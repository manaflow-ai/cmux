diff a/.github/workflows/cmux-tui-spec.yml b/.github/workflows/cmux-tui-spec.yml	(rejected hunks)
@@ -770,6 +770,48 @@ jobs:
           BASE_SHA: ${{ steps.base.outputs.sha }}
         run: python3 "$RUNNER_TEMP/cmux-tui-clippy-changed.py" --repo "$GITHUB_WORKSPACE" --base "$BASE_SHA"
 
+      # Lists draw only their visible rows: no draw fn in a ratatui crate gains a walk or clone
+      # of a whole collection (cmux-tui/crates/cmux-source-scan/src/visible_only.rs). It reads
+      # the tree, so it runs on every change; its ratchet list only shrinks.
+      - name: visible-only draw ratchet
+        if: ${{ !cancelled() }}
+        working-directory: cmux-tui
+        run: cargo run -q --locked -p cmux-source-scan -- visible-only "$GITHUB_WORKSPACE"
+
+      # The runtime half of the ratchet above: each registered rail draws at 100 and 10,000
+      # items and its per-frame work (walked, cloned, built) stays flat in N, or keeps a baseline
+      # that only flips one way (cmux-view-rows/src/frame_work.rs). Only the full workspace gate
+      # ran them, and PR CI builds acpmux without `tui`, so a rail change could land a list that
+      # draws all of itself. Runs when a change touches either crate's inputs.
+      - name: visible-only frame work contracts
+        if: ${{ !cancelled() }}
+        env:
+          BASE_SHA: ${{ steps.base.outputs.sha }}
+        run: |
+          set -o pipefail
+          run_acpmux=1 run_tui=1
+          if [[ "$BASE_SHA" =~ ^[0-9a-f]{40}$ ]] \
+            && changed=$(git diff --no-renames --name-only "$BASE_SHA" HEAD); then
+            python3 scripts/ci/cargo_test_verdict.py touches cmux-tui/crates/acpmux <<<"$changed" || run_acpmux=0
+            python3 scripts/ci/cargo_test_verdict.py touches cmux-tui/crates/cmux-tui <<<"$changed" || run_tui=0
+          fi
+          cd cmux-tui
+          check() {
+            local name=$1; shift
+            local log="$RUNNER_TEMP/frame-work-$name.log" start=$SECONDS
+            cargo test --locked "$@" 2>&1 | tee "$log"
+            echo "frame work contracts ($name): $((SECONDS - start)) s" >> "$GITHUB_STEP_SUMMARY"
+            if ! grep -qE 'test result: ok\. [1-9][0-9]* passed' "$log"; then
+              echo "::error title=visible-only frame work contracts::$name selected no frame_work test"
+              exit 1
+            fi
+          }
+          if [[ $run_acpmux == 1 ]]; then check acpmux -p acpmux --features tui --lib frame_work; fi
+          if [[ $run_tui == 1 ]]; then check cmux-tui -p cmux-tui --lib frame_work; fi
+          if [[ $run_acpmux == 0 && $run_tui == 0 ]]; then
+            echo "No acpmux or cmux-tui input changed; skipping the frame work contracts." >> "$GITHUB_STEP_SUMMARY"
+          fi
+
       # The host's clone/enrollment and root-peer IPC invariants must execute,
       # not only compile. Reuse this job's Rust setup and warm target directory.
       - name: Cloud host identity tests
