{
  "$comment": [
    "Input families of Mac-rendered goldens (`cmux-shotdiff key`, cmux-tui/crates/cmux-shotdiff). A family's key is the sha256",
    "of its entry here and of every file its paths match, so a Mac renders it once per change of those",
    "files. Wide on purpose: a path left out lets a stale golden pass; one too many only costs a render.",
    "Paths are globs from the repository root, the last matching one wins, `!` excludes."
  ],
  "version": 1,
  "families": {
    "ios-gate": {
      "doc": "The App Review gate's reviewer-path stills (ios-review-gate.yml, one variant per device family): the app, the packages it can link, the Rust crates CmuxMobileLinkFFI.xcframework compiles (cmux-next-ios/rust and every cmux-tui crate it reaches, .github/scripts/ios_link_ffi_key.py), the UI test that walks it, the workflow steps that set appearance and status bar, and the Xcode and device pins.",
      "variants": [
        "iphone",
        "ipad",
        "duo"
      ],
      "paths": [
        "cmux-next-ios/**",
        "Packages/Shared/**",
        "Packages/iOS/**",
        "vendor/stack-auth-swift-sdk-prerelease/**",
        "scripts/ci/xcode-pins.txt",
        "scripts/select-ci-xcode.sh",
        ".github/ios-review-gate-devices.json",
        ".github/workflows/ios-review-gate.yml",
        "cmux-tui/crates/**",
        "cmux-tui/vendor/**",
        "cmux-tui/Cargo.toml",
        "cmux-tui/Cargo.lock",
        "cmux-tui/rust-toolchain.toml",
        "cmux-tui/.cargo/**",
        "Cargo.toml",
        "rust-toolchain.toml",
        ".cargo/**",
        ".github/scripts/ios_review_gate_devices.py",
        "!**/*.md",
        "!cmux-next-ios/verify/**",
        "!cmux-next-ios/AppStoreReview/**",
        "!cmux-next-ios/reliability-matrix/**",
        "!Packages/**/Tests/**"
      ]
    },
    "ios-screen-parity": {
      "doc": "A8's screen-parity stills (cmux-next-ios/verify/screen-parity/screens.tsv: 16 iPhone 17 Pro surfaces, list-rig fixtures and signed-out, light and dark), rendered on a Mac by ios-sim-linux-build.yml (artifact ios-sim-mac-shots) and on Linux by the sim SDK image: the app build's inputs (the ios-gate family's, less its workflow and device pins), the screen list and rig, and the workflow that renders them.",
      "variants": [
        "iphone-17-pro"
      ],
      "paths": [
        "cmux-next-ios/**",
        "Packages/Shared/**",
        "Packages/iOS/**",
        "vendor/stack-auth-swift-sdk-prerelease/**",
        "scripts/ci/xcode-pins.txt",
        "scripts/select-ci-xcode.sh",
        "cmux-tui/crates/**",
        "cmux-tui/vendor/**",
        "cmux-tui/Cargo.toml",
        "cmux-tui/Cargo.lock",
        "cmux-tui/rust-toolchain.toml",
        "cmux-tui/.cargo/**",
        "Cargo.toml",
        "rust-toolchain.toml",
        ".cargo/**",
        ".github/workflows/ios-sim-linux-build.yml",
        "!**/*.md",
        "!cmux-next-ios/AppStoreReview/**",
        "!cmux-next-ios/reliability-matrix/**",
        "!Packages/**/Tests/**",
        "!cmux-next-ios/verify/**",
        "cmux-next-ios/verify/screen-parity/**",
        "!**/*.md"
      ]
    },
    "desktop-gallery": {
      "doc": "B7's webview gallery parity renders. The gallery source, fixtures, renderer, Mac reference driver, parity policy, and workflow are keyed once per browser engine so Chromium and WebKit stores never share a golden.",
      "variants": [
        "chromium",
        "webkit"
      ],
      "paths": [
        "App/**",
        "Assets.xcassets/**",
        "Resources/**",
        "Packages/macOS/**",
        "Packages/Shared/**",
        "cmux.xcodeproj/**",
        "cmux.xcworkspace/**",
        "config/**",
        "Native/**",
        "libs/**",
        "vendor/**",
        "cmux-tui/crates/**",
        "cmux-tui/Cargo.toml",
        "cmux-tui/Cargo.lock",
        "ghostty",
        "ghostty-next",
        "scripts/cmux-next/gallery-mac-reference.py",
        "scripts/cmux-next/state_wait.py",
        "scripts/cmux-next/private-bun.sh",
        "scripts/cmux-next/build-*.sh",
        "scripts/cmux-next/bundle-*.sh",
        "scripts/cmux-next/cef-manifest.json",
        "scripts/cmux-next/desktop_goldens.py",
        "scripts/download-prebuilt-ghosttykit.sh",
        "cmux-tui/vendor/**",
        "cmux-tui/.cargo/**",
        "cmux-tui/rust-toolchain.toml",
        "Cargo.toml",
        "rust-toolchain.toml",
        ".cargo/**",
        "scripts/ci/xcode-pins.txt",
        ".xcode-version",
        "scripts/reload.sh",
        "package.json",
        "bun.lock",
        "webviews/**",
        "clients/**",
        "first-party-apps/**",
        "examples/gallery/**",
        "scripts/gallery-matrix/**",
        "scripts/measure/gallery-mac-reference.sh",
        "scripts/gallery-matrix/parity-tolerances.json",
        "scripts/cmux-next/media/whats-new-gallery.py",
        ".github/workflows/whats-new-gallery.yml",
        "cmux-tui/crates/cmux-shotdiff/**",
        "!**/*.md",
        "!Packages/**/Tests/**",
        "!**/node_modules/**",
        "!webviews/**/node_modules/**",
        "!scripts/gallery-matrix/**/node_modules/**",
        "!webviews/**/dist/**"
      ]
    },
    "desktop-frame-pacing": {
      "doc": "B10's desktop frame-pacing and golden interaction bench. The 120 Hz Mac runtime is recorded separately from its 120hz variant, so a future runtime can never reuse this store accidentally.",
      "variants": [
        "120hz"
      ],
      "paths": [
        "Packages/macOS/CmuxNext/**",
        "webviews/**",
        "scripts/ci/frame-pacing/**",
        "scripts/cmux-next/**",
        ".github/workflows/cmux-next-frame-pacing.yml",
        ".github/workflows/cmux-next-motion-golden.yml",
        "cmux-tui/crates/cmux-shotdiff/**",
        "cmux-tui/Cargo.toml",
        "cmux-tui/Cargo.lock",
        "cmux-tui/rust-toolchain.toml",
        "!**/*.md",
        "!Packages/macOS/CmuxNext/Tests/**",
        "!webviews/**/node_modules/**"
      ]
    },
    "desktop-chrome": {
      "doc": "Native NEXT reference crops for the cmux-fp look measurement (top left, sidebar and top bar at 2x). The replica can change without invalidating the Mac reference.",
      "variants": [
        "look-rest-2x"
      ],
      "paths": [
        "App/**",
        "Assets.xcassets/**",
        "Resources/**",
        "Packages/macOS/**",
        "Packages/Shared/**",
        "cmux.xcodeproj/**",
        "cmux.xcworkspace/**",
        "config/**",
        "Native/**",
        "libs/**",
        "vendor/**",
        "cmux-tui/crates/**",
        "cmux-tui/Cargo.toml",
        "cmux-tui/Cargo.lock",
        "ghostty",
        "ghostty-next",
        "scripts/cmux-next/build-*.sh",
        "scripts/cmux-next/bundle-*.sh",
        "scripts/cmux-next/cef-manifest.json",
        "scripts/cmux-next/desktop_goldens.py",
        "scripts/download-prebuilt-ghosttykit.sh",
        "cmux-tui/vendor/**",
        "cmux-tui/.cargo/**",
        "cmux-tui/rust-toolchain.toml",
        "Cargo.toml",
        "rust-toolchain.toml",
        ".cargo/**",
        "scripts/ci/xcode-pins.txt",
        ".xcode-version",
        "scripts/reload.sh",
        "package.json",
        "bun.lock",
        "webviews/**",
        "clients/**",
        "first-party-apps/**",
        "!**/*.md",
        "!Packages/**/Tests/**",
        "!**/node_modules/**"
      ]
    }
  }
}
