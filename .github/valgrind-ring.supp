# ring 0.17 AES-GCM uses initialized bytes through assembly that Valgrind 3.22
# cannot model. Keep the suppression at the ring/rustls boundary so unrelated
# uninitialized reads and syscall buffers still fail the leak-check job.
{
   ring-aes-gcm-decrypt
   Memcheck:Cond
   fun:*ring*aead*algorithm*Algorithm*open_within*
}
{
   ring-aes-gcm-writev-vector-0
   Memcheck:Param
   writev(vector[0])
   fun:writev
   ...
   fun:*rustls*ChunkVecBuffer*write_to*
}
{
   ring-aes-gcm-writev-vector-1
   Memcheck:Param
   writev(vector[1])
   fun:writev
   ...
   fun:*rustls*ChunkVecBuffer*write_to*
}
