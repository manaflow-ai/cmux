{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/ci/lint-swift-post-edit.sh\" 1>&2; printf '{}\\n'",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/ci/format-post-edit.sh\" 1>&2; printf '{}\\n'",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
