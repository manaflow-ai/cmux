# cmux Cloud devbox interactive shell setup (/etc/cmux/bashrc).
# Sourced from /etc/bash.bashrc, /etc/skel/.bashrc, /root/.bashrc, and
# /home/cmux/.bashrc.
case $- in *i*) ;; *) return ;; esac
# A login shell can reach this file through both system and user rc files.
if [[ ${__cmux_bashrc_loaded:-} ]]; then
  # Ubuntu's per-user rc can replace the system PS1 between the two sources.
  [ -r /etc/cmux/prompt.bash ] && . /etc/cmux/prompt.bash
  return
fi
__cmux_bashrc_loaded=1

# PTYs from the sandbox API do not reliably inherit these.
export LANG="${LANG:-C.UTF-8}"
export USER="${USER:-$(id -un)}"
export HOME="${HOME:-$(getent passwd "$(id -u)" | cut -d: -f6)}"

# Keep a persistent HOME's terminfo from shadowing cmux's capabilities. Login
# shells source the same file through /etc/profile.d; this covers non-login
# interactive shells opened by the session daemon.
[ -f /etc/profile.d/cmux-terminfo.sh ] && . /etc/profile.d/cmux-terminfo.sh

# First interactive shell on a fresh HOME (the persistent volume shadows the
# image's /root): seed history so ghost text completes agent launches.
if [ ! -f "$HOME/.bash_history" ] && [ -f /etc/cmux/seed-history ]; then
  cp /etc/cmux/seed-history "$HOME/.bash_history" 2>/dev/null || true
fi

# History ghost text (zsh-autosuggestions style) on top of readline. Right,
# End, Ctrl-E or Ctrl-F accepts; Alt-F accepts one word.
[ -r /etc/cmux/ghost.bash ] && . /etc/cmux/ghost.bash

# Users can override PS1 later in ~/.bashrc. The default reads the current
# machine name with Bash builtins and no Git scan.
[ -r /etc/cmux/prompt.bash ] && . /etc/cmux/prompt.bash

HISTSIZE=50000
HISTFILESIZE=50000
shopt -s histappend

alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias g=git
