# tint2 dock for the cmux devbox desktop: launchers (Chrome, Thunar, Ghostty)
# and a taskbar, no clock. Bottom panel, dark, matches the chatmux desktop
# layout. Launchers and icons live under /etc/cmux so the dock never depends
# on a distro's /usr/share/applications or icon-theme layout.
#
# ORDER MATTERS. tint2 resolves every `*_background_id = N` while it parses,
# against the backgrounds defined ABOVE that line (id 0 is the built-in
# transparent one; each `rounded =` opens the next). A forward reference clamps
# to -1 and hands the panel a garbage Background (out-of-bounds g_array_index):
# garbage borders drive the launcher icon size negative, every scaled icon comes
# back NULL, and the whole dock paints nothing (the 2026-08-27 invisible-toolbar
# regression). Keep the background blocks first; tests/vm-devbox-desktop.test.ts
# pins this.
# Background 1: panel
rounded = 0
border_width = 0
background_color = #14161c 90
border_color = #14161c 0

panel_items = LT
panel_position = bottom center horizontal
panel_size = 100% 36
panel_margin = 0 0
panel_padding = 6 3 6
panel_background_id = 1
panel_layer = top
wm_menu = 1

launcher_padding = 4 2 8
launcher_icon_size = 26
launcher_item_app = /etc/cmux/apps/google-chrome-cmux.desktop
launcher_item_app = /etc/cmux/apps/thunar-cmux.desktop
launcher_item_app = /etc/cmux/apps/ghostty-cmux.desktop

taskbar_mode = single_desktop
taskbar_padding = 6 2 6
task_maximum_size = 220 30
task_padding = 8 3
task_text = 1
task_icon = 1
task_font_color = #d8dee9 100
