#!/bin/sh
# Refreshes the machine's kind record (owner or team) from the VM-bound
# reflection route. It writes only an answer it got: missing configuration or a
# failed/invalid response leaves the record as it is (the image bakes `team`,
# and the Cloud backend records the kind it assigned at create), so a failed
# fetch never turns an owner VM `team`. Readers treat a missing or unreadable
# record as `team` (agent-auth.sh).
set -eu

kind_file=${CMUX_VM_KIND_FILE:-/etc/cmux/vm-kind}
env_file=${CMUX_VM_MODEL_ENV_FILE:-/etc/cmux/model-plane.env}

write_kind() {
  kind=$1
  dir=${kind_file%/*}
  [ "$dir" != "$kind_file" ] || dir=.
  mkdir -p "$dir"
  tmp=$(mktemp "$dir/.vm-kind.XXXXXX")
  trap 'rm -f "$tmp"' EXIT HUP INT TERM
  printf '%s\n' "$kind" >"$tmp"
  chmod 0644 "$tmp"
  if [ "$(id -u)" = 0 ]; then chown root:root "$tmp"; fi
  mv -f "$tmp" "$kind_file"
  trap - EXIT HUP INT TERM
}

# The boot's snapshot-clone check asks for a reset: a clone may carry its
# source's record, so it reads `team` until its own answer arrives.
if [ "${CMUX_VM_KIND_RESET:-}" = team ]; then
  write_kind team
  exit 0
fi
[ -f "$env_file" ] || exit 0
# Root-owned image data. It carries only alias origins and public placeholders.
. "$env_file"
origin=${CMUX_CODEROUTER_URL:-}
case "$origin" in https://*) ;; *) exit 0 ;; esac
key=${OPENAI_API_KEY:-cmux-vm-edge-placeholder}
set -- -fsS --connect-timeout 2 --max-time 8 -H "authorization: Bearer $key" -H 'accept: application/json'
if [ -f /usr/local/share/ca-certificates/freestyle-tls.crt ]; then
  set -- "$@" --cacert /usr/local/share/ca-certificates/freestyle-tls.crt
fi
body=$(curl "$@" "${origin%/}/api/vm/reflection/kind" 2>/dev/null) || exit 0
kind=$(printf '%s' "$body" | jq -er '.kind | select(. == "owner" or . == "team")' 2>/dev/null) || exit 0
write_kind "$kind"
