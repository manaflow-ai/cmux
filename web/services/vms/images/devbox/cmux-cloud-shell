#!/bin/sh
# cmux Cloud attach shell (/usr/local/bin/cmux-cloud-shell). cmuxd-remote
# spawns this for every PTY session (its --shell flag; see the per-provider
# serve commands in web/services/vms/drivers/{e2b,daytona,freestyle}.ts).
# A root daemon drops to the cmux user and starts a login bash so the
# /etc/cmux devshell (half-life prompt, ble.sh ghost text, seeded history)
# loads. A non-root daemon (E2B templates default the exec user to `user`)
# falls through to a login bash for the current user, which sources the same
# /etc/bash.bashrc chain.
if [ "$(id -u)" = "0" ] && id -u cmux >/dev/null 2>&1; then
  cd /home/cmux 2>/dev/null || true
  export HOME=/home/cmux
  export USER=cmux
  export LOGNAME=cmux
  export SHELL=/bin/bash
  exec runuser -u cmux -- /bin/bash -l
fi
export HOME="${HOME:-$(getent passwd "$(id -u)" | cut -d: -f6)}"
cd "$HOME" 2>/dev/null || true
export SHELL=/bin/bash
exec /bin/bash -l
