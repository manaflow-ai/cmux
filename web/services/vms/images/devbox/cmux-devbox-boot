#!/bin/sh
# cmux devbox boot supervisor (/usr/local/bin/cmux-devbox-boot).
#
# Supervises the cmux-tui session daemon, the machine's only session daemon
# (docs/cloud-cmux-tui-daemon.md), and, on a container image without systemd,
# the desktop session (see "Desktop" below). The Freestyle bake installs the
# pinned files.cmux.com build in the daemon user's home (sha256-verified; see
# web/scripts/build-devbox-freestyle.ts) and this loop starts the daemon and
# restarts it if it ever exits. On an image without the binary (the container
# Dockerfile) the loop waits for a driver to install it. The daemon command
# must stay identical to cmuxTuiDaemonCommand() in
# web/services/vms/drivers/cmuxTuiDaemon.ts; vm-devbox-image.test.ts pins
# the equality.
#
# The daemon runs as the image's work user (cmux, uid 1000, passwordless
# sudo), so every terminal pane is a non-root shell and coding agents start.
# The command picks that layout on the machine; a machine from an image baked
# before the work user existed keeps a root daemon and its /root state. This
# script reads the same selection so the state it wipes on a clone is the
# state the daemon actually writes.
#
# Per-machine daemon identity. A Freestyle snapshot is a memory image: every
# machine created from it resumes the source machine's processes, so a daemon
# running at snapshot time would hand one Noise static identity
# (identity.json) to every machine created from the snapshot, and nothing
# inside the guest (boot id, MAC, addresses) tells a clone apart. The
# platform's metadata service does (latest/meta-data/instance-id, the
# Firecracker MMDS behind the EC2-style token dance), so the daemon identity
# is bound to that id, cloud-init style, and re-checked every tick:
#   * /etc/cmux/daemon-instance-id names the machine whose identity the
#     state dir holds. A different id means "this is a clone": a running
#     daemon (another machine's identity) is stopped, the remote state is
#     wiped, and the daemon starts with a fresh identity bound to this id.
#   * /etc/cmux/bake-instance-id is the machine a snapshot is being taken
#     from. While it matches, the daemon is kept parked so the snapshot never
#     carries a live identity. The bake and derive scripts write it right
#     before they snapshot; a clone has a different id and starts its daemon
#     within one tick of resume.
# Without a metadata service (containers) the id is empty and the daemon
# simply runs, keeping whatever identity the state dir already holds.
#
# The SSH host keys are per machine for the same reason: a clone would
# otherwise present the builder's keys (and every other clone's). The clone
# branch regenerates them under the machine's own name
# (web/services/vms/images/identity.ts) in a detached subshell, so the daemon
# start never waits on key generation (sshd is not the daemon's readiness),
# and restarts sshd so it serves them. The new keys are staged before the old
# ones go, so a failed generation keeps a working sshd.
#
# The Freestyle public-platform bake runs this script from the cmux-tui-daemon
# systemd unit.
#
# Private-network announce. The provider's VPC fabric forwards to a machine
# only after it has seen a frame FROM that machine's VPC interface, and a
# memory-snapshot clone resumes with the interface already configured, so
# nothing transmits on it by itself: the owner's Mac then dials a listening
# daemon and every SYN vanishes (web/services/vms/images/network.ts has the
# measurement). announce_network sends a gratuitous ARP burst from every
# global IPv4 address; it runs detached when a clone is detected and every
# 30 s for the life of the supervisor so an idle machine never ages out of
# the fabric's table. The command line is devboxNetworkAnnounceCommand() in
# network.ts; vm-devbox-identity.test.ts pins the equality. The attach path
# announces on its own (freestyleNetworkAnnouncement.ts).
#
# CMUX_TUI_REMOTE_WS_BIND overrides the listener bind. Default: the IPv4
# wildcard. Freestyle sets [::]:1337 (its systemd unit / a driver drop-in)
# because private Freestyle networks can assign either address family; a
# dual-stack bind accepts both without public ingress.
#
# Desktop (container images only). On a Freestyle VM systemd's cmux-desktop
# unit owns the desktop session (desktop/cmux-desktop.service); without
# systemd nothing else would, so this supervisor runs the same
# cmux-desktop-boot loop as the work user (the uid-1000 account, else root)
# and restarts it if it ever exits. The daemon loop below is untouched by it:
# the desktop is a sibling process, never a child of the session daemon.
# Terminal identity for every pane the daemon opens. Children inherit the
# daemon's environment, and the Mac app renders each pane in its embedded
# Ghostty, so panes carry the same identity the app exports to local and SSH
# shells: TERM=xterm-256color plus COLORTERM=truecolor (set by the daemon at
# spawn), TERM_PROGRAM=ghostty, and TERM_PROGRAM_VERSION from the Ghostty
# generation the bake recorded in /etc/cmux/ghostty-version. Agents gate
# synchronized output, progress reporting, strikethrough, and Cmd-click on
# TERM_PROGRAM; without it Claude Code treats the pane as a plain xterm.
# The exact string is CMUX_TUI_DAEMON_TERMINAL_ENV in cmuxTuiDaemon.ts.
# BIN is not fixed here: cmux_tui_layout() below sets it from the layout.
DESKTOP_BOOT=/usr/local/bin/cmux-desktop-boot
DESKTOP_RUNTIME_DIR=/run/cmux-desktop
DESKTOP_DISPLAY=:1
BOUND_INSTANCE_FILE=/etc/cmux/daemon-instance-id
BAKE_INSTANCE_FILE=/etc/cmux/bake-instance-id
METADATA=http://169.254.169.254

# Selects the daemon's user, home and binary; keep identical to
# cmuxTuiLayoutSelector() in web/services/vms/drivers/cmuxTuiDaemon.ts.
cmux_tui_layout() {
  if id -u cmux >/dev/null 2>&1 && command -v setpriv >/dev/null 2>&1 && setpriv --reuid=cmux --regid=cmux --init-groups test -w /home/cmux 2>/dev/null && setpriv --reuid=cmux --regid=cmux --init-groups sudo -n true >/dev/null 2>&1; then CMUX_TUI_USER=cmux; CMUX_TUI_HOME=/home/cmux; CMUX_TUI_LAYOUT=user; else CMUX_TUI_USER=root; CMUX_TUI_HOME=/root; CMUX_TUI_LAYOUT=root; fi; CMUX_TUI_BIN="$CMUX_TUI_HOME/.cmux/bin/cmux-tui"
  BIN="$CMUX_TUI_BIN"
  # cmux-remote's state dir for the daemon user; identity.json lives under
  # sessions/<session>/auth.
  REMOTE_STATE_DIR="$CMUX_TUI_HOME/.local/state/cmux/remote"
}

instance_id() {
  token=$(curl -sf -m 1 -X PUT "$METADATA/latest/api/token" -H 'X-metadata-token-ttl-seconds: 60') || return 1
  curl -sf -m 1 -H "X-aws-ec2-metadata-token: $token" "$METADATA/latest/meta-data/instance-id"
}

cmux_tui_layout

daemon_pid=""
desktop_pid=""

start_desktop() {
  [ -x "$DESKTOP_BOOT" ] || return 0
  [ -d /run/systemd/system ] && return 0
  if [ -n "$desktop_pid" ] && kill -0 "$desktop_pid" 2>/dev/null; then return 0; fi
  [ -n "$desktop_pid" ] && wait "$desktop_pid" 2>/dev/null
  desktop_user=$(getent passwd 1000 | cut -d: -f1)
  [ -n "$desktop_user" ] || desktop_user=root
  desktop_home=$(getent passwd "$desktop_user" | cut -d: -f6)
  mkdir -p "$DESKTOP_RUNTIME_DIR" && chown "$desktop_user" "$DESKTOP_RUNTIME_DIR" && chmod 0755 "$DESKTOP_RUNTIME_DIR"
  runuser -u "$desktop_user" -- env HOME="$desktop_home" USER="$desktop_user" DISPLAY="$DESKTOP_DISPLAY" \
    CMUX_DESKTOP_RUNTIME_DIR="$DESKTOP_RUNTIME_DIR" "$DESKTOP_BOOT" >>/var/log/cmux-desktop.log 2>&1 &
  desktop_pid=$!
}

# New host keys are generated into a staging dir on the same filesystem and
# moved over the old ones only once all of them exist, so a failed generation
# leaves the previous keys in place (logged to the unit's journal) and sshd is
# never left without a key. sshd loads keys at start, so it is restarted last.
rekey_ssh_host() {
  command -v ssh-keygen >/dev/null 2>&1 || return 0
  staging=$(mktemp -d /etc/ssh/.cmux-rekey.XXXXXX) || { echo "cmux-devbox-boot: could not stage new ssh host keys; keeping the existing ones" >&2; return 1; }
  mkdir -p "$staging/etc/ssh"
  if ! ssh-keygen -A -f "$staging" >/dev/null 2>&1 || [ -z "$(ls "$staging"/etc/ssh/ssh_host_*_key 2>/dev/null)" ]; then
    rm -rf "$staging"
    echo "cmux-devbox-boot: ssh host key generation failed; keeping the existing keys" >&2
    return 1
  fi
  for key in "$staging"/etc/ssh/ssh_host_*_key; do
    mv -f "$key.pub" /etc/ssh/ && mv -f "$key" /etc/ssh/
  done
  rm -rf "$staging"
  [ -d /run/systemd/system ] && systemctl try-restart ssh >/dev/null 2>&1
  return 0
}

announce_network() {
  command -v arping >/dev/null 2>&1 && ip -o -4 addr show scope global 2>/dev/null | { while read -r _ dev _ cidr _; do case "$dev" in lo|docker*|veth*|br-*|virbr*) continue;; esac; case "$cidr" in 169.254.*) continue;; esac; arping -U -c 2 -w 2 -I "$dev" "${cidr%/*}" >/dev/null 2>&1 & done; wait; }; true
}

announce_loop() {
  while true; do announce_network; sleep 30; done
}

stop_daemon() {
  [ -n "$daemon_pid" ] || return 0
  kill "$daemon_pid" 2>/dev/null
  i=0
  while kill -0 "$daemon_pid" 2>/dev/null && [ "$i" -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
  kill -9 "$daemon_pid" 2>/dev/null
  wait "$daemon_pid" 2>/dev/null
  daemon_pid=""
}

announce_loop &

while true; do
  start_desktop
  # A driver can install the binary after boot, and it installs into the home
  # this same selection names, so re-read the layout until one appears.
  [ -x "$BIN" ] || cmux_tui_layout
  if [ -x "$BIN" ]; then
    id=$(instance_id 2>/dev/null) || id=""
    if [ -n "$id" ] && [ -f "$BAKE_INSTANCE_FILE" ] && [ "$id" = "$(cat "$BAKE_INSTANCE_FILE")" ]; then
      stop_daemon # the machine being snapshotted: parked until the snapshot is taken
    else
      if [ -n "$id" ] && [ "$id" != "$(cat "$BOUND_INSTANCE_FILE" 2>/dev/null)" ]; then
        stop_daemon
        rm -rf "$REMOTE_STATE_DIR"
        ( rekey_ssh_host & )
        ( announce_network & )
        mkdir -p /etc/cmux && printf '%s\n' "$id" > "$BOUND_INSTANCE_FILE"
      fi
      if [ -z "$daemon_pid" ] || ! kill -0 "$daemon_pid" 2>/dev/null; then
        [ -n "$daemon_pid" ] && wait "$daemon_pid" 2>/dev/null
        # --remote-ws-trusted-carrier: the listener is reachable only inside the
        # owner's private network, whose members are all authorized, so every
        # link gets carrier authentication with no device enrollment.
        (if id -u cmux >/dev/null 2>&1 && command -v setpriv >/dev/null 2>&1 && setpriv --reuid=cmux --regid=cmux --init-groups test -w /home/cmux 2>/dev/null && setpriv --reuid=cmux --regid=cmux --init-groups sudo -n true >/dev/null 2>&1; then CMUX_TUI_USER=cmux; CMUX_TUI_HOME=/home/cmux; CMUX_TUI_LAYOUT=user; else CMUX_TUI_USER=root; CMUX_TUI_HOME=/root; CMUX_TUI_LAYOUT=root; fi; CMUX_TUI_BIN="$CMUX_TUI_HOME/.cmux/bin/cmux-tui"; { mkdir -p /etc/cmux 2>/dev/null; printf '%s\n' "$CMUX_TUI_LAYOUT" > /etc/cmux/daemon-layout; } 2>/dev/null; cd "$CMUX_TUI_HOME" && if [ "$CMUX_TUI_USER" = root ]; then exec env HOME="$CMUX_TUI_HOME" TERM=xterm-256color TERM_PROGRAM=ghostty TERM_PROGRAM_VERSION="$(cat /etc/cmux/ghostty-version 2>/dev/null)" "$CMUX_TUI_BIN" server start --session cloud --remote-ws "${CMUX_TUI_REMOTE_WS_BIND:-0.0.0.0:1337}" --remote-ws-insecure-bind --remote-ws-trusted-carrier; else exec setpriv --reuid="$CMUX_TUI_USER" --regid="$CMUX_TUI_USER" --init-groups env HOME="$CMUX_TUI_HOME" USER="$CMUX_TUI_USER" LOGNAME="$CMUX_TUI_USER" SHELL=/bin/bash TERM=xterm-256color TERM_PROGRAM=ghostty TERM_PROGRAM_VERSION="$(cat /etc/cmux/ghostty-version 2>/dev/null)" "$CMUX_TUI_BIN" server start --session cloud --remote-ws "${CMUX_TUI_REMOTE_WS_BIND:-0.0.0.0:1337}" --remote-ws-insecure-bind --remote-ws-trusted-carrier; fi) &
        daemon_pid=$!
      fi
    fi
  fi
  sleep 1
done
