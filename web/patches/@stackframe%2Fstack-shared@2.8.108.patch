diff --git a/dist/esm/utils/promises.js b/dist/esm/utils/promises.js
index dd4213217eebd069805c9a6c8f5258e9b68795ef..3b06bab1c02986514ccf49b5062e2522137228f9 100644
--- a/dist/esm/utils/promises.js
+++ b/dist/esm/utils/promises.js
@@ -220,8 +220,25 @@ function runAsynchronouslyWithAlert(...args) {
 		...args[1],
 		onError: (error) => {
 			const nodeEnv = getProcessEnv("NODE_ENV");
-			if (KnownError.isKnownError(error) && nodeEnv?.includes("production")) alert(error.message);
-			else alert(`An unhandled error occurred. Please ${nodeEnv === "development" ? `check the browser console for the full error.` : "report this to the developer."}\n\n${error}`);
+			const productionLike = nodeEnv === undefined || nodeEnv.includes("production");
+			if (
+				KnownError.isKnownError(error) &&
+				productionLike &&
+				error.errorCode === "USER_EMAIL_ALREADY_EXISTS" &&
+				error.details?.would_work_if_email_was_verified === true &&
+				typeof window !== "undefined"
+			) {
+				const currentUrl = new URL(window.location.href);
+				const url = new URL("/handler/auth-error", currentUrl);
+				url.searchParams.set("code", "email-unverified");
+				for (const name of ["after_auth_return_to", "web_return_to", "native_app_return_to"]) {
+					const value = currentUrl.searchParams.get(name);
+					if (value) url.searchParams.set(name, value);
+				}
+				window.location.replace(url.toString());
+			} else {
+				alert(`An unhandled error occurred. Please ${nodeEnv === "development" ? `check the browser console for the full error.` : "report this to the developer."}`);
+			}
 			args[1]?.onError?.(error);
 		}
 	}, ...args.slice(2));
