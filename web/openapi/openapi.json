{
  "info": {
    "title": "cmux API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "openapi": "3.1.1",
  "paths": {
    "/account/me": {
      "get": {
        "operationId": "account.me",
        "summary": "Get the authenticated account and plan",
        "description": "Returns the signed-in user's id, primary email, and resolved billing plan (free or pro).",
        "tags": [
          "Account"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "userId": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    },
                    "planId": {
                      "enum": [
                        "free",
                        "pro"
                      ],
                      "type": "string"
                    },
                    "isPro": {
                      "type": "boolean"
                    },
                    "billingManagement": {
                      "enum": [
                        "stripe",
                        "external",
                        "none"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "userId",
                    "email",
                    "planId",
                    "isPro",
                    "billingManagement"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/dashboard/cloud/devices": {
      "get": {
        "operationId": "dashboard.cloud.devices",
        "summary": "List the authenticated user's Cloud Macs",
        "tags": [
          "Dashboard"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "deviceId": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "reportedName": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "displayName": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "modelIdentifier": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "osVersion": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "architecture": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "cmuxVersion": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "cmuxBuild": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "cmuxChannel": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "createdAt": {
                        "type": "number"
                      },
                      "lastControlPlaneAt": {
                        "type": "number"
                      },
                      "tunnelPurposes": {
                        "type": "array",
                        "items": {
                          "enum": [
                            "terminal",
                            "browser"
                          ],
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "id",
                      "deviceId",
                      "name",
                      "reportedName",
                      "displayName",
                      "modelIdentifier",
                      "osVersion",
                      "architecture",
                      "cmuxVersion",
                      "cmuxBuild",
                      "cmuxChannel",
                      "createdAt",
                      "lastControlPlaneAt",
                      "tunnelPurposes"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
