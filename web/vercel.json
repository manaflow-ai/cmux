    },
    {
      "path": "/api/cron/cloud-diagnostics",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/account",
      "schedule": "29 * * * *"
    },
    {
      "path": "/api/cron/push-token-revocations",
      "schedule": "37 * * * *"
    },
    {
      "path": "/api/cron/team-seats",
      "schedule": "11,41 * * * *"
    },
    {
      "path": "/api/cron/apple-notifications",
      "schedule": "17,47 * * * *"
    },
    {
      "path": "/api/cron/vm-usage-analytics",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron/runs",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/hang-reports-retention",
      "schedule": "41 4 * * *"
    }
  ]
}
