#!/bin/sh
# systemd-shutdown runs this right before the final reboot(2), with the
# action as $1 and the root file system already read-only.
#
# Before a kexec, reset every virtio device. Linux 6.1 leaves them running
# across kexec (virtio has no shutdown hook until 6.14), so the host keeps
# writing into buffers and queues the old kernel posted (network and vsock
# receive buffers, balloon free page reports, disk completions), in pages the
# new kernel already uses, and the new kernel hangs during boot. Unbinding a
# driver resets its device. Measured on Freestyle (2026-11-02): with the disk
# left bound 1 of 4 small machines came up; with it unbound every one did.
# The disk goes last, and only once / is mounted read-only (systemd-shutdown
# remounts it and syncs before running these hooks). If / is still writable,
# the disk stays bound and the switch may hang; once the machine is power
# cycled it comes back on the provider kernel with its disk intact, and the
# attempt guard keeps it there (cmux-guest-kernel, MAX_ATTEMPTS).
#
# systemd runs the hooks in this directory in parallel, after the final
# remount and before the kexec itself; this is the only one the image
# installs. A manual `kexec -e` (kexec-tools, not in the image) skips them.
[ "$1" = kexec ] || exit 0
drivers="${CMUX_SYSFS:-/sys}/bus/virtio/drivers"
mounts="${CMUX_PROC:-/proc}/mounts"
root_ro=no
while read -r _ target _ options _; do
  [ "$target" = / ] || continue
  case ",$options," in
    *,ro,*) root_ro=yes ;;
    *) root_ro=no ;;
  esac
done < "$mounts"
for driver in virtio_net vmw_vsock_virtio_transport virtio_balloon virtio_rng virtio_console 9pnet_virtio virtiofs virtio_blk; do
  [ "$driver" = virtio_blk ] && [ "$root_ro" != yes ] && continue
  for dev in "$drivers/$driver"/virtio*; do
    [ -e "$dev" ] || continue
    echo "${dev##*/}" > "$drivers/$driver/unbind"
  done
done
exit 0
