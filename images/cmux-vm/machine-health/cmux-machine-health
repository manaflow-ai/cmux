#!/usr/bin/env python3
"""cmux-machine-health: check a persistent cmux machine and heal what it safely can.

One bounded, idempotent pass per run, as root, from cmux-machine-health.timer every 60 s (a
oneshot with TimeoutStartSec=45: no resident process). Its state lives only in /run/cmux (tmpfs)
and every fix is rate-limited. It writes /run/cmux/machine-health.json:
  {"schema": 1, "checkedAt": T, "problems": [{"check", "detail", "since"}], "fixed": [{"check", "action", "at"}]}
problems: what is wrong now and could not be fixed. fixed: the last 24 h of actions, at most 20.

  dns     A public name, and this machine's MagicDNS name when it is logged in to a tailnet,
          resolve. Else (at most once per 15 min): restart systemd-resolved, relink
          /etc/resolv.conf to its stub if it is not, restart tailscaled when installed (so it
          picks resolved mode again), and check again.
  disk    Free space on / stays above a floor. Else start the hygiene commands, each as its own
          transient unit (at most once per 15 min). Under the hard floor it is critical.
  ram     MemAvailable stays above a floor. Reported only: kills are the cgroup limits' job.

problems come most important first (dns, disk, ram, loop), at most 8.

Config: /etc/cmux/machine-health.json overrides DEFAULTS. Install, from any copy of this file:
  sudo python3 cmux-machine-health install [--config FILE]
Remove: sudo cmux-machine-health uninstall (or systemctl disable --now cmux-machine-health.timer).
"""
import argparse, contextlib, fcntl, json, os, pwd, re, shutil, subprocess, sys, time

STATE_DIR = "/run/cmux"
HEALTH_FILE = f"{STATE_DIR}/machine-health.json"
STATE_FILE = f"{STATE_DIR}/machine-health-state.json"
CONFIG_FILE = "/etc/cmux/machine-health.json"
RESOLV_CONF = "/etc/resolv.conf"
RESOLVED_STUB = "/run/systemd/resolve/stub-resolv.conf"
HYGIENE = "/usr/local/bin/cmux-machine-hygiene"
SBIN = "/usr/local/sbin/cmux-machine-health"
PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
BUDGET_S = 40  # under the unit's TimeoutStartSec=45
GB = 10**9
DEFAULTS = {
    "dnsNames": ["github.com"],
    "tailnetName": True,
    "diskPath": "/",
    "diskFloorBytes": None,  # max(min(10 GB, 20% of the disk), 5% of the disk)
    "diskHardFloorBytes": None,  # min(3 GB, 10% of the disk)
    "ramFloorBytes": None,  # min(2 GiB, 10% of RAM)
    "hygieneCommands": None,  # argv lists; default: cmux-machine-hygiene --apply per /home user
}
HOSTNAME = re.compile(r"(?=.{1,253}$)[A-Za-z0-9_]([A-Za-z0-9_-]{0,62})(\.[A-Za-z0-9_]([A-Za-z0-9_-]{0,62}))*\.?")
ORDER = ["dns", "disk", "ram", "loop"]
MAX_PROBLEMS = 8
GUARD = "# cmux machine guard (cmux-machine-health install). Managed, do not edit.\n"
UNITS = {
    "/etc/systemd/system/cmux-machine-health.service": "[Unit]\nDescription=cmux machine health: check and heal DNS, disk and RAM once\nAfter=network.target systemd-resolved.service\n\n[Service]\nType=oneshot\nExecStart=" + SBIN + " run\nTimeoutStartSec=45\nNice=10\nIOSchedulingClass=idle\nOOMScoreAdjust=-500\nMemoryMax=256M\nTasksMax=64\n",
    "/etc/systemd/system/cmux-machine-health.timer": "[Unit]\nDescription=Run cmux machine health every minute\n\n[Timer]\nOnActiveSec=60\nOnUnitActiveSec=60\nAccuracySec=5\n\n[Install]\nWantedBy=timers.target\n",
    # Every ssh and login session (logind's session-N.scope): a runaway hits its own limits.
    # MemorySwapMax as a share of swap needs systemd 254+; older systemd ignores the line.
    "/etc/systemd/system/session-.scope.d/50-cmux-guard.conf": GUARD + "[Scope]\nMemoryHigh=70%\nMemoryMax=80%\nMemorySwapMax=25%\nTasksMax=8192\n",
    # The user's systemd manager (and so acpmux) outlives a runaway; memory.min needs its ancestors.
    "/etc/systemd/system/user@.service.d/50-cmux-guard.conf": GUARD + "[Service]\nOOMScoreAdjust=-900\nMemoryMin=64M\n",
    "/etc/systemd/system/user-.slice.d/50-cmux-guard.conf": GUARD + "[Slice]\nMemoryMin=64M\n",
    # Every user's sessions and services together leave a tenth of RAM to the system.
    "/etc/systemd/system/user.slice.d/50-cmux-guard.conf": GUARD + "[Slice]\nMemoryMin=256M\nMemoryMax=90%\n",
    # The manager's own -900 must not reach the user services it starts.
    "/etc/systemd/user.conf.d/50-cmux-guard.conf": GUARD + "[Manager]\nDefaultOOMScoreAdjust=200\n",
}


def iso(ts):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(ts))


def gb(n):
    return f"{n / GB:.1f} GB"


def clean(text):
    """Short plain text: no hint tail, no home paths, no credentials."""
    text = str(text).split("; `")[0]
    text = re.sub(r"(?i)(token|key|secret|password)=\S+", r"\1=...", text)
    return re.sub(r"/(home|Users|root)(/[^\s/]+)?", "~", text)[:200]


class Host:
    """Every side effect; tests pass a fake."""

    def now(self):
        return time.time()

    def mono(self):
        return time.monotonic()

    def sleep(self, s):
        time.sleep(s)

    def run(self, argv, timeout):
        try:
            r = subprocess.run(argv, capture_output=True, text=True, timeout=max(1, timeout), stdin=subprocess.DEVNULL, env={"PATH": PATH, "LANG": "C.UTF-8"}, cwd="/")
            return r.returncode, r.stdout
        except (OSError, subprocess.SubprocessError):
            return 124, ""

    def is_root(self):
        return os.geteuid() == 0

    @contextlib.contextmanager
    def lock(self):
        """One pass at a time (a manual run beside the timer's); yields False when another holds it."""
        os.makedirs(STATE_DIR, mode=0o755, exist_ok=True)
        with open(f"{STATE_DIR}/machine-health.lock", "w") as f:
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                yield False
                return
            yield True

    def set_oom_score(self, pid, score):
        with open(f"/proc/{pid}/oom_score_adj", "w") as f:
            f.write(f"{score}\n")

    def which(self, name):
        return shutil.which(name, path=PATH)

    def disk(self, path):
        s = os.statvfs(path)
        return s.f_bavail * s.f_frsize, s.f_blocks * s.f_frsize

    def meminfo(self):
        with open("/proc/meminfo") as f:
            kb = dict(re.findall(r"^(\w+):\s+(\d+) kB", f.read(), re.M))
        return int(kb["MemAvailable"]) * 1024, int(kb["MemTotal"]) * 1024

    def stub_linked(self):
        return os.path.islink(RESOLV_CONF) and os.path.realpath(RESOLV_CONF) == RESOLVED_STUB

    def stub_ready(self):
        try:
            with open(RESOLVED_STUB) as f:
                return "\nnameserver " in "\n" + f.read()
        except OSError:
            return False

    def relink(self):
        tmp = RESOLV_CONF + ".cmux-health"
        if os.path.lexists(tmp):
            os.unlink(tmp)
        os.symlink("../run/systemd/resolve/stub-resolv.conf", tmp)
        os.replace(tmp, RESOLV_CONF)

    def users(self):
        """Local accounts from /etc/passwd: no NSS lookup, so a hung directory service cannot stall a pass."""
        rows = []
        try:
            with open("/etc/passwd") as f:
                for line in f:
                    parts = line.rstrip("\n").split(":")
                    if len(parts) == 7 and parts[2].isdigit() and parts[3].isdigit():
                        rows.append(pwd.struct_passwd((parts[0], parts[1], int(parts[2]), int(parts[3]), parts[4], parts[5], parts[6])))
        except OSError:
            pass
        return rows

    def read_json(self, path):
        try:
            with open(path) as f:
                return json.load(f)
        except FileNotFoundError:
            return None

    def write(self, path, text, mode=0o644):
        os.makedirs(os.path.dirname(path), mode=0o755, exist_ok=True)
        tmp = f"{path}.tmp-{os.getpid()}"
        with open(tmp, "w") as f:
            f.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, path)

    def remove(self, path):
        if os.path.lexists(path):
            os.unlink(path)


class Pass:
    def __init__(self, host, config, state):
        self.host, self.config = host, config
        self.start = host.mono()
        state = state if isinstance(state, dict) else {}
        since, last, fixed = state.get("since"), state.get("last"), state.get("fixed")
        self.since_was = {k: v for k, v in since.items() if isinstance(v, str)} if isinstance(since, dict) else {}
        self.last = {k: v for k, v in last.items() if isinstance(v, (int, float)) and not isinstance(v, bool)} if isinstance(last, dict) else {}
        state = {"fixed": [f for f in fixed if isinstance(f, dict) and all(isinstance(f.get(k), str) for k in ("check", "action", "at"))] if isinstance(fixed, list) else []}
        self.since, self.problems, self.new_fixed = {}, [], []
        self.fixed_was = state.get("fixed", [])

    def left(self):
        return BUDGET_S - (self.host.mono() - self.start)

    def run(self, argv, timeout):
        """A command bounded by what is left of this pass, so the report is always written."""
        t = min(timeout, self.left() - 3)
        return self.host.run(argv, t) if t >= 1 else (124, "")

    def may(self, key, every_s, needs_s=0):
        """True at most once per every_s for this fix, and only with needs_s left in this run. A
        last time in the future (the clock went back) does not block."""
        now = self.host.now()
        if self.left() < needs_s or 0 <= now - self.last.get(key, 0) < every_s:
            return False
        self.last[key] = now
        return True

    def problem(self, check, key, detail, since=None):
        self.since[key] = self.since_was.get(key) or since or iso(self.host.now())
        self.problems.append({"check": check, "detail": clean(detail), "since": self.since[key]})

    def fixed(self, check, action):
        self.new_fixed.append({"check": check, "action": clean(action), "at": iso(self.host.now())})

    def run_check(self, name, fn):
        try:
            fn()
        except Exception as e:  # one broken check must not stop the others or the report
            self.problem("loop", f"loop:{name}", f"machine health: the {name} check failed: {type(e).__name__}")

    # dns
    def resolves(self, name):
        code, out = self.run(["getent", "ahosts", name], 5)
        return code == 0 and bool(out.strip())

    def tailnet_name(self):
        if not self.config["tailnetName"] or not self.host.which("tailscale"):
            return None
        try:
            s = json.loads(self.run(["tailscale", "status", "--json"], 5)[1])
        except ValueError:
            return None
        if s.get("BackendState") != "Running" or not s.get("MagicDNSSuffix") or (s.get("CurrentTailnet") or {}).get("MagicDNSEnabled") is False:
            return None
        return ((s.get("Self") or {}).get("DNSName") or "").rstrip(".") or None

    def check_dns(self):
        names = list(self.config["dnsNames"]) + [n for n in [self.tailnet_name()] if n]
        failing = [n for n in names if not self.resolves(n)]
        if failing and self.may("fix:dns", 15 * 60, needs_s=20):
            if self.run(["systemctl", "restart", "systemd-resolved.service"], 15)[0] == 0:
                self.fixed("dns", "restarted systemd-resolved")
            if not self.host.stub_linked() and self.host.stub_ready():
                self.host.relink()
                self.fixed("dns", "relinked /etc/resolv.conf to the systemd-resolved stub")
            if self.run(["systemctl", "show", "-p", "LoadState", "--value", "tailscaled.service"], 5)[1].strip() == "loaded":
                if self.run(["systemctl", "restart", "tailscaled.service"], 15)[0] == 0:
                    self.fixed("dns", "restarted tailscaled so it picks systemd-resolved")
            until = self.host.mono() + 10
            while failing:
                failing = [n for n in failing if not self.resolves(n)]
                if not failing or self.host.mono() >= until or self.left() < 8:
                    break
                self.host.sleep(1)
        for n in failing:
            self.problem("dns", f"dns:{n}", f"DNS: {n} does not resolve")

    # disk and ram
    def hygiene_commands(self):
        if self.config["hygieneCommands"] is not None:
            return self.config["hygieneCommands"]
        if not self.host.which(HYGIENE):
            return []
        homes = [u for u in self.host.users() if 1000 <= u.pw_uid < 60000 and u.pw_dir == f"/home/{u.pw_name}"]
        return [["runuser", "-u", u.pw_name, "--", HYGIENE, "--apply", "--home", u.pw_dir, "--root", u.pw_dir] for u in homes]

    def check_disk(self):
        path = self.config["diskPath"]
        free, total = self.host.disk(path)
        floor = self.config["diskFloorBytes"]
        floor = max(min(10 * GB, total // 5), total // 20) if floor is None else floor
        hard = self.config["diskHardFloorBytes"]
        hard = min(3 * GB, total // 10) if hard is None else hard
        if free >= floor:
            return
        commands = self.hygiene_commands()
        if commands and self.may("fix:disk", 15 * 60, needs_s=10):
            started = 0
            for i, argv in enumerate(commands):
                unit = ["systemd-run", "--quiet", "--collect", "--no-block", f"--unit=cmux-machine-health-hygiene-{i}", "-p", "RuntimeMaxSec=900", "-p", "Nice=10", "-p", "IOSchedulingClass=idle", "--"]
                started += self.run(unit + list(argv), 5)[0] == 0
            if started:
                self.fixed("disk", f"started disk hygiene ({started} of {len(commands)} commands)")
                free, total = self.host.disk(path)
            else:
                del self.last["fix:disk"]  # nothing ran: the next pass tries again
        if free < hard:
            self.problem("disk", "disk", f"disk: CRITICAL: {gb(free)} free on {path}, under the hard floor of {gb(hard)}")
        elif free < floor:
            self.problem("disk", "disk", f"disk: {gb(free)} free on {path}, under the floor of {gb(floor)}")

    def check_ram(self):
        avail, total = self.host.meminfo()
        floor = self.config["ramFloorBytes"]
        floor = min(2 * 2**30, total // 10) if floor is None else floor
        if avail < floor:
            self.problem("ram", "ram", f"RAM: {gb(avail)} available of {gb(total)}, under the floor of {gb(floor)}")

    def report(self):
        day_ago = iso(self.host.now() - 86400)
        fixed = ([f for f in self.fixed_was if f.get("at", "") >= day_ago] + self.new_fixed)[-20:]
        state = {"since": self.since, "last": {k: v for k, v in self.last.items() if self.host.now() - v < 86400}, "fixed": fixed}
        problems = sorted(self.problems, key=lambda p: ORDER.index(p["check"]))[:MAX_PROBLEMS]
        health = {"schema": 1, "checkedAt": iso(self.host.now()), "problems": problems, "fixed": fixed}
        return health, state


def config_problems(given):
    """Why a config is unusable, or nothing; install refuses it, a pass uses the defaults."""
    if not isinstance(given, dict):
        return ["the config must be a JSON object"]
    problems = [f"unknown config key {k}" for k in sorted(set(given) - set(DEFAULTS))]
    for key in ("dnsNames",):
        if key in given and not (isinstance(given[key], list) and all(isinstance(x, str) and x for x in given[key])):
            problems.append(f"{key} must be a list of non-empty strings")
    if isinstance(given.get("dnsNames"), list) and not all(isinstance(n, str) and HOSTNAME.fullmatch(n) for n in given["dnsNames"]):
        problems.append("dnsNames must be host names")
    if "tailnetName" in given and not isinstance(given["tailnetName"], bool):
        problems.append("tailnetName must be true or false")
    if "diskPath" in given and not (isinstance(given["diskPath"], str) and given["diskPath"].startswith("/")):
        problems.append("diskPath must be an absolute path")
    for key in ("diskFloorBytes", "diskHardFloorBytes", "ramFloorBytes"):
        v = given.get(key)
        if v is not None and (isinstance(v, bool) or not isinstance(v, int) or v < 0):
            problems.append(f"{key} must be a whole number of bytes, or null")
    hc = given.get("hygieneCommands")
    if hc is not None and not (isinstance(hc, list) and all(isinstance(a, list) and a and all(isinstance(x, str) for x in a) for a in hc)):
        problems.append("hygieneCommands must be a list of argv lists")
    return problems


def load_config(host):
    config = dict(DEFAULTS)
    try:
        given = host.read_json(CONFIG_FILE)
    except (OSError, ValueError):
        return config, f"{CONFIG_FILE} is not valid JSON; the defaults apply"
    if given is None:
        return config, None
    problems = config_problems(given)
    if problems:
        return config, f"{CONFIG_FILE}: {problems[0]}; the defaults apply"
    config.update(given)
    return config, None


def check_config(given):
    problems = config_problems(given)
    if problems:
        raise SystemExit("; ".join(problems))


def run_pass(host):
    config, config_error = load_config(host)
    state = {}
    try:
        state = host.read_json(STATE_FILE) or {}
    except (OSError, ValueError):
        pass
    p = Pass(host, config, state)
    if config_error:
        p.problem("loop", "loop:config", config_error)
    for name, fn in (("disk", p.check_disk), ("ram", p.check_ram), ("dns", p.check_dns)):
        p.run_check(name, fn)
    health, state = p.report()
    for item in p.problems:
        print(f"PROBLEM {item['check']}: {item['detail']} (since {item['since']})")
    host.write(STATE_FILE, json.dumps(state), 0o600)
    host.write(HEALTH_FILE, json.dumps(health) + "\n", 0o644)
    return health


def protect_running_managers(host):
    """Running user managers predate the drop-ins: each re-executes (it keeps every service, as
    after a systemd upgrade) to read DefaultOOMScoreAdjust, and only once that shows 200 does the
    manager itself get -900, so its services can never inherit it."""
    for line in host.run(["systemctl", "list-units", "--plain", "--no-legend", "--state=running", "user@*.service"], 10)[1].splitlines():
        unit = line.split()[0] if line.strip() else ""
        m = re.fullmatch(r"user@(\d+)\.service", unit)
        name = next((u.pw_name for u in host.users() if m and u.pw_uid == int(m.group(1))), None)
        if not name:
            continue
        host.run(["systemctl", "kill", "--kill-whom=main", "--signal=SIGRTMIN+25", unit], 10)
        default = ""
        for _ in range(20):
            default = host.run(["systemctl", "--user", "-M", f"{name}@", "show", "-p", "DefaultOOMScoreAdjust", "--value"], 5)[1].strip()
            if default == "200":
                break
            host.sleep(0.5)
        pid = host.run(["systemctl", "show", "-p", "MainPID", "--value", unit], 5)[1].strip()
        if default == "200" and pid.isdigit() and pid != "0":
            host.set_oom_score(int(pid), -900)
            print(f"{unit}: re-executed; OOM score -900 now, its services get 200")
        else:
            print(f"{unit}: not protected until it starts again (DefaultOOMScoreAdjust {default or 'unknown'})")


def install(host, config_path, start=True):
    if config_path:
        with open(config_path) as f:
            given = json.load(f)
        check_config(given)
        host.write(CONFIG_FILE, json.dumps(given, indent=2) + "\n")
    with open(os.path.abspath(__file__)) as f:
        host.write(SBIN, f.read(), 0o755)
    for path, text in UNITS.items():
        host.write(path, text)
    enable = ["systemctl", "enable", "--now", "cmux-machine-health.timer"] if start else ["systemctl", "enable", "cmux-machine-health.timer"]
    for argv in (["systemctl", "daemon-reload"], enable):
        if host.run(argv, 60)[0] != 0:
            raise SystemExit(f"{' '.join(argv)} failed")
    protect_running_managers(host)
    print("installed: guard drop-ins apply to new login sessions now")
    print("installed: cmux-machine-health.timer " + ("runs every 60 s" if start else "enabled, not started (--no-start)") + "; /run/cmux/machine-health.json")


def uninstall(host):
    host.run(["systemctl", "disable", "--now", "cmux-machine-health.timer"], 30)
    for path in [*UNITS, SBIN]:
        host.remove(path)
    host.run(["systemctl", "daemon-reload"], 60)
    print(f"removed; {CONFIG_FILE} and {STATE_DIR} are kept")


def main(argv=None, host=None):
    host = host or Host()
    ap = argparse.ArgumentParser(prog="cmux-machine-health", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd")
    sub.add_parser("run", help="one pass (the default)")
    ins = sub.add_parser("install", help="install the script, timer and guard drop-ins; enable the timer")
    ins.add_argument("--config", help="a JSON config to install as " + CONFIG_FILE)
    ins.add_argument("--no-start", action="store_true", help="enable the timer without starting it (an image bake starts it last)")
    sub.add_parser("uninstall", help="stop the timer and remove what install wrote")
    sub.add_parser("config", help="print the effective config")
    args = ap.parse_args(argv)
    if args.cmd == "config":
        print(json.dumps(load_config(host)[0], indent=2))
        return 0
    if not host.is_root():
        print("cmux-machine-health: run as root", file=sys.stderr)
        return 2
    if args.cmd == "install":
        install(host, args.config, start=not args.no_start)
        return 0
    if args.cmd == "uninstall":
        uninstall(host)
        return 0
    with host.lock() as mine:
        if not mine:
            print("another pass is running")
            return 0
        health = run_pass(host)
    print(f"{len(health['problems'])} problems reported, {len(health['fixed'])} fixes in 24 h")
    return 0


if __name__ == "__main__":
    sys.exit(main())
