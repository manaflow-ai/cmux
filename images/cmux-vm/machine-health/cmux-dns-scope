#!/usr/bin/env bash
# cmux-dns-scope: keep a Cloud machine resolving names when the provider's TLS-edge resolver stalls.
#
# A machine created with a TLS edge rule (a gateway-mode team's coderouter.cmux.internal, a network
# policy's steered domains) gets two things from the provider's guest agent after it resumes:
#   - /etc/systemd/resolved.conf.d/61-freestyle-tls.conf: `DNS=` then `DNS=<edge resolver>` and
#     `Domains=~.`, which drops the public resolvers of 60-freestyle-vms.conf;
#   - a plain /etc/resolv.conf (`nameserver <edge resolver>`, `options timeout:1 attempts:2`) in
#     place of the systemd-resolved stub link the image bakes.
# The edge resolver answers the rule's names with the edge's address and forwards the rest, which
# is why the drop-in sends every name to it. It is also then the only resolver: when it stops
# answering, every name fails, github.com and the Cloud API included, and the bind agent never
# reaches the API (image roll runs 45779971043 and 45774103440, 2026-11-26).
#
# This keeps the edge resolver first for every name and only resolver for *.cmux.internal, and
# adds the public resolvers behind it:
#   - /run/systemd/resolved.conf.d/62-cmux-dns-scope.conf: `DNS=<edge> <public...>`, `Domains=~.`.
#     systemd-resolved asks the first server and moves to the next only when it does not answer.
#   - the default-route link gets the edge resolver with routing domain ~cmux.internal, so the
#     edge's own names never reach a public resolver (which would answer NXDOMAIN).
#   - /etc/resolv.conf is linked back to the stub when it is the provider's plain file, so every
#     program asks systemd-resolved.
# A machine without 61-freestyle-tls.conf is left as it is (and loses this drop-in if it had one).
#
# Run by cmux-dns-scope.path whenever 61-freestyle-tls.conf, /etc/resolv.conf or resolved's stub
# file changes (resolved rewrites the stub when it restarts, which also drops runtime link
# settings), and once at boot. Idempotent: a pass that finds everything in place changes nothing.
#
# Usage: cmux-dns-scope   Output: one line per change made; exit 0 unless a change failed.

set -u
export LC_ALL=C

# Tests point these at a temp dir; on a machine they are the real paths.
conf_dir="${CMUX_DNS_CONF_DIR:-/etc/systemd/resolved.conf.d}"
run_dir="${CMUX_DNS_RUN_DIR:-/run/systemd/resolved.conf.d}"
resolv_conf="${CMUX_DNS_RESOLV_CONF:-/etc/resolv.conf}"
stub="${CMUX_DNS_STUB:-/run/systemd/resolve/stub-resolv.conf}"

edge_conf="$conf_dir/61-freestyle-tls.conf"
public_conf="$conf_dir/60-freestyle-vms.conf"
ours="$run_dir/62-cmux-dns-scope.conf"
edge_domains="~cmux.internal"
# The public resolvers 60-freestyle-vms.conf names on today's base, for a base that has none.
default_public="2606:4700:4700::1111 2001:4860:4860::8888 8.8.8.8 8.8.4.4"

failed=0

# The DNS servers a resolved.conf drop-in leaves set: DNS= lines add, an empty one resets.
servers_of() {
  [ -f "$1" ] || return 0
  awk '
    /^[[:space:]]*DNS[[:space:]]*=/ {
      v = $0; sub(/^[^=]*=/, "", v); gsub(/^[[:space:]]+|[[:space:]]+$/, "", v)
      s = (v == "") ? "" : (s == "" ? v : s " " v)
    }
    END { print s }' "$1"
}

# The interface of the default IPv4 route (the provider's eth0), else of the IPv6 one.
default_link() {
  local dev
  dev="$(ip -o -4 route show default 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit } }')"
  [ -n "$dev" ] || dev="$(ip -o -6 route show default 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit } }')"
  printf '%s' "$dev"
}

if [ ! -f "$edge_conf" ]; then
  if [ -e "$ours" ]; then
    if rm -f "$ours" && systemctl try-reload-or-restart systemd-resolved.service; then
      echo "removed $ours: no 61-freestyle-tls.conf"
    else
      echo "could not remove $ours" >&2; failed=1
    fi
  fi
  exit "$failed"
fi

edge="$(servers_of "$edge_conf")"
[ -n "$edge" ] || exit 0
public="$(servers_of "$public_conf")"
[ -n "$public" ] || public="$default_public"
fallback=""
for s in $public; do
  case " $edge " in *" $s "*) ;; *) fallback="$fallback $s" ;; esac
done

want="# Written by cmux-dns-scope (/usr/local/sbin/cmux-dns-scope): the TLS-edge resolver first, the
# public resolvers behind it, so a stalled edge resolver does not take every name with it.
[Resolve]
DNS=
DNS=$edge$fallback
Domains=~.
"

if [ "$(cat "$ours" 2>/dev/null)" != "$(printf '%s' "$want")" ]; then
  if mkdir -p "$run_dir" && printf '%s' "$want" > "$ours.tmp" && mv -f "$ours.tmp" "$ours" && systemctl restart systemd-resolved.service; then
    echo "wrote $ours: DNS=$edge$fallback"
  else
    echo "could not write $ours or restart systemd-resolved" >&2; failed=1
  fi
fi

# Runtime link settings: resolved forgets them when it restarts, and the path unit runs this again.
link="$(default_link)"
if [ -n "$link" ]; then
  have_dns="$(resolvectl dns "$link" 2>/dev/null | sed 's/^[^:]*:[[:space:]]*//')"
  have_domain="$(resolvectl domain "$link" 2>/dev/null | sed 's/^[^:]*:[[:space:]]*//')"
  if [ "$have_dns" != "$edge" ] || [ "$have_domain" != "$edge_domains" ]; then
    # shellcheck disable=SC2086 # $edge is a space-separated server list
    if resolvectl dns "$link" $edge && resolvectl domain "$link" $edge_domains && resolvectl default-route "$link" false; then
      echo "link $link: DNS=$edge Domains=$edge_domains"
    else
      echo "could not set DNS on link $link" >&2; failed=1
    fi
  fi
fi

# The provider's plain resolv.conf names only the edge resolver and bypasses resolved; the stub
# goes back only when resolved has a nameserver in it, so the machine is never left without one.
if [ ! -L "$resolv_conf" ] && grep -q '^nameserver ' "$stub" 2>/dev/null; then
  plain_servers="$(awk '$1 == "nameserver" { print $2 }' "$resolv_conf" 2>/dev/null | tr '\n' ' ')"
  only_edge=1
  for s in $plain_servers; do
    case " $edge " in *" $s "*) ;; *) only_edge=0 ;; esac
  done
  if [ -n "$plain_servers" ] && [ "$only_edge" = 1 ]; then
    if ln -sfn "$stub" "$resolv_conf"; then
      echo "linked $resolv_conf to $stub"
    else
      echo "could not link $resolv_conf to $stub" >&2; failed=1
    fi
  fi
fi

exit "$failed"
