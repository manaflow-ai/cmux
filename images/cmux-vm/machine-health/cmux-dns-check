#!/usr/bin/env bash
# cmux-dns-check: does this machine resolve names through systemd-resolved?
#
# Checks that /etc/resolv.conf is a link to systemd-resolved's stub, that
# systemd-resolved runs, that a public name resolves and, on a machine logged
# in to a tailnet with MagicDNS, that its own MagicDNS name resolves (else that
# check is skipped with the reason). With --restart it first restarts
# systemd-resolved, then tailscaled when installed, so the checks prove the
# machine comes back resolving: Tailscale picks its DNS mode when it starts,
# and it uses systemd-resolved only when resolv.conf is the resolved stub and
# resolved runs. Otherwise it writes resolv.conf itself ("direct" mode), which
# is how a machine ends with "no upstream resolvers set". The mode this
# tailscaled run picked is read from its journal and must be systemd-resolved.
#
# It changes nothing but the two restarts. Baked into the cmux VM image
# (images/cmux-vm) as /usr/local/sbin/cmux-dns-check; it runs the same on any
# systemd machine, e.g. as root from a checkout:
#   sudo images/cmux-vm/machine-health/cmux-dns-check --restart
#
# Usage: cmux-dns-check [--restart] [--name NAME]... [--timeout SECS]
# Output: one PASS, FAIL or SKIP line per check.
# Exit 0 when nothing failed, 1 when a check failed, 2 on bad usage.

set -u
export LC_ALL=C

# Tests point these at a temp dir; on a machine they are the real paths.
resolv_conf="${CMUX_DNS_RESOLV_CONF:-/etc/resolv.conf}"
stub="${CMUX_DNS_STUB:-/run/systemd/resolve/stub-resolv.conf}"

restart=0
timeout=20
names=()
usage() { echo "usage: cmux-dns-check [--restart] [--name NAME]... [--timeout SECS]" >&2; exit 2; }
while [ $# -gt 0 ]; do
  case "$1" in
    --restart) restart=1 ;;
    --name) shift; [ -n "${1:-}" ] || usage; names+=("$1") ;;
    --timeout) shift; case "${1:-}" in ''|*[!0-9]*) usage ;; esac; timeout="$1" ;;
    -h|--help) usage ;;
    *) echo "unknown argument: $1" >&2; usage ;;
  esac
  shift
done
[ ${#names[@]} -gt 0 ] || names=(github.com)

failed=0
pass() { printf 'PASS %s\n' "$*"; }
fail() { printf 'FAIL %s\n' "$*"; failed=1; }
skip() { printf 'SKIP %s\n' "$*"; }

# The first address NAME resolves to through the system resolver (nsswitch, so
# the same path every program takes), retried until the deadline: right after
# a restart the stub can take a moment to answer.
resolve() {
  local name="$1" end=$((SECONDS + timeout)) addr
  while :; do
    addr="$(timeout 5 getent ahosts "$name" 2>/dev/null | awk 'NR == 1 { print $1 }')"
    [ -n "$addr" ] && { printf '%s\n' "$addr"; return 0; }
    [ "$SECONDS" -ge "$end" ] && return 1
    sleep 1
  done
}

has_tailscaled() { systemctl cat tailscaled.service >/dev/null 2>&1; }

if [ "$restart" = 1 ]; then
  if systemctl restart systemd-resolved.service; then pass "restart systemd-resolved"; else fail "restart systemd-resolved: systemctl restart failed"; fi
  if has_tailscaled; then
    if systemctl restart tailscaled.service; then pass "restart tailscaled"; else fail "restart tailscaled: systemctl restart failed"; fi
  else
    skip "restart tailscaled: tailscaled is not installed"
  fi
fi

if [ -L "$resolv_conf" ] && [ "$(readlink -f "$resolv_conf")" = "$(readlink -f "$stub")" ]; then
  pass "resolv.conf: $resolv_conf links to $stub"
elif [ -L "$resolv_conf" ]; then
  fail "resolv.conf: $resolv_conf links to $(readlink "$resolv_conf"), not to $stub"
else
  fail "resolv.conf: $resolv_conf is not a link to $stub"
fi

if systemctl is-active --quiet systemd-resolved.service; then pass "systemd-resolved: active"; else fail "systemd-resolved: not active"; fi

# Tailscale's DNS mode for this tailscaled run: its startup log line
# `dns: [rc=... ret=MODE]` in the journal of the unit's current invocation.
if has_tailscaled; then
  invocation="$(systemctl show -p InvocationID --value tailscaled.service 2>/dev/null)"
  end=$((SECONDS + timeout)); mode=""
  while [ -n "$invocation" ]; do
    mode="$(journalctl -q -o cat "_SYSTEMD_INVOCATION_ID=$invocation" 2>/dev/null | grep -o 'dns: \[[^]]*ret=[a-z-]*' | tail -n 1 | sed 's/.*ret=//')"
    if [ -n "$mode" ] || [ "$SECONDS" -ge "$end" ]; then break; fi
    sleep 1
  done
  case "$mode" in
    systemd-resolved) pass "tailscale DNS mode: systemd-resolved" ;;
    "") skip "tailscale DNS mode: this tailscaled run logged no DNS mode" ;;
    *) fail "tailscale DNS mode: $mode (tailscaled writes resolv.conf itself instead of using systemd-resolved)" ;;
  esac
fi

for name in "${names[@]}"; do
  if addr="$(resolve "$name")"; then pass "resolve $name: $addr"; else fail "resolve $name: no address within ${timeout}s"; fi
done

# The machine's own MagicDNS name, when it is logged in to a tailnet with MagicDNS on.
if ! command -v tailscale >/dev/null 2>&1; then
  skip "resolve tailnet name: tailscale is not installed"
else
  self_name="$(timeout 10 tailscale status --json 2>/dev/null | python3 -c '
import json, sys
try:
    s = json.load(sys.stdin)
except ValueError:
    print("!tailscale status --json gave no JSON"); sys.exit()
if s.get("BackendState") != "Running":
    print("!not logged in to a tailnet (BackendState %s)" % s.get("BackendState")); sys.exit()
tailnet = s.get("CurrentTailnet") or {}
if not s.get("MagicDNSSuffix") or tailnet.get("MagicDNSEnabled") is False:
    print("!MagicDNS is off on this tailnet"); sys.exit()
name = ((s.get("Self") or {}).get("DNSName") or "").rstrip(".")
print(name or "!this machine has no MagicDNS name")
')"
  case "$self_name" in
    "") skip "resolve tailnet name: tailscale status --json gave no answer" ;;
    "!"*) skip "resolve tailnet name: ${self_name#!}" ;;
    *) if addr="$(resolve "$self_name")"; then pass "resolve tailnet name $self_name: $addr"; else fail "resolve tailnet name $self_name: no address within ${timeout}s"; fi ;;
  esac
fi

exit "$failed"
