#!/bin/sh
# cmux-chief-update [--if-missing | --after-exit | --rollback]: replace the Cloud Chief's optchat-chief with the
# newest published build, and move back to the build before it when the new one does not stay up.
#
#   1. Read the manifest (CMUX_CHIEF_MANIFEST_URL, default the rolling feat-cmux-next one on files.cmux.com;
#      a file:// URL works too). Its fields: commit, url, sha256, size.
#   2. Same sha256 as /var/lib/cmux-chief/current: nothing to do. The sha256 of a build this machine rolled
#      back ($ROOT/refused): nothing to do until the manifest names another build.
#   3. Download to /var/lib/cmux-chief/store/<sha256>/optchat-chief, check the size and sha256, and run
#      its `--version` before anything points at it.
#   4. Point `previous` at the build `current` names, mark the new build on trial ($ROOT/trial), and move the
#      `current` link in one rename.
#   5. If cmux-chief.service runs, send its host SIGUSR1: the host stops between turns (never mid-turn) and
#      exits 0, and Restart=always starts the new build.
#   6. Keep the builds `current` and `previous` name in the store; delete the others.
#
# The trial (cmux-chief.service's ExecStartPre stamps each start, its ExecStopPost runs --after-exit): a build on
# trial that exits with a failure 3 times (CMUX_CHIEF_MAX_FAILS), each time within 120 s of its start
# (CMUX_CHIEF_STAY_UP_SECONDS), is rolled back: `current` moves back to `previous`, the build's sha256 goes to
# $ROOT/refused, and systemd's restart starts the previous build. Exit 2 (a usage or configuration error, which
# RestartPreventExitStatus does not restart) rolls back at once and starts the unit again. A run that stays up
# 120 s accepts the build. Why these numbers: a start takes up to 60 s on its own (the host waits that long for
# its acpmux daemon after a handoff, acpmux_daemon.rs SPAWN_LIMIT), so 120 s is past any slow start; three
# failures, not one, so a single network or daemon hiccup does not refuse a good build; with RestartSec=5 and
# its steps the three come within about 30 s of the swap. A clean exit (0: a handoff or a stop) counts for
# neither.
#
# --if-missing (the unit's ExecStartPre): only when `current` points at nothing, so a host start never
# waits on the network otherwise; it also stamps the start of a build on trial. /etc/cmux/no-self-update (the
# bake and the smoke) or CMUX_CHIEF_SELF_UPDATE=0 (/etc/cmux/chief.env) turns the update off.
# --after-exit (the unit's ExecStopPost, with systemd's SERVICE_RESULT, EXIT_CODE, EXIT_STATUS): the trial.
# --rollback: by hand, move `current` back to `previous` now, refuse the build it leaves, and ask the host to
# restart between turns.
set -eu
umask 022
ROOT="${CMUX_CHIEF_ROOT:-/var/lib/cmux-chief}"
MANIFEST="${CMUX_CHIEF_MANIFEST_URL:-https://files.cmux.com/optchat-chief/latest/manifest.json}"
UNIT="${CMUX_CHIEF_UNIT:-cmux-chief.service}"
STAY_UP="${CMUX_CHIEF_STAY_UP_SECONDS:-120}"
MAX_FAILS="${CMUX_CHIEF_MAX_FAILS:-3}"
TRIAL="$ROOT/trial"
log() { echo "cmux-chief-update: $*"; }
sha_of() { sha256sum "$(readlink -f "$1")" | cut -d' ' -f1; }
# Point link $1 at $2 in one rename.
point() {
  ln -sfn "$2" "$1.new"
  mv -T "$1.new" "$1"
}
# One writer of current, previous, trial and refused at a time (the timer's run, the unit's hooks, a person).
lock() {
  install -d -m 0755 "$ROOT"
  exec 9>"$ROOT/.lock"
  flock -w 30 9
}

# Move `current` back to `previous` and refuse the build it leaves ($1: why).
rollback() {
  if [ ! -x "$ROOT/previous" ]; then
    log "no previous build to roll back to ($1)"
    return 1
  fi
  bad="$(sha_of "$ROOT/current")"
  good="$(readlink -f "$ROOT/previous")"
  point "$ROOT/current" "$good"
  printf '%s %s %s\n' "$bad" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" > "$ROOT/refused.new"
  mv -f "$ROOT/refused.new" "$ROOT/refused"
  rm -rf "$TRIAL" "$ROOT/previous"
  log "rolled back: refused $bad ($1); current is $good ($("$ROOT/current" --version 2>/dev/null || echo '?'))"
}

case "${1:-}" in
--after-exit)
  [ -d "$TRIAL" ] || exit 0
  lock
  # No start stamp: the host that stopped ran the build before the trial (its handoff to the new one).
  [ -f "$TRIAL/started" ] || exit 0
  if [ "$(sha_of "$ROOT/current")" != "$(cat "$TRIAL/sha")" ]; then
    rm -rf "$TRIAL"
    exit 0
  fi
  ran=$(($(date +%s) - $(cat "$TRIAL/started")))
  rm -f "$TRIAL/started"
  how="${EXIT_CODE:-?} ${EXIT_STATUS:-?}, ${SERVICE_RESULT:-?}"
  if [ "$ran" -ge "$STAY_UP" ]; then
    log "build $(cat "$TRIAL/sha") stayed up ${ran} s; accepted"
    rm -rf "$TRIAL"
    exit 0
  fi
  if [ "${EXIT_CODE:-}" = exited ] && [ "${EXIT_STATUS:-}" = 0 ]; then
    log "build on trial exited 0 after ${ran} s (a handoff or a stop); not counted"
    exit 0
  fi
  fails=$(($(cat "$TRIAL/fails" 2>/dev/null || echo 0) + 1))
  echo "$fails" > "$TRIAL/fails"
  log "build on trial $(cat "$TRIAL/sha") failed after ${ran} s ($how): $fails of $MAX_FAILS"
  if [ "${EXIT_CODE:-}" = exited ] && [ "${EXIT_STATUS:-}" = 2 ]; then
    rollback "exit 2 after ${ran} s"
    # RestartPreventExitStatus=2: systemd does not restart this one, so start the previous build here.
    systemctl --no-block start "$UNIT"
  elif [ "$fails" -ge "$MAX_FAILS" ]; then
    rollback "$fails failures within ${STAY_UP} s of a start, the last $how"
  fi
  exit 0
  ;;
--rollback)
  lock
  rollback "by hand"
  if systemctl is-active --quiet "$UNIT"; then
    systemctl kill --kill-whom=main --signal=SIGUSR1 "$UNIT"
    log "asked $UNIT to restart between turns"
  fi
  exit 0
  ;;
--if-missing)
  if [ -x "$ROOT/current" ]; then
    if [ -f "$TRIAL/sha" ]; then
      lock
      date +%s > "$TRIAL/started"
    fi
    exit 0
  fi
  log "no build at $ROOT/current; fetching the newest"
  ;;
*)
  if [ -e /etc/cmux/no-self-update ] || [ "${CMUX_CHIEF_SELF_UPDATE:-1}" = "0" ]; then
    log "self-update is off"
    exit 0
  fi
  ;;
esac

install -d -m 0755 "$ROOT" "$ROOT/store"
tmp="$(mktemp -d "$ROOT/.update.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT
if ! curl -fsSL --retry 3 --max-time 60 -o "$tmp/manifest.json" "$MANIFEST"; then
  # Nothing published yet, or the network is away: the next timer run tries again. With no build at all
  # (--if-missing) the host cannot start, so that is a failure.
  log "no manifest at $MANIFEST"
  [ "${1:-}" = "--if-missing" ] && exit 1
  exit 0
fi
fields="$(python3 -I -c '
import json, re, sys
m = json.load(open(sys.argv[1]))
sha, url, size = str(m["sha256"]), str(m["url"]), int(m["size"])
assert re.fullmatch(r"[0-9a-f]{64}", sha), "sha256"
assert re.match(r"(https|file)://", url), "url"
assert 0 < size < 1 << 30, "size"
print(sha, size, url)
' "$tmp/manifest.json")"
sha="${fields%% *}"
rest="${fields#* }"
size="${rest%% *}"
url="${rest#* }"

if [ -x "$ROOT/current" ]; then
  have="$(sha_of "$ROOT/current")"
  if [ "$have" = "$sha" ]; then
    log "up to date ($sha)"
    exit 0
  fi
  if [ -f "$ROOT/refused" ] && [ "$(cut -d' ' -f1 "$ROOT/refused")" = "$sha" ]; then
    log "the manifest names $sha, which this machine rolled back ($(cut -d' ' -f2- "$ROOT/refused")); waiting for another build"
    exit 0
  fi
fi

dest="$ROOT/store/$sha"
if [ ! -x "$dest/optchat-chief" ]; then
  curl -fsSL --retry 3 --max-time 600 -o "$tmp/optchat-chief" "$url"
  got_size="$(stat -c %s "$tmp/optchat-chief")"
  got_sha="$(sha256sum "$tmp/optchat-chief" | cut -d' ' -f1)"
  if [ "$got_size" != "$size" ] || [ "$got_sha" != "$sha" ]; then
    log "download does not match the manifest (size $got_size/$size, sha256 $got_sha/$sha)"
    exit 1
  fi
  chmod 0755 "$tmp/optchat-chief"
  "$tmp/optchat-chief" --version >/dev/null
  install -d -m 0755 "$dest"
  mv "$tmp/optchat-chief" "$dest/optchat-chief"
fi
lock
old="$(readlink -f "$ROOT/current" 2>/dev/null || true)"
rm -rf "$TRIAL"
if [ "${1:-}" != "--if-missing" ] && [ -n "$old" ] && [ -x "$old" ]; then
  point "$ROOT/previous" "$old"
  mkdir "$TRIAL"
  echo "$sha" > "$TRIAL/sha"
fi
point "$ROOT/current" "$dest/optchat-chief"
log "current is now $sha ($("$ROOT/current" --version 2>/dev/null || echo '?'))${old:+, previous $old}"

if [ "${1:-}" != "--if-missing" ] && systemctl is-active --quiet "$UNIT"; then
  systemctl kill --kill-whom=main --signal=SIGUSR1 "$UNIT"
  log "asked $UNIT to restart between turns"
fi

# Keep the builds `current` and `previous` name; delete the other ones.
keep="$(basename "$(dirname "$(readlink -f "$ROOT/current")")")"
prev="$(basename "$(dirname "$(readlink -f "$ROOT/previous" 2>/dev/null || echo /none/none)")")"
for gone in "$ROOT"/store/*; do
  [ -e "$gone" ] || continue
  case "$(basename "$gone")" in "$keep" | "$prev") ;; *) rm -rf "$gone" ;; esac
done
