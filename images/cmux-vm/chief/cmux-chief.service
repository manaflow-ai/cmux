# The Cloud Chief's brain host on a cmux Cloud machine: `optchat-chief host --conversation-source cloud`.
# Installed disabled. It starts once the machine is paired (the install file exists) and someone runs
# `sudo systemctl enable --now cmux-chief.service`.
#
# Restart=always: the updater asks the host to stop between turns (SIGUSR1, exit 0); systemd then starts
# the new binary /var/lib/cmux-chief/current points at. Exit 2 is a configuration error (no daemon socket,
# no install file), so it does not spin.
#
# A build on trial (cmux-chief-update moved `current` to it): ExecStartPre stamps each start and ExecStopPost
# judges each exit, so a new build that crashes 3 times within 120 s of its starts, or exits 2 once, is rolled
# back to the build before it (cmux-chief-update's header has the rule and why those numbers).
[Unit]
Description=cmux Cloud Chief host (optchat-chief host --conversation-source cloud)
After=network-online.target cmux-host.service
Wants=network-online.target cmux-chief-update.timer
ConditionPathExists=/home/cmux/.cmux/chief/cloud/install.json
StartLimitIntervalSec=0

[Service]
Type=simple
User=cmux
Group=cmux
Environment=HOME=/home/cmux
Environment=OPTCHAT_CLOUD_INSTALL=/home/cmux/.cmux/chief/cloud/install.json
# The acpmux the host trusts as its socket peer (acpmux_peer.rs): the image's, the cmux-tui multicall binary.
Environment=ACPMUX_BIN=/opt/cmux/current/bin/acpmux
# Its own acpmux home: the host starts that daemon as its child. The machine's ~/.acpmux daemon makes
# itself not dumpable, so its /proc/PID/exe is hidden and acpmux_peer.rs admits only a daemon this host started.
Environment=ACPMUX_HOME=/home/cmux/.cmux/chief/acpmux
EnvironmentFile=-/etc/cmux/chief.env
# The owner's Claude credential for the Chief's turns (OPTCHAT_CHIEF_TURN_CREDENTIALS=1 and one token), root's
# 0600 file on tmpfs that machine.chief_start writes (cmux-cloud-api chief_turn.rs); absent: nothing changes.
# Keep this line and fallback_unit's (chief_machine.rs) the same.
EnvironmentFile=-/run/cmux-chief/turn.env
# First start on a machine whose image carries no build yet: fetch the newest one (root, the `+`).
ExecStartPre=+/usr/local/sbin/cmux-chief-update --if-missing
ExecStart=/usr/local/lib/cmux-chief/cmux-chief-host
# The host's acpmux daemon and the Chief's subagents (its agent hosts) live in this unit's cgroup. KillMode=process:
# a host that ends (an update's handoff, a crash) takes only its own process down; ExecStop stops the daemon
# (cmux-chief-host --stop: keeping its agents for the next daemon after a handoff or crash, ending them on a stop).
KillMode=process
ExecStop=-/usr/local/lib/cmux-chief/cmux-chief-host --stop
# The rollback judge (root, the `+`): systemd passes SERVICE_RESULT, EXIT_CODE and EXIT_STATUS.
ExecStopPost=+/usr/local/sbin/cmux-chief-update --after-exit
Restart=always
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=60
RestartPreventExitStatus=2
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
