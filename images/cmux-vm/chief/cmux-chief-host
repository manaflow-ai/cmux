#!/bin/sh
# cmux-chief.service's ExecStart: the daemon socket the image recorded at bake (/etc/cmux/daemon-socket)
# unless chief.env names one, then the host on whatever build /var/lib/cmux-chief/current points at.
#
# --stop (the unit's ExecStop, as cmux, with the unit's ACPMUX_HOME and ACPMUX_BIN): stop the host's acpmux daemon.
# KillMode=process leaves the daemon and its agent hosts alone when the host's process ends, so:
#   - the host exited on its own (systemd set EXIT_CODE: an update's handoff, or a crash): `daemon shutdown`
#     detaches the hosted agents, and the daemon the next host starts adopts them, so the Chief's subagents and
#     their turns survive an update or a rollback;
#   - a stop asked for (`systemctl stop`, the host still runs): `daemon shutdown --end-agents`, which ends them, as
#     the control-group kill did before.
# The next host cannot use the old daemon itself: it is not dumpable and not the host's own child (acpmux_peer.rs).
set -eu
if [ "${1:-}" = "--stop" ]; then
  bin="${ACPMUX_BIN:-/opt/cmux/current/bin/acpmux}"
  if [ -n "${EXIT_CODE:-}" ]; then
    echo "cmux-chief-host: host exited (${EXIT_CODE} ${EXIT_STATUS:-?}); stopping its acpmux daemon, keeping its agents for the next one"
    exec "$bin" daemon shutdown
  fi
  echo "cmux-chief-host: stop asked for; stopping its acpmux daemon and its agents"
  exec "$bin" daemon shutdown --end-agents
fi
sock="${CMUX_DAEMON_SOCKET:-}"
if [ -z "$sock" ] && [ -r /etc/cmux/daemon-socket ]; then
  sock="$(head -n 1 /etc/cmux/daemon-socket)"
fi
if [ -z "$sock" ]; then
  echo "cmux-chief-host: no daemon socket (/etc/cmux/daemon-socket is empty and CMUX_DAEMON_SOCKET is unset)" >&2
  exit 2
fi
exec /var/lib/cmux-chief/current host \
  --conversation-source cloud \
  --cloud-install "${OPTCHAT_CLOUD_INSTALL:-/home/cmux/.cmux/chief/cloud/install.json}" \
  --daemon-socket "$sock"
