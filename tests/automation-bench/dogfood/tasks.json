{
  "about": "Browser-use dogfood tasks on real public sites (plans/cmux-next/computer-use-lead.md section 5). Each task drives only `cmux browser TAB <verb>` (the surface agents get), never a private hook. No task signs in, pays or types a password. `steps` are verb argument lists; `{fixture}` is this folder. `check` is a page expression that must be truthy at the end. `needs` names the capability a task exercises, for the gap table.",
  "tasks": [
    {"id": "example-title", "needs": "navigate", "url": "https://example.com/",
     "steps": [], "check": "document.title === 'Example Domain'"},
    {"id": "hn-story-links", "needs": "snapshot", "url": "https://news.ycombinator.com/",
     "steps": [], "snapshot_check": {"min_refs": 30, "contains": ["link \"new\"", "link \"past\""]}},
    {"id": "hn-vote-arrow-named", "needs": "snapshot-names", "url": "https://news.ycombinator.com/",
     "steps": [], "snapshot_check": {"contains": ["link \"upvote\""]}},
    {"id": "hn-click-new", "needs": "click", "url": "https://news.ycombinator.com/",
     "steps": [["click", "a[href='newest']"], ["wait", "--url-contains", "newest", "--timeout-ms", "10000"]],
     "check": "location.pathname === '/newest'"},
    {"id": "wikipedia-search", "needs": "fill+press", "url": "https://en.wikipedia.org/wiki/Main_Page",
     "steps": [["fill", "input[name=search]", "Rust (programming language)"], ["press", "Enter", "--selector", "input[name=search]"],
               ["wait", "--url-contains", "Rust_(programming_language)", "--timeout-ms", "15000"]],
     "check": "document.querySelector('h1') && /Rust/.test(document.querySelector('h1').innerText)"},
    {"id": "wikipedia-headings", "needs": "snapshot", "url": "https://en.wikipedia.org/wiki/Terminal_emulator",
     "steps": [], "snapshot_check": {"full": true, "contains": ["heading \"Terminal emulator\""]}},
    {"id": "ddg-search", "needs": "fill+press", "url": "https://duckduckgo.com/",
     "steps": [["fill", "textarea[name=q], input[name=q]", "cmux terminal"], ["press", "Enter", "--selector", "textarea[name=q], input[name=q]"],
               ["wait", "--url-contains", "q=", "--timeout-ms", "15000"]],
     "check": "/[?&]q=cmux/.test(location.search)"},
    {"id": "github-issues-tab", "needs": "click", "url": "https://github.com/browser-use/browser-use",
     "steps": [["click", "a[data-tab-item=issues]"], ["wait", "--url-contains", "/issues", "--timeout-ms", "15000"]],
     "check": "/\\/issues/.test(location.pathname)"},
    {"id": "httpbin-form", "needs": "form", "url": "https://httpbin.org/forms/post",
     "steps": [["fill", "input[name=custname]", "Dog Food"], ["check", "input[value=medium]"], ["check", "input[value=bacon]"],
               ["click", "form button"], ["wait", "--text", "custname", "--timeout-ms", "15000"]],
     "check": "document.body.innerText.includes('Dog Food') && document.body.innerText.includes('bacon')"},
    {"id": "internet-checkboxes", "needs": "check", "url": "https://the-internet.herokuapp.com/checkboxes",
     "steps": [["check", "#checkboxes input:nth-of-type(1)"]],
     "check": "document.querySelectorAll('#checkboxes input')[0].checked"},
    {"id": "internet-dropdown", "needs": "select", "url": "https://the-internet.herokuapp.com/dropdown",
     "steps": [["select", "#dropdown", "2"]],
     "check": "document.querySelector('#dropdown').value === '2'"},
    {"id": "internet-dropdown-options-in-snapshot", "needs": "snapshot-select", "url": "https://the-internet.herokuapp.com/dropdown",
     "steps": [], "snapshot_check": {"contains": ["Option 2"]}},
    {"id": "internet-dynamic-loading", "needs": "wait", "url": "https://the-internet.herokuapp.com/dynamic_loading/1",
     "steps": [["click", "#start button"], ["wait", "--text", "Hello World!", "--timeout-ms", "15000"]],
     "check": "getComputedStyle(document.querySelector('#finish')).display !== 'none'"},
    {"id": "internet-dynamic-render", "needs": "wait", "url": "https://the-internet.herokuapp.com/dynamic_loading/2",
     "steps": [["click", "#start button"], ["wait", "#finish h4", "--timeout-ms", "15000"]],
     "check": "document.querySelector('#finish h4').innerText.includes('Hello World!')"},
    {"id": "internet-add-remove", "needs": "click", "url": "https://the-internet.herokuapp.com/add_remove_elements/",
     "steps": [["click", "button[onclick='addElement()']"], ["click", "button[onclick='addElement()']"], ["click", ".added-manually"]],
     "check": "document.querySelectorAll('.added-manually').length === 1"},
    {"id": "internet-key-press", "needs": "press", "url": "https://the-internet.herokuapp.com/key_presses",
     "steps": [["press", "A", "--selector", "#target"]],
     "check": "/You entered: A/.test(document.querySelector('#result').innerText)"},
    {"id": "internet-hover", "needs": "hover", "url": "https://the-internet.herokuapp.com/hovers",
     "steps": [["hover", ".figure:nth-of-type(1) img"]],
     "check": "getComputedStyle(document.querySelector('.figure .figcaption')).display !== 'none'"},
    {"id": "internet-shadow-dom-snapshot", "needs": "snapshot-shadow", "url": "https://the-internet.herokuapp.com/shadowdom",
     "steps": [], "snapshot_check": {"full": true, "contains": ["different text"]}},
    {"id": "internet-iframe-snapshot", "needs": "snapshot-iframe", "url": "https://the-internet.herokuapp.com/iframe",
     "steps": [], "snapshot_check": {"full": true, "contains": ["Your content goes here"]}},
    {"id": "internet-js-alert", "needs": "dialog", "url": "https://the-internet.herokuapp.com/javascript_alerts",
     "steps": [["click", "button[onclick='jsAlert()']"], ["wait", "--text", "You successfully clicked an alert", "--timeout-ms", "8000"]],
     "check": "document.querySelector('#result').innerText.includes('successfully')"},
    {"id": "internet-upload", "needs": "upload", "url": "https://the-internet.herokuapp.com/upload",
     "steps": [["upload", "#file-upload", "{fixture}/upload-fixture.txt"], ["click", "#file-submit"], ["wait", "--text", "File Uploaded!", "--timeout-ms", "15000"]],
     "check": "document.body.innerText.includes('upload-fixture.txt')"},
    {"id": "internet-new-window", "needs": "tabs", "url": "https://the-internet.herokuapp.com/windows",
     "steps": [["click", "a[href='/windows/new']"]],
     "tabs_check": {"url_contains": "/windows/new"}},
    {"id": "todomvc-add", "needs": "type+press", "url": "https://demo.playwright.dev/todomvc/",
     "steps": [["fill", ".new-todo", "dogfood one"], ["press", "Enter", "--selector", ".new-todo"],
               ["fill", ".new-todo", "dogfood two"], ["press", "Enter", "--selector", ".new-todo"],
               ["check", ".todo-list li:nth-child(1) .toggle"]],
     "check": "document.querySelectorAll('.todo-list li').length === 2 && document.querySelectorAll('.todo-list li.completed').length === 1"},
    {"id": "fresh-tab-wait", "needs": "wait-fresh-tab", "url": "https://example.org/", "fresh_tab": true,
     "steps": [["wait", "--load-state", "complete", "--timeout-ms", "10000"]],
     "check": "document.readyState === 'complete'"},
    {"id": "mdn-scroll-into-view", "needs": "scroll", "url": "https://developer.mozilla.org/en-US/docs/Web/HTML/Element/select",
     "steps": [["scroll-into-view", "#see_also"]],
     "check": "(() => { const r = document.querySelector('#see_also').getBoundingClientRect(); return r.top < innerHeight && r.bottom > 0; })()"}
  ]
}
