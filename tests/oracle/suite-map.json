{
 "schema": "cmux-oracle-suite-map-v1",
 "description": "Changed paths to the oracle suites they can change (p15-oracle-009). Read by scripts/cmux-next/oracle/select_suites.py, which documents the format; `select_suites.py check` lints this file against the tree. Built-in rules select the corpus, expectations and baselines of tests/oracle case by case.",
 "products": {
  "daemon": {
   "suites": ["daemon-ops"],
   "cargo_roots": ["cmux-tui/crates/cmux-tui"]
  },
  "mcp": {
   "suites": ["mcp"],
   "cargo_roots": ["cmux-tui/crates/cmux-tui"]
  },
  "app": {
   "suites": ["actions", "ax", "e2e", "entrypoints"],
   "cargo_roots": [
    "cmux-tui/crates/cmux-tui",
    "cmux-tui/crates/cmux-app-ffi",
    "cmux-tui/crates/cmux-layout-reducer-ffi",
    "cmux-tui/crates/cmux-app-host",
    "cmux-tui/crates/cmux-browser-host",
    "cmux-tui/crates/cmux-holder",
    "cmux-tui/crates/acpmux"
   ]
  }
 },
 "cargo": {
  "scope": ["cmux-tui/**"],
  "not_linked": ["tests", "benches", "examples"],
  "reason": "a product binary is built from it (normal or build path dependency of a cargo root)"
 },
 "rules": [
  {
   "id": "oracle-run-path",
   "paths": [
    "scripts/cmux-next/oracle/**",
    "scripts/measure/oracle.sh",
    "schemas/oracle/**",
    "plans/cmux-next/refactor-switches/**",
    "tests/oracle/fixtures/**"
   ],
   "except": [
    "scripts/cmux-next/oracle/**/*_test.py",
    "scripts/cmux-next/oracle/selftest.py",
    "scripts/cmux-next/oracle/gen_*.py",
    "scripts/cmux-next/oracle/select_suites.py",
    "scripts/cmux-next/oracle/bisect_case.py",
    "scripts/cmux-next/oracle/driver_*.py",
    "scripts/cmux-next/oracle/fleet.py",
    "**/*.md"
   ],
   "products": ["all"],
   "reason": "the runner, normalizer, comparison, case schema, switch registry and fixtures are on every product's run path"
  },
  {
   "id": "driver-daemon",
   "paths": ["scripts/cmux-next/oracle/driver_daemon.py"],
   "products": ["daemon", "mcp"],
   "reason": "the daemon driver runs the daemon cases, and driver_mcp runs each mcp case through its case worker"
  },
  {
   "id": "driver-mcp",
   "paths": ["scripts/cmux-next/oracle/driver_mcp.py", "scripts/cmux-next/oracle/driver_cli.py"],
   "products": ["mcp"],
   "reason": "the mcp driver, and the cli driver whose binary and receipts it imports"
  },
  {
   "id": "driver-app",
   "paths": [
    "scripts/cmux-next/oracle/driver_app.py",
    "scripts/cmux-next/oracle/driver_app_v0.py",
    "scripts/cmux-next/oracle/fleet.py"
   ],
   "products": ["app"],
   "reason": "the app driver and the fleet runner of app shards"
  },
  {
   "id": "rust-workspace",
   "paths": [
    "cmux-tui/Cargo.toml",
    "cmux-tui/Cargo.lock",
    "cmux-tui/rust-toolchain.toml",
    "cmux-tui/.cargo/**",
    "cmux-tui/build-support/**",
    "cmux-tui/vendor/**",
    "cmux-tui/spec/**"
   ],
   "except": ["**/*.md"],
   "products": ["daemon", "mcp", "app"],
   "reason": "workspace manifest, lock, toolchain, vendored patches and the operation spec reach every Rust product"
  },
  {
   "id": "ghostty-next",
   "paths": ["ghostty-next"],
   "products": ["daemon", "mcp", "app"],
   "reason": "ghostty-vt-sys builds libghostty-vt from this submodule; the daemon and the app terminal run it"
  },
  {
   "id": "ghostty",
   "paths": ["ghostty"],
   "products": ["app"],
   "reason": "GhosttyKit for the app's terminal views comes from this submodule"
  },
  {
   "id": "swift-app",
   "paths": ["Packages/macOS/**", "Packages/Shared/**"],
   "except": ["Packages/*/*/Tests/**", "**/*.md"],
   "products": ["app"],
   "reason": "the macOS app's Swift packages"
  },
  {
   "id": "webviews",
   "paths": ["webviews/**"],
   "except": ["**/*.md"],
   "products": ["app"],
   "reason": "the app's web pages (pane protocol, palette, settings)"
  },
  {
   "id": "features",
   "paths": ["schemas/features/**"],
   "except": ["**/*.md"],
   "products": ["all"],
   "reason": "feature defaults are read by the app and the daemon at launch"
  }
 ],
 "ignore": [
  {
   "id": "oracle-tooling",
   "paths": [
    "scripts/cmux-next/oracle/**/*_test.py",
    "scripts/cmux-next/oracle/selftest.py",
    "scripts/cmux-next/oracle/gen_*.py",
    "scripts/cmux-next/oracle/select_suites.py",
    "scripts/cmux-next/oracle/bisect_case.py",
    "tests/oracle/suite-map.json",
    "tests/oracle/blocked/**",
    "tests/oracle/gap-closures/**",
    "tests/oracle/mutants/**",
    "tests/oracle/task-mutants/**"
   ],
   "reason": "tooling tests, selection and generator inputs: no run reads them; a regenerated case is selected by the corpus rule"
  },
  {
   "id": "prose",
   "paths": ["**/*.md", "docs/**", "plans/**"],
   "reason": "prose; no product reads it at run time"
  },
  {
   "id": "other-clients",
   "paths": ["web/**", "ios/**", "Packages/iOS/**", "cmux-next-ios/**", "backend/**", "workers/**", "services/**"],
   "reason": "server and iOS code; no oracle product runs it"
  },
  {
   "id": "tui-frontends",
   "paths": ["cmux-tui/frontends/**"],
   "reason": "the TUI web frontend; no suite of this map runs the tui product yet (p15-oracle-234)"
  },
  {
   "id": "ci-and-agents",
   "paths": [".github/**", ".claude/**", ".codex/**", ".agents/**", "scripts/ci/**", "skills/**"],
   "reason": "CI and agent configuration; the oracle runs no CI and its products do not read these"
  },
  {
   "id": "cmux-next-dev-tools",
   "paths": [
    "scripts/cmux-next/tests/**",
    "scripts/cmux-next/check-*",
    "scripts/cmux-next/test-*.sh",
    "scripts/cmux-next/bench-*.py",
    "scripts/cmux-next/bench_*.py",
    "scripts/cmux-next/perf-*.py",
    "scripts/cmux-next/*-audit.py",
    "scripts/cmux-next/guardrails*.py",
    "scripts/cmux-next/prepush-gate.py",
    "scripts/cmux-next/lint/**",
    "scripts/cmux-next/ext-conformance/**",
    "scripts/cmux-next/media/**",
    "scripts/cmux-next/release/**"
   ],
   "reason": "checks, linters, benches, media and release tooling; an oracle run neither builds nor executes them"
  },
  {
   "id": "other-tests",
   "paths": ["tests/**", "tests_v2/**", "Packages/*/*/Tests/**"],
   "except": ["tests/oracle/**"],
   "reason": "test suites outside the oracle; not built into a product"
  }
 ],
 "unmapped": "all"
}
