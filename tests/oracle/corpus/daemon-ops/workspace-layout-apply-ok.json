{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "workspace-layout-apply-ok",
  "suite": "daemon-ops",
  "title": "workspace.layout.apply: success on the standard fixture",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.workspace-layout-apply",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "workspace-layout-apply-ok.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "call",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.layout.apply",
        "params": {
          "layout": {
            "version": 1,
            "screen_id": "$step:fx-workspace#/value/screen_id",
            "active_pane_id": "$step:fx-workspace#/value/pane_id",
            "zoomed_pane_id": "$step:fx-workspace#/value/pane_id",
            "root": {
              "kind": "leaf",
              "pane_id": "$step:fx-workspace#/value/pane_id",
              "tab_ids": [
                "$step:fx-workspace#/value/tab_id"
              ]
            }
          }
        },
        "idempotencyKey": "workspace-layout-apply-ok.call"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "every required field from its catalog type"
    },
    {
      "id": "retry",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.layout.apply",
        "params": {
          "layout": {
            "version": 1,
            "screen_id": "$step:fx-workspace#/value/screen_id",
            "active_pane_id": "$step:fx-workspace#/value/pane_id",
            "zoomed_pane_id": "$step:fx-workspace#/value/pane_id",
            "root": {
              "kind": "leaf",
              "pane_id": "$step:fx-workspace#/value/pane_id",
              "tab_ids": [
                "$step:fx-workspace#/value/tab_id"
              ]
            }
          }
        },
        "idempotencyKey": "workspace-layout-apply-ok.call"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "I10: step call again with its idempotency key; the daemon replays its reply, adds no journal record and changes no facet"
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_daemon_ops.py from the catalog type of workspace.layout.apply (family workspace)"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
