{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "screen-update-ok",
  "suite": "daemon-ops",
  "title": "screen.update: success on the standard fixture",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.screen-update",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "screen-update-ok.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "call",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "screen": "$step:fx-workspace#/value/screen_id"
      },
      "args": {
        "method": "screen.update",
        "params": {
          "pinned": true,
          "color": "#336699"
        },
        "idempotencyKey": "screen-update-ok.call"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "pinned and color change in one commit"
    },
    {
      "id": "pinned",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/screens/0/extra/pinned",
        "equals": true,
        "maxMs": 5000
      },
      "settleMaxMs": 5000
    },
    {
      "id": "colored",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/screens/0/extra/color",
        "equals": "#336699",
        "maxMs": 5000
      },
      "settleMaxMs": 5000
    },
    {
      "id": "retry",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "screen": "$step:fx-workspace#/value/screen_id"
      },
      "args": {
        "method": "screen.update",
        "params": {
          "pinned": true,
          "color": "#336699"
        },
        "idempotencyKey": "screen-update-ok.call"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "I10: step call again with its idempotency key; the daemon replays its reply, adds no journal record and changes no facet"
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_daemon_ops.py from the catalog type of screen.update (family layout)"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
