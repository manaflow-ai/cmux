{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "screen-update-error",
  "suite": "daemon-ops",
  "title": "screen.update: typed error on the standard fixture",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.screen-update",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "screen-update-error.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "call",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "screen": "$step:fx-workspace#/value/screen_id"
      },
      "args": {
        "method": "screen.update",
        "params": {
          "pinned": true,
          "color": "not a color"
        },
        "idempotencyKey": "screen-update-error.call"
      },
      "expect": {
        "outcome": "error",
        "error": "validation.invalid",
        "errorDetails": {
          "reason": "color must be a palette token ([a-z][a-z0-9-]{0,31}) or #RRGGBB[AA]"
        }
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "a color that is no palette token and no hex color: validation.invalid, and the valid pinned of the same request is not written either"
    },
    {
      "id": "not-pinned",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/screens/0/extra/pinned",
        "predicate": "absent",
        "maxMs": 5000
      },
      "settleMaxMs": 5000
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_daemon_ops.py from the catalog type of screen.update (family layout)"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
