{
  "$comment": "p15-oracle-062: the sidebar family (sidebar, sidebar_layout, sidebar_view; 22 mutations) on the daemon's default sidebar document (itm_home, itm_app_store, itm_account; sec_top, sec_pinned, sec_recents, sec_bottom). Item and section ids are fixed by the case, so no placeholder is left. Errors are the reducer's own refusals (validation.invalid with its reason, nothing written) or the view's typed errors; sidebar.reset has no field to refuse, so its error stays the catalog check. A sidebar view needs a sidebar plugin: the case writes one (/bin/cat) into the daemon's config file from a terminal and reloads the config, the only way a running case daemon gets one. oracle-remote is another machine: adopting its workspace makes a machine section and a workspace item with a known id.",
  "operations": {
    "sidebar.adopt": {
      "success": {
        "params": {
          "refs": [
            {
              "session_id": "oracle-remote",
              "workspace_id": "ws_0123456789abcdef0123456789abcdef"
            }
          ]
        },
        "note": "a workspace of another machine gets that machine's section and lands at its end"
      },
      "error": {
        "error": "validation.invalid",
        "params": {
          "to": {
            "section": "sec_oracle_missing"
          }
        },
        "note": "the sidebar reducer refuses it (unknown_section) and writes nothing: the target section does not exist"
      }
    },
    "sidebar.apply": {
      "success": {
        "params": {
          "ops": [
            {
              "op": "section.add",
              "section": {
                "id": "sec_oracle",
                "kind": {
                  "type": "custom"
                },
                "title": "Oracle"
              }
            },
            {
              "op": "move",
              "items": [
                "itm_app_store"
              ],
              "to": {
                "section": "sec_oracle"
              }
            }
          ]
        },
        "note": "two reducer ops commit as one: a new custom section and an item moved into it"
      },
      "error": {
        "error": "validation.invalid",
        "params": {
          "ops": [
            {
              "op": "section.add",
              "section": {
                "id": "sec_oracle",
                "kind": {
                  "type": "custom"
                },
                "title": "Oracle"
              }
            },
            {
              "op": "section.remove",
              "id": "sec_oracle_missing"
            }
          ]
        },
        "note": "the sidebar reducer refuses it (unknown_section) and writes nothing: the second op fails, so the section the first one adds is not written either"
      }
    },
    "sidebar.group.create": {
      "success": {
        "params": {
          "id": "itm_oracle_group",
          "name": "oracle",
          "items": [
            "itm_app_store"
          ]
        },
        "note": "the group takes the place of its first item, which moves into it"
      },
      "error": {
        "error": "validation.invalid",
        "params": {
          "items": null
        },
        "note": "the sidebar reducer refuses it (invalid_target) and writes nothing: a group with no items needs a target"
      }
    },
    "sidebar.group.ungroup": {
      "success": {
        "before": [
          {
            "id": "make-group",
            "method": "sidebar.group.create",
            "params": {
              "id": "itm_oracle_group",
              "name": "oracle",
              "items": [
                "itm_app_store"
              ]
            }
          }
        ],
        "params": {
          "id": "itm_oracle_group"
        },
        "note": "the group's item takes its place and the group goes"
      },
      "error": {
        "error": "validation.invalid",
        "params": {
          "id": "itm_home"
        },
        "note": "the sidebar reducer refuses it (invalid_value) and writes nothing: itm_home is an app item, not a group",
        "before": []
      }
    },
    "sidebar.group.update": {
      "success": {
        "before": [
          {
            "id": "make-group",
            "method": "sidebar.group.create",
            "params": {
              "id": "itm_oracle_group",
              "name": "oracle",
              "items": [
                "itm_app_store"
              ]
            }
          }
        ],
        "params": {
          "id": "itm_oracle_group",
          "patch": {
            "name": "renamed",
            "color": "#336699",
            "collapsed": true
          }
        },
        "note": "name, color and collapsed of a group change in one commit"
      },
      "error": {
        "error": "validation.invalid",
        "params": {
          "id": "itm_home"
        },
        "note": "the sidebar reducer refuses it (invalid_value) and writes nothing: itm_home is an app item, not a group",
        "before": []
      }
    },
    "sidebar.item.add": {
      "success": {
        "params": {
          "item": {
            "id": "itm_oracle_url",
            "body": {
              "type": "url",
              "url": "http://127.0.0.1:9/",
              "title": "oracle"
            }
          },
          "to": {
            "section": "sec_top"
          }
        },
        "note": "a url item lands at the end of the top section"
      },
      "error": {
        "error": "validation.invalid",
        "params": {
          "to": {
            "section": "sec_oracle_missing"
          }
        },
        "note": "the sidebar reducer refuses it (unknown_section) and writes nothing: the target section does not exist"
      }
    },
    "sidebar.item.remove": {
      "success": {
        "params": {
          "id": "itm_app_store"
        },
        "note": "a default item of the top section goes"
      },
      "error": {
        "error": "validation.invalid",
        "params": {
          "id": "itm_oracle_missing"
        },
        "note": "the sidebar reducer refuses it (unknown_item) and writes nothing"
      }
    },
    "sidebar.item.remove_ref": {
      "success": {
        "params": {
          "ref": {
            "kind": "app",
            "value": "cmux/home"
          }
        },
        "note": "every item that shows the Home app goes (Remove from Sidebar)"
      },
      "error": {
        "error": "validation.invalid",
        "params": {
          "ref": {
            "kind": "app",
            "value": "cmux/oracle-missing"
          }
        },
        "note": "the sidebar reducer refuses it (unknown_item) and writes nothing: no item shows the ref"
      }
    },
    "sidebar.item.update": {
      "success": {
        "params": {
          "id": "itm_home",
          "patch": {
            "shows_label": false,
            "label": "oracle"
          }
        },
        "note": "the Home item hides its label and gets a custom label"
      },
      "error": {
        "error": "validation.invalid",
        "params": {
          "patch": {
            "title": "oracle"
          }
        },
        "note": "the sidebar reducer refuses it (invalid_value) and writes nothing: a title is a url item's, not an app item's"
      }
    },
    "sidebar.move": {
      "success": {
        "params": {
          "items": [
            "itm_app_store"
          ],
          "to": {
            "section": "sec_top",
            "before": "itm_home"
          }
        },
        "note": "the App Store item moves before Home in its own section"
      },
      "error": {
        "error": "validation.invalid",
        "params": {
          "items": [
            "itm_oracle_missing"
          ]
        },
        "note": "the sidebar reducer refuses it (unknown_item) and writes nothing"
      }
    },
    "sidebar.pin": {
      "success": {
        "params": {
          "items": [
            "itm_home"
          ]
        },
        "note": "Home moves to the end of Pinned"
      },
      "error": {
        "error": "validation.invalid",
        "params": {
          "items": [
            "itm_oracle_missing"
          ]
        },
        "note": "the sidebar reducer refuses it (unknown_item) and writes nothing"
      }
    },
    "sidebar.unpin": {
      "success": {
        "before": [
          {
            "id": "adopt-remote",
            "method": "sidebar.adopt",
            "params": {
              "refs": [
                {
                  "session_id": "oracle-remote",
                  "workspace_id": "ws_0123456789abcdef0123456789abcdef"
                }
              ]
            }
          },
          {
            "id": "pin-remote",
            "method": "sidebar.pin",
            "params": {
              "items": [
                "itm_w_oracle-remote_ws_0123456789abcdef0123456789abcdef"
              ]
            }
          }
        ],
        "params": {
          "items": [
            "itm_w_oracle-remote_ws_0123456789abcdef0123456789abcdef"
          ]
        },
        "note": "a pinned workspace goes back to the end of its machine section"
      },
      "error": {
        "error": "validation.invalid",
        "params": {
          "items": [
            "itm_home"
          ]
        },
        "note": "the sidebar reducer refuses it (no_machine) and writes nothing: an app item has no machine section to go back to",
        "before": []
      }
    },
    "sidebar.reset": {
      "success": {
        "before": [
          {
            "id": "remove-home",
            "method": "sidebar.item.remove",
            "params": {
              "id": "itm_home"
            }
          },
          {
            "id": "add-section",
            "method": "sidebar.section.add",
            "params": {
              "section": {
                "id": "sec_oracle",
                "kind": {
                  "type": "custom"
                },
                "title": "Oracle"
              }
            }
          }
        ],
        "note": "the default sections come back: Home returns to the top and the custom section goes"
      },
      "error": {
        "before": []
      }
    },
    "sidebar.section.add": {
      "success": {
        "params": {
          "section": {
            "id": "sec_oracle",
            "kind": {
              "type": "custom"
            },
            "title": "Oracle"
          },
          "place": {
            "region": "top",
            "index": 0
          }
        },
        "note": "a custom section lands first in the top region"
      },
      "error": {
        "error": "validation.invalid",
        "params": {
          "section": {
            "id": "sec_top",
            "kind": {
              "type": "custom"
            }
          },
          "place": null
        },
        "note": "the sidebar reducer refuses it (duplicate_id) and writes nothing: sec_top already exists"
      }
    },
    "sidebar.section.move": {
      "success": {
        "params": {
          "id": "sec_top",
          "place": {
            "after": "sec_pinned"
          }
        },
        "note": "the top section moves after Pinned in its region"
      },
      "error": {
        "error": "validation.invalid",
        "params": {
          "id": "sec_oracle_missing"
        },
        "note": "the sidebar reducer refuses it (unknown_section) and writes nothing"
      }
    },
    "sidebar.section.remove": {
      "success": {
        "params": {
          "id": "sec_recents"
        },
        "note": "the recent agent chats section goes"
      },
      "error": {
        "error": "validation.invalid",
        "params": {
          "id": "sec_m_oracle-remote"
        },
        "note": "the sidebar reducer refuses it (machine_required) and writes nothing: a machine section cannot be removed",
        "before": [
          {
            "id": "adopt-remote",
            "method": "sidebar.adopt",
            "params": {
              "refs": [
                {
                  "session_id": "oracle-remote",
                  "workspace_id": "ws_0123456789abcdef0123456789abcdef"
                }
              ]
            }
          }
        ]
      }
    },
    "sidebar.section.update": {
      "success": {
        "params": {
          "id": "sec_top",
          "patch": {
            "title": "Oracle",
            "gap": 4
          }
        },
        "note": "the top section gets a title and a 4-point gap"
      },
      "error": {
        "error": "validation.invalid",
        "params": {
          "patch": {
            "gap": 99
          }
        },
        "note": "the sidebar reducer refuses it (invalid_value) and writes nothing: a gap is 0 to 32 points"
      }
    },
    "sidebar_layout.update": {
      "success": {
        "params": {
          "op": {
            "kind": "item.update",
            "id": "itm_account",
            "shows_label": true
          }
        },
        "note": "the old layout reducer shows the account item's label"
      },
      "error": {
        "error": "validation.invalid",
        "params": {
          "op": {
            "kind": "item.remove",
            "id": "itm_oracle_missing"
          }
        },
        "note": "the sidebar reducer refuses it (unknown_item) and writes nothing: the old layout reducer finds no such item"
      }
    },
    "sidebar_view.ensure": {
      "success": {
        "before": [
          {
            "id": "write-config",
            "method": "workspace.create",
            "params": {
              "initial_content": "terminal",
              "name": "config",
              "argv": [
                "/bin/sh",
                "-c",
                "printf '%s\\n' \"$0\" > \"$CMUX_TUI_CONFIG\"",
                "{\"sidebar\":{\"plugin\":{\"command\":[\"/bin/cat\"]}}}"
              ]
            }
          },
          {
            "id": "config-written",
            "waitFor": {
              "pointer": "/daemon/session/terminals/0/lifecycle",
              "equals": "exited",
              "maxMs": 15000
            }
          },
          {
            "id": "reload-config",
            "method": "session.reload_config",
            "params": {}
          }
        ],
        "note": "with a sidebar plugin configured, the view starts at 80x24"
      },
      "error": {
        "error": "operation.failed",
        "before": [],
        "note": "the case daemon has no sidebar plugin configured, so there is no view to start"
      }
    },
    "sidebar_view.input": {
      "success": {
        "before": [
          {
            "id": "write-config",
            "method": "workspace.create",
            "params": {
              "initial_content": "terminal",
              "name": "config",
              "argv": [
                "/bin/sh",
                "-c",
                "printf '%s\\n' \"$0\" > \"$CMUX_TUI_CONFIG\"",
                "{\"sidebar\":{\"plugin\":{\"command\":[\"/bin/cat\"]}}}"
              ]
            }
          },
          {
            "id": "config-written",
            "waitFor": {
              "pointer": "/daemon/session/terminals/0/lifecycle",
              "equals": "exited",
              "maxMs": 15000
            }
          },
          {
            "id": "reload-config",
            "method": "session.reload_config",
            "params": {}
          },
          {
            "id": "ensure-view",
            "method": "sidebar_view.ensure",
            "params": {
              "cols": 80,
              "rows": 24
            }
          }
        ],
        "target": {
          "sidebar_view": "$step:ensure-view#/value/id"
        },
        "note": "bytes reach the running sidebar view"
      },
      "error": {
        "error": "selector.not_found",
        "before": [],
        "target": {
          "sidebar_view": "sidebar"
        },
        "note": "no view was started (no plugin), so the sidebar view selector matches nothing"
      }
    },
    "sidebar_view.reload": {
      "success": {
        "before": [
          {
            "id": "write-config",
            "method": "workspace.create",
            "params": {
              "initial_content": "terminal",
              "name": "config",
              "argv": [
                "/bin/sh",
                "-c",
                "printf '%s\\n' \"$0\" > \"$CMUX_TUI_CONFIG\"",
                "{\"sidebar\":{\"plugin\":{\"command\":[\"/bin/cat\"]}}}"
              ]
            }
          },
          {
            "id": "config-written",
            "waitFor": {
              "pointer": "/daemon/session/terminals/0/lifecycle",
              "equals": "exited",
              "maxMs": 15000
            }
          },
          {
            "id": "reload-config",
            "method": "session.reload_config",
            "params": {}
          },
          {
            "id": "ensure-view",
            "method": "sidebar_view.ensure",
            "params": {
              "cols": 80,
              "rows": 24
            }
          }
        ],
        "target": {
          "sidebar_view": "$step:ensure-view#/value/id"
        },
        "note": "the running sidebar view restarts"
      },
      "error": {
        "error": "selector.not_found",
        "before": [],
        "target": {
          "sidebar_view": "sidebar"
        },
        "note": "no view was started (no plugin), so the sidebar view selector matches nothing"
      }
    },
    "sidebar_view.resize": {
      "success": {
        "before": [
          {
            "id": "write-config",
            "method": "workspace.create",
            "params": {
              "initial_content": "terminal",
              "name": "config",
              "argv": [
                "/bin/sh",
                "-c",
                "printf '%s\\n' \"$0\" > \"$CMUX_TUI_CONFIG\"",
                "{\"sidebar\":{\"plugin\":{\"command\":[\"/bin/cat\"]}}}"
              ]
            }
          },
          {
            "id": "config-written",
            "waitFor": {
              "pointer": "/daemon/session/terminals/0/lifecycle",
              "equals": "exited",
              "maxMs": 15000
            }
          },
          {
            "id": "reload-config",
            "method": "session.reload_config",
            "params": {}
          },
          {
            "id": "ensure-view",
            "method": "sidebar_view.ensure",
            "params": {
              "cols": 80,
              "rows": 24
            }
          }
        ],
        "target": {
          "sidebar_view": "$step:ensure-view#/value/id"
        },
        "params": {
          "cols": 40,
          "rows": 10
        },
        "note": "the running sidebar view resizes to 40x10"
      },
      "error": {
        "error": "operation.failed",
        "before": [],
        "target": {
          "sidebar_view": "sidebar"
        },
        "note": "no sidebar plugin is configured, so there is no view to resize"
      }
    }
  }
}
