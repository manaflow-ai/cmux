{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "browser-input-mouse-ok",
  "suite": "daemon-ops",
  "title": "browser.input.mouse: success on the standard fixture",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.browser-input-mouse",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root",
    "a cmux-browser provider attached to the case daemon (the daemon launches no browser)"
  ],
  "requires": [
    "resource_api",
    "chromium"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "browser-input-mouse-ok.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "fx-browser",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id",
        "screen": "$step:fx-workspace#/value/screen_id",
        "pane": "$step:fx-workspace#/value/pane_id"
      },
      "args": {
        "method": "tab.create_browser",
        "params": {
          "url": "about:blank"
        },
        "idempotencyKey": "browser-input-mouse-ok.fx-browser"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "wait-live",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/browsers/0/status",
        "equals": "live",
        "maxMs": 15000
      },
      "settleMaxMs": 15000
    },
    {
      "id": "call",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "browser": "$step:fx-browser#/value/browser_id"
      },
      "args": {
        "method": "browser.input.mouse",
        "params": {
          "kind": "move",
          "x_px": 10.0,
          "y_px": 10.0,
          "pointer_frame_seq": "1"
        },
        "idempotencyKey": "browser-input-mouse-ok.call"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "a pointer move on the live page"
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_daemon_ops.py from the catalog type of browser.input.mouse (family browser)"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ],
  "untested": [
    "params.pointer_frame_seq must be the token of the browser.attach frame the coordinates came from; the case has no stream step to read one (streams are p15-oracle-204), so the daemon refuses the fixed token until the case reads it from a frame"
  ]
}
