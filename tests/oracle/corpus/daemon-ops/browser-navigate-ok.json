{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "browser-navigate-ok",
  "suite": "daemon-ops",
  "title": "browser.navigate: success on the standard fixture",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.browser-navigate",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root",
    "a cmux-browser provider attached to the case daemon (the daemon launches no browser)"
  ],
  "requires": [
    "resource_api",
    "chromium"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "browser-navigate-ok.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "fx-browser",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id",
        "screen": "$step:fx-workspace#/value/screen_id",
        "pane": "$step:fx-workspace#/value/pane_id"
      },
      "args": {
        "method": "tab.create_browser",
        "params": {
          "url": "about:blank"
        },
        "idempotencyKey": "browser-navigate-ok.fx-browser"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "wait-live",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/browsers/0/status",
        "equals": "live",
        "maxMs": 15000
      },
      "settleMaxMs": 15000
    },
    {
      "id": "call",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "browser": "$step:fx-browser#/value/browser_id"
      },
      "args": {
        "method": "browser.navigate",
        "params": {
          "url": "data:text/html,oracle"
        },
        "idempotencyKey": "browser-navigate-ok.call"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "the navigation commits and the browser's url is the data URL (offline: no network)"
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_daemon_ops.py from the catalog type of browser.navigate (family browser)"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
