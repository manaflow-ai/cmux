{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "terminal-move-error",
  "suite": "daemon-ops",
  "title": "terminal.move: typed error on the standard fixture",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.terminal-move",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "terminal-move-error.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "call",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:fx-workspace#/value/terminal_id"
      },
      "args": {
        "method": "terminal.move",
        "params": {
          "destination_workspace": "$step:fx-workspace#/value/workspace_id",
          "destination_screen": "$step:fx-workspace#/value/screen_id",
          "destination_pane": "pane_00000000000000000000000000000000",
          "index": 0
        },
        "idempotencyKey": "terminal-move-error.call"
      },
      "expect": {
        "outcome": "error",
        "error": "selector.not_found",
        "errorDetails": {
          "scope": "pane",
          "selector": "pane_00000000000000000000000000000000"
        }
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "a well-formed pane id that names no pane: the terminal stays where it is"
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_daemon_ops.py from the catalog type of terminal.move (family terminal)"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
