{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "terminal-holder-crash-old",
  "suite": "daemon-ops",
  "title": "Terminal holder crash journey, per-terminal host arm: an abort and a SIGKILL mid-output give the documented host-loss record",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.terminal-holder-crash-old",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api",
    "restart"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "allow_crashes": [
    {
      "kind": "holder",
      "reason": "abort ends the terminal host on purpose (its crash seam)",
      "steps": [
        "abort"
      ]
    },
    {
      "kind": "holder",
      "reason": "kill ends the terminal host on purpose (SIGKILL)",
      "steps": [
        "kill"
      ]
    }
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "terminal-holder-crash-old.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "arm",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:fx-workspace#/value/terminal_id"
      },
      "args": {
        "method": "terminal.input.write",
        "params": {
          "text": "printf '\\033[H\\033[2J\\033[3J'; i=0; while [ $i -lt 30 ]; do i=$((i+1)); echo line-$i; done; stty raw -echo; printf 'X\\033]2;oracle-armed\\007\\033[38;5;1'; dd bs=1 count=1 >/dev/null 2>&1; printf '96mRED\\033]2;oracle-second\\007\\303'; dd bs=1 count=1 >/dev/null 2>&1; printf '\\251 END\\033[0m\\r\\n\\033]2;oracle-done\\007'; exec cat\r"
        },
        "idempotencyKey": "terminal-holder-crash-old.arm"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "the program prints 30 lines and stops inside the SGR `ESC [ 38;5;1`"
    },
    {
      "id": "armed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:4871df02e32ffadd7e963d3b761f4735b39899515988a92af0d05c3d33e2b75d",
        "maxMs": 15000
      },
      "settleMaxMs": 15000
    },
    {
      "id": "view-1",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:fx-workspace#/value/terminal_id"
      },
      "args": {
        "method": "terminal.get",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "abort",
      "op": "kill",
      "target": {
        "process": "holder"
      },
      "args": {
        "signal": "ABRT"
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a killed process sends no reply; the driver's reply is the daemon's record of each ended terminal host",
        "result": {
          "signal": "ABRT",
          "process": "holder",
          "ended": [
            "terminal-host"
          ],
          "records": [
            {
              "crash": {
                "message": "test-injected host crash",
                "thread": "terminal-host-test-crash"
              },
              "end": {
                "detail": "terminal host ended without a durable exit sidecar",
                "kind": "host_lost",
                "reason": "died_without_exit_status"
              },
              "signals": [],
              "summary": {
                "panicked": true
              }
            }
          ]
        },
        "resultExcept": [
          "/records/*/at_ms",
          "/records/*/incarnation",
          "/records/*/terminal_id",
          "/records/*/cause",
          "/records/*/crash/at_ms",
          "/records/*/crash/backtrace",
          "/records/*/crash/host_pid",
          "/records/*/crash/incarnation",
          "/records/*/crash/location",
          "/records/*/crash/terminal_id"
        ]
      },
      "note": "the host's crash seam: it panics and aborts while the parser is inside the SGR"
    },
    {
      "id": "respawned",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/lifecycle",
        "equals": "running",
        "maxMs": 15000
      },
      "settleMaxMs": 15000,
      "note": "the daemon gives the terminal a new shell"
    },
    {
      "id": "view-2",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:fx-workspace#/value/terminal_id"
      },
      "args": {
        "method": "terminal.get",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok",
        "result": "$step:view-1#",
        "resultExcept": [
          "/cwd",
          "/extra",
          "/stream_revision"
        ]
      },
      "note": "the same terminal, title and size; the new shell starts in its own folder and its own output stream"
    },
    {
      "id": "rearm",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:fx-workspace#/value/terminal_id"
      },
      "args": {
        "method": "terminal.input.write",
        "params": {
          "text": "printf '\\033[H\\033[2J\\033[3J'; i=0; while [ $i -lt 30 ]; do i=$((i+1)); echo line-$i; done; stty raw -echo; printf 'X\\033]2;oracle-rearmed\\007\\033[38;5;1'; dd bs=1 count=1 >/dev/null 2>&1; printf '96mRED\\033]2;oracle-second\\007\\303'; dd bs=1 count=1 >/dev/null 2>&1; printf '\\251 END\\033[0m\\r\\n\\033]2;oracle-done\\007'; exec cat\r"
        },
        "idempotencyKey": "terminal-holder-crash-old.rearm"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "rearmed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:59409f55468bc51b986cb37aeae91763bbb7f5913fe9e111301b29b01887ccfd",
        "maxMs": 15000
      },
      "settleMaxMs": 15000
    },
    {
      "id": "view-3",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:fx-workspace#/value/terminal_id"
      },
      "args": {
        "method": "terminal.get",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "kill",
      "op": "kill",
      "target": {
        "process": "holder"
      },
      "args": {
        "signal": "KILL"
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a killed process sends no reply; the driver's reply is the daemon's record of each ended terminal host",
        "result": {
          "signal": "KILL",
          "process": "holder",
          "ended": [
            "terminal-host"
          ],
          "records": [
            {
              "cause": "no catchable signal recorded: SIGKILL, a crash, or memory pressure",
              "crash": null,
              "end": {
                "detail": "terminal host ended without a durable exit sidecar",
                "kind": "host_lost",
                "reason": "died_without_exit_status"
              },
              "signals": [],
              "summary": null
            }
          ]
        },
        "resultExcept": [
          "/records/*/at_ms",
          "/records/*/incarnation",
          "/records/*/terminal_id"
        ]
      },
      "note": "SIGKILL of the new shell's host inside the SGR"
    },
    {
      "id": "respawned-again",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/lifecycle",
        "equals": "running",
        "maxMs": 15000
      },
      "settleMaxMs": 15000
    },
    {
      "id": "view-4",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:fx-workspace#/value/terminal_id"
      },
      "args": {
        "method": "terminal.get",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok",
        "result": "$step:view-3#",
        "resultExcept": [
          "/cwd",
          "/extra",
          "/stream_revision"
        ]
      }
    }
  ],
  "invariants": [
    "the per-terminal host arm (the default): a host that dies inside an escape sequence is a host loss, recorded in terminal-losses.jsonl with its cause (cmux-tui/spec/terminal-host.md); the terminal keeps its id and gets a new shell"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
