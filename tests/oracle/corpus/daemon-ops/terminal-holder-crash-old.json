{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "terminal-holder-crash-old",
  "suite": "daemon-ops",
  "title": "Terminal holder crash journey, per-terminal host arm: an abort and a SIGKILL mid-output replace the host on its running shell",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.terminal-holder-crash-old",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api",
    "restart"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "allow_crashes": [
    {
      "kind": "holder",
      "reason": "abort ends the terminal host on purpose (its crash seam)",
      "steps": [
        "abort"
      ]
    },
    {
      "kind": "holder",
      "reason": "kill ends the terminal host on purpose (SIGKILL)",
      "steps": [
        "kill"
      ]
    }
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "terminal-holder-crash-old.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "arm",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:fx-workspace#/value/terminal_id"
      },
      "args": {
        "method": "terminal.input.write",
        "params": {
          "text": "printf '\\033[H\\033[2J\\033[3J'; i=0; while [ $i -lt 30 ]; do i=$((i+1)); echo line-$i; done; stty raw -echo; printf 'X\\033]2;oracle-armed\\007\\033[38;5;1'; dd bs=1 count=1 >/dev/null 2>&1; printf '96mRED\\033]2;oracle-second\\007\\303'; dd bs=1 count=1 >/dev/null 2>&1; printf '\\251 END\\033[0m\\r\\n\\033]2;oracle-done\\007'; exec cat\r"
        },
        "idempotencyKey": "terminal-holder-crash-old.arm"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "the program prints 30 lines and stops inside the SGR `ESC [ 38;5;1`"
    },
    {
      "id": "armed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:4871df02e32ffadd7e963d3b761f4735b39899515988a92af0d05c3d33e2b75d",
        "maxMs": 15000
      },
      "settleMaxMs": 15000
    },
    {
      "id": "state-1",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:fx-workspace#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "view-1",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:fx-workspace#/value/terminal_id"
      },
      "args": {
        "method": "terminal.get",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "abort",
      "op": "kill",
      "target": {
        "process": "holder"
      },
      "args": {
        "signal": "ABRT"
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a killed process sends no reply; the driver's reply is the daemon's record of each ended terminal host",
        "result": {
          "signal": "ABRT",
          "process": "holder",
          "ended": [
            "terminal-host"
          ],
          "records": [
            {
              "event": "host_replaced",
              "crash": {
                "message": "test-injected host crash",
                "thread": "terminal-host-test-crash"
              },
              "signals": []
            }
          ]
        },
        "resultExcept": [
          "/records/*/at_ms",
          "/records/*/cause",
          "/records/*/incarnation",
          "/records/*/new_host_pid",
          "/records/*/old_host_pid",
          "/records/*/terminal_id",
          "/records/*/crash/at_ms",
          "/records/*/crash/backtrace",
          "/records/*/crash/host_pid",
          "/records/*/crash/incarnation",
          "/records/*/crash/location",
          "/records/*/crash/terminal_id"
        ]
      },
      "note": "after the daemon holds the PTY custody, the host's crash seam panics and aborts it while the parser is inside the SGR; the driver takes the host_replaced line whose old_host_pid is the aborted host (the cause text names the panic's source location)"
    },
    {
      "id": "state-2",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:fx-workspace#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok",
        "result": "$step:state-1#"
      },
      "note": "the VT state (screen, modes, pen) and the 80x24 size are the ones before the abort"
    },
    {
      "id": "view-2",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:fx-workspace#/value/terminal_id"
      },
      "args": {
        "method": "terminal.get",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok",
        "result": "$step:view-1#",
        "resultExcept": [
          "/extra",
          "/stream_revision"
        ]
      },
      "note": "the same terminal, title, cwd and size, still running on the same shell: `extra` holds only the last output time, and stream_revision (a scheduling watermark) advances once when the replacement attaches"
    },
    {
      "id": "go",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:fx-workspace#/value/terminal_id"
      },
      "args": {
        "method": "terminal.input.write",
        "params": {
          "text": "g"
        },
        "idempotencyKey": "terminal-holder-crash-old.go"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "one byte for the program, which ends the SGR and stops inside `é`"
    },
    {
      "id": "second",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:2e2f9f48aa6fc82b7d04b83074757bfdc671a2e8266eadc8c13646a7ad749b28",
        "maxMs": 15000
      },
      "settleMaxMs": 15000,
      "note": "the replacement host streams the shell's output"
    },
    {
      "id": "state-3",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:fx-workspace#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "view-3",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:fx-workspace#/value/terminal_id"
      },
      "args": {
        "method": "terminal.get",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "kill",
      "op": "kill",
      "target": {
        "process": "holder"
      },
      "args": {
        "signal": "KILL"
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a killed process sends no reply; the driver's reply is the daemon's record of each ended terminal host",
        "result": {
          "signal": "KILL",
          "process": "holder",
          "ended": [
            "terminal-host"
          ],
          "records": [
            {
              "event": "host_replaced",
              "cause": "no catchable signal recorded: SIGKILL, a crash, or memory pressure",
              "crash": null,
              "signals": []
            }
          ]
        },
        "resultExcept": [
          "/records/*/at_ms",
          "/records/*/incarnation",
          "/records/*/new_host_pid",
          "/records/*/old_host_pid",
          "/records/*/terminal_id"
        ]
      },
      "note": "after the daemon holds the replacement's PTY custody, SIGKILL of the replacement host while the parser holds the first byte of `é`"
    },
    {
      "id": "state-4",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:fx-workspace#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok",
        "result": "$step:state-3#"
      }
    },
    {
      "id": "view-4",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:fx-workspace#/value/terminal_id"
      },
      "args": {
        "method": "terminal.get",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok",
        "result": "$step:view-3#",
        "resultExcept": [
          "/extra",
          "/stream_revision"
        ]
      }
    },
    {
      "id": "go-again",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:fx-workspace#/value/terminal_id"
      },
      "args": {
        "method": "terminal.input.write",
        "params": {
          "text": "g"
        },
        "idempotencyKey": "terminal-holder-crash-old.go-again"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "the second byte of `é`: the program ends its line and runs cat"
    },
    {
      "id": "done",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:c57885d4c24ed9f349e946da82d6aa248a5a9717b1a14e8c10fc4c7b06d57297",
        "maxMs": 15000
      },
      "settleMaxMs": 15000
    },
    {
      "id": "screen",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:fx-workspace#/value/terminal_id"
      },
      "args": {
        "method": "terminal.copy",
        "params": {
          "mode": "screen"
        }
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok",
        "result": {
          "mode": "screen",
          "text": "line-9\nline-10\nline-11\nline-12\nline-13\nline-14\nline-15\nline-16\nline-17\nline-18\nline-19\nline-20\nline-21\nline-22\nline-23\nline-24\nline-25\nline-26\nline-27\nline-28\nline-29\nline-30\nXREDé END"
        }
      },
      "note": "no byte was lost or parsed twice: `X`, the red text and `é` on one row"
    }
  ],
  "invariants": [
    "the per-terminal host arm (the default): a terminal host that dies while the daemon holds its PTY custody and leaves no exit sidecar is replaced on its running shell; the daemon appends a host_replaced line, and the terminal keeps its id, incarnation, VT state, size, title and cwd and loses no byte (cmux-tui/spec/terminal-host.md, PTY custody and adoption)"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
