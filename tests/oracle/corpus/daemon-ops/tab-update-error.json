{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "tab-update-error",
  "suite": "daemon-ops",
  "title": "tab.update: typed error on the standard fixture",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.tab-update",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "tab-update-error.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "call",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "tab": "$step:fx-workspace#/value/tab_id"
      },
      "args": {
        "method": "tab.update",
        "params": {
          "back": [
            "http://127.0.0.1:9/"
          ]
        },
        "idempotencyKey": "tab-update-error.call"
      },
      "expect": {
        "outcome": "error",
        "error": "validation.invalid",
        "errorDetails": {
          "reason": "back and forward apply only to browser tabs"
        }
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "a terminal tab has no browser history: tabs.rs state_update_tab refuses back and writes nothing"
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_daemon_ops.py from the catalog type of tab.update (family tab)"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
