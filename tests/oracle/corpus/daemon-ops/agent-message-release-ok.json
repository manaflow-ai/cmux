      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "agent.message.send",
        "params": {
          "recipients": [
            "$step:fx-workspace#/value/terminal_id"
          ],
          "body": "oracle"
        },
        "idempotencyKey": "agent-message-release-ok.fx-message"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
