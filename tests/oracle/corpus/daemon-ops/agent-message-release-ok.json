        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "agent.message.release",
        "params": {
          "message_id": "$step:fx-message#/value/id",
          "recipient": "oracle",
          "decision": "approve"
        },
        "idempotencyKey": "agent-message-release-ok.call"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "approves the held delivery of the fixture message"
    },
    {
      "id": "retry",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "agent.message.release",
        "params": {
          "message_id": "$step:fx-message#/value/id",
          "recipient": "oracle",
          "decision": "approve"
        },
        "idempotencyKey": "agent-message-release-ok.call"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
