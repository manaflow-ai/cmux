{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "agent-message-mark-ok",
  "suite": "daemon-ops",
  "title": "agent.message.mark: success on the standard fixture",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.agent-message-mark",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "agent-message-mark-ok.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "fx-message",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "agent.message.send",
        "params": {
          "recipients": [
            "$step:fx-workspace#/value/terminal_id"
          ],
          "body": "oracle"
        },
        "idempotencyKey": "agent-message-mark-ok.fx-message"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "call",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "agent.message.mark",
        "params": {
          "ids": [
            "$step:fx-message#/value/id"
          ],
          "recipient": "$step:fx-workspace#/value/terminal_id",
          "state": "acknowledged"
        },
        "idempotencyKey": "agent-message-mark-ok.call"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "acknowledges the fixture message's delivery to the fixture terminal; a person reading a queued message may skip delivered (agent_message_store.rs), so the outcome is the same whether the terminal took it yet"
    },
    {
      "id": "retry",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "agent.message.mark",
        "params": {
          "ids": [
            "$step:fx-message#/value/id"
          ],
          "recipient": "$step:fx-workspace#/value/terminal_id",
          "state": "acknowledged"
        },
        "idempotencyKey": "agent-message-mark-ok.call"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "I10: step call again with its idempotency key; the daemon replays its reply, adds no journal record and changes no facet"
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_daemon_ops.py from the catalog type of agent.message.mark (family chief)"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
