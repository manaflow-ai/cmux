{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "screen-group-update-error",
  "suite": "daemon-ops",
  "title": "screen_group.update: typed error on the standard fixture",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.screen-group-update",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "screen-group-update-error.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "fx-screen-group",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "screen_group.create",
        "params": {
          "screens": [
            "$step:fx-workspace#/value/screen_id"
          ],
          "name": "oracle"
        },
        "idempotencyKey": "screen-group-update-error.fx-screen-group"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "call",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "screen_group.update",
        "params": {
          "screen_group": "oracle-missing",
          "name": "renamed",
          "collapsed": true
        },
        "idempotencyKey": "screen-group-update-error.call"
      },
      "expect": {
        "outcome": "error",
        "error": "operation.failed",
        "errorDetails": {
          "reason": "unknown screen group oracle-missing"
        }
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "a group id that names no group: operation.failed, the fixture group is unchanged"
    },
    {
      "id": "group-kept",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/extra/state/screen_groups/0/id",
        "equals": "$step:fx-screen-group#/value/id",
        "maxMs": 5000
      },
      "settleMaxMs": 5000
    },
    {
      "id": "name-kept",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/extra/state/screen_groups/0/name",
        "equals": "oracle",
        "maxMs": 5000
      },
      "settleMaxMs": 5000
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_daemon_ops.py from the catalog type of screen_group.update (family layout)"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ],
  "untested": [
    "the catalog also lists resource.not_found for screen_group.update; the daemon answers an unknown group with operation.failed (screen_group_ops), and this case records that"
  ]
}
