{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "conversation-draft-error",
  "suite": "daemon-ops",
  "title": "conversation.draft: typed error on the standard fixture",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.conversation-draft",
    "network": "offline",
    "clock": "virtual",
    "agent": "mock"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "conversation",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "conversation.list",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "call",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "conversation.draft",
        "params": {
          "conversation": "$step:conversation#/0/id",
          "turn": "oracle",
          "segment": 1,
          "seq": 1,
          "kind": "talk",
          "text": "oracle",
          "fresh": true,
          "done": false
        },
        "idempotencyKey": "conversation-draft-error.call"
      },
      "expect": {
        "outcome": "error",
        "error": "operation.failed",
        "errorDetails": {
          "operation": "conversation.draft",
          "reason": "not_agent"
        }
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "the case connection acts as the person in the mock conversation, and only a bound agent participant publishes drafts"
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_daemon_ops.py from the catalog type of conversation.draft (family chief)"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
