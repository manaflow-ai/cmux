        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id",
        "screen": "$step:fx-workspace#/value/screen_id",
        "pane": "$step:fx-workspace#/value/pane_id"
      },
      "args": {
        "method": "pane.split",
        "params": {
          "direction": "right"
        },
        "idempotencyKey": "pane-swap-ok.fx-split"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "call",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "pane": "$step:fx-workspace#/value/pane_id"
      },
      "args": {
        "method": "pane.swap",
        "params": {
          "other_workspace": "$step:fx-workspace#/value/workspace_id",
          "other_screen": "$step:fx-workspace#/value/screen_id",
          "other_pane": "$step:fx-split#/value/pane_id"
        },
        "idempotencyKey": "pane-swap-ok.call"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "every required field from its catalog type"
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_daemon_ops.py from the catalog type of pane.swap (family layout)"
