{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "pane-split-ratio-set-ok",
  "suite": "daemon-ops",
  "title": "pane.split_ratio.set: success on the standard fixture",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.pane-split-ratio-set",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "pane-split-ratio-set-ok.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "fx-split",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id",
        "screen": "$step:fx-workspace#/value/screen_id",
        "pane": "$step:fx-workspace#/value/pane_id"
      },
      "args": {
        "method": "pane.split",
        "params": {
          "direction": "right"
        },
        "idempotencyKey": "pane-split-ratio-set-ok.fx-split"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "split-in-place",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/screens/0/layout/root/second/pane_id",
        "equals": "$step:fx-split#/value/pane_id",
        "maxMs": 5000
      },
      "settleMaxMs": 5000
    },
    {
      "id": "read-layout",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "screen": "$step:fx-workspace#/value/screen_id"
      },
      "args": {
        "method": "screen.get",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "call",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "pane": "$step:fx-workspace#/value/pane_id"
      },
      "args": {
        "method": "pane.split_ratio.set",
        "params": {
          "split_id": "$step:read-layout#/layout/root/split_id",
          "ratio": 0.25
        },
        "idempotencyKey": "pane-split-ratio-set-ok.call"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "the fixture split's id, read from screen.get, gets ratio 0.25; its children stay"
    },
    {
      "id": "ratio",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/screens/0/layout/root/ratio",
        "equals": 0.25,
        "maxMs": 5000
      },
      "settleMaxMs": 5000
    },
    {
      "id": "children-kept",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/screens/0/layout/root/second/pane_id",
        "equals": "$step:fx-split#/value/pane_id",
        "maxMs": 5000
      },
      "settleMaxMs": 5000
    },
    {
      "id": "retry",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "pane": "$step:fx-workspace#/value/pane_id"
      },
      "args": {
        "method": "pane.split_ratio.set",
        "params": {
          "split_id": "$step:read-layout#/layout/root/split_id",
          "ratio": 0.25
        },
        "idempotencyKey": "pane-split-ratio-set-ok.call"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "I10: step call again with its idempotency key; the daemon replays its reply, adds no journal record and changes no facet"
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_daemon_ops.py from the catalog type of pane.split_ratio.set (family layout)"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
