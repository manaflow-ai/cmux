      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "tab.list",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok",
        "result": "$step:tabs-before#"
      }
    },
    {
      "id": "producers-after",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "session.journal.producer.list",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok",
        "result": "$step:producers-before#"
      }
    },
    {
      "id": "checkpoints-after",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "session.journal.checkpoint.list",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok",
        "result": "$step:checkpoints-before#"
      }
    },
    {
      "id": "snapshot-after",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "session.snapshot",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok",
        "result": "$step:snapshot-before#",
        "resultExcept": [
          "/cursor",
          "/session/generation",
          "/session/revision",
          "/terminals/*/stream_revision",
          "/terminals/*/extra"
        ]
      }
    },
    {
      "id": "workspace-get",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.get",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "pane-get",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "pane": "$step:fx-workspace#/value/pane_id"
      },
      "args": {
        "method": "pane.get",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "tab-get",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "tab": "$step:fx-workspace#/value/tab_id"
      },
      "args": {
        "method": "tab.get",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "terminal-get",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:fx-workspace#/value/terminal_id"
      },
      "args": {
        "method": "terminal.get",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_daemon_ops.py from the catalog type of session.shutdown (family session)",
    "workspaces-after, panes-after, tabs-after, producers-after, checkpoints-after, snapshot-after reply what the step each names replied, but for the pointers its resultExcept lists"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ],
  "allow_crashes": [
    {
      "kind": "daemon",
      "reason": "session.shutdown stops the daemon on purpose (exit 0 after its receipt); the call step waits for that exit, and the restart step starts the daemon again on the same root",
      "steps": [
        "call"
      ]
    }
  ]
}
