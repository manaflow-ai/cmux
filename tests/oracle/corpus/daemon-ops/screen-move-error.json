{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "screen-move-error",
  "suite": "daemon-ops",
  "title": "screen.move: typed error on the standard fixture",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.screen-move",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "screen-move-error.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "second-screen",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "screen.create",
        "params": {
          "name": "second"
        },
        "idempotencyKey": "screen-move-error.second-screen"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "call",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "screen": "screen_0123456789abcdef0123456789abcdef"
      },
      "args": {
        "method": "screen.move",
        "params": {
          "index": 0
        },
        "idempotencyKey": "screen-move-error.call"
      },
      "expect": {
        "outcome": "error",
        "error": "selector.not_found",
        "errorDetails": {
          "scope": "screen",
          "selector": "screen_0123456789abcdef0123456789abcdef"
        }
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "a well-formed screen id that names no screen: selector.not_found, the order stays"
    },
    {
      "id": "order-kept",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/screens/0/id",
        "equals": "$step:fx-workspace#/value/screen_id",
        "maxMs": 5000
      },
      "settleMaxMs": 5000
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_daemon_ops.py from the catalog type of screen.move (family layout)"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
