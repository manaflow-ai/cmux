{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "sidebar-view-reload-ok",
  "suite": "daemon-ops",
  "title": "sidebar_view.reload: success on the standard fixture",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.sidebar-view-reload",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "write-config",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "config",
          "argv": [
            "/bin/sh",
            "-c",
            "printf '%s\\n' \"$0\" > \"$CMUX_TUI_CONFIG\"",
            "{\"sidebar\":{\"plugin\":{\"command\":[\"/bin/cat\"]}}}"
          ]
        },
        "idempotencyKey": "sidebar-view-reload-ok.write-config"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "config-written",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/lifecycle",
        "equals": "exited",
        "maxMs": 15000
      },
      "settleMaxMs": 15000
    },
    {
      "id": "reload-config",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "session.reload_config",
        "params": {},
        "idempotencyKey": "sidebar-view-reload-ok.reload-config"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "ensure-view",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "sidebar_view.ensure",
        "params": {
          "cols": 80,
          "rows": 24
        },
        "idempotencyKey": "sidebar-view-reload-ok.ensure-view"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "call",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "sidebar_view": "$step:ensure-view#/value/id"
      },
      "args": {
        "method": "sidebar_view.reload",
        "params": {},
        "idempotencyKey": "sidebar-view-reload-ok.call"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "the running sidebar view restarts"
    },
    {
      "id": "retry",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "sidebar_view": "$step:ensure-view#/value/id"
      },
      "args": {
        "method": "sidebar_view.reload",
        "params": {},
        "idempotencyKey": "sidebar-view-reload-ok.call"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "I10: step call again with its idempotency key; the daemon replays its reply, adds no journal record and changes no facet"
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_daemon_ops.py from the catalog type of sidebar_view.reload (family sidebar)"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
