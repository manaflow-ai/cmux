{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "tab-group-create-error",
  "suite": "daemon-ops",
  "title": "tab_group.create: typed error on the standard fixture",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.tab-group-create",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "tab-group-create-error.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "fx-split",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id",
        "screen": "$step:fx-workspace#/value/screen_id",
        "pane": "$step:fx-workspace#/value/pane_id"
      },
      "args": {
        "method": "pane.split",
        "params": {
          "direction": "right"
        },
        "idempotencyKey": "tab-group-create-error.fx-split"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "call",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "tab_group.create",
        "params": {
          "tabs": [
            "$step:fx-workspace#/value/tab_id",
            "$step:fx-split#/value/tab_id"
          ],
          "name": "oracle",
          "color": "blue"
        },
        "idempotencyKey": "tab-group-create-error.call"
      },
      "expect": {
        "outcome": "error",
        "error": "validation.invalid",
        "errorDetails": {
          "reason": "tab group members must share one pane"
        }
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "tabs of two panes cannot form one group (tab_groups.rs tab_group_create); no group is made"
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_daemon_ops.py from the catalog type of tab_group.create (family tab)"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
