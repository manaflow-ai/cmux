{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "git-checkpoint-unpin-ok",
  "suite": "daemon-ops",
  "title": "git.checkpoint.unpin: success on the standard fixture",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.git-checkpoint-unpin",
    "network": "offline",
    "clock": "virtual",
    "repo": "oracle"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root",
    "git on PATH; tests/oracle/fixtures/git/oracle.json built under $CASE_ROOT/repos before the first step (make_repo.py build_for_case): fixed dates, a local bare origin, no other remote",
    "HOME is the case's own folder under $CASE_ROOT, as for every case with a generated repository"
  ],
  "requires": [
    "resource_api",
    "git_repo"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "checkpoint",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "git.checkpoint.create",
        "params": {
          "path": "$CASE_ROOT/repos/oracle"
        },
        "idempotencyKey": "git-checkpoint-unpin-ok.checkpoint"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "pin",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "git.checkpoint.pin",
        "params": {
          "path": "$CASE_ROOT/repos/oracle",
          "checkpoint_id": "$step:checkpoint#/value/checkpoint_id",
          "pin_id": "oracle",
          "reason": "oracle"
        },
        "idempotencyKey": "git-checkpoint-unpin-ok.pin"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "call",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "git.checkpoint.unpin",
        "params": {
          "checkpoint_id": "$step:checkpoint#/value/checkpoint_id",
          "pin_id": "oracle",
          "path": "$CASE_ROOT/repos/oracle"
        },
        "idempotencyKey": "git-checkpoint-unpin-ok.call"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "removes the pin the before step set; the checkpoint stays"
    },
    {
      "id": "retry",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "git.checkpoint.unpin",
        "params": {
          "checkpoint_id": "$step:checkpoint#/value/checkpoint_id",
          "pin_id": "oracle",
          "path": "$CASE_ROOT/repos/oracle"
        },
        "idempotencyKey": "git-checkpoint-unpin-ok.call"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "I10: step call again with its idempotency key; the daemon replays its reply, adds no journal record and changes no facet"
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_daemon_ops.py from the catalog type of git.checkpoint.unpin (family git)"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ],
  "untested": [
    "no product offers git_repo yet: p15-oracle-243 makes the case runner build fixture.repo (make_repo.build_for_case, then $CASE_ROOT expanded) in the per-case HOME; the daemon product gets git_repo with it, and the git family's first VM run follows"
  ]
}
