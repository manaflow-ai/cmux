{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "pane-close-error",
  "suite": "daemon-ops",
  "title": "pane.close: typed error on the standard fixture",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.pane-close",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "pane-close-error.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "fx-split",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id",
        "screen": "$step:fx-workspace#/value/screen_id",
        "pane": "$step:fx-workspace#/value/pane_id"
      },
      "args": {
        "method": "pane.split",
        "params": {
          "direction": "right"
        },
        "idempotencyKey": "pane-close-error.fx-split"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "call",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "pane": "$step:fx-split#/value/pane_id"
      },
      "args": {
        "method": "pane.close",
        "params": {
          "expected_revision": "1"
        },
        "idempotencyKey": "pane-close-error.call"
      },
      "expect": {
        "outcome": "error",
        "error": "revision.conflict",
        "errorDetails": {
          "expected": "1"
        }
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "expected_revision 1 is older than the fixture's commits: revision.conflict (details expected 1; actual is the current revision), nothing written; the split keeps both panes"
    },
    {
      "id": "split-kept",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/screens/0/layout/root/second/pane_id",
        "equals": "$step:fx-split#/value/pane_id",
        "maxMs": 5000
      },
      "settleMaxMs": 5000
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_daemon_ops.py from the catalog type of pane.close (family layout)"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
