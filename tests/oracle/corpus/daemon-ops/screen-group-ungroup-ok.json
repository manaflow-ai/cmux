{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "screen-group-ungroup-ok",
  "suite": "daemon-ops",
  "title": "screen_group.ungroup: success on the standard fixture",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.screen-group-ungroup",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "screen-group-ungroup-ok.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "fx-screen-group",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "screen_group.create",
        "params": {
          "screens": [
            "$step:fx-workspace#/value/screen_id"
          ],
          "name": "oracle"
        },
        "idempotencyKey": "screen-group-ungroup-ok.fx-screen-group"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "call",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "screen_group.ungroup",
        "params": {
          "screen_group": "$step:fx-screen-group#/value/id"
        },
        "idempotencyKey": "screen-group-ungroup-ok.call"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "the group goes and its screen stays, ungrouped"
    },
    {
      "id": "ungrouped",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/screens/0/extra/screen_group_id",
        "predicate": "absent",
        "maxMs": 5000
      },
      "settleMaxMs": 5000
    },
    {
      "id": "no-group",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/extra/state/screen_groups",
        "predicate": {
          "op": "lengthEquals",
          "value": 0
        },
        "maxMs": 5000
      },
      "settleMaxMs": 5000
    },
    {
      "id": "retry",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "screen_group.ungroup",
        "params": {
          "screen_group": "$step:fx-screen-group#/value/id"
        },
        "idempotencyKey": "screen-group-ungroup-ok.call"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "I10: step call again with its idempotency key; the daemon replays its reply, adds no journal record and changes no facet"
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_daemon_ops.py from the catalog type of screen_group.ungroup (family layout)"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
