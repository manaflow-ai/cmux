{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "browser-forward-error",
  "suite": "daemon-ops",
  "title": "browser.forward: typed error on the standard fixture",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.browser-forward",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "browser-forward-error.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "fx-browser-profile",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "browser.profile.create",
        "params": {
          "name": "oracle"
        },
        "idempotencyKey": "browser-forward-error.fx-browser-profile"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "fx-app-browser",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id",
        "screen": "$step:fx-workspace#/value/screen_id",
        "pane": "$step:fx-workspace#/value/pane_id"
      },
      "args": {
        "method": "browser.profile.open",
        "params": {
          "url": "http://127.0.0.1:9/",
          "profile": "$step:fx-browser-profile#/value/browser_profile/id"
        },
        "idempotencyKey": "browser-forward-error.fx-app-browser"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "call",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "browser": "$step:fx-app-browser#/value/browser_id"
      },
      "args": {
        "method": "browser.forward",
        "params": {},
        "idempotencyKey": "browser-forward-error.call"
      },
      "expect": {
        "outcome": "error",
        "error": "operation.failed"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "an app-drawn browser has no daemon CDP session: operation.failed with details.extra.code browser_rendered_by_app and the tab id, no receipt"
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_daemon_ops.py from the catalog type of browser.forward (family browser)"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
