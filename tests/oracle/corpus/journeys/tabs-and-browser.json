{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "tabs-and-browser",
  "suite": "journeys",
  "title": "Terminal and browser tabs: navigate, back and forward, split, switch and move a tab, close and reopen it, and a renderer crash with retry",
  "journey": "tabs-and-browser",
  "priority": "P0",
  "surface": "cmux-next-native",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {
    "viewport": {
      "width": 1440,
      "height": 900
    }
  },
  "fixture": {
    "seed": "tabs-and-browser-v1",
    "network": "offline",
    "clock": "fixed",
    "agent": "mock",
    "web": true
  },
  "preconditions": [
    "private scratch config (driver_app: bench config, ui.animations.enabled false)",
    "tagged bench build",
    "no unrelated app instance",
    "a fresh saved session: one workspace, one terminal tab",
    "the loopback web fixture (webfixture.py) serves tests/oracle/fixtures/web as $WEB",
    "Chromium is the default browser engine (browser.defaultEngine unset)"
  ],
  "requires": [
    "actions",
    "keys",
    "gui",
    "chromium"
  ],
  "platforms": [
    "mac"
  ],
  "allow_crashes": [
    {
      "kind": "renderer",
      "reason": "crash-renderer types chrome://crash/ in the address bar on purpose: the debug URL ends that page's renderer",
      "steps": [
        "crash-renderer"
      ],
      "max": 1
    }
  ],
  "steps": [
    {
      "id": "open-terminal-tab",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "ctrl+`"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/tab_count",
        "predicate": "changed",
        "maxMs": 5000
      },
      "checkpoint": [
        "before",
        "turn",
        "settled"
      ],
      "note": "a person's Ctrl-` opens a second terminal tab in the launch's pane and selects it (newSurface)"
    },
    {
      "id": "open-page",
      "op": "action.run",
      "target": {
        "window": "current"
      },
      "args": {
        "action": "openBrowser.chromium",
        "params": {
          "url": "$WEB/load.html"
        }
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/tab_count",
        "predicate": "changed",
        "maxMs": 10000
      },
      "checkpoint": [
        "before",
        "turn",
        "settled"
      ],
      "note": "a script run files the Chromium tab at the end of the pane without selecting it; no browser.page call ever drives it, so it stays a person's tab"
    },
    {
      "id": "show-page",
      "op": "action.run",
      "target": {
        "window": "current"
      },
      "args": {
        "action": "selectSurfaceByNumber",
        "params": {
          "index": 9
        }
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/focus/context/browser",
        "equals": true,
        "maxMs": 10000
      },
      "note": "Select Tab 9 (a focus action) shows the last tab, the page, so Chromium makes its browser"
    },
    {
      "id": "page-loaded",
      "op": "settle",
      "waitFor": {
        "pointer": "/tabs/panes/0/tabs/0/loadState",
        "equals": "finished",
        "maxMs": 15000
      },
      "settleMaxMs": 15000
    },
    {
      "id": "navigate-other",
      "op": "cli",
      "target": {
        "tab": "current"
      },
      "args": {
        "argv": [
          "browser",
          "page",
          "navigate",
          "$WEB/other.html"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "cmux browser page navigate prints the tab, not an ActionEffect"
      },
      "waitFor": {
        "pointer": "/tabs/panes/0/tabs/0/canGoBack",
        "equals": true,
        "maxMs": 10000
      },
      "note": "the focused tab (`page`) loads the second page through browser.page.navigate; canGoBack turns true when it commits"
    },
    {
      "id": "other-loaded",
      "op": "settle",
      "waitFor": {
        "pointer": "/tabs/panes/0/tabs/0/loadState",
        "equals": "finished",
        "maxMs": 15000
      },
      "settleMaxMs": 15000
    },
    {
      "id": "back",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "cmd+["
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/tabs/panes/0/tabs/0/canGoForward",
        "equals": true,
        "maxMs": 10000
      },
      "checkpoint": [
        "turn",
        "settled"
      ],
      "note": "a person's Cmd-[ (browserBack) on the shown page"
    },
    {
      "id": "back-loaded",
      "op": "settle",
      "waitFor": {
        "pointer": "/tabs/panes/0/tabs/0/loadState",
        "equals": "finished",
        "maxMs": 15000
      },
      "settleMaxMs": 15000
    },
    {
      "id": "forward",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "cmd+]"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/tabs/panes/0/tabs/0/canGoForward",
        "equals": false,
        "maxMs": 10000
      },
      "checkpoint": [
        "turn",
        "settled"
      ],
      "note": "a person's Cmd-] (browserForward)"
    },
    {
      "id": "forward-loaded",
      "op": "settle",
      "waitFor": {
        "pointer": "/tabs/panes/0/tabs/0/loadState",
        "equals": "finished",
        "maxMs": 15000
      },
      "settleMaxMs": 15000
    },
    {
      "id": "split-right",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "cmd+d"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/layout/screens/0/root/axis",
        "equals": "horizontal",
        "maxMs": 10000
      },
      "checkpoint": [
        "before",
        "turn",
        "settled"
      ],
      "note": "a person's Cmd-D splits the pane; the new right pane has a terminal and takes the focus"
    },
    {
      "id": "focus-page-pane",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "cmd+opt+left"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/focus/context/browser",
        "equals": true,
        "maxMs": 5000
      },
      "note": "Cmd-Opt-Left (Ghostty's focus-pane key) back to the pane that shows the page"
    },
    {
      "id": "switch-tab",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "ctrl+tab"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/topology/focus/tab",
        "predicate": "changed",
        "maxMs": 5000
      },
      "checkpoint": [
        "turn",
        "settled"
      ],
      "note": "Ctrl-Tab (nextSurface) wraps from the page, the last tab, to the first"
    },
    {
      "id": "move-tab",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "cmd+opt+shift+]"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/topology/workspaces/0/screens/0/panes/0/tabs/0/id",
        "predicate": "changed",
        "maxMs": 5000
      },
      "checkpoint": [
        "turn",
        "settled"
      ],
      "note": "Cmd-Opt-Shift-] (moveSurfaceRight) moves the selected first tab one place right"
    },
    {
      "id": "show-page-again",
      "op": "action.run",
      "target": {
        "window": "current"
      },
      "args": {
        "action": "selectSurfaceByNumber",
        "params": {
          "index": 9
        }
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/focus/context/browser",
        "equals": true,
        "maxMs": 5000
      }
    },
    {
      "id": "close-page",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "cmd+w"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/tab_count",
        "predicate": "changed",
        "maxMs": 5000
      },
      "checkpoint": [
        "before",
        "turn",
        "settled"
      ],
      "note": "Cmd-W closes the page into the closed history"
    },
    {
      "id": "reopen-page",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "cmd+shift+t"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/tab_count",
        "predicate": "changed",
        "maxMs": 10000
      },
      "checkpoint": [
        "before",
        "turn",
        "settled"
      ],
      "note": "Shift-Cmd-T reopens the newest closed tab, the page, where it was"
    },
    {
      "id": "reopened-location",
      "op": "settle",
      "waitFor": {
        "pointer": "/tabs/panes/0/tabs/0/url",
        "equals": "$WEB/other.html",
        "maxMs": 15000
      },
      "settleMaxMs": 15000,
      "note": "the reopened tab keeps its location: the forward step left it on the second page"
    },
    {
      "id": "open-crash-page",
      "op": "action.run",
      "target": {
        "window": "current"
      },
      "args": {
        "action": "openBrowser.chromium",
        "params": {
          "url": "$WEB/crash.html"
        }
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/tab_count",
        "predicate": "changed",
        "maxMs": 10000
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "webfixture's chrome://crash link page, in a tab of its own that no agent drove"
    },
    {
      "id": "show-crash-page",
      "op": "action.run",
      "target": {
        "window": "current"
      },
      "args": {
        "action": "selectSurfaceByNumber",
        "params": {
          "index": 9
        }
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/topology/focus/tab",
        "predicate": "changed",
        "maxMs": 5000
      }
    },
    {
      "id": "crash-page-loaded",
      "op": "settle",
      "waitFor": {
        "pointer": "/tabs/panes/0/tabs/1/loadState",
        "equals": "finished",
        "maxMs": 15000
      },
      "settleMaxMs": 15000
    },
    {
      "id": "focus-omnibar",
      "op": "action.run",
      "target": {
        "window": "current"
      },
      "args": {
        "action": "focusBrowserAddressBar"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/focus/windows/0/model/target",
        "equals": "addressBar",
        "maxMs": 5000
      },
      "note": "the address bar of the shown crash page takes the keyboard (Chrome's FocusLocationBar)"
    },
    {
      "id": "crash-renderer",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "c",
          "h",
          "r",
          "o",
          "m",
          "e",
          "shift+;",
          "/",
          "/",
          "c",
          "r",
          "a",
          "s",
          "h",
          "/",
          "return"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "typing in the address bar runs no registry action; Return opens the typed URL as the person's"
      },
      "waitFor": {
        "pointer": "/crashes/counts/renderer",
        "predicate": "changed",
        "maxMs": 15000
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "settleMaxMs": 15000,
      "note": "a person types chrome://crash/ (Shift-; is the colon; with the trailing slash, the URL Chromium compares, the omnibar completes no chrome page (its completed hosts list `crashes`, never `crash/`)) and presses Return: the debug URL never commits and ends the page's renderer (third_party/blink/public/common/chrome_debug_urls.h kChromeUICrashURL; content/public/test/browser_test_utils.h CrashTab). The app, its other tabs and the daemon stay"
    },
    {
      "id": "crashed-tab",
      "op": "settle",
      "waitFor": {
        "pointer": "/tabs/panes/0/tabs/1/crashed",
        "equals": true,
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the crashed tab is an error state (the sad tab), not a closed tab"
    },
    {
      "id": "retry",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "cmd+r"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/tabs/panes/0/tabs/1/crashed",
        "equals": false,
        "maxMs": 15000
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "settleMaxMs": 15000,
      "note": "the retry: Cmd-R (browserReload) loads the page again in a new renderer"
    },
    {
      "id": "retry-loaded",
      "op": "settle",
      "waitFor": {
        "pointer": "/tabs/panes/0/tabs/1/loadState",
        "equals": "finished",
        "maxMs": 15000
      },
      "settleMaxMs": 15000
    },
    {
      "id": "final",
      "op": "snapshot",
      "args": {
        "facets": [
          "topology",
          "focus",
          "layout",
          "tabs",
          "overlays",
          "history",
          "crashes",
          "liveObjects",
          "invariants"
        ]
      }
    }
  ],
  "invariants": [
    "tab identity and browser location stay distinct: back, forward and reopen change the page tab's url, never its place among the terminal tabs, and a reopened tab keeps the location it closed with",
    "the app pid does not change in crash-renderer (driver_app fails the case when it does): a renderer crash ends one page's process, never the app (content/public/test/browser_test_utils.h CrashTab)",
    "crash-renderer raises crashes.counts.renderer by exactly one and no other kind (I17: allow_crashes renderer, max 1); the first page tab is not crashed in any later checkpoint",
    "the crashed tab shows an error state with retry (tabs crashed true), and Cmd-R brings it back (crashed false, loadState finished)",
    "the split leaves the page in the left pane: the tabs facet keeps one pane, since the new pane holds only a terminal"
  ],
  "teardown": [
    "quit the tagged app the run started and its tag's daemons (TagTeardown)",
    "verify its debug socket is gone"
  ],
  "untested": [
    "pointer entrypoints (no pointer op in case-v1): tab clicks, drags between panes, the sad tab's Reload button",
    "the page's own content after the crash: no facet reads a page's DOM",
    "GPU, hang and helper-kill failures (p15-oracle-223's chromium-* journeys)",
    "the new terminal's directory and output (the terminal-input journey)"
  ]
}
