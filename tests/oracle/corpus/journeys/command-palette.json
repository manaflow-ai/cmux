{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "command-palette",
  "suite": "journeys",
  "title": "Command palette: open, search, move through results with the keyboard, invoke, dismiss and reopen",
  "journey": "command-palette",
  "priority": "P0",
  "surface": "cmux-next-native",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {
    "viewport": {
      "width": 1440,
      "height": 900
    }
  },
  "fixture": {
    "seed": "command-palette-v1",
    "network": "offline",
    "clock": "fixed",
    "agent": "mock"
  },
  "preconditions": [
    "private scratch config (driver_app: bench config, ui.animations.enabled false)",
    "tagged bench build",
    "no unrelated app instance",
    "a fresh saved session: one workspace, one terminal tab"
  ],
  "requires": [
    "keys",
    "gui"
  ],
  "platforms": [
    "mac"
  ],
  "steps": [
    {
      "id": "open-palette",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "cmd+shift+p"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/overlays/palette/open",
        "equals": true,
        "maxMs": 5000
      },
      "checkpoint": [
        "before",
        "turn",
        "settled"
      ],
      "note": "a person's Cmd-Shift-P opens the palette on its Commands scope (commandPalette)"
    },
    {
      "id": "search",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "n",
          "e",
          "w",
          "space",
          "t",
          "e",
          "r",
          "m",
          "i",
          "n",
          "a",
          "l",
          "space",
          "t",
          "a",
          "b"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "typing into the palette's field runs no registry action; it changes the query"
      },
      "waitFor": {
        "pointer": "/overlays/palette/querySha256",
        "predicate": "changed",
        "maxMs": 5000
      },
      "settleMaxMs": 5000,
      "note": "the query is hashed (querySha256); topIds and selectedIndex are the results the baseline keeps"
    },
    {
      "id": "select-next",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "down"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "the open palette's key map moves the selection (PaletteKeyMap), not the registry"
      },
      "waitFor": {
        "pointer": "/overlays/palette/selectedIndex",
        "equals": 1,
        "maxMs": 5000
      },
      "checkpoint": [
        "before",
        "settled"
      ]
    },
    {
      "id": "select-previous",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "up"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "the open palette's key map moves the selection (PaletteKeyMap), not the registry"
      },
      "waitFor": {
        "pointer": "/overlays/palette/selectedIndex",
        "equals": 0,
        "maxMs": 5000
      },
      "checkpoint": [
        "before",
        "settled"
      ]
    },
    {
      "id": "invoke",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "return"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "Return runs the selected row through the palette, which attributes the run to the row's action, not to the key"
      },
      "waitFor": {
        "pointer": "/topology/tab_count",
        "predicate": "changed",
        "maxMs": 10000
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "the top row for `new terminal tab` is New Terminal Tab (newSurface): one tab more"
    },
    {
      "id": "palette-closed",
      "op": "settle",
      "waitFor": {
        "pointer": "/overlays/palette/open",
        "equals": false,
        "maxMs": 5000
      }
    },
    {
      "id": "focus-returned",
      "op": "settle",
      "waitFor": {
        "pointer": "/focus/context/terminal",
        "equals": true,
        "maxMs": 5000
      },
      "note": "the keyboard returns to the content: the new terminal tab, selected"
    },
    {
      "id": "reopen-palette",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "cmd+shift+p"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/overlays/palette/open",
        "equals": true,
        "maxMs": 5000
      },
      "checkpoint": [
        "before",
        "turn",
        "settled"
      ],
      "note": "the palette opens again; the settled checkpoint records whether it kept the last query"
    },
    {
      "id": "dismiss",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "escape"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "Escape closes the palette through its key map (PaletteKeyMap), not the registry"
      },
      "waitFor": {
        "pointer": "/overlays/palette/open",
        "equals": false,
        "maxMs": 5000
      },
      "checkpoint": [
        "before",
        "settled"
      ]
    },
    {
      "id": "focus-after-dismiss",
      "op": "settle",
      "waitFor": {
        "pointer": "/focus/paletteOpen",
        "equals": false,
        "maxMs": 5000
      },
      "note": "dismissal returns the keyboard to the content it came from"
    },
    {
      "id": "final",
      "op": "snapshot",
      "args": {
        "facets": [
          "topology",
          "focus",
          "overlays",
          "invariants"
        ]
      }
    }
  ],
  "invariants": [
    "search, selection, invocation, dismissal and focus return are deterministic: two runs give equal settled checkpoints (querySha256, topIds, selectedIndex)",
    "the palette is open from open-palette to invoke and from reopen-palette to dismiss, and closed between",
    "invoke runs exactly the selected row: one terminal tab more, no other change",
    "after invoke and after dismiss the focus is back in the content and focus.paletteOpen is false"
  ],
  "teardown": [
    "quit the tagged app the run started and its tag's daemons (TagTeardown)",
    "verify its debug socket is gone"
  ],
  "untested": [
    "pointer moves and clicks on rows (no pointer op in case-v1)",
    "the palette's other scopes (palette.open needs a focused run; the actions/palette cases)"
  ]
}
