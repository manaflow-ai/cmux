{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "alt-015",
  "suite": "terminal",
  "title": "VT alt stream 15 at 80x24",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "terminal.alt-015",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "empty",
          "name": "oracle"
        },
        "idempotencyKey": "alt-015.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "feed",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "printf '%s' \"$1\"; printf '\\033]2;%s\\007' \"$2\"; exec cat",
            "sh",
            "primary 0 gamma eta λόγος\r\nprimary 1 100% iota\r\nprimary 2 [ok]\r\nprimary 3 zeta [ok] delta beta\r\nprimary 4 x café café λόγος iota\r\nprimary 5 a/b/c ünïcödé x epsilon λόγος\r\nprimary 6 zeta λόγος\r\nprimary 7 theta theta {}\r\nprimary 8 beta eta\r\nprimary 9 kappa gamma eta alpha iota\r\nprimary 10 λόγος beta\r\nprimary 11 zeta\r\nprimary 12 iota [ok] --flag\r\nprimary 13 100%\r\nprimary 14 zeta eta ünïcödé ünïcödé beta\r\n\u001b[?1048h\u001b[?47h\u001b[H\u001b[2J\u001b[20;58H\u001b[25;5mzeta\u001b[0m\u001b[14;47H\u001b[23m{}\u001b[0m\u001b[3;78H\u001b[24;58:2::190:204:82;53ma/b/c theta kappa\u001b[0m\u001b[3;45H\u001b[22;48;2;193;225;22;3mcafé epsilon\u001b[0m\u001b[3;35H\u001b[48;2;24;26;169;48;2;203;45;94m--flag\u001b[0m\u001b[10;41H\u001b[2;58;5;119miota 100% epsilon\u001b[0m\u001b[19;50H\u001b[38;5;251;28;0;97m{} λόγος\u001b[0m\u001b[12;73H\u001b[58;5;218;103;0;102m--flag\u001b[0m\u001b[22;34H\u001b[48;2;23;225;237m{} {}\u001b[0m\u001b[20;63H\u001b[23mdelta alpha\u001b[0m\u001b[22;11H\u001b[0;23malpha\u001b[0m\u001b[9;59H\u001b[48;5;97;49mλόγος ünïcödé\u001b[0m\u001b[?47l\u001b8back theta --flag λόγος\r\n\u001b[?47h\u001b[H\u001b[2J\u001b[14;1H\u001b[58:2::158:201:132;3;9;38;5;159mcafé gamma eta\u001b[0m\u001b[13;39H\u001b[0;48;2;228;220;112;32mtheta kappa\u001b[0m\u001b[14;71H\u001b[94;22;58;5;46münïcödé zeta eta\u001b[0m\u001b[12;3H\u001b[4:2;4;36mtheta\u001b[0m\u001b[8;45H\u001b[107;4:0mepsilon\u001b[0m\u001b[20;66H\u001b[102;58:2::24:36:132;2;38;2;14;231;147mbeta\u001b[0m\u001b[8;11H\u001b[4;4:3;8mλόγος a/b/c\u001b[0m\u001b[20;38H\u001b[39;0mzeta beta delta\u001b[0m\u001b[5;13H\u001b[4:2;100;29;48;5;45m[ok] λόγος x\u001b[0m\u001b[13;78H\u001b[28;38;2;245;156;230;53mcafé beta\u001b[0m\u001b[23;74H\u001b[25;38;5;177;34;92ma/b/c theta\u001b[0m\u001b[10;19H\u001b[42;2;8mgamma delta kappa\u001b[0m\u001b[18;45H\u001b[36;53;28miota x λόγος\u001b[0m\u001b[8;18H\u001b[38;2;204;106;148m[ok] kappa kappa\u001b[0m\u001b[10;76H\u001b[4:2mepsilon 100% x\u001b[0m\u001b[9;27H\u001b[38;5;112;3;9;24m--flag\u001b[0m\u001b[13;44H\u001b[21;38;2;82;81;72meta eta\u001b[0m\u001b[22;9H\u001b[55meta {}\u001b[0m\u001b[18;34H\u001b[22münïcödé\u001b[0m\u001b[22;11H\u001b[107;4:1mgamma\u001b[0m\u001b[23;30H\u001b[22;5;48:2::79:104:12;39m{} λόγος iota\u001b[0m\u001b[21;18H\u001b[23;9ma/b/c\u001b[0m\u001b[?47lback eta\r\n\u001b[?1049h\u001b[8;6H\u001b[7;9;55;53mdelta\u001b[0m\u001b[6;14H\u001b[27mnaïve beta --flag\u001b[0m\u001b[13;29H\u001b[47;27mtheta beta ünïcödé\u001b[0m\u001b[1;46H\u001b[25;27;58;5;151mλόγος café [ok]\u001b[0m\u001b[8;69H\u001b[29;58:2::18:130:67;5;23m100% alpha\u001b[0m\u001b[15;8H\u001b[48;2;57;144;100malpha a/b/c λόγος\u001b[0m\u001b[19;61H\u001b[8;95meta zeta\u001b[0m\u001b[16;10H\u001b[24;29;21mkappa\u001b[0m\u001b[8;12H\u001b[48;2;126;250;187;55;33miota a/b/c\u001b[0m\u001b[22;28H\u001b[28;0;4:3mλόγος\u001b[0m\u001b[10;7H\u001b[5;24;2m[ok] --flag x\u001b[0m\u001b[19;42H\u001b[4;0;22;55mdelta\u001b[0m\u001b[1;6H\u001b[7;38;5;72;3mtheta kappa\u001b[0m\u001b[22;58H\u001b[46;55;58;5;120mepsilon epsilon alpha\u001b[0m\u001b[?1049l\u001b8back [ok] theta\r\n",
            "oracle-vt-fed"
          ],
          "cols": 80,
          "rows": 24
        },
        "idempotencyKey": "alt-015.feed"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a 80x24 terminal prints the 2408-byte stream, then the title oracle-vt-fed"
    },
    {
      "id": "fed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:05a9663712f01d2292be03a745ca771acc0360ad22e855882eee9a798b66a0a9",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the title comes after the stream, so the parser has taken every byte of it"
    },
    {
      "id": "state",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "screen",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.screen.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "hash",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "d() { if command -v sha256sum >/dev/null 2>&1; then printf '%s' \"$1\" | sha256sum; else printf '%s' \"$1\" | shasum -a 256; fi; }; printf '\\033]2;vt:%.64s screen:%.64s\\007' \"$(d \"$1\")\" \"$(d \"$2\")\"",
            "sh",
            "$step:state#/state_base64",
            "$step:screen#/text"
          ],
          "cwd": "/",
          "on_exit": "keep"
        },
        "idempotencyKey": "alt-015.hash"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a second terminal titles itself vt:<sha256 of the VT state> screen:<sha256 of the screen text>; it starts in / because a new terminal otherwise inherits the folder the stream's OSC 7 reported, which does not exist"
    },
    {
      "id": "hashed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/1/lifecycle",
        "equals": "exited",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the settled checkpoint holds the hash terminal's title: the arms and the baseline compare it"
    }
  ],
  "invariants": [
    "generated by schemas/terminal-corpus/generate.py (p15-oracle-101); features: alt-screen-1049, alt-screen-1047, alt-screen-47, save-cursor",
    "the VT state and screen of the stream terminal hash to the same title on both terminal-holder arms"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
