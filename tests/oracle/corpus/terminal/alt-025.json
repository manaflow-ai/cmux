{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "alt-025",
  "suite": "terminal",
  "title": "VT alt stream 25 at 60x20",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "terminal.alt-025",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "empty",
          "name": "oracle"
        },
        "idempotencyKey": "alt-025.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "feed",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "printf '%s' \"$1\"; printf '\\033]2;%s\\007' \"$2\"; exec cat",
            "sh",
            "primary 0 kappa epsilon --flag alpha\r\nprimary 1 x {}\r\nprimary 2 theta x\r\nprimary 3 alpha x kappa\r\nprimary 4 eta λόγος epsilon\r\nprimary 5 café theta zeta naïve\r\n\u001b7\u001b[?1049h\u001b[H\u001b[2J\u001b[5;60H\u001b[2;101;23m100% λόγος\u001b[0m\u001b[6;3H\u001b[55;46;38;5;1;48;5;245münïcödé alpha\u001b[0m\u001b[15;55H\u001b[38;5;206;48:2::119:41:184;55mx zeta zeta\u001b[0m\u001b[13;10H\u001b[39mgamma kappa\u001b[0m\u001b[16;1H\u001b[7ma/b/c\u001b[0m\u001b[?1049l\u001b[?1048lback theta alpha\r\n",
            "oracle-vt-fed"
          ],
          "cols": 60,
          "rows": 20
        },
        "idempotencyKey": "alt-025.feed"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a 60x20 terminal prints the 408-byte stream, then the title oracle-vt-fed"
    },
    {
      "id": "fed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:05a9663712f01d2292be03a745ca771acc0360ad22e855882eee9a798b66a0a9",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the title comes after the stream, so the parser has taken every byte of it"
    },
    {
      "id": "state",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "screen",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.screen.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "hash",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "d() { if command -v sha256sum >/dev/null 2>&1; then printf '%s' \"$1\" | sha256sum; else printf '%s' \"$1\" | shasum -a 256; fi; }; printf '\\033]2;vt:%.64s screen:%.64s\\007' \"$(d \"$1\")\" \"$(d \"$2\")\"",
            "sh",
            "$step:state#/state_base64",
            "$step:screen#/text"
          ],
          "cwd": "/",
          "on_exit": "keep"
        },
        "idempotencyKey": "alt-025.hash"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a second terminal titles itself vt:<sha256 of the VT state> screen:<sha256 of the screen text>; it starts in / because a new terminal otherwise inherits the folder the stream's OSC 7 reported, which does not exist"
    },
    {
      "id": "hashed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/1/lifecycle",
        "equals": "exited",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the settled checkpoint holds the hash terminal's title: the arms and the baseline compare it"
    }
  ],
  "invariants": [
    "generated by schemas/terminal-corpus/generate.py (p15-oracle-101); features: alt-screen-1049, alt-screen-1047, alt-screen-47, save-cursor",
    "the VT state and screen of the stream terminal hash to the same title on both terminal-holder arms"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
