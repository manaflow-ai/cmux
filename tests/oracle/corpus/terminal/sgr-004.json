a/b/c iota \u001b[58:2::189:109:80;25ma/b/c alpha delta \u001b[5;38;5;78;4:2;3mtheta 100% café \u001b[24;93;4;91ma/b/c alpha λόγος x \u001b[7D\u001b[4X\r\n\u001b[28mλόγος \u001b[5D\u001b[4X\r\n\u001b[4:5mcafé gamma naïve naïve \u001b[97;4;38;2;52;62;87;38;2;217;131;118mkappa --flag \u001b[53;48;5;103;9;0m\u001b[K\r\n\u001b[40;24;27mgamma iota alpha --flag \u001b[39;21mλόγος gamma zeta \u001b[101mkappa \u001b[59;49;8;38;2;42;42;205mepsilon ünïcödé \u001b[104;49;53;96mx café café \u001b[0m\r\n\u001b[48:2::124:166:19;25;27mdelta \u001b[58:2::84:237:3;38;2;88;66;135mtheta a/b/c delta naïve \u001b[28;58;5;51mtheta \u001b[8;39;7;33miota --flag \r\n\u001b[8;39m[ok] \u001b[55;38;5;31;103;23m{} [ok] \u001b[8;36mkappa kappa iota \u001b[48;2;81;134;250;39mcafé café 100% \u001b[27;0m{} café \u001b[0m\r\n\u001b[48;2;201;2;212;24ma/b/c 100% gamma --flag \u001b[7D\u001b[5X\r\n\u001b[5ma/b/c eta zeta \u001b[29mepsilon theta gamma ünïcödé \u001b[1miota gamma λόγος kappa \u001b[48:2::125:98:74;5;30mzeta \u001b[0m\r\n\u001b[0m",
