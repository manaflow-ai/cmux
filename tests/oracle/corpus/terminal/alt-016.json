{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "alt-016",
  "suite": "terminal",
  "title": "VT alt stream 16 at 40x12",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "terminal.alt-016",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "empty",
          "name": "oracle"
        },
        "idempotencyKey": "alt-016.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "feed",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "printf '%s' \"$1\"; printf '\\033]2;%s\\007' \"$2\"; exec cat",
            "sh",
            "primary 0 zeta beta\r\nprimary 1 eta ünïcödé theta λόγος delta\r\nprimary 2 epsilon 100% theta\r\n\u001b[?47h\u001b[H\u001b[2J\u001b[2;11H\u001b[7mtheta theta ünïcödé\u001b[0m\u001b[5;28H\u001b[24mzeta café\u001b[0m\u001b[8;33H\u001b[38:2::45:41:247;40münïcödé --flag ünïcödé\u001b[0m\u001b[6;27H\u001b[34;95;35;22miota ünïcödé\u001b[0m\u001b[?1047h\u001b[H\u001b[2J\u001b[11;24H\u001b[58;5;75münïcödé beta delta\u001b[0m\u001b[11;12H\u001b[102;4:5;49m{} a/b/c alpha\u001b[0m\u001b[6;40H\u001b[2m100% a/b/c epsilon\u001b[0m\u001b[11;22H\u001b[58;5;70;2mx theta\u001b[0m\u001b[12;11H\u001b[5;32;58:2::131:62:150;38:2::241:102:149mcafé x\u001b[0m\u001b[5;28H\u001b[24;25münïcödé\u001b[0m\u001b[4;37H\u001b[4:4;48;2;32;166;212;21;104mdelta naïve\u001b[0m\u001b[7;12H\u001b[8;9mλόγος delta a/b/c\u001b[0m\u001b[5;13H\u001b[53münïcödé beta {}\u001b[0m\u001b[?1047lback zeta alpha x λόγος\r\n\u001b7\u001b[?1049h\u001b[10;9H\u001b[38;2;63;15;23;97;22mλόγος gamma\u001b[0m\u001b[10;19H\u001b[4malpha x 100%\u001b[0m\u001b[8;36H\u001b[40;58:2::13:0:211;100m100% λόγος\u001b[0m\u001b[12;12H\u001b[48;5;228;21mepsilon x beta\u001b[0m\u001b[7;39H\u001b[58:2::245:93:158ma/b/c\u001b[0m\u001b[6;38H\u001b[29;45;4:2;48;2;17;234;146miota iota\u001b[0m\u001b[9;3H\u001b[47;27ma/b/c\u001b[0m\u001b[7;3H\u001b[48:2::112:97:228mx zeta {}\u001b[0m\u001b[2;1H\u001b[38;2;200;67;33mtheta\u001b[0m\u001b[7;16H\u001b[38;5;11;8mkappa gamma eta\u001b[0m\u001b[5;34H\u001b[101;4:5;4:0mcafé\u001b[0m\u001b[5;24H\u001b[38;5;45;48;2;81;46;76;45;23mnaïve --flag {}\u001b[0m\u001b[?1049l\u001b[?1048lback iota epsilon\r\n",
            "oracle-vt-fed"
          ],
          "cols": 40,
          "rows": 12
        },
        "idempotencyKey": "alt-016.feed"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a 40x12 terminal prints the 1211-byte stream, then the title oracle-vt-fed"
    },
    {
      "id": "fed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:05a9663712f01d2292be03a745ca771acc0360ad22e855882eee9a798b66a0a9",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the title comes after the stream, so the parser has taken every byte of it"
    },
    {
      "id": "state",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "screen",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.screen.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "hash",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "d() { if command -v sha256sum >/dev/null 2>&1; then printf '%s' \"$1\" | sha256sum; else printf '%s' \"$1\" | shasum -a 256; fi; }; printf '\\033]2;vt:%.64s screen:%.64s\\007' \"$(d \"$1\")\" \"$(d \"$2\")\"",
            "sh",
            "$step:state#/state_base64",
            "$step:screen#/text"
          ],
          "cwd": "/",
          "on_exit": "keep"
        },
        "idempotencyKey": "alt-016.hash"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a second terminal titles itself vt:<sha256 of the VT state> screen:<sha256 of the screen text>; it starts in / because a new terminal otherwise inherits the folder the stream's OSC 7 reported, which does not exist"
    },
    {
      "id": "hashed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/1/lifecycle",
        "equals": "exited",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the settled checkpoint holds the hash terminal's title: the arms and the baseline compare it"
    }
  ],
  "invariants": [
    "generated by schemas/terminal-corpus/generate.py (p15-oracle-101); features: alt-screen-1049, alt-screen-1047, alt-screen-47, save-cursor",
    "the VT state and screen of the stream terminal hash to the same title on both terminal-holder arms"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
