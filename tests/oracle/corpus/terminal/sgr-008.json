{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "sgr-008",
  "suite": "terminal",
  "title": "VT sgr stream 8 at 20x6",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "terminal.sgr-008",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "empty",
          "name": "oracle"
        },
        "idempotencyKey": "sgr-008.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "feed",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "printf '%s' \"$1\"; printf '\\033]2;%s\\007' \"$2\"; exec cat",
            "sh",
            "\u001b[58;5;26;53;9mkappa λόγος --flag kappa \u001b[93;39mkappa [ok] {} beta \u001b[8;9;9mλόγος --flag \u001b[7mλόγος [ok] --flag ünïcödé \u001b[48;2;236;45;45;28;39;48;5;22mgamma \r\n\u001b[48:2::106:151:113;35;1;4:4mbeta naïve alpha gamma \u001b[91;59mx --flag naïve \u001b[58:2::190:94:247;7;29;21mbeta λόγος iota alpha \u001b[55;53;47;4malpha --flag delta \u001b[29münïcödé alpha alpha café \u001b[4:5;29;22miota \r\n\u001b[55mepsilon epsilon a/b/c \u001b[1mdelta 100% x {} \u001b[48:2::153:194:41;22;23;48;2;211;206;99mdelta iota gamma delta \u001b[105;34;4;4:3mcafé --flag kappa \u001b[5m\u001b[K\r\n\u001b[22mx ünïcödé delta \u001b[48:2::43:111:240;42;53m--flag eta alpha λόγος \u001b[5D\u001b[4X\r\n\u001b[47;9meta λόγος \u001b[4;58:2::119:252:151;9;27mnaïve --flag delta \u001b[49;7;47;48;5;109mx \u001b[53;9m{} iota delta delta \u001b[4;24mdelta x \u001b[49;59;32meta \r\n\u001b[58;5;233;49münïcödé ünïcödé \u001b[58:2::29:24:164;58;5;173;4:5m100% \u001b[38:2::189:68:228;9m--flag \u001b[7m--flag delta \u001b[44;38;2;253;92;246;48;2;211;122;208m\u001b[K\r\n\u001b[38;2;120;114;198;29;96ma/b/c naïve \u001b[38;5;31;32ma/b/c \u001b[9münïcödé beta \u001b[3;39;5ma/b/c λόγος λόγος \u001b[48;5;215;28;40m{} \u001b[6D\u001b[1X\r\n\u001b[35mnaïve epsilon [ok] \u001b[38;2;19;151;78;8;38;2;143;53;232;48;2;145;230;158mλόγος 100% x a/b/c \r\n\u001b[5m[ok] x naïve \u001b[97;38;5;132;38;5;240;38:2::76:152:78mnaïve a/b/c \u001b[53;23;9;58:2::107:237:210münïcödé ünïcödé \u001b[37;106mx \u001b[48;2;247;253;234m\u001b[K\r\n\u001b[53;106mbeta \u001b[38:2::125:229:206;25m{} {} eta kappa \u001b[22;36;9;8m\u001b[K\r\n\u001b[0m",
            "oracle-vt-fed"
          ],
          "cols": 20,
          "rows": 6
        },
        "idempotencyKey": "sgr-008.feed"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a 20x6 terminal prints the 1425-byte stream, then the title oracle-vt-fed"
    },
    {
      "id": "fed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:05a9663712f01d2292be03a745ca771acc0360ad22e855882eee9a798b66a0a9",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the title comes after the stream, so the parser has taken every byte of it"
    },
    {
      "id": "state",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "screen",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.screen.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "hash",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "d() { if command -v sha256sum >/dev/null 2>&1; then printf '%s' \"$1\" | sha256sum; else printf '%s' \"$1\" | shasum -a 256; fi; }; printf '\\033]2;vt:%.64s screen:%.64s\\007' \"$(d \"$1\")\" \"$(d \"$2\")\"",
            "sh",
            "$step:state#/state_base64",
            "$step:screen#/text"
          ],
          "cwd": "/",
          "on_exit": "keep"
        },
        "idempotencyKey": "sgr-008.hash"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a second terminal titles itself vt:<sha256 of the VT state> screen:<sha256 of the screen text>; it starts in / because a new terminal otherwise inherits the folder the stream's OSC 7 reported, which does not exist"
    },
    {
      "id": "hashed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/1/lifecycle",
        "equals": "exited",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the settled checkpoint holds the hash terminal's title: the arms and the baseline compare it"
    }
  ],
  "invariants": [
    "generated by schemas/terminal-corpus/generate.py (p15-oracle-101); features: sgr, palette, truecolor, underline-styles, underline-color, bce, ech",
    "the VT state and screen of the stream terminal hash to the same title on both terminal-holder arms"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
