λόγος {} eta \u001b[25meta {} eta \u001b[38;5;249;8;106meta café [ok] \r\n\u001b[28;25;3meta naïve \r\n\u001b[59mλόγος \u001b[1;24;39meta café kappa \u001b[48:2::64:0:77;25;48:2::78:174:33mgamma beta \u001b[48:2::69:181:126;0;36münïcödé --flag \u001b[4:2;42;25;21mtheta \u001b[1;4;38;5;187ma/b/c kappa \u001b[0m\r\n\u001b[7;0;4:0;25miota delta a/b/c \u001b[9;38;2;140;42;107mcafé {} a/b/c zeta \u001b[48:2::65:87:211;28;24mgamma epsilon x \u001b[4:5;4;48:2::191:129:227;27mdelta \u001b[24;103mcafé \u001b[24;58;5;153;104m\u001b[K\r\n\u001b[48:2::51:82:30;48;2;84;154;196mtheta x \u001b[48;2;107;48;194;48;5;81;2m{} \u001b[7;58:2::238:74:34mepsilon alpha 100% alpha \u001b[3D\u001b[1X\r\n\u001b[49;1;27;48:2::113:239:51mepsilon theta zeta kappa \u001b[4:0;9;38;2;148;58;161mx epsilon \r\n\u001b[93;4:0;35münïcödé kappa café delta \r\n\u001b[48;5;6;53;9m[ok] eta epsilon λόγος \u001b[42;48;5;145malpha \u001b[38;5;70;49;7mcafé [ok] iota \u001b[93;7;27ma/b/c naïve \u001b[21;101;1;4:5mdelta iota gamma iota \r\n\u001b[23;49;7miota \u001b[38:2::236:238:165miota ünïcödé alpha gamma \r\n\u001b[40;48;2;174;64;232mnaïve alpha \u001b[7;2;39mzeta \u001b[29;25;55mcafé \u001b[45;5;55mzeta --flag theta \u001b[48;5;86;23;4;8münïcödé gamma \u001b[4:1;4:2mbeta epsilon a/b/c \u001b[0m\r\n\u001b[4:0;48;2;112;131;209münïcödé café ünïcödé \u001b[42;96;4:0malpha iota \u001b[59;22;21mgamma alpha \u001b[6D\u001b[3X\r\n\u001b[0m",
            "oracle-vt-fed"
          ],
          "cols": 80,
          "rows": 24
        },
        "idempotencyKey": "sgr-005.feed"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a 80x24 terminal prints the 2898-byte stream, then the title oracle-vt-fed"
    },
    {
      "id": "fed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:05a9663712f01d2292be03a745ca771acc0360ad22e855882eee9a798b66a0a9",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the title comes after the stream, so the parser has taken every byte of it"
    },
    {
      "id": "state",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "screen",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.screen.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "hash",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "d() { if command -v sha256sum >/dev/null 2>&1; then printf '%s' \"$1\" | sha256sum; else printf '%s' \"$1\" | shasum -a 256; fi; }; printf '\\033]2;vt:%.64s screen:%.64s\\007' \"$(d \"$1\")\" \"$(d \"$2\")\"",
            "sh",
            "$step:state#/state_base64",
            "$step:screen#/text"
          ],
          "cwd": "/",
          "on_exit": "keep"
        },
        "idempotencyKey": "sgr-005.hash"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a second terminal titles itself vt:<sha256 of the VT state> screen:<sha256 of the screen text>; it starts in / because a new terminal otherwise inherits the folder the stream's OSC 7 reported, which does not exist"
    },
    {
      "id": "hashed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/1/lifecycle",
        "equals": "exited",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the settled checkpoint holds the hash terminal's title: the arms and the baseline compare it"
    }
  ],
  "invariants": [
    "generated by schemas/terminal-corpus/generate.py (p15-oracle-101); features: sgr, palette, truecolor, underline-styles, underline-color, bce, ech",
    "the VT state and screen of the stream terminal hash to the same title on both terminal-holder arms"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
