:2::108:146:186;101;38;2;37;50;56miota --flag \r\n\u001b[25;4;5;4:0ma/b/c alpha a/b/c \u001b[24;21;9;48:2::194:20:191ma/b/c 100% zeta \u001b[2;59;21;58:2::197:48:153mnaïve gamma zeta iota \u001b[0m\r\n\u001b[53;23miota café λόγος delta \u001b[58;5;163;1;38;2;255;158;196mλόγος 100% eta \u001b[29meta 100% delta \u001b[1D\u001b[5X\r\n\u001b[29;38:2::28:94:228mdelta \r\n\u001b[90;38;2;248;246;210mλόγος a/b/c zeta \u001b[0m\r\n\u001b[49;38;5;197;48;2;235;19;230m100% \u001b[91m--flag café gamma --flag \u001b[9;48;2;144;226;174mcafé delta a/b/c \u001b[9;53;58;5;59mdelta delta alpha alpha \u001b[29;49;22;29malpha alpha {} a/b/c \u001b[0m\r\n\u001b[23;9;53m[ok] alpha eta \u001b[27;48;5;44;3;39mtheta \u001b[58;5;219mcafé naïve \u001b[23;9mx \u001b[4:0;59;48:2::200:246:50mx eta \u001b[25m100% \r\n\u001b[24;28m100% naïve \u001b[5mtheta gamma {} [ok] \u001b[29mλόγος \u001b[8D\u001b[1X\r\n\u001b[0m",
