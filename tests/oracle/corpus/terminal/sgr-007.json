{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "sgr-007",
  "suite": "terminal",
  "title": "VT sgr stream 7 at 40x12",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "terminal.sgr-007",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "empty",
          "name": "oracle"
        },
        "idempotencyKey": "sgr-007.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "feed",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "printf '%s' \"$1\"; printf '\\033]2;%s\\007' \"$2\"; exec cat",
            "sh",
            "\u001b[103mepsilon eta \u001b[58;5;202;22;24;49mx \r\n\u001b[2;4:1;39;0mx \u001b[59;8;38:2::96:77:39;3mkappa iota 100% kappa \u001b[59;38;2;157;183;149mx \u001b[107meta {} \u001b[2D\u001b[6X\r\n\u001b[40;58;5;249;24mzeta --flag zeta theta \u001b[1;2;22miota eta kappa \u001b[23;39;25;58:2::20:22:120mx ünïcödé \r\n\u001b[49mkappa \u001b[38:2::237:217:203;3;48;2;45;156;216;92mx theta \u001b[105;102;39m--flag eta \u001b[25ma/b/c x naïve theta \u001b[5D\u001b[1X\r\n\u001b[9;58:2::192:177:202;55;38;2;217;104;245mdelta naïve a/b/c \u001b[5ma/b/c \u001b[95;4:0meta \u001b[4:1mλόγος \u001b[0m\r\n\u001b[38;2;15;183;188;27;3;22meta \u001b[34mdelta café \u001b[4ma/b/c [ok] epsilon \u001b[53;28mkappa epsilon {} alpha \u001b[8D\u001b[3X\r\n\u001b[2;27;92;58;5;194mcafé epsilon \u001b[8;8mtheta \u001b[4:4;53;29m\u001b[K\r\n\u001b[28;27;59;21mgamma eta {} epsilon \u001b[0m\r\n\u001b[3;38;5;47;31mnaïve alpha \u001b[3mbeta \u001b[5D\u001b[1X\r\n\u001b[27;93;2mdelta ünïcödé ünïcödé alpha \u001b[5;21;38:2::158:22:127;53ma/b/c --flag \u001b[38;5;59;59;53;1mλόγος \u001b[92m{} ünïcödé \u001b[91;38;5;151;101;38;5;79m100% theta \u001b[3D\u001b[5X\r\n\u001b[21m[ok] delta alpha \u001b[38;2;205;5;132;48;2;173;124;15;23;0mbeta naïve \r\n\u001b[0m",
            "oracle-vt-fed"
          ],
          "cols": 40,
          "rows": 12
        },
        "idempotencyKey": "sgr-007.feed"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a 40x12 terminal prints the 1005-byte stream, then the title oracle-vt-fed"
    },
    {
      "id": "fed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:05a9663712f01d2292be03a745ca771acc0360ad22e855882eee9a798b66a0a9",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the title comes after the stream, so the parser has taken every byte of it"
    },
    {
      "id": "state",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "screen",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.screen.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "hash",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "d() { if command -v sha256sum >/dev/null 2>&1; then printf '%s' \"$1\" | sha256sum; else printf '%s' \"$1\" | shasum -a 256; fi; }; printf '\\033]2;vt:%.64s screen:%.64s\\007' \"$(d \"$1\")\" \"$(d \"$2\")\"",
            "sh",
            "$step:state#/state_base64",
            "$step:screen#/text"
          ],
          "cwd": "/",
          "on_exit": "keep"
        },
        "idempotencyKey": "sgr-007.hash"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a second terminal titles itself vt:<sha256 of the VT state> screen:<sha256 of the screen text>; it starts in / because a new terminal otherwise inherits the folder the stream's OSC 7 reported, which does not exist"
    },
    {
      "id": "hashed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/1/lifecycle",
        "equals": "exited",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the settled checkpoint holds the hash terminal's title: the arms and the baseline compare it"
    }
  ],
  "invariants": [
    "generated by schemas/terminal-corpus/generate.py (p15-oracle-101); features: sgr, palette, truecolor, underline-styles, underline-color, bce, ech",
    "the VT state and screen of the stream terminal hash to the same title on both terminal-holder arms"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
