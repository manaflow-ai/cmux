90H\u001b[97;5m[ok]\u001b[0m\u001b[21;16H\u001b[4;24mnaïve\u001b[0m\u001b[5;72H\u001b[4:4;55;55mtheta naïve zeta\u001b[0m\u001b[25;34H\u001b[21mtheta\u001b[0m\u001b[1;70H\u001b[48;2;160;80;87;48:2::27:102:72;3;44mx 100% {}\u001b[0m\u001b[28;83H\u001b[4münïcödé\u001b[0m\u001b[?1049l\u001b8back naïve beta 100% {}\r\n\u001b[?1048h\u001b[?47h\u001b[H\u001b[2J\u001b[18;60H\u001b[23;4:0;37;33mλόγος epsilon\u001b[0m\u001b[6;58H\u001b[59;30;48;5;154;39m--flag eta\u001b[0m\u001b[15;62H\u001b[39münïcödé [ok] kappa\u001b[0m\u001b[19;78H\u001b[23meta\u001b[0m\u001b[23;56H\u001b[53;25;4miota\u001b[0m\u001b[10;77H\u001b[28;1;38;2;11;75;197;27mλόγος a/b/c alpha\u001b[0m\u001b[25;64H\u001b[2;55mzeta café\u001b[0m\u001b[12;25H\u001b[24;48;2;233;138;136;28;58:2::108:82:24malpha delta\u001b[0m\u001b[27;15H\u001b[48;2;112;139;138;32;38;2;51;29;98;38;2;64;37;203mzeta\u001b[0m\u001b[10;40H\u001b[48:2::17:242:209;47;4:2;28meta\u001b[0m\u001b[24;77H\u001b[21;38;5;45;48:2::29:251:157mgamma\u001b[0m\u001b[3;56H\u001b[38;5;69;29;48:2::247:12:108;22mcafé ünïcödé\u001b[0m\u001b[10;61H\u001b[4;58:2::255:137:43;59mbeta iota\u001b[0m\u001b[7;62H\u001b[3;38:2::38:36:222;5;53münïcödé\u001b[0m\u001b[6;75H\u001b[38;5;195mepsilon gamma\u001b[0m\u001b[8;34H\u001b[8;25m{} iota λόγος\u001b[0m\u001b[16;70H\u001b[0;48;2;86;72;31m[ok]\u001b[0m\u001b[4;61H\u001b[53;59;46mcafé alpha\u001b[0m\u001b[27;69H\u001b[25;59;48;5;89miota {}\u001b[0m\u001b[24;44H\u001b[38:2::170:0:148meta gamma theta\u001b[0m\u001b[8;13H\u001b[58;5;162;55;107;5mtheta eta\u001b[0m\u001b[26;2H\u001b[27mbeta\u001b[0m\u001b[8;39H\u001b[93;2;23m--flag a/b/c\u001b[0m\u001b[15;34H\u001b[44;4:0;48;2;174;42;67mbeta λόγος x\u001b[0m\u001b[9;56H\u001b[53;29;59;59m[ok] 100% gamma\u001b[0m",
            "oracle-vt-fed"
          ],
          "cols": 100,
          "rows": 30
        },
        "idempotencyKey": "alt-002.feed"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a 100x30 terminal prints the 2950-byte stream, then the title oracle-vt-fed"
    },
    {
      "id": "fed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:05a9663712f01d2292be03a745ca771acc0360ad22e855882eee9a798b66a0a9",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the title comes after the stream, so the parser has taken every byte of it"
    },
    {
      "id": "state",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "screen",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.screen.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "hash",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "d() { if command -v sha256sum >/dev/null 2>&1; then printf '%s' \"$1\" | sha256sum; else printf '%s' \"$1\" | shasum -a 256; fi; }; printf '\\033]2;vt:%.64s screen:%.64s\\007' \"$(d \"$1\")\" \"$(d \"$2\")\"",
            "sh",
            "$step:state#/state_base64",
            "$step:screen#/text"
          ],
          "cwd": "/",
          "on_exit": "keep"
        },
        "idempotencyKey": "alt-002.hash"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a second terminal titles itself vt:<sha256 of the VT state> screen:<sha256 of the screen text>; it starts in / because a new terminal otherwise inherits the folder the stream's OSC 7 reported, which does not exist"
    },
    {
      "id": "hashed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/1/lifecycle",
        "equals": "exited",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the settled checkpoint holds the hash terminal's title: the arms and the baseline compare it"
    }
  ],
  "invariants": [
    "generated by schemas/terminal-corpus/generate.py (p15-oracle-101); features: alt-screen-1049, alt-screen-1047, alt-screen-47, save-cursor",
    "the VT state and screen of the stream terminal hash to the same title on both terminal-holder arms"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
