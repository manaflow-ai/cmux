{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "osc-017",
  "suite": "terminal",
  "title": "VT osc stream 17 at 60x20",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "terminal.osc-017",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "empty",
          "name": "oracle"
        },
        "idempotencyKey": "osc-017.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "feed",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "printf '%s' \"$1\"; printf '\\033]2;%s\\007' \"$2\"; exec cat",
            "sh",
            "\u001b[57G\u001b]8;id=l0;http://localhost/tmp/item-0?q=279\u0007\u001b[31m--flag --flag kappa\u001b[0m\u001b]8;;\u0007 eta\r\n\u001b]8;;http://127.0.0.1:8123/tmp/item-1?q=523\u0007\u001b[3;4:4mtheta {} alpha\u001b[0m\u001b]8;;\u0007 \r\n\u001b]8;id=l2;file:///tmp/item-2\u001b\\\u001b[27;102;3miota\u001b[0m\u001b]8;;\u001b\\ \r\n\u001b[57G\u001b]8;id=l0;http://localhost/tmp/item-3?q=630\u0007\u001b[39;48:2::112:57:12;24m[ok] --flag 100%\u001b[0m\u001b]8;;\u0007 \r\n\u001b[57G\u001b]8;id=l1;http://127.0.0.1:8123/tmp/item-4?q=110\u001b\\\u001b[48;2;8;242;2;22;97;38:2::174:145:46m--flag x alpha\u001b[0m\u001b]8;;\u001b\\ \r\n\u001b]8;id=l2;http://localhost/tmp/item-5?q=2\u001b\\\u001b[38;5;151;22;95;25miota naïve kappa\u001b[0m\u001b]8;;\u001b\\ beta iota\r\n\u001b]8;;file:///tmp/item-6\u001b\\\u001b[23;4:2;9;58:2::213:33:155mcafé delta\u001b[0m\u001b]8;;\u001b\\ a/b/c\r\n\u001b[57G\u001b]8;;file:///tmp/item-7\u0007\u001b[28;8mλόγος\u001b[0m \r\n\u001b]8;id=l2;http://[::1]:9/tmp/item-8?q=879\u0007\u001b[27;39m--flag [ok]\u001b[0m\u001b]8;;\u0007 delta\r\n\u001b]8;id=l0;file:///tmp/item-9\u0007\u001b[2;8;48:2::241:231:239mbeta\u001b[0m\u001b]8;;\u0007 \r\n\u001b]8;id=l1;file:///tmp/item-10\u0007\u001b[36;0;58:2::167:115:255;90mcafé --flag\u001b[0m \r\n\u001b[57G\u001b]8;id=l2;http://[::1]:9/tmp/item-11?q=131\u0007\u001b[59mepsilon zeta 100%\u001b[0m theta a/b/c\r\n\u001b]8;;http://127.0.0.1:8123/tmp/item-12?q=409\u001b\\\u001b[38;5;189;38:2::22:120:251;22;8mx\u001b[0m\u001b]8;;\u001b\\ epsilon naïve\r\n",
            "oracle-vt-fed"
          ],
          "cols": 60,
          "rows": 20
        },
        "idempotencyKey": "osc-017.feed"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a 60x20 terminal prints the 1111-byte stream, then the title oracle-vt-fed"
    },
    {
      "id": "fed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:05a9663712f01d2292be03a745ca771acc0360ad22e855882eee9a798b66a0a9",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the title comes after the stream, so the parser has taken every byte of it"
    },
    {
      "id": "state",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "screen",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.screen.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "hash",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "d() { if command -v sha256sum >/dev/null 2>&1; then printf '%s' \"$1\" | sha256sum; else printf '%s' \"$1\" | shasum -a 256; fi; }; printf '\\033]2;vt:%.64s screen:%.64s\\007' \"$(d \"$1\")\" \"$(d \"$2\")\"",
            "sh",
            "$step:state#/state_base64",
            "$step:screen#/text"
          ],
          "cwd": "/",
          "on_exit": "keep"
        },
        "idempotencyKey": "osc-017.hash"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a second terminal titles itself vt:<sha256 of the VT state> screen:<sha256 of the screen text>; it starts in / because a new terminal otherwise inherits the folder the stream's OSC 7 reported, which does not exist"
    },
    {
      "id": "hashed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/1/lifecycle",
        "equals": "exited",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the settled checkpoint holds the hash terminal's title: the arms and the baseline compare it"
    }
  ],
  "invariants": [
    "generated by schemas/terminal-corpus/generate.py (p15-oracle-101); features: osc8, osc7, osc133, title, osc4, osc10-12",
    "the VT state and screen of the stream terminal hash to the same title on both terminal-holder arms"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
