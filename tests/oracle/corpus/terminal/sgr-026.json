{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "sgr-026",
  "suite": "terminal",
  "title": "VT sgr stream 26 at 40x12",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "terminal.sgr-026",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "empty",
          "name": "oracle"
        },
        "idempotencyKey": "sgr-026.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "feed",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "printf '%s' \"$1\"; printf '\\033]2;%s\\007' \"$2\"; exec cat",
            "sh",
            "\u001b[91;9;5;23m--flag [ok] naïve {} \u001b[103;7;4:5malpha a/b/c alpha \u001b[4:3;2;4:2mtheta gamma \u001b[0m\r\n\u001b[58;5;115miota epsilon alpha gamma \u001b[0m\r\n\u001b[53;38;5;124;25mcafé iota [ok] \u001b[22;4:2münïcödé 100% \u001b[29meta --flag beta delta \u001b[47;4:1;4mx {} λόγος \u001b[0;97;21mnaïve \r\n\u001b[0;1;48;2;42;169;203;38;2;34;166;239meta x \u001b[53;106;4:1;38;5;126mtheta λόγος beta \u001b[48;5;96;2;4:4m--flag alpha --flag \r\n\u001b[48;2;35;187;5;49;38;2;23;250;79;7ma/b/c iota x \u001b[8;48;5;109;4:1;48:2::233:249:236m[ok] alpha a/b/c \u001b[58;5;48m--flag café {} \u001b[28;3miota kappa kappa \u001b[59;101;38;5;143m\u001b[K\r\n\u001b[30;35m--flag a/b/c gamma \u001b[92;48;2;131;59;157miota 100% ünïcödé a/b/c \u001b[4:3;47;48:2::169:105:40mdelta \u001b[48:2::192:52:149;4:2meta \u001b[44;48:2::240:107:59;58;5;167miota eta epsilon \u001b[5;25;0;53mzeta x \u001b[36;55;22;31m\u001b[K\r\n\u001b[38;2;54;120;249;7mkappa 100% --flag \u001b[28;38:2::168:182:245;4:5mkappa epsilon kappa \u001b[101;0münïcödé naïve gamma \u001b[48;5;217;4:3;25;59mx gamma ünïcödé beta \r\n\u001b[58:2::28:217:92mkappa alpha x \u001b[4;4:0;39;4mλόγος eta epsilon \u001b[21mkappa beta \u001b[25;38;5;161m--flag \u001b[1;28münïcödé {} alpha \u001b[9;44;59;100mbeta zeta theta x \u001b[0m\r\n\u001b[48:2::72:168:208;49;24;0ma/b/c a/b/c zeta [ok] \u001b[39;48:2::91:226:162mbeta gamma \u001b[3mdelta λόγος {} \u001b[59;59;4:1;3m100% iota \u001b[4:2;53;28;7mx iota a/b/c \u001b[2D\u001b[4X\r\n\u001b[59m[ok] 100% 100% beta \u001b[25m[ok] \u001b[31;53;38;5;139mdelta zeta theta café \u001b[49;1m[ok] zeta \u001b[5D\u001b[1X\r\n\u001b[100;59;38:2::12:99:229m100% λόγος a/b/c \u001b[9mcafé delta \u001b[28;5;24meta \u001b[59;102;0;49mbeta \u001b[0m\r\n\u001b[38;2;198;180;22;49mgamma alpha λόγος \r\n\u001b[8miota alpha \u001b[1D\u001b[5X\r\n\u001b[0m",
            "oracle-vt-fed"
          ],
          "cols": 40,
          "rows": 12
        },
        "idempotencyKey": "sgr-026.feed"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a 40x12 terminal prints the 1572-byte stream, then the title oracle-vt-fed"
    },
    {
      "id": "fed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:05a9663712f01d2292be03a745ca771acc0360ad22e855882eee9a798b66a0a9",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the title comes after the stream, so the parser has taken every byte of it"
    },
    {
      "id": "state",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "screen",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.screen.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "hash",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "d() { if command -v sha256sum >/dev/null 2>&1; then printf '%s' \"$1\" | sha256sum; else printf '%s' \"$1\" | shasum -a 256; fi; }; printf '\\033]2;vt:%.64s screen:%.64s\\007' \"$(d \"$1\")\" \"$(d \"$2\")\"",
            "sh",
            "$step:state#/state_base64",
            "$step:screen#/text"
          ],
          "cwd": "/",
          "on_exit": "keep"
        },
        "idempotencyKey": "sgr-026.hash"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a second terminal titles itself vt:<sha256 of the VT state> screen:<sha256 of the screen text>; it starts in / because a new terminal otherwise inherits the folder the stream's OSC 7 reported, which does not exist"
    },
    {
      "id": "hashed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/1/lifecycle",
        "equals": "exited",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the settled checkpoint holds the hash terminal's title: the arms and the baseline compare it"
    }
  ],
  "invariants": [
    "generated by schemas/terminal-corpus/generate.py (p15-oracle-101); features: sgr, palette, truecolor, underline-styles, underline-color, bce, ech",
    "the VT state and screen of the stream terminal hash to the same title on both terminal-holder arms"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
