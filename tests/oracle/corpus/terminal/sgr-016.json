{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "sgr-016",
  "suite": "terminal",
  "title": "VT sgr stream 16 at 60x20",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "terminal.sgr-016",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "empty",
          "name": "oracle"
        },
        "idempotencyKey": "sgr-016.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "feed",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "printf '%s' \"$1\"; printf '\\033]2;%s\\007' \"$2\"; exec cat",
            "sh",
            "\u001b[25malpha x 100% {} \u001b[0;49;38:2::2:83:100;106mnaïve \u001b[7;105;48;5;128mbeta 100% [ok] zeta \u001b[97;38;2;166;252;99;59;38;5;100mbeta epsilon \u001b[47;22mepsilon x delta gamma \r\n\u001b[32;45;22;91mkappa \u001b[55;24;41miota iota λόγος \u001b[4;55;4:3;4:1mx \u001b[38;2;152;162;194;48;2;121;48;178;3;24malpha zeta eta \u001b[4:0m\u001b[K\r\n\u001b[58:2::71:28:187mkappa \u001b[4D\u001b[6X\r\n\u001b[4:3;24;38;2;28;61;208mdelta \r\n\u001b[38;2;119;81;140;48:2::160:51:146m[ok] alpha zeta naïve \u001b[2;24mnaïve \u001b[39;107;39;5m\u001b[K\r\n\u001b[21;59mtheta eta [ok] λόγος \u001b[59;38;2;78;140;104;25;48;2;229;89;114ma/b/c café \r\n\u001b[103;4:4mnaïve naïve theta \u001b[4:4;38;5;193;28m{} alpha kappa eta \u001b[25;2;58:2::230:91:38mdelta {} \u001b[8D\u001b[3X\r\n\u001b[5;4;48;2;8;206;41;48:2::167:183:142mkappa \u001b[43;27mzeta --flag \u001b[4:0;5miota --flag epsilon \u001b[7D\u001b[3X\r\n\u001b[48:2::74:255:253;1;90mcafé x \u001b[49;48;2;185;47;222mgamma theta delta \u001b[48:2::208:139:128mnaïve iota a/b/c ünïcödé \r\n\u001b[58;5;19;32m{} zeta \u001b[8D\u001b[6X\r\n\u001b[48;5;185;49;34;24mcafé \u001b[4D\u001b[5X\r\n\u001b[0m",
            "oracle-vt-fed"
          ],
          "cols": 60,
          "rows": 20
        },
        "idempotencyKey": "sgr-016.feed"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a 60x20 terminal prints the 954-byte stream, then the title oracle-vt-fed"
    },
    {
      "id": "fed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:05a9663712f01d2292be03a745ca771acc0360ad22e855882eee9a798b66a0a9",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the title comes after the stream, so the parser has taken every byte of it"
    },
    {
      "id": "state",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "screen",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.screen.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "hash",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "d() { if command -v sha256sum >/dev/null 2>&1; then printf '%s' \"$1\" | sha256sum; else printf '%s' \"$1\" | shasum -a 256; fi; }; printf '\\033]2;vt:%.64s screen:%.64s\\007' \"$(d \"$1\")\" \"$(d \"$2\")\"",
            "sh",
            "$step:state#/state_base64",
            "$step:screen#/text"
          ],
          "cwd": "/",
          "on_exit": "keep"
        },
        "idempotencyKey": "sgr-016.hash"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a second terminal titles itself vt:<sha256 of the VT state> screen:<sha256 of the screen text>; it starts in / because a new terminal otherwise inherits the folder the stream's OSC 7 reported, which does not exist"
    },
    {
      "id": "hashed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/1/lifecycle",
        "equals": "exited",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the settled checkpoint holds the hash terminal's title: the arms and the baseline compare it"
    }
  ],
  "invariants": [
    "generated by schemas/terminal-corpus/generate.py (p15-oracle-101); features: sgr, palette, truecolor, underline-styles, underline-color, bce, ech",
    "the VT state and screen of the stream terminal hash to the same title on both terminal-holder arms"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
