{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "alt-012",
  "suite": "terminal",
  "title": "VT alt stream 12 at 40x12",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "terminal.alt-012",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "empty",
          "name": "oracle"
        },
        "idempotencyKey": "alt-012.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "feed",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "printf '%s' \"$1\"; printf '\\033]2;%s\\007' \"$2\"; exec cat",
            "sh",
            "primary 0 {} alpha\r\nprimary 1 ünïcödé epsilon kappa\r\nprimary 2 alpha kappa naïve\r\nprimary 3 {} epsilon λόγος\r\nprimary 4 x epsilon epsilon naïve\r\n\u001b[?1048h\u001b[?47h\u001b[2;19H\u001b[5;58;5;181;48:2::137:252:250mtheta\u001b[0m\u001b[3;9H\u001b[23miota beta [ok]\u001b[0m\u001b[6;7H\u001b[2;2m--flag beta\u001b[0m\u001b[4;37H\u001b[53;59;96;3münïcödé alpha\u001b[0m\u001b[12;35H\u001b[7;55;49;38;2;160;128;109mx\u001b[0m\u001b[9;10H\u001b[59mdelta --flag\u001b[0m\u001b[7;21H\u001b[27;58;5;197;38:2::221:120:10;107mx beta beta\u001b[0m\u001b[11;38H\u001b[47mgamma\u001b[0m\u001b[5;40H\u001b[4:3;9m[ok] a/b/c kappa\u001b[0m\u001b[3;16H\u001b[48;2;222;129;196;48;2;182;37;55;21mdelta\u001b[0m\u001b[?47lback x λόγος gamma [ok]\r\n\u001b7\u001b[?1047h\u001b[9;27H\u001b[55mepsilon beta\u001b[0m\u001b[12;1H\u001b[0;38;5;241mλόγος 100%\u001b[0m\u001b[2;7H\u001b[4:5mzeta gamma gamma\u001b[0m\u001b[6;5H\u001b[5;58;5;150;7mzeta\u001b[0m\u001b[6;12H\u001b[38;2;167;137;16;101;38:2::31:209:1;4:2mdelta eta\u001b[0m\u001b[3;20H\u001b[27;93;92;48;2;158;237;123mbeta kappa\u001b[0m\u001b[?1047l\u001b[?1048lback λόγος {} naïve\r\n\u001b7\u001b[?1047h\u001b[H\u001b[2J\u001b[9;37H\u001b[9mcafé\u001b[0m\u001b[8;39H\u001b[47;48;2;84;117;140malpha --flag\u001b[0m\u001b[4;38H\u001b[23;96münïcödé\u001b[0m\u001b[1;14H\u001b[48;2;83;249;32;23m[ok]\u001b[0m\u001b[9;19H\u001b[0;48:2::205:53:11m--flag eta zeta\u001b[0m\u001b[5;30H\u001b[4;28mλόγος\u001b[0m\u001b[4;3H\u001b[48;2;70;25;191;39;24mzeta zeta\u001b[0m\u001b[2;11H\u001b[48;2;5;52;13mbeta\u001b[0m\u001b[6;17H\u001b[5;48;2;250;91;102;28;23malpha naïve\u001b[0m\u001b[8;28H\u001b[2;40mx\u001b[0m\u001b[10;9H\u001b[7;48;2;22;14;24meta café\u001b[0m\u001b[9;6H\u001b[39;4;48;2;60;121;136;44münïcödé zeta\u001b[0m",
            "oracle-vt-fed"
          ],
          "cols": 40,
          "rows": 12
        },
        "idempotencyKey": "alt-012.feed"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a 40x12 terminal prints the 1326-byte stream, then the title oracle-vt-fed"
    },
    {
      "id": "fed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:05a9663712f01d2292be03a745ca771acc0360ad22e855882eee9a798b66a0a9",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the title comes after the stream, so the parser has taken every byte of it"
    },
    {
      "id": "state",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "screen",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.screen.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "hash",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "d() { if command -v sha256sum >/dev/null 2>&1; then printf '%s' \"$1\" | sha256sum; else printf '%s' \"$1\" | shasum -a 256; fi; }; printf '\\033]2;vt:%.64s screen:%.64s\\007' \"$(d \"$1\")\" \"$(d \"$2\")\"",
            "sh",
            "$step:state#/state_base64",
            "$step:screen#/text"
          ],
          "cwd": "/",
          "on_exit": "keep"
        },
        "idempotencyKey": "alt-012.hash"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a second terminal titles itself vt:<sha256 of the VT state> screen:<sha256 of the screen text>; it starts in / because a new terminal otherwise inherits the folder the stream's OSC 7 reported, which does not exist"
    },
    {
      "id": "hashed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/1/lifecycle",
        "equals": "exited",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the settled checkpoint holds the hash terminal's title: the arms and the baseline compare it"
    }
  ],
  "invariants": [
    "generated by schemas/terminal-corpus/generate.py (p15-oracle-101); features: alt-screen-1049, alt-screen-1047, alt-screen-47, save-cursor",
    "the VT state and screen of the stream terminal hash to the same title on both terminal-holder arms"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
