{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "osc-010",
  "suite": "terminal",
  "title": "VT osc stream 10 at 100x30",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "terminal.osc-010",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "empty",
          "name": "oracle"
        },
        "idempotencyKey": "osc-010.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "feed",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "printf '%s' \"$1\"; printf '\\033]2;%s\\007' \"$2\"; exec cat",
            "sh",
            "\u001b[97G\u001b]8;id=l0;http://127.0.0.1:8123/tmp/item-0?q=203\u001b\\\u001b[1;7;53m--flag --flag\u001b[0m\u001b]8;;\u001b\\ \r\n\u001b]8;;http://[::1]:9/tmp/item-1?q=493\u0007\u001b[4:5mgamma café gamma\u001b[0m\u001b]8;;\u0007 λόγος {}\r\n\u001b[97G\u001b]8;id=l2;http://localhost/tmp/item-2?q=105\u0007\u001b[36;95mzeta alpha\u001b[0m\u001b]8;;\u0007 café zeta\r\n\u001b]8;;http://127.0.0.1:8123/tmp/item-3?q=721\u001b\\\u001b[4:4;5m[ok] delta 100%\u001b[0m λόγος\r\n\u001b]8;;http://[::1]:9/tmp/item-4?q=72\u001b\\\u001b[27;4;96m[ok] x 100%\u001b[0m \r\n\u001b[97G\u001b]8;id=l2;http://localhost/tmp/item-5?q=178\u001b\\\u001b[47miota x ünïcödé\u001b[0m\u001b]8;;\u001b\\ epsilon\r\n\u001b]8;id=l0;http://127.0.0.1:8123/tmp/item-6?q=713\u0007\u001b[24;43;28;3münïcödé\u001b[0m\u001b]8;;\u0007 ünïcödé\r\n\u001b]8;;http://[::1]:9/tmp/item-7?q=10\u0007\u001b[41;90;27;39malpha\u001b[0m\u001b]8;;\u0007 {}\r\n\u001b]8;;http://[::1]:9/tmp/item-8?q=97\u001b\\\u001b[29;2m--flag ünïcödé 100%\u001b[0m\u001b]8;;\u001b\\ theta\r\n\u001b[97G\u001b]8;id=l0;http://localhost/tmp/item-9?q=529\u001b\\\u001b[7;25ma/b/c a/b/c\u001b[0m\u001b]8;;\u001b\\ \r\n\u001b[97G\u001b]8;;http://127.0.0.1:8123/tmp/item-10?q=251\u0007\u001b[1;4:3;38:2::194:133:41meta\u001b[0m kappa café\r\n\u001b]8;;http://127.0.0.1:8123/tmp/item-11?q=78\u0007\u001b[27;45mx\u001b[0m\u001b]8;;\u0007 \r\n\u001b]8;id=l0;http://[::1]:9/tmp/item-12?q=123\u001b\\\u001b[36;48;5;0;21m{} --flag\u001b[0m\u001b]8;;\u001b\\ alpha café\r\n\u001b[97G\u001b]8;id=l1;http://127.0.0.1:8123/tmp/item-13?q=461\u0007\u001b[41;28m100% epsilon naïve\u001b[0m café\r\n\u001b]8;;http://[::1]:9/tmp/item-14?q=439\u001b\\\u001b[104mbeta\u001b[0m\u001b]8;;\u001b\\ \r\n\u001b]8;id=l0;http://127.0.0.1:8123/tmp/item-15?q=742\u001b\\\u001b[2;48;5;165mcafé beta café\u001b[0m\u001b]8;;\u001b\\ delta\r\n\u001b]8;id=l1;file:///tmp/item-16\u001b\\\u001b[7mλόγος beta x\u001b[0m\u001b]8;;\u001b\\ naïve kappa\r\n\u001b[97G\u001b]8;id=l2;http://localhost/tmp/item-17?q=666\u0007\u001b[59;1mtheta x eta\u001b[0m\u001b]8;;\u0007 --flag 100%\r\n\u001b]8;;http://[::1]:9/tmp/item-18?q=745\u001b\\\u001b[7;4:5;48;2;209;19;173;58:2::26:224:32mepsilon kappa eta\u001b[0m\u001b]8;;\u001b\\ gamma\r\n\u001b]8;id=l1;http://localhost/tmp/item-19?q=63\u0007\u001b[48;2;148;70;123;49;38:2::108:125:238;21mbeta epsilon iota\u001b[0m \r\n\u001b[97G\u001b]8;id=l2;http://localhost/tmp/item-20?q=486\u001b\\\u001b[5;55mepsilon\u001b[0m delta\r\n\u001b[97G\u001b]8;id=l0;http://127.0.0.1:8123/tmp/item-21?q=459\u001b\\\u001b[7mcafé alpha gamma\u001b[0m {} theta\r\n\u001b]8;id=l1;http://127.0.0.1:8123/tmp/item-22?q=892\u0007\u001b[38;5;253;0;48;2;7;31;85mepsilon\u001b[0m\u001b]8;;\u0007 \r\n",
            "oracle-vt-fed"
          ],
          "cols": 100,
          "rows": 30
        },
        "idempotencyKey": "osc-010.feed"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a 100x30 terminal prints the 2017-byte stream, then the title oracle-vt-fed"
    },
    {
      "id": "fed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:05a9663712f01d2292be03a745ca771acc0360ad22e855882eee9a798b66a0a9",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the title comes after the stream, so the parser has taken every byte of it"
    },
    {
      "id": "state",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "screen",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.screen.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "hash",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "d() { if command -v sha256sum >/dev/null 2>&1; then printf '%s' \"$1\" | sha256sum; else printf '%s' \"$1\" | shasum -a 256; fi; }; printf '\\033]2;vt:%.64s screen:%.64s\\007' \"$(d \"$1\")\" \"$(d \"$2\")\"",
            "sh",
            "$step:state#/state_base64",
            "$step:screen#/text"
          ],
          "cwd": "/",
          "on_exit": "keep"
        },
        "idempotencyKey": "osc-010.hash"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a second terminal titles itself vt:<sha256 of the VT state> screen:<sha256 of the screen text>; it starts in / because a new terminal otherwise inherits the folder the stream's OSC 7 reported, which does not exist"
    },
    {
      "id": "hashed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/1/lifecycle",
        "equals": "exited",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the settled checkpoint holds the hash terminal's title: the arms and the baseline compare it"
    }
  ],
  "invariants": [
    "generated by schemas/terminal-corpus/generate.py (p15-oracle-101); features: osc8, osc7, osc133, title, osc4, osc10-12",
    "the VT state and screen of the stream terminal hash to the same title on both terminal-holder arms"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
