{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "osc-022",
  "suite": "terminal",
  "title": "VT osc stream 22 at 132x50",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "terminal.osc-022",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "empty",
          "name": "oracle"
        },
        "idempotencyKey": "osc-022.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "feed",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "printf '%s' \"$1\"; printf '\\033]2;%s\\007' \"$2\"; exec cat",
            "sh",
            "\u001b]7;file://localhost/tmp/dir%200/eta\u0007\u001b]7;file://localhost/tmp/dir%201/zeta\u001b\\\u001b]7;file://localhost/tmp/dir%202/epsilon\u001b\\\u001b]7;file://localhost/tmp/dir%203/iota\u0007\u001b]7;file://localhost/tmp/dir%204/theta\u0007\u001b]7;file://localhost/tmp/dir%205/alpha\u0007\u001b]7;file://localhost/tmp/dir%206/kappa\u0007\u001b]7;file://localhost/tmp/dir%207/iota\u0007\u001b]7;file://localhost/tmp/dir%208/gamma\u001b\\\u001b]7;file://localhost/tmp/dir%209/epsilon\u001b\\\u001b]7;file://localhost/tmp/dir%2010/epsilon\u0007\u001b]7;file://localhost/tmp/dir%2011/delta\u001b\\\u001b]7;file://localhost/tmp/dir%2012/alpha\u0007\u001b]7;file://localhost/tmp/dir%2013/zeta\u001b\\\u001b]7;file://localhost/tmp/dir%2014/theta\u001b\\\u001b]7;file://localhost/tmp/dir%2015/eta\u001b\\\u001b]7;file://localhost/tmp/dir%2016/gamma\u001b\\\u001b]7;file://localhost/tmp/dir%2017/iota\u001b\\\u001b]7;file://localhost/tmp/dir%2018/eta\u0007\u001b]7;file://localhost/tmp/dir%2019/eta\u0007\u001b]7;file://localhost/tmp/dir%2020/eta\u001b\\\u001b]7;file://localhost/tmp/dir%2021/kappa\u0007\u001b]7;file://localhost/tmp/dir%2022/iota\u001b\\\u001b]7;file://localhost/tmp/dir%2023/zeta\u001b\\\u001b]7;file://localhost/tmp/dir%2024/alpha\u001b\\\u001b]7;file://localhost/tmp/dir%2025/gamma\u001b\\\u001b]7;file://localhost/tmp/dir%2026/delta\u001b\\\u001b]7;file://localhost/tmp/dir%2027/beta\u0007\u001b]7;file://localhost/tmp/dir%2028/zeta\u001b\\\u001b]7;file://localhost/tmp/dir%2029/delta\u0007\u001b]7;file://localhost/tmp/dir%2030/eta\u0007\u001b]7;file://localhost/tmp/dir%2031/beta\u0007\u001b]7;file://localhost/tmp/dir%2032/iota\u001b\\\u001b]7;file://localhost/tmp/dir%2033/zeta\u001b\\\u001b]7;file://localhost/tmp/dir%2034/delta\u0007\u001b]7;file://localhost/tmp/dir%2035/theta\u001b\\\u001b]7;file://localhost/tmp/dir%2036/epsilon\u001b\\\u001b]7;file://localhost/tmp/dir%2037/gamma\u0007\u001b]7;file://localhost/tmp/dir%2038/alpha\u0007\u001b]7;file://localhost/tmp/dir%2039/beta\u0007\u001b]7;file://localhost/tmp/dir%2040/iota\u001b\\\u001b]7;file://localhost/tmp/dir%2041/eta\u0007\u001b]7;file://localhost/tmp/dir%2042/iota\u001b\\\u001b]7;file://localhost/tmp/dir%2043/theta\u001b\\\u001b]7;file://localhost/tmp/dir%2044/theta\u0007\u001b]7;file://localhost/tmp/dir%2045/eta\u0007\u001b]7;file://localhost/tmp/dir%2046/kappa\u001b\\\u001b]7;file://localhost/tmp/dir%2047/theta\u001b\\",
            "oracle-vt-fed"
          ],
          "cols": 132,
          "rows": 50
        },
        "idempotencyKey": "osc-022.feed"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a 132x50 terminal prints the 1913-byte stream, then the title oracle-vt-fed"
    },
    {
      "id": "fed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:05a9663712f01d2292be03a745ca771acc0360ad22e855882eee9a798b66a0a9",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the title comes after the stream, so the parser has taken every byte of it"
    },
    {
      "id": "state",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "screen",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.screen.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "hash",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "d() { if command -v sha256sum >/dev/null 2>&1; then printf '%s' \"$1\" | sha256sum; else printf '%s' \"$1\" | shasum -a 256; fi; }; printf '\\033]2;vt:%.64s screen:%.64s\\007' \"$(d \"$1\")\" \"$(d \"$2\")\"",
            "sh",
            "$step:state#/state_base64",
            "$step:screen#/text"
          ],
          "cwd": "/",
          "on_exit": "keep"
        },
        "idempotencyKey": "osc-022.hash"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a second terminal titles itself vt:<sha256 of the VT state> screen:<sha256 of the screen text>; it starts in / because a new terminal otherwise inherits the folder the stream's OSC 7 reported, which does not exist"
    },
    {
      "id": "hashed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/1/lifecycle",
        "equals": "exited",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the settled checkpoint holds the hash terminal's title: the arms and the baseline compare it"
    }
  ],
  "invariants": [
    "generated by schemas/terminal-corpus/generate.py (p15-oracle-101); features: osc8, osc7, osc133, title, osc4, osc10-12",
    "the VT state and screen of the stream terminal hash to the same title on both terminal-holder arms"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
