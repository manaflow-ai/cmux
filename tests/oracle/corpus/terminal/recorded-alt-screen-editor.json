{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "recorded-alt-screen-editor",
  "suite": "terminal",
  "title": "VT recorded stream alt-screen-editor.vt at 100x24",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "terminal.recorded-alt-screen-editor",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "empty",
          "name": "oracle"
        },
        "idempotencyKey": "recorded-alt-screen-editor.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "feed",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "printf '%s' \"$1\"; printf '\\033]2;%s\\007' \"$2\"; exec cat",
            "sh",
            "\u001b[?1049h\u001b[H\u001b[2J\u001b[?25l\u001b[1;22r\u001b[1;1H\u001b[38;5;241m   1 \u001b[0m\u001b[48;2;30;30;46mfn line_1() -> \u001b[1mu32\u001b[22m { return 1; }\u001b[K\u001b[0m\u001b[2;1H\u001b[38;5;242m   2 \u001b[0m\u001b[48;2;30;30;46mfn line_2() -> \u001b[1mu32\u001b[22m { return 2; }\u001b[K\u001b[0m\u001b[3;1H\u001b[38;5;243m   3 \u001b[0m\u001b[48;2;30;30;46mfn line_3() -> \u001b[1mu32\u001b[22m { return 3; }\u001b[K\u001b[0m\u001b[4;1H\u001b[38;5;244m   4 \u001b[0m\u001b[48;2;30;30;46mfn line_4() -> \u001b[1mu32\u001b[22m { return 4; }\u001b[K\u001b[0m\u001b[5;1H\u001b[38;5;245m   5 \u001b[0m\u001b[48;2;30;30;46mfn line_5() -> \u001b[1mu32\u001b[22m { return 5; }\u001b[K\u001b[0m\u001b[6;1H\u001b[38;5;246m   6 \u001b[0m\u001b[48;2;30;30;46mfn line_6() -> \u001b[1mu32\u001b[22m { return 6; }\u001b[K\u001b[0m\u001b[7;1H\u001b[38;5;247m   7 \u001b[0m\u001b[48;2;30;30;46mfn line_7() -> \u001b[1mu32\u001b[22m { return 7; }\u001b[K\u001b[0m\u001b[8;1H\u001b[38;5;248m   8 \u001b[0m\u001b[48;2;30;30;46mfn line_8() -> \u001b[1mu32\u001b[22m { return 8; }\u001b[K\u001b[0m\u001b[9;1H\u001b[38;5;249m   9 \u001b[0m\u001b[48;2;30;30;46mfn line_9() -> \u001b[1mu32\u001b[22m { return 9; }\u001b[K\u001b[0m\u001b[10;1H\u001b[38;5;240m  10 \u001b[0m\u001b[48;2;30;30;46mfn line_10() -> \u001b[1mu32\u001b[22m { return 10; }\u001b[K\u001b[0m\u001b[11;1H\u001b[38;5;241m  11 \u001b[0m\u001b[48;2;30;30;46mfn line_11() -> \u001b[1mu32\u001b[22m { return 11; }\u001b[K\u001b[0m\u001b[12;1H\u001b[38;5;242m  12 \u001b[0m\u001b[48;2;30;30;46mfn line_12() -> \u001b[1mu32\u001b[22m { return 12; }\u001b[K\u001b[0m\u001b[13;1H\u001b[38;5;243m  13 \u001b[0m\u001b[48;2;30;30;46mfn line_13() -> \u001b[1mu32\u001b[22m { return 13; }\u001b[K\u001b[0m\u001b[14;1H\u001b[38;5;244m  14 \u001b[0m\u001b[48;2;30;30;46mfn line_14() -> \u001b[1mu32\u001b[22m { return 14; }\u001b[K\u001b[0m\u001b[15;1H\u001b[38;5;245m  15 \u001b[0m\u001b[48;2;30;30;46mfn line_15() -> \u001b[1mu32\u001b[22m { return 15; }\u001b[K\u001b[0m\u001b[16;1H\u001b[38;5;246m  16 \u001b[0m\u001b[48;2;30;30;46mfn line_16() -> \u001b[1mu32\u001b[22m { return 16; }\u001b[K\u001b[0m\u001b[17;1H\u001b[38;5;247m  17 \u001b[0m\u001b[48;2;30;30;46mfn line_17() -> \u001b[1mu32\u001b[22m { return 17; }\u001b[K\u001b[0m\u001b[18;1H\u001b[38;5;248m  18 \u001b[0m\u001b[48;2;30;30;46mfn line_18() -> \u001b[1mu32\u001b[22m { return 18; }\u001b[K\u001b[0m\u001b[19;1H\u001b[38;5;249m  19 \u001b[0m\u001b[48;2;30;30;46mfn line_19() -> \u001b[1mu32\u001b[22m { return 19; }\u001b[K\u001b[0m\u001b[20;1H\u001b[38;5;240m  20 \u001b[0m\u001b[48;2;30;30;46mfn line_20() -> \u001b[1mu32\u001b[22m { return 20; }\u001b[K\u001b[0m\u001b[21;1H\u001b[38;5;241m  21 \u001b[0m\u001b[48;2;30;30;46mfn line_21() -> \u001b[1mu32\u001b[22m { return 21; }\u001b[K\u001b[0m\u001b[22;1H\u001b[38;5;242m  22 \u001b[0m\u001b[48;2;30;30;46mfn line_22() -> \u001b[1mu32\u001b[22m { return 22; }\u001b[K\u001b[0m\u001b[24;1H\u001b[7m-- INSERT --  src/main.zig  [+]\u001b[0m\u001b[K\u001b[5;10H\u001b[?25h\u001b[2 q\u001b[3S\u001b[?2004h\u001b[?1000h\u001b[?1006h",
            "oracle-vt-fed"
          ],
          "cols": 100,
          "rows": 24
        },
        "idempotencyKey": "recorded-alt-screen-editor.feed"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a 100x24 terminal prints the 2142-byte stream, then the title oracle-vt-fed"
    },
    {
      "id": "fed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:05a9663712f01d2292be03a745ca771acc0360ad22e855882eee9a798b66a0a9",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the title comes after the stream, so the parser has taken every byte of it"
    },
    {
      "id": "state",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "screen",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.screen.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "hash",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "d() { if command -v sha256sum >/dev/null 2>&1; then printf '%s' \"$1\" | sha256sum; else printf '%s' \"$1\" | shasum -a 256; fi; }; printf '\\033]2;vt:%.64s screen:%.64s\\007' \"$(d \"$1\")\" \"$(d \"$2\")\"",
            "sh",
            "$step:state#/state_base64",
            "$step:screen#/text"
          ],
          "cwd": "/",
          "on_exit": "keep"
        },
        "idempotencyKey": "recorded-alt-screen-editor.hash"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a second terminal titles itself vt:<sha256 of the VT state> screen:<sha256 of the screen text>; it starts in / because a new terminal otherwise inherits the folder the stream's OSC 7 reported, which does not exist"
    },
    {
      "id": "hashed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/1/lifecycle",
        "equals": "exited",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the settled checkpoint holds the hash terminal's title: the arms and the baseline compare it"
    }
  ],
  "invariants": [
    "generated by schemas/terminal-corpus/generate.py (p15-oracle-101); features: alt-screen, scroll-region, cursor-style, modes",
    "the VT state and screen of the stream terminal hash to the same title on both terminal-holder arms"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
