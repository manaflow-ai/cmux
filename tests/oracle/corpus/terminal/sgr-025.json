{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "sgr-025",
  "suite": "terminal",
  "title": "VT sgr stream 25 at 60x20",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "terminal.sgr-025",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "empty",
          "name": "oracle"
        },
        "idempotencyKey": "sgr-025.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "feed",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "printf '%s' \"$1\"; printf '\\033]2;%s\\007' \"$2\"; exec cat",
            "sh",
            "\u001b[38;2;229;103;145;48;2;14;120;149mgamma eta \u001b[59;48;2;99;36;201;23;7mλόγος [ok] beta kappa \u001b[2;1m[ok] ünïcödé \u001b[49;4:0;49;48;5;6m100% \u001b[0m\r\n\u001b[4:1m100% x \u001b[59mzeta a/b/c iota iota \u001b[48:2::134:81:6;24meta {} theta [ok] \u001b[1;5meta theta \u001b[4:2;47;38:2::236:222:255;58;5;217mgamma \r\n\u001b[29;9mλόγος 100% \u001b[3;1;49;7mcafé alpha gamma \u001b[53;4:4;28;4:2ma/b/c 100% delta x \u001b[49;58:2::62:96:123mdelta 100% \u001b[53;58;5;89;4:5;97ma/b/c \u001b[38;2;186;222;114;38;5;211mzeta delta \u001b[0m\r\n\u001b[8mbeta alpha theta naïve \u001b[22;22m{} theta café \u001b[4;28mtheta {} --flag [ok] \u001b[8;43;40m[ok] zeta a/b/c a/b/c \u001b[102;4:1;4:5;107miota {} 100% \r\n\u001b[4:0;39;0mx gamma λόγος \u001b[0;4:2mλόγος iota \u001b[58:2::121:2:173mtheta x {} \u001b[38;2;37;3;48mnaïve λόγος kappa --flag \u001b[93;58;5;228;48:2::194:237:38m[ok] \u001b[4;43mx naïve iota naïve \r\n\u001b[43münïcödé λόγος λόγος \u001b[100;55;8;8m\u001b[K\r\n\u001b[9;38:2::2:250:15mepsilon x λόγος \u001b[29;35;102;39meta --flag eta delta \u001b[4:1mx iota \u001b[48;2;35;135;91;106mgamma iota beta ünïcödé \u001b[0m\r\n\u001b[37;59;21mgamma \u001b[23;48;5;6;38:2::118:49:106malpha epsilon --flag \u001b[0m\r\n\u001b[40;102m{} x zeta x \u001b[38:2::45:177:136;55;39;29mbeta naïve a/b/c \u001b[4miota delta theta [ok] \r\n\u001b[0;22miota --flag \u001b[38:2::181:200:159;38;5;195meta {} \u001b[104;4:2m100% ünïcödé \u001b[24;23;24mtheta \u001b[4;27;48:2::190:59:9meta theta \u001b[48:2::92:190:84;46mbeta a/b/c naïve a/b/c \u001b[4D\u001b[2X\r\n\u001b[33;96;4:3;38;2;166;57;79m{} zeta iota ünïcödé \u001b[48;2;163;154;82;4:2;5mgamma ünïcödé delta x \u001b[5D\u001b[5X\r\n\u001b[0m",
            "oracle-vt-fed"
          ],
          "cols": 60,
          "rows": 20
        },
        "idempotencyKey": "sgr-025.feed"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a 60x20 terminal prints the 1487-byte stream, then the title oracle-vt-fed"
    },
    {
      "id": "fed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:05a9663712f01d2292be03a745ca771acc0360ad22e855882eee9a798b66a0a9",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the title comes after the stream, so the parser has taken every byte of it"
    },
    {
      "id": "state",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "screen",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.screen.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "hash",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "d() { if command -v sha256sum >/dev/null 2>&1; then printf '%s' \"$1\" | sha256sum; else printf '%s' \"$1\" | shasum -a 256; fi; }; printf '\\033]2;vt:%.64s screen:%.64s\\007' \"$(d \"$1\")\" \"$(d \"$2\")\"",
            "sh",
            "$step:state#/state_base64",
            "$step:screen#/text"
          ],
          "cwd": "/",
          "on_exit": "keep"
        },
        "idempotencyKey": "sgr-025.hash"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a second terminal titles itself vt:<sha256 of the VT state> screen:<sha256 of the screen text>; it starts in / because a new terminal otherwise inherits the folder the stream's OSC 7 reported, which does not exist"
    },
    {
      "id": "hashed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/1/lifecycle",
        "equals": "exited",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the settled checkpoint holds the hash terminal's title: the arms and the baseline compare it"
    }
  ],
  "invariants": [
    "generated by schemas/terminal-corpus/generate.py (p15-oracle-101); features: sgr, palette, truecolor, underline-styles, underline-color, bce, ech",
    "the VT state and screen of the stream terminal hash to the same title on both terminal-holder arms"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
