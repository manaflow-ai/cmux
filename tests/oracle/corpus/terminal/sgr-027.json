ma \u001b[25;102;4miota naïve iota beta \r\n\u001b[4:4m[ok] theta gamma naïve \u001b[48;5;199mgamma \u001b[29;38;2;207;155;172;49;97m\u001b[K\r\n\u001b[48;5;87;59mx theta {} \u001b[48;2;2;29;248;5;107ma/b/c 100% naïve \u001b[38;5;176;1;48;2;105;147;210m100% epsilon x \u001b[8;39;4:4;27mx [ok] \u001b[48;2;228;91;254;28;103;38;2;208;95;130m100% \r\n\u001b[28;53;23;3mcafé iota λόγος 100% \u001b[38;5;189;92;0;47mzeta eta \r\n\u001b[22;7;4:5mkappa naïve λόγος eta \u001b[9malpha naïve 100% \r\n\u001b[4:4meta theta kappa zeta \u001b[49;7;48;2;39;190;10;0mkappa iota café delta \u001b[48;2;64;52;219;7;21miota \u001b[106m--flag \u001b[7D\u001b[4X\r\n\u001b[25;59;25mtheta λόγος \u001b[0m\r\n\u001b[23;49;48:2::21:158:199;58;5;245m{} alpha λόγος epsilon \u001b[55;53;4:4mcafé beta epsilon 100% \r\n\u001b[97;43;53mbeta \u001b[27;48:2::85:103:28;55m100% kappa --flag gamma \u001b[29mcafé \u001b[48:2::48:14:80mkappa café beta \u001b[48;2;98;41;209;59;48;2;123;52;94mλόγος alpha alpha 100% \u001b[0m\r\n\u001b[45;38;2;141;70;40;58:2::164:78:172;59malpha \r\n\u001b[48;5;165;48;2;120;228;29miota iota ünïcödé kappa \u001b[22mnaïve \u001b[39miota ünïcödé \u001b[5;9m[ok] \u001b[41;4:2meta kappa café \u001b[28;4:5;25m\u001b[K\r\n\u001b[0m",
