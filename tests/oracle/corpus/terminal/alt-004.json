{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "alt-004",
  "suite": "terminal",
  "title": "VT alt stream 4 at 40x12",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "terminal.alt-004",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "empty",
          "name": "oracle"
        },
        "idempotencyKey": "alt-004.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "feed",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "printf '%s' \"$1\"; printf '\\033]2;%s\\007' \"$2\"; exec cat",
            "sh",
            "primary 0 café\r\nprimary 1 zeta\r\nprimary 2 λόγος x café λόγος --flag\r\nprimary 3 --flag café delta alpha delta\r\nprimary 4 delta\r\nprimary 5 ünïcödé\r\nprimary 6 x\r\n\u001b[?1047h\u001b[2;19H\u001b[4:5mλόγος café\u001b[0m\u001b[10;20H\u001b[55;43;42mzeta delta\u001b[0m\u001b[3;8H\u001b[24;96miota 100% theta\u001b[0m\u001b[10;32H\u001b[48;5;166;59;40münïcödé\u001b[0m\u001b[3;26H\u001b[5;48;5;210;28;103mgamma 100%\u001b[0m\u001b[8;21H\u001b[102;1;38;5;244m[ok] 100% alpha\u001b[0m\u001b[11;29H\u001b[5;24;41;58:2::19:219:77mcafé\u001b[0m\u001b[?1048h\u001b[?1047h\u001b[3;27H\u001b[29;58:2::101:8:38;21mbeta eta\u001b[0m\u001b[3;8H\u001b[107mx\u001b[0m\u001b[8;18H\u001b[25;44;49mzeta gamma eta\u001b[0m\u001b[1;19H\u001b[58:2::106:83:126mcafé ünïcödé --flag\u001b[0m\u001b[8;21H\u001b[93;58:2::91:122:70mλόγος λόγος zeta\u001b[0m\u001b[5;25H\u001b[59;8ma/b/c\u001b[0m\u001b[8;36H\u001b[39;49;0;101münïcödé beta\u001b[0m\u001b[7;26H\u001b[24;48;2;114;17;194;59mkappa iota --flag\u001b[0m\u001b[11;12H\u001b[25;39mdelta {} gamma\u001b[0m\u001b[12;30H\u001b[101;8;4:0mgamma ünïcödé [ok]\u001b[0m\u001b[?1047h\u001b[H\u001b[2J\u001b[11;6H\u001b[38:2::210:113:53;55;8;3mepsilon [ok] a/b/c\u001b[0m\u001b[11;9H\u001b[42meta café\u001b[0m\u001b[12;33H\u001b[38;5;112;38;2;161;150;50m{} ünïcödé\u001b[0m\u001b[5;20H\u001b[38;5;114;38:2::142:131:228;58:2::194:60:166;38;5;249miota a/b/c\u001b[0m\u001b[4;5H\u001b[4:4mx zeta λόγος\u001b[0m\u001b[6;15H\u001b[58;5;234;43;106miota [ok]\u001b[0m\u001b[10;33H\u001b[39;3m[ok] [ok]\u001b[0m\u001b[9;37H\u001b[29;38;2;233;248;253;31m100% alpha\u001b[0m\u001b[1;40H\u001b[7;55;48:2::7:176:83;48;2;160;128;11mgamma ünïcödé\u001b[0m\u001b[5;14H\u001b[38;2;49;80;190;0;21mbeta λόγος\u001b[0m\u001b[?1047lback [ok]\r\n",
            "oracle-vt-fed"
          ],
          "cols": 40,
          "rows": 12
        },
        "idempotencyKey": "alt-004.feed"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a 40x12 terminal prints the 1371-byte stream, then the title oracle-vt-fed"
    },
    {
      "id": "fed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:05a9663712f01d2292be03a745ca771acc0360ad22e855882eee9a798b66a0a9",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the title comes after the stream, so the parser has taken every byte of it"
    },
    {
      "id": "state",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "screen",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.screen.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "hash",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "d() { if command -v sha256sum >/dev/null 2>&1; then printf '%s' \"$1\" | sha256sum; else printf '%s' \"$1\" | shasum -a 256; fi; }; printf '\\033]2;vt:%.64s screen:%.64s\\007' \"$(d \"$1\")\" \"$(d \"$2\")\"",
            "sh",
            "$step:state#/state_base64",
            "$step:screen#/text"
          ],
          "cwd": "/",
          "on_exit": "keep"
        },
        "idempotencyKey": "alt-004.hash"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a second terminal titles itself vt:<sha256 of the VT state> screen:<sha256 of the screen text>; it starts in / because a new terminal otherwise inherits the folder the stream's OSC 7 reported, which does not exist"
    },
    {
      "id": "hashed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/1/lifecycle",
        "equals": "exited",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the settled checkpoint holds the hash terminal's title: the arms and the baseline compare it"
    }
  ],
  "invariants": [
    "generated by schemas/terminal-corpus/generate.py (p15-oracle-101); features: alt-screen-1049, alt-screen-1047, alt-screen-47, save-cursor",
    "the VT state and screen of the stream terminal hash to the same title on both terminal-holder arms"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
