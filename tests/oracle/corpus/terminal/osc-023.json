{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "osc-023",
  "suite": "terminal",
  "title": "VT osc stream 23 at 100x30",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "terminal.osc-023",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "empty",
          "name": "oracle"
        },
        "idempotencyKey": "osc-023.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "feed",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "printf '%s' \"$1\"; printf '\\033]2;%s\\007' \"$2\"; exec cat",
            "sh",
            "\u001b[97G\u001b]8;;http://[::1]:9/tmp/item-0?q=954\u001b\\\u001b[91;105m100%\u001b[0m\u001b]8;;\u001b\\ epsilon theta\r\n\u001b]8;id=l1;http://localhost/tmp/item-1?q=13\u0007\u001b[38;2;60;187;35mepsilon\u001b[0m\u001b]8;;\u0007 x {}\r\n\u001b]8;;http://localhost/tmp/item-2?q=423\u0007\u001b[38;2;33;71;187;25;9;38;2;170;71;231mepsilon\u001b[0m\u001b]8;;\u0007 ünïcödé\r\n\u001b]8;id=l0;http://localhost/tmp/item-3?q=399\u001b\\\u001b[103;24;48;2;176;233;50mzeta ünïcödé\u001b[0m\u001b]8;;\u001b\\ \r\n\u001b]8;;file:///tmp/item-4\u0007\u001b[9;37m--flag\u001b[0m\u001b]8;;\u0007 beta a/b/c\r\n\u001b]8;;http://[::1]:9/tmp/item-5?q=356\u0007\u001b[29;32;103mkappa\u001b[0m\u001b]8;;\u0007 \r\n\u001b]8;;http://[::1]:9/tmp/item-6?q=518\u001b\\\u001b[8mgamma x {}\u001b[0m\u001b]8;;\u001b\\ alpha\r\n\u001b[97G\u001b]8;;file:///tmp/item-7\u0007\u001b[4:4;7;53miota delta {}\u001b[0m\u001b]8;;\u0007 \r\n\u001b]8;id=l2;http://127.0.0.1:8123/tmp/item-8?q=512\u001b\\\u001b[21;58:2::218:100:183mcafé --flag\u001b[0m\u001b]8;;\u001b\\ kappa\r\n\u001b]8;id=l0;http://[::1]:9/tmp/item-9?q=491\u0007\u001b[48;5;12;4:3mx a/b/c\u001b[0m 100%\r\n\u001b]8;id=l1;http://[::1]:9/tmp/item-10?q=793\u0007\u001b[4:5mcafé epsilon café\u001b[0m\u001b]8;;\u0007 x delta\r\n",
            "oracle-vt-fed"
          ],
          "cols": 100,
          "rows": 30
        },
        "idempotencyKey": "osc-023.feed"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a 100x30 terminal prints the 905-byte stream, then the title oracle-vt-fed"
    },
    {
      "id": "fed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:05a9663712f01d2292be03a745ca771acc0360ad22e855882eee9a798b66a0a9",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the title comes after the stream, so the parser has taken every byte of it"
    },
    {
      "id": "state",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "screen",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.screen.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "hash",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "d() { if command -v sha256sum >/dev/null 2>&1; then printf '%s' \"$1\" | sha256sum; else printf '%s' \"$1\" | shasum -a 256; fi; }; printf '\\033]2;vt:%.64s screen:%.64s\\007' \"$(d \"$1\")\" \"$(d \"$2\")\"",
            "sh",
            "$step:state#/state_base64",
            "$step:screen#/text"
          ],
          "cwd": "/",
          "on_exit": "keep"
        },
        "idempotencyKey": "osc-023.hash"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a second terminal titles itself vt:<sha256 of the VT state> screen:<sha256 of the screen text>; it starts in / because a new terminal otherwise inherits the folder the stream's OSC 7 reported, which does not exist"
    },
    {
      "id": "hashed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/1/lifecycle",
        "equals": "exited",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the settled checkpoint holds the hash terminal's title: the arms and the baseline compare it"
    }
  ],
  "invariants": [
    "generated by schemas/terminal-corpus/generate.py (p15-oracle-101); features: osc8, osc7, osc133, title, osc4, osc10-12",
    "the VT state and screen of the stream terminal hash to the same title on both terminal-holder arms"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
