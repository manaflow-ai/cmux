{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "alt-005",
  "suite": "terminal",
  "title": "VT alt stream 5 at 40x12",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "terminal.alt-005",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "empty",
          "name": "oracle"
        },
        "idempotencyKey": "alt-005.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "feed",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "printf '%s' \"$1\"; printf '\\033]2;%s\\007' \"$2\"; exec cat",
            "sh",
            "primary 0 theta\r\nprimary 1 kappa\r\nprimary 2 naïve zeta x\r\nprimary 3 zeta eta epsilon\r\nprimary 4 {} café --flag café kappa\r\nprimary 5 {} delta delta\r\nprimary 6 café alpha gamma\r\n\u001b[?1048h\u001b[?1047h\u001b[H\u001b[2J\u001b[4;10H\u001b[46;59;29m100% --flag λόγος\u001b[0m\u001b[7;40H\u001b[38:2::91:70:74;3;48;2;177;191;73m[ok] ünïcödé\u001b[0m\u001b[3;38H\u001b[23;2;4:2mgamma iota\u001b[0m\u001b[10;25H\u001b[4:3meta\u001b[0m\u001b[12;14H\u001b[53münïcödé\u001b[0m\u001b[11;30H\u001b[24;24;38;2;249;65;141mzeta café\u001b[0m\u001b[2;22H\u001b[92;28;7m{} delta café\u001b[0m\u001b[5;39H\u001b[49;94;8mx alpha\u001b[0m\u001b[5;16H\u001b[58;5;168;58:2::48:49:102;41;4:0m--flag\u001b[0m\u001b[?1049h\u001b[H\u001b[2J\u001b[2;15H\u001b[58;5;106;4:5mepsilon [ok]\u001b[0m\u001b[10;29H\u001b[48;5;137malpha\u001b[0m\u001b[10;31H\u001b[58:2::66:88:28m{}\u001b[0m\u001b[4;1H\u001b[38;5;224;23;105mtheta epsilon\u001b[0m\u001b[8;21H\u001b[4:4;48;2;41;20;170mkappa zeta {}\u001b[0m\u001b[7;8H\u001b[5;23;59;42mepsilon 100% a/b/c\u001b[0m\u001b[3;7H\u001b[42;103mcafé x\u001b[0m\u001b[9;25H\u001b[4:3;48;2;90;28;11;7mdelta gamma\u001b[0m\u001b[8;35H\u001b[0;38;2;21;48;58;2mx\u001b[0m",
            "oracle-vt-fed"
          ],
          "cols": 40,
          "rows": 12
        },
        "idempotencyKey": "alt-005.feed"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a 40x12 terminal prints the 892-byte stream, then the title oracle-vt-fed"
    },
    {
      "id": "fed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:05a9663712f01d2292be03a745ca771acc0360ad22e855882eee9a798b66a0a9",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the title comes after the stream, so the parser has taken every byte of it"
    },
    {
      "id": "state",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "screen",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.screen.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "hash",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "d() { if command -v sha256sum >/dev/null 2>&1; then printf '%s' \"$1\" | sha256sum; else printf '%s' \"$1\" | shasum -a 256; fi; }; printf '\\033]2;vt:%.64s screen:%.64s\\007' \"$(d \"$1\")\" \"$(d \"$2\")\"",
            "sh",
            "$step:state#/state_base64",
            "$step:screen#/text"
          ],
          "cwd": "/",
          "on_exit": "keep"
        },
        "idempotencyKey": "alt-005.hash"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a second terminal titles itself vt:<sha256 of the VT state> screen:<sha256 of the screen text>; it starts in / because a new terminal otherwise inherits the folder the stream's OSC 7 reported, which does not exist"
    },
    {
      "id": "hashed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/1/lifecycle",
        "equals": "exited",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the settled checkpoint holds the hash terminal's title: the arms and the baseline compare it"
    }
  ],
  "invariants": [
    "generated by schemas/terminal-corpus/generate.py (p15-oracle-101); features: alt-screen-1049, alt-screen-1047, alt-screen-47, save-cursor",
    "the VT state and screen of the stream terminal hash to the same title on both terminal-holder arms"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
