{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "osc-008",
  "suite": "terminal",
  "title": "VT osc stream 8 at 132x50",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "terminal.osc-008",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "empty",
          "name": "oracle"
        },
        "idempotencyKey": "osc-008.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "feed",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "printf '%s' \"$1\"; printf '\\033]2;%s\\007' \"$2\"; exec cat",
            "sh",
            "\u001b]8;id=l0;http://localhost/tmp/item-0?q=468\u001b\\\u001b[8mλόγος\u001b[0m \r\n\u001b]8;;http://127.0.0.1:8123/tmp/item-1?q=219\u0007\u001b[30;39mgamma\u001b[0m \r\n\u001b]8;id=l2;file:///tmp/item-2\u001b\\\u001b[25;58:2::214:219:174;2m100% 100% iota\u001b[0m {}\r\n\u001b]8;;http://localhost/tmp/item-3?q=177\u0007\u001b[5;1;4;5m{} 100% 100%\u001b[0m\u001b]8;;\u0007 x delta\r\n\u001b]8;;http://localhost/tmp/item-4?q=207\u0007\u001b[53;59mx\u001b[0m\u001b]8;;\u0007 x alpha\r\n\u001b]8;id=l2;http://[::1]:9/tmp/item-5?q=18\u001b\\\u001b[48;2;27;190;196;41ma/b/c\u001b[0m\u001b]8;;\u001b\\ \r\n\u001b]8;;http://127.0.0.1:8123/tmp/item-6?q=359\u0007\u001b[23;4:5mx λόγος\u001b[0m\u001b]8;;\u0007 iota\r\n\u001b]8;;http://localhost/tmp/item-7?q=177\u001b\\\u001b[4:1;44;48;5;161;55mdelta\u001b[0m\u001b]8;;\u001b\\ [ok]\r\n\u001b[129G\u001b]8;;http://[::1]:9/tmp/item-8?q=362\u0007\u001b[48;2;36;115;48;49;9mtheta ünïcödé\u001b[0m\u001b]8;;\u0007 λόγος\r\n\u001b]8;;file:///tmp/item-9\u0007\u001b[53mkappa alpha ünïcödé\u001b[0m delta alpha\r\n\u001b[129G\u001b]8;;http://127.0.0.1:8123/tmp/item-10?q=671\u0007\u001b[42;97malpha\u001b[0m\u001b]8;;\u0007 \r\n\u001b]8;;file:///tmp/item-11\u001b\\\u001b[9malpha delta a/b/c\u001b[0m\u001b]8;;\u001b\\ zeta theta\r\n\u001b]8;id=l0;http://127.0.0.1:8123/tmp/item-12?q=42\u001b\\\u001b[7;48:2::71:68:142;3;55m[ok]\u001b[0m\u001b]8;;\u001b\\ \r\n\u001b[129G\u001b]8;id=l1;http://[::1]:9/tmp/item-13?q=687\u0007\u001b[9münïcödé kappa\u001b[0m\u001b]8;;\u0007 iota\r\n\u001b]8;id=l2;file:///tmp/item-14\u001b\\\u001b[58;5;159;4;35;3münïcödé\u001b[0m\u001b]8;;\u001b\\ \r\n\u001b]8;;file:///tmp/item-15\u001b\\\u001b[9;38:2::228:139:9;4:1;38;5;125m--flag --flag\u001b[0m\u001b]8;;\u001b\\ gamma epsilon\r\n\u001b]8;;http://[::1]:9/tmp/item-16?q=1\u001b\\\u001b[39;48;2;214;149;250mcafé epsilon zeta\u001b[0m\u001b]8;;\u001b\\ a/b/c --flag\r\n\u001b]8;;http://[::1]:9/tmp/item-17?q=667\u0007\u001b[92miota iota\u001b[0m\u001b]8;;\u0007 \r\n\u001b]8;;http://[::1]:9/tmp/item-18?q=851\u001b\\\u001b[27;3m--flag naïve\u001b[0m\u001b]8;;\u001b\\ theta\r\n\u001b[129G\u001b]8;id=l1;http://localhost/tmp/item-19?q=990\u0007\u001b[48;2;104;221;151;38;2;73;157;111mnaïve\u001b[0m\u001b]8;;\u0007 x\r\n\u001b[129G\u001b]8;;http://127.0.0.1:8123/tmp/item-20?q=237\u001b\\\u001b[24;44mzeta beta kappa\u001b[0m\u001b]8;;\u001b\\ epsilon 100%\r\n\u001b[129G\u001b]8;;http://127.0.0.1:8123/tmp/item-21?q=449\u0007\u001b[59;59;47münïcödé zeta alpha\u001b[0m\u001b]8;;\u0007 ünïcödé --flag\r\n\u001b[129G\u001b]8;id=l1;http://localhost/tmp/item-22?q=539\u0007\u001b[4;100miota\u001b[0m ünïcödé\r\n\u001b]8;;http://localhost/tmp/item-23?q=750\u001b\\\u001b[9;4:3;90mnaïve beta zeta\u001b[0m\u001b]8;;\u001b\\ --flag ünïcödé\r\n",
            "oracle-vt-fed"
          ],
          "cols": 132,
          "rows": 50
        },
        "idempotencyKey": "osc-008.feed"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a 132x50 terminal prints the 2030-byte stream, then the title oracle-vt-fed"
    },
    {
      "id": "fed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:05a9663712f01d2292be03a745ca771acc0360ad22e855882eee9a798b66a0a9",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the title comes after the stream, so the parser has taken every byte of it"
    },
    {
      "id": "state",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "screen",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.screen.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "hash",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "d() { if command -v sha256sum >/dev/null 2>&1; then printf '%s' \"$1\" | sha256sum; else printf '%s' \"$1\" | shasum -a 256; fi; }; printf '\\033]2;vt:%.64s screen:%.64s\\007' \"$(d \"$1\")\" \"$(d \"$2\")\"",
            "sh",
            "$step:state#/state_base64",
            "$step:screen#/text"
          ],
          "cwd": "/",
          "on_exit": "keep"
        },
        "idempotencyKey": "osc-008.hash"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a second terminal titles itself vt:<sha256 of the VT state> screen:<sha256 of the screen text>; it starts in / because a new terminal otherwise inherits the folder the stream's OSC 7 reported, which does not exist"
    },
    {
      "id": "hashed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/1/lifecycle",
        "equals": "exited",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the settled checkpoint holds the hash terminal's title: the arms and the baseline compare it"
    }
  ],
  "invariants": [
    "generated by schemas/terminal-corpus/generate.py (p15-oracle-101); features: osc8, osc7, osc133, title, osc4, osc10-12",
    "the VT state and screen of the stream terminal hash to the same title on both terminal-holder arms"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
