{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "sgr-021",
  "suite": "terminal",
  "title": "VT sgr stream 21 at 80x24",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "terminal.sgr-021",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "empty",
          "name": "oracle"
        },
        "idempotencyKey": "sgr-021.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "feed",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "printf '%s' \"$1\"; printf '\\033]2;%s\\007' \"$2\"; exec cat",
            "sh",
            "\u001b[22;5mx delta zeta \u001b[43;27;92;103malpha 100% [ok] \u001b[1;5;48;2;163;194;128mλόγος café iota \u001b[25;38;2;71;208;245;4:1;29m{} zeta \u001b[38:2::246:228:3;38;2;154;62;249;33mgamma alpha eta \u001b[27;38;5;24;4:4mzeta \u001b[38;2;241;13;220;9;45m\u001b[K\r\n\u001b[48;2;56;54;52;23mλόγος λόγος epsilon zeta \u001b[94;25;5;29mtheta a/b/c alpha \u001b[0m\r\n\u001b[3mtheta ünïcödé [ok] \u001b[48:2::192:211:247;102;53meta alpha epsilon café \u001b[90meta zeta \u001b[38:2::162:179:93;27;48;5;174;42mbeta alpha {} theta \u001b[23mx eta \u001b[22;8;21;21mcafé \r\n\u001b[4;4;4:2mnaïve \u001b[4:0;38:2::46:116:240m100% iota \r\n\u001b[49;101;38;5;198;25mepsilon \u001b[48;2;72;29;77;49;2;48:2::13:215:130mgamma a/b/c \u001b[59;59mbeta --flag \u001b[1D\u001b[6X\r\n\u001b[42;22;22m{} \u001b[4;58:2::61:153:22ma/b/c 100% \u001b[33;0;0;55meta eta alpha \u001b[0m\r\n\u001b[4meta alpha \u001b[2D\u001b[1X\r\n\u001b[48;5;252meta 100% kappa alpha \u001b[22mλόγος alpha kappa zeta \u001b[58;5;27;4m[ok] delta theta x \u001b[90;27;48;2;124;251;109mtheta \u001b[38;2;9;8;38;22;38;5;113;24mnaïve \u001b[39;4:0;21;106malpha naïve eta \r\n\u001b[58;5;238;33;1;48;5;1mλόγος \u001b[24m[ok] theta ünïcödé \u001b[9mgamma [ok] \u001b[0m\r\n\u001b[59;58:2::196:118:159;48;2;83;12;213;29mtheta λόγος x naïve \u001b[4:0;48:2::197:65:248mkappa [ok] \u001b[48;5;66;48;2;252;177;31m[ok] [ok] [ok] naïve \u001b[0;1;7m--flag λόγος naïve iota \u001b[39m\u001b[K\r\n\u001b[59;49mepsilon x \r\n\u001b[59mx ünïcödé [ok] \u001b[2;4:2;1;27m\u001b[K\r\n\u001b[8;38;2;71;87;50;29;24m{} a/b/c delta \u001b[39miota \u001b[7;37mλόγος eta \u001b[2;9mdelta alpha naïve \r\n\u001b[4;7;31;4:2ma/b/c 100% {} \u001b[0;25;53;58:2::170:252:188münïcödé \u001b[38;5;60;58;5;145;36;0mepsilon epsilon \u001b[48;2;40;222;129;38;2;170;1;95;38;5;222;27m100% 100% beta \u001b[0m\r\n\u001b[58;5;80mcafé kappa {} \u001b[48;5;234;92;4m{} theta gamma \u001b[1;48;2;103;225;184;29;4ma/b/c \u001b[55m[ok] café iota alpha \u001b[0m\r\n\u001b[0m",
            "oracle-vt-fed"
          ],
          "cols": 80,
          "rows": 24
        },
        "idempotencyKey": "sgr-021.feed"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a 80x24 terminal prints the 1701-byte stream, then the title oracle-vt-fed"
    },
    {
      "id": "fed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:05a9663712f01d2292be03a745ca771acc0360ad22e855882eee9a798b66a0a9",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the title comes after the stream, so the parser has taken every byte of it"
    },
    {
      "id": "state",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "screen",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.screen.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "hash",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "d() { if command -v sha256sum >/dev/null 2>&1; then printf '%s' \"$1\" | sha256sum; else printf '%s' \"$1\" | shasum -a 256; fi; }; printf '\\033]2;vt:%.64s screen:%.64s\\007' \"$(d \"$1\")\" \"$(d \"$2\")\"",
            "sh",
            "$step:state#/state_base64",
            "$step:screen#/text"
          ],
          "cwd": "/",
          "on_exit": "keep"
        },
        "idempotencyKey": "sgr-021.hash"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a second terminal titles itself vt:<sha256 of the VT state> screen:<sha256 of the screen text>; it starts in / because a new terminal otherwise inherits the folder the stream's OSC 7 reported, which does not exist"
    },
    {
      "id": "hashed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/1/lifecycle",
        "equals": "exited",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the settled checkpoint holds the hash terminal's title: the arms and the baseline compare it"
    }
  ],
  "invariants": [
    "generated by schemas/terminal-corpus/generate.py (p15-oracle-101); features: sgr, palette, truecolor, underline-styles, underline-color, bce, ech",
    "the VT state and screen of the stream terminal hash to the same title on both terminal-holder arms"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
