{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "sgr-039",
  "suite": "terminal",
  "title": "VT sgr stream 39 at 20x6",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "terminal.sgr-039",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "empty",
          "name": "oracle"
        },
        "idempotencyKey": "sgr-039.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "feed",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "printf '%s' \"$1\"; printf '\\033]2;%s\\007' \"$2\"; exec cat",
            "sh",
            "\u001b[48;5;87;58;5;199mepsilon {} gamma alpha \u001b[94;27;8;35malpha x \u001b[48:2::55:166:214mbeta theta theta gamma \u001b[55;4;106;48;2;240;166;249mdelta a/b/c \u001b[59m{} \u001b[44;3mnaïve \u001b[0m\r\n\u001b[28;2;44mnaïve epsilon epsilon \u001b[53meta \u001b[96;27mcafé theta kappa \u001b[4:0mcafé iota alpha \u001b[1malpha delta eta epsilon \u001b[48;2;63;235;84m100% \r\n\u001b[1;9;48;2;31;158;98;38;5;190mbeta kappa beta gamma \u001b[48:2::66:228:211;44;1;35mnaïve \u001b[38;2;145;46;5mx \u001b[29;38:2::155:220:246;49;53m[ok] zeta café ünïcödé \u001b[38;2;101;196;126;49;41mepsilon eta beta {} \u001b[38;5;168;28;1;40mzeta {} \u001b[7D\u001b[5X\r\n\u001b[24;38:2::225:72:243;39;48;2;153;202;225mcafé kappa [ok] epsilon \u001b[5;92;9;24meta 100% epsilon [ok] \u001b[48:2::120:204:8;93mgamma epsilon naïve \u001b[24mbeta eta 100% x \u001b[3D\u001b[3X\r\n\u001b[2;25;39mzeta delta alpha {} \u001b[48:2::113:182:83;35;4:3miota 100% \u001b[39;24;49;38:2::136:93:182mλόγος \r\n\u001b[4:0malpha --flag 100% \u001b[25;5;47;38;5;131m100% --flag \u001b[53;55mtheta kappa \u001b[53;38:2::135:160:107;23;2m\u001b[K\r\n\u001b[2malpha \u001b[0;49;22m\u001b[K\r\n\u001b[59;28;4:4;9mcafé ünïcödé \u001b[4;48:2::79:12:60;93;38:2::62:111:143münïcödé iota eta \u001b[49mx zeta \u001b[21;97;107mdelta \u001b[24m\u001b[K\r\n\u001b[53;48;2;1;131;92mbeta [ok] \u001b[23;4:0;3mbeta eta ünïcödé eta \r\n\u001b[0m",
            "oracle-vt-fed"
          ],
          "cols": 20,
          "rows": 6
        },
        "idempotencyKey": "sgr-039.feed"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a 20x6 terminal prints the 1176-byte stream, then the title oracle-vt-fed"
    },
    {
      "id": "fed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:05a9663712f01d2292be03a745ca771acc0360ad22e855882eee9a798b66a0a9",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the title comes after the stream, so the parser has taken every byte of it"
    },
    {
      "id": "state",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "screen",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.screen.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "hash",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "d() { if command -v sha256sum >/dev/null 2>&1; then printf '%s' \"$1\" | sha256sum; else printf '%s' \"$1\" | shasum -a 256; fi; }; printf '\\033]2;vt:%.64s screen:%.64s\\007' \"$(d \"$1\")\" \"$(d \"$2\")\"",
            "sh",
            "$step:state#/state_base64",
            "$step:screen#/text"
          ],
          "cwd": "/",
          "on_exit": "keep"
        },
        "idempotencyKey": "sgr-039.hash"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a second terminal titles itself vt:<sha256 of the VT state> screen:<sha256 of the screen text>; it starts in / because a new terminal otherwise inherits the folder the stream's OSC 7 reported, which does not exist"
    },
    {
      "id": "hashed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/1/lifecycle",
        "equals": "exited",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the settled checkpoint holds the hash terminal's title: the arms and the baseline compare it"
    }
  ],
  "invariants": [
    "generated by schemas/terminal-corpus/generate.py (p15-oracle-101); features: sgr, palette, truecolor, underline-styles, underline-color, bce, ech",
    "the VT state and screen of the stream terminal hash to the same title on both terminal-holder arms"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
