{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "wide-011",
  "suite": "terminal",
  "title": "VT wide stream 11 at 132x50",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "terminal.wide-011",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "empty",
          "name": "oracle"
        },
        "idempotencyKey": "wide-011.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "feed",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "printf '%s' \"$1\"; printf '\\033]2;%s\\007' \"$2\"; exec cat",
            "sh",
            "\u001b[?2027hかなかな\u001b[4Dx\r\n❤️ 😀 🚀 かな é 漢字 क्ष 👨‍👩‍👧\r\n🇯🇵\tक्ष\r\n😀全角\u001b[4Dy\r\n👍🏽カナक्ष🚀⚠︎\u001b[4G\u001b[2P\r\n❤️\tạ̈\t👨‍👩‍👧\r\n한국어 क्ष 👍🏽 👍🏽 全角 中文字符\r\n\u001b[130Gक्षＡＢＣ\r\n👍🏽全角\u001b[2Dz\r\n\u001b[131G🇯🇵😀\r\n한국어\t❤️\r\n👍🏽ạ̈🚀😀かな\u001b[1G\u001b[3@\r\n漢字\tかな\t❤️\tかな\r\n👍🏽\tạ̈\t❤️\tかな\t👨‍👩‍👧\r\né 😀 한국어\r\n全角ạ̈👨‍👩‍👧😀ạ̈\u001b[4G\u001b[3P\r\n\u001b[37mbeta beta {} 👍🏽\u001b[0m\r\n\u001b[36mbeta --flag --flag 👨‍👩‍👧\u001b[0m\r\n⚠︎ 中文字符 ＡＢＣ\r\n🚀é\u001b[4Dy\r\nかな\tＡＢＣ\r\n全角🇯🇵é🇯🇵かな\u001b[4G\u001b[3X\r\n\u001b[130GＡＢＣ❤️\r\n\u001b[34mdelta 한국어\u001b[0m\r\nかな\tक्ष\tक्ष\r\nＡＢＣ👨‍👩‍👧👍🏽क्ष⚠︎\u001b[5G\u001b[3P\r\n\u001b[37mkappa theta ＡＢＣ\u001b[0m\r\n\u001b[36mzeta カナ\u001b[0m\r\n😀\té\t한국어\tかな\r\n中文字符\t⚠︎\r\n\u001b[132G🚀👨‍👩‍👧\r\n\u001b[130G❤️👨‍👩‍👧\r\n\u001b[36münïcödé café café é\u001b[0m\r\n",
            "oracle-vt-fed"
          ],
          "cols": 132,
          "rows": 50
        },
        "idempotencyKey": "wide-011.feed"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a 132x50 terminal prints the 1055-byte stream, then the title oracle-vt-fed"
    },
    {
      "id": "fed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:05a9663712f01d2292be03a745ca771acc0360ad22e855882eee9a798b66a0a9",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the title comes after the stream, so the parser has taken every byte of it"
    },
    {
      "id": "state",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "screen",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.screen.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "hash",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "d() { if command -v sha256sum >/dev/null 2>&1; then printf '%s' \"$1\" | sha256sum; else printf '%s' \"$1\" | shasum -a 256; fi; }; printf '\\033]2;vt:%.64s screen:%.64s\\007' \"$(d \"$1\")\" \"$(d \"$2\")\"",
            "sh",
            "$step:state#/state_base64",
            "$step:screen#/text"
          ],
          "cwd": "/",
          "on_exit": "keep"
        },
        "idempotencyKey": "wide-011.hash"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a second terminal titles itself vt:<sha256 of the VT state> screen:<sha256 of the screen text>; it starts in / because a new terminal otherwise inherits the folder the stream's OSC 7 reported, which does not exist"
    },
    {
      "id": "hashed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/1/lifecycle",
        "equals": "exited",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the settled checkpoint holds the hash terminal's title: the arms and the baseline compare it"
    }
  ],
  "invariants": [
    "generated by schemas/terminal-corpus/generate.py (p15-oracle-101); features: wide, graphemes, variation-selectors, mode-2027, ich-dch, no-autowrap",
    "the VT state and screen of the stream terminal hash to the same title on both terminal-holder arms"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
