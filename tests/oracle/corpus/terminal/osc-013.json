{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "osc-013",
  "suite": "terminal",
  "title": "VT osc stream 13 at 120x40",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "terminal.osc-013",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "empty",
          "name": "oracle"
        },
        "idempotencyKey": "osc-013.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "feed",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "printf '%s' \"$1\"; printf '\\033]2;%s\\007' \"$2\"; exec cat",
            "sh",
            "\u001b]11;#4216fa\u001b\\fg/bg\r\n\u001b]4;222;rgb:3d/ac/25\u0007\u001b[38;5;62mpal\u001b[0m\r\n\u001b]12;#bfc11b\u001b\\fg/bg\r\n\u001b]110\u001b\\reset\r\n\u001b]2;title 4 a/b/c\u0007\u001b]2;title 5 epsilon delta\u001b\\\u001b]2;title 6 a/b/c λόγος\u001b\\\u001b]2;title 7 [ok]\u0007\u001b]111\u0007reset\r\n\u001b]110\u0007reset\r\n\u001b]10;#35b20e\u0007fg/bg\r\n\u001b]2;title 11 iota\u001b\\\u001b]12;#c3523a\u0007fg/bg\r\n\u001b]110\u001b\\reset\r\n\u001b]4;244;rgb:42/5e/f8\u001b\\\u001b[38;5;119mpal\u001b[0m\r\n\u001b]0;title 15 100%\u001b\\\u001b]110\u001b\\reset\r\n\u001b]110\u0007reset\r\n\u001b]0;title 18 λόγος kappa\u0007\u001b]104\u0007reset\r\n\u001b]110\u0007reset\r\n\u001b]104\u0007reset\r\n\u001b]10;#327789\u001b\\fg/bg\r\n\u001b]4;180;rgb:a5/56/9a\u0007\u001b[38;5;64mpal\u001b[0m\r\n\u001b]10;#1a5f5f\u001b\\fg/bg\r\n\u001b]2;title 25 alpha\u0007\u001b]112\u001b\\reset\r\n\u001b]11;#0b01ab\u0007fg/bg\r\n\u001b]4;191;rgb:41/c0/b5\u001b\\\u001b[38;5;53mpal\u001b[0m\r\n\u001b]4;109;rgb:5c/3b/f0\u001b\\\u001b[38;5;191mpal\u001b[0m\r\n\u001b]11;#70306a\u001b\\fg/bg\r\n\u001b]4;43;rgb:16/4a/4c\u001b\\\u001b[38;5;77mpal\u001b[0m\r\n",
            "oracle-vt-fed"
          ],
          "cols": 120,
          "rows": 40
        },
        "idempotencyKey": "osc-013.feed"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a 120x40 terminal prints the 723-byte stream, then the title oracle-vt-fed"
    },
    {
      "id": "fed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:05a9663712f01d2292be03a745ca771acc0360ad22e855882eee9a798b66a0a9",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the title comes after the stream, so the parser has taken every byte of it"
    },
    {
      "id": "state",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "screen",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.screen.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "hash",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "d() { if command -v sha256sum >/dev/null 2>&1; then printf '%s' \"$1\" | sha256sum; else printf '%s' \"$1\" | shasum -a 256; fi; }; printf '\\033]2;vt:%.64s screen:%.64s\\007' \"$(d \"$1\")\" \"$(d \"$2\")\"",
            "sh",
            "$step:state#/state_base64",
            "$step:screen#/text"
          ],
          "cwd": "/",
          "on_exit": "keep"
        },
        "idempotencyKey": "osc-013.hash"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a second terminal titles itself vt:<sha256 of the VT state> screen:<sha256 of the screen text>; it starts in / because a new terminal otherwise inherits the folder the stream's OSC 7 reported, which does not exist"
    },
    {
      "id": "hashed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/1/lifecycle",
        "equals": "exited",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the settled checkpoint holds the hash terminal's title: the arms and the baseline compare it"
    }
  ],
  "invariants": [
    "generated by schemas/terminal-corpus/generate.py (p15-oracle-101); features: osc8, osc7, osc133, title, osc4, osc10-12",
    "the VT state and screen of the stream terminal hash to the same title on both terminal-holder arms"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
