{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "sgr-015",
  "suite": "terminal",
  "title": "VT sgr stream 15 at 20x6",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "terminal.sgr-015",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "empty",
          "name": "oracle"
        },
        "idempotencyKey": "sgr-015.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "feed",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "printf '%s' \"$1\"; printf '\\033]2;%s\\007' \"$2\"; exec cat",
            "sh",
            "\u001b[58:2::245:28:219;3mλόγος --flag λόγος \u001b[38;5;240;49;3mnaïve naïve ünïcödé \u001b[0m\r\n\u001b[24mepsilon alpha \r\n\u001b[45m{} zeta beta café \u001b[4;38;2;247;255;118;48;2;180;191;85;102malpha a/b/c café [ok] \u001b[34mbeta theta \u001b[29;58:2::14:175:150;94;24m--flag a/b/c \u001b[24;38;2;171;110;56;22mgamma ünïcödé --flag \u001b[4:5;93miota {} \r\n\u001b[48;5;164;40;46;53mkappa [ok] café ünïcödé \u001b[38;2;237;101;168;107;38;5;56;7mdelta \u001b[4:1m[ok] 100% zeta \u001b[27;34;28mgamma kappa \r\n\u001b[9;58:2::18:136:3;4:0m{} kappa kappa x \u001b[9;37mbeta x {} \u001b[24;37;38;2;89;85;183mdelta naïve delta \u001b[32;58:2::156:18:228;29;0m\u001b[K\r\n\u001b[1;22m[ok] --flag \u001b[55;4:0;97mnaïve [ok] a/b/c \u001b[36;24;49meta zeta \u001b[95mkappa ünïcödé \u001b[44mtheta epsilon \u001b[27;90;48;2;167;227;143;46mλόγος beta \r\n\u001b[46;38;2;56;192;171;4:1;100mx delta 100% \u001b[43;39;38:2::228:156:57;59ma/b/c eta \u001b[49;21;38;5;56mtheta theta \u001b[28;23malpha zeta {} \u001b[25;4:0;28mdelta \r\n\u001b[49;24;4:3;39m{} zeta alpha \u001b[53mepsilon zeta alpha \u001b[38;2;245;145;59m\u001b[K\r\n\u001b[0m",
            "oracle-vt-fed"
          ],
          "cols": 20,
          "rows": 6
        },
        "idempotencyKey": "sgr-015.feed"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a 20x6 terminal prints the 984-byte stream, then the title oracle-vt-fed"
    },
    {
      "id": "fed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/title",
        "equals": "sha256:05a9663712f01d2292be03a745ca771acc0360ad22e855882eee9a798b66a0a9",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the title comes after the stream, so the parser has taken every byte of it"
    },
    {
      "id": "state",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.state.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "screen",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:feed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.screen.read"
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "hash",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "d() { if command -v sha256sum >/dev/null 2>&1; then printf '%s' \"$1\" | sha256sum; else printf '%s' \"$1\" | shasum -a 256; fi; }; printf '\\033]2;vt:%.64s screen:%.64s\\007' \"$(d \"$1\")\" \"$(d \"$2\")\"",
            "sh",
            "$step:state#/state_base64",
            "$step:screen#/text"
          ],
          "cwd": "/",
          "on_exit": "keep"
        },
        "idempotencyKey": "sgr-015.hash"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a second terminal titles itself vt:<sha256 of the VT state> screen:<sha256 of the screen text>; it starts in / because a new terminal otherwise inherits the folder the stream's OSC 7 reported, which does not exist"
    },
    {
      "id": "hashed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/terminals/1/lifecycle",
        "equals": "exited",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the settled checkpoint holds the hash terminal's title: the arms and the baseline compare it"
    }
  ],
  "invariants": [
    "generated by schemas/terminal-corpus/generate.py (p15-oracle-101); features: sgr, palette, truecolor, underline-styles, underline-color, bce, ech",
    "the VT state and screen of the stream terminal hash to the same title on both terminal-holder arms"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
