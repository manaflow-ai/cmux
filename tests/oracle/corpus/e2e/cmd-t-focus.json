{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "cmd-t-focus",
  "suite": "e2e",
  "title": "Cmd-T opens a New Tab page as a tab of the current workspace from every focus",
  "priority": "P0",
  "surface": "cmux-next-native",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {
    "viewport": {
      "width": 1440,
      "height": 900
    }
  },
  "fixture": {
    "seed": "e2e-cmd-t-focus-v1",
    "network": "offline",
    "clock": "fixed",
    "agent": "mock"
  },
  "preconditions": [
    "private scratch config",
    "tagged bench build",
    "no unrelated app instance",
    "a fresh launch: one window, one workspace, one terminal tab"
  ],
  "requires": [
    "actions",
    "keys",
    "gui",
    "chromium"
  ],
  "platforms": [
    "mac"
  ],
  "steps": [
    {
      "id": "launched",
      "op": "snapshot",
      "args": {
        "facets": [
          "topology",
          "focus",
          "tabs"
        ]
      },
      "settleMaxMs": 5000
    },
    {
      "id": "cmd-t-terminal",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "cmd+t"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/tab_count",
        "predicate": "changed",
        "maxMs": 5000
      },
      "note": "Cmd-T on a terminal: one new tab in the focused workspace, no new workspace; the New Tab page (cx-xt5k)"
    },
    {
      "id": "on-new-tab-page",
      "op": "snapshot",
      "args": {
        "facets": [
          "topology",
          "focus",
          "tabs"
        ]
      },
      "settleMaxMs": 5000,
      "note": "the New Tab page has the keyboard in its field"
    },
    {
      "id": "cmd-t-field",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "cmd+t"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/tab_count",
        "predicate": "changed",
        "maxMs": 5000
      },
      "note": "Cmd-T with the keyboard in the New Tab page's field (a web view) opens another tab there (222b3c1f031)"
    },
    {
      "id": "cmd-t-field-again",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "cmd+t"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/tab_count",
        "predicate": "changed",
        "maxMs": 5000
      },
      "note": "and again from that New Tab page's field"
    },
    {
      "id": "three-pages",
      "op": "snapshot",
      "args": {
        "facets": [
          "topology",
          "focus",
          "tabs"
        ]
      },
      "settleMaxMs": 5000
    },
    {
      "id": "open-browser",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "cmd+shift+l"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/tab_count",
        "predicate": "changed",
        "maxMs": 5000
      },
      "settleMaxMs": 10000,
      "note": "a browser tab in the focused pane, selected (openBrowser)"
    },
    {
      "id": "cmd-t-browser",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "cmd+t"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/tab_count",
        "predicate": "changed",
        "maxMs": 5000
      },
      "note": "Cmd-T on a browser tab opens a New Tab page there"
    },
    {
      "id": "after-browser",
      "op": "snapshot",
      "args": {
        "facets": [
          "topology",
          "focus",
          "tabs"
        ]
      },
      "settleMaxMs": 5000
    },
    {
      "id": "new-chat",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "cmd+i"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/topology/workspaces",
        "predicate": "changed",
        "maxMs": 5000
      },
      "settleMaxMs": 10000,
      "note": "Cmd-I: a new workspace whose only tab is an agent chat (the mock agent), with no tab strip"
    },
    {
      "id": "lone-chat",
      "op": "snapshot",
      "args": {
        "facets": [
          "topology",
          "focus",
          "tabs"
        ]
      },
      "settleMaxMs": 5000
    },
    {
      "id": "cmd-t-chat",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "cmd+t"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/tab_count",
        "predicate": "changed",
        "maxMs": 5000
      },
      "note": "Cmd-T on a lone agent chat opens a New Tab page as a tab in that workspace, not a new workspace (cx-04fy)"
    },
    {
      "id": "chat-with-tab",
      "op": "snapshot",
      "args": {
        "facets": [
          "topology",
          "focus",
          "tabs"
        ]
      },
      "settleMaxMs": 5000
    }
  ],
  "invariants": [
    "converted from scripts/cmux-next/cmd-t-focus-e2e.py, which stays as the live check; tests/oracle/corpus/e2e/coverage.json maps the script to this case and its cited fix",
    "each Cmd-T adds one tab to the focused workspace's focused pane and no workspace; the new tab shows the New Tab page",
    "from a lone agent chat (cx-04fy) the chat's workspace gets the tab; no new workspace",
    "every mutation has one receipt or one typed error (I1)"
  ],
  "teardown": [
    "quit the tagged app the run started",
    "verify its debug socket is gone",
    "end the tag's daemons (TagTeardown)"
  ],
  "untested": [
    "the sweep that every bound Command or Control shortcut reaches the key router from the New Tab field (debug.key dry_run over action.list): a dry run is not a case op; the entrypoints suite runs each shortcut",
    "whether the field itself has the keyboard (debug.new_tab field): the focus facet's responder kind is the recorded value"
  ]
}
