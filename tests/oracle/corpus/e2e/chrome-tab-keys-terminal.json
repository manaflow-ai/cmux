      },
      "waitFor": {
        "pointer": "/topology/topology/focus/workspace",
        "equals": "$step:w2#/created/0",
        "maxMs": 5000
      }
    },
    {
      "id": "cmd-2",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "cmd+2"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/topology/focus/workspace",
        "equals": "$step:w1#/created/0",
        "maxMs": 5000
      },
      "checkpoint": [
        "turn",
        "settled"
      ],
      "note": "selects the second workspace (selectWorkspaceByNumber 2 with numbering workspacesOnly): w1"
    },
    {
      "id": "cmd-9-show-start",
      "op": "action.run",
      "target": {
        "window": "current"
      },
      "args": {
        "action": "goToWorkspace",
        "params": {
