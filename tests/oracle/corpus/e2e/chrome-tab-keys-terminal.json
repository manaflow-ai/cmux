{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "chrome-tab-keys-terminal",
  "suite": "e2e",
  "title": "Chrome's tab keys move between sidebar items with the keyboard in a terminal",
  "priority": "P0",
  "surface": "cmux-next-native",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {
    "viewport": {
      "width": 1440,
      "height": 900
    }
  },
  "fixture": {
    "seed": "e2e-chrome-tab-keys-terminal-v1",
    "network": "offline",
    "clock": "fixed",
    "agent": "mock"
  },
  "preconditions": [
    "private scratch config",
    "tagged bench build",
    "no unrelated app instance",
    "a fresh launch: one window, one workspace, one terminal tab"
  ],
  "requires": [
    "actions",
    "keys",
    "gui"
  ],
  "platforms": [
    "mac"
  ],
  "steps": [
    {
      "id": "launched",
      "op": "snapshot",
      "args": {
        "facets": [
          "topology",
          "focus",
          "sidebar",
          "settings"
        ]
      },
      "settleMaxMs": 5000
    },
    {
      "id": "numbering-workspaces",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "settings",
          "set",
          "sidebar.numbering",
          "workspacesOnly"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a settings write has no action receipt"
      },
      "waitFor": {
        "pointer": "/settings/nonDefaultKeys",
        "predicate": {
          "op": "contains",
          "value": "sidebar.numbering"
        },
        "maxMs": 10000
      },
      "note": "Cmd-1 to Cmd-9 count workspaces only: the default allItems numbers Home = 1 and the App Store = 2 first (SidebarItemOrder.items(_:), schemas/defaults/cmux-next.json setting.sidebar.numbering)"
    },
    {
      "id": "w1",
      "op": "action.run",
      "target": {
        "window": "current"
      },
      "args": {
        "action": "workspace.newAtBottom"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/topology/workspaces",
        "predicate": "changed",
        "maxMs": 5000
      },
      "note": "w1: a terminal workspace at the bottom of the sidebar, not shown"
    },
    {
      "id": "w2",
      "op": "action.run",
      "target": {
        "window": "current"
      },
      "args": {
        "action": "workspace.newAtBottom"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/topology/workspaces",
        "predicate": "changed",
        "maxMs": 5000
      },
      "note": "w2: a terminal workspace at the bottom of the sidebar, not shown"
    },
    {
      "id": "w3",
      "op": "action.run",
      "target": {
        "window": "current"
      },
      "args": {
        "action": "workspace.newAtBottom"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/topology/workspaces",
        "predicate": "changed",
        "maxMs": 5000
      },
      "note": "w3: a terminal workspace at the bottom of the sidebar, not shown"
    },
    {
      "id": "w4",
      "op": "action.run",
      "target": {
        "window": "current"
      },
      "args": {
        "action": "workspace.newAtBottom"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/topology/workspaces",
        "predicate": "changed",
        "maxMs": 5000
      },
      "note": "w4: a terminal workspace at the bottom of the sidebar, not shown"
    },
    {
      "id": "show-start",
      "op": "action.run",
      "target": {
        "window": "current"
      },
      "args": {
        "action": "goToWorkspace",
        "params": {
          "workspace": "$step:w2#/created/0"
        }
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/topology/focus/workspace",
        "equals": "$step:w2#/created/0",
        "maxMs": 5000
      },
      "note": "w2 is the start: not the first, second or last item, so every key must move the selection"
    },
    {
      "id": "start",
      "op": "snapshot",
      "args": {
        "facets": [
          "topology",
          "focus",
          "tabs"
        ]
      },
      "settleMaxMs": 5000,
      "note": "the start shows its terminal with the keyboard in it: a pane with one tab"
    },
    {
      "id": "ctrl-cmd-close-bracket-show-start",
      "op": "action.run",
      "target": {
        "window": "current"
      },
      "args": {
        "action": "goToWorkspace",
        "params": {
          "workspace": "$step:w2#/created/0"
        }
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/topology/focus/workspace",
        "equals": "$step:w2#/created/0",
        "maxMs": 5000
      }
    },
    {
      "id": "ctrl-cmd-close-bracket",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "ctrl+cmd+]"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/topology/focus/workspace",
        "equals": "$step:w3#/created/0",
        "maxMs": 5000
      },
      "checkpoint": [
        "turn",
        "settled"
      ],
      "note": "selects the sidebar item below the start (nextSidebarTab): w3"
    },
    {
      "id": "ctrl-cmd-open-bracket-show-start",
      "op": "action.run",
      "target": {
        "window": "current"
      },
      "args": {
        "action": "goToWorkspace",
        "params": {
          "workspace": "$step:w2#/created/0"
        }
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/topology/focus/workspace",
        "equals": "$step:w2#/created/0",
        "maxMs": 5000
      }
    },
    {
      "id": "ctrl-cmd-open-bracket",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "ctrl+cmd+["
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/topology/focus/workspace",
        "equals": "$step:w1#/created/0",
        "maxMs": 5000
      },
      "checkpoint": [
        "turn",
        "settled"
      ],
      "note": "selects the sidebar item above the start (prevSidebarTab): w1"
    },
    {
      "id": "ctrl-pagedown-show-start",
      "op": "action.run",
      "target": {
        "window": "current"
      },
      "args": {
        "action": "goToWorkspace",
        "params": {
          "workspace": "$step:w2#/created/0"
        }
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/topology/focus/workspace",
        "equals": "$step:w2#/created/0",
        "maxMs": 5000
      }
    },
    {
      "id": "ctrl-pagedown",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "ctrl+pagedown"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/topology/focus/workspace",
        "equals": "$step:w3#/created/0",
        "maxMs": 5000
      },
      "checkpoint": [
        "turn",
        "settled"
      ],
      "note": "selects the sidebar item below the start (nextSidebarTab): w3"
    },
    {
      "id": "ctrl-pageup-show-start",
      "op": "action.run",
      "target": {
        "window": "current"
      },
      "args": {
        "action": "goToWorkspace",
        "params": {
          "workspace": "$step:w2#/created/0"
        }
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/topology/focus/workspace",
        "equals": "$step:w2#/created/0",
        "maxMs": 5000
      }
    },
    {
      "id": "ctrl-pageup",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "ctrl+pageup"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/topology/focus/workspace",
        "equals": "$step:w1#/created/0",
        "maxMs": 5000
      },
      "checkpoint": [
        "turn",
        "settled"
      ],
      "note": "selects the sidebar item above the start (prevSidebarTab): w1"
    },
    {
      "id": "cmd-1-show-start",
      "op": "action.run",
      "target": {
        "window": "current"
      },
      "args": {
        "action": "goToWorkspace",
        "params": {
          "workspace": "$step:w2#/created/0"
        }
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/topology/focus/workspace",
        "equals": "$step:w2#/created/0",
        "maxMs": 5000
      }
    },
    {
      "id": "cmd-1",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "cmd+1"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/topology/focus/workspace",
        "predicate": "changed",
        "maxMs": 5000
      },
      "checkpoint": [
        "turn",
        "settled"
      ],
      "note": "selects the first workspace (selectWorkspaceByNumber 1 with numbering workspacesOnly): the launch's workspace"
    },
    {
      "id": "cmd-2-show-start",
      "op": "action.run",
      "target": {
        "window": "current"
      },
      "args": {
        "action": "goToWorkspace",
        "params": {
          "workspace": "$step:w2#/created/0"
        }
      },
      "expect": {
        "outcome": "ok",
