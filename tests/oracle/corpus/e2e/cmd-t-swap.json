{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "cmd-t-swap",
  "suite": "e2e",
  "title": "With tabs.swapCmdTAndCmdN on, Cmd-N is New Tab and Cmd-T New Workspace; off again, Cmd-N opens a workspace",
  "priority": "P1",
  "surface": "cmux-next-native",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {
    "viewport": {
      "width": 1440,
      "height": 900
    }
  },
  "fixture": {
    "seed": "e2e-cmd-t-swap-v1",
    "network": "offline",
    "clock": "fixed",
    "agent": "mock"
  },
  "preconditions": [
    "private scratch config",
    "tagged bench build",
    "no unrelated app instance",
    "a fresh launch: one window, one workspace, one terminal tab"
  ],
  "requires": [
    "actions",
    "keys",
    "gui"
  ],
  "platforms": [
    "mac"
  ],
  "steps": [
    {
      "id": "launched",
      "op": "snapshot",
      "args": {
        "facets": [
          "topology",
          "focus",
          "tabs",
          "settings"
        ]
      },
      "settleMaxMs": 5000
    },
    {
      "id": "swap-on",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "settings",
          "set",
          "tabs.swapCmdTAndCmdN",
          "true"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a settings write has no action receipt"
      },
      "waitFor": {
        "pointer": "/settings/nonDefaultKeys",
        "predicate": {
          "op": "contains",
          "value": "tabs.swapCmdTAndCmdN"
        },
        "maxMs": 10000
      }
    },
    {
      "id": "swapped-cmd-n",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "cmd+n"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/tab_count",
        "predicate": "changed",
        "maxMs": 5000
      },
      "note": "swapped: Cmd-N on a terminal opens a tab in the focused workspace"
    },
    {
      "id": "swapped-tab",
      "op": "snapshot",
      "args": {
        "facets": [
          "topology",
          "focus",
          "tabs"
        ]
      },
      "settleMaxMs": 5000
    },
    {
      "id": "swapped-cmd-t",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "cmd+t"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/topology/workspaces",
        "predicate": "changed",
        "maxMs": 5000
      },
      "note": "swapped: Cmd-T on the New Tab page opens a workspace in the focused workspace's group"
    },
    {
      "id": "swapped-workspace",
      "op": "snapshot",
      "args": {
        "facets": [
          "topology",
          "focus",
          "tabs"
        ]
      },
      "settleMaxMs": 5000
    },
    {
      "id": "swap-off",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "settings",
          "unset",
          "tabs.swapCmdTAndCmdN"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a settings write has no action receipt"
      },
      "waitFor": {
        "pointer": "/settings/nonDefaultKeys",
        "predicate": "changed",
        "maxMs": 10000
      }
    },
    {
      "id": "cmd-n",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "cmd+n"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/topology/workspaces",
        "predicate": "changed",
        "maxMs": 5000
      },
      "note": "swap off again: Cmd-N opens a workspace"
    },
    {
      "id": "unswapped",
      "op": "snapshot",
      "args": {
        "facets": [
          "topology",
          "focus",
          "tabs",
          "settings"
        ]
      },
      "settleMaxMs": 5000
    }
  ],
  "invariants": [
    "converted from scripts/cmux-next/cmd-t-focus-e2e.py, which stays as the live check; tests/oracle/corpus/e2e/coverage.json maps the script to this case and its cited fix",
    "swapped-tab: one more tab in the focused workspace and no new workspace",
    "swapped-workspace and unswapped: one more workspace each, in the focused workspace's group, the old workspace's tabs unchanged",
    "unswapped's settings equal launched's: the case leaves the setting at its default"
  ],
  "teardown": [
    "quit the tagged app the run started",
    "verify its debug socket is gone",
    "end the tag's daemons (TagTeardown)"
  ]
}
