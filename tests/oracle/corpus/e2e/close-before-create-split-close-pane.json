{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "close-before-create-split-close-pane",
  "suite": "e2e",
  "title": "Close before create: Cmd-D, then Close Pane at once; the split goes and the old pane stays",
  "priority": "P0",
  "surface": "cmux-next-native",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {
    "viewport": {
      "width": 1440,
      "height": 900
    }
  },
  "fixture": {
    "seed": "e2e-close-before-create-split-close-pane-v1",
    "network": "offline",
    "clock": "fixed",
    "agent": "mock"
  },
  "preconditions": [
    "private scratch config",
    "tagged bench build",
    "no unrelated app instance",
    "a fresh launch: one window, one workspace, one terminal tab"
  ],
  "requires": [
    "actions",
    "keys",
    "gui"
  ],
  "platforms": [
    "mac"
  ],
  "steps": [
    {
      "id": "before",
      "op": "snapshot",
      "args": {
        "facets": [
          "topology",
          "focus",
          "layout",
          "tabs",
          "terminals"
        ]
      },
      "settleMaxMs": 5000
    },
    {
      "id": "split-1",
      "op": "key",
      "target": {
        "window": "current"
      },
      "args": {
        "keys": [
          "cmd+d"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "checkpoint": [
        "turn"
      ],
      "note": "Cmd-D: an optimistic split, a provisional pane, focused; no settle before the close"
    },
    {
      "id": "close-pane-1",
      "op": "action.run",
      "target": {
        "window": "current"
      },
      "args": {
        "action": "closePane"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "settleMaxMs": 5000,
      "note": "Close Pane on the focused pane at once, as the script's action.run closePane"
    },
    {
      "id": "after-1",
      "op": "snapshot",
