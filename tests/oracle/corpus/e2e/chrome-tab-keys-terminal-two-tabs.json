  "id": "chrome-tab-keys-terminal-two-tabs",
  "suite": "e2e",
  "title": "Chrome's tab keys move between sidebar items from a terminal in a pane with two tabs, not between the pane's tabs",
  "priority": "P0",
  "surface": "cmux-next-native",
  "source": {
