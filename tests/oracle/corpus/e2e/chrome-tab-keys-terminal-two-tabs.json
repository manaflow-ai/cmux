      "id": "w1",
      "op": "action.run",
      "target": {
        "window": "current"
      },
      "args": {
        "action": "workspace.newAtBottom"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/topology/topology/workspaces",
        "predicate": "changed",
        "maxMs": 5000
      },
      "note": "w1: a terminal workspace at the bottom of the sidebar, not shown"
    },
    {
      "id": "w2",
      "op": "action.run",
      "target": {
        "window": "current"
      },
      "args": {
        "action": "workspace.newAtBottom"
      },
