{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "new-workspace-like-this",
  "suite": "e2e",
  "title": "New Workspace Like This opens right below its workspace (in its group), in its directory, with a first tab of the same kind; the ids it folds still run it",
  "priority": "P1",
  "surface": "cmux-next-native",
  "source": {"repo": "manaflow-ai/cmux", "ref": "$RUN", "artifact": "$RUN"},
  "environment": {"viewport": {"width": 1440, "height": 900}},
  "fixture": {"seed": "e2e-new-workspace-like-this-v1", "network": "offline", "clock": "fixed", "agent": "mock"},
  "preconditions": [
    "private scratch config",
    "tagged bench build",
    "no unrelated app instance",
    "a fresh launch: one window, one terminal workspace, no workspace group",
    "converted from scripts/cmux-next/new-workspace-like-this-e2e.py (cx-rrvi, #19000), which stays; tests/oracle/corpus/e2e/_scripts-094.json links them"
  ],
  "requires": ["actions", "keys", "gui"],
  "platforms": ["mac"],
  "steps": [
    {
      "id": "anchor",
      "op": "action.run",
      "target": {"window": "current"},
      "args": {"action": "workspace.newAtBottom"},
      "expect": {"outcome": "ok", "receipt": "action.done"},
      "waitFor": {"pointer": "/topology/topology/workspaces", "predicate": "changed", "maxMs": 20000},
      "note": "the anchor: a terminal workspace (created/0)"
    },
    {
      "id": "group-anchor",
      "op": "action.run",
      "target": {"workspace": "$step:anchor#/created/0"},
      "args": {"action": "workspace.moveToNewGroup", "params": {"name": "like this e2e"}},
      "expect": {"outcome": "ok", "receipt": "action.done"},
      "waitFor": {"pointer": "/topology/topology/workspace_groups", "predicate": {"op": "lengthEquals", "value": 1}, "maxMs": 10000}
    },
    {
      "id": "below-anchor",
      "op": "action.run",
      "target": {"workspace": "$step:anchor#/created/0"},
      "args": {"action": "workspace.newBelow"},
      "expect": {"outcome": "ok", "receipt": "action.done"},
      "waitFor": {"pointer": "/topology/topology/workspaces", "predicate": "changed", "maxMs": 20000},
      "note": "a second workspace right below the anchor in its group, so 'right below' is not 'last'"
    },
    {
      "id": "grouped",
      "op": "snapshot",
      "args": {"facets": ["topology", "sidebar", "terminals"]},
      "settleMaxMs": 5000
    },
    {
      "id": "like-anchor",
      "op": "action.run",
      "target": {"workspace": "$step:anchor#/created/0"},
      "args": {"action": "workspace.newLikeThis"},
      "expect": {"outcome": "ok", "receipt": "action.done"},
      "waitFor": {"pointer": "/topology/topology/workspaces", "predicate": "changed", "maxMs": 20000},
      "settleMaxMs": 10000,
      "note": "script row 'New Workspace Like This on a grouped terminal workspace'"
    },
    {
      "id": "liked",
      "op": "snapshot",
      "args": {"facets": ["topology", "sidebar", "terminals"]},
      "settleMaxMs": 5000
    },
    {
      "id": "page-workspace",
      "op": "key",
      "target": {"window": "current"},
      "args": {"keys": ["cmd+n"]},
      "expect": {"outcome": "ok", "receipt": "action.done"},
      "waitFor": {"pointer": "/topology/topology/focus/workspace", "predicate": "changed", "maxMs": 20000},
      "settleMaxMs": 10000,
      "note": "a person's Cmd-N: a shown workspace on the New Tab page"
    },
    {
      "id": "like-page",
      "op": "action.run",
      "target": {"window": "current"},
      "args": {"action": "workspace.newLikeThis"},
      "expect": {"outcome": "ok", "receipt": "action.done"},
      "waitFor": {"pointer": "/topology/topology/workspaces", "predicate": "changed", "maxMs": 20000},
      "settleMaxMs": 10000,
      "note": "script row 'New Workspace Like This on a New Tab page workspace opens on the New Tab page': no target, so the shown (Cmd-N) workspace"
    },
    {
      "id": "show-page-liked",
      "op": "key",
      "target": {"window": "current"},
      "args": {"keys": ["ctrl+cmd+]"]},
      "expect": {"outcome": "ok", "receipt": "action.done"},
      "waitFor": {"pointer": "/topology/topology/focus/workspace", "predicate": "changed", "maxMs": 5000},
      "settleMaxMs": 10000,
      "note": "a socket run files the new workspace without showing it; Next Sidebar Item shows the row right below the Cmd-N workspace, which is the one like-page made"
    },
    {
      "id": "page-liked",
      "op": "snapshot",
      "args": {"facets": ["topology", "focus", "tabs", "webviews"]},
      "settleMaxMs": 5000
    },
    {
      "id": "old-same-directory",
      "op": "action.run",
      "target": {"workspace": "$step:anchor#/created/0"},
      "args": {"action": "workspace.newInSameDirectory"},
      "expect": {"outcome": "ok", "receipt": "action.done"},
      "waitFor": {"pointer": "/topology/topology/workspaces", "predicate": "changed", "maxMs": 20000},
      "note": "script row 'the old id workspace.newInSameDirectory runs New Workspace Like This' (ActionCatalog renamed ids)"
    },
    {
      "id": "old-in-group",
      "op": "action.run",
      "target": {"workspace": "$step:anchor#/created/0"},
      "args": {"action": "workspace.newInGroup"},
      "expect": {"outcome": "ok", "receipt": "action.done"},
      "waitFor": {"pointer": "/topology/topology/workspaces", "predicate": "changed", "maxMs": 20000},
      "note": "script row 'the old id workspace.newInGroup runs New Workspace Like This'"
    },
    {
      "id": "end",
      "op": "snapshot",
      "args": {"facets": ["topology", "sidebar", "terminals"]},
      "settleMaxMs": 5000
    }
  ],
  "invariants": [
    "at liked, the workspace like-anchor made is the sidebar row right after the anchor and before below-anchor's, in the anchor's group, and its first tab is a terminal whose cwd equals the anchor terminal's cwd",
    "at page-liked the focused tab of the shown workspace is a New Tab page, not a terminal",
    "old-same-directory and old-in-group each add one workspace in the anchor's group right below it, as like-anchor did",
    "every mutation has one receipt or one typed error (I1)",
    "ids stay stable unless the step created or closed them (I2)"
  ],
  "teardown": ["quit the tagged app the run started", "verify its debug socket is gone", "end the tag's daemons (TagTeardown)"],
  "untested": [
    "a workspace row's New menu (debug.sidebar_rows menu_x/menu_y submenus): no facet records menu item titles",
    "that the old ids' replies name workspace.newLikeThis: action.run's `action` member is not part of expect.result"
  ]
}
