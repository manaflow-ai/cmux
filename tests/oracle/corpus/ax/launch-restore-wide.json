{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "launch-restore-wide",
  "suite": "ax",
  "title": "Launch, open a tab, relaunch and find the same controls (wide, 2560 pt): AX tree",
  "journey": "launch-restore",
  "priority": "P0",
  "surface": "cmux-next-native",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {
    "viewport": {
      "width": 2560,
      "height": 900
    },
    "scale": 2,
    "theme": "dark",
    "locale": "en-US",
    "reducedMotion": false,
    "engine": "none"
  },
  "fixture": {
    "seed": "ax-launch-restore-wide-v1",
    "network": "offline",
    "clock": "fixed",
    "agent": "none"
  },
  "preconditions": [
    "private scratch config",
    "tagged bench build",
    "no unrelated app instance",
    "the main window is 2560 x 900 pt"
  ],
  "requires": [
    "keys",
    "gui",
    "restart"
  ],
  "platforms": [
    "mac"
  ],
  "steps": [
    {
      "id": "ax-launch",
      "op": "snapshot",
      "args": {
        "facets": [
          "ax"
        ]
      }
    },
    {
      "id": "new-tab",
      "op": "key",
      "target": {
        "window": "main"
      },
      "args": {
        "keys": [
          "cmd+n"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.applied"
      }
    },
    {
      "id": "ax-new-tab",
      "op": "snapshot",
      "args": {
        "facets": [
          "ax"
        ]
      }
    },
    {
      "id": "relaunch",
      "op": "restart",
      "target": {
        "process": "app"
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a relaunch runs no action; the restored windows are its result"
      }
    },
    {
      "id": "ax-restored",
      "op": "snapshot",
      "args": {
        "facets": [
          "ax"
        ]
      }
    }
  ],
  "invariants": [
    "a kept element whose name is an app string has its localization key, never its text",
    "the restored window has the controls it had before the relaunch, with the same keys"
  ],
  "teardown": [
    "quit the tagged app the run started",
    "verify its debug socket is gone"
  ],
  "untested": [
    "VoiceOver speech output",
    "the AX trees of web pages (the webviews facet, p15-oracle-215)"
  ]
}
