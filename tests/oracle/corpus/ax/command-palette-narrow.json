{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "command-palette-narrow",
  "suite": "ax",
  "title": "Open the palette, search, move the selection, dismiss and reopen (narrow, 800 pt): AX tree",
  "journey": "command-palette",
  "priority": "P0",
  "surface": "cmux-next-native",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {
    "viewport": {
      "width": 800,
      "height": 900
    },
    "scale": 2,
    "theme": "dark",
    "locale": "en-US",
    "reducedMotion": false,
    "engine": "none"
  },
  "fixture": {
    "seed": "ax-command-palette-narrow-v1",
    "network": "offline",
    "clock": "fixed",
    "agent": "none"
  },
  "preconditions": [
    "private scratch config",
    "tagged bench build",
    "no unrelated app instance",
    "the main window is 800 x 900 pt"
  ],
  "requires": [
    "keys",
    "gui"
  ],
  "platforms": [
    "mac"
  ],
  "steps": [
    {
      "id": "ax-start",
      "op": "snapshot",
      "args": {
        "facets": [
          "ax"
        ]
      }
    },
    {
      "id": "open-palette",
      "op": "key",
      "target": {
        "window": "main"
      },
      "args": {
        "keys": [
          "cmd+shift+p"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      }
    },
    {
      "id": "search",
      "op": "key",
      "target": {
        "window": "main"
      },
      "args": {
        "keys": [
          "s",
          "p",
          "l",
          "i",
          "t"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "typed text goes to the focused field or terminal, not to an action"
      }
    },
    {
      "id": "move-down",
      "op": "key",
      "target": {
        "window": "main"
      },
      "args": {
        "keys": [
          "down"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      }
    },
    {
      "id": "ax-results",
      "op": "snapshot",
      "args": {
        "facets": [
          "ax"
        ]
      }
    },
    {
      "id": "dismiss",
      "op": "key",
      "target": {
        "window": "main"
      },
      "args": {
        "keys": [
          "escape"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      }
    },
    {
      "id": "ax-dismissed",
      "op": "snapshot",
      "args": {
        "facets": [
          "ax"
        ]
      }
    },
    {
      "id": "reopen",
      "op": "key",
      "target": {
        "window": "main"
      },
      "args": {
        "keys": [
          "cmd+shift+p"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      }
    },
    {
      "id": "ax-reopened",
      "op": "snapshot",
      "args": {
        "facets": [
          "ax"
        ]
      }
    },
    {
      "id": "dismiss-again",
      "op": "key",
      "target": {
        "window": "main"
      },
      "args": {
        "keys": [
          "escape"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      }
    }
  ],
  "invariants": [
    "a kept element whose name is an app string has its localization key, never its text",
    "the palette's search field has the focus while it shows",
    "the focus returns where it was after each dismiss"
  ],
  "teardown": [
    "quit the tagged app the run started",
    "verify its debug socket is gone"
  ],
  "untested": [
    "VoiceOver speech output",
    "the AX trees of web pages (the webviews facet, p15-oracle-215)"
  ]
}
