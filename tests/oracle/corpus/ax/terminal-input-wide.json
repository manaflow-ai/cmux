{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "terminal-input-wide",
  "suite": "ax",
  "title": "Type in a terminal, open the find bar, search and close it (wide, 2560 pt): AX tree",
  "journey": "terminal-input",
  "priority": "P0",
  "surface": "cmux-next-native",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {
    "viewport": {
      "width": 2560,
      "height": 900
    },
    "scale": 2,
    "theme": "dark",
    "locale": "en-US",
    "reducedMotion": false,
    "engine": "none"
  },
  "fixture": {
    "seed": "ax-terminal-input-wide-v1",
    "network": "offline",
    "clock": "fixed",
    "agent": "none"
  },
  "preconditions": [
    "private scratch config",
    "tagged bench build",
    "no unrelated app instance",
    "the main window is 2560 x 900 pt"
  ],
  "requires": [
    "keys",
    "gui"
  ],
  "platforms": [
    "mac"
  ],
  "steps": [
    {
      "id": "ax-start",
      "op": "snapshot",
      "args": {
        "facets": [
          "ax"
        ]
      }
    },
    {
      "id": "type-command",
      "op": "key",
      "target": {
        "window": "main"
      },
      "args": {
        "keys": [
          "e",
          "c",
          "h",
          "o",
          "space",
          "o",
          "k"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "typed text goes to the focused field or terminal, not to an action"
      }
    },
    {
      "id": "submit",
      "op": "key",
      "target": {
        "window": "main"
      },
      "args": {
        "keys": [
          "return"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "typed text goes to the focused field or terminal, not to an action"
      }
    },
    {
      "id": "open-find",
      "op": "key",
      "target": {
        "window": "main"
      },
      "args": {
        "keys": [
          "cmd+f"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      }
    },
    {
      "id": "ax-find-bar",
      "op": "snapshot",
      "args": {
        "facets": [
          "ax"
        ]
      }
    },
    {
      "id": "type-query",
      "op": "key",
      "target": {
        "window": "main"
      },
      "args": {
        "keys": [
          "o",
          "k"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "typed text goes to the focused field or terminal, not to an action"
      }
    },
    {
      "id": "close-find",
      "op": "key",
      "target": {
        "window": "main"
      },
      "args": {
        "keys": [
          "escape"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      }
    },
    {
      "id": "ax-find-closed",
      "op": "snapshot",
      "args": {
        "facets": [
          "ax"
        ]
      }
    }
  ],
  "invariants": [
    "a kept element whose name is an app string has its localization key, never its text",
    "the find bar's field has the focus while it shows",
    "the terminal has the focus again after the find bar closes"
  ],
  "teardown": [
    "quit the tagged app the run started",
    "verify its debug socket is gone"
  ],
  "untested": [
    "VoiceOver speech output",
    "the AX trees of web pages (the webviews facet, p15-oracle-215)"
  ]
}
