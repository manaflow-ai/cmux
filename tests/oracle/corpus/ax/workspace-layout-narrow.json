{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "workspace-layout-narrow",
  "suite": "ax",
  "title": "Split right and down, move focus, rename and close a tab (narrow, 800 pt): AX tree",
  "journey": "workspace-layout",
  "priority": "P0",
  "surface": "cmux-next-native",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {
    "viewport": {
      "width": 800,
      "height": 900
    },
    "scale": 2,
    "theme": "dark",
    "locale": "en-US",
    "reducedMotion": false,
    "engine": "none"
  },
  "fixture": {
    "seed": "ax-workspace-layout-narrow-v1",
    "network": "offline",
    "clock": "fixed",
    "agent": "none"
  },
  "preconditions": [
    "private scratch config",
    "tagged bench build",
    "no unrelated app instance",
    "the main window is 800 x 900 pt"
  ],
  "requires": [
    "keys",
    "gui"
  ],
  "platforms": [
    "mac"
  ],
  "steps": [
    {
      "id": "ax-start",
      "op": "snapshot",
      "args": {
        "facets": [
          "ax"
        ]
      }
    },
    {
      "id": "split-right",
      "op": "key",
      "target": {
        "window": "main"
      },
      "args": {
        "keys": [
          "cmd+d"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.applied"
      }
    },
    {
      "id": "split-down",
      "op": "key",
      "target": {
        "window": "main"
      },
      "args": {
        "keys": [
          "cmd+shift+d"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.applied"
      }
    },
    {
      "id": "focus-left",
      "op": "key",
      "target": {
        "window": "main"
      },
      "args": {
        "keys": [
          "cmd+opt+left"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      }
    },
    {
      "id": "ax-split",
      "op": "snapshot",
      "args": {
        "facets": [
          "ax"
        ]
      }
    },
    {
      "id": "rename",
      "op": "key",
      "target": {
        "window": "main"
      },
      "args": {
        "keys": [
          "cmd+r"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      }
    },
    {
      "id": "ax-rename-prompt",
      "op": "snapshot",
      "args": {
        "facets": [
          "ax"
        ]
      }
    },
    {
      "id": "dismiss-rename",
      "op": "key",
      "target": {
        "window": "main"
      },
      "args": {
        "keys": [
          "escape"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      }
    },
    {
      "id": "close-tab",
      "op": "key",
      "target": {
        "window": "main"
      },
      "args": {
        "keys": [
          "cmd+w"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.applied"
      }
    },
    {
      "id": "ax-closed",
      "op": "snapshot",
      "args": {
        "facets": [
          "ax"
        ]
      }
    }
  ],
  "invariants": [
    "a kept element whose name is an app string has its localization key, never its text",
    "the rename prompt's field has the focus while it shows",
    "the focus returns to a pane after the prompt and the close"
  ],
  "teardown": [
    "quit the tagged app the run started",
    "verify its debug socket is gone"
  ],
  "untested": [
    "VoiceOver speech output",
    "the AX trees of web pages (the webviews facet, p15-oracle-215)"
  ]
}
