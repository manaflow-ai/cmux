{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "accessibility-and-narrow-wide",
  "suite": "ax",
  "title": "Drive splits, focus moves and the palette from the keyboard with reduced motion (wide, 2560 pt): AX tree",
  "journey": "accessibility-and-narrow",
  "priority": "P1",
  "surface": "cmux-next-native",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {
    "viewport": {
      "width": 2560,
      "height": 900
    },
    "scale": 2,
    "theme": "dark",
    "locale": "en-US",
    "reducedMotion": true,
    "engine": "none"
  },
  "fixture": {
    "seed": "ax-accessibility-and-narrow-wide-v1",
    "network": "offline",
    "clock": "fixed",
    "agent": "none"
  },
  "preconditions": [
    "private scratch config",
    "tagged bench build",
    "no unrelated app instance",
    "the main window is 2560 x 900 pt"
  ],
  "requires": [
    "keys",
    "gui"
  ],
  "platforms": [
    "mac"
  ],
  "steps": [
    {
      "id": "ax-start",
      "op": "snapshot",
      "args": {
        "facets": [
          "ax"
        ]
      }
    },
    {
      "id": "split-right",
      "op": "key",
      "target": {
        "window": "main"
      },
      "args": {
        "keys": [
          "cmd+d"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.applied"
      }
    },
    {
      "id": "ax-split",
      "op": "snapshot",
      "args": {
        "facets": [
          "ax"
        ]
      }
    },
    {
      "id": "focus-left",
      "op": "key",
      "target": {
        "window": "main"
      },
      "args": {
        "keys": [
          "cmd+opt+left"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      }
    },
    {
      "id": "ax-focus-left",
      "op": "snapshot",
      "args": {
        "facets": [
          "ax"
        ]
      }
    },
    {
      "id": "focus-right",
      "op": "key",
      "target": {
        "window": "main"
      },
      "args": {
        "keys": [
          "cmd+opt+right"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      }
    },
    {
      "id": "open-palette",
      "op": "key",
      "target": {
        "window": "main"
      },
      "args": {
        "keys": [
          "cmd+shift+p"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      }
    },
    {
      "id": "move-down",
      "op": "key",
      "target": {
        "window": "main"
      },
      "args": {
        "keys": [
          "down",
          "down"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      }
    },
    {
      "id": "ax-palette",
      "op": "snapshot",
      "args": {
        "facets": [
          "ax"
        ]
      }
    },
    {
      "id": "dismiss",
      "op": "key",
      "target": {
        "window": "main"
      },
      "args": {
        "keys": [
          "escape"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      }
    },
    {
      "id": "ax-end",
      "op": "snapshot",
      "args": {
        "facets": [
          "ax"
        ]
      }
    }
  ],
  "invariants": [
    "a kept element whose name is an app string has its localization key, never its text",
    "every control a key reaches stays kept at every width",
    "the focused element follows each focus move"
  ],
  "teardown": [
    "quit the tagged app the run started",
    "verify its debug socket is gone"
  ],
  "untested": [
    "VoiceOver speech output",
    "the AX trees of web pages (the webviews facet, p15-oracle-215)"
  ]
}
