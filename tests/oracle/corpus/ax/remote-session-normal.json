{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "remote-session-normal",
  "suite": "ax",
  "title": "Open the remote connect flow offline and dismiss it (normal, 1440 pt): AX tree",
  "journey": "remote-session",
  "priority": "P2",
  "surface": "cmux-next-native",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "scale": 2,
    "theme": "dark",
    "locale": "en-US",
    "reducedMotion": false,
    "engine": "none"
  },
  "fixture": {
    "seed": "ax-remote-session-normal-v1",
    "network": "offline",
    "clock": "fixed",
    "agent": "none"
  },
  "preconditions": [
    "private scratch config",
    "tagged bench build",
    "no unrelated app instance",
    "the main window is 1440 x 900 pt"
  ],
  "requires": [
    "actions",
    "keys",
    "gui"
  ],
  "platforms": [
    "mac"
  ],
  "steps": [
    {
      "id": "ax-start",
      "op": "snapshot",
      "args": {
        "facets": [
          "ax"
        ]
      }
    },
    {
      "id": "remote-connect",
      "op": "action.run",
      "target": {
        "window": "main"
      },
      "args": {
        "action": "remote.connect",
        "entrypoint": "script"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      }
    },
    {
      "id": "ax-connect",
      "op": "snapshot",
      "args": {
        "facets": [
          "ax"
        ]
      }
    },
    {
      "id": "dismiss",
      "op": "key",
      "target": {
        "window": "main"
      },
      "args": {
        "keys": [
          "escape"
        ]
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      }
    },
    {
      "id": "ax-dismissed",
      "op": "snapshot",
      "args": {
        "facets": [
          "ax"
        ]
      }
    }
  ],
  "invariants": [
    "a kept element whose name is an app string has its localization key, never its text",
    "the connect flow's controls are kept while it shows and the local controls are unchanged after it"
  ],
  "teardown": [
    "quit the tagged app the run started",
    "verify its debug socket is gone"
  ],
  "untested": [
    "VoiceOver speech output",
    "the AX trees of web pages (the webviews facet, p15-oracle-215)"
  ]
}
