{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "tabs-and-browser-normal",
  "suite": "ax",
  "title": "Open a browser page and a second browser tab, go back and reload in it, and close it (normal, 1440 pt): AX tree",
  "journey": "tabs-and-browser",
  "priority": "P0",
  "surface": "cmux-next-native",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "scale": 2,
    "theme": "dark",
    "locale": "en-US",
    "reducedMotion": false,
    "engine": "chromium"
  },
  "fixture": {
    "seed": "ax-tabs-and-browser-normal-v1",
    "network": "offline",
    "clock": "fixed",
    "agent": "none",
    "web": true
  },
  "preconditions": [
    "private scratch config",
    "tagged bench build",
    "no unrelated app instance",
    "the main window is 1440 x 900 pt"
  ],
  "requires": [
    "actions",
    "keys",
    "gui",
    "chromium"
  ],
  "platforms": [
    "mac"
  ],
  "steps": [
    {
      "id": "open-page",
      "op": "action.run",
      "target": {
        "window": "main"
      },
      "args": {
        "action": "newBrowserWorkspace",
        "entrypoint": "script",
        "params": {
          "url": "$WEB/load.html"
        }
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.applied"
      },
      "waitFor": {
        "pointer": "/tabs/selected/loading",
        "equals": false,
        "maxMs": 5000
      }
    },
    {
      "id": "ax-page",
      "op": "snapshot",
      "args": {
        "facets": [
          "ax"
        ]
      }
    },
    {
      "id": "new-tab",
      "op": "action.run",
      "target": {
        "window": "main"
      },
      "args": {
        "action": "openBrowser",
        "entrypoint": "script",
        "params": {
          "url": "$WEB/load.html"
        }
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.applied"
      },
      "waitFor": {
        "pointer": "/tabs/selected/loading",
        "equals": false,
        "maxMs": 5000
      }
    },
    {
      "id": "back",
      "op": "action.run",
      "target": {
        "window": "main"
      },
      "args": {
        "action": "browserBack",
        "entrypoint": "script"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      }
    },
    {
      "id": "reload",
      "op": "action.run",
      "target": {
        "window": "main"
      },
      "args": {
        "action": "browserReload",
        "entrypoint": "script"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      },
      "waitFor": {
        "pointer": "/tabs/selected/loading",
        "equals": false,
        "maxMs": 5000
      }
    },
    {
      "id": "ax-reloaded",
      "op": "snapshot",
      "args": {
        "facets": [
          "ax"
        ]
      }
    },
    {
      "id": "close-tab",
      "op": "action.run",
      "target": {
        "window": "main"
      },
      "args": {
        "action": "closeTab",
        "entrypoint": "script"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.applied"
      }
    },
    {
      "id": "ax-closed",
      "op": "snapshot",
      "args": {
        "facets": [
          "ax"
        ]
      }
    }
  ],
  "invariants": [
    "a kept element whose name is an app string has its localization key, never its text",
    "the browser chrome's controls are kept and the page's own elements are not (the webviews facet has them)"
  ],
  "teardown": [
    "quit the tagged app the run started",
    "verify its debug socket is gone"
  ],
  "untested": [
    "VoiceOver speech output",
    "the AX trees of web pages (the webviews facet, p15-oracle-215)"
  ]
}
