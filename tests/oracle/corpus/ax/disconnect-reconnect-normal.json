{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "disconnect-reconnect-normal",
  "suite": "ax",
  "title": "Restart the daemon and reconnect the workspace (normal, 1440 pt): AX tree",
  "journey": "disconnect-reconnect",
  "priority": "P1",
  "surface": "cmux-next-native",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "scale": 2,
    "theme": "dark",
    "locale": "en-US",
    "reducedMotion": false,
    "engine": "none"
  },
  "fixture": {
    "seed": "ax-disconnect-reconnect-normal-v1",
    "network": "offline",
    "clock": "fixed",
    "agent": "none"
  },
  "preconditions": [
    "private scratch config",
    "tagged bench build",
    "no unrelated app instance",
    "the main window is 1440 x 900 pt"
  ],
  "requires": [
    "actions",
    "gui",
    "restart"
  ],
  "platforms": [
    "mac"
  ],
  "steps": [
    {
      "id": "ax-start",
      "op": "snapshot",
      "args": {
        "facets": [
          "ax"
        ]
      }
    },
    {
      "id": "restart-daemon",
      "op": "restart",
      "target": {
        "process": "daemon"
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a daemon restart runs no action"
      }
    },
    {
      "id": "reconnect",
      "op": "action.run",
      "target": {
        "window": "main"
      },
      "args": {
        "action": "reconnectWorkspace",
        "entrypoint": "script"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "action.done"
      }
    },
    {
      "id": "ax-reconnected",
      "op": "snapshot",
      "args": {
        "facets": [
          "ax"
        ]
      }
    }
  ],
  "invariants": [
    "a kept element whose name is an app string has its localization key, never its text",
    "the controls after the reconnect equal the controls before the restart"
  ],
  "teardown": [
    "quit the tagged app the run started",
    "verify its debug socket is gone"
  ],
  "untested": [
    "VoiceOver speech output",
    "the AX trees of web pages (the webviews facet, p15-oracle-215)",
    "the transient reconnecting state: no barrier holds it and the ax facet cannot be waited on"
  ]
}
