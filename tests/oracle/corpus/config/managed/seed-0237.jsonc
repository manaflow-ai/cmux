{
  "file": "{\n  \"appearance\": {\n    \"colorTransition\": {\n      \"springDamping\": 0.1\n    }\n  },\n  \"notifications\": {\n    \"sources\": {\n      \"agent\": {\n        \"dismissal\": 1\n      }\n    }\n  },\n  \"updates\": {\n    \"meteredNetwork\": 1\n  },\n  \"editor\": {\n    \"wordBasedSuggestions\": false\n  }\n}\n",
