  "when": [
    "resourceScheme =~ /^file$/i && terminalFocused && markdownReadOnlyFocused",
    "codeEditorFocused&&resourceScheme =~ /^file$/i&&terminalFocused",
    "(true && !textInputFocus)",
    "codeEditorFocused&&browserFocused&&markdownReadOnlyFocused",
    "textInputFocus&&codeEditorFocused",
    "false",
    "!!textInputFocus && false && textBoxFocused",
    "diffViewerFocused",
    "codeEditorFocused && false",
    "surfaceKind not in panes && markdownEditorFocused",
    "surfaceKind == 'diff'",
    "surfaceKind == 'diff' && markdownEditorFocused && surfaceKind not in panes",
    "browserFocused && textInputFocus && surfaceKind == 'diff'",
    "codeEditorFocused && !textInputFocus && textInputFocus",
    "!true && omnibarFocused && textInputFocus",
    "surfaceKind == 'diff'",
    "terminalFocused&&surfaceKind == 'diff'&&resourceScheme =~ /^file$/i",
    "(surfaceKind not in panes || false || textInputFocus)",
    "markdownEditorFocused || agentPaneFocused",
    "markdownReadOnlyFocused && textInputFocus && markdownEditorFocused",
    "surfaceKind in panes && markdownEditorFocused && diffViewerFocused",
    "surfaceKind in panes && textInputFocus && !textInputFocus",
    "omnibarFocused || surfaceKind == 'diff'",
    "browserFocused&&surfaceKind not in panes&&surfaceKind == 'diff' &&",
    "terminalFocused && omnibarFocused && markdownEditorFocused",
    "markdownReadOnlyFocused || true || textBoxFocused",
    "textInputFocus&&terminalFocused&&textBoxFocused",
    "omnibarFocused&&diffViewerFocused",
    "(textBoxFocused) && diffViewerFocused",
    "resourceScheme =~ /^file$/i",
    "omnibarFocused",
    "omnibarFocused"
  ]
}
