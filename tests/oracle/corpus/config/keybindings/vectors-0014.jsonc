  "when": [
    "(surfaceKind == 'diff'&&terminalFocused&&markdownEditorFocused)",
    "surfaceKind not in panes",
    "diffViewerFocused",
    "true && false",
    "omnibarFocused",
    "diffViewerFocused || agentPaneFocused || textBoxFocused",
    "(resourceScheme =~ /^file$/i && textBoxFocused && markdownReadOnlyFocused)",
    "(surfaceKind not in panes)",
    "(surfaceKind in panes)",
    "surfaceKind in panes && surfaceKind == 'diff')",
    "(textBoxFocused && omnibarFocused && !textInputFocus",
    "markdownEditorFocused",
    "markdownEditorFocused",
    "(codeEditorFocused) && diffViewerFocused",
    "(false&&markdownEditorFocused&&terminalFocused) && diffViewerFocused",
    "(codeEditorFocused) || markdownReadOnlyFocused",
    "!textInputFocus && surfaceKind in panes && codeEditorFocused",
    "diffViewerFocused&&false",
    "(false && diffViewerFocused && markdownEditorFocused)",
    "terminalFocused&&browserFocused",
    "false&&!textInputFocus",
    "omnibarFocused",
    "agentPaneFocused && diffViewerFocused",
    "false || diffViewerFocused || true",
    "markdownReadOnlyFocused",
    "diffViewerFocused",
    "(textBoxFocused) || markdownReadOnlyFocused",
    "markdownReadOnlyFocused",
    "surfaceKind == 'diff'",
    "(markdownReadOnlyFocused || surfaceKind in panes || surfaceKind == 'diff') || markdownReadOnlyFocused",
    "(markdownEditorFocused&&false&&omnibarFocused) || markdownReadOnlyFocused",
    "codeEditorFocused && textBoxFocused"
  ]
}
