{
  "strokes": [
    "alt+up",
    "alt+down",
    "alt+tab",
    "alt+return",
    "alt+enter",
    "alt+escape",
    "alt+esc",
    "alt+delete",
    "alt+backspace",
    "alt+space",
    "alt+spacebar",
    "alt+home",
    "alt+end",
    "alt+pageup",
    "alt+pagedown",
    "alt+plus",
    "alt+equals",
    "alt+comma",
    "alt+period",
    "alt+dot",
    "alt+slash",
    "alt+backslash",
    "alt+semicolon",
    "alt+quote",
    "alt+apostrophe",
    "alt+backtick",
    "alt+grave",
    "alt+minus",
    "alt+hyphen",
    "alt+leftbracket",
    "alt+openbracket",
    "alt+rightbracket",
    "alt+closebracket",
    "alt+arrowleft",
    "alt+leftarrow",
    "alt+arrowup",
    "alt+uparrow",
    "alt+arrowdown",
    "alt+downarrow",
    "alt+arrowright",
    "alt+rightarrow",
    "alt+Left",
    "alt+TAB",
    "alt+←",
    "alt+↑",
    "alt+⇥",
    "alt+↩",
    "alt+⎋",
    "alt+⌫",
    "alt+<space>",
    "alt+f0",
    "alt+f1",
    "alt+f9",
    "alt+f12",
    "alt+f13",
    "alt+f20",
    "alt+f21",
    "alt+F5",
    "alt+insert",
    "alt+",
    "alt+ ",
    "alt+ab",
    "⌥+a",
    "⌥+b"
  ],
  "when": [
    "resourceScheme =~ /^file$/i || diffViewerFocused",
    "surfaceKind not in panes && textInputFocus && markdownEditorFocused",
    "textBoxFocused && surfaceKind not in panes",
    "diffViewerFocused && textBoxFocused && resourceScheme =~ /^file$/i",
    "(diffViewerFocused && omnibarFocused && !textInputFocus)",
    "browserFocused && diffViewerFocused && markdownEditorFocused",
    "terminalFocused",
    "diffViewerFocused",
    "markdownEditorFocused&&false",
    "omnibarFocused",
    "surfaceKind == 'diff' || markdownEditorFocused || diffViewerFocused",
    "(diffViewerFocused&&surfaceKind not in panes&&true) || markdownReadOnlyFocused",
    "false || codeEditorFocused || omnibarFocused",
    "agentPaneFocused && true && markdownReadOnlyFocused",
    "surfaceKind not in panes && terminalFocused",
    "terminalFocused && surfaceKind in panes",
    "agentPaneFocused && markdownReadOnlyFocused && diffViewerFocused",
    "markdownEditorFocused",
    "!!markdownReadOnlyFocused",
    "(diffViewerFocused&&surfaceKind == 'diff'&&omnibarFocused)",
    "surfaceKind not in panes && markdownReadOnlyFocused",
    "(surfaceKind not in panes) && diffViewerFocused",
    "(markdownEditorFocused && omnibarFocused) || markdownReadOnlyFocused",
    "!false && surfaceKind == 'diff'",
    "(markdownEditorFocused && agentPaneFocused) || markdownReadOnlyFocused",
    "markdownEditorFocused&&surfaceKind in panes&&false",
    "textInputFocus",
    "omnibarFocused",
    "surfaceKind == 'diff'&&surfaceKind not in panes",
    "codeEditorFocused",
    "(omnibarFocused && markdownReadOnlyFocused && false) || markdownReadOnlyFocused",
    "surfaceKind in panes && surfaceKind not in panes && false"
  ]
}
