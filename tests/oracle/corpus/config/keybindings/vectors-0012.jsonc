    "alt+[",
    "alt+]",
    "alt++",
    "alt+é",
    "alt+ß",
    "alt+left",
    "alt+right"
  ],
  "when": [
    "surfaceKind not in panes && omnibarFocused",
    "markdownEditorFocused &&",
    "omnibarFocused && surfaceKind not in panes && terminalFocused",
    "markdownReadOnlyFocused",
    "diffViewerFocused",
    "(false && agentPaneFocused) && diffViewerFocused",
    "resourceScheme =~ /^file$/i)",
    "markdownReadOnlyFocused&&!textInputFocus&&textBoxFocused",
    "surfaceKind == 'diff' && textInputFocus && surfaceKind not in panes",
    "true && markdownReadOnlyFocused && resourceScheme =~ /^file$/i",
    "(diffViewerFocused && agentPaneFocused) && diffViewerFocused",
    "false&&markdownReadOnlyFocused",
    "!!resourceScheme =~ /^file$/i && diffViewerFocused && terminalFocused",
    "diffViewerFocused && omnibarFocused",
    "(markdownReadOnlyFocused)",
    "markdownEditorFocused&&surfaceKind == 'diff'&&markdownReadOnlyFocused",
    "codeEditorFocused && true",
    "surfaceKind in panes",
    "resourceScheme =~ /^file$/i&&terminalFocused",
    "(terminalFocused && browserFocused) && diffViewerFocused",
    "markdownReadOnlyFocused)",
    "terminalFocused && false",
    "codeEditorFocused",
    "markdownReadOnlyFocused && browserFocused",
    "!textBoxFocused && agentPaneFocused && !textInputFocus",
    "agentPaneFocused && diffViewerFocused && markdownEditorFocused",
    "textInputFocus || diffViewerFocused",
    "(surfaceKind == 'diff' && terminalFocused && textInputFocus) && diffViewerFocused",
    "true",
    "true && agentPaneFocused && !textInputFocus",
    "surfaceKind not in panes && surfaceKind == 'diff' && resourceScheme =~ /^file$/i",
    "diffViewerFocused && surfaceKind not in panes && codeEditorFocused"
  ]
}
