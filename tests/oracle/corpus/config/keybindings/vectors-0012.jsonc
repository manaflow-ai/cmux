{
  "strokes": [
    "option+backtick",
    "option+grave",
    "option+minus",
    "option+hyphen",
    "option+leftbracket",
    "option+openbracket",
    "option+rightbracket",
    "option+closebracket",
    "option+arrowleft",
    "option+leftarrow",
    "option+arrowup",
    "option+uparrow",
    "option+arrowdown",
    "option+downarrow",
    "option+arrowright",
    "option+rightarrow",
    "option+Left",
    "option+TAB",
    "option+←",
    "option+↑",
    "option+⇥",
    "option+↩",
    "option+⎋",
    "option+⌫",
    "option+<space>",
    "option+f0",
    "option+f1",
    "option+f9",
    "option+f12",
    "option+f13",
    "option+f20",
    "option+f21",
    "option+F5",
    "option+insert",
    "option+",
    "option+ ",
    "option+ab",
    "alt+a",
    "alt+b",
    "alt+c",
    "alt+x",
    "alt+y",
    "alt+z",
    "alt+A",
    "alt+Z",
    "alt+0",
    "alt+1",
    "alt+9",
    "alt+,",
    "alt+.",
    "alt+/",
    "alt+\\",
    "alt+;",
    "alt+'",
    "alt+`",
    "alt+-",
