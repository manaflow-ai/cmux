  "when": [
    "terminalFocused",
    "diffViewerFocused",
    "agentPaneFocused && browserFocused && terminalFocused",
    "surfaceKind == 'diff'",
    "(diffViewerFocused || textInputFocus || surfaceKind not in panes) && diffViewerFocused",
    "surfaceKind == 'diff'",
    "diffViewerFocused",
    "false || omnibarFocused",
    "(surfaceKind not in panes) || markdownReadOnlyFocused",
    "textInputFocus && terminalFocused",
    "markdownEditorFocused && omnibarFocused",
    "markdownReadOnlyFocused",
    "surfaceKind in panes",
    "(surfaceKind in panes && surfaceKind == 'diff' && surfaceKind not in panes)",
    "true",
    "((true&&agentPaneFocused&&!textInputFocus) || markdownReadOnlyFocused",
    "(diffViewerFocused && omnibarFocused && codeEditorFocused) || markdownReadOnlyFocused",
    "(terminalFocused && omnibarFocused) || markdownReadOnlyFocused",
    "omnibarFocused",
    "(false || surfaceKind not in panes",
    "codeEditorFocused",
    "resourceScheme =~ /^file$/i && false && surfaceKind == 'diff'",
    "surfaceKind == 'diff'",
    "diffViewerFocused&&textInputFocus&&textBoxFocused",
    "(!textInputFocus || false || browserFocused) || markdownReadOnlyFocused &&",
    "(codeEditorFocused&&diffViewerFocused&&markdownEditorFocused) && diffViewerFocused",
    "browserFocused && textBoxFocused && textInputFocus",
    "textBoxFocused || markdownReadOnlyFocused || codeEditorFocused",
    "terminalFocused",
    "codeEditorFocused&&terminalFocused",
    "(textInputFocus || browserFocused) || markdownReadOnlyFocused",
    "(markdownReadOnlyFocused"
  ]
}
