{
  "strokes": [
    "command+9",
    "command+,",
    "command+.",
    "command+/",
    "command+\\",
    "command+;",
    "command+'",
    "command+`",
    "command+-",
    "command+=",
    "command+[",
    "command+]",
    "command++",
    "command+é",
    "command+ß",
    "command+left",
    "command+right",
    "command+up",
    "command+down",
    "command+tab",
    "command+return",
    "command+enter",
    "command+escape",
    "command+esc",
    "command+delete",
    "command+backspace",
    "command+space",
    "command+spacebar",
    "command+home",
    "command+end",
    "command+pageup",
    "command+pagedown",
    "command+plus",
    "command+equals",
    "command+comma",
    "command+period",
    "command+dot",
    "command+slash",
    "command+backslash",
    "command+semicolon",
    "command+quote",
    "command+apostrophe",
    "command+backtick",
    "command+grave",
    "command+minus",
    "command+hyphen",
    "command+leftbracket",
    "command+openbracket",
    "command+rightbracket",
    "command+closebracket",
    "command+arrowleft",
    "command+leftarrow",
    "command+arrowup",
    "command+uparrow",
    "command+arrowdown",
    "command+downarrow",
    "command+arrowright",
    "command+rightarrow",
    "command+Left",
    "command+TAB",
    "command+←",
    "command+↑",
    "command+⇥",
    "command+↩"
  ],
  "when": [
    "markdownReadOnlyFocused && diffViewerFocused",
    "(terminalFocused && diffViewerFocused && markdownReadOnlyFocused) && diffViewerFocused",
    "textInputFocus && markdownReadOnlyFocused)",
    "textBoxFocused && false",
    "terminalFocused",
    "false&&browserFocused",
    "markdownReadOnlyFocused&&codeEditorFocused",
    "true && markdownEditorFocused && omnibarFocused",
    "agentPaneFocused && surfaceKind not in panes && true",
    "(diffViewerFocused&&codeEditorFocused&&textBoxFocused)",
    "(agentPaneFocused&&surfaceKind == 'diff') || markdownReadOnlyFocused",
    "diffViewerFocused || browserFocused",
    "!textInputFocus&&markdownEditorFocused&&markdownReadOnlyFocused",
    "textBoxFocused&&terminalFocused",
    "markdownReadOnlyFocused",
    "browserFocused && !textInputFocus",
    "resourceScheme =~ /^file$/i&&surfaceKind not in panes",
    "true && omnibarFocused && markdownEditorFocused",
    "!textInputFocus && true && browserFocused",
    "resourceScheme =~ /^file$/i || browserFocused || false)",
    "!textInputFocus && diffViewerFocused",
    "textInputFocus",
    "browserFocused || diffViewerFocused",
    "surfaceKind in panes&&surfaceKind == 'diff'&&codeEditorFocused",
    "terminalFocused&&markdownReadOnlyFocused&&surfaceKind in panes",
    "browserFocused && omnibarFocused && textBoxFocused",
    "(terminalFocused)",
    "!omnibarFocused || surfaceKind not in panes",
    "omnibarFocused && textInputFocus && agentPaneFocused",
    "markdownEditorFocused && surfaceKind not in panes",
    "diffViewerFocused || surfaceKind == 'diff'",
    "browserFocused&&!textInputFocus&&terminalFocused"
  ]
}
