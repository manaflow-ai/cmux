{
  "strokes": [
    "command+⎋",
    "command+⌫",
    "command+<space>",
    "command+f0",
    "command+f1",
    "command+f9",
    "command+f12",
    "command+f13",
    "command+f20",
    "command+f21",
    "command+F5",
    "command+insert",
    "command+",
    "command+ ",
    "command+ab",
    "meta+a",
    "meta+b",
    "meta+c",
    "meta+x",
    "meta+y",
    "meta+z",
    "meta+A",
    "meta+Z",
    "meta+0",
    "meta+1",
    "meta+9",
    "meta+,",
    "meta+.",
    "meta+/",
    "meta+\\",
    "meta+;",
    "meta+'",
    "meta+`",
    "meta+-",
    "meta+=",
    "meta+[",
    "meta+]",
    "meta++",
    "meta+é",
    "meta+ß",
    "meta+left",
    "meta+right",
    "meta+up",
    "meta+down",
    "meta+tab",
    "meta+return",
    "meta+enter",
    "meta+escape",
    "meta+esc",
    "meta+delete",
    "meta+backspace",
    "meta+space",
    "meta+spacebar",
    "meta+home",
    "meta+end",
    "meta+pageup",
    "meta+pagedown",
    "meta+plus",
    "meta+equals",
    "meta+comma",
    "meta+period",
    "meta+dot",
    "meta+slash",
    "meta+backslash"
  ],
  "when": [
    "agentPaneFocused&&textInputFocus",
    "textInputFocus&&agentPaneFocused&&surfaceKind in panes",
    "surfaceKind in panes",
    "textInputFocus",
    "agentPaneFocused && markdownReadOnlyFocused",
    "!textInputFocus",
    "textBoxFocused",
    "codeEditorFocused",
    "true",
    "surfaceKind == 'diff' || diffViewerFocused",
    "terminalFocused",
    "agentPaneFocused",
    "surfaceKind not in panes",
    "(markdownEditorFocused && diffViewerFocused) && diffViewerFocused",
    "browserFocused&&markdownReadOnlyFocused",
    "(codeEditorFocused || agentPaneFocused || !textInputFocus",
    "surfaceKind not in panes && !textInputFocus",
    "(textInputFocus) || markdownReadOnlyFocused",
    "surfaceKind not in panes || false",
    "!!(markdownReadOnlyFocused) || markdownReadOnlyFocused",
    "codeEditorFocused && textInputFocus && terminalFocused",
    "false && markdownReadOnlyFocused && !textInputFocus",
    "terminalFocused",
    "diffViewerFocused&&surfaceKind in panes&&textBoxFocused",
    "terminalFocused&&!textInputFocus",
    "textBoxFocused && terminalFocused",
    "omnibarFocused",
    "(codeEditorFocused) && diffViewerFocused",
    "!!textBoxFocused && codeEditorFocused && diffViewerFocused",
    "(codeEditorFocused&&surfaceKind == 'diff'&&omnibarFocused) && diffViewerFocused",
    "((textInputFocus) && diffViewerFocused",
    "(textBoxFocused && browserFocused && diffViewerFocused) && diffViewerFocused"
  ]
}
