{
  "strokes": [
    "meta+semicolon",
    "meta+quote",
    "meta+apostrophe",
    "meta+backtick",
    "meta+grave",
    "meta+minus",
    "meta+hyphen",
    "meta+leftbracket",
    "meta+openbracket",
    "meta+rightbracket",
    "meta+closebracket",
    "meta+arrowleft",
    "meta+leftarrow",
    "meta+arrowup",
    "meta+uparrow",
    "meta+arrowdown",
    "meta+downarrow",
    "meta+arrowright",
    "meta+rightarrow",
    "meta+Left",
    "meta+TAB",
    "meta+←",
    "meta+↑",
    "meta+⇥",
    "meta+↩",
    "meta+⎋",
    "meta+⌫",
    "meta+<space>",
    "meta+f0",
    "meta+f1",
    "meta+f9",
    "meta+f12",
    "meta+f13",
    "meta+f20",
    "meta+f21",
    "meta+F5",
    "meta+insert",
    "meta+",
    "meta+ ",
    "meta+ab",
    "⌘+a",
    "⌘+b",
    "⌘+c",
    "⌘+x",
    "⌘+y",
    "⌘+z",
    "⌘+A",
    "⌘+Z",
    "⌘+0",
    "⌘+1",
    "⌘+9",
    "⌘+,",
    "⌘+.",
    "⌘+/",
    "⌘+\\",
    "⌘+;",
    "⌘+'",
    "⌘+`",
    "⌘+-",
    "⌘+=",
    "⌘+[",
    "⌘+]",
    "⌘++",
    "⌘+é"
  ],
  "when": [
    "terminalFocused && textInputFocus && textBoxFocused",
    "true && surfaceKind not in panes && textBoxFocused",
    "surfaceKind == 'diff'&&codeEditorFocused",
    "browserFocused&&markdownReadOnlyFocused&&diffViewerFocused",
    "codeEditorFocused || omnibarFocused || markdownReadOnlyFocused",
    "true",
    "omnibarFocused &&",
    "resourceScheme =~ /^file$/i || diffViewerFocused",
    "(markdownReadOnlyFocused) || markdownReadOnlyFocused",
    "textBoxFocused",
    "diffViewerFocused",
    "(codeEditorFocused&&diffViewerFocused) || markdownReadOnlyFocused",
    "browserFocused",
    "(diffViewerFocused && agentPaneFocused",
    "terminalFocused&&true",
    "diffViewerFocused&&surfaceKind in panes&&!textInputFocus",
    "markdownEditorFocused && surfaceKind not in panes && markdownReadOnlyFocused",
    "browserFocused && textInputFocus && diffViewerFocused",
    "(agentPaneFocused && true) || markdownReadOnlyFocused",
    "false && surfaceKind in panes",
    "surfaceKind not in panes && true",
    "false && textBoxFocused && !textInputFocus",
    "surfaceKind == 'diff'",
    "(surfaceKind not in panes)",
    "textInputFocus",
    "!!(resourceScheme =~ /^file$/i)",
    "!codeEditorFocused&&markdownReadOnlyFocused",
    "diffViewerFocused",
    "true",
    "textInputFocus",
    "codeEditorFocused&&surfaceKind == 'diff'",
    "surfaceKind not in panes"
  ]
}
