{
  "strokes": [
    "cmd+backspace",
    "cmd+space",
    "cmd+spacebar",
    "cmd+home",
    "cmd+end",
    "cmd+pageup",
    "cmd+pagedown",
    "cmd+plus",
    "cmd+equals",
    "cmd+comma",
    "cmd+period",
    "cmd+dot",
    "cmd+slash",
    "cmd+backslash",
    "cmd+semicolon",
    "cmd+quote",
    "cmd+apostrophe",
    "cmd+backtick",
    "cmd+grave",
    "cmd+minus",
    "cmd+hyphen",
    "cmd+leftbracket",
    "cmd+openbracket",
    "cmd+rightbracket",
    "cmd+closebracket",
    "cmd+arrowleft",
    "cmd+leftarrow",
    "cmd+arrowup",
    "cmd+uparrow",
    "cmd+arrowdown",
    "cmd+downarrow",
    "cmd+arrowright",
    "cmd+rightarrow",
    "cmd+Left",
    "cmd+TAB",
    "cmd+←",
    "cmd+↑",
    "cmd+⇥",
    "cmd+↩",
    "cmd+⎋",
    "cmd+⌫",
    "cmd+<space>",
    "cmd+f0",
    "cmd+f1",
    "cmd+f9",
    "cmd+f12",
    "cmd+f13",
    "cmd+f20",
    "cmd+f21",
    "cmd+F5",
    "cmd+insert",
    "cmd+",
    "cmd+ ",
    "cmd+ab",
    "command+a",
    "command+b",
    "command+c",
    "command+x",
    "command+y",
    "command+z",
    "command+A",
    "command+Z",
    "command+0",
    "command+1"
  ],
  "when": [
    "(surfaceKind not in panes)",
    "false && markdownReadOnlyFocused && markdownEditorFocused",
    "textInputFocus && false && true",
    "!markdownEditorFocused",
    "!textInputFocus",
    "browserFocused",
    "false && surfaceKind == 'diff' && !textInputFocus",
    "(textInputFocus)",
    "(terminalFocused && codeEditorFocused && !textInputFocus) && diffViewerFocused",
    "agentPaneFocused",
    "surfaceKind == 'diff' || false || terminalFocused",
    "surfaceKind == 'diff' && diffViewerFocused && markdownEditorFocused",
    "(markdownEditorFocused && !textInputFocus) && diffViewerFocused",
    "browserFocused && omnibarFocused && agentPaneFocused",
    "false && diffViewerFocused && true",
    "!textInputFocus",
    "diffViewerFocused && surfaceKind == 'diff' && textBoxFocused",
    "markdownReadOnlyFocused || agentPaneFocused",
    "surfaceKind not in panes && diffViewerFocused && browserFocused",
    "browserFocused&&surfaceKind in panes",
    "!textInputFocus",
    "markdownEditorFocused",
    "false && surfaceKind in panes",
    "!!omnibarFocused || !textInputFocus || surfaceKind not in panes",
    "true && terminalFocused && omnibarFocused",
    "terminalFocused",
    "terminalFocused",
    "omnibarFocused",
    "((resourceScheme =~ /^file$/i&&textInputFocus&&diffViewerFocused) || markdownReadOnlyFocused",
    "omnibarFocused",
    "false",
    "surfaceKind in panes"
  ]
}
