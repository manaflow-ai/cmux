  ],
  "when": [
    "resourceScheme =~ /^file$/i || markdownEditorFocused",
    "diffViewerFocused&&agentPaneFocused",
    "surfaceKind == 'diff'&&textBoxFocused&&surfaceKind not in panes",
    "agentPaneFocused&&browserFocused&&true",
    "resourceScheme =~ /^file$/i || omnibarFocused || false",
    "textInputFocus",
    "true || surfaceKind == 'diff' || surfaceKind not in panes",
    "!textInputFocus || false || textInputFocus",
    "(textInputFocus) && diffViewerFocused",
    "(surfaceKind in panes && textInputFocus)",
    "markdownEditorFocused && omnibarFocused",
    "!diffViewerFocused && markdownEditorFocused && resourceScheme =~ /^file$/i",
    "(surfaceKind in panes)",
    "surfaceKind not in panes && textBoxFocused && false",
    "terminalFocused",
    "codeEditorFocused && surfaceKind == 'diff'",
    "!textInputFocus&&false&&markdownReadOnlyFocused",
    "textInputFocus && markdownReadOnlyFocused",
    "!textInputFocus && terminalFocused && markdownReadOnlyFocused",
    "omnibarFocused && !textInputFocus",
    "!textInputFocus || false",
    "codeEditorFocused && surfaceKind not in panes && diffViewerFocused",
    "(browserFocused&&textInputFocus&&markdownEditorFocused) || markdownReadOnlyFocused",
    "(codeEditorFocused) || markdownReadOnlyFocused",
    "textInputFocus && false",
    "resourceScheme =~ /^file$/i && surfaceKind == 'diff'",
    "resourceScheme =~ /^file$/i || false || omnibarFocused",
    "(resourceScheme =~ /^file$/i)",
    "textInputFocus && false && markdownReadOnlyFocused",
    "markdownReadOnlyFocused || diffViewerFocused || textBoxFocused",
    "terminalFocused && diffViewerFocused",
    "(surfaceKind == 'diff') && diffViewerFocused"
  ]
}
