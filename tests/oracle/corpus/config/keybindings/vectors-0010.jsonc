{
  "strokes": [
    "opt+/",
    "opt+\\",
    "opt+;",
    "opt+'",
    "opt+`",
    "opt+-",
    "opt+=",
    "opt+[",
    "opt+]",
    "opt++",
    "opt+é",
    "opt+ß",
    "opt+left",
    "opt+right",
    "opt+up",
    "opt+down",
    "opt+tab",
    "opt+return",
    "opt+enter",
    "opt+escape",
    "opt+esc",
    "opt+delete",
    "opt+backspace",
    "opt+space",
    "opt+spacebar",
    "opt+home",
    "opt+end",
    "opt+pageup",
    "opt+pagedown",
    "opt+plus",
    "opt+equals",
    "opt+comma",
    "opt+period",
    "opt+dot",
    "opt+slash",
    "opt+backslash",
    "opt+semicolon",
    "opt+quote",
    "opt+apostrophe",
    "opt+backtick",
    "opt+grave",
    "opt+minus",
    "opt+hyphen",
    "opt+leftbracket",
    "opt+openbracket",
    "opt+rightbracket",
    "opt+closebracket",
    "opt+arrowleft",
    "opt+leftarrow",
    "opt+arrowup",
    "opt+uparrow",
    "opt+arrowdown",
    "opt+downarrow",
    "opt+arrowright",
    "opt+rightarrow",
    "opt+Left",
    "opt+TAB",
    "opt+←",
    "opt+↑",
    "opt+⇥",
    "opt+↩",
    "opt+⎋",
    "opt+⌫",
    "opt+<space>"
  ],
  "when": [
    "markdownReadOnlyFocused || surfaceKind not in panes || terminalFocused",
    "markdownReadOnlyFocused",
    "(browserFocused || markdownEditorFocused)",
    "diffViewerFocused && textInputFocus && textBoxFocused",
    "omnibarFocused || resourceScheme =~ /^file$/i || codeEditorFocused",
    "true || markdownEditorFocused",
    "!!true && diffViewerFocused",
    "surfaceKind not in panes",
    "!surfaceKind in panes&&true",
    "diffViewerFocused",
    "!textInputFocus && browserFocused",
    "terminalFocused && codeEditorFocused &&",
    "diffViewerFocused",
    "surfaceKind not in panes",
    "!browserFocused",
    "true && surfaceKind in panes && textInputFocus",
    "diffViewerFocused",
    "markdownEditorFocused || browserFocused || agentPaneFocused",
    "false && textBoxFocused",
    "markdownReadOnlyFocused || markdownEditorFocused || diffViewerFocused",
    "(false) && diffViewerFocused",
    "browserFocused&&codeEditorFocused&&agentPaneFocused &&",
    "terminalFocused && markdownReadOnlyFocused && browserFocused)",
    "agentPaneFocused && !textInputFocus && omnibarFocused",
    "omnibarFocused",
    "terminalFocused && omnibarFocused && !textInputFocus",
    "omnibarFocused && textInputFocus",
    "surfaceKind not in panes",
    "markdownReadOnlyFocused&&surfaceKind in panes&&surfaceKind == 'diff'",
    "markdownReadOnlyFocused && agentPaneFocused && omnibarFocused",
    "markdownReadOnlyFocused || resourceScheme =~ /^file$/i || codeEditorFocused",
    "true && markdownReadOnlyFocused && diffViewerFocused"
  ]
}
