{
  "strokes": [
    "opt+f0",
    "opt+f1",
    "opt+f9",
    "opt+f12",
    "opt+f13",
    "opt+f20",
    "opt+f21",
    "opt+F5",
    "opt+insert",
    "opt+",
    "opt+ ",
    "opt+ab",
    "option+a",
    "option+b",
    "option+c",
    "option+x",
    "option+y",
    "option+z",
    "option+A",
    "option+Z",
    "option+0",
    "option+1",
    "option+9",
    "option+,",
    "option+.",
    "option+/",
    "option+\\",
    "option+;",
    "option+'",
    "option+`",
    "option+-",
    "option+=",
    "option+[",
    "option+]",
    "option++",
    "option+é",
    "option+ß",
    "option+left",
    "option+right",
    "option+up",
    "option+down",
    "option+tab",
    "option+return",
    "option+enter",
    "option+escape",
    "option+esc",
    "option+delete",
    "option+backspace",
    "option+space",
    "option+spacebar",
    "option+home",
    "option+end",
    "option+pageup",
    "option+pagedown",
    "option+plus",
    "option+equals",
    "option+comma",
    "option+period",
    "option+dot",
    "option+slash",
    "option+backslash",
    "option+semicolon",
    "option+quote",
    "option+apostrophe"
  ],
  "when": [
    "!(textBoxFocused) || markdownReadOnlyFocused",
    "true",
    "omnibarFocused && browserFocused && resourceScheme =~ /^file$/i",
    "resourceScheme =~ /^file$/i",
    "!textInputFocus",
    "textBoxFocused",
    "(markdownEditorFocused) || markdownReadOnlyFocused",
    "(codeEditorFocused && surfaceKind == 'diff') && diffViewerFocused",
    "textBoxFocused && textInputFocus",
    "markdownReadOnlyFocused && true && false",
    "agentPaneFocused)",
    "(surfaceKind == 'diff' || diffViewerFocused",
    "!browserFocused && surfaceKind not in panes && codeEditorFocused",
    "!!terminalFocused && !textInputFocus && surfaceKind not in panes",
    "resourceScheme =~ /^file$/i&&browserFocused",
    "markdownReadOnlyFocused && !textInputFocus",
    "markdownReadOnlyFocused && textBoxFocused",
    "(false",
    "(surfaceKind in panes&&terminalFocused) && diffViewerFocused",
    "(false || diffViewerFocused) || markdownReadOnlyFocused &&",
    "terminalFocused",
    "!browserFocused",
    "textBoxFocused && markdownEditorFocused && textInputFocus",
    "!textInputFocus && markdownReadOnlyFocused",
    "omnibarFocused || surfaceKind == 'diff'",
    "markdownEditorFocused",
    "markdownEditorFocused && textBoxFocused && agentPaneFocused",
    "false",
    "diffViewerFocused && resourceScheme =~ /^file$/i",
    "surfaceKind == 'diff' || true || textBoxFocused",
    "resourceScheme =~ /^file$/i",
    "codeEditorFocused&&agentPaneFocused&&terminalFocused"
  ]
}
