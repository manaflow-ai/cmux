    "⇧+minus",
    "⇧+hyphen",
    "⇧+leftbracket",
    "⇧+openbracket",
    "⇧+rightbracket",
    "⇧+closebracket",
    "⇧+arrowleft",
    "⇧+leftarrow",
    "⇧+arrowup",
    "⇧+uparrow",
    "⇧+arrowdown",
    "⇧+downarrow",
    "⇧+arrowright",
    "⇧+rightarrow",
    "⇧+Left",
    "⇧+TAB",
    "⇧+←",
    "⇧+↑",
    "⇧+⇥",
    "⇧+↩",
    "⇧+⎋",
    "⇧+⌫",
    "⇧+<space>",
    "⇧+f0",
    "⇧+f1",
    "⇧+f9",
    "⇧+f12",
    "⇧+f13",
    "⇧+f20",
    "⇧+f21",
    "⇧+F5",
    "⇧+insert",
    "⇧+",
    "⇧+ ",
    "⇧+ab",
    "opt+a",
    "opt+b",
    "opt+c",
    "opt+x",
    "opt+y",
    "opt+z",
    "opt+A",
    "opt+Z",
    "opt+0",
    "opt+1",
    "opt+9",
    "opt+,",
    "opt+."
  ],
  "when": [
    "codeEditorFocused && diffViewerFocused && markdownReadOnlyFocused",
    "markdownEditorFocused",
    "diffViewerFocused || textInputFocus",
    "textInputFocus&&textBoxFocused&&omnibarFocused",
    "(diffViewerFocused || markdownReadOnlyFocused) && diffViewerFocused",
    "browserFocused&&true",
    "(textInputFocus) && diffViewerFocused",
    "terminalFocused && codeEditorFocused && surfaceKind in panes",
    "markdownEditorFocused && resourceScheme =~ /^file$/i",
    "resourceScheme =~ /^file$/i&&surfaceKind not in panes",
    "!!markdownEditorFocused&&!textInputFocus&&textInputFocus",
    "(terminalFocused || resourceScheme =~ /^file$/i || !textInputFocus)",
    "diffViewerFocused && omnibarFocused && terminalFocused",
    "omnibarFocused || textInputFocus",
    "resourceScheme =~ /^file$/i || true || !textInputFocus",
    "resourceScheme =~ /^file$/i",
    "surfaceKind == 'diff' && diffViewerFocused && markdownEditorFocused",
    "!textInputFocus&&true",
    "terminalFocused",
    "markdownReadOnlyFocused",
    "surfaceKind not in panes",
    "(codeEditorFocused&&diffViewerFocused&&!textInputFocus) || markdownReadOnlyFocused",
    "!textInputFocus",
    "markdownEditorFocused",
    "codeEditorFocused&&surfaceKind in panes",
    "!textInputFocus",
    "!textInputFocus || textBoxFocused || omnibarFocused",
    "false&&resourceScheme =~ /^file$/i",
    "markdownReadOnlyFocused && terminalFocused && omnibarFocused",
    "textInputFocus || agentPaneFocused || terminalFocused",
    "surfaceKind not in panes && markdownReadOnlyFocused",
    "terminalFocused"
  ]
}
