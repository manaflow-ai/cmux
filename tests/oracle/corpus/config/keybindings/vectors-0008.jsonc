{
  "strokes": [
    "shift+uparrow",
    "shift+arrowdown",
    "shift+downarrow",
    "shift+arrowright",
    "shift+rightarrow",
    "shift+Left",
    "shift+TAB",
    "shift+←",
    "shift+↑",
    "shift+⇥",
    "shift+↩",
    "shift+⎋",
    "shift+⌫",
    "shift+<space>",
    "shift+f0",
    "shift+f1",
    "shift+f9",
    "shift+f12",
    "shift+f13",
    "shift+f20",
    "shift+f21",
    "shift+F5",
    "shift+insert",
    "shift+",
    "shift+ ",
    "shift+ab",
    "⇧+a",
    "⇧+b",
    "⇧+c",
    "⇧+x",
    "⇧+y",
    "⇧+z",
    "⇧+A",
    "⇧+Z",
    "⇧+0",
    "⇧+1",
    "⇧+9",
    "⇧+,",
    "⇧+.",
    "⇧+/",
    "⇧+\\",
    "⇧+;",
    "⇧+'",
    "⇧+`",
    "⇧+-",
    "⇧+=",
    "⇧+[",
    "⇧+]",
    "⇧++",
    "⇧+é",
    "⇧+ß",
    "⇧+left",
    "⇧+right",
    "⇧+up",
    "⇧+down",
    "⇧+tab",
    "⇧+return",
    "⇧+enter",
    "⇧+escape",
    "⇧+esc",
    "⇧+delete",
    "⇧+backspace",
    "⇧+space",
    "⇧+spacebar"
  ],
  "when": [
    "codeEditorFocused",
    "textInputFocus && terminalFocused && diffViewerFocused",
    "(markdownReadOnlyFocused || true) || markdownReadOnlyFocused",
    "textInputFocus || surfaceKind == 'diff'",
    "(textBoxFocused&&agentPaneFocused&&surfaceKind in panes)",
    "markdownEditorFocused",
    "(markdownEditorFocused&&markdownReadOnlyFocused&&surfaceKind in panes) || markdownReadOnlyFocused",
    "resourceScheme =~ /^file$/i",
    "terminalFocused",
    "markdownEditorFocused&&markdownReadOnlyFocused&&diffViewerFocused",
    "resourceScheme =~ /^file$/i",
    "diffViewerFocused &&",
    "(false&&diffViewerFocused&&surfaceKind == 'diff')",
    "(resourceScheme =~ /^file$/i&&true) || markdownReadOnlyFocused",
    "false",
    "surfaceKind in panes",
    "surfaceKind == 'diff'",
    "surfaceKind in panes && codeEditorFocused && browserFocused",
    "false && resourceScheme =~ /^file$/i && diffViewerFocused",
    "(true&&surfaceKind in panes",
    "(markdownReadOnlyFocused && omnibarFocused) && diffViewerFocused",
    "(browserFocused&&resourceScheme =~ /^file$/i&&true",
    "true && surfaceKind == 'diff'",
    "diffViewerFocused",
    "diffViewerFocused",
    "!textInputFocus&&resourceScheme =~ /^file$/i&&surfaceKind == 'diff'",
    "textInputFocus && markdownEditorFocused",
    "(textInputFocus&&surfaceKind == 'diff') || markdownReadOnlyFocused",
    "markdownEditorFocused",
    "surfaceKind in panes && terminalFocused",
    "!!(surfaceKind in panes&&surfaceKind not in panes&&terminalFocused)",
    "!agentPaneFocused && false && codeEditorFocused"
  ]
}
