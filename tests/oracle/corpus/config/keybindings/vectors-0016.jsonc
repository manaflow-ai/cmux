{
  "strokes": [
    "ctrl+pagedown",
    "ctrl+plus",
    "ctrl+equals",
    "ctrl+comma",
    "ctrl+period",
    "ctrl+dot",
    "ctrl+slash",
    "ctrl+backslash",
    "ctrl+semicolon",
    "ctrl+quote",
    "ctrl+apostrophe",
    "ctrl+backtick",
    "ctrl+grave",
    "ctrl+minus",
    "ctrl+hyphen",
    "ctrl+leftbracket",
    "ctrl+openbracket",
    "ctrl+rightbracket",
    "ctrl+closebracket",
    "ctrl+arrowleft",
    "ctrl+leftarrow",
    "ctrl+arrowup",
    "ctrl+uparrow",
    "ctrl+arrowdown",
    "ctrl+downarrow",
    "ctrl+arrowright",
    "ctrl+rightarrow",
    "ctrl+Left",
    "ctrl+TAB",
    "ctrl+←",
    "ctrl+↑",
    "ctrl+⇥",
    "ctrl+↩",
    "ctrl+⎋",
    "ctrl+⌫",
    "ctrl+<space>",
    "ctrl+f0",
    "ctrl+f1",
    "ctrl+f9",
    "ctrl+f12",
    "ctrl+f13",
    "ctrl+f20",
    "ctrl+f21",
    "ctrl+F5",
    "ctrl+insert",
    "ctrl+",
    "ctrl+ ",
    "ctrl+ab",
    "control+a",
    "control+b",
    "control+c",
    "control+x",
    "control+y",
    "control+z",
    "control+A",
    "control+Z",
    "control+0",
    "control+1",
    "control+9",
    "control+,",
    "control+.",
    "control+/",
    "control+\\",
    "control+;"
  ],
  "when": [
    "(resourceScheme =~ /^file$/i && diffViewerFocused && surfaceKind == 'diff') || markdownReadOnlyFocused",
    "(!textInputFocus || markdownEditorFocused || omnibarFocused)",
    "agentPaneFocused&&codeEditorFocused&&surfaceKind in panes",
    "(omnibarFocused && codeEditorFocused)",
    "false || surfaceKind not in panes || diffViewerFocused",
    "!textInputFocus",
    "markdownEditorFocused",
    "markdownReadOnlyFocused && textBoxFocused && !textInputFocus",
    "surfaceKind in panes && markdownEditorFocused && textInputFocus",
    "codeEditorFocused&&surfaceKind in panes&&textInputFocus",
    "(terminalFocused) && diffViewerFocused",
    "!omnibarFocused || textBoxFocused",
    "!textInputFocus",
    "",
    " ",
    "&&",
    "()",
    "diffViewerFocused && textInputFocus",
    "diffViewerFocused||textInputFocus"
  ]
}
