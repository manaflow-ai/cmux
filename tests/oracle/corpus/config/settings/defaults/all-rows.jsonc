{
  "history": {
    "terminalCommands": false,
    "commandRetentionDays": 30,
    "closed": {
      "maxGroups": 0,
      "maxAgeDays": 0
    }
  },
  "navigation": {
    "historyScope": "workspace",
    "history": {
      "scope": "workspaces"
    }
  },
  "window": {
    "titlebar": "minimal",
    "titlebarButtons": "hover",
    "trafficLightClearance": 72
  },
  "app": {
    "globalHotKey": false,
    "startAgentGlobalHotKey": false,
    "hideDockIconWithoutWindows": true,
    "warnBeforeClosingTab": true,
    "warnBeforeClosingAgentSession": true,
    "quitBehavior": "ask",
    "uiScale": 1
  },
  "tabs": {
    "newTabTemplate": "minimal",
    "terminalFirst": false,
    "newTabPosition": "afterCurrent",
    "plusButton": "hover",
    "barPosition": "top",
    "barOrder": "aboveToolbar",
    "toolbarButtons": [],
    "overflow": "shrink",
    "cmdWClosesPinnedTabs": true,
    "swapCmdTAndCmdN": false,
    "commandDigits": "workspaces",
    "newTabNowPlaying": false,
    "newTabWidgets": {
      "greeting": false,
      "projects": false,
      "actions": false,
      "chats": false,
      "styleDots": false,
      "weather": false,
      "weatherCity": "",
      "machines": false,
      "clock": false,
      "timer": false,
      "warmGreeting": false,
      "quote": false,
      "order": [
        "projects",
        "actions",
        "chats"
      ]
    }
  },
  "browser": {
    "toolbarPosition": "top",
    "toolbarButtons": [
      "media",
      "zoom",
      "downloads"
    ],
    "defaultEngine": "chromium",
    "siteEngines": {
      "amazon.com/gp/video": "webkit",
      "disneyplus.com": "webkit",
      "hulu.com": "webkit",
      "max.com": "webkit",
      "music.apple.com": "webkit",
      "netflix.com": "webkit",
      "primevideo.com": "webkit",
      "spotify.com": "webkit",
      "tv.apple.com": "webkit"
    },
    "newTabPage": "",
    "showBookmarksBar": false,
    "showAgentCursor": true,
    "agentMouse": {
      "motion": "human",
      "maxMoveMs": 350
    },
    "builtInAdBlocker": true,
    "hibernation": "moderate",
    "hibernationExclusions": [],
    "hibernatePinnedTabs": false,
    "freezeHiddenTabs": 30,
    "keepNeighborTabsAwake": 1,
    "remoteLocalhost": true,
    "searchEngine": "google",
    "customSearchEngine": {
      "search": "",
      "suggest": ""
    },
    "omnibar": {
      "remoteSuggestions": true,
      "inlineAutocomplete": true,
      "maxRows": 8,
      "calculator": true,
      "showFullURLs": false,
      "glass": "off",
      "glassTint": "background",
      "glassTintStrength": 0.35,
      "cornerRadius": "theme",
      "shadow": false,
      "backgroundOpacity": 0
    },
    "links": {
      "cmdClick": "linkPlacement",
      "cmdShiftClick": "foregroundTab",
      "shiftClick": "newWindow",
      "optionClick": "download",
      "middleClick": "backgroundTab"
    },
    "enabled": true,
    "openLinksInCmuxBrowser": true,
    "openTerminalLinksInCmuxBrowser": true,
    "hostsToOpenInEmbeddedBrowser": [],
    "urlsToAlwaysOpenExternally": [],
    "passwords": {
      "offerToSave": true,
      "generate": true,
      "allowExport": false
    },
    "verificationAutofill": {
      "enabled": false
    },
    "toolbar": {
      "back": true,
      "forward": true,
      "reload": true,
      "home": false,
      "extensions": true,
      "downloads": true,
      "media": true,
      "profile": true,
      "menu": true
    }
  },
  "newTerminal": {
    "opensWorkspace": false
  },
  "layout": {
    "defaultColumnWidth": 0.5,
    "centerFocusedColumn": "never",
    "stripScrollbar": "system",
    "closeFocus": "previousNeighbor",
    "splitSizing": "even",
    "newColumnWidth": "matchCurrent",
    "dockColumnEdge": "nearest",
    "dockColumnMode": "docked",
    "frameOrientation": "columnMajor",
    "rows": true,
    "focusFollowsMouse": false,
    "scrollAreas": false,
    "scrollModifier": "command",
    "minimumPaneWidth": 200,
    "minimumPaneHeight": 64,
    "newPanePlacement": "tab",
    "tileBrowsers": false,
    "linkPlacement": "split-right",
    "mainPane": "agent-chats",
    "paneBorder": "subtle",
    "stripMargin": 0,
    "columnWidthPresets": [
      1,
      0.6667,
      0.5,
      0.3333
    ]
  },
  "shortcuts": {
    "showModifierHoldHints": true
  },
  "updates": {
    "channel": "nightly",
    "checkAutomatically": true,
    "checkIntervalSeconds": 3600,
    "downloadAutomatically": true,
    "meteredNetwork": "defer-low-data",
    "web": "every-merge",
    "installOnQuit": true,
    "notify": "badge",
    "keepPreviousVersions": 1,
    "showWhatsNew": true,
    "idleInstallMaxWaitSeconds": 900,
    "idleInstallQuietSeconds": 60
  },
  "announcements": {
    "enabled": true,
    "fetch": true
  },
  "computerUse": {
    "enabled": false,
    "driver": "legacy"
  },
  "freeModel": {
    "enabled": true
  },
  "sessions": {
    "keepAwake": "pluggedIn",
    "resumeAgents": true,
    "allowFullAccess": true,
    "promptSuggestions": true
  },
  "phone": {
    "allowConnections": false,
    "startSessions": true,
    "keepAwake": "pluggedIn",
    "cloudReplica": false
  },
  "appearance": {
    "machineColors": {},
    "appTheme": "followTerminal",
    "themeEdits": {},
    "accent": "neutral",
    "backdropArt": "none",
    "background": "none",
    "backgroundRotation": "daily",
    "paneBackgrounds": "shared",
    "experimentalControls": false,
    "inactiveWindowDim": 0,
    "glassTransparency": 0,
    "hue": 0.5,
    "saturation": 1,
    "density": "compact",
    "customDensities": [],
    "borders": "default",
    "focusIndicator": "tabs",
    "chromeStyle": "flat-sidebar-line",
    "statusIndicator": {
      "style": "arc",
      "animation": "animated",
      "size": 1,
      "thickness": 1.5,
      "showAgentWorkingOnTabs": true,
      "showPageLoading": true,
      "honorStatusStyle": true
    },
    "sidebarSurface": "same",
    "colorTransition": {
      "enabled": true,
      "duration": 200,
      "curve": "easeOut",
      "springResponse": 0.3,
      "springDamping": 1,
      "bezierX1": 0.42,
      "bezierY1": 0,
      "bezierX2": 0.58,
      "bezierY2": 1,
      "colorSpace": "oklab",
      "reduceMotion": "crossfade"
    }
  },
  "agents": {
    "subsessions": {
      "enabled": true,
      "answerQuestions": false,
      "maxChildren": 50,
      "maxDepth": 10
    },
    "trust": {
      "autoTrust": false,
      "projectRoots": [],
      "ownOrgs": []
    },
    "chats": {
      "enabled": true,
      "discovery": true,
      "roots": []
    },
    "defaultPermissionMode": "fullAccess"
  },
  "mobile": {
    "allowIPhoneConnections": false,
    "terminalSizing": "smallest",
    "terminalSizingOrder": []
  },
  "workspaces": {
    "newPlacement": "top",
    "autoName": true
  },
  "sidebar": {
    "groupByComputer": false,
    "border": false,
    "sectionLook": "quiet",
    "topBandMaxShare": 0.3333333333333333,
    "bottomBandMaxShare": 0.25,
    "pinnedBandsScroll": true,
    "showWorkspaceTabs": false,
    "showChats": true,
    "sessionTree": false,
    "showProjects": true,
    "groupBy": "none",
    "showSpaces": true,
    "showProfileControl": true,
    "showSearchButton": true,
    "minimal": false,
    "style": "standard",
    "density": "compact",
    "detailedStatusIcons": false,
    "showTimestamps": false,
    "showColors": true,
    "showLocalMachine": false,
    "groupHeader": {
      "memberCount": false,
      "unreadCount": false
    },
    "minimalMode": "off",
    "cards": {
      "tips": true
    },
    "priorityView": {
      "enabled": false,
      "shown": true
    },
    "side": "left",
    "spacesPosition": "bottom",
    "spacesVisibility": "hover",
    "numbering": "allItems",
    "cmd9": "last",
    "stepping": "allItems",
    "steppingWraps": true,
    "hoverCards": {
      "enabled": true,
      "delay": 250,
      "layout": "timeline",
      "sections": {
        "timings": true,
        "prompts": true,
        "waiting": true,
        "git": true,
        "ports": true
      },
      "maxRows": 20,
      "groups": {
        "workspaceGroups": true,
        "tabGroups": true,
        "delay": 600,
        "order": "status",
        "maxMembers": 8,
        "sections": {
          "status": true,
          "members": true,
          "activity": true,
          "git": true,
          "ports": true
        }
      }
    },
    "nowPlaying": {
      "enabled": false,
      "otherApps": false
    },
    "workspaceRow": {
      "icon": true,
      "directory": false,
      "branch": false,
      "process": false,
      "agentStatus": false,
      "tabCount": false,
      "ports": false,
      "lastActivity": false,
      "pullRequest": false,
      "progress": true,
      "working": true,
      "log": false,
      "notification": false,
      "secondLineOrder": [
        "notification",
        "directory",
        "branch",
        "process",
        "agentStatus",
        "ports",
        "lastActivity"
      ]
    },
    "workspaceIcons": {}
  },
  "palette": {
    "scopes": {
      "tabs": {
        "prefix": "@"
      },
      "workspaces": {
        "prefix": "#"
      },
      "commands": {
        "prefix": ">"
      },
      "settings": {
        "prefix": ","
      },
      "scopes": {
        "prefix": "?"
      }
    },
    "aliases": {},
    "pins": []
  },
  "picker": {
    "pinned": []
  },
  "screenshots": {
    "findTools": true,
    "folders": []
  },
  "tasks": {
    "layout": "inbox"
  },
  "ui": {
    "reducedBackgrounds": false,
    "animationSpeed": "fast",
    "paneAnimations": true,
    "animations": {
      "newTab": true,
      "newWorkspace": true,
      "bounce": "none",
      "enabled": true,
      "sidebar": true,
      "tabs": true,
      "panes": true,
      "overlays": true,
      "hoverCards": true,
      "home": true,
      "cursor": true,
      "indicators": true,
      "feedback": true,
      "web": true
    },
    "calm": "off"
  },
  "focus": {
    "inactiveTabStyle": "fade"
  },
  "focusRing": {
    "enabled": false,
    "style": "ring",
    "contrast": "subtle",
    "width": 1,
    "showWhenSinglePane": false
  },
  "status": {
    "inferCommandBusy": false,
    "inferCommandBusyAfter": 3,
    "runNotifyMinimumSeconds": 10,
    "runNotifyWhenVisible": false
  },
  "diff": {
    "layout": "auto",
    "diffIndicators": "bars",
    "colors": "theme",
    "wordWrap": false,
    "wordDiffs": true,
    "lineNumbers": true,
    "showBackgrounds": true,
    "expandUnchanged": false,
    "groupByKind": false,
    "hideWhitespace": false,
    "showBulkActions": true
  },
  "markdown": {
    "remoteImages": false,
    "layout": {
      "width": 72,
      "fullWidth": false
    },
    "font": {
      "size": 16,
      "preset": "system",
      "lineHeight": 1.6
    },
    "spacing": {
      "paragraph": 1
    },
    "code": {
      "scale": 0.875
    },
    "tables": "scroll",
    "theme": "app"
  },
  "agentPane": {
    "display": {
      "width": 800,
      "fullWidth": false,
      "font": {
        "preset": "markdown",
        "size": 14,
        "lineHeight": 1.625
      },
      "inspector": {
        "placement": "overlay"
      }
    },
    "links": {
      "outsideRoots": "open"
    },
    "images": {
      "remote": "click"
    },
    "needsYou": {
      "enabled": false
    },
    "editedFiles": {
      "show": "always",
      "maxRows": 5,
      "scope": "turn"
    },
    "showContextUsage": true,
    "showDictation": true,
    "spellChecking": false,
    "zoom": 1
  },
  "terminal": {
    "linkOpener": {
      "default": "cmux",
      "rules": []
    }
  },
  "editor": {
    "fontWeight": "normal",
    "fontLigatures": false,
    "lineHeight": 0,
    "letterSpacing": 0,
    "tabSize": 4,
    "insertSpaces": true,
    "detectIndentation": true,
    "wordWrap": "off",
    "wordWrapColumn": 80,
    "lineNumbers": "on",
    "rulers": [],
    "minimap": {
      "enabled": false
    },
    "renderWhitespace": "selection",
    "renderControlCharacters": true,
    "renderLineHighlight": "line",
    "bracketPairColorization": {
      "enabled": true
    },
    "guides": {
      "bracketPairs": false,
      "indentation": true
    },
    "matchBrackets": "always",
    "stickyScroll": {
      "enabled": true
    },
    "folding": true,
    "scrollBeyondLastLine": false,
    "smoothScrolling": false,
    "mouseWheelZoom": false,
    "cursorStyle": "line",
    "cursorBlinking": "blink",
    "cursorSmoothCaretAnimation": "off",
    "cursorSurroundingLines": 0,
    "multiCursorModifier": "alt",
    "autoClosingBrackets": true,
    "autoClosingQuotes": true,
    "linkedEditing": false,
    "quickSuggestions": false,
    "wordBasedSuggestions": true,
    "acceptSuggestionOnEnter": "on",
    "emptySelectionClipboard": true,
    "find": {
      "seedSearchStringFromSelection": "always"
    },
    "autoSave": "afterDelay",
    "autoSaveDelay": 1000,
    "trimTrailingWhitespace": false,
    "insertFinalNewline": false,
    "formatOnSave": false,
    "importFrom": "auto"
  },
  "media": {
    "pictureInPicture": {
      "enabled": true
    }
  },
  "files": {
    "textEditor": ""
  },
  "home": {
    "server": "hosted",
    "chiefBubbleStyle": "imessage",
    "attachments": {
      "keepLocation": false
    },
    "channelsEnabled": false,
    "chiefPetEnabled": false,
    "chiefPetMascot": "orb"
  },
  "chief": {
    "reactionsCanWake": true,
    "reactionClassifier": {
      "harness": "",
      "model": "claude-haiku-5-5",
      "prompt": ""
    }
  },
  "notifications": {
    "dismissal": "click",
    "timeoutSeconds": 30,
    "desktop": "unlessFocused",
    "sound": "default",
    "suppressWhileTypingSeconds": 0,
    "dockBadge": true,
    "dockBounce": "once",
    "showPreviews": "whenUnlocked",
    "attention": {
      "style": "steady",
      "terminals": "glow",
      "agentChats": "none",
      "agentChatBlinkCount": 1,
      "width": 2,
      "blinkCount": 2,
      "duration": 3,
      "persist": true,
      "flash": true,
      "flashOnTyping": true,
      "showOnTab": true,
      "showOnSidebar": true,
      "moveToTop": false
    },
    "mutedWorkspaces": []
  },
  "feed": {
    "mirrorNotifications": {
      "agents": true,
      "terminal": "off"
    },
    "agentPermissionPrompts": false,
    "github": {
      "enabled": false,
      "pollIntervalSeconds": 120
    }
  },
  "labs": {
    "previewFeatures": false,
    "classicHome": false
  },
  "diagnostics": {
    "hangReports": false
  },
  "macScreen": {
    "systemShortcuts": false,
    "debug": {
      "relayOnly": false
    }
  },
  "deviceHub": {
    "url": ""
  }
}
