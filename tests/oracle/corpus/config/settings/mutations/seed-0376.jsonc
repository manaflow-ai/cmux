{
    "sidebar": {
        "workspaceRow": {
            "browser": {
                "directory": "true"
            },
            "agent": {
                "progress": true
            },
            "secondLineOrder": [1]
        }
    },
    "appearance": {
        "colorTransition": {
            "bezierX2": 1
        },
        "surfaces": {
            "browserChrome": {
                "color": "red"
            }
        }
    },
    "home": {
        "chiefPetEnabled": true
    },
    "terminal": {
        "linkOpener": {
            "default": 1
        }
    },
    "browser": {
        "toolbar": {
            "downloads": true
        },
        "customSearchEngine": {
            "suggest": "https://search.example/?q=%s"
        }
    },
    "workspaces": {
        "newPlacement": 1
    },
    "editor": {
        "wordWrapColumn": 505
    }
}
