{
    "markdown": {
        "code": {
            "blockSize": 8
        }
    },
    "editor": {
        "cursorStyle": 1,
    },
    "appearance": {
        "colorTransition": {
            "bezierX2": "1"
        },
        "surfaces": {
            "terminal": {
                "opacity": 0,
            },
        },
    },
    "window": {
        "titlebarButtons": "hover",
    },
    "sidebar": {
        "workspaceRow": {
            "agent": {
                "progress": false,
                "directory": null,
            },
            "browser": {
                "branch": null
            },
            "working": "true",
        }
    },
    "tabs": {
        "barPosition": "__not_a_choice__",
        "newTabWidgets": {
            "styleDots": 1
        }
    },
    "home": {
        "chiefPetEnabled": true
    },
    "oracleUnknown": {
        "nested": {
            "key": [true],
        }
    },
}
