{
	"browser": {
		"freezeHiddenTabs": 3600,
		"toolbar": {
			"reload": null,
			// a { brace
"reload": 10E-1
		}
	},
	// note
"sidebar": {
		"workspaceRow": {
			/* block */ "agent": {
				"icon": 1e0
			},
			// "quoted"
"terminal": {
				"secondLineOrder": 0,
				"secondLineOrder": "notification"
			}
		},
		/* block */ "hoverCards": {
			"sections": {
				"prompts": true
			}
		},
		"style": true
	},
	// url: https://localhost/x
"editor": {
		"wordWrap": true
	},
	/* // inside */ "layout": {
		"splitSizing": 1e0
	}
}
