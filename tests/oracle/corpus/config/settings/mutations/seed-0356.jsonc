{
    "sidebar": {
        "workspaceRow": {
            "agent": {
                "secondLineOrder": ["__not_a_choice__"],
                "pullRequest": true
            }
        },
        "hoverCards": {
            "groups": {
                "sections": {
                    "status": true
                }
            }
        }
    },
    "browser": {
        "omnibar": {
            "glass": "off"
        },
        "toolbar": {
            "back": true
        }
    },
    "feed": {
        "mirrorNotifications": {
            "agents": null
        }
    },
    "palette": {
        "scopes": {
            "scopes": {
                "prefix": "."
            }
        }
    },
    "editor": {
        "detectIndentation": false
    },
    "oracleUnknown": {
        "nested": {
            "key": "x"
        }
    }
}
