{
  "sidebar": {
    /* {"k": 1} */ "workspaceRow": {
      // note
"browser": {
        /* // inside */ "working": true
      },
      // a { brace
"mixed": {
        "ports": null
      }
    },
    "showProfileControl": true
  },
  "agents": {
    "chats": {
      "enabled": true
    }
  },
  "terminal": {
    /* {"k": 1} */ "fontFamily": true
  },
  "browser": {
    "hibernationExclusions": ["localhost", "*.example.com"],
    "passwords": {
      /* // inside */ "offerToSave": true
    }
  },
  "markdown": {
    /* * */ "remoteImages": false
  },
  "appearance": {
    "appTheme": true,
    // a { brace
"metrics": {
      "tabMinActiveWidth": 6080E-1
    }
  },
  // a { brace
"notifications": {
    "sources": {
      "terminal": {
        "dismissal": "focus"
      }
    },
    "attention": {
      "color": 0.0
    }
  }
}
