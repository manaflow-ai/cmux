{
	// a { brace
"feed": {
		/* // inside */ "agentPermissionPrompts": null
	},
	// "quoted"
"sidebar": {
		"workspaceRow": {
			"mixed": {
				"secondLineOrder": [1]
			},
			"agent": {
				"secondLineOrder": ["lastActivity", "ports", "agentStatus", "process", "branch", "directory", "notification"]
			}
		},
		"numbering": "__not_a_choice__"
	},
	"browser": {
		// url: https://localhost/x
"hostsToOpenInEmbeddedBrowser": ["localhost", "*.example.com"],
		"hibernation": "off"
	},
	// a { brace
"layout": {
		"splitSizing": "halve"
	},
	"notifications": {
		"attention": {
			"blinkCount": 19
		}
	},
	"appearance": {
		"colorTransition": {
			"springResponse": 0.3
		},
		"accent": "blue"
	}
}
