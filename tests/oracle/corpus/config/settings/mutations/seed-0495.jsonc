{
	"ui": {
		/* block */ "animations": {
			"overlays": "true"
		},
	},
	"layout": {
		// url: https://localhost/x
"frameOrientation": "columnMajor"
	},
	"appearance": {
		/* * */ "surfaces": {
			/* {"k": 1} */ "splitDivider": {
				// url: https://localhost/x
"opacity": 0.5,
			},
		},
		/* block */ "paneBackgrounds": "perPane",
	},
	/* // inside */ "feed": {
		"mirrorNotifications": {
			"terminal": "__not_a_choice__",
		},
	},
	"sidebar": {
		"density": "expanded"
	},
	"markdown": {
		"font": {
			"size": "1"
		}
	},
	// url: https://localhost/x
"editor": {
		"cursorSmoothCaretAnimation": 1e0,
	},
	"notifications": {
		"dismissal": "focus",
		/* block */ "desktop": "__not_a_choice__"
	},
	/* {"k": 1} */ "agents": {
		/* {"k": 1} */ "trust": {
			"ownOrgs": [1,],
		}
	},
}
