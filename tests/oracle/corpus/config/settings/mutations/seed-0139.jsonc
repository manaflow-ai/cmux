{
  "browser": "shadowed",
  "browser": {
    /* block */ "omnibox": {
      "color": "#1A2B3C80",
    },
    "openLinksInCmuxBrowser": null,
    "toolbar": null,
    "toolbar": {
      "forward": false
    }
  },
  "tabs": null,
  /* // inside */ "tabs": {
    "newTabPosition": "afterCurrent",
  },
  "home": {
    "chiefBubbleStyle": true,
  },
  "sidebar": {
    /* {"k": 1} */ "hoverCards": {
      "groups": "shadowed",
      // note
"groups": {
        "sections": {
          "activity": false,
        },
        "workspaceGroups": "shadowed",
        // a { brace
"workspaceGroups": true
      },
      /* * */ "sections": {
        "git": true,
      },
    },
    "workspaceRow": {
      "browser": "shadowed",
      /* * */ "browser": {
        "process": null
      },
    }
  },
  "appearance": 0,
  "appearance": {
    "metrics": {
      "sidebarWidth": 680
    }
  }
}
