{
    "editor": {
        "lineNumbers": true,
        "fontWeight": "normal"
    },
    "browser": {
        "hibernation": "__not_a_choice__"
    },
    "sidebar": {
        "cards": {
            "tips": true,
        },
    },
    "notifications": {
        "dismissal": "click",
    },
    "ui": {
        "animations": {
            "home": true
        },
    },
    "layout": {
        "columnWidthPresets": ["1",],
        "closeFocus": 10E-1
    },
}
