{
  // a { brace
"layout": {
    "linkPlacement": "__not_a_choice__"
  },
  // note
"editor": {
    "smoothScrolling": 1e0,
    "trimTrailingWhitespace": null
  },
  "browser": {
    "showAgentCursor": null,
    "toolbar": {
      "menu": true
    }
  },
  /* // inside */ "status": {
    // note
"inferCommandBusy": 1
  },
  "sidebar": {
    "hoverCards": {
      "groups": {
        "sections": {
          "git": "true"
        }
      }
    }
  },
  // "quoted"
"sessions": {
    "promptSuggestions": "true"
  },
  "media": {
    // url: https://localhost/x
"pictureInPicture": {
      "enabled": false
    }
  },
  "notifications": {
    "attention": {
      // url: https://localhost/x
"terminals": "glow"
    }
  }
}
