{
	"home": {
		"attachments": {
			// "quoted"
"keepLocation": false,
		},
	},
	// url: https://localhost/x
"sidebar": {
		// url: https://localhost/x
"workspaceRow": {
			/* // inside */ "branch": 1,
			/* {"k": 1} */ "browser": {
				"process": true,
			},
		},
	},
	"editor": {
		"linkedEditing": 1,
		// note
"renderControlCharacters": true,
	},
	"ui": {
		"animations": {
			"overlays": "true",
			// a { brace
"sidebar": true,
		},
	},
	"notifications": {
		"attention": {
			"flashOnTyping": null,
		},
		/* // inside */ "dismissal": "click",
	},
	// url: https://localhost/x
"focus": {
		/* * */ "inactiveTabStyle": true,
	},
	// note
"oracleUnknown": {
		/* {"k": 1} */ "nested": {
			"key": "x"
		},
	}
}
