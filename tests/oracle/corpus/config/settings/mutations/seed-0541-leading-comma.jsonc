{,
  "agentPane": {
    "editedFiles": {
      "show": "never"
    }
  },
  "browser": {
    "omnibar": {
      "maxRows": "1"
    },
    "agentMouse": {
      "motion": "human"
    }
  },
  "tabs": {
    "newTabPosition": "end"
  },
  "navigation": {
    "history": {
      "scope": "__not_a_choice__"
    }
  },
  "editor": {
    "minimap": {
      "enabled": null
    }
  },
  "sidebar": {
    "workspaceRow": {
      "mixed": {
        "directory": "true",
        "notification": false
      }
    },
    "hoverCards": {
      "sections": {
        "timings": false
      }
    }
  },
  "notifications": {
    "attention": {
      "style": "__not_a_choice__"
    }
  },
  "ui": {
    "animations": {
      "hoverCards": "true"
    }
  }
}
