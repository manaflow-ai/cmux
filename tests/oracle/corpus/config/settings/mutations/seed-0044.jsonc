{
    "feed": {
        /* {"k": 1} */ "mirrorNotifications": {
            // url: https://localhost/x
"terminal": "full"
        }
    },
    "layout": {
        "rows": true,
        "scrollAreas": false
    },
    "computerUse": {
        "enabled": false
    },
    "sidebar": {
        "workspaceRow": {
            /* {"k": 1} */ "mixed": {
                // a { brace
"directory": null
            }
        }
    },
    "appearance": {
        // note
"surfaces": {
            /* * */ "agentPane": {
                "color": "#12345g"
            }
        },
        /* // inside */ "metrics": {
            "titlebarHeight": 40
        }
    },
    "tabs": {
        "newTabWidgets": {
            // "quoted"
"greeting": "true"
        }
    },
    "markdown": {
        "layout": {
            /* {"k": 1} */ "width": -940
        }
    },
    // note
"phone": {
        "keepAwake": "always"
    },
    /* * */ "oracleUnknown": {
        "nested": {
            "key": [true]
        }
    }
}
