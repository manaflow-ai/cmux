{
    "sidebar": {
        "workspaceRow": {
            "browser": {
                "secondLineOrder": ["lastActivity", "ports", "agentStatus", "process", "branch", "directory", "notification"]
            },
            "agent": {
                "working": "true"
            }
        },
        "workspaceIcons": []
    },
    "appearance": {
        "colorTransition": {
            "colorSpace": "oklab",
            "enabled": null
        }
    },
    "layout": {
        "linkPlacement": true
    },
    "editor": {
        "insertSpaces": true
    },
    "agents": {
        "chats": {
            "discovery": 1
        },
        "trust": {
            "projectRoots": "/Users/ada/src"
        }
    },
    "tabs": {
        "plusButton": true
    },
    "markdown": {
        "tables": "scroll",
        "layout": {
            "fullWidth": 1
        }
    }
}
