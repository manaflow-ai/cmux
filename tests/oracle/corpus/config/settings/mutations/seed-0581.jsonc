{
    "notifications": 0,
    "notifications": {
        "attention": "shadowed",
        // a { brace
"attention": {
            "terminals": null,
            "terminals": "glow"
        }
    },
    // note
"browser": {
        // "quoted"
"newTabPage": "localhost",
        /* * */ "builtInAdBlocker": true
    },
    "editor": {
        "cursorBlinking": "phase"
    },
    "mobile": {
        "terminalSizing": "shadowed",
        "terminalSizing": "__not_a_choice__"
    },
    // url: https://localhost/x
"sidebar": {
        "workspaceRow": {
            "terminal": {
                "log": true
            }
        }
    },
    // url: https://localhost/x
"labs": {
        /* * */ "previewFeatures": null
    },
    "agentPane": {
        "display": {
            "inspector": {
                "placement": "__not_a_choice__"
            }
        }
    },
    "layout": null,
    "layout": {
        /* {"k": 1} */ "splitSizing": true
    }
}
