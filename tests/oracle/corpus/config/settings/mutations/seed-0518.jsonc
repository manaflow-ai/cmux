{
  "tabs": {
    "newTabWidgets": {
      "quote": 1,
      "chats": "true"
    }
  },
  "markdown": {
    "code": {
      "scale": -0.4
    }
  },
  "sidebar": {
    "workspaceRow": {
      "agent": {
        "tabCount": null
      }
    },
    "hoverCards": {
      "enabled": null
    }
  },
  "agentPane": {
    "editedFiles": {
      "show": "always"
    }
  },
  "layout": {
    "paneBorderColor": "#1A2B3C80"
  },
  "app": {
    "warnBeforeClosingAgentSession": null
  },
  "notifications": {
    "attention": {
      "flashOnTyping": null
    }
  },
  "diff": {
    "layout": "auto"
  }
}
