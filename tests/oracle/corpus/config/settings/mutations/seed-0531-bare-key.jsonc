			// url: https://localhost/x
"terminal": {
				/* * */ "secondLineOrder": [],
				// note
"notification": false
			},
			"browser": "shadowed",
			"browser": {
				"secondLineOrder": null,
				"secondLineOrder": []
			},
			"agent": {
				"notification": 0,
				// a { brace
"notification": 1
			}
		}
	},
	// "quoted"
"diff": {
		// "quoted"
"wordWrap": false
	},
	"palette": null,
	"palette": {
