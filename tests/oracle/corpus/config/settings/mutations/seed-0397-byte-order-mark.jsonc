{
  // url: https://localhost/x
"layout": {
    "stripMargin": 0,
    // "quoted"
"stripMargin": -40,
    "dockColumnMode": "__not_a_choice__"
  },
  // a { brace
"freeModel": {
    "enabled": true
  },
  "sidebar": {
    // note
"workspaceRow": {
      "browser": 0,
      /* // inside */ "browser": {
        // note
"pullRequest": null,
        "progress": true
      }
    },
    "showSearchButton": false
  },
  "agents": {
    "chats": {
      /* // inside */ "roots": ["/opt/cmux-chat-data"]
    }
  },
  "appearance": {
    "backdropArt": "degas-green-dancers"
  },
  "browser": {
    // note
"toolbar": {
      /* {"k": 1} */ "extensions": "true"
    }
  },
  /* block */ "diff": {
    "diffIndicators": "shadowed",
    /* * */ "diffIndicators": 1
  },
  /* block */ "focus": {
    /* block */ "inactiveTabStyle": "__not_a_choice__"
  },
  "terminal": {
    "linkOpener": {
      "default": null,
      "default": "cmux"
    }
  }
}
