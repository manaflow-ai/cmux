{
    "window": 0,
    "window": {
        // a { brace
"trafficLightClearance": 72e0,
    },
    "browser": {
        "omnibox": null,
        "omnibox": {
            /* block */ "color": "red",
        },
        "urlsToAlwaysOpenExternally": [""],
        /* {"k": 1} */ "openLinksInCmuxBrowser": false
    },
    /* // inside */ "sidebar": {
        /* block */ "numbering": 10E-1,
        "workspaceRow": {
            "agent": {
                "agentStatus": "shadowed",
                "agentStatus": 10E-1,
            }
        },
        "style": "standard"
    },
    "editor": 0,
    "editor": {
        "fontWeight": true,
    },
    /* * */ "oracleUnknown": {
        "nested": {
            // url: https://localhost/x
"key": "x",
        }
    },
}
