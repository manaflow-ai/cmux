{
	"status": {
		"runNotifyWhenVisible": true
	},
	"app": {
		"quitBehavior": "end-everything"
	},
	"appearance": {
		"colorTransition": {
			"reduceMotion": true
		},
		"surfaces": {
			"diff": {
				"opacity": 2.0
			},
			"sidebar": {
				"opacity": 1e0
			}
		},
		"metrics": {
			"tabMinActiveWidth": 320
		}
	},
	"tabs": {
		"newTabWidgets": {
			"greeting": false
		}
	},
	"workspaces": {
		"autoName": 1.0
	},
	"focusRing": {
		"color": "#1a2B3c"
	},
	"browser": {
		"omnibar": {
			"inlineAutocomplete": null
		}
	},
	"home": {
		"chiefBubbleStyle": "__not_a_choice__"
	},
	"sidebar": {
		"showWorkspaceTabs": false
	}
}
