{
	"notifications": {
		"quietHours": "22:00-07:00"
	},
	"markdown": {
		// a { brace
"remoteImages": 1
	},
	"browser": {
		// "quoted"
"defaultEngine": 1,
	},
	"editor": {
		"insertSpaces": "true",
	},
	"layout": {
		"focusFollowsMouse": null
	},
	"appearance": {
		// note
"surfaces": {
			// a { brace
"sidebar": {
				"color": "#1A2B3C80",
			},
		},
		/* block */ "chromeStyle": 1,
		"statusIndicator": {
			"thickness": -3
		},
		"metrics": {
			"titlebarHeight": "1"
		},
	},
	// note
"window": {
		/* {"k": 1} */ "titlebarButtons": "always"
	},
	// a { brace
"home": {
		// note
"chiefPetMascot": "orb",
	},
	"focusRing": {
		"showWhenSinglePane": true,
	}
}
