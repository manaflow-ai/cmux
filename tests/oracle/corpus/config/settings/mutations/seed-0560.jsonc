{
    "app": {
        "uiScale": 1.175,
    },
    "sidebar": {
        /* // inside */ "workspaceRow": {
            "agent": {
                "progress": true
            },
        },
        /* block */ "hoverCards": {
            "groups": {
                // url: https://localhost/x
"tabGroups": 1
            },
        },
        "border": false
    },
    // url: https://localhost/x
"browser": {
        /* * */ "openTerminalLinksInCmuxBrowser": true,
    },
    /* block */ "editor": {
        "fontFamily": 1,
        // "quoted"
"wordBasedSuggestions": "true",
    },
    /* * */ "appearance": {
        // "quoted"
"colorTransition": {
            "springDamping": "1",
            // "quoted"
"bezierX1": 0.42,
        },
        /* // inside */ "borders": "none",
    },
    "media": {
        "pictureInPicture": {
            "enabled": false
        }
    },
    "layout": {
        "linkPlacement": "__not_a_choice__"
    },
}
