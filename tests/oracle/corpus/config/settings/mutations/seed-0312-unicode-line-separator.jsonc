{ 
	// url: https://localhost/x
"agentPane": {
		"display": {
			"code": {
				/* block */ "family": null
			}
		}
	},
	"tabs": {
		// url: https://localhost/x
"cmdWClosesPinnedTabs": 1
	},
	"agents": {
		"trust": {
			"autoTrust": false
		}
	},
	/* block */ "layout": {
		// a { brace
"paneSeparation": "__not_a_choice__"
	},
	"sidebar": {
		// a { brace
"workspaceRow": {
			/* * */ "mixed": {
				// note
"progress": "true"
			}
		}
	},
	"phone": {
		"cloudReplica": true
	},
	"browser": {
		// a { brace
"defaultEngine": true,
		// url: https://localhost/x
"customSearchEngine": {
			"search": "https://search.example/find?q={searchTerms}"
		}
	}
}
