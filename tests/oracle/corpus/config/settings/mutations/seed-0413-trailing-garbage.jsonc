{
  /* block */ "tabs": {
    "swapCmdTAndCmdN": false
  },
  "appearance": {
    "statusIndicator": {
      "size": 2.5
    },
  },
  "sidebar": {
    "style": 10E-1,
    /* * */ "workspaceRow": {
      "browser": {
        "lastActivity": 1
      },
      // "quoted"
"agent": {
        "tabCount": null,
      }
    },
  },
  "notifications": {
    "attention": {
      "moveToTop": true,
    },
  },
  // a { brace
"browser": {
    "showAgentCursor": true,
    "links": {
      "cmdShiftClick": "linkPlacement"
    }
  }
}

}
