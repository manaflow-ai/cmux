{
    "appearance": {
        "glassTransparency": "1",
        "colorTransition": {
            "colorSpace": "__not_a_choice__"
        }
    },
    "layout": {
        "defaultColumnWidth": 0.55e0,
        "paneSeparation": "cards",
    },
    "browser": {
        "agentMouse": {
            "maxMoveMs": 1000
        },
        "defaultEngine": "chromium"
    },
    "markdown": {
        "font": {
            "lineHeight": 2.4,
        }
    },
    "notifications": {
        "attention": {
            "showOnTab": true
        }
    },
    "sidebar": {
        "hoverCards": {
            "maxRows": 50.5e0
        },
    }
}
