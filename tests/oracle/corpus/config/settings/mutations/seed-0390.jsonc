{
    "browser": {
        "passwords": {
            "allowExport": 1e0,
        },
        "links": {
            "middleClick": "download",
        }
    },
    "appearance": {
        "experimentalControls": 1.0,
        "surfaces": {
            "browserChrome": {
                // "quoted"
"opacity": 0.5e0,
            },
            "docks": {
                /* {"k": 1} */ "opacity": 1
            },
        }
    },
    "tabs": {
        // url: https://localhost/x
"barPosition": "top",
    },
    "notifications": {
        "attention": {
            "color": "1a2b3c",
        }
    },
    "sidebar": {
        "hoverCards": {
            "delay": 0,
            "maxRows": 199e0,
        },
        "showWorkspaceTabs": 1e0
    },
    // note
"editor": {
        "fontWeight": "__not_a_choice__",
    },
    "navigation": {
        "history": {
            "scope": 1e0
        }
    }
}
