{
  "browser": {
    // a { brace
"omnibar": {
      "cornerRadius": "1",
    },
    // "quoted"
"agentMouse": {
      "maxMoveMs": 5300E-1
    },
    // "quoted"
"toolbar": {
      // "quoted"
"back": "true"
    },
    // url: https://localhost/x
"passwords": {
      /* // inside */ "allowExport": false,
    }
  },
  // "quoted"
"sidebar": {
    "workspaceRow": {
      // "quoted"
"agent": {
        // url: https://localhost/x
"notification": null
      },
      "terminal": {
        "tabCount": null,
      },
    },
  },
  /* // inside */ "layout": {
    // note
"defaultColumnWidth": 0.55e0,
    // note
"paneBorder": "subtle"
  },
  /* block */ "editor": {
    "fontSize": 138e0
  },
  "notifications": {
    // note
"attention": {
      "duration": 59.7
    },
  }
,,}
