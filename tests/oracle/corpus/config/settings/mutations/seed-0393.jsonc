        "showBackgrounds": true,
    },
    "editor": {
        "autoClosingQuotes": true
    },
    "sidebar": {
        // a { brace
"workspaceRow": {
            "browser": {
                "branch": false
            },
            "agent": {
                /* block */ "agentStatus": null,
            }
        }
    },
}
