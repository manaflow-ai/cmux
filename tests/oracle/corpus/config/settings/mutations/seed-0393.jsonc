                "color": "#1234567"
            },
            // note
"settings": {
                "opacity": -1,
            }
        },
        "colorTransition": {
            "springResponse": 0.3,
        }
    },
    "browser": {
        "builtInAdBlocker": "true"
    },
    "ui": {
        "reducedBackgrounds": false
    },
    // note
