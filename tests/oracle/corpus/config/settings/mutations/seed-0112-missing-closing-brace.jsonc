{
	"browser": {
		// note
"builtInAdBlocker": "true"
	},
	"layout": {
		"centerFocusedColumn": "on-overflow",
		// url: https://localhost/x
"frameOrientation": true,
	},
	// note
"sidebar": {
		"workspaceRow": {
			"agent": {
				"working": true,
			},
		},
		"steppingWraps": "true"
	},
	/* * */ "markdown": {
		"layout": {
			"fullWidth": false
		}
	},
	/* // inside */ "terminal": {
		"fontSize": 4,
	},
	"appearance": {
		// note
"metrics": {
			/* {"k": 1} */ "columnGap": 24
		}
	},
	"editor": {
		"mouseWheelZoom": true,
	},

