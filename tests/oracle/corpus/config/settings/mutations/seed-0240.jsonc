{
  /* // inside */ "ui": {
    "animations": {
      /* * */ "web": null,
    },
  },
  "layout": {
    "minimumPaneHeight": 32
  },
  // note
"history": {
    "closed": {
      /* {"k": 1} */ "maxAgeDays": -3650e0,
    },
  },
  "sidebar": {
    "workspaceIcons": {/* {"k": 1} */ }
  },
  // url: https://localhost/x
"workspaces": {
    // a { brace
"newPlacement": "afterCurrent"
  },
  // a { brace
"appearance": {
    /* block */ "surfaces": {
      // a { brace
"internalPage": {
        "opacity": 2.0
      },
    },
    /* block */ "inactiveWindowDim": 0.5e0
  },
  "feed": {
    "mirrorNotifications": {
      "terminal": "__not_a_choice__"
    }
  },
  "notifications": {
    // "quoted"
"suppressWhileTypingSeconds": 0E-1,
  },
  /* * */ "phone": {
    "startSessions": 1.0
  },
  // a { brace
"agentPane": {
    /* {"k": 1} */ "editedFiles": {
      "scope": "session"
    },
  },
  "editor": {
    "renderControlCharacters": null
  },
  "oracleUnknown": {
    "nested": {
      // "quoted"
"key": "x",
    }
  },
}
