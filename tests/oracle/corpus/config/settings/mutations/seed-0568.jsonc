{
    "browser": {
        "toolbar": {
            "back": false
        }
    },
    "agents": {
        "subsessions": {
            "maxChildren": 500.5
        }
    },
    "diff": {
        "wordDiffs": true
    },
    "notifications": {
        "suppressWhileTypingSeconds": "1"
    },
    "chief": {
        "reactionClassifier": {
            "prompt": null
        }
    },
    "sidebar": {
        "workspaceIcons": {},
        "hoverCards": {
            "sections": {
                "prompts": null,
                "timings": false
            }
        }
    },
    "media": {
        "pictureInPicture": {
            "enabled": true
        }
    }
}
