{
	/* block */ "sidebar": {
		// note
"workspaceRow": {
			/* * */ "mixed": {
				// "quoted"
"working": "true"
			},
			"browser": {
				"log": null
			},
			"agent": "shadowed",
			/* // inside */ "agent": {
				"progress": true,
				/* block */ "directory": null
			}
		},
		"hoverCards": 0,
		/* // inside */ "hoverCards": {
			/* block */ "maxRows": 199
		}
	},
	"appearance": {
		"surfaces": {
			"docks": {
				"color": "shadowed",
				"color": "#12345g"
			}
		}
	},
	"browser": {
		"showBookmarksBar": 1
	},
	// url: https://localhost/x
"app": {
		"uiScale": 1.5
	}
}
