{
	"sidebar": {
		"workspaceRow": {
			"agent": {
				"process": 1
			},
			"browser": {
				"tabCount": 1
			}
		}
	},
	"browser": {
		// url: https://localhost/x
"toolbar": {
			/* {"k": 1} */ "media": "true"
		},
		// note
"hibernationExclusions": [1]
	},
	/* // inside */ "notifications": {
		"attention": {
			"flashOnTyping": "true"
		}
	},
	"layout": {
		"dockColumnEdge": "__not_a_choice__"
	},
	"appearance": {
		/* * */ "surfaces": {
			// url: https://localhost/x
"sidebar": {
				/* * */ "color": "#1a2B3c"
			}
		},
		"experimentalControls": 1,
		"colorTransition": {
			"curve": "easeOut"
		}
	},
	"editor": {
		/* block */ "stickyScroll": {
			// note
"enabled": "true"
		}
	},
	"agentPane": {
		// a { brace
"display": {
			/* {"k": 1} */ "fullWidth": "true"
		}
	},
	/* // inside */ "agents": {
		// note
"trust": {
			"projectRoots": "/Users/ada/src"
		}
	},
	/* * */ "oracleUnknown": {
		"nested": {
			/* block */ "key": [true]
		}
	}
}
