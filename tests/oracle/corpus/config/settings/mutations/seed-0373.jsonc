{
    "tabs": {
        /* * */ "commandDigits": "workspaces"
    },
    "sidebar": {
        "workspaceRow": {
            "agent": {
                /* block */ "pullRequest": 10E-1
            },
            "browser": {
                "agentStatus": "true"
            }
        },
        "nowPlaying": {
            "enabled": false
        },
        /* // inside */ "minimal": null,
        "workspaceIcons": {
            "Work": 1
        }
    },
    "ui": {
        // note
"reducedBackgrounds": true
    },
    /* block */ "notifications": {
        "attention": {
            // url: https://localhost/x
"style": true
        }
    }
}
