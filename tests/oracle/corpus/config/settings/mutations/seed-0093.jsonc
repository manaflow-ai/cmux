{
    /* {"k": 1} */ "sidebar": {
        "workspaceRow": null,
        /* // inside */ "workspaceRow": {
            "browser": {
                "pullRequest": 0,
                // note
"pullRequest": "true"
            }
        },
        "showTimestamps": 1,
        // note
"hoverCards": {
            /* * */ "groups": {
                "sections": "shadowed",
                "sections": {
                    "status": true
                }
            }
        }
    },
    "browser": {
        "omnibar": "shadowed",
        // note
"omnibar": {
            "glassTintStrength": "1"
        }
    },
    /* * */ "editor": {
        "autoSaveDelay": 1000
    },
    "navigation": {
        "history": {
            "scope": true
        }
    },
    /* {"k": 1} */ "appearance": {
        // a { brace
"colorTransition": {
            "duration": "1"
        },
        "surfaces": null,
        // url: https://localhost/x
"surfaces": {
            /* * */ "newTabPage": {
                "opacity": null,
                // url: https://localhost/x
"opacity": 2
            }
        }
    }
}
