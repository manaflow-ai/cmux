{
  "sidebar": {
    "workspaceRow": {
      "browser": {
        "log": true,
      },
    },
    "spacesPosition": "top",
    "priorityView": {
      "enabled": true,
    }
  },
  "appearance": {
    "backdropArt": "turner-temeraire",
    "metrics": {
      "tabMinInactiveWidth": 16,
    },
    "surfaces": {
      "terminal": {
        "color": "1a2b3c",
      },
    },
    "colorTransition": {
      "duration": 200,
    }
  },
  "editor": {
    "fontWeight": "600",
  },
  "computerUse": {
    "driver": 1
  },
}
