{
    browser: null,
    "browser": {
        "passwords": {
            "generate": "true"
        },
        "defaultEngine": "__not_a_choice__"
    },
    "history": null,
    "history": {
        // "quoted"
"commandRetentionDays": "1"
    },
    /* // inside */ "editor": {
        "matchBrackets": null,
        // "quoted"
"matchBrackets": "near",
        "autoClosingBrackets": 0,
        // "quoted"
"autoClosingBrackets": true
    },
    /* {"k": 1} */ "sidebar": {
        "workspaceRow": {
            // note
"terminal": {
                "pullRequest": true
            },
            "browser": {
                "tabCount": "shadowed",
                "tabCount": "true"
            },
            /* // inside */ "secondLineOrder": ["__not_a_choice__"]
        }
    },
    // a { brace
"agentPane": {
        "editedFiles": {
            "show": "shadowed",
            "show": 10E-1
        }
    },
    "oracleUnknown": {
        "nested": {
            "key": 1
        }
    }
}
