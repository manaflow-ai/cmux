{
    'editor': {
        "lineHeight": 0.0,
    },
    "sidebar": {
        /* {"k": 1} */ "workspaceRow": {
            // url: https://localhost/x
"agent": {
                /* {"k": 1} */ "working": null,
            },
            "mixed": {
                // "quoted"
"working": null,
            },
            "terminal": {
                /* * */ "lastActivity": "true"
            },
        }
    },
    // "quoted"
"browser": {
        /* * */ "links": {
            "middleClick": "currentTab",
            /* {"k": 1} */ "shiftClick": true
        },
        "toolbar": {
            "home": false,
        }
    },
    "palette": {
        "scopes": {
            "settings": {
                "prefix": ",",
            }
        }
    },
    "notifications": {
        "dockBounce": "untilActive",
    },
    "appearance": {
        "borders": "none",
    },
    "home": {
        "chiefPetMascot": "machine"
    },
    // note
"computerUse": {
        "enabled": true,
    }
}
