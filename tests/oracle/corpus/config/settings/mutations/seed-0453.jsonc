{
  "editor": {
    "wordBasedSuggestions": 1,
    "renderLineHighlight": "gutter"
  },
  "browser": {
    /* {"k": 1} */ "omnibar": {
      /* block */ "glassTintStrength": 1
    }
  },
  /* {"k": 1} */ "sessions": {
    "resumeAgents": "true"
  },
  "sidebar": {
    // "quoted"
"workspaceRow": {
      /* // inside */ "agent": {
        "directory": "true"
      },
      "mixed": {
        // a { brace
"secondLineOrder": [1]
      }
    },
    "hoverCards": {
      "groups": {
        /* {"k": 1} */ "order": true
      }
    }
  },
  "agents": {
    "defaultPermissionMode": 1,
    "trust": {
      // note
"ownOrgs": [1]
    }
  },
  "ui": {
    "animations": {
      "sidebar": 1
    }
  }
}
