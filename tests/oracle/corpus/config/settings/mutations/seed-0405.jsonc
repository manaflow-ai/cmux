{
    "appearance": "shadowed",
    /* block */ "appearance": {
        "statusIndicator": "shadowed",
        "statusIndicator": {
            "showAgentWorkingOnTabs": true
        },
        /* block */ "borders": true
    },
    "sidebar": {
        "workspaceRow": {
            /* * */ "agent": {
                "branch": "shadowed",
                /* {"k": 1} */ "branch": true
            }
        }
    },
    "browser": {
        "showAgentCursor": null,
        "showAgentCursor": "true"
    },
    "agents": {
        "trust": {
            "projectRoots": ["relative/path"]
        }
    },
    "files": {
        "textEditor": ""
    },
    "editor": null,
    "editor": {
        // note
"autoClosingQuotes": true
    },
    "agentPane": {
        "images": {
            // url: https://localhost/x
"remote": "__not_a_choice__"
        }
    },
    // "quoted"
"layout": {
        "closeFocus": 1
    },
    "oracleUnknown": {
        "nested": {
            "key": [true]
        }
    }
}
