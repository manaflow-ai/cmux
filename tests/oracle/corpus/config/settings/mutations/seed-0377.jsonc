{
    /* block */ "mobile": {
        "terminalSizing": "priority"
    },
    "appearance": {
        /* {"k": 1} */ "surfaces": {
            "internalPage": {
                "opacity": 1
            }
        },
        // "quoted"
"metrics": {
            // note
"tabPinnedWidth": 24.0
        }
    },
    "browser": {
        /* // inside */ "omnibox": {
            // url: https://localhost/x
"color": "#1A2B3C80"
        }
    },
    "sessions": {
        // note
"promptSuggestions": true
    },
    "sidebar": {
        /* block */ "workspaceRow": {
            "terminal": {
                "log": null
            }
        }
    },
    "oracleUnknown": {
        // "quoted"
"nested": {
            "key": 1.0
        }
    }
}
