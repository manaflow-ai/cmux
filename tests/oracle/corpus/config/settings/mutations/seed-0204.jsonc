{
	"browser": {
		"newTabPage": "about:blank",
		"freezeHiddenTabs": "1",
		"omnibar": {
			"inlineAutocomplete": "true"
		}
	},
	"computerUse": {
		"enabled": false
	},
	"sidebar": {
