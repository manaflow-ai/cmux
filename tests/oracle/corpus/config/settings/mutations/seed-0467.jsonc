{
    /* block */ "tabs": {
        "barPosition": "top"
    },
    /* {"k": 1} */ "sidebar": {
        // note
"workspaceRow": {
            "browser": {
                "tabCount": null
            }
        },
        "showSpaces": null
    },
    "browser": {
        "toolbar": "shadowed",
        // "quoted"
"toolbar": {
            "back": true
        }
    },
    "mobile": {
        "terminalSizing": "shadowed",
        "terminalSizing": "smallest"
    },
    "appearance": 0,
    "appearance": {
        "chromeStyle": 0,
        "chromeStyle": "card",
        "interfaceScale": 0.9
    },
    "editor": 0,
    "editor": {
        "cursorStyle": "shadowed",
        // "quoted"
"cursorStyle": "block-outline"
    },
    "updates": "shadowed",
    /* {"k": 1} */ "updates": {
        "web": 1,
        "keepPreviousVersions": 2.5
    },
    /* // inside */ "status": {
        "inferCommandBusyAfter": 300
    },
    "oracleUnknown": {
        "nested": {
            // url: https://localhost/x
"key": 1
        }
    }
}
