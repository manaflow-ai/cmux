{
    "browser": {
        "links": {
            "optionClick": "currentTab"
        },
        "omnibar": {
            "glassTintStrength": 0.35
        },
        "customSearchEngine": {
            "suggest": ""
        }
    },
    "editor": {
        "wordWrapColumn": 10,
        "guides": {
            "bracketPairs": false
        }
    },
    "layout": {
        "paneSeparation": "dividers"
    },
    "sidebar": {
        "workspaceIcons": {
            "Work": 1
        },
        "workspaceRow": {
            "terminal": {
                "pullRequest": 1
            }
        }
    },
    "notifications": {
        "attention": {
            "persist": "true"
        }
    },
    "diagnostics": {
        "hangReports": "true"
    }
}
