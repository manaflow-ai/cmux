{
  // a { brace
"editor": {
    /* // inside */ "insertSpaces": 1e0,
    /* * */ "mouseWheelZoom": false
  },
  "markdown": {
    "font": {
      "lineHeight": "1"
    }
  },
  "browser": {
    "hibernationExclusions": [],
    "urlsToAlwaysOpenExternally": [],
    /* block */ "toolbar": {
      "extensions": 1e0
    }
  },
  "window": {
    // url: https://localhost/x
"trafficLightClearance": 0E-1
  },
  "notifications": {
    "attention": {
      "persist": "true"
    }
  }
}
