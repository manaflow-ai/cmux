{
    "sidebar": {
        "workspaceRow": {
            "directory": false
        },
        // a { brace
"showWorkspaceTabs": true,
        "topBandMaxShare": 0.1
    },
    /* * */ "appearance": {
        // note
"background": "monet-waterlily-pond"
    },
    "status": {
        // note
"runNotifyWhenVisible": false
    },
    "layout": {
        "splitSizing": "__not_a_choice__"
    },
    "editor": {
        /* block */ "importFrom": "cursor",
        "cursorStyle": "line"
    },
    /* // inside */ "agentPane": {
        "display": {
            "inspector": {
                "placement": "overlay"
            }
        }
    },
    "feed": {
        "mirrorNotifications": {
            /* block */ "terminal": true
        }
    },
    /* * */ "oracleUnknown": {
        // note
"nested": {
            // a { brace
"key": [true]
        }
    }
}
