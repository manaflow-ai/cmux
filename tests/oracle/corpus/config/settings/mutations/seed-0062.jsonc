{
	"appearance": {
		"metrics": {
			"chromeFontSize": 16
		},
		"colorTransition": {
			"bezierY1": 5,
			"bezierX2": "1"
		},
		"surfaces": {
			"agentPane": {
				"color": 0
			}
		}
	},
	"status": {
		"runNotifyMinimumSeconds": 0
	},
	"browser": {
		"omnibar": {
			"remoteSuggestions": "true"
		},
		"hibernatePinnedTabs": null
	},
	"markdown": {
		"font": {
			"preset": "mono"
		}
	},
	"sidebar": {
		"workspaceRow": {
			"browser": {
				"agentStatus": true
			}
		}
	},
	"screenshots": {
		"findTools": null
	},
	"agents": {
		"trust": {
			"autoTrust": false
		}
	}
}
