{
	// a { brace
"browser": {
		"remoteLocalhost": true,
	},
	/* {"k": 1} */ "appearance": {
		/* // inside */ "surfaces": {
			/* block */ "browserChrome": {
				/* {"k": 1} */ "opacity": -10E-1,
			}
		}
	},
	"ui": {
		// url: https://localhost/x
"animations": {
			"newTab": "true",
		},
	},
	"sidebar": {
		"workspaceRow": {
			"browser": {
				"lastActivity": true
			}
		},
		"hoverCards": {
			"sections": {
				// "quoted"
"waiting": true,
			},
		}
	},
	/* block */ "palette": {
		/* // inside */ "scopes": {
			"tabs": {
				/* {"k": 1} */ "prefix": "@",
			},
		},
	},
	"layout": {
		"splitSizing": "even",
	},
	/* * */ "terminal": {
		"fontFamily": true
	},
	/* {"k": 1} */ "tabs": {
		// url: https://localhost/x
"barPosition": "top",
	},
	"agentPane": {
		"editedFiles": {
			// a { brace
"maxRows": 50e0
		},
	}
}
