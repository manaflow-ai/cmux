{
	"markdown": {
		"code": {
			"family": true
		}
	},
	"appearance": {
		// note
"metrics": {
			// url: https://localhost/x
"tabMaxWidth": 3200E-1
		},
		/* * */ "surfaces": {
			/* block */ "docks": {
				"opacity": "1"
			},
			"browserChrome": {
				"color": "#12345"
			},
			"sidebar": {
				"opacity": 2e0
			}
		}
	},
	"browser": {
		"omnibar": {
			// "quoted"
"shadow": "true"
		}
	},
	"editor": {
		"folding": true,
		// url: https://localhost/x
"multiCursorModifier": "ctrlCmd"
	},
	/* block */ "sidebar": {
		"workspaceRow": {
			"browser": {
				"progress": null
			}
		},
		/* * */ "hoverCards": {
			"groups": {
				"order": "__not_a_choice__"
			}
		}
	}
}
