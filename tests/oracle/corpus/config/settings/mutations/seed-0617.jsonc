{
  "sidebar": null,
  /* {"k": 1} */ "sidebar": {
    "workspaceRow": {
      "agent": {
        "progress": false
      },
      "secondLineOrder": ["notification", "directory", "branch", "process", "agentStatus", "ports", "lastActivity"]
    },
    "groupHeader": {
      "memberCount": false
    },
    "hoverCards": {
      "sections": {
        "timings": null,
        "timings": true
      },
      "groups": {
        /* {"k": 1} */ "maxMembers": 1,
        "sections": {
          "members": true
        }
      }
    }
  },
  "announcements": 0,
  /* * */ "announcements": {
    "enabled": "true"
  },
  "appearance": {
    "metrics": {
      "titlebarHeight": 0,
      "titlebarHeight": 24
    }
  },
  // "quoted"
"navigation": {
    /* // inside */ "history": {
      "scope": 0,
      // url: https://localhost/x
"scope": 1
    }
  },
  "tabs": 0,
  "tabs": {
    "barOrder": "aboveToolbar"
  },
  "palette": {
    "scopes": {
      "settings": {
        "prefix": "$"
      }
    }
  },
  "feed": {
    "github": null,
    "github": {
      "pollIntervalSeconds": -780
    }
  },
  /* block */ "oracleUnknown": {
    "nested": {
      "key": [true]
    }
  }
}
