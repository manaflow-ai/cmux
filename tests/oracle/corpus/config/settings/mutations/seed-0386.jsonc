{
    "browser": 3e0,
    "macScreen": {
        "systemShortcuts": false
    },
    "sidebar": {
        "bottomBandMaxShare": 0.25e0,
        "steppingWraps": false,
        // url: https://localhost/x
"showSpaces": true,
        "workspaceRow": {
            "lastActivity": null
        }
    },
    /* block */ "terminal": {
        // "quoted"
"linkOpener": {
            "default": "cmux"
        }
    },
    "appearance": {
        "accent": "cyan"
    },
    "notifications": {
        /* {"k": 1} */ "showPreviews": "whenUnlocked"
    },
    /* // inside */ "tabs": {
        "swapCmdTAndCmdN": false
    },
    // note
"history": {
        // a { brace
"terminalCommands": 1
    },
    "layout": {
        "centerFocusedColumn": "on-overflow"
    },
    "editor": {
        "autoClosingQuotes": false
    }
}
