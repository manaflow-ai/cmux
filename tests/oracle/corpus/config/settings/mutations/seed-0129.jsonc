{
    // note
"sidebar": {
        "hoverCards": {
            "groups": {
                "workspaceGroups": "true"
            }
        },
        "detailedStatusIcons": true,
        "workspaceRow": {
            // url: https://localhost/x
"mixed": {
                /* {"k": 1} */ "directory": null
            }
        }
    },
    "appearance": {
        "backdropArt": "velde-cannon-shot",
        "backgroundRotation": "daily",
    },
    "app": {
        // note
"warnBeforeClosingTab": "true",
        "uiScale": 1
    },
    "notifications": {
        "attention": {
            "terminals": "__not_a_choice__",
            /* * */ "persist": true,
        }
    },
    "browser": {
        "builtInAdBlocker": true,
    },
    "mobile": {
        /* {"k": 1} */ "terminalSizing": "mac"
    },
    /* {"k": 1} */ "agentPane": {
        /* // inside */ "editedFiles": {
            "show": "collapsed",
        }
    },
    /* // inside */ "oracleUnknown": {
        "nested": {
            /* block */ "key": [true],
        }
    }
}
