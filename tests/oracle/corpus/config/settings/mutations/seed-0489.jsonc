{
    "terminal": {
        "fontSize": 188
    },
    /* // inside */ "sidebar": {
        "workspaceRow": {
            /* * */ "mixed": {
                /* // inside */ "agentStatus": 1
            }
        },
        "showSearchButton": true
    },
    "tabs": {
        "swapCmdTAndCmdN": false
    },
    // a { brace
"editor": {
        "lineNumbers": "__not_a_choice__",
        "detectIndentation": false
    },
    "browser": {
        // note
"agentMouse": {
            // url: https://localhost/x
"motion": true
        }
    },
    "layout": {
        /* // inside */ "dockColumnMode": 1,
        /* {"k": 1} */ "paneBorderWidth": "1"
    },
    "screenshots": {
        "folders": "/Users/ada/src"
    },
    /* // inside */ "sessions": {
        "keepAwake": 1
    }
}
