{
    "editor": {
        "scrollBeyondLastLine": false
    },
    "mobile": {
        "allowIPhoneConnections": null
    },
    /* block */ "diff": {
        "colors": "theme"
    },
    "appearance": {
        "colorTransition": {
            "duration": 2000,
            "bezierY1": "1"
        },
        /* {"k": 1} */ "metrics": {
            "chromeFontSize": "1"
        }
    },
    /* // inside */ "layout": {
        // a { brace
"paneCornerRadius": 40
    },
    "oracleUnknown": {
        "nested": {
            /* // inside */ "key": 1
        }
    }
}
