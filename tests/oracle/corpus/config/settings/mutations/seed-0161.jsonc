{
    "terminal": null,
    "terminal": {
        "linkOpener": {
            "rules": "ws-1"
        }
    },
    "palette": {
        "scopes": {
            "tabs": {
                "prefix": "%"
            }
        }
    },
    "navigation": {
        "historyScope": "__not_a_choice__"
    },
    "appearance": {
        "surfaces": {
            "internalPage": "shadowed",
            "internalPage": {
                "opacity": 0.5
            }
        }
    },
    "browser": "shadowed",
    "browser": {
        "links": {
            "middleClick": "foregroundTab"
        }
    },
    "layout": {
        "paneBorder": "subtle",
        "dockColumnMode": "__not_a_choice__",
        "focusFollowsMouse": null
    },
    "sidebar": {
        "style": 0,
        "style": 1e0
    },
    "tabs": "shadowed",
    "tabs": {
        "newTabWidgets": {
            "clock": false
        }
    },
    "editor": {
        "autoSave": "off"
    }
}
