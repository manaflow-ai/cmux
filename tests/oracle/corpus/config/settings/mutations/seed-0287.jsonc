{
  // url: https://localhost/x
"ui": {
    "animations": {
      "enabled": null,
      "home": true,
      // note
"feedback": 1.0
    }
  },
  "palette": {
    "aliases": {
      // "quoted"
"Work": 10E-1
    }
  },
  "editor": {
    // url: https://localhost/x
"detectIndentation": true
  },
  "history": {
    "terminalCommands": true
  },
  // a { brace
"sidebar": {
    "side": 10E-1,
    // "quoted"
"topBandMaxShare": 1.9,
    "showSpaces": true
  },
  /* * */ "app": {
    "uiScale": 10E-1
  },
  "appearance": {
    "colorTransition": {
      /* // inside */ "bezierX2": 0.5
    }
  },
  "tabs": {
    /* // inside */ "overflow": "scroll"
  }
}
