{
  "editor": {
    "acceptSuggestionOnEnter": "on",
    "lineNumbers": true
  },
  "browser": {
    "toolbar": {
      "forward": 1,
    }
  },
  "focusRing": {
    "contrast": "standard"
  },
  "appearance": {
    "surfaces": {
      "home": {
        "opacity": -1
      },
      "internalPage": {
        "opacity": 1,
      }
    },
    "metrics": {
      "tabMinInactiveWidth": 624,
    },
  },
  "sidebar": {
    "hoverCards": {
      "groups": {
        "sections": {
          "activity": true,
        },
      },
    },
    "workspaceRow": {
      "mixed": {
        "tabCount": 1
      },
    }
  },
  "layout": {
    "defaultColumnWidth": 0.1
  },
}

}
