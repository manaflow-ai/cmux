{
  /* * */ "window": "flat",
  "layout": {
    /* block */ "linkPlacement": 1,
    // "quoted"
"paneBorderColor": "1a2b3c"
  },
  "browser": {
    "omnibar": {
      "cornerRadius": true
    }
  },
  /* block */ "markdown": {
    "code": {
      "family": 1
    }
  },
  "tabs": {
    "newTabWidgets": {
      "weather": 1
    }
  },
  // note
"appearance": {
    // a { brace
"surfaces": {
      "sidebar": {
        // note
"color": "#12345g"
      }
    }
  },
  "sidebar": {
    // url: https://localhost/x
"sectionLook": true,
    /* block */ "workspaceRow": {
      "browser": {
        "directory": 1
      },
      "terminal": {
        // "quoted"
"progress": 1
      }
    },
    /* // inside */ "density": "__not_a_choice__"
  },
  "freeModel": {
    "enabled": "true"
  }
, "oracle": 1e400}
