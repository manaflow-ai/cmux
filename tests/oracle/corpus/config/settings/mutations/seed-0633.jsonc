{
	"editor": {
		"cursorSurroundingLines": 500E-1,
		"cursorStyle": "line",
		"matchBrackets": "always"
	},
	"notifications": {
		"attention": {
			"width": 15.5e0
		}
	},
	"browser": {
		"verificationAutofill": {
			"enabled": false
		}
	},
	"sidebar": {
		"bottomBandMaxShare": 0.5,
	},
	"layout": {
		"scrollAreas": false
	},
	"oracleUnknown": {
		"nested": {
			"key": "x",
		},
	}
}
