{
    "focusRing": {
        "contrast": true
    },
    "sidebar": {
        "showChats": 1,
    },
    "layout": {
        "defaultColumnWidth": 0.1
    },
    "editor": {
        "lineHeight": 300,
    },
    "updates": {
        "installOnQuit": 1
    },
    "appearance": {
        "focusIndicator": "border",
        "surfaces": {
            "browserChrome": {
                "opacity": -1
            },
            "markdown": {
                "color": "1a2b3c",
            },
        },
    },
    "notifications": {
        "attention": {
            "color": "red",
        }
    }
}
