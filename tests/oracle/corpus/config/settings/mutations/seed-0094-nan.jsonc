{
	"sidebar": {
		// note
"workspaceRow": {
			// a { brace
"agent": {
				"process": true
			},
			"mixed": {
				"progress": 1.0
			}
		},
		"density": "expanded"
	},
	"tabs": {
		"newTabWidgets": {
			/* // inside */ "quote": false
		}
	},
	"markdown": {
		/* * */ "remoteImages": 10E-1
	},
	"notifications": {
		"attention": {
			// url: https://localhost/x
"width": 2e0
		}
	},
	"layout": {
		"paneBorderWidth": 0.5
	},
	"browser": {
		"openTerminalLinksInCmuxBrowser": true
	},
	/* // inside */ "appearance": {
		"surfaces": {
			// note
"docks": {
				"color": "1a2b3c"
			},
			// "quoted"
"browserChrome": {
				"opacity": "1"
			}
		}
	},
	"history": {
		// url: https://localhost/x
"closed": {
			"maxAgeDays": 0e0
		}
	},
	"oracleUnknown": {
