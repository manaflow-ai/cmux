{
	"sidebar": {
		"workspaceRow": {
			"secondLineOrder": ["notification", "directory", "branch", "process", "agentStatus", "ports", "lastActivity"],
		},
	},
	/* block */ "appearance": {
		"colorTransition": {
			"bezierX2": "1"
		},
		/* {"k": 1} */ "interfaceScale": -0.09999999999999998,
		/* // inside */ "surfaces": {
			"tabBar": {
				// "quoted"
"color": "#1234567"
			}
		},
	},
	"notifications": {
		/* {"k": 1} */ "dockBadge": "true"
	},
	"editor": {
		"detectIndentation": true,
		// url: https://localhost/x
"importFrom": "vscodium"
	},
	"browser": {
		// a { brace
"links": {
			"optionClick": "download"
		}
	},
	/* // inside */ "tabs": {
		"commandDigits": "tabs"
	}
}
