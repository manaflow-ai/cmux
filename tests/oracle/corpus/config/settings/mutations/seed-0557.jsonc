{
	"appearance": {
		"statusIndicator": {
			"style": "arc",
		},
	},
	"tabs": {
		"newTabWidgets": {
			"projects": false
		},
		"barPosition": "top",
		"newTabPosition": "start"
	},
	"sidebar": {
		"hoverCards": {
			"layout": "minimal"
		},
		"workspaceRow": {
			"agent": {
				"secondLineOrder": ["__not_a_choice__"],
			}
		}
	},
	"mobile": {
		"allowIPhoneConnections": 10E-1
	},
	"browser": {
		"builtInAdBlocker": false,
	},
	"layout": {
		"panePadding": -160E-1
	},
	"editor": {
		"guides": {
			"indentation": "true",
		}
	},
	"ui": {
		"animations": {
			"newTab": null,
		}
	}
}
