{
	"picker": {
		/* // inside */ "pinned": []
	},
	// url: https://localhost/x
"agentPane": {
		/* // inside */ "editedFiles": {
			"maxRows": 99,
		},
	},
	"layout": {
		"tileBrowsers": 1,
	},
	// url: https://localhost/x
"sidebar": {
		"workspaceRow": {
			/* * */ "browser": {
				"directory": null,
			}
		},
		"priorityView": {
			"shown": false
		}
	},
	"tabs": {
		/* block */ "overflow": "scroll"
	},
	"palette": {
		"scopes": {
			/* * */ "scopes": {
				/* block */ "prefix": "=",
			},
		},
	},
	"notifications": {
		"timeoutSeconds": "1",
	},
	"browser": {
		"omnibar": {
			"cornerRadius": -16
		}
	},
	"sessions": {
		"promptSuggestions": null,
	},
	"appearance": {
		// url: https://localhost/x
"surfaces": {
			"diff": {
				"opacity": 1,
			},
		}
	},
	"editor": {
		"find": {
			"seedSearchStringFromSelection": "__not_a_choice__"
		}
	},
	/* block */ "oracleUnknown": {
		/* block */ "nested": {
			// note
"key": 1
		}
	}
}
