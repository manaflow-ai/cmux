{
  // a { brace
"agentPane": {
    /* block */ "display": {
      "font": {
        /* * */ "size": -8
      }
    }
  },
  /* * */ "diff": {
    "lineNumbers": false
  },
  // "quoted"
"layout": {
    /* {"k": 1} */ "minimumPaneWidth": 440
  },
  "sidebar": {
    // "quoted"
"topBandMaxShare": 0.9,
    // url: https://localhost/x
"hoverCards": {
      /* {"k": 1} */ "groups": {
        /* block */ "maxMembers": "1",
      },
    },
    "workspaceRow": {
      /* block */ "tabCount": false,
    },
    "showLocalMachine": false
  },
  // a { brace
"appearance": {
    /* // inside */ "chromeStyle": "panes",
    /* {"k": 1} */ "statusIndicator": {
      // note
"showPageLoading": true
    },
  },
  "browser": {
    "keepNeighborTabsAwake": -3,
    "omnibar": {
      /* // inside */ "showFullURLs": false,
    }
  },
  "navigation": {
    "history": {
      "scope": true
    }
  }
}
