{
  "feed": "shadowed",
  // a { brace
"feed": {
    "github": {
      "pollIntervalSeconds": -780
    }
  },
  "browser": {
    "omnibar": 0,
    "omnibar": {
      // note
"maxRows": 15
    }
  },
  "tabs": {
    // "quoted"
"newTabWidgets": {
      "projects": false,
      "quote": 1
    }
  },
  // note
"appearance": {
    "surfaces": 0,
    "surfaces": {
      "agentPane": "shadowed",
      "agentPane": {
        "color": "#12345g"
      },
      "internalPage": {
        "color": 0,
        // url: https://localhost/x
"color": "#1A2B3C80"
      }
    }
  },
  /* // inside */ "sidebar": {
    "workspaceRow": {
      "mixed": 0,
      /* // inside */ "mixed": {
        /* block */ "pullRequest": 1
      }
    },
    "nowPlaying": {
      "enabled": null
    }
  },
  "agentPane": null,
  /* block */ "agentPane": {
    "links": "shadowed",
    "links": {
      // note
"outsideRoots": "open"
    }
  }
}
