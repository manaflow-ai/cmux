{
  /* * */ "browser": {
    // note
"passwords": {
      /* block */ "offerToSave": true
    }
  },
  "editor": {
    "minimap": {
      // note
"enabled": "true"
    }
  },
  /* {"k": 1} */ "appearance": {
    "surfaces": {
      /* // inside */ "diff": {
        "opacity": "1"
      }
    }
  },
  "agentPane": {
    /* block */ "links": {
      "outsideRoots": "text"
    }
  },
  "markdown": {
    "font": {
      "preset": "mono"
    }
  },
  "layout": {
    "paneSeparation": "__not_a_choice__",
    "minimumPaneWidth": 200
  },
  /* block */ "focusRing": {
    /* block */ "contrast": "subtle"
  },
  "tabs": {
    "newTabWidgets": {
      "quote": "true"
    }
  }
}
