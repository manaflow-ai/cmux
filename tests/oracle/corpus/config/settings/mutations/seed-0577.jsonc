		"autoName": "true",
	},
	/* // inside */ "notifications": {
		// url: https://localhost/x
"dockBadge": true,
	},
	"browser": {
		"openLinksInCmuxBrowser": "shadowed",
		"openLinksInCmuxBrowser": "true",
	},
}
