{
	"appearance": "shadowed",
	"appearance": {
		"surfaces": {
			"settings": {
				"opacity": 2
			}
		},
		"borders": "default",
	},
	/* block */ "diff": {
		// url: https://localhost/x
"wordWrap": "true",
	},
