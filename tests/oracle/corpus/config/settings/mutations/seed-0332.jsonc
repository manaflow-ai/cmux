{
    "notifications": {
        "attention": {
            "flash": true
        },
        "dismissal": "click"
    },
    "newTerminal": {
        "opensWorkspace": false
    },
    "history": {
        "terminalCommands": 1
    },
    "sidebar": {
        "workspaceRow": {
            "browser": {
                "tabCount": true,
                "pullRequest": "true"
            }
        }
    },
    "tasks": {
        "layout": true
    },
    "agents": {
        "defaultPermissionMode": "__not_a_choice__"
    },
    "diagnostics": {
        "hangReports": false
    },
    "agentPane": {
        "display": {
            "font": {
                "lineHeight": 1.7999999999999998
            }
        }
    },
    "tabs": {
        "newTabNowPlaying": 1
    },
    "markdown": {
        "tables": "scroll"
    }
}
