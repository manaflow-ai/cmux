{
    "sidebar": {
        // url: https://localhost/x
"minimalMode": "__not_a_choice__",
        /* * */ "workspaceRow": {
            // "quoted"
"ports": false,
            /* * */ "mixed": {
                // url: https://localhost/x
"tabCount": null
            }
        }
    },
    "browser": {
        "builtInAdBlocker": 1
    },
    // "quoted"
"layout": {
        // url: https://localhost/x
"stripScrollbar": "always"
    },
    "markdown": {
        "code": {
            "family": true
        }
    },
    "diff": {
        /* * */ "hideWhitespace": true
    },
    "tabs": {
        "newTabWidgets": {
            /* block */ "timer": 1
        }
    },
    // a { brace
"appearance": {
        // url: https://localhost/x
"chromeStyle": "flat-sidebar-line",
        "customDensity": null
    },
    // note
"oracleUnknown": {
        "nested": {
            // a { brace
"key": "x"
        }
    }
}
