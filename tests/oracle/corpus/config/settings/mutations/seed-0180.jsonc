{
  // note
"browser": {
    "toolbar": {
      "home": null,
    },
    // url: https://localhost/x
"showAgentCursor": true,
    "agentMouse": {
      // "quoted"
"motion": true
    }
  },
  "layout": {
    "stripScrollbar": "system",
  },
  "sidebar": {
    "hoverCards": {
      // url: https://localhost/x
"groups": {
        "sections": {
          // note
"ports": "true"
        },
      },
    },
    /* block */ "workspaceRow": {
      "mixed": {
        "working": null
      },
    },
  },
  "focusRing": {
    /* * */ "enabled": true,
  },
  /* * */ "macScreen": {
    "debug": {
      "relayOnly": false,
    },
  }
}
