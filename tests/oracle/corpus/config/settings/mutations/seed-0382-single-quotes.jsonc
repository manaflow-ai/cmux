{
  'browser': {
    "enabled": false
  },
  /* block */ "sidebar": {
    "pinnedBandsScroll": "true",
    // a { brace
"hoverCards": {
      "sections": {
        "ports": "true",
      },
    }
  },
  "tabs": {
    /* // inside */ "newTabWidgets": {
      "timer": false,
    },
  },
  // "quoted"
"appearance": {
    /* {"k": 1} */ "colorTransition": {
      "duration": 40000E-1,
      /* // inside */ "reduceMotion": "crossfade",
    },
    "saturation": 0,
  },
  "oracleUnknown": {
    // a { brace
"nested": {
      "key": "x"
    },
  },
}
