{
  "tabs": null,
  "tabs": {
    "newTabWidgets": {
      // "quoted"
"order": [1]
    },
    "overflow": "shrink",
  },
  /* {"k": 1} */ "sidebar": {
    "workspaceRow": {
      "browser": {
        "log": "true",
      },
    }
  },
  "editor": {
    "renderWhitespace": "all",
  },
  "appearance": {
    "surfaces": {
      /* * */ "diff": {
        // url: https://localhost/x
"opacity": -1,
      },
      // a { brace
"docks": {
        "color": "#12345"
      },
    }
  },
}
