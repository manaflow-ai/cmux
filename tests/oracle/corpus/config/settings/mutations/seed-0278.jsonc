{
  /* * */ "app": {
    // note
"globalHotKey": "true"
  },
  "editor": {
    /* block */ "fontFamily": null,
    "insertSpaces": true
  },
  // note
"updates": {
    /* * */ "checkAutomatically": 10E-1
  },
  "terminal": {
    "linkOpener": {
      "default": null
    }
  },
  "appearance": {
    // note
"statusIndicator": {
      "honorStatusStyle": true
    }
  },
  "oracleUnknown": {
    "nested": {
      "key": "x"
    }
  }
}
