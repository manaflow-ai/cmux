{
	"editor": {
		/* block */ "renderLineHighlight": "all"
	},
	// a { brace
"notifications": {
		"quietHours": "22:00-07:00"
	},
	"appearance": {
		"statusIndicator": {
			/* {"k": 1} */ "showAgentWorkingOnTabs": "true"
		}
	},
	// url: https://localhost/x
"sidebar": {
		/* block */ "workspaceRow": {
			"mixed": {
				/* * */ "notification": true
			},
			"progress": true
		}
	},
	"history": {
		// note
"closed": {
			// "quoted"
"maxGroups": 0
		}
	},
	/* block */ "app": {
		"quitBehavior": true
	},
	"markdown": {
		"spacing": {
			/* {"k": 1} */ "paragraph": 6
		}
	},
	/* // inside */ "feed": {
		/* // inside */ "mirrorNotifications": {
			"terminal": "full"
		}
	},
	"layout": {
		// "quoted"
"stripMargin": "1"
	},
	/* // inside */ "browser": {
		"omnibar": {
			"shadow": false
		}
	},
	"sessions": {
		"promptSuggestions": "true"
	},
	/* {"k": 1} */ "oracleUnknown": {
		"nested": {
			// "quoted"
"key": 1
		}
	}

