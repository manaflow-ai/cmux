{
    "appearance": {
        "colorTransition": {
            "curve": "__not_a_choice__"
        },
        "statusIndicator": {
            "showAgentWorkingOnTabs": true
        }
    },
    // note
"terminal": {
        "linkOpener": {
            // a { brace
"default": "cmux"
        }
    },
    // "quoted"
"sidebar": {
        /* * */ "workspaceRow": {
            "browser": {
                "pullRequest": true
            }
        },
        // a { brace
"density": 1
    },
    "notifications": {
        "attention": {
            "flashOnTyping": true
        }
    },
    // note
"shortcuts": {
        "showModifierHoldHints": true
    },
    "oracleUnknown": {
        // "quoted"
"nested": {
            "key": [true]
        }
    }
}
