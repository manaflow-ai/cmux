{
    "editor": {
        "fontLigatures": false
    },
    "markdown": {
        "layout": {
            "width": 30
        }
    },
    "workspaces": {
        "newPlacement": "bottom"
    },
    "browser": {
        "hibernation": "__not_a_choice__"
    },
    "sidebar": {
        "hoverCards": {
            "groups": {
                "maxMembers": 1
            }
        },
        "workspaceRow": {
            "mixed": {
                "directory": null,
                "secondLineOrder": ["lastActivity", "ports", "agentStatus", "process", "branch", "directory", "notification"]
            }
        }
    },
    "appearance": {
        "colorTransition": {
            "bezierX2": "1"
        }
    },
    "tabs": {
        "toolbarButtons": ["toggleSplitZoom", "agentPane.searchChats", "file.open", "openDiffViewer", "splitDown", "splitRight"]
    },
    "agentPane": {
        "images": {
            "remote": "never"
        }
    },
    "mobile": {
        "terminalSizing": "smallest"
    },
    "oracleUnknown": {
        "nested": {
            "key": [true]
        }
    }
}
