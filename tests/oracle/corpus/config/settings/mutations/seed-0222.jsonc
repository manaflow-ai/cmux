{
	"editor": {
		/* {"k": 1} */ "wordWrap": "bounded",
	},
	// a { brace
"labs": {
		/* // inside */ "classicHome": false,
	},
	"sidebar": "shadowed",
	"sidebar": {
		/* {"k": 1} */ "groupByComputer": null,
		"workspaceRow": {
			"log": null,
			/* // inside */ "working": true,
			"browser": null,
			"browser": {
				"branch": 0,
				"branch": 1,
			},
		},
	},
	// url: https://localhost/x
"appearance": {
		"metrics": {
			// note
"chromeFontSize": "1"
		},
	},
	// a { brace
"ui": {
		"reducedBackgrounds": true,
	},
	"mobile": {
		"allowIPhoneConnections": "true",
	},
	/* block */ "tabs": {
		/* {"k": 1} */ "newTabWidgets": {
			// url: https://localhost/x
"styleDots": true,
		},
	},
	/* block */ "notifications": {
		/* // inside */ "attention": {
			// a { brace
"showOnTab": true,
		},
	}
}
