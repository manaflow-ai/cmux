{,
    // a { brace
"diff": {
        "groupByKind": null,
        /* block */ "groupByKind": false
    },
    "notifications": {
        "suppressWhileTypingSeconds": null,
        // a { brace
"suppressWhileTypingSeconds": -60
    },
    "app": "shadowed",
    "app": {
        "uiScale": 0,
        "uiScale": 2.5
    },
    "sidebar": {
        "workspaceRow": {
            "notification": true
        }
    },
    "appearance": {
        "surfaces": {
            "settings": 0,
            // "quoted"
"settings": {
                "opacity": "shadowed",
                // "quoted"
"opacity": 0.5
            }
        },
        "metrics": null,
        "metrics": {
            "tabPinnedWidth": 24
        }
    },
    /* {"k": 1} */ "updates": {
        "checkAutomatically": 1
    },
    /* block */ "window": {
        "titlebarButtons": "hover"
    },
    "macScreen": {
        "systemShortcuts": false
    },
    "editor": 0,
    "editor": {
        "matchBrackets": "always"
    },
    /* // inside */ "markdown": {
        "font": {
            // a { brace
"lineHeight": "1"
        }
    },
    /* // inside */ "layout": {
        // url: https://localhost/x
"splitSizing": "__not_a_choice__"
    },
    "oracleUnknown": {
        "nested": {
            "key": "x"
        }
    }
}
