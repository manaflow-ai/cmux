{
    "browser": {
        "verificationAutofill": {
            "enabled": 1
        },
    },
    // url: https://localhost/x
"editor": {
        "scrollBeyondLastLine": "true",
        // note
"cursorStyle": "line"
    },
    "layout": {
        "defaultColumnWidth": "1"
    },
    /* {"k": 1} */ "sidebar": {
        "workspaceRow": {
            /* * */ "terminal": {
                "progress": 1,
            },
            // a { brace
"mixed": {
                /* block */ "icon": false
            }
        },
    },
    "updates": {
        // "quoted"
"checkIntervalSeconds": 302850,
    },
    "app": {
        // "quoted"
"startAgentGlobalHotKey": null
    },
    "appearance": {
        "surfaces": {
            /* * */ "newTabPage": {
                "opacity": -1,
            },
        },
    },
    "oracleUnknown": {
        "nested": {
            "key": [true,],
        },
    },
}
