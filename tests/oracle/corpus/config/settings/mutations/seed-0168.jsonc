{
	/* // inside */ "browser": {
		// url: https://localhost/x
"toolbarPosition": "__not_a_choice__"
	},
	// "quoted"
"editor": {
		"renderLineHighlight": "none"
	},
	/* {"k": 1} */ "sidebar": {
		"workspaceRow": {
			// url: https://localhost/x
"terminal": {
				/* block */ "working": true
			},
			// url: https://localhost/x
"browser": {
				// note
"process": true
			}
		},
		"numbering": "workspacesOnly",
		"sessionTree": true,
		"showChats": 10E-1
	},
	// url: https://localhost/x
"appearance": {
		// note
"surfaces": {
			"editor": {
				// a { brace
"color": "#12345g"
			},
		},
		"metrics": {
			"titlebarHeight": 400E-1
		},
	},
	// url: https://localhost/x
"oracleUnknown": {
		/* {"k": 1} */ "nested": {
			"key": [true],
		}
	},
}
