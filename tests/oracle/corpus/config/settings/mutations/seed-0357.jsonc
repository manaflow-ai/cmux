{
  /* {"k": 1} */ "browser": {
    /* // inside */ "omnibar": {
      "shadow": false
    },
    "toolbar": {
      "extensions": null,
    }
  },
  /* // inside */ "appearance": {
    "metrics": {
      "chromeFontSize": 10.0,
    },
    "surfaces": {
      // a { brace
"internalPage": {
        "color": "#1a2B3c"
      },
    }
  },
  "diff": {
    "diffIndicators": "bars",
  },
  // url: https://localhost/x
"status": {
    // note
"runNotifyMinimumSeconds": 10e0,
  },
  // "quoted"
"phone": {
    "cloudReplica": true
  },
  "notifications": {
    "attention": {
      "duration": -29.4
    }
  },
  /* // inside */ "sidebar": {
    "workspaceRow": {
      // note
"lastActivity": "true",
    }
  },
  // "quoted"
"mobile": {
    "terminalSizingOrder": ["ws-1", "2B7F0C3A-workspace"],
  },
}
