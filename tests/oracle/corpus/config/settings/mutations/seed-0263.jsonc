{
  // note
"appearance": {
    "focusIndicator": "border",
    "inactiveWindowDim": 0,
    "colorTransition": {
      // a { brace
"bezierY2": -4,
    }
  },
  "sessions": {
    "resumeAgents": true
  },
  "sidebar": {
    "workspaceRow": {
      "agent": {
        /* {"k": 1} */ "tabCount": "true"
      },
      "terminal": {
        "pullRequest": false
      }
    },
  },
  "chief": {
    // "quoted"
"reactionClassifier": {
      "prompt": 1,
    },
  },
  "ui": {
    // note
"animations": {
      "web": "true",
    }
  },
  "layout": {
    "paneBorder": true,
  },
  "editor": {
    /* {"k": 1} */ "autoSave": 1,
  }
}
