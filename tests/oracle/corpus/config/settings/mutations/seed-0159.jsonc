{
    "appearance": {
        "paneBackgrounds": "perPane",
    },
    "status": {
        "inferCommandBusy": null
    },
    "app": {
        "warnBeforeClosingTab": 1
    },
    "browser": {
        "builtInAdBlocker": null,
        "newTabPage": "file:///tmp/a.html",
        // note
"toolbarButtons": ["devTools", "theme", "profile", "designMode", "downloads", "favorites", "zoom", "media"],
        "omnibox": {
            "popupHoverColor": "1a2b3c"
        },
    },
    /* * */ "ui": {
        // url: https://localhost/x
"animations": {
            "tabs": false,
        },
    },
    "feed": {
        "github": {
            "pollIntervalSeconds": -780
        }
    },
    // "quoted"
"focusRing": {
        // a { brace
"showWhenSinglePane": false
    },
}
