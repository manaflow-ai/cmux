{
	"sidebar": {
		"workspaceRow": {
			"terminal": {
				"directory": true
			}
		},
		"minimalMode": "off",
		"hoverCards": {
			"enabled": "true"
		}
	},
	"layout": {
		"frameOrientation": "rowMajor"
	},
	"diff": {
		"expandUnchanged": true
	},
	"appearance": {
		"surfaces": {
			"docks": {
				"opacity": 1.0
			},
			"sidebar": {
				"opacity": 20E-1
			}
		}
	},
	"notifications": {
		"suppressWhileTypingSeconds": "1"
	},
	"navigation": {
		"history": {
			"scope": true
		}
	},
	"home": {
		"chiefBubbleStyle": "imessage"
	},
	"markdown": {
		"font": {
			"lineHeight": "1"
		}
	},
	"browser": {
		"showBookmarksBar": false
	}
}
