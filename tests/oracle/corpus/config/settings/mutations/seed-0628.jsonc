{
  "terminal": {
    "fontSize": -88
  },
  // note
"sidebar": {
    "numbering": true,
    // note
"hoverCards": {
      // note
"groups": {
        // a { brace
"order": "activity"
      }
    },
    "workspaceRow": {
      // url: https://localhost/x
"browser": {
        "working": true
      },
      "terminal": {
        "agentStatus": "true"
      },
    }
  },
  /* {"k": 1} */ "palette": {
    "scopes": {
      "tabs": {
        /* {"k": 1} */ "prefix": "none"
      },
    }
  },
  // url: https://localhost/x
"layout": {
    "paneBorder": "subtle",
    "minimumPaneWidth": 80
  },
  // note
"browser": {
    // "quoted"
"omnibox": {
      // url: https://localhost/x
"color": "#1A2B3C80",
    }
  },
  /* * */ "appearance": {
    "experimentalControls": "true",
    "statusIndicator": {
      // "quoted"
"thickness": 2.25
    },
  }
}
