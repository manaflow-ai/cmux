{
    // note
"browser": {
        // a { brace
"hibernation": "moderate"
    },
    "markdown": {
        // "quoted"
"code": {
            "family": null
        }
    },
    "notifications": {
        /* // inside */ "attention": {
            "moveToTop": true,
        },
    },
    "sidebar": {
        /* // inside */ "hoverCards": {
            "layout": "log"
        },
        /* * */ "workspaceRow": {
            "agent": {
                "log": "true"
            },
            "mixed": {
                "tabCount": false
            }
        }
    },
    /* block */ "agentPane": {
        /* {"k": 1} */ "links": {
            "outsideRoots": "open"
        }
    },
    "appearance": {
        "chromeStyle": 1,
        // url: https://localhost/x
"paneBackgrounds": "shared"
    },
    /* block */ "layout": {
        "frameOrientation": "rowMajor",
    }
, "oracle": 1e400}
