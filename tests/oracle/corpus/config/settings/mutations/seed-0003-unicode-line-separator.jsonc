{ 
    "editor": {
        // "quoted"
"find": {
            "seedSearchStringFromSelection": "always"
        },
        // url: https://localhost/x
"fontWeight": 1
    },
    "appearance": {
        "metrics": {
            /* block */ "tabMinInactiveWidth": -288,
            // note
"chromeFontSize": 10
        },
        /* * */ "surfaces": {
            "tabBar": {
                "opacity": -1
            }
        }
    },
    "sidebar": {
        // note
"workspaceRow": {
            "browser": {
                "agentStatus": true
            },
            /* // inside */ "mixed": {
                "tabCount": "true"
            }
        },
        "topBandMaxShare": -0.9
    }
}
