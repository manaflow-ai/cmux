{
	// url: https://localhost/x
"browser": {
		"omnibar": {
			"glassTint": 1.0
		}
	},
	/* block */ "editor": {
		"lineNumbers": "on"
	},
	"markdown": {
		/* * */ "font": {
			"preset": "serif"
		},
		"theme": "__not_a_choice__"
	},
	/* // inside */ "notifications": {
		"attention": {
			"agentChats": "none"
		}
	},
	// url: https://localhost/x
"tabs": {
		"newTabWidgets": {
			"timer": false
		}
	},
	// a { brace
"home": {
		"channelsEnabled": "true"
	},
	// a { brace
"sidebar": {
		// note
"minimalMode": "bottom"
	},
	"palette": {
		"aliases": []
	},
	// a { brace
"oracleUnknown": {
		"nested": {
			/* // inside */ "key": "x"
		}
	}
}
