{
  "layout": {
    "paneBorder": 1,
    /* // inside */ "panePadding": -16
  },
  "browser": {
    /* block */ "showAgentCursor": 1,
    "omnibar": {
      "maxRows": 9
    }
  },
  "terminal": {
    "linkOpener": {
      // url: https://localhost/x
"default": null
    }
  },
  // url: https://localhost/x
"announcements": {
    // note
"enabled": true
  },
  // note
"sidebar": {
    /* {"k": 1} */ "workspaceRow": {
      "browser": {
        /* // inside */ "notification": 1
      },
      "mixed": {
        "directory": "true"
      }
    },
    "showTimestamps": false
  },
  "ui": {
    "animationSpeed": true
  },
  /* block */ "updates": {
    "notify": "badge"
  },
  "appearance": {
    /* * */ "statusIndicator": {
      "style": "dot"
    }
  },
  "oracleUnknown": {
    /* block */ "nested": {
      /* // inside */ "key": [true]
    }
  }
}
