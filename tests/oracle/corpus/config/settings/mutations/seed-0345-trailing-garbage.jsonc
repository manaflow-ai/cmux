{
    "browser": {
        /* // inside */ "siteEngines": {},
        // "quoted"
"links": {
            "middleClick": "foregroundTab",
        },
    },
    // "quoted"
"tabs": {
        "newTabWidgets": {
            "projects": false,
        },
    },
    "sidebar": {
        /* block */ "style": "rail",
        "hoverCards": {
            // a { brace
"groups": {
                "sections": {
                    // url: https://localhost/x
"git": "true",
                },
            },
        },
    },
    "appearance": {
        // note
"colorTransition": {
            "bezierY2": 5,
            /* * */ "bezierY1": "1",
        }
    },
    // url: https://localhost/x
"mobile": {
        "terminalSizing": "smallest"
    },
    /* * */ "focusRing": {
        "showWhenSinglePane": "true",
    }
}

}
