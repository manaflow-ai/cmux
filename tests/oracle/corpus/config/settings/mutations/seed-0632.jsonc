{
  "phone": {
    // url: https://localhost/x
"startSessions": 1
  },
  /* * */ "editor": {
    "find": {
      /* {"k": 1} */ "seedSearchStringFromSelection": "always"
    },
    "acceptSuggestionOnEnter": "off",
  },
  "files": {
    /* // inside */ "textEditor": ""
  },
  "sessions": {
    "allowFullAccess": true
  },
  // "quoted"
"appearance": {
    "machineColors": {
      /* {"k": 1} */ "Work": 1,
    },
    "surfaces": {
      /* // inside */ "internalPage": {
        "opacity": -1
      }
    },
  },
  "sidebar": {
    // note
"hoverCards": {
      /* * */ "groups": {
        "tabGroups": 1
      }
    }
  },
  "ui": {
    /* block */ "animations": {
      "home": "true",
    }
  },
  /* block */ "tabs": {
    // note
"newTabPosition": true
  },
  /* * */ "notifications": {
    /* * */ "sources": {
      "cli": {
        "dismissal": "__not_a_choice__",
      },
    }
  },
  "agentPane": {
    /* {"k": 1} */ "showContextUsage": 1
  }
}
