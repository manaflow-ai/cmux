{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "pane-swap-error",
  "suite": "mcp",
  "title": "pane_swap: pane.swap: typed error on the standard fixture",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.pane-swap",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root",
    "the MCP server's own settings file turns it on (driver_mcp.py MCP_CONFIG)"
  ],
  "requires": [
    "resource_api",
    "mcp"
  ],
  "platforms": [
    "linux"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "pane-swap-error.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "fx-split",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id",
        "screen": "$step:fx-workspace#/value/screen_id",
        "pane": "$step:fx-workspace#/value/pane_id"
      },
      "args": {
        "method": "pane.split",
        "params": {
          "direction": "right"
        },
        "idempotencyKey": "pane-swap-error.fx-split"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "call",
      "op": "mcp",
      "target": {
        "machine": "current",
        "session": "current",
        "pane": "$step:fx-workspace#/value/pane_id"
      },
      "args": {
        "tool": "pane_swap",
        "arguments": {
          "pane": "$step:fx-workspace#/value/pane_id",
          "other_workspace": "$step:fx-workspace#/value/workspace_id",
          "other_screen": "$step:fx-workspace#/value/screen_id",
          "other_pane": "$step:fx-workspace#/value/pane_id",
          "idempotency_key": "pane-swap-error.call"
        }
      },
      "expect": {
        "outcome": "error",
        "error": "operation.failed",
        "errorDetails": {
          "reason": "cannot swap a pane with itself"
        }
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "the daemon-ops call as the MCP tool pane_swap; a pane swapped with itself: operation.failed, the split is unchanged"
    },
    {
      "id": "first-kept",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/screens/0/layout/root/first/pane_id",
        "equals": "$step:fx-workspace#/value/pane_id",
        "maxMs": 5000
      },
      "settleMaxMs": 5000
    },
    {
      "id": "second-kept",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/screens/0/layout/root/second/pane_id",
        "equals": "$step:fx-split#/value/pane_id",
        "maxMs": 5000
      },
      "settleMaxMs": 5000
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_mcp.py from daemon-ops/pane-swap-error (its twin: the same steps, the call through the resource API)",
    "generated by scripts/cmux-next/oracle/gen_daemon_ops.py from the catalog type of pane.swap (family layout)"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
