{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "pane-split-error",
  "suite": "mcp",
  "title": "pane_split: pane.split: typed error on the standard fixture",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.pane-split",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root",
    "the MCP server's own settings file turns it on (driver_mcp.py MCP_CONFIG)"
  ],
  "requires": [
    "resource_api",
    "mcp"
  ],
  "platforms": [
    "linux"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "pane-split-error.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "call",
      "op": "mcp",
      "target": {
        "machine": "current",
        "session": "current",
        "pane": "$step:fx-workspace#/value/pane_id"
      },
      "args": {
        "tool": "pane_split",
        "arguments": {
          "pane": "$step:fx-workspace#/value/pane_id",
          "direction": "down",
          "ratio": 1.0,
          "idempotency_key": "pane-split-error.call"
        }
      },
      "expect": {
        "outcome": "error",
        "error": "validation.invalid",
        "errorDetails": {
          "field": "pane.split.ratio"
        }
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "the daemon-ops call as the MCP tool pane_split; ratio 1 leaves no room for the old pane (0 < ratio < 1): validation.invalid, no split"
    },
    {
      "id": "no-split",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/screens/0/layout/root/kind",
        "equals": "leaf",
        "maxMs": 5000
      },
      "settleMaxMs": 5000
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_mcp.py from daemon-ops/pane-split-error (its twin: the same steps, the call through the resource API)",
    "generated by scripts/cmux-next/oracle/gen_daemon_ops.py from the catalog type of pane.split (family layout)"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
