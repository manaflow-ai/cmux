{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "column-update-ok",
  "suite": "mcp",
  "title": "column_update: column.update: success on the standard fixture",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.column-update",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root",
    "the MCP server's own settings file turns it on (driver_mcp.py MCP_CONFIG)"
  ],
  "requires": [
    "resource_api",
    "mcp"
  ],
  "platforms": [
    "linux"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "column-update-ok.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "viewport-split",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "pane": "$step:fx-workspace#/value/pane_id"
      },
      "args": {
        "method": "pane.split",
        "params": {
          "direction": "right",
          "viewport_width": 0.5
        },
        "idempotencyKey": "column-update-ok.viewport-split"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "read-layout",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "screen": "$step:fx-workspace#/value/screen_id"
      },
      "args": {
        "method": "screen.get",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "call",
      "op": "mcp",
      "target": {
        "machine": "current",
        "session": "current",
        "screen": "$step:fx-workspace#/value/screen_id"
      },
      "args": {
        "tool": "column_update",
        "arguments": {
          "screen": "$step:fx-workspace#/value/screen_id",
          "column": "$step:read-layout#/layout/root/columns/1/column_id",
          "dock": true,
          "edge": "right",
          "idempotency_key": "column-update-ok.call"
        }
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "the daemon-ops call as the MCP tool column_update; a rightward viewport split makes two columns; the second is docked to the right edge (mode docked by default) and the first stays free"
    },
    {
      "id": "docked",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/screens/0/layout/root/columns/1/dock",
        "equals": {
          "edge": "right",
          "mode": "docked"
        },
        "maxMs": 5000
      },
      "settleMaxMs": 5000
    },
    {
      "id": "first-free",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/screens/0/layout/root/columns/0/dock",
        "predicate": "absent",
        "maxMs": 5000
      },
      "settleMaxMs": 5000
    },
    {
      "id": "retry",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "screen": "$step:fx-workspace#/value/screen_id"
      },
      "args": {
        "method": "column.update",
        "params": {
          "column": "$step:read-layout#/layout/root/columns/1/column_id",
          "dock": true,
          "edge": "right"
        },
        "idempotencyKey": "column-update-ok.call"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "I10: step call again with its idempotency key; the daemon replays its reply, adds no journal record and changes no facet"
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_mcp.py from daemon-ops/column-update-ok (its twin: the same steps, the call through the resource API)",
    "generated by scripts/cmux-next/oracle/gen_daemon_ops.py from the catalog type of column.update (family layout)"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
