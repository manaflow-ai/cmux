{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "pane-split-ok",
  "suite": "mcp",
  "title": "pane_split: pane.split: success on the standard fixture",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.pane-split",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root",
    "the MCP server's own settings file turns it on (driver_mcp.py MCP_CONFIG)"
  ],
  "requires": [
    "resource_api",
    "mcp"
  ],
  "platforms": [
    "linux"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "pane-split-ok.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "call",
      "op": "mcp",
      "target": {
        "machine": "current",
        "session": "current",
        "pane": "$step:fx-workspace#/value/pane_id"
      },
      "args": {
        "tool": "pane_split",
        "arguments": {
          "pane": "$step:fx-workspace#/value/pane_id",
          "direction": "down",
          "ratio": 0.25,
          "idempotency_key": "pane-split-ok.call"
        }
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "the daemon-ops call as the MCP tool pane_split; a downward split at ratio 0.25 gives the new pane a quarter: a vertical split whose first child is the old pane at ratio 0.75 (the layout ratio is the first child's share)"
    },
    {
      "id": "split-root",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/screens/0/layout/root/kind",
        "equals": "split",
        "maxMs": 5000
      },
      "settleMaxMs": 5000
    },
    {
      "id": "vertical",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/screens/0/layout/root/direction",
        "equals": "vertical",
        "maxMs": 5000
      },
      "settleMaxMs": 5000
    },
    {
      "id": "ratio",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/screens/0/layout/root/ratio",
        "equals": 0.75,
        "maxMs": 5000
      },
      "settleMaxMs": 5000
    },
    {
      "id": "old-first",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/screens/0/layout/root/first/pane_id",
        "equals": "$step:fx-workspace#/value/pane_id",
        "maxMs": 5000
      },
      "settleMaxMs": 5000
    },
    {
      "id": "new-second",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/screens/0/layout/root/second/pane_id",
        "equals": "$step:call#/value/pane_id",
        "maxMs": 5000
      },
      "settleMaxMs": 5000
    },
    {
      "id": "retry",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "pane": "$step:fx-workspace#/value/pane_id"
      },
      "args": {
        "method": "pane.split",
        "params": {
          "direction": "down",
          "ratio": 0.25
        },
        "idempotencyKey": "pane-split-ok.call"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "I10: step call again with its idempotency key; the daemon replays its reply, adds no journal record and changes no facet"
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_mcp.py from daemon-ops/pane-split-ok (its twin: the same steps, the call through the resource API)",
    "generated by scripts/cmux-next/oracle/gen_daemon_ops.py from the catalog type of pane.split (family layout)"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
