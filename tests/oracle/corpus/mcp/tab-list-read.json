{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "tab-list-read",
  "suite": "mcp",
  "title": "tab_list: the read tab.list through MCP equals the resource API's reply",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "mcp.tab-list",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root",
    "the MCP server's own settings file turns it on (driver_mcp.py MCP_CONFIG)"
  ],
  "requires": [
    "resource_api",
    "mcp"
  ],
  "platforms": [
    "linux"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "tab-list-read.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "call",
      "op": "mcp",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id",
        "screen": "$step:fx-workspace#/value/screen_id",
        "pane": "$step:fx-workspace#/value/pane_id"
      },
      "args": {
        "tool": "tab_list",
        "arguments": {
          "workspace": "$step:fx-workspace#/value/workspace_id",
          "screen": "$step:fx-workspace#/value/screen_id",
          "pane": "$step:fx-workspace#/value/pane_id"
        }
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "the read as the MCP tool tab_list"
    },
    {
      "id": "resource",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id",
        "screen": "$step:fx-workspace#/value/screen_id",
        "pane": "$step:fx-workspace#/value/pane_id"
      },
      "args": {
        "method": "tab.list",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok",
        "result": "$step:call#/items"
      },
      "checkpoint": [
        "settled"
      ],
      "note": "the read again through the resource API: its reply is the MCP result (an array read's items), so the MCP receipt is the daemon's own value"
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_mcp.py from the catalog type of tab.list on gen_daemon_ops.py's fixture",
    "the MCP read changes no daemon facet (readOnly), and its result is the resource API's reply"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
