{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "screen-layout-undo-ok",
  "suite": "mcp",
  "title": "screen_layout_undo: screen.layout.undo: success on the standard fixture",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.screen-layout-undo",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root",
    "the MCP server's own settings file turns it on (driver_mcp.py MCP_CONFIG)"
  ],
  "requires": [
    "resource_api",
    "mcp"
  ],
  "platforms": [
    "linux"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "screen-layout-undo-ok.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "zoom",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "pane": "$step:fx-workspace#/value/pane_id"
      },
      "args": {
        "method": "pane.zoom",
        "params": {
          "enabled": true
        },
        "idempotencyKey": "screen-layout-undo-ok.zoom"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "call",
      "op": "mcp",
      "target": {
        "machine": "current",
        "session": "current",
        "screen": "$step:fx-workspace#/value/screen_id"
      },
      "args": {
        "tool": "screen_layout_undo",
        "arguments": {
          "screen": "$step:fx-workspace#/value/screen_id",
          "idempotency_key": "screen-layout-undo-ok.call"
        }
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "the daemon-ops call as the MCP tool screen_layout_undo; undo takes back the screen's last layout change, a zoom"
    },
    {
      "id": "unzoomed",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/panes/0/zoomed",
        "equals": false,
        "maxMs": 5000
      },
      "settleMaxMs": 5000
    },
    {
      "id": "retry",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "screen": "$step:fx-workspace#/value/screen_id"
      },
      "args": {
        "method": "screen.layout.undo",
        "params": {},
        "idempotencyKey": "screen-layout-undo-ok.call"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "I10: step call again with its idempotency key; the daemon replays its reply, adds no journal record and changes no facet"
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_mcp.py from daemon-ops/screen-layout-undo-ok (its twin: the same steps, the call through the resource API)",
    "generated by scripts/cmux-next/oracle/gen_daemon_ops.py from the catalog type of screen.layout.undo (family layout)"
  ],
