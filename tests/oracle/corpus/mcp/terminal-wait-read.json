{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "terminal-wait-read",
  "suite": "mcp",
  "title": "terminal_wait: the read terminal.wait through MCP equals the resource API's reply",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "mcp.terminal-wait",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root",
    "the MCP server's own settings file turns it on (driver_mcp.py MCP_CONFIG)"
  ],
  "requires": [
    "resource_api",
    "mcp"
  ],
  "platforms": [
    "linux"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "terminal-wait-read.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "fx-printed",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "pane": "$step:fx-workspace#/value/pane_id"
      },
      "args": {
        "method": "pane.run",
        "params": {
          "argv": [
            "/bin/sh",
            "-c",
            "printf oracle; exec cat"
          ]
        },
        "idempotencyKey": "terminal-wait-read.fx-printed"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "note": "a terminal that prints one fixed text, then waits on its input"
    },
    {
      "id": "fx-printed-seen",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:fx-printed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.wait",
        "params": {
          "pattern": "oracle",
          "timeout_ms": "10000"
        }
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      },
      "checkpoint": [
        "settled"
      ],
      "note": "the text is on the screen, so the read sees the command's whole output"
    },
    {
      "id": "call",
      "op": "mcp",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:fx-printed#/value/terminal_id"
      },
      "args": {
        "tool": "terminal_wait",
        "arguments": {
          "terminal": "$step:fx-printed#/value/terminal_id",
          "pattern": "oracle",
          "timeout_ms": "10000"
        }
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "the read as the MCP tool terminal_wait"
    },
    {
      "id": "resource",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:fx-printed#/value/terminal_id"
      },
      "args": {
        "method": "terminal.wait",
        "params": {
          "pattern": "oracle",
          "timeout_ms": "10000"
        }
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok",
        "result": "$step:call#"
      },
      "checkpoint": [
        "settled"
      ],
      "note": "the read again through the resource API: its reply is the MCP result (an array read's items), so the MCP receipt is the daemon's own value"
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_mcp.py from the catalog type of terminal.wait on gen_daemon_ops.py's fixture",
    "the MCP read changes no daemon facet (readOnly), and its result is the resource API's reply"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
