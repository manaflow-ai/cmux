{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "pane-create-ok",
  "suite": "mcp",
  "title": "pane_create: pane.create: success on the standard fixture",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.pane-create",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root",
    "the MCP server's own settings file turns it on (driver_mcp.py MCP_CONFIG)"
  ],
  "requires": [
    "resource_api",
    "mcp"
  ],
  "platforms": [
    "linux"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "pane-create-ok.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "call",
      "op": "mcp",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id",
        "screen": "$step:fx-workspace#/value/screen_id"
      },
      "args": {
        "tool": "pane_create",
        "arguments": {
          "workspace": "$step:fx-workspace#/value/workspace_id",
          "screen": "$step:fx-workspace#/value/screen_id",
          "idempotency_key": "pane-create-ok.call"
        }
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "the daemon-ops call as the MCP tool pane_create; a new pane splits the screen: the fixture pane stays first, the new one is second and active"
    },
    {
      "id": "new-second",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/screens/0/layout/root/second/pane_id",
        "equals": "$step:call#/value/pane_id",
        "maxMs": 5000
      },
      "settleMaxMs": 5000
    },
    {
      "id": "new-active",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/screens/0/layout/active_pane_id",
        "equals": "$step:call#/value/pane_id",
        "maxMs": 5000
      },
      "settleMaxMs": 5000
    },
    {
      "id": "old-first",
      "op": "settle",
      "waitFor": {
        "pointer": "/daemon/session/screens/0/layout/root/first/pane_id",
        "equals": "$step:fx-workspace#/value/pane_id",
        "maxMs": 5000
      },
      "settleMaxMs": 5000
    },
    {
      "id": "retry",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id",
        "screen": "$step:fx-workspace#/value/screen_id"
      },
      "args": {
        "method": "pane.create",
        "params": {},
        "idempotencyKey": "pane-create-ok.call"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "I10: step call again with its idempotency key; the daemon replays its reply, adds no journal record and changes no facet"
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_mcp.py from daemon-ops/pane-create-ok (its twin: the same steps, the call through the resource API)",
    "generated by scripts/cmux-next/oracle/gen_daemon_ops.py from the catalog type of pane.create (family layout)"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
