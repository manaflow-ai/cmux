{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "terminal-renderer-grant-create-ok",
  "suite": "streams",
  "title": "terminal.renderer_grant.create: the connection mints a short renderer grant for the fixture terminal",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "streams.terminal-renderer-grant-create",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root",
    "one SDK connection per case connection: main, renderer"
