{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "session-events-ok",
  "suite": "streams",
  "title": "session.events: open the stream on one connection, change the session on another",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "streams.session-events",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root",
    "one SDK connection per case connection: main, watch"
  ],
  "requires": [
    "resource_api"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "session-events-ok.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "call",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "session.events",
        "scope": "connection",
        "connection": "watch"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "stream_opened"
      },
      "checkpoint": [
        "before",
        "settled"
      ]
    },
    {
      "id": "rename",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.rename",
        "params": {
          "name": "streamed"
        },
        "idempotencyKey": "session-events-ok.rename"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "settle",
      "op": "settle",
      "note": "the last cut: I8 folds every open log up to it"
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_streams.py from the catalog entry of session.events (stream_open)",
    "I8: the watch connection's session.events log, folded, equals the daemon facet at every checkpoint after it opened, the rename included"
  ],
  "teardown": [
    "close every case connection",
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
