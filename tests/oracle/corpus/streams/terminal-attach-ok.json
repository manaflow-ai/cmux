{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "terminal-attach-ok",
  "suite": "streams",
  "title": "terminal.attach: attach a viewer to the fixture terminal",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "streams.terminal-attach",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root",
    "one SDK connection per case connection: main, viewer"
  ],
  "requires": [
    "resource_api"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "terminal-attach-ok.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "call",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:fx-workspace#/value/terminal_id"
      },
      "args": {
        "method": "terminal.attach",
        "params": {
          "cols": 80,
          "rows": 24
        },
        "scope": "connection",
        "connection": "viewer"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "view_attachment_stream_opened"
      },
      "checkpoint": [
        "before",
        "settled"
      ]
    },
    {
      "id": "settle",
      "op": "settle",
      "note": "the last cut: I8 folds every open log up to it"
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_streams.py from the catalog entry of terminal.attach (stream_open)",
    "the viewer client lists the terminal in attached_terminal_ids"
  ],
  "teardown": [
    "close every case connection",
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
