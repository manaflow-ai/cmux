{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "request-cancel-ok",
  "suite": "streams",
  "title": "request.cancel: cancel in flight: a terminal.wait that cannot match, canceled before it answers",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "streams.request-cancel",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root",
    "one SDK connection per case connection: main, waiter"
  ],
  "requires": [
    "resource_api"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "request-cancel-ok.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "wait",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "terminal": "$step:fx-workspace#/value/terminal_id"
      },
      "readOnly": true,
      "args": {
        "method": "terminal.wait",
        "params": {
          "pattern": "oracle-pattern-never-printed"
        },
        "connection": "waiter",
        "inFlight": true
      },
      "expect": {
        "outcome": "ok"
      },
      "note": "never matches and has no timeout: only the cancel ends it"
    },
    {
      "id": "call",
      "op": "resource.call",
      "args": {
        "method": "request.cancel",
        "params": {
          "request_id": "$step:wait#/request_id"
        },
        "scope": "connection",
        "connection": "waiter"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "request_cancel_result",
        "result": {
          "canceled": true
        }
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "canceled true: the cancel wins against a wait that cannot complete"
    },
    {
      "id": "settle",
      "op": "settle",
      "note": "the last cut: I8 folds every open log up to it"
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_streams.py from the catalog entry of request.cancel (connection_control)",
    "the wait sends no response after the cancel's confirmation"
  ],
  "teardown": [
    "close every case connection",
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
