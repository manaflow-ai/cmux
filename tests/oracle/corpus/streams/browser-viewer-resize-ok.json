{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "browser-viewer-resize-ok",
  "suite": "streams",
  "title": "browser.viewer.resize: resize during attach: the browser viewer resizes its own attachment",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "streams.browser-viewer-resize",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root",
    "one SDK connection per case connection: main, viewer",
    "a cmux-browser provider attached to the case daemon (the daemon launches no browser)"
  ],
  "requires": [
    "resource_api",
    "chromium"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "browser-viewer-resize-ok.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "fx-browser",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id",
        "screen": "$step:fx-workspace#/value/screen_id",
        "pane": "$step:fx-workspace#/value/pane_id"
      },
      "args": {
        "method": "tab.create_browser",
        "params": {
          "url": "about:blank"
        },
        "idempotencyKey": "browser-viewer-resize-ok.fx-browser"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "attach",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "browser": "$step:fx-browser#/value/browser_id"
      },
      "args": {
        "method": "browser.attach",
        "params": {
          "width_px": 800,
          "height_px": 600
        },
        "scope": "connection",
        "connection": "viewer"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "view_attachment_stream_opened"
      }
    },
    {
      "id": "call",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "browser": "$step:fx-browser#/value/browser_id"
      },
      "args": {
        "method": "browser.viewer.resize",
        "params": {
          "attachment_lease": "$step:attach#/attachment_lease",
          "width_px": 1024,
          "height_px": 768
        },
        "scope": "connection",
        "connection": "viewer"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "browser_viewer_resize_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ]
    },
    {
      "id": "settle",
      "op": "settle",
      "note": "the last cut: I8 folds every open log up to it"
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_streams.py from the catalog entry of browser.viewer.resize (connection_control)"
  ],
  "teardown": [
    "close every case connection",
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
