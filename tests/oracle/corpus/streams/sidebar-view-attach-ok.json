{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "sidebar-view-attach-ok",
  "suite": "streams",
  "title": "sidebar_view.attach: attach to the fixture sidebar view",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "streams.sidebar-view-attach",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root",
    "one SDK connection per case connection: main, viewer"
  ],
  "requires": [
    "resource_api"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "steps": [
    {
      "id": "fx-sidebar-view",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "sidebar_view.ensure",
        "params": {
          "cols": 80,
          "rows": 24
        },
        "idempotencyKey": "sidebar-view-attach-ok.fx-sidebar-view"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "call",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "sidebar_view": "$step:fx-sidebar-view#/value/id"
      },
      "args": {
        "method": "sidebar_view.attach",
        "scope": "connection",
        "connection": "viewer"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "stream_opened"
      },
      "checkpoint": [
        "before",
        "settled"
      ]
    },
    {
      "id": "settle",
      "op": "settle",
      "note": "the last cut: I8 folds every open log up to it"
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/gen_streams.py from the catalog entry of sidebar_view.attach (stream_open)"
  ],
  "teardown": [
    "close every case connection",
    "stop the case daemon",
    "verify the socket and state root are gone"
  ]
}
