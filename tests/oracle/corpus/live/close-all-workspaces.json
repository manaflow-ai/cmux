  "invariants": [
    "converted from scripts/cmux-next/close-all-workspaces-live.py (p15-oracle-225); the script stays, and scripts/cmux-next/oracle/live-map.json links it to this case",
    "the refused script and CLI runs change no workspace: their settled checkpoints equal the ones before them",
    "the palette's top rows for the query are workspace.closeAll and workspace.closeAllInAllWindows",
    "the person's close leaves the window open (the store's home workspace never closes) and its settled overlays stack holds one toast",
    "the last close leaves no listed workspace in any window"
  ],
  "teardown": [
    "the driver quits the tagged app it launched and ends the tag's daemons (TagTeardown)",
    "the driver resets the session before the next case (app_reset.py)"
  ],
  "untested": [
    "the close question while a terminal runs `sleep` and its Cancel: no facet holds a terminal's foreground program, so no step can wait until sleep runs",
    "the toast's Undo: debug.toast undo has no case step and the toast's button needs a pointer",
    "`cmux mcp serve` tools/list: driver_app.py's mcp step sends tools/call only"
  ]
