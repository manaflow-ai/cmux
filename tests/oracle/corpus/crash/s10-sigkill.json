{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "s10-sigkill",
  "suite": "crash",
  "title": "Crash walk 10: sigkill after daemon-ops/browser-devices-add-custom-error step call, then the last acknowledged state",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.browser-devices-add-custom",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api",
    "restart"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "allow_crashes": [
    {
      "kind": "daemon",
      "reason": "the crash walk kills the session owner on purpose (SIGKILL)",
      "steps": [
        "crash-kill"
      ]
    }
  ],
  "steps": [
    {
      "id": "call",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "browser.devices.add_custom",
        "params": {
          "device": {
            "title": "Oracle Phone",
            "type": "phone",
            "screen": {
              "device-pixel-ratio": 11,
              "vertical": {
                "width": 390,
                "height": 844
              },
              "horizontal": {
                "width": 844,
                "height": 390
              }
            },
            "capabilities": [
              "touch",
              "mobile"
            ],
            "user-agent": "Mozilla/5.0 (Linux; Android 14; Oracle Phone) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/%s Mobile Safari/537.36"
          }
        },
        "idempotencyKey": "browser-devices-add-custom-error.call"
      },
      "expect": {
        "outcome": "error",
        "error": "validation.invalid"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "device-pixel-ratio 11 is outside Chrome's limit (above 0 and at most 10); the device is not stored"
    },
    {
      "id": "crash-acked",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "session.snapshot",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "crash-kill",
      "op": "kill",
      "target": {
        "process": "daemon"
      },
      "args": {
        "signal": "KILL"
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a SIGKILL sends no request; the recovered state is its result"
      }
    },
    {
      "id": "crash-recover",
      "op": "restart",
      "target": {
        "process": "daemon"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "identify"
      }
    },
    {
      "id": "crash-recovered",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "session.snapshot",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok",
        "result": "$step:crash-acked#",
        "resultExcept": [
          "/cursor",
          "/session/generation",
          "/session/revision",
          "/terminals/*/stream_revision",
          "/terminals/*/extra",
          "/clients"
        ]
      }
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/crash_walks.py (p15-oracle-207) from seed 10: walk daemon-ops/browser-devices-add-custom-error, sigkill after step call",
    "crash-recovered replies what crash-acked replied, but for what a new daemon generation changes: a restart on the same root after the kill keeps every acknowledged mutation"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ],
  "untested": [
    "the state between the kill and the last acknowledged step (an unacknowledged call may or may not survive; this case sends none)"
  ]
}
