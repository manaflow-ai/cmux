{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "s1608-owner-panic-old",
  "suite": "crash",
  "title": "Crash walk 1608: owner-panic after daemon-ops/sidebar-view-reload-ok step write-config, then the last acknowledged state",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.sidebar-view-reload",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api",
    "restart"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "allow_crashes": [
    {
      "kind": "daemon",
      "reason": "the crash walk kills the session owner on purpose (SIGKILL)",
      "steps": [
        "crash-kill"
      ]
    }
  ],
  "steps": [
    {
      "id": "write-config",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "config",
          "argv": [
            "/bin/sh",
            "-c",
            "printf '%s\\n' \"$0\" > \"$CMUX_TUI_CONFIG\"",
            "{\"sidebar\":{\"plugin\":{\"command\":[\"/bin/cat\"]}}}"
          ]
        },
        "idempotencyKey": "sidebar-view-reload-ok.write-config"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "crash-acked",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "session.snapshot",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "crash-kill",
      "op": "kill",
      "target": {
        "process": "daemon"
      },
      "args": {
        "signal": "KILL"
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a SIGKILL sends no request; the recovered state is its result"
      }
    },
    {
      "id": "crash-recover",
      "op": "restart",
      "target": {
        "process": "daemon"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "identify"
      }
    },
    {
      "id": "crash-recovered",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "session.snapshot",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok",
        "result": "$step:crash-acked#",
        "resultExcept": [
          "/cursor",
          "/session/generation",
          "/session/revision",
          "/terminals/*/stream_revision",
          "/terminals/*/extra",
          "/clients"
        ]
      }
    },
    {
      "id": "crash-replay",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "config",
          "argv": [
            "/bin/sh",
            "-c",
            "printf '%s\\n' \"$0\" > \"$CMUX_TUI_CONFIG\"",
            "{\"sidebar\":{\"plugin\":{\"command\":[\"/bin/cat\"]}}}"
          ]
        },
        "idempotencyKey": "sidebar-view-reload-ok.write-config"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result",
        "result": "$step:write-config#",
        "resultExcept": [
          "/generation",
          "/replayed"
        ]
      }
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/crash_walks.py (p15-oracle-207) from seed 1608: walk daemon-ops/sidebar-view-reload-ok, owner-panic after step write-config",
    "crash-recovered replies what crash-acked replied, but for what a new daemon generation changes: a restart on the same root after the kill keeps every acknowledged mutation",
    "crash-replay replies the receipt the daemon acknowledged before the kill (I10 across a crash)"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ],
  "untested": [
    "the state between the kill and the last acknowledged step (an unacknowledged call may or may not survive; this case sends none)",
    "the recovering owner's worker-thread panic (CMUX_TUI_TEST_OWNER_PANIC=thread): only crash_walks.py run and replay set it; oracle.py runs this case as a SIGKILL walk"
  ]
