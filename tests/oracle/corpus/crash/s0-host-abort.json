{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "s0-host-abort",
  "suite": "crash",
  "title": "Crash walk 0: host-abort after daemon-ops/workspace-focus-error step fx-workspace, then the last acknowledged state",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.workspace-focus",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api",
    "restart"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "allow_crashes": [
    {
      "kind": "daemon",
      "reason": "the crash walk kills the session owner on purpose (SIGKILL)",
      "steps": [
        "crash-kill"
      ]
    },
    {
      "kind": "holder",
      "reason": "the crash walk aborts the terminal host on purpose (its crash seam, SIGABRT)",
      "steps": [
        "crash-abort"
      ]
    }
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "workspace-focus-error.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "crash-acked",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "session.snapshot",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "crash-abort",
      "op": "kill",
      "target": {
        "process": "holder"
      },
      "args": {
        "signal": "ABRT"
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a kill sends no request; its reply is the daemon's record of the ended host"
      }
    },
    {
      "id": "crash-kill",
      "op": "kill",
      "target": {
        "process": "daemon"
      },
      "args": {
        "signal": "KILL"
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a SIGKILL sends no request; the recovered state is its result"
      }
    },
    {
      "id": "crash-recover",
      "op": "restart",
      "target": {
        "process": "daemon"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "identify"
      },
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/lifecycle",
        "equals": "running",
        "maxMs": 15000
      }
    },
    {
      "id": "crash-recovered",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "session.snapshot",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok",
        "result": "$step:crash-acked#",
        "resultExcept": [
          "/cursor",
          "/session/generation",
          "/session/revision",
          "/terminals/*/stream_revision",
          "/terminals/*/extra",
          "/clients"
        ]
      }
    },
    {
      "id": "crash-replay",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "workspace-focus-error.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result",
        "result": "$step:fx-workspace#",
        "resultExcept": [
          "/generation",
          "/replayed"
        ]
      }
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/crash_walks.py (p15-oracle-207) from seed 0: walk daemon-ops/workspace-focus-error, host-abort after step fx-workspace",
    "crash-recovered replies what crash-acked replied, but for what a new daemon generation changes: a restart on the same root after the kill keeps every acknowledged mutation",
    "crash-replay replies the receipt the daemon acknowledged before the kill (I10 across a crash)"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ],
  "untested": [
    "the state between the kill and the last acknowledged step (an unacknowledged call may or may not survive; this case sends none)"
  ]
}
