{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "s5-owner-panic",
  "suite": "crash",
  "title": "Crash walk 5: owner-panic after daemon-ops/workspace-open-url-ok step retry, then the last acknowledged state",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "daemon-ops.workspace-open-url",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": [
    "hermetic state root",
    "no other cmux-tui on the state root"
  ],
  "requires": [
    "resource_api",
    "restart"
  ],
  "switches": [
    "terminal-holder"
  ],
  "platforms": [
    "linux",
    "mac"
  ],
  "allow_crashes": [
    {
      "kind": "daemon",
      "reason": "the crash walk kills the session owner on purpose (SIGKILL)",
      "steps": [
        "crash-kill"
      ]
    }
  ],
  "steps": [
    {
      "id": "fx-workspace",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "workspace.create",
        "params": {
          "initial_content": "terminal",
          "name": "oracle"
        },
        "idempotencyKey": "workspace-open-url-ok.fx-workspace"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      }
    },
    {
      "id": "call",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.open_url",
        "params": {
          "url": "about:blank"
        },
        "idempotencyKey": "workspace-open-url-ok.call"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "every required field from its catalog type"
    },
    {
      "id": "retry",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.open_url",
        "params": {
          "url": "about:blank"
        },
        "idempotencyKey": "workspace-open-url-ok.call"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result"
      },
      "checkpoint": [
        "before",
        "settled"
      ],
      "note": "I10: step call again with its idempotency key; the daemon replays its reply, adds no journal record and changes no facet"
    },
    {
      "id": "crash-acked",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "session.snapshot",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "id": "crash-kill",
      "op": "kill",
      "target": {
        "process": "daemon"
      },
      "args": {
        "signal": "KILL"
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a SIGKILL sends no request; the recovered state is its result"
      }
    },
    {
      "id": "crash-recover",
      "op": "restart",
      "target": {
        "process": "daemon"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "identify"
      },
      "waitFor": {
        "pointer": "/daemon/session/terminals/0/lifecycle",
        "equals": "running",
        "maxMs": 15000
      }
    },
    {
      "id": "crash-recovered",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current"
      },
      "args": {
        "method": "session.snapshot",
        "params": {}
      },
      "readOnly": true,
      "expect": {
        "outcome": "ok",
        "result": "$step:crash-acked#",
        "resultExcept": [
          "/cursor",
          "/session/generation",
          "/session/revision",
          "/terminals/*/stream_revision",
          "/terminals/*/extra",
          "/clients"
        ]
      }
    },
    {
      "id": "crash-replay",
      "op": "resource.call",
      "target": {
        "machine": "current",
        "session": "current",
        "workspace": "$step:fx-workspace#/value/workspace_id"
      },
      "args": {
        "method": "workspace.open_url",
        "params": {
          "url": "about:blank"
        },
        "idempotencyKey": "workspace-open-url-ok.call"
      },
      "expect": {
        "outcome": "ok",
        "receipt": "mutation_result",
        "result": "$step:retry#",
        "resultExcept": [
          "/generation",
          "/replayed"
        ]
      }
    }
  ],
  "invariants": [
    "generated by scripts/cmux-next/oracle/crash_walks.py (p15-oracle-207) from seed 5: walk daemon-ops/workspace-open-url-ok, owner-panic after step retry",
    "crash-recovered replies what crash-acked replied, but for what a new daemon generation changes: a restart on the same root after the kill keeps every acknowledged mutation",
    "crash-replay replies the receipt the daemon acknowledged before the kill (I10 across a crash)"
  ],
  "teardown": [
    "stop the case daemon",
    "verify the socket and state root are gone"
  ],
  "untested": [
    "the state between the kill and the last acknowledged step (an unacknowledged call may or may not survive; this case sends none)",
    "the recovering owner's worker-thread panic (CMUX_TUI_TEST_OWNER_PANIC=thread): only crash_walks.py run and replay set it; oracle.py runs this case as a SIGKILL walk"
  ]
}
