{
 "$schema": "../../../../schemas/oracle/case-v1.schema.json",
 "corpusVersion": 1,
 "id": "new-workspace",
 "suite": "tui",
 "title": "prefix W opens a workspace",
 "surface": "cmux-tui",
 "source": {
  "repo": "manaflow-ai/cmux",
  "ref": "$RUN",
  "artifact": "$RUN"
 },
 "environment": {},
 "fixture": {
  "seed": "tui-new-workspace",
  "network": "offline",
  "clock": "fixed"
 },
 "preconditions": [
  "cmux-tui attach on a PTY owned by driver_tui.py"
 ],
 "requires": [
  "tui"
 ],
 "platforms": [
  "linux"
 ],
 "steps": [
  {
   "id": "act",
   "op": "tui.key",
   "target": {
    "session": "current"
   },
   "args": {
    "keys": [
     "ctrl+b",
     "shift+w"
    ]
   },
   "expect": {
    "outcome": "ok",
    "noReceiptReason": "a key press has no receipt: its effect is the settled daemon facet and screen"
   },
   "checkpoint": [
    "settled"
   ],
   "waitFor": {
    "pointer": "/daemon/session/workspaces",
    "predicate": {
     "op": "lengthEquals",
     "value": 2
    },
    "maxMs": 10000
   }
  }
 ],
 "invariants": [],
 "teardown": [
  "hang up the TUI's terminal",
  "stop the case daemon"
 ]
}
