{
 "$schema": "../../../../schemas/oracle/case-v1.schema.json",
 "corpusVersion": 1,
 "id": "show-shortcuts",
 "suite": "tui",
 "title": "prefix ? shows the shortcut overlay (its turn checkpoint); Escape closes it",
 "surface": "cmux-tui",
 "source": {
  "repo": "manaflow-ai/cmux",
  "ref": "$RUN",
  "artifact": "$RUN"
 },
 "environment": {},
 "fixture": {
  "seed": "tui-show-shortcuts",
  "network": "offline",
  "clock": "fixed"
 },
 "preconditions": [
  "cmux-tui attach on a PTY owned by driver_tui.py"
 ],
 "requires": [
  "tui"
 ],
 "platforms": [
  "linux"
 ],
 "steps": [
  {
   "id": "act",
   "op": "tui.key",
   "target": {
    "session": "current"
   },
   "args": {
    "keys": [
     "ctrl+b",
     "shift+/"
    ]
   },
   "expect": {
    "outcome": "ok",
    "noReceiptReason": "a key press has no receipt: its effect is the settled daemon facet and screen"
   },
   "checkpoint": [
    "before",
    "turn"
   ],
   "waitFor": {
    "pointer": "/tui/cursor/visible",
    "equals": false,
    "maxMs": 10000
   }
  },
  {
   "id": "close",
   "op": "tui.key",
   "target": {
    "session": "current"
   },
   "args": {
    "keys": [
     "escape"
    ]
   },
   "expect": {
    "outcome": "ok",
    "noReceiptReason": "a key press has no receipt: its effect is the settled daemon facet and screen"
   },
   "checkpoint": [
    "settled"
   ]
  }
 ],
 "invariants": [],
 "teardown": [
  "hang up the TUI's terminal",
  "stop the case daemon"
 ]
}
