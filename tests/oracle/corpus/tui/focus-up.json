{
 "$schema": "../../../../schemas/oracle/case-v1.schema.json",
 "corpusVersion": 1,
 "id": "focus-up",
 "suite": "tui",
 "title": "prefix k focuses the upper pane",
 "surface": "cmux-tui",
 "source": {
  "repo": "manaflow-ai/cmux",
  "ref": "$RUN",
  "artifact": "$RUN"
 },
 "environment": {},
 "fixture": {
  "seed": "tui-focus-up",
  "network": "offline",
  "clock": "fixed"
 },
 "preconditions": [
  "cmux-tui attach on a PTY owned by driver_tui.py"
 ],
 "requires": [
  "resource_api",
  "tui"
 ],
 "platforms": [
  "linux"
 ],
 "steps": [
  {
   "id": "fixture",
   "op": "resource.call",
   "readOnly": true,
   "args": {
    "method": "session.snapshot",
    "params": {}
   },
   "expect": {
    "outcome": "ok"
   }
  },
  {
   "id": "setup",
   "op": "resource.call",
   "target": {
    "machine": "current",
    "session": "current",
    "pane": "$step:fixture#/panes/0/id"
   },
   "args": {
    "method": "pane.split",
    "params": {
     "direction": "down"
    },
    "idempotencyKey": "tui.setup.pane.split"
   },
   "expect": {
    "outcome": "ok",
    "receipt": "mutation_result"
   },
   "waitFor": {
    "pointer": "/daemon/session/panes",
    "predicate": {
     "op": "lengthEquals",
     "value": 2
    },
    "maxMs": 10000
   }
  },
  {
   "id": "down",
   "op": "tui.key",
   "target": {
    "session": "current"
   },
   "args": {
    "keys": [
     "ctrl+b",
     "j"
    ]
   },
   "expect": {
    "outcome": "ok",
    "noReceiptReason": "a key press has no receipt: its effect is the settled daemon facet and screen"
   },
   "checkpoint": [
    "settled"
   ],
   "waitFor": {
    "pointer": "/tui/screenSha256",
    "predicate": "changed",
    "maxMs": 10000
   }
  },
  {
   "id": "act",
   "op": "tui.key",
   "target": {
    "session": "current"
   },
   "args": {
    "keys": [
     "ctrl+b",
     "k"
    ]
   },
   "expect": {
    "outcome": "ok",
    "noReceiptReason": "a key press has no receipt: its effect is the settled daemon facet and screen"
   },
   "checkpoint": [
    "settled"
   ],
   "waitFor": {
    "pointer": "/tui/screenSha256",
    "predicate": "changed",
    "maxMs": 10000
   }
  }
 ],
 "invariants": [],
 "teardown": [
  "hang up the TUI's terminal",
  "stop the case daemon"
 ]
}
