{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "sidebar-footer",
  "suite": "tours",
  "title": "Tour: Sidebar footer: the account control and Search on one line above the bottom margin",
  "priority": "P2",
  "surface": "cmux-next-native",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {
    "viewport": {
      "width": 1440,
      "height": 900
    }
  },
  "fixture": {
    "seed": "tours-sidebar-footer-v1",
    "network": "offline",
    "clock": "fixed",
    "agent": "mock"
  },
  "preconditions": [
    "private scratch config",
    "tagged bench build",
    "no unrelated app instance",
    "the main window is 1440 x 900 pt",
    "the launch has one workspace with one terminal (an empty saved session)"
  ],
  "requires": [
    "gui"
  ],
  "platforms": [
    "mac"
  ],
  "steps": [
    {
      "id": "01-launch-the-footer-at-compact-density",
      "op": "snapshot"
    },
    {
      "id": "02-comfortable-rows",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "settings",
          "set",
          "sidebar.density",
          "comfortable"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/settings/effectiveSha256",
        "predicate": "changed",
        "maxMs": 5000
      }
    },
    {
      "id": "03-expanded-rows",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "settings",
          "set",
          "sidebar.density",
          "expanded"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/settings/effectiveSha256",
        "predicate": "changed",
        "maxMs": 5000
      }
    },
    {
      "id": "04-back-to-compact-rows",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "settings",
          "set",
          "sidebar.density",
          "compact"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/settings/effectiveSha256",
        "predicate": "changed",
        "maxMs": 5000
      }
    }
  ],
  "invariants": [
    "each step's settled snapshot is the model state of the tour's picture of that step",
    "no step waits on a clock: each ends on its waitFor value or the settle barrier"
  ],
  "teardown": [
    "quit the tagged app the run started",
    "verify its debug socket is gone"
  ],
  "untested": [
    "pixels: the tour's screenshots and video (scripts/cmux-next/media/tour.py); a case compares model state, and its reviewed baseline stands in for each picture"
  ]
}
