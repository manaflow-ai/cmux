{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "launch-themes",
  "suite": "tours",
  "title": "Tour: Launch clip: three new themes",
  "priority": "P2",
  "surface": "cmux-next-native",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {
    "viewport": {
      "width": 1440,
      "height": 900
    }
  },
  "fixture": {
    "seed": "tours-launch-themes-v1",
    "network": "offline",
    "clock": "fixed",
    "agent": "mock"
  },
  "preconditions": [
    "private scratch config",
    "tagged bench build",
    "no unrelated app instance",
    "the main window is 1440 x 900 pt",
    "the launch has one workspace with one terminal (an empty saved session)"
  ],
  "requires": [
    "gui"
  ],
  "platforms": [
    "mac"
  ],
  "steps": [
    {
      "id": "setup-01-appearance-theme",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "settings",
          "set",
          "appearance.theme",
          "Soft Blue"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/settings/effectiveSha256",
        "predicate": "changed",
        "maxMs": 5000
      },
      "note": "the tour launches with this setting; case-v1 has no launch config"
    },
    {
      "id": "01-launch",
      "op": "settle",
      "settleMaxMs": 10000
    },
    {
      "id": "02-workspace-infra",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "workspace",
          "new",
          "--name",
          "infra"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/terminals/list/1/attach",
        "equals": "attached",
        "maxMs": 5000
      }
    },
    {
      "id": "03-workspace-docs-site",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "workspace",
          "new",
          "--name",
          "docs-site"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/terminals/list/2/attach",
        "equals": "attached",
        "maxMs": 5000
      }
    },
    {
      "id": "04-workspace-app",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "workspace",
          "new",
          "--name",
          "app"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/terminals/list/3/attach",
        "equals": "attached",
        "maxMs": 5000
      }
    },
    {
      "id": "05-a-shell-in-app",
      "op": "cli",
      "target": {
        "session": "current"
      },
      "args": {
        "argv": [
          "workspace",
          "name:app",
          "screen",
          "current",
          "pane",
          "current",
          "tab",
          "current",
          "terminal",
          "current",
          "write",
          "--text",
          "clear; printf '%s\\n' 'cmux launch clip' infra docs-site app; printf '\\033]2;%s\\007' 'tours launch-themes 05'; cat >/dev/null\r"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/topology/topology/workspaces/3/screens/0/panes/0/tabs/0/title",
        "equals": "tours launch-themes 05",
        "maxMs": 5000
      },
      "note": "host output (uname, the macOS app list) differs by host and OS; a golden baseline needs fixed text; the screen is the command's output alone: it starts with clear, sets its title last and holds the shell, so no prompt races the snapshot; the step waits on that title"
    },
    {
      "id": "06-split-right",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "action",
          "run",
          "splitRight"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/topology/topology/workspaces",
        "predicate": "changed",
        "maxMs": 5000
      }
    },
    {
      "id": "08-soft-blue",
      "op": "snapshot",
      "settleMaxMs": 10000
    },
    {
      "id": "09-clay-orange",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "settings",
          "set",
          "appearance.theme",
          "Clay Orange"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/settings/effectiveSha256",
        "predicate": "changed",
        "maxMs": 10000
      },
      "settleMaxMs": 10000
    },
    {
      "id": "10-olive-grey",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "settings",
          "set",
          "appearance.theme",
          "Olive Grey"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/settings/effectiveSha256",
        "predicate": "changed",
        "maxMs": 10000
      },
      "settleMaxMs": 10000
    },
    {
      "id": "11-soft-blue-light",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "settings",
          "set",
          "appearance.theme",
          "Soft Blue Light"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/settings/effectiveSha256",
        "predicate": "changed",
        "maxMs": 10000
      },
      "settleMaxMs": 10000
    },
    {
      "id": "12-clay-orange-light",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "settings",
          "set",
          "appearance.theme",
          "Clay Orange Light"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/settings/effectiveSha256",
        "predicate": "changed",
        "maxMs": 10000
      },
      "settleMaxMs": 10000
    },
    {
      "id": "13-back-to-soft-blue",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "settings",
          "set",
          "appearance.theme",
          "Soft Blue"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/settings/effectiveSha256",
        "predicate": "changed",
        "maxMs": 5000
      }
    }
  ],
  "invariants": [
    "each step's settled snapshot is the model state of the tour's picture of that step",
    "no step waits on a clock: each ends on its waitFor value or the settle barrier"
  ],
  "teardown": [
    "quit the tagged app the run started",
    "verify its debug socket is gone"
  ],
  "untested": [
    "pixels: the tour's screenshots and video (scripts/cmux-next/media/tour.py); a case compares model state, and its reviewed baseline stands in for each picture",
    "tour step 7 (Agent chat beside the terminal): `cmux agent new-chat` is no CLI verb (cmux-tui cli/command.rs parse_agent sends it to agent_focus, a usage error), so the step fails on every build"
  ]
}
