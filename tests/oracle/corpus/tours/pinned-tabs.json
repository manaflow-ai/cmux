{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "pinned-tabs",
  "suite": "tours",
  "title": "Tour: Pinned tabs",
  "priority": "P2",
  "surface": "cmux-next-native",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {
    "viewport": {
      "width": 1440,
      "height": 900
    }
  },
  "fixture": {
    "seed": "tours-pinned-tabs-v1",
    "network": "offline",
    "clock": "fixed",
    "agent": "mock"
  },
  "preconditions": [
    "private scratch config",
    "tagged bench build",
    "no unrelated app instance",
    "the main window is 1440 x 900 pt",
    "the launch has one workspace with one terminal (an empty saved session)"
  ],
  "requires": [
    "gui"
  ],
  "platforms": [
    "mac"
  ],
  "steps": [
    {
      "id": "01-launch",
      "op": "snapshot"
    },
    {
      "id": "02-new-workspace",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "workspace",
          "new",
          "--name",
          "Pins"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/terminals/list/1/attach",
        "equals": "attached",
        "maxMs": 5000
      }
    },
    {
      "id": "03-second-terminal-tab",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "action",
          "run",
          "newSurface"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/topology/tab_count",
        "predicate": "changed",
        "maxMs": 5000
      }
    },
    {
      "id": "04-third-terminal-tab",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "action",
          "run",
          "newSurface"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/topology/tab_count",
        "predicate": "changed",
        "maxMs": 5000
      }
    },
    {
      "id": "06-pin-the-browser-tab-it-moves-to-the-star",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "action",
          "run",
          "palette.toggleTabPin"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/topology/topology/workspaces",
        "predicate": "changed",
        "maxMs": 5000
      },
      "note": "the browser tab step is dropped (no web fixture in driver_app), so this pins the selected terminal tab"
    },
    {
      "id": "07-select-the-next-tab",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "action",
          "run",
          "nextSurface"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/topology/topology/focus/tab",
        "predicate": "changed",
        "maxMs": 5000
      }
    },
    {
      "id": "08-pin-a-terminal-tab-it-joins-the-pinned-t",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "action",
          "run",
          "palette.toggleTabPin"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/topology/topology/workspaces",
        "predicate": "changed",
        "maxMs": 5000
      }
    },
    {
      "id": "09-close-other-tabs-from-a-pinned-tab-keeps",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "action",
          "run",
          "closeOtherTabsInPane"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/topology/tab_count",
        "predicate": "changed",
        "maxMs": 5000
      }
    },
    {
      "id": "10-unpin-the-terminal-it-returns-to-the-nor",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "action",
          "run",
          "palette.toggleTabPin"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/topology/topology/workspaces",
        "predicate": "changed",
        "maxMs": 5000
      }
    }
  ],
  "invariants": [
    "each step's settled snapshot is the model state of the tour's picture of that step",
    "no step waits on a clock: each ends on its waitFor value or the settle barrier"
  ],
  "teardown": [
    "quit the tagged app the run started",
    "verify its debug socket is gone"
  ],
  "untested": [
    "pixels: the tour's screenshots and video (scripts/cmux-next/media/tour.py); a case compares model state, and its reviewed baseline stands in for each picture",
    "tour step 5 (Browser tab: four tabs): driver_app.py fails a fixture.web case as a Crash (no loopback web fixture yet), so a step that opens a $WEB page waits until driver_app serves webfixture.py"
  ]
}
