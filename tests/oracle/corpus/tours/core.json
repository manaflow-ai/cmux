{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "core",
  "suite": "tours",
  "title": "Tour: Core UI",
  "priority": "P2",
  "surface": "cmux-next-native",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {
    "viewport": {
      "width": 1440,
      "height": 900
    }
  },
  "fixture": {
    "seed": "tours-core-v1",
    "network": "offline",
    "clock": "fixed",
    "agent": "mock",
    "web": true
  },
  "preconditions": [
    "private scratch config",
    "tagged bench build",
    "no unrelated app instance",
    "the main window is 1440 x 900 pt",
    "the loopback web fixture server ($WEB, webfixture.py)"
  ],
  "requires": [
    "gui"
  ],
  "platforms": [
    "mac"
  ],
  "steps": [
    {
      "id": "01-launch",
      "op": "snapshot"
    },
    {
      "id": "02-new-workspace",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "workspace",
          "new",
          "--name",
          "Tour"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/topology/topology/workspaces",
        "predicate": "changed",
        "maxMs": 5000
      }
    },
    {
      "id": "03-type-in-the-terminal",
      "op": "cli",
      "target": {
        "session": "current"
      },
      "args": {
        "argv": [
          "workspace",
          "name:Tour",
          "screen",
          "current",
          "pane",
          "current",
          "tab",
          "current",
          "terminal",
          "current",
          "write",
          "--text",
          "echo hello from the cmux-next tour\r"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/terminals/list",
        "predicate": "changed",
        "maxMs": 5000
      }
    },
    {
      "id": "04-a-command-reports-progress-tab-loading-s",
      "op": "cli",
      "target": {
        "session": "current"
      },
      "args": {
        "argv": [
          "workspace",
          "name:Tour",
          "screen",
          "current",
          "pane",
          "current",
          "tab",
          "current",
          "terminal",
          "current",
          "write",
          "--text",
          "clear; printf '\\033]9;4;3\\007'; cat >/dev/null\r"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/terminals/list",
        "predicate": "changed",
        "maxMs": 5000
      },
      "note": "the shell holds the progress state by reading stdin, not by a timed wait"
    },
    {
      "id": "05-split-right",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "action",
          "run",
          "splitRight"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/topology/topology/workspaces",
        "predicate": "changed",
        "maxMs": 5000
      }
    },
    {
      "id": "06-split-down",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "action",
          "run",
          "splitDown"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/topology/topology/workspaces",
        "predicate": "changed",
        "maxMs": 5000
      }
    },
    {
      "id": "07-new-terminal-tab",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "action",
          "run",
          "newSurface"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/topology/tab_count",
        "predicate": "changed",
        "maxMs": 5000
      }
    },
    {
      "id": "08-browser-tab",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "tab",
          "new-browser",
          "--url",
          "$WEB/load.html"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/tabs/panes/0/tabs/0/loadState",
        "equals": "finished",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the tour's remote page is $WEB/load.html (the loopback web fixture)"
    },
    {
      "id": "09-hide-the-sidebar",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "action",
          "run",
          "toggleSidebar"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/sidebar/hidden",
        "predicate": "changed",
        "maxMs": 5000
      }
    },
    {
      "id": "10-show-the-sidebar",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "action",
          "run",
          "toggleSidebar"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/sidebar/hidden",
        "predicate": "changed",
        "maxMs": 5000
      }
    },
    {
      "id": "11-notification",
      "op": "cli",
      "target": {
        "session": "current"
      },
      "args": {
        "argv": [
          "notify",
          "--title",
          "Tour",
          "--body",
          "Hello from CI"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "note": "no snapshot value this command is sure to change"
    },
    {
      "id": "12-notifications-panel",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "action",
          "run",
          "showNotifications"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "note": "tour.py optional (the notifications panel is not ported yet): the settle barrier alone, since the step may not do its work"
    },
    {
      "id": "13-agent-chat",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "agent",
          "new-chat"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "settleMaxMs": 10000,
      "note": "tour.py optional (agent chat views are not ported yet): the settle barrier alone, since the step may not do its work"
    },
    {
      "id": "14-agent-workspace",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "workspace",
          "new",
          "--name",
          "Agent"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/topology/topology/workspaces",
        "predicate": "changed",
        "maxMs": 5000
      }
    },
    {
      "id": "15-agent-starts",
      "op": "cli",
      "target": {
        "session": "current"
      },
      "args": {
        "argv": [
          "workspace",
          "name:Agent",
          "screen",
          "current",
          "pane",
          "current",
          "tab",
          "current",
          "terminal",
          "current",
          "write",
          "--text",
          "clear; printf '\\033]7501;state=working\\033\\\\'; head -n 1 >/dev/null; printf '\\033]7501;state=done\\033\\\\'; cat >/dev/null\r"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/terminals/list",
        "predicate": "changed",
        "maxMs": 5000
      },
      "note": "the agent state holds until a later step writes a line, not for 8 timed seconds; then the shell reads stdin"
    },
    {
      "id": "16-an-agent-works-row-working-spinner",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "workspace",
          "new",
          "--name",
          "Notes"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/topology/topology/workspaces",
        "predicate": "changed",
        "maxMs": 5000
      }
    },
    {
      "id": "17-the-agent-finishes-done-mark-in-the-spin",
      "op": "cli",
      "target": {
        "session": "current"
      },
      "args": {
        "argv": [
          "workspace",
          "name:Agent",
          "screen",
          "current",
          "pane",
          "current",
          "tab",
          "current",
          "terminal",
          "current",
          "write",
          "--text",
          "done\r"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/terminals/list",
        "predicate": "changed",
        "maxMs": 5000
      },
      "note": "the tour waited 8 timed seconds for the agent to finish; this line ends the agent's wait, so the done state follows the step, not a clock (its echo is the terminal change the step waits on)"
    },
    {
      "id": "18-session-tree-keycaps-on-the-first-rows",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "settings",
          "set",
          "sidebar.sessionTree",
          "true"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "note": "tour.py optional (an app from before sidebar.sessionTree): the settle barrier alone, since the step may not do its work"
    },
    {
      "id": "19-session-tree-back-off-for-later-tours",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "settings",
          "set",
          "sidebar.sessionTree",
          "false"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "note": "tour.py optional (an app from before sidebar.sessionTree): the settle barrier alone, since the step may not do its work"
    },
    {
      "id": "20-profile-menu",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "action",
          "run",
          "sidebar.profileMenu"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "note": "tour.py optional (the menu shot needs a screen capture route): the settle barrier alone, since the step may not do its work"
    }
  ],
  "invariants": [
    "each step's settled snapshot is the model state of the tour's picture of that step",
    "no step waits on a clock: each ends on its waitFor value or the settle barrier"
  ],
  "teardown": [
    "quit the tagged app the run started",
    "verify its debug socket is gone"
  ],
  "untested": [
    "pixels: the tour's screenshots and video (scripts/cmux-next/media/tour.py); a case compares model state, and its reviewed baseline stands in for each picture"
  ]
}
