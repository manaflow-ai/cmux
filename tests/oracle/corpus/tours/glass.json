{
  "$schema": "../../../../schemas/oracle/case-v1.schema.json",
  "corpusVersion": 1,
  "id": "glass",
  "suite": "tours",
  "title": "Tour: Glass and themes",
  "priority": "P2",
  "surface": "cmux-next-native",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {
    "viewport": {
      "width": 1440,
      "height": 900
    }
  },
  "fixture": {
    "seed": "tours-glass-v1",
    "network": "offline",
    "clock": "fixed",
    "agent": "mock"
  },
  "preconditions": [
    "private scratch config",
    "tagged bench build",
    "no unrelated app instance",
    "the main window is 1440 x 900 pt",
    "the launch has one workspace with one terminal (an empty saved session)"
  ],
  "requires": [
    "gui"
  ],
  "platforms": [
    "mac"
  ],
  "steps": [
    {
      "id": "setup-01-appearance-background",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "settings",
          "set",
          "appearance.background",
          "hokusai-great-wave"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/settings/effectiveSha256",
        "predicate": "changed",
        "maxMs": 5000
      },
      "note": "the tour launches with this setting; case-v1 has no launch config"
    },
    {
      "id": "setup-02-appearance-theme",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "settings",
          "set",
          "appearance.theme",
          "Clay Orange"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/settings/effectiveSha256",
        "predicate": "changed",
        "maxMs": 5000
      },
      "note": "the tour launches with this setting; case-v1 has no launch config"
    },
    {
      "id": "01-launch-over-art",
      "op": "snapshot",
      "settleMaxMs": 10000
    },
    {
      "id": "02-new-workspace",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "workspace",
          "new",
          "--name",
          "Glass"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/terminals/list/1/attach",
        "equals": "attached",
        "maxMs": 5000
      }
    },
    {
      "id": "03-terminal-text-and-ansi-colors-over-art",
      "op": "cli",
      "target": {
        "session": "current"
      },
      "args": {
        "argv": [
          "workspace",
          "name:Glass",
          "screen",
          "current",
          "pane",
          "current",
          "tab",
          "current",
          "terminal",
          "current",
          "write",
          "--text",
          "clear; echo 'cmux glass tour: plain text stays readable over the art'; for c in 1 2 3 4 5 6 7; do printf '\\033[3%sm color %s \\033[1m bold \\033[0m' $c $c; done; echo; printf '\\033]2;%s\\007' 'tours glass 03'; cat >/dev/null\r"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/topology/topology/workspaces/1/screens/0/panes/0/tabs/0/title",
        "equals": "tours glass 03",
        "maxMs": 10000
      },
      "settleMaxMs": 10000,
      "note": "the screen is the command's output alone: it starts with clear, sets its title last and holds the shell, so no prompt races the snapshot; the step waits on that title"
    },
    {
      "id": "04-split-right",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "action",
          "run",
          "splitRight"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/topology/topology/workspaces",
        "predicate": "changed",
        "maxMs": 5000
      }
    },
    {
      "id": "06-command-palette-on-glass-over-art",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "action",
          "run",
          "commandPalette"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/overlays/palette/open",
        "predicate": "changed",
        "maxMs": 5000
      }
    },
    {
      "id": "07-close-the-palette",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "action",
          "run",
          "commandPalette"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/overlays/palette/open",
        "predicate": "changed",
        "maxMs": 5000
      }
    },
    {
      "id": "08-soft-blue-over-art",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "settings",
          "set",
          "appearance.theme",
          "Soft Blue"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/settings/effectiveSha256",
        "predicate": "changed",
        "maxMs": 10000
      },
      "settleMaxMs": 10000
    },
    {
      "id": "09-soft-blue-light-over-art",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "settings",
          "set",
          "appearance.theme",
          "Soft Blue Light"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/settings/effectiveSha256",
        "predicate": "changed",
        "maxMs": 10000
      },
      "settleMaxMs": 10000
    },
    {
      "id": "10-clay-orange-light-over-art",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "settings",
          "set",
          "appearance.theme",
          "Clay Orange Light"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/settings/effectiveSha256",
        "predicate": "changed",
        "maxMs": 10000
      },
      "settleMaxMs": 10000
    },
    {
      "id": "11-art-off-clay-orange-light",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "settings",
          "unset",
          "appearance.background"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/settings/effectiveSha256",
        "predicate": "changed",
        "maxMs": 10000
      },
      "settleMaxMs": 10000
    },
    {
      "id": "12-clay-orange",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "settings",
          "set",
          "appearance.theme",
          "Clay Orange"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/settings/effectiveSha256",
        "predicate": "changed",
        "maxMs": 10000
      },
      "settleMaxMs": 10000
    },
    {
      "id": "13-soft-blue",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "settings",
          "set",
          "appearance.theme",
          "Soft Blue"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/settings/effectiveSha256",
        "predicate": "changed",
        "maxMs": 10000
      },
      "settleMaxMs": 10000
    },
    {
      "id": "14-soft-blue-light",
      "op": "cli",
      "target": {
        "window": "current"
      },
      "args": {
        "argv": [
          "settings",
          "set",
          "appearance.theme",
          "Soft Blue Light"
        ]
      },
      "expect": {
        "outcome": "ok",
        "noReceiptReason": "a tour step: the bundle's cmux prints no ActionEffect kind (driver_app.py op_cli)"
      },
      "waitFor": {
        "pointer": "/settings/effectiveSha256",
        "predicate": "changed",
        "maxMs": 10000
      },
      "settleMaxMs": 10000
    }
  ],
  "invariants": [
    "each step's settled snapshot is the model state of the tour's picture of that step",
    "no step waits on a clock: each ends on its waitFor value or the settle barrier"
  ],
  "teardown": [
    "quit the tagged app the run started",
    "verify its debug socket is gone"
  ],
  "untested": [
    "pixels: the tour's screenshots and video (scripts/cmux-next/media/tour.py); a case compares model state, and its reviewed baseline stands in for each picture",
    "tour step 5 (Agent chat beside the terminal): `cmux agent new-chat` is no CLI verb (cmux-tui cli/command.rs parse_agent sends it to agent_focus, a usage error), so the step fails on every build"
  ]
}
