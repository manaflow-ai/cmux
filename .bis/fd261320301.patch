+// The status-outside-the-dot detector (scripts/check-status-outside-dot.ts, RFD 0128): a dot item's words
+// drawn anywhere but the composer status dot fail, unless ALLOWED says why they are not a status row.
+import { expect, test } from "bun:test";
+import { dotKinds, findAll, findInSource, rules, words } from "../scripts/check-status-outside-dot";
+
+test("the webviews draw no composer status outside the dot", () => {
+  const { findings, stale } = findAll();
+  expect(findings.map((f) => `${f.file}:${f.line} ${f.kind} ${f.key}`)).toEqual([]);
+  expect(stale).toEqual([]);
+});
+
+test("the dot's kinds are read from the model", () => {
+  expect(
+    dotKinds(`const KINDS: ReadonlySet<string> = new Set<StatusKind>([\n  "machineLink",\n  "sendsHeld",\n]);`),
+  ).toEqual(["machineLink", "sendsHeld"]);
+});
+
+test("words set aside placeholders, punctuation and case", () => {
+  expect(words("Reconnecting to {subject}…")).toBe("reconnecting to");
+  expect(words("Restoring sessions… {time}")).toBe(words("Restoring sessions…"));
+});
+
+const catalog = new Map([
+  ["status.sendsHeld.held", "Sending when ready"],
+  ["status.queuePaused.paused", "Queue paused"],
+  ["composer.sendingWhenReady", "Sending when ready"],
+  ["fresh.pausedRow", "Queue paused."],
+  ["other.thing", "Something else"],
+]);
+const r = rules(catalog, ["sendsHeld", "queuePaused"]);
+
+test("a planted row repeating an item's words fails; other copy passes", () => {
+  const text = `
+const a = t("fresh.pausedRow");
+const b = t("other.thing");
+const c = t("status.sendsHeld.held");
+`;
+  expect(
+    findInSource("agent-session/acpmux/NewRow.tsx", text, r).map((f) =>
+      `${f.line} ${f.kind} ${f.key} ${f.item ?? ""}`.trim(),
+    ),
+  ).toEqual(["2 dot-words fresh.pausedRow status.queuePaused.paused", "4 dot-key status.sendsHeld.held"]);
+});
+
+test("the dot's own files, ALLOWED rows, tests and galleries pass", () => {
+  expect(findInSource("agent-session/acpmux/ComposerStatusDot.tsx", `t("status.sendsHeld.held")`, r)).toEqual([]);
+  expect(findInSource("agent-session/acpmux/Composer.tsx", `t("composer.sendingWhenReady")`, r)).toEqual([]);
+  expect(findInSource("agent-session/acpmux/Other.tsx", `t("composer.sendingWhenReady")`, r)).toHaveLength(1);
+  expect(findInSource("agent-session/acpmux/Other.gallery.tsx", `t("composer.sendingWhenReady")`, r)).toEqual([]);
+  expect(findInSource("agent-session/acpmux/Other.test.tsx", `t("status.sendsHeld.held")`, r)).toEqual([]);
+});
diff --git a/webviews/test/checkpoint-select-keeps-review.test.ts b/webviews/test/checkpoint-select-keeps-review.test.ts
new file mode 100644
index 00000000000..c31c1b48df4
--- /dev/null
+++ b/webviews/test/checkpoint-select-keeps-review.test.ts
@@ -0,0 +1,43 @@
+// A chat switch selects the checkpoint client's new target (checkpoints/client.ts `select`). On a host
+// with no checkpoints, the unsupported error from the capability read is the same for every target,
+// so a select keeps it: the fields the pane draws (checkpoints/controller.tsx REVIEW_FIELDS) stay the
+// same objects, and the pane does not draw again for them. It dropped the error on every select, a
+// new review state each switch and a second sync render of the whole pane inside the switch's frame
+// (bench/settled-page.bench.ts chat_switch). A supported client still starts each target clean.
+import { expect, test } from "bun:test";
+import { CheckpointClient } from "../src/agent-session/acpmux/checkpoints/client";
+
+const memory = { get: async () => undefined, set: async () => {}, delete: async () => {} };
+const target = (sessionId: string) => ({ cwd: "/repo", sessionId, hostKind: "local" as const });
+
+test("an unsupported client keeps its error across chat switches", async () => {
+  const client = new CheckpointClient(async () => ({}), {
+    persistence: memory,
+    capabilities: async () => {
+      throw { code: "native.unsupported", origin: "native", message: "native.unsupported" };
+    },
+  });
+  client.select(target("a"));
+  expect(await client.refreshCapabilities()).toBe(false);
+  const error = client.getSnapshot().error;
+  expect(error?.code).toBe("native.unsupported");
+  for (const id of ["b", "c", "a"]) {
+    client.select(target(id));
+    expect(client.getSnapshot().error).toBe(error!);
+    expect(client.getSnapshot().target?.sessionId).toBe(id);
+  }
+});
+
+test("a supported client starts each target with no error, list or record", async () => {
+  const client = new CheckpointClient(async () => ({}), {
+    persistence: memory,
+    capabilities: async () => ({ checkpoints: true }) as never,
+  });
+  client.select(target("a"));
+  await client.refreshCapabilities();
+  client.state = { ...client.state, error: { code: "operation.failed" } as never };
+  client.select(target("b"));
+  expect(client.getSnapshot().error).toBeUndefined();
+  expect(client.getSnapshot().list).toBeUndefined();
+  expect(client.getSnapshot().record).toBeUndefined();
+});
diff --git a/webviews/test/cloud-last-pick.test.ts b/webviews/test/cloud-last-pick.test.ts
new file mode 100644
index 00000000000..07e3ae5546e
--- /dev/null
+++ b/webviews/test/cloud-last-pick.test.ts
@@ -0,0 +1,86 @@
+// Cloud's own last pick (cloudLastPick.ts), apart from This Mac's (lastPick.ts). Austin, 2026-11-27:
+// "Cloud + autocloud have their own bucket of models and this mac is just your local setup ... We should
+// store a state for the local models and a different state for the cloud+autocloud".
+import { afterEach, beforeAll, expect, test } from "bun:test";
+
+const store = new Map<string, string>();
+beforeAll(() => {
+  (globalThis as Record<string, unknown>).localStorage ??= {
+    getItem: (key: string) => store.get(key) ?? null,
+    setItem: (key: string, value: string) => void store.set(key, value),
+    removeItem: (key: string) => void store.delete(key),
+    clear: () => store.clear(),
+  };
+});
+
+const mod = () => import("../src/agent-session/acpmux/cloudLastPick");
+const sent: Record<string, unknown>[] = [];
+const post = async (_method: string, params: Record<string, unknown>) => void sent.push(params);
+
+afterEach(async () => {
+  (await mod()).clearCloudLastPick();
+  (await import("../src/agent-session/acpmux/cloudAgentPick")).clearCloudAgentPick();
+  globalThis.localStorage?.clear();
+  sent.length = 0;
+});
+
+test("a Cloud pick is Cloud's last pick and the app is told it is Cloud's", async () => {
+  const { cloudLastPick, rememberCloudPick } = await mod();
+  expect(cloudLastPick()).toBeUndefined();
+  rememberCloudPick({ harness: "codex", model: "gpt-6.1" }, post);
+  expect(cloudLastPick()).toEqual({ harness: "codex", model: "gpt-6.1" });
+  expect(sent).toEqual([{ agent: "codex", model: "gpt-6.1", place: "cloud" }]);
+});
+
+test("a pick naming no model keeps the model last picked on the same agent, not another agent's", async () => {
+  const { cloudLastPick, rememberCloudPick } = await mod();
+  rememberCloudPick({ harness: "codex", model: "gpt-6.1" }, post);
+  rememberCloudPick({ harness: "codex" }, post);
+  expect(cloudLastPick()).toEqual({ harness: "codex", model: "gpt-6.1" });
+  rememberCloudPick({ harness: "claude" }, post);
+  expect(cloudLastPick()).toEqual({ harness: "claude" });
+});
+
+test("a Cloud pick never changes This Mac's last pick, and a This Mac pick never changes Cloud's", async () => {
+  const { cloudLastPick, rememberCloudPick } = await mod();
+  const { lastPick, rememberPick } = await import("../src/agent-session/acpmux/lastPick");
+  rememberPick({ harness: "claude", model: "opus-5.5" }, "/p", post);
+  rememberCloudPick({ harness: "codex", model: "gpt-6.1" }, post);
+  expect(lastPick("/p")).toEqual({ harness: "claude", model: "opus-5.5" });
+  rememberPick({ harness: "pi", model: "m" }, "/p", post);
+  expect(cloudLastPick()).toEqual({ harness: "codex", model: "gpt-6.1" });
+});
+
+test("holding a Cloud agent pick remembers it as Cloud's", async () => {
+  const { cloudLastPick } = await mod();
+  const { holdCloudAgentPick } = await import("../src/agent-session/acpmux/cloudAgentPick");
+  holdCloudAgentPick({ harness: "codex", model: "gpt-6.1" });
+  expect(cloudLastPick()).toEqual({ harness: "codex", model: "gpt-6.1" });
+});
+
+test("the app's copy seeds a page until the page picks; a bad copy seeds nothing", async () => {
+  const { cloudLastPick, rememberCloudPick, seedCloudLastPick } = await mod();
+  seedCloudLastPick({ harness: "", model: "x" });
+  seedCloudLastPick(null);
+  expect(cloudLastPick()).toBeUndefined();
+  seedCloudLastPick({ harness: "codex", model: "gpt-6.1" });
+  expect(cloudLastPick()).toEqual({ harness: "codex", model: "gpt-6.1" });
+  rememberCloudPick({ harness: "claude", model: "opus-5.5" }, post);
+  seedCloudLastPick({ harness: "codex", model: "gpt-6.1" });
+  expect(cloudLastPick()).toEqual({ harness: "claude", model: "opus-5.5" });
+});
+
+test("the New Tab context's lastPicks.cloud seeds Cloud's last pick", async () => {
+  const { cloudLastPick } = await mod();
+  const { newTabHost } = await import("../src/agent-session/acpmux/newTabModel");
+  newTabHost({
+    newTab: {
+      lastPicks: {
+        global: { harness: "claude", model: "default" },
+        folders: [],
+        cloud: { harness: "codex", model: "gpt-6.1" },
+      },
+    },
+  });
+  expect(cloudLastPick()).toEqual({ harness: "codex", model: "gpt-6.1" });
+});
