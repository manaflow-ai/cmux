+    () => new MockAcpmuxSocket(() => Promise.resolve()) as unknown as WebSocket,
+  );
+  try {
+    await client.select(WORKED_SESSION);
+    const socket = MockAcpmuxSocket.live!;
+    socket.seedSubagentLog(WORKED_SESSION, CAPPED_ID, subagentReportLog());
