@@ -0,0 +1,110 @@
+// l10n-allow-file: gallery fixtures (sample machine names), not shipped UI.
+// Device glyphs (Leo 2026-11-14: "nicer icons ... across all the remote related areas"): every
+// device kind beside its name, as a menu row lists machines and as the composer's chip shows one,
+// in the shipped look and the candidates it was picked over. Light and dark are the theme axis.
+import { createElement } from "react";
+import { componentEntry } from "../gallery/format";
+import type { Play } from "../gallery/play";
+import { DEVICE_GLYPH_VIEWBOX } from "./deviceGlyphPaths";
+import type { DeviceKind } from "./deviceKinds";
+
+type Look = "regular" | "medium" | "light" | "large";
+type Props = { look: Look; offline?: boolean; boxes?: boolean };
+
+const NAMES: Record<DeviceKind, string> = {
+  macbook: "This Mac",
+  "mac-mini": "build-mini",
+  imac: "studio-imac",
+  "mac-studio": "render-studio",
+  "mac-pro": "tower-pro",
+  "linux-desktop": "workstation",
+  "linux-server": "gpu-box",
+  cloud: "Cloud machine",
+  iphone: "Phone",
+  ipad: "Tablet",
+  generic: "unknown-host",
+};
+
+const everyKindHasAGlyph: Play = async (ctx) => {
+  await ctx.waitFor(() => ctx.document.querySelectorAll(".device-glyph-gallery-row").length > 0);
+  for (const row of ctx.document.querySelectorAll(".device-glyph-gallery-row svg")) {
+    if (!row.querySelector("path")) throw new Error(`${row.getAttribute("data-device")} drew no glyph`);
+  }
+};
+
+const variant = (look: Look, note: string, extra: Partial<Props> = {}) => ({
+  note,
+  props: { look, ...extra },
+  play: everyKindHasAGlyph,
+});
+
+export default componentEntry<Props>({
+  id: "ui.device-glyph",
+  title: "Device glyphs",
+  area: "UI primitives",
+  height: 460,
+  styles: () => import("./DeviceGlyph.gallery.css"),
+  covers: ["ui/DeviceGlyph.tsx#DeviceGlyph", "ui/DeviceGlyph.tsx#DeviceGlyphShapes"],
+  load: () =>
+    Promise.all([import("./DeviceGlyph"), import("./deviceGlyphVariants"), import("./deviceKinds")]).then(
+      ([glyph, variants, kinds]) =>
+        (props: Props) =>
+          createElement(
+            "div",
+            { className: `device-glyph-gallery${props.boxes ? " device-glyph-gallery-boxes" : ""}` },
+            ...kinds.DEVICE_KINDS.flatMap((kind) => {
+              const paths = variants.DEVICE_GLYPH_VARIANTS[props.look];
+              const shapes =
+                props.look === "regular"
+                  ? createElement(glyph.DeviceGlyphShapes, { kind })
+                  : createElement(
+                      "g",
+                      null,
+                      ...(paths[kinds.DEVICE_SYMBOLS[kind]] ?? []).map((layer, i) =>
+                        createElement("path", {
+                          key: i,
+                          d: layer.d,
+                          fill: "currentColor",
+                          fillRule: layer.rule ?? "nonzero",
+                        }),
+                      ),
+                    );
+              const svg = (className: string, width: number) =>
+                createElement(
+                  "svg",
+                  {
+                    className: `ui-device-glyph ${className}`,
+                    "data-device": kind,
+                    "data-offline": props.offline ? "" : undefined,
+                    width,
+                    height: 14,
+                    viewBox: DEVICE_GLYPH_VIEWBOX,
+                    "aria-hidden": true,
+                  },
+                  shapes,
+                );
+              const row = (className: string, width: number) =>
+                createElement(
+                  "div",
+                  {
+                    key: `${kind}-${className}`,
+                    className: "device-glyph-gallery-row",
+                    "data-offline": props.offline ? "" : undefined,
+                  },
+                  svg(className, width),
+                  createElement("span", null, NAMES[kind]),
+                );
+              // A menu row's square icon column, then the composer chip's wider slot.
+              return [row("menu", 14), row("chip", 17.5)];
+            }),
+          ),
+    ),
+  variants: {
+    regular: variant("regular", "Shipped: SF Symbols regular, the composer MacBook's scale"),
+    medium: variant("medium", "Candidate: medium weight"),
+    light: variant("light", "Candidate: light weight"),
+    large: variant("large", "Candidate: 12% larger than the MacBook's scale"),
+    offline: variant("regular", "Offline: the glyph dims with its label", { offline: true }),
+    centering: variant("regular", "Glyph boxes: one box and one center line for every kind", { boxes: true }),
+  },
+});
diff --git a/webviews/src/ui/DeviceGlyph.test.tsx b/webviews/src/ui/DeviceGlyph.test.tsx
new file mode 100644
index 00000000000..e19603610c3
--- /dev/null
+++ b/webviews/src/ui/DeviceGlyph.test.tsx
@@ -0,0 +1,81 @@
+// Every device kind draws a glyph, and every machine surface draws it from the one shared component
+// (Leo 2026-11-14: "nicer icons ... across all the remote related areas").
+import { afterEach, expect, test } from "bun:test";
+import { readFileSync } from "node:fs";
+import path from "node:path";
+import { createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { DeviceGlyph } from "./DeviceGlyph";
+import { DEVICE_GLYPH_PATHS } from "./deviceGlyphPaths";
+import { DEVICE_KINDS, DEVICE_SYMBOLS, deviceKindsFromStatus, noteDeviceKinds, resetDeviceKinds } from "./deviceKinds";
+import { EnvironmentIcon } from "../agent-session/acpmux/EnvironmentPicker";
+
+afterEach(() => resetDeviceKinds());
+
+test("every kind in the Rust table has its symbol's paths", () => {
+  expect(DEVICE_KINDS.length).toBe(11);
+  for (const kind of DEVICE_KINDS) {
+    const layers = DEVICE_GLYPH_PATHS[DEVICE_SYMBOLS[kind]];
+    expect(layers?.length, kind).toBeGreaterThan(0);
+    const markup = renderToStaticMarkup(createElement(DeviceGlyph, { kind }));
+    expect(markup).toContain(`data-device="${kind}"`);
+    expect(markup).toContain("<path");
+  }
+});
+
+test("a status read names this machine and each peer", () => {
+  const status = {
+    device: "mac-mini",
+    peers: [
+      { name: "gpu-box", health: { device: "linux-server" } },
+      { name: "old", health: {} },
+      { name: "odd", health: { device: "toaster" } },
+      { name: "vm", transport: "wss", health: { device: "linux-server" } },
+      { name: "direct-vm", url: "wss://relay.example/vm", health: { device: "linux-server" } },
+    ],
+  };
+  expect(deviceKindsFromStatus(status)).toEqual({
+    local: "mac-mini",
+    peers: { "gpu-box": "linux-server", vm: "cloud", "direct-vm": "cloud" },
+  });
+});
+
+test("the location picker draws each machine's reported kind", () => {
+  const icon = (kind: "local" | "ssh" | "cloud", name?: string) =>
+    renderToStaticMarkup(createElement(EnvironmentIcon, name ? { kind, name } : { kind }));
+  // Before the daemon says: This Mac is the MacBook it always was, SSH keeps its terminal glyph.
+  expect(icon("local")).toContain('data-device="macbook"');
+  expect(icon("ssh", "gpu-box")).not.toContain("data-device");
+  noteDeviceKinds({ device: "mac-mini", peers: [{ name: "gpu-box", health: { device: "linux-server" } }] });
+  expect(icon("local")).toContain('data-device="mac-mini"');
+  expect(icon("ssh", "gpu-box")).toContain('data-device="linux-server"');
+  // An SSH icon with no machine named (a saved environment, an action row) never takes this Mac's.
+  expect(icon("ssh")).not.toContain("data-device");
+  // The box keeps its size: this Mac's wide MacBook box, every other machine the square one.
+  expect(icon("local")).toContain("acpmux-macbook-icon");
+  expect(icon("ssh", "gpu-box")).not.toContain("acpmux-macbook-icon");
+  // A Cloud machine keeps its own cloud icon, whatever its VM reports.
+  const cloudBefore = icon("cloud", "vm");
+  noteDeviceKinds({ peers: [{ name: "vm", health: { device: "linux-server" } }] });
+  expect(icon("cloud", "vm")).toBe(cloudBefore);
+  expect(cloudBefore).not.toContain("data-device");
+  // A later read without kinds keeps what was said.
+  noteDeviceKinds({ peers: [] });
+  expect(icon("local")).toContain('data-device="mac-mini"');
+});
+
+/// The web surfaces that draw a machine. Each draws its glyph from ui/DeviceGlyph, never a copy.
+const SURFACES = [
+  "agent-session/acpmux/EnvironmentPicker.tsx",
+  "agent-session/acpmux/ComposerContext.tsx",
+  "agent-session/acpmux/ProjectChooser.tsx",
+];
+
+test("every machine surface uses the shared device glyph", () => {
+  const src = path.resolve(import.meta.dir, "..");
+  for (const file of SURFACES) {
+    const text = readFileSync(path.join(src, file), "utf8");
+    expect(/from "(\.\.\/)+ui\/DeviceGlyph"/.test(text), file).toBe(true);
+    expect(/<(DeviceGlyph|DeviceGlyphShapes|MachineGlyph)\b/.test(text), file).toBe(true);
+  }
+});
diff --git a/webviews/src/ui/DeviceGlyph.tsx b/webviews/src/ui/DeviceGlyph.tsx
new file mode 100644
index 00000000000..942ae4667f0
--- /dev/null
+++ b/webviews/src/ui/DeviceGlyph.tsx
@@ -0,0 +1,66 @@
+import type { CSSProperties } from "react";
+import { DEVICE_GLYPH_PATHS, DEVICE_GLYPH_VIEWBOX } from "./deviceGlyphPaths";
+import { DEVICE_SYMBOLS, type DeviceKind, useDeviceKind } from "./deviceKinds";
+import "./DeviceGlyph.css";
+
+/// One device's glyph: the SF Symbol its kind names (`DEVICE_SYMBOLS`, the Rust table), drawn from
+/// that symbol's vector paths (`deviceGlyphPaths.ts`) at one shared scale, so a Mac mini, a server
+/// and an iPhone stand at the same optical size and center in every row (the MacBook prior art,
+/// MacBookGlyph.tsx). Fills with the text color, so it follows the theme; `offline` dims it.
+export function DeviceGlyph({
+  kind,
+  className,
+  style,
+  offline,
+  width = 14,
+  height = 14,
+}: {
+  kind: DeviceKind;
+  className?: string;
+  style?: CSSProperties | undefined;
+  offline?: boolean;
+  width?: number;
+  height?: number;
+}) {
+  const symbol = DEVICE_SYMBOLS[kind];
+  return (
+    <svg
+      className={`ui-device-glyph${className ? ` ${className}` : ""}`}
+      data-device={kind}
+      data-symbol={symbol}
+      data-offline={offline ? "" : undefined}
+      style={style}
+      width={width}
+      height={height}
+      viewBox={DEVICE_GLYPH_VIEWBOX}
+      aria-hidden="true"
+      focusable="false"
+    >
+      <DeviceGlyphShapes kind={kind} />
+    </svg>
+  );
+}
+
+/// The glyph's paths alone, for an icon that already draws its own `<svg>` with the shared
+/// `DEVICE_GLYPH_VIEWBOX` (the location picker's EnvironmentIcon, the composer chip).
+export function DeviceGlyphShapes({ kind }: { kind: DeviceKind }) {
+  const glyph = DEVICE_GLYPH_PATHS[DEVICE_SYMBOLS[kind]] ?? DEVICE_GLYPH_PATHS[DEVICE_SYMBOLS.generic];
+  return (
+    <g data-device={kind}>
+      {glyph?.map((layer, index) => (
+        <path key={index} d={layer.d} fill="currentColor" fillRule={layer.rule ?? "nonzero"} stroke="none" />
+      ))}
+    </g>
+  );
+}
+
+/// The glyph of a machine the daemon described: this machine when `machine` is absent, else the
+/// peer it names. `fallback` is the kind until the daemon says (an older daemon never does).
+export function MachineGlyph({
+  machine,
+  fallback,
+  ...rest
+}: { machine?: string; fallback: DeviceKind } & Omit<Parameters<typeof DeviceGlyph>[0], "kind">) {
+  const kind = useDeviceKind(machine) ?? fallback;
+  return <DeviceGlyph kind={kind} {...rest} />;
+}
