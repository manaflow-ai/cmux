diff --git a/webviews/src/agent-session/acpmux/cloudLastPick.ts b/webviews/src/agent-session/acpmux/cloudLastPick.ts
new file mode 100644
index 00000000000..b5b715f223c
--- /dev/null
+++ b/webviews/src/agent-session/acpmux/cloudLastPick.ts
@@ -0,0 +1,102 @@
+// The agent and model last picked for a Cloud machine: Cloud's own bucket, apart from This Mac's
+// (lastPick.ts). Austin, 2026-11-27: "Cloud + autocloud have their own bucket of models and this mac
+// is just your local setup ... We should store a state for the local models and a different state for
+// the cloud+autocloud so that we can remain consistent". A Cloud pick (cloudAgentPick.ts holds it for
+// the page) is remembered here, never in This Mac's last pick; the next page with Cloud picked shows
+// it and its first send names it, so a Cloud chat never starts on the agent This Mac last used.
+// This page's storage ends with the launch, so the app keeps a copy (`newTab.remember` with
+// `place: "cloud"`, AgentPaneLastPicks `cloud`) and the New Tab context brings it back (`lastPicks.cloud`).
+import { useMemo, useSyncExternalStore } from "react";
+import { postNative } from "./native";
+
+export type CloudLastPick = { harness: string; model?: string };
+
+const STORAGE_KEY = "cmux.acpmux.cloudLastPick";
+
+const listeners = new Set<() => void>();
+
+function parse(value: unknown): CloudLastPick | undefined {
+  const pick = value as Partial<CloudLastPick> | null;
+  if (typeof pick?.harness !== "string" || pick.harness === "" || pick.harness.length > 128) return undefined;
+  const model =
+    typeof pick.model === "string" && pick.model !== "" && pick.model.length <= 256 ? pick.model : undefined;
+  return model ? { harness: pick.harness, model } : { harness: pick.harness };
+}
+
+type Stored = { pick?: CloudLastPick; picked?: boolean };
+
+function read(): Stored {
+  try {
+    const parsed = JSON.parse(globalThis.localStorage?.getItem(STORAGE_KEY) ?? "{}") as Stored | null;
+    const pick = parse(parsed?.pick);
+    return { ...(pick ? { pick } : {}), ...(parsed?.picked === true ? { picked: true } : {}) };
+  } catch {
+    return {};
+  }
+}
+
+function write(stored: Stored): void {
+  try {
+    globalThis.localStorage?.setItem(STORAGE_KEY, JSON.stringify(stored));
+  } catch {
+    // Storage unavailable: the next Cloud page starts on This Mac's last pick, as before.
+  }
+  for (const listener of listeners) listener();
+}
+
+/** The Cloud pick last made, if any. */
+export function cloudLastPick(): CloudLastPick | undefined {
+  return read().pick;
+}
+
+/** The app's copy (the New Tab context's `lastPicks.cloud`) seeds this page until the page picks. */
+export function seedCloudLastPick(value: unknown): void {
+  if (read().picked) return;
+  const pick = parse(value);
+  if (pick) write({ pick });
+}
+
+/// Remembers `pick` as Cloud's: the agent and model the next page with Cloud picked starts on.
+/// `post` sends it to the app (a page's `callNative`); else the page's native bridge.
+export function rememberCloudPick(
+  pick: CloudLastPick,
+  post?: (method: string, params: Record<string, unknown>) => Promise<unknown>,
+): void {
+  const kept = parse(pick);
+  if (!kept) return;
+  const before = read().pick;
+  // A pick naming no model keeps the model last picked on the same agent.
+  const next = kept.model || before?.harness !== kept.harness ? kept : before;
+  write({ pick: next, picked: true });
+  const params = { agent: next.harness, ...(next.model ? { model: next.model } : {}), place: "cloud" };
+  const direct = post ? undefined : globalThis.window?.cmuxAcpmuxActions?.["newTab.remember"];
+  const send = post ?? ((method: string, body: typeof params) => (direct ? direct(body) : postNative(method, body)));
+  try {
+    void Promise.resolve(send("newTab.remember", params)).catch(() => undefined);
+  } catch {
+    // No bridge (a test page): this page still keeps it.
+  }
+}
+
+/** Tests only: forgets the pick. */
+export function clearCloudLastPick(): void {
+  try {
+    globalThis.localStorage?.removeItem(STORAGE_KEY);
+  } catch {
+    // Nothing kept.
+  }
+  for (const listener of listeners) listener();
+}
+
+/** `cloudLastPick()`, drawn again when a pick is remembered or the app's copy arrives. */
+export function useCloudLastPick(): CloudLastPick | undefined {
+  const key = useSyncExternalStore(
+    (listener) => {
+      listeners.add(listener);
+      return () => listeners.delete(listener);
+    },
+    () => JSON.stringify(cloudLastPick() ?? null),
+    () => "null",
+  );
+  return useMemo(() => (JSON.parse(key) as CloudLastPick | null) ?? undefined, [key]);
+}
diff --git a/webviews/src/agent-session/acpmux/cloudStartOpened.test.ts b/webviews/src/agent-session/acpmux/cloudStartOpened.test.ts
new file mode 100644
index 00000000000..d762d4819c4
--- /dev/null
+++ b/webviews/src/agent-session/acpmux/cloudStartOpened.test.ts
@@ -0,0 +1,62 @@
+import { expect, test } from "bun:test";
+import { cloudStartBegun, type CloudStartProgress } from "./cloudStartProgress";
+import {
+  cloudChatFirstPage,
+  cloudStartOpened,
+  cloudStartOpenedSettled,
+  cloudStartWaitsForFirstPage,
+} from "./cloudStartOpened";
+
+const OPENED_AT = 1_000;
+const started = (): CloudStartProgress => ({ ...cloudStartBegun("k", "fix the tests", "/tmp/repo"), stalled: true });
+const opened = () => cloudStartOpened(started(), "k", OPENED_AT)!;
+const row = (kind: string, at = OPENED_AT + 1, text?: string) => ({ kind, at, text });
+
+test("an ok answer keeps the card, marked opened, from now", () => {
+  const start = opened();
+  expect(start.opened).toBe(true);
+  expect(start.state).toBe("starting");
+  expect(start.advancedAt).toBe(OPENED_AT);
+  expect(start.stalled).toBeUndefined();
+  expect(start.task).toBe("fix the tests");
+  // Another start's answer changes nothing.
+  expect(cloudStartOpened(started(), "other")).toEqual(started());
+});
+
+test("the card shows until the Cloud chat has a session with a row of its own", () => {
+  const start = opened();
+  expect(cloudStartWaitsForFirstPage(start, { rows: [] })).toBe(true);
+  expect(cloudStartWaitsForFirstPage(start, { sessionId: "s", rows: [] })).toBe(true);
+  expect(cloudStartWaitsForFirstPage(start, { sessionId: "s", rows: [row("notice")] })).toBe(true);
+  expect(cloudStartWaitsForFirstPage(start, { sessionId: "s", rows: [row("user")] })).toBe(false);
+  expect(cloudStartWaitsForFirstPage(started(), { rows: [] })).toBe(false);
+  expect(cloudChatFirstPage({ rows: [row("user")] })).toBe(false);
+});
+
+test("the first page settles the card away", () => {
+  expect(cloudStartOpenedSettled(opened(), { sessionId: "s", rows: [row("user")] })).toBeUndefined();
+  expect(cloudStartOpenedSettled(opened(), { sessionId: "s", rows: [] })).toEqual(opened());
+});
+
+test("a failure on the way shows on the card in its own words, prompt kept, no Retry", () => {
+  const byHost = cloudStartOpenedSettled(opened(), { rows: [], hostError: "The Cloud machine stopped answering." })!;
+  expect(byHost.state).toBe("failed");
+  expect(byHost.message).toBe("The Cloud machine stopped answering.");
+  expect(byHost.task).toBe("fix the tests");
+  expect(byHost.opened).toBeUndefined();
+  expect(byHost.retryable).toBe(false);
+  const byStart = cloudStartOpenedSettled(opened(), {
+    rows: [row("notice", OPENED_AT, "Couldn't start the agent: no usage left")],
+  })!;
+  expect(byStart.state).toBe("failed");
+  expect(byStart.message).toBe("Couldn't start the agent: no usage left");
+});
+
+test("a notice from before the open is not this start's failure", () => {
+  expect(cloudStartOpenedSettled(opened(), { rows: [row("notice", OPENED_AT - 1, "old")] })).toEqual(opened());
+});
+
+test("a start not opened is left alone", () => {
+  expect(cloudStartOpenedSettled(started(), { sessionId: "s", rows: [row("user")] })).toEqual(started());
+  expect(cloudStartOpenedSettled(undefined, { rows: [] })).toBeUndefined();
+});
diff --git a/webviews/src/agent-session/acpmux/cloudStartOpened.ts b/webviews/src/agent-session/acpmux/cloudStartOpened.ts
new file mode 100644
index 00000000000..81f032a7d62
--- /dev/null
+++ b/webviews/src/agent-session/acpmux/cloudStartOpened.ts
@@ -0,0 +1,63 @@
+import type { CloudStartProgress } from "./cloudStartProgress";
+
+/// A Cloud start the host opened, until its chat shows (Austin, 2026-11-27: "the initial chat loads and then when we
+/// do a “transition” to a cloud chat it likes blinks out and then changes the chat… sometimes there is an error and
+/// the chat just goes blank and stuff or loads forever").
+///
+/// A start in place keeps this page (cmux-cloud-start-core `one_pane`): its socket closes, its reconnect starts the
+/// chat on the Cloud machine, and `cloud.startChat` answers ok meanwhile. Clearing the card on that answer drew an
+/// empty chat (no session, no rows) until the Cloud chat's first frame came: the blink. A start whose Cloud session
+/// then failed left that empty chat for good. The card, with the sent prompt, now stays until the Cloud chat's first
+/// page has a row of its own, and a failure on the way turns it into the failed card, prompt kept.
+
+/// What the page shows of its chat now, as far as the hand-off reads it.
+export type CloudStartOpenedView = {
+  /// The chat the snapshot shows (undefined before the Cloud session's first frame).
+  sessionId?: string;
+  rows: readonly { kind: string; at: number; text?: unknown }[];
+  /// The host's failure to hand the page acpmux, once the pane shows it (App.tsx `hostErrorShown`).
+  hostError?: string;
+};
+
+/// The host answered start `key` ok: the card stays, marked opened, until the chat shows (`cloudStartOpenedSettled`).
+export function cloudStartOpened(
+  current: CloudStartProgress | undefined,
+  key: string,
+  now: number = Date.now(),
+): CloudStartProgress | undefined {
+  if (current?.key !== key || current.state !== "starting") return current;
+  const { ask: _ask, signingIn: _signingIn, stalled: _stalled, ...rest } = current;
+  return { ...rest, opened: true, advancedAt: now };
+}
+
+/// Whether the Cloud chat's first page is drawn: its session, with a row that is not only a notice.
+export function cloudChatFirstPage(view: CloudStartOpenedView): boolean {
+  return Boolean(view.sessionId) && view.rows.some((row) => row.kind !== "notice");
+}
+
+/// An opened start as the chat stands now: gone once the Cloud chat's first page is drawn; failed, in the
+/// failure's own words, when the pane's line to the host failed or the chat's start said why (a notice row since the
+/// open and nothing else); else as it was (its stall bound, `watchCloudStartStall`, still runs).
+export function cloudStartOpenedSettled(
+  current: CloudStartProgress | undefined,
+  view: CloudStartOpenedView,
+): CloudStartProgress | undefined {
+  if (!current?.opened || current.state !== "starting") return current;
+  if (cloudChatFirstPage(view)) return undefined;
+  const since = current.advancedAt ?? 0;
+  const notice = view.rows.find(
+    (row) => row.kind === "notice" && row.at >= since && typeof row.text === "string" && row.text,
+  );
+  const message = view.hostError || (notice?.text as string | undefined);
+  if (!message) return current;
+  const { opened: _opened, stalled: _stalled, ...rest } = current;
+  return { ...rest, state: "failed", code: "cloud_chat_open_failed", message, retryable: false };
+}
+
+/// Whether the card shows for an opened start: until the Cloud chat's first page is drawn.
+export function cloudStartWaitsForFirstPage(
+  start: CloudStartProgress | undefined,
+  view: CloudStartOpenedView,
+): boolean {
+  return start?.opened === true && !cloudChatFirstPage(view);
+}
