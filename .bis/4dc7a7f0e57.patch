@@ -0,0 +1,68 @@
+// The chat render pipeline experiment (rule R7, cmuxterm-hq docs/design/chat-render-pipeline.md): with it
+// off a row frame's style is exactly the one before the experiment; with it on, settled rows hold their
+// indexed height under `content-visibility: auto` and the running turn never does.
+import { expect, test } from "bun:test";
+import { renderToStaticMarkup } from "react-dom/server";
+import { createElement } from "react";
+import type { AcpmuxRow } from "../model";
+import { WORKED } from "./turns";
+import { isSettledRow, rowFrameStyle, settledBefore, settledRowHeight } from "./settledRowSkip";
+
+const row = (id: string, kind: string, extra: Partial<AcpmuxRow> = {}): AcpmuxRow =>
+  ({ id, kind, ...extra }) as AcpmuxRow;
+const geometry = { heightAt: (index: number) => 100 + index };
+
+// Two ended turns, then the running one: its prompt, a running call and the streaming reply.
+const rows: AcpmuxRow[] = [
+  row("u1", "user"),
+  row("a1", "assistant"),
+  row("w1", WORKED),
+  row("u2", "user"),
+  row("t2", "tool", { status: "completed" }),
+  row("a2", "assistant"),
+  row("u3", "user"),
+  row("t3", "tool", { status: "in_progress" }),
+  row("a3", "assistant", { streaming: true }),
+];
+
+test("off: no row is settled and the rows are not scanned", () => {
+  expect(settledBefore(rows, false)).toBe(0);
+  for (const [index, each] of rows.entries()) expect(settledRowHeight(false, each, index, 6, geometry)).toBeUndefined();
+});
+
+test("off: the row frame's style is exactly top and marginTop", () => {
+  expect(rowFrameStyle(40, 40.5, undefined)).toStrictEqual({ top: 40, marginTop: 0.5 });
+  expect(renderToStaticMarkup(createElement("div", { style: rowFrameStyle(40, 40.5, undefined) }))).toBe(
+    '<div style="top:40px;margin-top:0.5px"></div>',
+  );
+});
+
+test("on: rows of ended turns hold their indexed height, the running turn's never do", () => {
+  const before = settledBefore(rows, true);
+  expect(before).toBe(6);
+  const held = rows.map((each, index) => settledRowHeight(true, each, index, before, geometry));
+  expect(held).toEqual([100, 101, 102, 103, 104, 105, undefined, undefined, undefined]);
+});
+
+test("on: the turn's end marks settle rows in the latest turn, never one that streams or runs", () => {
+  expect(isSettledRow(row("s", "turnSummary"), 9, 0)).toBe(true);
+  expect(isSettledRow(row("w", WORKED), 9, 0)).toBe(true);
+  expect(isSettledRow(row("f", "tool", { settled: true }), 9, 0)).toBe(true);
+  expect(isSettledRow(row("a", "assistant"), 9, 0)).toBe(false);
+  expect(isSettledRow(row("l", "thinking", { live: true, settled: true }), 0, 5)).toBe(false);
+  expect(isSettledRow(row("p", "user", { pending: true }), 0, 5)).toBe(false);
+  expect(isSettledRow(row("r", "tool", { status: "running" }), 0, 5)).toBe(false);
+});
+
+test("on: a held row's style skips it off screen at its height", () => {
+  expect(rowFrameStyle(40, 40, 230)).toStrictEqual({
+    top: 40,
+    marginTop: 0,
+    contentVisibility: "auto",
+    containIntrinsicBlockSize: "auto 230px",
+  });
+});
+
+test("no prompt yet: nothing is settled by position", () => {
+  expect(settledBefore([row("a", "assistant", { streaming: true })], true)).toBe(0);
+});
diff --git a/webviews/src/agent-session/acpmux/conversation/settledRowSkip.ts b/webviews/src/agent-session/acpmux/conversation/settledRowSkip.ts
new file mode 100644
index 00000000000..0ca1ba1ae97
--- /dev/null
+++ b/webviews/src/agent-session/acpmux/conversation/settledRowSkip.ts
@@ -0,0 +1,57 @@
+// The chat render pipeline experiment (chatRenderPipeline.experiment.ts, `experiments.chat_render_pipeline`):
+// rule R7 of cmuxterm-hq docs/design/chat-render-pipeline.md, "Off-screen rows cost nothing". A settled
+// row takes `content-visibility: auto` with `contain-intrinsic-block-size: auto <its indexed height>`,
+// so the browser skips its style, layout and paint while it is off screen and holds its place at the
+// height the layout already has for it. The streaming row, the live line and the running turn never
+// take it: an off-screen row that is skipped keeps its remembered size, so a row that can still grow
+// must stay drawn. With the experiment off nothing here changes a row.
+import type { CSSProperties } from "react";
+import type { AcpmuxRow } from "../model";
+import { WORKED } from "./turns";
+
+/// The index of the latest prompt (`user` row): rows above it belong to turns that have ended, the
+/// running turn included its prompt and everything under it. 0 when the experiment is off, so no row
+/// counts as settled by position and the rows are not scanned.
+export function settledBefore(rows: readonly AcpmuxRow[], on: boolean): number {
+  if (!on) return 0;
+  for (let index = rows.length - 1; index >= 0; index -= 1) if (rows[index]!.kind === "user") return index;
+  return 0;
+}
+
+const RUNNING = new Set(["pending", "in_progress", "running"]);
+
+/// Whether the row at `index` is settled: a row of an ended turn above the latest prompt, or one the
+/// turn's end marked (work folded under "Worked for", an ended turn's card, its footer). Never a row
+/// that streams, the live line, a pending row or a call still running.
+export function isSettledRow(row: AcpmuxRow, index: number, before: number): boolean {
+  if (row.streaming || row.live || row.pending) return false;
+  if (row.status !== undefined && RUNNING.has(row.status)) return false;
+  if (index < before) return true;
+  return row.settled === true || row.ended === true || row.kind === WORKED || row.kind === "turnSummary";
+}
+
+/// The height a row's frame holds while the browser skips it, or undefined to draw it as before.
+export function settledRowHeight(
+  on: boolean,
+  row: AcpmuxRow,
+  index: number,
+  before: number,
+  geometry: { heightAt(index: number): number },
+): number | undefined {
+  if (!on || !isSettledRow(row, index, before)) return undefined;
+  return geometry.heightAt(index);
+}
+
+/// The row frame's inline style. Without a held height it is exactly the style the frame had before
+/// the experiment (`top` and `marginTop`, no other key), so the DOM is unchanged with it off.
+export function rowFrameStyle(
+  integralTop: number,
+  placedTop: number,
+  intrinsicHeight: number | undefined,
+): CSSProperties {
+  const style: CSSProperties = { top: integralTop, marginTop: placedTop - integralTop };
+  if (intrinsicHeight === undefined) return style;
+  style.contentVisibility = "auto";
+  style.containIntrinsicBlockSize = `auto ${intrinsicHeight}px`;
+  return style;
+}
