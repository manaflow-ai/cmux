+import { StableLabel } from "../../../ui/StableLabel";
+import { useT } from "../i18n";
+import type { PullRequestOps } from "./pullRequestOps";
+
+export function PullRequestActions({ ops }: { ops: PullRequestOps }) {
+  const t = useT();
