+    let done = false;
+    let asked = false;
+    let waited = false;
+    const finish = (items: KnownPaths | undefined) => {
+      if (done) return;
+      done = true;
+      waiting.delete(wake);
+      clearTimeout(timer);
+      resolve(items);
+    };
