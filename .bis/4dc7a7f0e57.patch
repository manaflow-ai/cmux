diff --git a/webviews/test/chat-switch-one-shape.test.ts b/webviews/test/chat-switch-one-shape.test.ts
new file mode 100644
index 00000000000..ca224699892
--- /dev/null
+++ b/webviews/test/chat-switch-one-shape.test.ts
@@ -0,0 +1,108 @@
+// l10n-allow-file: test fixture prompts and replies, not shipped UI.
+//
+// The render that first shows another chat runs with the folds of the chat it left: AcpmuxPane puts
+// the shown chat's own folds in `expanded` later in that render, and React renders it again. Shaped
+// in that first pass, every turn was shaped under folds the kept turns were not shaped with, and that
+// pass's turns, kept as the last ones, made the pass React keeps shape every turn again (settled-page
+// bench, chat_switch: two whole shapes a switch, a switch back included). These hold a switch to the
+// turns kept for the chat (a switch back's, or those shaped ahead, pane/useTurnActions.ts `shapeAhead`).
+import { expect, test } from "bun:test";
+import type { AcpmuxRow } from "../src/agent-session/acpmux/model";
+import { turnRowsShownFrom, type TurnRowsShownDeps } from "../src/agent-session/acpmux/pane/useTurnActions";
+
+let at = 0;
+const row = (id: string, kind: string, extra: Partial<AcpmuxRow> = {}): AcpmuxRow => ({
+  id,
+  kind,
+  version: 1,
+  at: (at += 1_000),
+  ...extra,
+});
+/** `count` finished turns of chat `name`. */
+const chat = (name: string, count: number) =>
+  Array.from({ length: count }, (_, turn) => [
+    row(`${name}-u${turn}`, "user", { text: `Step ${turn}` }),
+    row(`${name}-a${turn}`, "assistant", { text: `Step ${turn} done.` }),
+    row(`${name}-e${turn}`, "turnSummary", { status: "completed", durationMs: 4_000 }),
+  ]).flat();
+
+/** A snapshot's lists keep their identity across renders, as the client keeps them. */
+const NO_BREAKS: TurnRowsShownDeps["messageBreaks"] = [];
+const NO_STEERS: TurnRowsShownDeps["snapshot"]["waitingSteers"] = [];
+
+/** One pane's refs across chats, as AcpmuxPane keeps them. */
+function pane() {
+  const lastTurns: TurnRowsShownDeps["lastTurns"] = { current: undefined };
+  const pastTurns: NonNullable<TurnRowsShownDeps["pastTurns"]> = { current: new Map() };
+  const foldsSeen: TurnRowsShownDeps["foldsSeen"] = { current: {} };
+  const heldCalls: TurnRowsShownDeps["heldCalls"] = { current: { keys: new Set() } };
+  const heldRuns: TurnRowsShownDeps["heldRuns"] = { current: { keys: new Set() } };
+  const heldWorked = { current: { keys: new Set<string>() } as TurnRowsShownDeps["heldWorked"]["current"] };
+  const heldFolds: TurnRowsShownDeps["heldFolds"] = { current: { keys: new Set() } };
+  const shown = (shownSessionId: string, sourceRows: AcpmuxRow[], folds: Set<string>) =>
+    turnRowsShownFrom({
+      chatPresentation: "transcript" as TurnRowsShownDeps["chatPresentation"],
+      childRows: undefined,
+      sourceRows,
+      panelAsks: new Set(),
+      started: [],
+      startedCache: { current: new Map() },
+      doneLines: { current: new Map() },
+      workflowLabsEnabled: false,
+      lastTurns,
+      pastTurns,
+      shownSessionId,
+      heldCalls,
+      callRelease: 0,
+      transcriptInView: { current: () => null },
+      heldRuns,
+      heldWorked,
+      heldWorkedClosing: { current: false },
+      snapshot: {
+        isWorking: false,
+        canLoadNewer: false,
+        clockOffsetMs: 0,
+        turnStartedAtMs: undefined,
+        waitingSteers: NO_STEERS,
+      },
+      messageBreaks: NO_BREAKS,
+      supersededReplyIds: undefined,
+      foldsSeen,
+      folds,
+      heldFolds,
+      chatShellRuns: [],
+    });
+  return { lastTurns, pastTurns, shown };
+}
+
+test("a switch back shapes the chat once, from the turns it kept, not twice from none", () => {
+  const { lastTurns, pastTurns, shown } = pane();
+  const [rowsA, rowsB] = [chat("a", 40), chat("b", 40)];
+  const [foldsA, foldsB] = [new Set<string>(), new Set<string>()];
+  shown("b", rowsB, foldsB);
+  const keptB = lastTurns.current!.turns;
+  shown("a", rowsA, foldsA);
+  const shownA = lastTurns.current;
+  expect(pastTurns.current.get("b")?.turns).toBe(keptB);
+  // The pass React throws away: chat B with chat A's folds. It keeps nothing from it.
+  shown("b", rowsB, foldsA);
+  expect(lastTurns.current).toBe(shownA);
+  expect(pastTurns.current.get("b")?.turns).toBe(keptB);
+  // The pass React keeps, with B's own folds, reuses the turns B kept.
+  const drawn = shown("b", rowsB, foldsB);
+  expect(lastTurns.current!.sessionId).toBe("b");
+  // Nothing in B changed while it was away: turnViewFrom hands back the very turns B kept, shaping none.
+  expect(lastTurns.current!.turns).toBe(keptB);
+  expect(drawn.map((each) => each.id)).toContain("b-a39");
+});
+
+test("the first show of a chat nothing was kept for shapes it in the first pass, as before", () => {
+  const { lastTurns, shown } = pane();
+  const [rowsA, rowsC] = [chat("a", 3), chat("c", 3)];
+  const [foldsA, foldsC] = [new Set<string>(), new Set<string>()];
+  shown("a", rowsA, foldsA);
+  const first = shown("c", rowsC, foldsA);
+  expect(first.map((each) => each.id)).toContain("c-a2");
+  expect(lastTurns.current!.sessionId).toBe("c");
+  expect(shown("c", rowsC, foldsC).map((each) => each.id)).toContain("c-a2");
+});
diff --git a/webviews/test/chat-switch-warm-ahead.test.ts b/webviews/test/chat-switch-warm-ahead.test.ts
new file mode 100644
index 00000000000..6b5aa12e2bf
--- /dev/null
+++ b/webviews/test/chat-switch-warm-ahead.test.ts
@@ -0,0 +1,249 @@
+// l10n-allow-file: test fixture prompts and replies, not shipped UI.
+//
+// The first switch to a chat this page never showed did all the work a switch back skips: its rows
+// were folded into new objects and every turn was shaped again (settled-page bench, chat_switch).
+// While the page is idle the client folds the likely next chat's kept tail ahead (direct.ts
+// `warmRows`) and the pane shapes those rows into turns (pane/useTurnActions.ts `shapeAhead`).
+// These hold that work to being reused, not redone:
+//
+//   - the first frame of a switch to a chat folded ahead draws the very row objects folded ahead;
+//   - the turns shaped ahead are reused whole by that frame's shaping;
+//   - a chat that ran on after it was folded ahead draws what it says now, not the rows folded ahead.
+import { afterAll, beforeAll, expect, test } from "bun:test";
+import { JSDOM } from "jsdom";
+import { AcpmuxDirectClient, type WarmedChat } from "../src/agent-session/acpmux/direct";
+import type { AcpmuxSnapshot } from "../src/agent-session/acpmux/model";
+import { NO_MESSAGE_BREAKS, turnViewFrom, type TurnView } from "../src/agent-session/acpmux/conversation/turns";
+import { shapeAhead } from "../src/agent-session/acpmux/pane/useTurnActions";
+import type { SubagentRows } from "../src/agent-session/acpmux/subagents/subagentRows";
+import { settleReact } from "./support/domTeardown";
+
+const START = Date.UTC(2026, 10, 28, 9, 0, 0);
+const dom = new JSDOM("<!doctype html>", { url: "http://localhost/" });
+const scope = globalThis as Record<string, unknown>;
+const saved = { window: scope.window, document: scope.document, had: "window" in scope };
+
+beforeAll(() => {
+  scope.window = dom.window;
+  scope.document = dom.window.document;
+});
+
+afterAll(async () => {
+  await settleReact();
+  if (saved.had) Object.assign(scope, { window: saved.window, document: saved.document });
+  else {
+    delete scope.window;
+    delete scope.document;
+  }
+});
+
+type Message = { id?: number; method: string; params?: Record<string, unknown> };
+type Step = [dir: string, kind: string, msg: Record<string, unknown>];
+
+const prompt = (text: string): Step => ["mux", "user_message", { text }];
+const reply = (sessionId: string, text: string): Step => [
+  "in",
+  "agent_message_chunk",
+  {
+    method: "session/update",
+    params: { sessionId, update: { sessionUpdate: "agent_message_chunk", content: { type: "text", text } } },
+  },
+];
+const DONE: Step = ["mux", "turn_result", { status: "completed" }];
+
+/** acpmux for two chats, each answering its attach with `pages[sessionId]`; `hold` keeps one attach unanswered. */
+class Daemon {
+  readonly sessionA: string;
+  readonly sessionB: string;
+  readonly pages = new Map<string, Step[]>();
+  hold?: string;
+  private held?: { socket: Socket; message: Message };
+  private holding?: () => void;
+  asked = new Promise<void>((resolve) => (this.holding = resolve));
+
+  constructor(name: string) {
+    this.sessionA = `${name}-a`;
+    this.sessionB = `${name}-b`;
+  }
+
+  /** One connection: each client opens its own. */
+  socket(): Socket {
+    return new Socket(this);
+  }
+
+  heard(socket: Socket, message: Message): void {
+    if (message.id === undefined) return;
+    if (message.method === "_acpmux/attach" && message.params?.sessionId === this.hold) {
+      this.held = { socket, message };
+      this.hold = undefined;
+      this.holding?.();
+      return;
+    }
+    queueMicrotask(() => this.answer(socket, message));
+  }
+
+  release(): void {
+    const held = this.held;
+    this.held = undefined;
+    if (held) this.answer(held.socket, held.message);
+  }
+
+  private summary(sessionId: string) {
+    return {
+      sessionId,
+      cwd: "/home/dev/project",
+      title: `Chat ${sessionId}`,
+      harness: "claude",
+      status: "idle",
+      turnCount: 2,
+      updatedAt: START,
+    };
+  }
+
+  private answer(socket: Socket, message: Message): void {
+    const sessionId = String(message.params?.sessionId ?? "");
+    let result: unknown = {};
+    if (message.method === "initialize")
+      result = { protocolVersion: 1, _meta: { acpmux: { origin: "local", extensions: [], operations: [] } } };
+    else if (message.method === "_acpmux/watch")
+      result = { sessions: [this.summary(this.sessionA), this.summary(this.sessionB)] };
+    else if (message.method === "_acpmux/attach") {
+      const records = (this.pages.get(sessionId) ?? []).map(([dir, kind, msg], at) => ({
+        sessionId,
+        seq: at + 1,
+        at: START + (at + 1) * 1000,
+        dir,
+        kind,
+        msg,
+      }));
+      result = { session: this.summary(sessionId), lastSeq: records.at(-1)?.seq ?? 0, events: records, hasMore: false };
+    } else if (message.method === "_acpmux/events") result = { events: [], hasMore: false, lastSeq: 0 };
+    if (socket.readyState === 1)
+      socket.onmessage?.({ data: JSON.stringify({ jsonrpc: "2.0", id: message.id, result }) });
+  }
+}
+
+class Socket {
+  readyState = 0;
+  onopen: (() => void) | null = null;
+  onerror: (() => void) | null = null;
+  onclose: (() => void) | null = null;
+  onmessage: ((message: { data: string }) => void) | null = null;
+
+  constructor(private readonly daemon: Daemon) {
+    queueMicrotask(() => {
+      this.readyState = 1;
+      this.onopen?.();
+    });
+  }
+
+  send(raw: string): void {
+    this.daemon.heard(this, JSON.parse(raw) as Message);
+  }
+
+  close(): void {
+    this.readyState = 3;
+  }
+}
+
+const connect = async (daemon: Daemon, sessionId: string) => {
+  const drawn: AcpmuxSnapshot[] = [];
+  const client = await AcpmuxDirectClient.connect(
+    { protocolVersion: 1, transport: "acpmux-websocket", endpoint: "ws://warm.invalid/", token: "t", sessionId },
+    (snapshot) => {
+      if (snapshot.type === "snapshot") drawn.push(snapshot);
+    },
+    undefined,
+    () => daemon.socket() as unknown as WebSocket,
+  );
+  return { client, last: () => drawn.at(-1)! };
+};
+
+/** Two chats of a few turns each; chat B gets a kept tail from a page that showed it, then closed. */
+const twoChats = async (name: string) => {
+  const daemon = new Daemon(name);
+  const [A, B] = [daemon.sessionA, daemon.sessionB];
+  daemon.pages.set(A, [prompt("Look at the retry path"), reply(A, "Retry added."), DONE]);
+  daemon.pages.set(B, [
+    prompt("Docs"),
+    reply(B, "Docs updated."),
+    DONE,
+    prompt("And the changelog"),
+    reply(B, "Changelog entry added."),
+    DONE,
+  ]);
+  const earlier = await connect(daemon, B);
+  await earlier.client.select(A);
+  earlier.client.close();
+  return { daemon, A, B };
+};
+
+const warmedOn = (client: AcpmuxDirectClient, sessionId: string) =>
+  new Promise<WarmedChat>((resolve) => {
+    const stop = client.onWarmed((warmed) => {
+      if (warmed.sessionId !== sessionId) return;
+      stop();
+      resolve(warmed);
+    });
+  });
+
+test("the first switch to a chat folded ahead draws the rows and turns made ahead", async () => {
+  const { daemon, A, B } = await twoChats("warm-first");
+  const { client, last } = await connect(daemon, A);
+  try {
+    const warmed = await warmedOn(client, B);
+    expect(warmed.rows.length).toBeGreaterThan(0);
+    const pastTurns = new Map<string, { sessionId: string | undefined; turns: TurnView; subagents: SubagentRows }>();
+    const expanded = new Set<string>();
+    shapeAhead(warmed, {
+      expanded,
+      doneLines: new Map(),
+      workflowLabsEnabled: false,
+      splitSilent: false,
+      clockOffset: undefined,
+      pastTurns,
+    });
+    const ahead = pastTurns.get(B)!.turns;
+    // B's attach held: the frame the switch lands on is drawn from its kept tail.
+    daemon.hold = B;
+    const opening = client.select(B);
+    await daemon.asked;
+    const shown = last();
+    expect(shown.sessionId).toBe(B);
+    // Every row the switch drew is the object folded ahead (OrderedRows.keepSame), not a new copy.
+    expect(shown.rows.length).toBe(warmed.rows.length);
+    shown.rows.forEach((row, at) => expect(row).toBe(warmed.rows[at]!));
+    // The switch's shaping reuses the turns shaped ahead: it shaped none again.
+    const turns = turnViewFrom(
+      shown.rows,
+      expanded,
+      { clockOffset: undefined, agentFamily: warmed.family, messageBreaks: NO_MESSAGE_BREAKS },
+      ahead,
+    );
+    expect(turns.reusedRows).toBeGreaterThan(0);
+    expect(turns.rows.slice(0, turns.reusedRows)).toEqual(ahead.rows.slice(0, turns.reusedRows));
+    turns.rows.slice(0, turns.reusedRows).forEach((row, at) => expect(row).toBe(ahead.rows[at]!));
+    daemon.release();
+    await opening;
+  } finally {
+    client.close();
+  }
+});
+
+test("a chat that ran on after it was folded ahead draws what it says now", async () => {
+  const { daemon, A, B } = await twoChats("warm-ran-on");
+  const { client, last } = await connect(daemon, A);
+  try {
+    await warmedOn(client, B);
+    // B ran on: its attach answers a reply the rows folded ahead do not hold.
+    daemon.pages.get(B)!.push(prompt("Tag it"), reply(B, "Tagged v1.2."), DONE);
+    await client.select(B);
+    const words = last()
+      .rows.map((row) => JSON.stringify(row))
+      .join(" ");
+    expect(words).toContain("Changelog entry added.");
+    expect(words).toContain("Tagged v1.2.");
+  } finally {
+    client.close();
+  }
+});
diff --git a/webviews/test/chat-switch-warm-running-command.test.ts b/webviews/test/chat-switch-warm-running-command.test.ts
new file mode 100644
index 00000000000..ab73456f699
--- /dev/null
+++ b/webviews/test/chat-switch-warm-running-command.test.ts
@@ -0,0 +1,55 @@
+// l10n-allow-file: test fixture prompts and commands, not shipped UI.
+//
+// A chat folded ahead (pane/useTurnActions.ts `shapeAhead`) is shaped as it rests, so the live line of
+// a turn it still runs was first read on the switch: its running command's words, a shell parse and a
+// rule match (~1.3 ms the first time on a page; settled-page bench, chat_switch stream). The shaping
+// ahead reads them, so the switch finds them kept (commandActions.ts `runningCommandSaid`).
+import { expect, test } from "bun:test";
+import type { AcpmuxRow } from "../src/agent-session/acpmux/model";
+import { runningSaidKept } from "../src/agent-session/acpmux/conversation/commandActions";
+import { shapeAhead } from "../src/agent-session/acpmux/pane/useTurnActions";
+
+let at = 0;
+const row = (id: string, kind: string, extra: Partial<AcpmuxRow> = {}): AcpmuxRow => ({
+  id,
+  kind,
+  version: 1,
+  at: (at += 1_000),
+  ...extra,
+});
+const call = (id: string, command: string, status: string): AcpmuxRow =>
+  row(id, "activity", { items: [{ tool: { id: `${id}-tool`, kind: "execute", title: command, command, status } }] } as Partial<AcpmuxRow>);
+
+const ahead = (sessionId: string, rows: AcpmuxRow[]) =>
+  shapeAhead(
+    { sessionId, rows, family: undefined },
+    {
+      expanded: new Set(),
+      doneLines: new Map(),
+      workflowLabsEnabled: false,
+      splitSilent: true,
+      clockOffset: undefined,
+      pastTurns: new Map(),
+    },
+  );
+
+test("a chat folded ahead mid-command keeps that command's live words for the switch", () => {
+  const before = runningSaidKept();
+  ahead("running", [
+    row("u0", "user", { text: "Check the logs" }),
+    call("c0", "tail -n 200 /var/log/warm-ahead-unique.log", "in_progress"),
+  ]);
+  expect(runningSaidKept()).toBe(before + 1);
+});
+
+test("finished commands and earlier turns' commands are not read ahead", () => {
+  const before = runningSaidKept();
+  ahead("rested", [
+    row("u0", "user", { text: "Build it" }),
+    call("c0", "make warm-ahead-earlier-turn", "in_progress"),
+    row("u1", "user", { text: "Now test" }),
+    call("c1", "make warm-ahead-finished", "completed"),
+    row("e1", "turnSummary", { status: "completed", durationMs: 4_000 }),
+  ]);
+  expect(runningSaidKept()).toBe(before);
+});
