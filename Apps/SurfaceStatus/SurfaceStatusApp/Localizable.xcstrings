          }
        }
      }
    },
    "manager.state.native": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブ"
          }
        }
      }
    },
    "manager.state.notInstalled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Installed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未インストール"
          }
        }
      }
    },
    "manager.state.unmanaged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unmanaged File"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理対象外のファイル"
          }
        }
      }
    },
    "manager.state.updateAvailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update Available"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートあり"
          }
        }
      }
    },
    "manager.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage optional Pi/OpenCode lifecycle adapters and Codex launch attribution for the bundled cmux sidebar extension."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同梱のcmuxサイドバー拡張機能用の、任意のPi/OpenCodeライフサイクルアダプターとCodex起動アトリビューションを管理します。"
          }
        }
      }
    },
    "manager.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CMUX Surface Status"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CMUX Surface Status"
          }
        }
      }
    },
    "manager.uninstall.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only app-owned Pi/OpenCode adapters and the Codex launch-attribution helper are removed. Native Claude and Codex hooks, agent sessions, Herdr hooks, and cmux settings are preserved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが所有するPi/OpenCodeアダプターとCodex起動帰属ヘルパーだけを削除します。ClaudeとCodexのネイティブフック、エージェントセッション、Herdrフック、cmux設定は保持されます。"
          }
        }
      }
    },
    "manager.uninstall.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uninstall lifecycle adapters?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライフサイクルアダプターをアンインストールしますか？"
          }
        }
      }
    }
  },
  "version": "1.0"
}
