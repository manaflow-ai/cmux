      "idempotency": "forbidden",
      "input": {
        "additionalProperties": false,
        "properties": {
          "machine": {
            "description": "machine_ id; the current machine when absent",
            "type": "string"
          },
          "agent": {
            "description": "Agent id (claude, codex, opencode, gemini, ...)",
            "type": "string"
          },
          "roots": {
            "description": "Project root handles to include besides user scope",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [],
        "type": "object"
      },
      "mcp": {
        "expose": "default",
        "group": "skill"
      },
      "name": "skill.list",
      "owner": "session_host",
      "palette": null,
