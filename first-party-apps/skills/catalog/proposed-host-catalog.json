    {
      "class": "mutation",
      "cli": {
        "path": "skills install",
        "visible": true
      },
      "docs": "Install a skill folder from a git repository or the store for the given agents. With dry_run: a diff resource of the new files and what the skill asks for.",
      "focuses": false,
      "idempotency": "required",
      "input": {
        "additionalProperties": false,
        "properties": {
          "machine": {
            "description": "machine_ id; the current machine when absent",
            "type": "string"
          },
          "agent": {
            "description": "Agent id (claude, codex, opencode, gemini, ...)",
            "type": "string"
          },
          "scope": {
            "description": "user (everywhere) or project",
            "type": "string",
            "enum": [
              "user",
              "project"
            ]
          },
          "root": {
            "description": "root_ handle of the project folder (project scope)",
            "type": "string"
          },
          "dry_run": {
            "description": "Plan only: return a diff resource with the exact edits and base revisions; write nothing",
            "type": "boolean"
          },
          "agents": {
            "description": "Agents to change in one plan",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "source": {
            "description": "{git, ref?, path?} (https or ssh) or {store}",
            "type": "object"
          }
        },
        "required": [
          "agents",
          "source",
          "scope"
        ],
        "type": "object"
      },
      "mcp": {
        "expose": "never"
      },
      "name": "skill.install",
      "owner": "session_host",
      "palette": null,
      "queue_offline": false,
      "remote_relay": "deny",
      "risk": "execute",
      "since": "skills/1",
      "origin": "user"
    },
