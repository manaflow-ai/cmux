{
  "$schema": "../../cmux-tui/crates/cmux-app-host/schema/v2/cmux-app.schema.json",
  "manifestVersion": 2,
  "id": "cmux/clock",
  "name": {
    "en": "Clock"
  },
  "version": "1.0.0",
  "description": {
    "en": "The time in big, bold numbers under today's date, like the iPhone Lock Screen. Larger sizes add other cities, how far ahead or behind they are and whether it is already tomorrow there. Choose a 12 or 24 hour clock, your cities, or an analog face. Works as soon as you add it."
  },
  "publisher": {
    "name": "cmux",
    "url": "https://cmux.com"
  },
  "repository": "https://github.com/manaflow-ai/cmux",
  "license": "GPL-3.0-or-later",
  "icon": "assets/icon.svg",
  "screenshots": [
    "screenshots/small-medium-large.png",
    "screenshots/analog.png"
  ],
  "categories": [
    "productivity"
  ],
  "keywords": [
    "clock",
    "time",
    "world clock",
    "time zones",
    "widget"
  ],
  "engines": {
    "cmux": "^2.0"
  },
  "runtime": {
    "main": "dist/main.js"
  },
  "implements": {
    "cmux.widget/1": {
      "export": "renderClock",
      "title": {
        "en": "Clock"
      },
      "symbol": "clock",
      "options": {
        "sizes": [
          "small",
          "medium",
          "large"
        ],
        "defaultSize": "small",
        "refresh": {
          "everySeconds": 60
        },
        "places": [
          "newtab",
          "sidebar"
        ]
      }
    }
  },
  "scopes": {},
  "settings": {
    "type": "object",
    "properties": {
      "hourCycle": {
        "type": "string",
        "title": "Clock",
        "description": "12 or 24 hours. Automatic follows your language and region.",
        "enum": [
          "system",
          "12h",
          "24h"
        ],
        "default": "system"
      },
      "cities": {
        "type": "string",
        "title": "Cities",
        "description": "Time zones by name, separated by commas, for example Europe/London, Asia/Tokyo. Leave empty for Los Angeles, New York, London, Tokyo and Sydney (skipping the ones at your own time).",
        "default": ""
      },
      "face": {
        "type": "string",
        "title": "Face",
        "description": "Digital numbers, or an analog dial (small and medium).",
        "enum": [
          "digital",
          "analog"
        ],
        "default": "digital"
      }
    }
  },
  "activation": [
    "onInterface:cmux.widget/1"
  ],
  "files": [
    "dist/",
    "assets/",
    "screenshots/"
  ]
}
