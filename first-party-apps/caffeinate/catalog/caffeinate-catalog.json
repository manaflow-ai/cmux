        "visible": true
      },
      "mcp": {
        "expose": "default"
      },
      "palette": {
        "title": "Keep Awake Until Stopped"
      },
      "docs": "Keep the Mac awake until you stop it.",
      "since": "caffeinate/1",
      "export": "keepAwake",
      "gesture": "required"
    },
    {
      "name": "caffeinate.keep_awake_hour",
      "owner": "app:cmux/caffeinate",
      "class": "mutation",
      "risk": "mutate-own",
      "idempotency": "required",
      "focuses": false,
      "queue_offline": false,
      "remote_relay": "deny",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "cli": {
        "path": "keep-awake-hour",
        "visible": true
      },
      "mcp": {
        "expose": "default"
      },
      "palette": {
        "title": "Keep Awake for 1 Hour"
      },
      "docs": "Keep the Mac awake for one hour.",
      "since": "caffeinate/1",
      "export": "keepAwakeHour"
    },
    {
      "name": "caffeinate.start",
      "owner": "app:cmux/caffeinate",
      "class": "mutation",
      "risk": "mutate-own",
      "idempotency": "required",
      "focuses": false,
      "queue_offline": false,
      "remote_relay": "deny",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "preset": {
            "type": "string",
            "enum": [
              "command",
              "untilStopped",
              "hour",
              "duration"
            ],
            "description": "command: until a terminal's command, a task or a process ends; untilStopped; hour; duration (needs minutes)."
          },
          "kinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "display",
                "idle",
                "disk",
                "system",
                "user"
              ]
            },
            "description": "What stays awake (caffeinate -d -i -m -s -u). Default: idle for command, display and idle otherwise."
          },
          "minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440,
            "description": "Time limit (caffeinate -t, in minutes)."
          },
          "terminal": {
            "type": "string",
            "description": "terminal_… handle: end when its current command finishes. Agents may pass only their own terminal."
          },
          "task": {
            "type": "string",
            "description": "task_… handle: end when the task finishes."
          },
          "pid": {
            "type": "integer",
            "minimum": 1,
            "description": "End when this process exits (caffeinate -w). People only; prefer terminal."
          },
          "reason": {
            "type": "string",
            "maxLength": 120,
            "description": "Shown in the system's power assertion list."
          },
          "request_id": {
            "type": "string",
            "description": "Idempotency key for retries."
          }
        },
        "required": []
      },
      "cli": {
        "path": "start",
        "visible": true
      },
      "mcp": {
        "expose": "default"
      },
      "docs": "Keep the Mac awake with a preset: until stopped, for a time, or until a terminal's command, a task or a process ends.",
      "since": "caffeinate/1",
      "export": "start",
      "palette": {
        "title": "Keep Awake…",
        "presets": [
          {
            "id": "until-stopped",
            "title": {
              "en": "Keep Awake Until Stopped",
              "ja": "停止するまでスリープしない"
            },
            "args": {
              "preset": "untilStopped"
            }
          },
          {
            "id": "one-hour",
            "title": {
              "en": "Keep Awake for 1 Hour",
              "ja": "1 時間スリープしない"
            },
            "args": {
              "preset": "hour"
            }
          },
          {
            "id": "while-command",
            "title": {
              "en": "Keep Awake While This Command Runs",
              "ja": "このコマンドの実行中はスリープしない"
            },
            "args": {
              "preset": "command"
            },
            "when": "paneFocused:terminal"
          }
        ]
      },
      "gesture": "optional"
    },
    {
      "name": "caffeinate.stop",
      "owner": "app:cmux/caffeinate",
      "class": "mutation",
      "risk": "mutate-shared",
      "idempotency": "required",
      "focuses": false,
      "queue_offline": false,
      "remote_relay": "deny",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "assertion": {
            "type": "string",
            "description": "pwr_… id from list. Stopping what someone else started needs a person (origin user)."
          }
        },
        "required": [
          "assertion"
        ]
      },
      "cli": {
        "path": "stop",
        "visible": true
      },
      "mcp": {
        "expose": "default"
      },
      "docs": "Stop one keep-awake assertion (pwr_ id from list). Stopping one that someone else started needs a person.",
      "since": "caffeinate/1",
      "export": "stop",
      "gesture": "required"
    },
    {
