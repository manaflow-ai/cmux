{
  "grant": [
    "power:read",
    "power:write",
    "terminal:read",
    "mcp:expose",
    "actions:run"
  ],
  "scopes": {
    "power.assertion.list": {
      "scope": "power:read",
      "class": "read"
    },
    "power.assertion.create": {
      "scope": "power:write",
      "class": "mutation"
    },
    "power.assertion.release": {
      "scope": "power:write",
      "class": "mutation"
    },
    "app.settings.set": {
      "scope": "settings:write",
      "class": "mutation"
    }
  },
  "ops": {
    "power.assertion.list": {
      "revision": "10",
      "available": true,
      "power_source": "ac",
      "assertions": [],
      "limits": {
        "max_per_app": 8,
        "max_timed_s": 86400
      }
    },
    "terminal.list": [
      {
        "id": "terminal_7",
