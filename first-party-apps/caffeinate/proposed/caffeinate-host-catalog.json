{
  "schema_version": 1,
  "family": "caffeinate",
  "owner": "app:cmux/caffeinate",
  "$comment": "App ops (owner app:cmux/caffeinate). They call the proposed host capability power.assertion.* (owner host:native on the target machine; README 'Power assertions'), which is not part of this fragment.",
  "operations": [
    {
      "name": "caffeinate.start",
      "owner": "app:cmux/caffeinate",
      "class": "mutation",
      "risk": "mutate-own",
      "docs": "Keep the Mac awake with a preset: until stopped, for a time, or until a terminal's command, a task or a process ends. Agents may bind only to their own terminal.",
      "cli": { "path": "power keep-awake", "visible": true },
      "code_mode": { "path": "mux.caffeinate.start" },
      "mcp": { "expose": "default", "group": "power" },
      "palette": [
        { "title": "Keep Awake Until Stopped", "args": { "preset": "untilStopped" } },
        { "title": "Keep Awake for 1 Hour", "args": { "preset": "hour" } },
        { "title": "Keep Awake While This Command Runs", "args": { "preset": "command", "terminal": "$context.terminal" }, "when": "context.terminal.busy" }
      ],
      "focuses": false,
      "idempotency": "optional",
      "queue_offline": false,
      "remote_relay": "deny",
      "since": "caffeinate/1",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "preset": { "enum": ["command", "untilStopped", "hour", "duration"] },
          "kinds": { "type": "array", "items": { "enum": ["display", "idle", "disk", "system", "user"] } },
          "minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
          "terminal": { "type": "string", "description": "terminal_… handle" },
          "task": { "type": "string", "description": "task_… handle" },
          "pid": { "type": "integer", "minimum": 1, "description": "origin user only" },
          "reason": { "type": "string", "maxLength": 120 }
        },
        "required": []
      },
      "output": { "type": "object", "properties": { "started": { "type": "boolean" }, "assertion": { "type": "string" }, "expires_at": { "type": ["string", "null"], "format": "date-time" }, "code": { "type": "string" } } },
      "x-implementation": "js:start"
    },
    {
      "name": "caffeinate.stop",
      "owner": "app:cmux/caffeinate",
      "class": "mutation",
      "risk": "mutate-shared",
      "docs": "Stop one assertion. Stopping what someone else started needs origin user.",
      "cli": { "path": "power stop", "visible": true },
      "code_mode": { "path": "mux.caffeinate.stop" },
      "mcp": { "expose": "default", "group": "power" },
      "palette": null,
      "focuses": false,
      "idempotency": "optional",
      "queue_offline": false,
      "remote_relay": "deny",
      "since": "caffeinate/1",
      "input": { "type": "object", "additionalProperties": false, "properties": { "assertion": { "type": "string" } }, "required": ["assertion"] },
      "x-implementation": "js:stop"
    },
    {
      "name": "caffeinate.stop_all",
      "owner": "app:cmux/caffeinate",
      "class": "mutation",
      "risk": "mutate-shared",
      "docs": "Stop every assertion the caller may stop (a person: all; an agent: its own).",
      "cli": { "path": "power stop --all", "visible": true },
      "code_mode": { "path": "mux.caffeinate.stopAll" },
      "mcp": { "expose": "default", "group": "power" },
      "palette": [{ "title": "Stop Keeping the Mac Awake", "args": {} }],
      "focuses": false,
      "idempotency": "optional",
      "queue_offline": false,
      "remote_relay": "deny",
      "since": "caffeinate/1",
      "input": { "type": "object", "additionalProperties": false, "properties": {}, "required": [] },
      "x-implementation": "js:stopAll"
    },
    {
      "name": "caffeinate.list",
      "owner": "app:cmux/caffeinate",
      "class": "read",
      "risk": "read",
      "docs": "What keeps the Mac awake through cmux: title, kinds and flags, time left, binding, owner.",
      "cli": { "path": "power list", "visible": true },
      "code_mode": { "path": "mux.caffeinate.list" },
      "mcp": { "expose": "default", "group": "power" },
      "palette": null,
      "focuses": false,
      "idempotency": "forbidden",
      "queue_offline": false,
      "remote_relay": "deny",
      "since": "caffeinate/1",
      "input": { "type": "object", "additionalProperties": false, "properties": {}, "required": [] },
      "x-implementation": "js:list"
    },
    {
      "name": "caffeinate.show",
      "owner": "app:cmux/caffeinate",
      "class": "mutation",
      "risk": "mutate-own",
      "docs": "Open the Caffeinate pane.",
      "cli": null,
      "code_mode": { "path": "mux.caffeinate.show" },
      "mcp": { "expose": "never", "group": "power" },
      "palette": [{ "title": "Show Caffeinate", "args": {} }],
      "focuses": true,
      "idempotency": "forbidden",
      "queue_offline": false,
      "remote_relay": "deny",
      "since": "caffeinate/1",
      "input": { "type": "object", "additionalProperties": false, "properties": { "gesture": { "type": "string", "description": "Gesture token of the user action (ctx.gesture)" } }, "required": ["gesture"] },
      "x-implementation": "js:show"
    }
  ],
  "trigger_events": []
}
