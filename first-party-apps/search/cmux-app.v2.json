{
  "$schema": "https://cmux.dev/schemas/cmux-app/2.json",
  "manifestVersion": 2,
  "id": "cmux/search",
  "name": {
    "en": "Search",
    "ja": "検索"
  },
  "version": "0.1.0",
  "description": "Find anything in cmux and open it: workspaces, terminals and their text, browser tabs and history, items from other apps, and files.",
  "publisher": {
    "name": "cmux",
    "url": "https://cmux.dev"
  },
  "repository": "https://github.com/manaflow-ai/cmux",
  "license": "MIT",
  "icon": "assets/icon.svg",
  "categories": [
    "sidebar",
    "productivity"
  ],
  "keywords": [
    "search",
    "find",
    "grep",
    "scrollback",
    "history"
  ],
  "engines": {
    "cmux": "^2.0"
  },
  "runtime": {
    "main": "dist/main.js"
  },
  "catalog": "catalog/search-catalog.json",
  "implements": {
    "cmux.section/1": {
      "export": "renderSection",
      "title": {
        "en": "Search",
        "ja": "検索"
      },
      "symbol": "magnifyingglass",
      "options": {
        "defaultRegion": "top",
        "maxRows": 24
      }
    },
    "cmux.pane/1": {
      "export": "renderPane",
      "title": {
        "en": "Search",
        "ja": "検索"
      },
      "symbol": "magnifyingglass"
    }
  },
  "scopes": {
    "session:read": "Find workspaces, tabs, terminals and browser tabs by name.",
    "terminal:read": "Search the text of your terminals.",
    "workspace:write": "Show the workspace or tab of a result when you open it.",
    "actions:run": "Open pages, files and app items when you pick them.",
    "mcp:expose": "Offer the search command to your agents as a tool."
  },
  "optionalScopes": {
    "browser_history:read": "Search your browsing history.",
    "fs:read": "Search file names and contents in the folders you allow.",
    "search:read": "Include results that your other apps offer."
  },
  "variants": [
    {
      "id": "variant",
      "title": "Design variant",
      "values": [
        "grouped",
        "preview",
        "palette"
      ],
      "default": "grouped"
    }
  ],
  "settings": {
    "type": "object",
    "properties": {
      "defaultScope": {
        "type": "string",
        "title": "Search in",
        "enum": [
          "all",
          "workspace"
        ],
        "default": "all",
        "description": "all: everything. workspace: only the current workspace (type in:all to widen one search)."
      },
      "rememberRecent": {
        "type": "boolean",
        "title": "Remember recent searches",
        "default": true
      },
      "sources": {
        "type": "array",
        "title": "Sources",
        "items": {
          "enum": [
            "workspaces",
            "terminals",
            "browser",
            "apps",
            "files"
          ]
        },
        "default": [
          "workspaces",
          "terminals",
          "browser",
          "apps",
          "files"
        ],
        "description": "What Search looks through."
      }
    }
  },
  "activation": [
    "onInterface:cmux.section/1",
    "onInterface:cmux.pane/1",
    "onOp:search_app.search",
    "onOp:search_app.clear_recent"
  ],
  "files": [
    "dist/",
    "assets/",
    "catalog/"
  ]
}
