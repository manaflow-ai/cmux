{
  "$schema": "https://cmux.dev/schemas/cmux-app/2.json",
  "manifestVersion": 2,
  "id": "cmux/usage",
  "name": {
    "en": "Usage",
    "ja": "使用量"
  },
  "version": "0.1.0",
  "description": {
    "en": "Usage of every AI plan account your routers know: session and weekly headroom, resets, and a pace verdict per provider, in the menu bar, a pane and the sidebar.",
    "ja": "ルーターが管理するすべての AI プランアカウントの使用量: セッションと週間の残り、リセット時刻、プロバイダーごとのペース判定を、メニューバー、ペイン、サイドバーに表示します。"
  },
  "publisher": {
    "name": "cmux",
    "url": "https://cmux.dev"
  },
  "repository": "https://github.com/manaflow-ai/cmux",
  "license": "MIT",
  "icon": "assets/icon.svg",
  "categories": [
    "agents",
    "monitoring"
  ],
  "keywords": [
    "usage",
    "limits",
    "quota",
    "pace",
    "accounts",
    "router"
  ],
  "engines": {
    "cmux": "^2.0"
  },
  "runtime": {
    "main": "dist/main.js"
  },
  "catalog": "catalog/usage-catalog.json",
  "implements": {
    "cmux.section/1": {
      "export": "renderSection",
      "title": {
        "en": "Usage",
        "ja": "使用量"
      },
      "symbol": "gauge.with.needle",
      "options": {
        "defaultRegion": "bottom",
        "maxRows": 12
      }
    },
    "cmux.status/1": {
      "export": "renderStatus",
      "title": {
        "en": "Usage",
        "ja": "使用量"
      },
      "symbol": "gauge.with.needle",
      "options": {
        "placement": "statusStrip"
      }
    },
    "cmux.pane/1": {
      "export": "renderPane",
      "title": {
        "en": "Usage",
        "ja": "使用量"
      },
      "symbol": "gauge.with.needle"
    }
  },
  "scopes": {
    "account:read": "Read account usage from the cmux usage server, which runs your router's status command. The app never sees a credential.",
    "account:write": "Ask the usage server to read the router now when you choose Refresh.",
    "notification:write": "Tell you once when a provider has no usable account left."
  },
  "optionalScopes": {
    "mcp:expose": "Let agents read usage and pace through the status tool.",
    "actions:run": "Open the usage pane when you choose Show Usage."
  },
  "variants": [
    {
      "id": "variant",
      "title": "Design variant",
      "values": [
        "rows",
        "meters",
        "quiet"
      ],
      "default": "rows"
    }
  ],
  "settings": {
    "type": "object",
    "properties": {
      "notifications": {
        "type": "boolean",
        "title": "Tell me when a provider has no usable account",
        "default": true
      },
      "staleMinutes": {
        "type": "integer",
        "title": "Mark data stale after minutes",
        "minimum": 1,
        "default": 30
      }
    }
  },
  "activation": [
    "onInterface:cmux.section/1",
    "onInterface:cmux.status/1",
    "onInterface:cmux.pane/1",
    "onOp:usage_app.show",
    "onOp:usage_app.refresh",
    "onOp:usage_app.status"
  ],
  "files": [
    "dist/",
    "assets/",
    "catalog/"
  ]
}
