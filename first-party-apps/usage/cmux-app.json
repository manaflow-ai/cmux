{
  "$schema": "https://cmux.dev/schemas/cmux-app/1.json",
  "manifestVersion": 1,
  "id": "cmux/usage",
  "name": { "en": "Usage", "ja": "使用量" },
  "version": "0.1.0",
  "description": {
    "en": "Usage of every AI plan account your routers know: session and weekly headroom, resets, and a pace verdict per provider, in the menu bar, a pane and the sidebar.",
    "ja": "ルーターが管理するすべての AI プランアカウントの使用量: セッションと週間の残り、リセット時刻、プロバイダーごとのペース判定を、メニューバー、ペイン、サイドバーに表示します。"
  },
  "publisher": { "name": "cmux", "url": "https://cmux.dev" },
  "repository": "https://github.com/manaflow-ai/cmux",
  "license": "MIT",
  "icon": "assets/icon.svg",
  "categories": ["agents", "monitoring"],
  "keywords": ["usage", "limits", "quota", "pace", "accounts", "router"],
  "engines": { "cmux": "^1.0" },
  "main": "dist/main.js",
  "scopes": {
    "account:read": "Read account usage from the cmux usage server, which runs your router's status command. The app never sees a credential.",
    "account:write": "Ask the usage server to read the router now when you choose Refresh.",
    "notification:write": "Tell you once when a provider has no usable account left."
  },
  "optionalScopes": { "mcp:expose": "Let agents read usage and pace through the status tool.", "actions:run": "Open the usage pane when you choose Show Usage." },
  "contributes": {
    "statusItems": [{ "id": "menu", "title": { "en": "Usage", "ja": "使用量" }, "symbol": "gauge.with.needle", "placement": "statusStrip", "render": "renderStatus" }],
    "sidebarSections": [{ "id": "usage", "title": { "en": "Usage", "ja": "使用量" }, "symbol": "gauge.with.needle", "defaultRegion": "bottom", "render": "renderSection", "maxRows": 12 }],
    "commands": [
      {
        "id": "show",
        "title": { "en": "Show Usage", "ja": "使用量を表示" },
        "run": "show",
        "keywords": ["usage", "limits", "quota"],
        "contexts": ["palette", "statusItem:menu", "sidebarSection:usage"]
      },
      {
        "id": "refresh",
        "title": { "en": "Refresh Usage Now", "ja": "使用量を今すぐ更新" },
        "run": "refresh",
        "keywords": ["usage", "limits"],
        "contexts": ["palette", "statusItem:menu", "sidebarSection:usage"]
      },
      {
        "id": "status",
        "title": { "en": "Usage Status", "ja": "使用量の状態" },
        "run": "status",
        "keywords": ["usage", "limits", "json"],
        "arguments": {
          "type": "object",
          "properties": {
            "provider": { "type": "string", "description": "Only this provider id as the router names it (claude, codex, ...)." },
            "accounts": { "type": "boolean", "description": "Include one row per account with the router's labels (default false: provider summaries and pace only)." },
            "refresh": { "type": "boolean", "description": "Ask the usage server to read the router first (rate-limited by the server)." }
          }
        }
      },
      { "id": "cycleVariant", "title": { "en": "Next Usage Variant", "ja": "次の使用量バリアント" }, "run": "cycleVariant", "contexts": ["palette"], "mcp": false }
    ],
    "mcpServers": [{ "id": "tools", "title": { "en": "Usage", "ja": "使用量" }, "tools": "commands" }],
    "settings": {
      "type": "object",
      "properties": {
        "variant": { "type": "string", "title": "Design variant", "enum": ["rows", "meters", "quiet"], "default": "rows", "x-cmux-devOnly": true },
        "notifications": { "type": "boolean", "title": "Tell me when a provider has no usable account", "default": true },
        "staleMinutes": { "type": "integer", "title": "Mark data stale after minutes", "minimum": 1, "default": 30 }
      }
    },
    "paneKinds": [{ "id": "usagePane", "title": { "en": "Usage", "ja": "使用量" }, "symbol": "gauge.with.needle", "render": "renderPane" }]
  },
  "activation": ["onStatusItem:menu", "onSidebarSection:usage", "onPane:usagePane", "onCommand:show", "onCommand:refresh", "onCommand:status", "onCommand:cycleVariant"],
  "files": ["dist/", "assets/"]
}
