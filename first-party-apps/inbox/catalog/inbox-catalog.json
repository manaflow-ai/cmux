        "path": "apps run cmux/inbox mark-done",
        "visible": true
      },
      "mcp": {
        "expose": "never"
      },
      "palette": {
        "title": "Mark Inbox Item as Done"
      },
      "docs": "Mark an inbox item as done. Open requests cannot be marked done.",
      "since": "inbox_app/1",
      "export": "markDone"
    },
    {
      "name": "inbox_app.snooze",
      "owner": "app:cmux/inbox",
      "class": "mutation",
      "risk": "mutate-own",
      "idempotency": "required",
      "focuses": false,
      "queue_offline": false,
      "remote_relay": "deny",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Item id (fi_…); the selected item when omitted. Open requests cannot be snoozed."
          },
          "minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 43200,
            "default": 60,
            "description": "How long to snooze."
          }
        },
        "required": []
      },
      "cli": {
        "path": "apps run cmux/inbox snooze",
        "visible": true
      },
      "mcp": {
        "expose": "never"
      },
      "palette": {
        "title": "Snooze Inbox Item"
      },
      "docs": "Snooze an inbox item. Open requests cannot be snoozed.",
      "since": "inbox_app/1",
      "export": "snooze"
    },
