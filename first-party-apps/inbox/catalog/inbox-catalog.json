      "owner": "app:cmux/inbox",
      "class": "mutation",
      "risk": "mutate-own",
      "idempotency": "required",
      "focuses": false,
      "queue_offline": false,
      "remote_relay": "deny",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
