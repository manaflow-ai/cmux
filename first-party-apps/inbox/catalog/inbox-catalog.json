{
  "family": "inbox_app",
  "operations": [
    {
      "name": "inbox_app.open",
      "owner": "app:cmux/inbox",
      "class": "mutation",
      "risk": "mutate-own",
      "idempotency": "required",
      "focuses": true,
      "queue_offline": false,
      "remote_relay": "deny",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "cli": {
        "path": "apps run cmux/inbox open",
        "visible": true
      },
      "mcp": {
        "expose": "never"
      },
      "palette": {
        "title": "Open Inbox"
