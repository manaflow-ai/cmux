{
  "$schema": "../../cmux-tui/crates/cmux-app-host/schema/v2/cmux-app.schema.json",
  "manifestVersion": 2,
  "id": "cmux/calendar",
  "name": {
    "en": "Calendar"
  },
  "version": "1.0.0",
  "description": "Your next events from the calendars on your Mac, like the Calendar widget on an iPhone: today's date in red, then what is coming up in each calendar's color. Larger sizes add the rest of today and tomorrow. The first time, one click lets it see your calendars.",
  "publisher": {
    "name": "cmux",
    "url": "https://cmux.com"
  },
  "repository": "https://github.com/manaflow-ai/cmux",
  "license": "GPL-3.0-or-later",
  "icon": "assets/icon.svg",
  "screenshots": [
    "screenshots/small-medium-large.png",
    "screenshots/clear-day.png"
  ],
  "categories": [
    "productivity"
  ],
  "keywords": [
    "calendar",
    "events",
    "up next",
    "schedule",
    "widget"
  ],
  "engines": {
    "cmux": "^2.0"
  },
  "runtime": {
    "main": "dist/main.js"
  },
  "implements": {
    "cmux.widget/1": {
      "export": "renderCalendar",
      "title": {
        "en": "Up Next"
      },
      "symbol": "calendar",
      "options": {
        "sizes": [
          "small",
          "medium",
          "large"
        ],
        "defaultSize": "small",
        "refresh": {
          "everySeconds": 60
        },
        "places": [
          "newtab",
          "sidebar"
        ]
      }
    }
  },
  "scopes": {
    "system_calendar:read": "See the events in the calendars on your Mac, to show what is next. Nothing leaves your Mac."
  },
  "settings": {
    "type": "object",
    "properties": {
      "hourCycle": {
        "type": "string",
        "title": "Clock",
        "description": "12 or 24 hours. Automatic follows your language and region.",
        "enum": [
          "system",
          "12h",
          "24h"
        ],
        "default": "system"
      },
      "largeLayout": {
        "type": "string",
        "title": "Large size",
        "description": "The hour grid of today and tomorrow, as Calendar draws it, or a list of the next events.",
        "enum": [
          "grid",
          "list"
        ],
        "default": "grid"
      }
    }
  },
  "activation": [
    "onInterface:cmux.widget/1"
  ],
  "files": [
    "dist/",
    "assets/",
    "screenshots/"
  ]
}
