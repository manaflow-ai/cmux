{
  "//": "In this repository the SDK resolves from source, so the app builds with no install of it.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": { "cmux-extension-sdk/web": ["../../cmux-tui/crates/cmux-extension-sdk/typescript/src/web.ts"] }
  },
  "include": ["web-src", "preview/host.ts", "preview/fixtures.ts"]
}
