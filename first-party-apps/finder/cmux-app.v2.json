{
  "$schema": "https://cmux.dev/schemas/cmux-app/2.json",
  "manifestVersion": 2,
  "id": "cmux/finder",
  "name": {
    "en": "Finder",
    "ja": "ファインダー"
  },
  "version": "0.1.0",
  "description": {
    "en": "Browse folders on this Mac, cmux servers, the team VM and SSH hosts. Copy, move, rename and trash files with progress, preview them, and send them to terminals and agents.",
    "ja": "このMac、cmuxサーバー、チームVM、SSHホストのフォルダをブラウズします。進捗を見ながらファイルをコピー、移動、名前変更、ゴミ箱に入れ、プレビューし、ターミナルやエージェントに渡せます。"
  },
  "publisher": {
    "name": "cmux",
    "url": "https://cmux.dev"
  },
  "repository": "https://github.com/manaflow-ai/cmux",
  "license": "MIT",
  "icon": "assets/icon.svg",
  "categories": [
    "productivity",
    "cloud",
    "developer-tools"
  ],
  "keywords": [
    "files",
    "finder",
    "ssh",
    "sftp",
    "copy",
    "browse"
  ],
  "engines": {
    "cmux": "^2.0"
  },
  "runtime": {
    "main": "dist/main.js"
  },
  "catalog": "catalog/finder-catalog.json",
  "implements": {
    "cmux.section/1": {
      "export": "renderFiles",
      "title": {
        "en": "Files",
        "ja": "ファイル"
      },
      "symbol": "folder",
      "options": {
        "defaultRegion": "middle"
      }
    },
    "cmux.pane/1": {
      "export": "renderFinder",
      "title": {
        "en": "Finder",
        "ja": "ファインダー"
      },
      "symbol": "folder"
    }
  },
  "scopes": {
    "fs:read": "List and preview files in the folders and hosts you give this app.",
    "host:read": "Show the hosts you connected this app to and whether they are online."
  },
  "optionalScopes": {
    "fs:write": "Create, rename, copy, move and trash files when you ask, only in folders you gave it write access to.",
    "agent:write": "Attach files to an agent when you choose Attach to Agent."
  },
  "handles": {
    "root": "Folders you add to Finder.",
    "connection": "Hosts you connect to Finder."
  },
  "strings": "strings/",
  "variants": [
    {
      "id": "variant",
      "title": "Design variant",
      "values": [
        "listPreview",
        "columns",
        "dualPane"
      ],
      "default": "listPreview"
    }
  ],
  "settings": {
    "type": "object",
    "properties": {
      "showPreview": {
        "type": "boolean",
        "default": true,
        "title": "Show the preview pane"
      }
    }
  },
  "activation": [
    "onInterface:cmux.section/1",
    "onInterface:cmux.pane/1",
    "onOp:finder.open",
    "onOp:finder.add_folder",
    "onOp:finder.connect_host"
  ],
  "files": [
    "dist/",
    "assets/",
    "catalog/",
    "strings/"
  ]
}
