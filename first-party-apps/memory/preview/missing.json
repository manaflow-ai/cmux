      "scope": "memory:read",
      "class": "read"
    },
    "memory.list": {
      "scope": "memory:read",
      "class": "read"
    },
    "memory.search": {
      "scope": "memory:read",
      "class": "read"
    },
    "document.open": {
      "scope": "document:read",
      "class": "read"
    },
    "document.read": {
      "scope": "document:read",
      "class": "read"
    },
    "document.edit": {
      "scope": "document:write",
      "class": "mutation"
    },
    "document.propose": {
      "scope": "document:read",
      "class": "mutation"
    },
    "fs.trash": {
      "scope": "fs:write",
      "class": "mutation"
    },
    "ui.open": {
      "scope": "memory:read",
      "class": "mutation"
    },
    "app.pane.open": {
      "scope": "memory:read",
