{
  "$schema": "https://cmux.dev/schemas/cmux-app/1.json",
  "manifestVersion": 1,
  "id": "cmux/coderouter",
  "name": { "en": "CodeRouter", "ja": "CodeRouter" },
  "version": "0.1.0",
  "description": {
    "en": "Set up and watch CodeRouter, the cmux model router: provider accounts, sharing, API keys, usage, failover order and a test request.",
    "ja": "cmux のモデルルーター CodeRouter の設定と状況確認: プロバイダーアカウント、共有、API キー、使用量、フェイルオーバー順、テストリクエスト。"
  },
  "publisher": { "name": "cmux", "url": "https://cmux.dev" },
  "repository": "https://github.com/manaflow-ai/cmux",
  "license": "GPL-3.0-or-later",
  "icon": "assets/icon.svg",
  "categories": ["agents", "cloud", "monitoring"],
  "keywords": ["coderouter", "router", "models", "api key", "usage", "accounts"],
  "engines": { "cmux": "^1.0" },
  "main": "dist/main.js",
  "scopes": {
    "coderouter:read": "See CodeRouter status, your connected accounts, API key names, usage and failover order. Never a key or token.",
    "coderouter:write": "Ask cmux to connect, share or remove an account and to route your agents through CodeRouter. cmux asks you and handles the secret.",
    "actions:run": "Open the Accounts screen, sign in, and start a provider's own login when you click."
  },
  "optionalScopes": {
    "coderouter:execute": "Send one tiny test prompt through CodeRouter when you click Test. It uses a few tokens.",
    "coderouter:control": "Create and revoke CodeRouter API keys. cmux shows the new key once in its own window; this app never sees it."
  },
  "contributes": {
    "sidebarSections": [
      { "id": "coderouter", "title": { "en": "CodeRouter", "ja": "CodeRouter" }, "symbol": "arrow.triangle.branch", "defaultRegion": "bottom", "render": "renderSection", "maxRows": 12 }
    ],
    "statusItems": [
      { "id": "health", "title": { "en": "CodeRouter Health", "ja": "CodeRouter の状態" }, "symbol": "arrow.triangle.branch", "placement": "titlebar", "render": "renderStatus" }
    ],
    "paneKinds": [
      { "id": "dashboard", "title": { "en": "CodeRouter", "ja": "CodeRouter" }, "symbol": "arrow.triangle.branch", "render": "renderDashboard" },
      { "id": "onboarding", "title": { "en": "Set Up CodeRouter", "ja": "CodeRouter を設定" }, "symbol": "sparkles", "render": "renderOnboarding" }
    ],
    "commands": [
      { "id": "open", "title": { "en": "Open CodeRouter", "ja": "CodeRouter を開く" }, "run": "open", "keywords": ["coderouter", "router", "usage"], "contexts": ["palette", "sidebarSection:coderouter", "statusItem:health"] },
      {
        "id": "connectAccount",
        "title": { "en": "Connect Account to CodeRouter", "ja": "CodeRouter にアカウントを接続" },
        "run": "connectAccount",
        "keywords": ["coderouter", "connect", "account", "codex", "claude"],
        "contexts": ["palette", "sidebarSection:coderouter"],
        "arguments": { "type": "object", "properties": { "provider": { "type": "string", "enum": ["codex", "claude", "openai", "anthropic", "openrouter", "bedrock"], "description": "Provider to connect. Omit to connect the best account found on this Mac." } } }
      },
      {
        "id": "createKey",
        "title": { "en": "Create CodeRouter API Key", "ja": "CodeRouter API キーを作成" },
        "run": "createKey",
        "keywords": ["coderouter", "api key", "crk", "token"],
        "contexts": ["palette", "sidebarSection:coderouter"],
        "arguments": { "type": "object", "properties": { "label": { "type": "string", "maxLength": 80, "description": "Name of the key, for example the tool that uses it." } } }
      },
      { "id": "runTest", "title": { "en": "Test CodeRouter", "ja": "CodeRouter をテスト" }, "run": "runTest", "keywords": ["coderouter", "test", "latency", "ping"], "contexts": ["palette", "sidebarSection:coderouter", "statusItem:health"] },
      { "id": "startOnboarding", "title": { "en": "Set Up CodeRouter", "ja": "CodeRouter を設定" }, "run": "startOnboarding", "keywords": ["coderouter", "setup", "onboarding", "welcome"], "contexts": ["palette", "sidebarSection:coderouter"] },
      { "id": "cycleVariant", "title": { "en": "Next CodeRouter Variant", "ja": "次の CodeRouter バリアント" }, "run": "cycleVariant", "keywords": ["coderouter", "variant", "design"], "contexts": ["palette"] }
    ],
    "settings": {
      "type": "object",
      "properties": {
        "variant": { "type": "string", "title": "Design variant", "enum": ["checklist", "wizard", "tabs"], "default": "checklist", "x-cmux-devOnly": true },
        "usageWindow": { "type": "string", "title": "Usage window", "enum": ["24h", "7d", "30d"], "default": "7d" },
        "statusShowsUsage": { "type": "boolean", "title": "Show today's spend in the status item", "default": true },
        "language": { "type": "string", "title": "Language override", "enum": ["auto", "en", "ja"], "default": "auto", "x-cmux-devOnly": true }
      }
    }
  },
  "activation": ["onSidebarSection:coderouter", "onStatusItem:health", "onPane:dashboard", "onPane:onboarding", "onCommand:open", "onCommand:connectAccount", "onCommand:createKey", "onCommand:runTest", "onCommand:startOnboarding", "onCommand:cycleVariant"],
  "files": ["dist/", "assets/"]
}
