{
  "$comment": "SKETCH of this app on platform v2 (plan app-platform section 12). Not loaded by today's runtime; cmux-app.json is the live manifest.",
  "manifestVersion": 2,
  "id": "cmux/codemirror",
  "version": "0.1.0",
  "publisher": {
    "name": "cmux",
    "url": "https://cmux.dev"
  },
  "repository": "https://github.com/manaflow-ai/cmux",
  "license": "MIT",
  "engines": {
    "cmux": "^2.0"
  },
  "name": {
    "en": "CodeMirror",
    "ja": "CodeMirror"
  },
  "strings": "strings/",
  "main": "dist/main.js",
  "scopes": {
    "document:write": "Edit and save the documents you open with this editor."
  },
  "implements": {
    "cmux.editor/1": {
      "renderer": "web",
      "web": "web/index.html",
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'",
      "types": [
        "public.source-code",
        "public.plain-text",
        "public.json",
        "net.daringfireball.markdown"
      ],
      "capabilities": [
        "diff",
        "readOnly",
        "multiCursor"
      ],
      "paneCommands": [
        "save",
        "revert",
        "toggleReadOnly",
        "focus"
      ]
    }
  },
  "consumes": [
    "cmux.diff.renderer/1"
  ],
  "handles": [
    "doc",
    "diff"
  ],
  "catalog": {
    "owner": "app:cmux/codemirror",
    "ops": [
      {
        "name": "codemirror.open",
        "export": "open",
        "risk": "read",
        "params": {
          "uri": "string?",
          "doc": "doc_…?"
        },
        "surfaces": {
          "cli": "cmux open --with cmux/codemirror <uri>",
          "mcp": true
        },
        "gesture": "required"
      },
      {
        "name": "codemirror.save",
        "export": "save",
        "risk": "mutate-shared",
        "params": {
          "doc": "doc_…?"
        },
        "surfaces": {
          "palette": {
            "title": "Save"
          },
          "keyboard": {
            "key": "cmd+s",
            "when": "pane:editor"
          },
          "mcp": true
        }
      },
      {
        "name": "codemirror.revert",
        "export": "revert",
        "risk": "mutate-shared",
        "surfaces": {
          "palette": {
            "title": "Revert to Saved"
          }
        }
      },
      {
        "name": "codemirror.toggle_read_only",
        "export": "toggleReadOnly",
        "risk": "mutate-own",
        "surfaces": {
          "palette": {
            "title": "Toggle Read-Only"
          }
        }
      }
    ]
  },
  "openWith": {
    "types": [
      "public.source-code",
      "public.plain-text"
    ],
    "askToBecomeDefault": true
  },
  "variants": {
    "setting": "variant",
    "values": [
      "statusLine",
      "header",
      "bare"
    ],
    "default": "statusLine",
    "channels": [
      "dev",
      "nightly"
    ]
  },
  "settings": {
    "fontFamily": {
      "default": "",
      "description": "Empty: the terminal font."
    },
    "fontSize": {
      "default": 0
    },
    "wordWrap": {
      "default": false
    },
    "lineNumbers": {
      "default": true
    },
    "tabSize": {
      "default": 2
    }
  },
  "v2Gaps": [
    "The web pane bridge message shape is not specified in V7 (interfaces/web-bridge.ts proposes one).",
    "No pane-routed commands: Save from the palette or Cmd-S must reach the focused web pane (paneCommands here).",
    "V7 CSP: both editor libraries inject styles at runtime and need style-src 'unsafe-inline'; scripts stay 'self'.",
    "No terminal theme in the pane init (background, foreground, cursor, selection, 16-color palette, font): the editors must not fall back to library colors.",
    "document.read {doc, revision} for an older revision (conflict compare) is not in V3's op list.",
    "No locale in the web pane init; cmux.t(key) is defined for the script VM only.",
    "No pane visibility event to pause work in hidden panes."
  ]
}
