{
  "family": "codemirror",
  "operations": [
    {
      "name": "codemirror.open",
      "owner": "app:cmux/codemirror",
      "class": "mutation",
      "risk": "mutate-own",
      "idempotency": "required",
      "focuses": true,
      "queue_offline": false,
      "remote_relay": "deny",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "uri": {
            "type": "string",
            "description": "file:// or cmux-fs:// URI."
          },
          "doc": {
            "type": "string",
            "description": "A document handle (doc_…)."
          }
        },
        "required": []
      },
      "cli": {
        "path": "apps run cmux/codemirror open",
        "visible": true
      },
      "mcp": {
        "expose": "default"
      },
      "docs": "Open a file or a document handle in a CodeMirror editor pane.",
      "since": "codemirror/1",
      "export": "open"
    },
    {
      "name": "codemirror.save",
      "owner": "app:cmux/codemirror",
      "class": "mutation",
      "risk": "mutate-shared",
      "idempotency": "required",
      "focuses": false,
      "queue_offline": false,
      "remote_relay": "deny",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "doc": {
            "type": "string",
            "description": "A document handle; the focused editor when absent."
          }
        },
        "required": []
      },
      "cli": {
        "path": "apps run cmux/codemirror save",
        "visible": true
      },
      "mcp": {
        "expose": "default"
      },
      "palette": {
        "title": "Save"
      },
      "docs": "Save the focused editor's document, or the document handle given.",
      "since": "codemirror/1",
      "export": "save"
    },
    {
      "name": "codemirror.revert",
      "owner": "app:cmux/codemirror",
      "class": "mutation",
      "risk": "mutate-shared",
      "idempotency": "required",
      "focuses": false,
      "queue_offline": false,
      "remote_relay": "deny",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "doc": {
            "type": "string"
          }
        },
        "required": []
      },
      "cli": {
        "path": "apps run cmux/codemirror revert",
        "visible": true
      },
      "mcp": {
        "expose": "default"
      },
      "palette": {
        "title": "Revert to Saved"
      },
      "docs": "Drop unsaved edits and show the saved revision of the document.",
      "since": "codemirror/1",
      "export": "revert"
    },
    {
      "name": "codemirror.toggle_read_only",
      "owner": "app:cmux/codemirror",
      "class": "mutation",
      "risk": "mutate-own",
      "idempotency": "required",
      "focuses": false,
      "queue_offline": false,
      "remote_relay": "deny",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "cli": {
        "path": "apps run cmux/codemirror toggle-read-only",
        "visible": true
      },
      "mcp": {
        "expose": "never"
      },
      "palette": {
        "title": "Toggle Read-Only"
      },
      "docs": "Turn read-only mode on or off in the focused editor.",
      "since": "codemirror/1",
      "export": "toggleReadOnly"
    },
    {
      "name": "codemirror.cycle_variant",
      "owner": "app:cmux/codemirror",
      "class": "mutation",
      "risk": "mutate-own",
      "idempotency": "required",
      "focuses": false,
      "queue_offline": false,
      "remote_relay": "deny",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "cli": {
        "path": "apps run cmux/codemirror cycle-variant",
        "visible": false
      },
      "mcp": {
        "expose": "never"
      },
      "palette": {
        "title": "Next CodeMirror Variant"
      },
      "docs": "Switch to the next CodeMirror design variant (DEV and NIGHTLY).",
      "since": "codemirror/1",
      "export": "cycleVariant"
    }
  ]
}
