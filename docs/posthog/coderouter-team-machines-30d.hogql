-- Publish this as the SQL endpoint `coderouter-team-machines-30d` in the
-- dedicated CodeRouter PostHog project. Define `team_scope` as a required
-- string variable. One row per Cloud VM (`coderouter_vm_id`, the cmux
-- `cloud_vms.id` UUID) that spent tokens through a VM-bound route token in
-- the last 30 UTC days. Unbound (CLI) traffic has no `coderouter_vm_id` and
-- is excluded. The server joins rows to the team's own `cloud_vms` rows and
-- drops any id the team does not own.
SELECT
  toString(properties.coderouter_vm_id) AS vm_id,
  sum(toInt(coalesce(properties.$ai_input_tokens, 0))) AS input_tokens,
  sum(toInt(coalesce(properties.$ai_cache_read_input_tokens, 0))) AS cached_input_tokens,
  sum(toInt(coalesce(properties.$ai_output_tokens, 0))) AS output_tokens,
  sum(toInt(coalesce(properties.coderouter_total_tokens, 0))) AS total_tokens,
  sum(toFloat(coalesce(properties.$ai_total_cost_usd, 0))) AS api_equivalent_usd,
  sum(toInt(coalesce(properties.coderouter_priced_tokens, 0))) AS priced_tokens,
  sum(toInt(coalesce(properties.coderouter_unpriced_tokens, 0))) AS unpriced_tokens
FROM events
WHERE event = '$ai_generation'
  AND toDate(timestamp) >= toDate(now()) - INTERVAL 29 DAY
  AND toDate(timestamp) <= toDate(now())
  AND properties.coderouter_team_scope = {variables.team_scope}
  AND properties.coderouter_vm_id IS NOT NULL
  AND properties.coderouter_vm_id != ''
GROUP BY vm_id
ORDER BY total_tokens DESC
-- The app accepts at most 200 machines per team; lower-usage machines past
-- that are omitted rather than surfaced as a truncated response.
LIMIT 200
