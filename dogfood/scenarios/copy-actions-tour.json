{
  "paths": [
    "Sources/CmuxSurfaceTabBarBuiltInAction.swift",
    "Sources/ContentView*",
    "Sources/TerminalCopyAction.swift",
    "Sources/Workspace.swift",
    "Packages/macOS/CmuxTerminal/*"
  ],
  "steps": [
    {
      "socket": "workspace.create",
      "params": {
        "title": "Copy Actions",
        "initial_input": "printf 'copy actions ready\\n'",
        "focus": true
      },
      "save": "workspace"
    },
    {
      "wait": 1.5
    },
    {
      "key": "p",
      "modifiers": [
        "command",
        "shift"
      ]
    },
    {
      "wait": 0.8
    },
    {
      "type": "copy"
    },
    {
      "wait": 0.8
    },
    {
      "shot": "copy-actions-palette"
    },
    {
      "tree": "copy-actions-palette-tree"
    },
    {
      "click": {
        "id": "CommandPaletteResultRow.8.palette.copyWorkingDirectory",
        "type": "button"
      }
    },
    {
      "wait": 0.8
    },
    {
      "key": "v",
      "modifiers": [
        "command"
      ]
    },
    {
      "wait": 0.8
    },
    {
      "shot": "copy-actions-pasted-path"
    },
    {
      "tree": "copy-actions-pasted-path-tree"
    }
  ]
}
