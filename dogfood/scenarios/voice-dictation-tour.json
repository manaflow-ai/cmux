{
  "launch": {"env": {"CMUX_UI_TEST_VOICE_FIXTURE_SCRIPT": "Fix the failing build. Then run the tests again."}, "args": ["-voice.dictationEnabled", "YES", "-voice.hotkeyMode", "toggle"]},
  "steps": [
    {"socket": "workspace.create", "params": {"title": "Dictation", "initial_input": "clear\n", "focus": true}, "save": "ws"},
    {"wait": 1.5},
    {"shot": "tab-bar-with-mic"},
    {"tree": "tab-bar-with-mic"},
    {"key": "v", "modifiers": ["control", "command"]},
    {"wait": 1.2},
    {"shot": "hud-listening-partial", "screen": true},
    {"expect": "VoiceDictationHUD"},
    {"wait": 2.5},
    {"shot": "hud-first-sentence", "screen": true},
    {"wait": 3},
    {"shot": "hud-second-sentence", "screen": true},
    {"key": "v", "modifiers": ["control", "command"]},
    {"wait": 1.5},
    {"expect": "VoiceDictationHUD", "exists": false},
    {"socket": "debug.terminal.read_text", "save": "text"},
    {"shot": "text-pasted-in-terminal"},
    {"key": "p", "modifiers": ["command", "shift"]},
    {"wait": 0.5},
    {"type": "voice dictation"},
    {"wait": 0.5},
    {"shot": "palette-dictation-command"},
    {"key": "return"},
    {"wait": 1.5},
    {"shot": "hud-from-palette", "screen": true},
    {"expect": "VoiceDictationHUD"},
    {"key": "v", "modifiers": ["control", "command"]},
    {"wait": 1.5},
    {"socket": "debug.terminal.read_text", "save": "text-after-palette"},
    {"shot": "text-after-palette"},
    {"key": ",", "modifiers": ["command"]},
    {"wait": 1.5},
    {"click": {"label": "Voice", "type": "staticText"}},
    {"wait": 1},
    {"shot": "settings-voice"},
    {"tree": "settings-voice"},
    {"key": "w", "modifiers": ["command"]}
  ]
}
