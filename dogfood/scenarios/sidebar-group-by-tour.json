{
  "steps": [
    {"socket": "workspace.create", "params": {"title": "api server", "initial_input": "echo '{\"session_id\":\"a1\",\"source\":\"startup\",\"cwd\":\"/tmp\"}' | cmux claude-hook session-start; echo '{\"session_id\":\"a1\",\"turn_id\":\"t1\",\"cwd\":\"/tmp\"}' | cmux claude-hook prompt-submit; clear\n", "focus": false}, "save": "api"},
    {"socket": "workspace.create", "params": {"title": "release notes", "initial_input": "echo '{\"session_id\":\"b1\",\"source\":\"startup\",\"cwd\":\"/tmp\"}' | cmux claude-hook session-start; echo '{\"session_id\":\"b1\",\"turn_id\":\"t1\",\"cwd\":\"/tmp\"}' | cmux claude-hook prompt-submit; echo '{\"session_id\":\"b1\",\"message\":\"Claude needs your permission to use Bash\",\"notification_type\":\"permission_prompt\"}' | cmux claude-hook notification; clear\n", "focus": false}, "save": "notes"},
    {"socket": "workspace.create", "params": {"title": "docs site", "initial_input": "echo docs\n", "focus": false}, "save": "docs"},
    {"socket": "workspace.create", "params": {"title": "train eval", "initial_input": "echo '{\"session_id\":\"c1\",\"source\":\"startup\",\"cwd\":\"/tmp\"}' | cmux claude-hook session-start; echo '{\"session_id\":\"c1\",\"turn_id\":\"t1\",\"cwd\":\"/tmp\"}' | cmux claude-hook prompt-submit; clear\n", "focus": false}, "save": "train"},
    {"socket": "workspace.create", "params": {"title": "tail logs", "focus": false}, "save": "logs"},
    {"socket": "workspace.create", "params": {"title": "gpu shell", "focus": false}, "save": "gpu"},
    {"socket": "workspace.remote.configure", "params": {"workspace_id": "${train.workspace_id}", "destination": "dev@devbox"}},
    {"socket": "workspace.remote.configure", "params": {"workspace_id": "${logs.workspace_id}", "destination": "devbox"}},
    {"socket": "workspace.remote.configure", "params": {"workspace_id": "${gpu.workspace_id}", "destination": "ops@gpu-01"}},
    {"socket": "workspace.group.create", "params": {"name": "Release", "child_workspace_ids": ["${notes.workspace_id}", "${docs.workspace_id}"]}, "save": "g"},
    {"socket": "notification.create_for_target", "params": {"workspace_id": "${docs.workspace_id}", "title": "Build finished", "body": "docs site deployed"}},
    {"wait": 3},
    {"shot": "01-manual"},
    {"tree": "sidebar-manual"},
    {"socket": "sidebar.group_by", "params": {"mode": "host"}, "save": "host"},
    {"wait": 1.5},
    {"shot": "02-group-by-host"},
    {"tree": "sidebar-host"},
    {"socket": "sidebar.group_by", "params": {"mode": "status"}},
    {"wait": 1.5},
    {"shot": "03-group-by-status"},
    {"tree": "sidebar-status"},
    {"key": "p", "modifiers": ["command", "shift"]},
    {"wait": 0.5},
    {"type": "group by"},
    {"wait": 0.7},
    {"shot": "04-palette-group-by"},
    {"key": "escape"},
    {"socket": "sidebar.group_by", "params": {}, "save": "current"},
    {"socket": "sidebar.group_by", "params": {"mode": "manual"}},
    {"wait": 1.5},
    {"shot": "05-back-to-manual"},
    {"socket": "workspace.group.list", "params": {}, "save": "groups"}
  ]
}
