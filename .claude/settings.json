{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/ci/lint-swift-post-edit.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash scripts/ci/format-post-edit.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
