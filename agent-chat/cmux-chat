#!/bin/bash
# cmux-chat: open a cmux agent chat (browser-surface UI) from the terminal.
#
#   cmux-chat                          new composer as a workspace tab (sidebar entry)
#   cmux-chat fix the failing test     start a chat with that prompt
#   cmux-chat -p codex refactor foo    pick provider (claude/codex/opencode/goose/pi/gemini)
#   cmux-chat --split                  open as a split in the current workspace instead
#   cmux-chat --no-open ...            print the URL only
#   cmux-chat --terminal [--surface ID] chat view of the agent running in a
#                                      terminal ($CMUX_SURFACE_ID), as a split
#
# Starts the sidecar server (bun server.ts) if it isn't running. The server
# makes a token per launch and reports it, with its port, only in an
# owner-only state file (~/.cmux/agent-chat/state.json); every route needs it
# as the first path segment. The token never goes on a command line here:
# curl reads its URLs from stdin.
set -euo pipefail

SELF="$0"
[ -L "$SELF" ] && SELF="$(readlink "$SELF")"
HERE="$(cd "$(dirname "$SELF")" && pwd)"
PORT="${CMUX_AGENT_UI_PORT:-7739}"
BASE="http://127.0.0.1:${PORT}"
BUN="${BUN_BIN:-$HOME/.bun/bin/bun}"

if [ -n "${CMUX_AGENT_CHAT_STATE_FILE:-}" ]; then
  cd "$HERE"
  exec "$BUN" server.ts
fi

provider="claude" cwd="" open_mode="tab" auto_approve=true no_open=false
terminal=false surface="${CMUX_SURFACE_ID:-}"
prompt=()
while [ $# -gt 0 ]; do
  case "$1" in
    -p|--provider) provider="$2"; shift 2 ;;
    -C|--cwd) cwd="$2"; shift 2 ;;
    --split) open_mode="split"; shift ;;
    --tab) open_mode="tab"; shift ;;
    --no-open) no_open=true; shift ;;
    --terminal) terminal=true; open_mode="split"; shift ;;
    --surface) surface="$2"; shift 2 ;;
    --no-auto-approve) auto_approve=false; shift ;;
    -h|--help) sed -n '2,12p' "$SELF" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) prompt+=("$1"); shift ;;
  esac
done

STATE="$HOME/.cmux/agent-chat/state.json"

# curl with its URL (which carries the token) on stdin, never in argv.
curl_url() { # <url> [curl args...]
  local u="$1"; shift
  printf 'url = "%s"\n' "$u" | curl -fsS -K - "$@"
}

# The token from the state file, when that file names the server on $PORT.
state_token() {
  [ -r "$STATE" ] || return 1
  CC_PORT="$PORT" python3 -c '
import json, os, sys
s = json.load(open(sys.argv[1]))
if str(s.get("port")) != os.environ["CC_PORT"] or not s.get("token"): sys.exit(1)
print(s["token"])' "$STATE"
}

if ! curl -fsS --max-time 1 "$BASE/healthz" >/dev/null 2>&1; then
  echo "starting cmux-agent-ui server on :$PORT" >&2
  rm -f "$STATE"
  (cd "$HERE" && CMUX_AGENT_CHAT_PORT="$PORT" "$BUN" server.ts >> /tmp/cmux-agent-ui.log 2>&1 &)
  ok=false
  for _ in $(seq 1 50); do
    if curl -fsS --max-time 1 "$BASE/healthz" >/dev/null 2>&1 && state_token >/dev/null 2>&1; then ok=true; break; fi
    sleep 0.2
  done
  $ok || { echo "server failed to start; see /tmp/cmux-agent-ui.log" >&2; exit 1; }
fi
token="$(state_token)" || { echo "a server runs on :$PORT but $STATE does not name it; stop that server and retry" >&2; exit 1; }
curl_url "$BASE/$token/api/theme" --max-time 2 -o /dev/null 2>/dev/null \
  || { echo "the server on :$PORT refused the token in $STATE; stop that server and retry" >&2; exit 1; }
BASE="$BASE/$token"

url="$BASE/"
if $terminal; then
  [ -n "$surface" ] || { echo "--terminal needs --surface or CMUX_SURFACE_ID" >&2; exit 1; }
  url="$BASE/terminal/$surface"
elif [ ${#prompt[@]} -gt 0 ]; then
  body=$(printf '%s' "${prompt[*]}" | \
    CC_PROVIDER="$provider" CC_CWD="${cwd:-$PWD}" CC_AUTO="$auto_approve" python3 -c '
import json, sys, os
print(json.dumps({
    "prompt": sys.stdin.read(),
    "provider": os.environ["CC_PROVIDER"],
    "cwd": os.environ["CC_CWD"],
    "autoApprove": os.environ["CC_AUTO"] == "true",
}))')
  resp=$(curl_url "$BASE/api/sessions" -X POST -H 'content-type: application/json' -d "$body")
  url=$(printf '%s' "$resp" | python3 -c 'import json,sys; print(json.load(sys.stdin)["url"])')
fi

if $no_open; then
  echo "$url"
  exit 0
fi

if [ "$open_mode" = "tab" ]; then
  layout=$(CC_URL="$url" python3 -c '
import json, os
print(json.dumps({"pane": {"surfaces": [{"type": "browser", "url": os.environ["CC_URL"], "focus": True}]}}))')
  cmux new-workspace --name "agent chat" --layout "$layout" >/dev/null
else
  # Splits get a transparent webview so Ghostty background-opacity/blur show
  # through; the page matches with an alpha body when ?transparent=1 is set.
  params=$(CC_URL="${url}?transparent=1" python3 -c '
import json, os
p = {"url": os.environ["CC_URL"], "transparent_background": True}
ws = os.environ.get("CMUX_WORKSPACE_ID")
if ws: p["workspace_id"] = ws
print(json.dumps(p))')
  cmux rpc browser.open_split "$params" >/dev/null
fi
echo "$url"
