#!/bin/bash
# cmux-chat: open a cmux agent chat (browser-surface UI) from the terminal.
#
#   cmux-chat                          new composer as a workspace tab (sidebar entry)
#   cmux-chat fix the failing test     start a chat with that prompt
#   cmux-chat -p codex refactor foo    pick provider (claude/codex/opencode/pi/gemini)
#   cmux-chat --split                  open as a split in the current workspace instead
#   cmux-chat --no-open ...            print the URL only
#   cmux-chat --terminal [--surface ID] chat view of the agent running in a
#                                      terminal ($CMUX_SURFACE_ID), as a split
#
# Starts the sidecar server (bun server.ts) if it isn't running.
set -euo pipefail

SELF="$0"
[ -L "$SELF" ] && SELF="$(readlink "$SELF")"
HERE="$(cd "$(dirname "$SELF")" && pwd)"
PORT="${CMUX_AGENT_UI_PORT:-7739}"
BASE="http://127.0.0.1:${PORT}"
BUN="${BUN_BIN:-$HOME/.bun/bin/bun}"

if [ -n "${CMUX_AGENT_CHAT_STATE_FILE:-}" ]; then
  cd "$HERE"
  exec "$BUN" server.ts
fi

provider="claude" cwd="" open_mode="tab" auto_approve=true no_open=false
terminal=false surface="${CMUX_SURFACE_ID:-}"
prompt=()
while [ $# -gt 0 ]; do
  case "$1" in
    -p|--provider) provider="$2"; shift 2 ;;
    -C|--cwd) cwd="$2"; shift 2 ;;
    --split) open_mode="split"; shift ;;
    --tab) open_mode="tab"; shift ;;
    --no-open) no_open=true; shift ;;
    --terminal) terminal=true; open_mode="split"; shift ;;
    --surface) surface="$2"; shift 2 ;;
    --no-auto-approve) auto_approve=false; shift ;;
    -h|--help) sed -n '2,12p' "$SELF" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) prompt+=("$1"); shift ;;
  esac
done

# The server listens on loopback, which every local OS account can reach, and
# it runs agents with this user's tools. Every launch therefore carries a
# per-user token kept in an owner-only file; cmux reads the same file to open
# this server. CMUX_AGENT_CHAT_TOKEN overrides it.
TOKEN_DIR="$HOME/.cmuxterm/agent-chat"
TOKEN_FILE="$TOKEN_DIR/cli-token"

valid_token() {
  case "$1" in
    ''|*[!A-Za-z0-9_-]*) return 1 ;;
  esac
  [ "${#1}" -ge 16 ] && [ "${#1}" -le 256 ]
}

read_token_file() {
  [ -f "$TOKEN_FILE" ] && [ ! -L "$TOKEN_FILE" ] && [ -O "$TOKEN_FILE" ] || return 1
  chmod 600 "$TOKEN_FILE"
  IFS= read -r token < "$TOKEN_FILE" || [ -n "${token:-}" ]
  valid_token "$token"
}

resolve_token() {
  if [ -n "${CMUX_AGENT_CHAT_TOKEN:-}" ]; then
    token="$CMUX_AGENT_CHAT_TOKEN"
    valid_token "$token" || { echo "CMUX_AGENT_CHAT_TOKEN must be 16-256 characters of [A-Za-z0-9_-]" >&2; exit 1; }
    return
  fi
  (umask 077 && mkdir -p "$TOKEN_DIR")
  chmod 700 "$TOKEN_DIR"
  read_token_file && return
  local tmp
  tmp="$(umask 077 && mktemp "$TOKEN_DIR/cli-token.XXXXXX")"
  python3 -c 'import secrets; print(secrets.token_urlsafe(32))' > "$tmp"
  # ln refuses to replace a file, so concurrent first runs agree on one token.
  ln "$tmp" "$TOKEN_FILE" 2>/dev/null || true
  rm -f "$tmp"
  read_token_file || { echo "could not create $TOKEN_FILE" >&2; exit 1; }
}

token=""
resolve_token
AUTH_BASE="$BASE/$token"

# A server started without this token (an older cmux-chat, or another
# account's process on the port) serves its HTML shell for every path, so
# only a JSON answer proves the token is accepted.
accepts_token() {
  local content_type
  content_type=$(curl -fsS --max-time 1 -o /dev/null -w '%{content_type}' "$AUTH_BASE/api/sessions" 2>/dev/null) || return 1
  case "$content_type" in application/json*) return 0 ;; *) return 1 ;; esac
}

if ! curl -fsS --max-time 1 "$BASE/healthz" >/dev/null 2>&1; then
  echo "starting cmux-agent-ui server on :$PORT" >&2
  (cd "$HERE" && CMUX_AGENT_CHAT_TOKEN="$token" "$BUN" server.ts >> /tmp/cmux-agent-ui.log 2>&1 &)
  ok=false
  for _ in $(seq 1 50); do
    if curl -fsS --max-time 1 "$BASE/healthz" >/dev/null 2>&1; then ok=true; break; fi
    sleep 0.2
  done
  $ok || { echo "server failed to start; see /tmp/cmux-agent-ui.log" >&2; exit 1; }
fi
accepts_token || {
  echo "the server on :$PORT does not accept this user's agent chat token; stop it and rerun cmux-chat" >&2
  exit 1
}

url="$AUTH_BASE/"
if $terminal; then
  [ -n "$surface" ] || { echo "--terminal needs --surface or CMUX_SURFACE_ID" >&2; exit 1; }
  url="$AUTH_BASE/terminal/$surface"
elif [ ${#prompt[@]} -gt 0 ]; then
  body=$(printf '%s' "${prompt[*]}" | \
    CC_PROVIDER="$provider" CC_CWD="${cwd:-$PWD}" CC_AUTO="$auto_approve" python3 -c '
import json, sys, os
print(json.dumps({
    "prompt": sys.stdin.read(),
    "provider": os.environ["CC_PROVIDER"],
    "cwd": os.environ["CC_CWD"],
    "autoApprove": os.environ["CC_AUTO"] == "true",
}))')
  resp=$(curl -fsS -X POST "$AUTH_BASE/api/sessions" -H 'content-type: application/json' -d "$body")
  url=$(printf '%s' "$resp" | python3 -c 'import json,sys; print(json.load(sys.stdin)["url"])')
fi

if $no_open; then
  echo "$url"
  exit 0
fi

if [ "$open_mode" = "tab" ]; then
  layout=$(CC_URL="$url" python3 -c '
import json, os
print(json.dumps({"pane": {"surfaces": [{"type": "browser", "url": os.environ["CC_URL"], "focus": True}]}}))')
  cmux new-workspace --name "agent chat" --layout "$layout" >/dev/null
else
  # Splits get a transparent webview so Ghostty background-opacity/blur show
  # through; the page matches with an alpha body when ?transparent=1 is set.
  params=$(CC_URL="${url}?transparent=1" python3 -c '
import json, os
p = {"url": os.environ["CC_URL"], "transparent_background": True}
ws = os.environ.get("CMUX_WORKSPACE_ID")
if ws: p["workspace_id"] = ws
print(json.dumps(p))')
  cmux rpc browser.open_split "$params" >/dev/null
fi
echo "$url"
