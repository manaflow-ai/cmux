// Omnibar: browser chrome for agents and terminals. One band of chrome (tab strip and toolbar)
// at fixed heights, one colour everywhere with a neutral highlight on the selected tab and row,
// hairlines where two regions meet, and every corner derived from the address field's 8 pt.
// The colours are Hush's (warm near-white), flattened to one tone. Its twin is Omnibar Dark.
{
  "name": "Omnibar",
  "description": "Light: one chrome colour, a neutral highlight on the selected tab, hairline dividers, 8 pt root corner.",

  "appearance.theme": "Builtin Light",
  "appearance.appTheme": "followTerminal",
  // background: the one chrome colour. foreground: the ink. selection: the selected tab's and
  // row's highlight, the only second tone in the chrome (the ink at about 9% over the page).
  // accent: Send, focus and links only; never a selected row.
  "colors": { "background": "#fdfcf8", "foreground": "#2a2825", "selection": "#e9e5dc", "accent": "#4a65a3" },
  "appearance.accent": "theme",
  // The terminal: Hush's palette unchanged, solved in OKLCH over this same page colour.
  "ghostty": [
    "background = #fdfcf8",
    "foreground = #2a2825",
    "cursor-color = #4a65a3",
    "cursor-text = #fdfcf8",
    "selection-background = #e9e5dc",
    "selection-foreground = #2a2825",
    "palette = 0=#2a2825",
    "palette = 1=#975a56",
    "palette = 2=#47754e",
    "palette = 3=#7f6830",
    "palette = 4=#4e6c99",
    "palette = 5=#875c85",
    "palette = 6=#1d767b",
    "palette = 7=#6c7077",
    "palette = 8=#858991",
    "palette = 9=#a45f53",
    "palette = 10=#3f7e56",
    "palette = 11=#886e2a",
    "palette = 12=#5771a9",
    "palette = 13=#96608c",
    "palette = 14=#047e89",
    "palette = 15=#909397"
  ],
  "terminal.fontFamily": "SF Mono",
  "terminal.fontSize": 13,
  "appearance.saturation": 0.85,

  // Material: none. No wallpaper, no glass, no blur: browser chrome is opaque.
  "appearance.background": "none",
  "appearance.backgroundBlur": "none",
  "appearance.wallpaperTint": false,
  "appearance.fontSmoothing": "antialiased",

  // One colour, with a highlight for the selected tab: flat
  // chrome, the title area in the same tone, two-tone off, the sidebar on the same surface.
  // Regions separate by a 1 pt hairline, never by a shade.
  "appearance.chromeStyle": "flat",
  "appearance.titleAreaTone": "oneColor",
  "appearance.twoTone": "off",
  "appearance.sidebarSurface": "same",
  "appearance.borders": "default",
  // The selected tab meets its pane flush, with no goo.
  "appearance.cornerFlush": "flush",
  // The selected tab and row are a neutral highlight, whatever the accent.
  "appearance.selection": "neutral",
  "appearance.focusIndicator": "tabs",
  "focus.inactiveTabStyle": "quiet",
  "focusRing.style": "ring",
  "appearance.density": "cozy",

  // The band. One control height, 28 pt (the toolbar button, the address field and the row),
  // and one band height, 36 pt = 28 + 4 above + 4 below, for the tab strip and the toolbar alike.
  // Sidebar rows are the same 28 pt, so a session is the same size as a tab. Tabs: 192 pt at
  // most (on the 4 pt grid), 96 pt at least when selected (title and close button
  // stay), 56 pt otherwise (an icon plus a close button).
  "appearance.metrics.titlebarHeight": 36,
  "appearance.metrics.tabStripHeight": 36,
  "appearance.metrics.sidebarRowHeight": 28,
  "appearance.metrics.sidebarWidth": 220,
  "appearance.metrics.chromeFontSize": 13,
  "appearance.metrics.tabFontSize": 12,
  "appearance.metrics.tabMaxWidth": 192,
  "appearance.metrics.tabMinActiveWidth": 96,
  "appearance.metrics.tabMinInactiveWidth": 56,
  "appearance.metrics.columnGap": 0,
  "appearance.metrics.dividerThickness": 1,

  // Corners. The root is the address field's 8 pt (the default roundness is the address field's). A container's corner is its child's corner plus the padding between them: a chip
  // in the field is 6 (8 - 2), a pane holding 8 pt controls 4 pt from its edge is 12 (8 + 4).
  "layout.paneCornerRadius": 12,
  "layout.cornerPadding": 4,

  "sidebar.style": "standard",
  "sidebar.border": true,
  "sidebar.sectionLook": "quiet",

  // Every surface the one chrome colour; only the hairline differs.
  "appearance.surfaces.sidebar.color": "#fdfcf8",
  "appearance.surfaces.sidebar.opacity": 1,
  "appearance.surfaces.tabBar.color": "#fdfcf8",
  "appearance.surfaces.tabBar.opacity": 1,
  "appearance.surfaces.browserChrome.color": "#fdfcf8",
  "appearance.surfaces.browserChrome.opacity": 1,
  "appearance.surfaces.docks.color": "#fdfcf8",
  "appearance.surfaces.docks.opacity": 1,
  "appearance.surfaces.agentPane.color": "#fdfcf8",
  "appearance.surfaces.agentPane.opacity": 1,
  "appearance.surfaces.editor.color": "#fdfcf8",
  "appearance.surfaces.editor.opacity": 1,
  "appearance.surfaces.diff.color": "#fdfcf8",
  "appearance.surfaces.diff.opacity": 1,
  "appearance.surfaces.markdown.color": "#fdfcf8",
  "appearance.surfaces.markdown.opacity": 1,
  "appearance.surfaces.settings.color": "#fdfcf8",
  "appearance.surfaces.settings.opacity": 1,
  "appearance.surfaces.internalPage.color": "#fdfcf8",
  "appearance.surfaces.internalPage.opacity": 1,
  "appearance.surfaces.newTabPage.color": "#fdfcf8",
  "appearance.surfaces.newTabPage.opacity": 1,
  "appearance.surfaces.home.color": "#fdfcf8",
  "appearance.surfaces.home.opacity": 1,
  "appearance.surfaces.splitDivider.color": "#e2ded3",
  "appearance.surfaces.splitDivider.opacity": 1,

  // Status: a small dot, shown on tabs too: a tab's state is its favicon.
  "appearance.statusIndicator.style": "dot",
  "appearance.statusIndicator.animation": "animated",
  "appearance.statusIndicator.size": 0.85,
  "appearance.statusIndicator.showAgentWorkingOnTabs": true,

  // The address field: the root shape. 28 pt tall, 8 pt corners, 14 pt text, opaque, no shadow.
  "browser.omnibar.glass": "off",

  // Motion: short and flat. Colour changes ease out over 200 ms (a browser's tab and address
  // field timing); nothing springs.
  "ui.animationSpeed": "fast",
  "appearance.colorTransition.enabled": true,
  "appearance.colorTransition.curve": "easeOut",
  "appearance.colorTransition.duration": 200,
  "appearance.colorTransition.colorSpace": "oklab",
  "appearance.colorTransition.reduceMotion": "crossfade"

  // Pending cmux#46861 / cmux#47048 (layout and proportions). Uncomment once your build has them.
  // Rows inset 4 pt with 8 pt corners; 28 pt square toolbar buttons, 8 pt corners, 4 pt apart, the
  // hover fill the ink at 6% (10% in Dark).
  // "appearance.metrics.sidebarRowInset": 4,
  // "appearance.metrics.sidebarRowPadding": 8,
  // "appearance.metrics.sidebarRowGap": 0,
  // "appearance.metrics.toolbarButtonSize": 28,
  // "appearance.metrics.toolbarButtonGap": 4,
  // "appearance.metrics.toolbarButtonCornerRadius": 8,
  // "appearance.metrics.toolbarButtonActiveFill": 0.06,
  // "appearance.metrics.composerPadding": 6,
  // "appearance.metrics.composerMinHeight": 40,
  // Pending cmux#46780: the tab's own shape (8 pt top corners, 4 pt foot) is not settable.
  // "appearance.tabShape": "rounded",
}
