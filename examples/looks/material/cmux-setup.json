{
  "cmuxSetup": 1,
  "id": "manaflow-ai/material-look",
  "name": "Material",
  "tagline": "Material Design 3 for agent chats: a tonal two-tone drawer and tab row, Roboto, 20 px bubbles, one primary.",
  "description": "A whole cmux look in Material Design 3 (Material You), the baseline scheme as Android 14 and Google's apps draw it: theme files for color, tone and proportions (Material, the light default, and Material Dark), settings for Roboto on the M3 type scale, the chat's width and the navigation drawer's rows, a stylesheet of cmux.agentPane.style/1 tokens for the shape scale (20 px bubble, filled 12 px cards, M3 menus), and a customize view for a rich-tooltip hover card and drawer rows. Remove it and everything you had comes back.",
  "version": "1.1.0",
  "license": "MIT",
  "repository": "https://github.com/manaflow-ai/cmux-material-look",
  "screenshots": ["screenshots/chat.png", "screenshots/chat-dark.png"],

  "cmuxProfile": 1,
  "settings": {
    "appearance.themeFile": "material",

    // The rest of cmux in the same hand. The Markdown viewer: the system face, 16 px at the chat's
    // 1.5 line height and code scale, in a column as wide as the chat's (760 px is about 86
    // characters).
    "markdown.font.preset": "system",
    "markdown.font.size": 16,
    "markdown.font.lineHeight": 1.5,
    "markdown.code.scale": 0.875,
    "markdown.layout.width": 86,
    // Diffs in the theme's own red and green, with a bar at each changed line.
    "diff.colors": "theme",
    "diff.diffIndicators": "bars",

    // M3 type: Roboto everywhere, replies on Body Large (16 sp on a 24 sp line), code at 14.
    "agentPane.display.font.ui": "roboto",
    "agentPane.display.font.preset": "system",
    "agentPane.display.font.size": 16,
    "agentPane.display.font.lineHeight": 1.5,
    "agentPane.display.code.scale": 0.875,
    // A reading column as Google's chat apps keep it on an expanded window.
    "agentPane.display.width": 760,
    "agentPane.display.minimap": "off",
    "agentPane.display.statusVerbs.mode": "thinking",
    // The composer's ring: a determinate M3 circular progress indicator of the context window.
    "agentPane.composerRing": "context",
    // Pending in cmux#46738 (the composer's look); M3 would take the filled, full-pill composer:
    // "agentPane.composerLook": "...",

    // The navigation drawer: sections with headlines, a leading icon per item, a trailing label.
    "sidebar.density": "comfortable",
    "sidebar.groupBy": "folder",
    "sidebar.groupHeader.background": "sections",
    "sidebar.groupPalette": "theme",
    "sidebar.detailedStatusIcons": false,
    "sidebar.workspaceRow.icon": true,
    "sidebar.workspaceRow.directory": false,
    "sidebar.workspaceRow.branch": false,
    "sidebar.workspaceRow.lastActivity": false,
    "sidebar.showTimestamps": true,
    "sidebar.workspaceRow.pullRequest": true,
    "sidebar.workspaceRow.agentStatus": true
    // Pending in cmux#46805 (the sidebar's look):
    // "sidebar.look": "...",
  }
}
