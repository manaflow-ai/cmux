// Basalt: a quiet, near-black agent-editor look, dark (the default). A #1a1a1a page, a cooler
// #1a1b1c sidebar behind a 1 pt line, #f0f0f0 text with gray steps under it, one soft steel blue
// (#699be1) for Run, Send and focus with dark ink on it, links in a muted blue, the chat's prompt in
// a bordered box, tabs as small pills in the title bar, and quick, spatial motion.
// Every value was sampled from the pixels of the references in the README, at their 2x scale.
{
  "name": "Basalt",
  "description": "Near-black with a blue button.",

  "appearance.theme": "Builtin Dark",
  // The window, sidebar and pages take this file's colors, over an App Theme of your own.
  "appearance.appTheme": "followTerminal",
  // background: the page. foreground: the reply text. selection: a dimmed steel blue under light
  // text. accent: the Run button's blue (dark ink on it, which cmux draws on a dark theme's accent).
  // The terminal's red, green and yellow are the diff counts and the attention dot.
  "colors": {
    "background": "#1a1a1a",
    "foreground": "#f0f0f0",
    "selection": "#5e7695",
    "accent": "#699be1",
    "1": "#ea7485",
    "2": "#80b38d",
    "3": "#e8b773",
    "4": "#699be1",
    "9": "#ea7485",
    "10": "#80b38d",
    "11": "#e8b773",
    "12": "#86aee4",
    // The terminal palette, whole: the slots above as sampled, the rest at a quiet chroma, each
    // solved in OKLCH over the page (5.5:1, the bright ones 8.5:1, 8 the dim gray 3.4:1), and the
    // cursor in the accent.
    "0": "#474c52",
    "5": "#ba7cb7",
    "6": "#0ba1a7",
    "7": "#f0f0f0",
    "8": "#6a6f75",
    "13": "#ec9bdc",
    "14": "#1cc8d9",
    "15": "#edeef1",
    "cursor": "#699be1"
  },
  "appearance.accent": "theme",
  // The terminal face: Menlo at 12 pt, the face and size an editor's terminal opens in on a Mac.
  "terminal.fontFamily": "Menlo",
  "terminal.fontSize": 12,

  // No wallpaper, no glass: flat fills, as the editor draws them.
  "appearance.background": "none",
  "appearance.backgroundBlur": "none",
  "browser.omnibar.glass": "off",
  "appearance.fontSmoothing": "antialiased",

  // Layout: flat panes, a 1 pt line between the sidebar and the content, the title bar in the
  // content's own color, the focused pane marked by its tab, not a ring.
  "appearance.chromeStyle": "flat-sidebar-line",
  "appearance.borders": "default",
  "appearance.titleAreaTone": "oneColor",
  "appearance.focusIndicator": "tabs",
  "appearance.density": "comfortable",
  // Pending cmux#46780: a chat's tab is a small rounded pill (#242424) in the title bar.
  // "appearance.tabShape": "rounded",
  // Pending cmux#46516: the selected sidebar row is a gray fill (#2f3031), not the accent.
  // "appearance.selection": "neutral",

  // Proportions, measured at 2x: a 40 pt title bar holding the tab pills (26 pt tall), a 260 pt
  // sidebar with 30 pt rows, the 13 pt interface size the settings ship with, tab titles at 13 pt
  // that size to their title up to 240 pt, a 1 pt divider, no gutter.
  "appearance.metrics.titlebarHeight": 40,
  "appearance.metrics.sidebarWidth": 260,
  "appearance.metrics.sidebarRowHeight": 30,
  "appearance.metrics.chromeFontSize": 13,
  "appearance.metrics.tabStripHeight": 40,
  "appearance.metrics.tabFontSize": 13,
  "appearance.metrics.tabMaxWidth": 240,
  "appearance.metrics.tabMinActiveWidth": 120,
  "appearance.metrics.tabMinInactiveWidth": 96,
  "appearance.metrics.columnGap": 0,
  "appearance.metrics.dividerThickness": 1,

  // The sidebar: a cooler, lighter gray than the page, a 1 pt #333435 line, quiet gray headings
  // ("Repositories").
  "appearance.sidebarSurface": "separate",
  "appearance.surfaces.sidebar.color": "#1a1b1c",
  "appearance.surfaces.sidebar.opacity": 1,
  "sidebar.style": "standard",
  "sidebar.border": true,
  "sidebar.borderWidth": 1,
  "sidebar.sectionLook": "quiet",

  // The content: the page everywhere, the title bar and tab strip in it too; code, diffs and the
  // terminal a step darker (#181818, the editor's own ground, also its menus' fill).
  "appearance.surfaces.agentPane.color": "#1a1a1a",
  "appearance.surfaces.agentPane.opacity": 1,
  "appearance.surfaces.tabBar.color": "#1a1a1a",
  "appearance.surfaces.tabBar.opacity": 1,
  "appearance.surfaces.terminal.color": "#181818",
  "appearance.surfaces.terminal.opacity": 1,
  "appearance.surfaces.editor.color": "#181818",
  "appearance.surfaces.editor.opacity": 1,
  "appearance.surfaces.diff.color": "#181818",
  "appearance.surfaces.diff.opacity": 1,
  "appearance.surfaces.markdown.color": "#1a1a1a",
  "appearance.surfaces.markdown.opacity": 1,
  "appearance.surfaces.browserChrome.color": "#1a1a1a",
  "appearance.surfaces.browserChrome.opacity": 1,
  "appearance.surfaces.docks.color": "#1a1a1a",
  "appearance.surfaces.docks.opacity": 1,
  "appearance.surfaces.splitDivider.color": "#333435",
  "appearance.surfaces.splitDivider.opacity": 1,

  // Settings and pages: the page, with the grouped cards (#232323) the settings draw on it.
  "appearance.surfaces.settings.color": "#1a1a1a",
  "appearance.surfaces.settings.opacity": 1,
  "appearance.surfaces.internalPage.color": "#1a1a1a",
  "appearance.surfaces.internalPage.opacity": 1,
  "appearance.surfaces.newTabPage.color": "#1a1a1a",
  "appearance.surfaces.newTabPage.opacity": 1,
  "appearance.surfaces.home.color": "#1a1a1a",
  "appearance.surfaces.home.opacity": 1,

  // Status: a small dot on each row, animated while it works (amber when it waits for you, blue
  // when it finished unread, gray when done), also on the tab.
  "appearance.statusIndicator.style": "dot",
  "appearance.statusIndicator.animation": "animated",
  "appearance.statusIndicator.size": 0.8,
  "appearance.statusIndicator.showAgentWorkingOnTabs": true,

  // Motion: fast and spatial. Panes reflow at once; colors ease out in 150 ms.
  "ui.animationSpeed": "fast",
  "appearance.colorTransition.enabled": true,
  "appearance.colorTransition.curve": "easeOut",
  "appearance.colorTransition.duration": 150,
  "appearance.colorTransition.colorSpace": "oklab",
  "appearance.colorTransition.reduceMotion": "instant"

  // Pending cmux#46861 (layout and proportions): 26 pt toolbar buttons on a 6 pt rounded fill,
  // no hairline under the title bar, rows inset 8 pt with an 8 pt corner fill, a 42 pt composer.
  // "appearance.metrics.sidebarRowHeightWithSubtitle": 44,
  // "appearance.metrics.sidebarRowInset": 8,
  // "appearance.metrics.sidebarRowPadding": 10,
  // "appearance.metrics.sidebarRowGap": 1,
  // "appearance.metrics.toolbarButtonSize": 26,
  // "appearance.metrics.toolbarButtonGap": 6,
  // "appearance.metrics.toolbarButtonCornerRadius": 6,
  // "appearance.metrics.toolbarButtonActiveFill": 0.08,
  // "appearance.metrics.headerDivider": 0,
  // "appearance.metrics.composerPadding": 8,
  // "appearance.metrics.composerMinHeight": 42,
  // "appearance.metrics.spacingScale": 1,
}
