// Hairline: Flat and quiet, dark: zinc grays, 8 px corners, one-pixel borders and no shadows, no glass.
// Radius 8 px for panes, tabs, cards and popovers (layout.paneCornerRadius); buttons and tabs sit 2 px inside it.
{
  "name": "Hairline",
  "description": "Dark gray, thin borders.",
  "appearance.theme": "Builtin Dark",
  "appearance.appTheme": "followTerminal",
  "colors": {
    "background": "#09090b",
    "foreground": "#fafafa",
    "selection": "#74747b",
    "accent": "#fafafa"
  },
  "appearance.accent": "neutral",
  "ghostty": [
    "background = #09090b",
    "foreground = #fafafa",
    "cursor-color = #fafafa",
    "cursor-text = #09090b",
    "selection-background = #3f3f46",
    "selection-foreground = #fafafa",
    "palette = 0=#27272a",
    "palette = 1=#f87171",
    "palette = 2=#4ade80",
    "palette = 3=#facc15",
    "palette = 4=#60a5fa",
    "palette = 5=#c084fc",
    "palette = 6=#22d3ee",
    "palette = 7=#e4e4e7",
    "palette = 8=#71717a",
    "palette = 9=#f87171",
    "palette = 10=#4ade80",
    "palette = 11=#facc15",
    "palette = 12=#60a5fa",
    "palette = 13=#c084fc",
    "palette = 14=#22d3ee",
    "palette = 15=#fafafa"
  ],
  "terminal.fontFamily": "SF Mono",
  "terminal.fontSize": 13,
  "appearance.background": "none",
  "appearance.backgroundBlur": "none",
  "appearance.fontSmoothing": "antialiased",
  "appearance.chromeStyle": "flat",
  "appearance.borders": "default",
  "appearance.titleAreaTone": "oneColor",
  "appearance.focusIndicator": "both",
  "appearance.density": "compact",
  "appearance.metrics.titlebarHeight": 36,
  "appearance.metrics.sidebarWidth": 256,
  "appearance.metrics.sidebarRowHeight": 28,
  "appearance.metrics.chromeFontSize": 13,
  "appearance.metrics.tabStripHeight": 36,
  "appearance.metrics.tabFontSize": 13,
  "appearance.metrics.columnGap": 0,
  "appearance.metrics.dividerThickness": 1,
  "appearance.sidebarSurface": "separate",
  "sidebar.style": "standard",
  "sidebar.border": true,
  "sidebar.borderWidth": 1,
  "sidebar.sectionLook": "quiet",
  "appearance.statusIndicator.style": "dot",
  "layout.paneCornerRadius": 8,
  "layout.cornerPadding": 2,
  "layout.paneBorderWidth": 1,
  "ui.reducedBackgrounds": true,
  "appearance.surfaces.sidebar.color": "#0a0a0d",
  "appearance.surfaces.sidebar.opacity": 1,
  "appearance.surfaces.agentPane.color": "#09090b",
  "appearance.surfaces.agentPane.opacity": 1,
  "appearance.surfaces.terminal.color": "#09090b",
  "appearance.surfaces.terminal.opacity": 1,
  "appearance.surfaces.editor.color": "#09090b",
  "appearance.surfaces.editor.opacity": 1,
  "appearance.surfaces.diff.color": "#09090b",
  "appearance.surfaces.diff.opacity": 1,
  "appearance.surfaces.markdown.color": "#09090b",
  "appearance.surfaces.markdown.opacity": 1,
  "appearance.surfaces.tabBar.color": "#18181b",
  "appearance.surfaces.tabBar.opacity": 1,
  "appearance.surfaces.browserChrome.color": "#18181b",
  "appearance.surfaces.browserChrome.opacity": 1,
  "appearance.surfaces.docks.color": "#18181b",
  "appearance.surfaces.docks.opacity": 1,
  "appearance.surfaces.splitDivider.color": "#27272a",
  "appearance.surfaces.splitDivider.opacity": 1,
  "appearance.surfaces.settings.color": "#09090b",
  "appearance.surfaces.settings.opacity": 1,
  "appearance.surfaces.internalPage.color": "#09090b",
  "appearance.surfaces.internalPage.opacity": 1,
  "appearance.surfaces.newTabPage.color": "#09090b",
  "appearance.surfaces.newTabPage.opacity": 1,
  "appearance.surfaces.home.color": "#09090b",
  "appearance.surfaces.home.opacity": 1,
  "browser.omnibar.glass": "off",
  "ui.animationSpeed": "fast"
