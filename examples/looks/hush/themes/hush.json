// Hush: a calm assistant-browser look in Light. A warm near-white everywhere, the work in one large
// rounded card that floats on a soft shadow rather than a line, a parchment sidebar a breath
// darker than the card, a quiet slate-blue accent used sparingly, and slow, even motion with
// nothing that bounces. Its twin is Hush Dark.
{
  "name": "Hush",
  "description": "Light: warm near-white, a large rounded content card on a soft shadow, a parchment sidebar, a quiet slate accent.",

  "appearance.theme": "Builtin Light",
  "appearance.appTheme": "followTerminal",
  // background: the card's warm white (the source's page is #FDF8EC; this keeps its warmth at a
  // whisper). foreground: a warm graphite, softer than black. selection: a warm gray wash.
  // accent: a muted slate-blue, for Send, focus and links only.
  "colors": { "background": "#fdfcf8", "foreground": "#2a2825", "selection": "#e9e5dc", "accent": "#4a65a3" },
  "appearance.accent": "theme",
  // The terminal: the page and ink above, the cursor in the accent, the selection, and all sixteen
  // ANSI colors at a hushed chroma, each solved in OKLCH over the page (5.2:1, the bright ones
  // 4.7:1, 7 the gray 4.8:1, 15 3:1; 8, the dim gray, 3.4:1).
  "ghostty": [
    "background = #fdfcf8",
    "foreground = #2a2825",
    "cursor-color = #4a65a3",
    "cursor-text = #fdfcf8",
    "selection-background = #e9e5dc",
    "selection-foreground = #2a2825",
    "palette = 0=#2a2825",
    "palette = 1=#975a56",
    "palette = 2=#47754e",
    "palette = 3=#7f6830",
    "palette = 4=#4e6c99",
    "palette = 5=#875c85",
    "palette = 6=#1d767b",
    "palette = 7=#6c7077",
    "palette = 8=#858991",
    "palette = 9=#a45f53",
    "palette = 10=#3f7e56",
    "palette = 11=#886e2a",
    "palette = 12=#5771a9",
    "palette = 13=#96608c",
    "palette = 14=#047e89",
    "palette = 15=#909397"
  ],
  // The terminal face: SF Mono at 13 pt, the system's monospaced face, nothing louder.
  "terminal.fontFamily": "SF Mono",
  "terminal.fontSize": 13,
  // A little less color in the tint, so the accent never shouts.
  "appearance.saturation": 0.85,

  // Material: no wallpaper and no glass; the calm comes from flat warm paper.
  "appearance.background": "none",
  "appearance.backgroundBlur": "none",
  "appearance.wallpaperTint": false,
  "appearance.fontSmoothing": "antialiased",

  // Layout: one large rounded card inset into the sidebar's color, no hairlines anywhere (the card
  // separates by tone and shadow), title, tab strip and sidebar shaded apart from the card.
  "appearance.chromeStyle": "card",
  "appearance.borders": "none",
  "appearance.titleAreaTone": "subtleTone",
  "appearance.focusIndicator": "tabs",
  "appearance.density": "comfortable",
  // Pending cmux#46780: tabs are soft rounded chips; the selected one is the card's white.
  // "appearance.tabShape": "rounded",
  // Pending cmux#46516: the selected row is a white lift, not an accent fill.
  // "appearance.selection": "neutral",

  // Proportions, measured from the source captures: a 44 pt top band (window buttons and the
  // toolbar's square buttons), a 200 pt sidebar (the source's 18% of its window) with 32 pt rows,
  // 13 pt chrome text, a 36 pt tab strip with 13 pt titles, a 6 pt inset around the card and no
  // divider.
  "appearance.metrics.titlebarHeight": 44,
  "appearance.metrics.sidebarWidth": 200,
  "appearance.metrics.sidebarRowHeight": 32,
  "appearance.metrics.chromeFontSize": 13,
  "appearance.metrics.tabStripHeight": 36,
  "appearance.metrics.tabFontSize": 13,
  "appearance.metrics.tabMaxWidth": 220,
  "appearance.metrics.tabMinActiveWidth": 140,
  "appearance.metrics.tabMinInactiveWidth": 96,
  "appearance.metrics.columnGap": 6,
  "appearance.metrics.dividerThickness": 0,

  // The sidebar: opaque warm parchment, no edge line, sections under quiet headings.
  "appearance.sidebarSurface": "separate",
  "appearance.surfaces.sidebar.color": "#f3eee2",
  "appearance.surfaces.sidebar.opacity": 1,
  "sidebar.style": "standard",
  "sidebar.border": false,
  "sidebar.sectionLook": "quiet",

  // The card: warm white; the tab strip and toolbar the sidebar's parchment so the card is the
  // only light thing; docks and the browser's bar a half step under the card.
  "appearance.surfaces.agentPane.color": "#fdfcf8",
  "appearance.surfaces.agentPane.opacity": 1,
  "appearance.surfaces.tabBar.color": "#f3eee2",
  "appearance.surfaces.tabBar.opacity": 1,
  "appearance.surfaces.browserChrome.color": "#f8f5ee",
  "appearance.surfaces.browserChrome.opacity": 1,
  "appearance.surfaces.docks.color": "#f8f5ee",
  "appearance.surfaces.docks.opacity": 1,
  "appearance.surfaces.editor.color": "#fdfcf8",
  "appearance.surfaces.editor.opacity": 1,
  "appearance.surfaces.diff.color": "#fdfcf8",
  "appearance.surfaces.diff.opacity": 1,
  "appearance.surfaces.markdown.color": "#fdfcf8",
  "appearance.surfaces.markdown.opacity": 1,
  "appearance.surfaces.splitDivider.color": "#ebe5d6",
  "appearance.surfaces.splitDivider.opacity": 1,

  // Settings and pages: the new tab's warm page, the same as the card, so a page is one calm sheet
  // with a centered field.
  "appearance.surfaces.settings.color": "#fbf8f1",
  "appearance.surfaces.settings.opacity": 1,
  "appearance.surfaces.internalPage.color": "#fbf8f1",
  "appearance.surfaces.internalPage.opacity": 1,
  "appearance.surfaces.newTabPage.color": "#fbf8f1",
  "appearance.surfaces.newTabPage.opacity": 1,
  "appearance.surfaces.home.color": "#fbf8f1",
  "appearance.surfaces.home.opacity": 1,

  // Status: a small dot that breathes, never a spinner; not repeated on the tabs.
  "appearance.statusIndicator.style": "dot",
  "appearance.statusIndicator.animation": "animated",
  "appearance.statusIndicator.size": 0.85,
  "appearance.statusIndicator.showAgentWorkingOnTabs": false,

  // The address field: plain, no glass.
  "browser.omnibar.glass": "off",

  // Motion: slow and even. A gentle ease-in-out over 450 ms for color changes, no spring.
  "ui.animationSpeed": "normal",
  "appearance.colorTransition.enabled": true,
  "appearance.colorTransition.curve": "easeInOut",
  "appearance.colorTransition.duration": 450,
  "appearance.colorTransition.colorSpace": "oklab",
  "appearance.colorTransition.reduceMotion": "crossfade"

  // Pending cmux#46861 (layout and proportions): a calm browser: rows inset 6 pt with 10 pt corners, 28 pt square toolbar buttons with an 8 pt fill and even gaps, no toolbar hairline, a roomy 56 pt card composer. Uncomment once your build has it.
  // "appearance.metrics.sidebarRowHeightWithSubtitle": 48,
  // "appearance.metrics.sidebarRowInset": 6,
  // "appearance.metrics.sidebarRowPadding": 10,
  // "appearance.metrics.sidebarRowGap": 2,
  // "appearance.metrics.toolbarButtonSize": 28,
  // "appearance.metrics.toolbarButtonGap": 6,
  // "appearance.metrics.toolbarButtonCornerRadius": 8,
  // "appearance.metrics.toolbarButtonActiveFill": 0.08,
  // "appearance.metrics.headerDivider": 0,
  // "appearance.metrics.composerPadding": 14,
  // "appearance.metrics.composerMinHeight": 56,
  // "appearance.metrics.spacingScale": 1.1,
}
