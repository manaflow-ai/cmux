{
  "cmuxSetup": 1,
  "id": "manaflow-ai/hush-look",
  "name": "Hush",
  "tagline": "Soft white with one big card.",
  "description": "Soft white with one big card.",
  "version": "1.1.0",
  "license": "MIT",
  "repository": "https://github.com/manaflow-ai/cmux-hush-look",
  "screenshots": ["screenshots/hush-light.png", "screenshots/hush-dark.png"],

  "cmuxProfile": 1,
  "settings": {
    "appearance.themeFile": "hush",

    // The rest of cmux in the same hand. The Markdown viewer: the system face, 16 px at the chat's
    // 1.6 line height and code scale, in a column as wide as the chat's (680 px is about 82
    // characters).
    "markdown.font.preset": "system",
    "markdown.font.size": 16,
    "markdown.font.lineHeight": 1.6,
    "markdown.code.scale": 0.88,
    "markdown.layout.width": 82,
    // Diffs in muted red and green, so a diff never shouts, with a bar at each changed line.
    "diff.colors": "muted",
    "diff.diffIndicators": "bars",
    // Sidebar group colors in grays, so color stays for focus alone.
    "sidebar.groupPalette": "grayscale",

    // The chat as a quiet reading panel: the system font at 15 px with a roomy 1.6 line height,
    // code at 0.88 so it never shouts over the prose, a 680 px column, no minimap, the harness
    // marks as small symbols, and the context ring around Send.
    "agentPane.display.font.ui": "system-ui",
    "agentPane.display.font.preset": "system",
    "agentPane.display.font.size": 15,
    "agentPane.display.font.lineHeight": 1.6,
    "agentPane.display.code.scale": 0.88,
    "agentPane.display.width": 680,
    "agentPane.display.minimap": "off",
    "agentPane.display.harnessPlacement": "symbols",
    "agentPane.composerRing": "context",
    // Pending cmux#46738: no floating-card composer exists (auto, codex, claude); a white card on a
    // soft shadow with a pill "add files" chip and a round gray Send is the gap.
    // "agentPane.composerLook": "auto",

    // The sidebar, quiet: one-line rows with their icon and nothing else, plain section headings,
    // groups as plain headings, no timestamps or detailed status marks, and the sidebar's buttons
    // shown only while the pointer is over it (the source shows a tab's close button on its
    // selected row and nothing on the rest).
    // Pending cmux#46805: no calm-browser sidebar look exists (cmux, claude, codex, studio).
    // "sidebar.look": "cmux",
    "sidebar.density": "comfortable",
    "sidebar.minimal": true,
    "sidebar.groupBy": "folder",
    "sidebar.groupHeader.background": "sections",
    "sidebar.groupHeader.memberCount": false,
    "sidebar.chromeGroups": false,
    "sidebar.detailedStatusIcons": false,
    "sidebar.showTimestamps": false,
    "sidebar.workspaceRow.icon": true,
    "sidebar.workspaceRow.directory": false,
    "sidebar.workspaceRow.branch": false,
    "sidebar.workspaceRow.lastActivity": false,
    "sidebar.workspaceRow.agentStatus": false,
    "sidebar.workspaceRow.pullRequest": false,
    "sidebar.workspaceRow.working": true,
    "sidebar.workspaceRow.progress": false,
    "sidebar.hoverCards.enabled": true,

    // The address field: a soft rounded field, no shadow.
    "browser.omnibar.cornerRadius": 12,
    "browser.omnibar.shadow": false
  }
}
