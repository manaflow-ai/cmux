{
  "cmuxSetup": 1,
  "id": "manaflow-ai/linen-look",
  "name": "Linen",
  "tagline": "A soft consumer chat look: one centered column, a pill composer, a gray history sidebar, almost no chrome.",
  "description": "A whole cmux look built only from public surfaces, after a consumer chat app: theme files for color, flat chrome and proportions (Linen, light, the default; Linen Dark), settings for a centered 768 px reading column in larger type, a history sidebar of recent chats with their age and hover controls, a quiet Thinking line and spinner while work runs, a stylesheet of cmux.agentPane.style/1 tokens for gray prompt pills and soft rounded menus, and a customize view for its preview hover card. Remove it and everything you had comes back.",
  "version": "1.1.0",
  "license": "MIT",
  "repository": "https://github.com/manaflow-ai/cmux-linen-look",
  "screenshots": ["screenshots/linen-light.png", "screenshots/linen-dark.png"],

  "cmuxProfile": 1,
  "settings": {
    "appearance.themeFile": "linen",

    // The rest of cmux in the same hand. The Markdown viewer: the system face, 16 px at the chat's
    // 1.6 line height and code scale, in a column as wide as the chat's (768 px is about 87
    // characters).
    "markdown.font.preset": "system",
    "markdown.font.size": 16,
    "markdown.font.lineHeight": 1.6,
    "markdown.code.scale": 0.9,
    "markdown.layout.width": 87,
    // Diffs in the theme's own red and green, with a bar at each changed line.
    "diff.colors": "theme",
    "diff.diffIndicators": "bars",
    // Sidebar group colors in grays, so color stays for focus alone.
    "sidebar.groupPalette": "grayscale",

    // The chat: the system font, 16 px text on a 1.6 line, code at 0.9, one centered 768 px
    // column, no minimap.
    "agentPane.display.font.ui": "system-ui",
    "agentPane.display.font.preset": "system",
    "agentPane.display.font.size": 16,
    "agentPane.display.font.lineHeight": 1.6,
    "agentPane.display.code.scale": 0.9,
    "agentPane.display.width": 768,
    "agentPane.display.fullWidth": false,
    "agentPane.display.minimap": "off",
    // Work folds into one line you can open ("Worked for 17s >"); while it runs the status says
    // Thinking and stays on it, no rotating verbs.
    "agentPane.display.transcriptView": "normal",
    "agentPane.display.statusVerbs.mode": "thinking",
    "agentPane.display.harnessPlacement": "symbols",
    // "Work locally" sits under the composer, at its left.
    "agentPane.display.environment.placement": "left",
    // The session panel (progress, outputs, sources) pushes the column aside, never covers it.
    "agentPane.display.sessionInfo.placement": "push",
    // A file the chat made is one card under the answer, folded.
    "agentPane.editedFiles.show": "collapsed",
    "agentPane.editedFiles.scope": "turn",
    "agentPane.composerRing": "context",
    // Pending cmux#46738: the Codex composer is this look's pill: a rounded field with + at the
    // left and a round Send at the right.
    // "agentPane.composerLook": "codex",

    // The sidebar: a history of recent chats under plain gray headings, one line each with its age
    // at the right, pin and archive on hover, no icons, a spinner while one works.
    // Pending cmux#46805: the Codex sidebar look is this look's history list.
    // "sidebar.look": "codex",
    "sidebar.density": "comfortable",
    "sidebar.groupBy": "recents",
    "sidebar.groupHeader.background": "sections",
    "sidebar.groupHeader.memberCount": false,
    "sidebar.chromeGroups": false,
    "sidebar.detailedStatusIcons": false,
    "sidebar.showTimestamps": true,
    "sidebar.controlsOnHover": true,
    "sidebar.showSearchButton": true,
    "sidebar.workspaceRow.icon": false,
    "sidebar.workspaceRow.directory": false,
    "sidebar.workspaceRow.branch": false,
    "sidebar.workspaceRow.lastActivity": false,
    "sidebar.workspaceRow.agentStatus": false,
    "sidebar.workspaceRow.pullRequest": false,
    "sidebar.workspaceRow.working": true,
    "sidebar.workspaceRow.progress": false,
    "sidebar.hoverCards.enabled": true,
    "sidebar.hoverCards.layout": "compact",
    "sidebar.hoverCards.delay": 600,

    // The browser's address field: a capsule, like every field in the look, no shadow.
    "browser.omnibar.cornerRadius": "capsule",
    "browser.omnibar.shadow": false
  }
}
