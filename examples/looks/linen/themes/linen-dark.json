// Linen Dark: the same consumer chat, dark. A #212121 page with one centered reading column, a
// deeper #181818 history sidebar with no line beside it, #f3f3f3 text, prompts in #303030 pills
// on the right, a white round Send with a dark arrow, rounded menus, a quiet "Thinking" and a
// spinner while work runs, and gentle motion.
// Every value was sampled or measured from the pixels of the references in the README.
{
  "name": "Linen Dark",
  "description": "The consumer chat, dark: #212121 page, #181818 history sidebar, #303030 prompt pills, a white Send.",

  "appearance.theme": "Builtin Dark",
  // The window, sidebar and pages take this file's colors, over an App Theme of your own.
  "appearance.appTheme": "followTerminal",
  // background: the #212121 page. foreground: #f3f3f3. selection: a deep blue under the text.
  // accent: near-white, the round Send button and focus, the page color on it: no brand hue.
  // The terminal's blue is the unread dot's, its green the "link copied" toast's, its red Delete's.
  "colors": {
    "background": "#212121",
    "foreground": "#f3f3f3",
    "selection": "#5a76a0",
    "accent": "#f3f3f3",
    "1": "#ff6b62",
    "2": "#4cc27a",
    "3": "#ff9d4d",
    "4": "#6b9cf5",
    "9": "#ff6b62",
    "10": "#4cc27a",
    "11": "#ff9d4d",
    "12": "#6b9cf5",
    // The terminal palette, whole: the slots above as sampled, the rest at a plain chroma, each
    // solved in OKLCH over the page (5.5:1, the bright ones 8.5:1, 8 the dim gray 3.4:1), and the
    // cursor in the accent.
    "0": "#4c5157",
    "5": "#c082be",
    "6": "#15a8ae",
    "7": "#f3f3f3",
    "8": "#6f747a",
    "13": "#f3a2e3",
    "14": "#2bcfe0",
    "15": "#f5f7fa",
    "cursor": "#f3f3f3"
  },
  "appearance.accent": "theme",
  // The terminal face: SF Mono at 13 pt, the system's monospaced face, as the chat's code blocks
  // use.
  "terminal.fontFamily": "SF Mono",
  "terminal.fontSize": 13,

  // No wallpaper, no glass: plain fills.
  "appearance.background": "none",
  "appearance.backgroundBlur": "none",
  "browser.omnibar.glass": "off",
  "appearance.fontSmoothing": "antialiased",

  // Layout: flat, no line between the sidebar and the chat (the gray alone parts them), the title
  // bar in the page's gray, one pane at a time with no ring.
  "appearance.chromeStyle": "flat",
  "appearance.borders": "default",
  "appearance.titleAreaTone": "oneColor",
  "appearance.focusIndicator": "tabs",
  "appearance.density": "comfortable",
  // Pending cmux#46780: a side panel's tab is a rounded pill with its close button.
  // "appearance.tabShape": "rounded",
  // Pending cmux#46516: the selected history row is a lighter rounded fill (#2f2f2f), not the accent.
  // "appearance.selection": "neutral",

  // Proportions: a 52 pt header, the 260 pt history sidebar with 32 pt rows, 14 pt sidebar text,
  // tabs at 13 pt in a 36 pt strip, a 1 pt divider, no gutter.
  "appearance.metrics.titlebarHeight": 52,
  "appearance.metrics.sidebarWidth": 260,
  "appearance.metrics.sidebarRowHeight": 32,
  "appearance.metrics.chromeFontSize": 14,
  "appearance.metrics.tabStripHeight": 36,
  "appearance.metrics.tabFontSize": 13,
  "appearance.metrics.tabMaxWidth": 220,
  "appearance.metrics.tabMinActiveWidth": 120,
  "appearance.metrics.tabMinInactiveWidth": 96,
  "appearance.metrics.columnGap": 0,
  "appearance.metrics.dividerThickness": 1,

  // The sidebar: a step darker than the page (#181818), no edge line, quiet gray headings ("Pinned", "Threads").
  "appearance.sidebarSurface": "separate",
  "appearance.surfaces.sidebar.color": "#181818",
  "appearance.surfaces.sidebar.opacity": 1,
  "sidebar.style": "standard",
  "sidebar.border": false,
  "sidebar.sectionLook": "quiet",

  // The content: the #212121 page everywhere a person reads; code and diffs on a code block's #181818.
  "appearance.surfaces.agentPane.color": "#212121",
  "appearance.surfaces.agentPane.opacity": 1,
  "appearance.surfaces.tabBar.color": "#212121",
  "appearance.surfaces.tabBar.opacity": 1,
  "appearance.surfaces.terminal.color": "#212121",
  "appearance.surfaces.terminal.opacity": 1,
  "appearance.surfaces.editor.color": "#181818",
  "appearance.surfaces.editor.opacity": 1,
  "appearance.surfaces.diff.color": "#181818",
  "appearance.surfaces.diff.opacity": 1,
  "appearance.surfaces.markdown.color": "#212121",
  "appearance.surfaces.markdown.opacity": 1,
  "appearance.surfaces.browserChrome.color": "#212121",
  "appearance.surfaces.browserChrome.opacity": 1,
  "appearance.surfaces.docks.color": "#212121",
  "appearance.surfaces.docks.opacity": 1,
  "appearance.surfaces.splitDivider.color": "#303030",
  "appearance.surfaces.splitDivider.opacity": 1,

  // Settings and pages: the page's gray sheet.
  "appearance.surfaces.settings.color": "#212121",
  "appearance.surfaces.settings.opacity": 1,
  "appearance.surfaces.internalPage.color": "#212121",
  "appearance.surfaces.internalPage.opacity": 1,
  "appearance.surfaces.newTabPage.color": "#212121",
  "appearance.surfaces.newTabPage.opacity": 1,
  "appearance.surfaces.home.color": "#212121",
  "appearance.surfaces.home.opacity": 1,

  // Status: a thin spinning ring while a chat works (the composer's Stop spinner), also on tabs.
  "appearance.statusIndicator.style": "arc",
  "appearance.statusIndicator.animation": "animated",
  "appearance.statusIndicator.thickness": 1.5,
  "appearance.statusIndicator.showAgentWorkingOnTabs": true,

  // Motion: soft, at the standard speed; colors ease in and out over 250 ms.
  "ui.animationSpeed": "normal",
  "appearance.colorTransition.enabled": true,
  "appearance.colorTransition.curve": "easeInOut",
  "appearance.colorTransition.duration": 250,
  "appearance.colorTransition.colorSpace": "oklab",
  "appearance.colorTransition.reduceMotion": "crossfade"

  // Pending cmux#46861 (layout and proportions): 36 pt round toolbar buttons with a 10 pt gray
  // fill on hover, no hairline under the header, history rows inset 6 pt with a 10 pt rounded
  // fill, a pill composer at least 52 pt tall.
  // "appearance.metrics.sidebarRowHeightWithSubtitle": 48,
  // "appearance.metrics.sidebarRowInset": 6,
  // "appearance.metrics.sidebarRowPadding": 10,
  // "appearance.metrics.sidebarRowGap": 0,
  // "appearance.metrics.toolbarButtonSize": 36,
  // "appearance.metrics.toolbarButtonGap": 4,
  // "appearance.metrics.toolbarButtonCornerRadius": 10,
  // "appearance.metrics.toolbarButtonActiveFill": 0.06,
  // "appearance.metrics.headerDivider": 0,
  // "appearance.metrics.composerPadding": 12,
  // "appearance.metrics.composerMinHeight": 52,
  // "appearance.metrics.spacingScale": 1.1,
}
