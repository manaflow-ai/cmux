// shadcn Dark: shadcn/ui as it ships today (v4, new-york, the neutral base color), dark. A #0a0a0a page,
// a #171717 sidebar with a white-at-10% hairline, #fafafa text, a #e5e5e5 primary and no
// hue anywhere; panes are outlined cards, not shadows. Every value below is one of shadcn's own
// tokens (globals.css .dark) or one of its component sizes, named on its line.
{
  "name": "shadcn Dark",
  "description": "shadcn/ui neutral, dark: #0a0a0a page, #171717 sidebar, white-at-10% hairlines, light primary.",

  "appearance.theme": "Builtin Dark",
  // The window, sidebar and pages take that theme too, over an App Theme of your own.
  "appearance.appTheme": "followTerminal",
  // background, foreground, accent (the selected item's fill) and primary. "1" and "9" are the
  // terminal's red, which the app's destructive red is made from: shadcn's --destructive
  // oklch(0.704 0.191 22.216).
  "colors": {
    "background": "#0a0a0a",
    "foreground": "#fafafa",
    "selection": "#757575",
    "accent": "#e5e5e5",
    "1": "#ff6467",
    "9": "#ff6467",
    // The terminal palette, whole: the slots above as sampled, the rest at a neutral chroma, each
    // solved in OKLCH over the page (5.5:1, the bright ones 8.5:1, 8 the dim gray 3.4:1), and the
    // cursor in the accent.
    "0": "#3f444a",
    "2": "#439854",
    "3": "#a78206",
    "4": "#5388d5",
    "5": "#b66db4",
    "6": "#0d969c",
    "7": "#fafafa",
    "8": "#61666c",
    "10": "#47c078",
    "11": "#d2a40a",
    "12": "#7fa9ff",
    "13": "#e88ad7",
    "14": "#05bccc",
    "15": "#dfe1e3",
    "cursor": "#e5e5e5"
  },
  // No hue: Send, focus and selection come from the light primary above.
  "appearance.accent": "neutral",
  // The terminal face: Geist Mono at 13 pt, the monospaced twin of the chat's Geist;
  // without it installed, the terminal keeps its built-in face.
  "terminal.fontFamily": "Geist Mono",
  "terminal.fontSize": 13,
  // Pending: the selected sidebar row as shadcn's gray --sidebar-accent, not the primary (cmux #46516).
  // "appearance.selection": "neutral",

  // No wallpaper, no glass: shadcn surfaces are flat fills.
  "appearance.background": "none",
  "appearance.backgroundBlur": "none",
  "browser.omnibar.glass": "off",
  // Panes are outlined cards on the sidebar's color (shadcn's sidebar variant="inset" layout).
  "appearance.chromeStyle": "card-outlined",
  "appearance.borders": "default",
  // Tailwind's `antialiased` on <body>.
  "appearance.fontSmoothing": "antialiased",

  // Sidebar: --sidebar #171717 with --sidebar-border white at 10%, a 1 px border-r.
  "appearance.sidebarSurface": "separate",
  "appearance.surfaces.sidebar.color": "#0a0a0a",
  "appearance.surfaces.sidebar.opacity": 1,
  "sidebar.border": true,
  "sidebar.borderWidth": 1,
  // SidebarGroupLabel: small muted labels over plain lists, no cards, no rules.
  "sidebar.sectionLook": "quiet",

  // Pages: --background.
  "appearance.surfaces.agentPane.color": "#0a0a0a",
  "appearance.surfaces.agentPane.opacity": 1,
  "appearance.surfaces.terminal.color": "#0a0a0a",
  "appearance.surfaces.terminal.opacity": 1,
  "appearance.surfaces.settings.color": "#0a0a0a",
  "appearance.surfaces.settings.opacity": 1,
  "appearance.surfaces.internalPage.color": "#0a0a0a",
  "appearance.surfaces.internalPage.opacity": 1,
  "appearance.surfaces.newTabPage.color": "#0a0a0a",
  "appearance.surfaces.newTabPage.opacity": 1,
  "appearance.surfaces.home.color": "#0a0a0a",
  "appearance.surfaces.home.opacity": 1,
  "appearance.surfaces.markdown.color": "#0a0a0a",
  "appearance.surfaces.markdown.opacity": 1,
  "appearance.surfaces.editor.color": "#0a0a0a",
  "appearance.surfaces.editor.opacity": 1,
  "appearance.surfaces.diff.color": "#0a0a0a",
  "appearance.surfaces.diff.opacity": 1,
  "appearance.surfaces.browserChrome.color": "#0a0a0a",
  "appearance.surfaces.browserChrome.opacity": 1,
  // Docks sit beside the sidebar: --sidebar.
  "appearance.surfaces.docks.color": "#171717",
  "appearance.surfaces.docks.opacity": 1,
  // Lines between panes: --border.
  "appearance.surfaces.splitDivider.color": "#ffffff1a",
  "appearance.surfaces.splitDivider.opacity": 1,
  // The tab strip is shadcn's TabsList: a bg-muted track the selected tab sits on.
  "appearance.surfaces.tabBar.color": "#262626",
  "appearance.surfaces.tabBar.opacity": 1,
  // Pending: the selected tab as a raised, rounded card on the track (cmux #46780).
  // "appearance.tabShape": "rounded",

  // The focused pane shows on its tab (data-[state=active]), no ring around the pane.
  "appearance.focusIndicator": "tabs",
  // Work in progress: a small pulsing dot (animate-pulse) in the primary, no spinner.
  "appearance.statusIndicator.style": "dot",
  "appearance.statusIndicator.animation": "animated",
  "appearance.statusIndicator.color": "#e5e5e5",

  // Proportions, from shadcn's components (Tailwind's 4 px grid).
  "appearance.density": "compact",
  // SIDEBAR_WIDTH 16rem; SidebarMenuButton h-8; the sidebar-07 header at h-12 (its h-16 is past
  // the 56 cap); TabsList h-9; TabsTrigger text-sm; a TabsTrigger in the docs' w-[400px] two-tab
  // list; text-sm, the size of every shadcn control; SidebarInset m-2; a 1 px border.
  "appearance.metrics.sidebarWidth": 256,
  "appearance.metrics.sidebarRowHeight": 32,
  "appearance.metrics.titlebarHeight": 48,
  "appearance.metrics.tabStripHeight": 36,
  "appearance.metrics.tabFontSize": 14,
  "appearance.metrics.tabMaxWidth": 200,
  "appearance.metrics.chromeFontSize": 14,
  "appearance.metrics.columnGap": 8,
  "appearance.metrics.dividerThickness": 1,

  // Motion: Tailwind's transition (150 ms, cubic-bezier(0.4, 0, 0.2, 1)), colors blended in OKLab
  // as shadcn's oklch tokens are.
  "ui.animationSpeed": "fast",
  "appearance.colorTransition.enabled": true,
  "appearance.colorTransition.duration": 150,
  "appearance.colorTransition.curve": "cubicBezier",
  "appearance.colorTransition.bezierX1": 0.4,
  "appearance.colorTransition.bezierY1": 0,
  "appearance.colorTransition.bezierX2": 0.2,
  "appearance.colorTransition.bezierY2": 1,
  "appearance.colorTransition.colorSpace": "oklab"

  // Pending cmux#46861 (layout and proportions): shadcn: h-7 icon buttons, rounded-md, a border-b header, the sidebar's 4 px gap and px-2 rows, a min-h-16 textarea. Uncomment once your build has it.
  // "appearance.metrics.sidebarRowHeightWithSubtitle": 48,
  // "appearance.metrics.sidebarRowInset": 8,
  // "appearance.metrics.sidebarRowPadding": 8,
  // "appearance.metrics.sidebarRowGap": 4,
  // "appearance.metrics.toolbarButtonSize": 28,
  // "appearance.metrics.toolbarButtonGap": 4,
  // "appearance.metrics.toolbarButtonCornerRadius": 6,
  // "appearance.metrics.toolbarButtonActiveFill": 0.06,
  // "appearance.metrics.headerDivider": 1,
  // "appearance.metrics.composerPadding": 12,
  // "appearance.metrics.composerMinHeight": 64,
  // "appearance.metrics.spacingScale": 1,
}
