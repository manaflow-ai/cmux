{
  "cmuxSetup": 1,
  "id": "manaflow-ai/shadcn-look",
  "name": "shadcn",
  "tagline": "shadcn/ui on every surface: Geist, neutral black and white, 1 px hairlines, outlined cards, a quiet grouped sidebar.",
  "description": "A whole cmux look made from shadcn/ui as it ships today (v4, new-york, neutral): its color tokens in a light and a dark theme file, its component sizes as cmux's proportions, Geist type, a stylesheet of cmux.agentPane.style/1 tokens for the muted prompt bubble, outlined cards and DropdownMenu-shaped menus, and a customize view whose hover card is a shadcn HoverCard. Remove it and everything you had comes back.",
  "version": "1.0.0",
  "license": "MIT",
  "repository": "https://github.com/manaflow-ai/cmux-shadcn-look",

  "cmuxProfile": 1,
  "settings": {
    "appearance.themeFile": "shadcn",
    "agentPane.display.font.ui": "geist",
    "agentPane.display.font.preset": "system",
    "agentPane.display.font.size": 14,
    "agentPane.display.font.lineHeight": 1.6,
    "agentPane.display.code.family": "Geist Mono",
    "agentPane.display.code.scale": 0.875,
    "agentPane.display.width": 768,
    "agentPane.composerRing": "context",
    // Pending: the composer as shadcn's Textarea in a hairline card with an icon-button row, the
    // nearest of the composer looks (cmux #46738).
    // "agentPane.composerLook": "studio",
    // Pending: the sidebar itself as shadcn's sidebar-07 (cmux #46805).
    // "sidebar.look": "...",
    "sidebar.density": "compact",
    "sidebar.groupBy": "folder",
    "sidebar.groupHeader.background": "sections",
    "sidebar.groupHeader.memberCount": false,
    "sidebar.showTimestamps": false,
    "sidebar.workspaceRow.icon": true,
    "sidebar.workspaceRow.directory": false,
    "sidebar.workspaceRow.branch": true,
    "sidebar.workspaceRow.lastActivity": false,
    "sidebar.workspaceRow.pullRequest": false,
    "sidebar.workspaceRow.agentStatus": false,
    "sidebar.workspaceRow.tabCount": false,
    "sidebar.workspaceRow.ports": false,
    "sidebar.hoverCards.delay": 700,
    "browser.omnibar.cornerRadius": 8,
    "browser.omnibar.shadow": false,
    "browser.omnibar.height": 36,
    "browser.omnibar.fontSize": 14,
    "browser.omnibar.backgroundOpacity": 1
  }
}
