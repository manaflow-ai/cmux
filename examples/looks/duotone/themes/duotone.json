// Duotone (Light, the default). Two tones of one neutral gray: the work (OKLCH L 1.0, #ffffff) and
// the chrome (L 0.97, #f5f5f5). The work is the lit one. Ink #161616 (16.6:1 on the chrome),
// secondary ink #555555 (6.8:1), marks #696969 (5.0:1); every figure is measured on the chrome,
// the worse tone for dark ink.
{
  "name": "Duotone",
  "description": "Two light grays, no color.",

  "appearance.theme": "Builtin Light",
  "appearance.appTheme": "followTerminal",
  // background: the work tone. foreground: the ink. selection: the terminal's text selection, the
  // one blue (with the cursor below). There is no accent colour: the accent is neutral, so the
  // selected row, focus and Send draw in the ink, never in a hue.
  "colors": { "background": "#ffffff", "foreground": "#161616", "selection": "#d5e2fb" },
  "appearance.accent": "neutral",
  "ghostty": [
    "background = #ffffff",
    "foreground = #161616",
    "cursor-color = #2f62d8",
    "cursor-text = #ffffff",
    "selection-background = #d5e2fb",
    "selection-foreground = #161616",
    "palette = 0=#1c1c1c",
    "palette = 1=#a8483c",
    "palette = 2=#02763b",
    "palette = 3=#7c6301",
    "palette = 4=#3c64b1",
    "palette = 5=#954b8c",
    "palette = 6=#08717a",
    "palette = 7=#686b73",
    "palette = 8=#80848c",
    "palette = 9=#b84a2f",
    "palette = 10=#017d4d",
    "palette = 11=#846a00",
    "palette = 12=#4a67c5",
    "palette = 13=#a84a91",
    "palette = 14=#087887",
    "palette = 15=#8b8d91"
  ],
  "terminal.fontSize": 13,

  // Material: opaque. The chrome tone is a shade over the window's ground, so its step is only a
  // fixed number when the ground is fixed. Over glass the same shade drew a step that changed with
  // the wallpaper; pinning the ground is what makes this one constant.
  "appearance.background": "none",
  "appearance.backgroundBlur": "none",
  "appearance.backgroundOpacity": 1,
  "appearance.wallpaperTint": false,

  // The two tones. The work is #ffffff; the chrome around it (sidebar, toolbar, tab strip) is
  // #f5f5f5: 0.03 lower in OKLCH lightness, same hue, no chroma. Title area contrast 1.75 is
  // the value that draws exactly that step over this ground. The selected tab takes the work tone
  // and runs into the pane through filleted corners (flush-goo).
  "appearance.cornerFlush": "flush-goo",
  "appearance.titleAreaTone": "subtleTone",
  "appearance.titleAreaContrast": 1.75,
  "appearance.twoTone": "off",
  "appearance.focusIndicator": "tabs",
  "appearance.density": "cozy",

  // A line separates neighbours of the same tone (two panes side by side); the tone step separates
  // chrome from work. Never both: no line where the sidebar meets the pane.
  "sidebar.border": false,
  "appearance.surfaces.splitDivider.color": "#d7d7d7",
  "appearance.surfaces.splitDivider.opacity": 1,

  // Every work surface on the work tone, opaque: the chat, terminal, files, diffs, pages.
  "appearance.surfaces.agentPane.color": "#ffffff",
  "appearance.surfaces.agentPane.opacity": 1,
  "appearance.surfaces.terminal.color": "#ffffff",
  "appearance.surfaces.terminal.opacity": 1,
  "appearance.surfaces.editor.color": "#ffffff",
  "appearance.surfaces.editor.opacity": 1,
  "appearance.surfaces.diff.color": "#ffffff",
  "appearance.surfaces.diff.opacity": 1,
  "appearance.surfaces.markdown.color": "#ffffff",
  "appearance.surfaces.markdown.opacity": 1,
  "appearance.surfaces.settings.color": "#ffffff",
  "appearance.surfaces.settings.opacity": 1,
  "appearance.surfaces.internalPage.color": "#ffffff",
  "appearance.surfaces.internalPage.opacity": 1,
  "appearance.surfaces.newTabPage.color": "#ffffff",
  "appearance.surfaces.newTabPage.opacity": 1,
  "appearance.surfaces.home.color": "#ffffff",
  "appearance.surfaces.home.opacity": 1,
  // Docks are chrome: they hold tools, not the work.
  "appearance.surfaces.docks.color": "#f5f5f5",
  "appearance.surfaces.docks.opacity": 1,
  // The sidebar and the tab bar are chrome too. Naming the tone outright, as well as shading the
  // title area above, is what makes a preview that does not draw the shade still show the step.
  "appearance.surfaces.sidebar.color": "#f5f5f5",
  "appearance.surfaces.sidebar.opacity": 1,
  "appearance.surfaces.tabBar.color": "#f5f5f5",
  "appearance.surfaces.tabBar.opacity": 1,

  // The proportion ladder, at a row height H of 28: strip and toolbar H + 2 x 6 = 40, the sidebar
  // 9 H = 252, type 13, a 6 gutter (the row's own inset), a 1 divider.
  "appearance.metrics.titlebarHeight": 40,
  "appearance.metrics.tabStripHeight": 40,
  "appearance.metrics.tabFontSize": 13,
  "appearance.metrics.sidebarWidth": 252,
  "appearance.metrics.sidebarRowHeight": 28,
  "appearance.metrics.chromeFontSize": 13,
  "appearance.metrics.columnGap": 6,
  "appearance.metrics.dividerThickness": 1,

  "browser.omnibar.glass": "off",

  // Motion: a tone change blends in lightness only, quickly.
  "appearance.colorTransition.enabled": true,
  "appearance.colorTransition.duration": 120,
  "appearance.colorTransition.curve": "easeOut",
  "appearance.colorTransition.colorSpace": "oklab",
  "appearance.colorTransition.reduceMotion": "crossfade"

  // Pending cmux#46861 (row proportions): the row's inset is (H - icon) / 2 = 6 on the leading,
  // top and bottom sides, the icon to label gap is the same 6, and a toolbar button is one row
  // height square with the control corner. Uncomment once your build has it.
  // "appearance.metrics.sidebarRowInset": 6,
  // "appearance.metrics.sidebarRowPadding": 6,
  // "appearance.metrics.sidebarRowGap": 0,
  // "appearance.metrics.toolbarButtonSize": 28,
  // "appearance.metrics.toolbarButtonGap": 6,
  // "appearance.metrics.toolbarButtonCornerRadius": 8,
  // "appearance.metrics.composerPadding": 12,
  // "appearance.metrics.composerMinHeight": 40
}
