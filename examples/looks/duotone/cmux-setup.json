{
  "cmuxSetup": 1,
  "id": "manaflow-ai/duotone-look",
  "name": "Duotone",
  "tagline": "Two shades of gray and nothing else.",
  "description": "Just two shades of gray, one for the window and one for your work. The selected row stays gray instead of taking a color. Light and dark. Remove it and everything you had comes back.",
  "version": "0.2.0",
  "license": "MIT",
  "repository": "https://github.com/manaflow-ai/cmux",
  "screenshots": [],

  "cmuxProfile": 1,
  "settings": {
    "appearance.themeFile": "duotone",

    // The reading column: 27 row heights (27 x 28 = 756), three times the sidebar (9 x 28 = 252).
    "agentPane.display.width": 756,

    // The sidebar: one line per row at the row height the theme files set.
    "sidebar.workspaceRow.icon": true,
    // Diffs and sidebar group colors from the theme's own palette.
    "diff.colors": "theme",
    "sidebar.groupPalette": "theme",

    // The address field takes the control corner (2/7 of the row height).
    "browser.omnibar.cornerRadius": 8

    // Pending cmux#46780: the tab shape. Duotone's tab is the gooey one, and with that change the
    // selected sidebar row runs into the pane the same way. Uncomment once your build has it.
    // "appearance.tabShape": "gooey",
    // Pending cmux#46516: the selected row's own setting. Until then the theme files set a neutral
    // accent, which draws the selected row in the ink at low strength.
    // "appearance.selection": "neutral"
  }
}
