// Prism: a browser-as-sidebar look in Light. The window is a frame tinted in one bright "space"
// color (a pale lavender here) that holds the rows vertically, the work sits in one borderless white
// card inset into that frame, an indigo-blue accent does selection, focus, Send and links, and
// motion is a quick, slightly bouncy spring. Its twin is Prism Dark.
{
  "name": "Prism",
  "description": "Light: a pale lavender frame around a white card, an indigo accent.",

  "appearance.theme": "Builtin Light",
  "appearance.appTheme": "followTerminal",
  // background: the card's white. foreground: an ink with a violet cast so text sits in the frame's
  // family. selection: the accent at 18% over white. accent: the indigo-blue of the look's primary
  // buttons and radio fills.
  "colors": { "background": "#ffffff", "foreground": "#1f1d2b", "selection": "#d9dbfe", "accent": "#3139fb" },
  "appearance.accent": "theme",
  // The terminal: the page and ink above, the cursor in the accent, the selection, and all sixteen
  // ANSI colors at a vivid, cool chroma, each solved in OKLCH over the page (5.2:1, the bright ones
  // 4.7:1, 7 the gray 4.8:1, 15 3:1; 8, the dim gray, 3.4:1).
  "ghostty": [
    "background = #ffffff",
    "foreground = #1f1d2b",
    "cursor-color = #3139fb",
    "cursor-text = #ffffff",
    "selection-background = #d9dbfe",
    "selection-foreground = #1f1d2b",
    "palette = 0=#1f1d2b",
    "palette = 1=#c23c49",
    "palette = 2=#137e08",
    "palette = 3=#8d6603",
    "palette = 4=#056ec4",
    "palette = 5=#9f49ad",
    "palette = 6=#077979",
    "palette = 7=#6d7279",
    "palette = 8=#868b92",
    "palette = 9=#d6373a",
    "palette = 10=#058635",
    "palette = 11=#956c07",
    "palette = 12=#166fe5",
    "palette = 13=#b544b4",
    "palette = 14=#098086",
    "palette = 15=#939599"
  ],
  // The terminal face: SF Mono at 13 pt, the system's monospaced face under the bright frame.
  "terminal.fontFamily": "SF Mono",
  "terminal.fontSize": 13,
  // A little extra color in the tint, as the frame is meant to be loud and the card quiet.
  "appearance.saturation": 1.15,

  // Material: behind-window glass shows through the frame only, taking the desktop's colors, so
  // the space color reads as a tinted gradient rather than a flat fill.
  "appearance.background": "none",
  "appearance.backgroundBlur": "glass",
  "appearance.backgroundOpacity": 0.55,
  "appearance.glassTransparency": 0.3,
  "appearance.wallpaperTint": true,
  "appearance.fontSmoothing": "antialiased",

  // Layout: one borderless card inset into the colored frame on every side, no hairlines (the card
  // edge against the frame is the only line), the frame shaded apart from the card.
  "appearance.chromeStyle": "card",
  "appearance.borders": "none",
  "appearance.titleAreaTone": "subtleTone",
  "appearance.focusIndicator": "tabs",
  "appearance.density": "comfortable",
  // Pending cmux#46780: the rows-as-tabs are soft rounded pills.
  // "appearance.tabShape": "rounded",
  // Pending cmux#46516: the selected row is a white lift on the frame, not an accent fill.
  // "appearance.selection": "neutral",

  // Proportions, measured from the source captures: a 40 pt top band (window buttons and the
  // back, forward and reload row), a 216 pt sidebar with 32 pt rows (a hovered row is 64 px at
  // 2x), 13 pt chrome text, an 8 pt frame around the card, no split divider (the frame is the gap).
  "appearance.metrics.titlebarHeight": 40,
  "appearance.metrics.sidebarWidth": 216,
  "appearance.metrics.sidebarRowHeight": 32,
  "appearance.metrics.chromeFontSize": 13,
  "appearance.metrics.tabStripHeight": 32,
  "appearance.metrics.tabFontSize": 12,
  "appearance.metrics.tabMaxWidth": 240,
  "appearance.metrics.tabMinActiveWidth": 120,
  "appearance.metrics.tabMinInactiveWidth": 80,
  "appearance.metrics.columnGap": 8,
  "appearance.metrics.dividerThickness": 0,

  // The frame: the space color, a little translucent so the desktop tints it, no edge line, and
  // hairline-separated sections (pinned above, today below). The lavender is pale (#fffdff): the app
  // fits its muted inks to the white page, so the deeper #d4ccfb left the sidebar captions under
  // 4.5:1 (`cmux theme check`).
  "appearance.sidebarSurface": "separate",
  "appearance.surfaces.sidebar.color": "#fffdff",
  "appearance.surfaces.sidebar.opacity": 0.86,
  "sidebar.style": "standard",
  "sidebar.border": false,
  "sidebar.sectionLook": "lines",

  // The card: pure white; the tab strip a pale wash of the frame color so it reads as the card's
  // own top edge; toolbar, docks and the browser's bar one step under white with the same cast.
  "appearance.surfaces.agentPane.color": "#ffffff",
  "appearance.surfaces.agentPane.opacity": 1,
  "appearance.surfaces.tabBar.color": "#e6e1fd",
  "appearance.surfaces.tabBar.opacity": 1,
  "appearance.surfaces.browserChrome.color": "#f5f3ff",
  "appearance.surfaces.browserChrome.opacity": 1,
  "appearance.surfaces.docks.color": "#f5f3ff",
  "appearance.surfaces.docks.opacity": 1,
  "appearance.surfaces.editor.color": "#ffffff",
  "appearance.surfaces.editor.opacity": 1,
  "appearance.surfaces.diff.color": "#ffffff",
  "appearance.surfaces.diff.opacity": 1,
  "appearance.surfaces.markdown.color": "#ffffff",
  "appearance.surfaces.markdown.opacity": 1,
  "appearance.surfaces.splitDivider.color": "#fffdff",
  "appearance.surfaces.splitDivider.opacity": 1,

  // Settings and pages: the onboarding pages' white card over a pale wash of the space color.
  "appearance.surfaces.settings.color": "#f2effe",
  "appearance.surfaces.settings.opacity": 1,
  "appearance.surfaces.internalPage.color": "#f2effe",
  "appearance.surfaces.internalPage.opacity": 1,
  "appearance.surfaces.newTabPage.color": "#f2effe",
  "appearance.surfaces.newTabPage.opacity": 1,
  "appearance.surfaces.home.color": "#f2effe",
  "appearance.surfaces.home.opacity": 1,

  // Status: a spinning arc on the row while work runs, and on the tab too.
  "appearance.statusIndicator.style": "arc",
  "appearance.statusIndicator.animation": "animated",
  "appearance.statusIndicator.showAgentWorkingOnTabs": true,

  // The command bar floats as a glass panel tinted by the accent.
  "browser.omnibar.glass": "regular",
  "browser.omnibar.glassTint": "accent",
  "browser.omnibar.glassTintStrength": 0.15,

  // Motion: playful. A fast spring with a little overshoot (damping under 1) for color changes,
  // so switching spaces swings the frame's color rather than fading it.
  "ui.animationSpeed": "normal",
  "appearance.colorTransition.enabled": true,
  "appearance.colorTransition.curve": "spring",
  "appearance.colorTransition.springResponse": 0.45,
  "appearance.colorTransition.springDamping": 0.75,
  "appearance.colorTransition.colorSpace": "oklab",
  "appearance.colorTransition.reduceMotion": "crossfade"

  // Pending cmux#46861 (layout and proportions): a browser sidebar: rows nearly edge to edge (4 pt inset) with 8 pt corners, 28 pt toolbar buttons with an 8 pt rounded fill, no toolbar hairline, a 44 pt command-bar composer. Uncomment once your build has it.
  // "appearance.metrics.sidebarRowHeightWithSubtitle": 48,
  // "appearance.metrics.sidebarRowInset": 4,
  // "appearance.metrics.sidebarRowPadding": 10,
  // "appearance.metrics.sidebarRowGap": 2,
  // "appearance.metrics.toolbarButtonSize": 28,
  // "appearance.metrics.toolbarButtonGap": 4,
  // "appearance.metrics.toolbarButtonCornerRadius": 8,
  // "appearance.metrics.toolbarButtonActiveFill": 0.12,
  // "appearance.metrics.headerDivider": 0,
  // "appearance.metrics.composerPadding": 12,
  // "appearance.metrics.composerMinHeight": 44,
  // "appearance.metrics.spacingScale": 1,
}
