{
  "$schema": "https://cmux.dev/schemas/cmux-app/2.json",
  "manifestVersion": 2,
  "id": "local/customize",
  "name": {
    "en": "Open in editor"
  },
  "description": "Open the tab's folder in your editor.",
  "version": "1.0.0",
  "engines": {
    "cmux": "^2.0"
  },
  "runtime": {
    "main": "main.js"
  },
  "implements": {
    "cmux.session.info.section/1": {
      "export": "renderEditor",
      "title": "Open in editor",
      "symbol": "chevron.left.forwardslash.chevron.right"
    }
  },
  "scopes": {
    "actions:run": "Open the selected local working folder in its editor."
  },
  "activation": [
    "onInterface:cmux.session.info.section/1"
  ],
  "files": [
    "main.js"
  ]
}
