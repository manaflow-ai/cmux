// The app's keyboard flows on cmux actions. Each key is scoped to the chat (agentPaneFocused), so a
// terminal keeps cmux's own Command-K (clear), Command-D (split right) and Command-J chords.
[
  // Command palette on Command-K. Chat search (cmux puts it on Command-K) is the sidebar's Search row.
  { "key": "cmd+k", "command": "commandPalette", "when": "agentPaneFocused" },
  // Terminal drawer: cmux's quick terminal shows and hides on the same key.
  { "key": "cmd+j", "command": "toggleQuickTerminal", "when": "agentPaneFocused" },
  // Diff beside the chat.
  { "key": "cmd+d", "command": "openDiffViewer", "when": "agentPaneFocused" },
  // Preview beside the chat.
  { "key": "cmd+shift+j", "command": "agentPane.togglePreview", "when": "agentPaneFocused" },
  // New thread.
  { "key": "cmd+n", "command": "palette.newAgentChat" },
  { "key": "cmd+shift+o", "command": "palette.newAgentChat" },
  // Composer chords: model, effort, access, worktree, host.
  { "key": "cmd+shift+m", "command": "agentPane.switchModel", "when": "agentPaneFocused" },
  { "key": "cmd+shift+e", "command": "agentPane.setEffort", "when": "agentPaneFocused" },
  { "key": "cmd+shift+a", "command": "agentPane.composer.switchMode", "when": "agentPaneFocused" },
  { "key": "cmd+shift+x", "command": "agentPane.composer.chooseFolder", "when": "agentPaneFocused" },
  { "key": "cmd+shift+h", "command": "agentPane.composer.chooseComputer", "when": "agentPaneFocused" },
  // Previous and next thread; Command-1 to 9 already jump.
  { "key": "cmd+shift+leftbracket", "command": "prevSidebarTab" },
  { "key": "cmd+shift+rightbracket", "command": "nextSidebarTab" },
  // Settle a finished thread, pin a thread.
  { "key": "cmd+shift+s", "command": "markWorkspaceDone", "when": "agentPaneFocused" },
  { "key": "cmd+shift+p", "command": "palette.toggleTabPin", "when": "agentPaneFocused" },
  // Dictation.
  { "key": "cmd+shift+d", "command": "palette.toggleDictation", "when": "agentPaneFocused" },
  // Usage: the context meter is the nearest cmux has to the app's usage page.
  { "key": "cmd+u", "command": "agentPane.composer.showContextUsage", "when": "agentPaneFocused" },
  // Keyboard shortcuts.
  { "key": "cmd+slash", "command": "palette.searchShortcuts" }
]
