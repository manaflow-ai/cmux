{
  "$schema": "https://cmux.dev/schemas/cmux-app/2.json",
  "manifestVersion": 2,
  "id": "local/customize",
  "name": {
    "en": "Model and reasoning picker"
  },
  "version": "1.0.0",
  "description": "Choose a model, its reasoning effort and the available service tier from the composer.",
  "engines": {
    "cmux": "^2.0"
  },
  "implements": {
    "cmux.composer.model.picker/1": {
      "options": {
        "modelMenu": "search",
        "reasoningMenu": "column"
      }
    }
  }
}
