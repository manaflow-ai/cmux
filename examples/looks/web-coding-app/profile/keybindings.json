// The web coding app's keys. Command-N was New Workspace and stays in the Command Palette.
// `cmux customize discard` puts your own keys back.
[
  { "key": "cmd+n", "command": "palette.newAgentChat" },
  { "key": "cmd+shift+leftbracket", "command": "prevSidebarTab", "args": { "scope": "workspaces" } },
  { "key": "cmd+shift+rightbracket", "command": "nextSidebarTab", "args": { "scope": "workspaces" } },
  // Sessions are workspaces in this profile, so reopening a closed session reopens its workspace.
  { "key": "cmd+shift+t", "command": "reopenClosedWorkspace" },
  { "key": "cmd+shift+u", "command": "jumpToUnread" },
  { "key": "ctrl+shift+m", "command": "agentPane.switchModel" },
  { "key": "ctrl+shift+e", "command": "agentPane.setEffort" },
  { "key": "ctrl+shift+a", "command": "agentPane.setMode" },
  { "key": "cmd+slash", "command": "palette.searchShortcuts" }
]
