{
  "cmuxSetup": 1,
  "id": "manaflow-ai/broadsheet-look",
  "name": "Broadsheet",
  "tagline": "Large text in a narrow column.",
  "description": "Large text in a narrow column.",
  "version": "0.2.0",
  "license": "MIT",
  "repository": "https://github.com/manaflow-ai/cmux/tree/feat-cmux-next/examples/looks/broadsheet",
  "screenshots": ["screenshots/broadsheet-light.png", "screenshots/broadsheet-dark.png"],

  "cmuxProfile": 1,
  "settings": {
    "appearance.themeFile": "broadsheet",

    // The reading voice: the system sans at 16 px on a 24 px line (1.5, six 4 px baseline units).
    // 16 is one step above the chrome's 13 on the scale (13 x 1.2 = 15.6); the default is 14 px
    // on a 22.75 px line, which sits on no grid.
    "agentPane.display.font.ui": "system-ui",
    "agentPane.display.font.preset": "system",
    "agentPane.display.font.size": 16,
    "agentPane.display.font.lineHeight": 1.5,
    // The code voice: 13 px (0.8125 of 16), the chrome's size. Its line follows the reading
    // text's ratio (21.67 px as measured), which a look cannot set apart.
    "agentPane.display.code.scale": 0.8125,
    // The measure: a 560 px column, 72 characters of 16 px text a line as measured
    // (the default 800 px column at 14 px measures 123). The one width holds code and
    // diffs too; a look cannot give them a wider column.
    "agentPane.display.width": 560,

    // The Markdown viewer in the same hand: 16 px on a 24 px line, code at 13 px, a 70-character column.
    "markdown.font.preset": "system",
    "markdown.font.size": 16,
    "markdown.font.lineHeight": 1.5,
    "markdown.code.scale": 0.8125,
    "markdown.layout.width": 70,

    // Sidebar groups are separated by a hairline and a larger gap, never by a card.
    "sidebar.sectionLook": "lines",

    // The address field: a 6 px corner (the tab's), no shadow.
    "browser.omnibar.cornerRadius": 6,
    "browser.omnibar.shadow": false
  }
}
