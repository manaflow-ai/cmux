// Paper: warm paper and ink with a sepia accent; in dark, the same ink and sepia on a lamp-lit
// brown page. No wallpaper; a soft sidebar beside the page.
{
  "name": "Paper",
  "description": "Warm paper, ink text and a sepia accent, in light and dark.",

  // The terminal theme on each side, and its own colors there.
  "appearance.theme": "light:Builtin Light,dark:Builtin Dark",
  // The window, sidebar and pages take that theme too, over an App Theme of your own.
  "appearance.appTheme": "followTerminal",
  "appearance.themeEdits": {
    "Builtin Light/background": "#faf8f3",
    "Builtin Light/foreground": "#2d2a26",
    "Builtin Light/selection": "#e8e1d3",
    "Builtin Light/accent": "#8a5a2b",
    "Builtin Dark/background": "#1e1b17",
    "Builtin Dark/foreground": "#ebe4d6",
    "Builtin Dark/selection": "#3b342b",
    "Builtin Dark/accent": "#d9a66b"
  },
  "appearance.accent": "theme",

  "appearance.background": "none",
  "appearance.borders": "none",
  "appearance.chromeStyle": "flat",

  // The sidebar and chat are the theme's own page on each side.
  "appearance.sidebarSurface": "separate",
  "sidebar.sectionLook": "quiet",
  "appearance.statusIndicator.style": "arc",

  "appearance.density": "comfortable"
}
