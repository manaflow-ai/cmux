{
  "cmuxSetup": 1,
  "id": "manaflow-ai/lamina-look",
  "name": "Lamina",
  "tagline": "Frosted glass layers, compact rows.",
  "description": "Frosted glass layers, compact rows.",
  "version": "1.0.0",
  "license": "MIT",
  "screenshots": ["screenshots/lamina-dark.png", "screenshots/lamina-light.png"],

  "cmuxProfile": 1,
  "settings": {
    // Lamina (dark) is the default; lamina-light is the light twin.
    "appearance.themeFile": "lamina",

    // Panes: cards, 4 point padding, the dark layer's one-point line as their stroke.
    "layout.paneSeparation": "cards",
    "layout.panePadding": 4,
    "layout.paneBorderColor": "#3a3a3a",

    // The sidebar: threads grouped by folder, each with its age; no tip cards.
    "sidebar.groupBy": "folder",
    "sidebar.showTimestamps": true,
    "sidebar.cards.tips": false,

    // The chat: a 900 px column, no minimap, the changed files folded under each turn.
    "agentPane.display.width": 900,
    "agentPane.display.minimap": "off",
    "agentPane.editedFiles.show": "collapsed",

    // The toast: flat, an opaque surface with a thin edge and no shadow, not a glass pill.
    "notifications.toast.style": "flat"
  }
}
