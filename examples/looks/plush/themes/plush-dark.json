// Plush Dark: the Plush look in Dark.
// One cool blue-gray clay surface everywhere; panes are soft raised cards on it, set apart by an even
// 10 pt gap, 16 pt corners and a breath of shade instead of lines. No borders, no glass, no wallpaper. The
// type is a low-contrast ink (6.74:1 over the page, above the 4.5:1 floor) and the one saturated
// accent (#8d95ff) marks focus, Send, links and the working dot. ANSI colors are solved in OKLCH
// at one lightness over the page (every hue at least 5.2:1). An opt-in look: nothing changes
// until you pick it.
{
  "name": "Plush Dark",
  "description": "Dark blue-gray, raised panels.",
  "appearance.theme": "Builtin Dark",
  "appearance.appTheme": "followTerminal",
  "colors": {
    "background": "#2a2f37",
    "foreground": "#b0b8c6",
    "selection": "#6c75ac",
    "accent": "#8d95ff"
  },
  "appearance.accent": "theme",
