    "background = #2a2f37",
    "foreground = #b0b8c6",
    "cursor-color = #8d95ff",
    "cursor-text = #2a2f37",
    "selection-background = #6c75ac",
    "selection-foreground = #2a2f37",
    "palette = 0=#464e58",
