// Tandem Dark: the agent workspace at night. You and your agents work side by side in one window:
// a warm near-black workspace in a rounded card beside an opaque warm-gray sidebar that lists every
// chat and tab as one line with its age, sheets a step lighter for Settings and pages, soft warm
// ink, and the same orange for what the agent may do on its own. Colors are sampled from the
// references' pixels (README, References): the workspace #141110, the sidebar #1B1918, the
// selected row #272523, the ink #EAE8E6, the secondary ink #A4A09D, a prompt warmed toward the
// accent (#271E1D sampled).
{
  "name": "Tandem Dark",
  "description": "An agent workspace, Dark: a warm near-black card, a warm-gray sidebar of chats and tabs, an orange policy accent.",

  // The terminal follows the workspace; the window, sidebar and pages take this theme.
  "appearance.theme": "Builtin Dark",
  "appearance.appTheme": "followTerminal",
  // background: the warm near-black (#141110 sampled). foreground: the ink (#EAE8E6 sampled).
  // selection: the orange at about 25% over the workspace. accent: the policy orange, brighter.
  "colors": { "background": "#141110", "foreground": "#eae8e6", "selection": "#4d2c18", "accent": "#ec6420" },
  "appearance.accent": "theme",
  // The terminal: the page and ink above, the cursor in the accent, the selection, and all sixteen
  // ANSI colors at a warm chroma, each solved in OKLCH over the page (5.5:1, the bright ones 8.5:1;
  // 0 the raised black 2:1; 8, the dim gray, 3.4:1).
  "ghostty": [
    "background = #141110",
    "foreground = #eae8e6",
    "cursor-color = #ec6420",
    "cursor-text = #141110",
    "selection-background = #4d2c18",
    "selection-foreground = #eae8e6",
    "palette = 0=#43474d",
    "palette = 1=#d36e60",
    "palette = 2=#3d9d5e",
    "palette = 3=#a78801",
    "palette = 4=#608adb",
    "palette = 5=#be70b3",
    "palette = 6=#039aa5",
    "palette = 7=#eae8e6",
    "palette = 8=#65696f",
    "palette = 9=#ff9075",
    "palette = 10=#3ec584",
    "palette = 11=#d1ab17",
    "palette = 12=#8eadff",
    "palette = 13=#f18dd5",
    "palette = 14=#03c0d7",
    "palette = 15=#e4e6e8"
  ],
  // The terminal face: SF Mono at 13 pt, the system's monospaced face beside Inter.
  "terminal.fontFamily": "SF Mono",
  "terminal.fontSize": 13,

  // Material: opaque, as the workspace app draws it at night.
  "appearance.background": "none",
  "appearance.backgroundBlur": "none",
  "appearance.backgroundOpacity": 1,
  "appearance.wallpaperTint": false,
  "appearance.fontSmoothing": "antialiased",

  // Layout: the workspace sits in one rounded card beside the sidebar with a thin gutter (6 pt at
  // the right and bottom, sampled), no line where the sidebar meets it; the toolbar in the
  // workspace's own tone; the focused pane marked on its tab, as an underlined tab.
  "appearance.chromeStyle": "card",
  "appearance.borders": "default",
  "appearance.titleAreaTone": "oneColor",
  "appearance.focusIndicator": "tabs",
  "appearance.density": "cozy",
  // Pending cmux#46780: chat tabs are rounded capsules on the strip (the closest of block, rounded,
  // gooey; the underlined text tab itself has no shape yet).
  // "appearance.tabShape": "rounded",
  // Pending cmux#46516: the selected chat or tab is a raised row a step lighter (#272523 sampled), not an
  // accent capsule.
  // "appearance.selection": "neutral",

  // Proportions, measured from the references at their capture scale (1 pt per pixel in the 1440 pt
  // live window; half the pixels in the 2x workspace captures): a 42 pt toolbar, a 40 pt tab strip
  // with 13 pt titles in tabs about 160 pt wide, a 272 pt sidebar (280 and 254 in the two
  // references) with 32 pt rows, 13 pt chrome text, a 6 pt gutter around the card and a 1 pt divider.
  "appearance.metrics.titlebarHeight": 42,
  "appearance.metrics.tabStripHeight": 40,
  "appearance.metrics.tabFontSize": 13,
  "appearance.metrics.tabMaxWidth": 180,
  "appearance.metrics.tabMinActiveWidth": 140,
  "appearance.metrics.tabMinInactiveWidth": 100,
  "appearance.metrics.sidebarWidth": 272,
  "appearance.metrics.sidebarRowHeight": 32,
  "appearance.metrics.chromeFontSize": 13,
  "appearance.metrics.columnGap": 6,
  "appearance.metrics.dividerThickness": 1,

  // The sidebar: a warm gray a step over the workspace, opaque, no edge line; quiet gray
  // section headings ("Pinned", "Chats", "Tabs") over hairline breaks.
  "appearance.sidebarSurface": "separate",
  "appearance.surfaces.sidebar.color": "#1d1b1a",
  "appearance.surfaces.sidebar.opacity": 1,
  "sidebar.style": "standard",
  "sidebar.border": false,
  "sidebar.sectionLook": "lines",

  // The workspace: the chat, tab strip, toolbar, terminal, files and diffs on the near-black (the
  // tab strip in the chat's own tone, under an underlined tab); docks a step lighter.
  "appearance.surfaces.agentPane.color": "#141110",
  "appearance.surfaces.agentPane.opacity": 1,
  "appearance.surfaces.tabBar.color": "#141110",
  "appearance.surfaces.tabBar.opacity": 1,
  "appearance.surfaces.browserChrome.color": "#141110",
  "appearance.surfaces.browserChrome.opacity": 1,
  "appearance.surfaces.terminal.color": "#141110",
  "appearance.surfaces.terminal.opacity": 1,
  "appearance.surfaces.docks.color": "#1b1918",
  "appearance.surfaces.docks.opacity": 1,
  "appearance.surfaces.editor.color": "#141110",
  "appearance.surfaces.editor.opacity": 1,
  "appearance.surfaces.diff.color": "#141110",
  "appearance.surfaces.diff.opacity": 1,
  "appearance.surfaces.markdown.color": "#141110",
  "appearance.surfaces.markdown.opacity": 1,
  // The divider: a warm hairline a step over the sidebar.
  "appearance.surfaces.splitDivider.color": "#2c2927",
  "appearance.surfaces.splitDivider.opacity": 1,

  // Settings and pages: sheets a step over the workspace (#1B1918, the sidebar's sampled tone);
  // New Tab and Home on the workspace itself.
  "appearance.surfaces.settings.color": "#1b1918",
  "appearance.surfaces.settings.opacity": 1,
  "appearance.surfaces.internalPage.color": "#1b1918",
  "appearance.surfaces.internalPage.opacity": 1,
  "appearance.surfaces.newTabPage.color": "#141110",
  "appearance.surfaces.newTabPage.opacity": 1,
  "appearance.surfaces.home.color": "#141110",
  "appearance.surfaces.home.opacity": 1,

  // Status: the dotted loader beside a working tab and in its row, on tabs too.
  "appearance.statusIndicator.style": "braille",
  "appearance.statusIndicator.animation": "animated",
  "appearance.statusIndicator.showAgentWorkingOnTabs": true,
  "appearance.statusIndicator.showPageLoading": true,

  // The address field: plain in the toolbar; it opens into an elevated suggestion sheet.
  "browser.omnibar.glass": "off",

  // Motion: modest. Controls arrive and the page reflows at the standard speed; colors blend over
  // a short ease-in-out.
  "ui.animationSpeed": "normal",
  "appearance.colorTransition.enabled": true,
  "appearance.colorTransition.duration": 200,
  "appearance.colorTransition.curve": "easeInOut",
  "appearance.colorTransition.colorSpace": "oklab",
  "appearance.colorTransition.reduceMotion": "crossfade"

  // Pending cmux#46861 (layout and proportions): an agent workspace: rows inset 8 pt with 8 pt
  // padding and a 4 pt gap (a 32 pt row on a 36 pt pitch), a 50 pt row with a subtitle line, 28 pt
  // toolbar buttons with an 8 pt corner, a hairline under the toolbar, and the composer as a 44 pt
  // capsule. Uncomment once your build has it.
  // "appearance.metrics.sidebarRowHeightWithSubtitle": 50,
  // "appearance.metrics.sidebarRowInset": 8,
  // "appearance.metrics.sidebarRowPadding": 8,
  // "appearance.metrics.sidebarRowGap": 4,
  // "appearance.metrics.toolbarButtonSize": 28,
  // "appearance.metrics.toolbarButtonGap": 8,
  // "appearance.metrics.toolbarButtonCornerRadius": 8,
  // "appearance.metrics.toolbarButtonActiveFill": 0.08,
  // "appearance.metrics.headerDivider": 1,
  // "appearance.metrics.composerPadding": 12,
  // "appearance.metrics.composerMinHeight": 44,
  // "appearance.metrics.spacingScale": 1,
}
