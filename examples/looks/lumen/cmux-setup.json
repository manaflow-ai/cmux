{
  "cmuxSetup": 1,
  "id": "manaflow-ai/lumen-look",
  "name": "Lumen",
  "tagline": "Light glass over your wallpaper, with a calm work area.",
  "description": "Neutral glass over your own wallpaper, with your work on a calm, solid area in the middle. Light and dark. Remove it and everything you had comes back.",
  "version": "0.2.0",
  "license": "MIT",
  "screenshots": ["screenshots/lumen-dark.png", "screenshots/lumen-light.png"],

  "cmuxProfile": 1,
  "settings": {
    "appearance.themeFile": "lumen",

    // Tool rows stay quiet: thoughts and tool calls at the normal level of detail. The chat's
    // fonts and sizes are left as they are: the type scale is the app's own.
    "agentPane.display.transcriptView": "normal",

    // The address field: corners on the same rule as the panes (8 pt), no shadow, since depth comes
    // from the material.
    "browser.omnibar.cornerRadius": 8,
    "browser.omnibar.shadow": false
  }
}
