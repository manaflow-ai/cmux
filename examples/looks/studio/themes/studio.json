// Studio: a low-contrast neutral workbench, near-black in dark and near-white in light. Neutral
// grays, a hairline between the sidebar and the chat, no wallpaper and no glass, so the transcript and
// the code read first.
{
  "name": "Studio",
  "description": "Neutral chrome in light and dark, a hairline sidebar edge, no wallpaper or glass.",

  // The terminal theme on each side, and its own colors there.
  "appearance.theme": "light:Builtin Light,dark:Builtin Dark",
  // The window, sidebar and pages take that theme too, over an App Theme of your own.
  "appearance.appTheme": "followTerminal",
  "appearance.themeEdits": {
    "Builtin Light/background": "#fafafa",
    "Builtin Light/foreground": "#18181b",
    "Builtin Light/selection": "#e4e4e7",
    "Builtin Light/accent": "#52525b",
    "Builtin Dark/background": "#0b0b0c",
    "Builtin Dark/foreground": "#e4e4e7",
    "Builtin Dark/selection": "#27272a",
    "Builtin Dark/accent": "#a1a1aa"
  },
  "appearance.accent": "neutral",

  "appearance.background": "none",
  "appearance.backgroundBlur": "none",
  "appearance.chromeStyle": "flat-sidebar-line",
  "appearance.borders": "default",

  // The sidebar and chat are the theme's own page on each side.
  "appearance.sidebarSurface": "separate",
  "sidebar.sectionLook": "lines",
  "appearance.statusIndicator.style": "dot",

  "appearance.density": "compact"
}
