{
  "cmuxSetup": 1,
  "id": "manaflow-ai/codex-send-parity",
  "name": "Reference send",
  "tagline": "Sent prompts rise, leaving room to reply.",
  "description": "Sent prompts rise, leaving room to reply.",
  "version": "1.0.0",
  "license": "MIT",
  "repository": "https://github.com/manaflow-ai/cmux",
  "screenshots": [],

  "cmuxProfile": 1,
  "settings": {
    // No entrance: on feat-cmux-next a sent prompt already lands in one frame (--cmux-motion-send 0ms),
    // so there is nothing to turn off today. Once cmux#50293 lands, pin it off:
    //   "agentPane.display.sendPop": "off"
    // Pending (no pull request yet): the send placement switch, "agentPane.sendPlacement": "top".
    // Values "bottom" (today's scroll to the end, the default) and "top" (the room-and-spring placement
    // in README.md). The nearest setting today, agentPane.scrollToBottomOnSend (toggle, default true),
    // only decides whether a send scrolls at all, and an agent may not set it (agent_settable false).
    // The builder new-chat page (customize/, cmux.newtab/1): "What should we build in {project}?",
    // the project a picker. It draws on the web New Tab page only, so that one is pinned.
    // Remove the setup, or `cmux settings reset tabs.newTabApp`, and cmux's own New Tab page is back.
    "tabs.newTabApp": "local/customize",
    "tabs.nativeNewTabPage": false
  }
}
