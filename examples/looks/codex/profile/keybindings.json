// The reference app's keys (the codex-app recipe). Shift-Command-O was Restore Previous App Launch;
// it stays in the Command Palette.
[
  { "key": "cmd+shift+o", "command": "palette.newAgentChat", "args": { "harness": "codex" } },
  { "key": "cmd+shift+e", "command": "agentPane.toggleFiles" },
  { "key": "ctrl+shift+g", "command": "openDiffViewer" },
  { "key": "ctrl+shift+m", "command": "agentPane.switchModel" },
  { "key": "cmd+shift+leftbracket", "command": "prevSidebarTab" },
  { "key": "cmd+shift+rightbracket", "command": "nextSidebarTab" },
  { "key": "cmd+slash", "command": "palette.searchShortcuts" }
]
