{
  "cmuxSetup": 1,
  "id": "manaflow-ai/codex-profile",
  "name": "Reference desktop agent app (whole)",
  "tagline": "The whole reference desktop coding agent app in one opt-in look: its colors and type, its wide calm sidebar, its round composer, its keys, its New Tab page and its motion.",
  "description": "Opt-in. One look built from the codex-app recipe and the four codex feature looks (composer, send-parity, sidebar, threads): the reference app's theme, system type at 12 pt, a 1200 pt transcript column, the round studio composer with circular icon buttons, a 340 pt sidebar of 11 pt one-line chats by project with a spinner or unread dot and Settled folding, a Chats section with New chat, Active work, Pinned, Projects, Recents, a sort and archive from a row, the thread hover card, the builder New Tab page (\"What should we build in {project}?\"), the app's keyboard shortcuts and fast, quiet motion. README.md lists every feature of the reference app and how this look matches it or which gap is left. Remove it and everything you had comes back.",
  "version": "1.0.0",
  "license": "MIT",
  "repository": "https://github.com/manaflow-ai/cmux",
  "screenshots": [],

  "cmuxProfile": 1,
  "settings": {
    // Colors and type (the codex-app recipe).
    "appearance.themeFile": "codex-app",
    "agentPane.display.presentation": "messages",
    "agentPane.display.font.preset": "system",
    "agentPane.display.font.ui": "system-ui",
    // Proportions (parity table, proportions): cmux's type read about 1.3x larger than the reference
    // app's in the sidebar and transcript, and the reference transcript column is wider.
    "agentPane.display.font.size": 12,
    "agentPane.display.width": 1200,
    // The transcript's parts (the reference app's thread): a right-aligned rounded bubble for your
    // messages, borderless cards with a 10 pt corner, no times. The width, face and size above win.
    "agentPane.display.transcriptTokens": {
      "density": "cozy",
      "userMessage.style": "bubble", "userMessage.align": "right", "userMessage.maxWidth": 0.75,
      "userMessage.radius": 10, "userMessage.paddingBlock": 7, "userMessage.paddingInline": 12,
      "userMessage.fill": 0.05,
      "toolCards": "minimal", "toolCard.radius": 10, "toolCard.border": "none", "codeCard.radius": 10,
      "timestamps": "off", "toolOutput.textSize": 0.92
    },
    "agentPane.display.minimap": "off",
    "agentPane.editedFiles.show": "collapsed",
    "agentPane.attachmentView": "strip",
    "diff.layout": "unified",
    "notifications.attention.agentChats": "ring",

    // Tabs: no tab strip for a lone chat; the diff viewer and chat search at the toolbar.
    "tabs.hideLoneChatTab": true,
    "tabs.toolbarButtons": ["openDiffViewer", "agentPane.searchChats"],

    // The composer (codex/composer): the prompt on its own line over the controls row.
    "agentPane.composerLook": "studio",
    // The empty message box's text, as in a Codex thread.
    "agentPane.composerPlaceholder": "Ask for follow-up changes",
    // The model picker (parity table, model_effort_picker): the reference app's chip opens a short list of
    // models with a check on the current one; the compact menu is that, with Effort as a submenu.
    "agentPane.display.modelPickerStyle": "menu",
    // One model/effort chip ("GPT-5.5  High"), as the Codex composer draws it: Studio would split the effort into its own chip.
    "agentPane.display.effortChip": "joined",

    // The sidebar (codex/sidebar): 340 pt, 36 pt rows, 11 pt text (14 / 1.3), one line per chat.
    "appearance.metrics.sidebarWidth": 340,
    "appearance.metrics.sidebarRowHeight": 36,
    "appearance.metrics.chromeFontSize": 11,
    "appearance.density": "comfortable",
    // Pending (Rust): "appearance.metrics.sidebarWidthMin": 240, "appearance.metrics.sidebarWidthMax": 520,
    // "appearance.metrics.sidebarRowCornerRadius": 10, "appearance.metrics.sidebarRowInset": 6,
    // "appearance.metrics.sidebarRowPadding": 10. The Chats section draws its rows at those numbers now.
    "sidebar.style": "standard",
    "sidebar.density": "comfortable",
    "sidebar.textSize": "default",
    "sidebar.groupBy": "folder",
    "sidebar.showTimestamps": true,
    "sidebar.detailedStatusIcons": false,
    "sidebar.showSpaces": false,
    "sidebar.cards.tips": false,
    "appearance.statusIndicator.style": "arc",
    "sidebar.controlsOnHover": true,
    // Account switching (parity table, account_switching): the reference app has one Personal row at the foot.
    // cmux drew that row mid-sidebar and a second avatar button at the foot, so the avatar goes.
    "sidebar.showProfileControl": false,
    "sidebar.groupHeader.memberCount": false,
    "sidebar.groupHeader.unreadCount": false,
    "sidebar.workspaceRow.icon": false,
    "sidebar.workspaceRow.directory": false,
    "sidebar.workspaceRow.branch": false,
    "sidebar.workspaceRow.lastActivity": false,
    "sidebar.workspaceRow.agentStatus": false,
    "sidebar.workspaceRow.pullRequest": false,
    "sidebar.workspaceRow.progress": false,
    "sidebar.workspaceRow.working": true,
    "sidebar.settleFinished": true,
    "sidebar.hoverCards.enabled": true,
    "sidebar.hoverCards.layout": "compact",
    // Pending (Rust): "sidebar.sortBy": "updated" and "sidebar.rowHoverAction": "archive" for the native list.

    // Sidebar sections (parity table, sidebar): the reference app draws New chat, Active work, Projects and
    // Recents, all from the Chats section in customize/. cmux's top section (Home, which draws as Chief, and the
    // App Store) goes; sections draw no header, so the Chats section has no "Chats" title over New chat; and a
    // chat with no folder sits at the end of the list with no "No Folder" header. The priority view is not
    // turned on: the Chats section's Active work lists the chats that are working or waiting on you.
    "sidebar.sections.hidden": ["sec_top"],
    "sidebar.sectionLook": "lines",
    "sidebar.folderlessUngrouped": true,
    // The Personal row at the sidebar's foot opens the account menu, as the Codex app's: who is signed in, the
    // teams to switch between, then Settings, Usage, Help and Sign Out.
    "sidebar.profileMenu.style": "account",

    // The New Tab page (codex/send-parity): the builder page from customize/.
    "tabs.newTabApp": "local/customize",
    "tabs.nativeNewTabPage": false,
    // Pending: "agentPane.display.sendPop": "off" (cmux#50293) and "agentPane.sendPlacement": "top"
    // (no pull request yet; the room-and-spring send in ../send-parity/README.md).

    // Motion. The look's durations and curves are the reference app's own, read from its shipped
    // stylesheets and motion module (agent-pane/theme.css; README.md, Motion). cmux's fast speed and
    // every animation stay on.
    // Its working line ("Working for 12s") shines one band half the line wide across it every 2 s.
    "agentPane.display.thinking.shimmer": "continuous",
    "agentPane.display.thinking.shimmerPeriod": 2000,
    "agentPane.display.thinking.shimmerBand": 0,
    "ui.animationSpeed": "fast",
    "ui.paneAnimations": true,
    "ui.animations.enabled": true
  }
}
