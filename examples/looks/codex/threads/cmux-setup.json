{
  "cmuxSetup": 1,
  "id": "manaflow-ai/codex-threads",
  "name": "Reference threads",
  "tagline": "Priority, Unreads and Archive views.",
  "description": "Priority, Unreads and Archive views of chats.",
  "version": "1.0.0",
  "license": "MIT",
  "repository": "https://github.com/manaflow-ai/cmux",
  "screenshots": [],

  "cmuxProfile": 1,
  "settings": {
    // cmux's own bell listing every agent chat, the ones waiting on you first.
    "sidebar.priorityView.enabled": true,
    "sidebar.priorityView.shown": true,
    // Read chats fold away at the end of their list until their next turn.
    "sidebar.settleFinished": true,
    "sidebar.showTimestamps": true
    // Pending (Rust): view options as settings (Show Chat / Work / Pinned / Priority as its own
    // section / Scheduled), a chat op to mark unread, and one to hide read chats. Archive,
    // Unarchive and Mark as read are the host's chat.archive and chat.mark_read now; Clear read
    // chats stays an app-local mark in this view's storage.
  }
}
