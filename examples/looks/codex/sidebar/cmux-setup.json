{
  "cmuxSetup": 1,
  "id": "manaflow-ai/codex-sidebar",
  "name": "Reference sidebar",
  "tagline": "A wide, calm chat sidebar.",
  "description": "A wide, calm chat sidebar.",
  "version": "1.0.0",
  "license": "MIT",
  "repository": "https://github.com/manaflow-ai/cmux",
  "screenshots": [],

  "cmuxProfile": 1,
  "settings": {
    // Proportions from the reference: a 340 pt sidebar, 36 pt rows (h-9), 14 pt interface text.
    "appearance.metrics.sidebarWidth": 340,
    "appearance.metrics.sidebarRowHeight": 36,
    "appearance.metrics.chromeFontSize": 14,
    "appearance.density": "comfortable",
    // Pending (Rust): sidebar width limits (min 240, max 520, never more than the window minus 240),
    // row corner radius 10, row inset 6 and cell padding 10 as settings; the customize view draws
    // its own rows at those numbers, the native rows keep cmux's.
    // "appearance.metrics.sidebarWidthMin": 240,
    // "appearance.metrics.sidebarWidthMax": 520,
    // "appearance.metrics.sidebarRowCornerRadius": 10,
    // "appearance.metrics.sidebarRowInset": 6,
    // "appearance.metrics.sidebarRowPadding": 10,

    // One line per chat: the title, its age at the right, a spinner while it works and a dot when
    // it has something unread. Nothing else under the name.
    "sidebar.style": "standard",
    "sidebar.density": "comfortable",
    "sidebar.textSize": "default",
    "sidebar.groupBy": "folder",
    "sidebar.showTimestamps": true,
    "sidebar.detailedStatusIcons": false,
    "appearance.statusIndicator.style": "arc",
    "sidebar.controlsOnHover": true,
    "sidebar.groupHeader.memberCount": false,
    "sidebar.groupHeader.unreadCount": false,
    "sidebar.showSpaces": false,
    "sidebar.workspaceRow.icon": false,
    "sidebar.workspaceRow.directory": false,
    "sidebar.workspaceRow.branch": false,
    "sidebar.workspaceRow.lastActivity": false,
    "sidebar.workspaceRow.agentStatus": false,
    "sidebar.workspaceRow.pullRequest": false,
    "sidebar.workspaceRow.progress": false,
    "sidebar.workspaceRow.working": true,

    // The reference's archiving: a chat whose answer you have read folds into Settled at the end
    // of its list until its next turn.
    "sidebar.settleFinished": true,

    // The thread hover card: title, kind, folder.
    "sidebar.hoverCards.enabled": true,
    "sidebar.hoverCards.layout": "compact"
    // Pending (Rust): a sort for the native list (Created, Last updated, Manual); the customize
    // view's Chats section has the first two now.
    // "sidebar.sortBy": "updated",
    // Pending (Rust): the status mark swapping to an Archive button under the pointer, per row.
    // "sidebar.rowHoverAction": "archive",
  }
}
