// Review desk keys (the review-desk look). Shift-Command-D opens the diff viewer. Inside the
// diff viewer, where letters are not typing, ] F and [ F step files, N and Shift-N step hunks and
// G G goes to the top (J, K, Shift-G and / are the viewer's own already).
// `cmux setup remove manaflow-ai/review-desk` puts your own keys back.
[
  { "key": "cmd+shift+d", "command": "openDiffViewer" },
  { "key": "rightbracket f", "command": "diffViewerNextFile", "when": "diffViewerFocused" },
  { "key": "leftbracket f", "command": "diffViewerPreviousFile", "when": "diffViewerFocused" },
  { "key": "n", "command": "diffViewerNextHunk", "when": "diffViewerFocused" },
  { "key": "shift+n", "command": "diffViewerPreviousHunk", "when": "diffViewerFocused" },
  { "key": "g g", "command": "diffViewerGoToTop", "when": "diffViewerFocused" }
]
