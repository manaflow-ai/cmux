// Leader keys (the leader look): Command-J, then a letter. Command-J is cmux's own leader
// (Command-J T is the Quick Terminal, Command-J S a new chat), so nothing a terminal or a chat
// types is taken. After Command-J: W is focus, R is resize, M is move, each then H, J, K or L.
// `cmux setup remove manaflow-ai/leader` puts your own keys back.
[
  // Panes
  { "key": "cmd+j v", "command": "splitRight" },
  { "key": "cmd+j minus", "command": "splitDown" },
  { "key": "cmd+j z", "command": "toggleSplitZoom" },
  { "key": "cmd+j e", "command": "equalizeSplits" },
  { "key": "cmd+j o", "command": "toggleFloatingPane" },
  { "key": "cmd+j x", "command": "closeTab" },

  // Things to open
  { "key": "cmd+j c", "command": "new.terminal.tab" },
  { "key": "cmd+j a", "command": "new.agentChat.right" },
  { "key": "cmd+j d", "command": "openDiffViewer" },
  { "key": "cmd+j b", "command": "toggleSidebar" },

  // Workspaces
  { "key": "cmd+j rightbracket", "command": "nextSidebarTab" },
  { "key": "cmd+j leftbracket", "command": "prevSidebarTab" },

  // Command-J W: focus
  { "key": "cmd+j w h", "command": "focusLeft" },
  { "key": "cmd+j w j", "command": "focusDown" },
  { "key": "cmd+j w k", "command": "focusUp" },
  { "key": "cmd+j w l", "command": "focusRight" },

  // Command-J R: resize
  { "key": "cmd+j r h", "command": "resizePaneLeft" },
  { "key": "cmd+j r j", "command": "resizePaneDown" },
  { "key": "cmd+j r k", "command": "resizePaneUp" },
  { "key": "cmd+j r l", "command": "resizePaneRight" },

  // Command-J M: move the tab to the next pane that way
  { "key": "cmd+j m h", "command": "moveSurfaceToPaneLeft" },
  { "key": "cmd+j m j", "command": "moveSurfaceToPaneDown" },
  { "key": "cmd+j m k", "command": "moveSurfaceToPaneUp" },
  { "key": "cmd+j m l", "command": "moveSurfaceToPaneRight" }
]
