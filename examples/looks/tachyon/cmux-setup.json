{
  "cmuxSetup": 1,
  "id": "manaflow-ai/tachyon-look",
  "name": "Tachyon",
  "tagline": "A terminal where each command's output is a card.",
  "description": "A terminal where each command's output is its own card, in graphite with a teal accent and the prompt at the bottom. Light and dark. Remove it and everything you had comes back.",
  "version": "1.1.0",
  "license": "MIT",
  "repository": "https://github.com/manaflow-ai/cmux-tachyon-look",
  "screenshots": ["screenshots/tachyon-dark.png", "screenshots/tachyon-light.png"],

  "cmuxProfile": 1,
  "settings": {
    "appearance.themeFile": "tachyon",

    // The rest of cmux in the same hand. The Markdown viewer: the chat's face (monospaced), 14 px
    // at the chat's 1.5 line height and code scale, in a column as wide as the chat's (1040 px is
    // about 110 characters).
    "markdown.font.preset": "mono",
    "markdown.font.size": 14,
    "markdown.font.lineHeight": 1.5,
    "markdown.code.scale": 1,
    "markdown.layout.width": 110,
    // Diffs in the theme's own red and green, with + and - marks, the way a terminal prints a diff.
    "diff.colors": "theme",
    "diff.diffIndicators": "classic",
    // Sidebar group colors from the theme's own palette (the theme files' terminal colors).
    "sidebar.groupPalette": "theme",

    // The chat as terminal output: every reply, card and the prompt in the monospaced face at 14 px,
    // a 1.5 line height so blocks of output breathe, code at full size (it is the same face), and a
    // wide 1040 px column, since output runs the width of the pane.
    "agentPane.display.font.ui": "roboto",
    "agentPane.display.font.preset": "mono",
    "agentPane.display.font.size": 14,
    "agentPane.display.font.lineHeight": 1.5,
    "agentPane.display.code.scale": 1,
    "agentPane.display.width": 1040,
    "agentPane.display.minimap": "off",
    "agentPane.display.harnessPlacement": "symbols",
    "agentPane.display.transcriptView": "normal",
    "agentPane.composerRing": "context",
    // Pending cmux#46738: no terminal composer look exists (auto, codex, claude); a full-width input
    // pinned to the bottom with a chip row under it (attach, voice, diff count, folder, branch) is
    // the gap.
    // "agentPane.composerLook": "auto",

    // The session sidebar: one flat list (no folder groups), every row expanded to its folder, branch
    // and agent state, the change count beside the branch, detailed status marks, and a hover card
    // that opens quickly.
    // Pending cmux#46805: no terminal sidebar look exists (cmux, claude, codex, studio).
    // "sidebar.look": "cmux",
    "sidebar.density": "expanded",
    "sidebar.groupBy": "none",
    "sidebar.groupHeader.background": "sections",
    "sidebar.groupHeader.memberCount": false,
    "sidebar.chromeGroups": false,
    "sidebar.detailedStatusIcons": true,
    "sidebar.showTimestamps": false,
    "sidebar.workspaceRow.icon": true,
    "sidebar.workspaceRow.directory": true,
    "sidebar.workspaceRow.branch": true,
    "sidebar.workspaceRow.agentStatus": true,
    "sidebar.workspaceRow.pullRequest": false,
    "sidebar.workspaceRow.lastActivity": false,
    "sidebar.workspaceRow.working": true,
    "sidebar.workspaceRow.progress": true,
    "sidebar.workspaceRow.secondLineOrder": ["directory", "branch", "agentStatus"],
    "sidebar.hoverCards.enabled": true,
    "sidebar.hoverCards.delay": 300,

    // The command search: a plain 6 px field with no shadow.
    "browser.omnibar.cornerRadius": 6,
    "browser.omnibar.shadow": false
  }
}
