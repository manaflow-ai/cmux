{
  "cmuxSetup": 1,
  "id": "manaflow-ai/chatgpt-whole",
  "name": "Codex desktop",
  "description": "A light Codex workspace with project threads, archive controls, a multiline composer, review, local editor handoff, and desktop shortcuts.",
  "version": "1.0.0",
  "screenshots": [
    "screenshots/codex-app-basic-light.webp"
  ],
  "cmuxProfile": 1,
  "settings": {
    "appearance.themeFile": "codex-app",
    "tabs.newTabApp": "local/customize",
    "tabs.hideLoneChatTab": true,
    "tabs.toolbarButtons": [
      "openDiffViewer",
      "agentPane.searchChats"
    ],
    "sidebar.groupBy": "recents",
    "sidebar.showTimestamps": true,
    "sidebar.density": "comfortable",
    "sidebar.showSpaces": false,
    "sidebar.cards.tips": false,
    "sidebar.workspaceRow.icon": false,
    "sidebar.showColors": false,
    "sidebar.hoverCards.layout": "compact",
    "agentPane.display.presentation": "messages",
    "agentPane.display.font.preset": "system",
    "agentPane.display.font.ui": "system-ui",
    "agentPane.display.font.size": 15,
    "agentPane.display.font.lineHeight": 1.5,
    "agentPane.display.width": 1000,
    "agentPane.display.minimap": "off",
    "agentPane.editedFiles.show": "collapsed",
    "agentPane.attachmentView": "strip",
    "diff.layout": "unified",
    "notifications.attention.agentChats": "ring",
    "focus.inactiveTabStyle": "quiet",
    "layout.paneCornerRadius": 16,
    "sidebar.controlsOnHover": true,
    "sidebar.groupHeader.background": "sections",
    "sidebar.side": "left",
    "sidebar.showProfileControl": true,
    "sidebar.showSearchButton": true,
    "sidebar.showNewWorkspaceChooser": true,
    "sidebar.workspacesAsTabs": false,
    "sidebar.chromeGroups": true,
    "sidebar.sideBySide": false,
    "sidebar.noFade": false,
    "sidebar.groupHeader.memberCount": true,
    "sidebar.groupHeader.unreadCount": true,
    "sidebar.groupPalette": "theme",
    "sidebar.workspaceRow.directory": false,
    "sidebar.workspaceRow.branch": false,
    "sidebar.workspaceRow.agentStatus": true,
    "sidebar.workspaceRow.tabCount": true,
    "sidebar.workspaceRow.lastActivity": false,
    "sidebar.workspaceRow.secondLineOrder": [
      "notification",
      "directory",
      "branch",
      "agentStatus",
      "lastActivity"
    ],
    "sidebar.style": "standard",
    "sidebar.workspaceRow.process": true,
    "sidebar.workspaceRow.pullRequest": false,
    "sidebar.workspaceRow.notification": true,
    "workspaceColors.indicatorStyle": "dot",
    "sidebar.priorityView.enabled": true,
    "sidebar.priorityView.shown": true,
    "agentPane.showDictation": true,
    "agentPane.showContextUsage": true,
    "agentPane.composerRing": "context",
    "diff.diffIndicators": "classic",
    "diff.lineNumbers": true,
    "diff.showBackgrounds": true,
    "agentPane.editedFiles.scope": "turn",
    "agentPane.display.sessionInfo.placement": "push",
    "agentPane.newChatsIn": "local",
    "agentPane.display.environment.placement": "left",
    "agentPane.display.harnessPlacement": "compact",
    "sidebar.textSize": "default",
    "appearance.metrics.sidebarWidth": 330,
    "appearance.metrics.sidebarRowHeight": 24,
    "sidebar.showProjects": true,
    "sidebar.showChats": true,
    "agentPane.display.pinnedPlan": true,
    "agentPane.display.trayTucked": false
  }
}
