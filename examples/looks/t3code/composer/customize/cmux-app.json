{
  "$schema": "https://cmux.dev/schemas/cmux-app/2.json",
  "manifestVersion": 2,
  "id": "local/customize",
  "name": {
    "en": "Thread composer"
  },
  "version": "1.0.0",
  "description": "Expose the attachment action beside the draft and keep the microphone and attachments visible.",
  "engines": {
    "cmux": "^2.0"
  },
  "implements": {
    "cmux.composer.toolbar/1": {
      "options": {
        "buttons": [
          {
            "action": "composer.attachFiles",
            "label": "Attach files"
          }
        ]
      }
    }
  }
}
