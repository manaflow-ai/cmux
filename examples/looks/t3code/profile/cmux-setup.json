{
  "cmuxSetup": 1,
  "id": "manaflow-ai/t3code-profile",
  "name": "T3 Code",
  "description": "Like T3 Code.",
  "version": "1.0.0",
  "license": "MIT",
  "screenshots": [
    "screenshots/source.png"
  ],
  "cmuxProfile": 1,
  "settings": {
    // The whole look (examples/looks/t3code/whole), which already unions the sidebar, display,
    // composer, archive, project-picker, open-in-editor and model-picker feature looks.
    "appearance.themeFile": "t3code-workspace",
    "appearance.metrics.sidebarWidth": 256,
    "sidebar.side": "left",
    "sidebar.style": "standard",
    "sidebar.density": "expanded",
    "sidebar.groupBy": "none",
    "sidebar.showChats": true,
    "sidebar.showProjects": true,
    "sidebar.showSearchButton": true,
    "sidebar.showTimestamps": true,
    "sidebar.controlsOnHover": true,
    "sidebar.hoverCards.enabled": true,
    "sidebar.workspaceRow.agent.directory": true,
    "sidebar.workspaceRow.agent.branch": true,
    "sidebar.workspaceRow.agent.pullRequest": true,
    "sidebar.workspaceRow.agent.agentStatus": true,
    "sidebar.workspaceRow.agent.secondLineOrder": [
      "directory",
      "branch",
      "agentStatus"
    ],
    // Proportions (parity table, proportions): cmux's sidebar type read larger than the app's and its
    // transcript column narrower. The app's sidebar rows are 12 px and its thread column is max-w-3xl (768 px).
    "appearance.metrics.chromeFontSize": 12,
    "agentPane.display.width": 768,
    "agentPane.display.presentation": "messages",
    "agentPane.display.font.preset": "system",
    "agentPane.display.font.ui": "system-ui",
    "agentPane.display.font.size": 14,
    "agentPane.display.font.lineHeight": 1.625,
    "agentPane.display.code.scale": 0.925,
    "agentPane.display.transcriptView": "normal",
    "agentPane.editedFiles.show": "collapsed",
    "agentPane.editedFiles.scope": "turn",
    "sidebar.settleFinished": true,
    "sidebar.showNewWorkspaceChooser": true,
    "agentPane.showDictation": true,
    "agentPane.attachmentView": "strip",

    // The feature set beyond the look.
    // New thread and Search rows at the top of the sidebar.
    "sidebar.nav": [
      "palette.newAgentChat | New thread | square.and.pencil",
      "search.chats | Search | magnifyingglass"
    ],
    // Model, effort and access chips in one row under the box, as the app's composer has them.
    "agentPane.composerLook": "studio",
    // An empty thread puts its composer in the middle of the page (the draft hero).
    "agentPane.emptyChatComposerPosition": "center",
    // The empty box reads as the app's does, not cmux's "Type / for commands".
    "agentPane.composerPlaceholder": "Ask for changes, send follow-ups, or attach images",
    // The selected thread row is gray, not tinted with the accent, as in the app's sidebar.
    "appearance.selection": "neutral",
    // Sidebar right-click and more menus are drawn by cmux, so the look's menu style reaches them.
    "sidebar.drawnMenus": true,
    // The app keeps a timeline minimap beside the thread.
    "agentPane.display.minimap": "compact",

    // Motion. The app's panels (sidebar, diff, terminal, right panel) open in one frame by default,
    // and hover backgrounds change without a fade. Row moves in the thread list still animate.
    "ui.animations.panes": false,
    "ui.animations.feedback": false,
    // The running tool label shines without pause.
    "agentPane.display.thinking.shimmer": "continuous"
    // Popovers, menus and tooltips (150 ms, cubic-bezier(0.4, 0, 0.2, 1)) and folds (200 ms) are timed
    // by agent-pane/theme.css's motion tokens. Pending: a 0.97 press scale and 180 ms step rows.
  }
}
