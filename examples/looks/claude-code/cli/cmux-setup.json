{
  "cmuxSetup": 1,
  "id": "manaflow-ai/claude-code-cli",
  "name": "Claude Code CLI",
  "description": "Start or resume Claude Code.",
  "version": "1.0.0",
  "license": "MIT",
  "cmuxProfile": 1,
  "actions": {
    "claude-code-start": {
      "type": "agent",
      "agent": "claude",
      "title": "Start Claude Code CLI",
      "target": "newTabInCurrentPane"
    },
    "claude-code-resume": {
      "type": "agent",
      "agent": "claude",
      "title": "Resume Claude Code CLI Session…",
      "target": "newTabInCurrentPane",
      "args": "--resume"
    }
  },
  "screenshots": [
    "preview.png"
  ]
}
