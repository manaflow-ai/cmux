{
  "cmuxSetup": 1,
  "id": "manaflow-ai/claude-code-transcript",
  "name": "Claude Code transcript",
  "description": "Replies in one column, tool steps folded.",
  "version": "1.0.0",
  "screenshots": [
    "screenshots/source.png"
  ],
  "cmuxProfile": 1,
  "settings": {
    "agentPane.display.presentation": "transcript",
    // Tool calls draw as quiet text rows with no icons, as in the reference app's Code tab.
    "agentPane.display.transcriptTokens": {"toolCards": "minimal"},
    "agentPane.display.transcriptView": "normal",
    "agentPane.display.font.size": 14,
    "agentPane.display.width": 800,
    "agentPane.display.minimap": "off",
    "agentPane.display.harnessPlacement": "compact",
    "agentPane.display.font.preset": "system"
  }
}
