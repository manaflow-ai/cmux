{
  "cmuxSetup": 1,
  "id": "manaflow-ai/claude-code-modes",
  "name": "Claude Code modes",
  "description": "Choose access or turn on Plan mode.",
  "version": "1.0.0",
  "license": "MIT",
  "cmuxProfile": 1,
  "actions": {
    "claude-code-plan": {
      "type": "agent",
      "agent": "claude",
      "title": "Start Claude Code CLI in Plan Mode",
      "target": "newTabInCurrentPane",
      "args": "--permission-mode plan"
    }
  },
  "screenshots": [
    "preview.png"
  ]
}
