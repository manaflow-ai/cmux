{
  "$schema": "https://cmux.dev/schemas/cmux-app/2.json",
  "manifestVersion": 2,
  "id": "local/customize",
  "name": { "en": "Session Recents" },
  "version": "1.0.0",
  "description": "Open and organize agent sessions from Recents.",
  "engines": { "cmux": "^2.0" },
  "runtime": { "main": "main.js" },
  "implements": {
    "cmux.section/1": {
      "export": "renderRecents",
      "title": "Recents",
      "symbol": "clock",
      "options": { "defaultRegion": "middle", "maxRows": 40 }
    }
  },
  "scopes": {
    "chat:read": "List sessions, including archived sessions.",
    "chat:write": "Pin, archive and restore the sessions you choose.",
    "actions:run": "Open the selected session.",
    "storage:local": "Remember the order of pinned sessions."
  },
  "activation": ["onInterface:cmux.section/1"],
  "files": ["main.js"]
}
