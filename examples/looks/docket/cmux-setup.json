{
  "cmuxSetup": 1,
  "id": "manaflow-ai/docket-look",
  "name": "Docket",
  "tagline": "Dark, dense, one indigo accent.",
  "description": "Dark, dense, one indigo accent.",
  "version": "1.1.0",
  "license": "MIT",
  "repository": "https://github.com/manaflow-ai/cmux-docket-look",
  "screenshots": ["screenshots/docket-dark.png", "screenshots/docket-light.png"],

  "cmuxProfile": 1,
  "settings": {
    "appearance.themeFile": "docket",

    // The rest of cmux in the same hand. The Markdown viewer: the system face, 14 px at the chat's
    // 1.5 line height and code scale, in a column as wide as the chat's (680 px is about 95
    // characters).
    "markdown.font.preset": "system",
    "markdown.font.size": 14,
    "markdown.font.lineHeight": 1.5,
    "markdown.code.scale": 0.92,
    "markdown.layout.width": 95,
    // Diffs in muted red and green, so a diff never shouts, with a bar at each changed line.
    "diff.colors": "muted",
    "diff.diffIndicators": "bars",
    // Sidebar group colors in grays, so color stays for focus alone.
    "sidebar.groupPalette": "grayscale",

    // The chat in Inter at the tracker's 13 px with a 1.5 line height (its 20 px lines), code a
    // touch smaller, a 680 px column, no minimap, harness marks as small symbols.
    "agentPane.display.font.ui": "inter",
    "agentPane.display.font.preset": "system",
    "agentPane.display.font.size": 13,
    "agentPane.display.font.lineHeight": 1.5,
    "agentPane.display.code.scale": 0.92,
    "agentPane.display.width": 680,
    "agentPane.display.minimap": "off",
    "agentPane.display.harnessPlacement": "symbols",
    "agentPane.composerRing": "context",
    // Pending cmux#46738: the prompt is a tall box with the attach and a round send at its bottom
    // right; the nearest offered look is claude's.
    // "agentPane.composerLook": "claude",

    // The sidebar as an inbox: dense one-line rows with their icon, the state glyph before the
    // title, the time since the last change at the right (1h, 4h, 13h), an unread mark, counts on
    // the group headers ("Urgent issues 5"), plain gray section labels.
    // Pending cmux#46805: no tracker sidebar look exists (cmux, claude, codex, studio).
    // "sidebar.look": "cmux",
    "sidebar.density": "compact",
    "sidebar.groupBy": "folder",
    "sidebar.groupHeader.background": "sections",
    "sidebar.groupHeader.memberCount": true,
    "sidebar.groupHeader.unreadCount": true,
    "sidebar.chromeGroups": false,
    "sidebar.detailedStatusIcons": true,
    "sidebar.showTimestamps": true,
    "sidebar.workspaceRow.icon": true,
    "sidebar.workspaceRow.directory": false,
    "sidebar.workspaceRow.branch": false,
    "sidebar.workspaceRow.lastActivity": true,
    "sidebar.workspaceRow.agentStatus": true,
    "sidebar.workspaceRow.pullRequest": true,
    "sidebar.workspaceRow.notification": true,
    "sidebar.workspaceRow.working": true,
    "sidebar.workspaceRow.progress": true,
    "sidebar.hoverCards.enabled": true,
    "sidebar.hoverCards.layout": "compact",
    "sidebar.hoverCards.delay": 400,

    // The browser bar as the tracker's inputs: a 6 px corner, no shadow, 32 px at 13 px.
    "browser.omnibar.cornerRadius": 6,
    "browser.omnibar.shadow": false,
    "browser.omnibar.height": 32,
    "browser.omnibar.fontSize": 13
  }
}
