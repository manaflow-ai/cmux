{
  "cmuxSetup": 1,
  "id": "manaflow-ai/grid",
  "name": "Grid",
  "tagline": "A Swiss grid for the whole app: zero corners, 1 px rules instead of shadows, an 8 px grid, one accent and heavy grotesk type.",
  "description": "A whole cmux look built only from public surfaces, redesigned on a strict grid. Theme files make every surface one opaque color parted only by 1 px rules, with square pane corners, no glass, no blur and no wallpaper, one accent for Send, focus and the work dot, and every height on 8 px steps (Grid, dark, the default; Grid Light; Grid Signal). Settings set the chat and the Markdown viewer in Hanken Grotesk at 16 px on a 24 px line in a 768 px column, toasts as flat bars, and a square address field. A stylesheet of cmux.agentPane.style/1 tokens draws cards as ruled boxes with no fill and the prompt as a square box ruled in the ink. Remove it and everything you had comes back.",
  "version": "1.0.0",
  "license": "MIT",
  "repository": "https://github.com/manaflow-ai/cmux/tree/feat-cmux-next/examples/looks/grid",
  "screenshots": [],

  "cmuxProfile": 1,
  "settings": {
    // Grid (dark) by default; "grid-light" and "grid-signal" are the light variants. Color,
    // corners, rules, proportions and no glass live in the theme files.
    "appearance.themeFile": "grid",

    // The chat: a heavy grotesk (Hanken Grotesk, bundled with cmux) at 16 px on a 24 px line, code
    // at 14 px, a 768 px column (96 steps of 8), no minimap.
    "agentPane.display.font.ui": "hanken",
    "agentPane.display.font.preset": "system",
    "agentPane.display.font.size": 16,
    "agentPane.display.font.lineHeight": 1.5,
    "agentPane.display.code.scale": 0.875,
    "agentPane.display.width": 768,
    "agentPane.display.minimap": "off",
    "agentPane.composerRing": "context",

    // The Markdown viewer on the same grid: 16 px on a 24 px line, a 96-character column.
    "markdown.font.preset": "system",
    "markdown.font.size": 16,
    "markdown.font.lineHeight": 1.5,
    "markdown.code.scale": 0.875,
    "markdown.layout.width": 96,

    // Diffs in the theme's own red and green with a bar at each changed line; sidebar group
    // colors in grays, so the accent stays the only hue.
    "diff.colors": "theme",
    "diff.diffIndicators": "bars",
    "sidebar.groupPalette": "grayscale",

    // The sidebar: plain section headings over rules, one line per chat, a dot for status.
    "sidebar.density": "compact",
    "sidebar.groupHeader.background": "sections",
    "sidebar.groupHeader.memberCount": false,
    "sidebar.detailedStatusIcons": false,
    "sidebar.showTimestamps": true,
    "sidebar.workspaceRow.icon": false,
    "sidebar.workspaceRow.lastActivity": false,
    "sidebar.workspaceRow.pullRequest": false,

    // Pending cmux#49661: toasts as a hard bar (opaque, a 1 px edge, no shadow, rim or glass). The
    // key merged on 2026-11-23, but the generated settings schema a build embeds does not carry it
    // yet, so install refuses it until then. Uncomment once your build has it.
    // "notifications.toast.style": "flat",

    // The address field: square, flat, opaque.
    "browser.omnibar.cornerRadius": 0,
    "browser.omnibar.shadow": false,
    "browser.omnibar.backgroundOpacity": 1
  }
}
