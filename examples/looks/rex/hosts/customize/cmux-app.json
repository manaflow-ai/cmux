{
  "$schema": "https://cmux.dev/schemas/cmux-app/2.json",
  "manifestVersion": 2,
  "id": "local/customize",
  "name": {
    "en": "Hosts"
  },
  "version": "1.0.0",
  "description": "Your chats grouped by host.",
  "engines": {
    "cmux": "^2.0"
  },
  "runtime": {
    "main": "main.js"
  },
  "implements": {
    "cmux.section/1": {
      "export": "renderHosts",
      "title": "Hosts",
      "symbol": "terminal.fill",
      "options": {
        "defaultRegion": "top",
        "maxRows": 50
      }
    }
  },
  "scopes": {
    "agent_chat:read": "List local and peer chats and their reported activity.",
    "actions:run": "Open the selected chat or start one through native cmux actions."
  },
  "activation": [
    "onInterface:cmux.section/1"
  ],
  "files": [
    "main.js"
  ]
}
