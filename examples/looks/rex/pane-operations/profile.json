{
  "cmuxProfile": 1,
  "name": "rex-pane-operations",
  "description": "Five terminal-scoped native pane operations: close, close others on the same screen, move all tabs to a new workspace or window, and copy pane ID. See README.md for scope and native limits.",
  "settings": {},
  "files": {
    "keybindings.json": "[\n  {\n    \"key\": \"ctrl+opt+cmd+w\",\n    \"command\": \"closePane\",\n    \"when\": \"terminalFocused && !paletteOpen\"\n  },\n  {\n    \"key\": \"ctrl+opt+cmd+shift+w\",\n    \"command\": \"pane.closeOthers\",\n    \"when\": \"terminalFocused && !paletteOpen\"\n  },\n  {\n    \"key\": \"ctrl+opt+cmd+t\",\n    \"command\": \"pane.moveToNewWorkspace\",\n    \"when\": \"terminalFocused && !paletteOpen\"\n  },\n  {\n    \"key\": \"ctrl+opt+cmd+n\",\n    \"command\": \"pane.moveToNewWindow\",\n    \"when\": \"terminalFocused && !paletteOpen\"\n  },\n  {\n    \"key\": \"ctrl+opt+cmd+c\",\n    \"command\": \"palette.copyPaneID\",\n    \"when\": \"terminalFocused && !paletteOpen\"\n  }\n]\n"
  }
}
