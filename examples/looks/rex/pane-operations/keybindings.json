[
  {
    "key": "ctrl+opt+cmd+w",
    "command": "closePane",
    "when": "terminalFocused && !paletteOpen"
  },
  {
    "key": "ctrl+opt+cmd+shift+w",
    "command": "pane.closeOthers",
    "when": "terminalFocused && !paletteOpen"
  },
  {
    "key": "ctrl+opt+cmd+t",
    "command": "pane.moveToNewWorkspace",
    "when": "terminalFocused && !paletteOpen"
  },
  {
    "key": "ctrl+opt+cmd+n",
    "command": "pane.moveToNewWindow",
    "when": "terminalFocused && !paletteOpen"
  },
  {
    "key": "ctrl+opt+cmd+c",
    "command": "palette.copyPaneID",
    "when": "terminalFocused && !paletteOpen"
  }
]
