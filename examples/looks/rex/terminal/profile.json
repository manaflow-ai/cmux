{
  "cmuxProfile": 1,
  "name": "rex-terminal",
  "description": "Terminal-scoped font size, selection, copy mode, find and page navigation. Uses existing cmux actions; see README.md for source mappings and limits.",
  "settings": {},
  "files": {
    "keybindings.json": "[\n  {\n    \"key\": \"cmd+=\",\n    \"command\": \"terminal.increaseFontSize\",\n    \"when\": \"terminalFocused\"\n  },\n  {\n    \"key\": \"cmd+shift+=\",\n    \"command\": \"terminal.increaseFontSize\",\n    \"when\": \"terminalFocused\"\n  },\n  {\n    \"key\": \"cmd+-\",\n    \"command\": \"terminal.decreaseFontSize\",\n    \"when\": \"terminalFocused\"\n  },\n  {\n    \"key\": \"cmd+0\",\n    \"command\": \"terminal.resetFontSize\",\n    \"when\": \"terminalFocused\"\n  },\n  {\n    \"key\": \"cmd+c\",\n    \"command\": \"terminalCopy\",\n    \"when\": \"terminalFocused\"\n  },\n  {\n    \"key\": \"cmd+v\",\n    \"command\": \"terminalPaste\",\n    \"when\": \"terminalFocused\"\n  },\n  {\n    \"key\": \"cmd+a\",\n    \"command\": \"terminal.selectAll\",\n    \"when\": \"terminalFocused\"\n  },\n  {\n    \"key\": \"cmd+shift+c\",\n    \"command\": \"toggleTerminalCopyMode\",\n    \"when\": \"terminalFocused\"\n  },\n  {\n    \"key\": \"cmd+f\",\n    \"command\": \"find\",\n    \"when\": \"terminalFocused\"\n  },\n  {\n    \"key\": \"cmd+g\",\n    \"command\": \"findNext\",\n    \"when\": \"terminalFocused\"\n  },\n  {\n    \"key\": \"cmd+shift+g\",\n    \"command\": \"findPrevious\",\n    \"when\": \"terminalFocused\"\n  },\n  {\n    \"key\": \"cmd+pageup\",\n    \"command\": \"terminal.scrollPageUp\",\n    \"when\": \"terminalFocused\"\n  },\n  {\n    \"key\": \"cmd+pagedown\",\n    \"command\": \"terminal.scrollPageDown\",\n    \"when\": \"terminalFocused\"\n  }\n]\n"
  }
}
