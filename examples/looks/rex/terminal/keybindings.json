[
  {
    "key": "cmd+=",
    "command": "terminal.increaseFontSize",
    "when": "terminalFocused"
  },
  {
    "key": "cmd+shift+=",
    "command": "terminal.increaseFontSize",
    "when": "terminalFocused"
  },
  {
    "key": "cmd+-",
    "command": "terminal.decreaseFontSize",
    "when": "terminalFocused"
  },
  {
    "key": "cmd+0",
    "command": "terminal.resetFontSize",
    "when": "terminalFocused"
  },
  {
    "key": "cmd+c",
    "command": "terminalCopy",
    "when": "terminalFocused"
  },
  {
    "key": "cmd+v",
    "command": "terminalPaste",
    "when": "terminalFocused"
  },
  {
    "key": "cmd+a",
    "command": "terminal.selectAll",
    "when": "terminalFocused"
  },
  {
    "key": "cmd+shift+c",
    "command": "toggleTerminalCopyMode",
    "when": "terminalFocused"
  },
  {
    "key": "cmd+f",
    "command": "find",
    "when": "terminalFocused"
  },
  {
    "key": "cmd+g",
    "command": "findNext",
    "when": "terminalFocused"
  },
  {
    "key": "cmd+shift+g",
    "command": "findPrevious",
    "when": "terminalFocused"
  },
  {
    "key": "cmd+pageup",
    "command": "terminal.scrollPageUp",
    "when": "terminalFocused"
  },
  {
    "key": "cmd+pagedown",
    "command": "terminal.scrollPageDown",
    "when": "terminalFocused"
  }
]
