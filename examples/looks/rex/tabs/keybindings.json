[
  {
    "key": "cmd+n",
    "command": "newWindow",
    "when": "!paletteOpen"
  },
  {
    "key": "cmd+shift+w",
    "command": "closeWindow",
    "when": "!paletteOpen"
  },
  {
    "key": "ctrl+cmd+f",
    "command": "toggleFullScreen",
    "when": "!paletteOpen"
  },
  {
    "key": "cmd+t",
    "command": "newSurface",
    "when": "terminalFocused && !paletteOpen"
  },
  {
    "key": "cmd+opt+w",
    "command": "closeTab",
    "when": "terminalFocused && !paletteOpen"
  },
  {
    "key": "ctrl+tab",
    "command": "nextSurface",
    "when": "terminalFocused && !paletteOpen"
  },
  {
    "key": "cmd+shift+rightbracket",
    "command": "nextSurface",
    "when": "terminalFocused && !paletteOpen"
  },
  {
    "key": "ctrl+shift+tab",
    "command": "prevSurface",
    "when": "terminalFocused && !paletteOpen"
  },
  {
    "key": "cmd+shift+leftbracket",
    "command": "prevSurface",
    "when": "terminalFocused && !paletteOpen"
  },
  {
    "key": "ctrl+shift+pageup",
    "command": "moveSurfaceLeft",
    "when": "terminalFocused && !paletteOpen"
  },
  {
    "key": "ctrl+shift+pagedown",
    "command": "moveSurfaceRight",
    "when": "terminalFocused && !paletteOpen"
  },
  {
    "key": "cmd+1",
    "command": "selectSurfaceByNumber",
    "when": "terminalFocused && !paletteOpen",
    "args": {
      "index": 1
    }
  },
  {
    "key": "cmd+2",
    "command": "selectSurfaceByNumber",
    "when": "terminalFocused && !paletteOpen",
    "args": {
      "index": 2
    }
  },
  {
    "key": "cmd+3",
    "command": "selectSurfaceByNumber",
    "when": "terminalFocused && !paletteOpen",
    "args": {
      "index": 3
    }
  },
  {
    "key": "cmd+4",
    "command": "selectSurfaceByNumber",
    "when": "terminalFocused && !paletteOpen",
    "args": {
      "index": 4
    }
  },
  {
    "key": "cmd+5",
    "command": "selectSurfaceByNumber",
    "when": "terminalFocused && !paletteOpen",
    "args": {
      "index": 5
    }
  },
  {
    "key": "cmd+6",
    "command": "selectSurfaceByNumber",
    "when": "terminalFocused && !paletteOpen",
    "args": {
      "index": 6
    }
  },
  {
    "key": "cmd+7",
    "command": "selectSurfaceByNumber",
    "when": "terminalFocused && !paletteOpen",
    "args": {
      "index": 7
    }
  },
  {
    "key": "cmd+8",
    "command": "selectSurfaceByNumber",
    "when": "terminalFocused && !paletteOpen",
    "args": {
      "index": 8
    }
  },
  {
    "key": "cmd+quote",
    "command": "focusTabRecentInWorkspace",
    "when": "terminalFocused && !paletteOpen"
  }
]
