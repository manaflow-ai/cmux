  "settings": {},
  "files": {
    "keybindings.json": "[\n  {\n    \"key\": \"cmd+n\",\n    \"command\": \"newWindow\",\n    \"when\": \"!paletteOpen\"\n  },\n  {\n    \"key\": \"cmd+shift+w\",\n    \"command\": \"closeWindow\",\n    \"when\": \"!paletteOpen\"\n  },\n  {\n    \"key\": \"ctrl+cmd+f\",\n    \"command\": \"toggleFullScreen\",\n    \"when\": \"!paletteOpen\"\n  },\n  {\n    \"key\": \"cmd+t\",\n    \"command\": \"newSurface\",\n    \"when\": \"terminalFocused && !paletteOpen\"\n  },\n  {\n    \"key\": \"cmd+opt+w\",\n    \"command\": \"closeTab\",\n    \"when\": \"terminalFocused && !paletteOpen\"\n  },\n  {\n    \"key\": \"ctrl+tab\",\n    \"command\": \"nextSurface\",\n    \"when\": \"terminalFocused && !paletteOpen\"\n  },\n  {\n    \"key\": \"cmd+shift+rightbracket\",\n    \"command\": \"nextSurface\",\n    \"when\": \"terminalFocused && !paletteOpen\"\n  },\n  {\n    \"key\": \"ctrl+shift+tab\",\n    \"command\": \"prevSurface\",\n    \"when\": \"terminalFocused && !paletteOpen\"\n  },\n  {\n    \"key\": \"cmd+shift+leftbracket\",\n    \"command\": \"prevSurface\",\n    \"when\": \"terminalFocused && !paletteOpen\"\n  },\n  {\n    \"key\": \"ctrl+shift+pageup\",\n    \"command\": \"moveSurfaceLeft\",\n    \"when\": \"terminalFocused && !paletteOpen\"\n  },\n  {\n    \"key\": \"ctrl+shift+pagedown\",\n    \"command\": \"moveSurfaceRight\",\n    \"when\": \"terminalFocused && !paletteOpen\"\n  },\n  {\n    \"key\": \"cmd+1\",\n    \"command\": \"selectSurfaceByNumber\",\n    \"when\": \"terminalFocused && !paletteOpen\",\n    \"args\": {\n      \"index\": 1\n    }\n  },\n  {\n    \"key\": \"cmd+2\",\n    \"command\": \"selectSurfaceByNumber\",\n    \"when\": \"terminalFocused && !paletteOpen\",\n    \"args\": {\n      \"index\": 2\n    }\n  },\n  {\n    \"key\": \"cmd+3\",\n    \"command\": \"selectSurfaceByNumber\",\n    \"when\": \"terminalFocused && !paletteOpen\",\n    \"args\": {\n      \"index\": 3\n    }\n  },\n  {\n    \"key\": \"cmd+4\",\n    \"command\": \"selectSurfaceByNumber\",\n    \"when\": \"terminalFocused && !paletteOpen\",\n    \"args\": {\n      \"index\": 4\n    }\n  },\n  {\n    \"key\": \"cmd+5\",\n    \"command\": \"selectSurfaceByNumber\",\n    \"when\": \"terminalFocused && !paletteOpen\",\n    \"args\": {\n      \"index\": 5\n    }\n  },\n  {\n    \"key\": \"cmd+6\",\n    \"command\": \"selectSurfaceByNumber\",\n    \"when\": \"terminalFocused && !paletteOpen\",\n    \"args\": {\n      \"index\": 6\n    }\n  },\n  {\n    \"key\": \"cmd+7\",\n    \"command\": \"selectSurfaceByNumber\",\n    \"when\": \"terminalFocused && !paletteOpen\",\n    \"args\": {\n      \"index\": 7\n    }\n  },\n  {\n    \"key\": \"cmd+8\",\n    \"command\": \"selectSurfaceByNumber\",\n    \"when\": \"terminalFocused && !paletteOpen\",\n    \"args\": {\n      \"index\": 8\n    }\n  },\n  {\n    \"key\": \"cmd+quote\",\n    \"command\": \"focusTabRecentInWorkspace\",\n    \"when\": \"terminalFocused && !paletteOpen\"\n  }\n]\n"
  }
