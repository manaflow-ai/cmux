{
  "$schema": "https://cmux.dev/schemas/cmux-app/2.json",
  "manifestVersion": 2,
  "id": "local/customize",
  "name": "Rex",
  "version": "1.0.0",
  "description": "Launch terminals and browse chats by host.",
  "engines": {
    "cmux": "^2.0"
  },
  "runtime": {
    "main": "main.js"
  },
  "implements": {
    "cmux.section/1": {
      "export": "renderHosts",
      "title": "Hosts",
      "symbol": "terminal.fill",
      "options": {
        "defaultRegion": "top",
        "maxRows": 50
      }
    },
    "cmux.newtab/1": {
      "export": "renderNewTab",
      "title": "New Tab",
      "symbol": "plus"
    }
  },
  "scopes": {
    "agent_chat:read": "List local and peer chats and their reported activity.",
    "actions:run": "Open chats, start terminals and workspaces, or connect a host."
  },
  "activation": [
    "onInterface:cmux.section/1",
    "onInterface:cmux.newtab/1"
  ],
  "files": [
    "main.js"
  ]
}
