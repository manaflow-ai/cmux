{
  "name": "cockpit",
  "description": "Mission control, redone: moonlit glass over Dahl's Dresden at night, a New Tab page with a greeting, live counters that roll when they change, launch tiles and three designed cards (what needs you, your PRs, your workspaces), a Needs You section on top of the sidebar, the session tree, Priority View and a docked Chief on the right.",
  "settings": {
    "appearance.themeFile": "last-demo-cockpit",
    "tabs.newTabApp": "local/customize",
    "sidebar.priorityView.enabled": true,
    "sidebar.sessionTree": true,
    "home.chiefDock.edge": "right",
    "agentPane.display.sessionInfo.placement": "push",
    "layout.mainPane": "agent-chats",
    "layout.paneSeparation": "cards",
    "layout.paneCornerRadius": 12,
    "sidebar.density": "expanded",
    "sidebar.groupHeader.background": "glass",
    "agentPane.display.font.preset": "system",
    "sidebar.side": "left",
    "sidebar.showProfileControl": true,
    "sidebar.showSearchButton": true,
    "sidebar.showNewWorkspaceChooser": true,
    "sidebar.workspacesAsTabs": false,
    "sidebar.chromeGroups": true,
    "sidebar.sideBySide": false,
    "sidebar.noFade": false,
    "sidebar.groupHeader.memberCount": true,
    "sidebar.groupHeader.unreadCount": true,
    "sidebar.groupPalette": "theme",
    "sidebar.workspaceRow.directory": true,
    "sidebar.workspaceRow.branch": true,
    "sidebar.workspaceRow.agentStatus": true,
    "sidebar.workspaceRow.tabCount": true,
    "sidebar.workspaceRow.lastActivity": true,
    "sidebar.workspaceRow.secondLineOrder": [
      "notification",
      "directory",
      "branch",
      "agentStatus",
      "lastActivity"
    ],
    "sidebar.style": "standard",
    "sidebar.workspaceRow.icon": true,
    "sidebar.workspaceRow.process": true,
    "sidebar.workspaceRow.notification": true,
    "workspaceColors.indicatorStyle": "fill"
  }
}
