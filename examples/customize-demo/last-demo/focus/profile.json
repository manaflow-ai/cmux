{
  "name": "focus",
  "description": "One thing at a time, redone: frosted glass over Hiroshige's Zoshigaya, a warm ink-and-paper palette, and a New Tab page set like a title card: one question, what you are working on, a large session timer with presets, and today's sessions as a row of marks. The chat reads as messages, the sidebar is a rail whose bands hide until you point at it, and nothing moves.",
  "settings": {
    "appearance.themeFile": "last-demo-focus",
    "tabs.newTabApp": "local/customize",
    "agentPane.display.presentation": "messages",
    "agentPane.display.minimap": "off",
    "agentPane.display.trayTucked": true,
    "agentPane.display.environment.placement": "off",
    "sidebar.style": "rail",
    "sidebar.minimalMode": "both",
    "sidebar.controlsOnHover": true,
    "sidebar.hoverCards.enabled": false,
    "layout.rows": false,
    "layout.paneSeparation": "none",
    "appearance.focusIndicator": "none",
    "ui.calm": "still",
    "agentPane.display.font.lineHeight": 1.6,
    "agentPane.display.font.size": 15,
    "layout.paneCornerRadius": 10,
    "agentPane.display.font.preset": "system",
    "sidebar.side": "left",
    "sidebar.showProfileControl": true,
    "sidebar.showSearchButton": true,
    "sidebar.showNewWorkspaceChooser": true,
    "sidebar.workspacesAsTabs": false,
    "sidebar.chromeGroups": true,
    "sidebar.sideBySide": false,
    "sidebar.noFade": false,
    "sidebar.groupHeader.memberCount": true,
    "sidebar.groupHeader.unreadCount": true,
    "sidebar.groupPalette": "theme",
    "sidebar.workspaceRow.directory": true,
    "sidebar.workspaceRow.branch": true,
    "sidebar.workspaceRow.agentStatus": true,
    "sidebar.workspaceRow.tabCount": true,
    "sidebar.workspaceRow.lastActivity": true,
    "sidebar.workspaceRow.secondLineOrder": [
      "notification",
      "directory",
      "branch",
      "agentStatus",
      "lastActivity"
    ],
    "sidebar.groupHeader.background": "solid",
    "sidebar.workspaceRow.icon": false,
    "sidebar.workspaceRow.notification": false,
    "workspaceColors.indicatorStyle": "dot"
  }
}
