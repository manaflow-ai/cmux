{
  "name": "tiling",
  "description": "A scrolling tiling window manager, redone: panes as floating glass cards over Hokusai's Great Wave, a cyan focus border, new terminals and browsers in columns of their own that scroll sideways, focus follows the mouse, links open in a new column, and a thin rail sidebar with numbered workspaces and a status bar of panes, tabs, agents at work and the time.",
  "settings": {
    "appearance.themeFile": "last-demo-tiling",
    "layout.mainPane": "off",
    "layout.newPanePlacement": "split",
    "layout.tileBrowsers": true,
    "layout.scrollAreas": true,
    "layout.rows": false,
    "layout.newColumnWidth": "fixed",
    "layout.defaultColumnWidth": 0.5,
    "layout.centerFocusedColumn": "on-overflow",
    "layout.focusFollowsMouse": true,
    "layout.linkPlacement": "new-column",
    "layout.paneSeparation": "cards",
    "appearance.focusIndicator": "border",
    "sidebar.style": "rail",
    "sidebar.controlsOnHover": true,
    "focus.inactiveTabStyle": "tonal",
    "layout.paneCornerRadius": 8,
    "agentPane.display.font.preset": "system",
    "sidebar.side": "left",
    "sidebar.showProfileControl": true,
    "sidebar.showSearchButton": true,
    "sidebar.showNewWorkspaceChooser": true,
    "sidebar.workspacesAsTabs": false,
    "sidebar.chromeGroups": true,
    "sidebar.sideBySide": false,
    "sidebar.noFade": false,
    "sidebar.groupHeader.memberCount": true,
    "sidebar.groupHeader.unreadCount": true,
    "sidebar.groupPalette": "theme",
    "sidebar.workspaceRow.directory": true,
    "sidebar.workspaceRow.branch": true,
    "sidebar.workspaceRow.agentStatus": true,
    "sidebar.workspaceRow.tabCount": true,
    "sidebar.workspaceRow.lastActivity": true,
    "sidebar.workspaceRow.secondLineOrder": [
      "notification",
      "directory",
      "branch",
      "agentStatus",
      "lastActivity"
    ],
    "sidebar.groupHeader.background": "sections",
    "sidebar.numbering": "allItems",
    "sidebar.stepping": "allItems",
    "sidebar.steppingWraps": true,
    "sidebar.workspaceRow.icon": true,
    "sidebar.workspaceRow.process": true,
    "sidebar.workspaceRow.ports": true,
    "sidebar.workspaceRow.notification": true,
    "workspaceColors.indicatorStyle": "leftRail"
  }
}
