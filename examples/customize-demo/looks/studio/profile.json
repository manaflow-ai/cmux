{
  "name": "studio",
  "description": "A calm studio look for the whole window: dense graphite chrome with a hairline between the sidebar and the chat, a rose accent, an arc while work runs, Inter in a 740-point chat, small radii and hairline cards. The sidebar is the studio's thread list: threads under each project with a count, a status chip on every row (Working, Input, Failed, Done), and a Settled shelf for finished work. Every New Tab is the studio's start page (a prompt, one button per agent, and the usage of every Claude and Codex account on one page), each chat's Session Info gets the studio's thread details card, and the hover card reads like a work log.",
  "settings": {
    "appearance.themeFile": "studio",
    "tabs.newTabApp": "local/customize",
    "tabs.hideLoneChatTab": true,
    "tabs.toolbarButtons": [
      "openDiffViewer",
      "agentPane.searchChats"
    ],
    "sidebar.groupBy": "folder",
    "sidebar.settleFinished": true,
    "sidebar.showSpaces": false,
    "sidebar.cards.tips": false,
    "sidebar.groupHeader.background": "sections",
    "sidebar.groupHeader.memberCount": true,
    "sidebar.groupHeader.unreadCount": false,
    "sidebar.workspaceRow.icon": false,
    "sidebar.showColors": false,
    "sidebar.showTimestamps": true,
    "sidebar.detailedStatusIcons": true,
    "sidebar.density": "compact",
    "agentPane.display.font.preset": "system",
    "agentPane.display.font.ui": "inter",
    "agentPane.display.font.size": 14,
    "agentPane.display.font.lineHeight": 1.6,
    "agentPane.display.code.scale": 0.9,
    "agentPane.display.width": 740,
    "agentPane.display.harnessPlacement": "compact",
    "agentPane.display.minimap": "off",
    "agentPane.display.sessionInfo.placement": "push",
    "agentPane.editedFiles.show": "collapsed",
    "agentPane.showContextUsage": true,
    "diff.layout": "split",
    "focus.inactiveTabStyle": "tonal",
    "layout.paneCornerRadius": 6,
    "sidebar.controlsOnHover": true,
    "tabs.plusButton": "always",
    "sidebar.side": "left",
    "sidebar.showProfileControl": true,
    "sidebar.showSearchButton": true,
    "sidebar.showNewWorkspaceChooser": true,
    "sidebar.workspacesAsTabs": false,
    "sidebar.chromeGroups": true,
    "sidebar.sideBySide": false,
    "sidebar.noFade": false,
    "sidebar.groupPalette": "theme",
    "sidebar.workspaceRow.directory": true,
    "sidebar.workspaceRow.branch": true,
    "sidebar.workspaceRow.agentStatus": true,
    "sidebar.workspaceRow.tabCount": true,
    "sidebar.workspaceRow.lastActivity": true,
    "sidebar.workspaceRow.secondLineOrder": [
      "notification",
      "directory",
      "branch",
      "agentStatus",
      "lastActivity"
    ],
    "sidebar.style": "standard",
    "sidebar.workspaceRow.process": true,
    "sidebar.workspaceRow.ports": false,
    "sidebar.workspaceRow.notification": true,
    "workspaceColors.indicatorStyle": "fill",
    "tabs.nativeNewTabPage": false
  }
}
