// Studio's keys (the studio look): Shift-Command-O for a new thread, Command-K to search threads,
// Shift-Command-D for the diff. Each key's old action stays in the Command Palette.
// `cmux customize discard` puts your own keys back.
[
  { "key": "cmd+shift+o", "command": "palette.newAgentChat" },
  { "key": "cmd+k", "command": "agentPane.searchChats" },
  { "key": "cmd+shift+d", "command": "openDiffViewer" },
  { "key": "cmd+shift+m", "command": "agentPane.switchModel" },
  { "key": "cmd+shift+leftbracket", "command": "prevSidebarTab" },
  { "key": "cmd+shift+rightbracket", "command": "nextSidebarTab" }
]
