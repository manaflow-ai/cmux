{
  "name": "hosts",
  "description": "A hosts look for the whole window, after a terminal multiplexer's: a near-black terminal-first window, rounded panes beside a quiet sidebar, a mint accent, monospaced status lines. The sidebar is a hosts list: This Mac and every machine your sessions run on, each with a leading identity icon and its sessions under it, every session with its program status (working, blocked, done, error, idle) and what it is doing now, plus Add Host. Workspaces are grouped by computer. Every New Tab is a session picker (search every session on every host), each chat's Session Info gets a block card (host, session, status, folder), and the hover card reads like a status line.",
  "settings": {
    "appearance.themeFile": "hosts",
    "tabs.newTabApp": "local/customize",
    "tabs.hideLoneChatTab": true,
    "tabs.toolbarButtons": [
      "agentPane.searchChats"
    ],
    "sidebar.groupBy": "folder",
    "sidebar.groupByComputer": true,
    "sidebar.showSpaces": false,
    "sidebar.cards.tips": false,
    "sidebar.groupHeader.background": "sections",
    "sidebar.groupHeader.memberCount": true,
    "sidebar.groupHeader.unreadCount": false,
    "sidebar.workspaceRow.icon": true,
    "sidebar.showColors": false,
    "sidebar.showTimestamps": false,
    "sidebar.detailedStatusIcons": true,
    "sidebar.density": "comfortable",
    "sidebar.controlsOnHover": true,
    "agentPane.display.font.preset": "system",
    "agentPane.display.font.ui": "inter",
    "agentPane.display.font.size": 13,
    "agentPane.display.font.lineHeight": 1.55,
    "agentPane.display.code.scale": 0.95,
    "agentPane.display.width": 820,
    "agentPane.display.harnessPlacement": "compact",
    "agentPane.display.minimap": "off",
    "agentPane.display.sessionInfo.placement": "push",
    "agentPane.editedFiles.show": "collapsed",
    "agentPane.showContextUsage": true,
    "diff.layout": "unified",
    "focus.inactiveTabStyle": "tonal",
    "layout.paneCornerRadius": 14,
    "tabs.plusButton": "always",
    "sidebar.side": "left",
    "sidebar.showProfileControl": true,
    "sidebar.showSearchButton": true,
    "sidebar.showNewWorkspaceChooser": true,
    "sidebar.workspacesAsTabs": false,
    "sidebar.chromeGroups": true,
    "sidebar.sideBySide": false,
    "sidebar.noFade": false,
    "sidebar.groupPalette": "theme",
    "sidebar.workspaceRow.directory": true,
    "sidebar.workspaceRow.branch": true,
    "sidebar.workspaceRow.agentStatus": true,
    "sidebar.workspaceRow.tabCount": true,
    "sidebar.workspaceRow.lastActivity": true,
    "sidebar.workspaceRow.secondLineOrder": [
      "notification",
      "directory",
      "branch",
      "agentStatus",
      "lastActivity"
    ],
    "sidebar.style": "rail",
    "sidebar.showLocalMachine": true,
    "sidebar.workspaceRow.process": true,
    "sidebar.workspaceRow.ports": true,
    "sidebar.workspaceRow.working": true,
    "sidebar.workspaceRow.notification": true,
    "workspaceColors.indicatorStyle": "leftRail"
  }
