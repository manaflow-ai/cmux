    "keybindings.json": "[\n  {\n    \"key\": \"cmd+shift+p\",\n    \"command\": \"commandPalette\"\n  },\n  {\n    \"key\": \"cmd+,\",\n    \"command\": \"openSettings\"\n  },\n  {\n    \"key\": \"cmd+opt+p\",\n    \"command\": \"tab.search\",\n    \"when\": \"terminalFocused && !paletteOpen\"\n  },\n  {\n    \"key\": \"cmd+opt+r\",\n    \"command\": \"renameTab\",\n    \"when\": \"terminalFocused && !paletteOpen\"\n  },\n  {\n    \"key\": \"cmd+opt+quote\",\n    \"command\": \"focusHistoryLast\",\n    \"when\": \"terminalFocused && !paletteOpen\"\n  }\n]\n"
