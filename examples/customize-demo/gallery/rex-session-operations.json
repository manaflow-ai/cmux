{
  "cmuxProfile": 1,
  "name": "setup-manaflow-ai-rex-session-operations",
  "description": "Cycle between grouped workspaces, return to the last used workspace, rename, or close from a focused terminal.",
  "created_ms": 0,
  "settings": {},
  "files": {
    "keybindings.json": "[\n  {\n    \"key\": \"ctrl+opt+cmd+j n\",\n    \"command\": \"nextSidebarTabInGroup\",\n    \"when\": \"terminalFocused && !paletteOpen\"\n  },\n  {\n    \"key\": \"ctrl+opt+cmd+j p\",\n    \"command\": \"prevSidebarTabInGroup\",\n    \"when\": \"terminalFocused && !paletteOpen\"\n  },\n  {\n    \"key\": \"ctrl+opt+cmd+j l\",\n    \"command\": \"workspace.selectLastUsed\",\n    \"when\": \"terminalFocused && !paletteOpen\"\n  },\n  {\n    \"key\": \"ctrl+opt+cmd+j r\",\n    \"command\": \"renameWorkspace\",\n    \"when\": \"terminalFocused && !paletteOpen\"\n  },\n  {\n    \"key\": \"ctrl+opt+cmd+j w\",\n    \"command\": \"closeWorkspace\",\n    \"when\": \"terminalFocused && !paletteOpen\"\n  }\n]\n"
  },
  "x-setup": {
    "id": "manaflow-ai/rex-session-operations",
    "name": "Workspace shortcuts",
    "source": "looks/rex/session-operations"
  }
}
