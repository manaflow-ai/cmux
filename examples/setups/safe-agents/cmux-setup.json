{
  "cmuxSetup": 1,
  "id": "manaflow-ai/safe-agents-setup",
  "name": "Safe agents",
  "tagline": "Agents ask first",
  "description": "Agents ask before they act and cmux asks before closing an agent session. Touches only agent autonomy.",
  "version": "1.0.0",
  "license": "MIT",
  "repository": "https://github.com/manaflow-ai/cmux/tree/feat-cmux-next/examples/setups/safe-agents",
  "cmuxProfile": 1,
  "settings": {
    "agents.defaultPermissionMode": "ask",
    "app.warnBeforeClosingAgentSession": true,
    "agents.autoRetry.enabled": false
  }
}
