// Garbage: a pack that is wrong on purpose, for tests and for docs/cmux-next/theme-packs.md.
// Each line says what should happen. The good values (marked OK) must survive; every bad one is
// dropped alone with a diagnostic, and the pack still loads. Do not copy this as a starting point.
{
  "cmuxPack": 1,

  // BAD id: not "owner/name" (uppercase, spaces, no slash). Falls back to "local/garbage" with a diagnostic.
  "id": "Not An Id",
  "name": "Garbage",                        // OK
  "version": "0.0.1",                       // OK

  // BAD entry: a number is not a capability name; diagnostic, the rest of the list is kept.
  // OK: tokens, colors, backgrounds, motion, components. Not declared: fonts, tabs.
  "capabilities": ["tokens", "colors", "backgrounds", "motion", "components", 7],

  "look": {
    "appearance.theme": "Soft Blue",                       // OK (tokens): the terminal theme colors edit
    "appearance.accent": "theme",                          // OK (tokens)
    "appearance.chromeStyle": "two-tone",                  // OK (tokens)
    "ui.animationSpeed": "normal",                         // OK (motion)
    "appearance.backgroundOpacity": 0.8,                   // OK (backgrounds)
    "appearance.background": "file:assets/ok.png",         // see note below

    "terminal.fontSize": 14,                               // DROPPED: needs the fonts capability, not declared
    "sidebar.sectionLook": "card",                         // OK (components)
    "appearance.noSuchKey": true,                          // DROPPED: not a setting
    "appearance.density": 7,                               // DROPPED: wrong type, a choice takes text
    "appearance.glassTransparency": 4,                     // DROPPED: out of range, 0 to 1
    "appearance.borders": "dashed",                        // DROPPED: unknown choice, expected default or none
    "appearance.wallpaper": "file:../outside.png",         // DROPPED: escapes assets/ with ../
    "appearance.backgroundLight": "file:/etc/hosts",       // DROPPED: absolute path, a pack names only assets/NAME
    "appearance.backgroundDark": "file:assets/missing.png" // DROPPED: no such file in the pack
  },
  // Note: appearance.background = "file:assets/ok.png" passes the asset check (a real picture inside
  // assets/), so it is the one valid asset reference. Whether the settings schema accepts a file: value
  // for that key is the schema's call; a test should assert only the asset diagnostics, not this key.

  "colors": {
    "background": "#1f1419",                // OK
    "foreground": "#f7e8ee",                // OK
    "cursor": "pink"                        // DROPPED: expected "#RRGGBB"
  },

  // Slots need the components capability, which this pack declares.
  // chat.thinkingIndicator = "pulse" is OK; "chat.noSuchSlot" is dropped (unknown slot);
  // chat.jumpToBottom = "wiggle" is dropped (unknown variant).
  "slots": {
    "chat.thinkingIndicator": "pulse",
    "chat.noSuchSlot": "pulse",
    "chat.jumpToBottom": "wiggle"
  },

  // BAD top-level section: not a pack section, skipped with a diagnostic.
  "scripts": { "onUse": "echo hi" }
}
