// Sakura: a cherry-blossom look, two-tone. Blossom pink on a deep plum-black, a painting of almond
// blossom behind glass, soft motion. Try it: `cmux pack check examples/theme-packs/sakura`, then
// `cmux pack use examples/theme-packs/sakura --watch` and edit this file; `cmux pack undo` goes back.
{
  "cmuxPack": 1,
  "id": "cmux/sakura",
  "name": "Sakura",
  "version": "1.0.0",
  "description": "Cherry blossom pink over plum-black, two-tone chrome, glass over a blossom painting.",

  // Everything this pack changes. A key whose capability is not listed here is dropped.
  "capabilities": ["tokens", "colors", "backgrounds", "motion", "fonts", "components"],

  "look": {
    // tokens: the terminal theme the colors below edit, the accent, and the chrome's shape.
    "appearance.theme": "Sakura",
    "appearance.accent": "theme",
    "appearance.chromeStyle": "two-tone",
    "appearance.sidebarSurface": "separate",

    // backgrounds: almond blossom behind frosted glass, tinted by the colors.
    "appearance.background": "van-gogh-almond-blossom",
    "appearance.backgroundOpacity": 0.8,
    "appearance.backgroundBlur": "glass",
    "appearance.wallpaperTint": true,

    // motion: unhurried.
    "ui.animationSpeed": "normal",
    "ui.paneAnimations": true,

    // fonts: the terminal's family and size.
    "terminal.fontFamily": "Menlo",
    "terminal.fontSize": 14,

    // components: the sidebar's shape, a hairline edge, sections as cards.
    "sidebar.style": "standard",
    "sidebar.border": true,
    "sidebar.sectionLook": "card"
  },

  // colors: the terminal theme's own colors. Foreground on background is about 15:1.
  "colors": {
    "background": "#1f1419",
    "foreground": "#f7e8ee",
    "selection": "#5a2e44",
    "accent": "#f4a6c0",
    "cursor": "#ffb7d0"
  },

  // slots: swappable pieces of the UI. The thinking indicator becomes one small swelling mark.
  "slots": { "chat.thinkingIndicator": "pulse" }
}
