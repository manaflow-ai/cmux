{
  "$schema": "../../../cmux-tui/crates/cmux-app-host/schema/v2/cmux-app.schema.json",
  "manifestVersion": 2,
  "id": "local/json-render",
  "name": { "en": "json-render widgets" },
  "version": "0.1.0",
  "description": { "en": "Prototype: an agent describes a widget as a json-render spec made only of this extension's catalog, and cmux draws it with its own kit. A sidebar widget (a todo list an agent made from the catalog, or the one you pinned) and a card for widget parts an agent sends in chat." },
  "publisher": { "name": "cmux examples", "url": "https://cmux.com" },
  "repository": "https://github.com/manaflow-ai/cmux",
  "license": "MIT",
  "icon": { "symbol": "square.grid.2x2" },
  "categories": ["productivity"],
  "keywords": ["json-render", "widget", "agent", "example"],
  "engines": { "cmux": "^2.0" },
  "runtime": { "main": "dist/main.js" },
  "implements": {
    "cmux.chat.widget/1": {
      "export": "renderCard",
      "title": { "en": "Widget" },
      "symbol": "square.grid.2x2",
      "options": { "tools": ["mcp__json_render__show_widget"] }
    },
    "cmux.section/1": {
      "export": "renderSection",
      "title": { "en": "Widget" },
      "symbol": "checklist",
      "options": { "defaultRegion": "bottom", "maxRows": 12 }
    }
  },
  "scopes": {
    "storage:local": "Keep the widget's state (your todos) and the widget you pinned."
  },
  "activation": ["onInterface:cmux.chat.widget/1", "onInterface:cmux.section/1"],
  "files": ["dist/"]
}
