{
  "root": "main",
  "elements": {
    "main": {
      "type": "Panel",
      "props": {
        "title": "Todos"
      },
      "children": [
        "summary",
        "add-row",
        "div",
        "list",
        "empty"
      ]
    },
    "summary": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "spacing": 6
      },
      "children": [
        "count-text",
        "sp",
        "count-badge"
      ]
    },
    "count-text": {
      "type": "Text",
      "props": {
        "text": "Tasks",
        "font": "caption",
        "color": "secondary"
      },
      "children": []
    },
    "sp": {
      "type": "Spacer",
      "props": {},
      "children": []
    },
    "count-badge": {
      "type": "Badge",
      "props": {
        "text": {
          "$template": "${/todos/length}"
        },
        "tone": "accent"
      },
      "children": []
    },
    "add-row": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "spacing": 6
      },
      "children": [
        "new-field",
        "add-btn"
      ]
    },
    "new-field": {
      "type": "TextField",
      "props": {
        "value": {
          "$bindState": "/newTodo"
        },
        "placeholder": "Add a task"
      },
      "on": {
        "submit": {
          "action": "pushState",
          "params": {
            "statePath": "/todos",
            "value": {
              "id": "$id",
              "title": {
                "$state": "/newTodo"
              },
              "done": false
            },
            "clearStatePath": "/newTodo"
          }
        }
      },
      "children": []
    },
    "add-btn": {
      "type": "Button",
      "props": {
        "label": "Add"
      },
      "on": {
        "press": {
          "action": "pushState",
          "params": {
            "statePath": "/todos",
            "value": {
              "id": "$id",
              "title": {
                "$state": "/newTodo"
              },
              "done": false
            },
            "clearStatePath": "/newTodo"
          }
        }
      },
      "children": []
    },
    "div": {
      "type": "Divider",
      "props": {},
      "children": []
    },
    "list": {
      "type": "Stack",
      "props": {
        "spacing": 4
      },
      "repeat": {
        "statePath": "/todos",
        "key": "id"
      },
      "children": [
        "item"
      ]
    },
    "item": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "spacing": 6
      },
      "children": [
        "item-toggle",
        "item-sp",
        "item-del"
      ]
    },
    "item-toggle": {
      "type": "Toggle",
      "props": {
        "checked": {
          "$bindItem": "done"
        },
        "label": {
          "$item": "title"
        }
      },
      "children": []
    },
    "item-sp": {
      "type": "Spacer",
      "props": {},
      "children": []
    },
    "item-del": {
      "type": "Button",
      "props": {
        "label": "✕"
      },
      "on": {
        "press": {
          "action": "removeState",
          "params": {
            "statePath": "/todos",
            "index": {
              "$index": true
            }
          }
        }
      },
      "children": []
    },
    "empty": {
      "type": "Text",
      "props": {
        "text": "All clear. Add a task above.",
        "font": "caption",
        "color": "secondary"
      },
      "visible": {
        "$state": "/todos/length",
        "eq": 0
      },
      "children": []
    }
  },
  "state": {
    "newTodo": "",
    "todos": [
      {
        "id": "1",
        "title": "Review open PRs",
        "done": false
      },
      {
        "id": "2",
        "title": "Write release notes",
        "done": false
      },
      {
        "id": "3",
        "title": "Reply to Aziz",
        "done": true
      },
      {
        "id": "4",
        "title": "Fix sidebar spacing",
        "done": false
      }
    ]
  }
}
