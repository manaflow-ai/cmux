{"op":"add","path":"/root","value":"main"}
{"op":"add","path":"/elements/main","value":{"type":"Panel","props":{"title":"Todos"},"children":["summary","add-row","div","list","empty"]}}
{"op":"add","path":"/elements/summary","value":{"type":"Stack","props":{"direction":"horizontal","spacing":6},"children":["count-text","sp","count-badge"]}}
{"op":"add","path":"/elements/count-text","value":{"type":"Text","props":{"text":"Tasks","font":"caption","color":"secondary"},"children":[]}}
{"op":"add","path":"/elements/sp","value":{"type":"Spacer","props":{},"children":[]}}
{"op":"add","path":"/elements/count-badge","value":{"type":"Badge","props":{"text":{"$template":"${/todos/length}"},"tone":"accent"},"children":[]}}
{"op":"add","path":"/elements/add-row","value":{"type":"Stack","props":{"direction":"horizontal","spacing":6},"children":["new-field","add-btn"]}}
{"op":"add","path":"/elements/new-field","value":{"type":"TextField","props":{"value":{"$bindState":"/newTodo"},"placeholder":"Add a task"},"on":{"submit":{"action":"pushState","params":{"statePath":"/todos","value":{"id":"$id","title":{"$state":"/newTodo"},"done":false},"clearStatePath":"/newTodo"}}},"children":[]}}
{"op":"add","path":"/elements/add-btn","value":{"type":"Button","props":{"label":"Add"},"on":{"press":{"action":"pushState","params":{"statePath":"/todos","value":{"id":"$id","title":{"$state":"/newTodo"},"done":false},"clearStatePath":"/newTodo"}}},"children":[]}}
{"op":"add","path":"/elements/div","value":{"type":"Divider","props":{},"children":[]}}
{"op":"add","path":"/elements/list","value":{"type":"Stack","props":{"spacing":4},"repeat":{"statePath":"/todos","key":"id"},"children":["item"]}}
{"op":"add","path":"/elements/item","value":{"type":"Stack","props":{"direction":"horizontal","spacing":6},"children":["item-toggle","item-sp","item-del"]}}
{"op":"add","path":"/elements/item-toggle","value":{"type":"Toggle","props":{"checked":{"$bindItem":"done"},"label":{"$item":"title"}},"children":[]}}
{"op":"add","path":"/elements/item-sp","value":{"type":"Spacer","props":{},"children":[]}}
{"op":"add","path":"/elements/item-del","value":{"type":"Button","props":{"label":"✕"},"on":{"press":{"action":"removeState","params":{"statePath":"/todos","index":{"$index":true}}}},"children":[]}}
{"op":"add","path":"/elements/empty","value":{"type":"Text","props":{"text":"All clear. Add a task above.","font":"caption","color":"secondary"},"visible":{"$state":"/todos/length","eq":0},"children":[]}}
{"op":"add","path":"/state/newTodo","value":""}
{"op":"add","path":"/state/todos","value":[]}
{"op":"add","path":"/state/todos/0","value":{"id":"1","title":"Review open PRs","done":false}}
{"op":"add","path":"/state/todos/1","value":{"id":"2","title":"Write release notes","done":false}}
{"op":"add","path":"/state/todos/2","value":{"id":"3","title":"Reply to Aziz","done":true}}
{"op":"add","path":"/state/todos/3","value":{"id":"4","title":"Fix sidebar spacing","done":false}}
