{
  "$schema": "../../../cmux-tui/crates/cmux-app-host/schema/v2/cmux-app.schema.json",
  "manifestVersion": 2,
  "id": "local/showcase-newtab-clock",
  "name": { "en": "Clock" },
  "version": "1.0.0",
  "description": { "en": "An example extension built only on cmux-extension-sdk: the time and date on every new tab, picked in tabs.newTabApp." },
  "publisher": { "name": "cmux examples", "url": "https://cmux.com" },
  "repository": "https://github.com/manaflow-ai/cmux",
  "license": "MIT",
  "icon": { "symbol": "clock" },
  "categories": ["productivity", "samples"],
  "keywords": ["clock", "new tab", "example"],
  "engines": { "cmux": "^2.0" },
  "runtime": { "main": "dist/main.js" },
  "implements": {
    "cmux.newtab/1": {
      "export": "renderNewTab",
      "title": { "en": "Clock" },
      "symbol": "clock"
    }
  },
  "scopes": {},
  "activation": ["onInterface:cmux.newtab/1"],
  "files": ["dist/"]
}
