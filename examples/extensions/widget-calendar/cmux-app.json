{
  "$schema": "../../../cmux-tui/crates/cmux-app-host/schema/v2/cmux-app.schema.json",
  "manifestVersion": 2,
  "id": "local/widget-calendar",
  "name": { "en": "Calendar widget" },
  "version": "1.0.0",
  "description": { "en": "Today's date and your next events from the calendars on this Mac, as a widget card in the sidebar, small, medium or large." },
  "publisher": { "name": "cmux examples", "url": "https://cmux.com" },
  "repository": "https://github.com/manaflow-ai/cmux",
  "license": "MIT",
  "icon": { "symbol": "calendar" },
  "categories": ["sidebar"],
  "keywords": ["widget", "calendar", "events", "meetings"],
  "engines": { "cmux": "^2.0" },
  "runtime": { "main": "dist/main.js" },
  "implements": {
    "cmux.section/1": {
      "export": "renderCalendar",
      "title": { "en": "Calendar" },
      "symbol": "calendar",
      "options": { "defaultRegion": "bottom", "maxRows": 12 }
    }
  },
  "scopes": {
    "system_calendar:read": "Show your upcoming events from the calendars on this Mac."
  },
  "settings": {
    "type": "object",
    "properties": {
      "size": { "type": "string", "title": "Size", "enum": ["small", "medium", "large"], "default": "small" },
      "hour12": { "type": "boolean", "title": "12-hour times", "default": false }
    }
  },
  "activation": ["onInterface:cmux.section/1"],
  "files": ["dist/"]
}
