{
  "$schema": "../../../cmux-tui/crates/cmux-app-host/schema/v2/cmux-app.schema.json",
  "manifestVersion": 2,
  "id": "local/showcase-agent-standup",
  "name": { "en": "Standup" },
  "version": "1.0.0",
  "description": { "en": "A sidebar summary of the last day: chats finished, still working and waiting for you, then each project with the chats that changed in it. Click a chat to open it." },
  "tagline": { "en": "What your agents did since yesterday, by project" },
  "publisher": { "name": "cmux examples", "url": "https://cmux.com" },
  "repository": "https://github.com/manaflow-ai/cmux",
  "license": "MIT",
  "icon": { "symbol": "list.bullet.clipboard" },
  "categories": ["sidebar"],
  "keywords": ["standup", "agents", "chats", "example"],
  "engines": { "cmux": "^2.0" },
  "runtime": { "main": "dist/main.js" },
  "implements": {
    "cmux.section/1": {
      "export": "renderStandup",
      "title": { "en": "Standup" },
      "symbol": "list.bullet.clipboard",
      "options": { "defaultRegion": "bottom", "maxRows": 14 }
    }
  },
  "scopes": {
    "agent_chat:read": "See your agent chats, their state and when they last changed.",
    "actions:run": "Open a chat when you click it."
  },
  "settings": {
    "type": "object",
    "properties": {
      "hours": { "type": "integer", "title": "Look back (hours)", "minimum": 1, "maximum": 168, "default": 24 }
    }
  },
  "activation": ["onInterface:cmux.section/1"],
  "files": ["dist/"]
}
