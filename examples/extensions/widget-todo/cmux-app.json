{
  "$schema": "../../../cmux-tui/crates/cmux-app-host/schema/v2/cmux-app.schema.json",
  "manifestVersion": 2,
  "id": "local/widget-todo",
  "name": { "en": "To-do widget" },
  "version": "1.0.0",
  "description": { "en": "Your to-do list as a widget card in the sidebar: add, tick, edit and clear, small, medium or large. Kept on this Mac." },
  "publisher": { "name": "cmux examples", "url": "https://cmux.com" },
  "repository": "https://github.com/manaflow-ai/cmux",
  "license": "MIT",
  "icon": { "symbol": "checklist" },
  "categories": ["sidebar"],
  "keywords": ["widget", "to-do", "todo", "tasks", "checklist"],
  "engines": { "cmux": "^2.0" },
  "runtime": { "main": "dist/main.js" },
  "implements": {
    "cmux.section/1": {
      "export": "renderTodo",
      "title": { "en": "To-do" },
      "symbol": "checklist",
      "options": { "defaultRegion": "bottom", "maxRows": 12 }
    }
  },
  "scopes": {
    "storage:local": "Keep your to-do list on this Mac."
  },
  "settings": {
    "type": "object",
    "properties": {
      "size": { "type": "string", "title": "Size", "enum": ["small", "medium", "large"], "default": "medium" }
    }
  },
  "activation": ["onInterface:cmux.section/1"],
  "files": ["dist/"]
}
