{
  "$schema": "../../../cmux-tui/crates/cmux-app-host/schema/v2/cmux-app.schema.json",
  "manifestVersion": 2,
  "id": "local/widget-clock",
  "name": { "en": "Clock widget" },
  "version": "1.0.0",
  "description": { "en": "The time and the date as a widget card in the sidebar, small, medium or large, with the cities you work with." },
  "publisher": { "name": "cmux examples", "url": "https://cmux.com" },
  "repository": "https://github.com/manaflow-ai/cmux",
  "license": "MIT",
  "icon": { "symbol": "clock" },
  "categories": ["sidebar"],
  "keywords": ["widget", "clock", "time", "time zones"],
  "engines": { "cmux": "^2.0" },
  "runtime": { "main": "dist/main.js" },
  "implements": {
    "cmux.section/1": {
      "export": "renderClock",
      "title": { "en": "Clock" },
      "symbol": "clock",
      "options": { "defaultRegion": "bottom", "maxRows": 8 }
    }
  },
  "scopes": {},
  "settings": {
    "type": "object",
    "properties": {
      "size": { "type": "string", "title": "Size", "enum": ["small", "medium", "large"], "default": "small" },
      "zones": { "type": "string", "title": "Cities", "description": "Time zones for the medium and large sizes, IANA names separated by commas, for example Europe/London, Asia/Tokyo.", "default": "America/New_York, Europe/London, Asia/Tokyo" },
      "hour12": { "type": "boolean", "title": "12-hour clock", "default": false }
    }
  },
  "activation": ["onInterface:cmux.section/1"],
  "files": ["dist/"]
}
