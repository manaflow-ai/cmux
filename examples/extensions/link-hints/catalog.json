{
  "family": "local.link_hints",
  "owner": "app:local/link-hints",
  "operations": [
    {
      "name": "local.link_hints.follow",
      "owner": "app:local/link-hints",
      "class": "mutation",
      "risk": "mutate-own",
      "idempotency": "forbidden",
      "focuses": false,
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "tab": { "type": "string", "description": "The browser tab; cmux passes it for a page key. The focused tab when absent." } },
        "required": []
      },
      "cli": { "path": "follow", "visible": true },
      "mcp": { "expose": "never" },
      "palette": { "title": { "en": "Link Hints: Follow a Link" } },
      "keyboard": [{ "key": "f", "when": "browserFocused" }],
      "docs": "Label every link and button on screen; typing a label follows it, and Shift on its last letter opens it in a new tab.",
      "since": "local.link_hints/1",
      "export": "followLink"
    }
,
