{
  "//": "In this repository the SDK resolves from source, so the example builds with no install. Outside it, `npm install cmux-extension-sdk` and drop `paths`.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "paths": { "cmux-extension-sdk": ["../../../cmux-tui/crates/cmux-extension-sdk/typescript/src/index.ts"] }
  },
  "include": ["src"]
}
