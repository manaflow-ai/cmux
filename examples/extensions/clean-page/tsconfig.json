{
  "//": "In this repository the SDK resolves from source, so the example builds and tests with no install. Outside it, `npm install cmux-extension-sdk` and drop `paths`.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "paths": {
      "cmux-extension-sdk": ["../../../cmux-tui/crates/cmux-extension-sdk/typescript/src/index.ts"],
      "cmux-extension-sdk/testing": ["../../../cmux-tui/crates/cmux-extension-sdk/typescript/src/testing.ts"]
    }
  },
  "include": ["src", "test"]
}
