// The look's theme file: colors, surfaces, borders and density (docs/cmux-next/theme-recipes.md).
// `appearance.themeFile` in cmux-setup.json picks it by name.
{
  "name": "My Look",
  "description": "Say in one line what it looks like.",

  "appearance.theme": "Builtin Dark",
  "colors": { "background": "#111113", "foreground": "#e4e4e7", "selection": "#2a2a2e", "accent": "#a1a1aa" },

  "appearance.background": "none",
  "appearance.density": "compact"
}
