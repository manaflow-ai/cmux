{
  // A look's own thinking dots: a cmux.particles/1 document kept as a file of the look and named
  // with {"$file": PATH}. Installing the look reads the file into agentPane.display.thinking.glyph. Needs cmux#47525.
  "cmuxSetup": 1,
  "id": "manaflow-ai/starter-thinking-dots",
  "name": "Starter Thinking Dots",
  "tagline": "Three dots pulse while agents work.",
  "description": "Three dots pulse while agents work.",
  "version": "1.0.0",
  "license": "MIT",
  "cmuxProfile": 1,
  "settings": {
    "agentPane.display.thinking.glyph": { "$file": "agent-pane/thinking-glyph.json" },
    "agentPane.display.thinking.glyphSize": 2.4,
    "agentPane.display.thinking.jumpButton": "glyph"
  }
}
