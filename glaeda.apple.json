{
  "schema_version": 1,
  "profiles": {
    "ci-compile-admission": {
      "engine": "script",
      "sdk": "macosx",
      "executable": "scripts/ci/persistent-mac-semantic-entrypoint.sh",
      "arguments": [
        "{products}/semantic-state",
        "{products}/semantic-result.json"
      ],
      "environment": {
        "CMUX_CI_MODULE_CACHE_PATH": "{module_cache}",
        "CMUX_SKIP_ZIG_BUILD": "1"
      }
    }
  },
  "cache_policies": {
    "ci-compile-admission": "native"
  }
}
