{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "lib": ["ES2022"]
  },
  "include": ["packages/*/src", "packages/*/tests", "host/src", "host/tests"]
}
