# Xcode
.build/
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcworkspace/xcshareddata/

# macOS
.DS_Store

# Local env
.env
.envrc
!web/.envrc
ios/Config/AppStoreConnect.local.plist

# Swift Package Manager
.swiftpm/
.ci-source-packages/
.ci-reload-derived-data/
.glaeda/

# GhosttyKit binary (built from ghostty submodule via scripts/setup.sh)
GhosttyKit.xcframework
GhosttyKit.xcframework.bak-*/

# Release artifacts
cmux-*.zip
cmux-macos.dmg
appcast.xml

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.hypothesis/
.vercel

# Zig
.zig-cache/
zig-out/

# Node
node_modules/
.next/

# Test outputs
tests/visual_output/
tests/visual_report.html
experiments/*/target/

# Stale pre-rebrand Rust TUI build dir (renamed to cmux-tui/; old checkouts may
# still have an untracked mux/target). mux/ itself is the mux brain host.
/mux/target/

# Generated docs search index
web/.pagefind-site/
web/public/pagefind/

# Local scratch (screenshots, etc.)
tmp/
tmp-*/
.iter-logs/
.claude/worktrees/
.claude/scheduled_tasks.lock

# Local dogfood scratch (screenshots, recordings) — never commit
artifacts/

# tmux verbose debug logs (tmux -v) that land in the cwd
tmux-*.log

# Remote-only Blacksmith cmux-tui benchmark output
/testbox-benchmark/
/.cmux-scratch/

# Local-only prototype and deploy state
/Prototypes/*-clone/
/.cloudflare/
# Locally downloaded prebuilt client for Packages/Shared/CmuxTerminalClient
Packages/Shared/CmuxTerminalClient/CmuxTerminalClient.xcframework/

# The settings export stamp is derived, never committed (Leo 2026-10-21):
# scripts/ci/defaults_guard.py source-stamp --ref REF prints it for any commit.
/schemas/settings-export/
# The cmux-next web bundle stamp (scripts/cmux-next/build-web-bundles.sh).
/.web-bundles.key
/.web-bundles.key.tmp
# The cmux-next web bundles: build output of scripts/cmux-next/build-web-bundles.sh
# (cx-vn5). Each resource directory keeps its GENERATED.md placeholder.
/Packages/macOS/CmuxNext/Sources/CmuxNextAgentPane/Resources/agent-pane/*
!/Packages/macOS/CmuxNext/Sources/CmuxNextAgentPane/Resources/agent-pane/GENERATED.md
/Packages/macOS/CmuxNext/Sources/CmuxNextPages/Resources/pages/*
!/Packages/macOS/CmuxNext/Sources/CmuxNextPages/Resources/pages/GENERATED.md
/Packages/macOS/CmuxNext/Sources/CmuxNextAgentActivity/Resources/agent-activity/*
!/Packages/macOS/CmuxNext/Sources/CmuxNextAgentActivity/Resources/agent-activity/GENERATED.md
/Packages/macOS/CmuxNext/Sources/CmuxNextPalette/Resources/palette-ranker.js
/Resources/markdown-viewer/webviews-app/
# The React pages' strings tables: build output of webviews/scripts/pages/gen-strings.mjs, written
# by bun install, the webviews test preload and every bundle build from the xcstrings catalogs
# (#21946). Committed copies collided in every pull request that touched a catalog.
/webviews/src/**/generated/strings.json
/webviews/src/ui/featureTips/tips.generated.json
/webviews/src/pages/home-channels/generated/pane-strings.json
/webviews/src/pages/changelog/generated/pane-strings.json
/webviews/src/pages/diff/generated/locales/
/webviews/src/pages/diff/generated/localeLoaders.ts
/webviews/src/**/generated/*.tmp

# nested-groups prototype gallery output
Packages/macOS/CmuxNext/nested-groups-gallery/
Packages/macOS/CmuxNext/nested-groups-gallery.tar
Packages/macOS/CmuxNext/group-line-gallery/
Packages/macOS/CmuxNext/group-line-gallery.tar
Packages/macOS/CmuxNext/ws-no-color-gallery/
Packages/macOS/CmuxNext/ws-no-color-gallery.tar
Packages/macOS/CmuxNext/group-header-gallery/
Packages/macOS/CmuxNext/group-header-gallery.tar
Packages/macOS/CmuxNext/machine-link-gallery/
Packages/macOS/CmuxNext/machine-link-gallery.tar
Packages/macOS/CmuxNext/sidebar-look-gallery/
Packages/macOS/CmuxNext/sidebar-look-gallery.tar
Packages/macOS/CmuxNext/machines-section-gallery/
Packages/macOS/CmuxNext/machines-section-gallery.tar
Packages/macOS/CmuxNext/usage-warning-gallery/
Packages/macOS/CmuxNext/usage-warning-gallery.tar

# Spotlight exclusion marker that scripts/measure/quiet-host.sh writes in a fleet checkout
.metadata_never_index
