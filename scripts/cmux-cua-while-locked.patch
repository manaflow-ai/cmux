+/// type_text's default.
+const LOCKED_TYPE_DELAY_MS: u64 = 30;
+
+/// `type_text` on a locked screen: each character as a key down/up pair
+/// posted to `pid` (never the HID tap), with no Accessibility insert,
+/// focus write or read-back. Nothing can confirm it landed: the result says
+/// to look at the next `get_app_state` screenshot.
+async fn type_text_as_pid_keys(pid: i32, text: String, gate: NativeDispatchGate) -> ToolResult {
+    let text =
+        cmux_cua_core::text_sanitize::strip_trailing_agent_protocol_tags(&text).into_owned();
+    let characters = text.chars().count();
+    let posted = tokio::task::spawn_blocking(move || {
+        crate::input::keyboard::type_text_with_delay_guarded(
+            pid,
+            &text,
+            LOCKED_TYPE_DELAY_MS,
+            &gate,
+        )
+    })
+    .await;
+    match posted {
+        Ok(Ok(())) => ToolResult::text(format!(
+            "Typed {characters} char(s) as key events posted to pid {pid}. The screen is locked, \
+             so the text went in as keystrokes, not through Accessibility; check the next \
+             get_app_state screenshot to confirm it landed."
+        ))
+        .with_structured(json!({
+            "path": "key_events",
+            "characters": characters,
+            "verified": false,
+            "effect": "unverifiable",
+        })),
+        Ok(Err(error)) => ToolResult::error(format!("type_text failed: {error}")),
+        Err(error) => ToolResult::error(format!("type_text task failed: {error}")),
+    }
+}
