+/// What a compatibility call touches, for a locked screen
+/// (`computerUse.whileLocked`). On a locked Mac the desktop, the global HID
+/// event stream and the frontmost app belong to the lock screen: a keystroke
+/// posted there would type into its password field. One app's window does
+/// not: its picture comes from its own backing store (window-id capture) and
+/// input reaches it posted to its pid or through Accessibility.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum LockedRoute {
+    /// Reads what this Mac runs, with no picture and no input.
+    Inventory,
+    /// One app's window, by pid and window id: a window capture, input
+    /// posted to the pid, or an Accessibility action on that app.
+    Window,
+    /// The global HID tap, the real cursor or the frontmost app.
+    Shared,
+}
+
+fn locked_route(kind: CompatKind, args: &Value) -> LockedRoute {
+    let foreground = args.get("delivery_mode").and_then(Value::as_str) == Some("foreground");
+    match kind {
+        CompatKind::ListApps => LockedRoute::Inventory,
+        // A capture of the app's key window by its id. Launching an app that
+        // is not running activates it: that sink refuses on its own
+        // (`guarded_app_launch`).
+        CompatKind::GetAppState => LockedRoute::Window,
+        // Background clicks post to the pid; `foreground` fronts the window.
+        CompatKind::Click if foreground => LockedRoute::Shared,
+        CompatKind::Click => LockedRoute::Window,
+        // macOS has no background drag: the only drag that posts is the
+        // foreground one, through the HID tap with the app activated.
+        CompatKind::Drag => LockedRoute::Shared,
+        // Accessibility on the snapshot's app, or keys and wheel events
+        // posted to its pid.
+        CompatKind::PerformSecondaryAction
+        | CompatKind::SelectText
+        | CompatKind::SetValue
+        | CompatKind::PressKey
+        | CompatKind::TypeText
+        | CompatKind::Scroll => LockedRoute::Window,
+    }
+}
