+/// Post a mouse event to `pid` through one path: SkyLight's `SLEventPostToPid` (mouse events
+/// carry no auth envelope), or `CGEvent::post_to_pid` only when that SPI is absent, as
+/// `keyboard.rs` posts keys.
+///
+/// Posting through both delivered each click twice to AppKit and Electron targets. cmux's input
+/// A/B (scripts/measure/cu-driver-eval, macOS 26.5.2, 3 reps, these stamped fields) measured
+/// each path alone: either one delivered every click and scroll the pair delivered, in the
+/// background without a focus change and in the foreground, once.
+fn post_mouse_once(pid: i32, event: &CGEvent) {
+    let event_ptr = event.as_ptr() as *mut std::ffi::c_void;
+    if !crate::input::skylight::post_to_pid(pid as libc::pid_t, event_ptr, false) {
+        event.post_to_pid(pid as libc::pid_t);
+    }
+}
