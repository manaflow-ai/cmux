{
 "row": "p08-10",
 "toggle": "browserLaunchPictures",
 "inner": "launch",
 "runs": 5,
 "run_timeout": 1800,
 "metric": [
  "first_frame=\\.(cold|warm)\\.\\*\\.first_window_frame_committed$",
  "first_terminal=\\.(cold|warm)\\.\\*\\.first_terminal_frame$"
 ],
 "validity": [],
 "probe": [
  {
   "name": "launch picture shown over a restored browser pane",
   "method": "debug.timings",
   "params": {},
   "regex": "^launch_ms_since_process_start\\.browser\\.launch_picture_shown$",
   "min": 1
  }
 ],
 "inner_args": [
  "--mode",
  "cold",
  "--mode",
  "warm",
  "--runs",
  "1",
  "--profile",
  "realistic"
 ]
}