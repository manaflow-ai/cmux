{
 "row": "p14-07",
 "toggle": "energySaver",
 "inner": "idle-budget",
 "runs": 5,
 "run_timeout": 1800,
 "metric": [
  "wakeups=^sessions\\.[\\w-]+\\.kinds\\.[\\w-]+\\.wakeups_per_s$",
  "main_wakes=^sessions\\.[\\w-]+\\.kinds\\.app\\.main_wakes_per_s$",
  "cpu=^sessions\\.[\\w-]+\\.kinds\\.[\\w-]+\\.cpu_pct$"
 ],
 "validity": [],
 "probe": [
  {
   "name": "Energy Saver policy active (frame cap set)",
   "method": "debug.energy",
   "params": {},
   "regex": "^policy\\.ambientMaxFPS$",
   "min": 1
  }
 ],
 "inner_args": [
  "--sessions=light,light-hidden",
  "--settle=60"
 ]
}