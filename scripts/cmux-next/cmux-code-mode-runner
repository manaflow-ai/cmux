#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
bun=$(command -v bun || true)
[ -n "$bun" ] || { echo 'cmux run: bun is required' >&2; exit 2; }
if [ -d "$root/cmux-tui/bindings/typescript" ]; then
  sdk="$root/cmux-tui/bindings/typescript"
elif [ -d "$root/Resources/code-mode/sdk" ]; then
  sdk="$root/Resources/code-mode/sdk"
else
  sdk="$root/code-mode/sdk"
fi
worker="$(dirname -- "$0")/cmux-code-mode-sandbox"
exec "$bun" "$sdk/code-mode/supervise.mjs" "$worker" "$@"
