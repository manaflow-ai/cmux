{
  "comment": "Every Mach-O file in a cmux-next app bundle maps to the notices it needs. check_bundle_notices.py fails on a Mach-O that no entry matches and on a missing notice. Requirements: first-party (Contents/Resources/LICENSE), section:<id> (a `<!-- notices-section: <id> -->` marker in Contents/Resources/THIRD_PARTY_LICENSES.md), file:<bundle path> (a non-empty file). Paths are fnmatch patterns relative to the .app; `*` also matches `/`. Add an entry in the same change that adds a binary.",
  "entries": [
    {
      "path": "Contents/MacOS/cmux",
      "what": "the app: Swift packages, GhosttyKit (static), iroh-ffi Swift bindings, Sparkle client",
      "notices": ["first-party", "section:manual-swift-package-dependencies", "section:manual-ghostty", "section:manual-sparkle"]
    },
    {
      "path": "Contents/Frameworks/Sparkle.framework/*",
      "what": "Sparkle framework, Autoupdate and Updater.app",
      "notices": ["section:manual-sparkle"]
    },
    {
      "path": "Contents/Frameworks/Iroh.framework/*",
      "what": "iroh-ffi (Rust), manaflow-ai/iroh-ffi at the Package.resolved revision",
      "notices": ["section:rust-iroh-ffi"]
    },
    {
      "path": "Contents/Frameworks/Chromium Embedded Framework.framework/*",
      "what": "CEF and Chromium, including libcef_sandbox, SwiftShader and the Vulkan loader",
      "notices": ["file:Contents/Frameworks/Chromium Embedded Framework.framework/Resources/CREDITS.html", "file:Contents/Frameworks/Chromium Embedded Framework.framework/Resources/LICENSE.txt"]
    },
    {
      "path": "Contents/Frameworks/libcmux_cef_shim.dylib",
      "what": "first-party CEF shim (links CEF)",
      "notices": ["first-party", "file:Contents/Frameworks/Chromium Embedded Framework.framework/Resources/CREDITS.html", "file:Contents/Frameworks/Chromium Embedded Framework.framework/Resources/LICENSE.txt"]
    },
    {
      "path": "Contents/Frameworks/cmux Helper*.app/Contents/MacOS/*",
      "what": "first-party CEF helper processes (link CEF)",
      "notices": ["first-party", "file:Contents/Frameworks/Chromium Embedded Framework.framework/Resources/CREDITS.html", "file:Contents/Frameworks/Chromium Embedded Framework.framework/Resources/LICENSE.txt"]
    },
    {
      "path": "Contents/Resources/bin/cmux",
      "what": "the cmux CLI and daemon (cmux-tui crates; acpmux is linked in)",
      "notices": ["first-party", "section:rust-cmux-cli"]
    },
    {
      "path": "Contents/Resources/bin/cmux-tui-ssh/cmux-tui-*",
      "what": "the same cmux-tui binary for remote hosts",
      "notices": ["first-party", "section:rust-cmux-cli"]
    },
    {
      "path": "Contents/Resources/bin/cmux-app-host",
      "what": "app host (cmux-tui crate cmux-app-host)",
      "notices": ["first-party", "section:rust-cmux-app-host"]
    },
    {
      "path": "Contents/Resources/bin/cmux-cloud",
      "what": "first-party Cloud app server (first-party-apps/cloud/server)",
      "notices": ["first-party", "section:rust-cmux-cloud"]
    },
    {
      "path": "Contents/Resources/bin/cmux-diff-sidecar",
      "what": "diff viewer sidecar (Native/DiffSidecar)",
      "notices": ["first-party", "section:rust-cmux-diff-sidecar"]
    },
    {
      "path": "Contents/Resources/bin/ghostty",
      "what": "Ghostty CLI helper (Zig); the Zig package notices follow in S5",
      "notices": ["section:manual-ghostty"]
    },
    {
      "path": "Contents/Resources/libexec/cmux-server-helper",
      "what": "first-party server helper (Swift, no third-party code)",
      "notices": ["first-party"]
    }
  ],
  "resources": [
    {
      "path": "Contents/Resources/ghostty/themes",
      "what": "Ghostty themes from iTerm2-Color-Schemes (Resources/ghostty/themes, or Ghostty's zig-out share)",
      "notices": ["section:ghostty-themes"]
    }
  ]
