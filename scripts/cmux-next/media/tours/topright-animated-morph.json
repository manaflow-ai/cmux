{
  "title": "Chat header icons, morph: an opening click turns the glyph into the pane's tab",
  "steps": [
    {
      "title": "Launch",
      "wait": 2,
      "shot": false
    },
    {
      "title": "Header motion animated-morph",
      "rpc": {
        "method": "debug.tunables",
        "params": {
          "action": "set",
          "key": "agentChat.headerMotion",
          "value": "animated-morph"
        }
      },
      "wait": 0.5,
      "shot": false
    },
    {
      "title": "Light appearance",
      "rpc": {
        "method": "debug.appearance",
        "params": {
          "mode": "light"
        }
      },
      "wait": 1,
      "shot": false,
      "optional": "debug.appearance is DEBUG only"
    },
    {
      "title": "New workspace",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "Header motion"
      ],
      "wait": 1,
      "shot": false
    },
    {
      "title": "Open agent chat",
      "rpc": {
        "method": "action.run",
        "params": {
          "action": "palette.newAgentChat",
          "focus": true
        }
      },
      "wait": 6,
      "shot": false
    },
    {
      "title": "light: the header at rest, nothing moves",
      "wait": 1
    },
    {
      "title": "light: a turn that edited three files: Changes arrives, its dot shows changes are waiting",
      "rpc": {
        "method": "debug.agent_pane",
        "params": {
          "action": "seed_rows",
          "fixture": "worked-turn"
        }
      },
      "wait": 0.12,
      "optional": "debug.agent_pane is DEBUG only"
    },
    {
      "title": "light: settled",
      "wait": 1
    },
    {
      "title": "light: click Terminal: its plate grows out of the glyph and the glyph flies to the pane's edge as its tab",
      "rpc": {
        "method": "debug.agent_pane",
        "params": {
          "action": "click",
          "selector": "[data-quick-action=\"terminal\"]"
        }
      },
      "wait": 0.12,
      "optional": "debug.agent_pane is DEBUG only"
    },
    {
      "title": "light: Terminal open, its plate on",
      "wait": 1.5
    },
    {
      "title": "Dark appearance",
      "rpc": {
        "method": "debug.appearance",
        "params": {
          "mode": "dark"
        }
      },
      "wait": 1,
      "shot": false,
      "optional": "debug.appearance is DEBUG only"
    },
    {
      "title": "Open agent chat",
      "rpc": {
        "method": "action.run",
        "params": {
          "action": "palette.newAgentChat",
          "focus": true
        }
      },
      "wait": 6,
      "shot": false
    },
    {
      "title": "dark: the header at rest, nothing moves",
      "wait": 1
    },
    {
      "title": "dark: a turn that edited three files: Changes arrives, its dot shows changes are waiting",
      "rpc": {
        "method": "debug.agent_pane",
        "params": {
          "action": "seed_rows",
          "fixture": "worked-turn"
        }
      },
      "wait": 0.12,
      "optional": "debug.agent_pane is DEBUG only"
    },
    {
      "title": "dark: settled",
      "wait": 1
    },
    {
      "title": "dark: click Terminal: its plate grows out of the glyph and the glyph flies to the pane's edge as its tab",
      "rpc": {
        "method": "debug.agent_pane",
        "params": {
          "action": "click",
          "selector": "[data-quick-action=\"terminal\"]"
        }
      },
      "wait": 0.12,
      "optional": "debug.agent_pane is DEBUG only"
    },
    {
      "title": "dark: Terminal open, its plate on",
      "wait": 1.5
    },
    {
      "title": "Back to the system appearance",
      "rpc": {
        "method": "debug.appearance",
        "params": {
          "mode": "system"
        }
      },
      "wait": 1,
      "shot": false,
      "optional": "debug.appearance is DEBUG only"
    },
    {
      "title": "Header motion back to still",
      "rpc": {
        "method": "debug.tunables",
        "params": {
          "action": "set",
          "key": "agentChat.headerMotion",
          "value": "still"
        }
      },
      "wait": 0.5,
      "shot": false
    }
  ]
}
