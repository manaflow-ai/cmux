{
 "title": "New Tab (native page): \"split\" in the dropdown",
 "settings": {
  "tabs": {
   "nativeNewTabPage": true
  }
 },
 "steps": [
  {
   "title": "Launch",
   "wait": 2,
   "shot": false
  },
  {
   "title": "New workspace",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Tour"
   ],
   "shot": false
  },
  {
   "title": "Show the Tour workspace",
   "cmux": [
    "workspace",
    "name:Tour",
    "focus"
   ],
   "wait": 1.5,
   "shot": false
  },
  {
   "title": "New Tab (Cmd-T)",
   "wait": 2.5,
   "shot": false,
   "rpc": {
    "method": "debug.key",
    "params": {
     "key": "t",
     "modifiers": [
      "command"
     ]
    }
   }
  },
  {
   "title": "Type s",
   "rpc": {
    "method": "debug.key",
    "params": {
     "key": "s"
    }
   },
   "wait": 0.2,
   "shot": false
  },
  {
   "title": "Type p",
   "rpc": {
    "method": "debug.key",
    "params": {
     "key": "p"
    }
   },
   "wait": 0.2,
   "shot": false
  },
  {
   "title": "Type l",
   "rpc": {
    "method": "debug.key",
    "params": {
     "key": "l"
    }
   },
   "wait": 0.2,
   "shot": false
  },
  {
   "title": "Type i",
   "rpc": {
    "method": "debug.key",
    "params": {
     "key": "i"
    }
   },
   "wait": 0.2,
   "shot": false
  },
  {
   "title": "Type t",
   "rpc": {
    "method": "debug.key",
    "params": {
     "key": "t"
    }
   },
   "wait": 1.5,
   "shot": false
  },
  {
   "title": "Native New Tab: \"split\" in the dropdown",
   "wait": 0.5
  }
 ]
}
