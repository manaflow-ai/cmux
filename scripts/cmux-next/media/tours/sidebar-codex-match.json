{
 "title": "Sidebar matches the Codex sidebar at Default density (#39956): rows, inks, headings, surface",
 "steps": [
  {
   "title": "Launch",
   "wait": 3
  },
  {
   "title": "Workspace Work on the sidebar",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Work on the sidebar"
   ],
   "shot": false,
   "wait": 0.5
  },
  {
   "title": "Workspace Visible files list",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Visible files list"
   ],
   "shot": false,
   "wait": 0.5
  },
  {
   "title": "Workspace Casual check-in",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Casual check-in"
   ],
   "shot": false,
   "wait": 0.5
  },
  {
   "title": "Workspace Review two pull requests",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Review two pull requests"
   ],
   "shot": false,
   "wait": 0.5
  },
  {
   "title": "Workspace Capabilities overview",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Capabilities overview"
   ],
   "shot": false,
   "wait": 0.5
  },
  {
   "title": "Workspace Architecture refactor summary",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Architecture refactor summary"
   ],
   "shot": false,
   "wait": 0.5
  },
  {
   "title": "Workspace Fix split node parity",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Fix split node parity"
   ],
   "shot": false,
   "wait": 0.5
  },
  {
   "title": "Workspace Speed up parity gates",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Speed up parity gates"
   ],
   "shot": false,
   "wait": 0.5
  },
  {
   "title": "Workspace Find a session ID",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Find a session ID"
   ],
   "shot": false,
   "wait": 0.5
  },
  {
   "title": "Workspace Window tiling support",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Window tiling support"
   ],
   "shot": false,
   "wait": 0.5
  },
  {
   "title": "Dark",
   "rpc": {
    "method": "debug.appearance",
    "params": {
     "mode": "dark"
    }
   },
   "wait": 1,
   "shot": false,
   "optional": "debug.appearance is DEBUG only"
  },
  {
   "title": "Dark, Default density: Codex rows (30 pt, no gap, 8 pt padding, 10 pt corner), soft titles, Workspaces heading, dimmed sidebar",
   "wait": 2
  },
  {
   "title": "Dark, no Workspaces heading (sidebar.listHeading off)",
   "rpc": {
    "method": "debug.tunables",
    "params": {
     "action": "set",
     "key": "sidebar.listHeading",
     "value": false
    }
   },
   "wait": 2,
   "optional": "debug.tunables is DEBUG only"
  },
  {
   "title": "Dark, no sidebar dim (sidebar.surfaceDim.dark 0)",
   "rpc": {
    "method": "debug.tunables",
    "params": {
     "action": "set",
     "key": "sidebar.surfaceDim.dark",
     "value": 0
    }
   },
   "wait": 2,
   "optional": "debug.tunables is DEBUG only"
  },
  {
   "title": "Restore tunables",
   "rpc": {
    "method": "debug.tunables",
    "params": {
     "action": "reset",
     "section": "sidebar"
    }
   },
   "wait": 1,
   "shot": false,
   "optional": "debug.tunables is DEBUG only"
  },
  {
   "title": "Dark, Compact density keeps its own rows (24 pt + 2 pt gap)",
   "cmux": [
    "settings",
    "set",
    "appearance.density",
    "compact"
   ],
   "wait": 2
  },
  {
   "title": "Back to Default density",
   "cmux": [
    "settings",
    "unset",
    "appearance.density"
   ],
   "wait": 1,
   "shot": false
  },
  {
   "title": "Light",
   "rpc": {
    "method": "debug.appearance",
    "params": {
     "mode": "light"
    }
   },
   "wait": 1,
   "shot": false,
   "optional": "debug.appearance is DEBUG only"
  },
  {
   "title": "Light, Default density: Codex rows, soft titles, Workspaces heading, dimmed sidebar",
   "wait": 2
  },
  {
   "title": "Back to the system appearance",
   "rpc": {
    "method": "debug.appearance",
    "params": {
     "mode": "system"
    }
   },
   "wait": 1,
   "shot": false,
   "optional": "debug.appearance is DEBUG only"
  }
 ]
}
