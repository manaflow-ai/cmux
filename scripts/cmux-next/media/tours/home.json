{
  "title": "Home list header (its widths are the home.messages-list gallery entry)",
  "steps": [
    {"title": "Launch", "wait": 2, "shot": false},
    {"title": "Go to Home", "cmux": ["action", "run", "home.show"], "wait": 3, "shot": false, "optional": "Home needs its page in this build"},
    {"title": "Dark", "rpc": {"method": "debug.appearance", "params": {"mode": "dark"}}, "wait": 2, "shot": false},
    {"title": "Dark: header row at rest", "wait": 1},
    {"title": "Dark: search focused", "rpc": {"method": "debug.page", "params": {"page": "cmux.home-messages", "action": "click", "selector": ".hm-search input"}}, "wait": 1.5, "optional": "debug.page is DEBUG only"},
    {"title": "Dark: Unread only", "rpc": {"method": "debug.page", "params": {"page": "cmux.home-messages", "action": "click", "selector": ".hm-header .hm-circle[aria-pressed]"}}, "wait": 1.5, "optional": "debug.page is DEBUG only"},
    {"title": "Dark: All again", "rpc": {"method": "debug.page", "params": {"page": "cmux.home-messages", "action": "click", "selector": ".hm-header .hm-circle[aria-pressed]"}}, "wait": 1, "shot": false, "optional": "debug.page is DEBUG only"},
    {"title": "Light", "rpc": {"method": "debug.appearance", "params": {"mode": "light"}}, "wait": 2, "shot": false},
    {"title": "Light: header row at rest", "wait": 1},
    {"title": "Light: search focused", "rpc": {"method": "debug.page", "params": {"page": "cmux.home-messages", "action": "click", "selector": ".hm-search input"}}, "wait": 1.5, "optional": "debug.page is DEBUG only"},
    {"title": "Back to the system appearance", "rpc": {"method": "debug.appearance", "params": {"mode": "system"}}, "wait": 1, "shot": false}
  ]
}
