{
  "title": "Mac Screen Your Devices: Loading your devices\u2026 while the hub is idle (ui-state-fixes M5)",
  "steps": [
    {
      "title": "Launch",
      "wait": 2,
      "shot": false
    },
    {
      "title": "A device hub that is not started",
      "rpc": {
        "method": "debug.device_hub",
        "params": {
          "action": "capture_devices",
          "state": "loading"
        }
      },
      "wait": 1,
      "record": true,
      "shot": false
    },
    {
      "title": "Mac Screen home",
      "rpc": {
        "method": "debug.mac_screen",
        "params": {
          "action": "open"
        }
      },
      "wait": 3,
      "record": true
    }
  ]
}
