{
 "title": "Terminal selection hint: where it rests as the panes and the sidebar change under it",
 "steps": [
  {
   "title": "Launch",
   "wait": 2,
   "shot": false
  },
  {
   "title": "New workspace",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Hint"
   ],
   "shot": false
  },
  {
   "title": "Show the Hint workspace",
   "cmux": [
    "workspace",
    "name:Hint",
    "focus"
   ],
   "wait": 2,
   "shot": false
  },
  {
   "title": "Split right: two terminal panes",
   "cmux": [
    "action",
    "run",
    "splitRight"
   ],
   "wait": 2,
   "shot": false
  },
  {
   "title": "An agent chat on the right",
   "cmux": [
    "agent",
    "new-chat"
   ],
   "wait": 6,
   "optional": "agent backend unavailable on this runner",
   "shot": false
  },
  {
   "title": "Focus left",
   "cmux": [
    "action",
    "run",
    "focusLeft"
   ],
   "wait": 1,
   "shot": false
  },
  {
   "title": "Appearance dark",
   "rpc": {
    "method": "debug.appearance",
    "params": {
     "mode": "dark"
    }
   },
   "wait": 1,
   "shot": false
  },
  {
   "title": "Gallery plain dark",
   "rpc": {
    "method": "debug.tunables",
    "params": {
     "action": "set",
     "key": "toast.buttonRow",
     "value": "plain"
    }
   },
   "shot": false,
   "optional": "debug.tunables is DEBUG only"
  },
  {
   "title": "Plain (before): the buttons follow the message as text (dark)",
   "rpc": {
    "method": "debug.toast",
    "params": {
     "show": {
      "id": "terminal.selectionHint",
      "message": "Option or Shift + drag selects text",
      "seconds": 120
     }
    }
   },
   "wait": 1.5
  },
  {
   "title": "Gallery divider dark",
   "rpc": {
    "method": "debug.tunables",
    "params": {
     "action": "set",
     "key": "toast.buttonRow",
     "value": "divider"
    }
   },
   "shot": false,
   "optional": "debug.tunables is DEBUG only"
  },
  {
   "title": "Divider: a hairline between the message and the buttons (dark)",
   "rpc": {
    "method": "debug.toast",
    "params": {
     "show": {
      "id": "terminal.selectionHint",
      "message": "Option or Shift + drag selects text",
      "seconds": 120
     }
    }
   },
   "wait": 1.5
  },
  {
   "title": "Gallery chips dark",
   "rpc": {
    "method": "debug.tunables",
    "params": {
     "action": "set",
     "key": "toast.buttonRow",
     "value": "chips"
    }
   },
   "shot": false,
   "optional": "debug.tunables is DEBUG only"
  },
  {
   "title": "Chips: Don't Show Again on a faint fill (dark)",
   "rpc": {
    "method": "debug.toast",
    "params": {
     "show": {
      "id": "terminal.selectionHint",
      "message": "Option or Shift + drag selects text",
      "seconds": 120
     }
    }
   },
   "wait": 1.5
  },
  {
   "title": "Appearance light",
   "rpc": {
    "method": "debug.appearance",
    "params": {
     "mode": "light"
    }
   },
   "wait": 1,
   "shot": false
  },
  {
   "title": "Gallery plain light",
   "rpc": {
    "method": "debug.tunables",
    "params": {
     "action": "set",
     "key": "toast.buttonRow",
     "value": "plain"
    }
   },
   "shot": false,
   "optional": "debug.tunables is DEBUG only"
  },
  {
   "title": "Plain (before): the buttons follow the message as text (light)",
   "rpc": {
    "method": "debug.toast",
    "params": {
     "show": {
      "id": "terminal.selectionHint",
      "message": "Option or Shift + drag selects text",
      "seconds": 120
     }
    }
   },
   "wait": 1.5
  },
  {
   "title": "Gallery divider light",
   "rpc": {
    "method": "debug.tunables",
    "params": {
     "action": "set",
     "key": "toast.buttonRow",
     "value": "divider"
    }
   },
   "shot": false,
   "optional": "debug.tunables is DEBUG only"
  },
  {
   "title": "Divider: a hairline between the message and the buttons (light)",
   "rpc": {
    "method": "debug.toast",
    "params": {
     "show": {
      "id": "terminal.selectionHint",
      "message": "Option or Shift + drag selects text",
      "seconds": 120
     }
    }
   },
   "wait": 1.5
  },
  {
   "title": "Gallery chips light",
   "rpc": {
    "method": "debug.tunables",
    "params": {
     "action": "set",
     "key": "toast.buttonRow",
     "value": "chips"
    }
   },
   "shot": false,
   "optional": "debug.tunables is DEBUG only"
  },
  {
   "title": "Chips: Don't Show Again on a faint fill (light)",
   "rpc": {
    "method": "debug.toast",
    "params": {
     "show": {
      "id": "terminal.selectionHint",
      "message": "Option or Shift + drag selects text",
      "seconds": 120
     }
    }
   },
   "wait": 1.5
  },
  {
   "title": "Back to the system appearance",
   "rpc": {
    "method": "debug.appearance",
    "params": {
     "mode": "system"
    }
   },
   "wait": 1,
   "shot": false
  },
  {
   "title": "Default buttons look",
   "rpc": {
    "method": "debug.tunables",
    "params": {
     "action": "set", "value": null,
     "key": "toast.buttonRow"
    }
   },
   "shot": false,
   "optional": "debug.tunables is DEBUG only"
  },
  {
   "title": "The hint over the terminal, panes split evenly",
   "rpc": {
    "method": "debug.toast",
    "params": {
     "show": {
      "id": "terminal.selectionHint",
      "message": "Option or Shift + drag selects text",
      "seconds": 120
     }
    }
   },
   "wait": 2
  },
  {
   "title": "Drag the divider right: the terminal grows under the hint",
   "rpc": {
    "method": "debug.mouse",
    "params": {
     "action": "drag",
     "divider": "split:",
     "by_x": 160,
     "steps": 20
    }
   },
   "wait": 2,
   "optional": "debug.mouse is DEBUG only"
  },
  {
   "title": "Drag the divider left: the chat's composer slides under the hint",
   "rpc": {
    "method": "debug.mouse",
    "params": {
     "action": "drag",
     "divider": "split:",
     "by_x": -360,
     "steps": 30
    }
   },
   "wait": 2,
   "optional": "debug.mouse is DEBUG only"
  },
  {
   "title": "Hide the sidebar",
   "cmux": [
    "action",
    "run",
    "toggleSidebar"
   ],
   "wait": 2
  },
  {
   "title": "Show the sidebar again",
   "cmux": [
    "action",
    "run",
    "toggleSidebar"
   ],
   "wait": 2
  }
 ]
}
