{
  "title": "A click on a color swatch in the workspace right-click menu colors the workspace (#39953): the last shot shows the Colors row with a blue dot",
  "steps": [
    {
      "title": "Launch",
      "wait": 3,
      "shot": false
    },
    {
      "title": "New workspace",
      "cmux": ["workspace", "new", "--name", "Colors"],
      "shot": false
    },
    {
      "title": "Show the Colors workspace",
      "cmux": ["workspace", "name:Colors", "focus"],
      "wait": 2,
      "shot": false
    },
    {
      "title": "The workspace menu",
      "rpc": {"method": "debug.object_menu", "params": {"menu": "workspace"}},
      "wait": 1.5,
      "shot": false,
      "optional": "debug.object_menu is DEBUG only"
    },
    {
      "title": "Click the blue swatch",
      "rpc": {"method": "debug.object_menu", "params": {"swatch": 2}},
      "wait": 2,
      "shot": false,
      "optional": "debug.object_menu is DEBUG only"
    },
    {
      "title": "Close any menu left open",
      "rpc": {"method": "debug.object_menu", "params": {"dismiss": true}},
      "wait": 1.5,
      "shot": false,
      "optional": "debug.object_menu is DEBUG only"
    },
    {
      "title": "The Colors row is blue",
      "wait": 1
    }
  ]
}
