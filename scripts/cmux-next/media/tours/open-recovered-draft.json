{
  "title": "Open Recovered Draft… in the palette",
  "steps": [
    {"title": "Launch", "wait": 2, "shot": false},
    {"title": "Open the palette", "cmux": ["action", "run", "commandPalette"], "wait": 1.5, "shot": false},
    {"title": "Type r", "rpc": {"method": "debug.key", "params": {"key": "r", "target": "palette"}}, "wait": 0.2, "shot": false},
    {"title": "Type e", "rpc": {"method": "debug.key", "params": {"key": "e", "target": "palette"}}, "wait": 0.2, "shot": false},
    {"title": "Type c", "rpc": {"method": "debug.key", "params": {"key": "c", "target": "palette"}}, "wait": 0.2, "shot": false},
    {"title": "Type o", "rpc": {"method": "debug.key", "params": {"key": "o", "target": "palette"}}, "wait": 0.2, "shot": false},
    {"title": "Type v", "rpc": {"method": "debug.key", "params": {"key": "v", "target": "palette"}}, "wait": 1.5, "shot": false},
    {"title": "Palette: \"recov\" finds Open Recovered Draft…", "wait": 0.5},
    {"title": "Close the palette", "rpc": {"method": "debug.key", "params": {"key": "escape", "target": "palette"}}, "wait": 1, "shot": false}
  ]
}
