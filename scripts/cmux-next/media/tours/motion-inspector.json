{
  "title": "Motion Inspector: slow motion, the sidebar rows filter and the live list (Debug > Debug Windows > Motion Inspector)",
  "windows": [
    {
      "name": "motion-inspector",
      "title": "Motion Inspector"
    }
  ],
  "steps": [
    {
      "title": "Launch",
      "wait": 3,
      "shot": false
    },
    {
      "title": "Open the Motion Inspector (debug.motion window; it never takes the keys)",
      "rpc": {
        "method": "debug.motion",
        "params": {
          "action": "window"
        }
      },
      "wait": 1,
      "shot": false
    },
    {
      "title": "Row opening motion on (ui.animations.newWorkspace is off by default: a new row applies in one frame)",
      "rpc": {
        "method": "debug.motion",
        "params": {
          "action": "kind",
          "name": "newWorkspace",
          "value": true
        }
      },
      "wait": 0.3,
      "shot": false
    },
    {
      "title": "Review the sidebar rows only",
      "rpc": {
        "method": "debug.motion",
        "params": {
          "action": "filter",
          "kind": "sidebarRows"
        }
      },
      "wait": 0.5,
      "shot": false
    },
    {
      "title": "10x slow motion",
      "rpc": {
        "method": "debug.motion",
        "params": {
          "action": "time_scale",
          "value": 10
        }
      },
      "wait": 0.5,
      "shot": false
    },
    {
      "title": "Cmd-N three times: the new rows open in slow motion (a person's key; a CLI-made row shows in place)",
      "wait": 0.3,
      "shot": false,
      "rpc": {
        "method": "debug.key",
        "params": {
          "key": "n",
          "modifiers": [
            "cmd"
          ]
        }
      }
    },
    {
      "title": "Second",
      "wait": 0.3,
      "shot": false,
      "rpc": {
        "method": "debug.key",
        "params": {
          "key": "n",
          "modifiers": [
            "cmd"
          ]
        }
      }
    },
    {
      "title": "Third, mid-motion: the list shows each insert's spring, layers, frames and owner",
      "wait": 0.8,
      "rpc": {
        "method": "debug.key",
        "params": {
          "key": "n",
          "modifiers": [
            "cmd"
          ]
        }
      }
    },
    {
      "title": "Paused and stepped one frame",
      "rpc": {
        "method": "debug.motion",
        "params": {
          "action": "step",
          "frames": 1
        }
      },
      "wait": 0.5,
      "record": true
    },
    {
      "title": "Every kind, ungated animations found",
      "rpc": {
        "method": "debug.motion",
        "params": {
          "action": "findings"
        }
      },
      "wait": 0.5,
      "shot": false,
      "record": "file",
      "resultFile": "findings"
    },
    {
      "title": "The live list as JSON",
      "rpc": {
        "method": "debug.motion",
        "params": {
          "action": "running",
          "ended": true
        }
      },
      "wait": 0.5,
      "shot": false,
      "record": "file",
      "resultFile": "records"
    }
  ]
}
