{
  "title": "Chief channels: a channel lists in Home with a Channel tag and its unread state; the palette offers New Channel",
  "steps": [
    {"title": "Launch", "wait": 2, "shot": false},
    {"title": "Go to Home", "cmux": ["action", "run", "home.show"], "wait": 4, "shot": false,
     "optional": "the Chief's daemon may not start on this runner"},
    {"title": "Home: two DMs and two channels, each with the Channel tag (Launch is unread)",
     "rpc": {"method": "debug.home.sidebar_fixture", "params": {"count": 2, "pinned": 0, "channels": ["Launch", "Design"], "width": 340}},
     "wait": 2, "optional": "debug fixture is DEBUG only"},
    {"title": "Open the palette", "cmux": ["action", "run", "commandPalette"], "wait": 1.5, "shot": false},
    {"title": "Type c", "rpc": {"method": "debug.key", "params": {"key": "c", "target": "palette"}}, "wait": 0.2, "shot": false},
    {"title": "Type h", "rpc": {"method": "debug.key", "params": {"key": "h", "target": "palette"}}, "wait": 0.2, "shot": false},
    {"title": "Type a", "rpc": {"method": "debug.key", "params": {"key": "a", "target": "palette"}}, "wait": 0.2, "shot": false},
    {"title": "Type n", "rpc": {"method": "debug.key", "params": {"key": "n", "target": "palette"}}, "wait": 0.2, "shot": false},
    {"title": "Type n", "rpc": {"method": "debug.key", "params": {"key": "n", "target": "palette"}}, "wait": 0.2, "shot": false},
    {"title": "Type e", "rpc": {"method": "debug.key", "params": {"key": "e", "target": "palette"}}, "wait": 0.2, "shot": false},
    {"title": "Type l", "rpc": {"method": "debug.key", "params": {"key": "l", "target": "palette"}}, "wait": 1.5, "shot": false},
    {"title": "Palette: \"channel\" offers New Channel…", "wait": 0.5},
    {"title": "Close the palette", "cmux": ["action", "run", "commandPalette"], "wait": 1, "shot": false},
    {"title": "Dark", "rpc": {"method": "debug.appearance", "params": {"mode": "dark"}}, "wait": 2,
     "optional": "debug.appearance is DEBUG only"},
    {"title": "Back to the system appearance", "rpc": {"method": "debug.appearance", "params": {"mode": "system"}}, "wait": 1, "shot": false,
     "optional": "debug.appearance is DEBUG only"}
  ]
}
