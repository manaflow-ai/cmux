{
  "title": "Customize…: the palette and the cmux menu open a chat ready for what to change",
  "steps": [
    {
      "title": "Launch",
      "wait": 2,
      "shot": false
    },
    {
      "title": "New workspace app",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "app"
      ],
      "wait": 1.5,
      "shot": false
    },
    {
      "title": "Open app",
      "cmux": [
        "workspace",
        "name:app",
        "focus"
      ],
      "wait": 1.5,
      "shot": false
    },
    {
      "title": "Open the Command Palette",
      "cmux": [
        "action",
        "run",
        "commandPalette"
      ],
      "wait": 1.5,
      "shot": false
    },
    {
      "title": "Type 'c'",
      "rpc": {
        "method": "debug.key",
        "params": {
          "key": "c",
          "target": "palette"
        }
      },
      "wait": 0.2,
      "shot": false
    },
    {
      "title": "Type 'u'",
      "rpc": {
        "method": "debug.key",
        "params": {
          "key": "u",
          "target": "palette"
        }
      },
      "wait": 0.2,
      "shot": false
    },
    {
      "title": "Type 's'",
      "rpc": {
        "method": "debug.key",
        "params": {
          "key": "s",
          "target": "palette"
        }
      },
      "wait": 0.2,
      "shot": false
    },
    {
      "title": "Type 't'",
      "rpc": {
        "method": "debug.key",
        "params": {
          "key": "t",
          "target": "palette"
        }
      },
      "wait": 0.2,
      "shot": false
    },
    {
      "title": "Type 'o'",
      "rpc": {
        "method": "debug.key",
        "params": {
          "key": "o",
          "target": "palette"
        }
      },
      "wait": 0.2,
      "shot": false
    },
    {
      "title": "Type 'm'",
      "rpc": {
        "method": "debug.key",
        "params": {
          "key": "m",
          "target": "palette"
        }
      },
      "wait": 0.2,
      "shot": false
    },
    {
      "title": "The palette offers Customize…",
      "wait": 1
    },
    {
      "title": "Close the palette",
      "rpc": {
        "method": "debug.key",
        "params": {
          "key": "escape",
          "target": "palette"
        }
      },
      "wait": 1,
      "shot": false
    },
    {
      "title": "Customize… opens a new chat with /customize in its composer",
      "cmux": [
        "action",
        "run",
        "customize.open"
      ],
      "wait": 4
    }
  ]
}
