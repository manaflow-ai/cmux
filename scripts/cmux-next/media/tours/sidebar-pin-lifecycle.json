{
 "title": "Sidebar pin lifecycle: the hover pin is the action (outline Pin, struck-through Unpin), the pinned mark is filled; pin, reorder in Pinned, drag out of and into Pinned, click (dark and light). Record it with: cmux-ci capture SHA --state tour:sidebar-pin-lifecycle --video",
 "settings": {
  "sidebar": {
   "hoverCards": {
    "enabled": false
   }
  }
 },
 "steps": [
  {
   "title": "Launch",
   "wait": 3,
   "shot": false
  },
  {
   "title": "New workspace Notes",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Notes"
   ],
   "wait": 2,
   "shot": false
  },
  {
   "title": "Show Notes",
   "cmux": [
    "workspace",
    "name:Notes",
    "focus"
   ],
   "wait": 2,
   "shot": false
  },
  {
   "title": "Pin Notes",
   "cmux": [
    "action",
    "run",
    "palette.toggleWorkspacePin"
   ],
   "wait": 2,
   "shot": false
  },
  {
   "title": "New workspace Build",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Build"
   ],
   "wait": 2,
   "shot": false
  },
  {
   "title": "New workspace Release notes",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Release notes"
   ],
   "wait": 2,
   "shot": false
  },
  {
   "title": "New workspace Docs",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Docs"
   ],
   "wait": 2,
   "shot": false
  },
  {
   "title": "Dark",
   "rpc": {
    "method": "debug.appearance",
    "params": {
     "mode": "dark"
    }
   },
   "wait": 2,
   "shot": false
  },
  {
   "title": "At rest: pinned Notes shows its filled pinned mark",
   "wait": 1
  },
  {
   "title": "Hover the unpinned row Build: the outline pin is the Pin action",
   "rpc": {
    "method": "debug.mouse",
    "params": {
     "row": "Build",
     "action": "move"
    }
   },
   "wait": 2
  },
  {
   "title": "Hover the pinned Notes: the struck-through pin is the Unpin action, the filled mark stays the state",
   "rpc": {
    "method": "debug.mouse",
    "params": {
     "row": "Notes",
     "action": "move"
    }
   },
   "wait": 2
  },
  {
   "title": "Pin Build from the palette action (the hover Pin's action)",
   "cmux": [
    "workspace",
    "name:Build",
    "focus"
   ],
   "wait": 1,
   "shot": false
  },
  {
   "title": "Pin Build",
   "cmux": [
    "action",
    "run",
    "palette.toggleWorkspacePin"
   ],
   "wait": 2
  },
  {
   "title": "Drag pinned Build below Notes and back up: reorder inside Pinned",
   "rpc": {
    "method": "debug.mouse",
    "params": {
     "row": "Build",
     "action": "drag",
     "by_y": -40,
     "steps": 30
    }
   },
   "wait": 3
  },
  {
   "title": "Drag pinned Notes down out of Pinned into the list: it unpins",
   "rpc": {
    "method": "debug.mouse",
    "params": {
     "row": "Notes",
     "action": "drag",
     "by_y": 160,
     "steps": 40
    }
   },
   "wait": 3
  },
  {
   "title": "Drag Docs up from the list into Pinned",
   "rpc": {
    "method": "debug.mouse",
    "params": {
     "row": "Docs",
     "action": "drag",
     "by_y": -200,
     "steps": 40
    }
   },
   "wait": 3
  },
  {
   "title": "Click Release notes: it selects, no pin change",
   "rpc": {
    "method": "debug.mouse",
    "params": {
     "row": "Release notes",
     "action": "click"
    }
   },
   "wait": 2
  },
  {
   "title": "Click pinned Build: it selects, stays pinned",
   "rpc": {
    "method": "debug.mouse",
    "params": {
     "row": "Build",
     "action": "click"
    }
   },
   "wait": 2
  },
  {
   "title": "Light",
   "rpc": {
    "method": "debug.appearance",
    "params": {
     "mode": "light"
    }
   },
   "wait": 2,
   "shot": false
  },
  {
   "title": "Light, hover pinned Build: Unpin action, filled mark",
   "rpc": {
    "method": "debug.mouse",
    "params": {
     "row": "Build",
     "action": "move"
    }
   },
   "wait": 2
  },
  {
   "title": "Light, hover unpinned Release notes: Pin action",
   "rpc": {
    "method": "debug.mouse",
    "params": {
     "row": "Release notes",
     "action": "move"
    }
   },
   "wait": 2
  }
 ]
}
