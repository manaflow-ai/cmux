   ],
   "wait": 2,
   "shot": false
  },
  {
   "title": "Plain, One Color (default), V3: a device hairline at 2.5x the separator",
   "wait": 1
  },
  {
   "title": "Divider strength 1.75",
   "rpc": {
    "method": "debug.tunables",
    "params": {
     "action": "set",
     "key": "chrome.dividerStrength",
