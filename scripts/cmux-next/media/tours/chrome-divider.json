    "settings",
    "unset",
    "appearance.titleAreaTone"
   ],
   "wait": 2,
   "shot": false
  },
  {
   "title": "Plain, One Color (default), V2: 1 pt at 1.75x the separator",
   "wait": 1
  },
  {
   "title": "Divider strength 2.5",
   "rpc": {
    "method": "debug.tunables",
    "params": {
     "action": "set",
