{
  "title": "Meet Chief: the first-run onboarding on the empty Chief chat, each step in light and dark",
  "launch_args": ["--showcase"],
  "steps": [
    {"title": "Launch", "wait": 2, "shot": false},
    {"title": "Home on the empty Chief chat", "rpc": {"method": "debug.scene.render", "params": {"scene": "home-chief"}}, "wait": 1, "shot": false},
    {"title": "Light", "rpc": {"method": "debug.appearance", "params": {"mode": "light"}}, "wait": 1, "shot": false},
    {"title": "Light, step 1: who Chief is and what it does",
     "rpc": {"method": "debug.onboarding", "params": {"action": "meet_chief", "step": "meet"}}, "record": true, "wait": 1.5},
    {"title": "Light, step 2: what Chief can do on this Mac",
     "rpc": {"method": "debug.onboarding", "params": {"action": "meet_chief", "step": "access"}}, "record": true, "wait": 1.5},
    {"title": "Light, step 3: density and text size",
     "rpc": {"method": "debug.onboarding", "params": {"action": "meet_chief", "step": "look"}}, "record": true, "wait": 1.5},
    {"title": "Dark", "rpc": {"method": "debug.appearance", "params": {"mode": "dark"}}, "wait": 1, "shot": false},
    {"title": "Dark, step 1: who Chief is and what it does",
     "rpc": {"method": "debug.onboarding", "params": {"action": "meet_chief", "step": "meet"}}, "record": true, "wait": 1.5},
    {"title": "Dark, step 2: what Chief can do on this Mac",
     "rpc": {"method": "debug.onboarding", "params": {"action": "meet_chief", "step": "access"}}, "record": true, "wait": 1.5},
    {"title": "Dark, step 3: density and text size",
     "rpc": {"method": "debug.onboarding", "params": {"action": "meet_chief", "step": "look"}}, "record": true, "wait": 1.5},
    {"title": "Meet Chief ends: the first-run panel returns", "rpc": {"method": "debug.onboarding", "params": {"action": "meet_chief_end"}}, "record": true, "wait": 1.5},
    {"title": "Back to the system appearance", "rpc": {"method": "debug.appearance", "params": {"mode": "system"}}, "wait": 1, "shot": false}
  ]
}
