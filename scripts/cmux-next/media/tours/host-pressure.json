{
  "title": "Host pressure indicator, its three looks, popover and critical banner",
  "steps": [
    {"title": "Launch: the indicator ships off (Debug toggle hostPressure.enabled)", "wait": 2},
    {"title": "Indicator on: a normal host still shows nothing",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "hostPressure.enabled", "value": true}}, "wait": 2, "shot": false,
     "optional": "debug.tunables is DEBUG only"},
    {"title": "Warning: the still gauge after the toolbar band",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "hostPressure.force", "value": "warning"}}, "wait": 2,
     "optional": "debug.tunables is DEBUG only"},
    {"title": "The warning's popover: the load against its limit, turns, processes and the busiest sessions",
     "rpc": {"method": "debug.host_pressure", "params": {"action": "open"}}, "wait": 2,
     "optional": "debug.host_pressure is DEBUG only"},
    {"title": "Closed", "rpc": {"method": "debug.host_pressure", "params": {"action": "close"}}, "wait": 1, "shot": false,
     "optional": "debug.host_pressure is DEBUG only"},
    {"title": "Warning, version B: a triangle",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "hostPressure.style", "value": "triangle"}}, "wait": 2,
     "optional": "debug.tunables is DEBUG only"},
    {"title": "Warning, version C: the gauge with the load against its limit",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "hostPressure.style", "value": "load"}}, "wait": 2,
     "optional": "debug.tunables is DEBUG only"},
    {"title": "Back to version A",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "hostPressure.style", "value": "gauge"}}, "wait": 1, "shot": false,
     "optional": "debug.tunables is DEBUG only"},
    {"title": "Critical banner on (Debug toggle hostPressure.banner; it ships off)",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "hostPressure.banner", "value": true}}, "wait": 1, "shot": false,
     "optional": "debug.tunables is DEBUG only"},
    {"title": "Critical, version A: the triangle and the banner with acpmux's reasons and Show Details",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "hostPressure.force", "value": "critical"}}, "wait": 2,
     "optional": "debug.tunables is DEBUG only"},
    {"title": "The critical popover: the load against its limit, acpmux's reasons and the busiest sessions (a forced level's sample sessions have no Stop)",
     "rpc": {"method": "debug.host_pressure", "params": {"action": "open"}}, "wait": 2,
     "optional": "debug.host_pressure is DEBUG only"},
    {"title": "Closed",
     "rpc": {"method": "debug.host_pressure", "params": {"action": "close"}}, "wait": 1, "shot": false,
     "optional": "debug.host_pressure is DEBUG only"},
    {"title": "Critical, version B: the same triangle (B differs from A only at warning)",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "hostPressure.style", "value": "triangle"}}, "wait": 2,
     "optional": "debug.tunables is DEBUG only"},
    {"title": "Critical, version C: the triangle with the load against its limit",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "hostPressure.style", "value": "load"}}, "wait": 2,
     "optional": "debug.tunables is DEBUG only"},
    {"title": "Critical, version C in dark",
     "rpc": {"method": "debug.appearance", "params": {"mode": "dark"}}, "wait": 2,
     "optional": "debug.appearance is DEBUG only"},
    {"title": "Critical, version B in dark",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "hostPressure.style", "value": "triangle"}}, "wait": 2,
     "optional": "debug.tunables is DEBUG only"},
    {"title": "Critical, version A in dark",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "hostPressure.style", "value": "gauge"}}, "wait": 2,
     "optional": "debug.tunables is DEBUG only"},
    {"title": "Back to the system appearance",
     "rpc": {"method": "debug.appearance", "params": {"mode": "system"}}, "wait": 1, "shot": false,
     "optional": "debug.appearance is DEBUG only"},
    {"title": "Critical banner off again",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "hostPressure.banner", "value": false}}, "wait": 1, "shot": false,
     "optional": "debug.tunables is DEBUG only"},
    {"title": "Back to the host's real level",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "hostPressure.force", "value": "off"}}, "wait": 1, "shot": false,
     "optional": "debug.tunables is DEBUG only"},
    {"title": "Indicator off again: no timer, no reads",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "hostPressure.enabled", "value": false}}, "wait": 1, "shot": false,
     "optional": "debug.tunables is DEBUG only"}
  ]
}
