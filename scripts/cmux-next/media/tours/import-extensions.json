{
  "title": "Import from Browser brings extensions (#48466): Import from Browser\u2026 in the browser's More menu, the Extensions checkbox, then the workspace of the profile's extensions page and each store page",
  "env": {
    "CMUX_NEXT_BROWSER_IMPORT_HOME": "{repo}/scripts/cmux-next/media/fixtures/browser-import-home",
    "CMUX_NEXT_BROWSER_IMPORT_KEYS": "{repo}/scripts/cmux-next/media/fixtures/browser-import-keys.json"
  },
  "steps": [
    {
      "title": "Launch",
      "wait": 3,
      "shot": false
    },
    {
      "title": "Browser workspace",
      "rpc": {
        "method": "action.run",
        "params": {
          "action": "newBrowserWorkspace",
          "focus": true
        }
      },
      "wait": 4,
      "shot": false
    },
    {
      "title": "The More menu: Import from Browser\u2026 beside Manage Extensions and Passwords",
      "rpc": {
        "method": "action.run",
        "params": {
          "action": "browser.overflow.menu"
        }
      },
      "wait": 2,
      "display": true,
      "optional": "the menu shot needs --whole-host"
    },
    {
      "title": "Close the menu",
      "rpc": {
        "method": "debug.object_menu",
        "params": {
          "dismiss": true
        }
      },
      "wait": 1.5,
      "shot": false,
      "optional": "debug.object_menu is DEBUG only"
    },
    {
      "title": "Import from Browser opens on its picker",
      "rpc": {
        "method": "debug.onboarding",
        "params": {
          "action": "open",
          "step": "importData"
        }
      },
      "wait": 3,
      "shot": false
    },
    {
      "title": "Find the browsers in the fixture home",
      "rpc": {
        "method": "debug.onboarding",
        "params": {
          "action": "detect"
        }
      },
      "wait": 5,
      "shot": false
    },
    {
      "title": "Extensions checked",
      "rpc": {
        "method": "debug.onboarding",
        "params": {
          "action": "toggle_kind",
          "kind": "extensions"
        }
      },
      "wait": 2
    },
    {
      "title": "Import",
      "rpc": {
        "method": "debug.onboarding",
        "params": {
          "action": "import"
        }
      },
      "wait": 2,
      "shot": false
    },
    {
      "title": "Import without passwords (a no-op unless the consent screen is up)",
      "rpc": {
        "method": "debug.onboarding",
        "params": {
          "action": "skip_passwords"
        }
      },
      "wait": 12
    },
    {
      "title": "State: the import's summary",
      "rpc": {
        "method": "debug.onboarding",
        "params": {}
      },
      "shot": false
    },
    {
      "title": "Close the import window",
      "rpc": {
        "method": "debug.onboarding",
        "params": {
          "action": "close"
        }
      },
      "wait": 6
    }
  ]
}
