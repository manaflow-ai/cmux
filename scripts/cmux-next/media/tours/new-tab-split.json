   "shot": false
  },
  {
   "title": "New Tab, typing \"split\" as it opens",
   "rpc": {
    "method": "debug.new_tab",
    "params": {
     "action": "open_and_type",
     "text": "split"
    }
   },
   "wait": 2,
   "shot": false
  },
  {
   "title": "Web New Tab: \"split\" in the dropdown",
   "wait": 0.5
  }
 ]
