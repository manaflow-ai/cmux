{
  "title": "Command Palette v2, look B: Category rail (experiments.paletteV2 = rail): the palette open with \"re\" typed, results grouped under Workspaces, Sessions, Commands and Agents, the top match selected. Record it with: cmux-ci capture SHA --state tour:palette-v2-rail",
  "settings": {
    "experiments": {
      "paletteV2": "rail"
    }
  },
  "steps": [
    {
      "title": "Launch",
      "wait": 2,
      "shot": false
    },
    {
      "title": "New workspace work api",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "work api"
      ],
      "wait": 1.2,
      "shot": false
    },
    {
      "title": "New workspace work web",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "work web"
      ],
      "wait": 1.2,
      "shot": false
    },
    {
      "title": "New workspace release notes",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "release notes"
      ],
      "wait": 1.2,
      "shot": false
    },
    {
      "title": "New workspace research",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "research"
      ],
      "wait": 1.2,
      "shot": false
    },
    {
      "title": "Show work api",
      "cmux": [
        "workspace",
        "name:work api",
        "focus"
      ],
      "wait": 1,
      "shot": false
    },
    {
      "title": "Open the command palette",
      "cmux": [
        "action",
        "run",
        "commandPalette"
      ],
      "wait": 1.5,
      "shot": false
    },
    {
      "title": "Type r",
      "rpc": {
        "method": "debug.key",
        "params": {
          "key": "r",
          "target": "palette"
        }
      },
      "wait": 0.3,
      "shot": false
    },
    {
      "title": "Type e",
      "rpc": {
        "method": "debug.key",
        "params": {
          "key": "e",
          "target": "palette"
        }
      },
      "wait": 1.2,
      "shot": false
    },
    {
      "title": "Palette v2 B: Category rail: \"re\"",
      "wait": 0.5,
      "rpc": {
        "method": "debug.palette.capture",
        "params": {
          "path": "{collect}"
        }
      },
      "collect": "rail-re.png"
    },
    {
      "title": "Close the palette",
      "rpc": {
        "method": "debug.key",
        "params": {
          "key": "escape",
          "target": "palette"
        }
      },
      "wait": 0.5,
      "shot": false
    }
  ]
}
