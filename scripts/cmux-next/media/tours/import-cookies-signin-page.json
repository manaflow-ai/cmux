{
  "title": "Import Cookies card on a sign-in page drawn after the load",
  "env": {
    "CMUX_NEXT_BROWSER_IMPORT_OFFER": "1"
  },
  "steps": [
    {
      "title": "Launch",
      "wait": 2,
      "shot": false
    },
    {
      "title": "Fresh state: nothing imported, the banner setting on",
      "rpc": {
        "method": "debug.browser_import_offer",
        "params": {
          "action": "reset"
        }
      },
      "shot": false
    },
    {
      "title": "Browser workspace",
      "rpc": {
        "method": "action.run",
        "params": {
          "action": "newBrowserWorkspace",
          "focus": true
        }
      },
      "wait": 4,
      "shot": false
    },
    {
      "title": "The person opens a sign-in page whose form is drawn after the load (Discord)",
      "rpc": {
        "method": "debug.omnibar_type",
        "params": {
          "text": "https://discord.com/login"
        }
      },
      "wait": 12
    },
    {
      "title": "State: whether the card shows (no debug show: the page's own sign-in check decides)",
      "rpc": {
        "method": "debug.browser_import_offer",
        "params": {}
      },
      "shot": false
    }
  ]
}
