{
  "title": "Now Playing",
  "steps": [
    {"title": "Launch", "wait": 2},
    {"title": "Turn on the built-in player (preview)", "cmux": ["settings", "set", "labs.previewFeatures", "true"], "shot": false},
    {"title": "Play the system sounds", "cmux": ["action", "run", "music.open", "--arg", "path=/System/Library/Sounds"], "wait": 2},
    {"title": "New tab page: no player by default (u8394)", "cmux": ["tab", "new-page"], "wait": 2},
    {"title": "Show Now Playing on New Tab", "cmux": ["settings", "set", "tabs.newTabNowPlaying", "true"], "wait": 2},
    {"title": "A song that played to its end", "cmux": ["action", "run", "music.open", "--arg", "path=/System/Library/Sounds/Submarine.aiff"], "wait": 3},
    {"title": "Hide Now Playing", "cmux": ["settings", "set", "sidebar.nowPlaying.enabled", "false"], "wait": 1},
    {"title": "Show Now Playing", "cmux": ["settings", "set", "sidebar.nowPlaying.enabled", "true"], "wait": 1},
    {"title": "Stop", "cmux": ["action", "run", "music.stop"], "wait": 1}
  ]
}
