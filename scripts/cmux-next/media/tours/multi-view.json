{
  "title": "Multi-view: a workspace dragged beside another",
  "steps": [
    {"title": "Launch", "wait": 2, "shot": false},
    {"title": "New workspace api", "cmux": ["workspace", "new", "--name", "api"], "wait": 1, "shot": false},
    {"title": "New workspace docs: one workspace on screen", "cmux": ["workspace", "new", "--name", "docs"], "wait": 2},
    {"title": "The api row held and dragged onto docs's right edge: api shows beside docs, both rows lit",
     "rpc": {"method": "debug.mouse", "params": {"action": "drag", "row": "api", "to_edge": "right", "steps": 30}}, "wait": 3,
     "optional": "debug.mouse is DEBUG only"},
    {"title": "Dark", "rpc": {"method": "debug.appearance", "params": {"mode": "dark"}}, "wait": 2,
     "optional": "debug.appearance is DEBUG only"},
    {"title": "Back to the system appearance", "rpc": {"method": "debug.appearance", "params": {"mode": "system"}}, "wait": 1, "shot": false,
     "optional": "debug.appearance is DEBUG only"}
  ]
}
