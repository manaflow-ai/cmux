{
  "title": "Session Info native: full-height panel with its toggle on",
  "steps": [
    {
      "title": "Launch",
      "wait": 2,
      "shot": false
    },
    {
      "title": "Light: native Session Info below the header through the pane foot",
      "rpc": {
        "method": "debug.appearance",
        "params": {"mode": "light"}
      },
      "wait": 1,
      "shot": false
    },
    {
      "title": "Light: capture the native Session Info scene",
      "rpc": {
        "method": "debug.scene.render",
        "params": {"scene": "session-info-native"}
      },
      "wait": 1.5
    },
    {
      "title": "Dark: capture the native Session Info scene",
      "rpc": {
        "method": "debug.appearance",
        "params": {"mode": "dark"}
      },
      "wait": 1.5
    },
    {
      "title": "Dark: native Session Info remains full height",
      "rpc": {
        "method": "debug.scene.render",
        "params": {"scene": "session-info-native"}
      },
      "wait": 1.5
    },
    {
      "title": "Back to the system appearance",
      "rpc": {
        "method": "debug.appearance",
        "params": {"mode": "system"}
      },
      "wait": 1,
      "shot": false
    }
  ]
}
