{
  "title": "Workspace hover tabs",
  "settings": {"appearance": {"theme": "light:Soft Blue Light,dark:Soft Blue"}},
  "steps": [
    {"title": "Launch", "wait": 3},
    {"title": "Create a workspace with an inner tab", "cmux": ["workspace", "new", "--name", "Hover tab demo", "--cwd", "/tmp", "--shell", "printf ready; sleep 60"], "wait": 3},
    {"title": "Focus the created workspace", "rpc": {"method": "debug.mouse", "params": {"row": "Hover tab demo", "action": "click"}}, "wait": 2},
    {"title": "Inspect its first tab before setup", "rpc": {"method": "debug.sidebar_rows"}, "wait": 0},
    {"title": "Add a second inner tab", "cmux": ["action", "run", "newSurface"], "wait": 2},
    {"title": "Focus the second inner tab", "cmux": ["action", "run", "nextSurface"], "wait": 1},
    {"title": "Inspect the second tab before hovering", "rpc": {"method": "debug.sidebar_rows"}, "wait": 0},
    {"title": "Use dark appearance for the real hover", "rpc": {"method": "debug.appearance", "params": {"mode": "dark"}}, "wait": 1},
    {"title": "Hover the workspace row", "rpc": {"method": "debug.mouse", "params": {"row": "Hover tab demo", "action": "move"}}, "wait": 2},
    {"title": "Move into the popover", "rpc": {"method": "debug.mouse", "params": {"target": "hover-card", "x": 100, "y": 60, "action": "move"}}, "wait": 2},
    {"title": "Click the first inner tab from the second", "rpc": {"method": "debug.mouse", "params": {"target": "hover-card", "x": 100, "y": 60, "action": "click"}}, "wait": 3},
    {"title": "Focused tab after the click", "rpc": {"method": "debug.sidebar_rows"}, "wait": 1},
    {"title": "Popover is closed after focusing", "rpc": {"method": "debug.hover_cards"}, "wait": 0, "expect": {"method": "debug.hover_cards", "fields": {"card_showing": "false"}}}
  ]
}
