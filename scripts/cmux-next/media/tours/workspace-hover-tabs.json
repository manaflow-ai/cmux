{
  "title": "Workspace hover tabs",
  "settings": {"appearance": {"theme": "Soft Blue"}},
  "steps": [
    {"title": "Launch", "wait": 3},
    {"title": "Create a workspace with an inner tab", "cmux": ["workspace", "new", "--name", "Hover tab demo", "--cwd", "/tmp", "--shell", "printf ready; sleep 60"], "wait": 3},
    {"title": "Hover the workspace row", "rpc": {"method": "debug.mouse", "params": {"x": 100, "y": 100, "action": "move"}}, "wait": 1},
    {"title": "Move into the popover", "rpc": {"method": "debug.mouse", "params": {"target": "hover-card", "x": 100, "y": 60, "action": "move"}}, "wait": 2},
    {"title": "Click its inner tab", "rpc": {"method": "debug.mouse", "params": {"target": "hover-card", "x": 100, "y": 60, "action": "click"}}, "wait": 3},
    {"title": "Focused tab after the click", "rpc": {"method": "debug.sidebar_rows"}, "wait": 1}
  ]
}
