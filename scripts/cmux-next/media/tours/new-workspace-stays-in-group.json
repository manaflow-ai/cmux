{
  "title": "New workspace stays in its group",
  "steps": [
    {"title": "Launch", "wait": 2, "shot": false},
    {"title": "A loose workspace", "cmux": ["workspace", "new", "--name", "Loose"], "wait": 1, "shot": false},
    {"title": "Two workspaces", "cmux": ["workspace", "new", "--name", "lead-a"], "wait": 1, "shot": false},
    {"title": "Two workspaces", "cmux": ["workspace", "new", "--name", "lead-b"], "wait": 1, "shot": false},
    {"title": "A group, Leads", "cmux": ["workspace", "group", "create", "--name", "Leads"], "wait": 1, "shot": false},
    {"title": "lead-a in Leads", "cmux": ["workspace", "group", "Leads", "add", "--workspace", "name:lead-a"], "wait": 1, "shot": false},
    {"title": "lead-b in Leads", "cmux": ["workspace", "group", "Leads", "add", "--workspace", "name:lead-b"], "wait": 1, "shot": false},
    {"title": "lead-b selected, inside Leads", "cmux": ["workspace", "name:lead-b", "focus"], "wait": 2},
    {"title": "New Workspace: it goes into Leads, first, and is selected", "cmux": ["action", "run", "newTab"], "wait": 3},
    {"title": "New Workspace again, from the new one: still in Leads", "cmux": ["action", "run", "newTab"], "wait": 3},
    {"title": "A moment later: both still in Leads, none jumped above it", "wait": 3}
  ]
}
