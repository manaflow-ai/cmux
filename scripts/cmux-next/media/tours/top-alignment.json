{
 "title": "Window top alignment: the top row, the first tab and the sidebar's columns at every density",
 "steps": [
  {
   "title": "Launch",
   "wait": 3
  },
  {
   "title": "New workspace",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Align"
   ],
   "shot": false
  },
  {
   "title": "Show it",
   "cmux": [
    "workspace",
    "name:Align",
    "focus"
   ],
   "shot": false
  },
  {
   "title": "Second tab",
   "cmux": [
    "action",
    "run",
    "newSurface"
   ],
   "wait": 1.5,
   "shot": false
  },
  {
   "title": "An unread mark on a row",
   "daemon": true,
   "cmux": [
    "notify",
    "--title",
    "Align",
    "--body",
    "unread"
   ],
   "wait": 1.5,
   "shot": false
  },
  {
   "title": "Wide window",
   "rpc": {
    "method": "debug.window_frame",
    "params": {
     "frame": [
      80,
      80,
      1440,
      860
     ]
    }
   },
   "wait": 1,
   "shot": false,
   "optional": "DEBUG only"
  },
  {
   "title": "Density ultraCompact",
   "cmux": [
    "settings",
    "set",
    "appearance.density",
    "ultraCompact"
   ],
   "wait": 1.5,
   "shot": false
  },
  {
   "rpc": {
    "method": "debug.top_alignment",
    "params": {}
   },
   "optional": "debug.top_alignment is DEBUG only",
   "title": "measure: ultraCompact wide sidebar shown",
   "shot": true,
   "wait": 1.0
  },
  {
   "title": "Sidebar 300",
   "cmux": [
    "settings",
    "set",
    "appearance.metrics.sidebarWidth",
    "300"
   ],
   "wait": 1,
   "shot": false,
   "optional": "metric key"
  },
  {
   "rpc": {
    "method": "debug.top_alignment",
    "params": {}
   },
   "optional": "debug.top_alignment is DEBUG only",
   "title": "measure: ultraCompact wide sidebar 300",
   "shot": false,
   "wait": 1.0
  },
  {
   "title": "Sidebar default",
   "cmux": [
    "settings",
    "unset",
    "appearance.metrics.sidebarWidth"
   ],
   "wait": 1,
   "shot": false,
   "optional": "metric key"
  },
  {
   "title": "Hide sidebar",
   "cmux": [
    "action",
    "run",
    "toggleSidebar"
   ],
   "wait": 1.5,
   "shot": false
  },
  {
   "rpc": {
