  {
   "title": "A scrolled up 700 pt: the person reads an older message",
   "rpc": {
    "method": "debug.home.drive",
    "params": {
     "action": "scroll",
     "dy": -700
    }
   },
   "wait": 2
  },
  {
   "title": "A's rows while reading",
   "rpc": {
    "method": "debug.home.drive",
    "params": {
     "action": "rows"
    }
   },
   "wait": 0.2,
   "shot": false
  },
  {
   "title": "B opens at its newest",
   "rpc": {
    "method": "action.run",
    "params": {
     "id": "home.previousConversation",
     "focus": true
    }
   },
   "wait": 3
  },
  {
   "title": "A opens where the person was reading: the same lines as before",
   "rpc": {
    "method": "action.run",
    "params": {
     "id": "home.nextConversation",
     "focus": true
    }
   },
   "wait": 3
  },
  {
   "title": "A's rows after the reopen",
