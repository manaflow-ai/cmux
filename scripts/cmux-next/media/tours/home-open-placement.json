{
 "title": "Where a chat opens: at its newest message, or where it was left scrolled up (#27627)",
 "steps": [
  {
   "title": "Launch",
   "wait": 3,
   "shot": false
  },
  {
   "title": "Go to Home",
   "cmux": [
    "action",
    "run",
    "home.show"
   ],
   "wait": 4,
   "shot": false
  },
  {
   "title": "Channel A is made",
   "rpc": {
    "method": "debug.home.api",
    "params": {
     "call": "submit",
     "op": {
      "kind": "create_group",
      "title": "Scroll A",
      "participants": []
     }
    }
   },
   "wait": 2,
   "shot": false
  },
  {
   "title": "Open channel A",
   "rpc": {
    "method": "action.run",
    "params": {
     "id": "home.nextConversation",
     "focus": true
    }
   },
   "wait": 3,
   "shot": false
  },
  {
   "title": "A1 typed",
   "rpc": {
    "method": "debug.home.drive",
    "params": {
     "action": "type",
     "text": "A1 line 1\nA1 line 2\nA1 line 3\nA1 line 4\nA1 line 5\nA1 line 6\nA1 line 7\nA1 line 8\nA1 line 9\nA1 line 10\nA1 line 11\nA1 line 12"
    }
   },
   "wait": 0.1,
   "shot": false
  },
  {
   "title": "A1 sent",
   "rpc": {
    "method": "debug.home.drive",
    "params": {
     "action": "send"
    }
   },
   "wait": 0.6,
   "shot": false
  },
  {
   "title": "A2 typed",
   "rpc": {
    "method": "debug.home.drive",
    "params": {
     "action": "type",
