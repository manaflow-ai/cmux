    }
   },
   "wait": 0.2,
   "shot": false
  },
  {
   "title": "A scrolled back down to its newest",
   "rpc": {
    "method": "debug.home.drive",
    "params": {
     "action": "scroll",
     "dy": 100000
    }
   },
   "wait": 2,
   "shot": false
  },
  {
   "title": "B again",
   "rpc": {
    "method": "action.run",
    "params": {
     "id": "home.previousConversation",
     "focus": true
    }
   },
   "wait": 3,
   "shot": false
  },
  {
   "title": "A, scrolled back down before leaving: opens at A5 line 12",
   "rpc": {
    "method": "action.run",
    "params": {
     "id": "home.nextConversation",
     "focus": true
    }
   },
   "wait": 3
  },
  {
