{
  "title": "Sidebar corner morph (Debug sidebar.cornerMorph): off, shell, bridge and both on the showcase window, comfortable sidebar density, light and dark",
  "launch_args": [
    "--showcase"
  ],
  "settings": {
    "sidebar": {
      "density": "comfortable"
    }
  },
  "steps": [
    {
      "title": "Launch",
      "wait": 2,
      "shot": false
    },
    {
      "title": "The showcase window: real panes, an Agent tab, Home selected",
      "rpc": {
        "method": "debug.scene.render",
        "params": {
          "scene": "main-showcase"
        }
      },
      "wait": 2,
      "shot": false
    },
    {
      "title": "Light",
      "rpc": {
        "method": "debug.appearance",
        "params": {
          "mode": "light"
        }
      },
      "wait": 1,
      "shot": false,
      "optional": "debug.appearance is DEBUG only"
    },
    {
      "title": "Light, sidebar.cornerMorph off: the plain card (today)",
      "rpc": {
        "method": "debug.tunables",
        "params": {
          "action": "set",
          "key": "sidebar.cornerMorph",
          "value": "off"
        }
      },
      "wait": 1.5
    },
    {
      "title": "Light, sidebar.cornerMorph shell: the titlebar row and the tabs are one band",
      "rpc": {
        "method": "debug.tunables",
        "params": {
          "action": "set",
          "key": "sidebar.cornerMorph",
          "value": "shell"
        }
      },
      "wait": 1.5
    },
    {
      "title": "Light, sidebar.cornerMorph bridge: the selected workspace joins the card",
      "rpc": {
        "method": "debug.tunables",
        "params": {
          "action": "set",
          "key": "sidebar.cornerMorph",
          "value": "bridge"
        }
      },
      "wait": 1.5
    },
    {
      "title": "Light, sidebar.cornerMorph both: shell and bridge",
      "rpc": {
        "method": "debug.tunables",
        "params": {
          "action": "set",
          "key": "sidebar.cornerMorph",
          "value": "both"
        }
      },
      "wait": 1.5
    },
    {
      "title": "Dark",
      "rpc": {
        "method": "debug.appearance",
        "params": {
          "mode": "dark"
        }
      },
      "wait": 1,
      "shot": false,
      "optional": "debug.appearance is DEBUG only"
    },
    {
      "title": "Dark, sidebar.cornerMorph off: the plain card (today)",
      "rpc": {
        "method": "debug.tunables",
        "params": {
          "action": "set",
          "key": "sidebar.cornerMorph",
          "value": "off"
        }
      },
      "wait": 1.5
    },
    {
      "title": "Dark, sidebar.cornerMorph shell: the titlebar row and the tabs are one band",
      "rpc": {
        "method": "debug.tunables",
        "params": {
          "action": "set",
          "key": "sidebar.cornerMorph",
          "value": "shell"
        }
      },
      "wait": 1.5
    },
    {
      "title": "Dark, sidebar.cornerMorph bridge: the selected workspace joins the card",
      "rpc": {
        "method": "debug.tunables",
        "params": {
          "action": "set",
          "key": "sidebar.cornerMorph",
          "value": "bridge"
        }
      },
      "wait": 1.5
    },
    {
      "title": "Dark, sidebar.cornerMorph both: shell and bridge",
      "rpc": {
        "method": "debug.tunables",
        "params": {
          "action": "set",
          "key": "sidebar.cornerMorph",
          "value": "both"
        }
      },
      "wait": 1.5
    },
    {
      "title": "Back to the system appearance",
      "rpc": {
        "method": "debug.appearance",
        "params": {
          "mode": "system"
        }
      },
      "wait": 1,
      "shot": false,
      "optional": "debug.appearance is DEBUG only"
    },
    {
      "title": "Corner morph off",
      "rpc": {
        "method": "debug.tunables",
        "params": {
          "action": "set",
          "key": "sidebar.cornerMorph",
          "value": "off"
        }
      },
      "wait": 1,
      "shot": false
    }
  ]
}
