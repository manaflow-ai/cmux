{
 "title": "Chat header icons, Contextual: after a turn that names a local page",
 "steps": [
  {
   "title": "Launch",
   "wait": 2,
   "shot": false
  },
  {
   "title": "An agent chat in /tmp",
   "cmux": [
    "agent",
    "new-chat",
    "--cwd",
    "/tmp"
   ],
   "wait": 5,
   "shot": false,
   "optional": "agent backend unavailable on this runner"
  },
  {
   "title": "Style: contextual",
   "rpc": {
    "method": "debug.tunables",
    "params": {
     "action": "set",
     "key": "agentChat.headerIcons.contextual",
     "value": "contextual"
    }
   },
   "wait": 1.5,
   "shot": false,
   "optional": "debug.tunables is DEBUG only"
  },
  {
   "title": "A turn that edits three files and names http://localhost:5173/",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "seed_rows",
     "fixture": "worked-turn-page"
    }
   },
   "wait": 2,
   "shot": false
  },
  {
   "title": "Contextual after the turn: the globe appears",
   "wait": 1
  }
 ]
}
