{
  "title": "Pin and Unpin under the pointer on sidebar rows: an unpinned row shows an outline pin beside its more button, a pinned one a filled pin (dark and light). Record it with: cmux-ci capture SHA --state tour:sidebar-hover-pin",
  "settings": {"sidebar": {"hoverCards": {"enabled": false}}},
  "steps": [
    {"title": "Launch", "wait": 3, "shot": false},
    {"title": "New workspace Notes", "cmux": ["workspace", "new", "--name", "Notes"], "wait": 2, "shot": false},
    {"title": "Show Notes", "cmux": ["workspace", "name:Notes", "focus"], "wait": 2, "shot": false},
    {"title": "Pin Notes", "cmux": ["action", "run", "palette.toggleWorkspacePin"], "wait": 2, "shot": false},
    {"title": "New workspace Build", "cmux": ["workspace", "new", "--name", "Build"], "wait": 2, "shot": false},
    {"title": "New workspace Release notes", "cmux": ["workspace", "new", "--name", "Release notes"], "wait": 2, "shot": false},
    {"title": "Dark", "rpc": {"method": "debug.appearance", "params": {"mode": "dark"}}, "wait": 2, "shot": false},
    {"title": "Dark, hover the unpinned row Build", "rpc": {"method": "debug.mouse", "params": {"row": "Build", "action": "move"}}, "wait": 2},
    {"title": "Dark, hover the pinned workspace Notes", "rpc": {"method": "debug.mouse", "params": {"row": "Notes", "action": "move"}}, "wait": 2},
    {"title": "Light", "rpc": {"method": "debug.appearance", "params": {"mode": "light"}}, "wait": 2, "shot": false},
    {"title": "Light, hover the unpinned row Build", "rpc": {"method": "debug.mouse", "params": {"row": "Build", "action": "move"}}, "wait": 2},
    {"title": "Light, hover the pinned workspace Notes", "rpc": {"method": "debug.mouse", "params": {"row": "Notes", "action": "move"}}, "wait": 2}
  ]
}
