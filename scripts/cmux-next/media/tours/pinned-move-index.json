{
  "title": "CLI `cmux workspace <ws> move --index N` (and the MCP workspace_move tool, the same wire op) on a pinned workspace: it moves inside Pinned, under Home, and stays pinned (dark and light). Record it with: cmux-ci capture SHA --state tour:pinned-move-index",
  "settings": {},
  "steps": [
    {
      "title": "Launch",
      "wait": 3,
      "shot": false
    },
    {
      "title": "New workspace Notes",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "Notes"
      ],
      "wait": 2,
      "shot": false
    },
    {
      "title": "Show Notes",
      "cmux": [
        "workspace",
        "name:Notes",
        "focus"
      ],
      "wait": 2,
      "shot": false
    },
    {
      "title": "Pin Notes",
      "cmux": [
        "action",
        "run",
        "palette.toggleWorkspacePin"
      ],
      "wait": 2,
      "shot": false
    },
    {
      "title": "New workspace Build",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "Build"
      ],
      "wait": 2,
      "shot": false
    },
    {
      "title": "Show Build",
      "cmux": [
        "workspace",
        "name:Build",
        "focus"
      ],
      "wait": 2,
      "shot": false
    },
    {
      "title": "Pin Build",
      "cmux": [
        "action",
        "run",
        "palette.toggleWorkspacePin"
      ],
      "wait": 2,
      "shot": false
    },
    {
      "title": "New workspace Vault H1 H2 fixes",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "Vault H1 H2 fixes"
      ],
      "wait": 2,
      "shot": false
    },
    {
      "title": "Show Vault H1 H2 fixes",
      "cmux": [
        "workspace",
        "name:Vault H1 H2 fixes",
        "focus"
      ],
      "wait": 2,
      "shot": false
    },
    {
      "title": "Pin Vault H1 H2 fixes",
      "cmux": [
        "action",
        "run",
        "palette.toggleWorkspacePin"
      ],
      "wait": 2,
      "shot": false
    },
    {
      "title": "Dark: pinned Notes, Build, Vault H1 H2 fixes",
      "wait": 1
    },
    {
      "title": "Dark: CLI `workspace move --index 0` puts Vault H1 H2 fixes first in Pinned, under Home",
      "cmux": [
        "workspace",
        "name:Vault H1 H2 fixes",
        "move",
        "--index",
        "0"
      ],
      "wait": 2
    },
    {
      "title": "Light theme",
      "cmux": [
        "settings",
        "set",
        "appearance.theme",
        "Soft Blue Light"
      ],
      "wait": 3,
      "shot": false
    },
    {
      "title": "Light: CLI `workspace move --index 0` puts Build first in Pinned",
      "cmux": [
        "workspace",
        "name:Build",
        "move",
        "--index",
        "0"
      ],
      "wait": 2
    },
    {
      "title": "Light: CLI `workspace move --index 99` puts Build last in Pinned, still pinned",
      "cmux": [
        "workspace",
        "name:Build",
        "move",
        "--index",
        "99"
      ],
      "wait": 2
    },
    {
      "title": "Back to the dark theme",
      "cmux": [
        "settings",
        "unset",
        "appearance.theme"
      ],
      "wait": 2,
      "shot": false
    }
  ]
}
