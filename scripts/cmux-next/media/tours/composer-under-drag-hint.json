{
  "title": "Agent chat: a divider drag's modifier hint lifts above the composer, which stays put",
  "steps": [
    {
      "title": "Launch",
      "wait": 2
    },
    {
      "title": "New workspace",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "Hint"
      ],
      "shot": false
    },
    {
      "title": "Show the Hint workspace",
      "cmux": [
        "workspace",
        "name:Hint",
        "focus"
      ],
      "wait": 2,
      "shot": false
    },
    {
      "title": "Split right: two terminal panes",
      "cmux": [
        "action",
        "run",
        "splitRight"
      ],
      "wait": 2
    },
    {
      "title": "An agent chat on the right",
      "cmux": [
        "agent",
        "new-chat"
      ],
      "wait": 6,
      "optional": "agent backend unavailable on this runner"
    },
    {
      "title": "Focus left",
      "cmux": [
        "action",
        "run",
        "focusLeft"
      ],
      "shot": false
    },
    {
      "title": "An agent chat on the left",
      "cmux": [
        "agent",
        "new-chat"
      ],
      "wait": 6,
      "optional": "agent backend unavailable on this runner"
    },
    {
      "title": "Two chats, no toast: where the composers rest",
      "wait": 1
    },
    {
      "title": "Shift-drag the divider: the Snap hint shows over the panes' foot, above the composers",
      "rpc": {
        "method": "debug.mouse",
        "params": {
          "action": "drag",
          "divider": "split:",
          "by_x": -80,
          "steps": 20,
          "modifiers": [
            "shift"
          ],
          "release": false
        }
      },
      "wait": 2,
      "optional": "debug.mouse is DEBUG only"
    },
    {
      "title": "Still dragging with Shift: the composers have not moved",
      "rpc": {
        "method": "debug.mouse",
        "params": {
          "action": "drag",
          "divider": "split:",
          "by_x": 60,
          "steps": 20,
          "modifiers": [
            "shift"
          ],
          "press": false,
          "release": false
        }
      },
      "wait": 2,
      "optional": "debug.mouse is DEBUG only"
    },
    {
      "title": "Release: the hint goes, the composers stay",
      "rpc": {
        "method": "debug.mouse",
        "params": {
          "action": "up",
          "divider": "split:"
        }
      },
      "wait": 2,
      "optional": "debug.mouse is DEBUG only"
    }
  ]
}
