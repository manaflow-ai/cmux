{
  "title": "Interface Text Size (David Beyer's feedback, Nov 20): where Settings offers one text size for the sidebar, tabs, menus and chat, and the Set Up cmux card's Text Size and Density row. Light and dark, at the default size and at 15 pt. Record it with: cmux-ci capture SHA --state tour:interface-text-size",
  "settings": {},
  "steps": [
    {"title": "Launch", "wait": 3, "shot": false},
    {"title": "Settings opens on General, light", "cmux": ["action", "run", "openSettings"], "wait": 4},
    {"title": "Settings opens on General, dark", "rpc": {"method": "debug.appearance", "params": {"mode": "dark"}}, "wait": 2,
     "optional": "debug.appearance is DEBUG only"},
    {"title": "Back to light", "rpc": {"method": "debug.appearance", "params": {"mode": "light"}}, "wait": 1, "shot": false,
     "optional": "debug.appearance is DEBUG only"},
    {"title": "Text Size's own row, light", "cmux": ["action", "run", "openSettings", "--setting", "appearance.metrics.chromeFontSize"], "wait": 3},
    {"title": "Set Up cmux card, light", "cmux": ["action", "run", "home.showSetup"], "wait": 4},
    {"title": "Set Up cmux card, dark", "rpc": {"method": "debug.appearance", "params": {"mode": "dark"}}, "wait": 2,
     "optional": "debug.appearance is DEBUG only"},
    {"title": "Text Size 15 pt: sidebar, tabs and chat, dark", "cmux": ["settings", "set", "appearance.metrics.chromeFontSize", "15"], "wait": 3},
    {"title": "Text Size 15 pt, light", "rpc": {"method": "debug.appearance", "params": {"mode": "light"}}, "wait": 2,
     "optional": "debug.appearance is DEBUG only"},
    {"title": "Settings at Text Size 15 pt, light", "cmux": ["action", "run", "openSettings"], "wait": 3}
  ]
}
