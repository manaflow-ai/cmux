{
  "title": "Corner geometry (sidebar and tabs share one shape language)",
  "settings": {
    "appearance": {
      "density": "comfortable"
    }
  },
  "steps": [
    {
      "title": "Launch",
      "wait": 2
    },
    {
      "title": "Corner geometry off",
      "rpc": {
        "method": "debug.tunables",
        "params": {
          "action": "set",
          "key": "chrome.cornerGeometry",
          "value": "off"
        }
      },
      "shot": false,
      "optional": "debug.tunables is DEBUG only"
    },
    {
      "title": "off: new workspace",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "Today (off)"
      ],
      "shot": false
    },
    {
      "title": "off: tab 1",
      "cmux": [
        "tab",
        "new-browser",
        "--url",
        "https://example.com"
      ],
      "wait": 1,
      "shot": false
    },
    {
      "title": "off: tab 2",
      "cmux": [
        "tab",
        "new-browser",
        "--url",
        "https://example.org"
      ],
      "wait": 1,
      "shot": false
    },
    {
      "title": "off: tab 3",
      "cmux": [
        "tab",
        "new-browser",
        "--url",
        "https://example.net"
      ],
      "wait": 2,
      "shot": false
