{
  "title": "New Tab slash menu: the composer's / list in light and dark, at a large, small and narrow window and at both density ends",
  "steps": [
    {"title": "Launch", "wait": 2, "shot": false},
    {"title": "A large window", "rpc": {"method": "debug.window_frame", "params": {"frame": [80, 80, 1440, 860]}}, "wait": 1, "shot": false},
    {"title": "Light", "rpc": {"method": "debug.appearance", "params": {"mode": "light"}}, "wait": 1, "shot": false,
     "optional": "debug.appearance is DEBUG only"},
    {"title": "Large window, light: / opens the command list above the box", "rpc": {"method": "debug.new_tab", "params": {"action": "open_and_type", "text": "/"}}, "wait": 2},
    {"title": "Dark", "rpc": {"method": "debug.appearance", "params": {"mode": "dark"}}, "wait": 2, "shot": false,
     "optional": "debug.appearance is DEBUG only"},
    {"title": "Large window, dark", "rpc": {"method": "debug.new_tab", "params": {"action": "open_and_type", "text": "/"}}, "wait": 2},
    {"title": "A small window", "rpc": {"method": "debug.window_frame", "params": {"frame": [80, 80, 760, 520]}}, "wait": 1, "shot": false},
    {"title": "Small window, dark: the list stays inside the window", "rpc": {"method": "debug.new_tab", "params": {"action": "open_and_type", "text": "/"}}, "wait": 2},
    {"title": "Light again", "rpc": {"method": "debug.appearance", "params": {"mode": "light"}}, "wait": 1, "shot": false,
     "optional": "debug.appearance is DEBUG only"},
    {"title": "Small window, light", "rpc": {"method": "debug.new_tab", "params": {"action": "open_and_type", "text": "/"}}, "wait": 2},
    {"title": "A narrow window", "rpc": {"method": "debug.window_frame", "params": {"frame": [80, 80, 520, 640]}}, "wait": 1, "shot": false},
    {"title": "Narrow window, light: rows truncate, nothing runs past an edge", "rpc": {"method": "debug.new_tab", "params": {"action": "open_and_type", "text": "/"}}, "wait": 2},
    {"title": "Spacious density", "cmux": ["settings", "set", "appearance.density", "spacious"], "wait": 1.5, "shot": false},
    {"title": "Small window, spacious density", "rpc": {"method": "debug.window_frame", "params": {"frame": [80, 80, 760, 520]}}, "wait": 1, "shot": false},
    {"title": "Small window, spacious, light", "rpc": {"method": "debug.new_tab", "params": {"action": "open_and_type", "text": "/"}}, "wait": 2},
    {"title": "Ultra-compact density", "cmux": ["settings", "set", "appearance.density", "ultraCompact"], "wait": 1.5, "shot": false},
    {"title": "Small window, ultra-compact, light", "rpc": {"method": "debug.new_tab", "params": {"action": "open_and_type", "text": "/"}}, "wait": 2},
    {"title": "Default density, large window", "cmux": ["settings", "set", "appearance.density", "cozy"], "wait": 1.5, "shot": false},
    {"title": "Back to a large window", "rpc": {"method": "debug.window_frame", "params": {"frame": [80, 80, 1440, 860]}}, "wait": 1, "shot": false},
    {"title": "An agent chat", "cmux": ["agent", "new-chat"], "wait": 6, "shot": false,
     "optional": "agent backend unavailable on this runner"},
    {"title": "Agent chat, light: / opens the same list above its composer", "rpc": {"method": "debug.key", "params": {"key": "/", "target": "page"}}, "wait": 2,
     "optional": "agent backend unavailable on this runner"},
    {"title": "Agent chat, dark", "rpc": {"method": "debug.appearance", "params": {"mode": "dark"}}, "wait": 2,
     "optional": "debug.appearance is DEBUG only"},
    {"title": "Back to the system appearance", "rpc": {"method": "debug.appearance", "params": {"mode": "system"}}, "wait": 1, "shot": false,
     "optional": "debug.appearance is DEBUG only"}
  ]
}
