{
  "title": "Chat controls in the palette",
  "steps": [
    {"title": "Launch", "wait": 2, "shot": false},
    {"title": "New workspace", "cmux": ["workspace", "new", "--name", "Palette"], "wait": 2, "shot": false},
    {"title": "Show the workspace, not Home (a new workspace takes no focus)", "cmux": ["workspace", "name:Palette", "focus"],
     "wait": 1.5, "shot": false},
    {"title": "Open agent chat", "cmux": ["agent", "new-chat"], "wait": 4, "shot": false,
     "optional": "agent backend unavailable on this runner"},
    {"title": "Close the machine picker", "rpc": {"method": "debug.key", "params": {"key": "escape"}}, "wait": 0.5, "shot": false,
     "optional": "no picker open"},
    {"title": "Close the terminal, which a new chat leaves focused (its prompt names the runner, which PR media refuses)",
     "cmux": ["action", "run", "closePane"], "wait": 1, "shot": false,
     "optional": "closing the terminal asked to confirm"},
    {"title": "Focus the chat (its rows need the chat focused, not the terminal beside it)",
     "cmux": ["action", "run", "focusLeft"], "wait": 0.5, "shot": false,
     "expect": {"method": "debug.focus", "fields": {"context.agent_focused": true}},
     "optional": "agent backend unavailable on this runner"},
    {"title": "Open the palette", "cmux": ["action", "run", "commandPalette"], "wait": 1.5, "shot": false},
    {"title": "Type b", "rpc": {"method": "debug.key", "params": {"key": "b", "target": "palette"}}, "wait": 0.2, "shot": false},
    {"title": "Type a", "rpc": {"method": "debug.key", "params": {"key": "a", "target": "palette"}}, "wait": 0.2, "shot": false},
    {"title": "Type c", "rpc": {"method": "debug.key", "params": {"key": "c", "target": "palette"}}, "wait": 0.2, "shot": false},
    {"title": "Type k", "rpc": {"method": "debug.key", "params": {"key": "k", "target": "palette"}}, "wait": 0.2, "shot": false},
    {"title": "Type g", "rpc": {"method": "debug.key", "params": {"key": "g", "target": "palette"}}, "wait": 0.2, "shot": false},
    {"title": "Type r", "rpc": {"method": "debug.key", "params": {"key": "r", "target": "palette"}}, "wait": 0.2, "shot": false},
    {"title": "Type o", "rpc": {"method": "debug.key", "params": {"key": "o", "target": "palette"}}, "wait": 0.2, "shot": false},
    {"title": "Type u", "rpc": {"method": "debug.key", "params": {"key": "u", "target": "palette"}}, "wait": 0.2, "shot": false},
    {"title": "Type n", "rpc": {"method": "debug.key", "params": {"key": "n", "target": "palette"}}, "wait": 0.2, "shot": false},
    {"title": "Type d", "rpc": {"method": "debug.key", "params": {"key": "d", "target": "palette"}}, "wait": 1.5, "shot": false},
    {"title": "Palette: \"background\" in a new agent chat (Run in Background and Show Background Tasks say why they cannot run yet)", "wait": 0.5},
    {"title": "Close the palette", "cmux": ["action", "run", "commandPalette"], "wait": 1, "shot": false}
  ]
}
