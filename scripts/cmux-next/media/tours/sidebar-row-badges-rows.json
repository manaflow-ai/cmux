{
  "title": "Sidebar: the stacked subagent line and a row's badges (state marks, no clipping under the row) (Variant C: rows only); record: cmux-ci capture SHA --state tour:sidebar-row-badges-rows",
  "steps": [
    {
      "title": "Launch",
      "wait": 4,
      "shot": false
    },
    {
      "title": "Dismiss Meet Chief",
      "rpc": {
        "method": "debug.onboarding",
        "params": {
          "action": "meet_chief_end"
        }
      },
      "wait": 1,
      "shot": false,
      "optional": "debug.onboarding is DEBUG only"
    },
    {
      "title": "Variant C: rows only (set before the rows exist: the layout reads it when it is built)",
      "rpc": {
        "method": "debug.tunables",
        "params": {
          "action": "set",
          "key": "sidebar.subagents.look",
          "value": "rows"
        }
      },
      "wait": 2,
      "shot": false
    },
    {
      "title": "Workspace 1",
      "rpc": {
        "method": "action.run",
        "params": {
          "action": "workspace new",
          "args": {
            "name": "Fix product grid layout shift",
            "focus": true
          },
          "origin": "script"
        }
      },
      "wait": 1,
      "shot": false
    },
    {
      "title": "Workspace 2",
      "rpc": {
        "method": "action.run",
        "params": {
          "action": "workspace new",
          "args": {
            "name": "Upgrade the Stripe SDK",
            "focus": true
          },
          "origin": "script"
        }
      },
      "wait": 1,
      "shot": false
    },
    {
      "title": "Workspace 3",
      "rpc": {
        "method": "action.run",
        "params": {
          "action": "workspace new",
          "args": {
            "name": "Add dark mode color tokens",
            "focus": true
          },
          "origin": "script"
        }
      },
      "wait": 1,
      "shot": false
    },
    {
      "title": "Workspace 4",
      "rpc": {
        "method": "action.run",
        "params": {
          "action": "workspace new",
          "args": {
            "name": "Fix flaky checkout tests",
            "focus": true
          },
          "origin": "script"
        }
      },
      "wait": 1,
      "shot": false
    },
    {
      "title": "Sample subagents on every other row; session tree on (settings)",
      "rpc": {
        "method": "debug.tunables",
        "params": {
          "action": "set",
          "key": "sidebar.subagents.fixture",
          "value": true
        }
      },
      "wait": 2,
      "shot": false
    },
    {
      "title": "Dark",
      "rpc": {
        "method": "debug.appearance",
        "params": {
          "mode": "dark"
        }
      },
      "wait": 2,
      "optional": "debug.appearance is DEBUG only"
    },
    {
      "title": "Light",
      "rpc": {
        "method": "debug.appearance",
        "params": {
          "mode": "light"
        }
      },
      "wait": 2,
      "optional": "debug.appearance is DEBUG only"
    }
  ],
  "settings": {
    "sidebar": {
      "sessionTree": true,
      "hoverCards": {
        "enabled": false
      }
    }
  }
}
