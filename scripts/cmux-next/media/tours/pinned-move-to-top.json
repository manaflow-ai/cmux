{
  "title": "Move Workspace to Top on a pinned workspace: it goes first in Pinned, just under Home, never refused (dark and light). Record it with: cmux-ci capture SHA --state tour:pinned-move-to-top",
  "settings": {},
  "steps": [
    {
      "title": "Launch",
      "wait": 3,
      "shot": false
    },
    {
      "title": "New workspace Notes",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "Notes"
      ],
      "wait": 2,
      "shot": false
    },
    {
      "title": "Show Notes",
      "cmux": [
        "workspace",
        "name:Notes",
        "focus"
      ],
      "wait": 2,
      "shot": false
    },
    {
      "title": "Pin Notes",
      "cmux": [
        "action",
        "run",
        "palette.toggleWorkspacePin"
      ],
      "wait": 2,
      "shot": false
    },
    {
      "title": "New workspace Build",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "Build"
      ],
      "wait": 2,
      "shot": false
    },
    {
      "title": "Show Build",
      "cmux": [
        "workspace",
        "name:Build",
        "focus"
      ],
      "wait": 2,
      "shot": false
    },
    {
      "title": "Pin Build",
      "cmux": [
        "action",
        "run",
        "palette.toggleWorkspacePin"
      ],
      "wait": 2,
      "shot": false
    },
    {
      "title": "New workspace Vault H1 H2 fixes",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "Vault H1 H2 fixes"
      ],
      "wait": 2,
      "shot": false
    },
    {
      "title": "Show Vault H1 H2 fixes",
      "cmux": [
        "workspace",
        "name:Vault H1 H2 fixes",
        "focus"
      ],
      "wait": 2,
      "shot": false
    },
    {
      "title": "Pin Vault H1 H2 fixes",
      "cmux": [
        "action",
        "run",
        "palette.toggleWorkspacePin"
      ],
      "wait": 2,
      "shot": false
    },
    {
      "title": "Dark: Vault H1 H2 fixes is the last pinned workspace, selected",
      "wait": 1
    },
    {
      "title": "Palette: move workspace to top, dark",
      "rpc": {
        "method": "action.run",
        "params": {
          "action": "palette.open",
          "args": {
            "query": "move workspace to top"
          },
          "focus": true
        }
      },
      "wait": 1.5
    },
    {
      "title": "Palette rows for “move workspace to top”, dark",
      "rpc": {
        "method": "debug.palette.capture",
        "params": {
          "path": "{collect}"
        }
      },
      "wait": 0.3,
      "optional": "the palette may not be open",
      "collect": "pinned-move-to-top-palette-dark.png"
    },
    {
      "title": "Close the palette, dark",
      "rpc": {
        "method": "action.run",
        "params": {
          "action": "commandPalette",
          "focus": true
        }
      },
      "wait": 1,
      "optional": "no palette",
      "shot": false
    },
    {
      "title": "Dark: Move Workspace to Top puts it first in Pinned, under Home",
      "cmux": [
        "action",
        "run",
        "palette.moveWorkspaceToTop"
      ],
      "wait": 2
    },
    {
      "title": "Light theme",
      "cmux": [
        "settings",
        "set",
        "appearance.theme",
        "Soft Blue Light"
      ],
      "wait": 3,
      "shot": false
    },
    {
      "title": "Show Build (last pinned now)",
      "cmux": [
        "workspace",
        "name:Build",
        "focus"
      ],
      "wait": 2
    },
    {
      "title": "Palette: move workspace to top, light",
      "rpc": {
        "method": "action.run",
        "params": {
          "action": "palette.open",
          "args": {
            "query": "move workspace to top"
          },
          "focus": true
        }
      },
      "wait": 1.5
    },
    {
      "title": "Palette rows for “move workspace to top”, light",
      "rpc": {
        "method": "debug.palette.capture",
        "params": {
          "path": "{collect}"
        }
      },
      "wait": 0.3,
      "optional": "the palette may not be open",
      "collect": "pinned-move-to-top-palette-light.png"
    },
    {
      "title": "Close the palette, light",
      "rpc": {
        "method": "action.run",
        "params": {
          "action": "commandPalette",
          "focus": true
        }
      },
      "wait": 1,
      "optional": "no palette",
      "shot": false
    },
    {
      "title": "Light: Move Workspace to Top puts Build first in Pinned, under Home",
      "cmux": [
        "action",
        "run",
        "palette.moveWorkspaceToTop"
      ],
      "wait": 2
    },
    {
      "title": "Light: Move Workspace to Bottom puts Build last in Pinned",
      "cmux": [
        "action",
        "run",
        "workspace.moveToBottom"
      ],
      "wait": 2
    },
    {
      "title": "Back to the dark theme",
      "cmux": [
        "settings",
        "unset",
        "appearance.theme"
      ],
      "wait": 2,
      "shot": false
    }
  ]
}
