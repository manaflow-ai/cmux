{
  "title": "Host pressure gauges (RFD 0182 B10): bars, segmented meters and compact chips in the popover",
  "steps": [
    {"title": "Launch: the gauges ship off (Debug choice hostPressure.gauges)", "wait": 2, "shot": false},
    {"title": "Indicator on",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "hostPressure.enabled", "value": true}}, "wait": 1, "shot": false,
     "optional": "debug.tunables is DEBUG only"},
    {"title": "Critical: a forced level's sample readings for all five gauges",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "hostPressure.force", "value": "critical"}}, "wait": 2, "shot": false,
     "optional": "debug.tunables is DEBUG only"},
    {"title": "Gauges off: the popover as it ships",
     "rpc": {"method": "debug.host_pressure", "params": {"action": "open"}}, "wait": 2,
     "optional": "debug.host_pressure is DEBUG only"},
    {"title": "Closed", "rpc": {"method": "debug.host_pressure", "params": {"action": "close"}}, "wait": 1, "shot": false,
     "optional": "debug.host_pressure is DEBUG only"},
    {"title": "Version A: bars with their numbers",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "hostPressure.gauges", "value": "bars"}}, "wait": 1, "shot": false,
     "optional": "debug.tunables is DEBUG only"},
    {"title": "Version A: bars with their numbers in the critical popover",
     "rpc": {"method": "debug.host_pressure", "params": {"action": "open"}}, "wait": 2,
     "optional": "debug.host_pressure is DEBUG only"},
    {"title": "Closed", "rpc": {"method": "debug.host_pressure", "params": {"action": "close"}}, "wait": 1, "shot": false,
     "optional": "debug.host_pressure is DEBUG only"},
    {"title": "Version B: segmented meters",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "hostPressure.gauges", "value": "meters"}}, "wait": 1, "shot": false,
     "optional": "debug.tunables is DEBUG only"},
    {"title": "Version B: segmented meters in the critical popover",
     "rpc": {"method": "debug.host_pressure", "params": {"action": "open"}}, "wait": 2,
     "optional": "debug.host_pressure is DEBUG only"},
    {"title": "Closed", "rpc": {"method": "debug.host_pressure", "params": {"action": "close"}}, "wait": 1, "shot": false,
     "optional": "debug.host_pressure is DEBUG only"},
    {"title": "Version C: compact chips",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "hostPressure.gauges", "value": "compact"}}, "wait": 1, "shot": false,
     "optional": "debug.tunables is DEBUG only"},
    {"title": "Version C: compact chips in the critical popover",
     "rpc": {"method": "debug.host_pressure", "params": {"action": "open"}}, "wait": 2,
     "optional": "debug.host_pressure is DEBUG only"},
    {"title": "Closed", "rpc": {"method": "debug.host_pressure", "params": {"action": "close"}}, "wait": 1, "shot": false,
     "optional": "debug.host_pressure is DEBUG only"},
    {"title": "Warning level",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "hostPressure.force", "value": "warning"}}, "wait": 2, "shot": false,
     "optional": "debug.tunables is DEBUG only"},
    {"title": "Version A at warning: bars, fewer of them hot",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "hostPressure.gauges", "value": "bars"}}, "wait": 1, "shot": false,
     "optional": "debug.tunables is DEBUG only"},
    {"title": "Version A at warning in the popover",
     "rpc": {"method": "debug.host_pressure", "params": {"action": "open"}}, "wait": 2,
     "optional": "debug.host_pressure is DEBUG only"},
    {"title": "Closed", "rpc": {"method": "debug.host_pressure", "params": {"action": "close"}}, "wait": 1, "shot": false,
     "optional": "debug.host_pressure is DEBUG only"},
    {"title": "Dark", "rpc": {"method": "debug.appearance", "params": {"mode": "dark"}}, "wait": 1, "shot": false,
     "optional": "debug.appearance is DEBUG only"},
    {"title": "Version A at warning in dark",
     "rpc": {"method": "debug.host_pressure", "params": {"action": "open"}}, "wait": 2,
     "optional": "debug.host_pressure is DEBUG only"},
    {"title": "Closed", "rpc": {"method": "debug.host_pressure", "params": {"action": "close"}}, "wait": 1, "shot": false,
     "optional": "debug.host_pressure is DEBUG only"},
    {"title": "Back to the system appearance",
     "rpc": {"method": "debug.appearance", "params": {"mode": "system"}}, "wait": 1, "shot": false,
     "optional": "debug.appearance is DEBUG only"},
    {"title": "Gauges off again",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "hostPressure.gauges", "value": "off"}}, "wait": 1, "shot": false,
     "optional": "debug.tunables is DEBUG only"},
    {"title": "Back to the host's real level",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "hostPressure.force", "value": "off"}}, "wait": 1, "shot": false,
     "optional": "debug.tunables is DEBUG only"},
    {"title": "Indicator off again",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "hostPressure.enabled", "value": false}}, "wait": 1, "shot": false,
     "optional": "debug.tunables is DEBUG only"}
  ]
}
