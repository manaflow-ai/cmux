{
  "title": "Chief computer picker: the Computer tab of a Chief's profile with sample machines, a Cloud computer attached",
  "steps": [
    {
      "title": "Launch",
      "wait": 2,
      "shot": false
    },
    {
      "title": "Home at the Chief",
      "cmux": [
        "action",
        "run",
        "home.show"
      ],
      "wait": 5,
      "shot": false
    },
    {
      "title": "The Computer tab",
      "rpc": {
        "method": "debug.home.drive",
        "params": {
          "action": "chief_computer"
        }
      },
      "wait": 3,
      "shot": false,
      "optional": "debug.home.drive is DEBUG only"
    },
    {
      "title": "Again, once the card's first read has landed: the Chief's computer is on the picker's face",
      "rpc": {
        "method": "debug.home.drive",
        "params": {
          "action": "chief_computer"
        }
      },
      "wait": 0.2,
      "optional": "debug.home.drive is DEBUG only"
    }
  ]
}
