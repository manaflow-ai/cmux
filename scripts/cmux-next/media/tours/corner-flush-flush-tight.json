{
 "title": "Corner flush: Flush, tight (comfortable)",
 "settings": {
  "appearance": {
   "density": "comfortable"
  }
 },
 "steps": [
  {
   "title": "Launch",
   "wait": 3
  },
  {
   "title": "Corner flush flush-tight",
   "rpc": {
    "method": "debug.tunables",
    "params": {
     "action": "set",
     "key": "chrome.cornerFlush",
     "value": "flush-tight"
    }
   },
   "shot": false,
   "optional": "debug.tunables is DEBUG only"
  },
  {
   "title": "Workspace docs",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "docs"
   ],
   "shot": false
  },
  {
   "title": "Workspace api",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "api"
   ],
   "shot": false
  },
  {
   "title": "Workspace Tight",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Tight"
   ],
   "shot": false
  },
  {
   "title": "Quiet prompt",
   "cmux": [
    "workspace",
    "name:Tight",
    "screen",
    "current",
    "pane",
    "current",
    "tab",
    "current",
    "terminal",
    "current",
    "write",
    "--text",
    "export PS1='$ ' PROMPT='$ '; printf '\\033[2J\\033[3J\\033[H'\n"
   ],
   "wait": 1,
   "shot": false
  },
  {
   "title": "Show it",
   "cmux": [
    "workspace",
    "name:Tight",
    "focus"
   ],
   "wait": 2,
   "shot": false
  },
  {
   "title": "Name the first tab",
   "cmux": [
    "workspace",
    "name:Tight",
    "screen",
    "current",
    "pane",
    "current",
    "tab",
    "current",
    "rename",
    "shell"
   ],
   "shot": false,
   "optional": "a name only for the later focus step"
  },
  {
   "title": "Browser tab Docs",
   "cmux": [
    "tab",
    "create",
    "browser",
    "--url",
    "https://example.com",
    "--name",
    "Docs",
    "--workspace",
    "name:Tight"
   ],
   "wait": 3,
   "shot": false
  },
  {
   "title": "Browser tab API",
   "cmux": [
    "tab",
    "create",
    "browser",
    "--url",
    "https://example.org",
    "--name",
    "API",
    "--workspace",
    "name:Tight"
   ],
   "wait": 3,
   "shot": false
  },
  {
   "title": "Browser tab Notes",
   "cmux": [
    "tab",
    "create",
    "browser",
    "--url",
    "https://example.net",
    "--name",
    "Notes",
    "--workspace",
    "name:Tight"
   ],
   "wait": 3,
   "shot": false
  },
  {
   "title": "Focus the first tab",
   "cmux": [
    "workspace",
    "name:Tight",
    "screen",
    "current",
    "pane",
    "current",
    "tab",
    "name:shell",
    "focus"
   ],
   "wait": 1,
   "shot": false,
   "optional": "the first tab may already be selected"
  },
  {
   "title": "Flush, tight: the first tab selected",
   "wait": 2
  },
  {
   "title": "Select the second tab",
   "cmux": [
    "workspace",
    "name:Tight",
    "screen",
    "current",
    "pane",
    "current",
    "tab",
    "name:Docs",
    "focus"
   ],
   "wait": 2
  },
  {
   "title": "Select the third tab",
   "cmux": [
    "workspace",
    "name:Tight",
    "screen",
    "current",
    "pane",
    "current",
    "tab",
    "name:API",
    "focus"
   ],
   "wait": 2
  },
  {
   "title": "Back to the first tab",
   "cmux": [
    "workspace",
    "name:Tight",
    "screen",
    "current",
    "pane",
    "current",
    "tab",
    "name:shell",
    "focus"
   ],
   "wait": 2
  }
 ]
}
