{
 "title": "Hard-edge chrome transitions: value changes, tab and workspace switches, sidebar hide and show",
 "settings": {
  "appearance": {
   "density": "comfortable"
  }
 },
 "steps": [
  {
   "title": "Launch",
   "wait": 3
  },
  {
   "title": "Hard-edge chrome off",
   "rpc": {
    "method": "debug.tunables",
    "params": {
     "action": "set",
     "key": "chrome.hardEdge",
     "value": "off"
    }
   },
   "shot": false,
   "optional": "debug.tunables is DEBUG only"
  },
  {
   "title": "A second workspace in the sidebar",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "docs"
   ],
   "wait": 1,
   "shot": false
  },
  {
   "title": "A third workspace in the sidebar",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "api"
   ],
   "wait": 1,
   "shot": false
  },
  {
   "title": "The workspace shown",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Corner"
   ],
   "wait": 1,
   "shot": false
  },
  {
   "title": "Show it",
   "cmux": [
    "workspace",
    "name:Corner",
    "focus"
   ],
   "wait": 2,
   "shot": false
  },
  {
   "title": "Browser tab",
   "cmux": [
    "tab",
    "new-browser",
    "--url",
    "https://example.com"
   ],
   "wait": 4,
   "shot": false
  },
  {
   "title": "Second browser tab",
   "cmux": [
    "tab",
    "new-browser",
    "--url",
    "https://example.org"
   ],
   "wait": 4,
   "shot": false
  },
  {
   "title": "Today",
   "wait": 2
  },
  {
   "title": "off \u2192 chamfer",
   "rpc": {
    "method": "debug.tunables",
    "params": {
     "action": "set",
     "key": "chrome.hardEdge",
     "value": "chamfer"
    }
   },
   "shot": true,
   "optional": "debug.tunables is DEBUG only",
   "wait": 2
  },
  {
   "title": "chamfer \u2192 blade",
   "rpc": {
    "method": "debug.tunables",
    "params": {
     "action": "set",
     "key": "chrome.hardEdge",
     "value": "blade"
    }
   },
   "shot": true,
   "optional": "debug.tunables is DEBUG only",
   "wait": 2
  },
  {
   "title": "blade \u2192 hud",
   "rpc": {
    "method": "debug.tunables",
    "params": {
     "action": "set",
     "key": "chrome.hardEdge",
     "value": "hud"
    }
   },
   "shot": true,
   "optional": "debug.tunables is DEBUG only",
   "wait": 2
  },
  {
   "title": "hud \u2192 blade",
   "rpc": {
    "method": "debug.tunables",
    "params": {
     "action": "set",
     "key": "chrome.hardEdge",
     "value": "blade"
    }
   },
   "shot": true,
   "optional": "debug.tunables is DEBUG only",
   "wait": 2
  },
  {
   "title": "Next tab",
   "cmux": [
    "action",
    "run",
    "tab.next"
   ],
   "wait": 2,
   "shot": true
  },
  {
   "title": "Next tab again",
   "cmux": [
    "action",
    "run",
    "tab.next"
   ],
   "wait": 2,
   "shot": true
  },
  {
   "title": "Another workspace",
   "cmux": [
    "workspace",
    "name:api",
    "focus"
   ],
   "wait": 2,
   "shot": true
  },
  {
   "title": "Back to Corner",
   "cmux": [
    "workspace",
    "name:Corner",
    "focus"
   ],
   "wait": 2,
   "shot": true
  },
  {
   "title": "Hide the sidebar",
   "cmux": [
    "action",
    "run",
    "toggleSidebar"
   ],
   "wait": 2,
   "shot": true
  },
  {
   "title": "Show the sidebar",
   "cmux": [
    "action",
    "run",
    "toggleSidebar"
   ],
   "wait": 2,
   "shot": true
  }
 ]
}
