{
  "title": "Sidebar edit mode",
  "steps": [
    {"title": "Launch: the sidebar as it opens", "wait": 2},
    {"title": "Edit Sidebar: the items wiggle and show their ✕; the bar offers Add Items and Done", "cmux": ["action", "run", "sidebar.edit"], "wait": 2},
    {"title": "Dark", "rpc": {"method": "debug.appearance", "params": {"mode": "dark"}}, "wait": 2,
     "optional": "debug.appearance is DEBUG only"},
    {"title": "Back to the system appearance", "rpc": {"method": "debug.appearance", "params": {"mode": "system"}}, "wait": 1, "shot": false,
     "optional": "debug.appearance is DEBUG only"},
    {"title": "Done: the sidebar is still again", "cmux": ["action", "run", "sidebar.edit"], "wait": 2},
    {"title": "Add Items: App Store Features with the Home, Notifications, History and Bookmarks cards", "cmux": ["action", "run", "appStore.show", "--tab", "features", "--focus"], "wait": 3}
  ]
}
