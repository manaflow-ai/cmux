{
 "title": "Hard-edge chrome (hud): sidebar corner and tab row (comfortable)",
 "settings": {
  "appearance": {
   "density": "comfortable"
  }
 },
 "steps": [
  {
   "title": "Launch",
   "wait": 3
  },
  {
   "title": "Hard-edge chrome hud",
   "rpc": {
    "method": "debug.tunables",
    "params": {
     "action": "set",
     "key": "chrome.hardEdge",
     "value": "hud"
    }
   },
   "shot": false,
   "optional": "debug.tunables is DEBUG only"
  },
  {
   "title": "A second workspace in the sidebar",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "docs",
    "--cwd",
    "/tmp"
   ],
   "wait": 1,
   "shot": false
  },
  {
   "title": "A third workspace in the sidebar",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "api",
    "--cwd",
    "/tmp"
   ],
   "wait": 1,
   "shot": false
  },
  {
   "title": "The workspace shown",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Corner",
    "--cwd",
    "/tmp"
   ],
   "wait": 1,
   "shot": false
  },
  {
   "title": "Show it",
   "cmux": [
    "workspace",
    "name:Corner",
    "focus"
   ],
   "wait": 2,
   "shot": false
  },
  {
   "title": "A quiet prompt",
   "daemon": true,
   "cmux": [
    "workspace",
    "name:Corner",
    "screen",
    "current",
    "pane",
    "current",
    "tab",
    "current",
    "terminal",
    "current",
    "write",
    "--text",
    "PS1='$ '; PROMPT='$ '; clear\r"
   ],
   "wait": 1,
   "shot": false
  },
  {
   "title": "Browser tab",
   "cmux": [
    "tab",
    "new-browser",
    "--url",
    "https://example.com"
   ],
   "wait": 4,
   "shot": false
  },
  {
   "title": "Second browser tab",
   "cmux": [
    "tab",
    "new-browser",
    "--url",
    "https://example.org"
   ],
   "wait": 4,
   "shot": false
  },
  {
   "title": "HUD: layered frames with diamond rivets",
   "wait": 2
  }
 ]
}
