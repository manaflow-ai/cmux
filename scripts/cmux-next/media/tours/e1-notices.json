{
  "title": "Error and notice states: a real restart, a terminal link blip, an unreachable host and a refused agent start, each read back",
  "steps": [
    {"title": "Launch", "wait": 3, "shot": false},
    {"title": "Toasts right after launch (expect none: no launch noise)", "rpc": {"method": "debug.toast", "params": {}}, "wait": 0.5,
     "readback": {"at": "windows.*.toasts", "empty": true}},
    {"title": "Home", "cmux": ["action", "run", "home.show"], "wait": 4},
    {"title": "Turn on Home Channels", "cmux": ["action", "run", "home.enableChannels"], "wait": 1, "shot": false, "optional": "Home Channels may not be offered on this build"},
    {"title": "Home Channels", "cmux": ["action", "run", "home.switchView", "--view", "channels"], "wait": 3, "optional": "Home Channels may not be offered on this build"},
    {"title": "Home's daemon gate line (expect none while the daemon answers)", "rpc": {"method": "debug.page", "params": {"page": "cmux.home-channels", "action": "query", "selector": ".hc-gate-error, .hc-gate-line"}}, "wait": 0.2, "shot": false, "optional": "Home channels page may not be live on this build",
     "readback": {"at": "elements", "empty": true}},
    {"title": "Feed toast stack is a Notifications region", "rpc": {"method": "debug.page", "params": {"page": "cmux.feed", "action": "query", "selector": ".ui-notice-stack"}}, "wait": 0.2, "shot": false, "optional": "the Feed page shows only in Chief Home's Needs you; no verb opens it in a fresh run"},
    {"title": "A terminal workspace", "cmux": ["workspace", "new", "--name", "Notices"], "wait": 3},
    {"title": "Terminal link drops (blip, 1 s): no Reconnecting label yet", "rpc": {"method": "debug.terminal_state", "params": {"state": "reconnecting"}}, "wait": 1, "optional": "debug.terminal_state is DEBUG only",
     "readback": {"at": "state", "contains": ["reconnecting"]}},
    {"title": "Terminal link back within the reveal delay", "rpc": {"method": "debug.terminal_state", "params": {"state": "running"}}, "wait": 1, "optional": "debug.terminal_state is DEBUG only",
     "readback": {"at": "state", "contains": ["running"]}},
    {"title": "Toasts after the blip (expect none)", "rpc": {"method": "debug.toast", "params": {}}, "wait": 0.2, "shot": false,
     "readback": {"at": "windows.*.toasts", "empty": true}},
    {"title": "Terminal link down past the 5 s reveal delay: the pane says so", "rpc": {"method": "debug.terminal_state", "params": {"state": "reconnecting"}}, "wait": 6.5, "optional": "debug.terminal_state is DEBUG only",
     "readback": {"at": "state", "contains": ["reconnecting"]}},
    {"title": "Terminal link back", "rpc": {"method": "debug.terminal_state", "params": {"state": "running"}}, "wait": 1, "shot": false, "optional": "debug.terminal_state is DEBUG only",
     "readback": {"at": "state", "contains": ["running"]}},
    {"title": "Restart cmux-tui: its confirm", "cmux": ["action", "run", "palette.restartServer"], "wait": 1.5},
    {"title": "Read the confirm", "rpc": {"method": "debug.dialog", "params": {}}, "wait": 0.2, "shot": false,
     "readback": {"at": "dialogs", "count": 1, "contains": ["restart"], "absent": ["error", "exited", "os error"]}},
    {"title": "Confirm the restart", "rpc": {"method": "debug.dialog", "params": {"press": "restart"}}, "wait": 0.2, "shot": false},
    {"title": "Toasts after the restart (expect one plain result line)", "rpc": {"method": "debug.toast", "params": {}}, "wait": 0.5,
     "readback": {"at": "windows.*.toasts", "count": 1, "within": 20,
                  "absent": ["error:", "os error", "exited", "errno", "connection refused", "broken pipe", "panicked", "{"]}},
    {"title": "Home after the restart", "cmux": ["action", "run", "home.show"], "wait": 3},
    {"title": "Home Channels after the restart", "cmux": ["action", "run", "home.switchView", "--view", "channels"], "wait": 3, "optional": "Home Channels may not be offered on this build"},
    {"title": "Home's daemon gate line after the restart (expect none)", "rpc": {"method": "debug.page", "params": {"page": "cmux.home-channels", "action": "query", "selector": ".hc-gate-error, .hc-gate-line"}}, "wait": 0.2, "shot": false, "optional": "Home channels page may not be live on this build",
     "readback": {"at": "elements", "empty": true}},
    {"title": "Connect to an unreachable host", "cmux": ["action", "run", "remote.connect", "--destination", "nohost.invalid", "--focus"], "wait": 8},
    {"title": "Read the recovery dialog", "rpc": {"method": "debug.dialog", "params": {}}, "wait": 0.2, "shot": false,
     "readback": {"at": "dialogs", "contains": ["cannot reach nohost", "Copy Error"], "within": 20,
                  "absent": ["route candidates", "exited 255", "nodename", "Could not resolve"]}},
    {"title": "The machine's status line (the same sentence, from remote.machines)", "rpc": {"method": "remote.machines", "params": {}}, "wait": 0.2, "shot": false,
     "readback": {"at": "machines.*.detail", "contains": ["cannot reach nohost"], "within": 10,
                  "absent": ["route candidates", "exited 255", "nodename", "Could not resolve", "ssh:"]}},
    {"title": "Dismiss recovery", "rpc": {"method": "debug.dialog", "params": {"dismiss": true}}, "wait": 0.5, "shot": false, "optional": "no recovery dialog to dismiss"},
    {"title": "Toasts after the unreachable host", "rpc": {"method": "debug.toast", "params": {}}, "wait": 0.2, "shot": false,
     "readback": {"at": "windows.*.toasts", "absent": ["route candidates", "exited 255", "nodename", "Could not resolve", "error:", "os error"]}},
    {"title": "Start an agent chat with a harness that does not exist", "cmux": ["agents", "chat", "new", "--harness", "e1-no-such-harness", "--name", "e1-refused", "--", "hello"], "wait": 3, "optional": "the CLI refuses an unknown harness; its words are the read-back"},
    {"title": "Toasts after the refused agent start", "rpc": {"method": "debug.toast", "params": {}}, "wait": 0.5,
     "readback": {"at": "windows.*.toasts", "absent": ["chat.create_failed", "e1-no-such-harness", "families:", "profiles:", "presets:", "\"code\"", "error:"]}},
    {"title": "Open an agent chat", "cmux": ["agent", "new-chat"], "wait": 5, "optional": "agent backend unavailable on this runner"},
    {"title": "The chat's state as its pane shows it", "rpc": {"method": "debug.agent_pane", "params": {"action": "chat_state"}}, "wait": 0.5, "optional": "agent backend unavailable on this runner"},
    {"title": "Toasts at the end", "rpc": {"method": "debug.toast", "params": {}}, "wait": 0.5,
     "readback": {"at": "windows.*.toasts", "absent": ["error:", "os error", "exited", "errno", "panicked", "route candidates", "nodename", "chat.create_failed"]}}
  ]
}
