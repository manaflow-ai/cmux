{
  "title": "Where a tab's spinner and unread dot sit beside its title (Leo 2026-10-22, ask-a8b97f1201: the spacing)",
  "steps": [
    {"title": "Launch", "wait": 3, "shot": false},
    {"title": "New workspace", "cmux": ["workspace", "new", "--name", "Spacing"], "shot": false},
    {"title": "Show the Spacing workspace", "cmux": ["workspace", "name:Spacing", "focus"], "wait": 1, "shot": false},
    {"title": "Name the first tab", "cmux": ["tab", "current", "rename", "--name", "Release notes build for the nightly"], "wait": 1, "shot": false},
    {"title": "The first tab works, then finishes with unread output", "daemon": true,
     "cmux": ["workspace", "name:Spacing", "screen", "current", "pane", "current", "tab", "current", "terminal", "current", "write", "--text",
              "clear; sleep 2; printf '\\033]7501;state=working\\033\\\\'; sleep 30; printf '\\033]777;notify;Build;Done\\007'; printf '\\033]7501;state=idle\\033\\\\'; sleep 900\r"],
     "shot": false},
    {"title": "A second tab, so the first works in the background", "cmux": ["action", "run", "newSurface"], "wait": 1, "shot": false},
    {"title": "Name the second tab", "cmux": ["tab", "current", "rename", "--name", "Shell"], "wait": 4, "shot": false},
    {"title": "Busy, before: the spinner in the close button's slot",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "tabs.statusMarkPlacement", "value": "closeSlot"}},
     "optional": "debug.tunables is DEBUG only", "wait": 2},
    {"title": "Busy, the default: the spinner mirrors the icon",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "tabs.statusMarkPlacement", "value": "mirrorIcon"}},
     "optional": "debug.tunables is DEBUG only", "wait": 2},
    {"title": "Busy: the spinner and the close button mirror the icon",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "tabs.statusMarkPlacement", "value": "mirrorAll"}},
     "optional": "debug.tunables is DEBUG only", "wait": 2},
    {"title": "The work ends with unread output", "wait": 24, "shot": false},
    {"title": "Unread, before: the dot in the close button's slot",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "tabs.statusMarkPlacement", "value": "closeSlot"}},
     "optional": "debug.tunables is DEBUG only", "wait": 2},
    {"title": "Unread, the default: the dot mirrors the icon",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "tabs.statusMarkPlacement", "value": "mirrorIcon"}},
     "optional": "debug.tunables is DEBUG only", "wait": 2},
    {"title": "Unread: the dot and the close button mirror the icon",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "tabs.statusMarkPlacement", "value": "mirrorAll"}},
     "optional": "debug.tunables is DEBUG only", "wait": 2},
    {"title": "Back to the default",
     "rpc": {"method": "debug.tunables", "params": {"action": "set", "key": "tabs.statusMarkPlacement", "value": "mirrorIcon"}},
     "optional": "debug.tunables is DEBUG only", "wait": 1, "shot": false}
  ]
}
