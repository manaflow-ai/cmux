    {"title": "Type 'e'", "rpc": {"method": "debug.key", "params": {"key": "e", "target": "palette"}}, "wait": 0.05, "shot": false},
    {"title": "Type 'c'", "rpc": {"method": "debug.key", "params": {"key": "c", "target": "palette"}}, "wait": 0.05, "shot": false},
