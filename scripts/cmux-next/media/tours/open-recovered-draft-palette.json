{
  "title": "Open Recovered Draft… in the palette's Commands scope",
  "steps": [
    {"title": "Launch", "wait": 2, "shot": false},
    {"title": "Diagnostic: open the Commands scope with the query as an argument, and check the drawn field shows it", "cmux": ["action", "run", "palette.open", "--arg", "scope=commands", "--arg", "query=Open Recovered Draft", "--focus"], "wait": 1, "shot": false, "optional": "diagnostic only, the steps below type the query", "expect": {"method": "debug.focus", "fields": {"palette.open": true, "palette.query": "Open Recovered Draft", "palette.field": "Open Recovered Draft"}}},
    {"title": "Open the Commands scope empty (only catalog actions: no workspace, tab or draft rows)", "cmux": ["action", "run", "palette.open", "--arg", "scope=commands", "--focus"], "wait": 1, "shot": false, "expect": {"method": "debug.focus", "fields": {"palette.open": true, "palette.query": "", "palette.field": ""}}},
    {"title": "Type 'O'", "rpc": {"method": "debug.key", "params": {"key": "O", "target": "palette"}}, "wait": 0.05, "shot": false},
    {"title": "Type 'p'", "rpc": {"method": "debug.key", "params": {"key": "p", "target": "palette"}}, "wait": 0.05, "shot": false},
    {"title": "Type 'e'", "rpc": {"method": "debug.key", "params": {"key": "e", "target": "palette"}}, "wait": 0.05, "shot": false},
