    {"title": "Type 'v'", "rpc": {"method": "debug.key", "params": {"key": "v", "target": "palette"}}, "wait": 0.05, "shot": false},
    {"title": "Type 'e'", "rpc": {"method": "debug.key", "params": {"key": "e", "target": "palette"}}, "wait": 0.05, "shot": false},
    {"title": "Type 'r'", "rpc": {"method": "debug.key", "params": {"key": "r", "target": "palette"}}, "wait": 0.05, "shot": false},
    {"title": "Type 'e'", "rpc": {"method": "debug.key", "params": {"key": "e", "target": "palette"}}, "wait": 0.05, "shot": false},
    {"title": "Type 'd'", "rpc": {"method": "debug.key", "params": {"key": "d", "target": "palette"}}, "wait": 0.05, "shot": false},
