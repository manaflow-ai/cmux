{
  "title": "Import Cookies banner",
  "windows": [
    {
      "name": "banner-overlay",
      "class": "OverlayHostPanel"
    }
  ],
  "steps": [
    {
      "title": "Launch",
      "wait": 2,
      "shot": false
    },
    {
      "title": "Fresh state: the banner setting on",
      "rpc": {
        "method": "debug.browser_import_offer",
        "params": {
          "action": "reset"
        }
      },
      "shot": false
    },
    {
      "title": "Browser workspace",
      "cmux": [
        "action",
        "run",
        "newBrowserWorkspace"
      ],
      "wait": 3,
      "shot": false
    },
    {
      "title": "A page in the person's own browser tab",
      "cmux": [
        "tab",
        "new-browser",
        "--url",
        "https://example.com"
      ],
      "wait": 5,
      "shot": false
    },
    {
      "title": "The banner offers to import cookies, with Don't Show Again, Not Now and Import",
      "rpc": {
        "method": "debug.browser_import_offer",
        "params": {
          "action": "show"
        }
      },
      "wait": 3,
      "expect": {
        "method": "debug.browser_import_offer",
        "fields": {
          "showing": true,
          "offered": true
        }
      }
    },
    {
      "title": "Don't Show Again: browser.import.cookieBanner turns off and the banner goes",
      "rpc": {
        "method": "debug.browser_import_offer",
        "params": {
          "action": "answer",
          "choice": "never"
        }
      },
      "wait": 3,
      "expect": {
        "method": "debug.browser_import_offer",
        "fields": {
          "dismissed": true,
          "offered": false,
          "showing": false
        }
      }
    },
    {
      "title": "Show Import Cookies Banner (cmux browser show-cookie-banner): back on and shown again",
      "cmux": [
        "browser",
        "show-cookie-banner"
      ],
      "wait": 4,
      "expect": {
        "method": "debug.browser_import_offer",
        "fields": {
          "dismissed": false,
          "showing": true
        }
      }
    }
  ]
}
