{
  "title": "Extension SDK: the activity example, built only on cmux-extension-sdk, end to end and live reload",
  "customize": true,
  "steps": [
    {
      "title": "Launch",
      "wait": 4
    },
    {
      "title": "Workspace Alpha",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "Alpha"
      ],
      "wait": 3,
      "shot": false
    },
    {
      "title": "Workspace Beta",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "Beta"
      ],
      "wait": 3,
      "shot": false
    },
    {
      "title": "Show Alpha",
      "cmux": [
        "workspace",
        "name:Alpha",
        "focus"
      ],
      "wait": 2,
      "shot": false
    },
    {
      "title": "Bundle part 1 of 4 (gzip, base64) to a temp file",
      "daemon": true,
      "cmux": [
        "workspace",
        "name:Alpha",
        "screen",
        "current",
        "pane",
        "current",
        "tab",
        "current",
        "terminal",
        "current",
        "write",
        "--text",
        "clear; D=\"${CMUX_CUSTOMIZE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/cmux/customize}\"; T=\"${TMPDIR:-/tmp}/cmux-tour-activity\"; mkdir -p \"$T\"; : > \"$T/main.b64\"; printf %s  >> \"$T/main.b64\"; clear\r"
      ],
      "wait": 2,
      "shot": false
    },
    {
      "title": "Bundle part 2 of 4 (gzip, base64) to a temp file",
      "daemon": true,
      "cmux": [
        "workspace",
        "name:Alpha",
        "screen",
        "current",
        "pane",
        "current",
        "tab",
        "current",
        "terminal",
        "current",
        "write",
        "--text",
        "clear; D=\"${CMUX_CUSTOMIZE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/cmux/customize}\"; T=\"${TMPDIR:-/tmp}/cmux-tour-activity\"; printf %s  >> \"$T/main.b64\"; clear\r"
      ],
      "wait": 2,
      "shot": false
    },
    {
      "title": "Bundle part 3 of 4 (gzip, base64) to a temp file",
      "daemon": true,
      "cmux": [
        "workspace",
        "name:Alpha",
        "screen",
        "current",
        "pane",
        "current",
        "tab",
        "current",
        "terminal",
        "current",
        "write",
        "--text",
        "clear; D=\"${CMUX_CUSTOMIZE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/cmux/customize}\"; T=\"${TMPDIR:-/tmp}/cmux-tour-activity\"; printf %s  >> \"$T/main.b64\"; clear\r"
      ],
      "wait": 2,
      "shot": false
    },
    {
      "title": "Bundle part 4 of 4 (gzip, base64) to a temp file",
      "daemon": true,
      "cmux": [
        "workspace",
        "name:Alpha",
        "screen",
        "current",
        "pane",
        "current",
        "tab",
        "current",
        "terminal",
        "current",
        "write",
        "--text",
        "clear; D=\"${CMUX_CUSTOMIZE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/cmux/customize}\"; T=\"${TMPDIR:-/tmp}/cmux-tour-activity\"; printf %s  >> \"$T/main.b64\"; clear\r"
      ],
      "wait": 2,
      "shot": false
    },
    {
      "title": "Install: examples/extensions/activity packed by pack.ts against cmux-extension-sdk (sha256 aded781d...), manifest id rewritten to local/customize, saved into the customize folder; the Activity section lists the workspaces",
      "daemon": true,
      "cmux": [
        "workspace",
        "name:Alpha",
        "screen",
        "current",
        "pane",
        "current",
        "tab",
        "current",
        "terminal",
        "current",
        "write",
        "--text",
        "clear; D=\"${CMUX_CUSTOMIZE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/cmux/customize}\"; T=\"${TMPDIR:-/tmp}/cmux-tour-activity\"; mkdir -p \"$D/dist\" && base64 -d < \"$T/main.b64\" | gunzip > \"$T/main.js\" && cat \"$T/main.js\" > \"$D/dist/main.js\" && echo  | base64 -d | gunzip > \"$D/cmux-app.json\"; clear; shasum -a 256 \"$D/dist/main.js\"; ls -l \"$D\" \"$D/dist\"\r"
      ],
      "wait": 8
    },
    {
      "title": "Diagnostics: the customize folder, cmux ext list, cmux apps info local/customize",
      "daemon": true,
      "cmux": [
        "workspace",
        "name:Alpha",
        "screen",
        "current",
        "pane",
        "current",
        "tab",
        "current",
        "terminal",
        "current",
        "write",
        "--text",
        "clear; echo \"CMUX_CUSTOMIZE_DIR=$CMUX_CUSTOMIZE_DIR\"; echo \"cmux=$(command -v cmux)\"; cmux ext list 2>&1 | tail -8; cmux apps info local/customize 2>&1 | head -14\r"
      ],
      "wait": 5
    },
    {
      "title": "A new workspace (Gamma): the section redraws on workspace.changed",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "Gamma"
      ],
      "wait": 3
    },
    {
      "title": "Rename Beta to Beta renamed: the section redraws on workspace.changed",
      "cmux": [
        "workspace",
        "name:Beta",
        "rename",
        "--name",
        "Beta renamed"
      ],
      "wait": 3
    },
    {
      "title": "Show Alpha",
      "cmux": [
        "workspace",
        "name:Alpha",
        "focus"
      ],
      "wait": 2,
      "shot": false
    },
    {
      "title": "Hot reload: save the second build over dist/main.js (byte-identical to pack.ts of src/main.ts with the header 'No agent working (edited live)', sha256 2ba8856a...); the section changes with no relaunch",
      "daemon": true,
      "cmux": [
        "workspace",
        "name:Alpha",
        "screen",
        "current",
        "pane",
        "current",
        "tab",
        "current",
        "terminal",
        "current",
        "write",
        "--text",
        "clear; D=\"${CMUX_CUSTOMIZE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/cmux/customize}\"; T=\"${TMPDIR:-/tmp}/cmux-tour-activity\"; sed 's/\"No agent working\"/\"No agent working (edited live)\"/' \"$D/dist/main.js\" > \"$T/edited.js\" && cat \"$T/edited.js\" > \"$D/dist/main.js\"; clear; shasum -a 256 \"$D/dist/main.js\"; grep -c \"edited live\" \"$D/dist/main.js\"\r"
      ],
      "wait": 8
    },
    {
      "title": "Diagnostics after the save",
      "daemon": true,
      "cmux": [
        "workspace",
        "name:Alpha",
        "screen",
        "current",
        "pane",
        "current",
        "tab",
        "current",
        "terminal",
        "current",
        "write",
        "--text",
        "clear; echo \"CMUX_CUSTOMIZE_DIR=$CMUX_CUSTOMIZE_DIR\"; echo \"cmux=$(command -v cmux)\"; cmux ext list 2>&1 | tail -8; cmux apps info local/customize 2>&1 | head -14\r"
      ],
      "wait": 5
    },
    {
      "title": "Open the Activity feed pane (cmux.pane/1): cmux action run app.open --app local/customize",
      "cmux": [
        "action",
        "run",
        "app.open",
        "--app",
        "local/customize"
      ],
      "wait": 4,
      "optional": "app.open may not open a customize pane on this build"
    },
    {
      "title": "Select the Activity tab (cmux action run nextSurface)",
      "cmux": [
        "action",
        "run",
        "nextSurface"
      ],
      "wait": 3,
      "optional": "depends on the pane having opened"
    },
    {
      "title": "Rename Gamma: the feed pane shows a workspace.changed entry",
      "cmux": [
        "workspace",
        "name:Gamma",
        "rename",
        "--name",
        "Gamma renamed"
      ],
      "wait": 3,
      "optional": "depends on the pane having opened"
    },
    {
      "title": "Rename Alpha: another workspace.changed entry at the top of the feed",
      "cmux": [
        "workspace",
        "name:Alpha",
        "rename",
        "--name",
        "Alpha renamed"
      ],
      "wait": 3,
      "optional": "depends on the pane having opened"
    }
  ]
}
