{
  "title": "Model menu closes on pick (David Beyer 2026-11-20): on New Tab and in an agent chat, the model menu open, then a click on another model; light then dark. Before the fix the menu stays open after the click; after it, it closes and the chip names the pick.",
  "steps": [
    {
      "title": "Launch",
      "wait": 3,
      "shot": false
    },
    {
      "title": "Light: the app in light",
      "rpc": {
        "method": "debug.appearance",
        "params": {
          "mode": "light"
        }
      },
      "wait": 1.5,
      "shot": false
    },
    {
      "title": "Light: a New Tab",
      "cmux": [
        "tab",
        "new-page"
      ],
      "wait": 3,
      "shot": false
    },
    {
      "title": "Light: New Tab, the model menu open",
      "rpc": {
        "method": "debug.agent_pane",
        "params": {
          "action": "open_menu",
          "label": "Model"
        }
      },
      "wait": 2.5
    },
    {
      "title": "Light: New Tab, a click on another model (the menu closes after the fix)",
      "rpc": {
        "method": "debug.agent_pane",
        "params": {
          "action": "click",
          "selector": ".acpmux-cols [role=listbox] [role=option]:not([aria-selected=true]):not([aria-disabled=true])"
        }
      },
      "wait": 2.5
    },
    {
      "title": "Light: close any menu left open",
      "rpc": {
        "method": "debug.agent_pane",
        "params": {
          "action": "close_menus"
        }
      },
      "wait": 1,
      "shot": false,
      "optional": "no menu"
    },
    {
      "title": "Light: a new agent chat",
      "rpc": {
        "method": "action.run",
        "params": {
          "action": "palette.newAgentChat",
          "focus": true
        }
      },
      "wait": 3,
      "shot": false
    },
    {
      "title": "Light: on the fake harness",
      "rpc": {
        "method": "debug.agent_pane",
        "params": {
          "action": "new_chat",
          "harness": "fake"
        }
      },
      "wait": 3,
      "shot": false
    },
    {
      "title": "Light: the chat starts",
      "rpc": {
        "method": "debug.agent_pane",
        "params": {
          "action": "send_prompt",
          "text": "hello"
        }
      },
      "wait": 4,
      "shot": false
    },
    {
      "title": "Light: chat, the model menu open",
      "rpc": {
        "method": "debug.agent_pane",
        "params": {
          "action": "open_menu",
          "label": "Model"
        }
      },
      "wait": 2.5
    },
    {
      "title": "Light: chat, a click on another model (the menu closes after the fix)",
      "rpc": {
        "method": "debug.agent_pane",
        "params": {
          "action": "click",
          "selector": ":is(.acpmux-cols [role=listbox] [role=option]:not([aria-selected=true]):not([aria-disabled=true]), .acpmux-quick-menu [role=menuitemradio][aria-checked=false])"
        }
      },
      "wait": 2.5
    },
    {
      "title": "Light: close any menu left open",
      "rpc": {
        "method": "debug.agent_pane",
        "params": {
          "action": "close_menus"
        }
      },
      "wait": 1,
      "shot": false
    },
    {
      "title": "Dark: the app in dark",
      "rpc": {
        "method": "debug.appearance",
        "params": {
          "mode": "dark"
        }
      },
      "wait": 1.5,
      "shot": false
    },
    {
      "title": "Dark: a New Tab",
      "cmux": [
        "tab",
        "new-page"
      ],
      "wait": 3,
      "shot": false
    },
    {
      "title": "Dark: New Tab, the model menu open",
      "rpc": {
        "method": "debug.agent_pane",
        "params": {
          "action": "open_menu",
          "label": "Model"
        }
      },
      "wait": 2.5
    },
    {
      "title": "Dark: New Tab, a click on another model (the menu closes after the fix)",
      "rpc": {
        "method": "debug.agent_pane",
        "params": {
          "action": "click",
          "selector": ".acpmux-cols [role=listbox] [role=option]:not([aria-selected=true]):not([aria-disabled=true])"
        }
      },
      "wait": 2.5
    },
    {
      "title": "Dark: close any menu left open",
      "rpc": {
        "method": "debug.agent_pane",
        "params": {
          "action": "close_menus"
        }
      },
      "wait": 1,
      "shot": false,
      "optional": "no menu"
    },
    {
      "title": "Dark: a new agent chat",
      "rpc": {
        "method": "action.run",
        "params": {
          "action": "palette.newAgentChat",
          "focus": true
        }
      },
      "wait": 3,
      "shot": false
    },
    {
      "title": "Dark: on the fake harness",
      "rpc": {
        "method": "debug.agent_pane",
        "params": {
          "action": "new_chat",
          "harness": "fake"
        }
      },
      "wait": 3,
      "shot": false
    },
    {
      "title": "Dark: the chat starts",
      "rpc": {
        "method": "debug.agent_pane",
        "params": {
          "action": "send_prompt",
          "text": "hello"
        }
      },
      "wait": 4,
      "shot": false
    },
    {
      "title": "Dark: chat, the model menu open",
      "rpc": {
        "method": "debug.agent_pane",
        "params": {
          "action": "open_menu",
          "label": "Model"
        }
      },
      "wait": 2.5
    },
    {
      "title": "Dark: chat, a click on another model (the menu closes after the fix)",
      "rpc": {
        "method": "debug.agent_pane",
        "params": {
          "action": "click",
          "selector": ":is(.acpmux-cols [role=listbox] [role=option]:not([aria-selected=true]):not([aria-disabled=true]), .acpmux-quick-menu [role=menuitemradio][aria-checked=false])"
        }
      },
      "wait": 2.5
    },
    {
      "title": "Dark: close any menu left open",
      "rpc": {
        "method": "debug.agent_pane",
        "params": {
          "action": "close_menus"
        }
      },
      "wait": 1,
      "shot": false
    }
  ]
}
