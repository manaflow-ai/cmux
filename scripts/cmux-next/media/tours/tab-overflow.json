{
 "title": "Tab overflow (experiments.tabOverflow): 20 tabs while the window narrows and widens, under Scroll Chevrons, More Menu and All Tabs Pill",
 "settings": {
  "appearance": {
   "background": "hokusai-great-wave"
  },
  "experiments": {
   "tabOverflow": "off"
  }
 },
 "steps": [
  {
   "title": "Launch",
   "wait": 4,
   "shot": false
  },
  {
   "title": "Workspace Tabs",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Tabs"
   ],
   "wait": 1,
   "shot": false
  },
  {
   "title": "Show it",
   "cmux": [
    "workspace",
    "name:Tabs",
    "focus"
   ],
   "wait": 2,
   "shot": false
  },
  {
   "title": "Name the first tab",
   "cmux": [
    "workspace",
    "name:Tabs",
    "screen",
    "current",
    "pane",
    "current",
    "tab",
    "current",
    "rename",
    "shell"
   ],
   "wait": 0.5,
   "shot": false,
   "optional": "a name only"
  },
  {
   "title": "Tab Docs",
   "cmux": [
    "tab",
    "create",
    "terminal",
    "--name",
