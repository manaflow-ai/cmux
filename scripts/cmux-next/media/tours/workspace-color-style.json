{
  "title": "Workspace Color Style: a colored workspace as a dot, a left rail or a filled row (#25653)",
  "steps": [
    {
      "title": "Launch",
      "wait": 2,
      "shot": false
    },
    {
      "title": "Workspace PR ready",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "PR ready"
      ],
      "shot": false,
      "wait": 1
    },
    {
      "title": "Workspace Needs review",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "Needs review"
      ],
      "shot": false,
      "wait": 1
    },
    {
      "title": "Workspace Blocked",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "Blocked"
      ],
      "shot": false,
      "wait": 1
    },
    {
      "title": "Workspace Plain",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "Plain"
      ],
      "shot": false,
      "wait": 1
    },
    {
      "title": "Group Blocked",
      "cmux": [
        "workspace",
        "name:Blocked",
        "focus"
      ],
      "shot": false,
      "wait": 1
    },
    {
      "title": "Group Blocked into a new group",
      "cmux": [
        "action",
        "run",
        "workspace.moveToNewGroup"
      ],
      "shot": false,
      "wait": 1,
      "optional": "group creation by CLI depends on the target the run resolves"
    },
    {
      "title": "Focus PR ready",
      "cmux": [
        "workspace",
        "name:PR ready",
        "focus"
      ],
      "shot": false,
      "wait": 1
    },
    {
      "title": "PR ready is green",
      "cmux": [
        "workspace",
        "set-color",
        "--color",
        "green"
      ],
      "shot": false,
      "wait": 1
    },
    {
      "title": "Focus Needs review",
      "cmux": [
        "workspace",
        "name:Needs review",
        "focus"
      ],
      "shot": false,
      "wait": 1
    },
    {
      "title": "Needs review is yellow",
      "cmux": [
        "workspace",
        "set-color",
        "--color",
        "yellow"
      ],
      "shot": false,
      "wait": 1
    },
    {
      "title": "Focus Blocked",
      "cmux": [
        "workspace",
        "name:Blocked",
        "focus"
      ],
      "shot": false,
      "wait": 1
    },
    {
      "title": "Blocked (in a group) is red",
      "cmux": [
        "workspace",
        "set-color",
        "--color",
        "red"
      ],
      "shot": false,
      "wait": 1
    },
    {
      "title": "Select Needs review",
      "cmux": [
        "workspace",
        "name:Needs review",
        "focus"
      ],
      "shot": false,
      "wait": 1
    },
    {
      "title": "Dark",
      "rpc": {
        "method": "debug.appearance",
        "params": {
          "mode": "dark"
        }
      },
      "wait": 2,
      "shot": false,
      "optional": "debug.appearance is DEBUG only"
    },
    {
      "title": "Dark, Dot (default): the swatch before each colored name",
      "cmux": [
        "settings",
        "set",
        "workspaceColors.indicatorStyle",
        "dot"
      ],
      "wait": 2
    },
    {
      "title": "Dark, Left Rail: a bar down each colored row's edge",
      "cmux": [
        "settings",
        "set",
        "workspaceColors.indicatorStyle",
        "leftRail"
      ],
      "wait": 2
    },
    {
      "title": "Dark, Fill Row: each colored row filled, the selected one stronger",
      "cmux": [
        "settings",
        "set",
        "workspaceColors.indicatorStyle",
        "fill"
      ],
      "wait": 2
    },
    {
      "title": "Light",
      "rpc": {
        "method": "debug.appearance",
        "params": {
          "mode": "light"
        }
      },
      "wait": 2,
      "shot": false,
      "optional": "debug.appearance is DEBUG only"
    },
    {
      "title": "Light, Fill Row",
      "wait": 1
    },
    {
      "title": "Light, Left Rail",
      "cmux": [
        "settings",
        "set",
        "workspaceColors.indicatorStyle",
        "leftRail"
      ],
      "wait": 2
    },
    {
      "title": "Light, Dot (default)",
      "cmux": [
        "settings",
        "set",
        "workspaceColors.indicatorStyle",
        "dot"
      ],
      "wait": 2
    },
    {
      "title": "Back to the default",
      "cmux": [
        "settings",
        "unset",
        "workspaceColors.indicatorStyle"
      ],
      "wait": 1,
      "shot": false
    },
    {
      "title": "Back to the system appearance",
      "rpc": {
        "method": "debug.appearance",
        "params": {
          "mode": "system"
        }
      },
      "wait": 2,
      "shot": false,
      "optional": "debug.appearance is DEBUG only"
    }
  ]
}
