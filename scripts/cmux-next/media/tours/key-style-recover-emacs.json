{
  "title": "Key Style Emacs: back to Standard by keys through the palette, and by the CLI, with Settings showing the row",
  "frameInterval": 0.25,
  "settings": {"app": {"keyStyle": "emacs"}},
  "steps": [
    {"title": "Launch", "wait": 2, "shot": false},
    {"title": "Read back: Key Style is Emacs", "rpc": {"method": "settings.get", "params": {"path": "app.keyStyle"}}, "wait": 1},
    {"title": "Route 1, palette: Cmd-Shift-P", "rpc": {"method": "debug.key", "params": {"key": "p", "modifiers": ["cmd","shift"]}}, "wait": 1.5},
    {"title": "type k", "rpc": {"method": "debug.key", "params": {"key": "k", "target": "palette"}}, "wait": 0.15, "shot": false},
    {"title": "type e", "rpc": {"method": "debug.key", "params": {"key": "e", "target": "palette"}}, "wait": 0.15, "shot": false},
    {"title": "type y", "rpc": {"method": "debug.key", "params": {"key": "y", "target": "palette"}}, "wait": 0.15, "shot": false},
    {"title": "type space", "rpc": {"method": "debug.key", "params": {"key": "space", "target": "palette"}}, "wait": 0.15, "shot": false},
    {"title": "type s", "rpc": {"method": "debug.key", "params": {"key": "s", "target": "palette"}}, "wait": 0.15, "shot": false},
    {"title": "type t", "rpc": {"method": "debug.key", "params": {"key": "t", "target": "palette"}}, "wait": 0.15, "shot": false},
    {"title": "type y", "rpc": {"method": "debug.key", "params": {"key": "y", "target": "palette"}}, "wait": 0.15, "shot": false},
    {"title": "type l", "rpc": {"method": "debug.key", "params": {"key": "l", "target": "palette"}}, "wait": 0.15, "shot": false},
    {"title": "Palette: Key Style", "rpc": {"method": "debug.key", "params": {"key": "e", "target": "palette"}}, "wait": 1.5},
    {"title": "Return: its values", "rpc": {"method": "debug.key", "params": {"key": "return", "target": "palette"}}, "wait": 1.5},
    {"title": "type s", "rpc": {"method": "debug.key", "params": {"key": "s", "target": "palette"}}, "wait": 0.15, "shot": false},
    {"title": "type t", "rpc": {"method": "debug.key", "params": {"key": "t", "target": "palette"}}, "wait": 0.15, "shot": false},
    {"title": "type a", "rpc": {"method": "debug.key", "params": {"key": "a", "target": "palette"}}, "wait": 0.15, "shot": false},
    {"title": "type n", "rpc": {"method": "debug.key", "params": {"key": "n", "target": "palette"}}, "wait": 0.15, "shot": false},
    {"title": "type d", "rpc": {"method": "debug.key", "params": {"key": "d", "target": "palette"}}, "wait": 0.15, "shot": false},
    {"title": "type a", "rpc": {"method": "debug.key", "params": {"key": "a", "target": "palette"}}, "wait": 0.15, "shot": false},
    {"title": "type r", "rpc": {"method": "debug.key", "params": {"key": "r", "target": "palette"}}, "wait": 0.15, "shot": false},
    {"title": "Typing filters to Standard", "rpc": {"method": "debug.key", "params": {"key": "d", "target": "palette"}}, "wait": 1.5},
    {"title": "Return picks Standard", "rpc": {"method": "debug.key", "params": {"key": "return", "target": "palette"}}, "wait": 3},
    {"title": "Read back after the palette: Key Style is Standard", "rpc": {"method": "settings.get", "params": {"path": "app.keyStyle"}}, "wait": 0.5},
    {"title": "Set Emacs again (a cmux step)", "cmux": ["settings", "set", "app.keyStyle", "emacs"], "wait": 2.5},
    {"title": "Read back: Key Style is Emacs again", "rpc": {"method": "settings.get", "params": {"path": "app.keyStyle"}}, "wait": 0.5},
    {"title": "Route 2, CLI: cmux settings set app.keyStyle standard (a cmux step, as typed in a terminal)", "cmux": ["settings", "set", "app.keyStyle", "standard"], "wait": 2},
    {"title": "Read back after the CLI: Key Style is Standard", "rpc": {"method": "settings.get", "params": {"path": "app.keyStyle"}}, "wait": 1}
  ]
}
