{
 "title": "First screen UX audit (David Beyer 2026-11-20): launch window, New Tab empty, harness and model menus, a command, an address, a prompt and an ambiguous word typed, a new agent chat; light then dark.",
 "steps": [
  {
   "title": "Launch: the first window",
   "wait": 4
  },
  {
   "title": "A large window",
   "rpc": {
    "method": "debug.window_frame",
    "params": {
     "frame": [
      80,
      80,
      1440,
      900
     ]
    }
   },
   "wait": 1,
   "shot": false,
   "optional": "no window frame"
  },
  {
   "title": "Light: the app in light",
   "rpc": {
    "method": "debug.appearance",
    "params": {
     "mode": "light"
    }
   },
   "wait": 1.5,
   "shot": false,
   "optional": "debug.appearance is DEBUG only"
  },
  {
   "title": "Light: a New Tab, nothing typed",
   "cmux": [
    "tab",
    "new-page"
   ],
   "wait": 3
  },
  {
   "title": "Light: the harness menu open",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "open_menu",
     "label": "Harness"
    }
   },
   "wait": 2,
   "optional": "no harness menu"
  },
  {
   "title": "Light: close menus",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "close_menus"
    }
   },
   "wait": 1,
   "shot": false,
   "optional": "no menu"
  },
  {
   "title": "Light: the model menu open",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "open_menu",
     "label": "Model"
    }
   },
   "wait": 2,
   "optional": "no model menu"
  },
  {
   "title": "Light: close menus again",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "close_menus"
    }
   },
   "wait": 1,
   "shot": false,
   "optional": "no menu"
  },
  {
   "title": "Light: a shell command typed (ls -la)",
   "rpc": {
    "method": "debug.new_tab",
    "params": {
     "action": "open_and_type",
     "text": "ls -la"
    }
   },
   "wait": 2
  },
  {
   "title": "Light: an address typed (github.com)",
   "rpc": {
    "method": "debug.new_tab",
    "params": {
     "action": "open_and_type",
     "text": "github.com"
    }
   },
   "wait": 2
  },
  {
   "title": "Light: a prompt typed (fix the failing test)",
   "rpc": {
    "method": "debug.new_tab",
    "params": {
     "action": "open_and_type",
     "text": "fix the failing test"
    }
   },
   "wait": 2
  },
  {
   "title": "Light: a one-word ambiguous entry (deploy)",
   "rpc": {
    "method": "debug.new_tab",
    "params": {
     "action": "open_and_type",
     "text": "deploy"
    }
   },
   "wait": 2
  },
  {
   "title": "Light: a new agent chat",
   "rpc": {
    "method": "action.run",
    "params": {
     "action": "palette.newAgentChat",
     "focus": true
    }
   },
   "wait": 4,
   "optional": "agent backend unavailable"
  },
  {
   "title": "Dark: the app in dark",
   "rpc": {
    "method": "debug.appearance",
    "params": {
     "mode": "dark"
    }
   },
   "wait": 1.5,
   "shot": false,
   "optional": "debug.appearance is DEBUG only"
  },
  {
   "title": "Dark: a New Tab, nothing typed",
   "cmux": [
    "tab",
    "new-page"
   ],
   "wait": 3
  },
  {
   "title": "Dark: the harness menu open",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "open_menu",
     "label": "Harness"
    }
   },
   "wait": 2,
   "optional": "no harness menu"
  },
  {
   "title": "Dark: close menus",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "close_menus"
    }
   },
   "wait": 1,
   "shot": false,
   "optional": "no menu"
  },
  {
   "title": "Dark: the model menu open",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "open_menu",
     "label": "Model"
    }
   },
   "wait": 2,
   "optional": "no model menu"
  },
  {
   "title": "Dark: close menus again",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "close_menus"
    }
   },
   "wait": 1,
   "shot": false,
   "optional": "no menu"
  },
  {
   "title": "Dark: a shell command typed (ls -la)",
   "rpc": {
    "method": "debug.new_tab",
    "params": {
     "action": "open_and_type",
     "text": "ls -la"
    }
   },
   "wait": 2
  },
  {
   "title": "Dark: an address typed (github.com)",
   "rpc": {
    "method": "debug.new_tab",
    "params": {
     "action": "open_and_type",
     "text": "github.com"
    }
   },
   "wait": 2
  },
  {
   "title": "Dark: a prompt typed (fix the failing test)",
   "rpc": {
    "method": "debug.new_tab",
    "params": {
     "action": "open_and_type",
     "text": "fix the failing test"
    }
   },
   "wait": 2
  },
  {
   "title": "Dark: a one-word ambiguous entry (deploy)",
   "rpc": {
    "method": "debug.new_tab",
    "params": {
     "action": "open_and_type",
     "text": "deploy"
    }
   },
   "wait": 2
  },
  {
   "title": "Dark: a new agent chat",
   "rpc": {
    "method": "action.run",
    "params": {
     "action": "palette.newAgentChat",
     "focus": true
    }
   },
   "wait": 4,
   "optional": "agent backend unavailable"
  },
  {
   "title": "Back to system",
   "rpc": {
    "method": "debug.appearance",
    "params": {
     "mode": "system"
    }
   },
   "wait": 1,
   "shot": false,
   "optional": "DEBUG only"
  }
 ]
}