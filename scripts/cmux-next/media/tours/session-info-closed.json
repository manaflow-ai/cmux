{
 "title": "Session Info closed: its header toggle reads as off",
 "steps": [
  {
   "title": "Launch",
   "wait": 2,
   "shot": false
  },
  {
   "title": "Session Info on",
   "rpc": {
    "method": "debug.tunables",
    "params": {
     "action": "set",
     "key": "agent.inspector",
     "value": true
    }
   },
   "wait": 1,
   "shot": false
  },
  {
   "title": "Open agent chat",
   "cmux": [
    "agent",
    "new-chat"
   ],
   "wait": 5,
   "shot": false,
   "optional": "agent backend unavailable on this runner"
  },
  {
   "title": "Session Info open: the toggle is on",
   "wait": 2
  },
  {
   "title": "Close it with its toggle",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "click",
     "selector": "button.acpmux-session-info-toggle"
    }
   },
   "wait": 1.5,
   "shot": false
  },
  {
   "title": "Session Info closed",
   "wait": 1
  }
 ]
}
