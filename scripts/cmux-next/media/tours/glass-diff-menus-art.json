{
  "title": "Diff viewer menus: one glass, over art",
  "settings": {
    "appearance": {
      "background": "hokusai-great-wave"
    }
  },
  "steps": [
    {
      "title": "Launch",
      "wait": 3
    },
    {
      "title": "End Meet Chief",
      "rpc": {
        "method": "debug.onboarding",
        "params": {
          "action": "meet_chief_end"
        }
      },
      "wait": 1,
      "shot": false
    },
    {
      "title": "New workspace",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "Diff"
      ],
      "shot": false
    },
    {
      "title": "Show the Diff workspace",
      "cmux": [
        "workspace",
        "name:Diff",
        "focus"
      ],
      "shot": false
    },
    {
      "title": "Make the diff's repository",
      "daemon": true,
      "cmux": [
        "workspace",
        "name:Diff",
        "screen",
        "current",
        "pane",
        "current",
        "tab",
        "current",
        "terminal",
        "current",
        "write",
        "--text",
        "clear; bash {repo}/scripts/cmux-next/media/fixtures/diff-file-tree-repo.sh /tmp/cmux-tour-glass-diff-menus-art && echo FIXTURE-READY\r"
      ],
      "wait": 6,
      "shot": false
    },
    {
      "title": "Open the diff",
      "cmux": [
        "browser",
        "open-diff-viewer",
        "--path",
        "/tmp/cmux-tour-glass-diff-menus-art"
      ],
      "wait": 4,
      "shot": false
    },
    {
      "title": "Show the diff tab",
      "cmux": [
        "action",
        "run",
        "nextSurface",
        "--focus"
      ],
      "wait": 5,
      "shot": false
    },
    {
      "title": "Light",
      "rpc": {
        "method": "debug.appearance",
        "params": {
          "mode": "light"
        }
      },
      "wait": 2,
      "shot": false
    },
    {
      "title": "Diff source menu, light, over art: one glass (Leo 2026-11-22: \"doubled up glass/wack looking glass all over the place\")",
      "rpc": {
        "method": "debug.page",
        "params": {
          "page": "cmux.diff",
          "action": "click",
          "selector": "#source-menu-button"
        }
      },
      "wait": 2,
      "shot": true
    },
    {
      "title": "Close the source menu",
      "rpc": {
        "method": "debug.page",
        "params": {
          "page": "cmux.diff",
          "action": "click",
          "selector": "#source-menu-button"
        }
      },
      "wait": 1.5,
      "shot": false
    },
    {
      "title": "Diff options menu, light, over art: one glass",
      "rpc": {
        "method": "debug.page",
        "params": {
          "page": "cmux.diff",
          "action": "click",
          "selector": "#options-button"
        }
      },
      "wait": 2,
      "shot": true
    },
    {
      "title": "Close the options menu",
      "rpc": {
        "method": "debug.page",
        "params": {
          "page": "cmux.diff",
          "action": "click",
          "selector": "#options-button"
        }
      },
      "wait": 1.5,
      "shot": false
    },
    {
      "title": "Dark",
      "rpc": {
        "method": "debug.appearance",
        "params": {
          "mode": "dark"
        }
      },
      "wait": 2,
      "shot": false
    },
    {
      "title": "Diff source menu, dark, over art: one glass (Leo 2026-11-22: \"doubled up glass/wack looking glass all over the place\")",
      "rpc": {
        "method": "debug.page",
        "params": {
          "page": "cmux.diff",
          "action": "click",
          "selector": "#source-menu-button"
        }
      },
      "wait": 2,
      "shot": true
    },
    {
      "title": "Close the source menu",
      "rpc": {
        "method": "debug.page",
        "params": {
          "page": "cmux.diff",
          "action": "click",
          "selector": "#source-menu-button"
        }
      },
      "wait": 1.5,
      "shot": false
    },
    {
      "title": "Diff options menu, dark, over art: one glass",
      "rpc": {
        "method": "debug.page",
        "params": {
          "page": "cmux.diff",
          "action": "click",
          "selector": "#options-button"
        }
      },
      "wait": 2,
      "shot": true
    },
    {
      "title": "Close the options menu",
      "rpc": {
        "method": "debug.page",
        "params": {
          "page": "cmux.diff",
          "action": "click",
          "selector": "#options-button"
        }
      },
      "wait": 1.5,
      "shot": false
    },
    {
      "title": "Back to the system appearance",
      "rpc": {
        "method": "debug.appearance",
        "params": {
          "mode": "system"
        }
      },
      "wait": 2,
      "shot": false
    }
  ]
}
