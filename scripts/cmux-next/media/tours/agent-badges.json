{
  "title": "Agent badges (experiments.agentBadges with its running beam): an agent in a background tab runs, asks for approval, then finishes; its tab's count pill and its row's status pill change in place",
  "settings": {"experiments": {"agentBadges": true, "agentBadgesBeam": true}},
  "harnessFixture": {
    "harnesses": {
      "fake": {
        "argv": ["python3", "{repo}/cmux-tui/crates/acpmux/tests/fake_agent.py"],
        "description": "acpmux's test agent (Agent badges tour)"
      }
    }
  },
  "steps": [
    {"title": "Launch", "wait": 3, "shot": false},
    {"title": "A quiet workspace, so an idle row shows beside the agent's", "cmux": ["workspace", "new", "--name", "Notes"], "wait": 1, "shot": false},
    {"title": "New workspace Release", "cmux": ["workspace", "new", "--name", "Release"], "wait": 1, "shot": false},
    {"title": "Show Release", "cmux": ["workspace", "name:Release", "focus"], "wait": 1, "shot": false},
    {"title": "A gate the agent's first turn waits on", "daemon": true,
     "cmux": ["workspace", "name:Release", "screen", "current", "pane", "current", "tab", "current", "terminal", "current", "write", "--text",
              "rm -f /tmp/cmux-agent-badges-gate; mkfifo /tmp/cmux-agent-badges-gate; clear\r"],
     "wait": 1, "shot": false},
    {"title": "The agent starts: its turn runs until the gate opens",
     "cmux": ["agents", "chat", "new", "--harness", "fake", "--name", "release-check", "--", "gate: /tmp/cmux-agent-badges-gate"],
     "wait": 2, "shot": false},
    {"title": "A terminal tab in front, so the agent works in the background", "cmux": ["action", "run", "newSurface"], "wait": 1, "shot": false},
    {"title": "Name the terminal tab", "cmux": ["tab", "current", "rename", "--name", "Shell"], "wait": 1, "shot": false},
    {"title": "Queue the agent's next step: it will ask to deploy",
     "cmux": ["agents", "chat", "send", "release-check", "--", "ask: Deploy release to staging"], "wait": 1, "shot": false},
    {"title": "Running: the row's Running pill and the beam on its edge; the tab's count slot is reserved and empty", "wait": 3},
    {"title": "Still running", "wait": 2},
    {"title": "The first turn ends and the ask begins", "daemon": true,
     "cmux": ["workspace", "name:Release", "screen", "current", "pane", "current", "tab", "current", "terminal", "current", "write", "--text",
              "echo go > /tmp/cmux-agent-badges-gate\r"],
     "wait": 1, "shot": false},
    {"title": "Needs approval: the row's pill turns to Needs approval and the beam stops; the tab's count appears, nothing moves", "wait": 3},
    {"title": "Still waiting on the person", "wait": 2},
    {"title": "The ask is withdrawn", "cmux": ["agents", "chat", "interrupt", "release-check"], "wait": 1, "shot": false},
    {"title": "The agent reports back",
     "cmux": ["agents", "chat", "send", "release-check", "--", "Deployed to staging. Every check passed."], "wait": 2, "shot": false},
    {"title": "Done: the row's Done pill; the tab's count stays until the chat is read, nothing moves", "wait": 3},
    {"title": "Dark", "rpc": {"method": "debug.appearance", "params": {"mode": "dark"}}, "wait": 2},
    {"title": "Back to the system appearance", "rpc": {"method": "debug.appearance", "params": {"mode": "system"}}, "wait": 1, "shot": false}
  ]
}
