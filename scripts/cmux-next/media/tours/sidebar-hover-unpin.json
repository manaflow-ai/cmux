{
 "title": "Hover pin on sidebar rows: a pinned workspace tile (Notes) shows a filled pin (Unpin workspace) left of its more button; the tile is hovered by its point, since debug.mouse names list rows only (dark and light; a capture keeps one shot per appearance). Record it with: cmux-ci capture SHA --state tour:sidebar-hover-unpin",
 "settings": {
  "sidebar": {
   "hoverCards": {
    "enabled": false
   }
  }
 },
 "steps": [
  {
   "title": "Launch",
   "wait": 3,
   "shot": false
  },
  {
   "title": "New workspace Notes",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Notes"
   ],
   "wait": 2,
   "shot": false
  },
  {
   "title": "Show Notes",
   "cmux": [
    "workspace",
    "name:Notes",
    "focus"
   ],
   "wait": 2,
   "shot": false
  },
  {
   "title": "Pin Notes",
   "cmux": [
    "action",
    "run",
    "palette.toggleWorkspacePin"
   ],
   "wait": 2,
   "shot": false
  },
  {
   "title": "New workspace Build",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Build"
   ],
   "wait": 2,
   "shot": false
  },
  {
   "title": "New workspace Release notes",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Release notes"
   ],
   "wait": 2,
   "shot": false
  },
  {
   "title": "Dark",
   "rpc": {
    "method": "debug.appearance",
    "params": {
     "mode": "dark"
    }
   },
   "wait": 2,
   "shot": false
  },
  {
   "title": "Dark, hover the pinned workspace Notes",
   "rpc": {
    "method": "debug.mouse",
    "params": {
     "x": 114,
     "y": 123,
     "action": "move"
    }
   },
   "wait": 2
  },
  {
   "title": "Light",
   "rpc": {
    "method": "debug.appearance",
    "params": {
     "mode": "light"
    }
   },
   "wait": 2,
   "shot": false
  },
  {
   "title": "Light, hover the pinned workspace Notes",
   "rpc": {
    "method": "debug.mouse",
    "params": {
     "x": 114,
     "y": 123,
     "action": "move"
    }
   },
   "wait": 2
  }
 ]
}
