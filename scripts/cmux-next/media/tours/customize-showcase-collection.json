{
  "title": "Customization showcase: collection",
  "customize": true,
  "steps": [
    {
      "title": "Launch",
      "wait": 2,
      "shot": false
    },
    {
      "title": "New workspace",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "Tour"
      ],
      "shot": false
    },
    {
      "title": "Show the Tour workspace",
      "cmux": [
        "workspace",
        "name:Tour",
        "focus"
      ],
      "shot": false
    },
    {
      "title": "Before: cmux as it ships",
      "wait": 2
    },
    {
      "title": "collection: its views",
      "daemon": true,
      "cmux": [
        "workspace",
        "name:Tour",
        "screen",
        "current",
        "pane",
        "current",
        "tab",
        "current",
        "terminal",
        "current",
        "write",
        "--text",
        "clear; D=\"${CMUX_CUSTOMIZE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/cmux/customize}\"; mkdir -p \"$D\" && echo  | base64 -d > \"$D/main.js\" && echo  | base64 -d > \"$D/cmux-app.json\" && mkdir -p \"$D/../themes\" && echo  | base64 -d > \"$D/../themes/collection.json\" && echo saved collection\r"
      ],
      "wait": 4,
      "shot": false
    },
    {
      "title": "collection: tabs.newTabApp",
      "cmux": [
        "settings",
        "set",
        "tabs.newTabApp",
        "local/customize"
      ],
      "wait": 0.3,
      "shot": false
    },
    {
      "title": "collection: appearance.themeFile",
      "cmux": [
        "settings",
        "set",
        "appearance.themeFile",
        "collection"
      ],
      "wait": 0.3,
      "shot": false
    },
    {
      "title": "collection: sidebar.sectionLook",
      "cmux": [
        "settings",
        "set",
        "sidebar.sectionLook",
        "card"
      ],
      "wait": 0.3,
      "shot": false
    },
    {
      "title": "collection: The collection: a suite of small things to show what a view can do. The time and the weather, the usage left on every Claude and Codex account you use, and a chief gacha you pull with an animated reel, in a sidebar section and on every New Tab, all in an arcade theme.",
      "wait": 3
    },
    {
      "title": "collection: a New Tab is the setup's own page",
      "cmux": [
        "action",
        "run",
        "newTab.default"
      ],
      "wait": 3,
      "optional": "a New Tab opens a terminal when tabs.newTabTemplate picks one"
    }
  ]
}
