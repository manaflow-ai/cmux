{
  "title": "Home lists the whole team by default: teammates with no chat yet are rows after the conversations, and To: offers them before anything is typed",
  "steps": [
    {
      "title": "Launch",
      "wait": 2
    },
    {
      "title": "Go to Home",
      "cmux": [
        "action",
        "run",
        "home.show"
      ],
      "wait": 4,
      "shot": false,
      "optional": "the Chief's daemon may not start on this runner"
    },
    {
      "title": "The list: conversations, then every teammate with no chat yet",
      "rpc": {
        "method": "debug.home.sidebar_fixture",
        "params": {
          "count": 3,
          "team": 6,
          "width": 320
        }
      },
      "wait": 2,
      "optional": "debug fixture is DEBUG only"
    },
    {
      "title": "To: offers the Chiefs and the team before anything is typed",
      "rpc": {
        "method": "debug.home.sidebar_fixture",
        "params": {
          "new_message": 6
        }
      },
      "wait": 2,
      "optional": "debug fixture is DEBUG only"
    },
    {
      "title": "Dark",
      "rpc": {
        "method": "debug.appearance",
        "params": {
          "mode": "dark"
        }
      },
      "wait": 2,
      "optional": "debug.appearance is DEBUG only"
    },
    {
      "title": "Back to the system appearance",
      "rpc": {
        "method": "debug.appearance",
        "params": {
          "mode": "system"
        }
      },
      "wait": 1,
      "shot": false,
      "optional": "debug.appearance is DEBUG only"
    }
  ]
}
