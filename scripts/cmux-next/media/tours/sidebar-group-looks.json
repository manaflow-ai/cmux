{
  "title": "Sidebar group looks: Folders, Chips, Tree, Cards",
  "steps": [
    {"title": "Launch: the sidebar as it opens", "wait": 2, "shot": false},
    {"title": "Loose workspace", "cmux": ["workspace", "create", "--name", "scratch"], "wait": 1, "shot": false},
    {"title": "api server", "cmux": ["workspace", "create", "--name", "api server"], "wait": 1, "shot": false},
    {"title": "web app", "cmux": ["workspace", "create", "--name", "web app"], "wait": 1, "shot": false},
    {"title": "release notes", "cmux": ["workspace", "create", "--name", "release notes"], "wait": 1, "shot": false},
    {"title": "design review", "cmux": ["workspace", "create", "--name", "design review"], "wait": 1, "shot": false},
    {"title": "A purple group", "cmux": ["workspace", "group", "create", "--name", "Leads", "--color", "purple"], "wait": 1, "shot": false},
    {"title": "A group with no color", "cmux": ["workspace", "group", "create", "--name", "Backend"], "wait": 1, "shot": false},
    {"title": "A collapsed red group", "cmux": ["workspace", "group", "create", "--name", "Design", "--color", "red"], "wait": 1, "shot": false},
    {"title": "api server in Leads", "cmux": ["workspace", "group", "Leads", "add", "--workspace", "api server"], "wait": 1, "shot": false},
    {"title": "web app in Leads", "cmux": ["workspace", "group", "Leads", "add", "--workspace", "web app"], "wait": 1, "shot": false},
    {"title": "release notes in Backend", "cmux": ["workspace", "group", "Backend", "add", "--workspace", "release notes"], "wait": 1, "shot": false},
    {"title": "design review in Design", "cmux": ["workspace", "group", "Design", "add", "--workspace", "design review"], "wait": 1, "shot": false},
    {"title": "Fold Design", "cmux": ["workspace", "group", "Design", "update", "--collapse"], "wait": 1, "shot": false, "optional": "fold flag may differ"},
    {"title": "Folders (the default)", "cmux": ["settings", "set", "sidebar.groupHeader.background", "folder"], "wait": 2},
    {"title": "Chips", "cmux": ["settings", "set", "sidebar.groupHeader.background", "chip"], "wait": 2},
    {"title": "Tree", "cmux": ["settings", "set", "sidebar.groupHeader.background", "tree"], "wait": 2},
    {"title": "Cards", "cmux": ["settings", "set", "sidebar.groupHeader.background", "card"], "wait": 2}
  ]
}
