{
  "title": "Home: a new Chief whose first read failed; Try Again reads an empty first page and the first-run panel shows (ui-state-fixes M1, no-newest case)",
  "steps": [
    {
      "title": "Launch",
      "wait": 2,
      "shot": false
    },
    {
      "title": "The new Chief's first read fails",
      "rpc": {
        "method": "debug.home_native_fixture.open",
        "params": {
          "transcript": "failed",
          "chief": "new"
        }
      },
      "wait": 2.5,
      "record": true
    },
    {
      "title": "First page failed: the error with Try Again",
      "rpc": {
        "method": "debug.home_native_fixture.capture",
        "params": {
          "action": "state"
        }
      },
      "wait": 0.5,
      "record": true,
      "shot": false
    },
    {
      "title": "Try Again, the owner answering now",
      "rpc": {
        "method": "debug.home_native_fixture.capture",
        "params": {
          "action": "retry"
        }
      },
      "wait": 3,
      "record": true,
      "shot": false
    },
    {
      "title": "The read answered empty: first page loaded, the first-run panel shows",
      "rpc": {
        "method": "debug.home_native_fixture.capture",
        "params": {
          "action": "state"
        }
      },
      "wait": 0.5,
      "record": true,
      "shot": false
    }
  ]
}
