{
  "title": "Mac Screen Your Devices signed out: the note with Sign In, its inset measured like Try Again's (ui-state-fixes M5)",
  "steps": [
    {
      "title": "Launch",
      "wait": 2,
      "shot": false
    },
    {
      "title": "A workspace for the Mac Screen tab",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "devices"
      ],
      "wait": 1,
      "shot": false
    },
    {
      "title": "Open it",
      "cmux": [
        "workspace",
        "name:devices",
        "focus"
      ],
      "wait": 2,
      "shot": false
    },
    {
      "title": "No device hub on the page (signed out), the hub address valid",
      "rpc": {
        "method": "debug.device_hub",
        "params": {
          "action": "capture_devices",
          "state": "signed_out"
        }
      },
      "wait": 1,
      "record": true,
      "shot": false
    },
    {
      "title": "Mac Screen home",
      "rpc": {
        "method": "debug.mac_screen",
        "params": {
          "action": "open"
        }
      },
      "wait": 3,
      "record": true,
      "optional": "debug.mac_screen answers 'no pane' on a capture slot although the Screen Sharing tab opens"
    },
    {
      "title": "Sign In and the note text: frames in window points and pixels",
      "rpc": {
        "method": "debug.device_hub",
        "params": {
          "action": "capture_devices",
          "state": "geometry_sign_in"
        }
      },
      "wait": 0.5,
      "record": "file",
      "shot": false
    }
  ]
}
