{
  "title": "Home: a Chief with history: a first page that lands after the 10 s deadline (ui-state-fixes M1, history case)",
  "steps": [
    {
      "title": "Launch",
      "wait": 2,
      "shot": false
    },
    {
      "title": "The native Home transcript, its Chief transcript read held",
      "rpc": {
        "method": "debug.home_native_fixture.open",
        "params": {
          "transcript": "loading",
          "new": true
        }
      },
      "wait": 1.5,
      "record": true
    },
    {
      "title": "Past the 10 s deadline: the error with Try Again",
      "wait": 11,
      "shot": false
    },
    {
      "title": "After the deadline: first page failed",
      "rpc": {
        "method": "debug.home_native_fixture.capture",
        "params": {
          "action": "state",
          "expect": {
            "first_page": "failed",
            "panel": "failed",
            "served": 0
          }
        }
      },
      "wait": 0.5,
      "record": true,
      "shot": false
    },
    {
      "title": "Mid-run still, light: After the deadline: first page failed",
      "rpc": {
        "method": "debug.appearance",
        "params": {
          "mode": "light"
        }
      },
      "wait": 2.5,
      "shot": false
    },
    {
      "title": "Mid-run still, dark: After the deadline: first page failed",
      "rpc": {
        "method": "debug.appearance",
        "params": {
          "mode": "dark"
        }
      },
      "wait": 2.5,
      "shot": false
    },
    {
      "title": "The same state after both mid-run frames",
      "rpc": {
        "method": "debug.home_native_fixture.capture",
        "params": {
          "action": "state",
          "expect": {
            "first_page": "failed",
            "panel": "failed",
            "served": 0
          }
        }
      },
      "wait": 0.3,
      "record": true,
      "shot": false
    },
    {
      "title": "Back to light",
      "rpc": {
        "method": "debug.appearance",
        "params": {
          "mode": "light"
        }
      },
      "wait": 1,
      "shot": false
    },
    {
      "title": "The held read answers now (late)",
      "rpc": {
        "method": "debug.home_native_fixture.capture",
        "params": {
          "action": "release"
        }
      },
      "wait": 3,
      "record": true,
      "shot": false
    },
    {
      "title": "The late page replaced the error: first page loaded",
      "rpc": {
        "method": "debug.home_native_fixture.capture",
        "params": {
          "action": "state",
          "expect": {
            "first_page": "loaded",
            "panel": "none"
          }
        }
      },
      "wait": 0.5,
      "record": true,
      "shot": false
    }
  ]
}
