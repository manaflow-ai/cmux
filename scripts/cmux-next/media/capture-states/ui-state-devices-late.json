{
  "title": "Mac Screen Your Devices: the device list that arrives after the 10 s deadline replaces the error (ui-state-fixes M5)",
  "steps": [
    {
      "title": "Launch",
      "wait": 2,
      "shot": false
    },
    {
      "title": "A workspace for the Mac Screen tab",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "devices"
      ],
      "wait": 1,
      "shot": false
    },
    {
      "title": "Open it",
      "cmux": [
        "workspace",
        "name:devices",
        "focus"
      ],
      "wait": 2,
      "shot": false
    },
    {
      "title": "A registered hub whose socket never connects",
      "rpc": {
        "method": "debug.device_hub",
        "params": {
          "action": "capture_devices",
          "state": "timeout"
        }
      },
      "wait": 1,
      "record": true,
      "shot": false
    },
    {
      "title": "Mac Screen home",
      "rpc": {
        "method": "debug.mac_screen",
        "params": {
          "action": "open"
        }
      },
      "wait": 2,
      "record": true
    },
    {
      "title": "Past the 10 s list deadline: the error",
      "wait": 11,
      "shot": false
    },
    {
      "title": "The socket connects late and the list (one shared Mac) arrives",
      "rpc": {
        "method": "debug.device_hub",
        "params": {
          "action": "capture_devices",
          "state": "deliver"
        }
      },
      "wait": 3,
      "record": true,
      "shot": false
    }
  ]
}
