{
  "title": "Home: a Chief with history opened after the inbox read, its first read held past the 10 s deadline: the newest message with the inline error row and Try Again above it (ui-state-fixes M1, history case)",
  "steps": [
    {
      "title": "Launch",
      "wait": 2,
      "shot": false
    },
    {
      "title": "The Chief with history, opened once the inbox is read, its first read held",
      "rpc": {
        "method": "debug.home_native_fixture.open",
        "params": {
          "transcript": "loading",
          "after_inbox": true,
          "new": true
        }
      },
      "wait": 1.5,
      "record": true
    },
    {
      "title": "Before the deadline: loading",
      "rpc": {
        "method": "debug.home_native_fixture.capture",
        "params": {
          "action": "state",
          "expect": {
            "first_page": "loading",
            "panel": "loading",
            "served": 0
          }
        }
      },
      "wait": 0.5,
      "record": true,
      "shot": false
    },
    {
      "title": "Past the 10 s deadline",
      "wait": 11,
      "shot": false
    },
    {
      "title": "After the deadline: first page failed, the read still held",
      "rpc": {
        "method": "debug.home_native_fixture.capture",
        "params": {
          "action": "state",
          "expect": {
            "first_page": "failed",
            "panel": "failed",
            "served": 0
          }
        }
      },
      "wait": 0.5,
      "record": true,
      "shot": false
    }
  ]
}
