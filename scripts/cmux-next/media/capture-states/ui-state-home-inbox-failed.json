{
  "title": "Home: a Chief with history opened after the store read the inbox (as from the inbox list), its first transcript read failing: what shows (the inbox's newest message at once), then Try Again brings the rest (older-page reads held until Try Again, so only the inbox's newest message draws; ui-state-fixes M1, history case)",
  "steps": [
    {
      "title": "Launch",
      "wait": 2,
      "shot": false
    },
    {
      "title": "The Chief with history, opened once the inbox is read, its first read failing (its older pages held until Try Again)",
      "rpc": {
        "method": "debug.home_native_fixture.open",
        "params": {
          "transcript": "failed",
          "after_inbox": true,
          "new": true,
          "hold_history": true
        }
      },
      "wait": 3,
      "record": true
    },
    {
      "title": "First page failed: what the transcript draws, the panel, first-run and Try Again",
      "rpc": {
        "method": "debug.home_native_fixture.capture",
        "params": {
          "action": "state",
          "expect": {
            "first_page": "failed",
            "panel": "failed",
            "served": 0
          }
        }
      },
      "wait": 0.5,
      "record": true,
      "shot": false
    },
    {
      "title": "Mid-run still, light: First page failed: what the transcript draws, the panel, first-run and Try Again",
      "rpc": {
        "method": "debug.appearance",
        "params": {
          "mode": "light"
        }
      },
      "wait": 2.5,
      "shot": false
    },
    {
      "title": "Mid-run still, dark: First page failed: what the transcript draws, the panel, first-run and Try Again",
      "rpc": {
        "method": "debug.appearance",
        "params": {
          "mode": "dark"
        }
      },
      "wait": 2.5,
      "shot": false
    },
    {
      "title": "The same state after both mid-run frames",
      "rpc": {
        "method": "debug.home_native_fixture.capture",
        "params": {
          "action": "state",
          "expect": {
            "first_page": "failed",
            "panel": "failed",
            "served": 0
          }
        }
      },
      "wait": 0.3,
      "record": true,
      "shot": false
    },
    {
      "title": "Back to light",
      "rpc": {
        "method": "debug.appearance",
        "params": {
          "mode": "light"
        }
      },
      "wait": 1,
      "shot": false
    },
    {
      "title": "Try Again, the owner answering now",
      "rpc": {
        "method": "debug.home_native_fixture.capture",
        "params": {
          "action": "retry"
        }
      },
      "wait": 3,
      "record": true,
      "shot": false
    },
    {
      "title": "After Try Again: first page loaded",
      "rpc": {
        "method": "debug.home_native_fixture.capture",
        "params": {
          "action": "state",
          "expect": {
            "first_page": "loaded",
            "panel": "none"
          }
        }
      },
      "wait": 0.5,
      "record": true,
      "shot": false
    }
  ]
}
