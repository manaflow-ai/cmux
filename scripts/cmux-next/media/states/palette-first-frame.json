{
 "title": "Palette first frame (Lawrence, 2026-11-26: \"on cmd p, the workspace pill takes an additional frame to come in. prob similar with other things like cmd shift A\"): every frame the window server composites for the app's windows (debug.motion record_start, ScreenCaptureKit, display filter, so the palette panel is in it) while Cmd-P, Cmd-Shift-A, and Cmd-P over the open Cmd-Shift-P palette are pressed. The scope pill must be in the first frame the panel is.",
 "launch_args": [
  "--skip-onboarding"
 ],
 "steps": [
  {
   "title": "Launch",
   "wait": 1.0,
   "shot": false
  },
  {
   "title": "A second workspace",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Docs"
   ],
   "wait": 0.6,
   "shot": false
  },
  {
   "title": "Record",
   "rpc": {
    "method": "debug.motion",
    "params": {
     "action": "record_start",
     "path": "{strip}/palette.mov",
     "seconds": 40
    }
   },
   "wait": 1.5,
   "shot": false
  },
  {
   "title": "Cmd-P",
   "rpc": {
    "method": "debug.key",
    "params": {
     "key": "p",
     "modifiers": [
      "cmd"
     ]
    }
   },
   "wait": 1.2,
   "shot": false
  },
  {
   "title": "Close",
   "rpc": {
    "method": "debug.key",
    "params": {
     "key": "escape",
     "target": "palette"
    }
   },
   "wait": 0.7,
   "shot": false
  },
  {
   "title": "Cmd-Shift-A",
   "rpc": {
    "method": "debug.key",
    "params": {
     "key": "a",
     "modifiers": [
      "cmd",
      "shift"
     ]
    }
   },
   "wait": 1.2,
   "shot": false
  },
  {
   "title": "Close",
   "rpc": {
    "method": "debug.key",
    "params": {
     "key": "escape",
     "target": "palette"
    }
   },
   "wait": 0.7,
   "shot": false
  },
  {
   "title": "Cmd-Shift-P",
   "rpc": {
    "method": "debug.key",
    "params": {
     "key": "p",
     "modifiers": [
      "cmd",
      "shift"
     ]
    }
   },
   "wait": 0.9,
   "shot": false
  },
  {
   "title": "Cmd-P over the open palette",
   "rpc": {
    "method": "debug.key",
    "params": {
     "key": "p",
     "modifiers": [
      "cmd"
     ]
    }
   },
   "wait": 1.2,
   "shot": false
  },
  {
   "title": "Close",
   "rpc": {
    "method": "debug.key",
    "params": {
     "key": "escape",
     "target": "palette"
    }
   },
   "wait": 1.0,
   "shot": false
  },
  {
   "title": "Stop recording",
   "rpc": {
    "method": "debug.motion",
    "params": {
     "action": "record_stop"
    }
   },
   "wait": 2.5,
   "shot": false
  },
  {
   "title": "Recording written",
   "rpc": {
    "method": "debug.motion",
    "params": {
     "action": "record_read"
    }
   },
   "wait": 0.5,
   "shot": false
  },
  {
   "title": "Settled"
  }
 ]
}
