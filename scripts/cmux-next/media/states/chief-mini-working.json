{
  "title": "Show in Mini, the chat working: the Chief pet draws the chat's turn (8 frames from debug.chief_pet; the pet's panels stay out of screen captures)",
  "fakeHarness": {
    "id": "fake",
    "name": "Coordinator"
  },
  "settings": {
    "home": {
      "chiefPetEnabled": true,
      "chiefPetMascot": "mochi"
    }
  },
  "steps": [
    {
      "title": "Launch",
      "wait": 3
    },
    {
      "title": "A new agent chat",
      "rpc": {
        "method": "action.run",
        "params": {
          "action": "palette.newAgentChat",
          "focus": true
        }
      },
      "wait": 3
    },
    {
      "title": "On the fake harness, this Mac's own acpmux",
      "rpc": {
        "method": "debug.agent_pane",
        "params": {
          "action": "new_chat",
          "harness": "fake"
        }
      },
      "wait": 3
    },
    {
      "title": "A coordinator's first message (the fake agent echoes it)",
      "rpc": {
        "method": "debug.agent_pane",
        "params": {
          "action": "send_prompt",
          "text": "Coordinator: three lanes are landing the mini captures today."
        }
      },
      "wait": 4
    },
    {
      "title": "The chat's ••• menu",
      "rpc": {
        "method": "debug.agent_pane",
        "params": {
          "action": "click",
          "selector": "button[aria-label=\"Chat actions\"]"
        }
      },
      "wait": 1.5
    },
    {
      "title": "Show in Mini, clicked as the person",
      "rpc": {
        "method": "debug.agent_pane",
        "params": {
          "action": "click",
          "text": "Show in Mini"
        }
      },
      "wait": 3
    },
    {
      "title": "A long turn (a tool call every 100 ms for 60 s): the chat works",
      "rpc": {
        "method": "debug.agent_pane",
        "params": {
          "action": "send_prompt",
          "text": "works-through-cancel"
        }
      },
      "wait": 1.5
    },
    {
      "title": "The mini's state while the chat works",
      "rpc": {
        "method": "debug.chief_pet",
        "params": {
          "action": "state"
        }
      },
      "record": "file",
      "wait": 0.2
    },
    {
      "title": "Working frame 1",
      "rpc": {
        "method": "debug.chief_pet",
        "params": {
          "action": "snapshot",
          "window": "pet",
          "path": "{collect}"
        }
      },
      "collect": "working-01.png",
      "wait": 0.4
    },
    {
      "title": "Working frame 2",
      "rpc": {
        "method": "debug.chief_pet",
        "params": {
          "action": "snapshot",
          "window": "pet",
          "path": "{collect}"
        }
      },
      "collect": "working-02.png",
      "wait": 0.4
    },
    {
      "title": "Working frame 3",
      "rpc": {
        "method": "debug.chief_pet",
        "params": {
          "action": "snapshot",
          "window": "pet",
          "path": "{collect}"
        }
      },
      "collect": "working-03.png",
      "wait": 0.4
    },
    {
      "title": "Working frame 4",
      "rpc": {
        "method": "debug.chief_pet",
        "params": {
          "action": "snapshot",
          "window": "pet",
          "path": "{collect}"
        }
      },
      "collect": "working-04.png",
      "wait": 0.4
    },
    {
      "title": "Working frame 5",
      "rpc": {
        "method": "debug.chief_pet",
        "params": {
          "action": "snapshot",
          "window": "pet",
          "path": "{collect}"
        }
      },
      "collect": "working-05.png",
      "wait": 0.4
    },
    {
      "title": "Working frame 6",
      "rpc": {
        "method": "debug.chief_pet",
        "params": {
          "action": "snapshot",
          "window": "pet",
          "path": "{collect}"
        }
      },
      "collect": "working-06.png",
      "wait": 0.4
    },
    {
      "title": "Working frame 7",
      "rpc": {
        "method": "debug.chief_pet",
        "params": {
          "action": "snapshot",
          "window": "pet",
          "path": "{collect}"
        }
      },
      "collect": "working-07.png",
      "wait": 0.4
    },
    {
      "title": "Working frame 8",
      "rpc": {
        "method": "debug.chief_pet",
        "params": {
          "action": "snapshot",
          "window": "pet",
          "path": "{collect}"
        }
      },
      "collect": "working-08.png",
      "wait": 0.4
    },
    {
      "title": "Stop the long turn",
      "rpc": {
        "method": "debug.key",
        "params": {
          "key": "escape"
        }
      },
      "wait": 3,
      "optional": "Escape may not stop the turn"
    }
  ]
}
