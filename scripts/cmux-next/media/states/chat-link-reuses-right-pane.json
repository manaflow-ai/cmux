{
  "title": "A link from an agent chat with a page already docked on its right (cmux#28544): base docks the chat and opens a second right pane; after, the link is a tab in the pane already on the right.",
  "launch_args": ["--showcase"],
  "steps": [
    {"title": "Launch", "wait": 3},
    {"title": "A workspace", "cmux": ["action", "run", "newTab", "--name", "Right pane", "--focus", "--cwd", "/tmp"], "wait": 1},
    {"title": "Build the layout without main pane layout routing", "cmux": ["settings", "set", "layout.mainPane", "off"], "shot": false, "wait": 1},
    {"title": "An agent chat", "cmux": ["agent", "new-chat", "--cwd", "/tmp"], "wait": 3},
    {"title": "Wait for the chat page", "rpc": {"method": "debug.agent_pane", "params": {"action": "chat_state"}}, "shot": false},
    {"title": "The chat's turn (the showcase mock answers with a pull request link)", "rpc": {"method": "debug.agent_pane", "params": {"action": "send_prompt", "text": "Open the pull request"}}, "wait": 4, "shot": false},
    {"title": "A github.com page in the chat's pane", "cmux": ["tab", "new-browser", "--url", "https://github.com/manaflow-ai/cmux/pulls"], "wait": 4, "shot": false},
    {"title": "The page docked on the chat's right", "cmux": ["action", "run", "tab.moveToNewDockColumn", "--arg", "edge=right"], "wait": 2},
    {"title": "Main pane layout back on (the default)", "cmux": ["settings", "set", "layout.mainPane", "agent-chats"], "shot": false, "wait": 1},
    {"title": "Click the pull request link in the chat", "rpc": {"method": "debug.agent_pane", "params": {"action": "click", "selector": "a[href*=\"github.com\"]"}}, "wait": 0.3},
    {"title": "Mid-open", "wait": 0.3},
    {"title": "Where the link landed", "wait": 2}
  ]
}
