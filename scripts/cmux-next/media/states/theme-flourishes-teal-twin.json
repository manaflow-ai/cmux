{
 "title": "Teal Twin theme (github.com/teamleaderleo/teal-twin-theme @ 1.1.1) installed: window wallpaper, per-pane art in four panes, the sidebar header picture, the focused pane's accent glow, the tab close colors and the bar cursor, in dark and light",
 "steps": [
  {"title": "Launch", "wait": 3},
  {"title": "Four panes", "cmux": ["action", "run", "splitRight"], "wait": 1.5, "shot": false},
  {"title": "Split", "cmux": ["action", "run", "splitDown"], "wait": 1.5, "shot": false},
  {"title": "Split again", "cmux": ["action", "run", "splitRight"], "wait": 1.5, "shot": false},
  {"title": "Before: no theme", "wait": 1},
  {"title": "Install Teal Twin", "cmux": ["theme", "install", "github.com/teamleaderleo/teal-twin-theme@1.1.1", "--yes"], "wait": 6},
  {"title": "Teal Twin dark: dark appearance", "rpc": {"method": "debug.appearance", "params": {"mode": "dark"}}, "wait": 3},
  {"title": "Teal Twin light", "cmux": ["settings", "set", "appearance.themeFile", "teal-twin-light"], "wait": 1, "shot": false},
  {"title": "Teal Twin light: light appearance", "rpc": {"method": "debug.appearance", "params": {"mode": "light"}}, "wait": 3},
  {"title": "A plain theme: every flourish goes", "cmux": ["settings", "reset", "appearance.themeFile"], "wait": 3}
 ]
}
