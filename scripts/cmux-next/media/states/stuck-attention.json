{
  "title": "A live fake chat repeats one failed cargo test, shows the amber attention ring and diagnosis, then prefills an editable Nudge with hint draft without sending. Record with: cmux-ci capture SHA --state scripts/cmux-next/media/states/stuck-attention.json --cmux CHECKOUT --on controller",
  "fakeHarness": true,
  "steps": [
    {"title": "Launch", "wait": 2, "shot": false},
    {"title": "Open an agent chat", "rpc": {"method": "action.run", "params": {"action": "palette.newAgentChat", "focus": true}}, "wait": 2, "shot": false},
    {"title": "Start the isolated fake harness", "rpc": {"method": "debug.agent_pane", "params": {"action": "new_chat", "harness": "fake"}}, "record": true, "wait": 2, "shot": false},
    {"title": "Three identical failed tool calls, then a marker while the turn remains open", "rpc": {"method": "debug.agent_pane", "params": {"action": "send_prompt", "text": "stuck-loop"}}, "wait": 3, "shot": false},
    {"title": "Wait for the live turn's STUCK LOOP READY marker", "rpc": {"method": "debug.agent_pane", "params": {"action": "chat_state"}}, "untilReply": 20, "untilReplyContains": "STUCK LOOP READY", "record": "file", "shot": false},
    {"title": "Read the composer length before nudging", "rpc": {"method": "debug.agent_pane", "params": {"action": "readiness"}}, "record": true, "shot": false},
    {"title": "Capture the live attention ring and diagnosis", "rpc": {"method": "debug.window_snapshot", "params": {"kind": "main", "path": "{collect}"}}, "collect": "stuck-before-nudge.png", "wait": 0.5},
    {"title": "Nudge with hint prefills the composer", "rpc": {"method": "debug.agent_pane", "params": {"action": "click", "selector": ".acpmux-stuck-nudge"}}, "record": true, "wait": 0.5, "shot": false},
    {"title": "The editable composer has focus", "rpc": {"method": "debug.agent_pane", "params": {"action": "composer_focused"}}, "record": true, "shot": false},
    {"title": "Read the draft length after nudging", "rpc": {"method": "debug.agent_pane", "params": {"action": "readiness"}}, "record": true, "shot": false},
    {"title": "Confirm the agent still works and the nudge was not sent", "rpc": {"method": "debug.agent_pane", "params": {"action": "chat_state"}}, "record": "file", "shot": false},
    {"title": "Capture the editable hint draft beside the attention ring", "rpc": {"method": "debug.window_snapshot", "params": {"kind": "main", "path": "{collect}"}}, "collect": "stuck-after-nudge.png", "wait": 0.5}
  ]
}
