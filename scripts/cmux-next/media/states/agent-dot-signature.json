{
 "title": "Agent dot signatures (appearance.agentSignature on): each agent's sidebar row and its chat's running line draw a dot glyph acpmux makes from the session id. Three fake chats hold a running turn (until-cancel), so every row is running and the focused chat shows its running line. Record with: cmux-ci capture SHA --state scripts/cmux-next/media/states/agent-dot-signature.json --video --pr 47075",
 "launch_args": [
  "--skip-onboarding"
 ],
 "settings": {
  "appearance": {
   "agentSignature": true
  }
 },
 "harnessFixture": {
  "harnesses": {
   "fake": {
    "argv": [
     "python3",
     "{repo}/cmux-tui/crates/acpmux/tests/fake_agent.py"
    ],
    "description": "Fake ACP agent (agent dot signature capture)"
   }
  }
 },
 "steps": [
  {
   "title": "Launch",
   "wait": 3,
   "shot": false
  },
  {
   "title": "A fixed window size",
   "rpc": {
    "method": "debug.window_frame",
    "params": {
     "frame": [
      160,
      85,
      1100,
      720
     ]
    }
   },
   "wait": 0.3,
   "shot": false
  },
  {
   "title": "A workspace Alpha",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Alpha"
   ],
   "wait": 1.5,
   "shot": false
  },
  {
   "title": "Show Alpha",
   "cmux": [
    "workspace",
    "name:Alpha",
    "focus"
   ],
   "wait": 1,
   "shot": false
  },
  {
   "title": "An agent tab in Alpha",
   "rpc": {
    "method": "action.run",
    "params": {
     "action": "palette.newAgentChat",
     "focus": true
    }
   },
   "wait": 3,
   "shot": false
  },
  {
   "title": "A chat on the fake harness in Alpha",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "new_chat",
     "harness": "fake"
    }
   },
   "wait": 3,
   "shot": false
  },
  {
   "title": "Alpha's turn runs until cancelled",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "send_prompt",
     "text": "until-cancel"
    }
   },
   "wait": 2,
   "shot": false
  },
  {
   "title": "A workspace Beta",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Beta"
   ],
   "wait": 1.5,
   "shot": false
  },
  {
   "title": "Show Beta",
   "cmux": [
    "workspace",
    "name:Beta",
    "focus"
   ],
   "wait": 1,
   "shot": false
  },
  {
   "title": "An agent tab in Beta",
   "rpc": {
    "method": "action.run",
    "params": {
     "action": "palette.newAgentChat",
     "focus": true
    }
   },
   "wait": 3,
   "shot": false
  },
  {
   "title": "A chat on the fake harness in Beta",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "new_chat",
     "harness": "fake"
    }
   },
   "wait": 3,
   "shot": false
  },
  {
   "title": "Beta's turn runs until cancelled",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "send_prompt",
     "text": "until-cancel"
    }
   },
   "wait": 2,
   "shot": false
  },
  {
   "title": "A workspace Gamma",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Gamma"
   ],
   "wait": 1.5,
   "shot": false
  },
  {
   "title": "Show Gamma",
   "cmux": [
    "workspace",
    "name:Gamma",
    "focus"
   ],
   "wait": 1,
   "shot": false
  },
  {
   "title": "An agent tab in Gamma",
   "rpc": {
    "method": "action.run",
    "params": {
     "action": "palette.newAgentChat",
     "focus": true
    }
   },
   "wait": 3,
   "shot": false
  },
  {
   "title": "A chat on the fake harness in Gamma",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "new_chat",
     "harness": "fake"
    }
   },
   "wait": 3,
   "shot": false
  },
  {
   "title": "Gamma's turn runs until cancelled",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "send_prompt",
     "text": "until-cancel"
    }
   },
   "wait": 2,
   "shot": false
  },
  {
   "title": "Gamma's running line draws its glyph",
   "rpc": {
    "method": "debug.page",
    "params": {
     "page": "cmux.agent",
     "action": "wait",
     "selector": ".cv-signature",
     "timeout_ms": 20000
    }
   },
   "optional": "selector name",
   "record": true,
   "wait": 0.5,
   "shot": false
  },
  {
   "title": "On: sidebar rows and the running line each draw their agent's dot glyph",
   "wait": 2
  },
  {
   "title": "Back to Alpha: another session, another glyph",
   "cmux": [
    "workspace",
    "name:Alpha",
    "focus"
   ],
   "wait": 3
  },
  {
   "title": "The glyphs breathe while the turns run",
   "wait": 4
  }
 ]
}
