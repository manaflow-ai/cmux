{
 "title": "Borderless block chrome: four variants, light and dark (sidebar, the corner, the tab bar, top-right controls)",
 "launch_args": [
  "--showcase"
 ],
 "steps": [
  {
   "title": "Launch",
   "wait": 3
  },
  {
   "title": "Showcase rows: workspaces, groups, an agent chat, unread notifications",
   "rpc": {
    "method": "debug.showcase.seed",
    "params": {
     "focus": true,
     "dense": true
    }
   },
   "wait": 4,
   "optional": "the showcase fixture is DEBUG only"
  },
  {
   "title": "Workspace Blocks",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "Blocks"
   ],
   "wait": 2
  },
  {
   "title": "Show it",
   "cmux": [
    "workspace",
    "name:Blocks",
    "focus"
   ],
   "wait": 1.5
  },
  {
   "title": "A Markdown file",
   "cmux": [
    "workspace",
    "name:Blocks",
    "screen",
    "current",
    "pane",
    "current",
    "tab",
    "current",
    "terminal",
    "current",
    "write",
    "--text",
    "printf '# Blocks\\n\\nSolid tonal fills. No strokes, no hairlines.\\n' > /tmp/cmux-blocks.md; clear\r"
   ],
   "wait": 2,
   "daemon": true
  },
  {
   "title": "Open it in a second tab",
   "cmux": [
    "open",
    "/tmp/cmux-blocks.md",
    "--focus",
    "true"
   ],
   "wait": 3
  },
  {
   "title": "Split right",
   "cmux": [
    "action",
    "run",
    "splitRight"
   ],
   "wait": 2
  },
  {
   "title": "floating-none: appearance.chromeStyle = floating",
   "cmux": [
    "settings",
    "set",
    "appearance.chromeStyle",
    "floating"
   ],
   "wait": 0.7
  },
  {
   "title": "floating-none: appearance.borders = none",
   "cmux": [
    "settings",
    "set",
    "appearance.borders",
    "none"
   ],
   "wait": 0.7
  },
  {
   "title": "floating-none: system light",
   "rpc": {
    "method": "debug.appearance",
    "params": {
     "mode": "light"
    }
   },
   "wait": 2
  },
  {
   "title": "floating-none: the workspace",
   "cmux": [
    "workspace",
    "name:Blocks",
    "focus"
   ],
   "wait": 1.5
  },
  {
   "title": "Floating Panes with every line off: the parts that already exist (light)",
   "rpc": {
    "method": "debug.window_snapshot",
    "params": {
     "kind": "main",
     "path": "{collect}"
    }
   },
   "wait": 0.3,
   "collect": "floating-none-light.png"
  },
  {
   "title": "floating-none: system dark",
   "rpc": {
    "method": "debug.appearance",
    "params": {
     "mode": "dark"
    }
   },
   "wait": 2
  },
  {
   "title": "floating-none: the workspace",
   "cmux": [
    "workspace",
    "name:Blocks",
    "focus"
   ],
   "wait": 1.5
  },
  {
   "title": "Floating Panes with every line off: the parts that already exist (dark)",
   "rpc": {
    "method": "debug.window_snapshot",
    "params": {
     "kind": "main",
     "path": "{collect}"
    }
   },
   "wait": 0.3,
   "collect": "floating-none-dark.png"
  },
  {
   "title": "card-none: appearance.chromeStyle = two-tone",
   "cmux": [
    "settings",
    "set",
    "appearance.chromeStyle",
    "two-tone"
   ],
   "wait": 0.7
  },
  {
   "title": "card-none: appearance.borders = none",
   "cmux": [
    "settings",
    "set",
    "appearance.borders",
    "none"
   ],
   "wait": 0.7
  },
  {
   "title": "card-none: system light",
   "rpc": {
    "method": "debug.appearance",
    "params": {
     "mode": "light"
    }
   },
   "wait": 2
  },
  {
   "title": "card-none: the workspace",
   "cmux": [
    "workspace",
    "name:Blocks",
    "focus"
   ],
   "wait": 1.5
  },
  {
   "title": "One main-pane block on the shaded chrome (Two-Tone, lines off) (light)",
   "rpc": {
    "method": "debug.window_snapshot",
    "params": {
     "kind": "main",
     "path": "{collect}"
    }
   },
   "wait": 0.3,
   "collect": "card-none-light.png"
  },
  {
   "title": "card-none: system dark",
   "rpc": {
    "method": "debug.appearance",
    "params": {
     "mode": "dark"
    }
   },
   "wait": 2
  },
  {
   "title": "card-none: the workspace",
   "cmux": [
    "workspace",
    "name:Blocks",
    "focus"
   ],
   "wait": 1.5
  },
  {
   "title": "One main-pane block on the shaded chrome (Two-Tone, lines off) (dark)",
   "rpc": {
    "method": "debug.window_snapshot",
    "params": {
     "kind": "main",
     "path": "{collect}"
    }
   },
   "wait": 0.3,
   "collect": "card-none-dark.png"
  },
  {
   "title": "blocks: unset appearance.borders",
   "cmux": [
    "settings",
    "unset",
    "appearance.borders"
   ],
   "wait": 0.7
  },
  {
   "title": "blocks: appearance.chromeStyle = blocks",
   "cmux": [
    "settings",
    "set",
    "appearance.chromeStyle",
    "blocks"
   ],
   "wait": 0.7
  },
  {
   "title": "blocks: system light",
   "rpc": {
    "method": "debug.appearance",
    "params": {
     "mode": "light"
    }
   },
   "wait": 2
  },
  {
   "title": "blocks: the workspace",
   "cmux": [
    "workspace",
    "name:Blocks",
    "focus"
   ],
   "wait": 1.5
  },
  {
   "title": "Blocks: every pane its own block, a deeper chrome shade (light)",
   "rpc": {
    "method": "debug.window_snapshot",
    "params": {
     "kind": "main",
     "path": "{collect}"
    }
   },
   "wait": 0.3,
   "collect": "blocks-light.png"
  },
  {
   "title": "blocks: system dark",
   "rpc": {
    "method": "debug.appearance",
    "params": {
     "mode": "dark"
    }
   },
   "wait": 2
  },
  {
   "title": "blocks: the workspace",
   "cmux": [
    "workspace",
    "name:Blocks",
    "focus"
   ],
   "wait": 1.5
  },
  {
   "title": "Blocks: every pane its own block, a deeper chrome shade (dark)",
   "rpc": {
    "method": "debug.window_snapshot",
    "params": {
     "kind": "main",
     "path": "{collect}"
    }
   },
   "wait": 0.3,
   "collect": "blocks-dark.png"
  },
  {
   "title": "blocks-deep: tunable chrome.mainPane.shadeDark = 0.34",
   "rpc": {
    "method": "debug.tunables",
    "params": {
     "action": "set",
     "key": "chrome.mainPane.shadeDark",
     "value": 0.34
    }
   },
   "wait": 0.7,
   "optional": "debug.tunables is DEBUG only"
  },
  {
   "title": "blocks-deep: tunable chrome.mainPane.shadeLight = 0.08",
   "rpc": {
    "method": "debug.tunables",
    "params": {
     "action": "set",
     "key": "chrome.mainPane.shadeLight",
     "value": 0.08
    }
   },
   "wait": 0.7,
   "optional": "debug.tunables is DEBUG only"
  },
  {
   "title": "blocks-deep: layout.panePadding = 5",
   "cmux": [
    "settings",
    "set",
    "layout.panePadding",
    "5"
   ],
   "wait": 0.7
  },
  {
   "title": "blocks-deep: system light",
   "rpc": {
    "method": "debug.appearance",
    "params": {
     "mode": "light"
    }
   },
   "wait": 2
  },
  {
   "title": "blocks-deep: the workspace",
   "cmux": [
    "workspace",
    "name:Blocks",
    "focus"
   ],
   "wait": 1.5
  },
  {
   "title": "Blocks, deepest contrast and wider gaps (light)",
   "rpc": {
    "method": "debug.window_snapshot",
    "params": {
     "kind": "main",
     "path": "{collect}"
    }
   },
   "wait": 0.3,
   "collect": "blocks-deep-light.png"
  },
  {
   "title": "blocks-deep: system dark",
   "rpc": {
    "method": "debug.appearance",
    "params": {
     "mode": "dark"
    }
   },
   "wait": 2
  },
  {
   "title": "blocks-deep: the workspace",
   "cmux": [
    "workspace",
    "name:Blocks",
    "focus"
   ],
   "wait": 1.5
  },
  {
   "title": "Blocks, deepest contrast and wider gaps (dark)",
   "rpc": {
    "method": "debug.window_snapshot",
    "params": {
     "kind": "main",
     "path": "{collect}"
    }
   },
   "wait": 0.3,
   "collect": "blocks-deep-dark.png"
  }
 ]
}
