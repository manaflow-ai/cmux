{
  "title": "Agent new chat placement",
  "steps": [
    {"title": "Fresh launch at Home", "wait": 4},
    {"title": "CLI new chat from Home", "cmux": ["agent", "new-chat"], "wait": 5},
    {"title": "Record first placement", "rpc": {"method": "debug.windows"}, "record": true, "shot": false},
    {"title": "Record first pane layout", "rpc": {"method": "debug.pane_chrome"}, "record": true, "shot": false},
    {"title": "Repeat CLI new chat", "cmux": ["agent", "new-chat"], "wait": 5},
    {"title": "Record second placement", "rpc": {"method": "debug.windows"}, "record": true, "shot": false},
    {"title": "Record second pane layout", "rpc": {"method": "debug.pane_chrome"}, "record": true, "shot": false},
    {"title": "Third CLI new chat", "cmux": ["agent", "new-chat"], "wait": 5},
    {"title": "Record third placement", "rpc": {"method": "debug.windows"}, "record": true, "shot": false},
    {"title": "Record third pane layout", "rpc": {"method": "debug.pane_chrome"}, "record": true, "shot": false}
  ]
}
