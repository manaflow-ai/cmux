{
 "title": "Environment Secrets Playground: three directions of the Cloud environment variables and secrets page, ten states each",
 "steps": [
  {
   "title": "Launch",
   "wait": 2,
   "shot": false
  },
  {
   "title": "Bring the app in front (a pointer step launches it activated, so its buttons draw active)",
   "move": {
    "x": 40,
    "y": 40
   },
   "wait": 1,
   "shot": false
  },
  {
   "title": "Ledger: Empty",
   "rpc": {
    "method": "action.run",
    "params": {
     "action": "debug.envSecretsPlayground",
     "args": {
      "variant": 1,
      "state": 0
     },
     "origin": "script"
    }
   },
   "wait": 4,
   "shot": true
  },
