{
 "title": "Leo, 2026-11-09: a table opened from chat sits in the side panel on the right, and the line between it and the chat looked like a divider that could not be dragged. A reply's table opens in the side panel; its left edge then drags it wider, the chat narrowing with it (cmux#39090).",
 "launch_args": [
  "--showcase"
 ],
 "fakeHarness": {
  "id": "fake",
  "name": "Fake"
 },
 "steps": [
  {
   "title": "Launch",
   "wait": 3,
   "shot": false
  },
  {
   "title": "A wide window, so the chat has room for the panel beside it",
   "rpc": {
    "method": "debug.window_frame",
    "params": {
     "frame": [
      160,
      85,
      1600,
      960
     ]
    }
   },
   "record": true,
   "wait": 0.2,
   "shot": false
  },
  {
   "title": "A new agent chat",
   "rpc": {
    "method": "action.run",
    "params": {
     "action": "palette.newAgentChat",
     "focus": true
    }
   },
   "wait": 3,
   "shot": false
  },
  {
   "title": "On the fake harness",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "new_chat",
     "harness": "fake"
    }
   },
   "wait": 3,
   "shot": false
  },
  {
   "title": "Hide the sidebar",
   "cmux": [
    "action",
    "run",
    "toggleSidebar"
   ],
   "wait": 1,
   "shot": false
  },
  {
   "title": "The chat alone in the window (zoom its pane)",
   "rpc": {
    "method": "action.run",
    "params": {
     "action": "toggleSplitZoom",
     "target": "pane:{pane}"
    }
   },
   "record": true,
   "wait": 1.5,
   "shot": false
  },
  {
   "title": "A reply with a table (the fake agent echoes the prompt)",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "send_prompt",
     "text": "Retried rows by failure, last 24 hours:\n\n| Failure | Retried rows |\n| --- | ---: |\n| 5xx | 412 |\n| Timeout | 187 |\n| 4xx | 23 |"
    }
   },
   "wait": 4
  },
  {
   "title": "Open table (the reply's, not the prompt's; the click reveals it as a Tab would, since a capture window gives no hover)",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "click",
     "selector": ".cv-table-block:not(.cv-user .cv-table-block) button[aria-label=\"Open table\"]"
    }
   },
   "record": true,
   "wait": 2
  },
  {
   "title": "Where the panel's edge is (a press that never moves changes nothing)",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "click",
     "selector": ".acpmux-artifact > .ui-split-edge"
    }
   },
   "record": true,
   "wait": 0.5,
   "shot": false
  },
  {
   "title": "Drag the panel's edge 300px left, then drop (a trusted DevTools drag: the chat shows in Chromium's own child window, which posted AppKit events never reach)",
   "rpc": {
    "method": "debug.page",
    "params": {
     "page": "cmux.agent",
     "action": "drag",
     "x1": 863,
     "y1": 450,
     "x2": 563,
     "y2": 450,
     "steps": 20
    }
   },
   "record": true,
   "wait": 1.5
  },
  {
   "title": "Where the panel's edge is after the drop",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "click",
     "selector": ".acpmux-artifact > .ui-split-edge"
    }
   },
   "record": true,
   "wait": 0.5,
   "shot": false
  },
  {
   "title": "The page after the drop",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "readiness"
    }
   },
   "record": true,
   "wait": 0.2,
   "shot": false
  }
 ]
}
