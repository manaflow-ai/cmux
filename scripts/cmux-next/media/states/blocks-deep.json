{
 "title": "Borderless block chrome, Blocks with wider gaps (the compared shade is now the style's own): the sidebar, the corner, the tab bar and the top-right tools, light and dark",
 "launch_args": [
  "--showcase"
 ],
 "settings": {
  "appearance": {
   "chromeStyle": "blocks"
  },
  "layout": {
   "panePadding": 5
  }
 },
 "steps": [
  {
   "title": "Launch",
   "wait": 3
  },
  {
   "title": "Tunable chrome.mainPane.shadeDark = 0.34",
   "rpc": {
    "method": "debug.tunables",
    "params": {
     "action": "set",
     "key": "chrome.mainPane.shadeDark",
     "value": 0.34
    }
   },
   "wait": 0.7,
   "optional": "debug.tunables is DEBUG only"
  },
  {
   "title": "Tunable chrome.mainPane.shadeLight = 0.08",
   "rpc": {
    "method": "debug.tunables",
    "params": {
     "action": "set",
     "key": "chrome.mainPane.shadeLight",
     "value": 0.08
    }
   },
   "wait": 0.7,
   "optional": "debug.tunables is DEBUG only"
  },
  {
   "title": "Showcase rows: workspaces, an agent chat, unread notifications",
   "rpc": {
    "method": "debug.showcase.seed",
    "params": {
     "focus": true,
     "dense": true
    }
   },
   "wait": 4,
   "optional": "the showcase fixture is DEBUG only"
  },
  {
   "title": "Workspace blocks-deep",
   "cmux": [
    "workspace",
    "new",
    "--name",
    "blocks-deep"
   ],
   "wait": 2
  },
  {
   "title": "Show it",
   "cmux": [
    "workspace",
    "name:blocks-deep",
    "focus"
   ],
   "wait": 1.5
  },
  {
   "title": "A Markdown file, and a prompt that names no host",
   "cmux": [
    "workspace",
    "name:blocks-deep",
    "screen",
    "current",
    "pane",
    "current",
    "tab",
    "current",
    "terminal",
    "current",
    "write",
    "--text",
    "PS1='$ '; printf '# Blocks\\n\\nSolid tonal fills. No strokes, no hairlines.\\n' > /tmp/cmux-blocks.md; clear\r"
   ],
   "wait": 2,
   "daemon": true
  },
  {
   "title": "Open it in a second tab",
   "cmux": [
    "open",
    "/tmp/cmux-blocks.md",
    "--focus",
    "true"
   ],
   "wait": 3
  },
  {
   "title": "Split right",
   "cmux": [
    "action",
    "run",
    "splitRight"
   ],
   "wait": 2.5
  },
  {
   "title": "The new pane's prompt names no host",
   "cmux": [
    "workspace",
    "name:blocks-deep",
    "screen",
    "current",
    "pane",
    "current",
    "tab",
    "current",
    "terminal",
    "current",
    "write",
    "--text",
    "PS1='$ '; clear\r"
   ],
   "wait": 1.5,
   "daemon": true
  },
  {
   "title": "System light",
   "rpc": {
    "method": "debug.appearance",
    "params": {
     "mode": "light"
    }
   },
   "wait": 2
  },
  {
   "title": "The workspace",
   "cmux": [
    "workspace",
    "name:blocks-deep",
    "focus"
   ],
   "wait": 1.5
  },
  {
   "title": "Blocks with wider gaps (the compared shade is now the style's own) (light)",
   "rpc": {
    "method": "debug.window_snapshot",
    "params": {
     "kind": "main",
     "path": "{collect}"
    }
   },
   "wait": 0.3,
   "collect": "blocks-deep-light.png"
  },
  {
   "title": "System dark",
   "rpc": {
    "method": "debug.appearance",
    "params": {
     "mode": "dark"
    }
   },
   "wait": 2
  },
  {
   "title": "The workspace",
   "cmux": [
    "workspace",
    "name:blocks-deep",
    "focus"
   ],
   "wait": 1.5
  },
  {
   "title": "Blocks with wider gaps (the compared shade is now the style's own) (dark)",
   "rpc": {
    "method": "debug.window_snapshot",
    "params": {
     "kind": "main",
     "path": "{collect}"
    }
   },
   "wait": 0.3,
   "collect": "blocks-deep-dark.png"
  }
 ]
}
