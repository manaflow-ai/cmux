{
  "title": "The classic import prompt and its after-Not Now toast: before, the landed look and the gallery variants (CmuxDialogSpec.classicImportGallery, CmuxToast.classicImportGallery). Record with: cmux-ci capture SHA --state scripts/cmux-next/media/states/classic-import-prompt.json",
  "steps": [
    {
      "title": "Launch",
      "wait": 3,
      "shot": false
    },
    {
      "title": "Open the classicImportBefore prompt",
      "rpc": {
        "method": "debug.dialog",
        "params": {
          "open": "classicImportBefore"
        }
      },
      "record": true,
      "wait": 1,
      "shot": false
    },
    {
      "title": "Capture classicImportBefore",
      "rpc": {
        "method": "debug.window_snapshot",
        "params": {
          "kind": "main",
          "path": "{collect}"
        }
      },
      "collect": "prompt-before.png",
      "wait": 0.3
    },
    {
      "title": "Dismiss classicImportBefore",
      "rpc": {
        "method": "debug.dialog",
        "params": {
          "dismiss": true
        }
      },
      "shot": false,
      "wait": 0.6
    },
    {
      "title": "Open the classicImport prompt",
      "rpc": {
        "method": "debug.dialog",
        "params": {
          "open": "classicImport"
        }
      },
      "record": true,
      "wait": 1,
      "shot": false
    },
    {
      "title": "Capture classicImport",
      "rpc": {
        "method": "debug.window_snapshot",
        "params": {
          "kind": "main",
          "path": "{collect}"
        }
      },
      "collect": "prompt-landed.png",
      "wait": 0.3
    },
    {
      "title": "Dismiss classicImport",
      "rpc": {
        "method": "debug.dialog",
        "params": {
          "dismiss": true
        }
      },
      "shot": false,
      "wait": 0.6
    },
    {
      "title": "Open the classicImportCountTitle prompt",
      "rpc": {
        "method": "debug.dialog",
        "params": {
          "open": "classicImportCountTitle"
        }
      },
      "record": true,
      "wait": 1,
      "shot": false
    },
    {
      "title": "Capture classicImportCountTitle",
      "rpc": {
        "method": "debug.window_snapshot",
        "params": {
          "kind": "main",
          "path": "{collect}"
        }
      },
      "collect": "prompt-variant-count-title.png",
      "wait": 0.3
    },
    {
      "title": "Dismiss classicImportCountTitle",
      "rpc": {
        "method": "debug.dialog",
        "params": {
          "dismiss": true
        }
      },
      "shot": false,
      "wait": 0.6
    },
    {
      "title": "Open the classicImportList prompt",
      "rpc": {
        "method": "debug.dialog",
        "params": {
          "open": "classicImportList"
        }
      },
      "record": true,
      "wait": 1,
      "shot": false
    },
    {
      "title": "Capture classicImportList",
      "rpc": {
        "method": "debug.window_snapshot",
        "params": {
          "kind": "main",
          "path": "{collect}"
        }
      },
      "collect": "prompt-variant-list.png",
      "wait": 0.3
    },
    {
      "title": "Dismiss classicImportList",
      "rpc": {
        "method": "debug.dialog",
        "params": {
          "dismiss": true
        }
      },
      "shot": false,
      "wait": 0.6
    },
    {
      "title": "Open the classicImportCautions prompt",
      "rpc": {
        "method": "debug.dialog",
        "params": {
          "open": "classicImportCautions"
        }
      },
      "record": true,
      "wait": 1,
      "shot": false
    },
    {
      "title": "Capture classicImportCautions",
      "rpc": {
        "method": "debug.window_snapshot",
        "params": {
          "kind": "main",
          "path": "{collect}"
        }
      },
      "collect": "prompt-landed-cautions.png",
      "wait": 0.3
    },
    {
      "title": "Dismiss classicImportCautions",
      "rpc": {
        "method": "debug.dialog",
        "params": {
          "dismiss": true
        }
      },
      "shot": false,
      "wait": 0.6
    },
    {
      "title": "Show the before toast",
      "rpc": {
        "method": "debug.toast",
        "params": {
          "classic_toast": "before"
        }
      },
      "record": true,
      "wait": 1.2,
      "shot": false
    },
    {
      "title": "Capture toast before",
      "rpc": {
        "method": "debug.window_snapshot",
        "params": {
          "kind": "main",
          "path": "{collect}"
        }
      },
      "collect": "toast-before.png",
      "wait": 0.3
    },
    {
      "title": "Close toast before",
      "rpc": {
        "method": "debug.toast",
        "params": {
          "close": "classicImport"
        }
      },
      "shot": false,
      "wait": 0.5
    },
    {
      "title": "Show the short toast",
      "rpc": {
        "method": "debug.toast",
        "params": {
          "classic_toast": "short"
        }
      },
      "record": true,
      "wait": 1.2,
      "shot": false
    },
    {
      "title": "Capture toast short",
      "rpc": {
        "method": "debug.window_snapshot",
        "params": {
          "kind": "main",
          "path": "{collect}"
        }
      },
      "collect": "toast-short.png",
      "wait": 0.3
    },
    {
      "title": "Close toast short",
      "rpc": {
        "method": "debug.toast",
        "params": {
          "close": "classicImport"
        }
      },
      "shot": false,
      "wait": 0.5
    },
    {
      "title": "Show the action toast",
      "rpc": {
        "method": "debug.toast",
        "params": {
          "classic_toast": "action"
        }
      },
      "record": true,
      "wait": 1.2,
      "shot": false
    },
    {
      "title": "Capture toast action",
      "rpc": {
        "method": "debug.window_snapshot",
        "params": {
          "kind": "main",
          "path": "{collect}"
        }
      },
      "collect": "toast-action.png",
      "wait": 0.3
    },
    {
      "title": "Close toast action",
      "rpc": {
        "method": "debug.toast",
        "params": {
          "close": "classicImport"
        }
      },
      "shot": false,
      "wait": 0.5
    }
  ]
}
