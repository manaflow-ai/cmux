{
 "title": "Lawrence 2026-11-11: Ctrl-Shift-HJKL inside a column sized the wrong way. A split's divider follows the arrow; a strip column keeps grow/shrink.",
 "steps": [
  {
   "title": "Launch",
   "wait": 4,
   "shot": false
  },
  {
   "title": "Open a terminal workspace",
   "cmux": [
    "action",
    "run",
    "newTab",
    "--name",
    "Panes",
    "--focus",
    "--cwd",
    "/tmp"
   ],
   "wait": 2,
   "shot": false
  },
  {
   "title": "A wide window",
   "rpc": {
    "method": "debug.window_frame",
    "params": {
     "frame": [
      160,
      85,
      1600,
      960
     ]
    }
   },
   "wait": 0.3,
   "shot": false
  },
  {
   "title": "Hide the sidebar",
   "cmux": [
    "action",
    "run",
    "toggleSidebar"
   ],
   "wait": 1.0,
   "shot": false
  },
  {
   "title": "Split side by side",
   "cmux": [
    "action",
    "run",
    "splitRight"
   ],
   "wait": 2,
   "shot": false
  },
  {
   "title": "A: right pane focused, divider at 50%",
   "cmux": [
    "action",
    "run",
    "focusRight"
   ],
   "wait": 3,
   "shot": true
  },
  {
   "title": "H on the right pane (1 of 2)",
   "cmux": [
    "action",
    "run",
    "resizePaneLeft"
   ],
   "wait": 0.6,
   "shot": false
  },
  {
   "title": "B: after H H on the right pane",
   "cmux": [
    "action",
    "run",
    "resizePaneLeft"
   ],
   "wait": 3,
   "shot": true
  },
  {
   "title": "Right pane split into a stack",
   "cmux": [
    "action",
    "run",
    "splitDown"
   ],
   "wait": 2,
   "shot": false
  },
  {
   "title": "C: bottom-right pane focused",
   "cmux": [
    "action",
    "run",
    "focusDown"
   ],
   "wait": 3,
   "shot": true
  },
  {
   "title": "K on the bottom pane (1 of 2)",
   "cmux": [
    "action",
    "run",
    "resizePaneUp"
   ],
   "wait": 0.6,
   "shot": false
  },
  {
   "title": "D: after K K on the bottom-right pane",
   "cmux": [
    "action",
    "run",
    "resizePaneUp"
   ],
   "wait": 3,
   "shot": true
  },
  {
   "title": "E: after H on the bottom-right pane",
   "cmux": [
    "action",
    "run",
    "resizePaneLeft"
   ],
   "wait": 3,
   "shot": true
  }
 ]
}
