   "wait": 0.2,
   "shot": false
  },
  {
   "title": "Typed: the draft in the composer, transcript still scrolled up",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "readiness"
    }
   },
   "record": true,
   "wait": 1
  },
  {
   "title": "Keep scrolling while the session list ticks",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "fling",
     "seconds": 4,
     "wait": true
    }
   },
   "record": true,
   "wait": 0.5
  },
  {
   "title": "Two background subagents run: the composer's hat shows them, its time ticking each second",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "seed_rows",
     "fixture": "subagents",
     "count": 1,
     "agents": 3
    }
   },
   "record": true,
   "wait": 2
  },
  {
   "title": "Focus the composer under the ticking hat",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "focus_composer"
    }
   },
   "wait": 0.3,
   "shot": false
  },
  {
   "title": "Click into the composer under the hat",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "click",
     "selector": ".acpmux-composer-prompt"
    }
   },
   "record": true,
   "wait": 0.4,
   "shot": false
  },
  {
