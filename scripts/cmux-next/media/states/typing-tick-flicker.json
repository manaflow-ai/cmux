   "wait": 0.2,
   "shot": false
  },
  {
   "title": "Composer text after the second typing",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "readiness"
    }
   },
   "record": true,
   "wait": 0.2,
   "shot": false
  },
  {
   "title": "The hat ticks for six seconds while nothing else changes",
   "wait": 6
  },
  {
   "title": "The chat state at the end",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "chat_state"
    }
   },
   "record": "file",
   "wait": 0.5
