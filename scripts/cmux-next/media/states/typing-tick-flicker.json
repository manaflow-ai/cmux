{
 "title": "Typing and tick flicker check (cmux#39104, cmux#39142), in the showcase window (its sidebar rows and agent tab carry unread dots): a 300-turn agent chat scrolled up, twenty characters typed into the composer at a person's pace, more scrolling, then the subagents fixture's running subagents in the composer's hat, its time ticking, with more typing and six still seconds. The tab's and the workspace row's dots must not blink per key, and the composer and the hat must hold still but for the time digits. Record it with: cmux-ci capture SHA --state scripts/cmux-next/media/states/typing-tick-flicker.json --video",
 "launch_args": [
  "--showcase"
 ],
 "frameInterval": 0.25,
 "steps": [
  {
   "title": "Showcase window: workspaces, an agent chat tab, unread notifications",
   "rpc": {
    "method": "debug.showcase.seed",
    "params": {
     "focus": true
    }
   },
   "wait": 6
  },
  {
   "title": "Agent page ready",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "readiness"
    }
   },
   "optional": "the page may still be loading",
   "wait": 2,
   "shot": false
  },
  {
   "title": "Agent page ready (retry)",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "readiness"
    }
   },
   "wait": 1,
   "shot": false
  },
  {
   "title": "A long transcript: a 300-turn session (showcase mock daemon, loadFixture.ts)",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "load_seed",
     "turns": 300
    }
   },
   "record": true,
   "wait": 2
  },
  {
   "title": "Scroll the transcript up",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "fling",
     "seconds": 1.5,
     "wait": true
    }
   },
   "record": true,
   "wait": 1
  },
  {
   "title": "Focus the composer, transcript scrolled up",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "focus_composer"
    }
   },
   "record": true,
   "wait": 0.5,
   "shot": false
  },
  {
   "title": "Mark the agent tab unread (its tab dot and the workspace row's dot)",
   "rpc": {
    "method": "action.run",
    "params": {
     "action": "palette.toggleTabUnread"
    }
   },
   "record": true,
   "wait": 1.5,
   "optional": "marks the focused tab; the showcase may focus another"
  },
  {
   "title": "Click into the composer, as a person does",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "click",
     "selector": ".acpmux-composer-prompt"
    }
   },
   "record": true,
   "wait": 0.4,
   "shot": false
  },
  {
   "title": "Composer text before typing",
   "rpc": {
    "method": "debug.agent_pane",
    "params": {
     "action": "readiness"
    }
   },
   "record": true,
   "wait": 0.2,
   "shot": false
  },
  {
   "title": "Type 'c' (1/20)",
   "key": "c",
   "modifiers": [],
   "pane": "{pane}",
   "wait": 0.2,
   "shot": false
  },
  {
   "title": "Type 'h' (2/20)",
   "key": "h",
   "modifiers": [],
   "pane": "{pane}",
   "wait": 0.2,
   "shot": false
  },
  {
   "title": "Type 'e' (3/20)",
   "key": "e",
   "modifiers": [],
   "pane": "{pane}",
   "wait": 0.2,
   "shot": false
  },
  {
   "title": "Type 'c' (4/20)",
   "key": "c",
   "modifiers": [],
   "pane": "{pane}",
   "wait": 0.2,
   "shot": false
  },
  {
   "title": "Type 'k' (5/20)",
   "key": "k",
   "modifiers": [],
   "pane": "{pane}",
   "wait": 0.2,
   "shot": false
  },
  {
   "title": "Type ' ' (6/20)",
   "key": "space",
   "modifiers": [],
   "pane": "{pane}",
   "wait": 0.2,
   "shot": false
  },
  {
   "title": "Type 't' (7/20)",
   "key": "t",
   "modifiers": [],
   "pane": "{pane}",
   "wait": 0.2,
   "shot": false
