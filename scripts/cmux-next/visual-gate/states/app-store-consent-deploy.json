{
  "title": "Consent card of cmux apps install --deploy self-hosted",
  "settings": {
    "labs": {
      "previewFeatures": true
    }
  },
  "launch_args": [],
  "steps": [
    {
      "title": "Launch",
      "wait": 3
    },
    {
      "title": "App Store",
      "cmux": [
        "action",
        "run",
        "appStore.show",
        "--focus",
        "--tab",
        "discover"
      ],
      "wait": 4,
      "cite": "cmux-tui/crates/cmux-action-catalog/src/catalog/app_store.rs"
    },
    {
      "title": "cmux apps install manaflow-ai/hello-deploy",
      "cmux": [
        "action",
        "run",
        "app.install",
        "--no-wait",
        "--app",
        "manaflow-ai/hello-deploy",
        "--deploy",
        "self-hosted:ops-build-01.example.invalid"
      ],
      "wait": 3,
      "cite": "Packages/macOS/CmuxNext/Sources/CmuxNextPages/AppsStoreChange.swift"
    }
  ]
}
