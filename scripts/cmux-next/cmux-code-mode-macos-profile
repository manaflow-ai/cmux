#!/bin/sh
set -eu

if [ "$#" -lt 6 ] || [ "$#" -gt 7 ]; then
  echo "usage: $0 PROFILE BUN SDK SCRIPT PROXY_SOCKET TEMP_DIR [CLOUD_SOCKET]" >&2
  exit 2
fi

profile=$1
bun=$2
sdk=$3
script=$4
proxy_socket=$5
temp_dir=$6
cloud_socket=${7:-}

# Seatbelt literals are quoted strings. Reject control characters and escape the
# two characters that can terminate a literal. Paths with a newline are not
# meaningful script inputs.
literal() {
  value=$1
  case "$value" in
    *[![:print:]]*)
      echo "cmux run: sandbox path contains a non-printable character" >&2
      exit 2
      ;;
  esac
  printf '%s' "$value" | sed 's/[\\\"]/\\&/g'
}

{
  cat <<'EOF_PROFILE'
(version 1)
(deny default)

; Bun and the bundled SDK/script are the only executable/readable inputs.
EOF_PROFILE
  printf '(allow process-exec (literal "%s"))\n' "$(literal "$bun")"
  printf '(allow file-read* (literal "%s"))\n' "$(literal "$bun")"
  printf '(allow file-read* (subpath "%s"))\n' "$(literal "$sdk")"
  printf '(allow file-read* (literal "%s"))\n' "$(literal "$script")"
  cat <<'EOF_PROFILE'

; Bun's signed runtime and dynamic loader need system libraries, but no user
; data or broad filesystem/network access is exposed.
(allow file-read* (subpath "/System/Library"))
(allow file-read* (subpath "/usr/lib"))
(allow file-read* (subpath "/usr/share"))
(allow file-read* (subpath "/Library/Frameworks"))
(allow file-read* (literal "/dev/null"))
(allow file-read* (literal "/dev/random"))
(allow file-read* (literal "/dev/urandom"))
(allow sysctl-read)
(allow ipc-posix-shm-read*)
(allow ipc-posix-shm-write*)

; The script may write only its per-run temporary directory.
EOF_PROFILE
  printf '(allow file-read* (subpath "%s"))\n' "$(literal "$temp_dir")"
  printf '(allow file-write* (subpath "%s"))\n' "$(literal "$temp_dir")"
  printf '(allow file-read-metadata (subpath "%s"))\n' "$(literal "$temp_dir")"

  # Unix-domain sockets need an AF_UNIX socket descriptor plus a remote socket
  # path. The proxy owns the target cmux socket, so the sandbox sees only these
  # relays. A path filter directly on network-outbound is invalid SBPL and
  # makes sandbox-exec abort while compiling the profile.
  printf '(allow system-socket (socket-domain AF_UNIX))\n'
  printf '(allow file-read-metadata (literal "%s"))\n' "$(literal "$proxy_socket")"
  printf '(allow network-bind (local unix-socket (subpath "%s")))\n' "$(literal "$proxy_socket")"
  printf '(allow network-outbound (remote unix-socket (subpath "%s")))\n' "$(literal "$proxy_socket")"
  if [ -n "$cloud_socket" ]; then
    printf '(allow file-read-metadata (literal "%s"))\n' "$(literal "$cloud_socket")"
    printf '(allow network-bind (local unix-socket (subpath "%s")))\n' "$(literal "$cloud_socket")"
    printf '(allow network-outbound (remote unix-socket (subpath "%s")))\n' "$(literal "$cloud_socket")"
  fi
} >"$profile"
