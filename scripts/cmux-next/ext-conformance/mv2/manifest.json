{
  "manifest_version": 2,
  "name": "cmux conformance MV2",
  "version": "1.0",
  "description": "cmux-next chrome.* API conformance probe (MV2).",
  "key": "",
  "background": {
    "scripts": [
      "harness.js",
      "bg.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "cmux conformance MV2"
  },
  "permissions": [
    "tabs",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "harness.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    "config.json"
  ]
}