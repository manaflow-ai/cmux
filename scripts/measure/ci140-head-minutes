def ts(text):
    if not text or text.startswith("0001-"):
        return None
    m = re.match(r"^(.*T\d\d:\d\d:\d\d)(\.\d+)?", text)
    return dt.datetime.fromisoformat(m.group(1) + (m.group(2) or "")[:7] + "+00:00").timestamp()


def rows(path):
    with (gzip.open if path.endswith(".gz") else open)(path, "rt") as f:
        for line in f:
            if line.strip():
                yield json.loads(line)


def git(mirror, *args):
    env = dict(os.environ, GIT_NO_LAZY_FETCH="1")
    return subprocess.run(["git", "-C", mirror, *args], capture_output=True, text=True, env=env).stdout


def merges(mirror, since, until):
    """PR number -> (merge time, branch) for GitHub-committed `(#N)` subjects on the bases (ci_minutes.merged_prs)."""
    out = {}
    for branch in BASES:
        log = git(mirror, "log", "--no-merges", f"--since=@{int(since)}", f"--until=@{int(until)}",
                  "--format=%H%x09%ct%x09%cn%x09%s", f"origin/{branch}")
        for line in log.splitlines():
            sha, at, committer, subject = line.split("\t", 3)
            m = re.search(r"\(#(\d+)\)$", subject)
            if m and committer == "GitHub":
                out.setdefault(int(m.group(1)), (int(at), branch))
    return out


def job_key(r):
    """workflow file / job name with shard and matrix suffixes folded."""
    wf = (r.get("workflow_path") or r.get("workflow") or "?").rsplit("/", 1)[-1]
    job = re.sub(r" \((?:shard )?\d+(?:/\d+)?\)$", "", r.get("job") or "")
    job = re.sub(r"\b(shard|part) ?\d+(/\d+)?\b", r"\1 N", job)
    return wf, job


def fleet_key(j):
    sk = j.get("step_key") or ""
    if m := RC_KEY.match(sk):
        return "fleet", "rc " + m.group(3)
    if HV_KEY.match(sk):
        return "fleet", "hot verify"
    return "fleet", (j.get("kind") or "?") + " " + (j.get("submitter") or "")


def globmatch(f, p):
    return p == "**" or fnmatch.fnmatchcase(f, p) or (p.endswith("/**") and f.startswith(p[:-2]))


def touches(fs, globs):
    """GitHub paths semantics: ordered globs, `!glob` un-matches, last match wins; true if any file stays matched."""
    for f in fs:
        hit = False
        for g in globs:
            if g.startswith("!"):
                hit = hit and not globmatch(f, g[1:])
            elif globmatch(f, g):
                hit = True
        if hit:
            return True
    return False


def fate(pr, prs, merged_in, merged_any, since, until):
    if pr is None:
        return "no PR named"
    if pr in merged_in:
        return "merged in window"
    if pr in merged_any:
        return "merged after window" if merged_any[pr][0] >= until else "merged before window"
    p = prs.get(pr)
    if p is None:
        return "PR not in list"
    if p.get("mergedAt"):
        return "merged into another base" if p.get("baseRefName") not in BASES else "merged (not on mirror yet)"
    if p.get("state") == "CLOSED":
        return "closed unmerged"
    return "open draft" if p.get("isDraft") else "open ready"


def heads_bucket(n):
    return "1" if n <= 1 else "2-3" if n <= 3 else "4-9" if n <= 9 else "10-19" if n <= 19 else "20+"


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    for k in ("feed", "fleet", "rc", "prs", "mirror", "since", "until"):
        ap.add_argument("--" + k, required=True)
    ap.add_argument("--top", type=int, default=15)
    ap.add_argument("--json-out", help="also write every table as JSON here")
    ap.add_argument("--rules", help="a {\"rules\": [...]} JSON to use instead of RULES (same shape)")
    a = ap.parse_args(argv)
    since, until = ts(a.since), ts(a.until)
    table = json.load(open(a.rules))["rules"] if a.rules else RULES
    rules = [(r["wf"], re.compile(r["job"]), r["paths"], r.get("and_paths"), r.get("source", "rule")) for r in table]

    merged_any = merges(a.mirror, since - 7 * 86400, until + 7 * 86400)
    merged_in = {pr for pr, (at, _) in merged_any.items() if since <= at < until}
    M = len(merged_in) or 1
    prs = {int(k): v for k, v in json.load(open(a.prs)).items()}
    by_branch = collections.defaultdict(list)
    for p in prs.values():
        by_branch[p["headRefName"]].append((ts(p["createdAt"]), p["number"]))
    for v in by_branch.values():
        v.sort()

    rc = [h for h in json.load(open(a.rc))["heads"] if h.get("head") and h.get("pr")]
    head_pr = {h["head"]: h["pr"] for h in rc}
    head_base = {h["head"]: h.get("base") for h in rc}

    # GitHub rows -> runs (created = earliest job creation), sha, branch
    feed = []
    runs = {}
    for r in rows(a.feed):
        end = ts(r["at"])
        if r.get("seg") != "pr" or not since <= end < until:
            continue
        start = end - (r.get("seconds") or 0)
        created = start - (r.get("queue") or 0)
        x = runs.setdefault(r["run"], {"created": created, "sha": None, "branch": r.get("branch")})
        x["created"] = min(x["created"], created)
        if r.get("sha"):
            x["sha"] = r["sha"]
        feed.append((r, start, end))

    branch_pr = {}
    for x in runs.values():
        if x["sha"] in head_pr and x["branch"]:
            branch_pr.setdefault(x["branch"], head_pr[x["sha"]])

    def pr_of_branch(b, t):
        if b in branch_pr:
            return branch_pr[b]
        v = by_branch.get(b) or []
        best = None
        for c, n in v:
            if c is not None and c <= t + 3600:
                best = n
        return best if best is not None else (v[0][1] if v else None)

    for x in runs.values():
        x["pr"] = head_pr.get(x["sha"]) or (pr_of_branch(x["branch"], x["created"]) if x["branch"] else None)

    # head sequence per PR: rc heads by seen_at, feed shas by first run creation
    push = collections.defaultdict(dict)
    for h in rc:
        t = ts(h.get("seen_at"))
        if t:
            d = push[h["pr"]]
            d[h["head"]] = min(d.get(h["head"], 1e18), t)
    for x in runs.values():
        if x["pr"] and x["sha"]:
            d = push[x["pr"]]
            d[x["sha"]] = min(d.get(x["sha"], 1e18), x["created"])
    seqs = {pr: sorted((t, h) for h, t in d.items()) for pr, d in push.items()}
    times = {pr: [t for t, _ in s] for pr, s in seqs.items()}

    def head_at(pr, t):
        s = seqs.get(pr)
        if not s:
            return None
        i = bisect.bisect_right(times[pr], t + 60) - 1
        return s[max(i, 0)][1]

    def next_push(pr, head):
        s = seqs.get(pr) or []
        for i, (_, h) in enumerate(s):
            if h == head:
                return s[i + 1][0] if i + 1 < len(s) else None
        return None

    inferred = 0
    for x in runs.values():
        if not x["sha"] and x["pr"]:
            x["sha"] = head_at(x["pr"], x["created"])
            x["inferred"] = True
            inferred += 1

    # one list of cost items: (pr, head, key, minutes, start, end, conclusion, source)
    items = []
    for r, start, end in feed:
        x = runs[r["run"]]
        items.append((x["pr"], x["sha"], job_key(r), r["seconds"] / 60, start, end, r.get("conclusion"), "gh"))
    run_pr = {rid: (x["pr"], x["sha"]) for rid, x in runs.items() if x["pr"]}
    seen = set()
    full_head = {}
    for pr, s in seqs.items():
        for _, h in s:
            full_head[(pr, h[:12])] = h
    for j in rows(a.fleet):
        end, start = ts(j.get("updated_at")), ts(j.get("started_at"))
        if j.get("state") not in TERMINAL or end is None or not since <= end < until or j.get("id") in seen:
            continue
        seen.add(j.get("id"))
        m = (end - start) / 60 if start and j.get("worker") and end > start else 0.0
        sk, ws = j.get("step_key") or "", j.get("workspace") or ""
        pr = head = None
        if k := RC_KEY.match(sk):
            pr = int(k.group(1))
            head = full_head.get((pr, k.group(2)[:12])) or head_at(pr, ts(j.get("created_at")) or start or end)
        elif (k := HV_KEY.match(sk)) or (k := RUN.search(ws)):
            pr, head = run_pr.get(int(k.group(1) or k.group(2)), (None, None))
        elif k := PULL.search(ws):
            pr = int(k.group(1))
            head = head_at(pr, ts(j.get("created_at")) or end)
        if pr is None:
            continue  # lane, base, scheduled: not a PR head's cost (ci140-class-minutes rows)
        items.append((pr, head, fleet_key(j), m, start or end, end, j.get("state"), "fleet"))

    fates = {}
    for it in items:
        if it[0] not in fates:
            fates[it[0]] = fate(it[0], prs, merged_in, merged_any, since, until)

    out = {"window": [a.since, a.until], "merged_prs": len(merged_in), "inferred_runs": inferred, "runs": len(runs)}
    per = lambda v: round(v / M, 2)

    # 1. fate
    by_fate = collections.Counter()
    by_fate_src = collections.Counter()
    for it in items:
        by_fate[fates[it[0]]] += it[3]
        by_fate_src[(fates[it[0]], it[7])] += it[3]
    out["fate"] = {f: {"min": round(v), "per_merged_pr": per(v), "gh": per(by_fate_src[(f, "gh")]),
                       "fleet": per(by_fate_src[(f, "fleet")])} for f, v in by_fate.most_common()}

    NOT_IN = lambda it: it[0] is not None and fates[it[0]] != "merged in window"
    ci_heads = collections.defaultdict(set)
    pr_min = collections.Counter()
    for it in items:
        if it[0] is not None:
            ci_heads[it[0]].add(it[1])
            pr_min[it[0]] += it[3]
    hb = collections.Counter()
    hb_prs = collections.Counter()
    hb_all = collections.Counter()
    hb_all_prs = collections.Counter()
    for pr, hs in ci_heads.items():
        b = heads_bucket(len(hs))
        hb_all[b] += pr_min[pr]
        hb_all_prs[b] += 1
        if fates[pr] != "merged in window":
            hb[b] += pr_min[pr]
            hb_prs[b] += 1
    order = ["1", "2-3", "4-9", "10-19", "20+"]
    out["heads_not_merged"] = {b: {"prs": hb_prs[b], "per_merged_pr": per(hb[b])} for b in order}
    out["heads_all_prs"] = {b: {"prs": hb_all_prs[b], "per_merged_pr": per(hb_all[b])} for b in order}
    by_job = collections.Counter()
    by_job_fate = collections.defaultdict(collections.Counter)
    for it in items:
        if NOT_IN(it):
            by_job[it[2]] += it[3]
            by_job_fate[it[2]][fates[it[0]]] += it[3]
    out["jobs_not_merged"] = [{"job": " / ".join(k), "per_merged_pr": per(v),
                               "by_fate": {f: per(x) for f, x in by_job_fate[k].most_common(3)}}
                              for k, v in by_job.most_common(a.top * 2)]
    all_job = collections.Counter()
    for it in items:
        if it[0] is not None:
            all_job[it[2]] += it[3]
    out["jobs_all_prs"] = [[" / ".join(k), per(v)] for k, v in all_job.most_common(a.top * 3)]
    top = sorted((pr for pr in pr_min if fates[pr] != "merged in window"), key=lambda p: -pr_min[p])
    out["top_prs_not_merged"] = [{"pr": p, "fate": fates[p], "heads": len(ci_heads[p]), "min": round(pr_min[p]),
                                  "per_merged_pr": per(pr_min[p]),
                                  "branch": (prs.get(p) or {}).get("headRefName")} for p in top[:a.top * 2]]
    out["prs_10plus_heads"] = sorted(([p, len(hs), fates[p], round(pr_min[p])] for p, hs in ci_heads.items()
                                      if len(hs) >= 10), key=lambda x: -x[1])

    # 3. superseded
    sup = collections.Counter()
    sup_full = collections.Counter()
    sup_job = collections.Counter()
    nxt_cache = {}
    for it in items:
        pr, head, key, m, start, end, concl, src = it
        if pr is None or head is None or concl == "cancelled":
            continue
        if (pr, head) not in nxt_cache:
            nxt_cache[(pr, head)] = next_push(pr, head)
        nxt = nxt_cache[(pr, head)]
        if nxt is None or end <= nxt:
            continue
        ov = (end - max(start, nxt)) / 60 if m else 0.0
        ov = min(ov, m)
        f = "merged in window" if fates[pr] == "merged in window" else "not merged in window"
        sup[(f, src)] += ov
        sup_job[key] += ov
        if start >= nxt:
            sup_full[f] += m
    out["superseded"] = {"per_merged_pr": per(sum(sup.values())),
                         "split": {f"{f} {s}": per(v) for (f, s), v in sup.most_common()},
                         "started_after_newer_push": {f: per(v) for f, v in sup_full.items()},
                         "by_job": [[" / ".join(k), per(v)] for k, v in sup_job.most_common(a.top)]}

    # 2. spent vs needed
    heads = {(it[0], it[1]) for it in items if it[0] is not None and it[1]}

    def diff(ph):
        pr, head = ph
        base = (prs.get(pr) or {}).get("baseRefName") or "feat-cmux-next"
        ref = f"origin/{base}" if base in BASES else (head_base.get(head) or "origin/feat-cmux-next")
        p = subprocess.run(["git", "-C", a.mirror, "diff", "--name-only", "--no-renames", "--merge-base", ref, head],
                           capture_output=True, text=True, env=dict(os.environ, GIT_NO_LAZY_FETCH="1"))
        fs = p.stdout.split() if p.returncode == 0 else None
        # a base merge: a 2-parent head whose second parent is already on the base (the PR took the base, no edit)
        par = git(a.mirror, "rev-list", "--parents", "-n1", head).split()
        bm = len(par) == 3 and subprocess.run(
            ["git", "-C", a.mirror, "merge-base", "--is-ancestor", par[2], ref],
            env=dict(os.environ, GIT_NO_LAZY_FETCH="1"), capture_output=True).returncode == 0
        who = ""
        if bm:  # who makes base merges: committer and the subject with numbers and shas folded
            who = git(a.mirror, "log", "-1", "--format=%cn: %s", head).strip()
            who = re.sub(r" into .*$", " into <branch>", re.sub(r"[0-9a-f]{7,40}|\d+", "N", who))[:90]
        return ph, fs, bm, who

    files, base_merge = {}, {}
    with cf.ThreadPoolExecutor(16) as ex:
        for ph, fs, bm, who in ex.map(diff, heads):
            files[ph] = fs
            if bm:
                base_merge[ph] = who

    rule_cache = {}

    def rule_for(key):
        if key not in rule_cache:
            rule_cache[key] = next(((wf, paths, also, src) for wf, job, paths, also, src in rules
                                    if fnmatch.fnmatchcase(key[0], wf) and job.search(key[1])), None)
        return rule_cache[key]

    spent = collections.Counter()
    need = collections.Counter()
    waste_job = collections.Counter()
    waste_kind = collections.defaultdict(collections.Counter)
    norule = collections.Counter()
    head_rows = collections.defaultdict(lambda: [0.0, 0.0])
    unknown = 0.0
    match_cache = {}
    bm_min, bm_unneeded, bm_who = collections.Counter(), collections.Counter(), collections.Counter()
    for it in items:
        pr, head, key, m, *_ = it
        if pr is None:
            continue
        f = "merged in window" if fates[pr] == "merged in window" else "not merged in window"
        spent[f] += m
        fs = files.get((pr, head))
        rule = rule_for(key)
        if rule is None:
            norule[key] += m
            ok = True
        elif not fs:
            unknown += m
            ok = True
        else:
            ck = (pr, head, id(rule))
            if ck not in match_cache:
                match_cache[ck] = touches(fs, rule[1]) and (not rule[2] or touches(fs, rule[2]))
            ok = match_cache[ck]
        head_rows[(pr, head)][0] += m
        if (pr, head) in base_merge:
            bm_min[(f, it[7])] += m
            bm_who[base_merge[(pr, head)]] += m
            if not ok:
                bm_unneeded[f] += m
        if ok:
            need[f] += m
            head_rows[(pr, head)][1] += m
        else:
            waste_job[key] += m
            waste_kind[key][head_kind(fs)] += m
    out["need"] = {f: {"spent": per(spent[f]), "needed": per(need[f]),
                       "ratio": round(spent[f] / need[f], 2) if need[f] else None} for f in spent}
    S, N = sum(spent.values()), sum(need.values())
    out["need_total"] = {"spent": per(S), "needed": per(N), "ratio": round(S / N, 2) if N else None,
                         "heads": len(heads), "heads_without_diff": sum(1 for v in files.values() if not v),
                         "no_diff_min_per_merged_pr": per(unknown)}
    out["base_merge_heads"] = {"heads": len(base_merge), "of_heads": len(heads),
                               "spent": {f"{f} {src}": per(v) for (f, src), v in bm_min.most_common()},
                               "unneeded": {f: per(v) for f, v in bm_unneeded.items()},
                               "by_commit": [[w, per(v)] for w, v in bm_who.most_common(8)]}
    out["unneeded_jobs"] = [{"job": " / ".join(k), "per_merged_pr": per(v),
                             "head_kinds": {hk: per(x) for hk, x in waste_kind[k].most_common(4)}}
                            for k, v in waste_job.most_common(a.top * 2)]
    out["no_rule_jobs"] = [[" / ".join(k), per(v)] for k, v in norule.most_common(a.top)]
    worst = sorted(head_rows.items(), key=lambda kv: -(kv[1][0] - kv[1][1]))[:a.top]
    out["top_heads_unneeded"] = [{"pr": pr, "head": (h or "")[:12], "spent": round(s), "needed": round(n),
                                  "fate": fates[pr]} for (pr, h), (s, n) in worst]
    dist = collections.Counter()
    for (s, n) in head_rows.values():
        r = n / s if s else 1
        dist["needed 100%" if r >= 0.999 else "50-99%" if r >= 0.5 else "1-49%" if r > 0 else "0%"] += s
    out["heads_by_needed_share"] = {k: per(v) for k, v in dist.items()}

    if a.json_out:
        json.dump(out, open(a.json_out, "w"), indent=1)
    report(out, M)


def head_kind(fs):
    """docs-only, web-only, rust-only, swift-only, tools-only, mixed: what a head that did not need a job touched."""
    if not fs:
        return "no diff"
    kinds = set()
    for f in fs:
        if f.endswith((".md", ".txt")) or f.startswith(("docs/", "rfd/", "rfds/")):
            kinds.add("docs")
        elif any(globmatch(f, g) for g in WEB):
            kinds.add("web")
        elif any(globmatch(f, g) for g in RUST):
            kinds.add("rust")
        elif any(globmatch(f, g) for g in SWIFT):
            kinds.add("swift")
        elif any(globmatch(f, g) for g in CI_SELF):
            kinds.add("ci")
        else:
            kinds.add("tools/other")
    return "+".join(sorted(kinds)) + ("-only" if len(kinds) == 1 else "")


