#!/usr/bin/env python3
"""ci140-input-hash-repeats: CI minutes spent on job runs whose inputs were byte-identical to an earlier green run
of the same job (goal ci-min-per-pr-140). Measurement only: reads, changes no CI behavior.

  ci140-input-hash-repeats fetch-fleet --hq-data DIR --since ISO --until ISO --out FLEET.jsonl.gz
  ci140-input-hash-repeats measure --hq-data DIR --mirror GIT --repo CHECKOUT --records RECS.jsonl.gz \\
        --fleet FLEET.jsonl.gz --since ISO --until ISO [--json-out F] [--md-out F]

--hq-data is cmuxterm-hq build-fleet/data (ci_per_pr.py, ci_minutes.py, ci-cuts.json; fleet_client.py from
build-fleet/ beside them). RECS is `ci_per_pr.py --save` output, FLEET is `fetch-fleet` output (the meter's slim
fleet record plus `ref`, `source_digest`, `args`). The window must start at or after the first record that carries
a head `sha` (controller feed, 2026-11-26T21:30Z); earlier GitHub records have no sha and cannot be hashed.

Method. A job is (workflow file, job name) for a GitHub job, (step, ...) for a fleet job. Its inputs are the path
globs CI already declares: pr_router.json `affects` (else `paths`) of the callee workflow; the union of the step
table's `inputs` for a pr-pipeline.yml table job (any step without inputs makes it the whole tree); else the
workflow's own `on.pull_request|push.paths`; else the whole tree (stated per job as `basis`). The job's own workflow
file is added. A run's hash is sha256 over the sorted (path, blob id) of the head SHA's tree entries matching those
globs; for the whole tree it is the tree id (or `ref:<sha>` when the commit is not in the mirror). A run is a repeat
when a green run of the same job with the same hash finished before it started (any head or PR). Minutes: GitHub
job seconds, fleet started_at..updated_at, as the hq meter counts them.
"""
from __future__ import annotations

import argparse
import collections
import datetime as dt
import gzip
import hashlib
import json
import multiprocessing
import os
import re
import subprocess
import sys
from pathlib import Path

WHOLE = ("**",)
SHA40 = re.compile(r"^[0-9a-f]{40}$")
ENV = dict(os.environ, GIT_NO_LAZY_FETCH="1")


def git(mirror, *args, inp=None):
    p = subprocess.run(["git", "-C", mirror, *args], input=inp, capture_output=True, env=ENV)
    return p.stdout if p.returncode == 0 else b""


def load_meter(hq: str):
    sys.path.insert(0, hq)
    sys.path.insert(0, os.path.dirname(hq.rstrip("/")))
    import ci_per_pr as P  # noqa: E402
    return P


# ---- glob matching (ci_steps.glob_pattern semantics: ** crosses '/', * and ? do not; later `!glob` wins) ----
def glob_re(glob: str) -> re.Pattern:
    out, i = [], 0
    while i < len(glob):
        if glob.startswith("**/", i):
            out.append("(?:.*/)?"); i += 3
        elif glob.startswith("**", i):
            out.append(".*"); i += 2
        elif glob[i] == "*":
            out.append("[^/]*"); i += 1
        elif glob[i] == "?":
            out.append("[^/]"); i += 1
        else:
            out.append(re.escape(glob[i])); i += 1
    return re.compile("".join(out) + r"\Z")


def compile_spec(globs):
    pos = [glob_re(g) for g in globs if not g.startswith("!")]
    ordered = [(g.startswith("!"), glob_re(g.lstrip("!"))) for g in reversed(globs)]
    anyneg = any(g.startswith("!") for g in globs)
    big = re.compile("|".join("(?:%s)" % p.pattern[:-2] for p in pos) + r"\Z") if pos else None
    return big, ordered, anyneg


def admitted(c, path):
    big, ordered, anyneg = c
    if big is None or not big.match(path):
        return False
    if not anyneg:
        return True
    for neg, rx in ordered:
        if rx.match(path):
            return not neg
    return False


# ---- hashing (worker processes) ----
def hash_task(task):
    mirror, sha, specs = task
    out = {}
    tree = git(mirror, "rev-parse", "--verify", "-q", sha + "^{tree}").decode().strip()
    if not tree:
        return sha, None
    listing = None
    for spec in specs:
        if spec == WHOLE:
            out[spec] = "tree:" + tree
            continue
        if listing is None:
            raw = git(mirror, "ls-tree", "-r", "-z", "--full-tree", sha)
            listing = []
            for ent in raw.split(b"\0"):
                if ent:
                    meta, path = ent.split(b"\t", 1)
                    listing.append((path.decode("utf-8", "replace"), meta.split()[2].decode()))
        c = compile_spec(spec)
        h = hashlib.sha256()
        for path, oid in sorted(listing):
            if admitted(c, path):
                h.update(f"{path}\0{oid}\n".encode())
        out[spec] = "in:" + h.hexdigest()[:24]
    return sha, out


# ---- what CI declares ----
class Declared:
    def __init__(self, repo: str):
        self.repo = Path(repo)
        sys.path.insert(0, str(self.repo / "scripts/ci"))
        import ci_steps  # noqa: E402
        self.table = ci_steps.load(ci_steps.TABLE)
        self.callees = json.loads((self.repo / "scripts/ci/pr_router.json").read_text())["callees"]
        self.callers = {}  # caller job name -> callee file
        cur, name = None, ""
        for line in (self.repo / ".github/workflows/pr-router.yml").read_text().splitlines():
            if m := re.match(r"^  ([A-Za-z0-9_-]+):\s*$", line):
                cur, name = m.group(1), ""
            elif cur and (m := re.match(r"^    name:\s*(.+?)\s*$", line)):
                name = m.group(1).strip("'\"")
            elif cur and name and (m := re.match(r"^    uses: \./\.github/workflows/([^\s@]+)\s*$", line)):
                self.callers[name] = m.group(1)
        self.cache = {}

    def workflow_on_paths(self, fname):
        try:
            import yaml
            doc = yaml.safe_load((self.repo / ".github/workflows" / fname).read_text())
            on = doc.get(True, doc.get("on")) or {}
        except Exception:  # noqa: BLE001
            return None
        if not isinstance(on, dict):
            return None
        for ev in ("pull_request", "push"):
            cfg = on.get(ev)
            if isinstance(cfg, dict) and cfg.get("paths"):
                return list(cfg["paths"])
        return None

    def spec(self, fname, job):
        """(globs tuple, basis) for workflow file FNAME's job JOB."""
        key = (fname, job if fname == "pr-pipeline.yml" else "")
        if key in self.cache:
            return self.cache[key]
        wf = f".github/workflows/{fname}"
        cfg = self.callees.get(fname)
        if fname == "pr-pipeline.yml" and job in self.table.jobs:
            steps = [s for s in self.table.steps.values() if s.job == job]
            if any(not s.inputs for s in steps):
                res = (WHOLE, "table job: a step has no inputs -> whole tree")
            else:
                g = sorted({i for s in steps for i in s.inputs} | {"ci/steps.toml", "ci/run", "scripts/ci/ci_steps.py"})
                res = (tuple(g) + (wf,), "table-union of step inputs")
        elif cfg and cfg.get("affects"):
            res = (tuple(cfg["affects"]) + (wf,), "router affects")
        elif cfg and cfg.get("paths"):
            res = (tuple(cfg["paths"]) + (wf,), "router paths")
        else:
            p = self.workflow_on_paths(fname)
            res = ((tuple(p) + (wf,), "workflow on.paths") if p else (WHOLE, "no declared inputs -> whole tree"))
        self.cache[key] = res
        return res

    def spec_for_file(self, fname):
        return self.spec(fname, "")


CLIPPY_JOB = re.compile(r"clippy \(changed", re.I)


def gh_identity(r, D: Declared):
    wf = os.path.basename(r.get("workflow_path") or "") or None
    job = r["job"]
    if wf == "pr-router.yml":
        for name, callee in D.callers.items():
            if job == name or job.startswith(name + " / "):
                wf, job = callee, (job[len(name) + 3:] if job != name else name)
                break
    wf = wf or ("name:" + r.get("workflow", "?"))
    return wf, job


def parse_iso(t):
    return dt.datetime.fromisoformat(t.replace("Z", "+00:00")).timestamp()


def fleet_parse(j, P, D: Declared):
    """(job key, sha-or-None, spec globs, basis, carry tag) for a controller job."""
    sk = j.get("step_key") or ""
    tag = j.get("tag") or ""
    m = re.match(r"^rc-(\d+)-([0-9a-f]{12})-(.+?)(?:-r\d+)?$", sk)
    if m:
        step = m.group(3)
        wf = {"clippy-changed": "cmux-tui-spec.yml", "react-doctor": "cmux-next-react-doctor.yml"}.get(step)
        g, b = D.spec_for_file(wf) if wf else (WHOLE, "no declared inputs -> whole tree")
        return ("fleet:rc:" + step), m.group(2), g, b, ("clippy carry" if step == "clippy-changed" else "")
    m = re.match(r"^hv-\d+-([0-9a-f]{12})$", sk)
    if m:
        g, b = D.spec_for_file("cmux-next-hot-verify.yml")
        return "fleet:hot-verify", m.group(1), g, b, ""
    m = re.match(r"^opportunistic-advisory-(.+)-(\d+)-([0-9a-f]{40})-\d+-\d+$", sk)
    if m:
        wf = m.group(1) + ".yml"
        g, b = D.spec_for_file(wf) if (D.repo / ".github/workflows" / wf).exists() else (WHOLE, "no declared inputs -> whole tree")
        return "fleet:advisory:" + m.group(1), m.group(3), g, b, ""
    m = re.search(r"-([0-9a-f]{8})$", tag)
    ref = j.get("ref") or j.get("source_digest") or ""
    sha = ref if SHA40.match(ref) else (m.group(1) if m else None)
    ident = "fleet:" + (j.get("kind") or "?") + ":" + (j.get("script") or re.sub(r"-[0-9a-f]{8}$", "", tag))
    args = j.get("args")
    if args and not (j.get("kind") == "ci-step" and sk.startswith("opportunistic")):
        ident += " " + " ".join(map(str, args))[:80]
    return ident, sha, WHOLE, "no declared inputs -> whole tree", ""


def measure(a):
    P = load_meter(a.hq_data)
    import ci_minutes  # noqa: E402
    D = Declared(a.repo)
    since, until = P.parse_time(a.since), P.parse_time(a.until)
    runs = []  # dict(key, sha, spec, basis, carry, min, start, end, green, branch, kind)
    unhash = collections.Counter()
    tot_min = collections.Counter()
    for line in gzip.open(a.records, "rt"):
        r = json.loads(line)
        end = P.stamp(r)
        if not (since <= end < until):
            continue
        mins = r["seconds"] / 60
        tot_min["github"] += mins
        if not r.get("sha"):
            unhash["github no sha"] += mins
            continue
        wf, job = gh_identity(r, D)
        g, basis = D.spec(wf, job) if not wf.startswith("name:") else (WHOLE, "no declared inputs -> whole tree")
        carry = ""
        if wf in D.callers.values() or wf == "pr-pipeline.yml":
            carry = "rerun carry (router callee/table job)"
        if wf == "cmux-next-compile-preflight.yml":
            carry = "preflight cache"
        if CLIPPY_JOB.search(job):
            carry = "clippy carry"
        runs.append(dict(key=f"gh:{wf}:{job}", sha=r["sha"], spec=g, basis=basis, carry=carry, min=mins,
                         start=end - r["seconds"], end=end, green=r["conclusion"] == "success",
                         branch=r.get("branch") or "", src="github", run=r["run"]))
    # run id -> sha, for fleet jobs submitted from a run
    run_sha = {x["run"]: x["sha"] for x in runs}
    for line in gzip.open(a.fleet, "rt"):
        j = json.loads(line)
        if P.fleet_class(j) not in P.FLEET_PER_PR:
            continue
        end = P.ts(j.get("updated_at"))
        if end is None or not (since <= end < until):
            continue
        st = P.ts(j.get("started_at"))
        mins = (end - st) / 60 if st is not None and j.get("worker") and end > st else 0.0
        tot_min["fleet"] += mins
        if mins <= 0:
            continue
        key, sha, g, basis, carry = fleet_parse(j, P, D)
        rid = P.fleet_run_id(j)
        if not sha and rid in run_sha:
            sha = run_sha[rid]
        if not sha:
            unhash["fleet no sha/ref"] += mins
            continue
        runs.append(dict(key=key, sha=sha, spec=g, basis=basis, carry=carry, min=mins, start=st, end=end,
                         green=j.get("state") == "done" and j.get("exit_code", 0) in (0, None),
                         branch=j.get("workspace") or "", src="fleet", run=rid or 0))
    # resolve abbreviated shas
    short = {x["sha"] for x in runs if len(x["sha"]) < 40}
    full = {}
    if short:
        out = git(a.mirror, "rev-parse", "--verify", "-q", *[]) if False else b""
        for s in short:
            f = git(a.mirror, "rev-parse", "--verify", "-q", s + "^{commit}").decode().strip()
            if f:
                full[s] = f
    for x in runs:
        x["sha"] = full.get(x["sha"], x["sha"])
    # hash per head
    need = collections.defaultdict(set)
    for x in runs:
        need[x["sha"]].add(x["spec"])
    tasks = [(a.mirror, s, sorted(sp)) for s, sp in need.items() if SHA40.match(s)]
    hashes = {}
    with multiprocessing.Pool(a.procs) as pool:
        for n, (sha, out) in enumerate(pool.imap_unordered(hash_task, tasks, chunksize=8)):
            hashes[sha] = out
            if n % 1000 == 0:
                print(f"hashed {n}/{len(tasks)} heads", file=sys.stderr)
    kept = []
    for x in runs:
        h = (hashes.get(x["sha"]) or {}).get(x["spec"])
        if h is None:
            h = "ref:" + x["sha"] if x["spec"] == WHOLE else None
        if h is None:
            unhash["head not in mirror"] += x["min"]
            continue
        x["hash"] = h
        kept.append(x)
    # previous head per branch (order of first record)
    first = {}
    for x in kept:
        if x["src"] == "github" and x["branch"]:
            first[(x["branch"], x["sha"])] = min(first.get((x["branch"], x["sha"]), 1e18), x["start"])
    order = collections.defaultdict(list)
    for (b, s), t in first.items():
        order[b].append((t, s))
    prev = {}
    for b, lst in order.items():
        lst.sort()
        for i in range(1, len(lst)):
            prev[(b, lst[i][1])] = lst[i - 1][1]
    # repeats
    kept.sort(key=lambda x: x["start"])
    greens = collections.defaultdict(list)  # (key,hash) -> [(end, run)]
    for x in kept:
        x["repeat"] = None
        for e, y in greens.get((x["key"], x["hash"]), ()):
            if e <= x["start"]:
                x["repeat"] = y
                break
        if x["green"]:
            greens[(x["key"], x["hash"])].append((x["end"], x))
            greens[(x["key"], x["hash"])].sort(key=lambda t: t[0])
    merged = ci_minutes.merged_prs(a.mirror, since, until)
    npr = len(merged)
    rows = collections.defaultdict(lambda: dict(runs=0, min=0.0, rep_runs=0, rep_min=0.0, rel=collections.Counter(),
                                                basis="", carry=""))
    rel_tot = collections.Counter()
    basis_tot = collections.Counter()
    for x in kept:
        r = rows[x["key"]]
        r["runs"] += 1; r["min"] += x["min"]; r["basis"] = x["basis"]; r["carry"] = x["carry"]
        y = x["repeat"]
        if y:
            if y["sha"] == x["sha"]:
                rel = "same head (rerun / duplicate run)"
            elif x["src"] == "github" and prev.get((x["branch"], x["sha"])) == y["sha"] and y["branch"] == x["branch"]:
                rel = "same PR, previous head"
            elif y["branch"] == x["branch"] and x["branch"]:
                rel = "same PR, earlier head"
            else:
                rel = "other PR / base"
            r["rep_runs"] += 1; r["rep_min"] += x["min"]; r["rel"][rel] += x["min"]
            rel_tot[rel] += x["min"]
            basis_tot[x["basis"].split(" ->")[0].split(" of")[0]] += x["min"]
    rep_total = sum(r["rep_min"] for r in rows.values())
    top = sorted(rows.items(), key=lambda kv: -kv[1]["rep_min"])[:a.top]
    res = dict(window=[a.since, a.until], merged_prs=npr, meter_min=dict(tot_min),
               meter_min_per_merged_pr=round(sum(tot_min.values()) / npr, 1) if npr else None,
               unhashable_min=dict(unhash), hashed_min=round(sum(x["min"] for x in kept)),
               hashed_runs=len(kept), heads_hashed=len(tasks),
               repeat_runs=sum(1 for x in kept if x["repeat"]), repeat_min=round(rep_total),
               repeat_min_per_merged_pr=round(rep_total / npr, 2) if npr else None,
               repeat_min_by_relation={k: round(v) for k, v in rel_tot.most_common()},
               repeat_min_by_basis={k: round(v) for k, v in basis_tot.most_common()},
               top=[dict(job=k, runs=v["runs"], min=round(v["min"]), repeat_runs=v["rep_runs"],
                         repeat_min=round(v["rep_min"]), per_merged_pr=round(v["rep_min"] / npr, 2),
                         by_relation={a_: round(b_) for a_, b_ in v["rel"].most_common()}, basis=v["basis"],
                         carry_scope=v["carry"]) for k, v in top])
    if a.json_out:
        Path(a.json_out).write_text(json.dumps(res, indent=1))
    md = [f"# input-hash repeats {a.since}..{a.until}", "",
          f"merged PRs {npr}; meter minutes {round(sum(tot_min.values()))} ({res['meter_min_per_merged_pr']}/PR); "
          f"hashed {res['hashed_min']} min in {len(kept)} runs; unhashable {dict((k, round(v)) for k, v in unhash.items())}",
          f"**repeat minutes {res['repeat_min']} = {res['repeat_min_per_merged_pr']} per merged PR** "
          f"({res['repeat_runs']} runs)", "", "by relation to the earlier green run: " + json.dumps(res["repeat_min_by_relation"]),
          "by input basis: " + json.dumps(res["repeat_min_by_basis"]), "",
          "| job | runs | min | repeat runs | repeat min | per PR | relation | basis | carry scope |", "|---|---|---|---|---|---|---|---|---|"]
    for t in res["top"]:
        md.append(f"| `{t['job']}` | {t['runs']} | {t['min']} | {t['repeat_runs']} | {t['repeat_min']} | {t['per_merged_pr']} | "
                  f"{json.dumps(t['by_relation'])} | {t['basis']} | {t['carry_scope']} |")
    text = "\n".join(md)
    if a.md_out:
        Path(a.md_out).write_text(text)
    print(text)


def fetch_fleet(a):
    P = load_meter(a.hq_data)
    since, until = P.parse_time(a.since), P.parse_time(a.until)
    keep = P.FLEET_SCHEMA_FIELDS + ("ref", "source_digest", "args", "exit_code")
    n = 0
    with gzip.open(a.out, "wt") as o:
        for j in P.fetch_fleet(since, until):
            if j.get("state") not in P.FLEET_TERMINAL:
                continue
            e = P.ts(j.get("updated_at"))
            if e is None or not (since <= e < until):
                continue
            o.write(json.dumps({k: j[k] for k in keep if j.get(k) not in (None, "", [])}) + "\n")
            n += 1
    print(n, "fleet jobs")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    f = sub.add_parser("fetch-fleet")
    f.add_argument("--hq-data", required=True); f.add_argument("--since", required=True)
    f.add_argument("--until", required=True); f.add_argument("--out", required=True)
    m = sub.add_parser("measure")
    for k in ("hq-data", "mirror", "repo", "records", "fleet", "since", "until"):
        m.add_argument("--" + k, required=True)
    m.add_argument("--json-out"); m.add_argument("--md-out")
    m.add_argument("--top", type=int, default=10); m.add_argument("--procs", type=int, default=14)
    a = ap.parse_args()
    {"fetch-fleet": fetch_fleet, "measure": measure}[a.cmd](a)


if __name__ == "__main__":
    main()
