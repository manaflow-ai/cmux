#!/usr/bin/env bash
# Stand-in gh for scripts/measure/agent-quota.sh (the agent-quota bench): one pull request (octo/app#7, head $HEAD) whose one CI
# check finishes CI_SECONDS after the bench started. Every invocation that would reach GitHub
# is logged to $BENCH/calls.log; a --watch refresh counts as one call each.
BENCH=${BENCH:?}
HEAD=4f2c9a1e8b7d6c5f4e3d2c1b0a9f8e7d6c5b4a39
START=$(cat "$BENCH/start")
CI_SECONDS=${CI_SECONDS:-300}
log() { printf '%s %s\n' "$(date +%s)" "$*" >> "$BENCH/calls.log"; }
free() { printf '%s FREE %s\n' "$(date +%s)" "$*" >> "$BENCH/calls.log"; }
done_now() { [ $(( $(date +%s) - START )) -ge "$CI_SECONDS" ]; }
rollup() {
  if done_now; then
    echo '[{"__typename":"CheckRun","name":"test","status":"COMPLETED","conclusion":"SUCCESS","startedAt":"2026-11-18T10:00:00Z","completedAt":"2026-11-18T10:05:00Z","detailsUrl":"https://github.com/octo/app/actions/runs/99/job/1"}]'
  else
    echo '[{"__typename":"CheckRun","name":"test","status":"IN_PROGRESS","conclusion":"","startedAt":"2026-11-18T10:00:00Z","completedAt":null,"detailsUrl":"https://github.com/octo/app/actions/runs/99/job/1"}]'
  fi
}
checks_table() {
  if done_now; then printf 'test\tpass\t5m0s\thttps://github.com/octo/app/actions/runs/99/job/1\n'; return 0
  else printf 'test\tpending\t0\thttps://github.com/octo/app/actions/runs/99/job/1\n'; return 8; fi
}
interval_of() { local i=10; while [ $# -gt 0 ]; do case "$1" in -i|--interval) i=$2; shift;; --interval=*) i=${1#*=};; esac; shift; done; echo "$i"; }
pr_json() {
  local state=OPEN
  printf '{"number":7,"url":"https://github.com/octo/app/pull/7","state":"%s","title":"Fix the parser","headRefOid":"%s","headRefName":"fix-parser","baseRefName":"main","mergeable":"MERGEABLE","mergedAt":null,"mergeCommit":null,"isDraft":false,"labels":[],"body":"","comments":[],"reviewDecision":"","statusCheckRollup":%s}\n' "$state" "$HEAD" "$(rollup)"
}
run_json() {
  if done_now; then printf '{"databaseId":99,"status":"completed","conclusion":"success","headSha":"%s","name":"CI","workflowName":"CI","url":"https://github.com/octo/app/actions/runs/99","jobs":[{"name":"test","status":"completed","conclusion":"success"}]}' "$HEAD"
  else printf '{"databaseId":99,"status":"in_progress","conclusion":"","headSha":"%s","name":"CI","workflowName":"CI","url":"https://github.com/octo/app/actions/runs/99","jobs":[{"name":"test","status":"in_progress","conclusion":""}]}' "$HEAD"; fi
}
jqf() { local f=""; while [ $# -gt 0 ]; do case "$1" in -q|--jq) f=$2; shift;; esac; shift; done; if [ -n "$f" ]; then jq -r "$f"; else cat; fi; }
case "$1 $2" in
  "auth status") free "$*"; echo "github.com: Logged in to github.com account bench"; exit 0;;
  "api rate_limit"|"api /rate_limit") free "$*"; echo "{\"resources\":{\"core\":{\"limit\":5000,\"remaining\":4000,\"reset\":$(( $(date +%s)+3000 ))},\"graphql\":{\"limit\":5000,\"remaining\":4000,\"reset\":$(( $(date +%s)+3000 ))}}}" | jqf "$@"; exit 0;;
  "pr view") log "$*"; pr_json | jqf "$@"; exit 0;;
  "pr status") log "$*"; echo "Current branch: #7 Fix the parser [fix-parser]"; checks_table; exit 0;;
  "pr checks")
    if printf '%s\n' "$@" | grep -qx -- '--watch'; then
      i=$(interval_of "$@")
      while :; do log "$* (watch refresh)"; if done_now; then checks_table; exit 0; fi; sleep "$i"; done
    fi
    log "$*"
    if printf '%s\n' "$@" | grep -qx -- '--json'; then
      if done_now; then echo '[{"name":"test","state":"SUCCESS","bucket":"pass","link":"https://github.com/octo/app/actions/runs/99/job/1"}]'; else echo '[{"name":"test","state":"IN_PROGRESS","bucket":"pending","link":"https://github.com/octo/app/actions/runs/99/job/1"}]'; fi | jqf "$@"; done_now; exit $(( $? ? 8 : 0 ))
    fi
    checks_table; exit $?;;
  "run list") log "$*"; echo "[$(run_json)]" | jqf "$@"; exit 0;;
  "run view") log "$*"; if printf '%s\n' "$@" | grep -qx -- '--json'; then run_json | jqf "$@"; else run_json | jq -r '"CI \(.status) \(.conclusion)"'; fi; exit 0;;
  "run watch")
    i=$(interval_of "$@"); [ "$i" = 10 ] && i=3
    while :; do log "$* (watch refresh)"; if done_now; then echo "Run CI (99) completed with 'success'"; exit 0; fi; sleep "$i"; done;;
  api*) log "$*"
    case "$2" in
      *check-runs*) if done_now; then c=success; s=completed; else c=null; s=in_progress; fi; echo "{\"total_count\":1,\"check_runs\":[{\"name\":\"test\",\"status\":\"$s\",\"conclusion\":\"$c\"}]}" | jqf "$@";;
      *pulls/7*) echo "{\"number\":7,\"state\":\"open\",\"head\":{\"sha\":\"$HEAD\"}}" | jqf "$@";;
      *actions/runs*) echo "{\"workflow_runs\":[$(run_json)]}" | jqf "$@";;
      *) echo '{}';;
    esac; exit 0;;
  *) log "$* (unsupported)"; echo "gh (bench): $1 $2 is not simulated here" >&2; exit 1;;
esac
