#!/bin/bash
# cmux pre-commit hook
# Installed by ./scripts/setup.sh as a clone-local copy outside the checkout.
# Normalizes cmux.xcodeproj/project.pbxproj when staged so Xcode's
# nondeterministic section reordering never reaches a commit.
set -euo pipefail

HOOK_DIR="$(cd "${BASH_SOURCE[0]%/*}" && pwd -P)"
PYTHON_PATH_FILE="$HOOK_DIR/python3-path"
if [[ ! -r "$PYTHON_PATH_FILE" ]] || ! IFS= read -r PYTHON3_BIN < "$PYTHON_PATH_FILE" \
    || [[ "$PYTHON3_BIN" != /* ]] || [[ ! -x "$PYTHON3_BIN" ]]; then
    echo "pre-commit: trusted Python interpreter metadata is missing or invalid; rerun scripts/install-git-hooks.sh." >&2
    exit 1
fi
REGISTRY_VALIDATOR="$HOOK_DIR/validate_test_execution_registry.py"
PBX_NORMALIZER="$HOOK_DIR/normalize-pbxproj.py"
if [[ ! -f "$REGISTRY_VALIDATOR" || ! -f "$PBX_NORMALIZER" ]]; then
    echo "pre-commit: trusted helper copies are missing; rerun scripts/install-git-hooks.sh." >&2
    exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
PBXPROJ="cmux.xcodeproj/project.pbxproj"

cd "$REPO_ROOT"

# Register new Python tests that a workflow already runs, so adding a test and
# its ci-guards.yml step is all a commit needs. Best effort: CI still validates.
# Only this commit's tests: the ones it adds, and the ones its workflow changes
# name. Registering every unregistered test the base carries wrote the same
# entries into every pull request, which then conflicted (#21946).
REGISTRY="tests/test-execution.toml"
if git diff --cached --name-only --diff-filter=ACMRT | grep -Eq '^(tests/test_[^/]+\.py|\.github/workflows/.+)$' \
    && git diff --quiet -- "$REGISTRY"; then
    OWN_TESTS=()
    while IFS= read -r test_path; do
        [[ -n "$test_path" ]] && OWN_TESTS+=(--only "$test_path")
    done < <(
        {
            git diff --cached --name-only --diff-filter=A -- 'tests/test_*.py'
            git diff --cached -U0 -- .github/workflows | grep -E '^\+' | grep -oE 'tests/test_[A-Za-z0-9_]+\.py' || true
        } | sort -u
    )
    if (( ${#OWN_TESTS[@]} > 0 )); then
        "$PYTHON3_BIN" -I "$REGISTRY_VALIDATOR" --repo-root "$REPO_ROOT" --write "${OWN_TESTS[@]}" >/dev/null 2>&1 || true
    fi
    if ! git diff --quiet -- "$REGISTRY"; then
        git add "$REGISTRY"
        echo "pre-commit: registered new tests in $REGISTRY"
    fi
fi

# A merge commit combines base-owned files with the staged result. Do not
# reformat that result while Git is resolving the merge; formatters run on the
# authored files in the follow-up commit instead.
MERGE_HEAD_PATH="$(git rev-parse --git-path MERGE_HEAD)"
if [[ -f "$MERGE_HEAD_PATH" ]]; then
    echo "pre-commit: merge in progress; skipping formatters"
    exit 0
fi

# Only normalize when the pbxproj is part of this commit.
if git diff --cached --name-only --diff-filter=ACMRT | grep -Fxq "$PBXPROJ"; then
    # Refuse to normalize when the working-tree pbxproj has unstaged changes.
    # Otherwise the `git add` at the end would silently stage hunks the
    # user deliberately left out of this commit.
    if ! git diff --quiet -- "$PBXPROJ"; then
        echo "pre-commit: $PBXPROJ has unstaged changes; cannot safely normalize." >&2
        echo "Either stage the whole file (git add $PBXPROJ) or stash the unstaged hunks before committing." >&2
        exit 1
    fi

    "$PYTHON3_BIN" -I "$PBX_NORMALIZER" "$PBXPROJ"

    # If the normalizer rewrote the file, restage so the commit captures
    # the normalized form. (Working tree had no unstaged changes per the
    # guard above, so anything that changed is purely from normalization.)
    if ! git diff --quiet -- "$PBXPROJ"; then
        git add "$PBXPROJ"
    fi
fi

# A missing formatter is a hard failure for agents and CI, never a silent skip
# (lanes committed unformatted Rust and web code for days because rustfmt and
# vp were missing on the agent host). People get a warning instead. Codex
# shells set CODEX_CI and CODEX_THREAD_ID; Claude Code shells set CLAUDECODE.
REQUIRE_FORMATTERS=0
for var in CMUX_AGENT CMUX_REQUIRE_FORMATTERS CI CLAUDECODE CODEX_CI CODEX_THREAD_ID CODEX_SANDBOX; do
    if [[ -n "${!var:-}" && "${!var}" != 0 ]]; then
        REQUIRE_FORMATTERS=1
    fi
done
formatter_missing() { # message
    if (( REQUIRE_FORMATTERS )); then
        echo "pre-commit: $1" >&2
        echo "pre-commit: refusing to commit unformatted files (an agent or CI environment requires formatters; do not pass --no-verify)." >&2
        exit 1
    fi
    echo "pre-commit: $1; skipping (CI will check it)." >&2
}

# Keep the formatters on the fast path: only invoke them for files that are in
# this commit, and never build or inspect the rest of the checkout. A formatter
# rewrites its input in place, so refuse a file with unstaged edits rather than
# accidentally adding those edits to this commit.
STAGED_WEB_PATHS=()
STAGED_RUST_PATHS=()
STAGED_SWIFT_PATHS=()
while IFS= read -r -d '' path; do
    if ! git diff --quiet -- "$path"; then
        case "$path" in
            webviews/*|*.rs|*.swift)
                echo "pre-commit: $path has unstaged changes; stage or stash them before formatting." >&2
                exit 1
                ;;
        esac
    fi

    case "$path" in
        webviews/*)
            case "$path" in
                *.js|*.jsx|*.ts|*.tsx|*.mjs|*.cjs|*.mts|*.cts|*.css|*.scss|*.html|*.json|*.md|*.mdx)
                    STAGED_WEB_PATHS+=("${path#webviews/}")
                    ;;
            esac
            ;;
        *.rs)
            STAGED_RUST_PATHS+=("$path")
            ;;
        *.swift)
            STAGED_SWIFT_PATHS+=("$path")
            ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMRT -z)

if (( ${#STAGED_WEB_PATHS[@]} > 0 )); then
    # The checkout's own vp (vp fmt reads webviews/vite.config.ts, which needs
    # webviews' packages). Without them, install them: bun's cache makes that
    # about a second, and lifecycle scripts never run.
    VP_BIN="$REPO_ROOT/webviews/node_modules/.bin/vp"
    if [[ ! -x "$VP_BIN" ]] && command -v bun >/dev/null 2>&1; then
        echo "pre-commit: installing webviews packages for vp (bun install --frozen-lockfile --ignore-scripts)" >&2
        (cd "$REPO_ROOT/webviews" && bun install --frozen-lockfile --ignore-scripts >/dev/null 2>&1) || true
        # --ignore-scripts skips the postinstall that writes the pages' strings tables (build
        # output since #21946); write them so a later typecheck in this checkout finds them.
        (cd "$REPO_ROOT/webviews" && bun scripts/pages/gen-strings.mjs --best-effort >/dev/null 2>&1) || true
    fi
    if [[ ! -x "$VP_BIN" ]]; then
        formatter_missing "vp is unavailable (install bun, then run bun install in webviews)"
    else
        (
            cd "$REPO_ROOT/webviews"
            # A commit of only fmt-ignored files (webviews CSS) matches nothing.
            "$VP_BIN" fmt --no-error-on-unmatched-pattern "${STAGED_WEB_PATHS[@]}"
        )
        git add -- "${STAGED_WEB_PATHS[@]/#/webviews/}"
    fi
fi

# Rust: every staged .rs file is formatted as `cargo fmt` would, with its Cargo
# package's edition and the nearest rustfmt.toml above it inside the checkout.
# With none, an empty config pins rustfmt's defaults, so a stray rustfmt.toml
# above the checkout (rustfmt keeps searching up to /) never decides the
# format. Bash 3.2 compatible (macOS): no associative arrays.
rust_package_root() { # repository-relative path -> nearest directory with a [package] Cargo.toml
    local dir="${1%/*}"
    [[ "$dir" == "$1" ]] && dir=""
    while :; do
        if [[ -f "$REPO_ROOT/${dir:+$dir/}Cargo.toml" ]] && grep -q '^\[package\]' "$REPO_ROOT/${dir:+$dir/}Cargo.toml"; then
            echo "$dir"
            return 0
        fi
        [[ -z "$dir" ]] && return 1
        if [[ "$dir" == */* ]]; then dir="${dir%/*}"; else dir=""; fi
    done
}
rust_edition() { # package root -> its edition, following edition.workspace = true
    local manifest="$REPO_ROOT/${1:+$1/}Cargo.toml" dir="$1" edition
    edition="$(sed -nE 's/^edition[[:space:]]*=[[:space:]]*"([0-9]{4})".*/\1/p' "$manifest" | head -n 1)"
    if [[ -z "$edition" ]] && grep -qE '^edition([[:space:]]*\.[[:space:]]*workspace[[:space:]]*=[[:space:]]*true|[[:space:]]*=[[:space:]]*\{[[:space:]]*workspace[[:space:]]*=[[:space:]]*true)' "$manifest"; then
        while [[ -n "$dir" ]]; do
            if [[ "$dir" == */* ]]; then dir="${dir%/*}"; else dir=""; fi
            manifest="$REPO_ROOT/${dir:+$dir/}Cargo.toml"
            if [[ -f "$manifest" ]] && grep -q '^\[workspace\.package\]' "$manifest"; then
                edition="$(awk '/^\[/{section=$0} section=="[workspace.package]" && /^edition[[:space:]]*=/{gsub(/[^0-9]/,"",$0); print; exit}' "$manifest")"
                break
            fi
        done
    fi
    echo "${edition:-2015}"
}
rust_config() { # package root -> nearest rustfmt.toml or .rustfmt.toml at or above it in the checkout, or nothing
    local dir="$1"
    while :; do
        for name in rustfmt.toml .rustfmt.toml; do
            if [[ -f "$REPO_ROOT/${dir:+$dir/}$name" ]]; then
                echo "$REPO_ROOT/${dir:+$dir/}$name"
                return 0
            fi
        done
        [[ -z "$dir" ]] && return 0
        if [[ "$dir" == */* ]]; then dir="${dir%/*}"; else dir=""; fi
    done
}

if (( ${#STAGED_RUST_PATHS[@]} > 0 )); then
    # One "root<TAB>path" line per staged file inside a Cargo package; a .rs
    # file outside every package (a build script fixture, say) is left alone.
    RUST_ENTRIES=""
    for path in "${STAGED_RUST_PATHS[@]}"; do
        if package_root="$(rust_package_root "$path")"; then
            RUST_ENTRIES+="$package_root"$'\t'"$path"$'\n'
        fi
    done
    RUST_ROOTS="$(printf '%s' "$RUST_ENTRIES" | cut -f1 | sort -u)"
    # rustfmt can follow `mod` declarations from a staged module and rewrite
    # its children. Refuse that case within the affected Cargo package rather
    # than touching an unstaged Rust file in the worktree.
    while IFS= read -r package_root; do
        [[ -n "$RUST_ENTRIES" ]] || break
        if {
            git diff --name-only --diff-filter=ACMRT -- "${package_root:-.}"
            git ls-files --others --exclude-standard -- "${package_root:-.}"
        } | grep -Eq '\.rs$'; then
            echo "pre-commit: ${package_root:-.} has unstaged Rust edits; stage or stash them before formatting." >&2
            exit 1
        fi
    done <<<"$RUST_ROOTS"
    if [[ -n "$RUST_ENTRIES" ]]; then
        RUSTFMT_BIN="$(command -v rustfmt || true)"
        if [[ -z "$RUSTFMT_BIN" ]]; then
            formatter_missing "rustfmt is unavailable (rustup component add rustfmt, and put it on PATH)"
        else
            RUSTFMT_DEFAULTS="$(mktemp "${TMPDIR:-/tmp}/cmux-rustfmt-defaults.XXXXXX")"
            trap 'rm -f "$RUSTFMT_DEFAULTS"' EXIT
            while IFS= read -r package_root; do
                config="$(rust_config "$package_root")"
                RUSTFMT_ARGS=(--edition "$(rust_edition "$package_root")" --config-path "${config:-$RUSTFMT_DEFAULTS}")
                PACKAGE_PATHS=()
                while IFS=$'\t' read -r root path; do
                    [[ "$root" == "$package_root" ]] && PACKAGE_PATHS+=("$REPO_ROOT/$path")
                done <<<"$RUST_ENTRIES"
                "$RUSTFMT_BIN" "${RUSTFMT_ARGS[@]}" "${PACKAGE_PATHS[@]}"
                git add -- "${PACKAGE_PATHS[@]}"
            done <<<"$RUST_ROOTS"
        fi
    fi
fi

# cmux currently has no Swift-format configuration. Keep this branch ready for
# the day one is added without making a formatter a setup prerequisite today.
if (( ${#STAGED_SWIFT_PATHS[@]} > 0 )) && [[ -f "$REPO_ROOT/.swift-format" ]]; then
    SWIFT_FORMAT_BIN="$(command -v swift-format || true)"
    if [[ -z "$SWIFT_FORMAT_BIN" ]]; then
        formatter_missing "swift-format is unavailable"
    else
        for path in "${STAGED_SWIFT_PATHS[@]}"; do
            "$SWIFT_FORMAT_BIN" format --in-place --configuration "$REPO_ROOT/.swift-format" "$path"
            git add -- "$path"
        done
    fi
fi
