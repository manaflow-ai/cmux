#!/bin/bash
# cmux pre-commit hook
# Installed by ./scripts/setup.sh as a clone-local copy outside the checkout.
# Normalizes cmux.xcodeproj/project.pbxproj when staged so Xcode's
# nondeterministic section reordering never reaches a commit.
set -euo pipefail

HOOK_DIR="$(cd "${BASH_SOURCE[0]%/*}" && pwd -P)"
PYTHON_PATH_FILE="$HOOK_DIR/python3-path"
if [[ ! -r "$PYTHON_PATH_FILE" ]] || ! IFS= read -r PYTHON3_BIN < "$PYTHON_PATH_FILE" \
    || [[ "$PYTHON3_BIN" != /* ]] || [[ ! -x "$PYTHON3_BIN" ]]; then
    echo "pre-commit: trusted Python interpreter metadata is missing or invalid; rerun scripts/install-git-hooks.sh." >&2
    exit 1
fi
REGISTRY_VALIDATOR="$HOOK_DIR/validate_test_execution_registry.py"
PBX_NORMALIZER="$HOOK_DIR/normalize-pbxproj.py"
BUN_VERSION_READER="$HOOK_DIR/webviews_bun_version.py"
if [[ ! -f "$REGISTRY_VALIDATOR" || ! -f "$PBX_NORMALIZER" ]]; then
    echo "pre-commit: trusted helper copies are missing; rerun scripts/install-git-hooks.sh." >&2
    exit 1
fi

# Every program this hook runs is reached through one checked resolver, never
# by a bare name: a checkout that put its own rustup (or git, sed, env...) ahead
# on PATH ran it before anything was checked. The resolver takes a name through
# PATH's absolute entries only ('', '.' and other relative entries are skipped),
# or an absolute path, and prints it only when no place its lookup passes
# through lies inside this checkout (its work tree, its git directories and
# every worktree of the clone): not the directory it is found in, not any
# symlink hop (a link to a file or to a directory, followed one hop at a time),
# not its final target. A checkout link named git pointing at /bin/sh is
# refused like a checkout git: the link picks what runs and as which name. A
# tool from an install root (mise, asdf, ~/.bun) must also resolve inside that
# root. Otherwise it says why and prints nothing.
# Children look programs up by name too (npm's `#!/usr/bin/env node`, the
# registry helper's git): their PATH is one private directory of links to
# checked tools only (CHILD_TOOLS below), never a PATH directory, whose other
# entries nobody checked.
# The trusted interpreter the installer recorded is its only root of trust.
# tests/test_install_git_hooks.py parses this hook and fails on any command
# that is neither a shell builtin nor a resolved tool.
# Python free of single quotes: it is a single-quoted bash string.
TOOL_RESOLVER='
import os
import sys
import tempfile
import unicodedata

# The names children of the hook may look up on PATH. Each gets a link in the
# private PATH directory of the children when the resolver finds a checked one.
# Every other name on PATH gets a stub there, after them, that says it is not
# listed here and exits 127, so a child (by name, exec or shebang) that needs
# one more tool fails loudly with the fix. Add a tool with the child that needs it.
CHILD_TOOLS = (
    "git", "sed", "grep", "head", "cut", "sort", "awk", "cat", "mkdir", "mv", "rm", "find", "env",
    "mktemp", "tail", "sleep", "sh", "bash", "node", "npm", "npx", "bun", "bunx", "rustup", "rustfmt",
    "cargo", "python3", "dirname", "basename", "readlink", "realpath", "uname", "chmod", "ln", "cp",
    "tr", "xargs", "touch", "wc", "date", "id", "which", "tar", "gzip",
)
# The stubs for every other name, the second entry of the PATH children get.
NOT_LISTED = ".not-listed"


def real(path):
    return os.path.realpath(path)


def within(path, directory):
    return path == directory or path.startswith(directory.rstrip(os.sep) + os.sep)


def say(message):
    sys.stderr.write("pre-commit: " + message + "\n")


def first_line(path):
    try:
        with open(path) as handle:
            return handle.readline().strip()
    except OSError:
        return ""


def checkout_dirs(start):
    """The real work tree, git directories and every worktree of the clone, without running git."""
    found = []

    def add(path):
        if path and real(path) not in found:
            found.append(real(path))

    top = real(start)
    while not os.path.lexists(os.path.join(top, ".git")):
        parent = os.path.dirname(top)
        if parent == top:
            top = ""
            break
        top = parent
    git_dirs = [os.environ.get("GIT_DIR", "")]
    add(os.environ.get("GIT_WORK_TREE", ""))
    if top:
        add(top)
        dot_git = os.path.join(top, ".git")
        if os.path.isdir(dot_git):
            git_dirs.append(dot_git)
        elif first_line(dot_git).startswith("gitdir:"):
            git_dirs.append(os.path.join(top, first_line(dot_git)[len("gitdir:"):].strip()))
    for git_dir in filter(None, git_dirs):
        git_dir = real(git_dir)
        add(git_dir)
        common = first_line(os.path.join(git_dir, "commondir"))
        common = real(os.path.join(git_dir, common)) if common else git_dir
        add(common)
        if os.path.basename(common) == ".git":
            add(os.path.dirname(common))
        try:
            names = os.listdir(os.path.join(common, "worktrees"))
        except OSError:
            names = []
        for name in names:
            pointer = first_line(os.path.join(common, "worktrees", name, "gitdir"))
            if pointer:
                add(os.path.dirname(os.path.join(common, "worktrees", name, pointer)))
    return found


def trail(path):
    """Every place a lookup of an absolute path passes through: each symlink, at its real
    location, one hop at a time (links to directories and chains included), then the
    final target. None for a link loop or an unreadable link."""
    places = []
    pending = [part for part in path.split("/") if part]
    current = "/"
    hops = 0
    while pending:
        part = pending.pop(0)
        if part == ".":
            continue
        if part == "..":
            current = os.path.dirname(current)
            continue
        step = os.path.join(current, part)
        if os.path.islink(step):
            hops += 1
            if hops > 40:
                return None
            places.append(step)
            try:
                target = os.readlink(step)
            except OSError:
                return None
            if target.startswith("/"):
                current = "/"
            pending = [piece for piece in target.split("/") if piece] + pending
        else:
            current = step
    places.append(current)
    return places


def check(candidate, root, mode, dirs):
    """True when candidate may run; otherwise says why (unless it is simply absent)."""
    if not candidate.startswith("/"):
        say(f"{candidate} is not an absolute path; not running it.")
        return False
    if not os.path.exists(candidate):
        return False
    places = trail(candidate)
    if places is None:
        say(f"{candidate} is a symlink loop or an unreadable link; not running it.")
        return False
    resolved = places[-1]
    if not (os.path.isfile(resolved) and os.access(resolved, os.X_OK)):
        say(f"{candidate} is not an executable file; not running it.")
        return False
    if root or mode:
        root_real = real(root) if root else ""
        if not root_real or not within(resolved, root_real):
            say(f"{candidate} resolves to {resolved}, outside its install root {root_real}; not running it.")
            return False
    # A package install inside the checkout (its node_modules) is the one place
    # a tool may live inside it; the hook checks that git tracks nothing there.
    for place in places:
        if mode == "checkout-install" and within(place, root_real):
            continue
        for directory in dirs:
            if within(place, directory):
                say(f"{candidate} passes through {place}, inside this checkout ({directory}); not running it.")
                return False
    return True


def find(name, search_path, dirs):
    for entry in search_path.split(":"):
        if not entry.startswith("/"):
            if os.path.isfile(os.path.join(entry, name)) and os.access(os.path.join(entry, name), os.X_OK):
                label = entry or "(empty: the current directory)"
                say(f"PATH entry {label} is relative; not running {name} from it.")
            continue
        candidate = os.path.join(entry, name)
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK) and check(candidate, "", "", dirs):
            return candidate
    return ""


def child_path(search_path, dirs, found):
    """A new private directory (mode 0700, outside the checkout) of links to the checked
    CHILD_TOOLS: the only PATH children of the hook get."""
    for base in (tempfile.gettempdir(), "/tmp"):
        if base.startswith("/") and os.path.isdir(base) \
                and not any(within(real(base), directory) for directory in dirs):
            break
    else:
        say("no temporary directory outside this checkout for the PATH of its children; not committing.")
        sys.exit(1)
    plain(real(base))  # the directory name must reach bash whole, or nothing is made
    shims = real(tempfile.mkdtemp(prefix="cmux-pre-commit-path.", dir=base))
    linked = set()
    for name in CHILD_TOOLS:
        tool = found[name] if name in found else find(name, search_path, dirs)
        if tool:
            link(tool, shims, name)
            linked.add(name)
    # Two stubs, after the links: one for a name CHILD_TOOLS does not list, one
    # for a listed name with no copy the resolver accepts (none on PATH, or each
    # one inside this checkout). Each runs nothing from PATH: /bin/sh, its own
    # name, a message, 127. It covers a child running the name by name, by exec
    # and by a #!/usr/bin/env shebang alike.
    stubs = {}
    try:
        os.mkdir(os.path.join(shims, ".stub"))
        for kind, message in (
            ("not-listed", "${0##*/} isn\x27t in CHILD_TOOLS (scripts/git-hooks/pre-commit); a child of the hook"
                           " ran it by name. Add it there, with the reason."),
            ("unresolved", "${0##*/} is in CHILD_TOOLS (scripts/git-hooks/pre-commit), but PATH has no copy of it"
                           " outside this checkout; a child of the hook ran it by name."),
        ):
            stubs[kind] = os.path.join(shims, ".stub", kind)
            with open(stubs[kind], "w") as handle:
                handle.write("#!/bin/sh\necho \"pre-commit: " + message + "\" >&2\nexit 127\n")
            os.chmod(stubs[kind], 0o755)
        os.mkdir(os.path.join(shims, NOT_LISTED))
    except OSError as error:
        say(f"could not make the stubs in {shims}: {error}; not committing.")
        sys.exit(1)
    # Every executable file on PATH, whatever its name (.hidden-tool too):
    # whether a name runs is up to the file, so that alone decides.
    names = set()
    for entry in search_path.split(":"):
        if entry.startswith("/"):
            try:
                listed = os.listdir(entry)
            except OSError:
                continue
            for name in listed:
                path = os.path.join(entry, name)
                if name not in (".", "..") and os.path.isfile(path) and os.access(path, os.X_OK):
                    names.add(name)
    # One stub per name as a case- and normalization-insensitive volume (the
    # macOS default for the temporary directory) sees it: Probe and probe, or
    # the same name in two PATH directories, are one file there. A listed name
    # comes first, so NODE on PATH never takes the stub of a listed node.
    taken = set()
    for name in sorted(set(CHILD_TOOLS).difference(linked)) + sorted(names.difference(CHILD_TOOLS)):
        if "/" in name or folded(name) in taken:
            continue
        taken.add(folded(name))
        link(stubs["unresolved" if name in CHILD_TOOLS else "not-listed"], shims, os.path.join(NOT_LISTED, name))
    return shims


def folded(name):
    """A file name as a case- and normalization-insensitive volume compares it."""
    return unicodedata.normalize("NFD", name).casefold()


def link(target, shims, name):
    """shims/name -> target. One already there that points at target is fine (the same
    name made twice); any other failure names the link and stops the hook."""
    path = os.path.join(shims, name)
    try:
        os.symlink(target, path)
        return
    except FileExistsError as error:
        try:
            if os.readlink(path) == target:
                return
        except OSError:
            pass
        failure = error
    except OSError as error:
        failure = error
    say(f"could not make {name} in the PATH of the hook\x27s children ({shims}):"
        f" {failure.strerror or failure}; not committing.")
    sys.exit(1)


def plain(*fields):
    if any("\t" in field or "\n" in field for field in fields):
        say("a checkout or tool path holds a tab or newline; not running anything.")
        sys.exit(1)
    return "\t".join(fields)


# Run by python3 -c; tests load the functions above without running this.
if __name__ == "__main__":
    mode, arguments = sys.argv[1], sys.argv[2:]
    if mode == "boot":
        start, search_path, names = arguments[0], arguments[1], arguments[2:]
        dirs = checkout_dirs(start)
        if not dirs:
            say("found no git directory for this checkout; not running its tools.")
            sys.exit(1)
        if not check(sys.executable, "", "", dirs):
            sys.exit(1)
        lines = [plain("dir", directory) for directory in dirs]
        missing = []
        found = {}
        for name in names:
            found[name] = find(name, search_path, dirs)
            if found[name]:
                lines.append(plain("tool", "TOOL_" + name.upper().replace("-", "_"), found[name]))
            else:
                missing.append(name)
        if missing:
            say("no usable " + ", ".join(missing) + " on PATH outside this checkout; not committing.")
            sys.exit(1)
        shims = child_path(search_path, dirs, found)
        lines.append(plain("path", shims))
        print("\n".join(lines + ["ok"]))
    elif mode == "resolve":
        wanted, root, kind, search_path, dirs = arguments[0], arguments[1], arguments[2], arguments[3], arguments[4:]
        if "/" in wanted:
            found = wanted if check(wanted, root, kind, dirs) else ""
        else:
            found = find(wanted, search_path, dirs)
        if not found:
            sys.exit(1)
        print(plain(found))
    else:
        sys.exit(2)
'
ORIGINAL_PATH="${PATH:-}"
CHECKOUT_REAL_DIRS=()
CHILD_PATH_DIR=""
BOOT_OK=0
# The programs every commit may need, resolved in one interpreter start.
CORE_TOOLS=(git sed grep head cut sort awk cat mkdir mv rm find env mktemp tail sleep)
# The only writer of TOOL_* variables (the detector checks there is no other).
load_resolved_tools() {
    local kind name value
    while IFS=$'\t' read -r kind name value; do
        case "$kind" in
            dir) CHECKOUT_REAL_DIRS+=("$name") ;;
            path) CHILD_PATH_DIR="$name" ;;
            tool) [[ "$name" =~ ^TOOL_[A-Z0-9_]+$ ]] && printf -v "$name" '%s' "$value" ;;
            ok) BOOT_OK=1 ;;
        esac
    done < <("$PYTHON3_BIN" -I -c "$TOOL_RESOLVER" boot "$PWD" "$ORIGINAL_PATH" "${CORE_TOOLS[@]}" || true)
}
load_resolved_tools
if (( ! BOOT_OK )); then
    echo "pre-commit: could not resolve the tools this hook runs outside this checkout; refusing to run (do not pass --no-verify)." >&2
    exit 1
fi
# Children (vp's and npm's `#!/usr/bin/env node`, a rustup proxy, the registry
# helper's git) look tools up by name: their only PATH is the private directory
# of links to checked tools the boot made. A PATH directory itself is never
# handed on: an outside one may hold node -> <checkout>/payload. After the
# links come the stubs for every other name on PATH, which say the name is
# not in CHILD_TOOLS instead of a bare "not found".
export PATH="$CHILD_PATH_DIR:$CHILD_PATH_DIR/.not-listed"
# Removed however the hook ends (cleanup, below, takes this trap over).
trap '"$TOOL_RM" -rf "$CHILD_PATH_DIR"' EXIT
# The one checked resolver: a name (looked up on the caller's PATH) or an
# absolute path, optionally within an install root. Prints the path or fails.
resolve_tool() { # name-or-path [install-root] [checkout-install]
    "$PYTHON3_BIN" -I -c "$TOOL_RESOLVER" resolve "$1" "${2:-}" "${3:-}" "$ORIGINAL_PATH" "${CHECKOUT_REAL_DIRS[@]}"
}

REPO_ROOT="$("$TOOL_GIT" rev-parse --show-toplevel)"
PBXPROJ="cmux.xcodeproj/project.pbxproj"

cd "$REPO_ROOT"

# A merge commit (git merge, or a resolved conflict) stages the other parent's
# files against HEAD: its added tests and workflow lines are that branch's, not
# this commit's. The registry step below skips them, and so do the formatters.
MERGE_HEAD_PATH="$("$TOOL_GIT" rev-parse --git-path MERGE_HEAD)"
IN_MERGE=0
[[ -f "$MERGE_HEAD_PATH" ]] && IN_MERGE=1

# Register new Python tests that a workflow already runs, so adding a test and
# its ci-guards.yml step is all a commit needs. Best effort: CI still validates.
# Only this commit's tests: the ones it adds, and the ones its workflow changes
# name. Registering every unregistered test the base carries wrote the same
# entries into every pull request, which then conflicted (#21946). A merge
# adds no test of its own: registering what the base added since the branch
# point put the base's tests into pull requests (#30071, #30351).
# The registry is tests/test-execution.d/<area>.toml; tests/test-execution.toml was the
# single file before the split, and an old checkout may still have it.
REGISTRY=()
for registry_path in tests/test-execution.d tests/test-execution.toml; do
    [[ -e "$registry_path" ]] && REGISTRY+=("$registry_path")
done
# No unstaged edit and no new fragment: what the step below finds changed is its own.
registry_unchanged() {
    (( ${#REGISTRY[@]} > 0 )) && "$TOOL_GIT" diff --quiet -- "${REGISTRY[@]}" \
        && [[ -z "$("$TOOL_GIT" ls-files --others --exclude-standard -- "${REGISTRY[@]}")" ]]
}
if (( ! IN_MERGE )) && "$TOOL_GIT" diff --cached --name-only --diff-filter=ACMRT | "$TOOL_GREP" -Eq '^(tests/test_[^/]+\.py|\.github/workflows/.+)$' \
    && registry_unchanged; then
    OWN_TESTS=()
    while IFS= read -r test_path; do
        [[ -n "$test_path" ]] && OWN_TESTS+=(--only "$test_path")
    done < <(
        {
            "$TOOL_GIT" diff --cached --name-only --diff-filter=A -- 'tests/test_*.py'
            "$TOOL_GIT" diff --cached -U0 -- .github/workflows | "$TOOL_GREP" -E '^\+' | "$TOOL_GREP" -oE 'tests/test_[A-Za-z0-9_]+\.py' || true
        } | "$TOOL_SORT" -u
    )
    if (( ${#OWN_TESTS[@]} > 0 )); then
        # The helper runs `git` by name: the children's PATH links the resolved git.
        "$PYTHON3_BIN" -I "$REGISTRY_VALIDATOR" --repo-root "$REPO_ROOT" --write "${OWN_TESTS[@]}" >/dev/null 2>&1 || true
    fi
    if ! registry_unchanged; then
        "$TOOL_GIT" add -A -- "${REGISTRY[@]}"
        echo "pre-commit: registered new tests in ${REGISTRY[*]}"
    fi
fi

# A merge commit combines base-owned files with the staged result. Do not
# reformat that result while Git is resolving the merge; formatters run on the
# authored files in the follow-up commit instead.
if (( IN_MERGE )); then
    echo "pre-commit: merge in progress; skipping test registration and formatters"
    exit 0
fi

# Emergency switch: commit without formatting (CI still checks the format).
SKIP_FORMATTERS=0
if [[ "${CMUX_SKIP_FORMAT_HOOKS:-0}" == 1 ]]; then
    SKIP_FORMATTERS=1
    echo "pre-commit: CMUX_SKIP_FORMAT_HOOKS=1; skipping formatters (CI will check them)" >&2
fi

# Only normalize when the pbxproj is part of this commit.
if "$TOOL_GIT" diff --cached --name-only --diff-filter=ACMRT | "$TOOL_GREP" -Fxq "$PBXPROJ"; then
    # Refuse to normalize when the working-tree pbxproj has unstaged changes.
    # Otherwise the `git add` at the end would silently stage hunks the
    # user deliberately left out of this commit.
    if ! "$TOOL_GIT" diff --quiet -- "$PBXPROJ"; then
        echo "pre-commit: $PBXPROJ has unstaged changes; cannot safely normalize." >&2
        echo "Either stage the whole file (git add $PBXPROJ) or stash the unstaged hunks before committing." >&2
        exit 1
    fi

    "$PYTHON3_BIN" -I "$PBX_NORMALIZER" "$PBXPROJ"

    # If the normalizer rewrote the file, restage so the commit captures
    # the normalized form. (Working tree had no unstaged changes per the
    # guard above, so anything that changed is purely from normalization.)
    if ! "$TOOL_GIT" diff --quiet -- "$PBXPROJ"; then
        "$TOOL_GIT" add "$PBXPROJ"
    fi
fi

# A missing formatter is a hard failure for agents and CI, never a silent skip
# (lanes committed unformatted Rust and web code for days because rustfmt and
# vp were missing on the agent host). People get a warning instead. Codex
# shells set CODEX_CI and CODEX_THREAD_ID; Claude Code shells set CLAUDECODE.
REQUIRE_FORMATTERS=0
for var in CMUX_AGENT CMUX_REQUIRE_FORMATTERS CI CLAUDECODE CODEX_CI CODEX_THREAD_ID CODEX_SANDBOX; do
    if [[ -n "${!var:-}" && "${!var}" != 0 ]]; then
        REQUIRE_FORMATTERS=1
    fi
done
formatter_missing() { # message
    if (( REQUIRE_FORMATTERS )); then
        echo "pre-commit: $1" >&2
        echo "pre-commit: refusing to commit unformatted files (an agent or CI environment requires formatters; do not pass --no-verify)." >&2
        exit 1
    fi
    echo "pre-commit: $1; skipping (CI will check it)." >&2
}

# Keep the formatters on the fast path: only invoke them for files that are in
# this commit, and never build or inspect the rest of the checkout. A formatter
# rewrites its input in place, so refuse a file with unstaged edits rather than
# accidentally adding those edits to this commit.
# Each vite-plus package formats with its own vp and config, like its CI check.
WEB_PACKAGES=(webviews cmux-tui/frontends/web)
STAGED_WEB_PATHS=()
STAGED_RUST_PATHS=()
STAGED_SWIFT_PATHS=()
while IFS= read -r -d '' path; do
    if (( ! SKIP_FORMATTERS )) && ! "$TOOL_GIT" diff --quiet -- "$path"; then
        case "$path" in
            webviews/*|cmux-tui/frontends/web/*|*.rs|*.swift)
                echo "pre-commit: $path has unstaged changes; stage or stash them before formatting." >&2
                exit 1
                ;;
        esac
    fi

    case "$path" in
        webviews/*|cmux-tui/frontends/web/*)
            case "$path" in
                */node_modules/*) ;;
                *.js|*.jsx|*.ts|*.tsx|*.mjs|*.cjs|*.mts|*.cts|*.css|*.scss|*.html|*.json|*.md|*.mdx)
                    STAGED_WEB_PATHS+=("$path")
                    ;;
            esac
            ;;
        *.rs)
            STAGED_RUST_PATHS+=("$path")
            ;;
        *.swift)
            STAGED_SWIFT_PATHS+=("$path")
            ;;
    esac
done < <("$TOOL_GIT" diff --cached --name-only --diff-filter=ACMRT -z)

# The version a lockfile pins for a package, or nothing.
locked_version() { # package-dir name
    if [[ -f "$1/bun.lock" ]]; then
        "$TOOL_SED" -nE "s/^ *\"$2\": \[\"$2@([^\"]+)\".*/\1/p" "$1/bun.lock" | "$TOOL_HEAD" -n 1
    elif [[ -f "$1/package-lock.json" ]]; then
        "$PYTHON3_BIN" -I -c 'import json,sys; print(json.load(open(sys.argv[1]))["packages"].get("node_modules/"+sys.argv[2], {}).get("version", ""))' \
            "$1/package-lock.json" "$2" 2>/dev/null || true
    fi
}
# Temporary files and a held install lock go away however the hook ends.
RUSTFMT_DEFAULTS=""
BOOTSTRAP_LOG=""
BUN_PIN=""
HELD_LOCK=""
cleanup() {
    "$TOOL_RM" -f "${RUSTFMT_DEFAULTS:-}" "${BOOTSTRAP_LOG:-}"
    "$TOOL_RM" -rf "$CHILD_PATH_DIR"
    release_install_lock
}
# Removes the lock only while it is still ours: a hook that ran past the
# takeover age must not remove the lock its successor took.
# An empty PID file is ours too: the hook was stopped between mkdir and
# writing its PID.
release_install_lock() {
    if [[ -n "$HELD_LOCK" ]]; then
        local holder
        holder="$("$TOOL_CAT" "$HELD_LOCK/pid" 2>/dev/null || true)"
        if [[ "$holder" == "$$" || -z "$holder" ]]; then
            "$TOOL_RM" -rf "$HELD_LOCK"
        fi
    fi
    HELD_LOCK=""
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

# Takes a per-worktree install lock (a directory holding the holder's PID).
# A lock whose holder is gone, or one older than ten minutes, was left by a
# killed hook and is taken over.
# The stale lock is moved aside before mkdir: rename is atomic, so of two hooks
# that both found it stale only one moves it, and a lock that turns out to be
# live once moved (another hook took it meanwhile) is put back.
lock_is_stale() { # lock-dir
    local holder
    holder="$("$TOOL_CAT" "$1/pid" 2>/dev/null || true)"
    { [[ -n "$holder" ]] && ! kill -0 "$holder" 2>/dev/null; } \
        || [[ -n "$("$TOOL_FIND" "$1" -maxdepth 0 -mmin +10 2>/dev/null || true)" ]]
}
take_install_lock() { # lock-dir
    if ! "$TOOL_MKDIR" "$1" 2>/dev/null; then
        lock_is_stale "$1" || return 1
        "$TOOL_MV" "$1" "$1.stale.$$" 2>/dev/null || return 1
        if ! lock_is_stale "$1.stale.$$"; then
            [[ -e "$1" ]] || "$TOOL_MV" "$1.stale.$$" "$1" 2>/dev/null || true
            "$TOOL_RM" -rf "$1.stale.$$"
            return 1
        fi
        "$TOOL_RM" -rf "$1.stale.$$"
        "$TOOL_MKDIR" "$1" 2>/dev/null || return 1
    fi
    HELD_LOCK="$1"
    printf '%s\n' "$$" >"$1/pid"
}

# vp is missing, or vite-plus or oxfmt differ from the lockfile CI installs.
web_packages_stale() { # package-dir
    local name want have
    [[ -x "$1/node_modules/.bin/vp" ]] || return 0
    for name in vite-plus oxfmt; do
        want="$(locked_version "$1" "$name")"
        [[ -n "$want" ]] || continue
        have="$("$PYTHON3_BIN" -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get("version", ""))' \
            "$1/node_modules/$name/package.json" 2>/dev/null || true)"
        [[ "$want" == "$have" ]] || return 0
    done
    return 1
}

# A checkout decides what it pins, never where the hook runs a binary from: a
# pin like ../../../repository/payload walked out of the mise directory and ran
# the checkout's own payload/bin/bun. Every candidate goes through resolve_tool
# (above), with the install root it must stay inside.
# The bun version webviews/package.json devEngines pins, as the one shared reader
# (scripts/webviews_bun_version.py, installed beside this hook) reads it: the
# devEngines.packageManager entry named "bun", only as an exact major.minor.patch.
# check-webviews-bun-version.sh calls the same reader, so the two cannot disagree.
# Without the trusted reader, or with no pin it accepts, the hook cannot vouch
# for a bun: it says why and how to fix it, and fails (the caller refuses).
pinned_bun_version() {
    local pin status=0
    if [[ ! -f "$BUN_VERSION_READER" ]]; then
        echo "pre-commit: the trusted copy of webviews_bun_version.py is missing, so this hook cannot read the bun pin; run scripts/install-git-hooks.sh" >&2
        return 1
    fi
    pin="$("$PYTHON3_BIN" -I "$BUN_VERSION_READER" "$REPO_ROOT/webviews/package.json" 2>&1)" || status=$?
    if (( status != 0 )); then
        echo "pre-commit: ${pin//[^[:print:]]/?}; declare an exact bun in webviews/package.json devEngines.packageManager" >&2
        return 1
    fi
    printf '%s\n' "$pin"
}
# Every bun and npm call runs through tool_env: BUN_OPTIONS is the caller's,
# and bun prepends it to every command line, so a `--preload PATH` there made
# `bun install` fail with 'Script not found "install"' and no vp got installed.
# The tool is checked again here, so no caller can hand env an unchecked argv[0].
tool_env() { # tool args...
    local tool
    tool="$(resolve_tool "$1")" || return 1
    shift
    "$TOOL_ENV" -u BUN_OPTIONS "$tool" "$@"
}
# The bun the install runs, by absolute path: a bun at exactly the pinned
# version from mise, asdf, PATH or ~/.bun. There is no other fallback: with none
# at the pin it says how to install one and fails. Each candidate path is built
# only from the validated pin and passes resolve_tool before even its --version runs.
resolve_bun() { # pin (validated)
    local want="$1" entry root candidate path_bun mise_root asdf_root bun_root
    path_bun="$(resolve_tool bun || true)"
    if [[ -n "$want" ]]; then
        mise_root="${MISE_DATA_DIR:-${XDG_DATA_HOME:-${HOME:-/nonexistent}/.local/share}/mise}/installs/bun"
        asdf_root="${ASDF_DATA_DIR:-${HOME:-/nonexistent}/.asdf}/installs/bun"
        bun_root="${BUN_INSTALL:-${HOME:-/nonexistent}/.bun}"
        for entry in "$mise_root|$mise_root/$want/bin/bun" "$asdf_root|$asdf_root/$want/bin/bun" \
            "|$path_bun" "$bun_root|$bun_root/bin/bun"; do
            root="${entry%%|*}"
            candidate="${entry#*|}"
            [[ -n "$candidate" ]] || continue
            candidate="$(resolve_tool "$candidate" "$root")" || continue
            if [[ "$(tool_env "$candidate" --version 2>/dev/null || true)" == "$want" ]]; then
                printf '%s\n' "$candidate"
                return 0
            fi
        done
    fi
    echo "pre-commit: no bun ${want:-(no pin)} in mise, asdf, PATH or ~/.bun outside this checkout; install it: curl -fsSL https://bun.sh/install | bash -s bun-v${want:-<version>}" >&2
    return 1
}
# Stops the commit when the hook would have to install packages with a bun it
# cannot vouch for; the lines before say why and what fixes it.
refuse_bun_install() { # package
    echo "pre-commit: refusing to install $1 packages with a bun this hook cannot vouch for (see above)." >&2
    release_install_lock
    exit 1
}
# Runs an install step in a package directory with its output kept. When it
# fails, prints what ran and with which tool, so a broken bootstrap is never
# just "vp is unavailable".
bootstrap_run() { # package-dir tool args...
    local dir="$1" status=0 version
    shift
    BOOTSTRAP_LOG="${BOOTSTRAP_LOG:-$("$TOOL_MKTEMP" "${TMPDIR:-/tmp}/cmux-pre-commit-install.XXXXXX")}"
    (cd "$dir" && tool_env "$@") >"$BOOTSTRAP_LOG" 2>&1 || status=$?
    (( status != 0 )) || return 0
    version="$(tool_env "$1" --version 2>&1 | "$TOOL_HEAD" -n 1 || true)"
    {
        echo "pre-commit: install failed in $dir (exit $status)"
        echo "pre-commit:   command: env -u BUN_OPTIONS $*"
        echo "pre-commit:   argv[0]: $1"
        echo "pre-commit:   $1 --version: ${version:-no output}${BUN_PIN:+ (webviews/package.json pins bun $BUN_PIN)}"
        if [[ -n "${BUN_OPTIONS:-}" ]]; then
            echo "pre-commit:   BUN_OPTIONS: set (removed for this command)"
        else
            echo "pre-commit:   BUN_OPTIONS: not set"
        fi
        if [[ -n "${NODE_OPTIONS:-}" ]]; then
            echo "pre-commit:   NODE_OPTIONS: set"
        else
            echo "pre-commit:   NODE_OPTIONS: not set"
        fi
        echo "pre-commit:   last lines of its output:"
        "$TOOL_TAIL" -n 20 "$BOOTSTRAP_LOG" | "$TOOL_SED" 's/^/pre-commit:     /'
    } >&2
    return "$status"
}

if (( ${#STAGED_WEB_PATHS[@]} > 0 && ! SKIP_FORMATTERS )); then
    for package in "${WEB_PACKAGES[@]}"; do
        PACKAGE_PATHS=()
        for path in "${STAGED_WEB_PATHS[@]}"; do
            [[ "$path" == "$package/"* ]] && PACKAGE_PATHS+=("${path#"$package"/}")
        done
        (( ${#PACKAGE_PATHS[@]} > 0 )) || continue
        PACKAGE_DIR="$REPO_ROOT/$package"
        # The checkout's own vp (vp fmt reads the package's vite.config.ts, which
        # needs its packages), at the version its lockfile pins. Missing or stale
        # packages are installed first: bun's cache makes that about a second,
        # and lifecycle scripts never run.
        if web_packages_stale "$PACKAGE_DIR"; then
            # One install at a time into this worktree's node_modules: npm ci
            # deletes node_modules first. A held lock means someone else is
            # installing; format with what is there, or, with no vp yet, wait
            # (up to two minutes) for that install.
            INSTALL_LOCK="$("$TOOL_GIT" rev-parse --absolute-git-dir)/cmux-format-install-${package//\//-}.lock"
            if ! take_install_lock "$INSTALL_LOCK"; then
                echo "pre-commit: another agent is installing $package packages; using the current ones (waiting for them if vp is missing)" >&2
                for ((wait_seconds = 0; wait_seconds < 120; wait_seconds++)); do
                    [[ ! -x "$PACKAGE_DIR/node_modules/.bin/vp" && -d "$INSTALL_LOCK" ]] || break
                    "$TOOL_SLEEP" 1
                done
            elif [[ -f "$PACKAGE_DIR/bun.lock" ]]; then
                BUN_PIN="$(pinned_bun_version)" || refuse_bun_install "$package"
                BUN_BIN="$(resolve_bun "$BUN_PIN")" || refuse_bun_install "$package"
                echo "pre-commit: installing $package packages for vp ($BUN_BIN install --frozen-lockfile --ignore-scripts)" >&2
                bootstrap_run "$PACKAGE_DIR" "$BUN_BIN" install --frozen-lockfile --ignore-scripts || true
                if [[ "$package" == webviews ]]; then
                    # --ignore-scripts skips the postinstall that writes the pages' strings tables (build
                    # output since #21946); write them so a later typecheck in this checkout finds them.
                    (cd "$PACKAGE_DIR" && tool_env "$BUN_BIN" scripts/pages/gen-strings.mjs --best-effort >/dev/null 2>&1) || true
                fi
            elif [[ -f "$PACKAGE_DIR/package-lock.json" ]] && NPM_BIN="$(resolve_tool npm)"; then
                BUN_PIN=""
                echo "pre-commit: installing $package packages for vp ($NPM_BIN ci --ignore-scripts)" >&2
                bootstrap_run "$PACKAGE_DIR" "$NPM_BIN" ci --ignore-scripts --no-audit --no-fund || true
            fi
            [[ "$HELD_LOCK" != "$INSTALL_LOCK" ]] || release_install_lock
        fi
        # The package's own vp, the one tool the hook runs from inside the checkout:
        # vp fmt evaluates the package's vite.config.ts anyway. It must resolve
        # inside the package's node_modules, and git must track nothing there, so
        # it came from the install above, never from a commit.
        if [[ -n "$("$TOOL_GIT" ls-files -- "$package/node_modules" | "$TOOL_HEAD" -n 1)" ]]; then
            echo "pre-commit: git tracks files under $package/node_modules; not running its vp." >&2
            formatter_missing "vp is unavailable for $package (install its packages)"
            continue
        fi
        if ! VP_BIN="$(resolve_tool "$PACKAGE_DIR/node_modules/.bin/vp" "$PACKAGE_DIR/node_modules" checkout-install)"; then
            formatter_missing "vp is unavailable for $package (install its packages)"
            continue
        fi
        (
            cd "$PACKAGE_DIR"
            # A commit of only fmt-ignored files (webviews CSS) matches nothing.
            "$VP_BIN" fmt --no-error-on-unmatched-pattern "${PACKAGE_PATHS[@]}"
        )
        "$TOOL_GIT" add -- "${PACKAGE_PATHS[@]/#/$package/}"
    done
fi

# Rust: every staged .rs file is formatted as `cargo fmt` would, with its Cargo
# package's edition and the nearest rustfmt.toml above it inside the checkout.
# With none, an empty config pins rustfmt's defaults, so a stray rustfmt.toml
# above the checkout (rustfmt keeps searching up to /) never decides the
# format. Bash 3.2 compatible (macOS): no associative arrays.
rust_package_root() { # repository-relative path -> nearest directory with a [package] Cargo.toml
    local dir="${1%/*}"
    [[ "$dir" == "$1" ]] && dir=""
    while :; do
        if [[ -f "$REPO_ROOT/${dir:+$dir/}Cargo.toml" ]] && "$TOOL_GREP" -q '^\[package\]' "$REPO_ROOT/${dir:+$dir/}Cargo.toml"; then
            echo "$dir"
            return 0
        fi
        [[ -z "$dir" ]] && return 1
        if [[ "$dir" == */* ]]; then dir="${dir%/*}"; else dir=""; fi
    done
}
rust_edition() { # package root -> its edition, following edition.workspace = true
    local manifest="$REPO_ROOT/${1:+$1/}Cargo.toml" dir="$1" edition
    edition="$("$TOOL_SED" -nE 's/^edition[[:space:]]*=[[:space:]]*"([0-9]{4})".*/\1/p' "$manifest" | "$TOOL_HEAD" -n 1)"
    if [[ -z "$edition" ]] && "$TOOL_GREP" -qE '^edition([[:space:]]*\.[[:space:]]*workspace[[:space:]]*=[[:space:]]*true|[[:space:]]*=[[:space:]]*\{[[:space:]]*workspace[[:space:]]*=[[:space:]]*true)' "$manifest"; then
        while [[ -n "$dir" ]]; do
            if [[ "$dir" == */* ]]; then dir="${dir%/*}"; else dir=""; fi
            manifest="$REPO_ROOT/${dir:+$dir/}Cargo.toml"
            if [[ -f "$manifest" ]] && "$TOOL_GREP" -q '^\[workspace\.package\]' "$manifest"; then
                edition="$("$TOOL_AWK" '/^\[/{section=$0} section=="[workspace.package]" && /^edition[[:space:]]*=/{gsub(/[^0-9]/,"",$0); print; exit}' "$manifest")"
                break
            fi
        done
    fi
    echo "${edition:-2015}"
}
rust_toolchain() { # package root -> the channel the nearest rust-toolchain(.toml) pins, or nothing
    local dir="$1"
    while :; do
        if [[ -f "$REPO_ROOT/${dir:+$dir/}rust-toolchain.toml" ]]; then
            "$TOOL_SED" -nE 's/^[[:space:]]*channel[[:space:]]*=[[:space:]]*"([A-Za-z0-9][A-Za-z0-9._-]*)".*/\1/p' "$REPO_ROOT/${dir:+$dir/}rust-toolchain.toml" | "$TOOL_HEAD" -n 1
            return 0
        fi
        if [[ -f "$REPO_ROOT/${dir:+$dir/}rust-toolchain" ]]; then
            local channel=""
            IFS= read -r channel < "$REPO_ROOT/${dir:+$dir/}rust-toolchain" || true
            channel="${channel//[[:space:]]/}"
            # A toolchain name, never a path rustup would run a binary from.
            [[ "$channel" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] && echo "$channel"
            return 0
        fi
        [[ -z "$dir" ]] && return 0
        if [[ "$dir" == */* ]]; then dir="${dir%/*}"; else dir=""; fi
    done
}
rust_config() { # package root -> nearest rustfmt.toml or .rustfmt.toml at or above it in the checkout, or nothing
    local dir="$1"
    while :; do
        for name in rustfmt.toml .rustfmt.toml; do
            if [[ -f "$REPO_ROOT/${dir:+$dir/}$name" ]]; then
                echo "$REPO_ROOT/${dir:+$dir/}$name"
                return 0
            fi
        done
        [[ -z "$dir" ]] && return 0
        if [[ "$dir" == */* ]]; then dir="${dir%/*}"; else dir=""; fi
    done
}

if (( ${#STAGED_RUST_PATHS[@]} > 0 && ! SKIP_FORMATTERS )); then
    # One "root<TAB>path" line per staged file inside a Cargo package; a .rs
    # file outside every package (a build script fixture, say) is left alone.
    RUST_ENTRIES=""
    for path in "${STAGED_RUST_PATHS[@]}"; do
        if package_root="$(rust_package_root "$path")"; then
            RUST_ENTRIES+="$package_root"$'\t'"$path"$'\n'
        fi
    done
    RUST_ROOTS="$(printf '%s' "$RUST_ENTRIES" | "$TOOL_CUT" -f1 | "$TOOL_SORT" -u)"
    # rustfmt can follow `mod` declarations from a staged module and rewrite
    # its children. Refuse that case within the affected Cargo package rather
    # than touching an unstaged Rust file in the worktree.
    while IFS= read -r package_root; do
        [[ -n "$RUST_ENTRIES" ]] || break
        if {
            "$TOOL_GIT" diff --name-only --diff-filter=ACMRT -- "${package_root:-.}"
            "$TOOL_GIT" ls-files --others --exclude-standard -- "${package_root:-.}"
        } | "$TOOL_GREP" -Eq '\.rs$'; then
            echo "pre-commit: ${package_root:-.} has unstaged Rust edits; stage or stash them before formatting." >&2
            exit 1
        fi
    done <<<"$RUST_ROOTS"
    if [[ -n "$RUST_ENTRIES" ]]; then
        RUSTFMT_BIN="$(resolve_tool rustfmt || true)"
        if [[ -z "$RUSTFMT_BIN" ]]; then
            formatter_missing "rustfmt is unavailable (rustup component add rustfmt, and put it on PATH)"
        else
            RUSTFMT_DEFAULTS="$("$TOOL_MKTEMP" "${TMPDIR:-/tmp}/cmux-rustfmt-defaults.XXXXXX")"
            while IFS= read -r package_root; do
                config="$(rust_config "$package_root")"
                RUSTFMT_ARGS=(--edition "$(rust_edition "$package_root")" --config-path "${config:-$RUSTFMT_DEFAULTS}")
                PACKAGE_PATHS=()
                while IFS=$'\t' read -r root path; do
                    [[ "$root" == "$package_root" ]] && PACKAGE_PATHS+=("$REPO_ROOT/$path")
                done <<<"$RUST_ENTRIES"
                # The rustfmt of the toolchain CI's cargo fmt uses for this
                # package. rustfmt keeps a stable style across versions, so
                # without that toolchain the PATH rustfmt still formats.
                PACKAGE_RUSTFMT="$RUSTFMT_BIN"
                toolchain="$(rust_toolchain "$package_root")"
                if [[ -n "$toolchain" ]]; then
                    # Resolved once, and only when a package pins a toolchain.
                    [[ -n "${RUSTUP_BIN+set}" ]] || RUSTUP_BIN="$(resolve_tool rustup || true)"
                    pinned_path=""
                    if [[ -n "$RUSTUP_BIN" ]]; then
                        pinned_path="$(cd / && "$RUSTUP_BIN" which --toolchain "$toolchain" rustfmt 2>/dev/null || true)"
                    fi
                    if [[ -n "$pinned_path" ]] && PINNED_RUSTFMT="$(resolve_tool "$pinned_path")"; then
                        PACKAGE_RUSTFMT="$PINNED_RUSTFMT"
                    else
                        echo "pre-commit: ${package_root:-.} pins Rust $toolchain; using $RUSTFMT_BIN (rustup toolchain install $toolchain --component rustfmt)" >&2
                    fi
                fi
                # From /, so a rustup proxy picks no toolchain (or toolchain
                # path) from a rust-toolchain file in the checkout: every
                # argument is absolute.
                (cd / && "$PACKAGE_RUSTFMT" "${RUSTFMT_ARGS[@]}" "${PACKAGE_PATHS[@]}")
                "$TOOL_GIT" add -- "${PACKAGE_PATHS[@]}"
            done <<<"$RUST_ROOTS"
        fi
    fi
fi

# cmux currently has no Swift-format configuration. Keep this branch ready for
# the day one is added without making a formatter a setup prerequisite today.
if (( ${#STAGED_SWIFT_PATHS[@]} > 0 && ! SKIP_FORMATTERS )) && [[ -f "$REPO_ROOT/.swift-format" ]]; then
    SWIFT_FORMAT_BIN="$(resolve_tool swift-format || true)"
    if [[ -z "$SWIFT_FORMAT_BIN" ]]; then
        formatter_missing "swift-format is unavailable"
    else
        for path in "${STAGED_SWIFT_PATHS[@]}"; do
            "$SWIFT_FORMAT_BIN" format --in-place --configuration "$REPO_ROOT/.swift-format" "$path"
            "$TOOL_GIT" add -- "$path"
        done
    fi
fi
