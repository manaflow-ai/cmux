#!/usr/bin/env bash
# Refresh the trusted hook copies and merge drivers after a fast-forward/pull
# to trusted main or feat-cmux-next (where direct pushes land).
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
HEAD_SHA="$(git rev-parse HEAD)"

canonical_url() {
    case "$1" in
        git@github.com:manaflow-ai/cmux.git|ssh://git@github.com/manaflow-ai/cmux.git|https://github.com/manaflow-ai/cmux.git|https://github.com/manaflow-ai/cmux) return 0 ;;
    esac
    return 1
}

# After main or feat-cmux-next is merged into a branch, rebuild the generated
# files the merge kept one side of (.gitattributes, cmux-generated-v1) and
# commit them, so nobody resolves or rebuilds one by hand (Leo, 2026-11-16: "it
# shouldve just been done"). The rebuild runs the merged tree's generators, so
# only when the merged-in commit is exactly a base branch fetched from
# manaflow-ai/cmux and the branch does not track a fork or a pull request ref.
# CMUX_REGENERATE_AFTER_MERGE=0 turns it off. A failed generator only warns:
# the pull request's generated-file checks still name what is stale.
regenerate_after_base_merge() {
    [[ "${CMUX_REGENERATE_AFTER_MERGE:-1}" != 0 ]] || return 0
    local merged branch upstream_remote upstream_merge remote base python3_bin found=""
    merged="$(git rev-parse -q --verify 'HEAD^2' 2>/dev/null)" || return 0
    branch="$(git symbolic-ref -q --short HEAD)" || return 0
    upstream_remote="$(git config "branch.$branch.remote" || true)"
    upstream_merge="$(git config "branch.$branch.merge" || true)"
    case "$upstream_merge" in ""|refs/heads/*) ;; *) return 0 ;; esac
    if [[ -n "$upstream_remote" && "$upstream_remote" != "." ]]; then
        canonical_url "$(git remote get-url "$upstream_remote" 2>/dev/null || true)" || return 0
    fi
    while IFS= read -r remote; do
        canonical_url "$(git remote get-url "$remote" 2>/dev/null || true)" || continue
        for base in main feat-cmux-next; do
            if [[ "$(git rev-parse -q --verify "refs/remotes/$remote/$base" 2>/dev/null || true)" == "$merged" ]]; then
                found="$base"
            fi
        done
    done < <(git remote)
    [[ -n "$found" && -f "$REPO_ROOT/scripts/cmux-next/generated_merge.py" ]] || return 0
    python3_bin="$(command -v python3 || true)"
    [[ "$python3_bin" == /* ]] && python3_bin="$(/bin/realpath "$python3_bin")"
    case "$python3_bin" in /*) ;; *) return 0 ;; esac
    case "$python3_bin" in "$REPO_ROOT"/*) return 0 ;; esac
    if ! (cd "$REPO_ROOT" && "$python3_bin" -I scripts/cmux-next/generated_merge.py regenerate --merge --stage); then
        echo "warning: rebuilding the generated files after merging $found failed; run" \
            "scripts/cmux-next/generated_merge.py regenerate --merge --stage, then commit." >&2
        return 0
    fi
    if ! git diff --cached --quiet; then
        git commit --no-verify -q -m "Regenerate generated files after merging $found" \
            -m "scripts/cmux-next/generated_merge.py regenerate --merge, from the post-merge hook."
        echo "==> committed the generated files the merge with $found kept one side of, rebuilt."
    fi
}
regenerate_after_base_merge

# This hook is tracked, so never run its installer merely because an arbitrary
# checked-out branch asks. The current commit must exactly equal main or
# feat-cmux-next fetched from the canonical manaflow-ai/cmux remote already
# configured by the user: the shared branches whose scripts the team already runs.
while IFS= read -r remote; do
    url="$(git remote get-url "$remote" 2>/dev/null || true)"
    case "$url" in
        git@github.com:manaflow-ai/cmux.git|ssh://git@github.com/manaflow-ai/cmux.git|https://github.com/manaflow-ai/cmux.git|https://github.com/manaflow-ai/cmux)
            for trusted_branch in main feat-cmux-next; do
                trusted_ref="refs/remotes/$remote/$trusted_branch"
                trusted_sha="$(git rev-parse --verify "$trusted_ref" 2>/dev/null || true)"
                if [[ -n "$trusted_sha" && "$HEAD_SHA" == "$trusted_sha" ]]; then
                    trusted_inputs=(
                        scripts/install-git-hooks.sh
                        scripts/git-hooks/pre-commit
                        scripts/git-hooks/post-merge
                        scripts/merge-xcstrings.py
                        scripts/merge-pbxproj.py
                        scripts/merge-baseline.py
                        scripts/merge-daemon-capabilities.py
                        scripts/merge-insertions.py
                        scripts/ci/merge_main_resolver.py
                        scripts/ci/validate_test_execution_registry.py
                        scripts/ci/test_execution_registry.py
                        scripts/ci/workload_entrypoints.py
                        scripts/normalize-pbxproj.py
                        scripts/webviews_bun_version.py
                        scripts/git-hooks/pre-push
                        scripts/git-hooks/hook_python.sh
                        scripts/git-hooks/merge_python.sh
                        scripts/git-hooks/refresh_checks.py
                        scripts/web_lint_prepush.py
                        scripts/lint_swift_namespaces.py
                        # Legacy --namespace-fix installs copy this beside the hook even before the manifest existed.
                        scripts/swift_source_mask.py
                        scripts/git-hooks/checks-copy-inputs
                    )
                    if ! git diff --quiet "$trusted_sha" -- "${trusted_inputs[@]}"; then
                        echo "warning: cmux merge-driver installer inputs differ from trusted $trusted_branch; rerun from a clean checkout." >&2
                        exit 0
                    fi
                    # ...and everything the cmux-next checks copy is made from: the one list the installer copies
                    # and refresh_checks.py stamps from. refresh_checks.py (now known to be the trusted one, as is the
                    # list) reads it through the helper the install and a refresh copy through (--sources), which
                    # refuses an entry that leaves the repository (Codex on #40894, F1) by name.
                    copy_sources=()
                    if [[ -f "$REPO_ROOT/scripts/git-hooks/checks-copy-inputs" ]]; then
                        python3_bin="$(command -v python3 || true)"
                        [[ "$python3_bin" == /* ]] && python3_bin="$(/bin/realpath "$python3_bin")"
                        case "$python3_bin" in
                            /*) ;;
                            *) echo "warning: python3 is not an absolute executable; not reinstalling the cmux hooks." >&2; exit 0 ;;
                        esac
                        case "$python3_bin" in
                            "$REPO_ROOT"/*) echo "warning: python3 resolves inside the checkout; not reinstalling the cmux hooks." >&2; exit 0 ;;
                        esac
                        if ! sources="$("$python3_bin" -I "$REPO_ROOT/scripts/git-hooks/refresh_checks.py" \
                                --repo "$REPO_ROOT" --sources </dev/null)"; then
                            echo "warning: scripts/git-hooks/checks-copy-inputs has an entry the checks copy refuses; not reinstalling the cmux hooks." >&2
                            exit 0
                        fi
                        while IFS= read -r source; do
                            [[ -n "$source" ]] && copy_sources+=("$source")
                        done <<<"$sources"
                    fi
                    if (( ${#copy_sources[@]} )) && ! git diff --quiet "$trusted_sha" -- "${copy_sources[@]}"; then
                        echo "warning: cmux merge-driver installer inputs differ from trusted $trusted_branch; rerun from a clean checkout." >&2
                        exit 0
                    fi
                    exec /bin/bash "$REPO_ROOT/scripts/install-git-hooks.sh"
                fi
            done
            ;;
    esac
done < <(git remote)

exit 0
