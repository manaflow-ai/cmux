#!/bin/bash
# cmux pre-push hook, installed by scripts/install-git-hooks.sh as a clone-local
# copy outside the checkout.
# 1. Web lint (always): runs the web checks CI runs on what the push changes and
#    refuses the push when they fail. Skip once with
#    CMUX_WEB_LINT_SKIP_REASON="<the failing check and the base SHA where it also fails>".
# 2. cmux-next checks (always): scripts/cmux-next/prepush-gate.py runs the static
#    checks of the "cmux-next checks" CI job, ast-grep, SwiftFormat and SwiftLint
#    on what the push changes and refuses a push that adds a violation. Skip once with
#    CMUX_NEXT_CHECKS_SKIP_REASON="<check> fails in files this push does not touch".
# 3. Base-merge warning (always, never refuses): scripts/ci/base_merge_warning.py says when the push
#    merges the base into a branch whose old head still has CI running, which the push cancels.
# 4. Namespace autofix (opt-in): only when installed with --namespace-fix.
set -euo pipefail

HOOK_DIR="$(cd "${BASH_SOURCE[0]%/*}" && pwd -P)"
PYTHON_PATH_FILE="$HOOK_DIR/python3-path"
if [[ ! -r "$PYTHON_PATH_FILE" ]] || ! IFS= read -r PYTHON3_BIN < "$PYTHON_PATH_FILE" \
    || [[ "$PYTHON3_BIN" != /* ]] || [[ ! -x "$PYTHON3_BIN" ]]; then
    echo "pre-push: trusted Python interpreter metadata is missing; rerun scripts/install-git-hooks.sh." >&2
    exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Every check reads git's pushed-refs lines; read them once. $1 is the pushed remote (a name, or the URL of a
# push to a URL): the checks bound the push's own commits by its refs (cmux-next-checks/push_range.py).
PUSHED_REFS="$(cat)"
PUSHED_REMOTE="${1:-origin}"
CHECKS="$HOOK_DIR/cmux-next-checks"

WEB_LINT="$HOOK_DIR/web_lint_prepush.py"
if [[ -f "$WEB_LINT" ]]; then
    printf '%s\n' "$PUSHED_REFS" | "$PYTHON3_BIN" -I "$WEB_LINT" --pre-push --repo "$REPO_ROOT" \
        --remote "$PUSHED_REMOTE" --trusted-scripts-dir "$CHECKS"
else
    echo "pre-push: web lint helper is missing; rerun scripts/install-git-hooks.sh." >&2
    exit 1
fi

GATE="$HOOK_DIR/cmux_next_prepush_gate.py"
if [[ -f "$GATE" ]]; then
    # The remote's URL ($2): the compile trailer rule applies only to a push to manaflow-ai/cmux's feat-cmux-next.
    printf '%s\n' "$PUSHED_REFS" | CMUX_PREPUSH_REMOTE_URL="${2:-}" "$PYTHON3_BIN" -I "$GATE" --pre-push \
        --repo "$REPO_ROOT" --remote "$PUSHED_REMOTE" --trusted-scripts-dir "$CHECKS"
else
    echo "pre-push: cmux-next checks gate is missing; rerun scripts/install-git-hooks.sh." >&2
    exit 1
fi

# A base merge pushed while the old head's CI runs cancels it: warn, never refuse.
BASE_MERGE_WARNING="$HOOK_DIR/base_merge_warning.py"
if [[ -f "$BASE_MERGE_WARNING" ]]; then
    printf '%s\n' "$PUSHED_REFS" | "$PYTHON3_BIN" -I "$BASE_MERGE_WARNING" --pre-push --repo "$REPO_ROOT" || true
fi

SCANNER="$HOOK_DIR/lint_swift_namespaces.py"
MASKER="$HOOK_DIR/swift_source_mask.py"
if [[ ! -f "$SCANNER" || ! -f "$MASKER" ]]; then
    exit 0  # the namespace autofix is opt-in (install-git-hooks.sh --namespace-fix)
fi

before="$(git status --porcelain --untracked-files=normal)"
enum_roots=()
for d in Packages/Shared/CMUXMobileCore Packages/iOS/CmuxMobile* Packages/Shared/CmuxSyncStore ios/cmux; do
    [[ -d "$d" ]] && enum_roots+=("$d")
done
type_roots=()
for d in Packages/*/*/Sources ios/cmux; do
    [[ -d "$d" ]] && type_roots+=("$d")
done
"$PYTHON3_BIN" -I "$SCANNER" \
    --baseline scripts/lint-namespace-types-baseline.txt \
    --general-baseline scripts/lint-ios-package-conventions-baseline.txt \
    --ratchet scripts/lint-namespace-types-ratchet.txt \
    --fix \
    --enum-roots "${enum_roots[@]}" \
    --type-roots "${type_roots[@]}"
after="$(git status --porcelain --untracked-files=normal)"
if [[ "$before" != "$after" ]]; then
    echo "pre-push: namespace lint fixed files in this checkout." >&2
    echo "Review, stage, and commit those changes, then push again." >&2
    exit 1
fi
