#!/bin/bash
# cmux pre-push hook, installed by scripts/install-git-hooks.sh as a clone-local
# copy outside the checkout.
# 0. Clone-local extras (opt-in, off when unset): each absolute path in `git config --get-all cmux.prePushExtra`
#    (any config scope, `~` expanded) runs first, in order, from the top of the pushing worktree, as
#    `<path> <remote> <url>` with git's pushed-refs lines on stdin; a non-zero exit refuses the push. For a
#    clone's own rule (a merge freeze on a long-lived branch), so no one edits this installed copy: an edited
#    copy is never feat-cmux-next's, and the gate warns on every push. Add one with
#    `git config --add cmux.prePushExtra /abs/path/to/check` (it must be executable); remove them with
#    `git config --unset-all cmux.prePushExtra`. A relative path is refused (it would run from the checkout).
# 0a. Queue (always): at most CMUX_PREPUSH_SLOTS [2] hooks check at once on this Mac, whatever clone they push
#    from; the rest wait their turn (a line names the wait). On 2026-11-10 about nine agents' hooks ran at once at
#    load average 300-770: each `git worktree add` of a lint tree took 2-6 minutes, every gate ran past its limit
#    and no push finished. The wait never refuses a push: past CMUX_PREPUSH_QUEUE_WAIT_SECONDS [1800] the hook
#    runs anyway. A Mac that stays too loaded pushes through another one: scripts/cmux-next/push-from-host.sh.
# 0b. Checks refresh (a push to feat-cmux-next): scripts/git-hooks/refresh_checks.py.
# 1. Web lint (always): runs the web checks CI runs on what the push changes and
#    refuses the push when they fail. Skip once with
#    CMUX_WEB_LINT_SKIP_REASON="<the failing check and the base SHA where it also fails>".
# 2. cmux-next checks (always): scripts/cmux-next/prepush-gate.py runs the static
#    checks of the "cmux-next checks" CI job, ast-grep, SwiftFormat and SwiftLint
#    on what the push changes and refuses a push that adds a violation. Skip once with
#    CMUX_NEXT_CHECKS_SKIP_REASON="<check> fails in files this push does not touch".
# 3. Base-merge warning (always, never refuses): scripts/ci/base_merge_warning.py says when the push
#    merges the base into a branch whose old head still has CI running, which the push cancels.
# 4. Namespace autofix (opt-in): only when installed with --namespace-fix.
# Each run that checks commits ends with one `pre-push: hook times:` line on stderr (each phase's seconds and the
# total), then what a failure means: after a pass, a failure is git or GitHub (retry); a refusal names its phase.
# Pushes took 34-98 s on 2026-11-09 and nothing said whether the hook, git's pack step or GitHub was slow.
# A push whose every ref is a delete (`git push origin :refs/heads/x`) sends no commits: nothing above has
# anything to check, so it passes before any step, the work-tree lookup included (a clone without a work tree,
# a bare or core.bare one such as a shared clone root, deletes branches too). Any other ref runs every step.
set -euo pipefail

# Every check reads git's pushed-refs lines; read them once. $1 is the pushed remote (a name, or the URL of a
# push to a URL): the checks bound the push's own commits by its refs (cmux-next-checks/push_range.py).
PUSHED_REFS="$(cat)"
# Each check reads the refs from a file, never `printf | python`: on a Mac short of pipe memory a write into a
# pipe blocks for good (git_batch.py), and pushes hung in this hook for up to an hour on 2026-10-28.
REFS_FILE="$(mktemp "${TMPDIR:-/tmp}/cmux-pre-push-refs.XXXXXX")"
# Phase times, reported by the EXIT trap (header). Whole seconds: /bin/bash 3.2 on macOS has no EPOCHREALTIME.
# Phase names are single hyphenated words: the tests read "web lint" in the output as the web lint having run.
HOOK_STARTED=$SECONDS
TIMED=0
PHASE=""
PHASE_STARTED=0
PHASE_TIMES=""
phase() {  # phase NAME: end the running phase (if any) and start NAME; `phase ""` only ends it
    if [[ -n "$PHASE" ]]; then
        PHASE_TIMES="${PHASE_TIMES:+$PHASE_TIMES, }$PHASE $((SECONDS - PHASE_STARTED))s"
    fi
    PHASE="$1"
    PHASE_STARTED=$SECONDS
}
finish() {
    local status=$?
    rm -f "$REFS_FILE"
    (( TIMED )) || return 0
    local failed="$PHASE"
    phase ""
    echo "pre-push: hook times: ${PHASE_TIMES:-none}; total $((SECONDS - HOOK_STARTED))s" >&2
    if (( status == 0 )); then
        echo "pre-push: passed. git now packs and uploads: a failure after this line is git or GitHub, not a check." \
            "Retry it as AGENTS.md says (\"Retry a failed push\": git push -q, at most 3 retries, 30, 60, then 120 s apart)." >&2
    else
        echo "pre-push: refused in ${failed:-setup} (exit $status). A check that names a violation: fix it, do not retry" \
            "unchanged. The gate's \"ran past its ...s limit\" only: retry as AGENTS.md says (\"Retry a failed push\"), or push" \
            "through an idle Mac: scripts/cmux-next/push-from-host.sh <branch>." >&2
    fi
}
trap finish EXIT
# A signal must reach finish as a failure: on a fatal SIGTERM or SIGINT bash runs the EXIT trap with $? of the last
# command (0), and a hook stopped in the middle of a check printed "pre-push: passed" (review of #39787).
trap 'exit 143' TERM
trap 'exit 130' INT
printf '%s\n' "$PUSHED_REFS" > "$REFS_FILE"

# A delete-only push passes here (header). Each line is `<local ref> <local sha> <remote ref> <remote sha>`;
# git sends a delete with an all-zero local sha. On 2026-11-01 `git -C <clone root> push origin :refs/heads/x`
# from a clone without a work tree died below in `git rev-parse --show-toplevel` 738 times.
PUSHED_REF_COUNT=0
DELETED_REF_COUNT=0
while IFS=' ' read -r _ LOCAL_SHA _ _; do
    if [[ -z "$LOCAL_SHA" ]]; then
        continue
    fi
    PUSHED_REF_COUNT=$((PUSHED_REF_COUNT + 1))
    if [[ "$LOCAL_SHA" =~ ^0+$ ]]; then
        DELETED_REF_COUNT=$((DELETED_REF_COUNT + 1))
    fi
done < "$REFS_FILE"
if (( PUSHED_REF_COUNT > 0 && DELETED_REF_COUNT == PUSHED_REF_COUNT )); then
    exit 0
fi

TIMED=1  # a push with commits to check: report the phase times (header)
phase setup
HOOK_DIR="$(cd "${BASH_SOURCE[0]%/*}" && pwd -P)"
PYTHON_PATH_FILE="$HOOK_DIR/python3-path"
if [[ ! -r "$PYTHON_PATH_FILE" ]] || ! IFS= read -r PYTHON3_BIN < "$PYTHON_PATH_FILE" \
    || [[ "$PYTHON3_BIN" != /* ]] || [[ ! -x "$PYTHON3_BIN" ]]; then
    echo "pre-push: trusted Python interpreter metadata is missing; rerun scripts/install-git-hooks.sh." >&2
    exit 1
fi

# The queue (header, 0a). The hook runs again as the child of a python3 that holds one of the slot locks until
# the child exits, as install-git-hooks.sh holds install.lock: only that parent has the lock file open (Python
# opens it close-on-exec), so nothing a check starts can keep a slot after the hook ends. The locks are in /tmp,
# not $TMPDIR: every agent has its own $TMPDIR, and the queue is for the whole Mac. The program is a -c argument
# and free of single quotes (bash 5.1+ writes a here-document into a pipe first; see REFS_FILE above).
if [[ -z "${CMUX_PREPUSH_QUEUE_HELD:-}" ]]; then
    QUEUE_HOLDER='
import fcntl
import os
import signal
import subprocess
import sys
import time

directory, command = sys.argv[1], sys.argv[2:]


def number(name, default):
    try:
        return float(os.environ.get(name) or default)
    except ValueError:
        return float(default)


slots = max(1, int(number("CMUX_PREPUSH_SLOTS", 2)))
budget = number("CMUX_PREPUSH_QUEUE_WAIT_SECONDS", 1800)
started = time.monotonic()
held = None
told = False
while held is None:
    for slot in range(slots):
        path = os.path.join(directory, f"cmux-pre-push-queue.{os.getuid()}.{slot}.lock")
        try:
            lock = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)  # not inheritable (PEP 446)
        except OSError:
            continue
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            os.close(lock)
            continue
        held = lock
        break
    if held is not None:
        break
    waited = time.monotonic() - started
    if waited >= budget:
        print(f"pre-push: waited {waited:.0f}s for a turn (CMUX_PREPUSH_QUEUE_WAIT_SECONDS); checking now, beside "
              "the other pushes.", file=sys.stderr, flush=True)
        break
    if not told:
        told = True
        print(f"pre-push: {slots} other push(es) on this Mac are being checked; waiting for a turn (up to "
              f"{budget:g}s, CMUX_PREPUSH_SLOTS). Nothing is wrong with this push.", file=sys.stderr, flush=True)
    time.sleep(0.2)  # a poll: flock has no wait over several files, and a slot frees when its holder exits
waited = int(time.monotonic() - started)
child = subprocess.Popen(command, env={**os.environ, "CMUX_PREPUSH_QUEUE_HELD": str(waited)})
for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
    signal.signal(signum, lambda number, frame: child.send_signal(number))
code = child.wait()
sys.exit(code if code >= 0 else 128 - code)
'
    exec 3< "$REFS_FILE"
    rm -f "$REFS_FILE"
    exec "$PYTHON3_BIN" -I -c "$QUEUE_HOLDER" "${CMUX_PREPUSH_QUEUE_DIR:-/tmp}" "${BASH_SOURCE[0]}" "$@" <&3
fi
if [[ "$CMUX_PREPUSH_QUEUE_HELD" =~ ^[0-9]+$ ]]; then
    PHASE_TIMES="queue ${CMUX_PREPUSH_QUEUE_HELD}s"  # the wait for a turn, first in the hook-times line
fi
unset CMUX_PREPUSH_QUEUE_HELD  # a push a check starts (none does today) queues for itself

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

PUSHED_REMOTE="${1:-origin}"
CHECKS="$HOOK_DIR/cmux-next-checks"

# Clone-local extras first (header, step 0): a clone's own rule refuses before the slower checks run.
phase extras
EXTRAS_STATUS=0
EXTRAS="$(git config --path --get-all cmux.prePushExtra)" || EXTRAS_STATUS=$?
if (( EXTRAS_STATUS > 1 )); then  # 1 is "not set"; anything else is a config git cannot read
    echo "pre-push: cannot read cmux.prePushExtra (git config exit $EXTRAS_STATUS); fix this clone's git config." >&2
    exit 1
fi
if [[ -n "$EXTRAS" ]]; then
    # Read from a printf process, never a here-string: bash writes those into a pipe it reads itself (above).
    while IFS= read -r EXTRA; do
        [[ -n "$EXTRA" ]] || continue
        if [[ "$EXTRA" != /* ]]; then
            echo "pre-push: cmux.prePushExtra '$EXTRA' is not an absolute path; refusing the push." >&2
            exit 1
        fi
        if [[ ! -f "$EXTRA" || ! -x "$EXTRA" ]]; then
            echo "pre-push: cmux.prePushExtra '$EXTRA' is not an executable file (chmod +x it, or" \
                "git config --unset-all cmux.prePushExtra); refusing the push." >&2
            exit 1
        fi
        EXTRA_STATUS=0
        "$EXTRA" "$@" < "$REFS_FILE" || EXTRA_STATUS=$?
        if (( EXTRA_STATUS != 0 )); then
            echo "pre-push: cmux.prePushExtra $EXTRA refused the push (exit $EXTRA_STATUS)." >&2
            exit "$EXTRA_STATUS"
        fi
    done < <(printf '%s\n' "$EXTRAS")
fi

# The checks copy is refreshed from the fetched feat-cmux-next before a push to it (refresh_checks.py says why);
# it never refuses a push.
REFRESH="$HOOK_DIR/refresh_checks.py"
phase checks-refresh
if [[ -f "$REFRESH" ]]; then
    "$PYTHON3_BIN" -I "$REFRESH" --hook-dir "$HOOK_DIR" --repo "$REPO_ROOT" \
        --remote-url "${2:-}" < "$REFS_FILE" || true
fi

WEB_LINT="$HOOK_DIR/web_lint_prepush.py"
# The bounded tier supplies the first signal before any existing checker can dispatch fleet work.
# Its installed reviewed copy reads commit blobs; candidate tests run only in its disposable sandbox.
# A deadline or missing warm tool is deferred to the existing mandatory checks, never called a pass.
FAST_TIER="$CHECKS/prepush_fast_tier.py"
phase fast-tier
if [[ -f "$FAST_TIER" ]]; then
    "$PYTHON3_BIN" -I "$FAST_TIER" --repo "$REPO_ROOT" --remote "$PUSHED_REMOTE" < "$REFS_FILE"
fi
phase web-lint
if [[ -f "$WEB_LINT" ]]; then
    "$PYTHON3_BIN" -I "$WEB_LINT" --pre-push --repo "$REPO_ROOT" \
        --remote "$PUSHED_REMOTE" --trusted-scripts-dir "$CHECKS" < "$REFS_FILE"
else
    echo "pre-push: web lint helper is missing; rerun scripts/install-git-hooks.sh." >&2
    exit 1
fi

GATE="$HOOK_DIR/cmux_next_prepush_gate.py"
phase cmux-next-gate
if [[ -f "$GATE" ]]; then
    # The remote's URL ($2): the compile trailer rule applies only to a push to manaflow-ai/cmux's feat-cmux-next.
    CMUX_PREPUSH_REMOTE_URL="${2:-}" "$PYTHON3_BIN" -I "$GATE" --pre-push \
        --repo "$REPO_ROOT" --remote "$PUSHED_REMOTE" --trusted-scripts-dir "$CHECKS" < "$REFS_FILE"
else
    echo "pre-push: cmux-next checks gate is missing; rerun scripts/install-git-hooks.sh." >&2
    exit 1
fi

# A base merge pushed while the old head's CI runs cancels it: warn, never refuse.
BASE_MERGE_WARNING="$HOOK_DIR/base_merge_warning.py"
phase base-merge-warning
if [[ -f "$BASE_MERGE_WARNING" ]]; then
    "$PYTHON3_BIN" -I "$BASE_MERGE_WARNING" --pre-push --repo "$REPO_ROOT" < "$REFS_FILE" || true
fi

phase ""
SCANNER="$HOOK_DIR/lint_swift_namespaces.py"
MASKER="$HOOK_DIR/swift_source_mask.py"
if [[ ! -f "$SCANNER" || ! -f "$MASKER" ]]; then
    exit 0  # the namespace autofix is opt-in (install-git-hooks.sh --namespace-fix)
fi

phase namespace-autofix
before="$(git status --porcelain --untracked-files=normal)"
enum_roots=()
for d in Packages/Shared/CMUXMobileCore Packages/iOS/CmuxMobile* ios/cmux; do
    [[ -d "$d" ]] && enum_roots+=("$d")
done
type_roots=()
for d in Packages/*/*/Sources ios/cmux; do
    [[ -d "$d" ]] && type_roots+=("$d")
done
"$PYTHON3_BIN" -I "$SCANNER" \
    --baseline scripts/lint-namespace-types-baseline.txt \
    --general-baseline scripts/lint-ios-package-conventions-baseline.txt \
    --ratchet scripts/lint-namespace-types-ratchet.txt \
    --fix \
    --enum-roots "${enum_roots[@]}" \
    --type-roots "${type_roots[@]}"
after="$(git status --porcelain --untracked-files=normal)"
if [[ "$before" != "$after" ]]; then
    echo "pre-push: namespace lint fixed files in this checkout." >&2
    echo "Review, stage, and commit those changes, then push again." >&2
    exit 1
fi
