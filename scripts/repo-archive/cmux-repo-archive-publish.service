[Unit]
Description=Repo archive publisher (hq RFD 0065 piece 1; scripts/repo-archive/publish.sh)

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=idle
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# The store and its write keys; without a store the run publishes nothing.
EnvironmentFile=-%h/.config/cmux-repo-archive-publish.env
Environment=CMUX_REPO_ARCHIVE_SCRIPT=%h/Projects/cmux/scripts/repo-archive/publish.sh
ExecStart=/bin/bash -c 'exec bash "$${CMUX_REPO_ARCHIVE_SCRIPT}" < /dev/null'
TimeoutStartSec=45min
