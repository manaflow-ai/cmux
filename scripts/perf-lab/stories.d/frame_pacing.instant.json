{
  "id": "frame_pacing.instant",
  "tier": "T1",
  "description": "Frame-pacing instant mode (bench.sh --mode instant: the frame-pacing workflow's instant create bench, instant-new-surfaces-bench.py): Cmd-N, Cmd-T, Ctrl-`, Cmd-D and Cmd-Shift-D through the real key path, idle and with every core busy, key to the frame that shows the result, its dropped frames and its main-thread time, and the measured Cmd-W after each Cmd-T, light session.",
  "command": ["scripts/ci/frame-pacing/bench.sh", "--mode", "instant"],
  "session": "light",
  "engine": "none",
  "config": "bench",
  "metrics": [
    {"name": "cmd_t\\.[^.]+\\.dropped", "unit": "count", "better": "lower",
     "target_ref": {"target": "new-surface-frames"}},
    {"name": "cmd_n\\.[^.]+\\.dropped", "unit": "count", "better": "lower",
     "target_ref": {"target": "new-surface-frames"}},
    {"name": "cmd_w\\.[^.]+\\.dropped", "unit": "count", "better": "lower",
     "target_ref": {"target": "new-surface-frames"}},
    {"name": "(ctrl_backtick|cmd_d|cmd_shift_d)\\.light\\.dropped", "unit": "count", "better": "lower"},
    {"name": "[a-z_]+\\.light\\.load\\.dropped", "unit": "count", "better": "lower"},
    {"name": "cmd_n\\.light\\.key_to_frame", "unit": "ms", "better": "lower",
     "target_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/cmd_n\\..*/p95"},
     "floor_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/cmd_n\\..*/floor"}},
    {"name": "cmd_t\\.light\\.key_to_frame", "unit": "ms", "better": "lower",
     "target_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/cmd_t\\..*/p95"},
     "floor_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/cmd_t\\..*/floor"}},
    {"name": "ctrl_backtick\\.light\\.key_to_frame", "unit": "ms", "better": "lower",
     "target_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/ctrl_backtick\\..*/p95"},
     "floor_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/ctrl_backtick\\..*/floor"}},
    {"name": "cmd_d\\.light\\.key_to_frame", "unit": "ms", "better": "lower",
     "target_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/cmd_d\\..*/p95"},
     "floor_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/cmd_d\\..*/floor"}},
    {"name": "cmd_shift_d\\.light\\.key_to_frame", "unit": "ms", "better": "lower",
     "target_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/cmd_shift_d\\..*/p95"},
     "floor_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/cmd_shift_d\\..*/floor"}},
    {"name": "cmd_w\\.light\\.key_to_frame", "unit": "ms", "better": "lower"},
    {"name": "[a-z_]+\\.light\\.load\\.key_to_frame", "unit": "ms", "better": "lower"},
    {"name": "[a-z_]+\\.light(\\.load)?\\.(key_ms|confirmed|commit)", "unit": "ms", "better": "lower"},
    {"name": "cmd_w\\.light(\\.load)?\\.frame", "unit": "ms", "better": "lower"},
    {"name": "[a-z_]+\\.light(\\.load)?\\.[a-z_]+\\.missed_runs", "unit": "count", "better": "lower"}
  ],
  "repeats": 1,
  "seconds": 420,
  "needs": ["debug:debug.new_tab", "debug:debug.key", "debug:debug.frames", "debug:debug.action_budget"],
  "hot_paths": ["new-tab"],
  "owner": "PL-instant",
  "component": "Tabs>Create"
}
