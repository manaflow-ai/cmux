{
  "id": "launch-warm-realistic",
  "tier": "T1",
  "description": "Warm launch x5, realistic profile (24 seeded workspaces, a split and an agent chat): the daemon kept running and only the app quit before each launch; process start to the first window frame and the first live terminal frame. The launch.warm target is judged on the empty profile (launch-warm).",
  "command": ["scripts/cmux-next/bench-startup.py", "--profile", "realistic", "--mode", "warm", "--runs", "5",
              "--timeout", "60"],
  "session": "light",
  "engine": "none",
  "config": "bench",
  "metrics": [
    {"name": "launch\\.warm\\.first_window_frame_committed", "unit": "ms", "better": "lower"},
    {"name": "launch\\.warm\\.first_terminal_frame", "unit": "ms", "better": "lower"},
    {"name": "launch\\.warm\\.did_finish_launching_end", "unit": "ms", "better": "lower"},
    {"name": "launch\\.warm\\.sidebar_rows_shown", "unit": "ms", "better": "lower"},
    {"name": "launch\\.warm\\.[a-z_]+\\.missing_runs", "unit": "count", "better": "lower"}
  ],
  "repeats": 2,
  "seconds": 180,
  "needs": [],
  "owner": "Performance Lead",
  "component": "Launch"
}
