{
  "id": "idle-tabs-webkit",
  "tier": "T1",
  "description": "Idle wakeups with 10 static WebKit tabs (browser.defaultEngine webkit; each page reports WebKit as its engine, and the run is refused when Chromium started or any Chromium process runs) over 3 workspaces, 1 shown (bench_idle.py tabs-10, WebKit arm): app main run loop wakes/s, app, daemon and helper interrupt wakeups/s over 60 s, read only at the window's ends. The Chromium arm is idle-tabs.",
  "command": ["scripts/cmux-next/bench_idle.py", "--fresh", "--scenarios", "tabs-10", "--engine", "webkit"],
  "session": "light",
  "engine": "webkit",
  "config": "bench",
  "metrics": [
    {"name": "idle\\.tabs-10\\.app_daemon_wakeups_per_s", "unit": "per_s", "better": "lower",
     "target_ref": {"target": "idle-wakeups.webkit"},
     "floor_ref": {"path": "scripts/cmux-next/idle-budget.py", "key": "CRON_FLOORS/wakeups_per_s"}},
    {"name": "idle\\.tabs-10\\.main_wakes_per_s", "unit": "per_s", "better": "lower",
     "target_ref": {"target": "idle-wakeups.webkit"},
     "floor_ref": {"path": "scripts/cmux-next/idle-budget.py", "key": "CRON_FLOORS/main_wakes_per_s"}},
    {"name": "idle\\.tabs-10\\.app_wakeups_per_s", "unit": "per_s", "better": "lower",
     "target_ref": {"path": "scripts/cmux-next/idle-budget.json", "key": "/kinds/app/wakeups_per_s"},
     "floor_ref": {"path": "scripts/cmux-next/idle-budget.py", "key": "CRON_FLOORS/wakeups_per_s"}},
    {"name": "idle\\.tabs-10\\.daemon_wakeups_per_s", "unit": "per_s", "better": "lower",
     "target_ref": {"path": "scripts/cmux-next/idle-budget.json", "key": "/kinds/daemon/wakeups_per_s"},
     "floor_ref": {"path": "scripts/cmux-next/idle-budget.py", "key": "CRON_FLOORS/wakeups_per_s"}},
    {"name": "idle\\.tabs-10\\.helper_wakeups_per_s", "unit": "per_s", "better": "lower",
     "floor_ref": {"path": "scripts/cmux-next/idle-budget.py", "key": "CRON_FLOORS/wakeups_per_s"}}
  ],
  "repeats": 1,
  "seconds": 180,
