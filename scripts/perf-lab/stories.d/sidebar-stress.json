{
  "id": "sidebar-stress",
  "tier": "T1",
  "description": "Sidebar at 1,000 workspaces in groups, 5% of them ticking (sidebar-stress-bench.py): trackpad scroll event time with the ticks off and on, row click to idle, row drag mouse-move time, the scroll's hitch time ratio, and the main-thread time per tick.",
  "command": ["scripts/cmux-next/sidebar-stress-bench.py", "--sizes", "1000",
              "--scenarios", "ticks,scroll,scroll_ticking,switch,drag,hitches", "--stop"],
  "session": "stress",
  "engine": "none",
  "config": "bench",
  "metrics": [
    {"name": "sidebar_stress\\.[0-9]+\\.(scroll|scroll_ticking)\\.event_rpc", "unit": "ms", "better": "lower"},
    {"name": "sidebar_stress\\.[0-9]+\\.switch\\.click_to_idle", "unit": "ms", "better": "lower"},
    {"name": "sidebar_stress\\.[0-9]+\\.drag\\.post_rpc", "unit": "ms", "better": "lower"},
    {"name": "sidebar_stress\\.[0-9]+\\.scroll_hitches\\.hitch_ratio", "unit": "percent", "better": "lower"},
    {"name": "sidebar_stress\\.[0-9]+\\.ticks\\.main_per_tick", "unit": "ms", "better": "lower"}
  ],
  "repeats": 1,
  "seconds": 900,
  "needs": ["debug:debug.sidebar_rows", "debug:debug.mouse", "debug:debug.frames"],
  "owner": "a590",
  "component": "Sidebar>Stress"
}
