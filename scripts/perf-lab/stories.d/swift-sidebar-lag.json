{
  "id": "swift-sidebar-lag",
  "tier": "builder",
  "description": "SidebarLagTests over SidebarLagBench: main-thread CPU and configured rows per frame for a scroll, a pointer sweep, ticking agents and selection clicks at 150 and 500 workspaces.",
  "command": ["scripts/perf-lab/stories/swift_benches.py", "run", "--story", "swift-sidebar-lag", "--filter", "SidebarLagTests"],
  "session": "light",
