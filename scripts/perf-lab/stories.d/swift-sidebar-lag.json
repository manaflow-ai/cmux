  "metrics": [
    {"name": "swift\\.sidebar_lag\\.(scroll|hover|ticks|select)\\.[0-9]+\\.cpu", "unit": "ms", "better": "lower"},
    {"name": "swift\\.sidebar_lag\\.(scroll|hover|ticks|select)\\.[0-9]+\\.configures", "unit": "count", "better": "lower"}
  ],
  "repeats": 1,
  "seconds": 1200,
  "needs": ["file:Packages/macOS/CmuxNext/Tests/CmuxNextAppTests/SidebarLagBench.swift", "file:Packages/macOS/CmuxNext/Tests/CmuxNextTestSupport/PerfResultWriter.swift"],
