{
  "id": "frame_pacing.golden",
  "tier": "T1",
  "description": "Frame-pacing golden interactions (bench.sh --mode golden: golden.py drive and judge): New Tab cold and warm (lands in one step; the display frames each opened Cmd-T missed from 0.1 s before the key to 0.9 s after it, cold opening included, not the key-to-frame window of new-surface-frames), sidebar collapse and expand, transcript follow, a live window resize, the Reduce Motion path, a Chromium page in a live resize and a dark page load, each animated property sampled once per display frame, light session.",
  "command": ["scripts/ci/frame-pacing/bench.sh", "--mode", "golden"],
  "session": "light",
  "engine": "none",
  "config": "bench",
  "metrics": [
    {"name": "golden\\.[a-z_]+\\.pass", "unit": "ratio", "better": "higher"},
    {"name": "golden\\.sidebar_collapse\\.intermediate", "unit": "count", "better": "higher",
     "target_ref": {"path": "scripts/ci/frame-pacing/golden.py", "key": "THRESHOLDS/sidebar_collapse/min_intermediate"}},
    {"name": "golden\\.sidebar_collapse\\.max_step", "unit": "ratio", "better": "lower",
     "target_ref": {"path": "scripts/ci/frame-pacing/golden.py", "key": "THRESHOLDS/sidebar_collapse/max_step"}},
    {"name": "golden\\.sidebar_collapse\\.frame_periods", "unit": "unitless", "better": "lower",
     "target_ref": {"path": "scripts/ci/frame-pacing/golden.py", "key": "THRESHOLDS/sidebar_collapse/p95_frames"}},
    {"name": "golden\\.sidebar_expand\\.intermediate", "unit": "count", "better": "higher",
     "target_ref": {"path": "scripts/ci/frame-pacing/golden.py", "key": "THRESHOLDS/sidebar_expand/min_intermediate"}},
    {"name": "golden\\.sidebar_expand\\.max_step", "unit": "ratio", "better": "lower",
     "target_ref": {"path": "scripts/ci/frame-pacing/golden.py", "key": "THRESHOLDS/sidebar_expand/max_step"}},
    {"name": "golden\\.sidebar_expand\\.frame_periods", "unit": "unitless", "better": "lower",
     "target_ref": {"path": "scripts/ci/frame-pacing/golden.py", "key": "THRESHOLDS/sidebar_expand/p95_frames"}},
    {"name": "golden\\.transcript_follow\\.intermediate", "unit": "count", "better": "higher",
     "target_ref": {"path": "scripts/ci/frame-pacing/golden.py", "key": "THRESHOLDS/transcript_follow/min_intermediate"}},
    {"name": "golden\\.transcript_follow\\.max_step", "unit": "ratio", "better": "lower",
     "target_ref": {"path": "scripts/ci/frame-pacing/golden.py", "key": "THRESHOLDS/transcript_follow/max_step"}},
    {"name": "golden\\.transcript_follow\\.frame_periods", "unit": "unitless", "better": "lower",
     "target_ref": {"path": "scripts/ci/frame-pacing/golden.py", "key": "THRESHOLDS/transcript_follow/p95_frames"}},
    {"name": "golden\\.window_resize\\.intermediate", "unit": "count", "better": "higher",
     "target_ref": {"path": "scripts/ci/frame-pacing/golden.py", "key": "THRESHOLDS/window_resize/min_intermediate"}},
    {"name": "golden\\.window_resize\\.max_step", "unit": "ratio", "better": "lower",
     "target_ref": {"path": "scripts/ci/frame-pacing/golden.py", "key": "THRESHOLDS/window_resize/max_step"}},
    {"name": "golden\\.window_resize\\.frame_periods", "unit": "unitless", "better": "lower",
     "target_ref": {"path": "scripts/ci/frame-pacing/golden.py", "key": "THRESHOLDS/window_resize/p95_frames"}},
    {"name": "golden\\.transcript_follow\\.trail_max", "unit": "ratio", "better": "lower",
     "target_ref": {"path": "scripts/ci/frame-pacing/golden.py", "key": "THRESHOLDS/transcript_follow/max_trail"}},
    {"name": "golden\\.transcript_follow\\.trail_end", "unit": "ratio", "better": "lower",
     "target_ref": {"path": "scripts/ci/frame-pacing/golden.py", "key": "THRESHOLDS/transcript_follow/end_trail"}},
    {"name": "golden\\.window_resize\\.lag_frames", "unit": "count", "better": "lower"},
    {"name": "golden\\.new_tab_cold\\.intermediate", "unit": "count", "better": "lower",
     "target_ref": {"path": "scripts/ci/frame-pacing/golden.py", "key": "THRESHOLDS/new_tab_cold/max_intermediate"}},
    {"name": "golden\\.new_tab_warm\\.intermediate", "unit": "count", "better": "lower",
     "target_ref": {"path": "scripts/ci/frame-pacing/golden.py", "key": "THRESHOLDS/new_tab_warm/max_intermediate"}},
    {"name": "golden\\.reduce_new_tab\\.intermediate", "unit": "count", "better": "lower",
     "target_ref": {"path": "scripts/ci/frame-pacing/golden.py", "key": "THRESHOLDS/reduce_new_tab/max_intermediate"}},
    {"name": "golden\\.reduce_sidebar_collapse\\.intermediate", "unit": "count", "better": "lower",
     "target_ref": {"path": "scripts/ci/frame-pacing/golden.py", "key": "THRESHOLDS/reduce_sidebar_collapse/max_intermediate"}},
    {"name": "golden\\.reduce_sidebar_expand\\.intermediate", "unit": "count", "better": "lower",
     "target_ref": {"path": "scripts/ci/frame-pacing/golden.py", "key": "THRESHOLDS/reduce_sidebar_expand/max_intermediate"}},
    {"name": "golden\\.new_tab_(cold|warm)\\.dropped", "unit": "count", "better": "lower"},
    {"name": "golden\\.browser_resize\\.(host|window)_lag_frames", "unit": "count", "better": "lower"},
    {"name": "golden\\.browser_resize\\.layout_lag_frames", "unit": "unitless", "better": "lower"},
    {"name": "golden\\.browser_resize\\.stale_frames", "unit": "count", "better": "lower"},
    {"name": "golden\\.dark_load_flash\\.luminance_gain", "unit": "ratio", "better": "lower",
     "target_ref": {"path": "scripts/ci/frame-pacing/dark_load_flash.py", "key": "TOLERANCE/luminance"}},
    {"name": "golden\\.dark_load_flash\\.peak_gain", "unit": "ratio", "better": "lower",
     "target_ref": {"path": "scripts/ci/frame-pacing/dark_load_flash.py", "key": "TOLERANCE/peak"}}
  ],
  "repeats": 1,
  "seconds": 240,
  "needs": ["debug:debug.motion", "debug:debug.new_tab", "debug:debug.key", "debug:debug.agent_pane", "debug:debug.mouse", "debug:debug.layers", "debug:debug.layout_counters", "debug:debug.window_record", "debug:debug.themes"],
  "owner": "PL-motion-core",
  "component": "Layout>Motion"
}
