{
  "id": "launch-restore-warm",
  "tier": "T1",
  "description": "Corpus story launch-restore, warm x5: 60 saved workspaces (perf-corpus/launch-restore.json) restored with the daemon kept running and only the app quit before each launch; process start to the first window frame, the first live terminal frame and the live sidebar rows, and each launch must restore the story's checkpoint state.",
  "command": ["scripts/cmux-next/bench-startup.py", "--corpus", "perf-corpus/launch-restore.json", "--mode", "warm",
              "--runs", "5", "--timeout", "60"],
  "session": "corpus:launch-restore",
  "engine": "none",
  "config": "bench",
  "metrics": [
    {"name": "corpus\\.launch_restore\\.warm\\.first_window_frame_committed", "unit": "ms", "better": "lower"},
    {"name": "corpus\\.launch_restore\\.warm\\.first_terminal_frame", "unit": "ms", "better": "lower"},
    {"name": "corpus\\.launch_restore\\.warm\\.did_finish_launching_end", "unit": "ms", "better": "lower"},
    {"name": "corpus\\.launch_restore\\.warm\\.sidebar_rows_shown", "unit": "ms", "better": "lower"},
    {"name": "corpus\\.launch_restore\\.warm\\.[a-z_]+\\.missing_runs", "unit": "count", "better": "lower"},
    {"name": "corpus\\.launch_restore\\.warm\\.checkpoint_mismatch_runs", "unit": "count", "better": "lower"}
  ],
  "repeats": 2,
  "seconds": 240,
  "needs": ["debug:debug.focus", "debug:debug.surfaces", "debug:debug.window_frame"],
  "owner": "PL-perf-lab",
  "component": "Launch>Restore"
}
