{
  "id": "motion",
  "tier": "T1",
  "description": "perf-budgets families panes (4x2 light) and new_surfaces (Cmd-N, Cmd-T, Ctrl-`, Cmd-D, Cmd-Shift-D key to visible) (the perf cron's motion part).",
  "command": ["scripts/cmux-next/perf-budgets.py", "--only=panes,new_surfaces"],
  "session": "light",
  "engine": "none",
  "config": "bench",
  "metrics": [
    {"name": "panes\\.[^.]+\\.(?!stress\\.)[^.]+\\.frame", "unit": "ms", "better": "lower",
     "target_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/panes\\..*\\.frame/p95"},
     "floor_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/panes\\..*\\.frame/floor"}},
    {"name": "cmd_n\\.[^.]+\\.key_to_visible", "unit": "ms", "better": "lower",
     "target_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/cmd_n\\..*/p95"},
     "floor_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/cmd_n\\..*/floor"}},
    {"name": "cmd_t\\.[^.]+\\.key_to_visible", "unit": "ms", "better": "lower",
     "target_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/cmd_t\\..*/p95"},
     "floor_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/cmd_t\\..*/floor"}},
    {"name": "ctrl_backtick\\.[^.]+\\.key_to_visible", "unit": "ms", "better": "lower",
     "target_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/ctrl_backtick\\..*/p95"},
     "floor_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/ctrl_backtick\\..*/floor"}},
    {"name": "cmd_d\\.[^.]+\\.key_to_visible", "unit": "ms", "better": "lower",
     "target_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/cmd_d\\..*/p95"},
     "floor_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/cmd_d\\..*/floor"}},
    {"name": "cmd_shift_d\\.[^.]+\\.key_to_visible", "unit": "ms", "better": "lower",
     "target_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/cmd_shift_d\\..*/p95"},
     "floor_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/cmd_shift_d\\..*/floor"}}
  ],
  "repeats": 1,
  "seconds": 900,
  "needs": [],
  "hot_paths": ["new-tab"],
  "owner": "PL-motion-core",
  "component": "Layout>Motion",
  "perf_cron_part": "motion"
}
