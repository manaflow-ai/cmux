{
  "id": "action-sweep-light-1",
  "tier": "T1",
  "description": "Every catalog action through its real entrypoint (effective shortcut via debug.key, else action.run), input to committed frame from the action.perform and action.commit signposts, light session, shard 1 of 4 of the action ids (every-action-sweep.py --shard 1/4); shard 1 also times the non-catalog interactions in its own report.",
  "command": [
    "scripts/cmux-next/every-action-sweep.py",
    "--sessions",
    "light",
    "--shard",
    "1/4",
    "--story",
    "action-sweep-light-1"
  ],
  "session": "light",
  "engine": "chromium",
  "config": "bench",
  "metrics": [
    {
      "name": "action\\..+\\.light\\.commit",
      "unit": "ms",
      "better": "lower",
      "target_ref": {
        "path": "scripts/cmux-next/every-action-sweep.py",
        "key": "TARGET_COMMIT_MS"
      }
    },
    {
      "name": "actions\\.over_budget",
      "unit": "count",
      "better": "lower"
    }
  ],
  "repeats": 1,
  "seconds": 1800,
  "needs": [
    "debug:debug.key",
    "debug:debug.frames",
    "debug:debug.hangs",
    "debug:debug.closed_ids",
    "debug:debug.cef",
    "signpost:actionPerform",
    "signpost:actionCommit"
  ],
  "owner": "PL-instant",
  "component": "Actions>Latency"
}
