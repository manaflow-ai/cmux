  "session": "light",
  "engine": "chromium",
  "config": "bench",
  "metrics": [
    {"name": "new_browser_tab\\.light\\.[a-z_]+\\.(visible|chrome|page|key_ms)", "unit": "ms", "better": "lower"},
    {"name": "new_browser_tab\\.light\\.[a-z_]+\\.visible_frame", "unit": "count", "better": "lower"},
    {"name": "new_browser_tab\\.light\\.[a-z_]+\\.[a-z_]+\\.missed_runs", "unit": "count", "better": "lower"}
  ],
  "repeats": 1,
  "seconds": 150,
  "needs": ["debug:debug.new_tab", "debug:debug.key", "debug:debug.surfaces"],
  "owner": "PL-cef-tab",
  "component": "Browser>NewTab"
