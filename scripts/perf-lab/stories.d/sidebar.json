{
  "id": "sidebar",
  "tier": "T1",
  "description": "perf-budgets family sidebar at 400 workspaces: scroll, drag and ticking frames, ticking CPU, and the workspace-switch matrix (the perf cron's sidebar part).",
  "command": ["scripts/cmux-next/perf-budgets.py", "--only=sidebar"],
  "session": "light",
  "engine": "none",
  "config": "bench",
  "metrics": [
    {"name": "sidebar\\.[0-9]+\\.(scroll|scroll_while_ticking|drag)\\.frame", "unit": "ms", "better": "lower",
     "target_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/sidebar\\.\\d+\\.(scroll|scroll_while_ticking|drag)\\.frame/p95"},
     "floor_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/sidebar\\.\\d+\\.(scroll|scroll_while_ticking|drag)\\.frame/floor"}},
    {"name": "sidebar\\.[0-9]+\\.ticking\\.frame", "unit": "ms", "better": "lower",
     "target_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/sidebar\\.\\d+\\.ticking\\.frame/p95"},
     "floor_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/sidebar\\.\\d+\\.ticking\\.frame/floor"}},
    {"name": "sidebar\\.[0-9]+\\.ticking\\.main_ms_per_s", "unit": "ms", "better": "lower",
     "target_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/sidebar\\.\\d+\\.ticking\\.main_ms_per_s/p95"},
     "floor_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/sidebar\\.\\d+\\.ticking\\.main_ms_per_s/floor"}},
    {"name": "sidebar\\.[0-9]+\\.ticking\\.cpu_pct", "unit": "percent", "better": "lower",
     "target_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/sidebar\\.\\d+\\.ticking\\.cpu_pct/p95"},
     "floor_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/sidebar\\.\\d+\\.ticking\\.cpu_pct/floor"}},
    {"name": "sidebar\\.[0-9]+\\.workspace_switch\\.click_to_idle", "unit": "ms", "better": "lower",
     "target_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/sidebar\\.\\d+\\.workspace_switch\\..*/p95"},
     "floor_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/sidebar\\.\\d+\\.workspace_switch\\..*/floor"}},
    {"name": "workspace_switch\\.[^.]+\\.input_to_idle", "unit": "ms", "better": "lower",
     "target_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/workspace_switch\\..*\\.input_to_idle/p95"},
     "floor_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/workspace_switch\\..*\\.input_to_idle/floor"}},
    {"name": "workspace_switch\\.[^.]+\\.input_to_commit", "unit": "ms", "better": "lower",
     "target_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/workspace_switch\\..*\\.input_to_commit/p95"},
     "floor_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/workspace_switch\\..*\\.input_to_commit/floor"}},
    {"name": "workspace_switch\\.[^.]+\\.longest_frame", "unit": "ms", "better": "lower",
     "target_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/workspace_switch\\..*\\.longest_frame/p95"},
     "floor_ref": {"path": "scripts/cmux-next/perf-budgets.json", "key": "/rows/workspace_switch\\..*\\.longest_frame/floor"}}
  ],
  "repeats": 1,
  "seconds": 1500,
  "needs": ["debug:debug.workspace_switch"],
  "owner": "a590",
  "component": "Sidebar",
  "perf_cron_part": "sidebar"
}
