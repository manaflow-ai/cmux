{
  "_doc": "Perf-lab sheriff subscriptions (alerts.py; p12-perf-process.md 3.5), the analog of chromeperf's sheriff Subscription (catapult dashboard/dashboard/protobuf/sheriff.proto). Only a series an entry matches can alert; every other series is stored and shown, never alerted. `match` maps series fields (story, metric, engine, host_class, build_config) to fnmatch globs; the first matching entry owns the series and its owner (an OWNERS.md lane) gets the alert group. `anomaly_config` overrides catapult's AnomalyConfig defaults (max_window_size 50, min_segment_size 6, min_absolute_change 0, min_relative_change 0.1, min_steppiness 0.5, multiple_of_std_dev 2.5) for that entry; never widen one to clear an alert (R3), de-noise the series instead. `targets` names targets.json ids for the target_miss tile. Per-action sweep series (action.<id>.<session>.commit) and per-op daemon series are not subscribed: they feed the monitored aggregates below. Debug-config series never alert.",
  "build_configs": ["bench", "bench-checks", "release"],
  "subscriptions": [
    {"name": "target-key-frame", "kind": "target", "owner": "PL-typing",
     "match": {"story": "terminal-key-to-frame*", "metric": "key_to_frame_ms"},
     "targets": ["key-frame-p50", "key-frame-p99"]},
    {"name": "target-home-omnibar-key-frame", "kind": "target", "owner": "PL-typing",
     "match": {"story": "home-*key-to-frame*", "metric": "key_to_frame_ms"},
     "targets": ["key-frame-p50", "key-frame-p99"]},
    {"name": "target-blocking-sites", "kind": "target", "owner": "PL-blocking",
     "match": {"story": "blocking-sites", "build_config": "bench-checks"},
     "targets": ["blocking-sites"]},
    {"name": "target-main-turn", "kind": "target", "owner": "PL-telemetry",
     "match": {"metric": "main_turn_ms"},
     "targets": ["main-turn-p99"]},
    {"name": "target-motion-drops", "kind": "target", "owner": "PL-motion-core",
     "match": {"story": "motion-*", "metric": "dropped_frames"},
     "targets": ["motion-dropped-frames"]},
    {"name": "target-idle-wakeups", "kind": "target", "owner": "Performance Lead",
     "match": {"story": "idle-wakeups-*", "metric": "wakeups_per_s*"},
     "targets": ["idle-wakeups-app-daemon", "idle-wakeups-main"]},
    {"name": "target-launch", "kind": "target", "owner": "Performance Lead",
     "match": {"story": "launch-*", "metric": "launch_ms"},
     "targets": ["launch-cold", "launch-warm"]},
    {"name": "target-new-surface-frames", "kind": "target", "owner": "PL-instant",
     "match": {"story": "new-surfaces-*", "metric": "missed_frames"},
     "targets": ["new-surfaces-missed-frames"]},
    {"name": "target-hangs", "kind": "target", "owner": "PL-telemetry",
     "match": {"metric": "hangs_over_250ms"},
     "targets": ["hangs-over-250ms"]},
    {"name": "target-chromium-crash-survival", "kind": "target", "owner": "PL-cef-helper",
     "match": {"story": "chromium-crash-survival", "metric": "survival_rate"},
     "targets": ["chromium-crash-survival"]},
    {"name": "target-qos", "kind": "target", "owner": "Performance Lead",
     "match": {"story": "qos-*", "metric": "*_count"},
     "targets": ["qos-undeclared", "qos-inversions"]},
    {"name": "target-leaf-build", "kind": "target", "owner": "PL-arch",
     "match": {"story": "build-incremental-leaf", "metric": "build_s"},
     "targets": ["incremental-leaf-build"]},
    {"name": "target-hidden-workspace-memory", "kind": "target", "owner": "PL-memory",
     "match": {"story": "memory-hidden*", "metric": "memory.hidden_slope"},
     "targets": ["memory-slope"]},

    {"name": "hot-cef-host-input", "kind": "perf-hot", "owner": "PL-cef-helper",
     "match": {"story": "chromium-host-input*"}},
    {"name": "hot-home-key", "kind": "perf-hot", "owner": "PL-typing",
     "match": {"metric": "home.typing.*"}},
    {"name": "hot-palette-key", "kind": "perf-hot", "owner": "Performance Lead",
     "match": {"metric": "palette.*"}},
    {"name": "hot-omnibar-key", "kind": "perf-hot", "owner": "Performance Lead",
     "match": {"story": "omnibar-*"}},
    {"name": "hot-motion-frame", "kind": "perf-hot", "owner": "PL-motion-core",
     "match": {"metric": "panes.*.frame"}},
    {"name": "hot-frame-tick", "kind": "perf-hot", "owner": "Performance Lead",
     "match": {"metric": "anim.*.frame"}},
    {"name": "hot-drag-frame", "kind": "perf-hot", "owner": "Performance Lead",
     "match": {"story": "drag-lag*"}},
    {"name": "hot-tab-switch", "kind": "perf-hot", "owner": "PL-switch",
     "match": {"metric": "tab_switch.*"}},
    {"name": "hot-workspace-switch", "kind": "perf-hot", "owner": "PL-switch",
     "match": {"metric": "workspace_switch.*"}},
    {"name": "hot-cef-geometry", "kind": "perf-hot", "owner": "PL-motion-cef",
     "match": {"story": "cef-geometry*"}},
    {"name": "hot-cmd-tab", "kind": "perf-hot", "owner": "PL-switch",
     "match": {"story": "cmd-tab*"}},
    {"name": "hot-new-tab", "kind": "perf-hot", "owner": "PL-cef-tab",
     "match": {"metric": "cmd_t.*"}},
    {"name": "hot-action-budget", "kind": "perf-hot", "owner": "PL-instant",
     "match": {"story": "action-budget-monitor*"}},

    {"name": "family-new-surfaces", "kind": "family", "owner": "PL-instant",
     "match": {"metric": "family.new_surfaces.*"}},
    {"name": "family-panes", "kind": "family", "owner": "PL-motion-core",
     "match": {"metric": "family.panes.*"}},
    {"name": "family-tab-switch", "kind": "family", "owner": "PL-switch",
     "match": {"metric": "family.tab_switch.*"}},
    {"name": "family-palette", "kind": "family", "owner": "Performance Lead",
     "match": {"metric": "family.palette.*"}},
    {"name": "family-sidebar", "kind": "family", "owner": "a590",
     "match": {"metric": "family.sidebar.*"}},
    {"name": "family-home", "kind": "family", "owner": "PL-typing",
     "match": {"metric": "family.home.*"}},
    {"name": "family-acp", "kind": "family", "owner": "PL-acpmux",
     "match": {"metric": "family.acp.*"}},
    {"name": "family-idle", "kind": "family", "owner": "Performance Lead",
     "match": {"metric": "family.idle.*"}},
    {"name": "family-anim", "kind": "family", "owner": "PL-motion-core",
     "match": {"metric": "family.anim.*"}},

    {"name": "aggregate-action-sweep", "kind": "aggregate", "owner": "PL-instant",
     "match": {"metric": "actions.over_budget"}},
    {"name": "aggregate-daemon-ops", "kind": "aggregate", "owner": "PL-daemon",
     "match": {"metric": "daemon.ops.*"}}
  ]
}
