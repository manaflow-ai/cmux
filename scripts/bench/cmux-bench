#!/usr/bin/env python3
"""cmux-bench: run a registered bench, record its rows in the ledger, compare two runs.

  cmux-bench list [--json]                       every bench: what it measures, units, owner, hosts
  cmux-bench NAME [--build B] [--host H] [--arg K=V]... [--json] [--no-ledger] [--dry-run]
                                                 run NAME and append its rows to the ledger
  cmux-bench NAME --import PATH [--build B] [--host-name N]
                                                 record a harness output you already have (a log or artifact)
  cmux-bench compare A B [--bench NAME] [--json|--markdown] [--threshold PCT] [--fail-on-regression]
  cmux-bench runs [--bench NAME] [--limit N] [--json]
  cmux-bench show RUN [--json]
  cmux-bench nightly [--benches a,b] [--repo OWNER/REPO] [--no-issue]
                                                 run the nightly benches on the newest NIGHTLY, compare each
                                                 with the NIGHTLY before, and open one issue for regressions
  cmux-bench ledger pull|push|path
  cmux-bench for-paths FILE... | --diff BASE | --stdin [--json|--markdown]
                                                 the benches, targeted tests and check templates a change's paths
                                                 need (docs/benches/relevance-map.toml); an unmapped path warns
  cmux-bench for-paths --coverage [--days 7]     % of the paths merged in the last N days a mapping covers
  cmux-bench for-paths --write | --check         regenerate (or check) the map's [[unit]] section from the layout

--build:  nightly (default; the newest NIGHTLY in the live feed) | DEV | <sha> | release:VERSION | local
--host:   fleet (a fleet Mac through cmux-ci, alone on its worker) | local-readonly (read-only probes of
          apps already running here: never builds, launches or quits anything) | anywhere (no app at all)
"""
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from benchlib import compare as cmp  # noqa: E402
from benchlib.bench import BenchError, Context, parse_build, resolve_nightly  # noqa: E402
from benchlib.ledger import Ledger, LedgerError  # noqa: E402
from benchlib.registry import load_all  # noqa: E402
from benchlib.schema import SchemaError  # noqa: E402

ISSUE_REPO = "manaflow-ai/cmuxterm-hq"


def cmd_list(args: argparse.Namespace) -> int:
    benches = load_all()
    if args.json:
        print(json.dumps([{"name": b.name, "summary": b.summary, "units": b.units, "owner": b.owner,
                           "hosts": list(b.hosts), "harness": b.harness, "version": b.version,
                           "nightly": b.nightly} for b in benches.values()], indent=2))
        return 0
    rows = [("bench", "measures", "units", "hosts", "owner", "harness")]
    for b in benches.values():
        rows.append((b.name + (" *" if b.nightly else ""), b.summary, b.units, ",".join(b.hosts), b.owner, b.harness))
    widths = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
    for i, r in enumerate(rows):
        print("  ".join(c.ljust(widths[j]) for j, c in enumerate(r)).rstrip())
        if i == 0:
            print("  ".join("-" * w for w in widths))
    print("\n* runs against each new NIGHTLY (cmux-bench nightly)")
    return 0


def _parse_kv(pairs: list[str]) -> dict[str, str]:
    out = {}
    for p in pairs:
        if "=" not in p:
            raise BenchError(f"--arg {p!r}: expected KEY=VALUE")
        k, v = p.split("=", 1)
        out[k] = v
    return out


def _bench_flags(rest: list[str]) -> dict[str, str]:
    """A bench's own flags: `--compare-zip URL` or `--compare-zip=URL` is --arg compare_zip=URL."""
    out: dict[str, str] = {}
    i = 0
    while i < len(rest):
        tok = rest[i]
        if not tok.startswith("--") or tok == "--":
            raise BenchError(f"unexpected argument {tok!r}")
        key, eq, val = tok[2:].partition("=")
        if not eq:
            if i + 1 < len(rest) and not rest[i + 1].startswith("--"):
                val, i = rest[i + 1], i + 1
            else:
                val = "1"
        key = key.replace("-", "_")
        out[key] = f"{out[key]},{val}" if key in out else val
        i += 1
    return out


def run_bench(name: str, build_spec: str | None, host: str | None, kv: dict[str, str], *, import_path: str | None = None,
              host_name: str | None = None, dry_run: bool = False) -> Context:
    benches = load_all()
    if name not in benches:
        raise BenchError(f"no bench named {name!r}; `cmux-bench list` shows them")
    bench = benches[name]
    host = host or bench.hosts[0]
    if import_path is None and host not in bench.hosts:
        raise BenchError(f"{name} runs on {', '.join(bench.hosts)}, not {host}")
    build = parse_build(build_spec)
    if import_path and build_spec is None:
        # An import is not the newest NIGHTLY unless the caller says so; a bench whose file names its build
        # (xbench) sets it in ingest. Never let an old file become BENCH@nightly.
        build = {"channel": "other", "version": None, "sha": None}
    elif build.pop("pending", False):
        try:
            build.update(resolve_nightly())
        except OSError as err:
            print(f"cmux-bench: warning: could not read the NIGHTLY feed ({err}); version unknown", file=sys.stderr)
    for key in ("version", "sha"):
        if kv.get(f"build_{key}"):
            build[key] = kv[f"build_{key}"]
    ctx = Context(bench=bench, build=build, host_role=host, args=kv, dry_run=dry_run)
    if host_name:
        ctx.host["name"] = host_name
    if import_path:
        bench.ingest(ctx, Path(import_path))
    else:
        bench.run(ctx)
    return ctx


def cmd_run(name: str, argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog=f"cmux-bench {name}")
    p.add_argument("--build")
    p.add_argument("--host", choices=["fleet", "local-readonly", "anywhere"])
    p.add_argument("--arg", action="append", default=[], metavar="KEY=VALUE")
    p.add_argument("--json", action="store_true")
    p.add_argument("--no-ledger", action="store_true", help="print the rows, record nothing")
    p.add_argument("--import", dest="import_path", metavar="PATH")
    p.add_argument("--host-name", help="with --import: the machine the file came from")
    p.add_argument("--dry-run", action="store_true", help="print the fleet command, run nothing")
    a, rest = p.parse_known_args(argv)
    try:
        kv = _parse_kv(a.arg)
        kv.update(_bench_flags(rest))
        ctx = run_bench(name, a.build, a.host, kv, import_path=a.import_path, host_name=a.host_name,
                        dry_run=a.dry_run)
    except BenchError as err:
        print(f"cmux-bench: {err}", file=sys.stderr)
        return 0 if a.dry_run and str(err) == "dry run" else 2
    for note in ctx.notes:
        print(f"cmux-bench: note: {note}", file=sys.stderr)
    if not ctx.rows:
        print(f"cmux-bench: {name} produced no rows", file=sys.stderr)
        return 1
    where = None
    if not a.no_ledger:
        try:
            where = Ledger().append(ctx.rows)
        except LedgerError as err:
            print(f"cmux-bench: ledger: {err} (the run is kept in the local ledger; `cmux-bench ledger push` retries)",
                  file=sys.stderr)
    if a.json:
        print(json.dumps(ctx.rows, indent=2))
    else:
        print(f"{ctx.run_id}  {cmp.build_label({'build': ctx.build})}  on {ctx.host.get('name')}")
        for r in ctx.rows:
            lab = cmp.label_text(r)
            extra = f"  p50 {cmp._fmt(r['p50'])}  p95 {cmp._fmt(r['p95'])}  n={r['n']}" if r.get("n") else ""
            print(f"  {r['metric']}{lab}: {cmp._fmt(r['value'])} {r['unit']}{extra}")
        if where:
            print(f"recorded: {where}")
    return 0


def _ledger_runs(pull: bool = True) -> list[dict]:
    led = Ledger()
    if pull:
        try:
            led.pull()
        except LedgerError as err:
            print(f"cmux-bench: ledger: {err} (reading the local copy)", file=sys.stderr)
    return led.runs()


def cmd_compare(a: argparse.Namespace) -> int:
    runs = _ledger_runs(not a.no_pull)
    try:
        ra = cmp.resolve(a.a, runs, a.bench)
        rb = cmp.resolve(a.b, runs, a.bench)
    except cmp.SelectorError as err:
        print(f"cmux-bench: {err}", file=sys.stderr)
        return 2
    benches = load_all()
    bench = benches.get(rb["bench"])
    result = cmp.compare(ra, rb, getattr(bench, "thresholds", {}), a.threshold, getattr(bench, "floors", {}))
    if a.json:
        print(json.dumps(result, indent=2))
    elif a.markdown:
        print(cmp.render_markdown(result))
    else:
        print(cmp.render(result))
    return 1 if a.fail_on_regression and result["regressions"] else 0


def cmd_runs(a: argparse.Namespace) -> int:
    runs = _ledger_runs(not a.no_pull)
    if a.bench:
        runs = [r for r in runs if r["bench"] == a.bench]
    runs = runs[-a.limit:]
    if a.json:
        print(json.dumps([{k: r[k] for k in ("run_id", "bench", "build", "host", "harness", "timestamp")}
                          | {"rows": len(r["rows"])} for r in runs], indent=2))
        return 0
    for r in runs:
        print(f"{r['run_id']}  {r['bench']:<12} {cmp.build_label(r):<36} {r['host'].get('name', ''):<16} {len(r['rows'])} rows")
    return 0


def cmd_show(a: argparse.Namespace) -> int:
    runs = _ledger_runs(not a.no_pull)
    try:
        run = cmp.resolve(a.run, runs, a.bench)
    except cmp.SelectorError as err:
        print(f"cmux-bench: {err}", file=sys.stderr)
        return 2
    if a.json:
        print(json.dumps(run["rows"], indent=2))
    else:
        print(f"{run['run_id']}  {cmp.build_label(run)}  on {run['host'].get('name')}  ({run['harness'].get('version')})")
        for r in run["rows"]:
            print(f"  {r['metric']}{cmp.label_text(r)}: {cmp._fmt(r['value'])} {r['unit']}")
    return 0


def cmd_nightly(a: argparse.Namespace) -> int:
    benches = load_all()
    names = a.benches.split(",") if a.benches else [n for n, b in benches.items() if b.nightly]
    nightly = resolve_nightly()
    report, failures = [], []
    for name in names:
        bench = benches[name]
        try:
            host = bench.nightly_args.get("host") or ("fleet" if "fleet" in bench.hosts else bench.hosts[0])
            ctx = run_bench(name, "nightly", host, {k: v for k, v in bench.nightly_args.items() if k != "host"})
            if not ctx.rows:
                failures.append(f"{name}: no rows ({'; '.join(ctx.notes)})")
                continue
        except (BenchError, SchemaError) as err:
            failures.append(f"{name}: {err}")
            continue
        try:
            Ledger().append(ctx.rows)
        except LedgerError as err:
            # The run is committed locally; compare against it anyway and push with the next run.
            failures.append(f"{name}: recorded locally, not pushed: {err}")
        runs = _ledger_runs(False)
        try:
            prev = cmp.resolve(f"{name}@nightly~1", runs)
        except cmp.SelectorError:
            print(f"{name}: first NIGHTLY measured, nothing to compare")
            continue
        cur = cmp.resolve(ctx.run_id, runs)
        result = cmp.compare(prev, cur, bench.thresholds, floors=bench.floors)
        print(cmp.render(result))
        if result["regressions"]:
            report.append((name, result))
    if report and not a.no_issue:
        version = nightly.get("version") or "unknown"
        title = f"bench: NIGHTLY {version} regressed {', '.join(n for n, _ in report)}"
        body = [f"`cmux-bench nightly` found regressions past threshold on NIGHTLY {version}.", ""]
        for name, result in report:
            body += [f"### {name}", "", cmp.render_markdown(result), "",
                     f"Reproduce: `scripts/bench/cmux-bench compare {name}@nightly~1 {name}@nightly`", ""]
        if failures:
            body += ["### Benches that did not finish", ""] + [f"- {f}" for f in failures]
        existing = subprocess.run(["gh", "issue", "list", "-R", a.repo, "--state", "open", "--search",
                                   f"in:title \"{title}\"", "--json", "number", "-q", ".[0].number"],
                                  text=True, capture_output=True)
        if existing.stdout.strip():
            print(f"already filed: {a.repo}#{existing.stdout.strip()}")
        else:
            subprocess.run(["gh", "issue", "create", "-R", a.repo, "--title", title, "--body", "\n".join(body)], check=False)
    for f in failures:
        print(f"cmux-bench: nightly: {f}", file=sys.stderr)
    return 1 if report or failures else 0


def cmd_ledger(a: argparse.Namespace) -> int:
    led = Ledger()
    if a.action == "path":
        print(led.root)
    elif a.action == "pull":
        led.pull()
    elif a.action == "push":
        led._ensure_clone()
        led.push()
    return 0


def _render_plan(plan: dict, markdown: bool) -> str:
    out: list[str] = []
    h = "### " if markdown else ""
    code = (lambda s: f"`{s}`") if markdown else (lambda s: s)  # noqa: E731
    out.append(f"{h}Relevance: {len(plan['paths'])} paths, {len(plan['areas'])} areas, "
               f"{len(plan['benches'])} benches, {len(plan['tests'])} tests, {len(plan['unmapped'])} unmapped")
    for a in plan["areas"]:
        if a["kind"] != "area":
            continue
        out.append(f"- area {a['name']} ({len(a['paths'])} paths)" + (f"; budget: {a['budget']}" if a["budget"] else ""))
        if a["benches"]:
            out.append("    benches: " + ", ".join(code(b) for b in a["benches"]))
    units = [a["name"] for a in plan["areas"] if a["kind"] == "unit"]
    if units:
        out.append("- units: " + ", ".join(code(u) for u in units))
    if plan["tests"]:
        out.append(f"{h}Targeted tests" if markdown else "tests:")
        out += [f"- {code(t)}" if markdown else f"  {t}" for t in plan["tests"]]
    if plan["ci_steps"]:
        out.append(("- " if markdown else "") + "CI steps the PR routes (ci/steps.toml): "
                   + ", ".join(code(s) for s in plan["ci_steps"]))
    if plan["templates"]:
        out.append(f"{h}Check templates" if markdown else "templates:")
        out += [f"- {t['situation']}: {code(t['template'])} ({len(t['paths'])} paths)" for t in plan["templates"]]
    if plan["unmapped"]:
        out.append(f"{h}Unmapped (area default, fail open)" if markdown else "unmapped (area default, fail open):")
        out += [f"- {code(p)}" if markdown else f"  {p}" for p in plan["unmapped"][:50]]
    return "\n".join(out)


def cmd_for_paths(argv: list[str]) -> int:
    import hashlib
    import os
    import time

    from benchlib import relevance

    p = argparse.ArgumentParser(prog="cmux-bench for-paths")
    p.add_argument("paths", nargs="*")
    p.add_argument("--diff", metavar="BASE", help="the paths of `git diff --name-only BASE...HEAD`")
    p.add_argument("--stdin", action="store_true", help="paths one a line on stdin")
    p.add_argument("--map", type=Path, default=relevance.MAP)
    p.add_argument("--json", action="store_true")
    p.add_argument("--markdown", action="store_true")
    p.add_argument("--coverage", action="store_true")
    p.add_argument("--days", type=int, default=7)
    p.add_argument("--write", action="store_true")
    p.add_argument("--check", action="store_true")
    a = p.parse_args(argv)
    if a.write or a.check:
        before = a.map.read_text(encoding="utf-8")
        changed = relevance.rewrite(a.map)
        if a.check and changed:
            a.map.write_text(before, encoding="utf-8")
            print(f"cmux-bench: {a.map} [[unit]] section is stale: run scripts/bench/cmux-bench for-paths --write",
                  file=sys.stderr)
            return 1
        print(("wrote " if changed else "fresh: ") + str(a.map))
        return 0
    try:
        index = relevance.load(a.map)
    except (OSError, relevance.MapError) as err:
        # Fail open: no map means every path takes its default, never a block.
        print(f"cmux-bench: for-paths: {err}; every path takes its area default", file=sys.stderr)
        index = relevance.Index([])
    if a.coverage:
        refs = ("origin/feat-cmux-next", "origin/main")
        heads = subprocess.run(["git", "rev-parse", *refs], cwd=relevance.ROOT, capture_output=True, text=True).stdout.split()
        key = hashlib.sha256(f"{a.days}:{time.strftime('%Y-%m-%d')}:{' '.join(heads)}".encode()).hexdigest()[:16]
        cache = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "cmux-bench" / f"merged-paths-{key}.json"
        if cache.is_file():
            changes = json.loads(cache.read_text())
        else:
            changes = relevance.merged_changes(a.days, refs)
            cache.parent.mkdir(parents=True, exist_ok=True)
            cache.write_text(json.dumps(changes))
        result = relevance.coverage(index, changes)
        if a.json:
            print(json.dumps(result, indent=2))
        else:
            print(f"{result['changes']} merged changes, {result['paths']} changed paths in {a.days} days: "
                  f"{result['mapped_pct']}% mapped ({result['area_pct']}% by a hand area, {result['unit_pct']}% by a unit), "
                  f"{result['checked_pct']}% checked (a mapping that names a test or bench, or a test file itself)")
            for k, n in result["top_misses"]:
                print(f"  unmapped  {n:6d}  {k}")
            for k, n in result["top_unchecked"]:
                print(f"  unchecked {n:6d}  {k}")
        return 0
    paths = list(a.paths)
    if a.stdin:
        paths += [line.strip() for line in sys.stdin if line.strip()]
    if a.diff:
        res = subprocess.run(["git", "diff", "--name-only", f"{a.diff}...HEAD"], cwd=relevance.ROOT,
                             capture_output=True, text=True)
        if res.returncode != 0:
            print(f"cmux-bench: for-paths: git diff {a.diff}...HEAD failed: {res.stderr.strip()}", file=sys.stderr)
            return 2
        paths += res.stdout.split()
    plan = relevance.plan(index, list(dict.fromkeys(paths)))
    if a.json:
        print(json.dumps(plan, indent=2, ensure_ascii=False))
    else:
        print(_render_plan(plan, a.markdown))
    for d in plan["defaults"]:
        print(f"cmux-bench: for-paths: warning: {d} has no mapping; add one to {a.map.name}", file=sys.stderr)
    return 0


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    head = argv[0]
    if head == "for-paths":
        return cmd_for_paths(argv[1:])
    if head == "list":
        p = argparse.ArgumentParser(prog="cmux-bench list")
        p.add_argument("--json", action="store_true")
        return cmd_list(p.parse_args(argv[1:]))
    if head in ("compare", "runs", "show", "nightly", "ledger"):
        p = argparse.ArgumentParser(prog=f"cmux-bench {head}")
        if head == "compare":
            p.add_argument("a")
            p.add_argument("b")
            p.add_argument("--bench")
            p.add_argument("--threshold", type=float, default=cmp.DEFAULT_THRESHOLD)
            p.add_argument("--json", action="store_true")
            p.add_argument("--markdown", action="store_true")
            p.add_argument("--fail-on-regression", action="store_true")
            p.add_argument("--no-pull", action="store_true")
        elif head == "runs":
            p.add_argument("--bench")
            p.add_argument("--limit", type=int, default=30)
            p.add_argument("--json", action="store_true")
            p.add_argument("--no-pull", action="store_true")
        elif head == "show":
            p.add_argument("run")
            p.add_argument("--bench")
            p.add_argument("--json", action="store_true")
            p.add_argument("--no-pull", action="store_true")
        elif head == "nightly":
            p.add_argument("--benches")
            p.add_argument("--repo", default=ISSUE_REPO)
            p.add_argument("--no-issue", action="store_true")
        else:
            p.add_argument("action", choices=["pull", "push", "path"])
        a = p.parse_args(argv[1:])
        return {"compare": cmd_compare, "runs": cmd_runs, "show": cmd_show, "nightly": cmd_nightly,
                "ledger": cmd_ledger}[head](a)
    return cmd_run(head, argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
