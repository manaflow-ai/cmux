#!/usr/bin/env python3
"""ci-why: is my pull request green, what is it waiting on, and is each red mine or the base's?

    scripts/ci-why [PR | PR URL] [--repo OWNER/REPO] [--status] [--json]

With no PR it finds the open pull request for the current branch. It prints one line per check on the
head commit that is not green or still running, and for each red asks scripts/ci/base_red_excuse.py
(the classifier our merge tooling uses) whether that check fails the same way on the base branch:

    base red   the same job fails the same way on the base (same failed steps and tests): not yours
    yours      it fails only on your PR: fix it
    rerun      cancelled, timed out, refused by its runner or lost: rerun the same commit
    update     the base has since fixed it: merge the base into your branch
    not yet    the base has no comparable run yet, or a read was cut short: ask again later

It uses your own `gh` login. Reads are conditional (ETag) and kept under ~/.cache/cmux-ci-why, so asking
again about an unchanged PR costs GitHub almost nothing; it reads once and exits, never polls. `--status`
skips the base comparison (only green / red / waiting). Opt-in: nothing runs unless you run it, and it
never comments, labels, reruns or merges.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CLASSIFIER = ROOT / "scripts" / "ci" / "base_red_excuse.py"
CACHE = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "cmux-ci-why"
GH_SECONDS = 60
JUDGE_SECONDS = int(os.environ.get("CI_WHY_JUDGE_SECONDS", "300"))

ACT = ("yours", "rerun", "update")  # verdicts that ask something of the PR's author
GREEN = {"success", "neutral", "skipped"}
RED = {"failure", "timed_out", "cancelled", "action_required", "startup_failure", "stale", "error"}  # "error": a status
NOT_YET_HINTS = ("re-check once", "no verdict yet", "incomplete")
RERUN_HINTS = ("infra, not a verdict", "re-run", "rerun", "re-ran", "refused at setup", "lost")


class GhError(Exception):
    pass


def gh(args: list[str], timeout: int = GH_SECONDS) -> str:
    try:
        done = subprocess.run(["gh", *args], capture_output=True, text=True, timeout=timeout,
                              stdin=subprocess.DEVNULL)
    except FileNotFoundError as error:
        raise GhError("gh is not installed: https://cli.github.com, then `gh auth login`") from error
    except subprocess.TimeoutExpired as error:
        raise GhError(f"gh {' '.join(args[:2])} took over {timeout} s") from error
    if done.returncode != 0:
        raise GhError((done.stderr or done.stdout).strip() or f"gh exited {done.returncode}")
    return done.stdout


def get(route: str):
    """ROUTE's JSON by a conditional read: a 304 answers from the copy kept under CACHE (free on GitHub's
    rate limit), a 200 refreshes it."""
    store = CACHE / "etags" / (hashlib.sha256(route.encode()).hexdigest()[:32] + ".json")
    try:
        kept = json.loads(store.read_text(encoding="utf-8"))
        if kept.get("route") != route:
            kept = None
    except (OSError, ValueError):
        kept = None
    args = ["api", "--include", route]
    if kept and kept.get("etag"):
        args[2:2] = ["-H", f"If-None-Match: {kept['etag']}"]
    try:
        said = gh(args)
    except GhError as error:
        if kept and "304" in str(error):  # some gh versions exit non-zero on a 304
            return kept["body"]
        raise
    head, _, body = said.replace("\r\n", "\n").partition("\n\n")
    status = re.match(r"HTTP/[0-9.]+ ([0-9]{3})", head)
    if status and status.group(1) == "304" and kept:
        return kept["body"]
    found = json.loads(body)
    etag = next((line.split(":", 1)[1].strip() for line in head.splitlines()[1:]
                 if line.lower().startswith("etag:")), "")
    if etag:
        try:
            store.parent.mkdir(parents=True, exist_ok=True)
            tmp = store.with_name(f".{store.name}.{os.getpid()}")
            tmp.write_text(json.dumps({"route": route, "etag": etag, "body": found}), encoding="utf-8")
            os.replace(tmp, store)
        except OSError:
            pass
    return found


def default_repo() -> str:
    try:
        url = subprocess.run(["git", "-C", str(ROOT), "remote", "get-url", "origin"], capture_output=True,
                             text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        url = ""
    found = re.search(r"github\.com[:/]([^/]+/[^/]+?)(?:\.git)?$", url)
    return found.group(1) if found else "manaflow-ai/cmux"


def find_pr(repo: str, given: str | None) -> int:
    if given:
        found = re.search(r"/pull/(\d+)", given) or re.fullmatch(r"#?(\d+)", given.strip())
        if not found:
            raise GhError(f"not a pull request number or URL: {given}")
        return int(found.group(1))
    branch = subprocess.run(["git", "branch", "--show-current"], capture_output=True, text=True).stdout.strip()
    if not branch:
        raise GhError("no PR given and no current branch: pass a PR number")
    pulls = get(f"repos/{repo}/pulls?state=open&head={repo.split('/')[0]}:{branch}&per_page=5")
    if pulls:
        return int(pulls[0]["number"])
    raise GhError(f"no open PR for branch {branch} in {repo}: pass a PR number")


def checks_at(repo: str, sha: str) -> list[dict]:
    """Every check on SHA as {name, state, url}: check runs (newest per name) and commit statuses."""
    runs: dict[str, dict] = {}
    page = 1
    while True:
        said = get(f"repos/{repo}/commits/{sha}/check-runs?per_page=100&page={page}")
        for run in said.get("check_runs", []):
            name = run.get("name", "")
            if name not in runs or run.get("id", 0) > runs[name].get("id", 0):
                runs[name] = run
        if page * 100 >= said.get("total_count", 0) or page >= 10:
            break
        page += 1
    found = [{"name": name, "state": run.get("conclusion") or run.get("status") or "queued",
              "url": run.get("html_url") or run.get("details_url") or ""} for name, run in runs.items()]
    combined = get(f"repos/{repo}/commits/{sha}/status?per_page=100")
    for status in combined.get("statuses", []):
        found.append({"name": status.get("context", ""), "state": status.get("state", "pending"),
                      "url": status.get("target_url") or ""})
    return sorted(found, key=lambda check: check["name"].lower())


def strip_name(why: str, name: str) -> str:
    """WHY without the classifier's leading "'NAME': ", which the line already shows."""
    return why.removeprefix(f"'{name}': ").removeprefix(f"'{name}' ")


def judge(repo: str, base: str, sha: str, name: str) -> tuple[str, str]:
    """(verdict, why) for one red check, from the shared classifier."""
    env = dict(os.environ, BASE_RED_EXCUSE_ETAGS=str(CACHE / "etags"),
               BASE_RED_EXCUSE_DEADLINE_SECONDS=str(JUDGE_SECONDS))
    try:
        done = subprocess.run([sys.executable, str(CLASSIFIER), "--repo", repo, "--base", base, "--sha", sha,
                               "--check", name], capture_output=True, text=True, env=env,
                              timeout=JUDGE_SECONDS + 30, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return "not yet", f"the base comparison took over {JUDGE_SECONDS} s; ask again later"
    said = (done.stdout.strip().splitlines() or [""])[0] if done.returncode == 0 else ""
    error = (done.stderr.strip().splitlines() or [""])[-1]
    if done.returncode == 0:
        return "base red", strip_name(said.removeprefix("excused "), name) or f"fails the same way on {base}"
    if done.returncode == 3:
        return "not yet", "GitHub rate-limited the read; ask again in a few minutes"
    why = strip_name(error.removeprefix("not excused: "), name)
    if any(hint in why for hint in NOT_YET_HINTS):
        return "not yet", why
    if why.startswith("fixed on base"):
        return "update", why
    if any(hint in why.lower() for hint in RERUN_HINTS):
        return "rerun", why
    return "yours", why or f"fails only on this PR, not on {base}"


def collapsed(names) -> list[tuple[str, int]]:
    """NAMES with shards folded: "web / react-apps-check (1)" .. "(12)" read as one line with a count."""
    counts: dict[str, int] = {}
    for name in names:
        key = re.sub(r" \(\d+\)$", "", name)
        counts[key] = counts.get(key, 0) + 1
    return list(counts.items())


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("pr", nargs="?", help="PR number or URL (default: the current branch's open PR)")
    parser.add_argument("--repo", default=None, help="OWNER/REPO (default: this checkout's origin)")
    parser.add_argument("--status", action="store_true", help="green / red / waiting only; no base comparison")
    parser.add_argument("--json", action="store_true", help="print one JSON object")
    args = parser.parse_args(argv)
    repo = args.repo or default_repo()
    try:
        number = find_pr(repo, args.pr)
        pull = get(f"repos/{repo}/pulls/{number}")
        sha, base = pull["head"]["sha"], pull["base"]["ref"]
        checks = checks_at(repo, sha)
    except (GhError, KeyError, ValueError) as error:
        print(f"ci-why: {error}", file=sys.stderr)
        return 2
    reds = [check for check in checks if check["state"] in RED]
    waiting = [check for check in checks if check["state"] not in RED | GREEN]
    green = len(checks) - len(reds) - len(waiting)
    if args.status:
        verdicts = [("red", "")] * len(reds)
    else:
        with ThreadPoolExecutor(max_workers=4) as pool:
            verdicts = list(pool.map(lambda check: judge(repo, base, sha, check["name"]), reds))
    for check, (verdict, why) in zip(reds, verdicts):
        check["verdict"], check["why"] = verdict, why
    if args.json:
        print(json.dumps({"repo": repo, "pr": number, "sha": sha, "base": base, "green": green,
                          "red": reds, "waiting": waiting}, indent=2))
        return 1 if any(check["verdict"] in ACT for check in reds) else 0
    mine = sum(check["verdict"] in ACT for check in reds)
    print(f"{repo}#{number} at {sha[:10]} into {base}: {green} green, {len(reds)} red"
          + ("" if args.status else f" ({sum(c['verdict'] == 'base red' for c in reds)} base, {mine} yours to act on)")
          + f", {len(waiting)} waiting")
    for check in reds:
        line = f"  {check['verdict']:<9} {check['name']}"
        why = check["why"] if len(check["why"]) <= 220 else check["why"][:217] + "..."
        print(line + (f": {why}" if why else ""))
        if check["verdict"] != "base red" and check["url"]:
            print(f"            {check['url']}")
    for name, count in collapsed(check["name"] for check in waiting):
        print(f"  waiting   {name}" + (f" (x{count})" if count > 1 else ""))
    if not reds and not waiting:
        print("  all green")
    return 1 if mine else 0


if __name__ == "__main__":
    raise SystemExit(main())
