{
 "id": "scroll-tui",
 "priority": "P2",
 "title": "SCROLL less and nvim/vim: per-frame time and missed 120 Hz refreshes while wheel and trackpad scroll a 50k-line file in full-screen programs",
 "why": "NIGHTLY REGRESSION cmux-ad m85/m86/m87 (2026-11-10): terminal scroll A/B of nightly ffffff979a1a vs 85b099928a8a and the 5-point bisect; same journeys for GHOSTTY INTEGRATION. Fleet minis only.",
 "source": "debug.mouse scroll (phase = trackpad) + debug.frames start/stop raw",
 "budget_seconds": 200,
 "steps": [
  {
   "do": "wait",
   "seconds": 3,
   "title": "the fresh profile's first window"
  },
  {
   "do": "base_terminal",
   "title": "the focused terminal the journey scrolls"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "type",
   "text": "seq -f 'L%06g-${nonce}' 1 50000 | tee /tmp/scrolltui-${nonce}.txt",
   "enter": true,
   "mark": "fill",
   "title": "50k lines of scrollback (and the same file for less and vim)"
  },
  {
   "do": "expect",
   "title": "the 50k lines arrived and the prompt is back",
   "since": "fill",
   "timeout": 90,
   "all": [
    {
     "daemon_line": "L050000-${nonce}"
    },
    {
     "daemon_prompt": true
    }
   ]
  },
  {
   "do": "mouse",
   "action": "move",
   "title": "the pointer over the pane, once (the bursts send hover: false)"
  },
  {
   "do": "type",
   "text": "clear; less /tmp/scrolltui-${nonce}.txt",
   "enter": true,
   "mark": "less",
   "title": "less on the 50k-line file"
  },
  {
   "do": "expect",
   "title": "less shows the file's first rows",
   "since": "less",
   "timeout": 15,
   "all": [
    {
     "pane_frame_text": "L000002-${nonce}"
    }
   ]
  },
  {
   "do": "rpc",
   "method": "debug.surfaces",
   "params": {},
   "title": "SURF0 less-wheel 1"
  },
  {
   "do": "rpc",
   "method": "debug.frames",
   "params": {
    "action": "start"
   },
   "title": "frames start less-wheel 1"
  },
  {
   "do": "mouse",
   "action": "scroll",
   "dy": -12,
   "hover": false,
   "count": 120,
   "interval": 0.008,
   "title": "wheel less-wheel 1"
  },
  {
