{
 "id": "sidebar-rows-film-grow-50",
 "priority": "P2",
 "title": "SIDEBAR ROWS film, grow motion (sidebar.insertMotion spring): 50 rows, 10 Cmd-N + 10 Cmd-Shift-W, and 10 + 10 with no workspace switch",
 "why": "cmux-ad m23: the contract asks the new row to grow from 0; the shipped default (snap, #28205) fades it in at full height. Until the lead rules, both motions are filmed (INSTANT OWNER 00:1xZ).",
 "source": "scripts/cmux-next/sidebar-instant-rows-live.py (debug.sidebar_rows motion), played on an exact fleet build with real keys (debug.key)",
 "budget_seconds": 250,
 "require_hz": 120,
 "steps": [
  {
   "do": "wait",
   "seconds": 3,
   "title": "the fresh profile's first window"
  },
  {
   "do": "new_terminal",
   "via": "key"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "marker_install"
  },
  {
   "do": "type",
   "text": "${marker} film-${nonce}-$((6*7))",
   "enter": true,
   "mark": "typed"
  },
  {
   "do": "expect",
   "title": "set-up check: the app types (its result does not decide the films)",
   "since": "typed",
   "timeout": 10,
   "all": [
    {
     "daemon_line": "film-${nonce}-42"
    },
    {
     "app_text_line": "film-${nonce}-42"
    },
    {
     "frame_marker": "film-${nonce}-42"
    }
   ]
  },
  {
   "do": "film_grow",
   "count": 50,
   "title": "50 workspaces"
  },
  {
   "do": "film_tunable",
   "key": "sidebar.insertMotion",
   "value": "spring",
   "title": "the grow motion: new rows open from height 0 on .move"
  },
  {
   "do": "film_presses",
   "scenario": "grow-light-50",
   "pairs": 10,
   "title": "grow, 50 rows: 10 Cmd-N + 10 Cmd-Shift-W"
  },
  {
   "do": "film_presses",
   "scenario": "grow-noswitch-50",
   "mode": "noswitch",
   "pairs": 10,
   "title": "grow, 50 rows, no workspace switch"
  },
  {
   "do": "film_tunable",
   "key": "sidebar.insertMotion",
   "value": null,
   "title": "back to the default"
  },
  {
   "do": "expect",
   "title": "both films recorded",
   "timeout": 5,
   "all": [
    {
     "film_recorded": {
      "scenario": "grow-light-50",
      "presses": 20
     }
    },
    {
     "film_recorded": {
      "scenario": "grow-noswitch-50",
      "presses": 20
     }
    }
   ]
  }
 ]
}
