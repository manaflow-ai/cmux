{
 "id": "page-handled-cmd-b-pagekey",
 "priority": "P0",
 "title": "With the page window key: a page that handles Cmd-B keeps it (no toggleSidebar), and an unhandled Cmd-F opens cmux Find; values recorded",
 "why": "reopen-f4 unhandled-key (after STATUS 8273): proves the page gets the key first and the unhandled report runs the held action.",
 "source": "REOPEN VIDEO for reopen-f4 (unhandled-key sub-agent a7ef7985776024ba0)",
 "budget_seconds": 200,
 "steps": [
  {
   "do": "require_whole_host"
  },
  {
   "do": "wait",
   "seconds": 5,
   "title": "set-up: Home finishes its first load"
  },
  {
   "do": "key",
   "key": "n",
   "modifiers": [
    "cmd"
   ]
  },
  {
   "do": "wait",
   "seconds": 2
  },
  {
   "do": "key",
   "key": "`",
   "modifiers": [
    "control"
   ]
  },
  {
   "do": "focused_terminal",
   "as": "term"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "type",
   "text": "echo t-${nonce}-$((6*7))",
   "enter": true,
   "mark": "t"
  },
  {
   "do": "expect",
   "title": "set-up: the terminal works",
   "since": "t",
   "timeout": 10,
   "all": [
    {
     "daemon_line": "t-${nonce}-42"
    }
   ]
  },
  {
   "do": "key_state",
   "name": "term-before",
   "title": "control: the terminal has the keyboard; sidebar state, key window"
  },
  {
   "do": "hid_key",
   "key": "b",
   "modifiers": [
    "cmd"
   ],
   "mark": "term-cmdb",
   "title": "control: a real HID Cmd-B in the terminal"
  },
  {
   "do": "wait",
   "seconds": 1.5
  },
  {
   "do": "key_state",
   "name": "term-after",
   "title": "control: sidebar state after Cmd-B, action_budget rows"
  },
  {
   "do": "expect",
   "title": "control: the real Cmd-B toggled the sidebar from the terminal (the HID key path works)",
   "timeout": 5,
   "all": [
    {
     "sidebar_changed": {
      "from": "term-before"
     }
    }
   ]
  },
  {
   "do": "hid_key",
   "key": "b",
   "modifiers": [
    "cmd"
   ],
   "mark": "term-cmdb2",
   "title": "control: a second real Cmd-B puts the sidebar back"
  },
  {
   "do": "wait",
   "seconds": 1.5
  },
  {
   "do": "key_state",
   "name": "term-restored",
   "budget": false
  },
  {
   "do": "page_server",
   "var": "page_url",
   "lines": [
    "<!doctype html><title>pd</title><body><p id=m>pagekeyzq waiting</p>",
    "<script>document.addEventListener('keydown',function(e){if(e.metaKey&&!e.shiftKey&&e.key==='b'){e.preventDefault();document.getElementById('m').textContent='pagekeyzq gotbold';}});</script></body>"
   ],
   "title": "a local page that handles Cmd-B itself (preventDefault, shows gotbold) and no other key"
  },
  {
   "do": "outwait_hold"
  },
  {
   "do": "key",
   "key": "l",
   "modifiers": [
    "cmd",
    "shift"
   ],
   "mark": "bar",
   "title": "Cmd-Shift-L opens a browser tab from the terminal"
  },
  {
   "do": "expect",
   "title": "the address bar takes the keys",
   "since": "bar",
   "timeout": 15,
   "all": [
    {
     "key_window_focus": {
      "in": [
       "addressBar"
      ]
     }
    }
   ]
  },
  {
   "do": "type",
   "text": "${page_url}",
   "mark": "url"
  },
  {
   "do": "key",
   "key": "return",
   "modifiers": [],
   "mark": "loaded"
  },
  {
   "do": "expect",
   "title": "the plain page loaded and has the keyboard",
   "since": "loaded",
   "timeout": 20,
   "all": [
    {
     "key_window_focus": {
      "in": [
       "browserPage"
      ]
     }
    },
    {
     "frame_text": "pagekeyzq waiting"
    }
   ]
  },
  {
   "do": "wait",
   "seconds": 2
  },
  {
   "do": "key_state",
   "name": "page-before",
   "title": "TEST A: sidebar state with the page focused"
  },
  {
   "do": "rpc_try",
   "method": "debug.key",
   "params": {
    "sequence": [
     {
      "key_code": 55,
      "down": true
     },
     {
      "key_code": 11,
      "down": true
     },
     {
      "key_code": 11,
      "down": false
     },
     {
      "key_code": 55,
      "down": false
     }
    ],
    "key_window": "page"
   },
   "title": "Cmd-B with the page window key: the page handles it"
  },
  {
   "do": "wait",
   "seconds": 1.5
  },
  {
   "do": "key_state",
   "name": "page-after-handled-cmdb",
   "title": "after the handled Cmd-B: sidebar must be unchanged, no new toggleSidebar row"
  },
  {
   "do": "rpc_try",
   "method": "debug.key",
   "params": {
    "last": true
   }
  },
  {
   "do": "frame_text_probe",
   "name": "gotbold",
   "text": "gotbold",
   "title": "did the page get Cmd-B (it shows gotbold)"
  },
  {
   "do": "rpc_try",
   "method": "debug.key",
   "params": {
    "sequence": [
     {
      "key_code": 55,
      "down": true
     },
     {
      "key_code": 3,
      "down": true
     },
     {
      "key_code": 3,
      "down": false
     },
     {
      "key_code": 55,
      "down": false
     }
    ],
    "key_window": "page"
   },
   "title": "Cmd-F with the page window key: the page does not handle it"
  },
  {
   "do": "wait",
   "seconds": 1.5
  },
  {
   "do": "key_state",
   "name": "page-after-cmdf",
   "title": "after the unhandled Cmd-F: a find row, focus"
  },
  {
   "do": "rpc_try",
   "method": "debug.key",
   "params": {
    "last": true
   }
  },
  {
   "do": "frame_text_probe",
   "name": "after-cmdf",
   "text": "pagekeyzq",
   "title": "frame after Cmd-F (evidence)"
  }
 ],
 "finally": [
  {
   "do": "input_journal",
   "name": "inputjournal",
   "last": 400
  },
  {
   "do": "key_state",
   "name": "final",
   "budget": false
  }
 ]
}
