  {
   "do": "require_whole_host"
  },
  {
   "do": "wait",
   "seconds": 5,
   "title": "set-up: Home finishes its first load"
  },
  {
   "do": "key",
   "key": "n",
   "modifiers": [
    "cmd"
   ]
  },
  {
   "do": "wait",
   "seconds": 2
  },
  {
   "do": "key",
   "key": "`",
   "modifiers": [
    "control"
   ]
  },
  {
   "do": "focused_terminal",
   "as": "term"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "type",
   "text": "echo t-${nonce}-$((6*7))",
   "enter": true,
   "mark": "t"
  },
  {
   "do": "expect",
   "title": "set-up: the terminal works",
   "since": "t",
   "timeout": 10,
   "all": [
    {
     "daemon_line": "t-${nonce}-42"
    }
   ]
  },
  {
   "do": "outwait_hold"
  },
  {
   "do": "key",
   "key": "l",
   "modifiers": [
    "cmd",
    "shift"
   ],
   "mark": "browser"
  },
  {
   "do": "expect",
   "title": "set-up: Cmd-Shift-L opens a browser tab whose address bar takes the keys",
