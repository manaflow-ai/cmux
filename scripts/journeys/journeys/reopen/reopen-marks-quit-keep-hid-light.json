{
 "id": "reopen-marks-quit-keep-hid-light",
 "priority": "P1",
 "title": "REOPEN (no film, app marks and exact state): a real Cmd-Q (Keep Sessions), then reopen, light profile",
 "why": "REOPEN VIDEO while no film source is allowed (cmux-ad 01:30Z): the app's own launch marks (launch.visible_terminals_drawn, launch_terminals per pane, first_window_frame_committed) and the exact state before and after. Not film evidence.",
 "source": "REOPEN VIDEO (STATUS 4269, 4276)",
 "budget_seconds": 250,
 "steps": [
  {
   "do": "require_whole_host",
   "title": "a real key and the display film need a whole-host lease"
  },
  {
   "do": "wait",
   "seconds": 5,
   "title": "set-up: Home finishes its first load"
  },
  {
   "do": "new_terminal",
   "via": "key",
   "as": "main"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "type",
   "text": "seq -f 'rv-${nonce}-%g' 1 400",
   "enter": true,
   "mark": "lines"
  },
  {
   "do": "expect",
   "title": "set-up: 400 lines (scrollback)",
   "since": "lines",
   "timeout": 20,
   "all": [
    {
     "daemon_line": "rv-${nonce}-400"
    }
   ]
  },
  {
   "do": "key",
   "key": "d",
   "modifiers": [
    "cmd"
   ]
  },
  {
   "do": "focused_terminal",
   "as": "right"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "type",
   "text": "echo right-${nonce}-$((6*7))",
   "enter": true,
   "mark": "right"
  },
  {
   "do": "expect",
   "title": "set-up: the split answers",
   "since": "right",
   "timeout": 10,
   "all": [
    {
     "daemon_line": "right-${nonce}-42"
    }
   ]
  },
  {
   "do": "seed_workspaces",
   "count": 2,
   "prefix": "rv-${nonce}-ws"
  },
  {
   "do": "reopen_video",
   "count": 5,
   "how": "quit-keep-hid",
   "title": "no film: a real Cmd-Q (Keep) and reopen, 5 cycles",
   "film": false
  },
  {
   "do": "expect",
   "title": "REOPEN-F4: every marker key typed after each reopen (the first as soon as the window is listed) reached its terminal exactly once",
   "timeout": 2,
   "all": [
    {
     "reopen_keys_received": {}
    }
   ]
  },
  {
   "do": "require_drawable",
   "title": "the window is on screen (frame checks)"
  },
  {
   "do": "expect",
   "title": "after the cycles: the split's text is back",
   "timeout": 30,
   "all": [
    {
     "daemon_line": "right-${nonce}-42"
    },
    {
     "app_text_line": "right-${nonce}-42"
    },
    {
     "frame_text": "right-${nonce}-42"
    }
   ]
  }
 ],
 "finally": [
  {
   "do": "close_seeded",
   "prefix": "rv-${nonce}-ws"
  }
 ]
}
