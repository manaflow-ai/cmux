{
 "id": "reopen-browser-plain-keys",
 "priority": "P1",
 "title": "After Cmd-Q (Keep) and reopen with a browser page (focused text field) focused: plain keys typed after the restored page loaded reach it (cycle A); plain keys typed as soon as the main window is listed reach it, in order (cycle B)",
 "why": "Diagnostic for reopen-f4 (lead STATUS 6493, review of #32207): reopen-browser-first-key cycle 4 loses every plain key typed at once after the reopen. Cycle A tells whether plain keys reach the restored page at all; cycle B is the same check as cycle 4.",
 "source": "REOPEN VIDEO for reopen-f4",
 "budget_seconds": 200,
 "steps": [
  {
   "do": "require_whole_host"
  },
  {
   "do": "wait",
   "seconds": 5,
   "title": "set-up: Home finishes its first load"
  },
  {
   "do": "key",
   "key": "n",
   "modifiers": [
    "cmd"
   ]
  },
  {
   "do": "wait",
   "seconds": 2
  },
  {
   "do": "key",
   "key": "`",
   "modifiers": [
    "control"
   ]
  },
  {
   "do": "focused_terminal",
   "as": "term"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "type",
   "text": "echo t-${nonce}-$((6*7))",
   "enter": true,
   "mark": "t"
  },
  {
   "do": "expect",
   "title": "set-up: the terminal works",
   "since": "t",
   "timeout": 10,
   "all": [
    {
     "daemon_line": "t-${nonce}-42"
    }
   ]
  },
  {
   "do": "outwait_hold"
  },
  {
   "do": "key",
   "key": "l",
   "modifiers": [
    "cmd",
    "shift"
   ],
   "mark": "browser"
  },
  {
   "do": "expect",
   "title": "set-up: Cmd-Shift-L opens a browser tab whose address bar takes the keys",
   "since": "browser",
   "timeout": 15,
   "all": [
    {
     "key_window_focus": {
      "in": [
       "addressBar"
      ]
     }
    }
   ]
  },
  {
   "do": "type",
   "text": "example.com",
   "mark": "url"
  },
  {
   "do": "key",
   "key": "return",
   "modifiers": [],
   "mark": "loaded"
  },
  {
   "do": "expect",
   "title": "set-up: the page loads and has the keyboard",
   "since": "loaded",
   "timeout": 45,
   "all": [
    {
     "key_window_focus": {
      "in": [
       "browserPage"
      ]
     }
    },
    {
     "frame_text": "documentation examples"
    }
   ]
  },
  {
   "do": "key",
   "key": "t",
   "modifiers": [
    "cmd"
   ],
   "mark": "newtab"
  },
  {
   "do": "wait",
   "seconds": 1.5
  },
  {
   "do": "key",
   "key": "w",
   "modifiers": [
    "cmd"
   ],
   "mark": "closetab"
  },
  {
   "do": "wait",
   "seconds": 1.5
  },
  {
   "do": "expect",
   "title": "set-up: after Cmd-T and Cmd-W the browser page has the keyboard again",
   "since": "closetab",
   "timeout": 15,
   "all": [
    {
     "key_window_focus": {
      "in": [
       "browserPage"
      ]
     }
    },
    {
     "frame_text": "documentation examples"
    }
   ]
  },
  {
   "do": "page_server",
   "var": "page_url",
   "lines": [
    "<!doctype html><html><head><title>keys</title><script>",
    "var s='';",
    "addEventListener('keydown',function(e){if(e.key.length==1){s+=e.key;document.getElementById('o').textContent='seen'+s.split('').reverse().join('')}},true);",
    "</script></head><body style='font:28px sans-serif'>",
    "<p id=r></p><input id=f autofocus autocomplete=off style='font:28px sans-serif;width:600px'><p id=o></p>",
    "<script>document.getElementById('r').textContent='pg'+'ok'+(6*7)</script>",
    "</body></html>"
   ],
   "title": "set-up: a local page (127.0.0.1) with a focused text field; its script shows every key the page gets, reversed"
  },
  {
   "do": "key",
   "key": "l",
   "modifiers": [
    "cmd"
   ],
   "mark": "page4",
   "title": "set-up: the browser tab goes to the local page"
  },
  {
   "do": "expect",
   "title": "set-up: the address bar takes the keys",
   "since": "page4",
   "timeout": 10,
   "all": [
    {
     "key_window_focus": {
      "in": [
       "addressBar"
      ]
     }
    }
   ]
  },
  {
   "do": "type",
   "text": "${page_url}",
   "mark": "url4"
  },
  {
   "do": "key",
   "key": "return",
   "modifiers": [],
   "mark": "loaded4"
  },
  {
   "do": "expect",
   "title": "set-up: the page ran its script and has the keyboard",
   "since": "loaded4",
   "timeout": 20,
   "all": [
    {
     "key_window_focus": {
      "in": [
       "browserPage"
      ]
     }
    },
    {
     "frame_text": "pgok42"
    }
   ]
  },
  {
   "do": "hid_key",
   "key": "a",
   "modifiers": [],
   "mark": "su4a"
  },
  {
   "do": "hid_key",
   "key": "b",
   "modifiers": [],
   "mark": "su4b"
  },
  {
   "do": "hid_key",
   "key": "c",
   "modifiers": [],
   "mark": "su4c"
  },
  {
   "do": "expect",
   "title": "set-up: real plain keys reach the page and its field (the page shows them reversed)",
   "since": "su4a",
   "timeout": 10,
   "all": [
    {
     "frame_text": "seencba"
    },
    {
     "key_window_focus": {
      "in": [
       "browserPage"
      ]
     }
    }
   ]
  },
  {
   "do": "reopen_browser_keys",
   "cmd_l": false,
   "mark": "reopenedA",
   "title": "cycle A: a real Cmd-Q (Keep) and reopen; no key until the restored page has loaded"
  },
  {
   "do": "expect",
   "title": "cycle A: the restored page has loaded and has the keyboard",
   "since": "reopenedA",
   "timeout": 20,
   "all": [
    {
     "frame_text": "pgok42"
    },
    {
     "key_window_focus": {
      "in": [
       "browserPage"
      ]
     }
    }
   ]
  },
  {
   "do": "hid_line",
   "text": "latekeysca",
   "enter": false,
   "mark": "lateA",
   "title": "cycle A: then plain keys only (a marker, no modifier) with real keys"
  },
  {
   "do": "expect",
   "title": "cycle A: the loaded restored page got every plain key in order (shown reversed) and its field shows the marker",
   "since": "lateA",
   "timeout": 10,
   "all": [
    {
     "frame_text": "seenacsyeketal"
    },
    {
     "frame_text": "latekeysca"
    },
    {
     "key_window_focus": {
      "in": [
       "browserPage"
      ]
     }
    }
   ]
  },
  {
   "do": "reopen_browser_keys",
   "text": "earlykeyscb",
   "cmd_l": false,
   "mark": "reopenedB",
   "title": "cycle B: a real Cmd-Q (Keep), reopen, and as soon as the main window is listed only plain keys (a marker, no modifier)"
  },
  {
   "do": "expect",
   "title": "cycle B: the restored page got every plain key in order (shown reversed) and its field shows the marker",
   "since": "reopenedB",
   "timeout": 10,
   "all": [
    {
     "frame_text": "seenbcsyekylrae"
    },
    {
     "frame_text": "earlykeyscb"
    },
    {
     "key_window_focus": {
      "in": [
       "browserPage"
      ]
     }
    }
   ]
  }
 ],
 "finally": [
  {
   "do": "input_journal",
   "name": "inputjournal",
   "last": 300
  }
 ]
}
