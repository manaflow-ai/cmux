{
 "id": "link-hints-cost-wiki-5",
 "priority": "P1",
 "title": "Measurement: 5 times plain f, wait 1 s, Escape on en.wikipedia.org/wiki/United_States (run with the memory hog)",
 "why": "Measurement for reopen-f4 and the lead (#32537 review point 3): the cost of the link-hint page check on a heavy real page. No click on the page body: a CuaDriver click into a Chromium page cannot be delivered on the minis (STATUS 7302, 7362); after the address-bar load the page has the keyboard with no field focused.",
 "source": "REOPEN VIDEO for reopen-f4",
 "budget_seconds": 200,
 "steps": [
  {
   "do": "require_whole_host"
  },
  {
   "do": "wait",
   "seconds": 5,
   "title": "set-up: Home finishes its first load"
  },
  {
   "do": "key",
   "key": "n",
   "modifiers": [
    "cmd"
   ]
  },
  {
   "do": "wait",
   "seconds": 2
  },
  {
   "do": "key",
   "key": "`",
   "modifiers": [
    "control"
   ]
  },
  {
   "do": "focused_terminal",
   "as": "term"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "type",
   "text": "echo t-${nonce}-$((6*7))",
   "enter": true,
   "mark": "t"
  },
  {
   "do": "expect",
   "title": "set-up: the terminal works",
   "since": "t",
   "timeout": 10,
   "all": [
    {
     "daemon_line": "t-${nonce}-42"
    }
   ]
  },
  {
   "do": "outwait_hold"
  },
  {
   "do": "key",
   "key": "l",
   "modifiers": [
    "cmd",
    "shift"
   ],
   "mark": "bar",
   "title": "Cmd-Shift-L opens a browser tab"
  },
  {
   "do": "expect",
   "title": "the address bar takes the keys",
   "since": "bar",
   "timeout": 15,
   "all": [
    {
     "key_window_focus": {
      "in": [
       "addressBar"
      ]
     }
    }
   ]
  },
  {
   "do": "type",
   "text": "https://en.wikipedia.org/wiki/United_States",
   "mark": "url"
  },
  {
   "do": "key",
   "key": "return",
   "modifiers": [],
   "mark": "loaded"
  },
  {
   "do": "expect",
   "title": "the heavy page loaded and has the keyboard (no field is focused on a Wikipedia article)",
   "since": "loaded",
   "timeout": 45,
   "all": [
    {
     "key_window_focus": {
      "in": [
       "browserPage"
      ]
     }
    },
    {
     "frame_text": "United States"
    }
   ]
  },
  {
   "do": "wait",
   "seconds": 5,
   "title": "the page finishes its late loads"
  },
  {
   "do": "hid_key",
   "key": "f",
   "modifiers": [],
   "mark": "f1",
   "title": "cycle 1: a real plain f (link hints)"
  },
  {
   "do": "wait",
   "seconds": 1.0
  },
  {
   "do": "hid_key",
   "key": "escape",
   "modifiers": [],
   "mark": "esc1"
  },
  {
   "do": "wait",
   "seconds": 0.4
  },
  {
   "do": "hid_key",
   "key": "f",
   "modifiers": [],
   "mark": "f2",
   "title": "cycle 2: a real plain f (link hints)"
  },
  {
   "do": "wait",
   "seconds": 1.0
  },
  {
   "do": "hid_key",
   "key": "escape",
   "modifiers": [],
   "mark": "esc2"
  },
  {
   "do": "wait",
   "seconds": 0.4
  },
  {
   "do": "hid_key",
   "key": "f",
   "modifiers": [],
   "mark": "f3",
   "title": "cycle 3: a real plain f (link hints)"
  },
  {
   "do": "wait",
   "seconds": 1.0
  },
  {
   "do": "hid_key",
   "key": "escape",
   "modifiers": [],
   "mark": "esc3"
  },
  {
   "do": "wait",
   "seconds": 0.4
  },
  {
   "do": "hid_key",
   "key": "f",
   "modifiers": [],
   "mark": "f4",
   "title": "cycle 4: a real plain f (link hints)"
  },
  {
   "do": "wait",
   "seconds": 1.0
  },
  {
   "do": "hid_key",
   "key": "escape",
   "modifiers": [],
   "mark": "esc4"
  },
  {
   "do": "wait",
   "seconds": 0.4
  },
  {
   "do": "hid_key",
   "key": "f",
   "modifiers": [],
   "mark": "f5",
   "title": "cycle 5: a real plain f (link hints)"
  },
  {
   "do": "wait",
   "seconds": 1.0
  },
  {
   "do": "hid_key",
   "key": "escape",
   "modifiers": [],
   "mark": "esc5"
  },
  {
   "do": "wait",
   "seconds": 0.4
  },
  {
   "do": "expect",
   "title": "the page still has the keyboard after the cycles",
   "timeout": 10,
   "all": [
    {
     "key_window_focus": {
      "in": [
       "browserPage"
      ]
     }
    }
   ]
  }
 ],
 "finally": [
  {
   "do": "input_journal",
   "name": "inputjournal",
   "last": 1000
  }
 ]
}
