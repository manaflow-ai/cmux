{
 "id": "quit-reopen-speed-20",
 "priority": "P1",
 "title": "Speed: quit (Keep Sessions) and reopen with 20 workspace(s): the last frame of every visible terminal and interactive, from main()",
 "why": "Lawrence 2026-11-01: 'quit and reopen needs to be super fast'. Target: a reopen with kept sessions shows the last frame of every visible terminal under 300 ms after main(), interactive under 500 ms.",
 "source": "QUIT P0 step 4 (STATUS 2680)",
 "budget_seconds": 260,
 "steps": [
  {
   "do": "require_whole_host",
   "title": "timings need a key window on screen (a whole-host lease), else not run"
  },
  {
   "do": "wait",
   "seconds": 6,
   "title": "set-up: Home finishes its first load"
  },
  {
   "do": "new_terminal",
   "via": "key",
   "as": "main"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "type",
   "text": "seq -f 'qs-${nonce}-%g' 1 2000",
   "enter": true,
   "mark": "lines"
  },
  {
   "do": "expect",
   "title": "set-up: 2000 lines",
   "since": "lines",
   "timeout": 20,
   "all": [
    {
     "daemon_line": "qs-${nonce}-2000"
    }
   ]
  },
  {
   "do": "key",
   "key": "d",
   "modifiers": [
    "cmd"
   ]
  },
  {
   "do": "focused_terminal",
   "as": "right"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "type",
   "text": "echo right-${nonce}-$((6*7))",
   "enter": true,
   "mark": "right"
  },
  {
   "do": "expect",
   "title": "set-up: the split answers",
   "since": "right",
   "timeout": 10,
   "all": [
    {
     "daemon_line": "right-${nonce}-42"
    }
   ]
  },
  {
   "do": "seed_workspaces",
   "count": 19,
   "prefix": "qs-${nonce}-ws"
  },
  {
   "do": "quit_speed",
   "count": 4,
   "how": "quit-keep",
   "title": "timed: quit (Keep Sessions) and reopen, from main()"
  },
  {
   "do": "require_drawable",
   "title": "the window is on screen (frame checks)"
  },
  {
   "do": "expect",
   "title": "after the cycles: the split's text and the scrollback tail are back",
   "timeout": 30,
   "all": [
    {
     "daemon_line": "right-${nonce}-42"
    },
    {
     "app_text_line": "right-${nonce}-42"
    },
    {
     "frame_text": "right-${nonce}-42"
    }
   ]
  }
 ],
 "finally": [
  {
   "do": "close_seeded",
   "prefix": "qs-${nonce}-ws"
  }
 ]
}
