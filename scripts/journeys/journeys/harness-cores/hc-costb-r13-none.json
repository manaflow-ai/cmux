{
 "id": "hc-costb-r13-none",
 "priority": "P1",
 "title": "HARNESS CORES: sampler cost, split (Cmd-D), NO sampler, run 13 (order reversed: no sampler first in each lease)",
 "why": "HARNESS CORES (lead 23:4xZ): the tier sampler's own cost on the key turn; same steps, the sampler on or off.",
 "source": "HARNESS CORES (agent harness-cores)",
 "budget_seconds": 120,
 "options": {
  "key_path": "real"
 },
 "steps": [
  {
   "do": "settings_file",
   "title": "set-up: theme Builtin Dark, no close warning, new columns share the strip",
   "set": {
    "appearance": {
     "theme": "Builtin Dark",
     "appTheme": "followTerminal"
    },
    "app": {
     "warnBeforeClosingTab": false
    },
    "layout": {
     "newColumnWidth": "fitScreen"
    }
   }
  },
  {
   "do": "smoke_ready",
   "timeout": 60
  },
  {
   "do": "smoke_make_key"
  },
  {
   "do": "new_terminal",
   "via": "key",
   "name": "rv-xtpa-split-1pane-idle-dark"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "name_pane",
   "as": "home"
  },
  {
   "do": "window_place",
   "title": "set-up: the window at 90% x 90% of the screen",
   "fraction": [
    0.05,
    0.05,
    0.9,
    0.9
   ]
  },
  {
   "do": "action",
   "action": "workspace.newAtBottom",
   "title": "set-up: a new workspace for the case"
  },
  {
   "do": "adopt_pane",
   "as": "p0"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "wait",
   "seconds": 1.5,
   "title": "the layout and the load settle (nothing observable to wait on)"
  },
  {
   "do": "trace_only_start",
   "name": "close",
   "title": "the geometry trace (display-link ticks), no recorder"
  },
  {
   "do": "wait",
   "seconds": 2.0,
   "title": "in place of xctrace's start (same timeline, no profiler)"
  },
  {
   "do": "rpc",
   "method": "debug.stall",
   "params": {
    "ms": 60
   },
   "title": "clock mark: a 60 ms main-thread stall"
  },
  {
   "do": "wait",
   "seconds": 0.5,
   "title": "the mark's frames pass"
  },
  {
   "do": "hid_key",
   "key": "d",
   "modifiers": [
    "cmd"
   ],
   "mark": "split",
   "title": "Cmd-D splits p0 right"
  },
  {
   "do": "wait",
   "seconds": 1.2,
   "title": "the motion lands"
  },
  {
   "do": "trace_only_stop",
   "name": "close"
  },
  {
   "do": "use_pane",
   "pane": "p0",
   "click": true,
   "title": "after: click into p0"
  },
  {
   "do": "hid_key",
   "key": "c",
   "modifiers": [
    "control"
   ],
   "title": "after: a real HID Ctrl-C (STATUS 6209: debug.key Ctrl-C can reach a menu)"
  },
  {
   "do": "type",
   "text": "echo rv-done-${nonce}",
   "enter": true,
   "mark": "after"
  },
  {
   "do": "expect",
   "title": "p0 echoes the line: app, daemon and frame",
   "since": "after",
   "timeout": 10,
   "all": [
    {
     "daemon_line": "rv-done-${nonce}"
    },
    {
     "app_text_line": "rv-done-${nonce}"
    },
    {
     "frame_text": "rv-done-${nonce}"
    }
   ]
  }
 ]
}