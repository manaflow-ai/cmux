{
 "id": "found-desync-channels-type",
 "priority": "P1",
 "first_in_app": true,
 "title": "Home dock Channels, first open in a fresh launch: after its Chromium page attaches, typed letters reach a field of the Channels page",
 "why": "Review of #29272 (FIX at 976b215bed7, https://github.com/manaflow-ai/cmux/pull/29272#issuecomment-6542312241): the pane lookup there also matched the docked Home's Channels page, a page nested in HomeDockView. Its attach then skipped its own focus grant, and the focus applier cannot focus a nested page, so the Chromium page never got the keys and typing into Channels went nowhere. The fix (5ceaf206d2b) matches only the pane's own Chromium page. This journey opens Channels for the first time in a fresh launch (Chromium makes its page after the view shows) and waits for its Chromium page. Then a click in the page's own script (debug.page click on .lg-search, no AppKit event, so no key-window change) opens the page's palette with its field focused in the DOM, and real key events go through the app's event queue (debug.key sequence with no key_window: they go to whatever window is key, as a person's keys do). The letters reach that field only when Chromium's page window has the keys. Plain letters: a chord such as Cmd-K is an app shortcut there (agentPane.searchChats) and never reaches the page. Needs run.py --whole-host (the app launched active, so a window is key). The frame check reads the typed word from the window. The daemon check at the end (after one Cmd-N) is the harness's required daemon evidence, a health check of the app afterwards, not part of the claim.",
 "source": "#29272 review finding 1; #29274 review (FIX at c5cba01aa64, comment 6542986147); webviews/src/pages/home-channels/ConversationList.tsx (.lg-search) and Palette.tsx",
 "budget_seconds": 200,
 "steps": [
  {
   "do": "fresh_app"
  },
  {
   "do": "smoke_ready",
   "timeout": 60
  },
  {
   "do": "smoke_remember_workspaces"
  },
  {
   "do": "smoke_make_key"
  },
  {
   "do": "rpc",
   "method": "settings.set",
   "params": {
    "path": "home.channelsEnabled",
    "value": true
   }
  },
  {
   "do": "rpc",
   "method": "action.run",
   "params": {
    "action": "home.show",
    "args": {},
    "focus": true
   }
  },
  {
   "do": "expect",
   "title": "the docked Home shows, with Channels enabled",
   "timeout": 20,
   "all": [
    {
     "app_rpc": {
      "method": "debug.home",
      "path": "dock.visible",
      "equals": true
     }
    },
    {
     "app_rpc": {
      "method": "debug.home",
      "path": "dock.channels_enabled",
      "equals": true
     }
    }
   ]
  },
  {
   "do": "rpc",
   "method": "action.run",
   "params": {
    "action": "home.switchView",
    "args": {
     "view": "channels"
    },
    "focus": true
   }
  },
  {
   "do": "expect",
   "title": "Channels shows, in Chromium, painted, with its search button",
   "timeout": 30,
   "all": [
    {
     "app_rpc": {
      "method": "debug.home",
      "path": "dock.mode",
      "equals": "channels"
     }
    },
    {
     "app_rpc": {
      "method": "debug.home",
      "path": "dock.channels_visible",
      "equals": true
     }
    },
    {
     "app_rpc": {
      "method": "debug.page",
      "params": {
       "page": "cmux.home-channels",
       "action": "state"
      },
      "path": "engine",
      "equals": "chromium"
     }
    },
    {
     "app_rpc": {
      "method": "debug.page",
      "params": {
       "page": "cmux.home-channels",
       "action": "state"
      },
      "path": "painted",
      "equals": true
     }
    },
    {
     "app_rpc": {
      "method": "debug.page",
      "params": {
       "page": "cmux.home-channels",
       "action": "query",
       "selector": ".lg-search"
      },
      "path": "elements",
      "len_gte": 1
     }
    }
   ]
  },
  {
   "do": "wait",
   "seconds": 2
  },
  {
   "do": "rpc",
   "method": "debug.focus"
  },
  {
   "do": "rpc",
   "method": "debug.window_list"
  },
  {
   "do": "rpc",
   "method": "debug.page",
   "params": {
    "page": "cmux.home-channels",
    "action": "click",
    "selector": ".lg-search"
   }
  },
  {
   "do": "expect",
   "title": "the page's palette is open and a text field in it has DOM focus (before any key)",
   "timeout": 10,
   "all": [
    {
     "app_rpc": {
      "method": "debug.page",
      "params": {
       "page": "cmux.home-channels",
       "action": "query",
       "selector": ".lg-palette"
      },
      "path": "elements",
      "len_gte": 1
     }
    },
    {
     "app_rpc": {
      "method": "debug.page",
      "params": {
       "page": "cmux.home-channels",
       "action": "state"
      },
      "path": "active.tag",
      "in": [
       "input",
       "textarea"
      ]
     }
    }
   ]
  },
  {
   "do": "rpc",
   "method": "debug.key",
   "params": {
    "sequence": [
     {
      "key_code": 35,
      "down": true,
      "after_ms": 60
     },
     {
      "key_code": 35,
      "down": false,
      "after_ms": 40
     },
     {
      "key_code": 15,
      "down": true,
      "after_ms": 60
     },
     {
      "key_code": 15,
      "down": false,
      "after_ms": 40
     },
     {
      "key_code": 31,
      "down": true,
      "after_ms": 60
     },
     {
      "key_code": 31,
      "down": false,
      "after_ms": 40
     },
     {
      "key_code": 11,
      "down": true,
      "after_ms": 60
     },
     {
      "key_code": 11,
      "down": false,
      "after_ms": 40
     },
     {
      "key_code": 14,
      "down": true,
      "after_ms": 60
     },
     {
      "key_code": 14,
      "down": false,
      "after_ms": 40
     }
    ]
   }
  },
  {
   "do": "wait",
   "seconds": 1.5
  },
  {
   "do": "rpc",
   "method": "debug.page",
   "params": {
    "page": "cmux.home-channels",
    "action": "state"
   }
  },
  {
   "do": "rpc",
   "method": "debug.focus"
  },
  {
   "do": "expect",
   "title": "the typed letters reached the Channels page: its focused field holds them, and the window shows them",
   "timeout": 10,
   "all": [
    {
     "app_rpc": {
      "method": "debug.page",
      "params": {
       "page": "cmux.home-channels",
       "action": "state"
      },
      "path": "active.value",
      "equals": "probe"
     }
    },
    {
     "frame_text": "probe"
    }
   ]
  },
  {
   "do": "fuzz_run",
   "sequence": [
    {
     "a": "new_workspace",
     "t": "slow"
    }
   ],
   "set": "full",
   "fresh": false,
   "shrink": false,
   "budget_s": 60
  },
  {
   "do": "expect",
   "title": "afterwards (a health check, not the claim) the daemon agrees with the app",
   "timeout": 20,
   "all": [
    {
     "fuzz_daemon_agrees": {}
    }
   ]
  }
 ],
 "finally": [
  {
   "do": "rpc",
   "method": "action.run",
   "params": {
    "action": "home.switchView",
    "args": {
     "view": "messages"
    },
    "focus": false
   }
  },
  {
   "do": "rpc",
   "method": "settings.unset",
   "params": {
    "path": "home.channelsEnabled"
   }
  },
  {
   "do": "smoke_close_all"
  }
 ]
}
