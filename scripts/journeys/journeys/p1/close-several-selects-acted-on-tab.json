{
  "id": "close-several-selects-acted-on-tab",
  "priority": "P1",
  "title": "Close Other Tabs, Close Tabs to the Right and Close Tabs to the Left on a tab that is not selected select that tab",
  "why": "cmux-ad i7: the tab the person acted on stays and is selected. With a pinned tab first, Close Others from an unselected tab selected the pinned tab.",
  "source": "cmux-ad i7 (PR #38413)",
  "budget_seconds": 150,
  "steps": [
    {"do": "new_terminal", "name": "jr-cos-${nonce}", "as": "t"},
    {"do": "expect", "title": "the first tab", "timeout": 15,
     "all": [{"app_rpc": {"method": "debug.focus", "path": "windows.0.model.resolved_tab", "not_equals": null, "bind": "t_id"}}]},
    {"do": "new_terminal", "via": "key", "as": "b0"},
    {"do": "expect", "title": "b0", "timeout": 15,
     "all": [{"app_rpc": {"method": "debug.focus", "path": "windows.0.model.resolved_tab", "not_in": [null, "${t_id}"], "bind": "b0_id"}}]},
    {"do": "new_terminal", "via": "key", "as": "b1"},
    {"do": "expect", "title": "b1", "timeout": 15,
     "all": [{"app_rpc": {"method": "debug.focus", "path": "windows.0.model.resolved_tab", "not_in": [null, "${t_id}", "${b0_id}"], "bind": "b1_id"}}]},
    {"do": "new_terminal", "via": "key", "as": "b2"},
    {"do": "expect", "title": "b2", "timeout": 15,
     "all": [{"app_rpc": {"method": "debug.focus", "path": "windows.0.model.resolved_tab", "not_in": [null, "${t_id}", "${b0_id}", "${b1_id}"], "bind": "b2_id"}}]},
    {"do": "rpc", "method": "action.run", "params": {"action": "palette.toggleTabPin", "target": "tab:${t_id}", "focus": true, "wait": true}},
    {"do": "rpc", "method": "action.run", "params": {"action": "tab.focus", "target": "tab:${b0_id}", "focus": true, "wait": true}},
    {"do": "expect", "title": "T pinned first, b0 selected", "timeout": 10,
     "all": [{"app_rpc": {"method": "debug.focus", "path": "windows.0.model.resolved_tab", "equals": "${b0_id}"}},
             {"app_rpc": {"method": "debug.surfaces", "path": "windows.0", "contains": "\"selected_tab\": \"${b0_id}\""}}]},

    {"do": "rpc", "method": "action.run", "params": {"action": "closeOtherTabsInPane", "target": "tab:${b2_id}", "focus": true, "wait": true}},
    {"do": "expect", "title": "Close Other Tabs on b2 (b0 selected, T pinned): b0 and b1 close, b2 is selected", "timeout": 10, "settle": 1,
     "all": [{"app_rpc": {"method": "debug.focus", "path": "windows.0.model.resolved_tab", "equals": "${b2_id}"}},
             {"app_layout": {"workspace": "jr-cos-${nonce}", "pane_tabs": 2}}]},

    {"do": "new_terminal", "via": "key", "as": "b3"},
    {"do": "expect", "title": "b3", "timeout": 15,
     "all": [{"app_rpc": {"method": "debug.focus", "path": "windows.0.model.resolved_tab", "not_in": [null, "${t_id}", "${b2_id}"], "bind": "b3_id"}}]},
    {"do": "rpc", "method": "action.run", "params": {"action": "tab.focus", "target": "tab:${t_id}", "focus": true, "wait": true}},
    {"do": "expect", "title": "T selected", "timeout": 10,
     "all": [{"app_rpc": {"method": "debug.focus", "path": "windows.0.model.resolved_tab", "equals": "${t_id}"}}]},
    {"do": "rpc", "method": "action.run", "params": {"action": "closeTabsToRight", "target": "tab:${b2_id}", "focus": true, "wait": true}},
    {"do": "use", "name": "b2"},
    {"do": "expect", "title": "Close Tabs to the Right of b2 (pinned T selected): b3 closes, b2 is selected", "timeout": 10, "settle": 1,
     "all": [{"app_rpc": {"method": "debug.focus", "path": "windows.0.model.resolved_tab", "equals": "${b2_id}"}},
             {"app_layout": {"workspace": "jr-cos-${nonce}", "pane_tabs": 2}}]},

    {"do": "new_terminal", "via": "key", "as": "b4"},
    {"do": "expect", "title": "b4", "timeout": 15,
     "all": [{"app_rpc": {"method": "debug.focus", "path": "windows.0.model.resolved_tab", "not_in": [null, "${t_id}", "${b2_id}", "${b3_id}"], "bind": "b4_id"}}]},
    {"do": "rpc", "method": "action.run", "params": {"action": "tab.focus", "target": "tab:${b2_id}", "focus": true, "wait": true}},
    {"do": "expect", "title": "b2 selected", "timeout": 10,
     "all": [{"app_rpc": {"method": "debug.focus", "path": "windows.0.model.resolved_tab", "equals": "${b2_id}"}}]},
    {"do": "rpc", "method": "action.run", "params": {"action": "closeTabsToLeft", "target": "tab:${b4_id}", "focus": true, "wait": true}},
    {"do": "expect", "title": "Close Tabs to the Left of b4 (b2 selected, T pinned): b2 closes, b4 is selected, not T", "timeout": 10, "settle": 1,
     "all": [{"app_rpc": {"method": "debug.focus", "path": "windows.0.model.resolved_tab", "equals": "${b4_id}"}},
             {"app_layout": {"workspace": "jr-cos-${nonce}", "pane_tabs": 2}}]},
    {"do": "expect", "title": "debug.surfaces names b4 as the pane's selected tab", "timeout": 5,
     "all": [{"app_rpc": {"method": "debug.surfaces", "path": "windows.0", "contains": "\"selected_tab\": \"${b4_id}\""}}]},
    {"do": "use", "name": "b4"},
    {"do": "neutral_prompt"},
    {"do": "type", "text": "echo kept-${nonce}-$((6*7))", "enter": true, "mark": "typed"},
    {"do": "expect", "title": "the selected b4 is the shown terminal and takes the keys", "since": "typed", "timeout": 10,
     "all": [{"daemon_line": "kept-${nonce}-42"}, {"app_text_line": "kept-${nonce}-42"}, {"frame_text": "kept-${nonce}-42"}]}
  ]
}
