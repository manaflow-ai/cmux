{
 "id": "heavy-session-reap",
 "priority": "P1",
 "title": "A heavy session (6 pages, 16 New Tab pages, 12 terminals) left running for the capture tool to reap",
 "why": "P0 #1 (2026-10-28): optimized builds crashed in Chromium (SIGSEGV in RenderWidgetHostImpl::OnSnapshotFromSurfaceReceived) when a renderer exited while a page picture was in flight; 19 of 21 reports came at lease ends (SIGTERM, then the quit closes every renderer). A crashed renderer, a discard or a quit ends renderers every day. The crashes came at the capture tool's reap of heavy leases (790-1220 processes), up to 10 minutes after the lease ended.",
 "source": "handoff/cef-snapshot-crash-result.md",
 "budget_seconds": 250,
 "steps": [
  {
   "do": "new_terminal",
   "name": "jr-capstorm-${nonce}",
   "as": "left"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "type",
   "text": "echo capstorm-${nonce}-$((6*7))",
   "enter": true,
   "mark": "term"
  },
  {
   "do": "expect",
   "title": "the terminal works",
   "since": "term",
   "timeout": 10,
   "all": [
    {
     "daemon_line": "capstorm-${nonce}-42"
    },
    {
     "app_text_line": "capstorm-${nonce}-42"
    }
   ]
  },
  {
   "do": "key",
   "key": "l",
   "modifiers": [
    "cmd",
    "shift"
   ],
   "mark": "b0-open"
  },
  {
   "do": "expect",
   "title": "Cmd+Shift+L opens a browser tab whose address bar takes the keys",
   "since": "b0-open",
   "timeout": 15,
   "all": [
    {
     "app_rpc": {
      "method": "debug.focus",
      "path": "windows.0.model.resolved",
      "equals": "addressBar"
     }
    }
   ]
  },
  {
   "do": "type",
   "text": "example.com",
   "enter": true,
   "mark": "b0"
  },
