      "params": {
        "key": "n",
        "modifiers": [],
        "target": "palette"
      }
    },
    {
      "do": "rpc",
      "method": "debug.key",
      "params": {
        "key": "d",
        "modifiers": [],
        "target": "palette"
      }
    },
    {
      "do": "expect",
      "title": "toggle on: the next palette open lists Debug: Tab Bar Playground",
      "timeout": 10,
      "all": [
        {
          "app_rpc": {
            "method": "debug.palette.capture",
            "params": {
              "path": "/tmp/jr-ddm-on-${nonce}.png"
            },
            "path": "rows",
            "contains": "debug.tabBarPlayground"
          }
        },
        {
          "app_rpc": {
            "method": "debug.palette.capture",
            "params": {
              "path": "/tmp/jr-ddm-on-${nonce}.png"
            },
            "path": "selected",
            "contains": "Debug: Tab Bar Playground"
          }
        }
