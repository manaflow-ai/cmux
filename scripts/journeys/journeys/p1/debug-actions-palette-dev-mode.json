        "modifiers": [],
        "target": "palette"
      }
    },
    {
      "do": "rpc",
      "method": "debug.key",
      "params": {
        "key": " ",
        "modifiers": [],
        "target": "palette"
      }
    },
    {
      "do": "rpc",
      "method": "debug.key",
      "params": {
        "key": "p",
        "modifiers": [],
        "target": "palette"
      }
    },
    {
      "do": "rpc",
      "method": "debug.key",
      "params": {
        "key": "l",
        "modifiers": [],
        "target": "palette"
      }
    },
    {
      "do": "rpc",
