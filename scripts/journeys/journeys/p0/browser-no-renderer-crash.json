    "import glob, os, plistlib, pwd, struct, subprocess, sys, tempfile",
    "# jr-cefjit: sign the app's Chromium helpers the way a shipped build runs them: with the hardened runtime, each helper",
    "# keeping its own entitlements. A fleet build is signed ad hoc without the hardened runtime, where V8 needs no",
    "# allow-jit, so a helper that lacks it still runs pages there (the #34904 crash did not show on fleet builds).",
    "# The lease's copy is re-signed by capture-host (codesign --force --deep --sign -), which drops every helper's",
    "# entitlements, so they are read from the build itself: the journeys cache's unpacked artifact of this build, which",
    "# has the same bundle name (~/.cache/cmux-journeys/builds/JOB/build/NAME.app, build_cache.py).",
    "# disable-library-validation stands in for the shipped Team ID (ad hoc code has none, so library validation would",
    "# refuse the ad hoc framework); it does not change what JIT needs. Only this lease's copy of the app changes.",
    "CS = \"/usr/bin/codesign\"",
    "def slices(data):",
    "    # A universal binary's slices, else the one Mach-O.",
    "    if struct.unpack(\">I\", data[:4])[0] == 0xcafebabe:",
    "        for i in range(struct.unpack(\">I\", data[4:8])[0]):",
    "            off, size = struct.unpack(\">II\", data[16 + i * 20: 24 + i * 20])",
    "            yield data[off:off + size]",
    "    else:",
    "        yield data",
    "def signature(path):",
    "    # The code signature of each slice of the bundle's executable, read from the file (not from codesign's output):",
    "    # (entitlements plist or {}, CodeDirectory flags).",
    "    exe = os.path.join(path, \"Contents\", \"MacOS\", os.path.basename(path)[:-4])",
    "    out = []",
    "    for m in slices(open(exe, \"rb\").read()):",
    "        ncmds, off, blob = struct.unpack(\"<I\", m[16:20])[0], 32, b\"\"",
    "        for _ in range(ncmds):",
    "            cmd, size = struct.unpack(\"<II\", m[off:off + 8])",
    "            if cmd == 0x1d:  # LC_CODE_SIGNATURE",
    "                dataoff, datasize = struct.unpack(\"<II\", m[off + 8:off + 16])",
    "                blob = m[dataoff:dataoff + datasize]",
    "            off += size",
    "        ents, flags = {}, None",
    "        for i in range(struct.unpack(\">I\", blob[8:12])[0] if blob else 0):",
    "            boff = struct.unpack(\">I\", blob[16 + i * 8:20 + i * 8])[0]",
    "            magic, length = struct.unpack(\">II\", blob[boff:boff + 8])",
    "            if magic == 0xfade7171:",
    "                ents = plistlib.loads(blob[boff + 8:boff + length])",
    "            elif magic == 0xfade0c02 and flags is None:",
    "                flags = struct.unpack(\">I\", blob[boff + 12:boff + 16])[0]",
    "        out.append((ents, flags))",
    "    return out",
    "def entitlements(path):",
    "    sigs = signature(path)",
    "    return sigs[0][0] if sigs and all(s[0] == sigs[0][0] for s in sigs) else None",
    "def flags(path):",
    "    names = {0x2: \"adhoc\", 0x10000: \"runtime\"}",
    "    got = {f for _, f in signature(path)}",
    "    return \",\".join(n for bit, n in sorted(names.items()) if all(f is not None and f & bit for f in got)) or \"none\"",
    "app = sys.argv[1].rstrip(\"/\")",
    "fw = os.path.join(app, \"Contents\", \"Frameworks\")",
    "home = pwd.getpwuid(os.getuid()).pw_dir",
    "built = sorted(glob.glob(os.path.join(home, \".cache\", \"cmux-journeys\", \"builds\", \"*\", \"build\", os.path.basename(app))))",
    "if len(built) != 1:",
    "    sys.exit(\"jr-cefjit-harden-failed: \" + str(len(built)) + \" unpacked builds named \" + os.path.basename(app) + \" in the journeys cache\")",
    "built_fw = os.path.join(built[0], \"Contents\", \"Frameworks\")",
    "print(\"jr-cefjit-build\", built[0].split(\"/builds/\")[1].split(\"/\")[0], flush=True)",
    "helpers = sorted(glob.glob(os.path.join(fw, \"* Helper.app\")) + glob.glob(os.path.join(fw, \"* Helper (*).app\")))",
    "if not helpers:",
    "    sys.exit(\"jr-cefjit-harden-failed: no helper apps in \" + fw)",
    "plans = []",
    "for h in helpers:",
    "    ents = entitlements(os.path.join(built_fw, os.path.basename(h)))",
    "    if ents is None:",
    "        sys.exit(\"jr-cefjit-harden-failed \" + os.path.basename(h) + \": its slices have different entitlements\")",
    "    plans.append((h, ents))",
    "gpu = [e for h, e in plans if h.endswith(\"Helper (GPU).app\")]",
    "if not gpu or not gpu[0].get(\"com.apple.security.cs.allow-jit\"):",
    "    # Every build signs the GPU helper with allow-jit: no read of it means the reads failed, not a missing entitlement.",
    "    sys.exit(\"jr-cefjit-harden-failed: the GPU helper's allow-jit was not read from its signature\")",
    "for h, ents in plans:",
    "    jit = \"jit\" if ents.get(\"com.apple.security.cs.allow-jit\") else \"nojit\"",
    "    ents = dict(ents, **{\"com.apple.security.cs.disable-library-validation\": True})",
    "    with tempfile.NamedTemporaryFile(\"wb\", prefix=\"jr-cefjit-ent.\", suffix=\".plist\", dir=\"/tmp\", delete=False) as f:",
    "        plistlib.dump(ents, f)",
    "    p = subprocess.run([CS, \"--force\", \"--sign\", \"-\", \"--options\", \"runtime\", \"--timestamp=none\", \"--entitlements\", f.name, h],",
    "                       capture_output=True, text=True)",
    "    os.unlink(f.name)",
    "    if p.returncode:",
    "        sys.exit(\"jr-cefjit-harden-failed \" + os.path.basename(h) + \": \" + p.stderr.strip()[-200:])",
    "    after = entitlements(h) or {}",
    "    if bool(after.get(\"com.apple.security.cs.allow-jit\")) != (jit == \"jit\") or \"runtime\" not in flags(h):",
    "        sys.exit(\"jr-cefjit-harden-failed \" + os.path.basename(h) + \": after the re-sign allow-jit changed or no hardened runtime\")",
    "    print(\"jr-cefjit-helper\", os.path.basename(h)[:-4].replace(\" \", \"_\"), jit, flags(h), flush=True)",
    "print(\"jr-cefjit-hardened\", len(plans), flush=True)"
   ]
  },
