   "do": "file",
   "path": "/tmp/jr-cefjit-serve-${nonce}.py",
   "lines": [
    "import http.server, re, sys, threading",
    "# jr-cefjit page server: serves only /jr-cefjit-<kind>-<digits>.html from ROOT on 127.0.0.1:PORT, ends after LIFE s.",
    "port, root, life = int(sys.argv[1]), sys.argv[2], float(sys.argv[3])",
    "ok = re.compile(r\"^/jr-cefjit-[a-z]+-[0-9]+\\.html$\")",
    "class Pages(http.server.SimpleHTTPRequestHandler):",
    "    def __init__(self, *a, **k):",
    "        super().__init__(*a, directory=root, **k)",
    "    def do_GET(self):",
    "        path = self.path.split(\"?\")[0]",
    "        if not ok.match(path):",
    "            self.send_error(404)",
    "            return",
    "        print(\"jr-cefjit-get \" + path, flush=True)",
    "        super().do_GET()",
    "    def end_headers(self):",
    "        self.send_header(\"Cache-Control\", \"no-store\")",
    "        super().end_headers()",
    "    def log_message(self, *args):",
    "        pass",
    "http.server.ThreadingHTTPServer.allow_reuse_address = True",
    "server = http.server.ThreadingHTTPServer((\"127.0.0.1\", port), Pages)",
    "threading.Timer(life, server.shutdown).start()",
    "print(\"jr-cefjit-serving \" + str(port), flush=True)",
    "server.serve_forever()",
    "print(\"jr-cefjit-stopped\", flush=True)"
   ]
