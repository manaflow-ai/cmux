   "path": "/tmp/jr-cefjit-heavy-${nonce}.html",
   "lines": [
    "<!doctype html><meta charset=\"utf-8\"><title>jr-cefjit heavy loading</title><style>body{font:44px -apple-system,Helvetica,sans-serif;margin:32px;background:#fff;color:#000}h1{font-size:52px;margin:0 0 16px}</style>",
    "<style>#spin{width:60px;height:60px;background:#36c;animation:r 1s linear infinite}@keyframes r{to{transform:rotate(360deg)}}</style>",
    "<body><h1 id=\"s\">HEAVY PAGE WORKING</h1><div id=\"spin\"></div><canvas id=\"c\" width=\"400\" height=\"160\"></canvas>",
    "<script>",
    "\"use strict\";",
    "// JIT work in every tier V8 has (the CEF 156 crash: V8 could not reserve its code range, #34904):",
    "// hot loops, typed arrays, JSON, regular expressions, WebAssembly, a worker, then two frames drawn.",
    "function primes(n){const s=new Uint8Array(n+1);let c=0;for(let i=2;i<=n;i++){if(!s[i]){c++;for(let j=i*i;j<=n;j+=i)s[j]=1;}}return c;}",
    "function mix(n){let h=0;for(let i=0;i<n;i++){h=(h*31+(i^(h>>>7)))|0;}return h;}",
    "function objs(n){const a=[];for(let i=0;i<n;i++)a.push({i:i,s:\"v\"+i,f:i*0.5});return JSON.parse(JSON.stringify(a)).reduce((t,o)=>t+o.i,0);}",
    "function words(n){let t=\"\";for(let i=0;i<n;i++)t+=\"id-\"+i+\" \";return (t.match(/id-[0-9]+7 /g)||[]).length;}",
    "const wasm=new Uint8Array([0,97,115,109,1,0,0,0,1,7,1,96,2,127,127,1,127,3,2,1,0,7,7,1,3,97,100,100,0,0,10,9,1,7,0,32,0,32,1,106,11]);",
    "const workerSource=\"onmessage=e=>{let s=0;for(let i=0;i<e.data;i++)s=(s+i*i)%1000003;postMessage(s)}\";",
    "async function run(){",
    "  const t0=performance.now();",
    "  const r=[primes(2000000),mix(5000000),objs(200000),words(50000)];",
    "  for(let k=0;k<5;k++)r[1]^=mix(1000000);",
    "  const m=await WebAssembly.instantiate(wasm);r.push(m.instance.exports.add(40,2));",
    "  const w=new Worker(URL.createObjectURL(new Blob([workerSource],{type:\"text/javascript\"})));",
    "  r.push(await new Promise((ok,no)=>{w.onmessage=e=>ok(e.data);w.onerror=no;w.postMessage(3000000);}));",
    "  const g=document.getElementById(\"c\").getContext(\"2d\");",
    "  for(let i=0;i<2000;i++){g.fillStyle=\"hsl(\"+(i%360)+\",70%,50%)\";g.fillRect((i*7)%400,(i*3)%160,6,6);}",
    "  await new Promise(f=>requestAnimationFrame(()=>requestAnimationFrame(f)));",
    "  document.getElementById(\"s\").textContent=\"HEAVY PAGE READY\";",
    "  document.title=\"jr-cefjit heavy ok \"+r.join(\" \")+\" ms \"+Math.round(performance.now()-t0);",
    "}",
    "run().catch(e=>{document.getElementById(\"s\").textContent=\"HEAVY PAGE ERROR\";document.title=\"jr-cefjit heavy error \"+e;});",
    "</script></body>"
   ]
