{
  "id": "nested-splits",
  "priority": "P0",
  "title": "Nested splits (right, then down, then right again): every pane is fitted and its PTY has its own size",
  "why": "Split trees three levels deep are everyday use (an editor, a server, logs, a shell). Every pane must keep a shell that answers, and every PTY must have its pane's grid, not its parent's.",
  "source": "window life: split (holistic-quality.md 1), nested",
  "budget_seconds": 90,
  "steps": [
    {"do": "new_terminal", "name": "jr-nested"},
    {"do": "neutral_prompt"},
    {"do": "name_pane", "as": "a"},
    {"do": "window_place", "title": "set-up: the window at 85% x 85% of the screen", "fraction": [0.02, 0.03, 0.85, 0.85]},
    {"do": "expect", "title": "the terminal fits the placed window", "timeout": 10, "all": [{"grid_fits": {}}]},
    {"do": "remember", "as": "full"},
    {"do": "key", "title": "Cmd-D", "key": "d", "modifiers": ["cmd"]},
    {"do": "adopt_pane", "as": "b"},
    {"do": "neutral_prompt"},
    {"do": "remember", "as": "b-half", "pane": "b"},
    {"do": "key", "title": "Cmd-Shift-D in b", "key": "d", "modifiers": ["cmd", "shift"]},
    {"do": "adopt_pane", "as": "c"},
    {"do": "neutral_prompt"},
    {"do": "remember", "as": "c-quarter", "pane": "c"},
    {"do": "key", "title": "Cmd-D in c", "key": "d", "modifiers": ["cmd"], "mark": "third"},
    {"do": "adopt_pane", "as": "d"},
    {"do": "neutral_prompt"},
    {"do": "expect", "title": "four panes in the right places, each at its share of the window and fitted", "since": "third", "timeout": 10,
     "all": [
       {"pane_frame": {"pane": "b", "right_of": "a"}},
       {"pane_frame": {"pane": "c", "below": "b"}},
       {"pane_frame": {"pane": "d", "right_of": "c"}},
       {"pane_frame": {"pane": "a", "vs": "full", "w": 0.5, "h": 1.0, "tol": 0.06}},
       {"pane_frame": {"pane": "b", "vs": "full", "w": 0.5, "h": 0.5, "tol": 0.07}},
       {"pane_frame": {"pane": "c", "vs": "full", "w": 0.25, "h": 0.5, "tol": 0.07}},
       {"pane_frame": {"pane": "d", "vs": "full", "w": 0.25, "h": 0.5, "tol": 0.07}},
       {"grid_fits": {"pane": "a"}},
       {"grid_fits": {"pane": "b"}},
       {"grid_fits": {"pane": "c", "vs": "c-quarter", "cols": "narrower", "rows": "same"}},
       {"grid_fits": {"pane": "d"}},
       {"app_prompt": true}
     ]},

    {"do": "type", "text": "echo d-${nonce} $(stty size)", "enter": true, "mark": "td"},
    {"do": "expect", "title": "d answers with its own PTY size", "since": "td", "timeout": 10,
     "all": [{"pty_size": {"tag": "d-${nonce}", "pane": "d"}}, {"app_text_contains": "d-${nonce} "}, {"pane_frame_text": {"text": "d-${nonce}", "pane": "d"}}]},
    {"do": "use_pane", "pane": "c", "click": true},
    {"do": "type", "text": "echo c-${nonce} $(stty size)", "enter": true, "mark": "tc"},
    {"do": "expect", "title": "c answers with its own PTY size", "since": "tc", "timeout": 10,
     "all": [{"pty_size": {"tag": "c-${nonce}", "pane": "c"}}, {"app_text_contains": "c-${nonce} "}, {"pane_frame_text": {"text": "c-${nonce}", "pane": "c"}}]},
    {"do": "use_pane", "pane": "b", "click": true},
    {"do": "type", "text": "echo b-${nonce} $(stty size)", "enter": true, "mark": "tb"},
    {"do": "expect", "title": "b answers with its own PTY size", "since": "tb", "timeout": 10,
     "all": [{"pty_size": {"tag": "b-${nonce}", "pane": "b"}}, {"app_text_contains": "b-${nonce} "}, {"pane_frame_text": {"text": "b-${nonce}", "pane": "b"}}]},
    {"do": "use_pane", "pane": "a", "click": true},
    {"do": "type", "text": "echo a-${nonce} $(stty size)", "enter": true, "mark": "ta"},
    {"do": "expect", "title": "a answers with its own PTY size; every pane's text shows in one frame", "since": "ta", "timeout": 10,
     "all": [
       {"pty_size": {"tag": "a-${nonce}", "pane": "a"}},
       {"daemon_prompt": true},
       {"app_text_contains": "a-${nonce} "},
       {"pane_frame_text": {"text": "a-${nonce}", "pane": "a"}},
       {"pane_frame_text": {"text": "b-${nonce}", "pane": "b"}},
       {"pane_frame_text": {"text": "c-${nonce}", "pane": "c"}},
       {"pane_frame_text": {"text": "d-${nonce}", "pane": "d"}}
     ]}
  ],
  "finally": [{"do": "restore_window", "from": "before-place"}]
}
