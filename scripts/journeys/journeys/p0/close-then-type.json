{
 "id": "close-then-type",
 "priority": "P0",
 "title": "Cmd-W on the focused right pane, then a line typed at once: the whole line runs in the left pane (8 tries)",
 "why": "STATUS 1333/1353: journey r3-after-switch round s3 (cmux19, build a0f707a2) pressed Cmd-W in the right pane and typed at once; the left shell ran 'cho ...'. A person's Cmd-W on a live terminal waits for the daemon's read (TabCloseGuard) and the closing terminal keeps the keyboard meanwhile, so the first key went into it.",
 "source": "P0 close-then-type (cmux-ad, 2026-10-31): a key typed after a close goes to the pane that has the focus after the close, never dropped",
 "budget_seconds": 200,
 "steps": [
  {
   "do": "new_terminal",
   "name": "jr-close-type"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "name_pane",
   "as": "left"
  },
  {
   "do": "window_place",
   "title": "set-up: the window at 70% x 70% of the screen",
   "fraction": [
    0.05,
    0.05,
    0.7,
    0.7
   ]
  },
  {
   "do": "type",
   "text": "echo keep-${nonce}",
   "enter": true
  },
  {
   "do": "key",
   "title": "try 1: Cmd-D",
   "key": "d",
   "modifiers": [
    "cmd"
   ]
  },
  {
   "do": "adopt_pane",
   "as": "r1"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "use_pane",
   "pane": "r1",
   "click": true,
   "title": "try 1: click into the right pane"
  },
  {
   "do": "key",
   "title": "try 1: Cmd-W closes the focused right pane",
   "key": "w",
   "modifiers": [
    "cmd"
   ],
   "mark": "c1"
  },
  {
   "do": "use_pane",
   "pane": "left"
  },
  {
   "do": "type",
   "title": "try 1: a line typed at once after Cmd-W",
   "text": "echo ct1-${nonce}x$((6*7))",
   "enter": true,
   "mark": "t1"
  },
  {
   "do": "expect",
   "title": "try 1: the whole line ran in the left pane (its first key too), the right pane is gone",
   "since": "t1",
   "timeout": 10,
   "all": [
    {
     "pane_state": {
      "pane": "r1",
      "gone": true
     }
    },
    {
     "daemon_line": "ct1-${nonce}x42"
    },
    {
     "app_text_line": "ct1-${nonce}x42"
    }
   ]
  },
