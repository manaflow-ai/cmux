{
 "id": "rv-zoom-12-idle-dark",
 "priority": "P1",
 "title": "Zoom one of 12 panes (3 columns x 4 rows; Shift-Cmd-Return), then unzoom (idle load, dark)",
 "why": "Lawrence 2026-11-02: every layout animation pixel perfect at 120 Hz with a 12-pane TUI load. The movie and trace are judged per frame (gap, overlap, stretch, stale content, jump, dropped frames).",
 "source": "RESIZE VIDEOS suite (handoff/resize-videos/FINDINGS.md)",
 "budget_seconds": 240,
 "options": {
  "key_path": "real"
 },
 "steps": [
  {
   "do": "settings_file",
   "title": "set-up: theme Builtin Dark, no close warning, new columns share the strip",
   "set": {
    "appearance": {
     "theme": "Builtin Dark",
     "appTheme": "followTerminal"
    },
    "app": {
     "warnBeforeClosingTab": false
    },
    "layout": {
     "newColumnWidth": "fitScreen"
    }
   }
  },
  {
   "do": "smoke_ready",
   "timeout": 60
  },
  {
   "do": "smoke_make_key"
  },
  {
   "do": "new_terminal",
   "via": "key",
   "name": "rv-zoom-12-idle-dark"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "name_pane",
   "as": "home"
  },
  {
   "do": "window_place",
   "title": "set-up: the window at 90% x 90% of the screen",
   "fraction": [
    0.05,
    0.05,
    0.9,
    0.9
   ]
  },
  {
   "do": "action",
   "action": "workspace.newAtBottom",
   "title": "set-up: a new workspace for the case"
  },
  {
   "do": "adopt_pane",
   "as": "p0"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "action",
   "action": "splitDown",
   "title": "set-up: splitDown"
  },
  {
   "do": "adopt_pane",
   "as": "p1"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "action",
   "action": "splitDown",
   "title": "set-up: splitDown"
  },
  {
   "do": "adopt_pane",
   "as": "p2"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "action",
   "action": "splitDown",
   "title": "set-up: splitDown"
  },
  {
   "do": "adopt_pane",
   "as": "p3"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "action",
   "action": "newColumn",
   "title": "set-up: newColumn"
  },
  {
   "do": "adopt_pane",
   "as": "p4"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "try_action",
   "action": "column.widthOneThird",
   "title": "set-up: the focused column 1/3 of the viewport (may hold already)"
  },
  {
   "do": "action",
   "action": "splitDown",
   "title": "set-up: splitDown"
  },
  {
   "do": "adopt_pane",
   "as": "p5"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "action",
   "action": "splitDown",
   "title": "set-up: splitDown"
  },
  {
   "do": "adopt_pane",
   "as": "p6"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "action",
   "action": "splitDown",
   "title": "set-up: splitDown"
  },
  {
   "do": "adopt_pane",
   "as": "p7"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "action",
   "action": "newColumn",
   "title": "set-up: newColumn"
  },
  {
   "do": "adopt_pane",
   "as": "p8"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "try_action",
   "action": "column.widthOneThird",
   "title": "set-up: the focused column 1/3 of the viewport (may hold already)"
  },
  {
   "do": "action",
   "action": "splitDown",
   "title": "set-up: splitDown"
  },
  {
   "do": "adopt_pane",
   "as": "p9"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "action",
   "action": "splitDown",
   "title": "set-up: splitDown"
  },
  {
   "do": "adopt_pane",
   "as": "p10"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "action",
   "action": "splitDown",
   "title": "set-up: splitDown"
  },
  {
   "do": "adopt_pane",
   "as": "p11"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "action",
   "action": "focusLeft",
   "title": "set-up: focus the column on the left"
  },
  {
   "do": "action",
   "action": "focusLeft",
   "title": "set-up: focus the column on the left"
  },
  {
   "do": "try_action",
   "action": "column.widthOneThird",
   "title": "set-up: the focused column 1/3 of the viewport (may hold already)"
  },
  {
   "do": "use_pane",
   "pane": "p4",
   "click": true
  },
  {
   "do": "wait",
   "seconds": 1.5,
   "title": "the layout and the load settle (nothing observable to wait on)"
  },
  {
   "do": "rpc",
   "method": "debug.main_budget",
   "params": {
    "reset": true
   },
   "title": "probe: main budget reset"
  },
  {
   "do": "rpc",
   "method": "debug.frames",
   "params": {
    "action": "start",
    "raw": true
   },
   "title": "probe: per-frame main thread on"
  },
  {
   "do": "video_start",
   "name": "rv-zoom-12-idle-dark",
   "seconds": 20,
   "title": "start the movie and the geometry trace (rv-zoom-12-idle-dark)"
  },
  {
   "do": "wait",
   "seconds": 0.6,
   "title": "lead: the recorder's start stall passes before the motion"
  },
  {
   "do": "hid_key",
   "key": "return",
   "modifiers": [
    "cmd",
    "shift"
   ],
   "mark": "zoom",
   "title": "zoom in"
  },
  {
   "do": "wait",
   "seconds": 1.0
  },
  {
   "do": "hid_key",
   "key": "return",
   "modifiers": [
    "cmd",
    "shift"
   ],
   "mark": "unzoom",
   "title": "zoom out"
  },
  {
   "do": "video_stop",
   "name": "rv-zoom-12-idle-dark",
   "tail": 1.2,
   "title": "the motion ends; stop the recording (rv-zoom-12-idle-dark)"
  },
  {
   "do": "rpc",
   "method": "debug.frames",
   "params": {
    "action": "stop",
    "raw": true
   },
   "title": "probe: per-frame main thread (raw)"
  },
  {
   "do": "rpc",
   "method": "debug.main_budget",
   "params": {},
   "title": "probe: main budget since the reset"
  },
  {
   "do": "rpc",
   "method": "debug.hangs",
   "params": {},
   "title": "probe: hangs"
  },
  {
   "do": "use_pane",
   "pane": "p0",
   "click": true,
   "title": "after: click into p0"
  },
  {
   "do": "key",
   "key": "c",
   "modifiers": [
    "control"
   ],
   "title": "after: Ctrl-C ends p0's load program"
  },
  {
   "do": "type",
   "text": "echo rv-done-${nonce}",
   "enter": true,
   "mark": "after"
  },
  {
   "do": "expect",
   "title": "p0 echoes the line: app, daemon and frame",
   "since": "after",
   "timeout": 10,
   "all": [
    {
     "daemon_line": "rv-done-${nonce}"
    },
    {
     "app_text_line": "rv-done-${nonce}"
    },
    {
     "frame_text": "rv-done-${nonce}"
    }
   ]
  }
 ]
}
