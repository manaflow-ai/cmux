{
 "id": "bv-ctx",
 "priority": "P1",
 "title": "#32132: devtools.openDocked over a page just shown in a new browser workspace (18 cycles, refusals counted)",
 "why": "The action context must follow the focused web view: the Developer Tools set is never refused over a focused page.",
 "source": "handoff/resize-videos (BROWSER VIDEO suite, lead STATUS 4282; Lawrence's DevTools case)",
 "budget_seconds": 250,
 "options": {
  "key_path": "real"
 },
 "steps": [
  {
   "do": "smoke_ready",
   "timeout": 60
  },
  {
   "do": "smoke_make_key"
  },
  {
   "do": "rpc",
   "title": "set-up: the app in dark (debug.appearance; Chromium and pages follow NSApp)",
   "method": "debug.appearance",
   "params": {
    "mode": "dark"
   }
  },
  {
   "do": "wait",
   "seconds": 0.8
  },
  {
   "do": "bv_serve"
  },
  {
   "do": "rpc",
   "title": "set-up: a workspace of its own (not Home: its chat would take the agent chat)",
   "method": "action.run",
   "params": {
    "action": "newTab",
    "args": {
     "name": "bv-main",
     "focus": true
    }
   }
  },
  {
   "do": "wait",
   "seconds": 1.2
  },
  {
   "do": "hid_key",
   "key": "n",
   "modifiers": [
    "cmd",
    "option"
   ],
   "title": "cycle 1: New Browser Workspace (Opt-Cmd-N)"
  },
  {
   "do": "wait",
   "seconds": 1.5
  },
  {
   "do": "hid_key",
   "key": "l",
   "modifiers": [
    "cmd"
   ],
   "title": "the address bar (Cmd-L)"
  },
  {
   "do": "wait",
   "seconds": 0.4
  },
  {
   "do": "smoke_type",
   "text": "${bv_base}/light.html",
   "enter": true,
   "title": "the test page typed"
  },
  {
   "do": "bv_page_ready",
   "page": "light"
  },
  {
   "do": "wait",
   "seconds": 0.8
  },
  {
   "do": "hid_click",
   "target": {
    "window_point": [
     560,
     420
    ]
   },
   "title": "focus the page (a real click)"
  },
  {
   "do": "wait",
   "seconds": 0.4
  },
