{
 "id": "rv-xtpa-zoom-12-idle-dark",
 "priority": "P1",
 "title": "xctrace, app clock: zoom one of 12 panes, unzoom 1.2 s later (idle, dark)",
 "why": "Lead 2026-11-02 09:0xZ: before/after main-thread time per close and per zoom of the merged fixes #31756, #31811, #31810.",
 "source": "RESIZE VIDEOS suite (handoff/resize-videos/FINDINGS.md)",
 "budget_seconds": 240,
 "options": {
  "key_path": "real"
 },
 "steps": [
  {
   "do": "settings_file",
   "title": "set-up: theme Builtin Dark, no close warning, new columns share the strip",
   "set": {
    "appearance": {
     "theme": "Builtin Dark",
     "appTheme": "followTerminal"
    },
    "app": {
     "warnBeforeClosingTab": false
    },
    "layout": {
     "newColumnWidth": "fitScreen"
    }
   }
  },
  {
   "do": "smoke_ready",
   "timeout": 60
  },
  {
   "do": "smoke_make_key"
  },
  {
   "do": "new_terminal",
   "via": "key",
   "name": "rv-xtpa-zoom-12-idle-dark"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "name_pane",
   "as": "home"
  },
  {
   "do": "window_place",
   "title": "set-up: the window at 90% x 90% of the screen",
   "fraction": [
    0.05,
    0.05,
    0.9,
    0.9
   ]
  },
  {
   "do": "action",
   "action": "workspace.newAtBottom",
   "title": "set-up: a new workspace for the case"
  },
  {
   "do": "adopt_pane",
   "as": "p0"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "action",
   "action": "splitDown",
   "title": "set-up: splitDown"
  },
  {
   "do": "adopt_pane",
   "as": "p1"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "action",
   "action": "splitDown",
   "title": "set-up: splitDown"
  },
  {
   "do": "adopt_pane",
   "as": "p2"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "action",
   "action": "splitDown",
   "title": "set-up: splitDown"
  },
  {
   "do": "adopt_pane",
   "as": "p3"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "action",
   "action": "newColumn",
   "title": "set-up: newColumn"
  },
  {
   "do": "adopt_pane",
   "as": "p4"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "try_action",
   "action": "column.widthOneThird",
   "title": "set-up: the focused column 1/3 of the viewport (may hold already)"
  },
  {
   "do": "action",
   "action": "splitDown",
   "title": "set-up: splitDown"
  },
  {
   "do": "adopt_pane",
   "as": "p5"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "action",
   "action": "splitDown",
   "title": "set-up: splitDown"
  },
  {
   "do": "adopt_pane",
   "as": "p6"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "action",
   "action": "splitDown",
   "title": "set-up: splitDown"
  },
  {
   "do": "adopt_pane",
   "as": "p7"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "action",
   "action": "newColumn",
   "title": "set-up: newColumn"
  },
  {
   "do": "adopt_pane",
   "as": "p8"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "try_action",
   "action": "column.widthOneThird",
   "title": "set-up: the focused column 1/3 of the viewport (may hold already)"
  },
  {
   "do": "action",
   "action": "splitDown",
   "title": "set-up: splitDown"
  },
  {
   "do": "adopt_pane",
   "as": "p9"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "action",
   "action": "splitDown",
   "title": "set-up: splitDown"
  },
  {
   "do": "adopt_pane",
   "as": "p10"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "action",
   "action": "splitDown",
   "title": "set-up: splitDown"
  },
  {
   "do": "adopt_pane",
   "as": "p11"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "action",
   "action": "focusLeft",
   "title": "set-up: focus the column on the left"
  },
  {
   "do": "action",
   "action": "focusLeft",
   "title": "set-up: focus the column on the left"
  },
  {
   "do": "try_action",
   "action": "column.widthOneThird",
   "title": "set-up: the focused column 1/3 of the viewport (may hold already)"
  },
  {
   "do": "use_pane",
   "pane": "p4",
   "click": true
  },
  {
   "do": "wait",
   "seconds": 1.5,
   "title": "the layout and the load settle (nothing observable to wait on)"
  },
  {
   "do": "trace_only_start",
   "name": "close",
   "title": "the geometry trace (display-link ticks), no recorder"
  },
  {
   "do": "xtp_start",
   "name": "xtp",
   "seconds": 5.2,
   "wait_first_sample": true,
   "first_sample_wait": 1.0,
   "title": "xctrace Time Profiler on the app"
  },
  {
   "do": "rpc",
   "method": "debug.stall",
   "params": {
    "ms": 60
   },
   "title": "clock mark: a 60 ms main-thread stall"
  },
  {
   "do": "wait",
   "seconds": 0.5,
   "title": "the mark's frames pass"
  },
  {
   "do": "hid_key",
   "key": "return",
   "modifiers": [
    "cmd",
    "shift"
   ],
   "mark": "zoom",
   "title": "zoom in"
  },
  {
   "do": "wait",
   "seconds": 1.2
  },
  {
   "do": "hid_key",
   "key": "return",
   "modifiers": [
    "cmd",
    "shift"
   ],
   "mark": "unzoom",
   "title": "zoom out"
  },
  {
   "do": "wait",
   "seconds": 1.2,
   "title": "the motion lands"
  },
  {
   "do": "trace_only_stop",
   "name": "close"
  },
  {
   "do": "xtp_stop",
   "name": "xtp"
  },
  {
   "do": "use_pane",
   "pane": "p0",
   "click": true,
   "title": "after: click into p0"
  },
  {
   "do": "key",
   "key": "c",
   "modifiers": [
    "control"
   ],
   "title": "after: Ctrl-C ends p0's load program"
  },
  {
   "do": "type",
   "text": "echo rv-done-${nonce}",
   "enter": true,
   "mark": "after"
  },
  {
   "do": "expect",
   "title": "p0 echoes the line: app, daemon and frame",
   "since": "after",
   "timeout": 10,
   "all": [
    {
     "daemon_line": "rv-done-${nonce}"
    },
    {
     "app_text_line": "rv-done-${nonce}"
    },
    {
     "frame_text": "rv-done-${nonce}"
    }
   ]
  }
 ]
}
