   "key": "1",
   "modifiers": [
    "cmd"
   ],
   "mark": "back-2",
   "title": "switch back (Cmd-1)"
  },
  {
   "do": "wait",
   "seconds": 1.2
  },
  {
   "do": "hid_key",
   "key": "left",
   "modifiers": [
    "control",
    "cmd"
   ],
   "mark": "resize-a-2",
   "title": "resize the pane (Ctrl-Cmd-Left)"
  },
  {
   "do": "wait",
   "seconds": 1.0
  },
  {
   "do": "hid_key",
   "key": "right",
   "modifiers": [
    "control",
    "cmd"
   ],
   "mark": "resize-b-2",
   "title": "resize the pane (Ctrl-Cmd-Right)"
  },
  {
   "do": "wait",
   "seconds": 1.0
  },
  {
   "do": "bv_state",
   "page": "heavy",
   "as": "resized-2"
  },
  {
   "do": "hid_key",
   "key": "w",
   "modifiers": [
    "cmd"
   ],
   "mark": "close-tab-2",
   "title": "close the page tab (Cmd-W)"
  },
  {
   "do": "wait",
   "seconds": 1.0
  },
  {
   "do": "hid_key",
   "key": "w",
   "modifiers": [
    "cmd"
   ],
   "mark": "close-2",
   "title": "close the browser pane (Cmd-W)"
  },
  {
