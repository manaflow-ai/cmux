{
 "id": "rv-close-in-row-xtp-idle-dark",
 "priority": "P1",
 "title": "Close the middle of 3 split panes in a row, xctrace Time Profiler, no recorder (F1 before/after) (idle load, dark)",
 "why": "Lawrence 2026-11-02: every layout animation pixel perfect at 120 Hz with a 12-pane TUI load. The movie and trace are judged per frame (gap, overlap, stretch, stale content, jump, dropped frames).",
 "source": "RESIZE VIDEOS suite (handoff/resize-videos/FINDINGS.md)",
 "budget_seconds": 240,
 "options": {
  "key_path": "real"
 },
 "steps": [
  {
   "do": "settings_file",
   "title": "set-up: theme Builtin Dark, no close warning, new columns share the strip",
   "set": {
    "appearance": {
     "theme": "Builtin Dark",
     "appTheme": "followTerminal"
    },
    "app": {
     "warnBeforeClosingTab": false
    },
    "layout": {
     "newColumnWidth": "fitScreen"
    }
   }
  },
  {
   "do": "smoke_ready",
   "timeout": 60
  },
  {
   "do": "smoke_make_key"
  },
  {
   "do": "new_terminal",
   "via": "key",
   "name": "rv-close-in-row-xtp-idle-dark"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "name_pane",
   "as": "home"
  },
  {
   "do": "window_place",
   "title": "set-up: the window at 90% x 90% of the screen",
   "fraction": [
    0.05,
    0.05,
    0.9,
    0.9
   ]
  },
  {
   "do": "action",
   "action": "workspace.newAtBottom",
   "title": "set-up: a new workspace for the case"
  },
  {
   "do": "adopt_pane",
   "as": "p0"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "action",
   "action": "splitRight",
   "title": "set-up: splitRight"
  },
  {
   "do": "adopt_pane",
   "as": "p1"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "action",
   "action": "splitRight",
   "title": "set-up: splitRight"
  },
  {
   "do": "adopt_pane",
   "as": "p2"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "use_pane",
   "pane": "p1",
   "click": true,
   "title": "focus p1 (a click)"
  },
  {
   "do": "wait",
   "seconds": 1.5,
   "title": "the layout and the load settle (nothing observable to wait on)"
  },
  {
   "do": "rpc",
   "method": "debug.main_budget",
   "params": {
    "reset": true
   },
   "title": "probe: main budget reset"
  },
  {
   "do": "rpc",
   "method": "debug.frames",
   "params": {
    "action": "start",
    "raw": true
   },
   "title": "probe: per-frame main thread on"
  },
  {
   "do": "trace_only_start",
   "name": "close",
   "title": "the geometry trace, no recorder"
  },
  {
   "do": "wait",
   "seconds": 0.6,
   "title": "lead: the recorder's start stall passes before the motion"
  },
  {
   "do": "xtp_start",
   "name": "xtp",
   "seconds": 2.0,
   "title": "xctrace Time Profiler on the app for 2 s from just before the key"
  },
  {
   "do": "hid_key",
   "key": "w",
   "modifiers": [
    "cmd"
   ],
   "mark": "close",
   "title": "Cmd-W closes p1"
  },
  {
   "do": "wait",
   "seconds": 1.2,
   "title": "the motion ends"
  },
  {
   "do": "trace_only_stop",
   "name": "close"
  },
  {
   "do": "rpc",
   "method": "debug.frames",
   "params": {
    "action": "stop",
    "raw": true
   },
   "title": "probe: per-frame main thread (raw)"
  },
  {
   "do": "rpc",
   "method": "debug.main_budget",
   "params": {},
   "title": "probe: main budget since the reset"
  },
  {
   "do": "rpc",
   "method": "debug.hangs",
   "params": {},
   "title": "probe: hangs"
  },
  {
   "do": "xtp_stop",
   "name": "xtp"
  },
  {
   "do": "use_pane",
   "pane": "p0",
   "click": true,
   "title": "after: click into p0"
  },
  {
   "do": "key",
   "key": "c",
   "modifiers": [
    "control"
   ],
   "title": "after: Ctrl-C ends p0's load program"
  },
  {
   "do": "type",
   "text": "echo rv-done-${nonce}",
   "enter": true,
   "mark": "after"
  },
  {
   "do": "expect",
   "title": "p0 echoes the line: app, daemon and frame",
   "since": "after",
   "timeout": 10,
   "all": [
    {
     "daemon_line": "rv-done-${nonce}"
    },
    {
     "app_text_line": "rv-done-${nonce}"
    },
    {
     "frame_text": "rv-done-${nonce}"
    }
   ]
  }
 ]
}
