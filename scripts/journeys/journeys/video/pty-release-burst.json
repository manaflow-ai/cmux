{
  "id": "pty-release-burst",
  "priority": "P1",
  "title": "PTY release: 50 terminal tabs closed at once give their PTYs back (the daemon tree's /dev/ptmx count by process, at 0-5 s, 10 s and 60 s after, and after the workspace close)",
  "why": "Lead 2026-11-03 00:4xZ: L6 at 120/s ran the host out of PTYs ('PTY capacity exhausted', STATUS 7860); a closed tab that keeps its PTY would be a daemon leak.",
  "source": "TYPING UNDER LOAD (lead 00:4xZ)",
  "budget_seconds": 260,
  "continue_not_judged": true,
  "steps": [
    {
      "do": "smoke_ready",
      "timeout": 60
    },
    {
      "do": "env_windows",
      "at": "start"
    },
    {
      "do": "smoke_remember_workspaces"
    },
    {
      "do": "smoke_make_key"
    },
    {
      "do": "smoke_key",
      "key": "n",
      "modifiers": [
        "cmd"
      ],
      "mark": "ws"
    },
    {
      "do": "expect",
      "title": "set-up: Cmd-N makes the typing workspace",
      "since": "ws",
      "timeout": 20,
      "all": [
        {
          "smoke_workspaces": {
            "new": 1
          }
        },
        {
          "smoke_frame": {}
        }
      ]
    },
    {
      "do": "smoke_key",
      "key": "`",
      "modifiers": [
        "control"
      ],
      "mark": "term"
    },
    {
      "do": "outwait_hold"
    },
    {
      "do": "smoke_type",
      "text": "echo typing-${nonce}",
      "enter": true
    },
    {
      "do": "expect",
      "title": "set-up: the typing terminal runs its line",
      "since": "term",
      "timeout": 30,
      "all": [
        {
          "smoke_daemon_lines": {
            "lines": [
              "typing-${nonce}"
            ]
          }
        }
      ]
    },
    {
      "do": "smoke_adopt_line",
      "line": "typing-${nonce}",
      "as": "typing"
    },
    {
      "do": "pty_release",
      "tabs": 50,
      "threads": 16,
      "timeout": 190
    }
  ],
  "finally": [
    {
      "do": "env_windows",
      "at": "end"
    },
    {
      "do": "smoke_close_all"
    }
  ]
}
