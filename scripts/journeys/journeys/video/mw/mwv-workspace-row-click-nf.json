      "do": "expect",
      "title": "three new windows, two workspaces each",
      "timeout": 15,
      "all": [
        {
          "windows_open": {
            "baseline_plus": 3
          }
        },
        {
          "window_state": {
            "window": "w1",
            "lists": [
              "mw-rc-a1-${nonce}",
              "mw-rc-a2-${nonce}"
            ]
          }
        },
        {
          "window_state": {
            "window": "w2",
            "lists": [
              "mw-rc-b1-${nonce}",
              "mw-rc-b2-${nonce}"
            ]
