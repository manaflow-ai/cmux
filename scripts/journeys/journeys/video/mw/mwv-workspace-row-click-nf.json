      "as": "w0",
      "title": "the first window (it keeps the earlier journeys' workspaces; a bystander here)"
    },
    {
      "do": "move_workspace",
      "workspace": "mw-rc-a1-${nonce}",
      "to": "new",
      "as": "w1",
      "title": "set-up: workspace a1 into a new window 1"
    },
    {
      "do": "move_workspace",
      "workspace": "mw-rc-a2-${nonce}",
      "to": "w1",
      "title": "set-up: workspace a2 into window 1"
    },
    {
      "do": "move_workspace",
      "workspace": "mw-rc-b1-${nonce}",
      "to": "new",
      "as": "w2",
      "title": "set-up: workspace b1 into a new window 2"
    },
    {
      "do": "move_workspace",
      "workspace": "mw-rc-b2-${nonce}",
      "to": "w2",
      "title": "set-up: workspace b2 into window 2"
    },
    {
      "do": "move_workspace",
      "workspace": "mw-rc-c1-${nonce}",
      "to": "new",
      "as": "w3",
      "title": "set-up: workspace c1 into a new window 3"
    },
    {
      "do": "move_workspace",
      "workspace": "mw-rc-c2-${nonce}",
      "to": "w3",
      "title": "set-up: workspace c2 into window 3"
    },
