      "do": "expect",
      "title": "window 1 shows a1; every other window did not change",
      "since": "c10",
      "timeout": 10,
      "settle": 0.5,
      "all": [
        {
          "window_state": {
            "window": "w1",
            "workspace": "mw-rc-a1-${nonce}",
            "home": false
