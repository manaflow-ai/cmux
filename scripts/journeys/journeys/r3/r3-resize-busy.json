{
 "id": "r3-resize-busy",
 "priority": "P1",
 "title": "R3 (e): resize the window and the split while a terminal prints without a stop: one size everywhere",
 "why": "Lawrence's v2.2.11-opt capture (2026-10-31): grid 297x87 but fit_grid 126x87 in a 2088x1233 view. After a resize the shown terminal must have one size in the app, Ghostty, the PTY and the daemon, and a typed long line must wrap at it.",
 "source": "cmux-ad P0 2026-10-31 (Lawrence on v2.2.11-opt: resizing terminals is broken); R3 invariant",
 "budget_seconds": 250,
 "steps": [
  {
   "do": "new_terminal",
   "via": "key",
   "name": "jr-r3-busy"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "type",
   "text": "echo base-${nonce}",
   "enter": true
  },
  {
   "do": "smoke_adopt_line",
   "line": "base-${nonce}",
   "as": "main"
  },
  {
   "do": "window_place",
   "title": "set-up: the window at 70% x 70% of the screen",
   "fraction": [
    0.05,
    0.05,
    0.7,
    0.7
   ]
  },
  {
   "do": "expect",
   "title": "baseline: the terminal fits the placed window (R3, settled)",
   "timeout": 15,
   "settle": 1.5,
   "all": [
    {
     "r3_settled": {
      "pane": "main"
     }
    }
   ]
  },
  {
   "do": "remember",
   "as": "start",
   "pane": "main"
  },
  {
   "do": "type",
   "text": "while :; do echo busy-$RANDOM-$RANDOM-$RANDOM-$RANDOM-$RANDOM-$RANDOM; done",
   "enter": true,
   "mark": "busy"
  },
  {
   "do": "key",
   "title": "Cmd-D",
   "key": "d",
   "modifiers": [
    "cmd"
   ],
   "mark": "split"
  },
  {
   "do": "adopt_pane",
   "as": "right"
  },
  {
   "do": "neutral_prompt"
  },
  {
   "do": "type",
   "text": "echo right-${nonce}",
   "enter": true
  },
  {
   "do": "smoke_adopt_line",
   "line": "right-${nonce}",
   "as": "right"
  },
  {
   "do": "window_drag",
   "title": "under output: drag the bottom-right corner 300 left, 200 up",
   "by": [
    -300,
    -200
   ],
   "events": 30,
   "mark": "shrink"
  },
  {
   "do": "type",
   "text": "echo r3bs-${nonce} $(stty size)",
   "enter": true
  },
  {
   "do": "r3_long_line",
   "tag": "r3bsw${nonce}"
  },
  {
   "do": "expect",
   "title": "r3bs: after the layout settles, right: grid == fit(bounds) == drawn == PTY == daemon == topology, and a long line wraps at the new width; also main",
   "since": "shrink",
   "timeout": 20,
   "settle": 2,
   "all": [
    {
     "r3_settled": {
      "pane": "right",
      "pty_tag": "r3bs-${nonce}",
      "long_tag": "r3bsw${nonce}"
     }
    },
    {
     "r3_settled": {
      "pane": "main"
     }
    },
    {
     "pty_size": {
      "tag": "r3bs-${nonce}",
      "pane": "right"
     }
    },
    {
     "smoke_frame": {}
    }
   ]
  },
  {
   "do": "remember",
   "as": "right1",
   "pane": "right"
  },
  {
   "do": "divider_drag",
   "title": "under output: drag the divider 120 points left",
   "between": [
    "main",
    "right"
   ],
   "by": -120,
   "events": 30,
   "mark": "drag"
  },
  {
   "do": "type",
   "text": "echo r3bd-${nonce} $(stty size)",
   "enter": true
  },
  {
   "do": "r3_long_line",
   "tag": "r3bdw${nonce}"
  },
  {
   "do": "expect",
   "title": "r3bd: after the layout settles, right: grid == fit(bounds) == drawn == PTY == daemon == topology, and a long line wraps at the new width; also main",
   "since": "drag",
   "timeout": 20,
   "settle": 2,
   "all": [
    {
     "r3_settled": {
      "pane": "right",
      "pty_tag": "r3bd-${nonce}",
      "long_tag": "r3bdw${nonce}",
      "vs": "right1",
      "cols": "wider"
     }
    },
    {
     "r3_settled": {
      "pane": "main"
     }
    },
    {
     "pty_size": {
      "tag": "r3bd-${nonce}",
      "pane": "right"
     }
    },
    {
     "smoke_frame": {}
    }
   ]
  },
  {
   "do": "window_drag",
   "title": "under output: drag the bottom-right corner 260 right, 160 down",
   "by": [
    260,
    160
   ],
   "events": 30,
   "mark": "grow"
  },
  {
   "do": "type",
   "text": "echo r3bg-${nonce} $(stty size)",
   "enter": true
  },
  {
   "do": "r3_long_line",
   "tag": "r3bgw${nonce}"
  },
  {
   "do": "expect",
   "title": "r3bg: after the layout settles, right: grid == fit(bounds) == drawn == PTY == daemon == topology, and a long line wraps at the new width; also main",
   "since": "grow",
   "timeout": 20,
   "settle": 2,
   "all": [
    {
     "r3_settled": {
      "pane": "right",
      "pty_tag": "r3bg-${nonce}",
      "long_tag": "r3bgw${nonce}"
     }
    },
    {
     "r3_settled": {
      "pane": "main"
     }
    },
    {
     "pty_size": {
      "tag": "r3bg-${nonce}",
      "pane": "right"
     }
    },
    {
     "smoke_frame": {}
    }
   ]
  }
 ],
 "finally": [
  {
   "do": "restore_window",
   "from": "before-place"
  }
 ]
}
