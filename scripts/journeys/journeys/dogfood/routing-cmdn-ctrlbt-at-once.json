{
  "id": "routing-cmdn-ctrlbt-at-once",
  "priority": "P1",
  "title": "Routing B: Cmd-N, Ctrl-` and a line with no wait: the line runs in the new terminal only",
  "why": "P0 #29530 (Cmd-N's New Tab hold took Ctrl-`), #30827",
  "source": "VIDEO EXTRA item 5, focus and input routing (lead 2026-11-02 00:29Z; STATUS 4271, 4283)",
  "budget_seconds": 120,
  "options": {
    "key_path": "real"
  },
  "continue_not_judged": true,
  "finally": [
    {
      "do": "rpc",
      "method": "debug.focus",
      "title": "the focus and key-hold state at the end (records only)"
    },
    {
      "do": "app_log",
      "seconds": 90,
      "grep": "newTab|closeTab|creation.hold|focus|firstResponder|keyRouter",
      "title": "the app log of the last 90 s (records only)"
    },
    {
      "do": "smoke_close_all"
    }
  ],
  "steps": [
    {
      "do": "smoke_ready",
      "timeout": 60
    },
    {
      "do": "smoke_remember_workspaces"
    },
    {
      "do": "smoke_make_key"
    },
    {
      "do": "smoke_snapshot",
      "name": "b1"
    },
    {
      "do": "smoke_key",
      "key": "n",
      "modifiers": [
        "cmd"
      ],
      "mark": "b1-ws"
    },
    {
      "do": "smoke_key",
      "key": "`",
      "modifiers": [
        "control"
      ],
      "mark": "b1"
    },
    {
      "do": "smoke_type_now",
      "text": "echo RB1-${nonce}-$((6*7))"
    },
    {
      "do": "expect",
      "title": "B1: Cmd-N, Ctrl-` and the line all at once: the line ran in the new terminal only",
      "since": "b1",
      "timeout": 20,
      "all": [
        {
          "routing_marker": {
            "line": "RB1-${nonce}-42",
            "on": "new:b1",
            "attempt": "B1"
          }
        },
        {
          "smoke_key_window": {}
        },
        {
          "frame_screen": {
            "shows": [
              "RB1-${nonce}-42"
            ]
          }
        }
      ]
    },
