{
  "id": "routing-click-during-split",
  "priority": "P1",
  "title": "Routing E: a click into a pane while a split animates, then a line at once: it runs in the clicked pane",
  "why": "#29262 (only the pane AppKit gives a press to takes the focus); the creation hold must not keep keys a click sent elsewhere",
  "source": "VIDEO EXTRA item 5, focus and input routing (lead 2026-11-02 00:29Z; STATUS 4271, 4283)",
  "budget_seconds": 258,
  "options": {
    "key_path": "real"
  },
  "continue_not_judged": true,
  "finally": [
    {
      "do": "video_close_open",
      "title": "stop a recording a failed check left open (its movie is the evidence)"
    },
    {
      "do": "env_windows",
      "at": "end",
      "title": "host dialogs at the end (SMOKE ENV mark)"
    },
    {
      "do": "rpc",
      "method": "debug.focus",
      "title": "the focus and key-hold state at the end (records only)"
    },
    {
      "do": "app_log",
      "seconds": 90,
      "grep": "newTab|closeTab|creation.hold|focus|firstResponder|keyRouter",
      "title": "the app log of the last 90 s (records only)"
    },
    {
      "do": "smoke_close_all"
    }
  ],
  "steps": [
    {
      "do": "smoke_ready",
      "timeout": 60
    },
    {
      "do": "env_windows",
      "at": "start"
    },
    {
      "do": "smoke_remember_workspaces"
    },
    {
      "do": "smoke_make_key"
    },
    {
      "do": "smoke_key",
      "key": "n",
      "modifiers": [
        "cmd"
      ],
      "mark": "setup-e10-ws"
    },
    {
      "do": "expect",
      "title": "set-up: Cmd-N makes the workspace of e10",
      "since": "setup-e10-ws",
      "timeout": 20,
      "all": [
        {
          "smoke_frame": {}
        }
      ]
    },
    {
      "do": "smoke_key",
      "key": "`",
      "modifiers": [
        "control"
      ],
      "mark": "setup-e10"
    },
    {
      "do": "outwait_hold"
    },
    {
      "do": "smoke_type",
      "text": "echo e10home-${nonce}",
      "enter": true
    },
    {
      "do": "expect",
      "title": "set-up: the terminal of e10 ran its line",
      "since": "setup-e10",
      "timeout": 30,
      "all": [
        {
          "smoke_daemon_lines": {
            "lines": [
              "e10home-${nonce}"
            ]
          }
        }
      ]
    },
    {
      "do": "smoke_adopt_line",
      "line": "e10home-${nonce}",
      "as": "e10"
    },
    {
      "do": "video_start",
      "name": "routing-e1",
      "seconds": 40
    },
    {
      "do": "smoke_key",
      "key": "d",
      "modifiers": [
        "cmd"
      ],
      "mark": "e1-split"
    },
    {
      "do": "routing_click",
      "pane": "e10",
      "mark": "e1"
    },
    {
      "do": "routing_type_now",
      "text": "echo RE1-${nonce}-$((6*7))"
    },
    {
      "do": "expect",
      "title": "E1: Cmd-D, a click into the first pane during the split animation, then a line at once: it ran in the clicked pane only",
      "since": "e1",
      "timeout": 20,
      "all": [
        {
          "routing_marker": {
            "line": "RE1-${nonce}-42",
            "on": "e10",
            "attempt": "E1"
          }
        },
        {
          "smoke_key_window": {}
        },
        {
          "frame_screen": {
            "shows": [
              "RE1-${nonce}-42"
            ]
          }
        }
      ]
    },
    {
      "do": "video_stop",
      "name": "routing-e1",
      "tail": 0.6
    },
