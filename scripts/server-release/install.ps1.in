# Generated release bootstrap. Archive hashes are pinned; Rust owns installation.
@@KEYS@@
function Invoke-CmuxServerInstall {
    $ErrorActionPreference = 'Stop'
    Set-StrictMode -Version Latest
    $installArguments = @($args | ForEach-Object { [string]$_ })
    $system = $false
    $expectValue = $false
    foreach ($argument in $installArguments) {
        if ($expectValue) {
            if ($argument -cnotmatch '^[A-Za-z0-9][A-Za-z0-9._+-]*$') { throw 'cmux-server-bootstrap: invalid_argument' }
            $expectValue = $false
            continue
        }
        switch -Exact ($argument) {
            '--system' { $system = $true }
            '--channel' { $expectValue = $true }
            '--version' { $expectValue = $true }
            '--json' {}
            default { throw 'cmux-server-bootstrap: invalid_argument' }
        }
    }
    if ($expectValue) { throw 'cmux-server-bootstrap: missing_argument' }
    $architecture = [Environment]::GetEnvironmentVariable('PROCESSOR_ARCHITEW6432')
    if (!$architecture) { $architecture = [Environment]::GetEnvironmentVariable('PROCESSOR_ARCHITECTURE') }
    switch -Exact ($architecture) {
        'AMD64' { $target = 'x86_64-windows' }
        'ARM64' { $target = 'aarch64-windows' }
        default { throw 'cmux-server-bootstrap: unsupported_platform' }
    }
    switch -Exact ($target) {
@@WINDOWS_CASES@@
    }
    $tempDir = Join-Path ([IO.Path]::GetTempPath()) ('cmux-server-bootstrap-' + [Guid]::NewGuid().ToString('N'))
    $null = New-Item -ItemType Directory -Path $tempDir
    try {
        # Protect the downloaded executable against replacement by other users.
        $identity = [Security.Principal.WindowsIdentity]::GetCurrent()
        $acl = New-Object Security.AccessControl.DirectorySecurity
        $acl.SetAccessRuleProtection($true, $false)
        $acl.SetOwner($identity.User)
        $rule = New-Object Security.AccessControl.FileSystemAccessRule($identity.User, 'FullControl', 'ContainerInherit,ObjectInherit', 'None', 'Allow')
        $acl.AddAccessRule($rule)
        Set-Acl -LiteralPath $tempDir -AclObject $acl
        $archive = Join-Path $tempDir 'bootstrap.zip'
        # Bound the body even when an upstream omits Content-Length. Redirects
        # are disabled: a release URL must directly serve this pinned object.
        Add-Type -AssemblyName System.Net.Http
        $handler = New-Object Net.Http.HttpClientHandler
        $handler.AllowAutoRedirect = $false
        $client = New-Object Net.Http.HttpClient($handler)
        $deadline = New-Object Threading.CancellationTokenSource
        $deadline.CancelAfter(300000)
        $oldProtocol = [Net.ServicePointManager]::SecurityProtocol
        $response = $null
        $source = $null
        $destination = $null
        try {
            [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
            $response = $client.GetAsync($url, [Net.Http.HttpCompletionOption]::ResponseHeadersRead, $deadline.Token).GetAwaiter().GetResult()
            if ([int]$response.StatusCode -ne 200) { throw 'cmux-server-bootstrap: download_failed' }
            $length = $response.Content.Headers.ContentLength
            if ($null -ne $length -and $length -ne $expectedSize) { throw 'cmux-server-bootstrap: package_size_mismatch' }
            $source = $response.Content.ReadAsStreamAsync().GetAwaiter().GetResult()
            $destination = [IO.File]::Open($archive, [IO.FileMode]::CreateNew)
            $buffer = New-Object byte[] 65536
            $total = 0L
            while (($read = $source.ReadAsync($buffer, 0, $buffer.Length, $deadline.Token).GetAwaiter().GetResult()) -gt 0) {
                $total += $read
                if ($total -gt $expectedSize) { throw 'cmux-server-bootstrap: package_size_mismatch' }
                $destination.Write($buffer, 0, $read)
            }
        } finally {
            if ($null -ne $destination) { $destination.Dispose() }
            if ($null -ne $source) { $source.Dispose() }
            if ($null -ne $response) { $response.Dispose() }
            $client.Dispose()
            $deadline.Dispose()
            [Net.ServicePointManager]::SecurityProtocol = $oldProtocol
        }
        if ((Get-Item -LiteralPath $archive).Length -ne $expectedSize) { throw 'cmux-server-bootstrap: package_size_mismatch' }
        if ((Get-FileHash -LiteralPath $archive -Algorithm SHA256).Hash.ToLowerInvariant() -cne $expectedHash) { throw 'cmux-server-bootstrap: package_digest_mismatch' }
        Add-Type -AssemblyName System.IO.Compression.FileSystem
        $zip = [IO.Compression.ZipFile]::OpenRead($archive)
        try {
            if ($zip.Entries.Count -ne 1 -or $zip.Entries[0].FullName -cne 'bin/cmux.exe' -or $zip.Entries[0].Length -gt 1073741824) { throw 'cmux-server-bootstrap: archive_invalid' }
            $binary = Join-Path $tempDir 'cmux.exe'
            [IO.Compression.ZipFileExtensions]::ExtractToFile($zip.Entries[0], $binary, $false)
        } finally { $zip.Dispose() }
        $signature = Get-AuthenticodeSignature -LiteralPath $binary
        $publishers = @(@@PUBLISHERS@@)
        if ($signature.Status -ne 'Valid' -or $null -eq $signature.SignerCertificate -or $publishers -cnotcontains $signature.SignerCertificate.Thumbprint) { throw 'cmux-server-bootstrap: authenticode_publisher_mismatch' }
        # Do not forward user-controlled mode or reexec environment overrides.
        $names = @('CMUX_SERVER_MODE', 'CMUX_SERVER_APP_BUNDLE', 'CMUX_SERVER_REEXEC')
        $saved = @{}
        foreach ($name in $names) {
            $saved[$name] = [Environment]::GetEnvironmentVariable($name)
            [Environment]::SetEnvironmentVariable($name, $null)
        }
        try {
            $principal = New-Object Security.Principal.WindowsPrincipal($identity)
            if ($system -and !$principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
                # Only the verified binary is elevated. Argument values have no
                # whitespace or quotes, including under Windows PowerShell 5.1.
                $process = Start-Process -FilePath $binary -ArgumentList (@('server', 'install') + $installArguments) -Verb RunAs -Wait -PassThru
                $exitCode = $process.ExitCode
            } else {
                & $binary server install @installArguments
                $exitCode = $LASTEXITCODE
            }
            if ($exitCode -ne 0) { throw "cmux-server-bootstrap: installer_exit_$exitCode" }
        } finally {
            foreach ($name in $names) { [Environment]::SetEnvironmentVariable($name, $saved[$name]) }
        }
    } finally { Remove-Item -LiteralPath $tempDir -Recurse -Force }
}
# A partial final invocation remains an incomplete script block.
if ($true) { Invoke-CmuxServerInstall @args }
