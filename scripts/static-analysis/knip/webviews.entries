# Extra knip entry globs for webviews/ (one per line, relative to webviews/). These are
# bundled by scripts that build the path from a variable, which gen-config.mjs cannot see.
# scripts/cmux-next/build-pages-web.sh loops over $PAGES (site-settings site-data certificate ...)
src/pages/*/main.tsx
src/*/main.tsx
# scripts/cmux-next/build-agent-pane-web.sh: "$SRC/acpmux/chatSnapshot/boot.ts" and the paint step
src/agent-session/acpmux/chatSnapshot/*.ts
# bundle.mjs aliases `shiki/*` to these trimmed copies (argument "$SRC/acpmux/shiki")
src/agent-session/acpmux/shiki/**/*.ts
src/pages/github/shiki/**/*.ts
