{
  "//": [
    "The pull-request jobs scripts/ci/affected_jobs.py routes by the cmux-tui crate graph: a job runs when the change",
    "touches an input of one of its crates (the crate, every crate it reaches by path dependency with the features",
    "its build turns on, the files their sources name outside them) or one of its own inputs (a path; one ending in",
    "/ is a directory). A workflow's `inputs` are inputs of each of its jobs. `features` are the job's --features;",
    "a `compile_only` job runs no test, so the fixtures its crates' tests read at run time are not its inputs; a",
    "`binaries_only` job uses only its crates' libraries and binaries, so their tests, benches and examples are not.",
    "A change to this file or the router runs every job; so do pushes, dispatches and the full-ci label.",
    "A job another router decides names that router's output (`router_output`): cmux-next.yml's daemon-test reads",
    "scripts/ci/cmux_next_route.py's `daemon`, which takes the job's inputs from here. `binaries_key` is the",
    "reuse-key file of the binaries a job fetches instead of building: each key input outside the crate graph is one",
    "of the job's inputs or a file a cmux-tui Rust source names (the graph places it). `routed_elsewhere` are scripts",
    "its steps run that its router routes by another rule: the generated-files checks it hosts, the package build's",
    "web bundles, and CI plumbing (caches, scratch, checkout repair) the router sends to the checks tier. `key_only` are key inputs no fetched binary reads (fixtures of crate tests and",
    "benches): the key holds them so the published tree is rebuilt, and the job's result cannot change with them."
  ],
  "workspace_inputs": [
    "cmux-tui/Cargo.toml",
    "cmux-tui/Cargo.lock",
    "cmux-tui/rust-toolchain.toml",
    "cmux-tui/rust-toolchain",
    "cmux-tui/.cargo/",
    "cmux-tui/clippy.toml",
    "cmux-tui/rustfmt.toml",
    ".github/actions/setup-cmux-tui-rust/",
    ".github/actions/runner-cargo-home/"
  ],
  "workflows": {
    ".github/workflows/cmux-tui-spec.yml": {
      "inputs": [".github/workflows/cmux-tui-spec.yml", ".github/actions/tree-result/"],
      "jobs": {
        "acpmux-tests": {
          "name": "acpmux tests (lib, hub_integration)",
          "crates": [
            "cmux-tui/crates/acpmux", "cmux-tui/crates/acpmux-book", "cmux-tui/crates/acpmux-build-id",
            "cmux-tui/crates/acpmux-client", "cmux-tui/crates/acpmux-core", "cmux-tui/crates/acpmux-list-types"
          ],
          "inputs": [
            "scripts/cmux-next/run-v2-gates.sh", "scripts/cmux-next/v2-gates.d/",
            "scripts/ci/cargo_test_verdict.py", "scripts/ci/git_tree.py", "scripts/ci/test_reds.py",
            "tests/test_cargo_test_verdict.py",
            ".github/actions/rust-compile-cache/",
            "scripts/ci/rust_compile_cache.py"
          ]
        },
        "acpmux-sim": {
          "name": "acpmux simulation (seeds)",
          "crates": ["cmux-tui/crates/acpmux"], "inputs": [".github/actions/rust-compile-cache/", "scripts/ci/rust_compile_cache.py"],
          "features": ["sim"]
        },
        "carrier-sim": {
          "name": "carrier simulation (seeds)",
          "crates": ["cmux-tui/crates/cmux-remote", "cmux-tui/crates/cmux-link", "cmux-tui/crates/cmux-relay"],
          "inputs": [
            "cmux-tui/crates/cmux-tui/src/carrier/", "ghostty-next", "scripts/install-zig-ci.sh",
            "scripts/ci/init-submodule.sh",
            ".github/actions/rust-compile-cache/",
            "scripts/ci/rust_compile_cache.py"
          ]
        },
        "acpmux-protocol-ir": {
          "name": "acpmux protocol IR is current",
          "crates": ["cmux-tui/crates/acpmux"],
          "inputs": ["scripts/cmux-next/cargo-locks.py", ".github/actions/rust-compile-cache/", "scripts/ci/rust_compile_cache.py"]
        }
      }
    },
    ".github/workflows/cmux-tui-windows-check.yml": {
      "inputs": [".github/workflows/cmux-tui-windows-check.yml", ".github/actions/tree-result/"],
      "jobs": {
        "windows-gnu-check": {
          "name": "cargo check (x86_64-pc-windows-gnu)",
          "compile_only": true,
          "crates": ["cmux-tui/crates/cmux-tui-core", "cmux-tui/crates/cmux-tui", "cmux-tui/crates/acpmux"],
          "inputs": [
            "ghostty-next", "scripts/install-zig-ci.sh", ".github/actions/ghostty-zig-packages/",
            "scripts/cmux-next/cargo-locks.py"
          ]
        }
      }
    },
    ".github/workflows/cmux-tui-sdks.yml": {
      "inputs": [".github/workflows/cmux-tui-sdks.yml", ".github/actions/tree-result/"],
      "jobs": {
        "conformance": {
          "name": "seven-language live conformance",
          "crates": ["cmux-tui/crates/cmux-tui", "cmux-tui/bindings/rust", "cmux-tui/bindings/rust-daemon-client"],
          "inputs": [
            "cmux-tui/bindings/", "cmux-tui/spec/", "ghostty", "ghostty-next", "scripts/install-zig-ci.sh",
            ".github/actions/ghostty-zig-packages/", ".github/actions/zig-global-cache/",
            "scripts/ghostty-zig-version.sh", "scripts/ci/init-submodule.sh"
          ]
        }
      }
    },
    ".github/workflows/cmux-next.yml": {
      "inputs": [],
      "jobs": {
        "daemon-test": {
          "name": "cmux-next daemon tests",
          "router_output": "daemon",
          "compile_only": true,
          "binaries_only": true,
          "binaries_key": "scripts/cmux-next/cmux-tui-tree-inputs.txt",
          "crates": [
            "cmux-tui/crates/cmux-tui", "cmux-tui/crates/cmux-holder", "cmux-tui/crates/cmux-app-host",
            "cmux-tui/crates/cmux-browser-host", "cmux-tui/crates/acpmux",
            "cmux-tui/bindings/examples/rust-agent-screen-detection", "first-party-apps/cloud/server"
          ],
          "features": ["tailnet", "hub-carrier"],
          "inputs": [
            "ghostty-next", "workers/cmux-vm/cli/",
            "scripts/cmux-next/cmux-tui-tree-inputs.txt", "scripts/ci/cmux_tui_tree_key.py",
            "scripts/cmux-next/build-layout-reducer-ffi.sh", "scripts/ci/acpmux-build-features.sh",
            "scripts/ci/tailnet-go.sh", "scripts/cmux-next/build-acpmux.sh", "scripts/ci/cargo-groups.sh",
            "scripts/ci/cmux-tui-darwin-builder", "scripts/ci/macos-cross.sh", "scripts/ci/macos_stubs.py",
            "scripts/ci/macho_weaken.py", "scripts/ci/macos-stubs/", ".github/workflows/cmux-tui-build-package.yml",
            "scripts/cmux-next/cmux-tui-build-profiles.json", "scripts/ghostty-zig-version.sh",
            "scripts/ci/stage-agent-detector.sh", "scripts/ci/cmux-tui-mac-cargo-builds.sh",
            "scripts/select-ci-xcode.sh",
            "plans/cmux-next/daemon-capabilities.json", "scripts/cmux-next/pin-cmux-tui.sh",
            "scripts/cmux-next/check-daemon-capabilities.sh", "scripts/cmux-next/cmux-tui.pin",
            "Packages/macOS/CmuxNext/Tests/CmuxNextAppTests/FirstLaunchTests.swift",
            "Packages/macOS/CmuxNext/Tests/CmuxNextAppTests/MarkdownPageFindTests.swift",
            "Packages/macOS/CmuxNext/Tests/CmuxNextAppTests/FileSourceSwitchTests.swift",
            "Packages/macOS/CmuxNext/Tests/CmuxNextAppTests/ClassicImportTests.swift",
            "Packages/macOS/CmuxNext/Tests/CmuxNextAppTests/ClassicMigrationTests.swift",
            "Packages/macOS/CmuxNext/Tests/CmuxNextAppTests/ClassicUpgradeSimulationTests.swift",
            "Packages/macOS/CmuxNext/Tests/CmuxNextAppTests/ClassicUpgradeHugeSimulationTests.swift",
            "Packages/macOS/CmuxNext/Tests/CmuxNextAppTests/ClassicUpgradeSimulator.swift",
            "Packages/macOS/CmuxNext/Sources/CmuxNextApp/Onboarding/AppOnboardingServices+ClassicSessions.swift",
            "Packages/macOS/CmuxNext/Sources/CmuxNextApp/Onboarding/AppOnboardingServices+ClassicMigration.swift"
          ],
          "routed_elsewhere": [
            "scripts/ci/reset-stale-submodules.sh", "scripts/ci/owned_spm_scratch.py",
            "scripts/ci/swiftpm_prefetch_binary_artifacts.py", "scripts/ci/e2e_warm_derived_data.py",
            "scripts/cmux-next/fast-tier-cache-key.sh", ".github/actions/cache-restore/",
            "scripts/cmux-next/regenerate-action-contracts.sh", "scripts/cmux-next/regenerate-settings-exports.sh",
            "scripts/cmux-next/check-settings-exports.sh", "scripts/cmux-next/base-autofix-exports-pack.sh",
            "scripts/ci/defaults_guard.py",
            "scripts/cmux-next/build-web-bundles.sh", "scripts/cmux-next/web-bundle-key.py",
            "scripts/cmux-next/private-bun.sh"
          ],
          "key_only": [
            "schemas/link-token/native.json", "schemas/link-token/vectors.json", "scripts/cmux-next/run-v2-gates.sh",
            "scripts/cmux-next/tests/run-v2-gates.test.sh", "scripts/cmux-next/v2-gates.d/"
          ]
        }
      }
    }
  }
}
