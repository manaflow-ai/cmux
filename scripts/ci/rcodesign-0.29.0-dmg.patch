+/// The DER header at the start of `data`: (tag, header length, content length).
+fn der_header(data: &[u8]) -> Result<(u8, usize, usize), AppleCodesignError> {
+    let err = || AppleCodesignError::SignatureBuilder("malformed CMS DER");
+    let tag = *data.first().ok_or_else(err)?;
+    let first = *data.get(1).ok_or_else(err)?;
+    let (header, len) = if first < 0x80 {
+        (2, first as usize)
+    } else {
+        let n = (first & 0x7f) as usize;
+        if n == 0 || n > 4 {
+            return Err(err());
+        }
+        let mut len = 0usize;
+        for i in 0..n {
+            len = (len << 8) | *data.get(2 + i).ok_or_else(err)? as usize;
+        }
+        (2 + n, len)
+    };
+    if data.len() < header + len {
+        return Err(err());
+    }
+    Ok((tag, header, len))
+}
+
+/// Re-encode a DER CMS signature the way codesign writes it: the ContentInfo, its
+/// [0] content, the SignedData and the encapContentInfo use indefinite lengths
+/// (ending in end-of-contents octets); everything inside them stays DER.
+pub fn cms_der_to_codesign_ber(der: &[u8]) -> Result<Vec<u8>, AppleCodesignError> {
+    let err = || AppleCodesignError::SignatureBuilder("unexpected CMS layout");
+    let (tag, header, len) = der_header(der)?;
+    if tag != 0x30 || header + len != der.len() {
+        return Err(err());
+    }
+    let content_info = &der[header..];
+    let (tag, header, len) = der_header(content_info)?;
+    if tag != 0x06 {
+        return Err(err());
+    }
+    let content_type = &content_info[..header + len];
+    let explicit = &content_info[header + len..];
+    let (tag, header, len) = der_header(explicit)?;
+    if tag != 0xa0 || header + len != explicit.len() {
+        return Err(err());
+    }
+    let signed_data = &explicit[header..];
+    let (tag, header, len) = der_header(signed_data)?;
+    if tag != 0x30 || header + len != signed_data.len() {
+        return Err(err());
+    }
+    let mut fields = &signed_data[header..];
+
+    let mut out = Vec::with_capacity(der.len() + 8);
+    out.extend_from_slice(&[0x30, 0x80]);
+    out.extend_from_slice(content_type);
+    out.extend_from_slice(&[0xa0, 0x80, 0x30, 0x80]);
+    // version, digestAlgorithms, encapContentInfo; the rest is copied as it is.
+    for i in 0..3 {
+        let (tag, header, len) = der_header(fields)?;
+        if i == 2 {
+            if tag != 0x30 {
+                return Err(err());
+            }
+            out.extend_from_slice(&[0x30, 0x80]);
+            out.extend_from_slice(&fields[header..header + len]);
+            out.extend_from_slice(&[0, 0]);
+        } else {
+            out.extend_from_slice(&fields[..header + len]);
+        }
+        fields = &fields[header + len..];
+    }
+    out.extend_from_slice(fields);
+    out.extend_from_slice(&[0, 0, 0, 0, 0, 0]);
+    Ok(out)
+}
