 /// Derive a new Mach-O binary with new signature data.
+/// The code page size codesign hashes with: 16 KiB for arm64 (but 4 KiB for
+/// tvOS, as codesign keeps it there), 4 KiB otherwise.
+fn code_page_size(macho: &MachOBinary) -> Result<u32, AppleCodesignError> {
+    let cputype = macho.macho.header.cputype();
+    if cputype == CPU_TYPE_ARM64 || cputype == CPU_TYPE_ARM64_32 {
+        if matches!(macho.find_targeting()?, Some(target) if target.platform == Platform::TvOs) {
+            Ok(4096)
+        } else {
+            Ok(16384)
+        }
+    } else {
+        Ok(4096)
+    }
+}
