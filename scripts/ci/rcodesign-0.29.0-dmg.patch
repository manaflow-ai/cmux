+/// Requirement text as codesign writes it (Security's requirement dumper):
+/// parentheses only where precedence needs them, and data unquoted only when
+/// it is a plain alphanumeric word that is not a keyword.
+pub mod apple_text {
+    use super::{CodeRequirementExpression as E, CodeRequirementMatchExpression as M, CodeRequirementValue};
+
+    #[derive(Clone, Copy, PartialEq, PartialOrd)]
+    enum Level {
+        Primary,
+        And,
+        Or,
+        Top,
+    }
+
+    const KEYWORDS: &[&str] = &[
+        "guest", "host", "designated", "library", "plugin", "or", "and", "always", "true", "never",
+        "false", "identifier", "cdhash", "platform", "notarized", "legacy", "anchor", "apple",
+        "generic", "certificate", "cert", "trusted", "info", "entitlement", "exists", "absent",
+        "leaf", "root", "timestamp", "",
+    ];
+
+    /// One requirement expression as codesign prints it.
+    pub fn format(expr: &E) -> String {
+        let mut out = String::new();
+        dump(&mut out, expr, Level::Top);
+        match out.strip_prefix(' ') {
+            Some(rest) => rest.to_string(),
+            None => out,
+        }
+    }
+
+    fn data(out: &mut String, bytes: &[u8], dot_ok: bool) {
+        #[derive(PartialEq)]
+        enum Mode {
+            Simple,
+            Printable,
+            Binary,
+        }
+        let mut mode = Mode::Simple;
+        for (n, &c) in bytes.iter().enumerate() {
+            if c.is_ascii_alphanumeric() || (c == b'.' && dot_ok) {
+                if n == 0 && c.is_ascii_digit() {
+                    mode = Mode::Printable;
+                }
+            } else if c.is_ascii_graphic() || matches!(c, b' ' | b'\t' | b'\n' | b'\x0b' | b'\x0c' | b'\r') {
+                if mode == Mode::Simple {
+                    mode = Mode::Printable;
+                }
+            } else {
+                mode = Mode::Binary;
+                break;
+            }
+        }
+        if mode == Mode::Simple && KEYWORDS.iter().any(|k| k.as_bytes() == bytes) {
+            mode = Mode::Printable;
+        }
+        match mode {
+            Mode::Simple => out.push_str(&String::from_utf8_lossy(bytes)),
+            Mode::Printable => {
+                out.push('"');
+                for &c in bytes {
+                    if c == b'\\' || c == b'"' {
+                        out.push('\\');
+                    }
+                    out.push(c as char);
+                }
+                out.push('"');
+            }
+            Mode::Binary => {
+                out.push_str("0x");
+                out.push_str(&hex::encode(bytes));
+            }
+        }
+    }
+
+    fn value(out: &mut String, v: &CodeRequirementValue) {
+        match v {
+            CodeRequirementValue::String(s) => data(out, s.as_bytes(), false),
+            CodeRequirementValue::Bytes(b) => data(out, b, false),
+        }
+    }
+
+    fn slot(out: &mut String, slot: i32) {
+        match slot {
+            -1 => out.push_str(" root"),
+            0 => out.push_str(" leaf"),
+            n => out.push_str(&format!(" {n}")),
+        }
+    }
+
+    fn hash(out: &mut String, digest: &[u8]) {
+        out.push_str("H\"");
+        out.push_str(&hex::encode(digest));
+        out.push('"');
+    }
+
+    fn matcher(out: &mut String, m: &M) {
+        match m {
+            M::Exists => out.push_str(" /* exists */"),
+            M::Absent => out.push_str(" absent "),
+            M::Equal(v) => { out.push_str(" = "); value(out, v) }
+            M::Contains(v) => { out.push_str(" ~ "); value(out, v) }
+            M::BeginsWith(v) => { out.push_str(" = "); value(out, v); out.push('*') }
+            M::EndsWith(v) => { out.push_str(" = *"); value(out, v) }
+            M::LessThan(v) => { out.push_str(" < "); value(out, v) }
+            M::GreaterThan(v) => { out.push_str(" > "); value(out, v) }
+            M::LessThanEqual(v) => { out.push_str(" <= "); value(out, v) }
+            M::GreaterThanEqual(v) => { out.push_str(" >= "); value(out, v) }
+            M::On(t) => out.push_str(&format!(" = <{t}>")),
+            M::Before(t) => out.push_str(&format!(" < <{t}>")),
+            M::After(t) => out.push_str(&format!(" > <{t}>")),
+            M::OnOrBefore(t) => out.push_str(&format!(" <= <{t}>")),
+            M::OnOrAfter(t) => out.push_str(&format!(" >= <{t}>")),
+        }
+    }
+
+    fn dump(out: &mut String, expr: &E, level: Level) {
+        match expr {
+            E::False => out.push_str("never"),
+            E::True => out.push_str("always"),
+            E::Identifier(s) => { out.push_str("identifier "); data(out, s.as_bytes(), false) }
+            E::AnchorApple => out.push_str("anchor apple"),
+            E::AnchorAppleGeneric => out.push_str("anchor apple generic"),
+            E::AnchorCertificateHash(s, d) => {
+                out.push_str("certificate");
+                slot(out, *s);
+                out.push_str(" = ");
+                hash(out, d)
+            }
+            E::InfoKeyValueLegacy(k, v) => {
+                out.push_str("info[");
+                data(out, k.as_bytes(), true);
+                out.push_str("] = ");
+                data(out, v.as_bytes(), false)
+            }
+            E::And(a, b) | E::Or(a, b) => {
+                let (own, word) = if matches!(expr, E::And(..)) {
+                    (Level::And, " and ")
+                } else {
+                    (Level::Or, " or ")
+                };
+                if level < own {
+                    out.push('(');
+                }
+                dump(out, a, own);
+                out.push_str(word);
+                dump(out, b, own);
+                if level < own {
+                    out.push(')');
+                }
+            }
+            E::Not(e) => { out.push_str("! "); dump(out, e, Level::Primary) }
+            E::CodeDirectoryHash(d) => { out.push_str("cdhash "); hash(out, d) }
+            E::InfoPlistKeyField(k, m) => {
+                out.push_str("info[");
+                data(out, k.as_bytes(), true);
+                out.push(']');
+                matcher(out, m)
+            }
+            E::EntitlementsKey(k, m) => {
+                out.push_str("entitlement[");
+                data(out, k.as_bytes(), true);
+                out.push(']');
+                matcher(out, m)
+            }
+            E::CertificateField(s, f, m) => {
+                out.push_str("certificate");
+                slot(out, *s);
+                out.push('[');
+                data(out, f.as_bytes(), true);
+                out.push(']');
+                matcher(out, m)
+            }
+            E::CertificateFieldDate(s, oid, m) => {
+                out.push_str("certificate");
+                slot(out, *s);
+                out.push_str(&format!("[timestamp.{oid}]"));
+                matcher(out, m)
+            }
+            E::CertificateGeneric(s, oid, m) => {
+                out.push_str("certificate");
+                slot(out, *s);
+                out.push_str(&format!("[field.{oid}]"));
+                matcher(out, m)
+            }
+            E::CertificatePolicy(s, oid, m) => {
+                out.push_str("certificate");
+                slot(out, *s);
+                out.push_str(&format!("[policy.{oid}]"));
+                matcher(out, m)
+            }
+            // Security prints no space before "trusted" here.
+            E::CertificateTrusted(s) => { out.push_str("certificate"); slot(out, *s); out.push_str("trusted") }
+            E::AnchorTrusted => out.push_str("anchor trusted"),
+            E::NamedAnchor(n) => { out.push_str("anchor apple "); data(out, n.as_bytes(), false) }
+            E::NamedCode(n) => { out.push('('); data(out, n.as_bytes(), false); out.push(')') }
+            E::Platform(p) => out.push_str(&format!("platform = {}", *p as i32)),
+            E::Notarized => out.push_str("notarized"),
+            E::LegacyDeveloperId => out.push_str("legacy"),
+        }
     }
+
+    #[cfg(test)]
+    mod test {
+        use super::*;
+        use std::borrow::Cow;
+
+        #[test]
+        fn developer_id_requirement_as_codesign_prints_it() {
+            let oid = |b: &'static [u8]| bcder::Oid(b);
+            let expr = E::And(
+                Box::new(E::And(
+                    Box::new(E::And(
+                        Box::new(E::And(
+                            Box::new(E::Identifier(Cow::from("org.sparkle-project.Sparkle.Updater"))),
+                            Box::new(E::AnchorAppleGeneric),
+                        )),
+                        Box::new(E::CertificateGeneric(1, oid(&[42, 134, 72, 134, 247, 99, 100, 6, 2, 6]), M::Exists)),
+                    )),
+                    Box::new(E::CertificateGeneric(0, oid(&[42, 134, 72, 134, 247, 99, 100, 6, 1, 13]), M::Exists)),
+                )),
+                Box::new(E::CertificateField(0, Cow::from("subject.OU"), M::Equal(CodeRequirementValue::from("7WLXT3NR37")))),
+            );
+            assert_eq!(
+                format(&expr),
+                "identifier \"org.sparkle-project.Sparkle.Updater\" and anchor apple generic and certificate 1[field.1.2.840.113635.100.6.2.6] /* exists */ and certificate leaf[field.1.2.840.113635.100.6.1.13] /* exists */ and certificate leaf[subject.OU] = \"7WLXT3NR37\""
+            );
+            assert_eq!(format(&E::Identifier(Cow::from("Autoupdate"))), "identifier Autoupdate");
+            assert_eq!(format(&E::Identifier(Cow::from("leaf"))), "identifier \"leaf\"");
+            let or = E::Or(
+                Box::new(E::CodeDirectoryHash(Cow::from(&[0xab_u8][..]))),
+                Box::new(E::CodeDirectoryHash(Cow::from(&[0xcd_u8][..]))),
+            );
+            assert_eq!(format(&or), "cdhash H\"ab\" or cdhash H\"cd\"");
+            let mixed = E::And(Box::new(or), Box::new(E::AnchorApple));
+            assert_eq!(format(&mixed), "(cdhash H\"ab\" or cdhash H\"cd\") and anchor apple");
+        }
+    }
 }
