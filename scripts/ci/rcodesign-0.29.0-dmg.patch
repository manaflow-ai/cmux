+
+    #[test]
+    fn outer_layers_become_indefinite() {
+        // ContentInfo { OID, [0] { SignedData { 1, SET {}, SEQ { OID }, SET { OCTET STRING } } } }
+        let signed_data = [
+            0x02, 0x01, 0x01, 0x31, 0x00, 0x30, 0x03, 0x06, 0x01, 0x2b, 0x31, 0x03, 0x04, 0x01,
+            0xff,
+        ];
+        let mut der = vec![0x30, 0x16, 0x06, 0x01, 0x2a, 0xa0, 0x11, 0x30, 0x0f];
+        der.extend_from_slice(&signed_data);
+        let ber = cms_der_to_codesign_ber(&der).unwrap();
+        assert_eq!(
+            ber,
+            vec![
+                0x30, 0x80, 0x06, 0x01, 0x2a, 0xa0, 0x80, 0x30, 0x80, 0x02, 0x01, 0x01, 0x31, 0x00,
+                0x30, 0x80, 0x06, 0x01, 0x2b, 0x00, 0x00, 0x31, 0x03, 0x04, 0x01, 0xff, 0x00, 0x00,
+                0x00, 0x00, 0x00, 0x00,
+            ]
+        );
+        assert!(cms_der_to_codesign_ber(&der[..der.len() - 1]).is_err());
+    }
+}
