+/// The slice alignments (log2) of a 32-bit universal header, in slice order.
+fn universal_alignments(data: &[u8], count: usize) -> Result<Vec<u32>, AppleCodesignError> {
+    let word = |offset: usize| -> Result<u32, AppleCodesignError> {
+        data.get(offset..offset + 4)
+            .map(|b| u32::from_be_bytes([b[0], b[1], b[2], b[3]]))
+            .ok_or(AppleCodesignError::SignatureBuilder("truncated universal header"))
+    };
+    if word(0)? != 0xcafebabe || word(4)? as usize != count {
+        return Err(AppleCodesignError::SignatureBuilder(
+            "only 32-bit universal binaries can be re-signed",
+        ));
+    }
+    (0..count).map(|i| word(8 + 20 * i + 16)).collect()
 }
 
+/// A universal binary as lipo lays it out: each slice at the next multiple of
+/// its own alignment, the input's, so only the slices' signatures change.
+fn write_universal(
+    writer: &mut impl Write,
+    binaries: &[Vec<u8>],
+    alignments: &[u32],
+) -> Result<(), AppleCodesignError> {
+    let header_len = 8 + 20 * binaries.len();
+    let mut offset = header_len as u64;
+    let mut layout = vec![];
