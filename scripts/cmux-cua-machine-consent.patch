+    }
+
+    fn refused(result: &ToolResult, surface: &str) -> bool {
+        result.is_error == Some(true)
+            && result.structured_content.as_ref().is_some_and(|structured| {
+                structured["code"] == "consent_required" && structured["surface"] == surface
+            })
+    }
+
