+
+impl Drop for ToolRegistry {
+    fn drop(&mut self) {
+        let watcher = self
+            .consent_watcher
+            .get_mut()
+            .map(Option::take)
+            .unwrap_or_else(|poisoned| poisoned.into_inner().take());
+        if let Some(ConsentWatcher { stop, thread }) = watcher {
+            drop(stop);
+            let _ = thread.join();
+        }
+    }
