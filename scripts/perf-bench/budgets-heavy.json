    "terminals": 20,
    "chromium_tabs": 20,
    "webkit_tabs": 0,
    "workspaces": 150,
    "home_settle_s": 30,
    "phase_settle_s": 40
  },
  "budgets": [
    {"row": "budget-idle-cpu", "limit": 1.0, "enforce": false},
    {"row": "budget-idle-cpu-app-hidden", "limit": 1.0, "enforce": false},
    {"row": "budget-idle-cpu-home", "limit": 1.0, "enforce": false},
    {"row": "budget-idle-wakeups", "limit": 30, "enforce": false},
    {"row": "budget-idle-wakeups-app-hidden", "limit": 30, "enforce": false},
    {"row": "budget-memory-home", "limit": 400, "enforce": false},
    {"row": "budget-memory-total", "limit": 1200, "enforce": false},
    {"row": "budget-memory-per-terminal", "limit": 10, "enforce": false},
    {"row": "budget-memory-first-chromium-tab", "limit": 250, "enforce": false},
    {"row": "budget-memory-per-chromium-tab", "limit": 30, "enforce": false},
    {"row": "budget-idle-disk-writes-home", "limit": 1.0, "enforce": false},
    {"row": "budget-idle-disk-writes", "limit": 1.0, "enforce": false},
    {"row": "budget-idle-disk-writes-app-hidden", "limit": 1.0, "enforce": false},
    {"row": "budget-idle-mach-msgs", "limit": 50, "enforce": false},
    {"row": "budget-idle-syscalls", "limit": 200, "enforce": false},
    {"row": "budget-idle-csw-app-hidden", "limit": 50, "enforce": false},
    {"row": "budget-processes", "limit": 15, "enforce": false},
    {"row": "budget-threads", "limit": 150, "enforce": false},
    {"row": "budget-memory-per-workspace", "limit": 2.0, "enforce": false}
  ]
