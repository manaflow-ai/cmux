{
  "schema": "xbench.budgets.v1",
  "about": "cmux NEXT resource budgets (budget.py). limit is in the row's unit; enforce false = advisory (reported, never fails). Targets from Leo 2026-10-21: whole-tree idle CPU under 1 %, a memory ceiling per hidden tab and for the app at idle. A budget the base breaks stays advisory; enforce it once the base holds it.",
  "scenario": {
    "terminals": 5,
    "chromium_tabs": 5,
    "webkit_tabs": 5,
    "home_settle_s": 30,
    "phase_settle_s": 40,
    "idle_s": 60
  },
  "budgets": [
    {"row": "budget-idle-cpu", "limit": 1.0, "enforce": false},
    {"row": "budget-idle-cpu-app-hidden", "limit": 1.0, "enforce": false},
    {"row": "budget-idle-cpu-home", "limit": 1.0, "enforce": false},
    {"row": "budget-idle-wakeups", "limit": 30, "enforce": false},
    {"row": "budget-idle-wakeups-app-hidden", "limit": 30, "enforce": false},
    {"row": "budget-memory-home", "limit": 400, "enforce": false},
    {"row": "budget-memory-total", "limit": 800, "enforce": false},
    {"row": "budget-memory-per-terminal", "limit": 10, "enforce": false},
    {"row": "budget-memory-first-chromium-tab", "limit": 250, "enforce": false},
    {"row": "budget-memory-per-chromium-tab", "limit": 30, "enforce": false},
    {"row": "budget-memory-first-webkit-tab", "limit": 120, "enforce": false},
    {"row": "budget-memory-per-webkit-tab", "limit": 20, "enforce": false}
  ]
}
