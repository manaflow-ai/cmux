+/// The `capabilities.experimental` key of an initialize result from a server
+/// that reads the screen lock after its last consent check, right before it
+/// dispatches a call (`ToolRegistry::require_unlocked`). cmux's lock gate
+/// passes a call while the Mac is unlocked, and runs only a helper that
+/// says this, so a call that waits while the Mac locks never runs.
+pub const LOCK_AT_EXECUTION_CAPABILITY: &str = "cmux/lock-at-execution-v1";
+
+/// `capabilities` with [`LOCK_AT_EXECUTION_CAPABILITY`] on a Mac, the only
+/// platform that installs the screen lock hook.
+fn capabilities(tools: Value) -> Value {
+    let mut capabilities = serde_json::json!({ "tools": tools });
+    if cfg!(target_os = "macos") {
+        capabilities["experimental"] = serde_json::json!({ LOCK_AT_EXECUTION_CAPABILITY: {} });
+    }
+    capabilities
+}
