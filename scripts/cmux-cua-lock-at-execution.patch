+    /// Refuses a call that needs the screen or input while the screen is
+    /// locked (or its lock state is unknown): a screenshot would see only the
+    /// lock screen, and a click or keystroke would land in its password field.
+    /// No await follows this read before dispatch.
+    fn require_unlocked(&self, tool: &str) -> Result<(), ToolResult> {
+        use crate::machine_consent::{requirement_for, Requirement};
+        let Some(locked) = self.screen_lock_hook else { return Ok(()) };
+        if requirement_for(tool) == Requirement::Nothing || locked() == Some(false) {
+            return Ok(());
+        }
+        Err(ToolResult::error(format!(
+            "{MAC_LOCKED}: this Mac's screen is locked, so nothing can see or use it. `{tool}` did not run. \
+             It runs again once the person unlocks the Mac."
+        ))
+        .with_structured(serde_json::json!({"error": MAC_LOCKED})))
+    }
