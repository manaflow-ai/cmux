+/// The daemon request a tool call goes as. On a Mac it is
+/// [`LOCK_CHECKED_CALL`](cmux_cua_core::protocol::LOCK_CHECKED_CALL): the
+/// daemon is installed separately and may be older than this proxy, and only
+/// one that reads the screen lock right before dispatch runs it. That is why
+/// this proxy may tell cmux it checks the lock at execution
+/// ([`proxy_initialize_result`]). Elsewhere there is no screen lock to read.
+fn daemon_call_method() -> &'static str {
+    if cfg!(target_os = "macos") {
+        cmux_cua_core::protocol::LOCK_CHECKED_CALL
+    } else {
+        "call"
+    }
+}
+
+/// The typed reason a call gets from a daemon built before the lock check,
+/// as cmux's lock gate answers a helper that does not say it.
+const HELPER_OUTDATED: &str = "cua_helper_outdated";
+
+/// Whether the daemon refused [`daemon_call_method`] as a method it does not
+/// know: it was built before the lock check, and the call did not run.
+fn daemon_predates_lock_check(response: &DaemonResponse) -> bool {
+    let unknown = format!("Unknown method: {}", cmux_cua_core::protocol::LOCK_CHECKED_CALL);
+    !response.ok && response.error.as_deref() == Some(unknown.as_str())
+}
+
+fn helper_outdated_result() -> serde_json::Value {
+    serde_json::json!({
+        "content": [{ "type": "text", "text": format!(
+            "{HELPER_OUTDATED}: this Mac's Computer Use helper is too old to check the \
+             screen lock right before it acts, so it was sent no steps. The step was not \
+             run. Update cmux, which updates the helper, then start a new chat."
+        ) }],
+        "isError": true,
+        "structuredContent": { "error": HELPER_OUTDATED }
+    })
