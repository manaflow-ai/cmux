    "NSSystemExtensionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux installs this network extension only when you turn on the Cloud Tunnel, so other apps on this Mac can reach your Cloud machines on their private network."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux は Cloud Tunnel をオンにしたときだけこのネットワーク拡張をインストールし、この Mac の他のアプリから Cloud マシンのプライベートネットワークに接続できるようにします。"
          }
        }
      }
    }
  },
  "version": "1.0"
