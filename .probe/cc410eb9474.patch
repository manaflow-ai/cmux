+test("the buttons lead the footer row; Worked for comes after them", () => {
+  const markup = renderToStaticMarkup(<TurnFooter row={footer({ durationMs: 5_000, text: "Done." })} />);
+  const group = markup.indexOf("cv-turn-action-group");
