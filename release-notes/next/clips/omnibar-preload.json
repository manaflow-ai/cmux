{
  "caption": "Type a page you open often in the address bar and press Return: it is already loaded.",
  "frameInterval": 0.25,
  "steps": [
    {"title": "Launch", "wait": 2},
    {"title": "A fixed window", "rpc": {"method": "debug.window_frame", "params": {"frame": [80, 80, 1200, 800]}}, "wait": 0.5},
    {"title": "A browser workspace, shown and focused", "rpc": {"method": "action.run", "params": {"action": "newBrowserWorkspace", "focus": true}}, "wait": 4},
    {"title": "A first page from the address bar", "rpc": {"method": "debug.omnibar_type", "params": {"text": "https://example.com/", "commit": true}}, "wait": 4},
    {"title": "Open a page from the address bar", "rpc": {"method": "debug.omnibar_type", "params": {"text": "iana.org/domains/reserved", "commit": true}}, "wait": 2, "clip": true},
    {"title": "Back to the first page", "rpc": {"method": "debug.omnibar_type", "params": {"text": "example.com", "commit": true}}, "wait": 2, "clip": true},
    {"title": "End", "wait": 0.3}
  ],
  "crop": [0.19, 0, 0.62, 0.42]
}
