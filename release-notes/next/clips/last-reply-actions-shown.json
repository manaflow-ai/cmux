{
  "caption": "Copy, Fork, Pin and the rest show under a chat's last reply, so you act on it at once with no hover.",
  "frameInterval": 0.25,
  "harnessFixture": {
    "harnesses": {
      "fake": {
        "argv": [
          "/usr/bin/python3",
          "{repo}/cmux-tui/crates/acpmux/tests/fake_agent.py"
        ],
        "description": "acpmux's test agent (What's New clip tours)"
      }
    }
  },
  "steps": [
    {"title": "Launch", "wait": 2},
    {"title": "A fixed window", "rpc": {"method": "debug.window_frame", "params": {"frame": [80, 80, 1200, 800]}}, "wait": 0.5},
    {"title": "A new agent chat", "rpc": {"method": "action.run", "params": {"action": "palette.newAgentChat", "focus": true}}, "wait": 3},
    {"title": "On the fake harness (acpmux's test agent)", "rpc": {"method": "debug.agent_pane", "params": {"action": "new_chat", "harness": "fake"}}, "wait": 3},
    {"title": "A first reply", "rpc": {"method": "debug.agent_pane", "params": {"action": "send_prompt", "text": "Draft the garden club newsletter"}}, "wait": 3},
    {"title": "A second prompt: its reply becomes the last one", "rpc": {"method": "debug.agent_pane", "params": {"action": "send_prompt", "text": "Add a line about Saturday's seed swap"}}, "wait": 3, "clip": true},
    {"title": "The last reply's buttons stay in view at rest", "wait": 1.5, "clip": true},
    {"title": "End", "wait": 0.3}
  ],
  "crop": [0.2, 0.1, 0.8, 0.85],
  "hold": 1.6
}
