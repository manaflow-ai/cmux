{
  "caption": "Choose cmux > Customizations > Agent Badges and agent tabs and sidebar rows show their counts and status at once.",
  "frameInterval": 0.25,
  "steps": [
    {"title": "Launch", "wait": 2},
    {"title": "A workspace", "cmux": ["workspace", "new", "--name", "app"], "wait": 1.5},
    {"title": "Show it", "cmux": ["workspace", "name:app", "focus"], "wait": 1},
    {"title": "An agent chat", "cmux": ["action", "run", "palette.newAgentChat"], "wait": 3},
    {"title": "Agent Badges on, as its Customizations row does", "cmux": ["settings", "set", "experiments.agentBadges", "true"], "wait": 2, "clip": true},
    {"title": "Counts on the tab, status in the sidebar", "wait": 2, "clip": true},
    {"title": "End", "wait": 0.3}
  ],
  "crop": [0, 0, 0.6, 0.4]
}
