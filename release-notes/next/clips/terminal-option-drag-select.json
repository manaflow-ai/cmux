{
  "caption": "In Claude Code or Codex, hold Option (or Shift) and drag to select text; ⌘C copies exactly that.",
  "frameInterval": 0.25,
  "settings": {
    "terminal": {
      "fontSize": 18
    }
  },
  "steps": [
    {
      "title": "Launch",
      "wait": 3
    },
    {
      "title": "New workspace",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "Select"
      ]
    },
    {
      "title": "Show it",
      "cmux": [
        "workspace",
        "name:Select",
        "focus"
      ],
      "wait": 2
    },
    {
      "title": "Write the fixture program (fixtures/terminal-selection/mouse_tui.py)",
      "daemon": true,
      "cmux": [
        "workspace",
        "name:Select",
        "screen",
        "current",
        "pane",
        "current",
        "tab",
        "current",
        "terminal",
        "current",
        "write",
        "--text",
        "echo  | base64 -D | gunzip > /tmp/cmux-tour-mouse-tui.py; clear\r"
      ],
      "wait": 2
    },
    {
      "title": "A full-screen program takes the mouse, as Claude Code and Codex do",
      "daemon": true,
      "cmux": [
        "workspace",
        "name:Select",
        "screen",
        "current",
        "pane",
        "current",
        "tab",
        "current",
        "terminal",
        "current",
        "write",
        "--text",
        "python3 /tmp/cmux-tour-mouse-tui.py\r"
      ],
      "wait": 3
    },
    {
      "title": "A plain drag goes to the program; the one-time hint says Option or Shift + drag selects",
      "rpc": {
        "method": "debug.mouse",
        "params": {
          "action": "drag",
          "pane": "focused",
          "by_x": 320,
          "by_y": 0,
          "steps": 24
        }
      },
      "wait": 1.5,
      "clip": true
    },
    {
      "title": "Option-drag selects the text",
      "rpc": {
        "method": "debug.mouse",
        "params": {
          "action": "drag",
          "pane": "focused",
          "by_x": 320,
          "by_y": 0,
          "steps": 24,
          "modifiers": [
            "option"
          ]
        }
      },
      "wait": 2.0,
      "clip": true
    },
    {
      "title": "⌘C copies it",
      "rpc": {
        "method": "debug.key",
        "params": {
          "key": "c",
          "modifiers": [
            "cmd"
          ]
        }
      },
      "wait": 0.5,
      "clip": true
    },
    {
      "title": "The program prints the clipboard: exact",
      "daemon": true,
      "cmux": [
        "workspace",
        "name:Select",
        "screen",
        "current",
        "pane",
        "current",
        "tab",
        "current",
        "terminal",
        "current",
        "write",
        "--text",
        "c"
      ],
      "wait": 1.5,
      "clip": true
    },
    {
      "title": "End",
      "wait": 0.3
    }
  ],
  "crop": [
    0.18,
    0.3,
    0.82,
    0.7
  ],
  "hold": 1.4
}
