{
 "caption": "Set Command-1 to 9 Select to Tabs, and ⌘1…9 jump straight to the focused pane's tabs.",
 "frameInterval": 0.25,
 "settings": {
  "tabs": {
   "commandDigits": "tabs"
  }
 },
 "steps": [
  {
   "title": "Launch",
   "wait": 2
  },
  {
   "title": "A workspace whose first tab shows release notes",
   "cmux": [
    "action",
    "run",
    "newTab",
    "--arg",
    "name=Release notes",
    "--arg",
    "command=printf '\\033]0;Release notes\\007'; clear; printf '\\n  \\033[1;34mRELEASE NOTES\\033[0m\\n\\n  \\033[32m+\\033[0m Tabs on Command-1 to 9\\n  \\033[32m+\\033[0m Faster sidebar\\n  \\033[32m+\\033[0m New themes\\n'; sleep 900",
    "--arg",
    "focus=true"
   ],
   "wait": 2.5
  },
  {
   "title": "Tab 2: a page",
   "cmux": [
    "tab",
    "new-browser",
    "--url",
    "https://example.com"
   ],
   "wait": 3
  },
  {
   "title": "Tab 3: another page",
   "cmux": [
    "tab",
    "new-browser",
    "--url",
    "https://www.iana.org/domains/reserved"
   ],
   "wait": 4
  },
  {
   "title": "Start on tab 1",
   "rpc": {
    "method": "debug.key",
    "params": {
     "key": "1",
     "modifiers": [
      "command"
     ]
    }
   },
   "wait": 1.2
  },
  {
   "title": "Hold Command: digit hints",
   "rpc": {
    "method": "debug.shortcut_hints",
    "params": {
     "modifier": "cmd"
    }
   },
   "wait": 1.0,
   "clip": true,
   "optional": "hint monitor needs an active window"
  },
  {
   "title": "⌘3",
   "rpc": {
    "method": "debug.key",
    "params": {
     "key": "3",
     "modifiers": [
      "command"
     ]
    }
   },
   "wait": 1.3,
   "clip": true
  },
  {
   "title": "⌘1",
   "rpc": {
    "method": "debug.key",
    "params": {
     "key": "1",
     "modifiers": [
      "command"
     ]
    }
   },
   "wait": 1.3,
   "clip": true
  },
  {
   "title": "⌘2",
   "rpc": {
    "method": "debug.key",
    "params": {
     "key": "2",
     "modifiers": [
      "command"
     ]
    }
   },
   "wait": 1.3,
   "clip": true
  },
  {
   "title": "Release Command",
   "rpc": {
    "method": "debug.shortcut_hints",
    "params": {
     "modifier": "release"
    }
   },
   "wait": 0.5,
   "optional": "hint monitor needs an active window"
  },
  {
   "title": "End",
   "wait": 0.3
  }
 ],
 "crop": [
  0.19,
  0,
  0.62,
  0.42
 ]
}
