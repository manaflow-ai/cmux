{
  "caption": "Capture Screenshot to Chat puts the region you pick into the chat's composer as a draft.",
  "frameInterval": 0.25,
  "launch_args": ["--showcase"],
  "steps": [
    {"title": "Launch", "wait": 2},
    {"title": "A workspace", "cmux": ["action", "run", "newTab", "--arg", "name=Release checklist", "--arg", "cwd=/tmp", "--arg", "command=/bin/sh -c \"clear; printf 'build 42 passed\\n'; exec sleep 900\"", "--focus"], "wait": 2.5},
    {"title": "Open a chat", "cmux": ["agent", "new-chat", "--cwd", "/tmp"], "wait": 3},
    {"title": "Wait for the chat page", "rpc": {"method": "debug.agent_pane", "params": {"action": "chat_state"}}, "wait": 1},
    {"title": "Capture a region into the chat", "rpc": {"method": "chat.capture.toChat", "params": {"region": [80, 120, 640, 360]}}, "wait": 2.5, "clip": true},
    {"title": "Read the composer", "rpc": {"method": "chat.composer.get", "params": {}}, "wait": 1.0, "clip": true},
    {"title": "End", "wait": 0.3}
  ],
  "crop": [0.45, 0.45, 0.55, 0.55]
}
