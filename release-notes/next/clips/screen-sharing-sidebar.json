{
  "caption": "Share This Mac stays visible in the sidebar with either workspace layout.",
  "frameInterval": 0.25,
  "settings": {"sidebar": {"groupByComputer": false}},
  "steps": [
    {"title": "Launch", "wait": 2},
    {"title": "A workspace, so the sidebar lists Projects (a fresh launch shows only Home)", "cmux": ["workspace", "new", "--name", "Build"]},
    {"title": "Show it (a new workspace takes no focus)", "cmux": ["workspace", "name:Build", "focus"], "wait": 1.5},
    {"title": "Share beside Projects", "wait": 1.5, "clip": true},
    {
      "title": "Share beside This Mac in the grouped layout",
      "cmux": ["settings", "set", "sidebar.groupByComputer", "true"],
      "wait": 2,
      "clip": true
    },
    {
      "title": "Return to the flat layout",
      "cmux": ["settings", "set", "sidebar.groupByComputer", "false"],
      "wait": 1.5,
      "clip": true
    },
    {"title": "End", "wait": 0.3}
  ],
  "crop": [0, 0.12, 0.28, 0.65]
}
