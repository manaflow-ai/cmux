{
  "caption": "With Needs You Look set to Glow, a tab and a sidebar row that wait for you breathe a soft glow instead of a badge, until you look.",
  "frameInterval": 0.25,
  "settings": {"notifications": {"attention": {"mark": "glow"}}},
  "steps": [
    {"title": "Launch", "wait": 3},
    {"title": "Billing API", "cmux": ["action", "run", "newTab", "--arg", "name=Billing API", "--arg", "command=sleep 600", "--arg", "focus=false"], "wait": 1},
    {"title": "Search index: notifies in a few seconds", "cmux": ["action", "run", "newTab", "--arg", "name=Search index", "--arg", "command=sleep 4; printf '\\033]777;notify;Search index;Reindex finished\\007'; sleep 600", "--arg", "focus=false"], "wait": 1},
    {"title": "Select the first", "cmux": ["action", "run", "workspace.selectFirst"], "wait": 1.5},
    {"title": "Search index finishes and glows", "wait": 6, "clip": true},
    {"title": "End", "wait": 0.3}
  ],
  "crop": [0, 0, 0.5, 0.33]
}
