{
  "caption": "Find the options for searching session history directly from the terminal.",
  "frameInterval": 0.25,
  "settings": {"terminal": {"fontSize": 20}},
  "steps": [
    {"title": "Open the example workspace", "cmux": ["workspace", "new", "--name", "Session search"]},
    {"title": "Show its terminal", "cmux": ["workspace", "name:Session search", "focus"], "wait": 1.5},
    {"title": "Read the search usage", "daemon": true,
     "cmux": ["workspace", "name:Session search", "screen", "current", "pane", "current", "tab", "current", "terminal", "current",
              "write", "--text", "cmux agent search --help\r"], "wait": 2, "clip": true},
    {"title": "Search options", "wait": 1.5, "clip": true}
  ],
  "crop": [0.19, 0.05, 0.81, 0.64]
}
