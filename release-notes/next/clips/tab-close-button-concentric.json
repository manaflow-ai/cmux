{
  "caption": "Point at a tab's x: a small rounded square lights up behind a thinner x, plain black on light and white on dark.",
  "frameInterval": 0.25,
  "settings": {
    "appearance": {
      "density": "compact",
      "chromeStyle": "flat-sidebar-line",
      "metrics": {
        "sidebarWidth": 240,
        "titlebarHeight": 32,
        "tabMaxWidth": 200,
        "tabMinActiveWidth": 200,
        "tabMinInactiveWidth": 200
      }
    },
    "window": {
      "titlebar": "standard"
    },
    "layout": {
      "panePadding": 0
    },
    "sidebar": {
      "side": "left"
    },
    "tabs": {
      "barPosition": "top",
      "barOrder": "aboveToolbar",
      "toolbarButtons": []
    }
  },
  "steps": [
    {"title": "Launch", "wait": 2},
    {"title": "A fixed window, so the tabs sit where the pointer goes", "rpc": {"method": "debug.window_frame", "params": {"frame": [80, 80, 1200, 800]}}, "wait": 0.5},
    {"title": "A public workspace", "rpc": {"method": "action.run", "params": {"action": "newTab", "args": {"name": "Release review", "command": "printf 'Release review\\n'; exec /bin/cat"}, "focus": true, "wait": true}}, "wait": 2},
    {"title": "A public page", "cmux": ["tab", "new-browser", "--url", "https://example.org", "--focus"], "wait": 3},
    {"title": "A second public page", "cmux": ["tab", "new-browser", "--url", "https://example.net", "--focus"], "wait": 3},
    {"title": "Light appearance", "rpc": {"method": "debug.appearance", "params": {"mode": "light"}}, "wait": 0.5},
    {"title": "Pointer off the tabs", "rpc": {"method": "debug.mouse", "params": {"action": "hover", "x": 800, "y": 400}}, "wait": 0.8, "clip": true},
    {"title": "Pointer on a tab: its x shows", "rpc": {"method": "debug.mouse", "params": {"action": "hover", "x": 530, "y": 46}}, "wait": 1.0, "clip": true},
    {"title": "Pointer on the x: the rounded square lights up", "rpc": {"method": "debug.mouse", "params": {"action": "hover", "x": 630, "y": 46}}, "wait": 1.5, "clip": true},
    {"title": "Pointer off again", "rpc": {"method": "debug.mouse", "params": {"action": "hover", "x": 800, "y": 400}}, "wait": 0.5, "clip": true},
    {"title": "Dark appearance", "rpc": {"method": "debug.appearance", "params": {"mode": "dark"}}, "wait": 0.8, "clip": true},
    {"title": "Pointer on the x in dark: a white square", "rpc": {"method": "debug.mouse", "params": {"action": "hover", "x": 630, "y": 46}}, "wait": 1.5, "clip": true},
    {"title": "End", "rpc": {"method": "debug.mouse", "params": {"action": "leave"}}, "wait": 0.3}
  ],
  "crop": [0.2, 0.0, 0.45, 0.12],
  "lead": 0.6,
  "hold": 1.2
}
