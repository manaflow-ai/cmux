{
  "caption": "Chat tools stay together, with Session Info first and the menu last.",
  "launch_args": ["--showcase"],
  "settings": {"layout": {"mainPane": "off"}},
  "frameInterval": 0.25,
  "steps": [
    {"title": "Open a main workspace", "cmux": ["action", "run", "newTab", "--name", "Header capture", "--focus", "--cwd", "/tmp"]},
    {"title": "Open a chat", "cmux": ["agent", "new-chat", "--cwd", "/tmp"]},
    {"title": "Wait for the chat page", "rpc": {"method": "debug.agent_pane", "params": {"action": "chat_state"}}, "record": true},
    {"title": "Toggle Session Info", "rpc": {"method": "debug.agent_pane", "params": {"action": "click", "selector": ".acpmux-session-info-toggle"}}, "clip": true},
    {"title": "Show the chat menu", "rpc": {"method": "debug.agent_pane", "params": {"action": "click", "selector": ".acpmux-header-tools [aria-haspopup=menu]"}}, "clip": true},
    {"title": "Close the menu", "rpc": {"method": "debug.agent_pane", "params": {"action": "close_menus"}}, "clip": true}
  ],
  "crop": [0.55, 0, 0.45, 0.55]
}
