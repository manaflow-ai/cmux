{
  "caption": "Chat tools stay together, with Session Info first and the menu last.",
  "launch_args": ["--showcase"],
  "frameInterval": 0.25,
  "steps": [
    {"title": "Sample chat", "rpc": {"method": "debug.scene.render", "params": {"scene": "main-showcase"}}},
    {"title": "Toggle Session Info", "rpc": {"method": "debug.agent_pane", "params": {"action": "click", "selector": ".acpmux-chat-inspector-toggle"}}, "clip": true},
    {"title": "Show the chat menu", "rpc": {"method": "debug.agent_pane", "params": {"action": "click", "selector": ".acpmux-header-tools [aria-haspopup=menu]"}}, "clip": true},
    {"title": "Close the menu", "rpc": {"method": "debug.agent_pane", "params": {"action": "close_menus"}}, "clip": true}
  ],
  "crop": [0.55, 0, 0.45, 0.55]
}
