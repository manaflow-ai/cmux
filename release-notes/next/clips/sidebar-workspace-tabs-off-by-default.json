{
  "caption": "Workspaces sit on one row each; turn on Show Workspace Tabs in Settings to list their tabs under them.",
  "frameInterval": 0.25,
  "steps": [
    {"title": "Launch", "wait": 3},
    {"title": "Billing API", "cmux": ["workspace", "new", "--name", "Billing API"], "wait": 1},
    {"title": "Billing API: a second tab", "cmux": ["tab", "new-page"], "wait": 1},
    {"title": "Billing API: a third tab", "cmux": ["tab", "new-page"], "wait": 1},
    {"title": "Release notes", "cmux": ["workspace", "new", "--name", "Release notes"], "wait": 1},
    {"title": "Release notes: a second tab", "cmux": ["tab", "new-page"], "wait": 1.5},
    {"title": "Show Workspace Tabs on: each workspace lists its tabs", "cmux": ["settings", "set", "sidebar.showWorkspaceTabs", "true"], "wait": 2.5, "clip": true},
    {"title": "Off again: one row per workspace", "cmux": ["settings", "unset", "sidebar.showWorkspaceTabs"], "wait": 2.5, "clip": true},
    {"title": "End", "wait": 0.3}
  ],
  "crop": [0, 0, 0.22, 0.45]
}
