{
  "caption": "Turn on Update When Idle and cmux installs updates and restarts while you are away, agents still working.",
  "frameInterval": 0.25,
  "steps": [
    {"title": "Launch", "wait": 2},
    {"title": "A fixed window", "rpc": {"method": "debug.window_frame", "params": {"frame": [80, 80, 1200, 800]}}, "wait": 0.5},
    {"title": "The window, before Settings opens", "wait": 1, "clip": true},
    {"title": "Settings at Update When Idle", "rpc": {"method": "action.run", "params": {"action": "openSettings", "arguments": {"setting": "updates.automatic"}, "focus": true}}, "wait": 3.5, "clip": true}
  ],
  "crop": [0.25, 0.0, 0.75, 0.7]
}
