{
  "caption": "Set the spacing between Space buttons in the sidebar.",
  "frameInterval": 0.25,
  "steps": [
    {"title": "Show Spaces", "cmux": ["settings", "set", "sidebar.showSpaces", "true"], "wait": 1},
    {"title": "Keep the switcher visible", "cmux": ["settings", "set", "sidebar.spacesVisibility", "always"], "wait": 1},
    {"title": "Work", "cmux": ["room", "create", "--name", "Work"], "wait": 1},
    {"title": "Notes", "cmux": ["room", "create", "--name", "Notes"], "wait": 1},
    {"title": "Density default", "wait": 1.5, "clip": true},
    {"title": "Closer", "cmux": ["settings", "set", "appearance.metrics.spaceButtonSpacing", "18"], "wait": 1.5, "clip": true},
    {"title": "Wider", "cmux": ["settings", "set", "appearance.metrics.spaceButtonSpacing", "40"], "wait": 1.5, "clip": true}
  ],
  "crop": [0, 0.8, 0.3, 0.2]
}
