{
  "caption": "A message sent while the chat's connection drops waits in its pending row and sends itself once the link is back.",
  "frameInterval": 0.25,
  "harnessFixture": {
    "harnesses": {
      "fake": {
        "argv": [
          "/usr/bin/python3",
          "{repo}/cmux-tui/crates/acpmux/tests/fake_agent.py"
        ],
        "description": "acpmux's test agent (What's New clip tours)"
      }
    }
  },
  "steps": [
    {"title": "Launch", "wait": 2},
    {"title": "A new agent chat", "rpc": {"method": "action.run", "params": {"action": "palette.newAgentChat", "focus": true}}, "wait": 3},
    {"title": "On the fake harness (acpmux's test agent)", "rpc": {"method": "debug.agent_pane", "params": {"action": "new_chat", "harness": "fake"}}, "wait": 3},
    {"title": "A first message", "rpc": {"method": "debug.agent_pane", "params": {"action": "send_prompt", "text": "Plan the garden layout"}}, "wait": 2},
    {"title": "Trust the folder if it asks", "rpc": {"method": "debug.agent_pane", "params": {"action": "click", "selector": ".acpmux-trust-ask-primary"}}, "wait": 3, "optional": "no trust ask"},
    {"title": "The connection drops (Restart cmux-tui)", "rpc": {"method": "debug.daemon", "params": {"action": "restart"}}, "wait": 0.2, "clip": true},
    {"title": "A message sent meanwhile", "rpc": {"method": "debug.agent_pane", "params": {"action": "send_prompt", "text": "Draft the release checklist"}}, "wait": 3, "clip": true},
    {"title": "It sends itself once the link is back", "wait": 2.5, "clip": true},
    {"title": "End", "wait": 0.3}
  ],
  "crop": [0.2, 0.1, 0.8, 0.85],
  "hold": 1.4
}
