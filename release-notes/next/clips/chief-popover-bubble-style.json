{
  "caption": "Click the Chief's name to switch its bubbles between iMessage and your theme, or open Chat Colors.",
  "frameInterval": 0.25,
  "steps": [
    {"title": "Home with the Chief chat", "cmux": ["action", "run", "home.show"], "wait": 3},
    {"title": "The Chief's settings", "cmux": ["action", "run", "home.toggleChiefSettings"], "wait": 1.5, "clip": true},
    {"title": "Bubble Style: Theme", "cmux": ["settings", "set", "home.chiefBubbleStyle", "theme"], "wait": 2, "clip": true},
    {"title": "Bubble Style: iMessage", "cmux": ["settings", "set", "home.chiefBubbleStyle", "imessage"], "wait": 2, "clip": true},
    {"title": "End", "wait": 0.3}
  ],
  "crop": [0.15, 0, 0.7, 0.7]
}
