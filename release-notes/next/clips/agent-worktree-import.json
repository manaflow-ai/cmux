{
  "caption": "Review the worktree import plan in Settings, then open the workspaces in their existing folders.",
  "frameInterval": 0.25,
  "steps": [
    {
      "title": "Open the fixture terminal",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "Import fixture"
      ]
    },
    {
      "title": "Focus the fixture terminal",
      "cmux": [
        "workspace",
        "name:Import fixture",
        "focus"
      ]
    },
    {
      "title": "Create isolated linked worktree and agent rollout",
      "daemon": true,
      "timeout": 150,
      "cmux": [
        "terminal",
        "current",
        "run",
        "--timeout",
        "120s",
        "--text",
        "python3 -c 'import base64,zlib;_fixture_source=zlib.decompress(base64.b64decode('\"'\"''\"'\"'));exec(compile(_fixture_source,'\"'\"'<capture-fixture>'\"'\"','\"'\"'exec'\"'\"'))' setup"
      ]
    },
    {
      "title": "Refresh from real source files",
      "reopen": "quit",
      "recordLaunch": 6,
      "wait": 2
    },
    {
      "title": "Open Import settings",
      "settings_section": "import/importSuggestions"
    },
    {
      "title": "Settings import wait",
      "rpc": {
        "method": "debug.page",
        "params": {
          "page": "cmux.settings",
          "action": "wait",
          "selector": "[data-import-card=\"agents.conductor\"] [data-action=\"start\"]",
          "timeout_ms": 30000
        }
      },
      "record": "file"
    },
    {
      "title": "Settings import state",
      "rpc": {
        "method": "debug.page",
        "params": {
          "page": "cmux.settings",
          "action": "state"
        }
      },
      "record": "file"
    },
    {
      "title": "Settings import click",
      "rpc": {
        "method": "debug.page",
        "params": {
          "page": "cmux.settings",
          "action": "click",
          "selector": "[data-import-card=\"agents.conductor\"] [data-action=\"start\"]"
        }
      },
      "record": "file",
      "wait": 1
    },
    {
      "title": "Real import consent",
      "rpc": {
        "method": "debug.dialog",
        "params": {}
      },
      "record": "file"
    },
    {
      "title": "Assert and confirm native consent",
      "daemon": true,
      "timeout": 150,
      "cmux": [
        "terminal",
        "current",
        "run",
        "--timeout",
        "120s",
        "--text",
        "python3 -c 'import hashlib,os,pathlib\nhome=pathlib.Path(os.environ['\"'\"'HOME'\"'\"'])\nif not home.is_absolute() or home.is_symlink(): raise RuntimeError('\"'\"'Invalid capture HOME'\"'\"')\nif str(home)!=os.environ.get('\"'\"'CMUX_CAPTURE_SHELL_HOME'\"'\"'): raise RuntimeError('\"'\"'Wrong capture HOME'\"'\"')\nhelper=home/'\"'\"'import-any-tool-fixture/capture.py'\"'\"'\nif helper.is_symlink() or not helper.resolve().is_relative_to(home.resolve()): raise RuntimeError('\"'\"'Helper escapes capture HOME'\"'\"')\n_fixture_source=helper.read_bytes()\nif hashlib.sha256(_fixture_source).hexdigest()!='\"'\"'73e50a5681e1644adbd28c4883cabfb77d7069737edddc423ddec0304b5d7431'\"'\"': raise RuntimeError('\"'\"'Fixture source changed'\"'\"')\nexec(compile(_fixture_source,str(helper),'\"'\"'exec'\"'\"'))' consent"
      ],
      "wait": 2
    },
    {
      "title": "Real generic worktree preview",
      "rpc": {
        "method": "debug.dialog",
        "params": {}
      },
      "record": "file"
    },
    {
      "title": "Import the worktree from its preview",
      "daemon": true,
      "timeout": 150,
      "cmux": [
        "terminal",
        "current",
        "run",
        "--timeout",
        "120s",
        "--text",
        "python3 -c 'import hashlib,os,pathlib\nhome=pathlib.Path(os.environ['\"'\"'HOME'\"'\"'])\nif not home.is_absolute() or home.is_symlink(): raise RuntimeError('\"'\"'Invalid capture HOME'\"'\"')\nif str(home)!=os.environ.get('\"'\"'CMUX_CAPTURE_SHELL_HOME'\"'\"'): raise RuntimeError('\"'\"'Wrong capture HOME'\"'\"')\nhelper=home/'\"'\"'import-any-tool-fixture/capture.py'\"'\"'\nif helper.is_symlink() or not helper.resolve().is_relative_to(home.resolve()): raise RuntimeError('\"'\"'Helper escapes capture HOME'\"'\"')\n_fixture_source=helper.read_bytes()\nif hashlib.sha256(_fixture_source).hexdigest()!='\"'\"'73e50a5681e1644adbd28c4883cabfb77d7069737edddc423ddec0304b5d7431'\"'\"': raise RuntimeError('\"'\"'Fixture source changed'\"'\"')\nexec(compile(_fixture_source,str(helper),'\"'\"'exec'\"'\"'))' preview"
      ],
      "wait": 1.2,
      "clip": true
    },
    {
      "title": "Settings import wait",
      "rpc": {
        "method": "debug.page",
        "params": {
          "page": "cmux.settings",
          "action": "wait",
          "selector": "[data-import-card=\"agents.conductor\"][data-state=\"done\"]",
          "timeout_ms": 60000
        }
      },
      "record": "file",
      "wait": 0.8,
      "clip": true
    },
    {
      "title": "Settings import state",
      "rpc": {
        "method": "debug.page",
        "params": {
          "page": "cmux.settings",
          "action": "state"
        }
      },
      "record": "file"
    },
    {
      "title": "Assert open workspace and completed idempotent ledger",
      "daemon": true,
      "timeout": 150,
      "cmux": [
        "terminal",
        "current",
        "run",
        "--timeout",
        "120s",
        "--text",
        "python3 -c 'import hashlib,os,pathlib\nhome=pathlib.Path(os.environ['\"'\"'HOME'\"'\"'])\nif not home.is_absolute() or home.is_symlink(): raise RuntimeError('\"'\"'Invalid capture HOME'\"'\"')\nif str(home)!=os.environ.get('\"'\"'CMUX_CAPTURE_SHELL_HOME'\"'\"'): raise RuntimeError('\"'\"'Wrong capture HOME'\"'\"')\nhelper=home/'\"'\"'import-any-tool-fixture/capture.py'\"'\"'\nif helper.is_symlink() or not helper.resolve().is_relative_to(home.resolve()): raise RuntimeError('\"'\"'Helper escapes capture HOME'\"'\"')\n_fixture_source=helper.read_bytes()\nif hashlib.sha256(_fixture_source).hexdigest()!='\"'\"'73e50a5681e1644adbd28c4883cabfb77d7069737edddc423ddec0304b5d7431'\"'\"': raise RuntimeError('\"'\"'Fixture source changed'\"'\"')\nexec(compile(_fixture_source,str(helper),'\"'\"'exec'\"'\"'))' verify"
      ]
    },
    {
      "title": "Read back imported app workspace",
      "rpc": {
        "method": "snapshot.get",
        "params": {}
      },
      "record": "file"
    },
    {
      "title": "Completed Import settings",
      "settings_section": "import/importSuggestions"
    },
    {
      "title": "Settings import state",
      "rpc": {
        "method": "debug.page",
        "params": {
          "page": "cmux.settings",
          "action": "state"
        }
      },
      "record": "file"
    }
  ],
  "crop": [
    0.2,
    0.08,
    0.75,
    0.75
  ],
  "lead": 0.6,
  "hold": 1.2
}
