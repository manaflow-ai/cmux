{
  "caption": "Open Settings > Appearance to browse the Looks gallery and compare each look on the same sample window.",
  "frameInterval": 0.25,
  "steps": [
    {"title": "Launch", "wait": 2},
    {"title": "A fixed window", "rpc": {"method": "debug.window_frame", "params": {"frame": [80, 80, 1200, 800]}}, "wait": 0.5},
    {"title": "Open the Looks gallery", "rpc": {"method": "action.run", "params": {"action": "openSettings", "arguments": {"setting": "card.looksGallery"}, "focus": true}}, "wait": 3, "clip": true},
    {"title": "End", "wait": 0.3}
  ],
  "crop": [0.25, 0.0, 0.75, 0.7]
}
