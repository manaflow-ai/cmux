{
  "caption": "Press ⌘K in a web page, and cmux asks whether the page or cmux gets it.",
  "frameInterval": 0.25,
  "steps": [
    {"title": "Launch", "wait": 2},
    {"title": "A web page", "cmux": ["tab", "new-browser", "--url", "https://example.com"], "wait": 4},
    {"title": "⌘K in the page", "rpc": {"method": "debug.key", "params": {"key": "k", "modifiers": ["command"]}}, "wait": 2.5, "clip": true},
    {"title": "End", "wait": 0.3}
  ],
  "crop": [0.2, 0.2, 0.6, 0.6]
}
