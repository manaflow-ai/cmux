{
  "caption": "Completed work folds into one line above the final answer, and opens again with one click.",
  "launch_args": ["--showcase"],
  "settings": {"layout": {"mainPane": "off"}},
  "frameInterval": 0.25,
  "steps": [
    {"title": "Open a workspace", "cmux": ["action", "run", "newTab", "--name", "Retry report", "--focus", "--cwd", "/tmp"]},
    {"title": "Open a chat", "cmux": ["agent", "new-chat", "--cwd", "/tmp"]},
    {"title": "Show a completed turn", "rpc": {"method": "debug.agent_pane", "params": {"action": "seed_rows", "fixture": "worked-turn"}}, "wait": 1},
    {"title": "Expand the work", "rpc": {"method": "debug.agent_pane", "params": {"action": "click", "selector": ".cv-worked.is-toggle"}}, "wait": 1.5, "clip": true},
    {"title": "Fold it again", "rpc": {"method": "debug.agent_pane", "params": {"action": "click", "selector": ".cv-worked.is-toggle"}}, "wait": 1.5, "clip": true}
  ],
  "crop": [0.2, 0.12, 0.75, 0.75]
}
