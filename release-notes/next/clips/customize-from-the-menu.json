{
  "caption": "Choose Customize… and cmux opens a chat with /customize ready: say what to change and watch it change.",
  "frameInterval": 0.25,
  "steps": [
    {
      "title": "Launch",
      "wait": 2
    },
    {
      "title": "A workspace",
      "cmux": [
        "workspace",
        "new",
        "--name",
        "app"
      ],
      "wait": 1.5
    },
    {
      "title": "Show it",
      "cmux": [
        "workspace",
        "name:app",
        "focus"
      ],
      "wait": 1
    },
    {
      "title": "Customize… opens a chat with /customize in its composer",
      "cmux": [
        "action",
        "run",
        "customize.open"
      ],
      "wait": 3,
      "clip": true
    },
    {
      "title": "The chat waits with /customize in its composer",
      "wait": 3,
      "clip": true
    },
    {
      "title": "End",
      "wait": 0.3
    }
  ],
  "crop": [
    0.2,
    0,
    0.42,
    1
  ]
}
