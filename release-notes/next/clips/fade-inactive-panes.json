{
  "caption": "Fade Inactive Panes on: the pane you leave fades, and the pane you move to fades back.",
  "frameInterval": 0.25,
  "steps": [
    {"title": "Launch", "wait": 2},
    {"title": "Turn the setting on", "cmux": ["settings", "set", "layout.fadeInactivePanes", "true"], "wait": 1},
    {"title": "A workspace of its own (launch focuses the agent chat, which no script splits)", "cmux": ["workspace", "new", "--name", "Panes"]},
    {"title": "Show it (a new workspace takes no focus)", "cmux": ["workspace", "name:Panes", "focus"], "wait": 1.5},
    {"title": "A second pane on the right", "cmux": ["action", "run", "splitRight"], "wait": 2},
    {"title": "Focus the left pane: the right one fades", "cmux": ["action", "run", "focusLeft"], "wait": 1.2, "clip": true},
    {"title": "Focus the right pane: it fades back, the left one fades", "cmux": ["action", "run", "focusRight"], "wait": 1.2, "clip": true},
    {"title": "Left again", "cmux": ["action", "run", "focusLeft"], "wait": 1.2, "clip": true},
    {"title": "And right", "cmux": ["action", "run", "focusRight"], "wait": 1.2, "clip": true},
    {"title": "Turn it back off", "cmux": ["settings", "set", "layout.fadeInactivePanes", "false"], "wait": 0.3},
    {"title": "End", "wait": 0.3}
  ],
  "crop": [0.19, 0, 0.81, 0.9]
}
