{
  "caption": "Switch density: tabs, sidebar rows and the address bar grow and shrink together.",
  "frameInterval": 0.25,
  "steps": [
    {"title": "Launch", "wait": 2},
    {"title": "A browser tab", "cmux": ["tab", "new-browser", "--url", "https://example.com"], "wait": 3},
    {"title": "Compact", "cmux": ["settings", "set", "appearance.density", "compact"], "wait": 1.5, "clip": true},
    {"title": "Default", "cmux": ["settings", "set", "appearance.density", "cozy"], "wait": 1.5, "clip": true},
    {"title": "Comfortable", "cmux": ["settings", "set", "appearance.density", "comfortable"], "wait": 1.5, "clip": true},
    {"title": "Spacious", "cmux": ["settings", "set", "appearance.density", "spacious"], "wait": 1.5, "clip": true},
    {"title": "Back to the usual density", "cmux": ["settings", "reset", "appearance.density"], "wait": 0.5}
  ],
  "crop": [0, 0, 0.7, 0.35]
}
