    "textConfirm.off": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إيقاف: ينفذ Chief كل ما تطلبه الرسالة دون أن يسألك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isključeno: Chief radi sve što poruka traži bez pitanja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fra: Chief gør alt, hvad en besked beder om, uden at spørge dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aus: Chief tut alles, worum eine Nachricht bittet, ohne dich zu fragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: Chief does everything a text asks without asking you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desactivado: Chief hace todo lo que pide un mensaje sin preguntarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désactivé : Chief fait tout ce qu'un message demande sans vous demander."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Disattivato: Chief fa tutto ciò che un messaggio chiede senza chiederti nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ: チーフはテキストで頼まれたことを確認なしですべて行います。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បិទ៖ Chief ធ្វើគ្រប់យ៉ាងដែលសារស្នើដោយមិនសួរអ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "끔: Chief는 문자가 요청한 모든 것을 묻지 않고 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Av: Chief gjør alt en melding ber om uten å spørre deg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wyłączone: Chief robi wszystko, o co prosi wiadomość, bez pytania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desativado: o Chief faz tudo o que uma mensagem pede sem perguntar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выкл.: Chief делает всё, о чём просит сообщение, не спрашивая вас."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ปิด: Chief ทำทุกอย่างที่ข้อความขอโดยไม่ถามคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kapalı: Chief, bir mesajın istediği her şeyi sana sormadan yapar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вимк.: Chief робить усе, про що просить повідомлення, не питаючи вас."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tắt: Chief làm mọi thứ tin nhắn yêu cầu mà không hỏi bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "关闭：Chief 会直接执行短信要求的一切，不询问你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "關閉：Chief 會直接執行簡訊要求的一切，不詢問你。"
          }
        }
      }
    },
    "textConfirm.raiseBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "في هذا المستوى، يمكن لشخص يستولي على رقم هاتفك أن يفعل المزيد باسمك. تابع فقط إذا كنت تقبل هذه المخاطرة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na ovom nivou osoba koja preuzme tvoj broj može učiniti više u tvoje ime. Nastavi samo ako prihvataš taj rizik."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "På dette niveau kan en person, der overtager dit nummer, gøre mere som dig. Fortsæt kun, hvis du accepterer den risiko."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auf dieser Stufe kann jemand, der deine Nummer übernimmt, mehr in deinem Namen tun. Fahre nur fort, wenn du dieses Risiko akzeptierst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With this level, a person who takes over your phone number can do more as you. Continue only if you accept that risk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Con este nivel, quien se apodere de tu número puede hacer más en tu nombre. Continúa solo si aceptas ese riesgo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "À ce niveau, une personne qui prend votre numéro peut faire davantage en votre nom. Continuez seulement si vous acceptez ce risque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Con questo livello, chi si impossessa del tuo numero può fare di più a tuo nome. Continua solo se accetti questo rischio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレベルでは、電話番号を乗っ取った人があなたとしてより多くのことを行えます。そのリスクを受け入れる場合のみ続けてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "នៅកម្រិតនេះ អ្នកដែលយកលេខទូរស័ព្ទរបស់អ្នកអាចធ្វើបានច្រើនជាងមុនក្នុងនាមអ្នក។ បន្តតែបើអ្នកទទួលយកហានិភ័យនោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 수준에서는 전화번호를 가로챈 사람이 당신 이름으로 더 많은 일을 할 수 있습니다. 그 위험을 받아들일 때만 계속하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "På dette nivået kan en person som tar over nummeret ditt gjøre mer som deg. Fortsett bare hvis du godtar den risikoen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na tym poziomie osoba, która przejmie Twój numer, może zrobić więcej w Twoim imieniu. Kontynuuj tylko, jeśli akceptujesz to ryzyko."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neste nível, quem tomar seu número pode fazer mais em seu nome. Continue só se aceitar esse risco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На этом уровне человек, захвативший ваш номер, может сделать больше от вашего имени. Продолжайте, только если принимаете этот риск."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ในระดับนี้ คนที่ยึดหมายเลขของคุณได้จะทำสิ่งต่างๆ ในนามคุณได้มากขึ้น ดำเนินการต่อเฉพาะเมื่อคุณยอมรับความเสี่ยงนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu seviyede numaranı ele geçiren biri senin adına daha fazlasını yapabilir. Yalnızca bu riski kabul ediyorsan devam et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На цьому рівні людина, яка захопила ваш номер, може зробити більше від вашого імені. Продовжуйте, лише якщо приймаєте цей ризик."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ở mức này, người chiếm số điện thoại của bạn có thể làm nhiều hơn nhân danh bạn. Chỉ tiếp tục nếu bạn chấp nhận rủi ro đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在此级别下，夺取你号码的人能以你的名义做更多事。只有在你接受这一风险时才继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在此等級下，奪取你號碼的人能以你的名義做更多事。只有在你接受這項風險時才繼續。"
          }
        }
      }
    },
