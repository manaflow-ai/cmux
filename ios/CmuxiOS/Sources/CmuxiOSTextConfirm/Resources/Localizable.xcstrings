          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Novo dispositivo pode reduzir a proteção"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Новое устройство может снизить защиту"
