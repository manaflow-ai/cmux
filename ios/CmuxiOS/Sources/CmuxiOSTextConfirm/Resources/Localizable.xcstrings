            "state": "translated",
            "value": "テキストの保護を弱められる新しいデバイス"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ឧបករណ៍ថ្មីអាចបន្ថយការការពារ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "새 기기가 문자 보호를 낮출 수 있음"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
