    "textConfirm.destructiveOnly": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الإجراءات المدمرة فقط: تؤكد عمليات الحذف والإجراءات التي لا يمكن التراجع عنها. قد ينفق Chief المال ويرسل الرسائل ويغير الصلاحيات من رسالة دون أن يسألك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Samo destruktivne: potvrđuješ brisanja i radnje koje se ne mogu poništiti. Chief može trošiti novac, slati poruke i mijenjati pristup iz poruke bez pitanja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kun destruktive: Du bekræfter sletninger og handlinger, der ikke kan fortrydes. Chief kan bruge penge, sende beskeder og ændre adgang fra en besked uden at spørge dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nur destruktive: Du bestätigst Löschungen und Aktionen, die sich nicht rückgängig machen lassen. Chief kann per Nachricht ohne Rückfrage Geld ausgeben, Nachrichten senden und Zugriff ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Destructive only: you confirm deletions and actions that cannot be undone. Chief may spend money, send messages and change access from a text without asking you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo destructivas: confirmas los borrados y las acciones que no se pueden deshacer. Chief puede gastar dinero, enviar mensajes y cambiar accesos desde un mensaje sin preguntarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Destructives uniquement : vous confirmez les suppressions et les actions irréversibles. Chief peut dépenser, envoyer des messages et modifier les accès depuis un message sans vous demander."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo distruttive: confermi eliminazioni e azioni irreversibili. Chief può spendere, inviare messaggi e cambiare gli accessi da un messaggio senza chiederti nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "破壊的な操作のみ: 削除と取り消せない操作だけを確認します。チーフはテキストから確認なしで支払い、送信、アクセス権の変更を行うことがあります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "តែសកម្មភាពបំផ្លិចបំផ្លាញ៖ អ្នកបញ្ជាក់ការលុប និងសកម្មភាពដែលមិនអាចត្រឡប់វិញបាន។ Chief អាចចំណាយលុយ ផ្ញើសារ និងប្ដូរសិទ្ធិចូលពីសារដោយមិនសួរអ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "파괴적 작업만: 삭제와 되돌릴 수 없는 작업만 확인합니다. Chief는 문자만으로 묻지 않고 결제, 전송, 접근 권한 변경을 할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bare destruktive: Du bekrefter slettinger og handlinger som ikke kan angres. Chief kan bruke penger, sende meldinger og endre tilgang fra en melding uten å spørre deg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tylko destrukcyjne: potwierdzasz usunięcia i działania, których nie da się cofnąć. Chief może wydawać pieniądze, wysyłać wiadomości i zmieniać dostęp z wiadomości bez pytania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Só destrutivas: você confirma exclusões e ações que não podem ser desfeitas. O Chief pode gastar, enviar mensagens e mudar acessos a partir de uma mensagem sem perguntar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Только разрушительные: вы подтверждаете удаления и необратимые действия. Chief может тратить деньги, отправлять сообщения и менять доступ по сообщению без вопросов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เฉพาะที่ทำลาย: คุณยืนยันการลบและการกระทำที่ย้อนกลับไม่ได้ Chief อาจใช้เงิน ส่งข้อความ และเปลี่ยนสิทธิ์จากข้อความโดยไม่ถามคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yalnızca yıkıcı: Silmeleri ve geri alınamayan işlemleri onaylarsın. Chief bir mesajla sana sormadan para harcayabilir, mesaj gönderebilir ve erişimi değiştirebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Лише руйнівні: ви підтверджуєте видалення та незворотні дії. Chief може витрачати гроші, надсилати повідомлення й змінювати доступ із повідомлення без запитань."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chỉ hành động phá hủy: bạn xác nhận việc xóa và các hành động không thể hoàn tác. Chief có thể tiêu tiền, gửi tin nhắn và thay đổi quyền truy cập từ tin nhắn mà không hỏi bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅破坏性操作：你只需确认删除和无法撤销的操作。Chief 可能会根据短信直接花钱、发送消息和更改访问权限，而不询问你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "僅限破壞性操作：你只需確認刪除和無法復原的操作。Chief 可能會依簡訊直接花錢、傳送訊息並變更存取權限，而不詢問你。"
          }
        }
      }
    },
    "textConfirm.keyAdded.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أضيف جهاز جديد يمكنه تخفيض حماية الرسائل بعد 24 ساعة. إذا لم تكن أنت، فأزله من إعدادات cmux."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dodan je novi uređaj koji nakon 24 sata može smanjiti zaštitu poruka. Ako to nisi ti, ukloni ga u postavkama cmuxa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En ny enhed, der kan sænke din beskyttelse efter 24 timer, er tilføjet. Hvis det ikke var dig, så fjern den i cmux-indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein neues Gerät wurde hinzugefügt, das nach 24 Stunden deinen Nachrichtenschutz verringern kann. Wenn du das nicht warst, entferne es in den cmux-Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new device was added that can lower your text protection after 24 hours. If this was not you, remove it in cmux Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se añadió un dispositivo nuevo que podrá reducir tu protección de mensajes en 24 horas. Si no fuiste tú, quítalo en los ajustes de cmux."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un nouvel appareil pouvant réduire votre protection des messages dans 24 heures a été ajouté. Si ce n'était pas vous, supprimez-le dans les réglages de cmux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "È stato aggiunto un nuovo dispositivo che tra 24 ore potrà ridurre la protezione dei messaggi. Se non sei stato tu, rimuovilo nelle impostazioni di cmux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "24時間後にテキストの保護を弱められる新しいデバイスが追加されました。心当たりがない場合は、cmux の設定で削除してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ឧបករណ៍ថ្មីមួយដែលអាចបន្ថយការការពារសាររបស់អ្នកបន្ទាប់ពី 24 ម៉ោង ត្រូវបានបន្ថែម។ បើមិនមែនអ្នកទេ សូមដកវាចេញក្នុងការកំណត់ cmux។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "24시간 후 문자 보호를 낮출 수 있는 새 기기가 추가되었습니다. 본인이 아니라면 cmux 설정에서 제거하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En ny enhet som kan senke beskyttelsen etter 24 timer er lagt til. Hvis det ikke var deg, fjern den i cmux-innstillingene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dodano nowe urządzenie, które po 24 godzinach może obniżyć ochronę wiadomości. Jeśli to nie Ty, usuń je w ustawieniach cmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Foi adicionado um novo dispositivo que poderá reduzir sua proteção de mensagens em 24 horas. Se não foi você, remova-o nos ajustes do cmux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Добавлено новое устройство, которое через 24 часа сможет снизить защиту сообщений. Если это были не вы, удалите его в настройках cmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "มีการเพิ่มอุปกรณ์ใหม่ที่จะลดการป้องกันข้อความได้หลังจาก 24 ชั่วโมง หากไม่ใช่คุณ ให้ลบออกในการตั้งค่า cmux"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "24 saat sonra mesaj korumanı düşürebilecek yeni bir cihaz eklendi. Bu sen değilsen cmux ayarlarından kaldır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Додано новий пристрій, який через 24 години зможе знизити захист повідомлень. Якщо це були не ви, видаліть його в налаштуваннях cmux."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Một thiết bị mới có thể giảm bảo vệ tin nhắn của bạn sau 24 giờ đã được thêm. Nếu không phải bạn, hãy xóa nó trong cài đặt cmux."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已添加一台新设备，它将在 24 小时后可以降低你的短信保护。如果不是你，请在 cmux 设置中移除它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已新增一台裝置，它將在 24 小時後可以降低你的簡訊保護。如果不是你，請在 cmux 設定中移除它。"
          }
        }
      }
    },
    "textConfirm.keyAdded.title": {
