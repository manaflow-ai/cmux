    "textConfirm.simSwapRisk": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أي شخص يسيطر على رقم هاتفك (هاتف مسروق أو تبديل شريحة SIM أو رقم معاد تدويره) يمكنه مراسلة Chief باسمك. كلما قل ما تؤكده، زاد ما يمكن لذلك الشخص فعله."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svako ko preuzme tvoj broj telefona (ukraden telefon, zamjena SIM kartice ili reciklirani broj) može pisati Chiefu kao ti. Što manje potvrđuješ, ta osoba može više."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle, der overtager dit telefonnummer (en stjålet telefon, et SIM-bytte eller et genbrugt nummer), kan skrive til Chief som dig. Jo mindre du bekræfter, jo mere kan den person gøre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wer deine Telefonnummer übernimmt (gestohlenes Telefon, SIM-Tausch oder neu vergebene Nummer), kann Chief als du schreiben. Je weniger du bestätigst, desto mehr kann diese Person tun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone who takes control of your phone number (a stolen phone, a SIM swap or a recycled number) can text Chief as you. The less you confirm, the more that person can do."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quien tome el control de tu número de teléfono (un teléfono robado, un cambio de SIM o un número reciclado) puede escribir a Chief como tú. Cuanto menos confirmes, más podrá hacer esa persona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toute personne qui prend le contrôle de votre numéro (téléphone volé, échange de SIM ou numéro réattribué) peut écrire à Chief en votre nom. Moins vous confirmez, plus cette personne peut agir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chiunque prenda il controllo del tuo numero (telefono rubato, scambio di SIM o numero riassegnato) può scrivere a Chief come te. Meno confermi, più quella persona può fare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの電話番号を乗っ取った人（盗まれた電話、SIMスワップ、再利用された番号）は、あなたとしてチーフにテキストを送れます。確認が少ないほど、その人ができることは増えます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អ្នកណាដែលគ្រប់គ្រងលេខទូរស័ព្ទរបស់អ្នក (ទូរស័ព្ទដែលត្រូវលួច ការប្ដូរ SIM ឬលេខដែលប្រើឡើងវិញ) អាចផ្ញើសារទៅ Chief ក្នុងនាមអ្នក។ អ្នកបញ្ជាក់កាន់តែតិច មនុស្សនោះអាចធ្វើបានកាន់តែច្រើន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "전화번호를 장악한 사람(도난된 휴대폰, SIM 스와프, 재사용된 번호)은 당신인 척 Chief에게 문자를 보낼 수 있습니다. 확인을 적게 할수록 그 사람이 할 수 있는 일이 많아집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle som tar kontroll over telefonnummeret ditt (en stjålet telefon, et SIM-bytte eller et gjenbrukt nummer) kan sende meldinger til Chief som deg. Jo mindre du bekrefter, jo mer kan den personen gjøre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Każdy, kto przejmie Twój numer telefonu (skradziony telefon, podmiana karty SIM lub ponownie przydzielony numer), może pisać do Chiefa jako Ty. Im mniej potwierdzasz, tym więcej ta osoba może zrobić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quem assumir o controle do seu número (celular roubado, troca de SIM ou número reciclado) pode mandar mensagens ao Chief como você. Quanto menos você confirma, mais essa pessoa pode fazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Любой, кто завладеет вашим номером (украденный телефон, подмена SIM или повторно выданный номер), может писать Chief от вашего имени. Чем меньше вы подтверждаете, тем больше может сделать этот человек."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ใครก็ตามที่ควบคุมหมายเลขโทรศัพท์ของคุณได้ (โทรศัพท์ถูกขโมย การสลับซิม หรือหมายเลขที่นำกลับมาใช้) สามารถส่งข้อความถึง Chief ในนามคุณ ยิ่งคุณยืนยันน้อย คนนั้นก็ยิ่งทำได้มาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Telefon numaranın kontrolünü ele geçiren herkes (çalınan telefon, SIM değiştirme veya yeniden atanmış numara) Chief'e senin yerine yazabilir. Ne kadar az onaylarsan o kişi o kadar çok şey yapabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Будь-хто, хто заволодіє вашим номером (викрадений телефон, заміна SIM або повторно виданий номер), може писати Chief від вашого імені. Що менше ви підтверджуєте, то більше може зробити ця людина."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bất kỳ ai chiếm được số điện thoại của bạn (điện thoại bị đánh cắp, hoán đổi SIM hoặc số được cấp lại) đều có thể nhắn cho Chief với tư cách là bạn. Bạn xác nhận càng ít, người đó càng làm được nhiều."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "任何控制了你的电话号码的人（手机被盗、SIM 卡被换或号码被回收再分配）都能以你的身份给 Chief 发短信。你确认得越少，这个人能做的就越多。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "任何控制了你電話號碼的人（手機遭竊、SIM 卡被換或號碼被回收再分配）都能以你的身分傳簡訊給 Chief。你確認得越少，這個人能做的就越多。"
          }
        }
      }
    },
    "textConfirm.strict": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "صارم (موصى به): عندما تطلب رسالة من Chief حذف شيء أو إنفاق مال أو إرسال شيء خارج cmux أو تغيير الصلاحيات أو أي إجراء لا يمكن التراجع عنه، تؤكد ذلك في التطبيق أولاً."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Strogo (preporučeno): kada poruka traži od Chiefa da nešto obriše, potroši novac, pošalje nešto izvan cmuxa, promijeni pristup ili uradi nešto što se ne može poništiti, prvo to potvrdiš u aplikaciji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Streng (anbefalet): Når en besked beder Chief om at slette noget, bruge penge, sende noget uden for cmux, ændre adgang eller gøre noget, der ikke kan fortrydes, bekræfter du det først i appen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Streng (empfohlen): Wenn eine Nachricht Chief bittet, etwas zu löschen, Geld auszugeben, etwas außerhalb von cmux zu senden, Zugriff zu ändern oder etwas Unumkehrbares zu tun, bestätigst du es zuerst in der App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strict (recommended): when a text asks Chief to delete something, spend money, send something outside cmux, change who has access or do anything that cannot be undone, you confirm it in the app first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Estricto (recomendado): cuando un mensaje pide a Chief borrar algo, gastar dinero, enviar algo fuera de cmux, cambiar el acceso o hacer algo que no se puede deshacer, lo confirmas primero en la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Strict (recommandé) : quand un message demande à Chief de supprimer quelque chose, de dépenser de l'argent, d'envoyer quelque chose hors de cmux, de modifier les accès ou de faire une action irréversible, vous le confirmez d'abord dans l'app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rigoroso (consigliato): quando un messaggio chiede a Chief di eliminare qualcosa, spendere denaro, inviare qualcosa fuori da cmux, cambiare gli accessi o fare qualcosa di irreversibile, lo confermi prima nell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "厳格（推奨）: テキストでチーフに削除、支払い、cmux外への送信、アクセス権の変更、または取り消せない操作を頼んだときは、先にアプリで確認します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "តឹងរ៉ឹង (ណែនាំ)៖ នៅពេលសារស្នើឱ្យ Chief លុប ចំណាយលុយ ផ្ញើអ្វីមួយក្រៅ cmux ប្ដូរសិទ្ធិចូល ឬធ្វើអ្វីដែលមិនអាចត្រឡប់វិញបាន អ្នកបញ្ជាក់វានៅក្នុងកម្មវិធីជាមុនសិន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "엄격(권장): 문자가 Chief에게 삭제, 결제, cmux 밖으로의 전송, 접근 권한 변경 또는 되돌릴 수 없는 작업을 요청하면 먼저 앱에서 확인합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Streng (anbefalt): Når en melding ber Chief slette noe, bruke penger, sende noe utenfor cmux, endre tilgang eller gjøre noe som ikke kan angres, bekrefter du det i appen først."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ścisły (zalecany): gdy wiadomość prosi Chiefa o usunięcie czegoś, wydanie pieniędzy, wysłanie czegoś poza cmux, zmianę dostępu lub coś, czego nie da się cofnąć, najpierw potwierdzasz to w aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rigoroso (recomendado): quando uma mensagem pede ao Chief para excluir algo, gastar dinheiro, enviar algo para fora do cmux, mudar acessos ou fazer algo que não pode ser desfeito, você confirma primeiro no app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Строго (рекомендуется): когда сообщение просит Chief что-то удалить, потратить деньги, отправить что-то за пределы cmux, изменить доступ или сделать что-то необратимое, вы сначала подтверждаете это в приложении."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เข้มงวด (แนะนำ): เมื่อข้อความขอให้ Chief ลบบางอย่าง ใช้เงิน ส่งบางอย่างออกนอก cmux เปลี่ยนสิทธิ์การเข้าถึง หรือทำสิ่งที่ย้อนกลับไม่ได้ คุณจะยืนยันในแอปก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Katı (önerilen): Bir mesaj Chief'ten bir şeyi silmesini, para harcamasını, cmux dışına bir şey göndermesini, erişimi değiştirmesini veya geri alınamayan bir şey yapmasını istediğinde önce uygulamada onaylarsın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Суворо (рекомендовано): коли повідомлення просить Chief щось видалити, витратити гроші, надіслати щось за межі cmux, змінити доступ або зробити щось незворотне, ви спершу підтверджуєте це в застосунку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nghiêm ngặt (khuyên dùng): khi tin nhắn yêu cầu Chief xóa thứ gì đó, tiêu tiền, gửi thứ gì ra ngoài cmux, thay đổi quyền truy cập hoặc làm điều không thể hoàn tác, bạn xác nhận trong ứng dụng trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "严格（推荐）：当短信要求 Chief 删除内容、花钱、向 cmux 之外发送内容、更改访问权限或执行无法撤销的操作时，你需要先在应用中确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "嚴格（建議）：當簡訊要求 Chief 刪除內容、花錢、向 cmux 以外傳送內容、變更存取權限或執行無法復原的操作時，你需要先在 App 中確認。"
          }
        }
      }
    },
