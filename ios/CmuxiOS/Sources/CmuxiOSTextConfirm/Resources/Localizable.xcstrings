        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อุปกรณ์ใหม่ลดการป้องกันได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yeni cihaz korumayı düşürebilir"
          }
