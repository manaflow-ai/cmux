    "textConfirm.lowered.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تغير تأكيد الرسائل إلى Chief من {from} إلى {to}. إذا لم تفعل ذلك، افتح cmux على جهاز موثوق وأعده إلى صارم."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Potvrda poruka za Chiefa promijenjena je s {from} na {to}. Ako to nisi ti, otvori cmux na pouzdanom uređaju i vrati na Strogo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bekræftelse af beskeder til Chief blev ændret fra {from} til {to}. Hvis det ikke var dig, så åbn cmux på en betroet enhed og sæt den tilbage til Streng."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Bestätigung für Nachrichten an Chief wurde von {from} auf {to} geändert. Wenn du das nicht warst, öffne cmux auf einem vertrauenswürdigen Gerät und stelle Streng wieder ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmation for texts to Chief changed from {from} to {to}. If you did not do this, open cmux on a trusted device and set it back to Strict."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La confirmación de mensajes a Chief cambió de {from} a {to}. Si no fuiste tú, abre cmux en un dispositivo de confianza y vuelve a Estricto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La confirmation des messages à Chief est passée de {from} à {to}. Si ce n'était pas vous, ouvrez cmux sur un appareil de confiance et remettez Strict."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La conferma dei messaggi a Chief è passata da {from} a {to}. Se non sei stato tu, apri cmux su un dispositivo fidato e torna a Rigoroso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チーフへのテキストの確認レベルが {from} から {to} に変更されました。心当たりがない場合は、信頼できるデバイスで cmux を開き、厳格に戻してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការបញ្ជាក់សម្រាប់សារទៅ Chief បានប្ដូរពី {from} ទៅ {to}។ បើមិនមែនអ្នកធ្វើទេ សូមបើក cmux នៅលើឧបករណ៍ដែលទុកចិត្ត ហើយប្ដូរត្រឡប់ទៅតឹងរ៉ឹង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief에게 보내는 문자의 확인 수준이 {from}에서 {to}(으)로 바뀌었습니다. 본인이 아니라면 신뢰할 수 있는 기기에서 cmux를 열고 엄격으로 되돌리세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bekreftelse av meldinger til Chief ble endret fra {from} til {to}. Hvis det ikke var deg, åpne cmux på en klarert enhet og sett den tilbake til Streng."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Potwierdzanie wiadomości do Chiefa zmieniono z {from} na {to}. Jeśli to nie Ty, otwórz cmux na zaufanym urządzeniu i przywróć Ścisły."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A confirmação de mensagens ao Chief mudou de {from} para {to}. Se não foi você, abra o cmux em um dispositivo confiável e volte para Rigoroso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подтверждение сообщений для Chief изменено с {from} на {to}. Если это были не вы, откройте cmux на доверенном устройстве и верните «Строго»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การยืนยันข้อความถึง Chief เปลี่ยนจาก {from} เป็น {to} หากไม่ใช่คุณ ให้เปิด cmux บนอุปกรณ์ที่เชื่อถือได้และตั้งกลับเป็นเข้มงวด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief'e gönderilen mesajların onayı {from} düzeyinden {to} düzeyine değişti. Bunu sen yapmadıysan cmux'u güvenilir bir cihazda aç ve Katı'ya geri al."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Підтвердження повідомлень для Chief змінено з {from} на {to}. Якщо це були не ви, відкрийте cmux на довіреному пристрої та поверніть «Суворо»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mức xác nhận tin nhắn gửi Chief đã đổi từ {from} sang {to}. Nếu không phải bạn, hãy mở cmux trên thiết bị tin cậy và đặt lại Nghiêm ngặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "发给 Chief 的短信确认级别已从{from}改为{to}。如果不是你操作的，请在受信任的设备上打开 cmux 并改回严格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "傳給 Chief 的簡訊確認等級已從{from}改為{to}。如果不是你操作的，請在受信任的裝置上開啟 cmux 並改回嚴格。"
          }
        }
      }
    },
