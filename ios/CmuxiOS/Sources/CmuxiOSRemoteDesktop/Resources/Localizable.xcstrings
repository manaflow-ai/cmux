    "rd.failure.permission-revoked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording was turned off on the Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macで画面収録がオフになりました。"
          }
        }
