    "rd.entry.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac streams its screen, or a VNC server it can reach."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macの画面、またはMacから接続できるVNCサーバを表示します。"
          }
        }
      }
    },
    "rd.entry.screen": {
      "extractionState": "manual",
      "localizations": {
