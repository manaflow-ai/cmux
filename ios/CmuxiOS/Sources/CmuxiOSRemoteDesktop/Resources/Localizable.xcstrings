    "rd.failure.vnc-auth-unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This VNC server needs a sign-in the Mac doesn't support. Turn on VNC password access on the server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このVNCサーバはMacが対応していないサインインを求めています。サーバでVNCパスワードによるアクセスをオンにしてください。"
          }
        }
      }
    },
    "rd.failure.vnc-not-allowed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac doesn't connect to that VNC server."
