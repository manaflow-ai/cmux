      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Denied on the Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macで拒否されました。"
          }
        }
      }
    },
    "rd.failure.display": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That display is no longer connected."
          }
