    "rd.auth.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يطلب %@ كلمة مرور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ fordert ein Passwort an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ asks for a password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ solicita una contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ demande un mot de passe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はパスワードを求めています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@에서 암호를 요청합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 要求输入密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 要求輸入密碼。"
          }
        }
      }
    },
