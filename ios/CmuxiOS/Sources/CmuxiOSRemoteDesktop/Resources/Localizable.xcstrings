    },
    "rd.failure.revoked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device is no longer paired with the Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスはMacとペアリングされていません。"
          }
        }
      }
    },
    "rd.failure.screen-recording": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Screen Recording for cmux in System Settings on your Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのシステム設定でcmuxの画面収録を許可してください。"
          }
        }
      }
    },
    "rd.failure.stopped": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped on the Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macで停止されました。"
          }
        }
      }
