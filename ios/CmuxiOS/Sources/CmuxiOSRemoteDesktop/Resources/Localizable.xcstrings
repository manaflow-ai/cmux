    "rd.failure.unreachable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacに接続できません。"
          }
        }
      }
