    "rd.vnc.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتصل الـ Mac بهذا الخادم نيابةً عنك. أدخل اسم مضيف أو عنوان IP ومنفذًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Mac verbindet sich für dich mit diesem Server. Gib einen Hostnamen oder eine IP-Adresse und einen Port ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac connects to this server for you. Enter a hostname or IP address and a port."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu Mac se conecta a este servidor por ti. Introduce un nombre de host o una dirección IP y un puerto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre Mac se connecte à ce serveur pour vous. Saisissez un nom d’hôte ou une adresse IP et un port."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macがこのサーバに接続します。ホスト名またはIPアドレスとポートを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac이 대신 이 서버에 연결합니다. 호스트 이름 또는 IP 주소와 포트를 입력하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的 Mac 会替你连接到此服务器。请输入主机名或 IP 地址以及端口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的 Mac 會替你連線到此伺服器。請輸入主機名稱或 IP 位址以及連接埠。"
          }
        }
      }
