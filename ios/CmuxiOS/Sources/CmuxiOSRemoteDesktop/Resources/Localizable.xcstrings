    "rd.entry.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يبث الـ Mac شاشته، أو خادم VNC يمكنه الوصول إليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Mac streamt seinen Bildschirm oder einen VNC-Server, den er erreichen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac streams its screen, or a VNC server it can reach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu Mac transmite su pantalla o un servidor VNC al que puede acceder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre Mac diffuse son écran, ou un serveur VNC qu’il peut joindre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macの画面、またはMacから接続できるVNCサーバを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac이 화면 또는 접근할 수 있는 VNC 서버를 스트리밍합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的 Mac 会串流它的屏幕，或它能访问的 VNC 服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的 Mac 會串流它的螢幕，或它能連線的 VNC 伺服器。"
          }
        }
      }
    },
