    "home.composer.offline": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "غير متصل. تبقى مسودتك هنا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Van mreže. Nacrt ostaje ovdje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Offline. Din kladde bliver her."
          }
