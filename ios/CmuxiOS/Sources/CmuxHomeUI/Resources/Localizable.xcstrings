    "home.to.inviteNotice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الأشخاص المميزون بـ «دعوة» لا يستخدمون cmux بعد. ستصلهم رسالتك كدعوة عبر البريد الإلكتروني أو الرسائل النصية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Osobe označene sa Pozovi još ne koriste cmux. Tvoja poruka stiže im kao pozivnica e-mailom ili SMS-om."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Personer markeret med Inviter bruger ikke cmux endnu. Din besked når dem som en invitation via e-mail eller sms."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mit „Einladen“ markierte Personen nutzen cmux noch nicht. Deine Nachricht erreicht sie als Einladung per E-Mail oder SMS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People marked Invite aren't on cmux yet. Your message reaches them as an invite by email or text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las personas marcadas con Invitar aún no usan cmux. Tu mensaje les llega como invitación por correo o SMS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les personnes marquées « Inviter » ne sont pas encore sur cmux. Votre message leur parvient comme une invitation par e-mail ou SMS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le persone segnate con Invita non usano ancora cmux. Il tuo messaggio arriva come invito via email o SMS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「招待」と表示された人はまだ cmux を使っていません。メッセージはメールまたはテキストの招待として届きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មនុស្សដែលមានសញ្ញា អញ្ជើញ មិនទាន់ប្រើ cmux នៅឡើយ។ សាររបស់អ្នកនឹងទៅដល់ពួកគេជាការអញ្ជើញតាមអ៊ីមែល ឬ SMS។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‘초대’로 표시된 사람은 아직 cmux를 사용하지 않습니다. 메시지는 이메일이나 문자 초대로 전달됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Personer merket Inviter bruker ikke cmux ennå. Meldingen din når dem som en invitasjon på e-post eller SMS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Osoby oznaczone jako Zaproś nie korzystają jeszcze z cmux. Twoja wiadomość dotrze do nich jako zaproszenie e-mailem lub SMS-em."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As pessoas marcadas com Convidar ainda não usam o cmux. Sua mensagem chega como convite por e-mail ou SMS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Люди с меткой «Пригласить» ещё не пользуются cmux. Ваше сообщение придёт им как приглашение по e-mail или SMS."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คนที่มีป้าย เชิญ ยังไม่ได้ใช้ cmux ข้อความของคุณจะไปถึงพวกเขาเป็นคำเชิญทางอีเมลหรือ SMS"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Davet ile işaretlenen kişiler henüz cmux kullanmıyor. Mesajınız onlara e-posta veya SMS ile davet olarak ulaşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Люди з позначкою «Запросити» ще не користуються cmux. Ваше повідомлення надійде їм як запрошення email або SMS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Những người được đánh dấu Mời chưa dùng cmux. Tin nhắn của bạn sẽ đến với họ dưới dạng lời mời qua email hoặc SMS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "标有“邀请”的人还没有使用 cmux。你的消息会以电子邮件或短信邀请的形式送达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "標有「邀請」的人尚未使用 cmux。你的訊息會以電子郵件或簡訊邀請的形式送達。"
          }
        }
      }
    },
    "home.to.inviteOnlyNotice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ستصلهم دعوتك عبر البريد الإلكتروني أو الرسائل النصية. ومن يستخدم cmux بالفعل سيعرف أنك هنا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dobit će tvoju pozivnicu e-mailom ili SMS-om. Oni koji već koriste cmux saznat će da si ovdje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De får din invitation via e-mail eller sms. Dem, der allerede bruger cmux, får besked om, at du er her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sie erhalten deine Einladung per E-Mail oder SMS. Wer cmux schon nutzt, erfährt, dass du hier bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They get an invitation from you by email or text. People already on cmux are told you're here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Recibirán tu invitación por correo o SMS. Quienes ya usan cmux sabrán que estás aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elles reçoivent votre invitation par e-mail ou SMS. Celles déjà sur cmux apprennent que vous êtes là."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Riceveranno il tuo invito via email o SMS. Chi usa già cmux saprà che sei qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたからの招待がメールまたはテキストで届きます。すでに cmux を使っている人には、あなたが参加したことが伝わります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ពួកគេនឹងទទួលការអញ្ជើញរបស់អ្នកតាមអ៊ីមែល ឬ SMS។ អ្នកដែលប្រើ cmux រួចហើយនឹងដឹងថាអ្នកនៅទីនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이메일이나 문자로 초대를 받습니다. 이미 cmux를 사용하는 사람에게는 회원님이 합류했다고 알려 줍니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De får invitasjonen din på e-post eller SMS. De som allerede bruker cmux, får vite at du er her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otrzymają Twoje zaproszenie e-mailem lub SMS-em. Osoby, które już korzystają z cmux, dowiedzą się, że tu jesteś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elas recebem seu convite por e-mail ou SMS. Quem já usa o cmux fica sabendo que você está aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Они получат ваше приглашение по e-mail или SMS. Те, кто уже в cmux, узнают, что вы здесь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "พวกเขาจะได้รับคำเชิญจากคุณทางอีเมลหรือ SMS คนที่ใช้ cmux อยู่แล้วจะได้รู้ว่าคุณอยู่ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Davetinizi e-posta veya SMS ile alırlar. Zaten cmux kullananlara burada olduğunuz bildirilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вони отримають ваше запрошення email або SMS. Ті, хто вже в cmux, дізнаються, що ви тут."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Họ nhận lời mời của bạn qua email hoặc SMS. Người đã dùng cmux sẽ biết bạn đã ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "他们会通过电子邮件或短信收到你的邀请。已在使用 cmux 的人会收到你已加入的通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "他們會透過電子郵件或簡訊收到你的邀請。已在使用 cmux 的人會收到你已加入的通知。"
          }
        }
      }
    },
