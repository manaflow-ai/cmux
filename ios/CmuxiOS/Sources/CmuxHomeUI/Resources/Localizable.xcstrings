    "home.invite.defaultMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hey! I'm using cmux to run my coding agents from my phone. My Chief takes a task, runs agents on my machines, and messages me here when it needs me. Join me: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やあ！スマホから cmux でコーディングエージェントを動かしています。Chief がタスクを引き受けて自分のマシンでエージェントを動かし、必要なときはここでメッセージをくれます。一緒にやろう: %@"
          }
        }
      }
    },
    "home.invite.emailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
