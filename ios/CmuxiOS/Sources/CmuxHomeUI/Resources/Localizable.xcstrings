    "home.chief.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتولى Chief المهام، ويشغّل الوكلاء على أجهزتك، ويراسلك هنا. سمّه باسم العمل الذي يتولاه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief preuzima zadatke, pokreće agente na tvojim računarima i piše ti ovdje. Nazovi ga po poslu za koji je zadužen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En Chief tager opgaver, kører agenter på dine maskiner og skriver til dig her. Giv den navn efter det arbejde, den ejer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Chief übernimmt Aufgaben, lässt Agents auf deinen Rechnern laufen und schreibt dir hier. Benenne ihn nach seiner Aufgabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Chief takes tasks, runs agents on your machines and messages you here. Name it for the work it owns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un Chief toma tareas, ejecuta agentes en tus máquinas y te escribe aquí. Ponle un nombre según su trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un Chief prend des tâches, lance des agents sur vos machines et vous écrit ici. Nommez-le d’après son travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un Chief prende compiti, avvia agenti sulle tue macchine e ti scrive qui. Dagli il nome del lavoro di cui si occupa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief はタスクを引き受け、あなたのマシンでエージェントを動かし、ここでメッセージを送ります。担当する仕事にちなんだ名前を付けましょう。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief ទទួលការងារ ដំណើរការភ្នាក់ងារលើម៉ាស៊ីនរបស់អ្នក ហើយផ្ញើសារមកអ្នកនៅទីនេះ។ ដាក់ឈ្មោះតាមការងារដែលវាទទួលខុសត្រូវ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief는 작업을 맡아 회원님의 컴퓨터에서 에이전트를 실행하고 여기에서 메시지를 보냅니다. 맡은 일에 맞게 이름을 지어 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En Chief tar oppgaver, kjører agenter på maskinene dine og skriver til deg her. Gi den navn etter arbeidet den eier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief przejmuje zadania, uruchamia agentów na Twoich komputerach i pisze do Ciebie tutaj. Nazwij go od pracy, za którą odpowiada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um Chief pega tarefas, roda agentes nas suas máquinas e fala com você aqui. Dê a ele o nome do trabalho que cuida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief берёт задачи, запускает агентов на ваших машинах и пишет вам здесь. Назовите его по работе, за которую он отвечает."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief รับงาน รันเอเจนต์บนเครื่องของคุณ และส่งข้อความหาคุณที่นี่ ตั้งชื่อตามงานที่มันดูแล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief görevleri alır, makinelerinizde ajanları çalıştırır ve size buradan yazar. Ona üstlendiği işin adını verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief бере завдання, запускає агентів на ваших машинах і пише вам тут. Назвіть його за роботою, за яку він відповідає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief nhận việc, chạy agent trên máy của bạn và nhắn bạn tại đây. Đặt tên theo công việc mà nó phụ trách."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief 会接下任务，在你的电脑上运行代理，并在这里给你发消息。按它负责的工作来命名吧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief 會接下任務、在你的電腦上執行代理，並在這裡傳訊息給你。依它負責的工作命名吧。"
          }
        }
      }
    },
