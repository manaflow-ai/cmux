    "home.invite.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يدعو شخصًا إلى cmux عبر البريد الإلكتروني أو الرسائل النصية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poziva nekoga u cmux e-mailom ili SMS-om."
          }
        },
        "da": {
          "stringUnit": {
