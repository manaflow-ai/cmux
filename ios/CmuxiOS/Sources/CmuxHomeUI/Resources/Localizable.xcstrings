    "home.contacts.privacy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يرى cmux العنوان الذي تختاره فقط، وليس جهات اتصالك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux vidi samo adresu koju odabereš, ne tvoje kontakte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux ser kun den adresse, du vælger, ikke dine kontakter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux sieht nur die gewählte Adresse, nicht deine Kontakte."
