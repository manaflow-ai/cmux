    "home.invite.statusText": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يستخدم cmux بعد. ستُرسل الدعوة برسالة نصية."
          }
        },
        "bs": {
