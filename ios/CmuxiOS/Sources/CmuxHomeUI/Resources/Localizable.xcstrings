    "home.offline.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكنك قراءة الرسائل المحفوظة. يعود الإرسال والدعوات وإنشاء Chief جديد عندما يعيد cmux الاتصال."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Možeš čitati sačuvane poruke. Slanje, pozivnice i novi Chiefovi vraćaju se kad se cmux ponovo poveže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du kan læse gemte beskeder. Afsendelse, invitationer og nye Chiefs vender tilbage, når cmux forbinder igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gespeicherte Nachrichten kannst du lesen. Senden, Einladungen und neue Chiefs sind wieder da, sobald cmux verbunden ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can read saved messages. Sending, invites and new Chiefs come back when cmux reconnects."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puedes leer los mensajes guardados. Enviar, invitar y crear Chiefs vuelven cuando cmux se reconecte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous pouvez lire les messages enregistrés. L’envoi, les invitations et les nouveaux Chiefs reviennent quand cmux se reconnecte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puoi leggere i messaggi salvati. Invio, inviti e nuovi Chief tornano quando cmux si riconnette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのメッセージは読めます。送信、招待、新しい Chief は cmux が再接続すると使えるようになります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អ្នកអាចអានសារដែលបានរក្សាទុក។ ការផ្ញើ ការអញ្ជើញ និង Chief ថ្មីនឹងត្រឡប់មកវិញពេល cmux ភ្ជាប់ម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "저장된 메시지는 읽을 수 있습니다. 보내기, 초대, 새 Chief는 cmux가 다시 연결되면 사용할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du kan lese lagrede meldinger. Sending, invitasjoner og nye Chiefs kommer tilbake når cmux kobler til igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Możesz czytać zapisane wiadomości. Wysyłanie, zaproszenia i nowi Chiefowie wrócą, gdy cmux się połączy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você pode ler as mensagens salvas. Enviar, convidar e criar Chiefs voltam quando o cmux reconectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сохранённые сообщения можно читать. Отправка, приглашения и новые Chief вернутся, когда cmux подключится снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คุณอ่านข้อความที่บันทึกไว้ได้ การส่ง คำเชิญ และ Chief ใหม่จะกลับมาเมื่อ cmux เชื่อมต่ออีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kayıtlı mesajları okuyabilirsiniz. Gönderme, davetler ve yeni Chief’ler cmux yeniden bağlandığında geri gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Збережені повідомлення можна читати. Надсилання, запрошення й нові Chief повернуться, коли cmux знову підключиться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bạn có thể đọc tin nhắn đã lưu. Gửi tin, lời mời và Chief mới sẽ trở lại khi cmux kết nối lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你可以阅读已保存的消息。cmux 重新连接后即可发送消息、邀请和创建新 Chief。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你可以閱讀已儲存的訊息。cmux 重新連線後即可傳送訊息、邀請和建立新 Chief。"
          }
        }
      }
    },
