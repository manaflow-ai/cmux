        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux が受け取るのは選んだアドレスだけです。連絡先全体は見えません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux ឃើញតែអាសយដ្ឋានដែលអ្នកជ្រើស មិនមែនទំនាក់ទំនងរបស់អ្នកទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux는 선택한 주소만 볼 수 있으며 연락처 전체는 볼 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux ser bare adressen du velger, ikke kontaktene dine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux widzi tylko wybrany adres, a nie Twoje kontakty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cmux vê só o endereço escolhido, não seus contatos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux видит только выбранный адрес, а не ваши контакты."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux เห็นเฉพาะที่อยู่ที่คุณเลือก ไม่เห็นรายชื่อของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux yalnızca seçtiğiniz adresi görür, kişilerinizi görmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux бачить лише вибрану адресу, а не ваші контакти."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux chỉ thấy địa chỉ bạn chọn, không thấy danh bạ của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 只能看到你选择的地址，看不到你的通讯录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 只會看到你選擇的地址，看不到你的聯絡人。"
          }
        }
      }
    },
