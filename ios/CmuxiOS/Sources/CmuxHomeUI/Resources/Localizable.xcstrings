    "home.rejection.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "طلبات كثيرة جدًا. حاول مرة أخرى بعد قليل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Previše zahtjeva. Pokušaj ponovo za trenutak."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "For mange forespørgsler. Prøv igen om lidt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zu viele Anfragen. Versuche es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many requests. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Demasiadas solicitudes. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trop de requêtes. Réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Troppe richieste. Riprova tra un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストが多すぎます。少し待ってからもう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សំណើច្រើនពេក។ ព្យាយាមម្តងទៀតបន្តិចទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "요청이 너무 많습니다. 잠시 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "For mange forespørsler. Prøv igjen om litt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zbyt wiele żądań. Spróbuj za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Muitas solicitações. Tente de novo em instantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Слишком много запросов. Повторите чуть позже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "มีคำขอมากเกินไป ลองอีกครั้งในอีกสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Çok fazla istek. Biraz sonra tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Забагато запитів. Повторіть трохи згодом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quá nhiều yêu cầu. Hãy thử lại sau giây lát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
