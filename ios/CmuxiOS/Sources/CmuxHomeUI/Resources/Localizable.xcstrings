    "home.invite.invitationBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "راسل %@ وفريق Chief الخاص به، وهم الوكلاء الذين يكتبون الشيفرة على أجهزته ويرفعون التقارير هنا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Piši osobi %@ i njenim Chiefovima, agentima koji pišu kod na njenim računarima i javljaju se ovdje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skriv til %@ og deres Chiefs, agenterne der skriver kode på deres maskiner og rapporterer her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schreib %@ und seinen Chiefs, den Agents, die auf seinen Rechnern Code schreiben und hier berichten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message %@ and their Chiefs, the agents that write code on their machines and report back here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escribe a %@ y a sus Chiefs, los agentes que programan en sus máquinas e informan aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Écrivez à %@ et à ses Chiefs, les agents qui codent sur ses machines et rendent compte ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scrivi a %@ e ai suoi Chief, gli agenti che scrivono codice sulle sue macchine e riferiscono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ さんとその Chief にメッセージを送れます。Chief は相手のマシンでコードを書き、ここで報告するエージェントです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ញើសារទៅ %@ និង Chief របស់ពួកគេ ដែលជាភ្នាក់ងារសរសេរកូដលើម៉ាស៊ីនរបស់ពួកគេ ហើយរាយការណ៍នៅទីនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 님과 그 Chief에게 메시지를 보내 보세요. Chief는 그 사람의 컴퓨터에서 코드를 작성하고 여기에서 보고하는 에이전트입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skriv til %@ og deres Chiefs, agentene som skriver kode på maskinene deres og rapporterer her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pisz do %@ i jego Chiefów, agentów, którzy piszą kod na jego komputerach i raportują tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Converse com %@ e com os Chiefs dele, os agentes que programam nas máquinas dele e reportam aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пишите %@ и их Chief — агентам, которые пишут код на их машинах и отчитываются здесь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ส่งข้อความถึง %@ และ Chief ของพวกเขา ซึ่งเป็นเอเจนต์ที่เขียนโค้ดบนเครื่องของพวกเขาและรายงานที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ve onun Chief’leriyle, yani makinelerinde kod yazıp buraya rapor veren ajanlarla mesajlaşın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пишіть %@ та їхнім Chief — агентам, які пишуть код на їхніх машинах і звітують тут."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhắn tin với %@ và các Chief của họ, những agent viết code trên máy của họ và báo cáo tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "给 %@ 和他们的 Chief 发消息。Chief 是在他们的电脑上写代码并在这里汇报的代理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "傳訊息給 %@ 和他們的 Chief。Chief 是在他們的電腦上寫程式並在這裡回報的代理。"
          }
        }
      }
    },
