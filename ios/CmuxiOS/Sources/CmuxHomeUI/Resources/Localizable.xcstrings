    "home.invite.defaultMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مرحبًا! أستخدم cmux لتشغيل وكلاء البرمجة من هاتفي. يتولى Chief الخاص بي المهمة، ويشغّل الوكلاء على أجهزتي، ويراسلني هنا عندما يحتاجني. انضم إليّ: %@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hej! Preko cmux upravljam svojim agentima za kodiranje s telefona. Moj Chief preuzme zadatak, pokrene agente na mojim računarima i javi mi se ovdje kad me treba. Pridruži se: %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hej! Jeg styrer mine kodeagenter fra telefonen med cmux. Min Chief tager en opgave, kører agenter på mine maskiner og skriver til mig her, når den har brug for mig. Vær med: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hey! Ich steuere meine Coding-Agents mit cmux vom Handy aus. Mein Chief übernimmt eine Aufgabe, lässt Agents auf meinen Rechnern laufen und schreibt mir hier, wenn er mich braucht. Mach mit: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hey! I'm using cmux to run my coding agents from my phone. My Chief takes a task, runs agents on my machines, and messages me here when it needs me. Join me: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¡Hola! Uso cmux para manejar mis agentes de código desde el móvil. Mi Chief toma una tarea, ejecuta agentes en mis máquinas y me escribe aquí cuando me necesita. Únete: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salut ! J’utilise cmux pour piloter mes agents de code depuis mon téléphone. Mon Chief prend une tâche, lance des agents sur mes machines et m’écrit ici quand il a besoin de moi. Rejoins-moi : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ciao! Uso cmux per gestire i miei agenti di programmazione dal telefono. Il mio Chief prende un compito, avvia agenti sulle mie macchine e mi scrive qui quando ha bisogno di me. Unisciti: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やあ！スマホから cmux でコーディングエージェントを動かしています。Chief がタスクを引き受けて自分のマシンでエージェントを動かし、必要なときはここでメッセージをくれます。一緒にやろう: %@"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សួស្តី! ខ្ញុំប្រើ cmux ដើម្បីបញ្ជាភ្នាក់ងារសរសេរកូដពីទូរសព្ទ។ Chief របស់ខ្ញុំទទួលការងារ ដំណើរការភ្នាក់ងារលើម៉ាស៊ីនរបស់ខ្ញុំ ហើយផ្ញើសារមកខ្ញុំនៅទីនេះពេលត្រូវការខ្ញុំ។ ចូលរួមជាមួយខ្ញុំ៖ %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "안녕! 요즘 cmux로 휴대폰에서 코딩 에이전트를 돌리고 있어. 내 Chief가 작업을 맡아서 내 컴퓨터에서 에이전트를 실행하고, 내가 필요하면 여기로 메시지를 보내 줘. 같이 하자: %@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hei! Jeg styrer kodeagentene mine fra mobilen med cmux. Chiefen min tar en oppgave, kjører agenter på maskinene mine og skriver til meg her når den trenger meg. Bli med: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cześć! Steruję swoimi agentami kodującymi z telefonu przez cmux. Mój Chief bierze zadanie, uruchamia agentów na moich komputerach i pisze do mnie tutaj, gdy mnie potrzebuje. Dołącz: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oi! Uso o cmux para comandar meus agentes de código pelo celular. Meu Chief pega uma tarefa, roda agentes nas minhas máquinas e me chama aqui quando precisa de mim. Vem também: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Привет! Я управляю своими агентами для кода с телефона через cmux. Мой Chief берёт задачу, запускает агентов на моих машинах и пишет мне сюда, когда я нужен. Присоединяйся: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หวัดดี! เราใช้ cmux สั่งเอเจนต์เขียนโค้ดจากมือถือ Chief ของเรารับงาน รันเอเจนต์บนเครื่องของเรา แล้วส่งข้อความมาที่นี่เมื่อต้องการเรา มาร่วมกันนะ: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Selam! Kodlama ajanlarımı telefonumdan cmux ile yönetiyorum. Chief’im bir görevi alıyor, makinelerimde ajanları çalıştırıyor ve bana ihtiyacı olduğunda buradan yazıyor. Sen de katıl: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Привіт! Я керую своїми агентами для коду з телефона через cmux. Мій Chief бере завдання, запускає агентів на моїх машинах і пише мені сюди, коли я потрібен. Приєднуйся: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chào bạn! Mình đang dùng cmux để điều khiển các agent viết code từ điện thoại. Chief của mình nhận việc, chạy agent trên máy của mình và nhắn mình ở đây khi cần. Tham gia cùng mình nhé: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "嗨！我在用 cmux 从手机上指挥我的编程代理。我的 Chief 会接下任务，在我的电脑上运行代理，需要我时就在这里给我发消息。一起来吧：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "嗨！我用 cmux 在手機上指揮我的程式代理。我的 Chief 會接下任務、在我的電腦上執行代理，需要我時就在這裡傳訊息給我。一起來吧：%@"
          }
        }
      }
    },
