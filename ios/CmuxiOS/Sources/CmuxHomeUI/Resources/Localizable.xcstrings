    "home.rejection.indeterminate": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "انقطع الاتصال. سيتحقق cmux مرة أخرى عند إعادة الاتصال."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Veza je prekinuta. cmux će ponovo provjeriti kad se poveže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Forbindelsen blev afbrudt. cmux tjekker igen, når den forbinder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Verbindung wurde unterbrochen. cmux prüft es erneut, sobald die Verbindung steht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection dropped. cmux will check again when it reconnects."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se perdió la conexión. cmux volverá a comprobarlo al reconectarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La connexion a été coupée. cmux vérifiera à nouveau à la reconnexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La connessione si è interrotta. cmux verificherà di nuovo alla riconnessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が切れました。再接続したときに cmux がもう一度確認します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការតភ្ជាប់បានដាច់។ cmux នឹងពិនិត្យម្តងទៀតពេលភ្ជាប់វិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "연결이 끊어졌습니다. 다시 연결되면 cmux가 다시 확인합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tilkoblingen ble brutt. cmux sjekker igjen når den kobler til."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Połączenie zostało przerwane. cmux sprawdzi to ponownie po połączeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A conexão caiu. O cmux vai verificar de novo ao reconectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Соединение прервалось. cmux проверит снова после подключения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การเชื่อมต่อขาดหาย cmux จะตรวจสอบอีกครั้งเมื่อเชื่อมต่อใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bağlantı koptu. cmux yeniden bağlandığında tekrar kontrol eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "З’єднання перервалося. cmux перевірить знову після підключення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mất kết nối. cmux sẽ kiểm tra lại khi kết nối lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "连接已断开。cmux 重新连接后会再次检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "連線已中斷。cmux 重新連線後會再次檢查。"
          }
        }
      }
    },
    "home.rejection.invalid": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّر على cmux قبول ذلك. تحقق منه وحاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux to nije mogao prihvatiti. Provjeri i pokušaj ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux kunne ikke acceptere det. Tjek det, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux konnte das nicht annehmen. Prüfe es und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux couldn't accept that. Check it and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux no pudo aceptarlo. Revísalo y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux n’a pas pu accepter cela. Vérifiez et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux non ha potuto accettarlo. Controlla e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux はその内容を受け付けられませんでした。確認してもう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux មិនអាចទទួលយកវាបានទេ។ ពិនិត្យ ហើយព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux가 해당 내용을 받을 수 없습니다. 확인 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux kunne ikke godta det. Sjekk og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux nie mógł tego przyjąć. Sprawdź i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cmux não pôde aceitar isso. Confira e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux не смог это принять. Проверьте и повторите."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux รับรายการนั้นไม่ได้ ตรวจสอบแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux bunu kabul edemedi. Kontrol edip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux не зміг це прийняти. Перевірте й повторіть."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux không chấp nhận được nội dung đó. Hãy kiểm tra và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 无法接受该内容。请检查后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 無法接受該內容。請檢查後再試一次。"
