        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Offline. Szkic zostaje tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sem conexão. Seu rascunho fica aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Нет сети. Черновик останется здесь."
          }
