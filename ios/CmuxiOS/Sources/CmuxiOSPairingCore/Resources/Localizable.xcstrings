{
  "sourceLanguage": "en",
  "strings": {
    "pairing.device.guest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）"
          }
        }
      }
    },
    "pairing.device.this": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhone"
          }
        }
      }
    },
    "pairing.error.cannot_rename": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only your own devices can be renamed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を変更できるのは自分のデバイスだけです。"
          }
        }
      }
    },
    "pairing.error.declined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac's owner declined this iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macの所有者がこのiPhoneを拒否しました。"
          }
        }
      }
    },
    "pairing.error.invalid_link": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This pairing code is damaged. Show a new code on your Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このペアリングコードは読み取れません。Macで新しいコードを表示してください。"
          }
        }
      }
    },
    "pairing.error.key_mismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code does not match the Mac's key. Scan the code shown in cmux on that Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードはMacの鍵と一致しません。そのMacのcmuxに表示されたコードをスキャンしてください。"
          }
        }
      }
    },
    "pairing.error.not_link": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not a cmux pairing code."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはcmuxのペアリングコードではありません。"
          }
        }
      }
    },
    "pairing.error.offer_unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This pairing code expired. Show a new code on your Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このペアリングコードは期限切れです。Macで新しいコードを表示してください。"
          }
        }
      }
    },
    "pairing.error.offer_used": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This pairing code was already used. Show a new code on your Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このペアリングコードはすでに使用されています。Macで新しいコードを表示してください。"
          }
        }
      }
    },
    "pairing.error.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're offline. Connect to the internet and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインです。インターネットに接続してもう一度お試しください。"
          }
        }
      }
    },
    "pairing.error.refused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing failed: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングに失敗しました: %@"
          }
        }
      }
    },
    "pairing.error.unknown_device": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That device is no longer on your account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのデバイスはもうアカウントにありません。"
          }
        }
      }
    },
    "pairing.error.update_required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This pairing code needs a newer version of cmux. Update the app and scan again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このペアリングコードには新しいバージョンのcmuxが必要です。アプリをアップデートしてもう一度スキャンしてください。"
          }
        }
      }
    },
    "pairing.status.paired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paired with %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@とペアリングしました。"
          }
        }
      }
    },
    "pairing.status.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the Mac's owner to accept this iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macの所有者がこのiPhoneを承認するのを待っています。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
