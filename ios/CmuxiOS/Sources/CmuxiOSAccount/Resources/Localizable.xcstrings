          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il tuo account non è stato eliminato. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アカウントは削除されませんでした。再試行してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គណនីរបស់អ្នកមិនត្រូវបានលុបទេ។ ព្យាយាមម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "계정이 삭제되지 않았습니다. 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kontoen ble ikke slettet. Prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konto nie zostało usunięte. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sua conta não foi apagada. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Аккаунт не удалён. Повторите попытку."
          }
        },
