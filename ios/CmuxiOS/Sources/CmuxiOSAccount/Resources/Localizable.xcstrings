    "account.delete.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سيتم حذف حسابك وأجهزة Cloud والأسرار المحفوظة والاشتراك، وسيتم تسجيل خروجك من كل مكان. لا يمكن التراجع عن ذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vaš račun, Cloud mašine, sačuvane tajne i pretplata se brišu, a vi ste odjavljeni svuda. Ovo se ne može poništiti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Din konto, Cloud-maskiner, gemte hemmeligheder og abonnement slettes, og du logges ud overalt. Det kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Konto, deine Cloud-Maschinen, gespeicherten Secrets und dein Abo werden gelöscht, und du wirst überall abgemeldet. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account, Cloud machines, saved secrets and subscription are deleted, and you're signed out everywhere. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se eliminan tu cuenta, tus máquinas de Cloud, tus secretos guardados y tu suscripción, y se cierra tu sesión en todas partes. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre compte, vos machines Cloud, vos secrets enregistrés et votre abonnement sont supprimés, et vous êtes déconnecté partout. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il tuo account, le macchine Cloud, i segreti salvati e l'abbonamento vengono eliminati e verrai disconnesso ovunque. L'operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アカウント、Cloud マシン、保存したシークレット、サブスクリプションが削除され、すべての場所でサインアウトされます。この操作は取り消せません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គណនី ម៉ាស៊ីន Cloud អាថ៌កំបាំងដែលបានរក្សាទុក និងការជាវរបស់អ្នកត្រូវបានលុប ហើយអ្នកត្រូវបានចេញពីគ្រប់កន្លែង។ មិនអាចត្រឡប់វិញបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "계정, Cloud 머신, 저장된 시크릿과 구독이 삭제되고 모든 곳에서 로그아웃됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kontoen, Cloud-maskinene, lagrede hemmeligheter og abonnementet slettes, og du logges ut overalt. Dette kan ikke angres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Twoje konto, maszyny Cloud, zapisane sekrety i subskrypcja zostaną usunięte, a Ty zostaniesz wylogowany wszędzie. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sua conta, máquinas do Cloud, segredos salvos e assinatura são apagados, e você sai em todos os lugares. Isso não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ваш аккаунт, машины Cloud, сохранённые секреты и подписка будут удалены, и вы выйдете на всех устройствах. Это нельзя отменить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "บัญชี เครื่อง Cloud ข้อมูลลับที่บันทึกไว้ และการสมัครใช้งานของคุณจะถูกลบ และคุณจะออกจากระบบทุกที่ ไม่สามารถเลิกทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hesabınız, Cloud makineleriniz, kayıtlı gizli bilgileriniz ve aboneliğiniz silinir ve her yerden çıkış yapılır. Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ваш обліковий запис, машини Cloud, збережені секрети й підписку буде видалено, а ви вийдете на всіх пристроях. Це не можна скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tài khoản, máy Cloud, bí mật đã lưu và gói đăng ký của bạn sẽ bị xóa, và bạn sẽ bị đăng xuất ở mọi nơi. Không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的账户、Cloud 机器、已保存的密钥和订阅将被删除，并在所有设备上退出登录。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的帳號、Cloud 機器、已儲存的密鑰和訂閱將被刪除，並在所有裝置上登出。此動作無法復原。"
          }
        }
      }
    },
