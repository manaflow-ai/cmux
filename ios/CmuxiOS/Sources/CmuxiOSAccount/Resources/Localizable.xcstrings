    "account.delete.failed.offline": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أنت غير متصل. اتصل وحاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niste na mreži. Povežite se i pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du er offline. Opret forbindelse, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du bist offline. Verbinde dich und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're offline. Connect and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No tienes conexión. Conéctate y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous êtes hors ligne. Connectez-vous et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sei offline. Connettiti e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "オフラインです。接続してから再試行してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អ្នកកំពុងគ្មានអ៊ីនធឺណិត។ ភ្ជាប់ ហើយព្យាយាមម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "오프라인 상태입니다. 연결한 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du er frakoblet. Koble til og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jesteś offline. Połącz się i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você está offline. Conecte-se e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Нет подключения. Подключитесь и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คุณออฟไลน์อยู่ เชื่อมต่อแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Çevrimdışısınız. Bağlanıp tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Немає з'єднання. Під'єднайтеся й спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bạn đang ngoại tuyến. Hãy kết nối và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你已离线。请连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你已離線。請連線後再試一次。"
          }
        }
      }
    },
    "account.delete.failed.refused": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يُحذف حسابك. حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vaš račun nije izbrisan. Pokušajte ponovo."
          }
        },
        "da": {
