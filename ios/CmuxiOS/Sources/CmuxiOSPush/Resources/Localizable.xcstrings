    "approve.signedFooter": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Allow asks for Face ID, Touch ID or your passcode. Your Mac accepts an allow from this phone only when this phone signs it."
          }
        },
