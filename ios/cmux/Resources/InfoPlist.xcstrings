{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-Kopplungs-QR-Codes vom Mac-Terminal scannen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan cmux pairing QR codes from your Mac terminal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanear códigos QR de emparejamiento de cmux desde tu terminal Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez les QR de jumelage cmux depuis votre terminal Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona i QR code di abbinamento cmux dal terminale del tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac のターミナルに表示された cmux のペアリング QR コードをスキャンします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 터미널에서 cmux 페어링 QR 코드를 스캔합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan cmux-koppel-QR-codes van je Mac-terminal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanuj kody QR parowania cmux z terminala Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanear QR codes de pareamento do cmux a partir do seu terminal Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирование QR-кодов сопряжения cmux с вашего Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac terminalinizden cmux eşleştirme QR kodlarını tarayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描 Mac 终端上的 cmux 配对二维码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描來自 Mac 終端機的 cmux 配對 QR 碼。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux verwendet Face ID, um zu bestätigen, dass du den Schutz für Nachrichten an Chief verringern möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux uses Face ID to confirm that you want to lower the protection for texts to Chief."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux usa Face ID para confirmar que quieres reducir la protección de los mensajes a Chief."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux utilise Face ID pour confirmer que vous souhaitez réduire la protection des messages envoyés à Chief."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux usa Face ID per confermare che vuoi ridurre la protezione dei messaggi a Chief."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief へのテキストの保護を下げることを確認するために、cmux は Face ID を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux는 Chief에게 보내는 메시지의 보호 수준을 낮추려는 것을 확인하기 위해 Face ID를 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux gebruikt Face ID om te bevestigen dat je de beveiliging van berichten aan Chief wilt verlagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux używa Face ID, aby potwierdzić, że chcesz obniżyć ochronę wiadomości do Chief."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux usa o Face ID para confirmar que você quer reduzir a proteção das mensagens para o Chief."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux использует Face ID, чтобы подтвердить, что вы хотите снизить защиту сообщений для Chief."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux, Chief'e gönderilen mesajların korumasını düşürmek istediğinizi onaylamak için Face ID kullanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 使用面容 ID 来确认你要降低发送给 Chief 的消息的保护级别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 使用 Face ID 來確認你要降低傳送給 Chief 的訊息的保護等級。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung zum Mac im lokalen Netzwerk für cmux-Mobile-Kopplung und Terminal-Sync herstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to your Mac on the local network for cmux mobile pairing and terminal sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectarse a tu Mac en la red local para el emparejamiento móvil de cmux y la sincronización del terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à votre Mac sur le réseau local pour le jumelage mobile cmux et la synchronisation du terminal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connettiti al tuo Mac sulla rete locale per l'abbinamento mobile cmux e la sincronizzazione del terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux モバイルのペアリングとターミナル同期のため、ローカルネットワーク上の Mac に接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 모바일 페어링 및 터미널 동기화를 위해 로컬 네트워크의 Mac에 연결합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinding maken met je Mac op het lokale netwerk voor cmux-mobiel koppelen en terminalsynchronisatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz się z Macem w sieci lokalnej w celu parowania mobilnego cmux i synchronizacji terminala."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectar ao seu Mac na rede local para pareamento móvel e sincronização de terminal do cmux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение к Mac в локальной сети для мобильного сопряжения и синхронизации терминала cmux."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux mobil eşleştirme ve terminal senkronizasyonu için yerel ağdaki Mac'inize bağlanın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过本地网络连接到您的 Mac，用于 cmux 移动端配对和终端同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過區域網路連線至您的 Mac，以進行 cmux 行動裝置配對和終端機同步。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nimmt deine Stimme für Nachrichten, Sprachnotizen und Anrufe an deinen Chief auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record your voice for messages, voice notes and calls to your Chief."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Graba tu voz para mensajes, notas de voz y llamadas a tu Chief."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enregistre votre voix pour les messages, notes vocales et appels à votre Chief."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Registra la tua voce per messaggi, note vocali e chiamate al tuo Chief."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージ、ボイスメモ、Chief との通話のために音声を録音します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "메시지, 음성 메모, Chief와의 통화를 위해 음성을 녹음합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neemt je stem op voor berichten, spraaknotities en gesprekken met je Chief."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nagrywa Twój głos do wiadomości, notatek głosowych i rozmów z Chiefem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Grava sua voz para mensagens, notas de voz e chamadas com seu Chief."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Записывает ваш голос для сообщений, голосовых заметок и звонков Chief."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mesajlar, sesli notlar ve Chief aramaları için sesinizi kaydeder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "录制你的声音，用于消息、语音备忘和与 Chief 通话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "錄製你的聲音，用於訊息、語音備忘和與 Chief 通話。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos anhängen, um sie an den Terminal-Agenten zu senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach photos to send to your terminal agent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjuntar fotos para enviar al agente de tu terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joignez des photos à envoyer à votre agent de terminal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allega foto da inviare all'agente del terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルのエージェントに送信する写真を添付します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 에이전트에게 전송할 사진을 첨부합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto's bijvoegen om naar je terminalagent te sturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dołączaj zdjęcia do wysyłania do agenta terminala."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anexar fotos para enviar ao seu agente de terminal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прикрепление фотографий для отправки агенту в терминале."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal ajanınıza göndermek için fotoğraf ekleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附加照片发送给终端 agent。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附加照片以傳送至您的終端機代理。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transkribiert deine Sprache auf diesem iPhone in Nachrichten und Sprachnotizen für deinen Chief."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribe your speech on this iPhone into messages and voice notes for your Chief."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transcribe tu voz en este iPhone en mensajes y notas de voz para tu Chief."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transcrit votre parole sur cet iPhone en messages et notes vocales pour votre Chief."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trascrive la tua voce su questo iPhone in messaggi e note vocali per il tuo Chief."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone 上で音声を文字起こしし、メッセージや Chief へのボイスメモにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 iPhone에서 음성을 받아써 메시지와 Chief에게 보낼 음성 메모로 만듭니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zet je spraak op deze iPhone om in berichten en spraaknotities voor je Chief."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transkrybuje Twoją mowę na tym iPhonie na wiadomości i notatki głosowe dla Chiefa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transcreve sua fala neste iPhone em mensagens e notas de voz para seu Chief."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Расшифровывает вашу речь на этом iPhone в сообщения и голосовые заметки для Chief."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konuşmanızı bu iPhone’da mesajlara ve Chief için sesli notlara dönüştürür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在这台 iPhone 上将你的语音转写为消息和给 Chief 的语音备忘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在這支 iPhone 上將你的語音轉寫為訊息和給 Chief 的語音備忘。"
          }
        }
      }
    }
  },
  "version": "1.0"
}