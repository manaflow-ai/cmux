    "mobile.settings.keepMacAwake.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't confirm the change on your Mac. Check the connection and retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macで変更を確認できませんでした。接続を確認して再試行してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderung konnte auf Ihrem Mac nicht bestätigt werden. Überprüfen Sie die Verbindung und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de confirmer la modification sur votre Mac. Vérifiez la connexion et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تأكيد التغيير على جهاز Mac الخاص بك. تحقق من الاتصال وأعد المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar el cambio en tu Mac. Verifique la conexión y vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法在您的 Mac 上確認變更。檢查連接並重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在您的 Mac 上确认更改。检查连接并重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 변경사항을 확인할 수 없습니다. 연결을 확인하고 다시 시도하세요."
          }
        }
      }
    },
    "mobile.settings.keepMacAwake.loadFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load the Mac's Keep Mac Awake status. Check the connection and retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macの「Macをスリープさせない」の状態を読み込めませんでした。接続を確認して再試行してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Keep Mac Awake-Status des Mac konnte nicht geladen werden. Überprüfen Sie die Verbindung und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger l'état Keep Mac Awake du Mac. Vérifiez la connexion et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحميل حالة Keep Mac Awake الخاصة بجهاز Mac. تحقق من الاتصال وأعد المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar el estado Mantener Mac despierto de la Mac. Verifique la conexión y vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入 Mac 的「保持 Mac 喚醒」狀態。檢查連接並重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载 Mac 的“保持 Mac 唤醒”状态。检查连接并重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 Keep Mac Awake 상태를 로드할 수 없습니다. 연결을 확인하고 다시 시도하세요."
          }
        }
      }
    },
    "mobile.settings.keepMacAwake.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevents this Mac from sleeping while cmux is open. Its display can still turn off."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmuxが開いている間、このMacがスリープするのを防ぎます。ディスプレイはオフにできます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert, dass dieser Mac in den Ruhezustand wechselt, während cmux geöffnet ist. Das Display kann sich immer noch ausschalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche ce Mac de dormir lorsque cmux est ouvert. Son affichage peut encore s'éteindre."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمنع جهاز Mac هذا من النوم أثناء فتح cmux. لا يزال من الممكن إيقاف تشغيل شاشة العرض الخاصة به."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita que esta Mac entre en suspensión mientras cmux está abierto. Su pantalla aún puede apagarse."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "防止此 Mac 在 cmux 開啟時進入睡眠狀態。它的顯示器仍然可以關閉。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防止此 Mac 在 cmux 打开时进入睡眠状态。它的显示屏仍然可以关闭。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 열려 있는 동안 이 Mac이 잠자기 상태가 되는 것을 방지합니다. 디스플레이가 여전히 꺼질 수 있습니다."
          }
        }
      }
    },
    "mobile.settings.keepMacAwake.updateRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update cmux on this Mac to control Keep Mac Awake from iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneから「Macをスリープさせない」を操作するには、このMacのcmuxをアップデートしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren Sie cmux auf diesem Mac, um Keep Mac Awake vom iPhone aus zu steuern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour cmux sur ce Mac pour contrôler Keep Mac Awake depuis l'iPhone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتحديث cmux على جهاز Mac هذا للتحكم في Keep Mac Awake من iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualice cmux en esta Mac para controlar Keep Mac Awake desde iPhone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新此 Mac 上的 cmux 以控制使 Mac 從 iPhone 中保持喚醒狀態。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新此 Mac 上的 cmux 以控制使 Mac 从 iPhone 中保持唤醒状态。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 Keep Mac Awake를 제어하려면 이 Mac에서 cmux를 업데이트하세요."
          }
        }
      }
    },
