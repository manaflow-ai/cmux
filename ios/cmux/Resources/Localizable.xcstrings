    "mobile.taskComposer.directoryPicker.search.coverage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search checks the Mac’s indexed folders and scans its home folder live. Browse to reach restricted locations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索はMacのインデックス済みフォルダを確認し、ホームフォルダを直接スキャンします。制限された場所にはブラウズで移動してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche überprüft die indizierten Ordner des Mac und scannt seinen Home-Ordner live. Durchsuchen Sie, um eingeschränkte Standorte zu erreichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche vérifie les dossiers indexés du Mac et analyse son dossier de départ en direct. Parcourez pour atteindre des emplacements restreints."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحقق البحث من المجلدات المفهرسة لجهاز Mac ويفحص المجلد الرئيسي الخاص به مباشرة. تصفح للوصول إلى المواقع المحظورة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda comprueba las carpetas indexadas de Mac y escanea su carpeta de inicio en vivo. Navega para llegar a ubicaciones restringidas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋會檢查 Mac 的索引資料夾並即時掃描其主資料夾。瀏覽以到達受限位置。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索会检查 Mac 的索引文件夹并实时扫描其主文件夹。浏览以到达受限位置。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색은 Mac의 색인 폴더를 확인하고 홈 폴더를 실시간으로 검색합니다. 제한된 위치에 도달하려면 탐색하세요."
          }
        }
      }
    },
    "mobile.taskComposer.directoryPicker.search.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing matched in the Mac’s index or home folder. Browse to look elsewhere, and check that cmux on the Mac can access its files."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのインデックスにもホームフォルダにも一致するものはありませんでした。他の場所はブラウズで探し、Mac上のcmuxにファイルへのアクセス権があるか確認してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Index oder Home-Ordner des Mac stimmte nichts überein. Suchen Sie woanders nach und prüfen Sie, ob cmux auf dem Mac auf seine Dateien zugreifen kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne correspond dans l'index ou le dossier de départ du Mac. Parcourez pour chercher ailleurs et vérifiez que cmux sur Mac peut accéder à ses fichiers."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد شيء مطابق في فهرس Mac أو المجلد الرئيسي. استعرض للبحث في مكان آخر، وتأكد من أن cmux الموجود على جهاز Mac يمكنه الوصول إلى ملفاته."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada que coincida en el índice o en la carpeta de inicio de Mac. Navegue para buscar en otra parte y verifique que cmux en Mac pueda acceder a sus archivos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 的索引或主資料夾中沒有任何符合的內容。瀏覽到其他地方，並檢查 Mac 上的 cmux 是否可以存取其檔案。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 的索引或主文件夹中没有任何匹配的内容。浏览到其他地方，并检查 Mac 上的 cmux 是否可以访问其文件。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 색인이나 홈 폴더에 일치하는 항목이 없습니다. 다른 곳을 찾아서 Mac의 cmux가 해당 파일에 액세스할 수 있는지 확인하세요."
          }
        }
      }
    },
