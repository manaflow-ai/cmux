    "mobile.connections.direct.addMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A numeric IP where this computer is reachable, like 192.168.1.20 or 192.168.1.20:64000. Without a port, the Mac's advertised port is used."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンピュータに到達できる数値IPアドレスを入力します（例: 192.168.1.20、192.168.1.20:64000）。ホスト名は使用できません。ポート未指定の場合はMacが公開しているポートを使用します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine numerische IP, unter der dieser Computer erreichbar ist, z. B. 192.168.1.20 oder 192.168.1.20:64000. Ohne Port wird der beworbene Port des Mac verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une adresse IP numérique à laquelle cet ordinateur est accessible, comme 192.168.1.20 ou 192.168.1.20:64000. Sans port, le port annoncé du Mac est utilisé."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان IP رقمي حيث يمكن الوصول إلى هذا الكمبيوتر، مثل 192.168.1.20 أو 192.168.1.20:64000. بدون منفذ، يتم استخدام المنفذ المعلن عنه لجهاز Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una IP numérica donde se puede acceder a esta computadora, como 192.168.1.20 o 192.168.1.20:64000. Sin un puerto, se utiliza el puerto anunciado de Mac."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可存取此電腦的數位 IP，例如 192.168.1.20 或 192.168.1.20:64000。如果沒有端口，則使用 Mac 公佈的端口。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可访问此计算机的数字 IP，例如 192.168.1.20 或 192.168.1.20:64000。如果没有端口，则使用 Mac 公布的端口。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 컴퓨터에 연결할 수 있는 숫자 IP(예: 192.168.1.20 또는 192.168.1.20:64000) 포트가 없으면 Mac의 알려진 포트가 사용됩니다."
          }
        }
      }
    },
