    "mobile.shortcuts.chat.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which compatible terminal buttons appear on both the chat and terminal keyboard bars. Changes here also update the terminal keyboard bar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットとターミナル両方のキーボードバーに表示する互換性のあるターミナルボタンを選びます。ここでの変更はターミナルのキーボードバーにも反映されます。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "选择哪些兼容的终端按钮同时显示在聊天和终端的键盘工具栏上。此处的更改也会更新终端键盘工具栏。"
        }
      }}
    },
    "mobile.shortcuts.chat.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared Shortcuts"
          }
        },
        "ja": {
