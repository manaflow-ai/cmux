    "mobile.settings.connectionMethod.tailscaleFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works with cmux 0.64.17 or later on your Mac. Install Tailscale on both devices, join the same network, then scan the Mac's pairing code once. cmux stays disconnected until that local authorization exists."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac版cmux 0.64.17以降で動作します。両方のデバイスにTailscaleをインストールして同じネットワークに参加し、Macのペアリングコードを一度スキャンしてください。そのローカル承認が完了するまでcmuxは未接続のままになります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert mit cmux 0.64.17 oder höher auf Ihrem Mac. Installieren Sie Tailscale auf beiden Geräten, verbinden Sie sich mit demselben Netzwerk und scannen Sie dann einmal den Pairing-Code des Mac. cmux bleibt getrennt, bis diese lokale Autorisierung vorhanden ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Works with cmux 0.64.17 or later on your Mac. Install Tailscale on both devices, join the same network, then scan the Mac's pairing code once. cmux stays disconnected until that local authorization exists."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Works with cmux 0.64.17 or later on your Mac. Install Tailscale on both devices, join the same network, then scan the Mac's pairing code once. cmux stays disconnected until that local authorization exists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Works with cmux 0.64.17 or later on your Mac. Install Tailscale on both devices, join the same network, then scan the Mac's pairing code once. cmux stays disconnected until that local authorization exists."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Works with cmux 0.64.17 or later on your Mac. Install Tailscale on both devices, join the same network, then scan the Mac's pairing code once. cmux stays disconnected until that local authorization exists."
          }
        },
        "zh-Hans": {
