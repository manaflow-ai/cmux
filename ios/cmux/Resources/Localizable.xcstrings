    "mobile.iroh.custom.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Addresses sync with your account. Provider secrets stay in this device's Keychain. A missing secret never enables another relay provider."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスはアカウントと同期されます。プロバイダーのシークレットはこのデバイスのキーチェーンに保存されます。シークレットがない場合に別のリレープロバイダーが有効になることはありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Adressen werden mit Ihrem Konto synchronisiert. Die Geheimnisse des Anbieters bleiben im Schlüsselbund dieses Geräts. Ein fehlendes Geheimnis aktiviert niemals einen anderen Relay-Anbieter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Addresses sync with your account. Provider secrets stay in this device's Keychain. A missing secret never enables another relay provider."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Addresses sync with your account. Provider secrets stay in this device's Keychain. A missing secret never enables another relay provider."
