          }
        }
      }
    },
    "mobile.pairing.hostUnreachableFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach %@:%d. Make sure your Mac is awake and the private network or LAN for this saved route is active."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%d に接続できません。Macが起動していて、この保存済み経路のプライベートネットワークまたはLANが有効か確認してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%d kann nicht erreicht werden. Stellen Sie sicher, dass Ihr Mac aktiv ist und das private Netzwerk oder LAN für diese gespeicherte Route aktiv ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'accéder à %@:%d. Assurez-vous que votre Mac est éveillé et que le réseau privé ou LAN de cet itinéraire enregistré est actif."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن الوصول إلى %@:%d. تأكد من أن جهاز Mac الخاص بك نشط وأن الشبكة الخاصة أو الشبكة المحلية (LAN) لهذا المسار المحفوظ نشطة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder a %@:%d. Asegúrese de que su Mac esté activa y que la red privada o LAN para esta ruta guardada esté activa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法到達 %@:%d。確保您的 Mac 處於喚醒狀態，並且此已儲存路線的專用網路或 LAN 處於活動狀態。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法到达 %@:%d。确保您的 Mac 处于唤醒状态，并且此已保存路线的专用网络或 LAN 处于活动状态。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%d에 연결할 수 없습니다. Mac이 깨어 있고 이 저장된 경로에 대한 개인 네트워크 또는 LAN이 활성화되어 있는지 확인하십시오."
          }
        }
      }
    },
    "mobile.pairing.invalidCode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This isn't a cmux pairing QR. On cmux 0.64.17, scan the Pair iPhone code. On newer versions, scan the code in Tailscale Pairing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはcmuxのペアリングQRコードではありません。cmux 0.64.17では「Pair iPhone」のコードをスキャンします。新しいバージョンでは「Tailscale Pairing」のコードをスキャンしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist kein Cmux-Pairing-QR. Scannen Sie auf cmux 0.64.17 den Pair iPhone-Code. Scannen Sie bei neueren Versionen den Code in Tailscale Pairing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas un QR d'appariement cmux. Sur cmux 0.64.17, scannez le code Pair iPhone. Sur les versions plus récentes, scannez le code dans Tailscale Pairing."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا ليس QR الاقتران cmux. في cmux 0.64.17، قم بمسح رمز Pair iPhone. في الإصدارات الأحدث، قم بمسح الرمز ضوئيًا في Tailscale Pairing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este no es un QR de emparejamiento de cmux. En cmux 0.64.17, escanee el código de emparejamiento de iPhone. En versiones más recientes, escanee el código en Tailscale Pairing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不是 cmux 配對二維碼。在 cmux 0.64.17 上，掃描配對 iPhone 代碼。在較新版本上，掃描 Tailscale 配對中的程式碼。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是 cmux 配对二维码。在 cmux 0.64.17 上，扫描配对 iPhone 代码。在较新版本上，扫描 Tailscale 配对中的代码。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 cmux 페어링 QR이 아닙니다. cmux 0.64.17에서 iPhone 페어링 코드를 스캔하세요. 최신 버전에서는 Tailscale 페어링에서 코드를 스캔하세요."
          }
        }
      }
    },
    "mobile.pairing.localNetworkPermission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS blocked the connection. Allow cmux to use the Local Network in iOS Settings, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSが接続をブロックしました。iOSの設定でcmuxにローカルネットワークの使用を許可してから、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS hat die Verbindung blockiert. Erlauben Sie cmux in den iOS-Einstellungen, das lokale Netzwerk zu verwenden, und versuchen Sie es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS a bloqué la connexion. Autorisez cmux à utiliser le réseau local dans les paramètres iOS, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قام iOS بحظر الاتصال. اسمح لـ cmux باستخدام الشبكة المحلية في إعدادات iOS، ثم حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS bloqueó la conexión. Permita que cmux use la red local en la configuración de iOS y luego inténtelo nuevamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 阻止了連線。在 iOS 設定中允許 cmux 使用本機網絡，然後再試一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 阻止了连接。在 iOS 设置中允许 cmux 使用本地网络，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 연결을 차단했습니다. cmux가 iOS 설정에서 로컬 네트워크를 사용하도록 허용한 후 다시 시도하세요."
          }
        }
      }
    },
    "mobile.pairing.macUpdateRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update cmux on this Mac to connect securely."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全に接続するには、このMacのcmuxをアップデートしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren Sie cmux auf diesem Mac, um eine sichere Verbindung herzustellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour cmux sur ce Mac pour vous connecter en toute sécurité."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتحديث cmux على جهاز Mac هذا للاتصال بشكل آمن."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualice cmux en esta Mac para conectarse de forma segura."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新此 Mac 上的 cmux 以安全連線。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新此 Mac 上的 cmux 以安全连接。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전하게 연결하려면 이 Mac에서 cmux를 업데이트하세요."
          }
        }
      }
    },
    "mobile.pairing.loopbackRejected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code points at the Mac itself (localhost), so your iPhone can't use it. On cmux 0.64.17, open Pair iPhone. On newer versions, open Tailscale Pairing. Then scan a fresh code."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードはMac自身（localhost）を指しているため、iPhoneからは使えません。cmux 0.64.17では「Pair iPhone」を開きます。新しいバージョンでは「Tailscale Pairing」を開き、新しいコードをスキャンしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code verweist auf den Mac selbst (localhost), sodass Ihr iPhone ihn nicht verwenden kann. Öffnen Sie unter cmux 0.64.17 „iPhone koppeln“. Öffnen Sie bei neueren Versionen Tailscale Pairing. Scannen Sie dann einen neuen Code."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code pointe vers le Mac lui-même (localhost), votre iPhone ne peut donc pas l'utiliser. Sur cmux 0.64.17, ouvrez Pair iPhone. Sur les versions plus récentes, ouvrez Tailscale Pairing. Scannez ensuite un nouveau code."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشير هذا الرمز إلى جهاز Mac نفسه (المضيف المحلي)، لذا لا يمكن لجهاز iPhone الخاص بك استخدامه. في cmux 0.64.17، افتح Pair iPhone. في الإصدارات الأحدث، افتح Tailscale Pairing. ثم قم بمسح رمز جديد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código apunta al propio Mac (localhost), por lo que tu iPhone no puede usarlo. En cmux 0.64.17, abra Emparejar iPhone. En versiones más recientes, abra Tailscale Pairing. Luego escanee un código nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此代碼指向 Mac 本身 (localhost)，因此您的 iPhone 無法使用它。在 cmux 0.64.17 上，開啟「配對 iPhone」。在較新版本上，開啟 Tailscale 配對。然後掃描新代碼。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此代码指向 Mac 本身 (localhost)，因此您的 iPhone 无法使用它。在 cmux 0.64.17 上，打开“配对 iPhone”。在较新版本上，打开 Tailscale 配对。然后扫描新代码。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 코드는 Mac 자체(localhost)를 가리키므로 iPhone에서는 이를 사용할 수 없습니다. cmux 0.64.17에서 iPhone 페어링을 엽니다. 최신 버전에서는 Tailscale 페어링을 엽니다. 그런 다음 새로운 코드를 스캔하세요."
          }
        }
      }
    },
    "mobile.pairing.manual.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't scan? Enter this Mac's numeric Tailscale IP and port:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンできない場合は、この Mac の数値 Tailscale IP アドレスとポートを入力してください："
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann nicht scannen? Geben Sie die numerische Tailscale-IP und den Port dieses Mac ein:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne parvenez pas à numériser ? Entrez l'adresse IP et le port Tailscale numérique de ce Mac :"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن المسح؟ أدخل عنوان Tailscale IP الرقمي والمنفذ الخاص بجهاز Mac:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
