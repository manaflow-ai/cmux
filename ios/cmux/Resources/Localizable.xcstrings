          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰과 Mac에 Tailscale을 설치하세요."
          }
        }
      }
    },
    "mobile.onboarding.tailscaleStep2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign both in to the same Tailscale account so they share one tailnet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方を同じTailscaleアカウントでサインインし、同じtailnetを共有させます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich beide bei demselben Tailscale-Konto an, damit sie sich ein Tailnet teilen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous tous les deux au même compte Tailscale afin qu’ils partagent un seul tailnet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتسجيل الدخول إلى نفس حساب Tailscale بحيث يتشاركان في شبكة خلفية واحدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sesión en ambos en la misma cuenta de Tailscale para que compartan una tailnet."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩者都登入同一個 Tailscale 帳戶，以便共用一個 tailnet。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两者都登录到同一个 Tailscale 帐户，以便共享一个 tailnet。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘 다 동일한 Tailscale 계정에 로그인하여 하나의 tailnet을 공유합니다."
          }
        }
      }
    },
    "mobile.onboarding.tailscaleStep3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep both signed in to the same cmux account too. Pairing checks that they match."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方を同じcmuxアカウントでもサインインしておきます。ペアリング時に一致を確認します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleiben Sie auch bei demselben cmux-Konto angemeldet. Beim Pairing wird überprüft, ob sie übereinstimmen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez également les deux connectés au même compte cmux. L'appariement vérifie qu'ils correspondent."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بكلاهما مسجلاً الدخول إلى حساب cmux نفسه أيضًا. الاقتران يتحقق من مطابقتها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga ambos iniciados sesión en la misma cuenta cmux también. El emparejamiento comprueba que coincidan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "也讓兩者登入同一個 cmux 帳號。配對檢查它們是否匹配。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也让两者登录到同一个 cmux 帐户。配对检查它们是否匹配。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘 다 동일한 cmux 계정에 로그인된 상태를 유지하세요. 페어링은 일치하는지 확인합니다."
          }
        }
      }
    },
    "mobile.onboarding.tailscaleTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put both devices on Tailscale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方の端末をTailscaleに入れる"
          }
        },
        "de": {
