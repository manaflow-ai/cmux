    "mobile.computers.forget.confirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's removed from all your devices. If it's still online, it reappears the next time it connects."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデバイスから削除されます。オンラインのままの場合は、次回接続時に再表示されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde von allen Ihren Geräten entfernt. Wenn es noch online ist, wird es bei der nächsten Verbindung wieder angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est supprimé de tous vos appareils. S'il est toujours en ligne, il réapparaîtra lors de sa prochaine connexion."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم إزالته من جميع أجهزتك. إذا كان لا يزال متصلاً بالإنترنت، فسيظهر مرة أخرى في المرة التالية التي يتصل فيها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se elimina de todos tus dispositivos. Si todavía está en línea, reaparece la próxima vez que se conecte."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它已從您的所有設備中刪除。如果它仍然在線，它會在下次連接時重新出現。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它已从您的所有设备中删除。如果它仍然在线，它会在下次连接时重新出现。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기기에서 삭제됩니다. 아직 온라인 상태라면 다음에 연결할 때 다시 나타납니다."
          }
        }
      }
    },
    "mobile.computers.forget.failureMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's still signed in. Check your connection and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだサインインしています。接続を確認してもう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist immer noch angemeldet. Überprüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est toujours connecté. Vérifiez votre connexion et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال قيد تسجيل الدخول. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía está conectado. Verifique su conexión e inténtelo nuevamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它仍然處於登入狀態。請檢查您的連接，然後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它仍然处于登录状态。请检查您的连接，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 로그인되어 있습니다. 연결을 확인하고 다시 시도하세요."
          }
        }
      }
    },
