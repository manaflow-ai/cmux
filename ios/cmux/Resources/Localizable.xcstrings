    "mobile.iroh.private.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a private route for Tailscale alternatives, a company VPN, or a network you operate. cmux still authenticates the Mac before use."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale の代替、会社の VPN、または自分で運用するネットワークにプライベートルートを使用します。使用前に cmux が Mac を認証します。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "可为 Tailscale 替代方案、公司 VPN 或你运营的网络使用专用路由。cmux 在使用前仍会验证 Mac。"
        }
      }}
    },
