    "mobile.signIn.restoringMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking your saved session. Sign-in options are paused until this finishes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みセッションを確認しています。完了するまでサインイン操作は一時停止されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie Ihre gespeicherte Sitzung. Die Anmeldeoptionen werden angehalten, bis dieser Vorgang abgeschlossen ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification de votre session enregistrée. Les options de connexion sont suspendues jusqu'à la fin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحقق من جلستك المحفوظة. يتم إيقاف خيارات تسجيل الدخول مؤقتًا حتى ينتهي هذا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobando su sesión guardada. Las opciones de inicio de sesión están en pausa hasta que esto finalice."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查您儲存的會話。登入選項將暫停，直至完成。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查您保存的会话。登录选项将暂停，直至完成。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 세션을 확인하는 중입니다. 이 작업이 완료될 때까지 로그인 옵션이 일시중지됩니다."
          }
        }
      }
    },
    "mobile.signIn.restoreTimeoutMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux could not finish checking your saved session. Check your connection, then retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux は保存済みセッションの確認を完了できませんでした。接続を確認してから再試行してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux konnte die Überprüfung Ihrer gespeicherten Sitzung nicht abschließen. Überprüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux n'a pas pu terminer la vérification de votre session enregistrée. Vérifiez votre connexion, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على cmux إنهاء فحص الجلسة المحفوظة. تحقق من اتصالك، ثم أعد المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no pudo terminar de verificar su sesión guardada. Verifique su conexión y luego vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 無法完成檢查您已儲存的會話。檢查您的連接，然後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 无法完成检查您保存的会话。检查您的连接，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 저장된 세션 확인을 완료할 수 없습니다. 연결을 확인한 후 다시 시도하세요."
          }
        }
      }
    },
