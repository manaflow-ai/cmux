          }
        }
      }
    },
    "mobile.workspaceAction.failure.reason.invalidWorkingDirectory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The working directory isn't available on your Mac; choose another directory."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac で作業ディレクトリを使用できません。別のディレクトリを選択してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Arbeitsverzeichnis ist auf Ihrem Mac nicht verfügbar; Wählen Sie ein anderes Verzeichnis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le répertoire de travail n'est pas disponible sur votre Mac ; choisissez un autre répertoire."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دليل العمل غير متوفر على جهاز Mac الخاص بك؛ اختر دليلا آخر."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El directorio de trabajo no está disponible en tu Mac; elija otro directorio."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作目錄在您的 Mac 上不可用；選擇另一個目錄。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作目录在您的 Mac 上不可用；选择另一个目录。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서는 작업 디렉토리를 사용할 수 없습니다. 다른 디렉터리를 선택하세요."
          }
        }
      }
    },
    "mobile.workspaceAction.failure.reason.alreadyCompleted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac already accepted the request; refresh workspaces before trying again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macはリクエストをすでに受け付けています。ワークスペースを更新してから、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Mac hat die Anfrage bereits angenommen; Aktualisieren Sie die Arbeitsbereiche, bevor Sie es erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Mac a déjà accepté la demande ; actualisez les espaces de travail avant de réessayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد قبل جهاز Mac الخاص بك الطلب بالفعل؛ قم بتحديث مساحات العمل قبل المحاولة مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Mac ya aceptó la solicitud; Actualice los espacios de trabajo antes de volver a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 Mac 已經接受了請求；請先刷新工作區，然後再試一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 Mac 已经接受了请求；请先刷新工作区，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 이미 요청을 수락했습니다. 다시 시도하기 전에 작업공간을 새로 고치세요."
          }
        }
      }
    },
    "mobile.workspaceAction.failure.reason.persistence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
