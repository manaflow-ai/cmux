    "mobile.loading.timeout.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux could not finish restoring this session. Check that the selected cmux build is running, then retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux はこのセッションの復元を完了できませんでした。選択した cmux ビルドが起動していることを確認してから、再試行してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux konnte die Wiederherstellung dieser Sitzung nicht abschließen. Überprüfen Sie, ob der ausgewählte cmux-Build ausgeführt wird, und versuchen Sie es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux n'a pas pu terminer la restauration de cette session. Vérifiez que la version cmux sélectionnée est en cours d'exécution, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على cmux إنهاء استعادة هذه الجلسة. تأكد من تشغيل إصدار cmux المحدد، ثم أعد المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no pudo terminar de restaurar esta sesión. Verifique que la compilación cmux seleccionada se esté ejecutando y luego vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 無法完成此會話的恢復。檢查所選 cmux 建置是否正在運行，然後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 无法完成此会话的恢复。检查所选 cmux 构建是否正在运行，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 이 세션 복원을 완료할 수 없습니다. 선택한 cmux 빌드가 실행 중인지 확인한 후 다시 시도하세요."
          }
        }
      }
    },
