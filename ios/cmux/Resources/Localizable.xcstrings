    "mobile.settings.deleteAccountServerCleanupIncompleteMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account sign-in was deleted, but some cmux cleanup did not finish. You will be signed out. Contact support if cmux data is still visible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントのサインイン情報は削除されましたが、一部の cmux クリーンアップは完了しませんでした。サインアウトします。cmux データがまだ表示される場合はサポートにお問い合わせください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung Ihres Kontos wurde gelöscht, einige cmux-Bereinigungen konnten jedoch nicht abgeschlossen werden. Sie werden abgemeldet. Wenden Sie sich an den Support, wenn cmux-Daten noch sichtbar sind."
          }
        },
        "fr": {
          "stringUnit": {
