    "mobile.pairing.versionWarningFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone is running cmux %@, but the Mac is running cmux %@. Pairing across different compatibility levels can break terminal input, workspace sync, or notifications. Continue only if you trust this Mac and accept that some features may fail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone は cmux %@ を実行していますが、Mac は cmux %@ を実行しています。異なる互換性レベル間でペアリングすると、ターミナル入力、ワークスペース同期、通知が壊れる可能性があります。この Mac を信頼し、一部の機能が失敗する可能性を受け入れる場合のみ続行してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem iPhone wird cmux %@ ausgeführt, auf dem Mac jedoch cmux %@. Durch das Koppeln über verschiedene Kompatibilitätsstufen hinweg kann es zu Unterbrechungen bei der Terminaleingabe, bei der Workspace-Synchronisierung oder bei Benachrichtigungen kommen. Fahren Sie nur fort, wenn Sie diesem Mac vertrauen und akzeptieren, dass einige Funktionen möglicherweise fehlschlagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone exécute cmux %@, mais le Mac exécute cmux %@. Le couplage entre différents niveaux de compatibilité peut interrompre la saisie du terminal, la synchronisation de l'espace de travail ou les notifications. Continuez uniquement si vous faites confiance à ce Mac et acceptez que certaines fonctionnalités puissent échouer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل جهاز iPhone هذا بنظام cmux %@، لكن جهاز Mac يعمل بنظام cmux %@. يمكن أن يؤدي الاقتران عبر مستويات توافق مختلفة إلى تعطيل الإدخال الطرفي أو مزامنة مساحة العمل أو الإشعارات. تابع فقط إذا كنت تثق بجهاز Mac هذا وتقبل احتمال فشل بعض الميزات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone ejecuta cmux %@, pero la Mac ejecuta cmux %@. El emparejamiento entre diferentes niveles de compatibilidad puede interrumpir la entrada del terminal, la sincronización del espacio de trabajo o las notificaciones. Continúe solo si confía en esta Mac y acepta que algunas funciones pueden fallar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPhone 運行 cmux %@，但 Mac 運行 cmux %@。跨不同相容性等級進行配對可能會破壞終端輸入、工作區同步或通知。只有在您信任這台 Mac 並接受某些功能可能會失敗的情況下才能繼續。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPhone 运行 cmux %@，但 Mac 运行 cmux %@。跨不同兼容性级别进行配对可能会破坏终端输入、工作区同步或通知。仅当您信任这台 Mac 并接受某些功能可能会失败的情况下才能继续。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone은 cmux %@를 실행하고 있지만 Mac은 cmux %@를 실행하고 있습니다. 다양한 호환성 수준에 걸쳐 페어링하면 터미널 입력, 작업 영역 동기화 또는 알림이 중단될 수 있습니다. 이 Mac을 신뢰하고 일부 기능이 실패할 수 있다는 점을 인정하는 경우에만 계속하세요."
          }
        }
      }
    },
