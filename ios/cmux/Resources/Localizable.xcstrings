    "mobile.shortcuts.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which buttons appear on the terminal keyboard bar, and drag to reorder them. The modifier keys, zoom, and paste can be moved or hidden along with the shortcuts. Swipe a custom action to edit or delete it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルのキーボードバーに表示するボタンを選び、ドラッグして並べ替えできます。修飾キー、ズーム、ペーストもショートカットと一緒に移動したり非表示にしたりできます。カスタムアクションはスワイプで編集または削除できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie aus, welche Schaltflächen auf der Tastaturleiste des Terminals angezeigt werden sollen, und ziehen Sie, um sie neu anzuordnen. Die Zusatztasten, Zoom und Einfügen können zusammen mit den Tastenkombinationen verschoben oder ausgeblendet werden. Wischen Sie über eine benutzerdefinierte Aktion, um sie zu bearbeiten oder zu löschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les boutons qui apparaissent sur la barre du clavier du terminal et faites-les glisser pour les réorganiser. Les touches de modification, le zoom et le collage peuvent être déplacés ou masqués avec les raccourcis. Faites glisser une action personnalisée pour la modifier ou la supprimer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الأزرار التي تظهر على شريط لوحة المفاتيح الطرفية، ثم اسحب لإعادة ترتيبها. يمكن نقل أو إخفاء مفاتيح التعديل والتكبير/التصغير واللصق مع الاختصارات. قم بتمرير إجراء مخصص لتحريره أو حذفه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija qué botones aparecen en la barra del teclado del terminal y arrástrelos para reordenarlos. Las teclas modificadoras, hacer zoom y pegar se pueden mover u ocultar junto con los atajos. Desliza una acción personalizada para editarla o eliminarla."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇終端鍵盤欄上顯示的按鈕，然後拖曳以重新排序。修飾鍵、縮放和貼上可以與快捷鍵一起移動或隱藏。滑動自訂操作即可編輯或刪除。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择终端键盘栏上显示的按钮，然后拖动以重新排序。修饰键、缩放和粘贴可以与快捷键一起移动或隐藏。滑动自定义操作即可对其进行编辑或删除。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 키보드 표시줄에 표시되는 버튼을 선택하고 드래그하여 순서를 변경합니다. 수정자 키, 확대/축소, 붙여넣기는 단축키와 함께 이동하거나 숨길 수 있습니다. 맞춤 작업을 스와이프하여 수정하거나 삭제하세요."
          }
        }
      }
    },
