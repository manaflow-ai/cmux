    "mobile.onboarding.connect.trust": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End-to-end encrypted. Relays cannot read your terminal traffic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンドツーエンドで暗号化。リレーはターミナル通信を読み取れません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ende-zu-Ende verschlüsselt. Relays können Ihren Terminalverkehr nicht lesen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffré de bout en bout. Les relais ne peuvent pas lire le trafic de votre terminal."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مشفرة من طرف إلى طرف. لا يمكن للمرحلات قراءة حركة المرور الطرفية الخاصة بك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifrado de extremo a extremo. Los relés no pueden leer el tráfico de su terminal."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "端對端加密。中繼無法讀取您的終端流量。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端到端加密。中继无法读取您的终端流量。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엔드투엔드 암호화. 릴레이는 터미널 트래픽을 읽을 수 없습니다."
          }
        }
      }
    },
