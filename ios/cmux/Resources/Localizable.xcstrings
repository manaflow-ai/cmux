    "mobile.autoConnectMigration.guidance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Older cmux versions still work over Tailscale. Open Tailscale Pairing on the Mac and scan its QR, or enter its numeric Tailscale IP and port once."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古い cmux バージョンでも Tailscale 経由で接続できます。Mac で「Tailscale Pairing」を開き、QR をスキャンするか、数値の Tailscale IP アドレスとポートを一度入力してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ältere cmux-Versionen funktionieren immer noch über Tailscale. Öffnen Sie Tailscale Pairing auf dem Mac und scannen Sie den QR-Code oder geben Sie einmal die numerische Tailscale-IP und den Port ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les anciennes versions de cmux fonctionnent toujours sur Tailscale. Ouvrez Tailscale Pairing sur le Mac et scannez son QR, ou entrez une fois son adresse IP Tailscale numérique et son port."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تزال إصدارات cmux الأقدم تعمل على Tailscale. افتح Tailscale Pairing على جهاز Mac وقم بمسح QR الخاص به، أو أدخل رقم Tailscale IP والمنفذ مرة واحدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las versiones anteriores de cmux todavía funcionan en Tailscale. Abra Tailscale Pairing en Mac y escanee su QR, o ingrese su IP numérica de Tailscale y su puerto una vez."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "較舊的 cmux 版本仍然可以在 Tailscale 上運行。在 Mac 上開啟 Tailscale 配對並掃描其二維碼，或輸入其數位 Tailscale IP 和連接埠一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "较旧的 cmux 版本仍然可以在 Tailscale 上运行。在 Mac 上打开 Tailscale 配对并扫描其二维码，或输入其数字 Tailscale IP 和端口一次。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 cmux 버전은 여전히 ​​Tailscale에서 작동합니다. Mac에서 Tailscale 페어링을 열고 QR을 스캔하거나 숫자로 된 Tailscale IP 및 포트를 한 번 입력하세요."
          }
        }
      }
    },
