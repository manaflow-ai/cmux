          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce QR est pour %@. Connectez-vous avec le même e-mail que le Mac, puis numérisez à nouveau."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا QR مخصص لـ %@. قم بتسجيل الدخول بنفس البريد الإلكتروني المسجل على جهاز Mac، ثم قم بالمسح الضوئي مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este QR es para %@. Inicie sesión con el mismo correo electrónico que en Mac y luego escanee nuevamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 QR 適用於 %@。使用與 Mac 相同的電子郵件登錄，然後再次掃描。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 QR 适用于 %@。使用与 Mac 相同的电子邮件登录，然后再次扫描。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 QR은 %@용입니다. Mac과 동일한 이메일로 로그인한 후 다시 스캔하세요."
          }
        }
      }
    },
    "mobile.pairing.fail.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device looks offline. Connect to Wi-Fi or cellular, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末はオフラインのようです。Wi-Fiまたはモバイルデータに接続してから、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät scheint offline zu sein. Stellen Sie eine WLAN- oder Mobilfunkverbindung her und versuchen Sie es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil semble hors ligne. Connectez-vous au Wi-Fi ou au réseau cellulaire, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو هذا الجهاز غير متصل بالإنترنت. اتصل بشبكة Wi-Fi أو شبكة خلوية، ثم حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo parece desconectado. Conéctate a una red Wi-Fi o celular y vuelve a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該設備看起來處於離線狀態。连接到 Wi-Fi 或蜂窝网络，然后重试。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该设备看起来处于离线状态。连接到 Wi-Fi 或蜂窝网络，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 오프라인인 것 같습니다. Wi-Fi 또는 모바일 데이터에 연결한 후 다시 시도해 보세요."
          }
        }
      }
    },
    "mobile.pairing.guidance.authEnvironment": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use BETA, INTERNAL, or the App Store app with Stable or Nightly. Use this DEV iPhone build with its same-tag DEV Mac build or a granted tag."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BETA、INTERNAL、または App Store アプリは Stable または Nightly と一緒に使用してください。この DEV iPhone ビルドは同じタグの DEV Mac ビルド、または許可されたタグと一緒に使用できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie BETA, INTERNAL oder die App Store-App mit Stable oder Nightly. Verwenden Sie diesen DEV-iPhone-Build mit seinem DEV-Mac-Build mit demselben Tag oder einem gewährten Tag."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez BETA, INTERNAL ou l'application App Store avec Stable ou Nightly. Utilisez cette version DEV iPhone avec sa version DEV Mac de même balise ou une balise accordée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم تطبيق BETA أو INTERNAL أو App Store مع Stable أو Nightly. استخدم إصدار DEV iPhone هذا مع إصدار DEV Mac الذي يحمل نفس العلامة أو علامة ممنوحة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice la aplicación BETA, INTERNAL o App Store con Stable o Nightly. Utilice esta compilación DEV de iPhone con su compilación DEV de Mac con la misma etiqueta o una etiqueta otorgada."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 BETA、INTERNAL 或 App Store 應用程式與 Stable 或 Nightly。將此 DEV iPhone 版本與其相同標籤的 DEV Mac 版本或已授予的標籤一起使用。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 BETA、INTERNAL 或 App Store 应用程序与 Stable 或 Nightly。将此 DEV iPhone 版本与其相同标签的 DEV Mac 版本或授予的标签一起使用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Stable 또는 Nightly와 함께 BETA, INTERNAL 또는 App Store 앱을 사용하세요. 동일한 태그의 DEV Mac 빌드 또는 부여된 태그와 함께 이 DEV iPhone 빌드를 사용하세요."
          }
        }
      }
    },
    "mobile.pairing.guidance.authEnvironment.devMac": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair with a Mac running the release cmux app, or use a development-channel iPhone build for dev Macs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リリース版の cmux アプリを実行している Mac とペアリングするか、開発用の Mac には開発チャネルの iPhone ビルドを使用してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppeln Sie es mit einem Mac, auf dem die Release-Cmux-App ausgeführt wird, oder verwenden Sie einen iPhone-Build für den Entwicklungskanal für Entwickler-Macs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associez-le à un Mac exécutant l’application cmux ou utilisez une version iPhone de canal de développement pour les Mac de développement."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بالاقتران مع جهاز Mac يقوم بتشغيل إصدار تطبيق cmux، أو استخدم إصدار iPhone لقناة التطوير لأجهزة Mac المطورة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Emparéjelo con una Mac que ejecute la aplicación cmux de lanzamiento o use una versión de iPhone del canal de desarrollo para Mac de desarrollo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與運行發布版 cmux 應用程式的 Mac 配對，或使用適用於開發 Mac 的開發通道 iPhone 版本。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与运行发布版 cmux 应用程序的 Mac 配对，或使用适用于开发 Mac 的开发通道 iPhone 版本。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "릴리스 cmux 앱을 실행하는 Mac과 페어링하거나 개발용 Mac용 개발 채널 iPhone 빌드를 사용하세요."
          }
        }
      }
    },
    "mobile.pairing.guidance.authEnvironment.official": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair with a Mac running the standard cmux app, and update cmux on the Mac if it is out of date."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常版の cmux アプリを実行している Mac とペアリングしてください。Mac の cmux が古い場合は最新版に更新してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppeln Sie es mit einem Mac, auf dem die Standard-cmux-App ausgeführt wird, und aktualisieren Sie cmux auf dem Mac, wenn es veraltet ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associez-le à un Mac exécutant l'application cmux standard et mettez à jour cmux sur le Mac s'il est obsolète."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإقرانه بجهاز Mac يقوم بتشغيل تطبيق cmux القياسي، وقم بتحديث cmux على جهاز Mac إذا كان قديمًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Emparéjelo con una Mac que ejecute la aplicación cmux estándar y actualice cmux en la Mac si no está actualizada."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與運行標準 cmux 應用程式的 Mac 配對，並在 Mac 上更新 cmux（如果它已過期）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与运行标准 cmux 应用程序的 Mac 配对，并在 Mac 上更新 cmux（如果它已过期）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표준 cmux 앱을 실행하는 Mac과 페어링하고, 오래된 경우 Mac에서 cmux를 업데이트하세요."
          }
        }
      }
    },
    "mobile.pairing.guidance.buildIncompatible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A DEV iPhone build connects to its same-tag DEV Mac build, plus tags granted with 'cmux mobile compatible-tags'. BETA, INTERNAL, and App Store builds connect only to Stable or Nightly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DEV iPhone ビルドは同じタグの DEV Mac ビルドと、「cmux mobile compatible-tags」で許可されたタグに接続できます。BETA、INTERNAL、App Store ビルドは Stable または Nightly にのみ接続できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein DEV-iPhone-Build stellt eine Verbindung zu seinem DEV-Mac-Build mit demselben Tag her, plus Tags, die mit „cmux mobile kompatibel-tags“ gewährt werden. BETA-, INTERNAL- und App Store-Builds stellen nur eine Verbindung zu Stable oder Nightly her."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une version DEV iPhone se connecte à sa version DEV Mac avec la même balise, ainsi qu'aux balises accordées avec les « balises compatibles mobiles cmux ». Les versions BETA, INTERNE et App Store se connectent uniquement à Stable ou Nightly."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتصل إصدار DEV iPhone بإصدار DEV Mac الذي يحمل نفس العلامة، بالإضافة إلى العلامات الممنوحة بـ \"علامات متوافقة مع الأجهزة المحمولة cmux\". تتصل إصدارات BETA وINTERNAL وApp Store بالإصدار الثابت أو Nightly فقط."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una compilación DEV de iPhone se conecta a su compilación DEV de Mac con la misma etiqueta, además de etiquetas otorgadas con 'etiquetas compatibles con dispositivos móviles cmux'. Las versiones BETA, INTERNA y App Store se conectan solo a Stable o Nightly."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DEV iPhone 版本連接到其相同標籤的 DEV Mac 版本，以及授予「cmux 行動裝置相容標籤」的標籤。 BETA、INTERNAL 和 App Store 版本僅連接到 Stable 或 Nightly。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DEV iPhone 版本连接到其相同标签的 DEV Mac 版本，以及授予“cmux 移动兼容标签”的标签。 BETA、INTERNAL 和 App Store 版本仅连接到 Stable 或 Nightly。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DEV iPhone 빌드는 동일한 태그의 DEV Mac 빌드와 'cmux 모바일 호환 태그'로 부여된 태그에 연결됩니다. BETA, INTERNAL 및 App Store 빌드는 Stable 또는 Nightly에만 연결됩니다."
          }
        }
      }
    },
    "mobile.pairing.guidance.buildIncompatible.official": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update cmux on your Mac to the latest version, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac の cmux を最新バージョンに更新してから、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren Sie cmux auf Ihrem Mac auf die neueste Version und versuchen Sie es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour cmux sur votre Mac avec la dernière version, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتحديث cmux على جهاز Mac الخاص بك إلى الإصدار الأحدث، ثم حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualice cmux en su Mac a la última versión y vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 Mac 上的 cmux 更新到最新版本，然後再試一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Mac 上的 cmux 更新到最新版本，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 cmux를 최신 버전으로 업데이트한 후 다시 시도하세요."
          }
        }
      }
    },
    "mobile.pairing.guidance.localNetwork": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings > cmux > Local Network, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 > cmux > ローカルネットワーク を開いてから、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen > cmux > Lokales Netzwerk, dann versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paramètres > cmux > Réseau local, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإعدادات > cmux > الشبكة المحلية، ثم حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuración > cmux > Red local y vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 > cmux > 本機網絡，然後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 > cmux > 本地网络，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 > cmux > 로컬 네트워크를 선택하고 다시 시도하세요."
          }
        }
      }
    },
    "mobile.pairing.guidance.macUpdateRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved computer will reconnect automatically after you update cmux on the Mac. You do not need to sign out or pair again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのcmuxをアップデートすると、保存済みのコンピュータに自動的に再接続します。サインアウトや再ペアリングは不要です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr gespeicherter Computer wird automatisch wieder verbunden, nachdem Sie cmux auf dem Mac aktualisiert haben. Sie müssen sich nicht abmelden oder erneut koppeln."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre ordinateur enregistré se reconnectera automatiquement après la mise à jour de cmux sur Mac. Vous n'avez pas besoin de vous déconnecter ou de vous associer à nouveau."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم إعادة توصيل جهاز الكمبيوتر المحفوظ الخاص بك تلقائيًا بعد تحديث cmux على جهاز Mac. لا تحتاج إلى تسجيل الخروج أو الاقتران مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su computadora guardada se volverá a conectar automáticamente después de que actualice cmux en Mac. No es necesario cerrar sesión ni volver a vincularse."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上更新 cmux 後，您儲存的電腦將自動重新連線。您無需登出或再次配對。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上更新 cmux 后，您保存的计算机将自动重新连接。您无需注销或再次配对。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 cmux를 업데이트하면 저장된 컴퓨터가 자동으로 다시 연결됩니다. 로그아웃하거나 다시 페어링할 필요가 없습니다."
          }
        }
      }
    },
    "mobile.pairing.guidance.openMacApp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open cmux on your Mac, then scan the QR or link from it again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macでcmuxを開いてから、そのQRコードまたはリンクをもう一度スキャンしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie cmux auf Ihrem Mac und scannen Sie dann den QR oder Link erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez cmux sur votre Mac, puis scannez à nouveau le QR ou le lien à partir de celui-ci."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح cmux على جهاز Mac الخاص بك، ثم قم بمسح QR أو الرابط منه مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra cmux en su Mac, luego escanee el QR o vincule nuevamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上開啟 cmux，然後再次掃描其中的 QR 或連結。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上打开 cmux，然后再次扫描其中的 QR 或链接。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 cmux를 연 다음 QR을 스캔하거나 다시 연결하세요."
          }
        }
      }
    },
    "mobile.pairing.guidance.connectAttemptGated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A connection attempt is already in progress. Give it a moment to finish; retry only if this computer stays disconnected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに接続処理が進行中です。完了まで少しお待ちください。接続されないままの場合のみ再試行してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird bereits ein Verbindungsversuch durchgeführt. Nehmen Sie sich einen Moment Zeit, um es fertigzustellen. Versuchen Sie es nur erneut, wenn die Verbindung zu diesem Computer weiterhin unterbrochen ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tentative de connexion est déjà en cours. Donnez-lui un moment pour terminer ; réessayez uniquement si cet ordinateur reste déconnecté."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاولة الاتصال جارية بالفعل. امنحها لحظة حتى تنتهي؛ أعد المحاولة فقط إذا ظل هذا الكمبيوتر غير متصل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay un intento de conexión en curso. Dale un momento para terminar; Vuelva a intentarlo solo si esta computadora permanece desconectada."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線嘗試已在進行中。給它一點時間來完成；僅當該計算機保持斷開連接時才重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接尝试已在进行中。给它一点时间来完成；仅当该计算机保持断开连接时才重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 시도가 이미 진행 중입니다. 잠시 기다려 주세요. 이 컴퓨터의 연결이 끊어진 경우에만 다시 시도하세요."
          }
        }
      }
    },
    "mobile.pairing.guidance.routeCleanupBlocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Force-quit and reopen cmux on this iPhone, then reconnect. If this returns, restart cmux on the Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneでcmuxを強制終了して開き直し、再接続してください。再発する場合は、Macのcmuxを再起動してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzwingen Sie das Beenden und öffnen Sie cmux auf diesem iPhone erneut, und stellen Sie dann die Verbindung wieder her. Wenn dies erneut auftritt, starten Sie cmux auf dem Mac neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forcez la fermeture et rouvrez cmux sur cet iPhone, puis reconnectez-vous. Si cela revient, redémarrez cmux sur le Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإنهاء الأمر بالقوة وإعادة فتح cmux على جهاز iPhone هذا، ثم أعد الاتصال. إذا عاد هذا، أعد تشغيل cmux على جهاز Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuerce el cierre y vuelva a abrir cmux en este iPhone, luego vuelva a conectarse. Si esto regresa, reinicie cmux en Mac."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此 iPhone 上強制退出並重新開啟 cmux，然後重新連線。如果再次出現此問題，請在 Mac 上重新啟動 cmux。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此 iPhone 上强制退出并重新打开 cmux，然后重新连接。如果再次出现此问题，请在 Mac 上重新启动 cmux。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에서 cmux를 강제 종료했다가 다시 연 다음 다시 연결하세요. 이 메시지가 반환되면 Mac에서 cmux를 다시 시작하세요."
          }
        }
      }
    },
    "mobile.pairing.guidance.reachability": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh reconnects automatically. For a saved private-network fallback, connect both devices to that network, wake the Mac, and open cmux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Irohは自動的に再接続します。保存済みのプライベートネットワークをフォールバックに使う場合は、両方の端末をそのネットワークに接続し、Macを起こしてcmuxを開いてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh verbindet sich automatisch wieder. Für ein gespeichertes privates Netzwerk-Fallback verbinden Sie beide Geräte mit diesem Netzwerk, aktivieren Sie den Mac und öffnen Sie cmux."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh se reconnecte automatiquement. Pour une solution de secours enregistrée sur un réseau privé, connectez les deux appareils à ce réseau, réveillez le Mac et ouvrez cmux."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم Iroh بإعادة الاتصال تلقائيًا. للحصول على نسخة احتياطية محفوظة للشبكة الخاصة، قم بتوصيل كلا الجهازين بتلك الشبكة، وقم بتنشيط جهاز Mac، وافتح cmux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh se vuelve a conectar automáticamente. Para tener una reserva de red privada guardada, conecte ambos dispositivos a esa red, active la Mac y abra cmux."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh 自動重新連線。對於已儲存的專用網路回退，請將兩個裝置連接到該網絡，喚醒 Mac，然後開啟 cmux。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh 自动重新连接。对于已保存的专用网络回退，请将两个设备连接到该网络，唤醒 Mac，然后打开 cmux。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이로가 자동으로 다시 연결됩니다. 저장된 개인 네트워크 대체를 위해 두 장치를 해당 네트워크에 연결하고 Mac을 깨운 다음 ​​cmux를 엽니다."
          }
        }
      }
    },
    "mobile.pairing.guidance.rescanFresh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Tailscale Pairing on the Mac and scan a fresh QR, or enter the Mac's numeric Tailscale IP and port."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac で「Tailscale Pairing」を開き、新しい QR をスキャンするか、Mac の数値 Tailscale IP アドレスとポートを入力してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie Tailscale Pairing auf dem Mac und scannen Sie einen neuen QR oder geben Sie die numerische Tailscale-IP und den Port des Mac ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Tailscale Pairing sur le Mac et scannez un nouveau QR, ou entrez l'adresse IP et le port numérique Tailscale du Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Tailscale Pairing على جهاز Mac وقم بمسح QR جديد، أو أدخل عنوان Tailscale IP الرقمي والمنفذ الخاص بجهاز Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Tailscale Pairing en Mac y escanee un QR nuevo, o ingrese la IP y el puerto numéricos de Tailscale de Mac."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上開啟 Tailscale 配對並掃描新的二維碼，或輸入 Mac 的數位 Tailscale IP 和連接埠。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上打开 Tailscale 配对并扫描新的二维码，或输入 Mac 的数字 Tailscale IP 和端口。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 Tailscale 페어링을 열고 새로운 QR을 스캔하거나 Mac의 숫자 Tailscale IP 및 포트를 입력하세요."
          }
        }
      }
    },
    "mobile.pairing.guidance.tailscaleUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Tailscale on both devices, then scan a fresh Mac pairing QR or enter its numeric Tailscale IP and port."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方のデバイスで Tailscale を開き、新しい Mac のペアリング QR をスキャンするか、数値の Tailscale IP アドレスとポートを入力してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie Tailscale auf beiden Geräten, scannen Sie dann einen neuen Mac-Kopplungs-QR oder geben Sie die numerische Tailscale-IP und den Port ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Tailscale sur les deux appareils, puis scannez un nouveau QR de couplage Mac ou entrez son adresse IP et son port Tailscale numériques."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Tailscale على كلا الجهازين، ثم قم بمسح QR جديد لإقران Mac أو أدخل Tailscale IP الرقمي والمنفذ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Tailscale en ambos dispositivos, luego escanee un QR de emparejamiento de Mac nuevo o ingrese su IP y puerto numéricos de Tailscale."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在兩台裝置上開啟 Tailscale，然後掃描新的 Mac 配對二維碼或輸入其數位 Tailscale IP 和連接埠。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在两台设备上打开 Tailscale，然后扫描新的 Mac 配对二维码或输入其数字 Tailscale IP 和端口。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 장치 모두에서 Tailscale을 연 다음 새로운 Mac 페어링 QR을 스캔하거나 숫자로 된 Tailscale IP 및 포트를 입력하세요."
          }
        }
      }
    },
    "mobile.pairing.guidance.sameAccount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both devices must be signed in to the same cmux account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方の端末が同じcmuxアカウントでサインインしている必要があります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Geräte müssen bei demselben cmux-Konto angemeldet sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux appareils doivent être connectés au même compte cmux."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب تسجيل دخول كلا الجهازين إلى نفس حساب cmux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos dispositivos deben iniciar sesión en la misma cuenta cmux."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩個裝置必須登入同一 cmux 帳戶。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个设备必须登录到同一 cmux 帐户。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 장치 모두 동일한 cmux 계정에 로그인되어 있어야 합니다."
          }
        }
      }
    },
    "mobile.pairing.guidance.updateApp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update cmux from the App Store (or TestFlight), then scan again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store（またはTestFlight）でcmuxを更新してから、もう一度スキャンしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren Sie cmux über den App Store (oder TestFlight) und scannen Sie dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour cmux depuis l'App Store (ou TestFlight), puis numérisez à nouveau."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتحديث cmux من App Store (أو TestFlight)، ثم قم بالمسح مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualice cmux desde App Store (o TestFlight) y luego escanee nuevamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 App Store（或 TestFlight）更新 cmux，然後再次掃描。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 App Store（或 TestFlight）更新 cmux，然后再次扫描。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store(또는 TestFlight)에서 cmux를 업데이트한 후 다시 스캔하세요."
          }
        }
      }
    },
    "mobile.pairing.guidance.updateApp.official": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
