    "mobile.connections.disconnected.listFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a shown computer to reconnect. Use its switch to show or hide it on this iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示中のコンピュータをタップして再接続します。スイッチでこのiPhoneでの表示・非表示を切り替えられます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf einen angezeigten Computer, um die Verbindung wiederherzustellen. Verwenden Sie den Schalter, um es auf diesem iPhone anzuzeigen oder auszublenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur un ordinateur affiché pour vous reconnecter. Utilisez son interrupteur pour l'afficher ou le masquer sur cet iPhone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على جهاز الكمبيوتر المعروض لإعادة الاتصال. استخدم مفتاحه لإظهاره أو إخفائه على هذا الـ iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque una computadora que se muestra para volver a conectarse. Utilice su interruptor para mostrarlo u ocultarlo en este iPhone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊顯示的電腦以重新連接。使用其開關在此 iPhone 上顯示或隱藏它。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击显示的计算机以重新连接。使用其开关在此 iPhone 上显示或隐藏它。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 연결하려면 표시된 컴퓨터를 탭하세요. 해당 스위치를 사용하여 이 iPhone에서 표시하거나 숨길 수 있습니다."
          }
        }
      }
    },
