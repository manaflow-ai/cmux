    "mobile.disconnected.connectFailedMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure the computer is awake and online, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータがスリープしておらずオンラインであることを確認してから、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie sicher, dass der Computer aktiv und online ist, und versuchen Sie es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assurez-vous que l'ordinateur est réveillé et en ligne, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد من أن الكمبيوتر نشط ومتصل بالإنترنت، ثم حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrese de que la computadora esté activa y en línea, luego inténtelo nuevamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確保電腦已喚醒並上線，然後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确保计算机已唤醒并在线，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터가 깨어 있고 온라인 상태인지 확인한 후 다시 시도하십시오."
          }
        }
      }
    },
