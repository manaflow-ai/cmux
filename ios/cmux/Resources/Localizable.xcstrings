    "mobile.taskComposer.drafts.empty.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave the composer with an unsent task and it is saved here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未送信のタスクを残したまま閉じると、ここに保存されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlassen Sie den Composer mit einer nicht gesendeten Aufgabe und sie wird hier gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez au compositeur une tâche non envoyée et elle sera enregistrée ici."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اترك للملحن مهمة غير مرسلة وسيتم حفظها هنا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deje al compositor una tarea sin enviar y se guardará aquí."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將未發送的任務留給作曲家，並將其保存在此處。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将未发送的任务留给作曲家，并将其保存在此处。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
