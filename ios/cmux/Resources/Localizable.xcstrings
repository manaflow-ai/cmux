    "mobile.onboarding.connectBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux uses Iroh by default. It connects directly to your Mac when possible and uses a cmux relay when needed. Your Mac's identity and cmux account are verified end to end, so the relay cannot read terminal traffic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmuxはデフォルトでIrohを使用します。可能な場合はMacへ直接接続し、必要な場合のみcmuxリレーを使用します。MacのIDとcmuxアカウントはエンドツーエンドで検証されるため、リレーはターミナル通信を読み取れません。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "cmux 默认使用 Iroh。它会在可能时直接连接到你的 Mac，需要时则通过 cmux 中继。你的 Mac 身份和 cmux 账户会经过端到端验证，因此中继无法读取终端流量。"
        }
      }}
    },
    "mobile.onboarding.connectTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted wherever you connect"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこからでも暗号化接続"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "无论在哪里连接都加密"
        }
      }}
    },
    "mobile.onboarding.getStarted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get started"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "始める"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "开始使用"
        }
      }}
    },
    "mobile.onboarding.next": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次へ"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "下一步"
        }
      }}
    },
    "mobile.onboarding.pairTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair your Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macとペアリング"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "配对 Mac"
        }
      }}
    },
    "mobile.onboarding.privateNetworkBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After cmux admits both devices over Iroh, Tailscale, WireGuard, another VPN, or the same LAN may become a faster direct path. They are optional, and Iroh keeps its encryption and identity checks."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmuxがIroh上で両方の端末を認証した後、Tailscale、WireGuard、別のVPN、または同じLANが、より高速な直接経路になる場合があります。これらは任意で、Irohの暗号化とID検証は維持されます。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "cmux 通过 Iroh 接纳两台设备后，Tailscale、WireGuard、其他 VPN 或同一局域网可能成为更快的直连路径。这些都是可选的，Iroh 仍会保留其加密和身份校验。"
        }
      }}
    },
    "mobile.onboarding.privateNetworkStep1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign this phone and the Mac in to the same cmux account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneとMacを同じcmuxアカウントでサインインします。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "让这部手机和 Mac 登录到同一个 cmux 账户。"
        }
      }}
    },
    "mobile.onboarding.privateNetworkStep2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave cmux running on the Mac so Iroh can reconnect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Irohが再接続できるよう、Macでcmuxを起動したままにします。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "让 cmux 在 Mac 上保持运行，以便 Iroh 可以重新连接。"
        }
      }}
    },
    "mobile.onboarding.privateNetworkStep3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: connect both devices to the same private network so an admitted Iroh session can migrate to it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意：認証済みのIrohセッションが移行できるよう、両方の端末を同じプライベートネットワークに接続します。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "可选：将两台设备连接到同一个专用网络，以便已接纳的 Iroh 会话可以迁移到该网络。"
        }
      }}
    },
    "mobile.onboarding.privateNetworkTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private networks stay available"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライベートネットワークも利用可能"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "专用网络保持可用"
        }
      }}
    },
    "mobile.onboarding.skip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキップ"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "跳过"
        }
      }}
    },
    "mobile.onboarding.tailscaleAppStoreLink": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: Tailscale for iPhone"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意：iPhone版Tailscale"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "可选：适用于 iPhone 的 Tailscale"
        }
      }}
    },
    "mobile.onboarding.tailscaleBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale is a free app that gives your devices a private network. Do this once, on both the phone and the Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscaleは、端末同士をプライベートなネットワークでつなぐ無料アプリです。iPhoneとMacの両方で一度だけ設定してください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "Tailscale 是一款免费应用，可为你的设备提供专用网络。在手机和 Mac 上都只需设置一次。"
        }
      }}
    },
    "mobile.onboarding.tailscaleLink": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: Tailscale for Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意：Mac版Tailscale"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "可选：适用于 Mac 的 Tailscale"
        }
      }}
    },
    "mobile.onboarding.tailscaleStep1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install Tailscale on this phone and on your Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末とMacの両方にTailscaleをインストールします。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "在这部手机和你的 Mac 上安装 Tailscale。"
        }
      }}
    },
    "mobile.onboarding.tailscaleStep2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign both in to the same Tailscale account so they share one tailnet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方を同じTailscaleアカウントでサインインし、同じtailnetを共有させます。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "让两者登录到同一个 Tailscale 账户，以便共享同一个 tailnet。"
        }
      }}
    },
    "mobile.onboarding.tailscaleStep3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep both signed in to the same cmux account too. Pairing checks that they match."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方を同じcmuxアカウントでもサインインしておきます。ペアリング時に一致を確認します。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "同时让两者保持登录到同一个 cmux 账户。配对时会校验两者是否一致。"
        }
      }}
    },
    "mobile.onboarding.tailscaleTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put both devices on Tailscale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方の端末をTailscaleに入れる"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "让两台设备都接入 Tailscale"
        }
      }}
    },
    "mobile.onboarding.troubleConnecting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouble connecting?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続できないときは"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "连接有问题？"
        }
      }}
    },
    "mobile.onboarding.whatBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux runs your terminals and AI coding agents on your Mac. Watch, type, and respond from your phone. Every agent alert stays in Notifications, and push alerts are optional when you want an immediate heads-up away from the app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmuxはMac上でターミナルとAIコーディングエージェントを動かします。iPhoneから状況を確認し、入力して対応できます。エージェントからの通知はすべて「通知」に時系列で残り、アプリを離れているときのプッシュ通知は必要に応じて有効にできます。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "cmux 在 Mac 上运行你的终端和 AI 编程代理。你可以用手机查看、输入和回复。所有代理提醒都会保留在「通知」中，当你希望在应用之外立即收到提醒时，也可以选择开启推送提醒。"
        }
      }}
    },
    "mobile.onboarding.whatTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac's terminals, on your phone"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのターミナルを、iPhoneで"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "你的 Mac 终端，尽在手机"
        }
      }}
    },
    "mobile.pairing.accountMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac is signed in to a different cmux account. Sign out and sign back in with the account that owns this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacは別のcmuxアカウントでサインインしています。サインアウトして、このMacを所有するアカウントでサインインし直してください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "这台 Mac 登录的是另一个 cmux 账户。请退出登录，并使用拥有这台 Mac 的账户重新登录。"
        }
      }}
    },
    "mobile.pairing.appNotRunning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac is reachable, but cmux isn't running there (or mobile pairing is off). Open cmux on the Mac, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macには接続できますが、cmuxが起動していません（またはモバイルのペア設定がオフです）。Macでcmuxを開いてから、もう一度お試しください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "可以到达你的 Mac，但 cmux 未在其中运行（或移动配对已关闭）。请在 Mac 上打开 cmux，然后重试。"
        }
      }}
    },
    "mobile.pairing.attachTicketExpired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This pairing link expired. Pair again with a fresh QR/link from that computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このペアリングリンクの有効期限が切れました。そのコンピュータの新しい QR/リンクでペアリングしてください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "此配对链接已过期。请用那台电脑上新的二维码/链接重新配对。"
        }
      }}
    },
    "mobile.pairing.authEnvironmentMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This dev build is signed in to cmux's development auth environment, so its account can never match a Mac running the release app — even with the same email."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この開発ビルドは cmux の開発用認証環境にサインインしているため、同じメールアドレスでも、リリース版アプリを実行している Mac のアカウントとは一致しません。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "此开发版构建登录的是 cmux 的开发验证环境，因此其账户永远无法与运行正式版应用的 Mac 匹配——即使邮箱相同也不行。"
        }
      }}
    },
    "mobile.pairing.authEnvironmentMismatch.devMac": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone uses cmux's production sign-in, but this Mac runs a dev build on the development auth environment, so their accounts can never match — even with the same email."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone は cmux の本番サインインを使用していますが、この Mac は開発用認証環境の開発ビルドを実行しているため、同じメールアドレスでもアカウントは一致しません。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "这部 iPhone 使用 cmux 的生产环境登录，但这台 Mac 在开发验证环境中运行开发版构建，因此两者的账户永远无法匹配——即使邮箱相同也不行。"
        }
      }}
    },
    "mobile.pairing.authorizationFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't verify your account with this Mac. Make sure both devices are signed in with the same email, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac でアカウントを確認できませんでした。両方のデバイスが同じメールアドレスでサインインしていることを確認してから、もう一度お試しください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "无法在这台 Mac 上验证你的账户。请确认两台设备使用同一 cmux 账户，且构建版本匹配（都是正式版，或都是开发版），然后重试。"
        }
      }}
    },
    "mobile.pairing.cameraDenied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera Access Required"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラへのアクセスが必要です"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "需要相机访问权限"
        }
      }}
    },
    "mobile.pairing.cameraUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera Unavailable"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを使用できません"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "相机不可用"
        }
      }}
    },
    "mobile.pairing.codePlaceholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing code"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングコード"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
