    "mobile.computers.presenceFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence is the Mac's own heartbeat to the presence service, which is currently a DEV-only feature. Stable cmux Macs don't announce it yet, so a Mac you're connected to may show no server heartbeat. If presence says online but This phone is not connected, the Mac is reachable elsewhere but not from your phone, usually a Tailscale or route problem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレゼンスは Mac 自身のプレゼンスサービスへのハートビートで、現在は DEV 限定の機能です。安定版の cmux Mac はまだ通知しないため、接続中の Mac でもサーバーハートビートが表示されないことがあります。プレゼンスがオンラインなのに「この電話」が未接続の場合、Mac は他からは到達できるが電話からは到達できません。通常は Tailscale かルートの問題です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Präsenz ist der Herzschlag des Mac für den Präsenzdienst, der derzeit nur für DEV verfügbar ist. Stabile cmux-Macs kündigen dies noch nicht an, daher zeigt ein Mac, mit dem Sie verbunden sind, möglicherweise keinen Server-Heartbeat an. Wenn bei Anwesenheit „Online“ angezeigt wird, dieses Telefon aber nicht verbunden ist, ist der Mac woanders erreichbar, jedoch nicht von Ihrem Telefon aus. Normalerweise liegt ein Tailscale- oder Routenproblem vor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence is the Mac's own heartbeat to the presence service, which is currently a DEV-only feature. Stable cmux Macs don't announce it yet, so a Mac you're connected to may show no server heartbeat. If presence says online but This phone is not connected, the Mac is reachable elsewhere but not from your phone, usually a Tailscale or route problem."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence is the Mac's own heartbeat to the presence service, which is currently a DEV-only feature. Stable cmux Macs don't announce it yet, so a Mac you're connected to may show no server heartbeat. If presence says online but This phone is not connected, the Mac is reachable elsewhere but not from your phone, usually a Tailscale or route problem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence is the Mac's own heartbeat to the presence service, which is currently a DEV-only feature. Stable cmux Macs don't announce it yet, so a Mac you're connected to may show no server heartbeat. If presence says online but This phone is not connected, the Mac is reachable elsewhere but not from your phone, usually a Tailscale or route problem."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence is the Mac's own heartbeat to the presence service, which is currently a DEV-only feature. Stable cmux Macs don't announce it yet, so a Mac you're connected to may show no server heartbeat. If presence says online but This phone is not connected, the Mac is reachable elsewhere but not from your phone, usually a Tailscale or route problem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence is the Mac's own heartbeat to the presence service, which is currently a DEV-only feature. Stable cmux Macs don't announce it yet, so a Mac you're connected to may show no server heartbeat. If presence says online but This phone is not connected, the Mac is reachable elsewhere but not from your phone, usually a Tailscale or route problem."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence is the Mac's own heartbeat to the presence service, which is currently a DEV-only feature. Stable cmux Macs don't announce it yet, so a Mac you're connected to may show no server heartbeat. If presence says online but This phone is not connected, the Mac is reachable elsewhere but not from your phone, usually a Tailscale or route problem."
          }
        }
      }
    },
    "mobile.computers.presenceFooter.official": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence is the Mac's own heartbeat to the presence service. Not every Mac reports it yet, so a Mac you're connected to may show no server heartbeat. If presence says online but This phone is not connected, the Mac is reachable elsewhere but not from your phone, usually a Tailscale or route problem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレゼンスは Mac 自身のプレゼンスサービスへのハートビートです。まだすべての Mac が通知するわけではないため、接続中の Mac でもサーバーハートビートが表示されないことがあります。プレゼンスがオンラインなのに「この電話」が未接続の場合、Mac は他からは到達できるが電話からは到達できません。通常は Tailscale かルートの問題です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Präsenz ist der Herzschlag des Mac für den Präsenzdienst. Da dies noch nicht von jedem Mac gemeldet wird, zeigt ein Mac, mit dem Sie verbunden sind, möglicherweise keinen Server-Heartbeat an. Wenn bei Anwesenheit „Online“ angezeigt wird, dieses Telefon aber nicht verbunden ist, ist der Mac woanders erreichbar, jedoch nicht von Ihrem Telefon aus. Normalerweise liegt ein Tailscale- oder Routenproblem vor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence is the Mac's own heartbeat to the presence service. Not every Mac reports it yet, so a Mac you're connected to may show no server heartbeat. If presence says online but This phone is not connected, the Mac is reachable elsewhere but not from your phone, usually a Tailscale or route problem."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence is the Mac's own heartbeat to the presence service. Not every Mac reports it yet, so a Mac you're connected to may show no server heartbeat. If presence says online but This phone is not connected, the Mac is reachable elsewhere but not from your phone, usually a Tailscale or route problem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence is the Mac's own heartbeat to the presence service. Not every Mac reports it yet, so a Mac you're connected to may show no server heartbeat. If presence says online but This phone is not connected, the Mac is reachable elsewhere but not from your phone, usually a Tailscale or route problem."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence is the Mac's own heartbeat to the presence service. Not every Mac reports it yet, so a Mac you're connected to may show no server heartbeat. If presence says online but This phone is not connected, the Mac is reachable elsewhere but not from your phone, usually a Tailscale or route problem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence is the Mac's own heartbeat to the presence service. Not every Mac reports it yet, so a Mac you're connected to may show no server heartbeat. If presence says online but This phone is not connected, the Mac is reachable elsewhere but not from your phone, usually a Tailscale or route problem."
          }
        },
