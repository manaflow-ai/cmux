          "stringUnit": {
            "state": "translated",
            "value": "cmux paused new connections because earlier connection cleanups are still stuck."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前の接続クリーンアップが停止したままのため、新しい接続を一時停止しました。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
