    "mobile.setupHelp.sameAccountFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both devices must be signed in to the same cmux account. A private network never replaces that check."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方の端末は同じcmuxアカウントでサインインする必要があります。プライベートネットワークがこの確認を置き換えることはありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Geräte müssen bei demselben cmux-Konto angemeldet sein. Ein privates Netzwerk ersetzt diese Überprüfung niemals."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Both devices must be signed in to the same cmux account. A private network never replaces that check."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Both devices must be signed in to the same cmux account. A private network never replaces that check."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Both devices must be signed in to the same cmux account. A private network never replaces that check."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Both devices must be signed in to the same cmux account. A private network never replaces that check."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Both devices must be signed in to the same cmux account. A private network never replaces that check."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Both devices must be signed in to the same cmux account. A private network never replaces that check."
          }
        }
      }
    },
    "mobile.setupHelp.signInBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to cmux on this phone with the same account your computer uses. Once you sign in, your computer is found automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末で、コンピュータと同じアカウントを使ってcmuxにサインインします。サインインすると、コンピュータは自動的に見つかります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich auf diesem Telefon mit demselben Konto bei cmux an, das Ihr Computer verwendet. Sobald Sie sich angemeldet haben, wird Ihr Computer automatisch gefunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to cmux on this phone with the same account your computer uses. Once you sign in, your computer is found automatically."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to cmux on this phone with the same account your computer uses. Once you sign in, your computer is found automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to cmux on this phone with the same account your computer uses. Once you sign in, your computer is found automatically."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to cmux on this phone with the same account your computer uses. Once you sign in, your computer is found automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
