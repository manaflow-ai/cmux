    "mobile.settings.shellIconLab.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first value is icon size. Stroke weights are 400 regular, 500 medium, and 600 semibold. α changes contrast; ○ changes circle size. Choose a variant, then reopen New Task."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の値はアイコンサイズです。線の太さは 400 がレギュラー、500 がミディアム、600 がセミボールドです。α はコントラスト、○ は円のサイズを変更します。バリエーションを選び、もう一度「新規タスク」を開いてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erste Wert ist die Symbolgröße. Die Strichstärken betragen 400 normal, 500 mittel und 600 halbfett. α verändert den Kontrast; ○ ändert die Kreisgröße. Wählen Sie eine Variante und öffnen Sie dann „Neue Aufgabe“ erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première valeur est la taille de l'icône. Les poids des traits sont de 400 réguliers, 500 moyens et 600 semi-gras. α change le contraste ; ○ modifie la taille du cercle. Choisissez une variante, puis rouvrez Nouvelle tâche."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القيمة الأولى هي حجم الرمز. أوزان الأشواط هي 400 عادية و500 متوسطة و600 نصف غامقة. α يغير التباين؛ ○ تغيير حجم الدائرة. اختر متغيرًا، ثم أعد فتح مهمة جديدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El primer valor es el tamaño del icono. Los pesos de los trazos son 400 regulares, 500 medios y 600 seminegritas. α cambia el contraste; ○ cambia el tamaño del círculo. Elija una variante y luego vuelva a abrir Nueva tarea."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第一個值是圖示大小。筆畫粗細為常規筆畫 400、中粗體 500 和半粗體 600。 α 改變對比； ○ 更改圓圈大小。選擇一個變體，然後重新開啟「新任務」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一个值是图标大小。笔画粗细为常规笔画 400、中等粗体 500 和半粗体 600。 α 改变对比度； ○ 更改圆圈大小。选择一个变体，然后重新打开“新任务”。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 번째 값은 아이콘 크기입니다. 획 두께는 일반 400, 중간 500, 세미볼드 600입니다. α는 대비를 변경합니다. ○ 원의 크기를 변경합니다. 변형을 선택한 다음 새 작업을 다시 엽니다."
          }
        }
      }
    },
