    "mobile.pairing.connectTimedOutFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No response from %@:%d. Make sure the Mac is awake, cmux is running, and the private route is active."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%d から応答がありません。Macが起動していてcmuxが実行中であり、プライベート経路が有効か確認してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Antwort von %@:%d. Stellen Sie sicher, dass der Mac aktiv ist, cmux ausgeführt wird und die private Route aktiv ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune réponse de %@:%d. Assurez-vous que le Mac est réveillé, que cmux est en cours d'exécution et que la route privée est active."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد استجابة من %@:%d. تأكد من أن جهاز Mac نشط، وأن cmux قيد التشغيل، وأن المسار الخاص نشط."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay respuesta de %@:%d. Asegúrese de que la Mac esté activa, cmux esté ejecutándose y la ruta privada esté activa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%d 無回應。確保 Mac 已喚醒、cmux 正在運作並且專用路由處於活動狀態。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%d 无响应。确保 Mac 已唤醒、cmux 正在运行并且专用路由处于活动状态。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%d에서 응답이 없습니다. Mac이 깨어 있고 cmux가 실행 중이며 개인 경로가 활성화되어 있는지 확인하십시오."
          }
        }
      }
    },
    "mobile.pairing.connectionDroppedFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected to %@:%d, but the host closed the connection. Check that the host app is still running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%d に接続しましたが、ホストが接続を閉じました。ホストアプリがまだ実行中であることを確認してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbunden mit %@:%d, aber der Host hat die Verbindung geschlossen. Überprüfen Sie, ob die Host-App noch ausgeführt wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté à %@:%d, mais l'hôte a fermé la connexion. Vérifiez que l'application hôte est toujours en cours d'exécution."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متصل بـ %@:%d، لكن المضيف أغلق الاتصال. تأكد من أن التطبيق المضيف لا يزال قيد التشغيل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado a %@:%d, pero el host cerró la conexión. Compruebe que la aplicación host todavía se esté ejecutando."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接到 %@:%d，但主機關閉了連線。檢查主機應用程式是否仍在執行。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接到 %@:%d，但主机关闭了连接。检查主机应用程序是否仍在运行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%d에 연결되었지만 호스트가 연결을 닫았습니다. 호스트 앱이 아직 실행 중인지 확인하세요."
          }
        }
      }
    },
    "mobile.pairing.connectionFailedFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach %@:%d. Check that the saved private network or LAN route is active and that the port is correct."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%d に到達できませんでした。保存済みのプライベートネットワークまたはLAN経路が有効で、ポートが正しいか確認してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%d konnte nicht erreicht werden. Überprüfen Sie, ob das gespeicherte private Netzwerk oder die LAN-Route aktiv ist und der Port korrekt ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'atteindre %@:%d. Vérifiez que le réseau privé ou la route LAN enregistré est actif et que le port est correct."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الوصول إلى %@:%d. تأكد من أن الشبكة الخاصة المحفوظة أو مسار LAN نشط وأن المنفذ صحيح."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo acceder a %@:%d. Compruebe que la red privada o la ruta LAN guardada esté activa y que el puerto sea correcto."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法到達 %@:%d。檢查已儲存的私人網路或 LAN 路由是否處於活動狀態以及連接埠是否正確。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法到达 %@:%d。检查保存的私网或 LAN 路由是否处于活动状态以及端口是否正确。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%d에 연결할 수 없습니다. 저장된 개인 네트워크 또는 LAN 경로가 활성화되어 있고 포트가 올바른지 확인하십시오."
          }
        }
      }
    },
    "mobile.pairing.connectionTimedOutFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No response from %@:%d. Make sure the host app is open and accepting mobile connections."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%d から応答がありません。ホストアプリが開いていて、モバイル接続を受け入れていることを確認してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Antwort von %@:%d. Stellen Sie sicher, dass die Host-App geöffnet ist und mobile Verbindungen akzeptiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune réponse de %@:%d. Assurez-vous que l'application hôte est ouverte et accepte les connexions mobiles."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد استجابة من %@:%d. تأكد من أن التطبيق المضيف مفتوح ويقبل اتصالات الهاتف المحمول."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay respuesta de %@:%d. Asegúrese de que la aplicación host esté abierta y acepte conexiones móviles."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%d 無回應。確保主機應用程式已開啟並接受行動連線。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%d 无响应。确保主机应用程序已打开并接受移动连接。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%d에서 응답이 없습니다. 호스트 앱이 열려 있고 모바일 연결을 허용하는지 확인하세요."
          }
        }
      }
    },
    "mobile.pairing.dnsFailedFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't resolve %@. Check the DNS or private network that provides this saved route."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を解決できませんでした。この保存済み経路を提供するDNSまたはプライベートネットワークを確認してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht aufgelöst werden. Überprüfen Sie den DNS oder das private Netzwerk, das diese gespeicherte Route bereitstellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de résoudre %@. Vérifiez le DNS ou le réseau privé qui fournit cet itinéraire enregistré."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر حل %@. تحقق من DNS أو الشبكة الخاصة التي توفر هذا المسار المحفوظ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo resolver %@. Verifique el DNS o la red privada que proporciona esta ruta guardada."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法解析 %@。檢查提供此已儲存路由的 DNS 或專用網路。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解析 %@。检查提供此已保存路由的 DNS 或专用网络。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@를 확인할 수 없습니다. 저장된 경로를 제공하는 DNS 또는 개인 네트워크를 확인하세요."
          }
        }
      }
    },
    "mobile.pairing.buildIncompatible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone build cannot connect to that cmux build."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone ビルドは、その cmux ビルドに接続できません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser iPhone-Build kann keine Verbindung zu diesem cmux-Build herstellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version d'iPhone ne peut pas se connecter à cette version cmux."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لإصدار iPhone هذا الاتصال بإصدار cmux هذا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilación de iPhone no puede conectarse a esa compilación de cmux."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPhone 版本無法連接到該 cmux 版本。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPhone 版本无法连接到该 cmux 版本。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone 빌드는 해당 cmux 빌드에 연결할 수 없습니다."
          }
        }
      }
    },
    "mobile.pairing.buildIncompatible.official": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac runs an incompatible version of cmux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac は互換性のないバージョンの cmux を実行しています。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Mac wird eine inkompatible Version von cmux ausgeführt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac exécute une version incompatible de cmux."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم جهاز Mac هذا بتشغيل إصدار غير متوافق من cmux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Mac ejecuta una versión incompatible de cmux."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 運行不相容版本的 cmux。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 运行不兼容版本的 cmux。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서는 호환되지 않는 cmux 버전을 실행하고 있습니다."
          }
        }
      }
    },
    "mobile.pairing.emailMismatchFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This QR is for %@, but this iPhone is signed in as %@. Sign in with the same email as the Mac, then scan again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この QR は %@ 用ですが、この iPhone は %@ としてサインインしています。Mac と同じメールアドレスでサインインしてから、もう一度スキャンしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser QR ist für %@, aber dieses iPhone ist als %@ angemeldet. Melden Sie sich mit derselben E-Mail-Adresse wie auf dem Mac an und scannen Sie dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce QR concerne %@, mais cet iPhone est connecté sous le nom %@. Connectez-vous avec le même e-mail que le Mac, puis numérisez à nouveau."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز QR هذا مخصص لـ %@، ولكن تم تسجيل دخول هذا الـ iPhone باسم %@. قم بتسجيل الدخول بنفس البريد الإلكتروني المسجل على جهاز Mac، ثم قم بالمسح الضوئي مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este QR es para %@, pero este iPhone está registrado como %@. Inicie sesión con el mismo correo electrónico que en Mac y luego escanee nuevamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 QR 適用於 %@，但此 iPhone 登入 %@。使用與 Mac 相同的電子郵件登錄，然後再次掃描。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 QR 适用于 %@，但此 iPhone 登录为 %@。使用与 Mac 相同的电子邮件登录，然后再次扫描。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 QR은 %@용이지만 이 iPhone은 %@로 로그인되어 있습니다. Mac과 동일한 이메일로 로그인한 후 다시 스캔하세요."
          }
        }
      }
    },
    "mobile.pairing.emailMissingFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This QR is for %@. Sign in with the same email as the Mac, then scan again."
          }
        },
        "ja": {
          "stringUnit": {
