    "mobile.connectionsUpdate.direct.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your LAN, WireGuard, or any other network: add the addresses where a computer is reachable and dial exactly those, with no fallback."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LANやWireGuardなど、コンピュータに到達できるアドレスを追加すると、そのアドレスだけに接続します。フォールバックはありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Ihrem LAN, WireGuard oder einem anderen Netzwerk: Fügen Sie die Adressen hinzu, unter denen ein Computer erreichbar ist, und wählen Sie genau diese an, ohne Rückgriff."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
