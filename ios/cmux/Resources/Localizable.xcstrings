    "mobile.iroh.debug.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing this restarts Iroh without signing out or changing this app's device identity."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定を変更すると、サインアウトせず、このアプリのデバイス ID を変更せずに Iroh が再起動します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie dies ändern, wird Iroh neu gestartet, ohne sich abzumelden oder die Geräteidentität dieser App zu ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer cela redémarre Iroh sans se déconnecter ni modifier l'identité de l'appareil de cette application."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي تغيير هذا إلى إعادة تشغيل Iroh دون تسجيل الخروج أو تغيير هوية جهاز هذا التطبيق."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cambiar esto, se reinicia Iroh sin cerrar sesión ni cambiar la identidad del dispositivo de esta aplicación."
          }
        },
        "zh-Hant": {
          "stringUnit": {
