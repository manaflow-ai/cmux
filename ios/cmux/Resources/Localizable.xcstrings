          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم وضعه في قائمة الانتظار نظرًا لعدم تسجيل دخول جهاز Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No está en cola porque la Mac no ha iniciado sesión."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於 Mac 未登錄，因此未排隊。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于 Mac 未登录，因此未排队。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 로그인되어 있지 않기 때문에 대기열에 있지 않습니다."
          }
        }
      }
    },
