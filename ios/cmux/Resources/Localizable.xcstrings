    "mobile.addDevice.signedInFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed in as %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ としてサインイン中"
          }
        }
      ,
      "zh-Hans": {
