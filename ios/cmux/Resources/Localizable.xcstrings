    "mobile.notifications.macMutationFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac did not save that change. Its last confirmed settings were restored."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macに変更を保存できませんでした。最後に確認された設定に戻しました。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac hat diese Änderung nicht gespeichert. Die letzten bestätigten Einstellungen wurden wiederhergestellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac n'a pas enregistré cette modification. Ses derniers paramètres confirmés ont été restaurés."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يقم جهاز Mac بحفظ هذا التغيير. تمت استعادة آخر إعداداته المؤكدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Mac no guardó ese cambio. Se restauraron sus últimas configuraciones confirmadas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 沒有儲存該變更。其最後確認的設定已恢復。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 没有保存该更改。其最后确认的设置已恢复。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac은 해당 변경 사항을 저장하지 않았습니다. 마지막으로 확인된 설정이 복원되었습니다."
          }
        }
      }
    },
