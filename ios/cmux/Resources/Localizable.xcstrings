    "mobile.computers.hidden.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden computers stay signed in to your account and are only hidden on this iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示のコンピュータはアカウントにサインインしたままで、このiPhoneでのみ非表示になります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeblendete Computer bleiben in Ihrem Konto angemeldet und werden nur auf diesem iPhone ausgeblendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ordinateurs masqués restent connectés à votre compte et ne sont masqués que sur cet iPhone."
