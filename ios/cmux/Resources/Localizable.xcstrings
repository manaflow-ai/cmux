    "mobile.connections.tailscaleUnauthorizedWarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No authorized Tailscale route yet — this computer stays disconnected until you add a Tailscale connection."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認済みのTailscaleルートがまだありません。Tailscale接続を追加するまで、このコンピュータは接続されません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine autorisierte Tailscale-Route – dieser Computer bleibt getrennt, bis Sie eine Tailscale-Verbindung hinzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune route Tailscale autorisée pour l'instant : cet ordinateur reste déconnecté jusqu'à ce que vous ajoutiez une connexion Tailscale."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد مسار Tailscale معتمد حتى الآن - يظل هذا الكمبيوتر غير متصل حتى تقوم بإضافة اتصال Tailscale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay una ruta autorizada de Tailscale: esta computadora permanece desconectada hasta que agregue una conexión de Tailscale."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未授權的 Tailscale 路由 — 在您新增 Tailscale 連線之前，此電腦將保持斷開連線。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无授权的 Tailscale 路由 — 在您添加 Tailscale 连接之前，此计算机将保持断开连接。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 인증된 Tailscale 경로가 없습니다. 이 컴퓨터는 Tailscale 연결을 추가할 때까지 연결이 끊어진 상태로 유지됩니다."
          }
        }
      }
    },
