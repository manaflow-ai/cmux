    "mobile.taskComposer.directoryPicker.search.limited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac returned limited search results. Browse to reach every accessible folder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacから返された検索結果は限定されています。アクセス可能なすべてのフォルダは参照して探せます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac hat begrenzte Suchergebnisse zurückgegeben. Durchsuchen Sie, um alle zugänglichen Ordner zu erreichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac a renvoyé des résultats de recherche limités. Parcourez pour atteindre tous les dossiers accessibles."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض جهاز Mac هذا نتائج بحث محدودة. استعرض للوصول إلى كل مجلد يمكن الوصول إليه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Mac arrojó resultados de búsqueda limitados. Explore para llegar a todas las carpetas accesibles."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 回傳了有限的搜尋結果。瀏覽以到達每個可存取的資料夾。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 返回了有限的搜索结果。浏览以到达每个可访问的文件夹。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac은 제한된 검색 결과를 반환했습니다. 접근 가능한 모든 폴더를 찾아보세요."
          }
        }
      }
    },
    "mobile.taskComposer.directoryPicker.search.partial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac search index did not finish in time. Refine your search or retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macの検索インデックスが時間内に完了しませんでした。検索語を絞るか、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac-Suchindex wurde nicht rechtzeitig fertiggestellt. Verfeinern Sie Ihre Suche oder versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'index de recherche Mac ne s'est pas terminé à temps. Affinez votre recherche ou réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم ينته فهرس بحث Mac في الوقت المناسب. قم بتحسين البحث أو أعد المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El índice de búsqueda de Mac no terminó a tiempo. Refine su búsqueda o vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 搜尋索引未及時完成。優化您的搜尋或重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 搜索索引未及时完成。优化您的搜索或重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 검색 색인이 제 시간에 완료되지 않았습니다. 검색 범위를 좁히거나 다시 시도하세요."
          }
        }
      }
    },
    "mobile.taskComposer.directoryPicker.search.truncated": {
      "extractionState": "manual",
      "localizations": {
