    "mobile.computers.pingFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ping opens a direct connection to each route to check if this phone can reach the Mac right now. It works even when a workspace shows Disconnected, which usually means the live stream dropped, not that the Mac is offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ping は各ルートへ直接接続を開き、この iPhone から今 Mac に到達できるかを確認します。ワークスペースが「切断されました」と表示されていても機能します。これは通常、Mac がオフラインなのではなく、ライブ接続が切れたことを意味します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ping öffnet eine direkte Verbindung zu jeder Route, um zu prüfen, ob dieses Telefon den Mac gerade erreichen kann. Es funktioniert auch dann, wenn in einem Arbeitsbereich „Getrennt“ angezeigt wird. Dies bedeutet normalerweise, dass der Livestream unterbrochen wurde und nicht, dass der Mac offline ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ping opens a direct connection to each route to check if this phone can reach the Mac right now. It works even when a workspace shows Disconnected, which usually means the live stream dropped, not that the Mac is offline."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Ping opens a direct connection to each route to check if this phone can reach the Mac right now. It works even when a workspace shows Disconnected, which usually means the live stream dropped, not that the Mac is offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ping opens a direct connection to each route to check if this phone can reach the Mac right now. It works even when a workspace shows Disconnected, which usually means the live stream dropped, not that the Mac is offline."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ping opens a direct connection to each route to check if this phone can reach the Mac right now. It works even when a workspace shows Disconnected, which usually means the live stream dropped, not that the Mac is offline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ping opens a direct connection to each route to check if this phone can reach the Mac right now. It works even when a workspace shows Disconnected, which usually means the live stream dropped, not that the Mac is offline."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ping opens a direct connection to each route to check if this phone can reach the Mac right now. It works even when a workspace shows Disconnected, which usually means the live stream dropped, not that the Mac is offline."
          }
        }
      }
    },
