    "mobile.altScreenNotice.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-screen mode mirrors the Mac terminal's exact size, so it may not fill this screen, and scrolling won't be as smooth. Claude Code: `/tui default`. Codex: restart with `codex --no-alt-screen`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全画面モードは Mac 側ターミナルのサイズをそのまま表示するため、この画面いっぱいに広がらない場合があり、スクロールも滑らかではなくなります。Claude Code: `/tui default`。Codex: `codex --no-alt-screen` で再起動。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vollbildmodus spiegelt die exakte Größe des Mac-Terminals wider, sodass er diesen Bildschirm möglicherweise nicht ausfüllt und das Scrollen nicht so reibungslos verläuft. Claude Code: „/tui default“. Codex: Neustart mit „codex --no-alt-screen“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-screen mode mirrors the Mac terminal's exact size, so it may not fill this screen, and scrolling won't be as smooth. Claude Code: `/tui default`. Codex: restart with `codex --no-alt-screen`."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-screen mode mirrors the Mac terminal's exact size, so it may not fill this screen, and scrolling won't be as smooth. Claude Code: `/tui default`. Codex: restart with `codex --no-alt-screen`."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-screen mode mirrors the Mac terminal's exact size, so it may not fill this screen, and scrolling won't be as smooth. Claude Code: `/tui default`. Codex: restart with `codex --no-alt-screen`."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-screen mode mirrors the Mac terminal's exact size, so it may not fill this screen, and scrolling won't be as smooth. Claude Code: `/tui default`. Codex: restart with `codex --no-alt-screen`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-screen mode mirrors the Mac terminal's exact size, so it may not fill this screen, and scrolling won't be as smooth. Claude Code: `/tui default`. Codex: restart with `codex --no-alt-screen`."
