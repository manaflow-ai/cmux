    "mobile.onboarding.tailscaleBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale is a free app that gives your devices a private network. Do this once, on both the phone and the Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscaleは、端末同士をプライベートなネットワークでつなぐ無料アプリです。iPhoneとMacの両方で一度だけ設定してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale ist eine kostenlose App, die Ihren Geräten ein privates Netzwerk bietet. Tun Sie dies einmal, sowohl auf dem Telefon als auch auf dem Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale est une application gratuite qui donne à vos appareils un réseau privé. Faites-le une fois, sur le téléphone et sur le Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale هو تطبيق مجاني يمنح أجهزتك شبكة خاصة. قم بذلك مرة واحدة، على كل من الهاتف وجهاز Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale es una aplicación gratuita que brinda a tus dispositivos una red privada. Haga esto una vez, tanto en el teléfono como en la Mac."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 是一款免費應用程序，可為您的裝置提供專用網路。在手机和 Mac 上执行此操作一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 是一款免费应用程序，可为您的设备提供专用网络。在手机和 Mac 上执行此操作一次。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale은 장치에 개인 네트워크를 제공하는 무료 앱입니다. 휴대폰과 Mac 모두에서 이 작업을 한 번만 수행합니다."
          }
        }
      }
    },
