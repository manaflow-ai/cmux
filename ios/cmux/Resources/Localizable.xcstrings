        }
      }
    },
    "mobile.connections.forget.failedMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account revoke didn't go through. Check the connection and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントからの解除が完了しませんでした。接続を確認してからもう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kontosperrung wurde nicht durchgeführt. Überprüfen Sie die Verbindung und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La révocation du compte n'a pas abouti. Vérifiez la connexion et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتم عملية إلغاء الحساب. تحقق من الاتصال وحاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La revocación de la cuenta no se realizó. Verifique la conexión y vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳號撤銷沒有成功。檢查連接並重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帐户撤销没有成功。检查连接并重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 해지가 처리되지 않았습니다. 연결을 확인하고 다시 시도해 보세요."
          }
        }
      }
    },
    "mobile.connections.direct.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled addresses feed the encrypted dial as hints; the connection is always identity-checked. Ports are optional."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なアドレスは暗号化されたダイヤルのヒントとして使われ、接続は常にID検証されます。ポートは省略可能です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivierte Adressen speisen die verschlüsselte Anwahl als Hinweise; Die Verbindung wird immer identitätsgeprüft. Ports sind optional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les adresses activées alimentent la numérotation cryptée sous forme d'indices ; la connexion est toujours vérifiée. Les ports sont facultatifs."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل العناوين الممكّنة على تغذية الاتصال المشفر كتلميحات؛ يتم دائمًا التحقق من هوية الاتصال. المنافذ اختيارية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las direcciones habilitadas alimentan el dial cifrado como sugerencias; la conexión siempre se verifica por identidad. Los puertos son opcionales."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用的地址將加密的撥號作為提示提供；連接始終經過身份檢查。連接埠是可選的。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用的地址将加密的拨号作为提示提供；连接始终经过身份检查。端口是可选的。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화된 주소는 암호화된 다이얼을 힌트로 제공합니다. 연결은 항상 신원이 확인됩니다. 포트는 선택 사항입니다."
          }
        }
      }
    },
    "mobile.connections.direct.labelPlaceholder": {
