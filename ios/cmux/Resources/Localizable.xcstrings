    "mobile.signIn.restoreTimeoutMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على cmux إنهاء فحص الجلسة المحفوظة. تحقق من اتصالك، ثم أعد المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux konnte die Überprüfung Ihrer gespeicherten Sitzung nicht abschließen. Überprüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux could not finish checking your saved session. Check your connection, then retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no pudo terminar de verificar su sesión guardada. Verifique su conexión y luego vuelva a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux n'a pas pu terminer la vérification de votre session enregistrée. Vérifiez votre connexion, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux は保存済みセッションの確認を完了できませんでした。接続を確認してから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 저장된 세션 확인을 완료할 수 없습니다. 연결을 확인한 후 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 无法完成检查您保存的会话。检查您的连接，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 無法完成檢查您已儲存的會話。檢查您的連接，然後重試。"
          }
        }
      }
    },
