          "stringUnit": {
            "state": "translated",
            "value": "التحقق من جلستك المحفوظة. يتم إيقاف خيارات تسجيل الدخول مؤقتًا حتى ينتهي هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie Ihre gespeicherte Sitzung. Die Anmeldeoptionen werden angehalten, bis dieser Vorgang abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking your saved session. Sign-in options are paused until this finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobando su sesión guardada. Las opciones de inicio de sesión están en pausa hasta que esto finalice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification de votre session enregistrée. Les options de connexion sont suspendues jusqu'à la fin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みセッションを確認しています。完了するまでサインイン操作は一時停止されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 세션을 확인하는 중입니다. 이 작업이 완료될 때까지 로그인 옵션이 일시중지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查您保存的会话。登录选项将暂停，直至完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查您儲存的會話。登入選項將暫停，直至完成。"
          }
        }
      }
    },
    "mobile.signIn.sentCodeFormat": {
