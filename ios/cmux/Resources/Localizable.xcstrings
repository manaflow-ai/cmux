    "mobile.deviceTree.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices and their cmux builds come from your team's registry. Tap a build to connect, then a workspace to open it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスとそのcmuxビルドはチームのレジストリから取得されます。ビルドをタップして接続し、ワークスペースをタップして開きます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräte und ihre cmux-Builds stammen aus der Registrierung Ihres Teams. Tippen Sie auf einen Build, um eine Verbindung herzustellen, und dann auf einen Arbeitsbereich, um ihn zu öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appareils et leurs versions cmux proviennent du registre de votre équipe. Appuyez sur une version pour vous connecter, puis sur un espace de travail pour l'ouvrir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأتي الأجهزة وإصدارات cmux الخاصة بها من سجل فريقك. اضغط على أحد الإصدارات للاتصال به، ثم على مساحة العمل لفتحه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dispositivos y sus compilaciones cmux provienen del registro de su equipo. Toque una compilación para conectarse y luego un espacio de trabajo para abrirla."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設備及其 cmux 版本來自您團隊的註冊表。點擊要連接的構建，然後點擊工作區將其打開。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备及其 cmux 版本来自您团队的注册表。点击要连接的构建，然后点击工作区将其打开。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장치 및 해당 cmux 빌드는 팀의 레지스트리에서 가져옵니다. 빌드를 탭하여 연결한 다음 작업공간을 탭하여 엽니다."
          }
        }
      }
    },
