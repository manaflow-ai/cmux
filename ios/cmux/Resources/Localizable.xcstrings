    "mobile.notifications.awayExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only When Away sends after the Mac is locked, asleep, or inactive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「離席中のみ」では、Macがロック中、スリープ中、または操作されていないときに送信します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nur bei Abwesenheit“ wird gesendet, nachdem der Mac gesperrt, im Ruhezustand oder inaktiv ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement en cas d'absence envoie une fois que le Mac est verrouillé, endormi ou inactif."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم إرسال رسالة \"فقط عندما تكون بالخارج\" بعد أن يكون جهاز Mac مقفلاً أو في وضع السكون أو غير نشط."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cuando está ausente se envía después de que la Mac esté bloqueada, suspendida o inactiva."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在離開時在 Mac 鎖定、睡眠或不活動後發送。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当离开时在 Mac 锁定、睡眠或不活动后发送。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 잠겨 있거나, 잠자기 상태이거나, 비활성 상태일 때 자리 비울 때만 전송됩니다."
          }
        }
      }
    },
