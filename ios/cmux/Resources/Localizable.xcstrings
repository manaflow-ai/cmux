    "mobile.iroh.private.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh discovers LAN and VPN paths after authenticating the Mac. Custom raw TCP routes are not accepted because they cannot prove the remote Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh は Mac を認証した後、LAN および VPN 経路を検出します。カスタムの生 TCP ルートはリモート Mac を証明できないため受け付けません。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "Iroh 会在验证 Mac 后自动发现局域网和 VPN 路径。不接受自定义原始 TCP 路由，因为它们无法证明远程 Mac 的身份。"
        }
      }}
    },
    "mobile.iroh.private.iroh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
