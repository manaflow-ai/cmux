    "mobile.autoConnectMigration.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh needs cmux 0.64.20 or later on your Mac for its authenticated, end-to-end encrypted connection."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Irohには、認証済みのエンドツーエンド暗号化接続に対応したMac版cmux 0.64.20以降が必要です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die authentifizierte, Ende-zu-Ende-verschlüsselte Verbindung benötigt Iroh cmux 0.64.20 oder höher auf Ihrem Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh a besoin de cmux 0.64.20 ou version ultérieure sur votre Mac pour sa connexion authentifiée et cryptée de bout en bout."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج Iroh إلى الإصدار cmux 0.64.20 أو إصدار أحدث على جهاز Mac لديك للاتصال المشفر والمصادق عليه من طرف إلى طرف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh necesita cmux 0.64.20 o posterior en su Mac para su conexión autenticada y cifrada de extremo a extremo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh 需要在 Mac 上安裝 cmux 0.64.20 或更高版本才能實現經過驗證的端對端加密連線。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh 需要在 Mac 上安装 cmux 0.64.20 或更高版本才能实现经过身份验证的端到端加密连接。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh는 인증되고 종단 간 암호화된 연결을 위해 Mac에 cmux 0.64.20 이상이 필요합니다."
          }
        }
      }
    },
