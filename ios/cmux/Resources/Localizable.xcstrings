    "mobile.connection.toast.unavailableMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The live connection dropped. Your Mac may still be online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ接続が切断されました。Mac はまだオンラインの可能性があります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Live-Verbindung wurde unterbrochen. Möglicherweise ist Ihr Mac noch online."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion en direct a été interrompue. Votre Mac est peut-être toujours en ligne."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع الاتصال المباشر. ربما لا يزال جهاز Mac الخاص بك متصلاً بالإنترنت."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión en vivo se cortó. Es posible que tu Mac todavía esté en línea."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時連線斷開。您的 Mac 可能仍然在線。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时连接断开。您的 Mac 可能仍然在线。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브 연결이 끊어졌습니다. Mac이 아직 온라인 상태일 수 있습니다."
          }
        }
      }
    },
    "mobile.connection.unavailableDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The live connection dropped. The selected cmux build may still be online. Tap Reconnect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ接続が切断されました。選択した cmux ビルドはまだオンラインの可能性があります。再接続をタップしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Live-Verbindung wurde unterbrochen. Der ausgewählte cmux-Build ist möglicherweise noch online. Tippen Sie auf „Erneut verbinden“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion en direct a été interrompue. La version cmux sélectionnée est peut-être toujours en ligne. Appuyez sur Reconnecter."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع الاتصال المباشر. ربما لا يزال إصدار cmux المحدد متصلاً بالإنترنت. اضغط على إعادة الاتصال."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión en vivo se cortó. Es posible que la compilación cmux seleccionada todavía esté en línea. Toca Reconectar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時連線斷開。所選的 cmux 版本可能仍然在線。點選重新連線。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时连接断开。所选的 cmux 版本可能仍然在线。点击重新连接。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브 연결이 끊어졌습니다. 선택한 cmux 빌드가 아직 온라인 상태일 수 있습니다. 다시 연결을 탭하세요."
          }
