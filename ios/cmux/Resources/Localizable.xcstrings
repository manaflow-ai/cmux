    "mobile.addDevice.tailscaleNumericRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For Tailscale pairing, enter the Mac's numeric Tailscale IP or scan its QR. MagicDNS names and local or LAN hosts aren't supported."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale でペアリングするには、Mac の数値 Tailscale IP アドレスを入力するか QR をスキャンしてください。MagicDNS 名やローカル／LAN ホストはサポートされません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie für die Tailscale-Kopplung die numerische Tailscale-IP des Mac ein oder scannen Sie dessen QR. MagicDNS-Namen und lokale oder LAN-Hosts werden nicht unterstützt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour le couplage Tailscale, entrez l’adresse IP Tailscale numérique du Mac ou scannez son QR. Les noms MagicDNS et les hôtes locaux ou LAN ne sont pas pris en charge."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لإقران Tailscale، أدخل عنوان Tailscale IP الرقمي لجهاز Mac أو قم بمسح QR الخاص به. أسماء MagicDNS والمضيفين المحليين أو مضيفي الشبكة المحلية (LAN) غير مدعومين."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para el emparejamiento de Tailscale, ingrese la IP numérica de Tailscale de la Mac o escanee su QR. No se admiten nombres MagicDNS ni hosts locales o LAN."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對於 Tailscale 配對，請輸入 Mac 的數位 Tailscale IP 或掃描其 QR。不支援 MagicDNS 名稱和本機或 LAN 主機。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对于 Tailscale 配对，请输入 Mac 的数字 Tailscale IP 或扫描其 QR。不支持 MagicDNS 名称和本地或 LAN 主机。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 페어링의 경우 Mac의 숫자 Tailscale IP를 입력하거나 QR을 스캔하세요. MagicDNS 이름과 로컬 또는 LAN 호스트는 지원되지 않습니다."
          }
        }
      }
    },
