    "mobile.iroh.relays.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct peer-to-peer stays enabled. cmux verifies a signed relay catalog, so fleet changes do not require an app update."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピアツーピアの直接接続は有効なままです。cmux は署名済みリレーカタログを検証するため、フリート変更にアプリ更新は不要です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkter Peer-to-Peer bleibt aktiviert. cmux überprüft einen signierten Relay-Katalog, sodass Flottenänderungen kein App-Update erfordern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct peer-to-peer stays enabled. cmux verifies a signed relay catalog, so fleet changes do not require an app update."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct peer-to-peer stays enabled. cmux verifies a signed relay catalog, so fleet changes do not require an app update."
