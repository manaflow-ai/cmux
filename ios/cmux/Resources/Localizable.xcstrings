    "mobile.surface.explainer.agentSession": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This agent session is running in cmux on your Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエージェントセッションはMacのcmuxで実行中です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Agentensitzung wird in cmux auf Ihrem Mac ausgeführt."
          }
        },
        "fr": {
