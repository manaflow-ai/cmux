    "mobile.connection.routeCleanupBlocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection cleanup is stuck. Restart cmux on this device before reconnecting."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続のクリーンアップが停止しています。再接続する前に、このデバイスのcmuxを再起動してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindungsbereinigung bleibt hängen. Starten Sie cmux auf diesem Gerät neu, bevor Sie die Verbindung wiederherstellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nettoyage de la connexion est bloqué. Redémarrez cmux sur cet appareil avant de vous reconnecter."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عملية تنظيف الاتصال عالقة. أعد تشغيل cmux على هذا الجهاز قبل إعادة الاتصال."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La limpieza de la conexión está bloqueada. Reinicie cmux en este dispositivo antes de volver a conectarse."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接清理被卡住。重新連線之前，請重新啟動該裝置上的 cmux。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接清理被卡住。重新连接之前，请重新启动该设备上的 cmux。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 정리가 중단되었습니다. 다시 연결하기 전에 이 장치에서 cmux를 다시 시작하세요."
          }
        }
      }
    },
