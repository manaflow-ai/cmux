    "mobile.settings.connectionMethod.directFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dials this computer's encrypted Iroh identity using the addresses you enable below — for LAN, WireGuard, or any network where it's reachable. No relay discovery, no other computers' routes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下で有効にしたアドレスを使って、このコンピュータの暗号化されたIroh IDにダイヤルします。LAN、WireGuardなど到達可能なあらゆるネットワークで使えます。リレー探索や他のコンピュータのルートは使いません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählt die verschlüsselte Iroh-Identität dieses Computers mithilfe der unten aktivierten Adressen – für LAN, WireGuard oder jedes Netzwerk, in dem er erreichbar ist. Keine Relay-Erkennung, keine Routen anderer Computer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose l'identité Iroh cryptée de cet ordinateur à l'aide des adresses que vous activez ci-dessous – pour LAN, WireGuard ou tout réseau où il est accessible. Pas de découverte de relais, pas de routes d'autres ordinateurs."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتصل بهوية Iroh المشفرة لهذا الكمبيوتر باستخدام العناوين التي تقوم بتمكينها أدناه - لشبكة LAN أو WireGuard أو أي شبكة يمكن الوصول إليها. لا يوجد اكتشاف للتتابع ولا توجد مسارات لأجهزة الكمبيوتر الأخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca la identidad cifrada de Iroh de esta computadora utilizando las direcciones que habilita a continuación: para LAN, WireGuard o cualquier red donde sea accesible. Sin descubrimiento de retransmisiones, ni rutas de otras computadoras."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用您在下方啟用的位址（適用於 LAN、WireGuard 或任何可存取的網路）撥打此電腦的加密 Iroh 身分。沒有中繼發現，沒有其他計算機的路由。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用您在下面启用的地址（对于 LAN、WireGuard 或任何可访问的网络）拨打此计算机的加密 Iroh 身份。没有中继发现，没有其他计算机的路由。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LAN, WireGuard 또는 연결할 수 있는 모든 네트워크에 대해 아래에서 활성화한 주소를 사용하여 이 컴퓨터의 암호화된 Iroh ID에 전화를 겁니다. 릴레이 검색도 없고 다른 컴퓨터의 경로도 없습니다."
          }
        }
      }
    },
