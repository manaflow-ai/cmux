    "mobile.workspaces.sort.order.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workspaces keep each computer's own order. Drag computers to choose which come first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースは各コンピュータ内の順序を保ちます。コンピュータをドラッグして表示順を選べます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeitsbereiche behalten die eigene Reihenfolge jedes Computers bei. Ziehen Sie Computer, um auszuwählen, welche zuerst kommen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les espaces de travail conservent le propre ordre de chaque ordinateur. Faites glisser les ordinateurs pour choisir lequel vient en premier."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتفظ مساحات العمل بالترتيب الخاص بكل كمبيوتر. اسحب أجهزة الكمبيوتر لاختيار أي منها يأتي أولاً."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los espacios de trabajo mantienen el orden propio de cada computadora. Arrastre las computadoras para elegir cuál va primero."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作區保持每台電腦自己的順序。拖曳電腦以選擇先出現的電腦。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作区保持每台计算机自己的顺序。拖动计算机以选择先出现的计算机。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 공간은 각 컴퓨터의 고유한 순서를 유지합니다. 컴퓨터를 드래그하여 먼저 오는 것을 선택하세요."
          }
        }
      }
    },
    "mobile.workspaces.sort.order.title": {
