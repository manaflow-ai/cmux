    "mobile.notificationFeed.update.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the latest cmux on your paired Macs to sync their notification history."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングしたMacのcmuxを最新版に更新すると、通知履歴を同期できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installieren Sie das neueste cmux auf Ihren gekoppelten Macs, um deren Benachrichtigungsverlauf zu synchronisieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez la dernière version de cmux sur vos Mac couplés pour synchroniser leur historique de notifications."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتثبيت أحدث إصدار من cmux على أجهزة Mac المقترنة لديك لمزامنة سجل الإشعارات الخاص بها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale el último cmux en sus Mac emparejadas para sincronizar su historial de notificaciones."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在配對的 Mac 上安裝最新的 cmux 以同步其通知記錄。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在配对的 Mac 上安装最新的 cmux 以同步其通知历史记录。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 기록을 동기화하려면 페어링된 Mac에 최신 cmux를 설치하세요."
          }
        }
      }
    },
    "mobile.notificationFeed.update.inlineBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some paired Macs cannot sync notifications yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
