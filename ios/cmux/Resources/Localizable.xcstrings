    "mobile.connectionsUpdate.perComputer.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each computer now picks how this iPhone reaches it: Iroh, Tailscale Only, or Direct. Set it in Computers → your computer → Connection Method."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各コンピュータごとに、このiPhoneからの接続方法（Iroh・Tailscaleのみ・ダイレクト）を選べるようになりました。「コンピュータ」→ コンピュータを選択 →「接続方法」で設定できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Computer wählt nun aus, wie dieses iPhone ihn erreicht: Iroh, Tailscale Only oder Direct. Stellen Sie es unter Computer → Ihr Computer → Verbindungsmethode ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque ordinateur choisit désormais comment cet iPhone l'atteint : Iroh, Tailscale Only ou Direct. Définissez-le dans Ordinateurs → votre ordinateur → Méthode de connexion."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يختار كل كمبيوتر الآن كيفية وصول جهاز iPhone إليه: Iroh، أو Tailscale Only، أو Direct. اضبطه في أجهزة الكمبيوتر → جهاز الكمبيوتر الخاص بك → طريقة الاتصال."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada computadora ahora elige cómo llega este iPhone: Iroh, Tailscale Only o Direct. Configúrelo en Computadoras → su computadora → Método de conexión."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在，每台電腦都會選擇 iPhone 的存取方式：Iroh、Tailscale Only 或 Direct。在電腦→您的電腦→連線方法中進行設定。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在，每台计算机都会选择 iPhone 的访问方式：Iroh、Tailscale Only 或 Direct。在计算机→您的计算机→连接方法中进行设置。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 각 컴퓨터는 Iroh, Tailscale Only 또는 Direct 중에서 이 iPhone이 연결되는 방식을 선택합니다. 컴퓨터 → 내 컴퓨터 → 연결 방법에서 설정하세요."
          }
        }
      }
    },
