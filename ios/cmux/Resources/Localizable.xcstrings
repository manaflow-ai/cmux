    "mobile.notificationFeed.empty.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every agent alert from your paired Macs will collect here, even if push alerts are off. Enable push alerts in Settings only when you want an immediate heads-up away from the app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングしたすべてのMacからのエージェント通知が、プッシュ通知をオフにしていてもここに集まります。アプリを離れているときにすぐ知らせてほしい場合だけ、設定でプッシュ通知を有効にしてください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "来自已配对 Mac 的所有代理提醒都会汇集到这里，即使推送提醒已关闭。只有在你想在应用之外立即收到提醒时，才在「设置」中启用推送提醒。"
        }
      }}
    },
