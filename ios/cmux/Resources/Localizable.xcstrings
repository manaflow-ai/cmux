        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظل أجهزة الكمبيوتر المخفية مسجلة الدخول إلى حسابك وتكون مخفية فقط على جهاز iPhone هذا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las computadoras ocultas permanecen conectadas a su cuenta y solo están ocultas en este iPhone."
