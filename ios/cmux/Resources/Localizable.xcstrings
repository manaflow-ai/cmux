    "mobile.settings.deleteAccountPartialFailureMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your cmux data was deleted, but account sign-in cleanup did not finish. Try Delete Account again to complete deletion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux のデータは削除されましたが、アカウントのサインイン情報のクリーンアップは完了しませんでした。削除を完了するには、もう一度「アカウントを削除」をお試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre cmux-Daten wurden gelöscht, aber die Bereinigung der Kontoanmeldung wurde nicht abgeschlossen. Versuchen Sie erneut, das Konto zu löschen, um den Löschvorgang abzuschließen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données cmux ont été supprimées, mais le nettoyage de la connexion au compte n'a pas été terminé. Essayez à nouveau de supprimer le compte pour terminer la suppression."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حذف بيانات cmux الخاصة بك، ولكن لم تكتمل عملية تنظيف تسجيل الدخول إلى الحساب. حاول حذف الحساب مرة أخرى لإكمال الحذف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminaron sus datos cmux, pero la limpieza de inicio de sesión de la cuenta no finalizó. Intente Eliminar cuenta nuevamente para completar la eliminación."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 cmux 資料已刪除，但帳號登入清理未完成。再次尝试删除帐户以完成删除。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 cmux 数据已删除，但帐户登录清理未完成。再次尝试删除帐户以完成删除。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 데이터가 삭제되었지만 계정 로그인 정리가 완료되지 않았습니다. 삭제를 완료하려면 계정 삭제를 다시 시도하세요."
          }
        }
      }
    },
    "mobile.settings.deleteAccountServerCleanupIncompleteMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account sign-in was deleted, but some cmux cleanup did not finish. You will be signed out. Contact support if cmux data is still visible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントのサインイン情報は削除されましたが、一部の cmux クリーンアップは完了しませんでした。サインアウトします。cmux データがまだ表示される場合はサポートにお問い合わせください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung Ihres Kontos wurde gelöscht, einige cmux-Bereinigungen konnten jedoch nicht abgeschlossen werden. Sie werden abgemeldet. Wenden Sie sich an den Support, wenn cmux-Daten noch sichtbar sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion à votre compte a été supprimée, mais un nettoyage cmux n'a pas été terminé. Vous serez déconnecté. Contactez le support si les données cmux sont toujours visibles."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حذف تسجيل الدخول إلى حسابك، ولكن لم تكتمل بعض عمليات تنظيف cmux. سيتم تسجيل خروجك. اتصل بالدعم إذا كانت بيانات cmux لا تزال مرئية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión de su cuenta se eliminó, pero parte de la limpieza de cmux no finalizó. Se cerrará tu sesión. Póngase en contacto con el soporte si los datos cmux aún están visibles."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的帳號登入已刪除，但某些 cmux 清理工作未完成。您將被註銷。如果 cmux 資料仍然可見，請聯絡支援人員。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的帐户登录已删除，但某些 cmux 清理工作未完成。您将被注销。如果 cmux 数据仍然可见，请联系支持人员。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 로그인이 삭제되었지만 일부 cmux 정리가 완료되지 않았습니다. 로그아웃됩니다. cmux 데이터가 계속 표시되면 지원팀에 문의하세요."
          }
        }
      }
    },
    "mobile.settings.deleteAccountTimedOutMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account deletion timed out. Check your connection and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントの削除がタイムアウトしました。接続を確認してからもう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung beim Löschen des Kontos. Überprüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression du compte a expiré. Vérifiez votre connexion et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت مهلة حذف الحساب. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el tiempo de eliminación de la cuenta. Comprueba tu conexión y vuelve a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶刪除逾時。檢查您的連線並重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帐户删除超时。检查您的连接并重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 삭제 시간이 초과되었습니다. 연결을 확인하고 다시 시도하세요."
          }
        }
      }
    },
    "mobile.settings.deleteAccountUnauthorizedMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session is no longer valid. You will be signed out on this device. Sign in again if the account still exists."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションが無効になりました。このデバイスではサインアウトされます。アカウントがまだ存在する場合は、もう一度サインインしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Sitzung ist nicht mehr gültig. Sie werden auf diesem Gerät abgemeldet. Melden Sie sich erneut an, wenn das Konto noch vorhanden ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session n'est plus valable. Vous serez déconnecté sur cet appareil. Reconnectez-vous si le compte existe toujours."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جلستك لم تعد صالحة. سيتم تسجيل خروجك على هذا الجهاز. قم بتسجيل الدخول مرة أخرى إذا كان الحساب لا يزال موجودًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión ya no es válida. Se cerrará tu sesión en este dispositivo. Inicie sesión nuevamente si la cuenta aún existe."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的會話不再有效。您將在此裝置上登出。如果帳戶仍然存在，請重新登入。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的会话不再有效。您将在此设备上注销。如果帐户仍然存在，请重新登录。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 세션은 더 이상 유효하지 않습니다. 이 기기에서 로그아웃됩니다. 계정이 아직 존재하는 경우 다시 로그인하세요."
          }
        }
      }
    },
    "mobile.settings.deleteAccountUnknownMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't confirm whether account deletion finished. Wait a moment, then try Delete Account again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントの削除が完了したか確認できませんでした。少し待ってから、もう一度「アカウントを削除」をお試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten nicht bestätigen, ob die Kontolöschung abgeschlossen ist. Warten Sie einen Moment und versuchen Sie dann erneut, das Konto zu löschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'avons pas pu confirmer si la suppression du compte est terminée. Attendez un moment, puis réessayez de supprimer le compte."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نتمكن من تأكيد ما إذا كان حذف الحساب قد انتهى أم لا. انتظر لحظة، ثم حاول حذف الحساب مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos confirmar si finalizó la eliminación de la cuenta. Espere un momento y luego intente Eliminar cuenta nuevamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們無法確認帳戶刪除是否完成。稍等片刻，然後再次嘗試刪除帳戶。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们无法确认帐户删除是否完成。稍等片刻，然后再次尝试删除帐户。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 삭제가 완료되었는지 확인할 수 없습니다. 잠시 기다린 후 계정 삭제를 다시 시도해 보세요."
          }
        }
      }
    },
    "mobile.settings.deleteAccountMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes your cmux account and cmux data. You will be signed out on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux アカウントと cmux のデータを完全に削除します。このデバイスではサインアウトされます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden Ihr cmux-Konto und Ihre cmux-Daten dauerhaft gelöscht. Sie werden auf diesem Gerät abgemeldet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement votre compte cmux et vos données cmux. Vous serez déconnecté sur cet appareil."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى حذف حساب cmux وبيانات cmux نهائيًا. سيتم تسجيل خروجك على هذا الجهاز."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente su cuenta cmux y sus datos cmux. Se cerrará tu sesión en este dispositivo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將永久刪除您的 cmux 帳戶和 cmux 資料。您將在此裝置上登出。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除您的 cmux 帐户和 cmux 数据。您将在此设备上注销。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 cmux 계정과 cmux 데이터가 영구적으로 삭제됩니다. 이 기기에서 로그아웃됩니다."
          }
        }
      }
    },
