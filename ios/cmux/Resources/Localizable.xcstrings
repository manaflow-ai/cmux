    "mobile.pairing.guidance.buildIncompatible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A DEV iPhone build connects to its same-tag DEV Mac build, plus tags granted with 'cmux mobile compatible-tags'. BETA, INTERNAL, and App Store builds connect only to Stable or Nightly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DEV iPhone ビルドは同じタグの DEV Mac ビルドと、「cmux mobile compatible-tags」で許可されたタグに接続できます。BETA、INTERNAL、App Store ビルドは Stable または Nightly にのみ接続できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein DEV-iPhone-Build stellt eine Verbindung zu seinem DEV-Mac-Build mit demselben Tag her, plus Tags, die mit „cmux mobile kompatibel-tags“ gewährt werden. BETA-, INTERNAL- und App Store-Builds stellen nur eine Verbindung zu Stable oder Nightly her."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "A DEV iPhone build connects to its same-tag DEV Mac build, plus tags granted with 'cmux mobile compatible-tags'. BETA, INTERNAL, and App Store builds connect only to Stable or Nightly."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "A DEV iPhone build connects to its same-tag DEV Mac build, plus tags granted with 'cmux mobile compatible-tags'. BETA, INTERNAL, and App Store builds connect only to Stable or Nightly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A DEV iPhone build connects to its same-tag DEV Mac build, plus tags granted with 'cmux mobile compatible-tags'. BETA, INTERNAL, and App Store builds connect only to Stable or Nightly."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "A DEV iPhone build connects to its same-tag DEV Mac build, plus tags granted with 'cmux mobile compatible-tags'. BETA, INTERNAL, and App Store builds connect only to Stable or Nightly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "A DEV iPhone build connects to its same-tag DEV Mac build, plus tags granted with 'cmux mobile compatible-tags'. BETA, INTERNAL, and App Store builds connect only to Stable or Nightly."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "A DEV iPhone build connects to its same-tag DEV Mac build, plus tags granted with 'cmux mobile compatible-tags'. BETA, INTERNAL, and App Store builds connect only to Stable or Nightly."
