    "mobile.notificationFeed.preview.input.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote builder went offline mid-build. Choose whether to retry on another machine or keep the current artifact."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートビルダーがビルド中にオフラインになりました。別のマシンで再試行するか、現在の成果物を維持するか選んでください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Remote Builder ging mitten im Build offline. Wählen Sie, ob Sie es auf einem anderen Computer erneut versuchen oder das aktuelle Artefakt behalten möchten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le constructeur distant s'est déconnecté à mi-construction. Choisissez si vous souhaitez réessayer sur une autre machine ou conserver l'artefact actuel."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصبح المنشئ البعيد غير متصل بالإنترنت في منتصف عملية البناء. اختر ما إذا كنت تريد إعادة المحاولة على جهاز آخر أو الاحتفاظ بالعنصر الحالي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El constructor remoto se desconectó a mitad de la compilación. Elija si desea volver a intentarlo en otra máquina o conservar el artefacto actual."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端建構器在建置過程中離線。選擇是在另一台電腦上重試還是保留目前工件。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程构建器在构建过程中离线。选择是在另一台计算机上重试还是保留当前工件。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 빌더가 빌드 도중 오프라인 상태가 되었습니다. 다른 머신에서 재시도할지 아니면 현재 아티팩트를 유지할지 선택하세요."
          }
        }
      }
    },
