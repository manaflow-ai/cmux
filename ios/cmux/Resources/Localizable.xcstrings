    "mobile.settings.unreadIndicatorLab.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Higher Left Shift moves the badge closer to the screen edge. Both values persist on this device and apply live to the workspace list."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左シフトを大きくするとバッジが画面の端に近づきます。どちらの値もこのデバイスに保存され、ワークスペース一覧に即時反映されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine höhere Linksverschiebung verschiebt das Abzeichen näher an den Bildschirmrand. Beide Werte bleiben auf diesem Gerät bestehen und gelten live für die Arbeitsbereichsliste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Maj supérieur à gauche rapproche le badge du bord de l'écran. Les deux valeurs persistent sur cet appareil et s'appliquent en direct à la liste des espaces de travail."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي الضغط على Shift Left إلى تحريك الشارة بالقرب من حافة الشاشة. تظل كلتا القيمتين على هذا الجهاز ويتم تطبيقهما مباشرة على قائمة مساحة العمل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mayor desplazamiento a la izquierda acerca la insignia al borde de la pantalla. Ambos valores persisten en este dispositivo y se aplican en vivo a la lista de espacios de trabajo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "較高的左移使徽章更靠近螢幕邊緣。這兩個值都保留在此裝置上，並即時應用於工作區清單。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "较高的左移使徽章更靠近屏幕边缘。这两个值都保留在此设备上，并实时应用于工作区列表。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 Shift 키를 높이면 배지가 화면 가장자리에 더 가깝게 이동됩니다. 두 값 모두 이 장치에 유지되며 작업 공간 목록에 실시간으로 적용됩니다."
          }
        }
      }
    },
