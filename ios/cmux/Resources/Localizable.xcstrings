    "mobile.settings.telemetryFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, cmux does not send iPhone or iPad product analytics or crash reports."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフの場合、cmux は iPhone または iPad の製品分析やクラッシュレポートを送信しません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn diese Option deaktiviert ist, sendet cmux keine iPhone- oder iPad-Produktanalysen oder Absturzberichte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu'il est désactivé, cmux n'envoie pas d'analyses de produits ni de rapports d'erreur sur iPhone ou iPad."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند إيقاف تشغيله، لا يرسل cmux تحليلات منتج iPhone أو iPad أو تقارير الأعطال."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está desactivado, cmux no envía análisis de productos de iPhone o iPad ni informes de fallos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉時，cmux 不會發送 iPhone 或 iPad 產品分析或崩潰報告。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
