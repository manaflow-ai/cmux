    "mobile.pairing.unrecognizedVersion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This QR needs a newer version of cmux. Update the app and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このQRコードには新しいバージョンのcmuxが必要です。アプリを更新してからもう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser QR benötigt eine neuere Version von cmux. Aktualisieren Sie die App und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce QR nécessite une version plus récente de cmux. Mettez à jour l'application et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج QR هذا إلى إصدار أحدث من cmux. قم بتحديث التطبيق وحاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este QR necesita una versión más nueva de cmux. Actualiza la aplicación y vuelve a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 QR 需要較新版本的 cmux。更新應用程式並重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 QR 需要较新版本的 cmux。更新应用程序并重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 QR에는 최신 버전의 cmux가 필요합니다. 앱을 업데이트하고 다시 시도해 보세요."
          }
        }
      }
    },
