        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتثبيت Tailscale على هذا الهاتف وعلى جهاز Mac الخاص بك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
