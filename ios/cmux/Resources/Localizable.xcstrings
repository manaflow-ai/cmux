    "mobile.taskComposer.directoryPicker.search.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing matched in the Mac’s index or home folder. Browse to look elsewhere, and check that cmux on the Mac can access its files."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのインデックスにもホームフォルダにも一致するものはありませんでした。他の場所はブラウズで探し、Mac上のcmuxにファイルへのアクセス権があるか確認してください。"
