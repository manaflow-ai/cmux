    "mobile.addDevice.accountHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing uses this account. If it does not match the Mac, sign in to the same account, then scan the Mac QR or enter its numeric Tailscale IP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングではこのアカウントを使用します。Mac と一致しない場合は、同じアカウントでサインインしてから、Mac の QR をスキャンするか数値の Tailscale IP を入力してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Pairing wird dieses Konto verwendet. Wenn es nicht mit dem Mac übereinstimmt, melden Sie sich bei demselben Konto an, scannen Sie dann den Mac-QR oder geben Sie dessen numerische Tailscale-IP ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jumelage utilise ce compte. S'il ne correspond pas au Mac, connectez-vous au même compte, puis scannez le QR Mac ou entrez son adresse IP Tailscale numérique."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم الاقتران هذا الحساب. إذا لم يكن مطابقًا لجهاز Mac، فقم بتسجيل الدخول إلى الحساب نفسه، ثم قم بمسح Mac QR ضوئيًا أو أدخل Tailscale IP الرقمي الخاص به."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El emparejamiento utiliza esta cuenta. Si no coincide con la Mac, inicie sesión en la misma cuenta, luego escanee el QR de Mac o ingrese su IP numérica de Tailscale."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配對使用此帳戶。如果與 Mac 不匹配，請登入相同帳戶，然後掃描 Mac QR 或輸入其數位 Tailscale IP。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对使用此帐户。如果与 Mac 不匹配，请登录同一帐户，然后扫描 Mac QR 或输入其数字 Tailscale IP。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링에서는 이 계정을 사용합니다. Mac과 일치하지 않는 경우 동일한 계정으로 로그인한 다음 Mac QR을 스캔하거나 숫자로 된 Tailscale IP를 입력하세요."
          }
        }
      }
    },
