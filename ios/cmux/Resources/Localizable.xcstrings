    "mobile.iroh.attention": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your relay preference needs attention. cmux is keeping an unselected provider disabled."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リレー設定を確認してください。cmux は未選択のプロバイダーを無効のまま維持しています。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Relaispräferenz erfordert Aufmerksamkeit. cmux hält einen nicht ausgewählten Anbieter deaktiviert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre préférence de relais nécessite une attention particulière. cmux maintient un fournisseur non sélectionné désactivé."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج تفضيل الترحيل الخاص بك إلى الاهتمام. يقوم cmux بتعطيل الموفر غير المحدد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su preferencia de relevo necesita atención. cmux mantiene deshabilitado un proveedor no seleccionado."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的中繼偏好需要注意。 cmux 正在停用未選擇的提供者。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的中继偏好需要注意。 cmux 正在禁用未选择的提供程序。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "릴레이 설정에 주의가 필요합니다. cmux는 선택되지 않은 공급자를 비활성화된 상태로 유지합니다."
          }
        }
      }
    },
