    "mobile.toolbar.editor.commandFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text typed into the terminal when tapped. Turn on Run after typing to press Return automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップしたときにターミナルへ入力されるテキストです。「入力後に実行」をオンにすると、自動的にReturnが押されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text, der beim Antippen in das Terminal eingegeben wird. Aktivieren Sie nach der Eingabe die Option „Ausführen“, um automatisch die Eingabetaste zu drücken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte saisi dans le terminal lorsque vous appuyez dessus. Activez Exécuter après avoir tapé pour appuyer automatiquement sur Retour."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النص المكتوب في المحطة عند النقر عليه. قم بتشغيل \"تشغيل بعد الكتابة\" للضغط على \"رجوع\" تلقائيًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto escrito en la terminal cuando se toca. Active Ejecutar después de escribir para presionar Retorno automáticamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "点击时在终端中输入的文本。鍵入後開啟「運轉」以自動按回車鍵。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击时在终端中输入的文本。键入后打开“运行”以自动按回车键。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭할 때 터미널에 입력되는 텍스트입니다. Enter 키를 자동으로 누르려면 입력 후 실행을 켜세요."
          }
        }
      }
    },
