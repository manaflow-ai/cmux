    "mobile.connectionsUpdate.direct.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your LAN, WireGuard, or any other network: add the addresses where a computer is reachable and dial exactly those, with no fallback."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LANやWireGuardなど、コンピュータに到達できるアドレスを追加すると、そのアドレスだけに接続します。フォールバックはありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Ihrem LAN, WireGuard oder einem anderen Netzwerk: Fügen Sie die Adressen hinzu, unter denen ein Computer erreichbar ist, und wählen Sie genau diese an, ohne Rückgriff."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur votre LAN, WireGuard ou tout autre réseau : ajoutez les adresses auxquelles un ordinateur est accessible et composez exactement celles-là, sans repli."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على شبكة LAN أو WireGuard أو أي شبكة أخرى: أضف العناوين التي يمكن الوصول إلى جهاز الكمبيوتر فيها واطلبها بالضبط، دون أي تراجع."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En su LAN, WireGuard o cualquier otra red: agregue las direcciones donde se puede acceder a una computadora y márquelas exactamente, sin respaldo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 LAN、WireGuard 或任何其他網路上：新增可存取電腦的位址並準確撥打這些位址，無需後備。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 LAN、WireGuard 或任何其他网络上：添加可访问计算机的地址并准确拨打这些地址，无需后备。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LAN, WireGuard 또는 기타 네트워크에서 컴퓨터에 연결할 수 있는 주소를 추가하고 폴백 없이 정확하게 해당 주소로 전화를 겁니다."
          }
        }
      }
    },
