    "mobile.tailscalePairing.emptyDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install Tailscale on both devices and use the same Tailscale network. Open Tailscale Pairing on the Mac and scan its QR here, or enter the Mac's numeric Tailscale IP and port. To use Iroh instead, open Settings, tap Connection Method, and choose Iroh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方のデバイスに Tailscale をインストールし、同じ Tailscale ネットワークを使用してください。Mac で「Tailscale Pairing」を開き、QR をここでスキャンするか、Mac の数値 Tailscale IP アドレスとポートを入力します。Iroh を使うには、「設定」で「接続方法」を開き、「Iroh」を選択してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installieren Sie Tailscale auf beiden Geräten und nutzen Sie dasselbe Tailscale-Netzwerk. Öffnen Sie Tailscale Pairing auf dem Mac und scannen Sie hier den QR-Code oder geben Sie die numerische Tailscale-IP und den Port des Mac ein. Um stattdessen Iroh zu verwenden, öffnen Sie die Einstellungen, tippen Sie auf Verbindungsmethode und wählen Sie Iroh."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez Tailscale sur les deux appareils et utilisez le même réseau Tailscale. Ouvrez Tailscale Pairing sur le Mac et scannez son QR ici, ou entrez l'adresse IP et le port numérique Tailscale du Mac. Pour utiliser Iroh à la place, ouvrez Paramètres, appuyez sur Méthode de connexion et choisissez Iroh."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتثبيت Tailscale على كلا الجهازين واستخدم نفس شبكة Tailscale. افتح Tailscale Pairing على جهاز Mac وقم بمسح QR الخاص به هنا، أو أدخل عنوان Tailscale IP الرقمي والمنفذ الخاص بجهاز Mac. لاستخدام Iroh بدلاً من ذلك، افتح الإعدادات، وانقر فوق طريقة الاتصال، واختر Iroh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale Tailscale en ambos dispositivos y use la misma red Tailscale. Abra Tailscale Pairing en Mac y escanee su QR aquí, o ingrese la IP y el puerto numéricos de Tailscale de Mac. Para usar Iroh en su lugar, abra Configuración, toque Método de conexión y elija Iroh."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在兩台裝置上安裝 Tailscale 並使用相同的 Tailscale 網路。在 Mac 上開啟 Tailscale 配對並在此處掃描其二維碼，或輸入 Mac 的數位 Tailscale IP 和連接埠。若要使用 Iroh，請開啟“設定”，點擊“連接方法”，然後選擇“Iroh”。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在两台设备上安装 Tailscale 并使用相同的 Tailscale 网络。在 Mac 上打开 Tailscale 配对并在此处扫描其二维码，或输入 Mac 的数字 Tailscale IP 和端口。要使用 Iroh，请打开“设置”，点击“连接方法”，然后选择“Iroh”。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 장치 모두에 Tailscale을 설치하고 동일한 Tailscale 네트워크를 사용하십시오. Mac에서 Tailscale 페어링을 열고 여기에서 QR을 스캔하거나 Mac의 숫자 Tailscale IP 및 포트를 입력하세요. 대신 Iroh를 사용하려면 설정을 열고 연결 방법을 탭한 후 Iroh를 선택하세요."
          }
        }
      }
    },
    "mobile.tailscalePairing.instructions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install Tailscale on both devices and use the same Tailscale network. Open Tailscale Pairing on the Mac and scan its QR here, or enter the Mac's numeric Tailscale IP and port."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方のデバイスに Tailscale をインストールし、同じ Tailscale ネットワークを使用してください。Mac で「Tailscale Pairing」を開き、QR をここでスキャンするか、Mac の数値 Tailscale IP アドレスとポートを入力してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installieren Sie Tailscale auf beiden Geräten und nutzen Sie dasselbe Tailscale-Netzwerk. Öffnen Sie Tailscale Pairing auf dem Mac und scannen Sie hier den QR-Code oder geben Sie die numerische Tailscale-IP und den Port des Mac ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez Tailscale sur les deux appareils et utilisez le même réseau Tailscale. Ouvrez Tailscale Pairing sur le Mac et scannez son QR ici, ou entrez l'adresse IP et le port numérique Tailscale du Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتثبيت Tailscale على كلا الجهازين واستخدم نفس شبكة Tailscale. افتح Tailscale Pairing على جهاز Mac وقم بمسح QR الخاص به هنا، أو أدخل عنوان Tailscale IP الرقمي والمنفذ الخاص بجهاز Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale Tailscale en ambos dispositivos y use la misma red Tailscale. Abra Tailscale Pairing en Mac y escanee su QR aquí, o ingrese la IP y el puerto numéricos de Tailscale de Mac."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在兩台裝置上安裝 Tailscale 並使用相同的 Tailscale 網路。在 Mac 上開啟 Tailscale 配對並在此處掃描其二維碼，或輸入 Mac 的數位 Tailscale IP 和連接埠。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在两台设备上安装 Tailscale 并使用相同的 Tailscale 网络。在 Mac 上打开 Tailscale 配对并在此处扫描其二维码，或输入 Mac 的数字 Tailscale IP 和端口。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 장치 모두에 Tailscale을 설치하고 동일한 Tailscale 네트워크를 사용하십시오. Mac에서 Tailscale 페어링을 열고 여기에서 QR을 스캔하거나 Mac의 숫자 Tailscale IP 및 포트를 입력하세요."
          }
        }
      }
    },
