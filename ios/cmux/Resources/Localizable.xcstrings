    "mobile.connectionsUpdate.iroh.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same authenticated, end-to-end encrypted connection, now with a clearer name. The app-wide setting moved out of Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証付きのエンドツーエンド暗号化接続はそのままに、名前がわかりやすくなりました。アプリ全体の設定は「設定」から移動しました。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieselbe authentifizierte, Ende-zu-Ende-verschlüsselte Verbindung, jetzt mit einem klareren Namen. Die App-weite Einstellung wurde aus den Einstellungen entfernt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même connexion authentifiée et cryptée de bout en bout, désormais avec un nom plus clair. Le paramètre à l’échelle de l’application a été retiré des paramètres."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نفس الاتصال المشفر والمصادق عليه من طرف إلى طرف، والآن باسم أكثر وضوحًا. تم نقل الإعداد على مستوى التطبيق من الإعدادات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La misma conexión autenticada y cifrada de extremo a extremo, ahora con un nombre más claro. La configuración de toda la aplicación salió de Configuración."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相同的經過身份驗證的端到端加密連接，現在具有更清晰的名稱。應用程式範圍的設定已移出「設定」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相同的经过身份验证的端到端加密连接，现在具有更清晰的名称。应用程序范围的设置已移出“设置”。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동일하게 인증되고 종단 간 암호화된 연결이 이제 더 명확한 이름으로 제공됩니다. 앱 전체 설정이 설정 밖으로 이동되었습니다."
          }
        }
      }
    },
    "mobile.connectionsUpdate.iroh.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-Connect is now Iroh"
          }
        },
        "ja": {
