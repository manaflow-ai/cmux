    "mobile.taskComposer.directoryPicker.browse.failure.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac could not list this folder. If this is a protected folder such as Downloads, allow cmux access in Mac System Settings › Privacy & Security › Files & Folders, then retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macでこのフォルダの一覧を取得できませんでした。Downloadsなどの保護されたフォルダの場合は、Macの「システム設定」＞「プライバシーとセキュリティ」＞「ファイルとフォルダ」でcmuxのアクセスを許可してから、もう一度お試しください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "Mac 无法列出此文件夹。如果这是「下载」等受保护文件夹，请在 Mac 系统设置 › 隐私与安全性 › 文件与文件夹中允许 cmux 访问，然后重试。"
        }
      }}
    },
    "mobile.taskComposer.directoryPicker.browse.failure.invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose another location and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の場所を選択して、もう一度お試しください。"
