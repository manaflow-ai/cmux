    "mobile.connectionsUpdate.iroh.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same authenticated, end-to-end encrypted connection, now with a clearer name. The app-wide setting moved out of Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証付きのエンドツーエンド暗号化接続はそのままに、名前がわかりやすくなりました。アプリ全体の設定は「設定」から移動しました。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieselbe authentifizierte, Ende-zu-Ende-verschlüsselte Verbindung, jetzt mit einem klareren Namen. Die App-weite Einstellung wurde aus den Einstellungen entfernt."
          }
        },
        "fr": {
