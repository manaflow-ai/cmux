    "mobile.iroh.relays.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct peer-to-peer stays enabled. cmux verifies a signed relay catalog, so fleet changes do not require an app update."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピアツーピアの直接接続は有効なままです。cmux は署名済みリレーカタログを検証するため、フリート変更にアプリ更新は不要です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkter Peer-to-Peer bleibt aktiviert. cmux überprüft einen signierten Relay-Katalog, sodass Flottenänderungen kein App-Update erfordern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le peer-to-peer direct reste activé. cmux vérifie un catalogue de relais signé, de sorte que les modifications de flotte ne nécessitent pas de mise à jour de l'application."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تمكين الإقامات المباشرة من نظير إلى نظير. يتحقق cmux من كتالوج الترحيل الموقع، لذلك لا تتطلب تغييرات الأسطول تحديث التطبيق."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanencias directas de igual a igual habilitadas. cmux verifica un catálogo de retransmisión firmado, por lo que los cambios de flota no requieren una actualización de la aplicación."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接點對點保持啟用狀態。 cmux 驗證已簽署的中繼目錄，因此佇列變更不需要應用程式更新。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接点对点保持启用状态。 cmux 验证已签名的中继目录，因此队列更改不需要应用程序更新。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 P2P(Peer-to-Peer)가 활성화된 상태로 유지됩니다. cmux는 서명된 릴레이 카탈로그를 확인하므로 플릿 변경 시 앱 업데이트가 필요하지 않습니다."
          }
        }
      }
    },
    "mobile.iroh.saveFailed": {
      "extractionState": "manual",
      "localizations": {
