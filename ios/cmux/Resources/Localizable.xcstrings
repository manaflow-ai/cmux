    "mobile.connections.direct.addMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A numeric IP where this computer is reachable, like 192.168.1.20 or 192.168.1.20:64000. Without a port, the Mac's advertised port is used."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンピュータに到達できる数値IPアドレスを入力します（例: 192.168.1.20、192.168.1.20:64000）。ホスト名は使用できません。ポート未指定の場合はMacが公開しているポートを使用します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine numerische IP, unter der dieser Computer erreichbar ist, z. B. 192.168.1.20 oder 192.168.1.20:64000. Ohne Port wird der beworbene Port des Mac verwendet."
          }
        },
        "fr": {
