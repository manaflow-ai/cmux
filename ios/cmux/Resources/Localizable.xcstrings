    "mobile.iroh.custom.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Addresses sync with your account. Provider secrets stay in this device's Keychain. A missing secret never enables another relay provider."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスはアカウントと同期されます。プロバイダーのシークレットはこのデバイスのキーチェーンに保存されます。シークレットがない場合に別のリレープロバイダーが有効になることはありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Adressen werden mit Ihrem Konto synchronisiert. Die Geheimnisse des Anbieters bleiben im Schlüsselbund dieses Geräts. Ein fehlendes Geheimnis aktiviert niemals einen anderen Relay-Anbieter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les adresses se synchronisent avec votre compte. Les secrets du fournisseur restent dans le trousseau de cet appareil. Un secret manquant n'active jamais un autre fournisseur de relais."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم مزامنة العناوين مع حسابك. تبقى أسرار الموفر في Keychain لهذا الجهاز. السر المفقود لا يسمح أبدًا لموفر ترحيل آخر."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las direcciones se sincronizan con su cuenta. Los secretos del proveedor permanecen en el llavero de este dispositivo. Un secreto faltante nunca habilita a otro proveedor de retransmisión."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "地址與您的帳戶同步。提供者機密保留在此設備的鑰匙圈中。遺失的秘密永遠不會啟用另一個中繼提供者。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址与您的帐户同步。提供商机密保留在此设备的钥匙串中。丢失的秘密永远不会启用另一个中继提供商。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소는 귀하의 계정과 동기화됩니다. 공급자 비밀번호는 이 기기의 키체인에 유지됩니다. 누락된 비밀은 다른 릴레이 공급자를 활성화하지 않습니다."
          }
        }
      }
    },
