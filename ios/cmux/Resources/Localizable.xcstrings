    "mobile.pairing.requestTimedOut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The computer did not respond. Check the host and port, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータが応答しませんでした。ホストとポートを確認して、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Computer reagierte nicht. Überprüfen Sie den Host und den Port und versuchen Sie es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ordinateur n'a pas répondu. Vérifiez l'hôte et le port, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكمبيوتر لم يستجب. تحقق من المضيف والمنفذ، ثم حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La computadora no respondió. Verifique el host y el puerto y vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電腦沒有反應。檢查主機和端口，然後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑没有反应。检查主机和端口，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터가 응답하지 않았습니다. 호스트와 포트를 확인한 후 다시 시도하세요."
          }
        }
      }
    },
    "mobile.pairing.connectAttemptGated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already reconnecting to this computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンピュータには再接続中です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung zu diesem Computer wird bereits wiederhergestellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je me reconnecte déjà à cet ordinateur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم الآن إعادة الاتصال بهذا الكمبيوتر بالفعل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya me estoy reconectando a esta computadora."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已經重新連接到這台電腦。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经重新连接到这台计算机。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 이 컴퓨터에 다시 연결하고 있습니다."
          }
        }
      }
    },
    "mobile.pairing.routeCleanupBlocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux paused new connections because earlier connection cleanups are still stuck."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前の接続クリーンアップが停止したままのため、新しい接続を一時停止しました。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux hat neue Verbindungen angehalten, da frühere Verbindungsbereinigungen immer noch hängen bleiben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux a suspendu les nouvelles connexions car les nettoyages de connexions antérieurs sont toujours bloqués."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قام cmux بإيقاف الاتصالات الجديدة مؤقتًا لأن عمليات تنظيف الاتصال السابقة لا تزال عالقة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux detuvo nuevas conexiones porque las limpiezas de conexiones anteriores todavía están bloqueadas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 暫停了新連接，因為先前的連接清理仍然卡住。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 暂停了新连接，因为之前的连接清理仍然卡住。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 연결 정리가 여전히 중단되어 cmux가 새 연결을 일시 중지했습니다."
          }
        }
      }
    },
