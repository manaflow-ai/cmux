    "mobile.surface.disconnected.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone isn't connected to the Mac right now. Reconnect, then retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneは現在Macに接続されていません。再接続してから再試行してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Telefon ist derzeit nicht mit dem Mac verbunden. Stellen Sie die Verbindung wieder her und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone n'est pas connecté au Mac pour le moment. Reconnectez-vous, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الهاتف غير متصل بجهاز Mac في الوقت الحالي. أعد الاتصال، ثم أعد المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono no está conectado a la Mac en este momento. Vuelva a conectarse y luego vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此手機目前尚未連接到 Mac。重新連接，然後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此手机目前尚未连接到 Mac。重新连接，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대전화는 현재 Mac에 연결되어 있지 않습니다. 다시 연결한 후 다시 시도하세요."
          }
        }
      }
    },
