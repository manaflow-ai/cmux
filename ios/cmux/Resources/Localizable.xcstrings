    "mobile.connections.direct.noneEnabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No address is enabled — this computer stays disconnected until you enable or add one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なアドレスがありません。アドレスを追加または有効化するまで、このコンピュータは接続されません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist keine Adresse aktiviert – dieser Computer bleibt getrennt, bis Sie eine aktivieren oder hinzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune adresse n'est activée : cet ordinateur reste déconnecté jusqu'à ce que vous en activiez ou en ajoutiez une."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تمكين أي عنوان — يظل هذا الكمبيوتر غير متصل حتى تقوم بتمكينه أو إضافته."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna dirección habilitada: esta computadora permanece desconectada hasta que habilites o agregues una."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未啟用任何位址 - 在您啟用或新增位址之前，該電腦將保持斷開連線。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未启用任何地址 - 在您启用或添加地址之前，该计算机将保持断开连接。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소가 활성화되지 않았습니다. 이 컴퓨터는 주소를 활성화하거나 추가할 때까지 연결이 끊어진 상태로 유지됩니다."
          }
        }
      }
    },
