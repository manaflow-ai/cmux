    "mobile.pairing.unrecognizedVersion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This QR needs a newer version of cmux. Update the app and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このQRコードには新しいバージョンのcmuxが必要です。アプリを更新してからもう一度お試しください。"
          }
        }
      ,
