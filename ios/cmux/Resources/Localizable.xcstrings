    "mobile.setupHelp.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To see your computer's terminals here, sign in to the same cmux account on both devices and keep cmux running on the computer. The step you are on is marked below."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでコンピュータのターミナルを表示するには、両方の端末で同じcmuxアカウントにサインインし、コンピュータでcmuxを起動したままにします。今いるステップは下に印が付いています。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "要在此处看到你电脑的终端，请在两台设备上登录同一个 cmux 账户，并让 cmux 在电脑上保持运行。你当前所处的步骤已在下方标出。"
        }
      }}
    },
    "mobile.setupHelp.introReference": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To see your computer's terminals here, sign in to the same cmux account on both devices and keep cmux running on the computer. Connection is automatic after that."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでコンピュータのターミナルを表示するには、両方の端末で同じcmuxアカウントにサインインし、コンピュータでcmuxを起動したままにします。あとは自動的に接続されます。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "要在此处看到你电脑的终端，请在两台设备上登录同一个 cmux 账户，并让 cmux 在电脑上保持运行。之后连接会自动建立。"
        }
      }}
    },
    "mobile.setupHelp.lanBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If both devices are on Tailscale, another VPN, or the same network, cmux can use it as a faster direct path. The connection stays encrypted and verified either way."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方の端末がTailscale、別のVPN、または同じネットワーク上にある場合、cmuxはそれをより高速な直接経路として使うことがあります。どの経路でも接続の暗号化と検証は保たれます。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "如果两台设备都在 Tailscale、其他 VPN 或同一网络中，cmux 可将其用作更快的直连路径。无论哪种方式，连接都会保持加密和验证。"
        }
      }}
    },
    "mobile.setupHelp.macAppBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install cmux on your computer, sign in to the same account, and leave it running. The computer then appears on this phone automatically. To pair through Tailscale, install Tailscale on both devices and connect them to the same Tailscale network. Then open Tailscale Pairing in cmux on the computer to show the QR and scan it here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータにcmuxをインストールし、同じcmuxアカウントでサインインしたまま起動しておきます。コンピュータは自動的にこの端末に表示されます。Tailscale経由でペアリングするには、両方のデバイスにTailscaleをインストールし、同じTailscaleネットワークに接続してください。その後、コンピュータのcmuxで「Tailscaleペアリング」を開いてQRコードを表示し、ここでスキャンします。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "在电脑上安装 cmux，登录同一个账户并保持运行。之后电脑会自动出现在这部手机上。要通过 Tailscale 配对，请在两台设备上安装 Tailscale 并连接到同一个 Tailscale 网络，然后在电脑上的 cmux 中打开 Tailscale 配对以显示二维码，并在此处扫描。"
        }
      }}
    },
    "mobile.setupHelp.macAppLink": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download cmux"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmuxをダウンロード"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "下载 cmux"
        }
      }}
    },
    "mobile.setupHelp.macAppTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run cmux on your computer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータでcmuxを起動"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "在你的电脑上运行 cmux"
        }
      }}
    },
    "mobile.setupHelp.mismatchBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The computer rejected this phone's sign-in, so the two are on different cmux accounts or this phone's session is stale. Sign either one out and back in so both use the same account, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータがこの端末のサインインを拒否しました。両者が別々のcmuxアカウントになっているか、この端末のセッションが古くなっています。どちらかでいったんサインアウトし、両方が同じアカウントになるようにサインインし直してから、もう一度お試しください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "电脑拒绝了这部手机的登录，说明两者处于不同的 cmux 账户，或这部手机的会话已过期。请将任一设备退出登录后重新登录，使两者使用同一账户，然后重试。"
        }
      }}
    },
    "mobile.setupHelp.mismatchTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match the account"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを合わせる"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "匹配账户"
        }
      }}
    },
    "mobile.setupHelp.networkBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux connects through Iroh, which links this phone to your computer directly when possible and through an encrypted cmux relay when not. Both devices verify your account, and the relay cannot read your terminals. No network setup is required."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmuxはIrohで接続します。可能な場合はこの端末とコンピュータを直接つなぎ、できない場合は暗号化されたcmuxリレーを経由します。両方の端末でアカウントを検証するため、リレーがターミナルの内容を読むことはできません。ネットワークの設定は不要です。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "cmux 通过 Iroh 连接：尽可能将这部手机与你的电脑直接相连，否则通过加密的 cmux 中继连接。两台设备都会验证你的账户，中继无法读取你的终端。无需任何网络设置。"
        }
      }}
    },
    "mobile.setupHelp.networkTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How it connects"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続のしくみ"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "连接方式"
        }
      }}
    },
    "mobile.setupHelp.sameAccountFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both devices must be signed in to the same cmux account. A private network never replaces that check."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方の端末は同じcmuxアカウントでサインインする必要があります。プライベートネットワークがこの確認を置き換えることはありません。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "两台设备必须登录同一个 cmux 账户。专用网络永远无法替代这一校验。"
        }
      }}
    },
    "mobile.setupHelp.signInBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to cmux on this phone with the same account your computer uses. Once you sign in, your computer is found automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末で、コンピュータと同じアカウントを使ってcmuxにサインインします。サインインすると、コンピュータは自動的に見つかります。"
          }
        }
