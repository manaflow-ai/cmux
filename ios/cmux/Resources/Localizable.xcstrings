    "mobile.pairing.secureRouteRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This pairing route is not trusted. Enter the Mac's numeric Tailscale IP and port, or scan its pairing QR."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このペアリング経路は信頼できません。Mac の数値 Tailscale IP アドレスとポートを入力するか、ペアリング QR をスキャンしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kopplungsroute ist nicht vertrauenswürdig. Geben Sie die numerische Tailscale-IP und den Port des Mac ein oder scannen Sie den Kopplungs-QR."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette route de couplage n’est pas fiable. Entrez l'adresse IP et le port Tailscale numériques du Mac, ou scannez son QR de couplage."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسار الاقتران هذا غير موثوق به. أدخل عنوان Tailscale IP الرقمي والمنفذ الخاص بجهاز Mac، أو قم بمسح QR المقترن الخاص به."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ruta de emparejamiento no es de confianza. Ingrese la IP y el puerto numéricos de Tailscale de la Mac, o escanee su QR de emparejamiento."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該配對路由不受信任。輸入 Mac 的數位 Tailscale IP 和端口，或掃描其配對二維碼。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该配对路由不受信任。输入 Mac 的数字 Tailscale IP 和端口，或扫描其配对二维码。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 페어링 경로는 신뢰할 수 없습니다. Mac의 숫자 Tailscale IP 및 포트를 입력하거나 페어링 QR을 스캔하세요."
          }
        }
      }
    },
    "mobile.pairing.stackAuthTokenUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in on your computer with the same account, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータで同じアカウントにサインインしてから、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich mit demselben Konto auf Ihrem Computer an und versuchen Sie es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous sur votre ordinateur avec le même compte, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتسجيل الدخول على جهاز الكمبيوتر الخاص بك بنفس الحساب، ثم حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sesión en su computadora con la misma cuenta y vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用相同帳戶登入您的計算機，然後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用同一帐户登录您的计算机，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동일한 계정으로 컴퓨터에 로그인한 후 다시 시도하세요."
          }
        }
      }
    },
    "mobile.pairing.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the QR shown on your computer, or enter a pairing code."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータに表示された QR コードをスキャンするか、ペアリングコードを入力してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannen Sie den auf Ihrem Computer angezeigten QR-Code oder geben Sie einen Kopplungscode ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez le QR affiché sur votre ordinateur ou entrez un code de couplage."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح رمز QR الظاهر على جهاز الكمبيوتر الخاص بك، أو أدخل رمز الاقتران."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanee el QR que se muestra en su computadora o ingrese un código de emparejamiento."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描電腦上顯示的二維碼，或輸入配對碼。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描计算机上显示的二维码，或输入配对码。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터에 표시된 QR을 스캔하거나 페어링 코드를 입력하세요."
          }
        }
      }
    },
