    "mobile.taskComposer.recovery.startAgain.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only continue if the task is not present. Starting again may create a duplicate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクが見つからない場合のみ続行してください。再度開始すると重複する可能性があります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fahren Sie nur fort, wenn die Aufgabe nicht vorhanden ist. Bei einem erneuten Start entsteht möglicherweise ein Duplikat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne continuez que si la tâche n'est pas présente. Recommencer peut créer un doublon."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع فقط إذا كانت المهمة غير موجودة. قد يؤدي البدء مرة أخرى إلى إنشاء نسخة مكررة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continúe solo si la tarea no está presente. Comenzar de nuevo puede crear un duplicado."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅當任務不存在時才繼續。重新開始可能會產生重複。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当任务不存在时才继续。重新开始可能会产生重复。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 없는 경우에만 계속하세요. 다시 시작하면 중복이 발생할 수 있습니다."
          }
        }
      }
    },
    "mobile.taskComposer.recovery.startAgain.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start this task again?"
          }
        },
        "ja": {
