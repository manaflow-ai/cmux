          "stringUnit": {
            "state": "translated",
            "value": "QR pairing usually needs both devices on the same Tailscale network. Turn Tailscale on first, or pair by host and port on a trusted local network."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QR ペアリングには通常、両方のデバイスが同じ Tailscale ネットワークに接続されている必要があります。まず Tailscale をオンにするか、信頼できるローカルネットワーク上でホストとポートを指定してペアリングしてください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "二维码配对通常需要两台设备位于同一个 Tailscale 网络。请先开启 Tailscale，或在可信的本地网络上通过主机和端口配对。"
        }
      }}
    },
    "mobile.altScreenNotice.button.accessibilityLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explain full-screen terminal sizing"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全画面ターミナルのサイズ表示を説明"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "说明全屏终端尺寸"
        }
      }}
    },
    "mobile.altScreenNotice.dismissAction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't Show Again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後表示しない"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "不再显示"
        }
      }}
    },
    "mobile.altScreenNotice.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-screen mode mirrors the Mac terminal's exact size, so it may not fill this screen. Claude Code: `/tui default`. Codex: restart with `codex --no-alt-screen`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全画面モードは Mac 側ターミナルのサイズをそのまま表示するため、この画面いっぱいに広がらない場合があります。Claude Code: `/tui default`。Codex: `codex --no-alt-screen` で再起動。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "全屏模式会镜像 Mac 终端的精确尺寸，因此可能无法填满此屏幕。Claude Code：`/tui default`。Codex：使用 `codex --no-alt-screen` 重新启动。"
        }
      }}
    },
