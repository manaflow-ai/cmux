    "mobile.taskComposer.failure.alreadyCompleted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac already accepted this task. Refresh workspaces before trying again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macはこのタスクをすでに受け付けています。ワークスペースを更新してから、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac hat diese Aufgabe bereits übernommen. Aktualisieren Sie die Arbeitsbereiche, bevor Sie es erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac a déjà accepté cette tâche. Actualisez les espaces de travail avant de réessayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد قبل جهاز Mac هذه المهمة بالفعل. قم بتحديث مساحات العمل قبل المحاولة مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Mac ya aceptó esta tarea. Actualice los espacios de trabajo antes de volver a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 已經接受了這個任務。重試之前刷新工作區。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 已经接受了这个任务。重试之前刷新工作区。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac은 이미 이 작업을 수락했습니다. 다시 시도하기 전에 작업공간을 새로 고치세요."
          }
        }
      }
    },
