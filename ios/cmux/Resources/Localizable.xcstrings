    "mobile.iroh.relayOnly.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps this device's Iroh connections on cmux relays instead of direct or local-network paths. Applies on the next reconnect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスの Iroh 接続を、直接経路やローカルネットワーク経路ではなく cmux リレー経由に固定します。次回の再接続時に適用されます。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "让此设备的 Iroh 连接保持使用 cmux 中继，而不是直连或本地网络路径。将在下次重新连接时生效。"
        }
      }}
    },
    "mobile.iroh.relays": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh Relays"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh リレー"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "Iroh 中继"
        }
      }}
    },
    "mobile.iroh.relays.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct peer-to-peer stays enabled. cmux verifies a signed relay catalog, so fleet changes do not require an app update."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピアツーピアの直接接続は有効なままです。cmux は署名済みリレーカタログを検証するため、フリート変更にアプリ更新は不要です。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "点对点直连保持启用。cmux 会验证带签名的中继目录，因此中继服务器群的变更无需更新应用。"
        }
      }}
    },
