    "mobile.pairing.cameraDeniedDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow camera access in Settings to scan the QR code shown on your Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macに表示されたQRコードをスキャンするには、設定でカメラへのアクセスを許可してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie den Kamerazugriff in den Einstellungen, um den auf Ihrem Mac angezeigten QR-Code zu scannen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l'accès à la caméra dans Paramètres pour scanner le code QR affiché sur votre Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول إلى الكاميرا في الإعدادات لمسح رمز الاستجابة السريعة الموضح على جهاز Mac الخاص بك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita el acceso a la cámara en Configuración para escanear el código QR que se muestra en su Mac."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「設定」中允許相機存取以掃描 Mac 上顯示的二維碼。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”中允许相机访问以扫描 Mac 上显示的二维码。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에 표시된 QR 코드를 스캔하려면 설정에서 카메라 액세스를 허용하세요."
          }
        }
      }
    },
    "mobile.pairing.cameraRestrictedDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is restricted on this device. Use a pairing link or the manual form instead."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではカメラの使用が制限されています。ペアリングリンクまたは手動入力を使用してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kamerazugriff ist auf diesem Gerät eingeschränkt. Verwenden Sie stattdessen einen Pairing-Link oder das manuelle Formular."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès à la caméra est restreint sur cet appareil. Utilisez plutôt un lien d’appariement ou le formulaire manuel."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الكاميرا مقيد على هذا الجهاز. استخدم رابط الاقتران أو النموذج اليدوي بدلاً من ذلك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la cámara está restringido en este dispositivo. Utilice un enlace de emparejamiento o el formulario manual en su lugar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置上的相機存取受到限制。請改用配對連結或手動表格。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的相机访问受到限制。请改用配对链接或手动表格。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 카메라 액세스가 제한되어 있습니다. 대신 페어링 링크나 수동 양식을 사용하세요."
          }
        }
      }
    },
