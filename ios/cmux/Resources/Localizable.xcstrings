    "mobile.settings.shellIconLab.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first value is icon size. Stroke weights are 400 regular, 500 medium, and 600 semibold. α changes contrast; ○ changes circle size. Choose a variant, then reopen New Task."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の値はアイコンサイズです。線の太さは 400 がレギュラー、500 がミディアム、600 がセミボールドです。α はコントラスト、○ は円のサイズを変更します。バリエーションを選び、もう一度「新規タスク」を開いてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erste Wert ist die Symbolgröße. Die Strichstärken betragen 400 normal, 500 mittel und 600 halbfett. α verändert den Kontrast; ○ ändert die Kreisgröße. Wählen Sie eine Variante und öffnen Sie dann „Neue Aufgabe“ erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "The first value is icon size. Stroke weights are 400 regular, 500 medium, and 600 semibold. α changes contrast; ○ changes circle size. Choose a variant, then reopen New Task."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "The first value is icon size. Stroke weights are 400 regular, 500 medium, and 600 semibold. α changes contrast; ○ changes circle size. Choose a variant, then reopen New Task."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "The first value is icon size. Stroke weights are 400 regular, 500 medium, and 600 semibold. α changes contrast; ○ changes circle size. Choose a variant, then reopen New Task."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "The first value is icon size. Stroke weights are 400 regular, 500 medium, and 600 semibold. α changes contrast; ○ changes circle size. Choose a variant, then reopen New Task."
