    "computers.listauth.unverified.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not verified on the new connection system yet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい接続システムでまだ確認されていません"
          }
