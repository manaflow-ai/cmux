          }
        }
      }
    },
    "mobile.onboarding.troubleConnecting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouble connecting?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続できないときは"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probleme beim Verbinden?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème de connexion ?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تواجه مشكلة في الاتصال؟"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Problemas para conectarse?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線有問題嗎？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接有问题吗？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결하는 데 문제가 있나요?"
          }
        }
      }
    },
    "mobile.onboarding.whatBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux runs your terminals and AI coding agents on your Mac. Watch, type, and respond from your phone. Every agent alert stays in Notifications, and push alerts are optional when you want an immediate heads-up away from the app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmuxはMac上でターミナルとAIコーディングエージェントを動かします。iPhoneから状況を確認し、入力して対応できます。エージェントからの通知はすべて「通知」に時系列で残り、アプリを離れているときのプッシュ通知は必要に応じて有効にできます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux führt Ihre Terminals und KI-Codierungsagenten auf Ihrem Mac aus. Beobachten, tippen und antworten Sie von Ihrem Telefon aus. Jede Agentenwarnung bleibt in den Benachrichtigungen erhalten, und Push-Benachrichtigungen sind optional, wenn Sie sofort benachrichtigt werden möchten, wenn Sie die App verlassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux exécute vos terminaux et agents de codage IA sur votre Mac. Regardez, tapez et répondez depuis votre téléphone. Chaque alerte d'agent reste dans les notifications et les alertes push sont facultatives lorsque vous souhaitez être informé immédiatement en dehors de l'application."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم cmux بتشغيل المحطات الطرفية ووكلاء ترميز الذكاء الاصطناعي على جهاز Mac الخاص بك. شاهد واكتب واستجب من هاتفك. يبقى كل تنبيه وكيل في الإشعارات، وتكون التنبيهات المؤقتة اختيارية عندما تريد تنبيهًا فوريًا بعيدًا عن التطبيق."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ejecuta sus terminales y agentes de codificación de IA en su Mac. Mira, escribe y responde desde tu teléfono. Cada alerta de agente permanece en Notificaciones y las alertas automáticas son opcionales cuando desea recibir un aviso inmediato fuera de la aplicación."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 在 Mac 上運行終端機和 AI 編碼代理程式。透過手機觀看、打字和回覆。每個代理警報都會保留在「通知」中，當您希望立即遠離應用程式時，推播警報是可選的。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 在 Mac 上运行终端和 AI 编码代理。通过手机观看、打字和回复。每个代理警报都会保留在“通知”中，当您希望立即远离应用程序时，推送警报是可选的。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux는 Mac에서 터미널과 AI 코딩 에이전트를 실행합니다. 휴대폰으로 보고, 입력하고, 응답하세요. 모든 에이전트 알림은 알림에 유지되며 앱에서 즉시 알림을 받으려는 경우 푸시 알림은 선택 사항입니다."
          }
        }
      }
    },
    "mobile.onboarding.whatTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac's terminals, on your phone"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのターミナルを、iPhoneで"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Terminals Ihres Mac auf Ihrem Telefon"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les terminaux de votre Mac, sur votre téléphone"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محطات Mac الخاصة بك، على هاتفك"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los terminales de tu Mac, en tu teléfono"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您手機上的 Mac 終端"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您手机上的 Mac 终端"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 터미널, 휴대폰에서"
          }
        }
      }
    },
    "mobile.pairing.accountMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac is signed in to a different cmux account. Sign out and sign back in with the account that owns this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacは別のcmuxアカウントでサインインしています。サインアウトして、このMacを所有するアカウントでサインインし直してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac ist bei einem anderen cmux-Konto angemeldet. Melden Sie sich ab und wieder mit dem Konto an, dem dieser Mac gehört."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac est connecté à un autre compte cmux. Déconnectez-vous et reconnectez-vous avec le compte propriétaire de ce Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تسجيل دخول جهاز Mac هذا إلى حساب cmux مختلف. قم بتسجيل الخروج ثم قم بتسجيل الدخول مرة أخرى باستخدام الحساب الذي يمتلك جهاز Mac هذا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Mac ha iniciado sesión en una cuenta cmux diferente. Cierra sesión y vuelve a iniciar sesión con la cuenta propietaria de esta Mac."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 已登入不同的 cmux 帳戶。登出並使用擁有這台 Mac 的帳戶重新登入。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 已登录到不同的 cmux 帐户。注销并使用拥有这台 Mac 的帐户重新登录。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac은 다른 cmux 계정으로 로그인되어 있습니다. 로그아웃한 후 이 Mac을 소유한 계정으로 다시 로그인하십시오."
          }
        }
      }
    },
    "mobile.pairing.appNotRunning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac is reachable, but cmux isn't running there (or mobile pairing is off). Open cmux on the Mac, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macには接続できますが、cmuxが起動していません（またはモバイルのペア設定がオフです）。Macでcmuxを開いてから、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Mac ist erreichbar, aber cmux läuft dort nicht (oder die mobile Kopplung ist deaktiviert). Öffnen Sie cmux auf dem Mac und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Mac est accessible, mais cmux n'y fonctionne pas (ou le couplage mobile est désactivé). Ouvrez cmux sur Mac, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن الوصول إلى جهاز Mac الخاص بك، ولكن cmux لا يعمل هناك (أو تم إيقاف إقران الهاتف المحمول). افتح cmux على جهاز Mac، ثم حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se puede acceder a tu Mac, pero cmux no se ejecuta allí (o el emparejamiento móvil está desactivado). Abra cmux en Mac y vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 Mac 可以訪問，但 cmux 未在其中運行（或移動配對已關閉）。在 Mac 上開啟 cmux，然後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 Mac 可以访问，但 cmux 未在其中运行（或移动配对已关闭）。在 Mac 上打开 cmux，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에 연결할 수 있지만 cmux가 실행되지 않습니다(또는 모바일 페어링이 꺼져 있음). Mac에서 cmux를 열고 다시 시도하세요."
          }
        }
      }
    },
    "mobile.pairing.attachTicketExpired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This pairing link expired. Pair again with a fresh QR/link from that computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このペアリングリンクの有効期限が切れました。そのコンピュータの新しい QR/リンクでペアリングしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kopplungslink ist abgelaufen. Koppeln Sie erneut mit einem neuen QR/Link von diesem Computer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien de jumelage a expiré. Associez-le à nouveau avec un nouveau QR/lien provenant de cet ordinateur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية رابط الاقتران هذا. قم بإقرانه مرة أخرى باستخدام رابط QR/رابط جديد من هذا الكمبيوتر."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este enlace de emparejamiento expiró. Vuelva a vincularlo con un QR/enlace nuevo de esa computadora."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該配對連結已過期。再次與該電腦上的新二維碼/連結配對。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该配对链接已过期。再次与该计算机上的新二维码/链接配对。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 페어링 링크는 만료되었습니다. 해당 컴퓨터의 새로운 QR/링크로 다시 페어링하세요."
          }
        }
      }
    },
    "mobile.pairing.authEnvironmentMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This dev build is signed in to cmux's development auth environment, so its account can never match a Mac running the release app — even with the same email."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この開発ビルドは cmux の開発用認証環境にサインインしているため、同じメールアドレスでも、リリース版アプリを実行している Mac のアカウントとは一致しません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Entwickler-Build ist in der Entwicklungs-Authentifizierungsumgebung von cmux angemeldet, sodass sein Konto niemals mit einem Mac übereinstimmen kann, auf dem die Release-App ausgeführt wird – selbst mit derselben E-Mail-Adresse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version de développement est connectée à l'environnement d'authentification de développement de cmux, de sorte que son compte ne peut jamais correspondre à un Mac exécutant l'application publiée, même avec le même e-mail."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تسجيل دخول إصدار المطور هذا إلى بيئة مصادقة التطوير الخاصة بـ cmux، لذلك لا يمكن لحسابه أبدًا أن يتطابق مع جهاز Mac يقوم بتشغيل تطبيق الإصدار - حتى باستخدام نفس البريد الإلكتروني."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilación de desarrollo está registrada en el entorno de autenticación de desarrollo de cmux, por lo que su cuenta nunca puede coincidir con una Mac que ejecuta la aplicación de lanzamiento, incluso con el mismo correo electrónico."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此開發版本已登入 cmux 的開發驗證環境，因此其帳戶永遠無法與執行發布應用程式的 Mac 相符 - 即使使用相同的電子郵件也是如此。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此开发版本已登录到 cmux 的开发身份验证环境，因此其帐户永远无法与运行发布应用程序的 Mac 匹配 - 即使使用相同的电子邮件也是如此。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 개발 빌드는 cmux의 개발 인증 환경에 로그인되어 있으므로 동일한 이메일을 사용하더라도 해당 계정은 릴리스 앱을 실행하는 Mac과 일치할 수 없습니다."
          }
        }
      }
    },
    "mobile.pairing.authEnvironmentMismatch.devMac": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone uses cmux's production sign-in, but this Mac runs a dev build on the development auth environment, so their accounts can never match — even with the same email."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone は cmux の本番サインインを使用していますが、この Mac は開発用認証環境の開発ビルドを実行しているため、同じメールアドレスでもアカウントは一致しません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone verwendet die Produktionsanmeldung von cmux, aber auf diesem Mac wird ein Entwicklungs-Build in der Entwicklungs-Authentifizierungsumgebung ausgeführt, sodass ihre Konten niemals übereinstimmen können – selbst mit derselben E-Mail-Adresse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone utilise la connexion de production de cmux, mais ce Mac exécute une version de développement sur l'environnement d'authentification de développement, de sorte que leurs comptes ne peuvent jamais correspondre, même avec le même e-mail."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم جهاز iPhone هذا تسجيل الدخول الخاص بإنتاج cmux، لكن جهاز Mac هذا يقوم بتشغيل إصدار مطور بناءً على بيئة مصادقة التطوير، لذلك لا يمكن أن تتطابق حساباتهم أبدًا - حتى مع نفس البريد الإلكتروني."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone utiliza el inicio de sesión de producción de cmux, pero esta Mac ejecuta una compilación de desarrollo en el entorno de autenticación de desarrollo, por lo que sus cuentas nunca pueden coincidir, ni siquiera con el mismo correo electrónico."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPhone 使用 cmux 的生產登錄，但此 Mac 在開發身份驗證環境上運行開發版本，因此他們的帳戶永遠無法匹配 - 即使使用相同的電子郵件也是如此。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPhone 使用 cmux 的生产登录，但此 Mac 在开发身份验证环境上运行开发版本，因此他们的帐户永远无法匹配 - 即使使用相同的电子邮件也是如此。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone은 cmux의 프로덕션 로그인을 사용하지만 이 Mac은 개발 인증 환경에서 개발 빌드를 실행하므로 동일한 이메일이라도 계정이 일치할 수 없습니다."
          }
        }
      }
    },
    "mobile.pairing.authEnvironmentMismatch.official": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac uses a different cmux sign-in environment, so its account can never match this iPhone's account, even with the same email."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac は別の cmux サインイン環境を使用しているため、同じメールアドレスでもこの iPhone のアカウントと一致することはありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac verwendet eine andere cmux-Anmeldeumgebung, sodass sein Konto nie mit dem Konto dieses iPhones übereinstimmen kann, selbst wenn es dieselbe E-Mail-Adresse hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac utilise un environnement de connexion cmux différent, son compte ne peut donc jamais correspondre à celui de cet iPhone, même avec le même e-mail."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم جهاز Mac هذا بيئة تسجيل دخول cmux مختلفة، لذا لا يمكن أن يتطابق حسابه أبدًا مع حساب iPhone هذا، حتى مع نفس البريد الإلكتروني."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Mac utiliza un entorno de inicio de sesión cmux diferente, por lo que su cuenta nunca puede coincidir con la cuenta de este iPhone, incluso con el mismo correo electrónico."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 使用不同的 cmux 登入環境，因此其帳戶永遠無法與此 iPhone 的帳戶匹配，即使使用相同的電子郵件也是如此。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 使用不同的 cmux 登录环境，因此其帐户永远无法与此 iPhone 的帐户匹配，即使使用相同的电子邮件也是如此。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac은 다른 cmux 로그인 환경을 사용하므로 동일한 이메일을 사용해도 계정이 이 iPhone의 계정과 일치할 수 없습니다."
          }
        }
      }
    },
    "mobile.pairing.authorizationFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't verify your account with this Mac. Make sure both devices are signed in with the same email, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac でアカウントを確認できませんでした。両方のデバイスが同じメールアドレスでサインインしていることを確認してから、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Konto konnte mit diesem Mac nicht bestätigt werden. Stellen Sie sicher, dass beide Geräte mit derselben E-Mail-Adresse angemeldet sind, und versuchen Sie es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier votre compte avec ce Mac. Assurez-vous que les deux appareils sont connectés avec la même adresse e-mail, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر التحقق من حسابك باستخدام جهاز Mac هذا. تأكد من تسجيل الدخول على كلا الجهازين باستخدام نفس البريد الإلكتروني، ثم حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar su cuenta con esta Mac. Asegúrese de que ambos dispositivos hayan iniciado sesión con el mismo correo electrónico y vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法使用此 Mac 驗證您的帳戶。確保兩台裝置都使用相同電子郵件登錄，然後再試一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用此 Mac 验证您的帐户。确保两台设备都使用同一电子邮件登录，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서는 계정을 확인할 수 없습니다. 두 기기가 모두 동일한 이메일로 로그인되어 있는지 확인한 후 다시 시도하세요."
          }
        }
      }
    },
