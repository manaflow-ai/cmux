    "mobile.iroh.private.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a private route for Tailscale alternatives, a company VPN, or a network you operate. cmux still authenticates the Mac before use."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale の代替、会社の VPN、または自分で運用するネットワークにプライベートルートを使用します。使用前に cmux が Mac を認証します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie eine private Route für Tailscale-Alternativen, ein Firmen-VPN oder ein von Ihnen betriebenes Netzwerk. cmux authentifiziert den Mac immer noch vor der Verwendung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez une route privée pour les alternatives Tailscale, un VPN d'entreprise ou un réseau que vous exploitez. cmux authentifie toujours le Mac avant utilisation."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم مسارًا خاصًا لبدائل Tailscale، أو VPN للشركة، أو الشبكة التي تديرها. لا يزال cmux يقوم بمصادقة جهاز Mac قبل الاستخدام."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice una ruta privada para alternativas de Tailscale, una VPN de empresa o una red que usted opere. cmux aún autentica la Mac antes de usarla."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Tailscale 替代方案、公司 VPN 或您經營的網路的專用路由。 cmux 在使用前仍會對 Mac 進行身份驗證。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Tailscale 替代方案、公司 VPN 或您运营的网络的专用路由。 cmux 在使用前仍会对 Mac 进行身份验证。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 대안, 회사 VPN 또는 운영하는 네트워크에는 개인 경로를 사용하십시오. cmux는 사용하기 전에 여전히 Mac을 인증합니다."
          }
        }
      }
    },
