    "mobile.notificationFeed.empty.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every agent alert from your paired Macs will collect here, even if push alerts are off. Enable push alerts in Settings only when you want an immediate heads-up away from the app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングしたすべてのMacからのエージェント通知が、プッシュ通知をオフにしていてもここに集まります。アプリを離れているときにすぐ知らせてほしい場合だけ、設定でプッシュ通知を有効にしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Agentenwarnungen Ihrer gekoppelten Macs werden hier gesammelt, auch wenn Push-Benachrichtigungen deaktiviert sind. Aktivieren Sie Push-Benachrichtigungen in den Einstellungen nur, wenn Sie sofort benachrichtigt werden möchten, wenn Sie die App verlassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Every agent alert from your paired Macs will collect here, even if push alerts are off. Enable push alerts in Settings only when you want an immediate heads-up away from the app."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Every agent alert from your paired Macs will collect here, even if push alerts are off. Enable push alerts in Settings only when you want an immediate heads-up away from the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Every agent alert from your paired Macs will collect here, even if push alerts are off. Enable push alerts in Settings only when you want an immediate heads-up away from the app."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
