    "mobile.computers.forget.confirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's removed from all your devices. If it's still online, it reappears the next time it connects."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデバイスから削除されます。オンラインのままの場合は、次回接続時に再表示されます。"
