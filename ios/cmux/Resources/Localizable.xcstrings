    "mobile.settings.connectionMethod.automaticFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connects to your Mac automatically over an end-to-end encrypted connection, directly or through cmux relays. No setup needed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンドツーエンドで暗号化された接続でMacに自動接続します（直接またはcmuxリレー経由）。設定は不要です。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "通过端到端加密连接自动连接到你的 Mac，可直接连接或经由 cmux 中继。无需任何设置。"
        }
      }}
    },
