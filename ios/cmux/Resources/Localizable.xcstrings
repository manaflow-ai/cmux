    "mobile.workspaceGroup.ungroup.confirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will dissolve the group on your Mac and keep its workspaces."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 上のこのグループを解除し、ワークスペースは残します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird die Gruppe auf Ihrem Mac aufgelöst und ihre Arbeitsbereiche bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela dissoudra le groupe sur votre Mac et conservera ses espaces de travail."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حل المجموعة على جهاز Mac الخاص بك والاحتفاظ بمساحات العمل الخاصة بها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto disolverá el grupo en tu Mac y mantendrá sus espacios de trabajo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將解散 Mac 上的群組並保留其工作區。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将解散 Mac 上的组并保留其工作区。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 Mac에서 그룹이 해체되고 작업 공간이 유지됩니다."
          }
        }
      }
    },
