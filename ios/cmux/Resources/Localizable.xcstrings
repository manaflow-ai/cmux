          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn diese Option deaktiviert ist, sendet cmux keine iPhone- oder iPad-Produktanalysen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu'il est désactivé, cmux n'envoie pas d'analyses de produits iPhone ou iPad."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند إيقاف تشغيله، لا يرسل cmux تحليلات منتج iPhone أو iPad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está desactivado, cmux no envía análisis de productos de iPhone o iPad."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉時，cmux 不會傳送 iPhone 或 iPad 產品分析。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
