    "mobile.setupHelp.sameAccountFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both devices must be signed in to the same cmux account. A private network never replaces that check."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方の端末は同じcmuxアカウントでサインインする必要があります。プライベートネットワークがこの確認を置き換えることはありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Geräte müssen bei demselben cmux-Konto angemeldet sein. Ein privates Netzwerk ersetzt diese Überprüfung niemals."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux appareils doivent être connectés au même compte cmux. Un réseau privé ne remplace jamais ce contrôle."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب تسجيل دخول كلا الجهازين إلى نفس حساب cmux. لا تحل الشبكة الخاصة محل هذا الفحص أبدًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos dispositivos deben iniciar sesión en la misma cuenta cmux. Una red privada nunca reemplaza ese cheque."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩個裝置必須登入同一 cmux 帳戶。專用網路永遠不會取代該檢查。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个设备必须登录到同一 cmux 帐户。专用网络永远不会取代该检查。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 장치 모두 동일한 cmux 계정에 로그인되어 있어야 합니다. 개인 네트워크는 해당 수표를 대체하지 않습니다."
          }
        }
      }
    },
    "mobile.setupHelp.signInBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to cmux on this phone with the same account your computer uses. Once you sign in, your computer is found automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末で、コンピュータと同じアカウントを使ってcmuxにサインインします。サインインすると、コンピュータは自動的に見つかります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich auf diesem Telefon mit demselben Konto bei cmux an, das Ihr Computer verwendet. Sobald Sie sich angemeldet haben, wird Ihr Computer automatisch gefunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à cmux sur ce téléphone avec le même compte que celui utilisé par votre ordinateur. Une fois connecté, votre ordinateur est trouvé automatiquement."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتسجيل الدخول إلى cmux على هذا الهاتف بنفس الحساب الذي يستخدمه جهاز الكمبيوتر الخاص بك. بمجرد تسجيل الدخول، يتم العثور على جهاز الكمبيوتر الخاص بك تلقائيًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sesión en cmux en este teléfono con la misma cuenta que usa su computadora. Una vez que inicie sesión, su computadora se encontrará automáticamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用您的電腦使用的相同帳戶在此手機上登入 cmux。登入後，系統會自動找到您的電腦。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用您的计算机使用的相同帐户在此手机上登录 cmux。登录后，系统会自动找到您的计算机。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터에서 사용하는 것과 동일한 계정으로 이 전화기에서 cmux에 로그인하세요. 로그인하면 컴퓨터가 자동으로 검색됩니다."
          }
        }
      }
    },
