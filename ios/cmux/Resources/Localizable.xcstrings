    "mobile.macUpdateHint.bodyFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is on cmux %2$@. Updating to %3$@ or later adds: %4$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@はcmux %2$@を実行中です。%3$@以降に更新すると次の機能が使えます：%4$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist auf cmux %2$@. Durch die Aktualisierung auf %3$@ oder höher wird Folgendes hinzugefügt: %4$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est sur cmux %2$@. La mise à jour vers %3$@ ou version ultérieure ajoute : %4$@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ موجود على cmux %2$@. يؤدي التحديث إلى %3$@ أو الإصدارات الأحدث إلى إضافة: %4$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está en cmux %2$@. La actualización a %3$@ o posterior agrega: %4$@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is on cmux %2$@. Updating to %3$@ or later adds: %4$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is on cmux %2$@. Updating to %3$@ or later adds: %4$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@는 cmux %2$@에 있습니다. %3$@ 이상으로 업데이트하면 %4$@가 추가됩니다."
          }
        }
      }
    },
    "mobile.macUpdateHint.bodyFormatUnknownVersion": {
