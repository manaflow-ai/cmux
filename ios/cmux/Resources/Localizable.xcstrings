{
  "sourceLanguage": "en",
  "strings": {
    "auth.error.apple_config": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الدخول إلى Apple غير متاح بعد. الرجاء استخدام طريقة تسجيل دخول أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Apple-Anmeldung ist noch nicht verfügbar. Bitte verwenden Sie eine andere Anmeldemethode."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Sign In is not available yet. Please use another sign-in method."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión de Apple aún no está disponible. Utilice otro método de inicio de sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion Apple n’est pas encore disponible. Veuillez utiliser une autre méthode de connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple でのサインインはまだ利用できません。別のサインイン方法を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 Apple 로그인을 사용할 수 없습니다. 다른 로그인 방법을 사용해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 登录尚不可用。请使用其他登录方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 登入尚不可用。請使用其他登入方式。"
          }
        }
      }
    },
    "auth.error.browser_sign_in_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إكمال تسجيل الدخول إلى المتصفح. حاول مرة أخرى أو افتح تسجيل الدخول في متصفحك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Browseranmeldung konnte nicht abgeschlossen werden. Versuchen Sie es erneut oder öffnen Sie die Anmeldung in Ihrem Browser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not complete browser sign-in. Try again or open sign-in in your browser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar el inicio de sesión en el navegador. Inténtalo de nuevo o abre el inicio de sesión en tu navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de terminer la connexion au navigateur. Réessayez ou ouvrez la connexion dans votre navigateur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザでのサインインを完了できませんでした。もう一度試すか、ブラウザでサインインを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 로그인을 완료할 수 없습니다. 다시 시도하거나 브라우저에서 로그인을 열어보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成浏览器登录。请重试或在浏览器中打开登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完成瀏覽器登入。請重試或在瀏覽器中開啟登入。"
          }
        }
      }
    },
    "auth.error.code_expired": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية الرمز. يرجى طلب واحدة جديدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Code abgelaufen. Bitte fordern Sie ein neues an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Code expired. Please request a new one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código expiró. Por favor solicite uno nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Code expiré. Veuillez en demander un nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードの有効期限が切れました。新しいコードをリクエストしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드가 만료되었습니다. 새로운 것을 요청하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码已过期。请索取一份新的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代碼已過期。請索取一份新的。"
          }
        }
      }
    },
    "auth.error.config": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الدخول غير متاح مؤقتا. يرجى المحاولة مرة أخرى في وقت لاحق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung ist vorübergehend nicht möglich. Bitte versuchen Sie es später noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in is temporarily unavailable. Please try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión no está disponible temporalmente. Inténtelo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion est temporairement indisponible. Veuillez réessayer plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインは一時的に利用できません。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시적으로 로그인을 사용할 수 없습니다. 나중에 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法登录。请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法登入。請稍後重試。"
          }
        }
      }
    },
    "auth.error.email_exists": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد حساب بهذا البريد الإلكتروني بالفعل. حاول تسجيل الدخول بدلاً من ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es existiert bereits ein Konto mit dieser E-Mail. Versuchen Sie stattdessen, sich anzumelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account with this email already exists. Try signing in instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe una cuenta con este correo electrónico. Intenta iniciar sesión en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte avec cette adresse email existe déjà. Essayez plutôt de vous connecter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメールのアカウントはすでに存在します。サインインを試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이메일을 사용하는 계정이 이미 존재합니다. 대신 로그인해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此电子邮件的帐户已存在。请尝试登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此电子邮件的帐户已存在。請嘗試登入。"
          }
        }
      }
    },
    "auth.error.email_requires_verification": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من هذا البريد الإلكتروني قبل طلب رمز تسجيل الدخول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie diese E-Mail, bevor Sie einen Anmeldecode anfordern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify this email before requesting a sign-in code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique este correo electrónico antes de solicitar un código de inicio de sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez cet e-mail avant de demander un code de connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインコードをリクエストする前に、このメールアドレスを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 코드를 요청하기 전에 이 이메일을 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在请求登录代码之前请验证此电子邮件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在請求登入代碼之前請驗證此電子郵件。"
          }
        }
      }
    },
    "auth.error.generic": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ ما. يرجى المحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas ist schief gelaufen. Bitte versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal. Por favor inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose s'est mal passé. Veuillez réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題が発生しました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제가 발생했습니다. 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出了点问题。请再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出了點問題。請再試一次。"
          }
        }
      }
    },
    "auth.error.invalid_code": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز غير صالح. يرجى التحقق والمحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültiger Code. Bitte überprüfen Sie es und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid code. Please check and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código no válido. Por favor verifique e intente nuevamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Code invalide. Veuillez vérifier et réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードが無効です。確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드가 잘못되었습니다. 확인하신 후 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码无效。请检查并重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代碼無效。請檢查並重試。"
          }
        }
      }
    },
    "auth.error.invalid_email": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى إدخال عنوان بريد إلكتروني صالح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte geben Sie eine gültige E-Mail-Adresse ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter a valid email address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, introduce una dirección de correo electrónico válida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'il vous plaît, mettez une adresse email valide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なメールアドレスを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유효한 이메일 주소를 입력하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效的电子邮件地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入有效的電子郵件地址。"
          }
        }
      }
    },
    "auth.error.invalid_mfa": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز التحقق غير صحيح. يرجى المحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falscher Bestätigungscode. Bitte versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorrect verification code. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código de verificación incorrecto. Por favor inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Code de vérification incorrect. Veuillez réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認コードが正しくありません。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘못된 인증 코드입니다. 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证码不正确。请再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證碼不正確。請再試一次。"
          }
        }
      }
    },
    "auth.error.network": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الاتصال بالخادم. تحقق من اتصالك بالإنترنت وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es konnte keine Verbindung zum Server hergestellt werden. Überprüfen Sie Ihre Internetverbindung und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not connect to the server. Check your internet connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar al servidor. Verifique su conexión a Internet e inténtelo nuevamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de se connecter au serveur. Vérifiez votre connexion Internet et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに接続できませんでした。インターネット接続を確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 연결할 수 없습니다. 인터넷 연결을 확인하고 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到服务器。检查您的互联网连接，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連接到伺服器。檢查您的網路連接，然後再試一次。"
          }
        }
      }
    },
    "auth.error.oauth_linked": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الحساب مرتبط بالفعل بطريقة تسجيل دخول أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto ist bereits mit einer anderen Anmeldemethode verknüpft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is already linked to another sign-in method."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta ya está vinculada a otro método de inicio de sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte est déjà lié à une autre méthode de connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントは別のサインイン方法にすでにリンクされています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정은 이미 다른 로그인 방법에 연결되어 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该帐户已链接到其他登录方法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該帳戶已連結至其他登入方法。"
          }
        }
      }
    },
    "auth.error.passkey_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشلت مصادقة مفتاح المرور. يرجى المحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Passkey-Authentifizierung ist fehlgeschlagen. Bitte versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passkey authentication failed. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error de autenticación de clave de acceso. Por favor inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'authentification par mot de passe a échoué. Veuillez réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスキー認証に失敗しました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
