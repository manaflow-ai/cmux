        }
      }}
    },
    "mobile.pairing.compatibilityDisplayFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "compatibility %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "互換性 %@"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "兼容性 %@"
        }
      }}
    },
    "mobile.pairing.compatibilityUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "unknown compatibility"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不明な互換性"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "兼容性未知"
        }
      }}
    },
    "mobile.pairing.connect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "连接"
        }
      }}
    },
    "mobile.pairing.connectTimedOutFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No response from %@:%d. Make sure the Mac is awake, cmux is running, and the private route is active."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%d から応答がありません。Macが起動していてcmuxが実行中であり、プライベート経路が有効か確認してください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "%@:%d 无响应。请确保 Mac 已唤醒、cmux 正在运行，且专用路由处于活动状态。"
        }
      }}
    },
    "mobile.pairing.connectionDroppedFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected to %@:%d, but the host closed the connection. Check that the host app is still running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%d に接続しましたが、ホストが接続を閉じました。ホストアプリがまだ実行中であることを確認してください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "已连接到 %@:%d，但主机关闭了连接。请检查主机应用是否仍在运行。"
        }
      }}
    },
    "mobile.pairing.connectionFailedFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach %@:%d. Check that the saved private network or LAN route is active and that the port is correct."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%d に到達できませんでした。保存済みのプライベートネットワークまたはLAN経路が有効で、ポートが正しいか確認してください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "无法连接到 %@:%d。请检查主机是否可通过 Tailscale 或局域网访问，以及端口是否正确。"
        }
      }}
    },
    "mobile.pairing.connectionTimedOutFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No response from %@:%d. Make sure the host app is open and accepting mobile connections."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%d から応答がありません。ホストアプリが開いていて、モバイル接続を受け入れていることを確認してください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "%@:%d 无响应。请确认主机应用已打开并接受移动设备连接。"
        }
      }}
    },
    "mobile.pairing.dnsFailedFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't resolve %@. Check the DNS or private network that provides this saved route."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を解決できませんでした。この保存済み経路を提供するDNSまたはプライベートネットワークを確認してください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "无法解析 %@。请检查提供此已保存路由的 DNS 或专用网络。"
        }
      }}
    },
    "mobile.pairing.buildIncompatible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone build cannot connect to that cmux build."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone ビルドは、その cmux ビルドに接続できません。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "这部 iPhone 的构建无法连接到那个 cmux 构建。"
        }
      }}
    },
    "mobile.pairing.emailMismatchFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This QR is for %@, but this iPhone is signed in as %@. Sign in with the same email as the Mac, then scan again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この QR は %@ 用ですが、この iPhone は %@ としてサインインしています。Mac と同じメールアドレスでサインインしてから、もう一度スキャンしてください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "此二维码对应 %@，但这部 iPhone 当前登录的是 %@。请使用与 Mac 相同的邮箱登录，然后重新扫描。"
        }
      }}
    },
    "mobile.pairing.emailMissingFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This QR is for %@. Sign in with the same email as the Mac, then scan again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この QR は %@ 用です。Mac と同じメールアドレスでサインインしてから、もう一度スキャンしてください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "此二维码对应 %@。请使用与 Mac 相同的邮箱登录，然后重新扫描。"
        }
      }}
    },
    "mobile.pairing.fail.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device looks offline. Connect to Wi-Fi or cellular, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末はオフラインのようです。Wi-Fiまたはモバイルデータに接続してから、もう一度お試しください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "此设备似乎处于离线状态。请连接到 Wi-Fi 或蜂窝网络，然后重试。"
        }
      }}
    },
    "mobile.pairing.guidance.authEnvironment": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use BETA, INTERNAL, or the App Store app with Stable or Nightly. Use this DEV app with a Mac that has the same DEV tag."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BETA、INTERNAL、または App Store アプリは Stable または Nightly と一緒に使用してください。この DEV アプリは同じ DEV タグを持つ Mac と一緒に使用してください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "请搭配 Stable 或 Nightly 使用 BETA、INTERNAL 或 App Store 应用。将此 DEV 应用与具有相同 DEV 标签的 Mac 搭配使用。"
        }
      }}
    },
    "mobile.pairing.guidance.authEnvironment.devMac": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair with a Mac running the release cmux app, or use a development-channel iPhone build for dev Macs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リリース版の cmux アプリを実行している Mac とペアリングするか、開発用の Mac には開発チャネルの iPhone ビルドを使用してください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "请与运行正式版 cmux 应用的 Mac 配对，或为开发版 Mac 使用开发通道的 iPhone 构建。"
        }
      }}
    },
    "mobile.pairing.guidance.buildIncompatible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DEV builds must use the same DEV tag. BETA, INTERNAL, and App Store builds connect only to Stable or Nightly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DEV ビルド同士は同じ DEV タグを使用する必要があります。BETA、INTERNAL、App Store ビルドは Stable または Nightly にのみ接続できます。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "DEV 构建必须使用相同的 DEV 标签。BETA、INTERNAL 和 App Store 构建只能连接到 Stable 或 Nightly。"
        }
      }}
    },
    "mobile.pairing.guidance.localNetwork": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings > cmux > Local Network, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 > cmux > ローカルネットワーク を開いてから、もう一度お試しください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "前往「设置 > cmux > 本地网络」，然后重试。"
        }
      }}
    },
    "mobile.pairing.guidance.macUpdateRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved computer will reconnect automatically after you update cmux on the Mac. You do not need to sign out or pair again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのcmuxをアップデートすると、保存済みのコンピュータに自動的に再接続します。サインアウトや再ペアリングは不要です。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "更新 Mac 上的 cmux 后，你已保存的电脑会自动重新连接。无需退出登录或重新配对。"
        }
      }}
    },
    "mobile.pairing.guidance.openMacApp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open cmux on your Mac, then scan the QR or link from it again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macでcmuxを開いてから、そのQRコードまたはリンクをもう一度スキャンしてください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "请在 Mac 上打开 cmux，然后重新扫描其中的二维码或链接。"
        }
      }}
    },
    "mobile.pairing.guidance.connectAttemptGated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A connection attempt is already in progress. Give it a moment to finish; retry only if this computer stays disconnected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに接続処理が進行中です。完了まで少しお待ちください。接続されないままの場合のみ再試行してください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "已有一个连接尝试正在进行。请稍等片刻让其完成；仅当这台电脑仍处于断开状态时再重试。"
        }
      }}
    },
    "mobile.pairing.guidance.routeCleanupBlocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Force-quit and reopen cmux on this iPhone, then reconnect. If this returns, restart cmux on the Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneでcmuxを強制終了して開き直し、再接続してください。再発する場合は、Macのcmuxを再起動してください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "请强制退出并重新打开这部 iPhone 上的 cmux，然后重新连接。如果问题再次出现，请在 Mac 上重启 cmux。"
        }
      }}
    },
    "mobile.pairing.guidance.reachability": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh reconnects automatically. For a saved private-network fallback, connect both devices to that network, wake the Mac, and open cmux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Irohは自動的に再接続します。保存済みのプライベートネットワークをフォールバックに使う場合は、両方の端末をそのネットワークに接続し、Macを起こしてcmuxを開いてください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "Iroh 会自动重新连接。如需使用已保存的专用网络回退方案，请将两台设备连接到该网络，唤醒 Mac，并打开 cmux。"
        }
      }}
    },
    "mobile.pairing.guidance.rescanFresh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Tailscale Pairing on your Mac and scan a fresh QR or link."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macで「Tailscaleペアリング」を開き、新しいQRコードまたはリンクをスキャンしてください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "请在 Mac 上打开「Tailscale 配对」，并扫描新的二维码或链接。"
        }
      }}
    },
    "mobile.pairing.guidance.sameAccount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both devices must be signed in to the same cmux account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方の端末が同じcmuxアカウントでサインインしている必要があります。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "两台设备必须登录到同一个 cmux 账户。"
        }
      }}
    },
    "mobile.pairing.guidance.updateApp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update cmux from the App Store (or TestFlight), then scan again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store（またはTestFlight）でcmuxを更新してから、もう一度スキャンしてください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "请从 App Store（或 TestFlight）更新 cmux，然后重新扫描。"
        }
      }}
    },
    "mobile.pairing.hostUnreachableFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach %@:%d. Make sure your Mac is awake and the private network or LAN for this saved route is active."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%d に接続できません。Macが起動していて、この保存済み経路のプライベートネットワークまたはLANが有効か確認してください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "无法到达 %@:%d。请确保你的 Mac 已唤醒，且此已保存路由对应的专用网络或局域网处于活动状态。"
        }
      }}
    },
    "mobile.pairing.invalidCode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This isn't a cmux pairing QR. Scan the code shown in Tailscale Pairing on your Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはcmuxのペアリングQRコードではありません。Macの「Tailscaleペアリング」に表示されているコードをスキャンしてください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "配对码无效。"
        }
      }}
    },
    "mobile.pairing.localNetworkPermission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS blocked the connection. Allow cmux to use the Local Network in iOS Settings, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSが接続をブロックしました。iOSの設定でcmuxにローカルネットワークの使用を許可してから、もう一度お試しください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "iOS 阻止了此连接。请在 iOS 设置中允许 cmux 使用本地网络，然后重试。"
        }
      }}
    },
    "mobile.pairing.macUpdateRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update cmux on this Mac to connect securely."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全に接続するには、このMacのcmuxをアップデートしてください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "更新这台 Mac 上的 cmux 以安全连接。"
        }
      }}
    },
    "mobile.pairing.loopbackRejected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code points at the Mac itself (localhost), so your iPhone can't use it. Open Tailscale Pairing on the Mac and scan a fresh code."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードはMac自身（localhost）を指しているため、iPhoneからは使えません。Macで「Tailscaleペアリング」を開き、新しいコードをスキャンしてください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "此代码指向 Mac 本身（localhost），因此你的 iPhone 无法使用。请在 Mac 上打开「Tailscale 配对」，并扫描新的代码。"
        }
      }}
    },
