    "mobile.iroh.relayOnly.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps this device's Iroh connections on cmux relays instead of direct or local-network paths. Applies on the next reconnect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスの Iroh 接続を、直接経路やローカルネットワーク経路ではなく cmux リレー経由に固定します。次回の再接続時に適用されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält die Iroh-Verbindungen dieses Geräts auf cmux-Relays statt auf direkten oder lokalen Netzwerkpfaden. Gilt bei der nächsten erneuten Verbindung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve les connexions Iroh de cet appareil sur des relais cmux au lieu de chemins directs ou de réseau local. S'applique à la prochaine reconnexion."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ باتصالات Iroh لهذا الجهاز على مرحلات cmux بدلاً من المسارات المباشرة أو مسارات الشبكة المحلية. ينطبق على إعادة الاتصال القادمة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene las conexiones Iroh de este dispositivo en relés cmux en lugar de rutas directas o de red local. Aplica en la próxima reconexión."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將此裝置的 Iroh 連線保持在 cmux 中繼上，而不是直接或本地網路路徑上。適用於下次重新連線。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此设备的 Iroh 连接保持在 cmux 中继上，而不是直接或本地网络路径上。适用于下次重新连接。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 또는 로컬 네트워크 경로 대신 cmux 릴레이에서 이 장치의 Iroh 연결을 유지합니다. 다음 재접속 시 적용됩니다."
          }
        }
      }
    },
