    "mobile.taskComposer.directoryPicker.search.coverage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search checks indexed folders across mounted volumes. Browse to reach unindexed or restricted locations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索では、マウントされたボリューム内のインデックス登録済みフォルダを確認します。インデックス未登録またはアクセス制限のある場所は、参照して探してください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "搜索会检查所有已挂载卷中的已索引文件夹。如需访问未索引或受限制的位置，请使用浏览。"
        }
      }}
    },
    "mobile.taskComposer.directoryPicker.search.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse the Mac to reach folders outside its search index."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macを参照すると、検索インデックス外のフォルダに移動できます。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "浏览 Mac 可访问其搜索索引之外的文件夹。"
        }
      }}
    },
    "mobile.taskComposer.directoryPicker.search.empty.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Indexed Matches"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インデックス内に一致する項目はありません"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "没有索引匹配项"
        }
      }}
    },
    "mobile.taskComposer.directoryPicker.search.limited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac returned limited search results. Browse to reach every accessible folder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacから返された検索結果は限定されています。アクセス可能なすべてのフォルダは参照して探せます。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "此 Mac 返回的搜索结果有限。请使用浏览以访问所有可访问的文件夹。"
        }
      }}
    },
    "mobile.taskComposer.directoryPicker.search.partial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac search index did not finish in time. Refine your search or retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macの検索インデックスが時間内に完了しませんでした。検索語を絞るか、もう一度お試しください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "Mac 搜索索引未及时完成。请优化搜索或重试。"
        }
      }}
    },
