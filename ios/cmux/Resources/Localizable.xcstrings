    "mobile.settings.diagnostics.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Log records in-app activity; the Network Log records connection diagnostics. Terminal contents and credentials are never written."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリログはアプリ内のアクティビティを記録し、ネットワークログは接続診断を記録します。ターミナルの内容や認証情報が書き込まれることはありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das App-Protokoll zeichnet In-App-Aktivitäten auf; Das Netzwerkprotokoll zeichnet Verbindungsdiagnosen auf. Terminalinhalte und Anmeldeinformationen werden niemals geschrieben."
          }
        },
        "fr": {
