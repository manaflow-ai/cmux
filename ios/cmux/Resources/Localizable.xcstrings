    "mobile.signIn.useDifferentEmail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم بريدًا إلكترونيًا مختلفًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie eine andere E-Mail"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a different email"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice un correo electrónico diferente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser une autre adresse e-mail"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のメールを使用"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 이메일을 사용하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用不同的电子邮件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用不同的電子郵件"
          }
        }
      }
    },
    "mobile.signIn.verificationBodyFormat": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد أرسلنا رابط التحقق إلى %@. افتحه، ثم ارجع إلى هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben einen Bestätigungslink an %@ gesendet. Öffnen Sie es und kehren Sie dann hierher zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We sent a verification link to %@. Open it, then return here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviamos un enlace de verificación a %@. Ábrelo y luego regresa aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons envoyé un lien de vérification à %@. Ouvrez-le, puis revenez ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に確認リンクを送信しました。リンクを開いてから、ここに戻ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@로 확인 링크를 보냈습니다. 그것을 열고 여기로 돌아오세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们向 %@ 发送了验证链接。打开它，然后返回这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們向 %@ 發送了驗證連結。打開它，然後返回這裡。"
          }
        }
      }
    },
    "mobile.signIn.verificationContinue": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد قمت بالتحقق من بريدي الإلكتروني"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe meine E-Mail bestätigt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I verified my email"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifiqué mi correo electrónico"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai vérifié mon email"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールを確認しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일을 확인했습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我验证了我的电子邮件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我驗證了我的電子郵件"
          }
        }
      }
    },
    "mobile.signIn.verificationPending": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم التحقق من هذا البريد الإلكتروني بعد. افتح رابط التحقق، ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese E-Mail ist noch nicht bestätigt. Öffnen Sie den Bestätigungslink und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That email is not verified yet. Open the verification link, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese correo electrónico aún no está verificado. Abra el enlace de verificación y vuelva a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet e-mail n'est pas encore vérifié. Ouvrez le lien de vérification, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメールアドレスはまだ確認されていません。確認リンクを開いてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 이메일은 아직 확인되지 않았습니다. 확인 링크를 연 후 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该电子邮件尚未验证。打开验证链接，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該電子郵件尚未驗證。打開驗證鏈接，然後重試。"
          }
        }
      }
    },
