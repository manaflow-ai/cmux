    "mobile.taskComposer.recovery.stillMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task is still missing. Refresh again or start it as a new task."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクがまだ見つかりません。もう一度更新するか、新しいタスクとして開始してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgabe fehlt noch. Aktualisieren Sie erneut oder starten Sie es als neue Aufgabe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche manque toujours. Actualisez à nouveau ou démarrez-le en tant que nouvelle tâche."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المهمة لا تزال مفقودة. قم بالتحديث مرة أخرى أو ابدأ كمهمة جديدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún falta la tarea. Actualice nuevamente o inícielo como una nueva tarea."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務依然不見蹤影。再次刷新或將其作為新任務啟動。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务依然不见踪影。再次刷新或将其作为新任务启动。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 아직 누락되었습니다. 다시 새로 고치거나 새 작업으로 시작하세요."
          }
        }
      }
    },
