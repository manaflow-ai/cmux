    "mobile.settings.teamFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switches which cmux team's computers and devices this app shows."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリに表示する cmux チームのコンピュータとデバイスを切り替えます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet um, welche Computer und Geräte des Cmux-Teams diese App anzeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bascule les ordinateurs et les appareils de l'équipe cmux affichés par cette application."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم بتبديل أجهزة الكمبيوتر والأجهزة الخاصة بفريق cmux التي يعرضها هذا التطبيق."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia qué computadoras y dispositivos del equipo cmux muestra esta aplicación."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換此應用程式顯示的 cmux 團隊的電腦和裝置。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换此应用程序显示的 cmux 团队的计算机和设备。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱이 표시하는 cmux 팀의 컴퓨터와 장치를 전환합니다."
          }
        }
      }
    },
