    "mobile.addDevice.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the Mac's pairing QR, or enter its numeric Tailscale IP and port. In the Simulator, 127.0.0.1 can connect to a local Mac. MagicDNS names and local or LAN hosts aren't supported for account-authenticated pairing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac のペアリング QR をスキャンするか、数値の Tailscale IP アドレスとポートを入力してください。シミュレータでは 127.0.0.1 で Mac に接続できます。アカウント認証によるペアリングでは、MagicDNS 名やローカル／LAN ホストはサポートされません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannen Sie den Kopplungs-QR des Mac oder geben Sie die numerische Tailscale-IP und den Port ein. Im Simulator kann 127.0.0.1 eine Verbindung zu einem lokalen Mac herstellen. MagicDNS-Namen und lokale oder LAN-Hosts werden für die kontoauthentifizierte Kopplung nicht unterstützt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez le QR de couplage du Mac ou entrez son adresse IP et son port Tailscale numériques. Dans le simulateur, 127.0.0.1 peut se connecter à un Mac local. Les noms MagicDNS et les hôtes locaux ou LAN ne sont pas pris en charge pour le couplage authentifié par compte."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بمسح QR الخاص بإقران جهاز Mac، أو أدخل رقم Tailscale IP والمنفذ. في جهاز المحاكاة، يمكن لـ 127.0.0.1 الاتصال بجهاز Mac محلي. أسماء MagicDNS والمضيفين المحليين أو مضيفي الشبكة المحلية (LAN) غير مدعومين للاقتران الذي تمت مصادقة الحساب عليه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanee el QR de emparejamiento de la Mac o ingrese su IP y puerto numéricos de Tailscale. En el Simulador, 127.0.0.1 puede conectarse a una Mac local. Los nombres MagicDNS y los hosts locales o LAN no son compatibles con el emparejamiento autenticado por cuenta."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描 Mac 的配對二維碼，或輸入其數位 Tailscale IP 和連接埠。在模擬器中，127.0.0.1可以連接到本機Mac。帳戶驗證配對不支援 MagicDNS 名稱和本機或 LAN 主機。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描 Mac 的配对二维码，或输入其数字 Tailscale IP 和端口。在模拟器中，127.0.0.1可以连接到本地Mac。帐户验证配对不支持 MagicDNS 名称和本地或 LAN 主机。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 페어링 QR을 스캔하거나 숫자로 된 Tailscale IP 및 포트를 입력하세요. 시뮬레이터에서 127.0.0.1은 로컬 Mac에 연결할 수 있습니다. MagicDNS 이름과 로컬 또는 LAN 호스트는 계정 인증 페어링에 지원되지 않습니다."
          }
        }
      }
    },
