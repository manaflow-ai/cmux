    "mobile.recovery.accountMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This computer is signed in to a different cmux account. Sign out and sign back in with that account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンピュータは別の cmux アカウントでサインインしています。そのアカウントでサインアウトしてからサインインし直してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Computer ist bei einem anderen cmux-Konto angemeldet. Melden Sie sich ab und wieder mit diesem Konto an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet ordinateur est connecté à un autre compte cmux. Déconnectez-vous et reconnectez-vous avec ce compte."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تسجيل دخول هذا الكمبيوتر إلى حساب cmux مختلف. قم بتسجيل الخروج وتسجيل الدخول مرة أخرى باستخدام هذا الحساب."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta computadora ha iniciado sesión en una cuenta cmux diferente. Cierra sesión y vuelve a iniciar sesión con esa cuenta."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此計算機已登入不同的 cmux 帳戶。登出並使用該帳戶重新登入。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此计算机已登录到不同的 cmux 帐户。注销并使用该帐户重新登录。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 컴퓨터는 다른 cmux 계정으로 로그인되어 있습니다. 로그아웃한 후 해당 계정으로 다시 로그인하세요."
          }
        }
      }
    },
