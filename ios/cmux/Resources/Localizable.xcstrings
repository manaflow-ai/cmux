    "mobile.onboarding.push.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a push when an agent is waiting, and reply right from the Lock Screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが待っているときにプッシュ通知が届き、ロック画面からそのまま返信できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalten Sie eine Push-Benachrichtigung, wenn ein Agent wartet, und antworten Sie direkt über den Sperrbildschirm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez un message lorsqu'un agent attend et répondez directement depuis l'écran de verrouillage."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على دفعة عندما يكون الوكيل في انتظارك، وقم بالرد مباشرة من شاشة القفل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reciba un empujón cuando un agente esté esperando y responda directamente desde la pantalla de bloqueo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當客服人員等待時收到推播，並直接從鎖定畫面回覆。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当客服人员等待时收到推送，并直接从锁定屏幕回复。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상담원이 대기 중일 때 푸시 알림을 받고 잠금 화면에서 바로 응답하세요."
          }
        }
      }
    },
