            "state": "translated",
            "value": "Dials this computer's encrypted Iroh identity using the addresses you enable below — for LAN, WireGuard, or any network where it's reachable. No relay discovery, no other computers' routes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
