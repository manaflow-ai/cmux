    "mobile.settings.accountFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device must be signed in to the same cmux account as the computer you pair with."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスは、ペアリングするコンピュータと同じ cmux アカウントでサインインしている必要があります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät muss bei demselben cmux-Konto angemeldet sein wie der Computer, mit dem Sie es koppeln."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil doit être connecté au même compte cmux que l'ordinateur avec lequel vous vous associez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب تسجيل دخول هذا الجهاز إلى نفس حساب cmux مثل الكمبيوتر الذي تقترن به."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo debe iniciar sesión en la misma cuenta cmux que la computadora con la que se vincula."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置必須登入與您配對的電腦相同的 cmux 帳戶。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备必须登录到与您配对的计算机相同的 cmux 帐户。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장치는 페어링하는 컴퓨터와 동일한 cmux 계정에 로그인해야 합니다."
          }
        }
      }
    },
