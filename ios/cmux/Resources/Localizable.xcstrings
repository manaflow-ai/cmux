    "mobile.todo.updateFailed.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your change was undone. Try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を元に戻しました。もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Änderung wurde rückgängig gemacht. Versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre modification a été annulée. Essayer à nouveau."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم التراجع عن التغيير الذي أجريته. حاول ثانية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cambio se deshizo. Intentar otra vez."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的變更已撤銷。再試一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的更改已撤消。再试一次。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경사항이 취소되었습니다. 다시 시도해 보세요."
          }
        }
      }
    },
