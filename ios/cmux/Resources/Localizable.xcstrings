    "mobile.iroh.private.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh discovers LAN and VPN paths after authenticating the Mac. Custom raw TCP routes are not accepted because they cannot prove the remote Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh は Mac を認証した後、LAN および VPN 経路を検出します。カスタムの生 TCP ルートはリモート Mac を証明できないため受け付けません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh erkennt LAN- und VPN-Pfade nach der Authentifizierung des Mac. Benutzerdefinierte unformatierte TCP-Routen werden nicht akzeptiert, da sie den Remote-Mac nicht nachweisen können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh découvre les chemins LAN et VPN après avoir authentifié le Mac. Les routes TCP brutes personnalisées ne sont pas acceptées car elles ne peuvent pas prouver le Mac distant."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكتشف Iroh مسارات LAN وVPN بعد مصادقة جهاز Mac. لا يتم قبول مسارات TCP الأولية المخصصة لأنها لا تستطيع إثبات جهاز Mac البعيد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh descubre rutas LAN y VPN después de autenticar la Mac. No se aceptan rutas TCP sin procesar personalizadas porque no pueden probar la Mac remota."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh 在 Mac 驗證後發現 LAN 和 VPN 路徑。不接受自訂原始 TCP 路由，因為它們無法證明遠端 Mac。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh 在对 Mac 进行身份验证后发现 LAN 和 VPN 路径。不接受自定义原始 TCP 路由，因为它们无法证明远程 Mac。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh는 Mac을 인증한 후 LAN 및 VPN 경로를 발견합니다. 사용자 정의 원시 TCP 경로는 원격 Mac을 증명할 수 없기 때문에 허용되지 않습니다."
          }
        }
      }
    },
