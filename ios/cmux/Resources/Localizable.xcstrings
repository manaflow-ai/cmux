    "mobile.onboarding.connect.method.tailscaleDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works with cmux 0.64.17 or later. Scan once to authorize the Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac版cmux 0.64.17以降で動作します。一度スキャンしてMacを承認します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert mit cmux 0.64.17 oder höher. Einmal scannen, um den Mac zu autorisieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne avec cmux 0.64.17 ou version ultérieure. Scannez une fois pour autoriser le Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل مع cmux 0.64.17 أو الأحدث. قم بالمسح الضوئي مرة واحدة لتخويل جهاز Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona con cmux 0.64.17 o posterior. Escanee una vez para autorizar la Mac."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於 cmux 0.64.17 或更高版本。掃描一次即可授權 Mac。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于 cmux 0.64.17 或更高版本。扫描一次即可授权 Mac。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 0.64.17 이상에서 작동합니다. 한 번 스캔하여 Mac을 인증하세요."
          }
        }
      }
    },
