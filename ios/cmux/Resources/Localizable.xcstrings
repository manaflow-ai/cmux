    },
    "mobile.onboarding.connect.tailscaleBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works with cmux 0.64.17 or later. Install Tailscale on both devices and join the same network. On 0.64.17, choose Connect iPhone/iPad and scan the Pair iPhone code once."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 0.64.17以降で動作します。両方のデバイスにTailscaleをインストールし、同じネットワークに参加してください。0.64.17では「Connect iPhone/iPad」を選び、「Pair iPhone」のコードを一度スキャンします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert mit cmux 0.64.17 oder höher. Installieren Sie Tailscale auf beiden Geräten und verbinden Sie sich mit demselben Netzwerk. Wählen Sie unter 0.64.17 „iPhone/iPad verbinden“ und scannen Sie den Code „iPhone koppeln“ einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne avec cmux 0.64.17 ou version ultérieure. Installez Tailscale sur les deux appareils et rejoignez le même réseau. Le 0.64.17, choisissez Connecter iPhone/iPad et scannez une fois le code Pair iPhone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل مع cmux 0.64.17 أو الأحدث. قم بتثبيت Tailscale على كلا الجهازين والانضمام إلى نفس الشبكة. في الإصدار 0.64.17، اختر Connect iPhone/iPad وقم بمسح رمز Pair iPhone ضوئيًا مرة واحدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona con cmux 0.64.17 o posterior. Instale Tailscale en ambos dispositivos y únase a la misma red. El 0.64.17, elija Conectar iPhone/iPad y escanee el código de Emparejar iPhone una vez."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於 cmux 0.64.17 或更高版本。在兩台裝置上安裝 Tailscale 並加入同一網路。在 0.64.17 上，選擇「連接 iPhone/iPad」並掃描一次「配對 iPhone」代碼。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于 cmux 0.64.17 或更高版本。在两台设备上安装 Tailscale 并加入同一网络。在 0.64.17 上，选择“连接 iPhone/iPad”并扫描一次“配对 iPhone”代码。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 0.64.17 이상에서 작동합니다. 두 장치 모두에 Tailscale을 설치하고 동일한 네트워크에 연결하십시오. 0.64.17에서는 Connect iPhone/iPad를 선택하고 iPhone 페어링 코드를 한 번 스캔하세요."
          }
        }
      }
    },
