    "mobile.settings.diagnostics.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Log records in-app activity; the Network Log records connection diagnostics. Terminal contents and credentials are never written."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリログはアプリ内のアクティビティを記録し、ネットワークログは接続診断を記録します。ターミナルの内容や認証情報が書き込まれることはありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das App-Protokoll zeichnet In-App-Aktivitäten auf; Das Netzwerkprotokoll zeichnet Verbindungsdiagnosen auf. Terminalinhalte und Anmeldeinformationen werden niemals geschrieben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal de l'application enregistre l'activité dans l'application ; le journal réseau enregistre les diagnostics de connexion. Le contenu du terminal et les informations d'identification ne sont jamais écrits."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجل سجل التطبيق النشاط داخل التطبيق؛ يسجل سجل الشبكة تشخيصات الاتصال. لا تتم كتابة محتويات المحطة وبيانات الاعتماد أبدًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro de aplicaciones registra la actividad dentro de la aplicación; el Registro de red registra los diagnósticos de conexión. El contenido y las credenciales del terminal nunca se escriben."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式日誌記錄應用程式內的活動；網路日誌記錄連線診斷。終端內容和憑證永遠不會被寫入。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用程序日志记录应用程序内的活动；网络日志记录连接诊断。终端内容和凭据永远不会被写入。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 로그는 인앱 활동을 기록합니다. 네트워크 로그는 연결 진단을 기록합니다. 터미널 내용과 자격 증명은 기록되지 않습니다."
          }
        }
      }
