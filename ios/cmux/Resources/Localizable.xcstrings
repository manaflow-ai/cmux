    "mobile.settings.rebuildKeyboardDockCaption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the rebuilt keyboard path instead of the default (iOS 26 and earlier). Reopen the workspace to apply."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトの代わりに再構築版キーボード処理を使用します（iOS 26 以前）。ワークスペースを開き直すと適用されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie den neu erstellten Tastaturpfad anstelle des Standardpfads (iOS 26 und früher). Öffnen Sie den Arbeitsbereich erneut, um sich zu bewerben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le chemin du clavier reconstruit au lieu de celui par défaut (iOS 26 et versions antérieures). Rouvrez l'espace de travail pour postuler."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم مسار لوحة المفاتيح المُعاد إنشاؤه بدلاً من المسار الافتراضي (iOS 26 والإصدارات الأقدم). أعد فتح مساحة العمل للتطبيق."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice la ruta del teclado reconstruida en lugar de la predeterminada (iOS 26 y versiones anteriores). Vuelva a abrir el espacio de trabajo para presentar la solicitud."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用重建的鍵盤路徑而不是預設路徑（iOS 26 及更早版本）。重新開啟工作區以套用。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用重建的键盘路径而不是默认路径（iOS 26 及更早版本）。重新打开工作区以应用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값(iOS 26 이하) 대신 재구축된 키보드 경로를 사용하세요. 적용하려면 작업공간을 다시 엽니다."
          }
        }
      }
    },
