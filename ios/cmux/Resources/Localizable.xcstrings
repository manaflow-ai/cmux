    "mobile.taskComposer.directoryPicker.browse.failure.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac could not list this folder. cmux may not have permission to read it yet. Allow access in Mac System Settings › Privacy & Security › Files & Folders, or grant cmux Full Disk Access, then retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macでこのフォルダの一覧を取得できませんでした。cmuxにこのフォルダへのアクセスがまだ許可されていない可能性があります。Macの「システム設定」＞「プライバシーとセキュリティ」＞「ファイルとフォルダ」でアクセスを許可するか、cmuxに「フルディスクアクセス」を付与してから、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac konnte diesen Ordner nicht auflisten. cmux hat möglicherweise noch keine Leseberechtigung. Erlauben Sie den Zugriff in den Mac-Systemeinstellungen › Datenschutz und Sicherheit › Dateien und Ordner oder gewähren Sie cmux vollständigen Festplattenzugriff und versuchen Sie es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac could not list this folder. cmux may not have permission to read it yet. Allow access in Mac System Settings › Privacy & Security › Files & Folders, or grant cmux Full Disk Access, then retry."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac could not list this folder. cmux may not have permission to read it yet. Allow access in Mac System Settings › Privacy & Security › Files & Folders, or grant cmux Full Disk Access, then retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac could not list this folder. cmux may not have permission to read it yet. Allow access in Mac System Settings › Privacy & Security › Files & Folders, or grant cmux Full Disk Access, then retry."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac could not list this folder. cmux may not have permission to read it yet. Allow access in Mac System Settings › Privacy & Security › Files & Folders, or grant cmux Full Disk Access, then retry."
