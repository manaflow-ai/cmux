    "mobile.settings.connectionMethod.automaticFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires cmux 0.64.20 or later on your Mac. Connects automatically over an authenticated, end-to-end encrypted connection."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac版cmux 0.64.20以降が必要です。認証済みのエンドツーエンド暗号化接続で自動的に接続します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert cmux 0.64.20 oder höher auf Ihrem Mac. Stellt automatisch eine Verbindung über eine authentifizierte, Ende-zu-Ende-verschlüsselte Verbindung her."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite cmux 0.64.20 ou version ultérieure sur votre Mac. Se connecte automatiquement via une connexion authentifiée et cryptée de bout en bout."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب cmux 0.64.20 أو أحدث على جهاز Mac الخاص بك. يتصل تلقائيًا عبر اتصال مشفر ومصدق من طرف إلى طرف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere cmux 0.64.20 o posterior en tu Mac. Se conecta automáticamente a través de una conexión cifrada de extremo a extremo autenticada."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 上需要 cmux 0.64.20 或更高版本。透過經過身份驗證的端對端加密連線自動連線。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 上需要 cmux 0.64.20 或更高版本。通过经过身份验证的端到端加密连接自动连接。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에는 cmux 0.64.20 이상이 필요합니다. 인증되고 종단 간 암호화된 연결을 통해 자동으로 연결됩니다."
          }
        }
      }
    },
    "mobile.settings.connectionMethod.tailscale": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale Only"
          }
        },
