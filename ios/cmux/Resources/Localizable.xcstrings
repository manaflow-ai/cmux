    "mobile.tailscale.disconnectedHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac may be unreachable because Tailscale is off here. Turn it on, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスで Tailscale がオフのため、Mac に接続できない可能性があります。Tailscale をオンにしてから、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Mac ist möglicherweise nicht erreichbar, da Tailscale hier deaktiviert ist. Schalten Sie es ein und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Mac est peut-être inaccessible car Tailscale est désactivé ici. Allumez-le, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ربما لا يمكن الوصول إلى جهاز Mac الخاص بك لأن Tailscale متوقف هنا. قم بتشغيله، ثم حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que no se pueda acceder a tu Mac porque Tailscale está desactivado aquí. Enciéndelo y vuelve a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 Mac 可能無法訪問，因為 Tailscale 已關閉。打開它，然後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 Mac 可能无法访问，因为 Tailscale 已关闭。打开它，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale이 여기에서 꺼져 있기 때문에 Mac에 접근하지 못할 수도 있습니다. 전원을 켠 후 다시 시도해 보세요."
          }
        }
      }
    },
