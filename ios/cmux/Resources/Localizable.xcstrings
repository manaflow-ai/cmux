    "mobile.pairing.guidance.macUpdateRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved computer will reconnect automatically after you update cmux on the Mac. You do not need to sign out or pair again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのcmuxをアップデートすると、保存済みのコンピュータに自動的に再接続します。サインアウトや再ペアリングは不要です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr gespeicherter Computer wird automatisch wieder verbunden, nachdem Sie cmux auf dem Mac aktualisiert haben. Sie müssen sich nicht abmelden oder erneut koppeln."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved computer will reconnect automatically after you update cmux on the Mac. You do not need to sign out or pair again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved computer will reconnect automatically after you update cmux on the Mac. You do not need to sign out or pair again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved computer will reconnect automatically after you update cmux on the Mac. You do not need to sign out or pair again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved computer will reconnect automatically after you update cmux on the Mac. You do not need to sign out or pair again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved computer will reconnect automatically after you update cmux on the Mac. You do not need to sign out or pair again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved computer will reconnect automatically after you update cmux on the Mac. You do not need to sign out or pair again."
          }
        }
      }
    },
