          }
        }
      }
    },
    "mobile.taskComposer.directoryPicker.browse.failure.missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder moved or no longer exists. Choose another location."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダは移動されたか、存在しません。別の場所を選択してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner wurde verschoben oder existiert nicht mehr. Wählen Sie einen anderen Standort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier a été déplacé ou n'existe plus. Choisissez un autre emplacement."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم نقل هذا المجلد أو لم يعد موجودًا. اختر موقعًا آخر."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta se movió o ya no existe. Elija otra ubicación."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹已移动或不再存在。選擇另一個位置。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹已移动或不再存在。选择另一个位置。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더는 이동되었거나 더 이상 존재하지 않습니다. 다른 위치를 선택하세요."
          }
        }
      }
    },
    "mobile.taskComposer.directoryPicker.browse.failure.permission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux does not have permission to read this folder on the Mac. Allow access in Mac System Settings › Privacy & Security › Files & Folders, or grant cmux Full Disk Access, then retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmuxにはMac上のこのフォルダを読み取る許可がありません。Macの「システム設定」＞「プライバシーとセキュリティ」＞「ファイルとフォルダ」でアクセスを許可するか、cmuxに「フルディスクアクセス」を付与してから、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux hat keine Berechtigung, diesen Ordner auf dem Mac zu lesen. Erlauben Sie den Zugriff in den Mac-Systemeinstellungen › Datenschutz und Sicherheit › Dateien und Ordner oder gewähren Sie cmux vollständigen Festplattenzugriff und versuchen Sie es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux n'est pas autorisé à lire ce dossier sur Mac. Autorisez l'accès dans Paramètres système Mac › Confidentialité et sécurité › Fichiers et dossiers, ou accordez l'accès complet au disque cmux, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس لدى cmux إذن لقراءة هذا المجلد على جهاز Mac. اسمح بالوصول في إعدادات نظام Mac ›الخصوصية والأمان ›الملفات والمجلدات، أو امنح cmux الوصول الكامل إلى القرص، ثم أعد المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no tiene permiso para leer esta carpeta en Mac. Permita el acceso en Configuración del sistema Mac › Privacidad y seguridad › Archivos y carpetas, o conceda a cmux acceso completo al disco y luego vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 無權在 Mac 上讀取此資料夾。在 Mac 系統設定 › 隱私和安全性 › 檔案和資料夾中允許訪問，或授予 cmux 完全磁碟存取權限，然後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 无权在 Mac 上读取此文件夹。在 Mac 系统设置 › 隐私和安全 › 文件和文件夹中允许访问，或授予 cmux 完全磁盘访问权限，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux에는 Mac에서 이 폴더를 읽을 수 있는 권한이 없습니다. Mac 시스템 설정 > 개인 정보 보호 및 보안 > 파일 및 폴더에서 액세스를 허용하거나 cmux 전체 디스크 액세스 권한을 부여한 후 다시 시도하십시오."
          }
        }
      }
    },
    "mobile.taskComposer.directoryPicker.browse.failure.timeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder took too long to load. Check the Mac or network volume, then retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダの読み込みに時間がかかりすぎました。Macまたはネットワークボリュームを確認して、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laden dieses Ordners hat zu lange gedauert. Überprüfen Sie das Mac- oder Netzwerk-Volume und versuchen Sie es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier a pris trop de temps à charger. Vérifiez le volume Mac ou réseau, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استغرق تحميل هذا المجلد وقتًا طويلاً. تحقق من حجم صوت Mac أو الشبكة، ثم أعد المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta tardó demasiado en cargarse. Verifique el volumen de Mac o de red, luego vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該資料夾載入時間太長。檢查 Mac 或網路音量，然後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件夹加载时间太长。检查 Mac 或网络音量，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더를 로드하는 데 시간이 너무 오래 걸렸습니다. Mac 또는 네트워크 볼륨을 확인한 후 다시 시도하세요."
          }
        }
      }
    },
