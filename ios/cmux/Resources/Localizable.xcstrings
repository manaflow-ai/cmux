    "mobile.feedback.explanation.agent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends diagnostics (debug log + visible terminal) and your note straight to the paired Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断情報（デバッグログ＋表示中のターミナル）とメモをペアリング済みの Mac に直接送信します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet Diagnosedaten (Debug-Protokoll + sichtbares Terminal) und Ihre Notiz direkt an den gekoppelten Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie des diagnostics (journal de débogage + terminal visible) et votre note directement au Mac couplé."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل التشخيصات (سجل التصحيح + المحطة المرئية) وملاحظتك مباشرة إلى جهاز Mac المقترن."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía diagnósticos (registro de depuración + terminal visible) y su nota directamente a la Mac emparejada."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將診斷資訊（偵錯日誌 + 可見終端）和您的註解直接傳送到配對的 Mac。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将诊断信息（调试日志 + 可见终端）和您的注释直接发送到配对的 Mac。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진단(디버그 로그 + 표시되는 터미널) 및 메모를 페어링된 Mac으로 직접 보냅니다."
          }
        }
      }
    },
    "mobile.feedback.explanation.email": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emails your feedback to the cmux team, stamped with your app version and device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのバージョンとデバイス情報を付けて、フィードバックを cmux チームにメールで送信します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet Ihr Feedback per E-Mail an das cmux-Team, gestempelt mit Ihrer App-Version und Ihrem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie vos commentaires par e-mail à l'équipe cmux, avec la version de votre application et votre appareil."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإرسال ملاحظاتك عبر البريد الإلكتروني إلى فريق cmux، مختومة بإصدار التطبيق والجهاز الخاص بك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía por correo electrónico sus comentarios al equipo de cmux, estampados con la versión de su aplicación y su dispositivo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過電子郵件將您的回饋發送給 cmux 團隊，並蓋上您的應用程式版本和裝置的印記。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过电子邮件将您的反馈发送给 cmux 团队，并盖上您的应用程序版本和设备的印记。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 버전과 장치가 포함된 피드백을 cmux 팀에 이메일로 보냅니다."
          }
        }
      }
    },
