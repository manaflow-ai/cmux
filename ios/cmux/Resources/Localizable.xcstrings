          }
        }
      }
    },
    "mobile.iroh.saveFailed.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your previous networking configuration is still active. Check your account connection and values, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のネットワーク設定が引き続き有効です。アカウント接続と値を確認して、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre vorherige Netzwerkkonfiguration ist noch aktiv. Überprüfen Sie die Verbindung und Werte Ihres Kontos und versuchen Sie es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre configuration réseau précédente est toujours active. Vérifiez la connexion et les valeurs de votre compte, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال تكوين الشبكة السابق نشطًا. تحقق من اتصال حسابك وقيمه، ثم حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su configuración de red anterior todavía está activa. Verifique la conexión y los valores de su cuenta y vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您之前的網路配置仍然有效。檢查您的帳戶連線和值，然後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您之前的网络配置仍然有效。检查您的帐户连接和值，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 네트워킹 구성이 여전히 활성 상태입니다. 계정 연결 및 값을 확인한 후 다시 시도하세요."
          }
        }
      }
    },
