    "mobile.settings.deleteAccountPartialFailureMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your cmux data was deleted, but account sign-in cleanup did not finish. Try Delete Account again to complete deletion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux のデータは削除されましたが、アカウントのサインイン情報のクリーンアップは完了しませんでした。削除を完了するには、もう一度「アカウントを削除」をお試しください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "你的 cmux 数据已删除，但账户登录清理尚未完成。请再次尝试删除账户以完成删除。"
        }
      }}
    },
    "mobile.settings.deleteAccountServerCleanupIncompleteMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account sign-in was deleted, but some cmux cleanup did not finish. You will be signed out. Contact support if cmux data is still visible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントのサインイン情報は削除されましたが、一部の cmux クリーンアップは完了しませんでした。サインアウトします。cmux データがまだ表示される場合はサポートにお問い合わせください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "你的账户登录已删除，但部分 cmux 清理尚未完成。你将退出登录。如果 cmux 数据仍然可见，请联系支持。"
        }
      }}
    },
    "mobile.settings.deleteAccountTimedOutMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account deletion timed out. Check your connection and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントの削除がタイムアウトしました。接続を確認してからもう一度お試しください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "删除账户超时。请检查连接后重试。"
        }
      }}
    },
    "mobile.settings.deleteAccountUnauthorizedMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session is no longer valid. You will be signed out on this device. Sign in again if the account still exists."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションが無効になりました。このデバイスではサインアウトされます。アカウントがまだ存在する場合は、もう一度サインインしてください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "你的会话已失效。你将在此设备上退出登录。如果账户仍然存在，请重新登录。"
        }
      }}
    },
    "mobile.settings.deleteAccountUnknownMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't confirm whether account deletion finished. Wait a moment, then try Delete Account again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントの削除が完了したか確認できませんでした。少し待ってから、もう一度「アカウントを削除」をお試しください。"
          }
        }
      ,
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "我们无法确认账户删除是否已完成。请稍等片刻，然后再次尝试删除账户。"
        }
      }}
    },
    "mobile.settings.deleteAccountMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
