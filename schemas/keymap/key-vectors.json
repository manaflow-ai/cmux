{
  "$comment": "HAND-EDITED. Synthetic key events that cmux-keymap (Rust, tests/vectors.rs) and webviews/src/ui/keyStyle.ts (keyStyle.test.ts) must both resolve the same way (design/keyboard-style.md). An event is {code, key, shiftedKey?, mods}: code is the physical key (W3C KeyboardEvent.code), key what the layout types on it without modifiers (lowercase; \"Dead\" for a dead key), shiftedKey what it types with Shift, mods any of cmd, ctrl, alt, shift. `layouts` gives each layout's characters by code, for the events the cases build with {layout, code}. A shortcut case says whether the binding (keybindings.json stroke syntax) matches the event in each app.shortcutLayout mode. A list case feeds strokes to app.keyStyle's list layer and names each outcome: a command, \"pending\" (the first g of gg) or \"pass\" (the key is left to the surface).",
  "layouts": {
    "qwerty": {
      "KeyQ": ["q", "Q"], "KeyW": ["w", "W"], "KeyE": ["e", "E"], "KeyR": ["r", "R"], "KeyT": ["t", "T"],
      "KeyY": ["y", "Y"], "KeyU": ["u", "U"], "KeyI": ["i", "I"], "KeyO": ["o", "O"], "KeyP": ["p", "P"],
      "BracketLeft": ["[", "{"], "BracketRight": ["]", "}"],
      "KeyA": ["a", "A"], "KeyS": ["s", "S"], "KeyD": ["d", "D"], "KeyF": ["f", "F"], "KeyG": ["g", "G"],
      "KeyH": ["h", "H"], "KeyJ": ["j", "J"], "KeyK": ["k", "K"], "KeyL": ["l", "L"], "Semicolon": [";", ":"],
      "Quote": ["'", "\""], "Backslash": ["\\", "|"],
      "KeyZ": ["z", "Z"], "KeyX": ["x", "X"], "KeyC": ["c", "C"], "KeyV": ["v", "V"], "KeyB": ["b", "B"],
      "KeyN": ["n", "N"], "KeyM": ["m", "M"], "Comma": [",", "<"], "Period": [".", ">"], "Slash": ["/", "?"],
      "Digit1": ["1", "!"], "Digit2": ["2", "@"], "Digit3": ["3", "#"], "Digit0": ["0", ")"],
      "Minus": ["-", "_"], "Equal": ["=", "+"], "Backquote": ["`", "~"]
    },
    "dvorak": {
      "KeyQ": ["'", "\""], "KeyW": [",", "<"], "KeyE": [".", ">"], "KeyR": ["p", "P"], "KeyT": ["y", "Y"],
      "KeyY": ["f", "F"], "KeyU": ["g", "G"], "KeyI": ["c", "C"], "KeyO": ["r", "R"], "KeyP": ["l", "L"],
      "BracketLeft": ["/", "?"], "BracketRight": ["=", "+"],
      "KeyA": ["a", "A"], "KeyS": ["o", "O"], "KeyD": ["e", "E"], "KeyF": ["u", "U"], "KeyG": ["i", "I"],
      "KeyH": ["d", "D"], "KeyJ": ["h", "H"], "KeyK": ["t", "T"], "KeyL": ["n", "N"], "Semicolon": ["s", "S"],
      "Quote": ["-", "_"], "Backslash": ["\\", "|"],
      "KeyZ": [";", ":"], "KeyX": ["q", "Q"], "KeyC": ["j", "J"], "KeyV": ["k", "K"], "KeyB": ["x", "X"],
      "KeyN": ["b", "B"], "KeyM": ["m", "M"], "Comma": ["w", "W"], "Period": ["v", "V"], "Slash": ["z", "Z"],
      "Digit1": ["1", "!"], "Digit2": ["2", "@"], "Digit3": ["3", "#"], "Digit0": ["0", ")"],
      "Minus": ["[", "{"], "Equal": ["]", "}"], "Backquote": ["`", "~"]
    },
    "colemak": {
      "KeyQ": ["q", "Q"], "KeyW": ["w", "W"], "KeyE": ["f", "F"], "KeyR": ["p", "P"], "KeyT": ["g", "G"],
      "KeyY": ["j", "J"], "KeyU": ["l", "L"], "KeyI": ["u", "U"], "KeyO": ["y", "Y"], "KeyP": [";", ":"],
      "BracketLeft": ["[", "{"], "BracketRight": ["]", "}"],
      "KeyA": ["a", "A"], "KeyS": ["r", "R"], "KeyD": ["s", "S"], "KeyF": ["t", "T"], "KeyG": ["d", "D"],
      "KeyH": ["h", "H"], "KeyJ": ["n", "N"], "KeyK": ["e", "E"], "KeyL": ["i", "I"], "Semicolon": ["o", "O"],
      "Quote": ["'", "\""], "Backslash": ["\\", "|"],
      "KeyZ": ["z", "Z"], "KeyX": ["x", "X"], "KeyC": ["c", "C"], "KeyV": ["v", "V"], "KeyB": ["b", "B"],
      "KeyN": ["k", "K"], "KeyM": ["m", "M"], "Comma": [",", "<"], "Period": [".", ">"], "Slash": ["/", "?"],
      "Digit1": ["1", "!"], "Digit2": ["2", "@"], "Digit3": ["3", "#"], "Digit0": ["0", ")"],
      "Minus": ["-", "_"], "Equal": ["=", "+"], "Backquote": ["`", "~"]
    },
    "azerty": {
      "KeyQ": ["a", "A"], "KeyW": ["z", "Z"], "KeyE": ["e", "E"], "KeyR": ["r", "R"], "KeyT": ["t", "T"],
      "KeyY": ["y", "Y"], "KeyU": ["u", "U"], "KeyI": ["i", "I"], "KeyO": ["o", "O"], "KeyP": ["p", "P"],
      "BracketLeft": ["Dead", "Dead"], "BracketRight": ["$", "*"],
      "KeyA": ["q", "Q"], "KeyS": ["s", "S"], "KeyD": ["d", "D"], "KeyF": ["f", "F"], "KeyG": ["g", "G"],
      "KeyH": ["h", "H"], "KeyJ": ["j", "J"], "KeyK": ["k", "K"], "KeyL": ["l", "L"], "Semicolon": ["m", "M"],
      "Quote": ["ù", "%"], "Backslash": ["`", "£"],
      "KeyZ": ["w", "W"], "KeyX": ["x", "X"], "KeyC": ["c", "C"], "KeyV": ["v", "V"], "KeyB": ["b", "B"],
      "KeyN": ["n", "N"], "KeyM": [",", "?"], "Comma": [";", "."], "Period": [":", "/"], "Slash": ["=", "+"],
      "Digit1": ["&", "1"], "Digit2": ["é", "2"], "Digit3": ["\"", "3"], "Digit0": ["à", "0"],
      "Minus": [")", "°"], "Equal": ["-", "_"], "Backquote": ["<", ">"]
    },
    "qwertz": {
      "KeyQ": ["q", "Q"], "KeyW": ["w", "W"], "KeyE": ["e", "E"], "KeyR": ["r", "R"], "KeyT": ["t", "T"],
      "KeyY": ["z", "Z"], "KeyU": ["u", "U"], "KeyI": ["i", "I"], "KeyO": ["o", "O"], "KeyP": ["p", "P"],
      "BracketLeft": ["ü", "Ü"], "BracketRight": ["+", "*"],
      "KeyA": ["a", "A"], "KeyS": ["s", "S"], "KeyD": ["d", "D"], "KeyF": ["f", "F"], "KeyG": ["g", "G"],
      "KeyH": ["h", "H"], "KeyJ": ["j", "J"], "KeyK": ["k", "K"], "KeyL": ["l", "L"], "Semicolon": ["ö", "Ö"],
      "Quote": ["ä", "Ä"], "Backslash": ["#", "'"],
      "KeyZ": ["y", "Y"], "KeyX": ["x", "X"], "KeyC": ["c", "C"], "KeyV": ["v", "V"], "KeyB": ["b", "B"],
      "KeyN": ["n", "N"], "KeyM": ["m", "M"], "Comma": [",", ";"], "Period": [".", ":"], "Slash": ["-", "_"],
      "Digit1": ["1", "!"], "Digit2": ["2", "\""], "Digit3": ["3", "§"], "Digit0": ["0", "="],
      "Minus": ["ß", "?"], "Equal": ["Dead", "Dead"], "Backquote": ["<", ">"]
    }
  },
  "$shortcutComment": "followLayout: a shortcut is the character the layout types (today's behavior), with three fallbacks so every shortcut stays reachable: a digit-row key also counts as its digit (AZERTY's & key is 1), a key that types a non-ASCII character or is a dead key counts as its US position (QWERTZ's ü is [), and a character the layout only types with Shift matches a binding without Shift (AZERTY's / is Shift-:), but never a letter's capital (Cmd-Shift-Z stays Cmd-Shift-Z). qwertyPositions: a shortcut is the key at that US position, whatever the layout types (Dvorak's Cmd-; key is Cmd-Z).",
  "shortcuts": [
    { "name": "qwerty cmd+z", "layout": "qwerty", "code": "KeyZ", "mods": ["cmd"], "binding": "cmd+z", "followLayout": true, "qwertyPositions": true },
    { "name": "dvorak: the key labeled ; is US z", "layout": "dvorak", "code": "KeyZ", "mods": ["cmd"], "binding": "cmd+z", "followLayout": false, "qwertyPositions": true },
    { "name": "dvorak: the key that types z (US /)", "layout": "dvorak", "code": "Slash", "mods": ["cmd"], "binding": "cmd+z", "followLayout": true, "qwertyPositions": false },
    { "name": "dvorak: cmd+/ by character is on US [", "layout": "dvorak", "code": "BracketLeft", "mods": ["cmd"], "binding": "cmd+/", "followLayout": true, "qwertyPositions": false },
    { "name": "dvorak: cmd+/ by position", "layout": "dvorak", "code": "Slash", "mods": ["cmd"], "binding": "cmd+/", "followLayout": false, "qwertyPositions": true },
    { "name": "dvorak: cmd+shift+] by position", "layout": "dvorak", "code": "BracketRight", "mods": ["cmd", "shift"], "binding": "cmd+shift+]", "followLayout": false, "qwertyPositions": true },
    { "name": "dvorak: cmd+shift+] by character (US =)", "layout": "dvorak", "code": "Equal", "mods": ["cmd", "shift"], "binding": "cmd+shift+]", "followLayout": true, "qwertyPositions": false },
    { "name": "dvorak: cmd+1 both ways", "layout": "dvorak", "code": "Digit1", "mods": ["cmd"], "binding": "cmd+1", "followLayout": true, "qwertyPositions": true },
    { "name": "colemak: cmd+e by character is US k", "layout": "colemak", "code": "KeyK", "mods": ["cmd"], "binding": "cmd+e", "followLayout": true, "qwertyPositions": false },
    { "name": "colemak: cmd+e by position", "layout": "colemak", "code": "KeyE", "mods": ["cmd"], "binding": "cmd+e", "followLayout": false, "qwertyPositions": true },
    { "name": "colemak: cmd+; by character (US p)", "layout": "colemak", "code": "KeyP", "mods": ["cmd"], "binding": "cmd+;", "followLayout": true, "qwertyPositions": false },
    { "name": "colemak: cmd+[ unchanged", "layout": "colemak", "code": "BracketLeft", "mods": ["cmd"], "binding": "cmd+[", "followLayout": true, "qwertyPositions": true },
    { "name": "azerty: cmd+a by character is US q", "layout": "azerty", "code": "KeyQ", "mods": ["cmd"], "binding": "cmd+a", "followLayout": true, "qwertyPositions": false },
    { "name": "azerty: cmd+q by character is US a, never quits by position", "layout": "azerty", "code": "KeyA", "mods": ["cmd"], "binding": "cmd+q", "followLayout": true, "qwertyPositions": false },
    { "name": "azerty: cmd+1 on the & key", "layout": "azerty", "code": "Digit1", "mods": ["cmd"], "binding": "cmd+1", "followLayout": true, "qwertyPositions": true },
    { "name": "azerty: cmd+2 on the é key", "layout": "azerty", "code": "Digit2", "mods": ["cmd"], "binding": "cmd+2", "followLayout": true, "qwertyPositions": true },
    { "name": "azerty: cmd+[ on the dead ^ key", "layout": "azerty", "code": "BracketLeft", "mods": ["cmd"], "binding": "cmd+[", "followLayout": true, "qwertyPositions": true },
    { "name": "azerty: cmd+/ is Shift-: by character", "layout": "azerty", "code": "Period", "mods": ["cmd", "shift"], "binding": "cmd+/", "followLayout": true, "qwertyPositions": false },
    { "name": "azerty: cmd+/ by position is the = key", "layout": "azerty", "code": "Slash", "mods": ["cmd"], "binding": "cmd+/", "followLayout": false, "qwertyPositions": true },
    { "name": "azerty: cmd+, by character is US m", "layout": "azerty", "code": "KeyM", "mods": ["cmd"], "binding": "cmd+,", "followLayout": true, "qwertyPositions": false },
    { "name": "azerty: cmd+m by character is US ;", "layout": "azerty", "code": "Semicolon", "mods": ["cmd"], "binding": "cmd+m", "followLayout": true, "qwertyPositions": false },
    { "name": "qwertz: cmd+z by character is US y", "layout": "qwertz", "code": "KeyY", "mods": ["cmd"], "binding": "cmd+z", "followLayout": true, "qwertyPositions": false },
    { "name": "qwertz: cmd+z by position", "layout": "qwertz", "code": "KeyZ", "mods": ["cmd"], "binding": "cmd+z", "followLayout": false, "qwertyPositions": true },
    { "name": "qwertz: cmd+[ on the ü key", "layout": "qwertz", "code": "BracketLeft", "mods": ["cmd"], "binding": "cmd+[", "followLayout": true, "qwertyPositions": true },
    { "name": "qwertz: cmd+shift+[ on the ü key", "layout": "qwertz", "code": "BracketLeft", "mods": ["cmd", "shift"], "binding": "cmd+shift+[", "followLayout": true, "qwertyPositions": true },
    { "name": "qwertz: cmd+= on the dead ´ key", "layout": "qwertz", "code": "Equal", "mods": ["cmd"], "binding": "cmd+=", "followLayout": true, "qwertyPositions": true },
    { "name": "qwertz: cmd+- by character is US /", "layout": "qwertz", "code": "Slash", "mods": ["cmd"], "binding": "cmd+-", "followLayout": true, "qwertyPositions": false },
    { "name": "qwertz: cmd+- on the ß key by position", "layout": "qwertz", "code": "Minus", "mods": ["cmd"], "binding": "cmd+-", "followLayout": true, "qwertyPositions": true },
    { "name": "modifiers must match", "layout": "qwerty", "code": "KeyZ", "mods": ["cmd", "alt"], "binding": "cmd+z", "followLayout": false, "qwertyPositions": false },
    { "name": "shift is not dropped for letters", "layout": "qwerty", "code": "KeyZ", "mods": ["cmd", "shift"], "binding": "cmd+z", "followLayout": false, "qwertyPositions": false }
  ],
  "$listComment": "Each stroke is {layout, code, mods?} (a physical key) or {named} for escape, up, down, enter. inText says a text field has the keyboard. The keys are matched in the case's shortcutLayout mode (default followLayout).",
  "lists": [
    { "name": "standard leaves everything to the surface", "style": "standard", "strokes": [{ "layout": "qwerty", "code": "KeyJ" }, { "layout": "qwerty", "code": "KeyK" }], "expect": ["pass", "pass"] },
    { "name": "vim j k", "style": "vim", "strokes": [{ "layout": "qwerty", "code": "KeyJ" }, { "layout": "qwerty", "code": "KeyK" }], "expect": ["list.next", "list.previous"] },
    { "name": "vim h l", "style": "vim", "strokes": [{ "layout": "qwerty", "code": "KeyH" }, { "layout": "qwerty", "code": "KeyL" }], "expect": ["list.back", "list.open"] },
    { "name": "vim gg and G", "style": "vim", "strokes": [{ "layout": "qwerty", "code": "KeyG" }, { "layout": "qwerty", "code": "KeyG" }, { "layout": "qwerty", "code": "KeyG", "mods": ["shift"] }], "expect": ["pending", "list.first", "list.last"] },
    { "name": "vim g then j drops the g", "style": "vim", "strokes": [{ "layout": "qwerty", "code": "KeyG" }, { "layout": "qwerty", "code": "KeyJ" }], "expect": ["pending", "list.next"] },
    { "name": "vim / searches", "style": "vim", "strokes": [{ "layout": "qwerty", "code": "Slash" }], "expect": ["list.search"] },
    { "name": "vim ctrl-d ctrl-u page", "style": "vim", "strokes": [{ "layout": "qwerty", "code": "KeyD", "mods": ["ctrl"] }, { "layout": "qwerty", "code": "KeyU", "mods": ["ctrl"] }], "expect": ["list.pageDown", "list.pageUp"] },
    { "name": "vim: a text field keeps j and k", "style": "vim", "inText": true, "strokes": [{ "layout": "qwerty", "code": "KeyJ" }, { "layout": "qwerty", "code": "KeyK" }, { "layout": "qwerty", "code": "KeyG" }], "expect": ["pass", "pass", "pass"] },
    { "name": "vim: Esc leaves a text field", "style": "vim", "inText": true, "strokes": [{ "named": "escape" }], "expect": ["list.leave"] },
    { "name": "vim: cmd+j is not j", "style": "vim", "strokes": [{ "layout": "qwerty", "code": "KeyJ", "mods": ["cmd"] }], "expect": ["pass"] },
    { "name": "vim: arrows stay with the surface", "style": "vim", "strokes": [{ "named": "down" }], "expect": ["pass"] },
    { "name": "vim on dvorak follows the letters", "style": "vim", "strokes": [{ "layout": "dvorak", "code": "KeyC" }, { "layout": "dvorak", "code": "KeyV" }], "expect": ["list.next", "list.previous"] },
    { "name": "vim on dvorak by position", "style": "vim", "shortcutLayout": "qwertyPositions", "strokes": [{ "layout": "dvorak", "code": "KeyJ" }, { "layout": "dvorak", "code": "KeyK" }], "expect": ["list.next", "list.previous"] },
    { "name": "vim on azerty: / is Shift-:", "style": "vim", "strokes": [{ "layout": "azerty", "code": "Period", "mods": ["shift"] }], "expect": ["list.search"] },
    { "name": "vim on azerty: G is Shift-g", "style": "vim", "strokes": [{ "layout": "azerty", "code": "KeyG", "mods": ["shift"] }], "expect": ["list.last"] },
    { "name": "emacs ctrl-n ctrl-p", "style": "emacs", "strokes": [{ "layout": "qwerty", "code": "KeyN", "mods": ["ctrl"] }, { "layout": "qwerty", "code": "KeyP", "mods": ["ctrl"] }], "expect": ["list.next", "list.previous"] },
    { "name": "emacs ctrl-a ctrl-e ctrl-f ctrl-b in a list", "style": "emacs", "strokes": [{ "layout": "qwerty", "code": "KeyA", "mods": ["ctrl"] }, { "layout": "qwerty", "code": "KeyE", "mods": ["ctrl"] }, { "layout": "qwerty", "code": "KeyF", "mods": ["ctrl"] }, { "layout": "qwerty", "code": "KeyB", "mods": ["ctrl"] }], "expect": ["list.first", "list.last", "list.open", "list.back"] },
    { "name": "emacs: a search field moves the results with ctrl-n/p and keeps ctrl-a/e/f/b for the caret", "style": "emacs", "inText": true, "strokes": [{ "layout": "qwerty", "code": "KeyN", "mods": ["ctrl"] }, { "layout": "qwerty", "code": "KeyP", "mods": ["ctrl"] }, { "layout": "qwerty", "code": "KeyA", "mods": ["ctrl"] }, { "layout": "qwerty", "code": "KeyE", "mods": ["ctrl"] }, { "layout": "qwerty", "code": "KeyF", "mods": ["ctrl"] }, { "layout": "qwerty", "code": "KeyB", "mods": ["ctrl"] }], "expect": ["list.next", "list.previous", "pass", "pass", "pass", "pass"] },
    { "name": "emacs: plain letters are typing", "style": "emacs", "strokes": [{ "layout": "qwerty", "code": "KeyN" }], "expect": ["pass"] },
    { "name": "emacs on dvorak follows the letters", "style": "emacs", "strokes": [{ "layout": "dvorak", "code": "KeyL", "mods": ["ctrl"] }, { "layout": "dvorak", "code": "KeyR", "mods": ["ctrl"] }], "expect": ["list.next", "list.previous"] },
    { "name": "emacs on qwertz by position", "style": "emacs", "shortcutLayout": "qwertyPositions", "strokes": [{ "layout": "qwertz", "code": "KeyN", "mods": ["ctrl"] }], "expect": ["list.next"] }
  ]
}
