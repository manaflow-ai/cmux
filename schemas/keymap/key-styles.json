{
  "$comment": "HAND-EDITED. The one keymap table of app.keyStyle and app.shortcutLayout (design/keyboard-style.md). cmux-tui/crates/cmux-keymap reads it (include_str!) for the Swift surfaces through CCmuxAppFFI, and webviews/src/ui/keyStyle.ts imports it for the web surfaces; both run every case of schemas/keymap/key-vectors.json. Strokes use keybindings.json syntax: modifiers ctrl, alt, shift, cmd, then one key (a letter, a digit, a punctuation character, or escape, enter, up, down, left, right, pageup, pagedown). A list command applies only where a list has the keyboard. A row without \"inText\": true never applies while a text field has the keyboard, so typing stays normal.",
  "commands": [
    "list.next",
    "list.previous",
    "list.first",
    "list.last",
    "list.pageDown",
    "list.pageUp",
    "list.open",
    "list.back",
    "list.search",
    "list.leave"
  ],
  "styles": {
    "standard": [],
    "vim": [
      { "keys": ["j"], "command": "list.next" },
      { "keys": ["k"], "command": "list.previous" },
      { "keys": ["l"], "command": "list.open" },
      { "keys": ["h"], "command": "list.back" },
      { "keys": ["g", "g"], "command": "list.first" },
      { "keys": ["shift+g"], "command": "list.last" },
      { "keys": ["ctrl+d"], "command": "list.pageDown" },
      { "keys": ["ctrl+u"], "command": "list.pageUp" },
      { "keys": ["/"], "command": "list.search" },
      { "keys": ["escape"], "command": "list.leave", "inText": true }
    ],
    "emacs": [
      { "keys": ["ctrl+n"], "command": "list.next", "inText": true },
      { "keys": ["ctrl+p"], "command": "list.previous", "inText": true },
      { "keys": ["ctrl+f"], "command": "list.open" },
      { "keys": ["ctrl+b"], "command": "list.back" },
      { "keys": ["ctrl+a"], "command": "list.first" },
      { "keys": ["ctrl+e"], "command": "list.last" },
      { "keys": ["ctrl+v"], "command": "list.pageDown" },
      { "keys": ["alt+v"], "command": "list.pageUp" },
      { "keys": ["ctrl+s"], "command": "list.search" },
      { "keys": ["ctrl+g"], "command": "list.leave", "inText": true }
    ]
  },
