{
  "$comment": "Cases every judge of the layout-motion contract (contract.json) must agree on: webviews/src/layout/motionJudge.ts is held to them by webviews/test/motion-judge.test.ts. A frame's samples map an id to its surface, its box [x, y, width, height] and its flags; `declared` lists the moves open in that frame. `undeclared` is the boxes that made a move no declaration covers.",
  "cases": [
    {
      "name": "a box still mounting is not judged",
      "frames": [
        { "samples": { "row": { "surface": "transcript-row", "box": [0, 0, 400, 20] } } },
        { "samples": { "row": { "surface": "transcript-row", "box": [0, 10, 400, 20] } } },
        { "samples": { "row": { "surface": "transcript-row", "box": [0, 10, 400, 20] } } }
      ],
      "undeclared": 0
    },
    {
      "name": "a rested row that moves with nothing declared is undeclared",
      "frames": [
        { "samples": { "row": { "surface": "transcript-row", "box": [0, 0, 400, 20] } } },
        { "samples": { "row": { "surface": "transcript-row", "box": [0, 0, 400, 20] } } },
        { "samples": { "row": { "surface": "transcript-row", "box": [0, 0, 400, 20] } } },
        { "samples": { "row": { "surface": "transcript-row", "box": [0, 16, 400, 20] } } }
      ],
      "undeclared": 1
    },
    {
      "name": "a rested image that reshapes is undeclared (its size was not in its record)",
      "frames": [
        { "samples": { "img": { "surface": "chat-media", "box": [0, 0, 120, 120] } } },
        { "samples": { "img": { "surface": "chat-media", "box": [0, 0, 120, 120] } } },
        { "samples": { "img": { "surface": "chat-media", "box": [0, 0, 120, 120] } } },
        { "samples": { "img": { "surface": "chat-media", "box": [0, 0, 320, 120] } } }
      ],
      "undeclared": 1
    },
    {
      "name": "a move under half a pixel is rounding",
      "frames": [
        { "samples": { "row": { "surface": "transcript-row", "box": [0, 0, 400, 20] } } },
        { "samples": { "row": { "surface": "transcript-row", "box": [0, 0, 400, 20] } } },
        { "samples": { "row": { "surface": "transcript-row", "box": [0, 0, 400, 20] } } },
        { "samples": { "row": { "surface": "transcript-row", "box": [0, 0.4, 400, 20] } } }
      ],
      "undeclared": 0
    },
    {
      "name": "a user scroll moves every transcript row",
      "frames": [
        { "samples": { "a": { "surface": "transcript-row", "box": [0, 0, 400, 20] }, "b": { "surface": "transcript-row", "box": [0, 20, 400, 20] } } },
        { "samples": { "a": { "surface": "transcript-row", "box": [0, 0, 400, 20] }, "b": { "surface": "transcript-row", "box": [0, 20, 400, 20] } } },
        { "samples": { "a": { "surface": "transcript-row", "box": [0, 0, 400, 20] }, "b": { "surface": "transcript-row", "box": [0, 20, 400, 20] } } },
        {
          "samples": { "a": { "surface": "transcript-row", "box": [0, -100, 400, 20] }, "b": { "surface": "transcript-row", "box": [0, -80, 400, 20] } },
          "declared": [{ "key": 1, "event": "user-scroll", "scope": "all" }]
        }
      ],
      "undeclared": 0
    },
    {
      "name": "a scroll does not cover the composer: its surface does not move on a scroll",
      "frames": [
        { "samples": { "box": { "surface": "composer", "box": [0, 500, 400, 60] } } },
        { "samples": { "box": { "surface": "composer", "box": [0, 500, 400, 60] } } },
        { "samples": { "box": { "surface": "composer", "box": [0, 500, 400, 60] } } },
        { "samples": { "box": { "surface": "composer", "box": [0, 490, 400, 60] } }, "declared": [{ "key": 1, "event": "user-scroll", "scope": "all" }] }
      ],
      "undeclared": 1
    },
    {
      "name": "a resize lays each box out once; a second move is a bounce",
      "frames": [
        { "samples": { "row": { "surface": "transcript-row", "box": [0, 0, 760, 20] } } },
        { "samples": { "row": { "surface": "transcript-row", "box": [0, 0, 760, 20] } } },
        { "samples": { "row": { "surface": "transcript-row", "box": [0, 0, 760, 20] } } },
        { "samples": { "row": { "surface": "transcript-row", "box": [0, 0, 520, 40] } }, "declared": [{ "key": 1, "event": "resize", "scope": "all", "once": true }] },
        { "samples": { "row": { "surface": "transcript-row", "box": [0, 0, 520, 40] } }, "declared": [{ "key": 1, "event": "resize", "scope": "all", "once": true }] },
        { "samples": { "row": { "surface": "transcript-row", "box": [0, 6, 520, 40] } }, "declared": [{ "key": 1, "event": "resize", "scope": "all", "once": true }] }
      ],
      "undeclared": 1
    },
    {
      "name": "an expand moves its target and pushes what follows straight down",
      "frames": [
        { "samples": { "fold": { "surface": "transcript-row", "box": [0, 0, 400, 20], "targeted": true }, "next": { "surface": "transcript-row", "box": [0, 20, 400, 20], "after": true } } },
        { "samples": { "fold": { "surface": "transcript-row", "box": [0, 0, 400, 20], "targeted": true }, "next": { "surface": "transcript-row", "box": [0, 20, 400, 20], "after": true } } },
        { "samples": { "fold": { "surface": "transcript-row", "box": [0, 0, 400, 20], "targeted": true }, "next": { "surface": "transcript-row", "box": [0, 20, 400, 20], "after": true } } },
        {
          "samples": { "fold": { "surface": "transcript-row", "box": [0, 0, 400, 120], "targeted": true }, "next": { "surface": "transcript-row", "box": [0, 120, 400, 20], "after": true } },
          "declared": [{ "key": 1, "event": "expand", "scope": "targets" }]
        }
      ],
      "undeclared": 0
    },
    {
      "name": "an expand does not cover a row above it rising, away from the very bottom",
      "frames": [
        { "samples": { "above": { "surface": "transcript-row", "box": [0, 0, 400, 20] }, "fold": { "surface": "transcript-row", "box": [0, 20, 400, 20], "targeted": true } } },
        { "samples": { "above": { "surface": "transcript-row", "box": [0, 0, 400, 20] }, "fold": { "surface": "transcript-row", "box": [0, 20, 400, 20], "targeted": true } } },
        { "samples": { "above": { "surface": "transcript-row", "box": [0, 0, 400, 20] }, "fold": { "surface": "transcript-row", "box": [0, 20, 400, 20], "targeted": true } } },
        {
          "samples": { "above": { "surface": "transcript-row", "box": [0, -4, 400, 20] }, "fold": { "surface": "transcript-row", "box": [0, 16, 400, 100], "targeted": true } },
          "declared": [{ "key": 1, "event": "expand", "scope": "targets" }]
        }
      ],
      "undeclared": 1
    },
    {
      "name": "at the very bottom an expand lifts the rows above it",
      "frames": [
        { "samples": { "above": { "surface": "transcript-row", "box": [0, 0, 400, 20], "before": true }, "fold": { "surface": "transcript-row", "box": [0, 20, 400, 20], "targeted": true } } },
        { "samples": { "above": { "surface": "transcript-row", "box": [0, 0, 400, 20], "before": true }, "fold": { "surface": "transcript-row", "box": [0, 20, 400, 20], "targeted": true } } },
        { "samples": { "above": { "surface": "transcript-row", "box": [0, 0, 400, 20], "before": true }, "fold": { "surface": "transcript-row", "box": [0, 20, 400, 20], "targeted": true } } },
        {
          "samples": { "above": { "surface": "transcript-row", "box": [0, -80, 400, 20], "before": true }, "fold": { "surface": "transcript-row", "box": [0, -60, 400, 100], "targeted": true } },
          "declared": [{ "key": 1, "event": "expand", "scope": "targets" }]
        }
      ],
      "undeclared": 0
    },
    {
      "name": "a move in the frame a declaration ends is still the declaration's",
      "frames": [
        { "samples": { "row": { "surface": "transcript-row", "box": [0, 0, 400, 20] } } },
        { "samples": { "row": { "surface": "transcript-row", "box": [0, 0, 400, 20] } } },
        { "samples": { "row": { "surface": "transcript-row", "box": [0, 0, 400, 20] } }, "declared": [{ "key": 1, "event": "stream-append", "scope": "all" }] },
        { "samples": { "row": { "surface": "transcript-row", "box": [0, -18, 400, 20] } } }
      ],
      "undeclared": 0
    },
    {
      "name": "a box an entrance animation moves is not judged until it rests",
      "frames": [
        { "samples": { "menu": { "surface": "popup", "box": [10, 10, 200, 100] } } },
        { "samples": { "menu": { "surface": "popup", "box": [10, 10, 200, 100] } } },
        { "samples": { "menu": { "surface": "popup", "box": [10, 10, 200, 100] } } },
        { "samples": { "menu": { "surface": "popup", "box": [10, 4, 200, 100], "animating": true } } },
        { "samples": { "menu": { "surface": "popup", "box": [10, 0, 200, 100] } } }
      ],
      "undeclared": 0
    }
  ]
}
