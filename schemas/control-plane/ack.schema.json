{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CtlAck",
  "type": "object",
  "required": [
    "v",
    "type",
    "rev",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "type": "integer",
      "description": "control-plane protocol version, 1"
    },
    "type": {
      "const": "ack"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appliedAt": {
          "type": "string",
          "format": "date-time",
          "description": "optional client stamp of when the acked revision was applied"
        }
      }
    },
    "rev": {
      "type": "integer",
      "minimum": 0,
      "description": "directory/hint revision the client has applied; stops the server's retry ladder for revisions up to and including it"
    }
  }
}
