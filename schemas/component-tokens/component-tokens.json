{
  "$comment": "Tier 3 of the design system, the component tokens (Material 3's component tier: a token named for one component that points at a system token). Tier 1 is schemas/design-scale (--ds-*), tier 2 schemas/design-roles (--role-*). A component's own stylesheet reads each token as var(<token>, <fallback>), where the fallback is exactly what the rule drew before the token existed, so with no token set nothing moves and the value resolves at the element as before (a per-size or per-context value keeps its own rule). Set one on :root, or on any ancestor, to re-skin that one component family. webviews/test/surface-tokens.test.ts holds every read below to its fallback and webviews/src/ui/README.md (\"Component tokens\") to naming each token. Not yet part of the public look contract (schemas/agent-pane/style-tokens.json).",
  "families": [
    {
      "name": "button",
      "component": "ui/Button.tsx",
      "file": "webviews/src/ui/controls.css",
      "prefix": "--cmux-button-",
      "tokens": [
        {
          "name": "--cmux-button-radius",
          "kind": "length",
          "for": "every button's corner",
          "reads": [
            { "selector": ".ui-button.ui-btn", "property": "border-radius", "fallback": "var(--ds-radius-control)" },
            { "selector": ".ui-btn[data-size=\"sm\"]", "property": "border-radius", "fallback": "var(--ds-radius-control)" },
            { "selector": ".ui-btn[data-size=\"lg\"]", "property": "border-radius", "fallback": "var(--ds-radius-control)" }
          ]
        },
        {
          "name": "--cmux-button-border",
          "kind": "border",
          "for": "every button's edge",
          "reads": [{ "selector": ".ui-button.ui-btn", "property": "border", "fallback": "0" }]
        },
        {
          "name": "--cmux-button-shadow",
          "kind": "box-shadow",
          "for": "every button's shadow, at no specificity (a variant's edge and the focus ring win)",
          "reads": [{ "selector": ":where(.ui-btn)", "property": "box-shadow", "fallback": "none" }]
        },
        {
          "name": "--cmux-button-height-sm",
          "kind": "length",
          "for": "a small button's height, and a small icon button's width",
          "reads": [
            { "selector": ".ui-btn[data-size=\"sm\"]", "property": "height", "fallback": "var(--ds-control-compact)" },
            { "selector": ".ui-btn[data-icon][data-size=\"sm\"]", "property": "width", "fallback": "var(--ds-control-compact)" }
          ]
        },
        {
          "name": "--cmux-button-height-md",
          "kind": "length",
          "for": "a button's height (the default size), and an icon button's width",
          "reads": [
            { "selector": ".ui-button.ui-btn", "property": "height", "fallback": "var(--ds-control-row)" },
            { "selector": ".ui-btn[data-icon]", "property": "width", "fallback": "var(--ds-control-row)" }
          ]
        },
        {
          "name": "--cmux-button-height-lg",
          "kind": "length",
          "for": "a large button's height, and a large icon button's width",
          "reads": [
            { "selector": ".ui-btn[data-size=\"lg\"]", "property": "height", "fallback": "var(--ds-control-primary)" },
            { "selector": ".ui-btn[data-icon][data-size=\"lg\"]", "property": "width", "fallback": "var(--ds-control-primary)" }
          ]
        },
        {
          "name": "--cmux-button-padding-inline-sm",
          "kind": "length",
          "for": "a small text button's side padding",
          "reads": [{ "selector": ".ui-btn[data-size=\"sm\"]", "property": "padding-inline", "fallback": "var(--ds-space-2)" }]
        },
        {
          "name": "--cmux-button-padding-inline-md",
          "kind": "length",
          "for": "a text button's side padding",
          "reads": [{ "selector": ".ui-button.ui-btn", "property": "padding-inline", "fallback": "var(--ds-space-3)" }]
        },
        {
          "name": "--cmux-button-padding-inline-lg",
          "kind": "length",
          "for": "a large text button's side padding",
          "reads": [{ "selector": ".ui-btn[data-size=\"lg\"]", "property": "padding-inline", "fallback": "var(--ds-space-4)" }]
        },
        {
          "name": "--cmux-button-gap",
          "kind": "length",
          "for": "the gap between a button's icon and its label",
          "reads": [{ "selector": ".ui-button.ui-btn", "property": "gap", "fallback": "var(--ds-space-2)" }]
        }
      ]
    },
    {
      "name": "input",
      "component": "ui/Input.tsx",
      "file": "webviews/src/ui/controls.css",
      "prefix": "--cmux-input-",
      "tokens": [
        {
          "name": "--cmux-input-radius",
          "kind": "length",
          "for": "every field's corner",
          "reads": [
            { "selector": ".ui-input", "property": "border-radius", "fallback": "var(--ds-radius-md)" },
            { "selector": ".ui-input[data-size=\"sm\"]", "property": "border-radius", "fallback": "var(--ds-radius-sm)" },
            { "selector": ".ui-input[data-size=\"lg\"]", "property": "border-radius", "fallback": "var(--ds-radius-lg)" }
          ]
        },
        {
          "name": "--cmux-input-border",
          "kind": "border",
          "for": "every field's edge",
          "reads": [{ "selector": ".ui-input", "property": "border", "fallback": "0" }]
        },
        {
          "name": "--cmux-input-shadow",
          "kind": "box-shadow",
          "for": "every field's shadow (an inset well), at no specificity",
          "reads": [{ "selector": ":where(.ui-input)", "property": "box-shadow", "fallback": "none" }]
        }
      ]
    },
    {
      "name": "menu",
      "component": "ui/Menu.tsx, ui/ContextMenu.tsx, ui/Popover.tsx, ui/Select.tsx",
      "file": "webviews/src/ui/popupSurface.css",
      "tokens": [
        {
          "name": "--menu-radius",
          "kind": "length",
          "for": "a menu's or popover's corner",
          "reads": [
            { "selector": ":root", "property": "--ui-popup-radius", "fallback": "var(--role-popover-radius, 8px)" },
            { "selector": ":where(.ui-popup.ui-menu, .ui-popup.ui-context-menu)", "property": "--ui-popup-radius", "fallback": "var(--role-menu-radius, 8px)" }
          ]
        },
        {
          "name": "--menu-padding",
          "kind": "length",
          "for": "a menu's inner padding, which is also the row highlight's inset",
          "reads": [
            { "selector": ":root", "property": "--ui-popup-padding", "fallback": "calc(var(--ds-space-1) * var(--cmux-interface-scale, 1))" },
            { "selector": ".ui-popup:is(.ui-menu, .ui-context-menu):not(.acpmux-quick-menu, .acpmux-scope-list, :has(.acpmux-access-item))", "property": "--ui-menu-inset", "fallback": "var(--cmux-menu-highlight-inset)" }
          ]
        },
        {
          "name": "--menu-row-height",
          "kind": "length",
          "for": "a menu row's height",
          "reads": [
            { "selector": ":root", "property": "--ui-row-height", "fallback": "calc(var(--ds-control-row) * var(--cmux-interface-scale, 1))" }
          ]
        },
        {
          "name": "--menu-hover-radius",
          "kind": "length",
          "for": "the highlighted row's corner",
          "reads": [
            { "selector": ":root", "property": "--ui-row-radius", "fallback": "max(4px, calc(var(--ui-popup-radius) - var(--ui-popup-padding, 4px)))" },
            { "selector": ".ui-popup:is(.ui-menu, .ui-context-menu):not(.acpmux-quick-menu, .acpmux-scope-list, :has(.acpmux-access-item)) .ui-menu-item", "property": "border-radius", "fallback": "var(--cmux-menu-highlight-radius)" }
          ]
        }
      ]
    },
    {
      "name": "tooltip",
      "component": "ui/Tooltip.tsx, ui/titleTooltips.ts",
      "file": "webviews/src/pages/shared/desktop.css",
      "tokens": [
        {
          "name": "--cmux-tooltip-radius",
          "kind": "length",
          "for": "a tooltip's and hover card's corner",
          "reads": [
            { "selector": ".ui-tooltip, .ui-title-tooltip", "property": "border-radius", "fallback": "calc(var(--role-tooltip-radius) * var(--cmux-interface-scale, 1))" }
          ]
        },
        {
          "name": "--cmux-tooltip-padding-block",
          "kind": "length",
          "for": "the space above and below a tooltip's text",
          "reads": [{ "selector": ":root", "property": "--tooltip-pad-block", "fallback": "var(--grid-base)" }]
        },
        {
          "name": "--cmux-tooltip-padding-inline",
          "kind": "length",
          "for": "the space before a tooltip's text and after its shortcut",
          "reads": [{ "selector": ":root", "property": "--tooltip-pad-inline", "fallback": "calc(var(--grid-base) * 2)" }]
        }
      ]
    },
    {
      "name": "dialog",
      "component": "ui/Dialog.tsx, ui/Sheet.tsx",
      "file": "webviews/src/ui/popupSurface.css",
      "prefix": "--cmux-dialog-",
      "tokens": [
        {
          "name": "--cmux-dialog-padding",
          "kind": "length",
          "for": "a dialog's padding, the same on every side (a dialog that sets its own --ui-dialog-padding keeps it)",
          "reads": [{ "selector": ".ui-dialog.ui-glass", "property": "--ui-dialog-padding", "fallback": "var(--role-dialog-inset)" }]
        },
        {
          "name": "--cmux-dialog-radius",
          "kind": "length",
          "for": "a dialog's corner; unset, the button corner plus the padding, so it stays concentric with its buttons",
          "reads": [
            { "selector": ".ui-dialog.ui-glass", "property": "border-radius", "fallback": "calc(var(--role-control-radius) + var(--ui-dialog-padding))" }
          ]
        }
      ]
    }
  ]
}
