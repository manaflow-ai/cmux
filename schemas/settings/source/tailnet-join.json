{
  "$comment": "Settings for adding Cloud machines to the person's Tailscale or Headscale tailnet. Authentication keys are entered only in the Join sheet and are never settings values.",
  "lists": [
    {
      "name": "tailnetJoin",
      "section": "machines",
      "group": {
        "key": "settings.group.tailnet",
        "text": "Tailscale"
      },
      "rows": [
        {
          "key": "tailnet.join.enabled",
          "title": { "key": "settings.tailnet.join.enabled", "text": "Add Cloud Machines to Your Tailnet" },
          "help": { "key": "settings.tailnet.join.enabled.help", "text": "Make Tailscale or Headscale available when you join a Cloud machine." },
          "summary": { "key": "settings.tailnet.join.enabled.summary", "text": "Cloud machines can join your tailnet" },
          "kind": "toggle",
          "default": false,
          "keywords": ["tailscale", "tailnet", "headscale", "cloud", "machines", "network"]
        },
        {
          "key": "tailnet.join.loginServer",
          "title": { "key": "settings.tailnet.join.loginServer", "text": "Login Server" },
          "help": { "key": "settings.tailnet.join.loginServer.help", "text": "Leave empty for Tailscale, or enter your Headscale control server URL." },
          "summary": { "key": "settings.tailnet.join.loginServer.summary", "text": "Tailscale or Headscale control server" },
          "kind": "text",
          "default": "",
          "placeholder": { "key": null, "text": "https://headscale.example.com" },
          "keywords": ["tailscale", "headscale", "login", "server", "control", "url"]
        },
        {
          "key": "tailnet.join.hostname",
          "title": { "key": "settings.tailnet.join.hostname", "text": "Hostname Template" },
          "help": { "key": "settings.tailnet.join.hostname.help", "text": "Optional device name template. Use {vm} for the Cloud machine name." },
          "summary": { "key": "settings.tailnet.join.hostname.summary", "text": "Name new tailnet devices" },
          "kind": "text",
          "default": "{vm}",
          "placeholder": { "key": null, "text": "{vm}" },
          "keywords": ["tailscale", "tailnet", "hostname", "device", "name", "template"]
        },
        {
          "key": "tailnet.join.tags",
          "title": { "key": "settings.tailnet.join.tags", "text": "Tags" },
          "help": { "key": "settings.tailnet.join.tags.help", "text": "ACL tags to request for each joined Cloud machine." },
          "summary": { "key": "settings.tailnet.join.tags.summary", "text": "ACL tags for joined machines" },
          "kind": "string_list",
          "default": [],
          "placeholder": { "key": null, "text": "tag:cmux" },
          "keywords": ["tailscale", "tailnet", "tags", "acl", "permissions"]
        },
        {
          "key": "tailnet.join.ssh",
          "title": { "key": "settings.tailnet.join.ssh", "text": "Tailscale SSH" },
          "help": { "key": "settings.tailnet.join.ssh.help", "text": "Enable Tailscale SSH on joined Cloud machines, subject to your ACL." },
          "summary": { "key": "settings.tailnet.join.ssh.summary", "text": "Enable Tailscale SSH" },
          "kind": "toggle",
          "default": false,
          "keywords": ["tailscale", "tailnet", "ssh", "remote"]
        },
        {
          "key": "tailnet.join.ephemeral",
          "title": { "key": "settings.tailnet.join.ephemeral", "text": "Ephemeral Devices" },
          "help": { "key": "settings.tailnet.join.ephemeral.help", "text": "Remove a joined machine from the tailnet when it goes offline." },
          "summary": { "key": "settings.tailnet.join.ephemeral.summary", "text": "Remove offline machines automatically" },
          "kind": "toggle",
          "default": false,
          "keywords": ["tailscale", "tailnet", "ephemeral", "offline", "remove"]
        },
        {
          "key": "tailnet.join.servePorts",
          "title": { "key": "settings.tailnet.join.servePorts", "text": "Serve Ports" },
          "help": { "key": "settings.tailnet.join.servePorts.help", "text": "Optional ports to publish through Tailscale Serve, such as 3000 or 8080:8443." },
          "summary": { "key": "settings.tailnet.join.servePorts.summary", "text": "Ports published through Tailscale Serve" },
          "kind": "string_list",
          "default": [],
          "placeholder": { "key": null, "text": "3000" },
          "keywords": ["tailscale", "tailnet", "serve", "ports", "https"]
        },
        {
          "key": "tailnet.join.autoJoinNewVMs",
          "title": { "key": "settings.tailnet.join.autoJoinNewVMs", "text": "Join New Cloud Machines Automatically" },
          "help": { "key": "settings.tailnet.join.autoJoinNewVMs.help", "text": "Ask for a key when a new Cloud machine is created and add it to your tailnet." },
          "summary": { "key": "settings.tailnet.join.autoJoinNewVMs.summary", "text": "Join new Cloud machines automatically" },
          "kind": "toggle",
          "default": false,
          "keywords": ["tailscale", "tailnet", "cloud", "machines", "automatic", "join"]
        }
      ]
    }
  ]
}
