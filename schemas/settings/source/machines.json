            "mobile",
            "remote",
            "connect"
          ]
        },
        {
          "key": "mobile.terminalSizing",
          "note": "How a terminal shown on several devices is sized. The raw values are the daemon's.",
          "title": {
            "key": "settings.mobile.terminalSizing",
            "text": "Terminal Size When Shared"
          },
          "help": {
            "key": "settings.mobile.terminalSizing.help",
            "text": "Decides the size of a terminal while this Mac and a phone show it at once. A device that gets a larger terminal than it fits scrolls sideways or shows empty space; text never wraps wrong. Set the priority order in the cmux app on your iPhone."
          },
          "kind": "choice",
          "choices": [
            {
              "value": "smallest",
              "title": {
                "key": "settings.choice.terminalSizing.smallest",
                "text": "Fit the Smallest Viewer"
              },
              "note": "Every viewer sees the whole grid (the default)."
            },
            {
              "value": "mac",
              "title": {
                "key": "settings.choice.terminalSizing.mac",
                "text": "Prefer This Mac"
              },
              "note": "This Mac keeps its size; a phone pans or letterboxes."
            },
            {
              "value": "latest",
              "title": {
                "key": "settings.choice.terminalSizing.latest",
                "text": "Prefer the Active Device"
              },
              "note": "The viewer that typed, pasted or focused last."
            },
            {
              "value": "priority",
              "title": {
                "key": "settings.choice.terminalSizing.priority",
                "text": "Priority Order"
              },
              "note": "`terminalSizingOrder`, highest first."
            }
          ],
          "default": "smallest",
          "keywords": [
            "iphone",
            "phone",
            "mobile",
            "terminal",
            "size",
            "sizing",
            "shared",
            "priority",
            "columns"
          ],
          "swift_enum": {
            "name": "MobileTerminalSizing"
          }
        },
        {
          "key": "mobile.terminalSizingOrder",
          "note": "Device tokens, highest first: `mac` (this Mac's own views) or `device:<id>`.",
          "title": {
            "key": "settings.mobile.terminalSizingOrder",
            "text": "Terminal Size Priority"
          },
          "help": {
            "key": "settings.mobile.terminalSizingOrder.help",
            "text": "The devices whose size a shared terminal takes first, highest first, when Terminal Size When Shared is Priority Order."
          },
          "kind": "string_list",
          "default": [],
          "keywords": [
            "iphone",
            "phone",
            "terminal",
            "size",
            "priority",
            "order"
          ],
