      "rows": [
        {
          "key": "mobile.allowIPhoneConnections",
          "title": {
            "key": "settings.mobile.allowIPhoneConnections",
            "text": "Allow iPhone Connections"
          },
          "help": {
            "key": "settings.mobile.allowIPhoneConnections.help",
            "text": "Lets the cmux app on your iPhone open this Mac's workspaces, terminals and agent chats while you are signed in with the same account."
          },
          "summary": {
            "key": "settings.mobile.allowIPhoneConnections.summary",
