{
  "$comment": "Settings rows of this Mac's machines, phones, Cloud and connectors (Computer Use, free model, SSH links, Cloud workspaces, iPhone, Mac Screen, cmux Remote, Device Hub, iMessage). Each list is one run of rows in SettingsSchema.all; gen-settings-sources.py writes the Swift (SettingsSchema+Machines*.generated.swift).",
  "lists": [
    {
      "name": "computerUse",
      "section": "general",
      "group": {
        "key": "settings.group.computerUse",
        "text": "Computer Use"
      },
      "rows": [
        {
          "key": "computerUse.enabled",
          "title": {
            "key": "settings.computerUse.enabled",
            "text": "Computer Use"
          },
          "help": {
            "key": "settings.computerUse.enabled.help",
            "text": "Lets agents see and use your apps through the signed cmux Computer Use helper. macOS asks for Accessibility and Screen Recording when you first allow them."
          },
          "summary": {
            "key": "settings.computerUse.enabled.summary",
            "text": "Lets agents see and use your apps"
          },
          "kind": "toggle",
          "default": false,
          "keywords": [
            "computer use",
            "agents",
            "automation",
            "screen recording",
            "accessibility",
            "helper"
          ]
        },
        {
          "key": "computerUse.driver",
          "note": "Which Computer Use driver the helper runs.",
          "title": {
            "key": "settings.computerUse.driver",
            "text": "Computer Use Driver"
          },
          "help": {
            "key": "settings.computerUse.driver.help",
            "text": "Legacy runs the current cmux Computer Use helper. Upstream runs the new helper built on the upstream Cua Driver; macOS asks for its permissions separately."
          },
          "summary": {
            "key": "settings.computerUse.driver.summary",
            "text": "Which helper runs Computer Use"
          },
          "kind": "choice",
          "choices": [
            {
              "value": "legacy",
              "title": {
                "key": "settings.computerUse.driver.legacy",
                "text": "Legacy"
              },
              "note": "The cmux-cua 0.8.12 helper (today's path, unchanged)."
            },
            {
              "value": "upstream",
              "title": {
                "key": "settings.computerUse.driver.upstream",
                "text": "Upstream"
              },
              "note": "The cmux Computer Use helper v2 with upstream Cua Driver in process."
            }
          ],
          "default": "upstream",
          "keywords": [
            "computer use",
            "driver",
            "cua",
            "upstream",
            "legacy",
            "helper"
          ],
          "swift_enum": {
            "name": "ComputerUseDriver"
          }
        },
        {
          "key": "computerUse.livePreview",
          "title": {
            "key": "settings.computerUse.livePreview",
            "text": "Live Preview in Chat"
          },
          "help": {
            "key": "settings.computerUse.livePreview.help",
            "text": "While an agent uses an app, its chat shows a small live view of that app. Click the view to open Agent Activity."
          },
          "summary": {
            "key": "settings.computerUse.livePreview.summary",
            "text": "Shows the app an agent uses in its chat"
          },
          "kind": "toggle",
          "default": true,
          "keywords": [
            "computer use",
            "live preview",
            "preview",
            "agent activity",
            "screenshot",
            "chat"
          ]
        }
      ]
    },
    {
      "name": "freeModel",
      "section": "general",
      "group": {
        "key": "settings.group.freeModel",
        "text": "AI Models"
      },
      "rows": [
        {
          "key": "freeModel.enabled",
          "title": {
            "key": "settings.freeModel.enabled",
            "text": "Free AI Model Without Sign-In"
          },
          "help": {
            "key": "settings.freeModel.enabled.help",
            "text": "Lets agents use the free cmux AI model while you are signed out. The first time an agent uses it, cmux proves to the Cloud service that this is a real Mac. Sign in for more models and higher limits."
          },
          "summary": {
            "key": "settings.freeModel.enabled.summary",
            "text": "Free AI model while signed out"
          },
          "kind": "toggle",
          "default": true,
          "keywords": [
            "ai",
            "model",
            "free",
            "sign in",
            "agents",
            "models"
          ]
        }
      ]
    },
    {
      "name": "sshLinks",
      "section": "machines",
      "group": {
        "key": "settings.group.sshLinks",
        "text": "SSH Links"
      },
      "rows": [
        {
          "key": "ssh.linkAllowedHosts",
          "title": {
            "key": "settings.machines.sshLinkHosts",
            "text": "Always Allowed SSH Link Hosts"
          },
          "help": {
            "key": "settings.machines.sshLinkHosts.help",
            "text": "An ssh:// link from another app connects to these hosts without asking. Remove a host to be asked again. Saved machines and cmux peers never ask."
          },
          "kind": "string_list",
          "default": [],
          "placeholder": {
            "key": null,
            "text": "devbox.local"
          },
          "keywords": [
            "ssh",
            "link",
            "url",
            "host",
            "trust",
            "allow",
            "always",
            "machine",
            "security"
          ],
          "swift_owner": "SSHLinkHostsSetting"
        }
      ]
    },
    {
      "name": "cloud",
      "section": "machines",
      "group": {
        "key": "settings.group.cloudWorkspaces",
        "text": "Cloud Workspaces"
      },
      "rows": [
        {
          "key": "cloud.newWorkspacesInCloud",
          "name": "inCloud",
          "title": {
            "key": "settings.cloud.newWorkspacesInCloud",
            "text": "Run New Workspaces in Cloud"
          },
          "help": {
            "key": "settings.cloud.newWorkspacesInCloud.help",
            "text": "Each new workspace (Cmd-N, the sidebar's +) gets its own new Cloud machine. Agent chats you start in it run on that machine."
          },
          "kind": "toggle",
          "default": false,
          "keywords": [
            "cloud",
            "vm",
            "remote",
            "machine",
            "new workspace",
            "cmd-n",
            "agent",
            "local",
            "toggle"
          ]
        },
        {
          "key": "cloud.newWorkspaceFolder",
          "name": "folder",
          "note": "What a new Cloud workspace starts with.",
          "title": {
            "key": "settings.cloud.newWorkspaceFolder",
            "text": "New Cloud Workspaces Start In"
          },
          "help": {
            "key": "settings.cloud.newWorkspaceFolder.help",
            "text": "Current Folder copies the folder you work in (its whole git working copy) to the new machine. Empty Folder starts in the machine's own empty folder."
          },
          "kind": "choice",
          "choices": [
            {
              "value": "inherit",
              "title": {
                "key": "settings.choice.cloudFolderInherit",
                "text": "Current Folder"
              },
              "note": "The person's current folder, synced to the machine."
            },
            {
              "value": "empty",
              "title": {
                "key": "settings.choice.cloudFolderEmpty",
                "text": "Empty Folder"
              },
              "note": "The machine's empty work folder (the image's working snapshot)."
            }
          ],
          "default": "inherit",
          "keywords": [
            "cloud",
            "vm",
            "folder",
            "sync",
            "copy",
            "inherit",
            "empty",
            "snapshot",
            "working directory"
          ],
          "swift_enum": {
            "name": "CloudWorkspaceFolder"
          }
        },
        {
          "key": "cloud.useMyClaudeLoginOnMyCloudMachines",
          "title": {
            "key": "settings.cloud.useMyClaudeLogin",
            "text": "Use My Claude Login on My Own Cloud Machines"
          },
          "help": {
            "key": "settings.cloud.useMyClaudeLogin.help",
            "text": "Copies your own Claude login from this Mac to Cloud machines you own, so their chats start signed in. Never to team or shared machines, and cmux never stores it. Off: each machine offers Sign in to Claude instead."
          },
          "kind": "toggle",
          "default": false,
          "keywords": [
            "cloud",
            "claude",
            "login",
            "sign in",
            "token",
            "credential",
            "machine",
            "consent",
            "copy"
          ],
          "swift_owner": "CloudLoginCopyConsentSetting"
        },
        {
          "key": "cloud.useMyCodexLoginOnMyCloudMachines",
          "title": {
            "key": "settings.cloud.useMyCodexLogin",
            "text": "Use My Codex Login on My Own Cloud Machines"
          },
          "help": {
            "key": "settings.cloud.useMyCodexLogin.help",
            "text": "Gives Cloud machines you own short-lived access from the Codex sign-in on this Mac, so their chats start signed in. The machine never gets your refresh token, and cmux never stores it. Off: a machine asks for a Codex sign-in instead."
          },
          "kind": "toggle",
          "default": false,
          "keywords": [
            "cloud",
            "codex",
            "chatgpt",
            "login",
            "sign in",
            "token",
            "credential",
            "machine",
            "consent"
          ],
          "swift_owner": "CloudCodexSignInConsentSetting"
        },
        {
          "key": "cloud.agentsStartWithoutAsking",
          "title": {
            "key": "settings.cloud.agentsStartWithoutAsking",
            "text": "Let Agents Use Cloud Without Asking"
          },
          "help": {
            "key": "settings.cloud.agentsStartWithoutAsking.help",
            "text": "Agents, `cmux cloud` in a terminal and scripts create Cloud machines, move chats to Cloud and start sessions there with no card asking you first. Your plan's limits still apply. Only you can change this."
          },
          "kind": "toggle",
          "default": true,
          "keywords": [
            "cloud",
            "vm",
            "machine",
            "agent",
            "start",
            "session",
            "create",
            "new machine",
            "move",
            "ask",
            "approve",
            "permission",
            "bypass",
            "without asking",
            "delegate"
          ],
          "swift_owner": "CloudAgentStartSetting"
        },
        {
          "key": "cloud.turnCheckpoints",
          "name": "turnCheckpoints",
          "title": {
            "key": "settings.cloud.turnCheckpoints",
            "text": "Save a Checkpoint Before Each Cloud Chat Turn"
          },
          "help": {
            "key": "settings.cloud.turnCheckpoints.help",
            "text": "Saves the whole Cloud machine between turns of a Cloud chat, so Back to Before This Turn restores it in seconds. Keeps the newest few checkpoints of each chat. Off: no checkpoints are saved."
          },
          "kind": "toggle",
          "default": false,
          "keywords": [
            "cloud",
            "checkpoint",
            "snapshot",
            "undo",
            "rewind",
            "restore",
            "turn",
            "back",
            "machine"
          ]
        }
      ]
    },
    {
      "name": "mobile",
