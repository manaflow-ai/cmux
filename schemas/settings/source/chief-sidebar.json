{
  "$comment": "HAND-EDITED source of the Home section's Chief subagent sidebar rows (cx-d5b5d). scripts/cmux-next/gen-settings-sources.py writes the Swift descriptors and parser constants from it (its docstring is the row format); schemas/settings/settings-schema.json is still exported from Swift and must not change when rows move here.",
  "lists": [
    {
      "name": "chiefSidebar",
      "section": "home",
      "group": {
        "key": "settings.group.chiefSubagents",
        "text": "Subagents"
      },
      "note": "Where Chief subagents get a workspace (a1018; Lawrence 2026-11-09: \"Chief's default must be to NOT start new workspaces all the time\"). Under auto the host gives a sidebar workspace to a task that mentions a show word and none to the rest (the Chief's own `Workspace: internal` puts one in the collapsed \"Chief's workspaces\" group); group sends the rest to that group; the words listed add to the built-in ones; the length rule is off at 0 (optchat-chief sidebar_choice.rs). Read at each spawn.",
      "rows": [
        {
          "key": "chief.subagentSidebar",
          "name": "mode",
          "title": {
            "key": "settings.chief.subagentSidebar",
            "text": "Subagent Workspaces"
          },
          "help": {
            "key": "settings.chief.subagentSidebar.help",
            "text": "Chief Decides gives a sidebar workspace only to work you will look at or join: UI, design, screenshots, or anything that needs your input. Other subagents get none; the Chief's link opens their chat. Chief's Workspaces Group puts those in one collapsed group instead. Always and Never override the Chief."
          },
          "kind": "choice",
          "choices": [
            {
              "value": "auto",
              "title": {
                "key": "settings.choice.subagentSidebarAuto",
                "text": "Chief Decides"
              }
            },
            {
              "value": "always",
              "title": {
                "key": "settings.choice.subagentSidebarAlways",
                "text": "Always"
              }
            },
            {
              "value": "group",
              "title": {
                "key": "settings.choice.subagentSidebarGroup",
                "text": "Chief's Workspaces Group"
              }
            },
            {
              "value": "never",
              "title": {
                "key": "settings.choice.subagentSidebarNever",
                "text": "Never"
              }
            }
          ],
          "default": "auto",
          "keywords": [
            "chief",
            "subagent",
            "sidebar",
            "workspace",
            "show",
            "hide",
            "hidden",
            "visible",
            "group",
            "internal"
          ]
        },
        {
          "key": "chief.subagentSidebarShowWords",
          "name": "showWords",
          "title": {
            "key": "settings.chief.subagentSidebarShowWords",
            "text": "Show Tasks That Mention"
          },
          "help": {
            "key": "settings.chief.subagentSidebarShowWords.help",
            "text": "Words or phrases that show a subagent when the Chief leaves it to these rules. They add to the built-in ones, such as UI, design, screenshots and needs you."
          },
          "kind": "string_list",
          "default": [],
          "placeholder": {
            "key": "settings.placeholder.wordOrPhrase",
            "text": "Add a word or phrase"
          },
          "keywords": [
            "chief",
            "subagent",
            "sidebar",
            "workspace",
            "show",
            "hide",
            "hidden",
            "visible",
            "words",
            "rules"
          ]
        },
        {
          "key": "chief.subagentSidebarHideWords",
          "name": "hideWords",
          "title": {
            "key": "settings.chief.subagentSidebarHideWords",
            "text": "Hide Tasks That Mention"
          },
          "help": {
            "key": "settings.chief.subagentSidebarHideWords.help",
            "text": "Words or phrases that keep a subagent hidden when the Chief leaves it to these rules. They add to the built-in ones, such as lookup, cleanup and land queue. A show word wins."
          },
          "kind": "string_list",
          "default": [],
          "placeholder": {
            "key": "settings.placeholder.wordOrPhrase",
            "text": "Add a word or phrase"
          },
          "keywords": [
            "chief",
            "subagent",
            "sidebar",
            "workspace",
            "show",
            "hide",
            "hidden",
            "visible",
            "words",
            "rules"
          ]
        },
        {
          "key": "chief.subagentSidebarMinWords",
          "name": "minWords",
          "title": {
            "key": "settings.chief.subagentSidebarMinWords",
            "text": "Show Tasks Longer Than"
          },
          "help": {
            "key": "settings.chief.subagentSidebarMinWords.help",
            "text": "A task with no show or hide word gets a sidebar workspace when it has at least this many words. 0, the default, turns this rule off: length alone says little about whether you will look at a task."
          },
          "kind": "number",
          "range": {
            "min": 0,
            "max": 1000,
            "step": 10,
            "unit": "count"
          },
          "default": 0,
          "keywords": [
            "chief",
            "subagent",
            "sidebar",
            "workspace",
            "show",
            "hide",
            "hidden",
            "visible",
            "length",
            "words"
          ]
        }
      ]
    }
  ]
}
