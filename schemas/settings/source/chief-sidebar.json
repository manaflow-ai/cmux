{
  "$comment": "HAND-EDITED source of the Home section's Chief subagent sidebar rows (cx-d5b5d). scripts/cmux-next/gen-settings-sources.py writes the Swift descriptors and parser constants from it (its docstring is the row format); schemas/settings/settings-schema.json is still exported from Swift and must not change when rows move here.",
  "lists": [
    {
      "name": "chiefSidebar",
      "section": "home",
      "group": {
        "key": "settings.group.chiefSubagents",
        "text": "Subagents"
      },
      "note": "Which Chief subagents get a workspace in the sidebar (a1018, Lawrence 2026-11-05: \"the chief will make the decision if the workspace is visible in the sidebar or not\", with heuristics the user shapes). Under auto the host shows a task that mentions a show word, hides one that mentions a hide word, else shows a task of at least the minimum words; the words listed add to the built-in ones (optchat-chief sidebar_choice.rs). Read at each spawn.",
      "rows": [
        {
          "key": "chief.subagentSidebar",
          "name": "mode",
          "title": {
            "key": "settings.chief.subagentSidebar",
            "text": "Subagents in the Sidebar"
          },
          "help": {
            "key": "settings.chief.subagentSidebar.help",
            "text": "Automatic lets the Chief decide for each subagent: work you will want to watch or join shows, short errands stay hidden. Always and Never override the Chief."
          },
          "kind": "choice",
          "choices": [
            {
              "value": "auto",
              "title": {
                "key": "settings.choice.subagentSidebarAuto",
                "text": "Chief Decides"
              }
            },
            {
              "value": "always",
              "title": {
                "key": "settings.choice.subagentSidebarAlways",
                "text": "Always"
              }
            },
            {
              "value": "never",
              "title": {
                "key": "settings.choice.subagentSidebarNever",
                "text": "Never"
              }
            }
          ],
          "default": "auto",
          "keywords": [
            "chief",
            "subagent",
            "sidebar",
            "workspace",
            "show",
            "hide",
            "hidden",
            "visible"
          ]
        },
        {
          "key": "chief.subagentSidebarShowWords",
          "name": "showWords",
          "title": {
            "key": "settings.chief.subagentSidebarShowWords",
            "text": "Show Tasks That Mention"
          },
          "help": {
            "key": "settings.chief.subagentSidebarShowWords.help",
            "text": "Words or phrases that show a subagent when the Chief leaves it to these rules. They add to the built-in ones, such as UI, design, screenshots and needs you."
          },
          "kind": "string_list",
          "default": [],
          "placeholder": {
            "key": "settings.placeholder.wordOrPhrase",
            "text": "Add a word or phrase"
          },
          "keywords": [
            "chief",
            "subagent",
            "sidebar",
            "workspace",
            "show",
            "hide",
            "hidden",
            "visible",
            "words",
            "rules"
          ]
        },
        {
          "key": "chief.subagentSidebarHideWords",
          "name": "hideWords",
          "title": {
            "key": "settings.chief.subagentSidebarHideWords",
            "text": "Hide Tasks That Mention"
          },
          "help": {
            "key": "settings.chief.subagentSidebarHideWords.help",
            "text": "Words or phrases that keep a subagent hidden when the Chief leaves it to these rules. They add to the built-in ones, such as lookup, cleanup and land queue. A show word wins."
          },
          "kind": "string_list",
          "default": [],
          "placeholder": {
            "key": "settings.placeholder.wordOrPhrase",
            "text": "Add a word or phrase"
          },
          "keywords": [
            "chief",
            "subagent",
            "sidebar",
            "workspace",
            "show",
            "hide",
            "hidden",
            "visible",
            "words",
            "rules"
          ]
        },
        {
          "key": "chief.subagentSidebarMinWords",
          "name": "minWords",
          "title": {
            "key": "settings.chief.subagentSidebarMinWords",
            "text": "Show Tasks Longer Than"
          },
          "help": {
            "key": "settings.chief.subagentSidebarMinWords.help",
            "text": "A task with no show or hide word shows when it has at least this many words, and stays hidden when it is shorter."
          },
          "kind": "number",
          "range": {
            "min": 0,
            "max": 1000,
            "step": 10,
            "unit": "count"
          },
          "default": 50,
          "keywords": [
            "chief",
            "subagent",
            "sidebar",
            "workspace",
            "show",
            "hide",
            "hidden",
            "visible",
            "length",
            "words"
          ]
        }
      ]
    }
  ]
}
