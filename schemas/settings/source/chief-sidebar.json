          "kind": "number",
          "range": {
            "min": 0,
            "max": 1000,
            "step": 10,
            "unit": "count"
          },
          "default": 50,
          "keywords": [
            "chief",
            "subagent",
            "sidebar",
            "workspace",
            "show",
            "hide",
            "hidden",
            "visible",
            "length",
            "words",
            "group"
          ]
        }
