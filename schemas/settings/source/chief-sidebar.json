{
  "$comment": "HAND-EDITED source of the Home section's Chief subagent sidebar rows (cx-d5b5d). scripts/cmux-next/gen-settings-sources.py writes the Swift descriptors and parser constants from it (its docstring is the row format); schemas/settings/settings-schema.json is still exported from Swift and must not change when rows move here.",
  "lists": [
    {
      "name": "chiefSidebar",
      "section": "home",
      "group": {
        "key": "settings.group.chiefSubagents",
        "text": "Subagents"
      },
      "note": "Which kind of workspace each Chief subagent gets: every one gets a workspace, in the sidebar or in the collapsed \"Chief's workspaces\" group (Aziz, relayed 2026-11-11: \"no hidden workspaces at all\"). Under auto the host puts a task that mentions a sidebar word in the sidebar and one that mentions a Chief word in the group, else a task of at least the minimum words in the sidebar; the words listed add to the built-in ones (optchat-chief sidebar_choice.rs). Read at each spawn.",
      "rows": [
        {
          "key": "chief.subagentSidebar",
          "name": "mode",
          "title": {
            "key": "settings.chief.subagentSidebar",
            "text": "Subagent Workspaces"
          },
          "help": {
            "key": "settings.chief.subagentSidebar.help",
            "text": "Every subagent gets a workspace. Chief Decides puts work you will watch or join in the sidebar and errands in the collapsed Chief's workspaces group, which search still finds. Sidebar or Chief's Workspaces puts every subagent there."
          },
          "kind": "choice",
          "choices": [
            {
              "value": "auto",
              "title": {
                "key": "settings.choice.subagentSidebarAuto",
                "text": "Chief Decides"
              }
            },
            {
              "value": "always",
              "title": {
                "key": "settings.choice.subagentSidebarAlways",
                "text": "Sidebar"
              }
            },
            {
              "value": "never",
              "title": {
                "key": "settings.choice.subagentSidebarNever",
                "text": "Chief's Workspaces"
              }
            }
          ],
          "default": "auto",
          "keywords": [
            "chief",
            "subagent",
            "sidebar",
            "workspace",
            "show",
            "hide",
            "hidden",
            "visible",
            "group"
          ]
        },
        {
          "key": "chief.subagentSidebarShowWords",
          "name": "showWords",
          "title": {
            "key": "settings.chief.subagentSidebarShowWords",
            "text": "Sidebar for Tasks That Mention"
          },
          "help": {
            "key": "settings.chief.subagentSidebarShowWords.help",
            "text": "Words or phrases that put a subagent in the sidebar when the Chief leaves it to these rules. They add to the built-in ones, such as UI, design, screenshots and needs you."
          },
          "kind": "string_list",
          "default": [],
          "placeholder": {
            "key": "settings.placeholder.wordOrPhrase",
            "text": "Add a word or phrase"
          },
          "keywords": [
            "chief",
            "subagent",
            "sidebar",
            "workspace",
            "show",
            "hide",
            "hidden",
            "visible",
            "words",
            "rules",
            "group"
          ]
        },
        {
          "key": "chief.subagentSidebarHideWords",
          "name": "hideWords",
          "title": {
            "key": "settings.chief.subagentSidebarHideWords",
            "text": "Chief's Workspaces for Tasks That Mention"
          },
          "help": {
            "key": "settings.chief.subagentSidebarHideWords.help",
            "text": "Words or phrases that put a subagent in the collapsed Chief's workspaces group when the Chief leaves it to these rules. They add to the built-in ones, such as lookup, cleanup and land queue. A sidebar word wins."
          },
          "kind": "string_list",
          "default": [],
          "placeholder": {
            "key": "settings.placeholder.wordOrPhrase",
            "text": "Add a word or phrase"
          },
          "keywords": [
            "chief",
            "subagent",
            "sidebar",
            "workspace",
            "show",
            "hide",
            "hidden",
            "visible",
            "words",
            "rules",
            "group"
          ]
        },
        {
          "key": "chief.subagentSidebarMinWords",
          "name": "minWords",
          "title": {
            "key": "settings.chief.subagentSidebarMinWords",
            "text": "Sidebar for Tasks Longer Than"
          },
          "help": {
            "key": "settings.chief.subagentSidebarMinWords.help",
            "text": "A task with neither kind of word goes in the sidebar when it has at least this many words, and in Chief's workspaces when it is shorter."
