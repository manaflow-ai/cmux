        {
          "key": "sidebar.hoverCards.enabled",
          "note": "On by default. Off: no card opens on hover; Show Resource Usage still opens one.",
          "title": {
            "key": "settings.sidebar.hoverCards.enabled",
            "text": "Show Hover Cards"
          },
          "help": {
            "key": "settings.sidebar.hoverCards.enabled.help",
            "text": "A card with details opens when the pointer rests on a workspace or a tab."
          },
          "kind": "toggle",
          "default": true,
          "keywords": [
            "hover",
            "card",
            "preview",
            "tooltip",
            "workspace",
            "tab"
          ]
        },
        {
          "key": "sidebar.hoverCards.delay",
          "note": "Milliseconds the pointer rests before the first card opens (HoverCardTiming.showDelay). While a card shows, or within 500 ms after it went, the next one opens at once.",
          "title": {
            "key": "settings.sidebar.hoverCards.delay",
            "text": "Hover Card Delay"
          },
          "help": {
            "key": "settings.sidebar.hoverCards.delay.help",
            "text": "How long the pointer rests on a workspace or a tab before its card opens. While a card shows, the next one opens at once."
          },
          "kind": "number",
          "range": {
            "min": 0,
            "max": 5000,
            "step": 100,
            "unit": "milliseconds"
