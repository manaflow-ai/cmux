            {
              "value": "compact",
              "title": {
                "key": "settings.choice.hoverCardCompact",
                "text": "Compact"
              }
            },
            {
              "value": "log",
              "title": {
                "key": "settings.choice.hoverCardLog",
                "text": "Full History"
              }
