            {
              "value": "classic",
              "title": {
                "key": "settings.choice.hoverCardClassic",
                "text": "Details Only"
              }
            },
            {
              "value": "minimal",
              "title": {
                "key": "settings.choice.hoverCardMinimal",
                "text": "Minimal"
              }
            }
