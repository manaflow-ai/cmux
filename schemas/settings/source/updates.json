          "range": {
            "min": 0,
            "max": 5,
            "step": 1,
            "unit": "count"
          },
          "default": 1,
          "keywords": [
            "update",
            "rollback",
            "previous",
            "downgrade"
          ]
        },
        {
          "key": "updates.showWhatsNew",
          "note": "The bottom-left \"cmux Updated!\" card after an update (WHATS-NEW-AFTER-UPDATE W1; never a top-of-sidebar item); managed config can force it off.",
          "title": {
            "key": "settings.updates.showWhatsNew",
            "text": "Show What's New After Updates"
          },
          "help": {
            "key": "settings.updates.showWhatsNew.help",
            "text": "After an update, a card at the bottom of the sidebar links to What's New until you open or dismiss it."
          },
          "kind": "toggle",
          "default": true,
          "keywords": [
            "whats new",
            "release notes",
            "changelog",
