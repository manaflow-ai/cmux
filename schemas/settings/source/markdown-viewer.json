{
  "$comment": "HAND-EDITED source of the Appearance section's Markdown Viewer rows (cx-d5b5d). scripts/cmux-next/gen-settings-sources.py writes the Swift descriptors and parser constants from it (its docstring is the row format); schemas/settings/settings-schema.json is still exported from Swift and must not change when rows move here.",
  "lists": [
    {
      "name": "markdownViewer",
      "section": "appearance",
      "group": {
        "key": "settings.group.markdownViewer",
        "text": "Markdown Viewer"
      },
      "note": "The markdown viewer's rows (diff-host S6, reading settings 2026-10-19): the keys the viewer's Reading Settings popover (the toolbar's Aa button) writes, with the page's defaults and ranges (webviews/src/pages/markdown/settings.ts MARKDOWN_READING).",
      "rows": [
        {
          "key": "markdown.remoteImages",
          "title": {
            "key": "settings.markdown.remoteImages",
            "text": "Load Web Images Automatically"
          },
          "help": {
            "key": "settings.markdown.remoteImages.help",
            "text": "Web image sites can see your address and when you open a document. When off, each document asks before loading its web images."
          },
          "kind": "toggle",
          "default": false,
          "keywords": [
            "markdown",
            "viewer",
            "reading",
            "image",
            "web",
            "remote",
            "privacy",
            "tracking",
            "automatic"
          ]
        },
        {
          "key": "markdown.layout.width",
          "name": "width",
          "note": "The widest the text column gets, in characters of the body font. Wide enough for an ultrawide monitor (1000 characters is about 8,800 points at 16 points); Full Width is its own key, never the top of this range. The default is the page's (MARKDOWN_READING.width).",
          "title": {
            "key": "settings.markdown.width",
            "text": "Text Width"
          },
          "help": {
            "key": "settings.markdown.width.help",
            "text": "The widest a line of text gets, in characters (30 to 1000). On a wider window the text stays centered with margins. Wide tables and code scroll sideways in their own box."
          },
          "kind": "number",
          "range": {
            "min": 30,
            "max": 1000,
            "step": 1,
            "unit": "count",
            "placeholder": 72
          },
          "default": 72,
          "keywords": [
            "markdown",
            "viewer",
            "reading",
            "width",
            "max width",
            "column",
            "measure",
            "line length",
            "wide",
            "ultrawide",
            "monitor"
          ]
        },
        {
          "key": "markdown.layout.fullWidth",
          "title": {
            "key": "settings.markdown.fullWidth",
            "text": "Full Width"
          },
          "help": {
