{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmux.com/schemas/oracle/case-v1",
  "title": "cmux oracle case v1",
  "description": "One behavior case of the oracle corpus (tests/oracle/corpus/<suite>/<case>.json; plans/cmux-next/chrome-parity/p15-oracle.md section 3D). It is the ui-workflow-corpus manifest (plans/cmux-next/ui-workflow-corpus.md, 'Workflow manifest') plus the capabilities it requires, the refactor switches it exercises, its platforms and the child exits it allows. The product (daemon, app, cli, headless, tui, mcp) is a run parameter, as in WPT (third_party/blink/tools/run_wpt_tests.py): the runner skips a case whose requires a product does not offer. Waits are typed (Kombucha WaitForState, ui/base/interaction/interactive_test.h), never sleeps. The x-oracle-* keywords are checks that JSON Schema cannot express; scripts/cmux-next/oracle/case_checks.py (stdlib) runs them with the error text each carries, and normalize.py --validate (task 013) and oracle.py check (task 017) call it. fixtures/case-v1-mutations.json is the list of refusals both layers must produce.",
  "$comment": "x-oracle-unique: the array items' value at 'key' (a JSON pointer) is unique. x-oracle-step-ref: the step id in the string (the whole string, or the part between '$step:' and '#') names a step of this case; order 'earlier' also requires that step to come before the step that holds the string. x-oracle-crash-scope: each step that ends a child process (a kill, or a Chromium debug URL in its args) is inside the steps of an allow_crashes entry of its kind, and no kind has more such steps than the sum of its entries' max. x-oracle-error: the message for the JSON Schema refusal of the def that carries it. Every pointer in a message is the JSON pointer of the value itself: {pointer} is the offending value (/steps/3/id, /steps/6/target/browser), {first} the earlier value it repeats (/steps/2/id); {value} is that value, {step} a step id, {kind} a crash kind, {count} and {max} step counts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "corpusVersion",
    "id",
    "suite",
    "source",
    "environment",
    "fixture",
    "preconditions",
    "requires",
    "platforms",
    "steps",
    "invariants",
    "teardown"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "^(\\.\\./)*([a-z0-9-]+/)*case-v1\\.schema\\.json$",
      "description": "Relative path to this schema. A remote URL is refused like every other non-loopback URL."
    },
    "corpusVersion": {"const": 1},
    "id": {
      "$ref": "#/$defs/slug",
      "description": "Case id, equal to the file name without .json. Expectations and baselines key on suite/id."
    },
    "suite": {
      "$ref": "#/$defs/slug",
      "description": "Corpus suite (section 3D table), equal to the parent directory name."
    },
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "journey": {
      "$ref": "#/$defs/slug",
      "description": "Parent ui-workflow journey id when a journey is split into bounded cases."
    },
    "priority": {"enum": ["P0", "P1", "P2"]},
    "surface": {"enum": ["cmux-next-native", "cmux-next-webview", "cmux-next-daemon", "cmux-tui"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "ref", "artifact"],
      "description": "What the case runs against. The oracle compares two SHAs (or two arms) per run, so a corpus case normally says $RUN and the runner records the exact SHA and artifact in manifest.normalized.json.",
      "properties": {
        "repo": {"const": "manaflow-ai/cmux"},
        "ref": {"type": "string", "pattern": "^([0-9a-f]{40}|\\$RUN)$"},
        "artifact": {"type": "string", "pattern": "^([A-Za-z0-9][A-Za-z0-9._:-]{0,127}|\\$RUN)$"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "description": "Run conditions the case pins. Animations are off by default (section 3B); motion-on is the motion-on switch arm, not a case field.",
      "properties": {
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": {"type": "integer", "minimum": 320, "maximum": 7680},
            "height": {"type": "integer", "minimum": 240, "maximum": 4320}
          }
        },
        "scale": {"enum": [1, 2, 3]},
        "theme": {"enum": ["light", "dark"]},
        "locale": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-[A-Z]{2})?$"},
        "reducedMotion": {"type": "boolean"},
        "engine": {"enum": ["webkit", "chromium", "none"]}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "network", "clock"],
      "properties": {
        "seed": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "description": "Seeds ids (CMUX_TUI_ORACLE_SEED, CMUX_NEXT_ORACLE_SEED) and named fixture identities."
        },
        "network": {
          "const": "offline",
          "description": "Oracle cases run offline (unshare -rn, CMUX_TUI_OFFLINE=1). Only loopback URLs are allowed anywhere in the case."
        },
        "clock": {
          "enum": ["fixed", "virtual"],
          "description": "virtual: the daemon oracle feature's virtual clock (base/test/task_environment.h MOCK_TIME analog); required by advance_clock steps."
        },
        "agent": {"enum": ["mock", "none"]},
        "setup": {
          "$ref": "#/$defs/slug",
          "description": "Shared sweep setup family (scripts/cmux-next/oracle/action_fixtures/<setup>.py)."
        },
        "web": {
          "type": "boolean",
          "description": "Start the loopback web fixture server; case URLs then write its origin as $WEB."
        },
        "repo": {
          "$ref": "#/$defs/slug",
          "description": "Build the git repository tests/oracle/fixtures/git/<repo>.json under $CASE_ROOT/repos/ before the first step (make_repo.py build_for_case, which needs HOME under the case root): fixed author and committer dates, a bare origin under the case root as its only remote. The case requires git_repo."
        }
      }
    },
    "preconditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "requires": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/capability"},
      "description": "Capabilities the product must offer. Steps imply some of them (see allOf): resource.call needs resource_api, action.run actions, key keys, mcp mcp, tui.key tui, kill and restart restart, a kill of a Chromium process chromium; fixture.repo needs git_repo (the driver builds the repository). cli needs none: every product ships the cmux CLI."
    },
    "switches": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
      "description": "Refactor switches the case exercises (plans/cmux-next/refactor-switches/<name>.json). A diff --switch run on a listed switch with 0 hits on the requested arm is arm-not-exercised."
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["linux", "mac", "windows"]},
      "description": "Platforms the case can run on; the same names as the Expectations platform modifiers."
    },
    "allow_crashes": {
      "type": "array",
      "items": {"$ref": "#/$defs/allowCrash"},
      "description": "Child exits invariant I17 accepts (content/public/test/browser_test_base.h ScopedAllowRendererCrashes). Any other exit fails the case. The exit a step causes on purpose (a kill, a resource.call with ends, or a Chromium debug URL such as chrome://crash) must be listed too, inside the entry's steps, as CrashTab needs ScopedAllowRendererCrashes. I17 counts an exit in the step whose turn or settled checkpoint first shows the rise of crashes.counts (one first shown at a step's before checkpoint belongs to the step before it); when the checkpoints before that one are missing or not comparable, the exit belongs to every step it could have happened in, and an entry for any of them covers it. An exit during the teardown needs an entry without steps. Each exit takes one of the first matching entry's max.",
      "x-oracle-crash-scope": {
        "error": "{pointer}: step \"{step}\" ends a {kind} process, but no allow_crashes entry of kind {kind} lists it in its steps",
        "countError": "{pointer}: {count} steps end a {kind} process, but the allow_crashes entries of kind {kind} allow at most {max}"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {"$ref": "#/$defs/step"},
      "x-oracle-unique": {"key": "/id", "error": "duplicate step id \"{value}\": {pointer} repeats {first}"}
    },
    "invariants": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "description": "Case-specific semantic statements for the reviewer. I1-I18 run at every checkpoint regardless."
    },
    "teardown": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "untested": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {"$ref": "#/$defs/noRemoteUrl"},
    {"$ref": "#/$defs/opNeedsCapabilityResourceCall"},
    {"$ref": "#/$defs/opNeedsCapabilityActionRun"},
    {"$ref": "#/$defs/opNeedsCapabilityKey"},
    {"$ref": "#/$defs/opNeedsCapabilityMcp"},
    {"$ref": "#/$defs/opNeedsCapabilityTuiKey"},
    {"$ref": "#/$defs/opNeedsCapabilityKill"},
    {"$ref": "#/$defs/opNeedsCapabilityRestart"},
    {"$ref": "#/$defs/opNeedsCapabilityChromiumKill"},
    {
      "$comment": "fixture.repo is built by the driver before the first step; a product whose driver does not build it lacks git_repo and never runs the case.",
      "if": {"required": ["fixture"], "properties": {"fixture": {"required": ["repo"]}}},
      "then": {"properties": {"requires": {"contains": {"const": "git_repo"}}}}
    },
    {
      "$comment": "advance_clock moves the daemon's virtual clock; a fixed or real clock cannot be advanced.",
      "if": {
        "required": ["steps"],
        "properties": {"steps": {"contains": {"required": ["op"], "properties": {"op": {"const": "advance_clock"}}}}}
      },
      "then": {"properties": {"fixture": {"properties": {"clock": {"const": "virtual"}}}}}
    },
    {"$ref": "#/$defs/killAllowsCrashDaemon"},
    {"$ref": "#/$defs/killAllowsCrashHolder"},
    {"$ref": "#/$defs/killAllowsCrashRenderer"},
    {"$ref": "#/$defs/killAllowsCrashGpu"},
    {"$ref": "#/$defs/killAllowsCrashBrowser"},
    {"$ref": "#/$defs/killAllowsCrashUtility"}
  ],
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "capability": {"enum": ["resource_api", "actions", "keys", "gui", "chromium", "restart", "mcp", "tui", "git_repo"]},
    "crashKind": {
      "enum": ["renderer", "gpu", "browser", "utility", "daemon", "holder"],
      "description": "The kinds of the crashes facet (snapshot-v1): the child processes whose exits I17 observes. The app is the observer, so a kill step cannot target it; restart the app instead."
    },
    "facetName": {
      "enum": [
        "topology",
        "daemon",
        "focus",
        "layout",
        "sidebar",
        "tabs",
        "overlays",
        "settings",
        "intents",
        "windows",
        "history",
        "notifications",
        "agents",
        "terminals",
        "webviews",
        "ax",
        "crashes",
        "liveObjects",
        "invariants",
        "switches",
        "cli",
        "mcp"
      ]
    },
    "facetPointer": {
      "type": "string",
      "pattern": "^/(topology|daemon|focus|layout|sidebar|tabs|overlays|settings|intents|windows|history|notifications|agents|terminals|webviews|ax|crashes|liveObjects|invariants|switches|cli|mcp)(/([^~/]|~[01])*)*$",
      "description": "JSON pointer into a snapshot, starting with a facet name."
    },
    "stepRef": {
      "type": "string",
      "pattern": "^\\$step:[a-z0-9][a-z0-9-]{0,63}#(/([^~/]|~[01])*)*$",
      "description": "A value from an earlier step's reply: $step:<step id>#<JSON pointer into the reply>. The runner substitutes it before the step runs.",
      "x-oracle-step-ref": {
        "order": "earlier",
        "error": "{pointer}: \"{value}\" names step \"{step}\", which is not an earlier step of this case"
      }
    },
    "handle": {
      "description": "A named fixture identity (seeded by fixture.seed) or a value from an earlier step.",
      "anyOf": [{"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, {"$ref": "#/$defs/stepRef"}]
    },
    "value": {
      "description": "Free-form JSON. A string that starts with $step: must be a valid earlier-step reference.",
      "if": {"type": "string", "pattern": "^\\$step:"},
      "then": {"$ref": "#/$defs/stepRef"},
      "items": {"$ref": "#/$defs/value"},
      "additionalProperties": {"$ref": "#/$defs/value"}
    },
    "valueObject": {"type": "object", "additionalProperties": {"$ref": "#/$defs/value"}},
    "noRemoteUrl": {
      "description": "Every string and key in the case, at any depth: a URL must have a loopback host (127.0.0.1, localhost, [::1]). The host is found the way the WHATWG URL parser finds it (url/url_canon_stdurl.cc, url/url_parse.cc): for http, https, ws, wss and ftp any run of / and \\ after the colon comes before the host, so http:host and http:\\\\host are refused like http://host; a file URL may only have an empty or loopback host (file:///path); a scheme-relative //host or \\\\host is refused. The Chromium debug URLs (third_party/blink/public/common/chrome_debug_urls.h) are local. The web fixture origin is written $WEB, without a scheme.",
      "not": {
        "type": "string",
        "pattern": "(?:^|[^A-Za-z0-9+.-])(?![Cc][Hh][Rr][Oo][Mm][Ee]://(?:crash|kill|hang|shorthang|gpucrash|gpuhang|memory-exhaust)(?![A-Za-z0-9-])|[Ff][Ii][Ll][Ee]:|(?:[Hh][Tt][Tt][Pp][Ss]?|[Ww][Ss][Ss]?|[Ff][Tt][Pp]):)[A-Za-z][A-Za-z0-9+.-]*://(?!(?:127\\.0\\.0\\.1|localhost|\\[::1\\])(?::[0-9]{1,5})?(?![A-Za-z0-9._~%!$&'()*+,;=:@\\t\\n\\r-]))|(?:^|[^A-Za-z0-9+.-])(?:[Hh][Tt][Tt][Pp][Ss]?|[Ww][Ss][Ss]?|[Ff][Tt][Pp]):[/\\\\]*(?![/\\\\])(?!(?:127\\.0\\.0\\.1|localhost|\\[::1\\])(?::[0-9]{1,5})?(?![A-Za-z0-9._~%!$&'()*+,;=:@\\t\\n\\r-]))|(?:^|[^A-Za-z0-9+.-])[Ff][Ii][Ll][Ee]:[/\\\\]{2}(?!/(?![/\\\\])|(?:127\\.0\\.0\\.1|localhost|\\[::1\\])(?::[0-9]{1,5})?(?![A-Za-z0-9._~%!$&'()*+,;=:@\\t\\n\\r-]))|(?:^|[\\s\"'(<>=,;\\[{|])[/\\\\]{2,}(?![/\\\\])(?=[A-Za-z0-9%\\[])(?!(?:127\\.0\\.0\\.1|localhost|\\[::1\\])(?::[0-9]{1,5})?(?![A-Za-z0-9._~%!$&'()*+,;=:@\\t\\n\\r-]))"
      },
      "x-oracle-error": "{pointer}: non-loopback URL in \"{value}\"; offline cases may only use 127.0.0.1, localhost, [::1], $WEB, file:/// or a chrome:// debug URL",
      "items": {"$ref": "#/$defs/noRemoteUrl"},
      "propertyNames": {"$ref": "#/$defs/noRemoteUrl"},
      "additionalProperties": {"$ref": "#/$defs/noRemoteUrl"}
    },
    "target": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "description": "The objects the step acts on. For resource.call these are the operation's selectors (cmux-tui/spec/resource-operations-v2.json); the graph check fails when a step changes an identity it does not target.",
      "properties": {
        "machine": {"$ref": "#/$defs/handle"},
        "session": {"$ref": "#/$defs/handle"},
        "client": {"$ref": "#/$defs/handle"},
        "frontend_projection": {"$ref": "#/$defs/handle"},
        "pairing_request": {"$ref": "#/$defs/handle"},
        "sidebar_view": {"$ref": "#/$defs/handle"},
        "stream": {"$ref": "#/$defs/handle"},
        "window": {"$ref": "#/$defs/handle"},
        "workspace": {"$ref": "#/$defs/handle"},
        "screen": {"$ref": "#/$defs/handle"},
        "pane": {"$ref": "#/$defs/handle"},
        "tab": {"$ref": "#/$defs/handle"},
        "terminal": {"$ref": "#/$defs/handle"},
        "browser": {"$ref": "#/$defs/handle"},
        "agent": {"$ref": "#/$defs/handle"},
        "process": {
          "enum": ["app", "daemon", "holder", "renderer", "gpu", "browser", "utility"],
          "description": "The process a kill or restart step acts on."
        }
      }
    },
    "keystroke": {
      "type": "string",
      "pattern": "^((cmd|ctrl|opt|alt|shift|fn)\\+)*([a-z0-9]|[-=\\[\\];:',./`\\\\]|plus|f[1-9]|f1[0-9]|return|escape|tab|space|backspace|delete|left|right|up|down|home|end|pageup|pagedown)$"
    },
    "keyArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keys"],
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/keystroke"},
          "description": "Keystrokes sent in order through the real key path, one turn each."
        }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": {"enum": ["ok", "error"]},
        "error": {
          "type": "string",
          "pattern": "^[a-z][a-z_]*(\\.[a-z][a-z_]*)+$",
          "description": "Typed error code, for example validation.invalid."
        },
        "result": {"$ref": "#/$defs/value", "description": "The reply after canonicalization, compared exactly. $step: references resolve first, so \"$step:<id>#\" holds the reply equal to an earlier step's whole reply."},
        "resultExcept": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(/([^~/]|~[01])*)+$"},
          "description": "JSON pointers removed from both the reply and result before the comparison: what a step may change and the case does not assert (a generation, a cursor, a connection's age). A segment * stands for every array item or object member at that place. A pointer that names nothing in either value removes nothing."
        },
        "receipt": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*([._][a-z][A-Za-z0-9]*)*$",
          "description": "Typed receipt kind the step must produce (I1): for action.run and key the ActionEffect kind the registry reports (action.done, action.applied, action.waiting), for resource.call the reply kind of resource-operations-v2 (mutation_result)."
        },
        "noReceiptReason": {"type": "string", "minLength": 10, "description": "Why the step has no receipt."},
        "errorDetails": {
          "type": "object",
          "minProperties": 1,
          "description": "A subset of the typed error's details the step must give: each key is present with an equal value, an object compared the same way key by key, any other value exactly. $step: references resolve first. A driver that cannot read the error's details fails the step as a Crash; it never skips the check."
        }
      },
      "dependentRequired": {"resultExcept": ["result"]},
      "if": {"properties": {"outcome": {"const": "error"}}},
      "then": {"required": ["error"]},
      "else": {"not": {"anyOf": [{"required": ["error"]}, {"required": ["errorDetails"]}]}}
    },
    "expectMutation": {
      "description": "I1: a mutation gives exactly one receipt or one typed error. An ok outcome names its receipt or says why none exists; an error outcome has its typed error and no receipt.",
      "if": {"properties": {"outcome": {"const": "ok"}}},
      "then": {
        "oneOf": [
          {"required": ["receipt"], "not": {"required": ["noReceiptReason"]}},
          {"required": ["noReceiptReason"], "not": {"required": ["receipt"]}}
        ]
      },
      "else": {"not": {"anyOf": [{"required": ["receipt"]}, {"required": ["noReceiptReason"]}]}}
    },
    "waitFor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer", "maxMs"],
      "description": "Waits until the snapshot value at pointer meets the condition (debug.oracle.wait_for, resolved from facet change signals). A timeout is the Timeout result.",
      "properties": {
        "pointer": {"$ref": "#/$defs/facetPointer"},
        "equals": {"$ref": "#/$defs/value"},
        "predicate": {
          "oneOf": [
            {"enum": ["exists", "absent", "empty", "nonEmpty", "changed"]},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["op", "value"],
              "properties": {
                "op": {"enum": ["gt", "gte", "lt", "lte", "contains", "lengthEquals"]},
                "value": {"$ref": "#/$defs/value"}
              }
            }
          ]
        },
        "maxMs": {"type": "integer", "minimum": 1, "maximum": 30000}
      },
      "oneOf": [{"required": ["equals"]}, {"required": ["predicate"]}]
    },
    "allowCrash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": {"$ref": "#/$defs/crashKind"},
        "reason": {"type": "string", "minLength": 10},
        "steps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Steps during which the exit may happen; the whole case when absent.",
          "items": {
            "$ref": "#/$defs/slug",
            "x-oracle-step-ref": {
              "order": "any",
              "error": "{pointer}: allow_crashes names step \"{step}\", which this case does not have"
            }
          }
        },
        "max": {"type": "integer", "minimum": 1, "default": 1, "description": "Most exits of this kind allowed."}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "op": {
          "enum": [
            "resource.call",
            "action.run",
            "key",
            "cli",
            "mcp",
            "tui.key",
            "settle",
            "snapshot",
            "kill",
            "restart",
            "advance_clock"
          ]
        },
        "target": {"$ref": "#/$defs/target"},
        "args": {"type": "object"},
        "readOnly": {
          "type": "boolean",
          "description": "resource.call, cli and mcp only: the step reads and needs no target. The runner fails the step when its settled snapshot differs from its before snapshot."
        },
        "expect": {"$ref": "#/$defs/expect"},
        "ends": {
          "const": "daemon",
          "description": "resource.call mutations only: an ok reply ends this process on purpose (session.shutdown stops the daemon after its receipt). The runner waits for the exit in the step, fails it unless the exit is a normal termination (exit 0; base/process/kill.h TERMINATION_STATUS_NORMAL_TERMINATION), records it as the step's exit for I17, and a later restart starts the process without stopping it. allow_crashes must list the step."
        },
        "waitFor": {"$ref": "#/$defs/waitFor"},
        "checkpoint": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["before", "turn", "settled"]},
          "default": ["settled"],
          "description": "Snapshots to record: before the step, at the end of its input turn (app action.run and key only), and after debug.oracle.settle."
        },
        "settleMaxMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000,
          "description": "Bound of the settle barrier after this step; Slow in Expectations gives 5x."
        },
        "note": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "$comment": "Always mutating: needs a target and an expected outcome.",
          "if": {
            "required": ["op"],
            "properties": {"op": {"enum": ["action.run", "key", "tui.key", "kill", "restart"]}}
          },
          "then": {
            "required": ["target", "expect"],
            "not": {"required": ["readOnly"]},
            "properties": {"expect": {"$ref": "#/$defs/expectMutation"}}
          }
        },
        {
          "$comment": "resource.call, cli and mcp mutate unless readOnly is true.",
          "if": {
            "required": ["op"],
            "properties": {"op": {"enum": ["resource.call", "cli", "mcp"]}, "readOnly": {"const": false}}
          },
          "then": {"required": ["target", "expect"], "properties": {"expect": {"$ref": "#/$defs/expectMutation"}}}
        },
        {
          "$comment": "Only a mutating resource.call ends a process on purpose.",
          "if": {"required": ["ends"]},
          "then": {"required": ["op"], "properties": {"op": {"const": "resource.call"}, "readOnly": {"const": false}}}
        },
        {
          "$comment": "Runner steps act on the whole run: no target, no readOnly.",
          "if": {"required": ["op"], "properties": {"op": {"enum": ["settle", "snapshot", "advance_clock"]}}},
          "then": {"not": {"anyOf": [{"required": ["target"]}, {"required": ["readOnly"]}]}}
        },
        {
          "$comment": "Turn checkpoints come from the app's OracleRecorder, which records input turns.",
          "if": {"required": ["op"], "properties": {"op": {"not": {"enum": ["action.run", "key"]}}}},
          "then": {"properties": {"checkpoint": {"not": {"contains": {"const": "turn"}}}}}
        },
        {
          "if": {"required": ["op"], "properties": {"op": {"const": "resource.call"}}},
          "then": {"required": ["args"], "properties": {"args": {"$ref": "#/$defs/argsResourceCall"}}}
        },
        {
          "$comment": "resource-operations-v2: idempotency is required for every mutation and forbidden for every read.",
          "if": {"required": ["op"], "properties": {"op": {"const": "resource.call"}, "readOnly": {"const": false}}},
          "then": {"properties": {"args": {"required": ["idempotencyKey"]}}},
          "else": {"properties": {"args": {"not": {"required": ["idempotencyKey"]}}}}
        },
        {
          "if": {"required": ["op"], "properties": {"op": {"const": "action.run"}}},
          "then": {"required": ["args"], "properties": {"args": {"$ref": "#/$defs/argsActionRun"}}}
        },
        {
          "if": {"required": ["op"], "properties": {"op": {"enum": ["key", "tui.key"]}}},
          "then": {"required": ["args"], "properties": {"args": {"$ref": "#/$defs/keyArgs"}}}
        },
        {
          "if": {"required": ["op"], "properties": {"op": {"const": "cli"}}},
          "then": {"required": ["args"], "properties": {"args": {"$ref": "#/$defs/argsCli"}}}
        },
        {
          "if": {"required": ["op"], "properties": {"op": {"const": "mcp"}}},
          "then": {"required": ["args"], "properties": {"args": {"$ref": "#/$defs/argsMcp"}}}
        },
        {
          "if": {"required": ["op"], "properties": {"op": {"const": "snapshot"}}},
          "then": {"properties": {"args": {"$ref": "#/$defs/argsSnapshot"}}}
        },
        {
          "if": {"required": ["op"], "properties": {"op": {"const": "kill"}}},
          "then": {
            "properties": {
              "target": {"required": ["process"], "properties": {"process": {"$ref": "#/$defs/crashKind"}}},
              "args": {"$ref": "#/$defs/argsKill"}
            }
          }
        },
        {
          "if": {"required": ["op"], "properties": {"op": {"const": "restart"}}},
          "then": {
            "properties": {
              "target": {"required": ["process"], "properties": {"process": {"enum": ["daemon", "app"]}}}
            }
          }
        },
        {
          "if": {"required": ["op"], "properties": {"op": {"enum": ["settle", "restart"]}}},
          "then": {"not": {"required": ["args"]}}
        },
        {
          "if": {"required": ["op"], "properties": {"op": {"const": "advance_clock"}}},
          "then": {"required": ["args"], "properties": {"args": {"$ref": "#/$defs/argsAdvanceClock"}}}
        },
        {
          "$comment": "$step: references in target, args, expect and waitFor must name an earlier step.",
          "properties": {
            "args": {"$ref": "#/$defs/value"},
            "expect": {"$ref": "#/$defs/value"},
            "waitFor": {"$ref": "#/$defs/value"}
          }
        }
      ]
    },
    "argsResourceCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": {
          "type": "string",
          "pattern": "^[a-z][a-z_]*(\\.[a-z][a-z_]*)+$",
          "description": "An operation of cmux-tui/spec/resource-operations-v2.json."
        },
        "params": {"$ref": "#/$defs/valueObject", "description": "The operation's fields. Selectors go in target."},
        "idempotencyKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "description": "Required for a mutation and refused for a read, as resource-operations-v2 declares. I10 retries reuse it."
        }
      }
    },
    "argsActionRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*(\\.[a-z0-9][A-Za-z0-9]*)*$",
          "description": "An action id of the app's ActionRegistry. A later segment may be a number (browser.keepNeighborTabsAwake.0)."
        },
        "params": {"$ref": "#/$defs/valueObject"},
        "entrypoint": {
          "enum": ["key", "pointer", "unattributed", "cli", "mcp", "script", "remote", "page"],
          "description": "ActionEntrypoint the run is attributed to (CmuxNextActions/ActionEntrypoint.swift)."
        }
      }
    },
    "argsCli": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"},
          "description": "Arguments after the cmux binary; no shell."
        },
        "stdin": {"type": "string"}
      }
    },
    "argsMcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool"],
      "properties": {
        "tool": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
        "arguments": {"$ref": "#/$defs/valueObject"}
      }
    },
    "argsSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "facets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/facetName"},
          "description": "Facets to record; all when absent."
        }
      }
    },
    "argsKill": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"signal": {"enum": ["KILL", "TERM", "ABRT", "SEGV"], "default": "KILL"}}
    },
    "argsAdvanceClock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ms"],
      "properties": {"ms": {"type": "integer", "minimum": 1, "maximum": 86400000}}
    },
    "opNeedsCapabilityResourceCall": {
      "if": {"$ref": "#/$defs/hasOpResourceCall"},
      "then": {"properties": {"requires": {"contains": {"const": "resource_api"}}}}
    },
    "opNeedsCapabilityActionRun": {
      "if": {"$ref": "#/$defs/hasOpActionRun"},
      "then": {"properties": {"requires": {"contains": {"const": "actions"}}}}
    },
    "opNeedsCapabilityKey": {
      "if": {"$ref": "#/$defs/hasOpKey"},
      "then": {"properties": {"requires": {"contains": {"const": "keys"}}}}
    },
    "opNeedsCapabilityMcp": {
      "if": {"$ref": "#/$defs/hasOpMcp"},
      "then": {"properties": {"requires": {"contains": {"const": "mcp"}}}}
    },
    "opNeedsCapabilityTuiKey": {
      "if": {"$ref": "#/$defs/hasOpTuiKey"},
      "then": {"properties": {"requires": {"contains": {"const": "tui"}}}}
    },
    "opNeedsCapabilityKill": {
      "if": {"$ref": "#/$defs/hasOpKill"},
      "then": {"properties": {"requires": {"contains": {"const": "restart"}}}}
    },
    "opNeedsCapabilityRestart": {
      "if": {"$ref": "#/$defs/hasOpRestart"},
      "then": {"properties": {"requires": {"contains": {"const": "restart"}}}}
    },
    "opNeedsCapabilityChromiumKill": {
      "if": {
        "required": ["steps"],
        "properties": {
          "steps": {
            "contains": {
              "required": ["op", "target"],
              "properties": {
                "op": {"const": "kill"},
                "target": {
                  "required": ["process"],
                  "properties": {"process": {"enum": ["renderer", "gpu", "browser", "utility"]}}
                }
              }
            }
          }
        }
      },
      "then": {"properties": {"requires": {"contains": {"const": "chromium"}}}}
    },
    "hasOpResourceCall": {
      "required": ["steps"],
      "properties": {"steps": {"contains": {"required": ["op"], "properties": {"op": {"const": "resource.call"}}}}}
    },
    "hasOpActionRun": {
      "required": ["steps"],
      "properties": {"steps": {"contains": {"required": ["op"], "properties": {"op": {"const": "action.run"}}}}}
    },
    "hasOpKey": {
      "required": ["steps"],
      "properties": {"steps": {"contains": {"required": ["op"], "properties": {"op": {"const": "key"}}}}}
    },
    "hasOpMcp": {
      "required": ["steps"],
      "properties": {"steps": {"contains": {"required": ["op"], "properties": {"op": {"const": "mcp"}}}}}
    },
    "hasOpTuiKey": {
      "required": ["steps"],
      "properties": {"steps": {"contains": {"required": ["op"], "properties": {"op": {"const": "tui.key"}}}}}
    },
    "hasOpKill": {
      "required": ["steps"],
      "properties": {"steps": {"contains": {"required": ["op"], "properties": {"op": {"const": "kill"}}}}}
    },
    "hasOpRestart": {
      "required": ["steps"],
      "properties": {"steps": {"contains": {"required": ["op"], "properties": {"op": {"const": "restart"}}}}}
    },
    "killAllowsCrashDaemon": {
      "if": {"$ref": "#/$defs/killsProcessDaemon"},
      "then": {
        "required": ["allow_crashes"],
        "properties": {"allow_crashes": {"contains": {"properties": {"kind": {"const": "daemon"}}}}}
      }
    },
    "killAllowsCrashHolder": {
      "if": {"$ref": "#/$defs/killsProcessHolder"},
      "then": {
        "required": ["allow_crashes"],
        "properties": {"allow_crashes": {"contains": {"properties": {"kind": {"const": "holder"}}}}}
      }
    },
    "killAllowsCrashRenderer": {
      "if": {"anyOf": [{"$ref": "#/$defs/killsProcessRenderer"}, {"$ref": "#/$defs/opensRendererCrashUrl"}]},
      "then": {
        "required": ["allow_crashes"],
        "properties": {"allow_crashes": {"contains": {"properties": {"kind": {"const": "renderer"}}}}}
      }
    },
    "killAllowsCrashGpu": {
      "if": {"anyOf": [{"$ref": "#/$defs/killsProcessGpu"}, {"$ref": "#/$defs/opensGpuCrashUrl"}]},
      "then": {
        "required": ["allow_crashes"],
        "properties": {"allow_crashes": {"contains": {"properties": {"kind": {"const": "gpu"}}}}}
      }
    },
    "killAllowsCrashBrowser": {
      "if": {"$ref": "#/$defs/killsProcessBrowser"},
      "then": {
        "required": ["allow_crashes"],
        "properties": {"allow_crashes": {"contains": {"properties": {"kind": {"const": "browser"}}}}}
      }
    },
    "killAllowsCrashUtility": {
      "if": {"$ref": "#/$defs/killsProcessUtility"},
      "then": {
        "required": ["allow_crashes"],
        "properties": {"allow_crashes": {"contains": {"properties": {"kind": {"const": "utility"}}}}}
      }
    },
    "rendererCrashUrl": {
      "type": "string",
      "pattern": "(?:^|[^A-Za-z0-9+.-])[Cc][Hh][Rr][Oo][Mm][Ee]://(?:crash|kill|hang|shorthang|memory-exhaust)(?![A-Za-z0-9-])",
      "description": "A Chromium debug URL that crashes, kills, hangs or exhausts the renderer that loads it (chrome_debug_urls.h kChromeUICrashURL, kChromeUIKillURL, kChromeUIHangURL, kChromeUIShorthangURL, kChromeUIMemoryExhaustURL)."
    },
    "gpuCrashUrl": {
      "type": "string",
      "pattern": "(?:^|[^A-Za-z0-9+.-])[Cc][Hh][Rr][Oo][Mm][Ee]://(?:gpucrash|gpuhang)(?![A-Za-z0-9-])",
      "description": "A Chromium debug URL that crashes or hangs the GPU process (kChromeUIGpuCrashURL, kChromeUIGpuHangURL)."
    },
    "opensRendererCrashUrl": {
      "required": ["steps"],
      "properties": {"steps": {"contains": {"required": ["args"], "properties": {"args": {"$ref": "#/$defs/hasRendererCrashUrl"}}}}}
    },
    "opensGpuCrashUrl": {
      "required": ["steps"],
      "properties": {"steps": {"contains": {"required": ["args"], "properties": {"args": {"$ref": "#/$defs/hasGpuCrashUrl"}}}}}
    },
    "hasRendererCrashUrl": {
      "description": "The value is, or holds at any depth, a rendererCrashUrl string.",
      "anyOf": [
        {"$ref": "#/$defs/rendererCrashUrl"},
        {"type": "array", "contains": {"$ref": "#/$defs/hasRendererCrashUrl"}},
        {"type": "object", "not": {"additionalProperties": {"not": {"$ref": "#/$defs/hasRendererCrashUrl"}}}}
      ]
    },
    "hasGpuCrashUrl": {
      "description": "The value is, or holds at any depth, a gpuCrashUrl string.",
      "anyOf": [
        {"$ref": "#/$defs/gpuCrashUrl"},
        {"type": "array", "contains": {"$ref": "#/$defs/hasGpuCrashUrl"}},
        {"type": "object", "not": {"additionalProperties": {"not": {"$ref": "#/$defs/hasGpuCrashUrl"}}}}
      ]
    },
    "killsProcessDaemon": {
      "required": ["steps"],
      "properties": {
        "steps": {
          "contains": {
            "required": ["op", "target"],
            "properties": {
              "op": {"const": "kill"},
              "target": {"required": ["process"], "properties": {"process": {"const": "daemon"}}}
            }
          }
        }
      }
    },
    "killsProcessHolder": {
      "required": ["steps"],
      "properties": {
        "steps": {
          "contains": {
            "required": ["op", "target"],
            "properties": {
              "op": {"const": "kill"},
              "target": {"required": ["process"], "properties": {"process": {"const": "holder"}}}
            }
          }
        }
      }
    },
    "killsProcessRenderer": {
      "required": ["steps"],
      "properties": {
        "steps": {
          "contains": {
            "required": ["op", "target"],
            "properties": {
              "op": {"const": "kill"},
              "target": {"required": ["process"], "properties": {"process": {"const": "renderer"}}}
            }
          }
        }
      }
    },
    "killsProcessGpu": {
      "required": ["steps"],
      "properties": {
        "steps": {
          "contains": {
            "required": ["op", "target"],
            "properties": {
              "op": {"const": "kill"},
              "target": {"required": ["process"], "properties": {"process": {"const": "gpu"}}}
            }
          }
        }
      }
    },
    "killsProcessBrowser": {
      "required": ["steps"],
      "properties": {
        "steps": {
          "contains": {
            "required": ["op", "target"],
            "properties": {
              "op": {"const": "kill"},
              "target": {"required": ["process"], "properties": {"process": {"const": "browser"}}}
            }
          }
        }
      }
    },
    "killsProcessUtility": {
      "required": ["steps"],
      "properties": {
        "steps": {
          "contains": {
            "required": ["op", "target"],
            "properties": {
              "op": {"const": "kill"},
              "target": {"required": ["process"], "properties": {"process": {"const": "utility"}}}
            }
          }
        }
      }
    }
  }
}
