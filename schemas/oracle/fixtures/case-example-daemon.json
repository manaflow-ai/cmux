{
  "$schema": "../case-v1.schema.json",
  "corpusVersion": 1,
  "id": "case-example-daemon",
  "suite": "daemon-ops",
  "title": "Create, retry, split, refuse, kill and restart on the daemon resource API",
  "surface": "cmux-next-daemon",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {},
  "fixture": {
    "seed": "case-example-daemon-v1",
    "network": "offline",
    "clock": "virtual"
  },
  "preconditions": ["hermetic state root", "no other cmux-tui on the state root"],
  "requires": ["resource_api", "restart"],
  "platforms": ["linux", "mac"],
  "allow_crashes": [
    {
      "kind": "daemon",
      "reason": "kill-daemon ends the daemon on purpose to check restore",
      "steps": ["kill-daemon"]
    }
  ],
  "steps": [
    {
      "id": "create-ws",
      "op": "resource.call",
      "target": {"machine": "local", "session": "fixture"},
      "args": {
        "method": "workspace.create",
        "params": {"name": "oracle", "initial_content": "terminal"},
        "idempotencyKey": "case-example-daemon.create-ws"
      },
      "expect": {"outcome": "ok", "receipt": "mutation_result"},
      "checkpoint": ["before", "settled"]
    },
    {
      "id": "create-ws-retry",
      "op": "resource.call",
      "target": {"machine": "local", "session": "fixture"},
      "args": {
        "method": "workspace.create",
        "params": {"name": "oracle", "initial_content": "terminal"},
        "idempotencyKey": "case-example-daemon.create-ws"
      },
      "expect": {"outcome": "ok", "receipt": "mutation_result"},
      "note": "Same idempotency key as create-ws: I10 wants an equal result and no state change."
    },
    {
      "id": "split-right",
      "op": "resource.call",
      "target": {
        "machine": "local",
        "session": "fixture",
        "workspace": "$step:create-ws#/value/workspace_id",
        "pane": "$step:create-ws#/value/pane_id"
      },
      "args": {
        "method": "pane.split",
        "params": {"direction": "right"},
        "idempotencyKey": "case-example-daemon.split-right"
      },
      "expect": {"outcome": "ok", "receipt": "mutation_result"},
      "settleMaxMs": 2000
    },
    {
      "id": "rename-missing",
      "op": "resource.call",
      "target": {"machine": "local", "session": "fixture", "workspace": "missing-workspace"},
      "args": {
        "method": "workspace.rename",
        "params": {"name": "nowhere"},
        "idempotencyKey": "case-example-daemon.rename-missing"
      },
      "expect": {"outcome": "error", "error": "selector.not_found"}
    },
    {
      "id": "list-workspaces",
      "op": "resource.call",
      "readOnly": true,
      "args": {
        "method": "workspace.list",
        "params": {"order": "session"}
      },
      "expect": {"outcome": "ok"}
    },
    {
      "id": "advance-clock",
      "op": "advance_clock",
      "args": {"ms": 60000}
    },
    {
      "id": "kill-daemon",
      "op": "kill",
      "target": {"process": "daemon"},
      "args": {"signal": "KILL"},
      "expect": {"outcome": "ok", "noReceiptReason": "a killed process sends no reply; the crashes facet records the exit"}
    },
    {
      "id": "restart-daemon",
      "op": "restart",
      "target": {"process": "daemon"},
      "expect": {"outcome": "ok", "receipt": "identify"},
      "waitFor": {
        "pointer": "/daemon/session/workspaces",
        "predicate": {"op": "lengthEquals", "value": 2},
        "maxMs": 5000
      }
    },
    {
      "id": "settle-after-restart",
      "op": "settle",
      "settleMaxMs": 5000
    },
    {
      "id": "final-snapshot",
      "op": "snapshot",
      "args": {"facets": ["daemon", "crashes", "liveObjects"]}
    }
  ],
  "invariants": [
    "the retry with the same idempotency key returns the first result and writes no journal record",
    "the restarted daemon restores the workspaces acknowledged before the kill"
  ],
  "teardown": ["stop the case daemon", "verify the socket and state root are gone"],
  "untested": ["graceful shutdown with sessions kept"]
}
