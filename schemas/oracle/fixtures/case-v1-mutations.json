{
  "description": "Mutations of the case-v1 example cases and the result each must give (scripts/cmux-next/oracle/case_checks.py --selftest). layer x-oracle: JSON Schema accepts the case and case_checks.py refuses it with exactly error. layer schema: JSON Schema refuses it with an error at pointer. layer valid: both accept it. Patches are RFC 6902 add, remove and replace on base.",
  "mutations": [
    {"name": "duplicate-step-id", "base": "case-example-app.json", "layer": "x-oracle", "patch": [{"op": "replace", "path": "/steps/1/id", "value": "split-right"}], "error": "duplicate step id \"split-right\": /steps/1/id repeats /steps/0/id"},
    {"name": "duplicate-step-appended", "base": "case-example-daemon.json", "layer": "x-oracle", "patch": [{"op": "add", "path": "/steps/-", "value": {"id": "create-ws", "op": "settle"}}], "error": "duplicate step id \"create-ws\": /steps/10/id repeats /steps/0/id"},
    {"name": "step-ref-missing", "base": "case-example-app.json", "layer": "x-oracle", "patch": [{"op": "replace", "path": "/steps/6/target/browser", "value": "$step:nope#/browser_id"}], "error": "/steps/6/target/browser: \"$step:nope#/browser_id\" names step \"nope\", which is not an earlier step of this case"},
    {"name": "step-ref-self", "base": "case-example-app.json", "layer": "x-oracle", "patch": [{"op": "replace", "path": "/steps/6/target/browser", "value": "$step:crash-renderer#/browser_id"}], "error": "/steps/6/target/browser: \"$step:crash-renderer#/browser_id\" names step \"crash-renderer\", which is not an earlier step of this case"},
    {"name": "step-ref-later", "base": "case-example-daemon.json", "layer": "x-oracle", "patch": [{"op": "add", "path": "/steps/0/args/params/after", "value": "$step:split-right#/value"}], "error": "/steps/0/args/params/after: \"$step:split-right#/value\" names step \"split-right\", which is not an earlier step of this case"},
    {"name": "step-ref-in-waitfor", "base": "case-example-daemon.json", "layer": "x-oracle", "patch": [{"op": "replace", "path": "/steps/7/waitFor/predicate/value", "value": "$step:final-snapshot#/count"}], "error": "/steps/7/waitFor/predicate/value: \"$step:final-snapshot#/count\" names step \"final-snapshot\", which is not an earlier step of this case"},
    {"name": "allow-crashes-unknown-step", "base": "case-example-app.json", "layer": "x-oracle", "patch": [{"op": "add", "path": "/allow_crashes/0/steps/-", "value": "nope"}], "error": "/allow_crashes/0/steps/1: allow_crashes names step \"nope\", which this case does not have"},
    {"name": "kill-outside-allowance-steps", "base": "case-example-daemon.json", "layer": "x-oracle", "patch": [{"op": "replace", "path": "/allow_crashes/0/steps/0", "value": "create-ws"}], "error": "/steps/6: step \"kill-daemon\" ends a daemon process, but no allow_crashes entry of kind daemon lists it in its steps"},
    {"name": "kill-renderer-outside-allowance-steps", "base": "case-example-app.json", "layer": "x-oracle", "patch": [{"op": "add", "path": "/requires/-", "value": "restart"}, {"op": "replace", "path": "/allow_crashes/0/max", "value": 2}, {"op": "add", "path": "/steps/8", "value": {"id": "kill-renderer", "op": "kill", "target": {"process": "renderer"}, "expect": {"outcome": "ok", "noReceiptReason": "a killed process sends no reply"}}}], "error": "/steps/8: step \"kill-renderer\" ends a renderer process, but no allow_crashes entry of kind renderer lists it in its steps"},
    {"name": "crash-url-outside-allowance-steps", "base": "case-example-app.json", "layer": "x-oracle", "patch": [{"op": "replace", "path": "/allow_crashes/0/steps/0", "value": "open-page"}], "error": "/steps/6: step \"crash-renderer\" ends a renderer process, but no allow_crashes entry of kind renderer lists it in its steps"},
    {"name": "two-kills-one-allowed", "base": "case-example-daemon.json", "layer": "x-oracle", "patch": [{"op": "remove", "path": "/allow_crashes/0/steps"}, {"op": "add", "path": "/steps/8", "value": {"id": "kill-daemon-again", "op": "kill", "target": {"process": "daemon"}, "expect": {"outcome": "ok", "noReceiptReason": "a killed process sends no reply"}}}], "error": "/allow_crashes: 2 steps end a daemon process, but the allow_crashes entries of kind daemon allow at most 1"},
    {"name": "unknown-root-field", "base": "case-example-daemon.json", "layer": "schema", "patch": [{"op": "add", "path": "/retries", "value": 3}], "pointer": ""},
    {"name": "unknown-step-field", "base": "case-example-daemon.json", "layer": "schema", "patch": [{"op": "add", "path": "/steps/0/sleepMs", "value": 100}], "pointer": "/steps/0"},
    {"name": "mutation-without-target", "base": "case-example-daemon.json", "layer": "schema", "patch": [{"op": "remove", "path": "/steps/0/target"}], "pointer": "/steps/0"},
    {"name": "mutation-without-expect", "base": "case-example-app.json", "layer": "schema", "patch": [{"op": "remove", "path": "/steps/1/expect"}], "pointer": "/steps/1"},
    {"name": "mutation-without-receipt", "base": "case-example-daemon.json", "layer": "schema", "patch": [{"op": "remove", "path": "/steps/0/expect/receipt"}], "pointer": "/steps/0/expect"},
    {"name": "receipt-and-reason", "base": "case-example-daemon.json", "layer": "schema", "patch": [{"op": "add", "path": "/steps/0/expect/noReceiptReason", "value": "both forms at once"}], "pointer": "/steps/0/expect"},
    {"name": "error-with-receipt", "base": "case-example-daemon.json", "layer": "schema", "patch": [{"op": "add", "path": "/steps/3/expect/receipt", "value": "mutation_result"}], "pointer": "/steps/3/expect"},
    {"name": "error-details-on-ok", "base": "case-example-daemon.json", "layer": "schema", "patch": [{"op": "add", "path": "/steps/0/expect/errorDetails", "value": {"extra": {"code": "x"}}}], "pointer": "/steps/0/expect"},
    {"name": "error-details-empty", "base": "case-example-daemon.json", "layer": "schema", "patch": [{"op": "add", "path": "/steps/3/expect/errorDetails", "value": {}}], "pointer": "/steps/3/expect/errorDetails"},
    {"name": "kill-the-app", "base": "case-example-daemon.json", "layer": "schema", "patch": [{"op": "replace", "path": "/steps/6/target/process", "value": "app"}], "pointer": "/steps/6/target/process"},
    {"name": "kill-without-allowance", "base": "case-example-daemon.json", "layer": "schema", "patch": [{"op": "remove", "path": "/allow_crashes"}], "pointer": ""},
    {"name": "crash-url-without-allowance", "base": "case-example-app.json", "layer": "schema", "patch": [{"op": "remove", "path": "/allow_crashes"}], "pointer": ""},
    {"name": "gpu-crash-url-without-allowance", "base": "case-example-app.json", "layer": "schema", "patch": [{"op": "replace", "path": "/steps/6/args/params/url", "value": "chrome://gpucrash"}], "pointer": "/allow_crashes"},
    {"name": "kill-without-restart-capability", "base": "case-example-daemon.json", "layer": "schema", "patch": [{"op": "replace", "path": "/requires", "value": ["resource_api"]}], "pointer": "/requires"},
    {"name": "repo-without-git-repo-capability", "base": "case-example-daemon.json", "layer": "schema", "patch": [{"op": "add", "path": "/fixture/repo", "value": "oracle"}], "pointer": "/requires"},
    {"name": "repo-with-git-repo-capability", "base": "case-example-daemon.json", "layer": "valid", "patch": [{"op": "add", "path": "/fixture/repo", "value": "oracle"}, {"op": "add", "path": "/requires/-", "value": "git_repo"}]},
    {"name": "state-root-without-state-root-capability", "base": "case-example-daemon.json", "layer": "schema", "patch": [{"op": "add", "path": "/fixture/stateRoot", "value": {"writtenBy": "cmux-tui-v0.13.4", "openedBy": "head"}}], "pointer": "/requires"},
    {"name": "state-root-with-state-root-capability", "base": "case-example-daemon.json", "layer": "valid", "patch": [{"op": "add", "path": "/fixture/stateRoot", "value": {"writtenBy": "head", "openedBy": "cmux-tui-v0.13.4"}}, {"op": "add", "path": "/requires/-", "value": "state_root"}]},
    {"name": "state-root-unknown-build", "base": "case-example-daemon.json", "layer": "schema", "patch": [{"op": "add", "path": "/fixture/stateRoot", "value": {"writtenBy": "main", "openedBy": "head"}}, {"op": "add", "path": "/requires/-", "value": "state_root"}], "pointer": "/fixture/stateRoot/writtenBy"},
    {"name": "advance-clock-on-fixed-clock", "base": "case-example-daemon.json", "layer": "schema", "patch": [{"op": "replace", "path": "/fixture/clock", "value": "fixed"}], "pointer": "/fixture/clock"},
    {"name": "turn-checkpoint-on-cli", "base": "case-example-app.json", "layer": "schema", "patch": [{"op": "add", "path": "/steps/4/checkpoint", "value": ["turn"]}], "pointer": "/steps/4/checkpoint"},
    {"name": "mutation-without-idempotency-key", "base": "case-example-daemon.json", "layer": "schema", "patch": [{"op": "remove", "path": "/steps/0/args/idempotencyKey"}], "pointer": "/steps/0/args"},
    {"name": "read-with-idempotency-key", "base": "case-example-daemon.json", "layer": "schema", "patch": [{"op": "add", "path": "/steps/4/args/idempotencyKey", "value": "k"}], "pointer": "/steps/4/args"},
    {"name": "waitfor-without-condition", "base": "case-example-app.json", "layer": "schema", "patch": [{"op": "remove", "path": "/steps/2/waitFor/equals"}], "pointer": "/steps/2/waitFor"},
    {"name": "bad-keystroke", "base": "case-example-app.json", "layer": "schema", "patch": [{"op": "replace", "path": "/steps/1/args/keys/0", "value": "command+d"}], "pointer": "/steps/1/args/keys/0"},
    {"name": "malformed-step-ref", "base": "case-example-app.json", "layer": "schema", "patch": [{"op": "replace", "path": "/steps/6/target/browser", "value": "$step:open-page"}], "pointer": "/steps/6/target/browser"},
    {"name": "remote-schema-url", "base": "case-example-daemon.json", "layer": "schema", "patch": [{"op": "replace", "path": "/$schema", "value": "https://example.com/case-v1.schema.json"}], "pointer": "/$schema"},
    {"name": "url-remote", "base": "case-example-app.json", "layer": "schema", "patch": [{"op": "replace", "path": "/steps/5/args/params/url", "value": "http://example.com/"}], "pointer": "/steps/5/args/params/url"},
    {"name": "url-userinfo", "base": "case-example-app.json", "layer": "schema", "patch": [{"op": "replace", "path": "/steps/5/args/params/url", "value": "http://localhost@example.com/"}], "pointer": "/steps/5/args/params/url"},
    {"name": "url-look-alike-host", "base": "case-example-app.json", "layer": "schema", "patch": [{"op": "replace", "path": "/steps/5/args/params/url", "value": "http://localhost.example.com/"}], "pointer": "/steps/5/args/params/url"},
    {"name": "url-bad-port", "base": "case-example-app.json", "layer": "schema", "patch": [{"op": "replace", "path": "/steps/5/args/params/url", "value": "http://127.0.0.1:80a/"}], "pointer": "/steps/5/args/params/url"},
    {"name": "url-no-slashes", "base": "case-example-app.json", "layer": "schema", "patch": [{"op": "replace", "path": "/steps/5/args/params/url", "value": "http:example.com"}], "pointer": "/steps/5/args/params/url"},
    {"name": "url-one-slash", "base": "case-example-app.json", "layer": "schema", "patch": [{"op": "replace", "path": "/steps/5/args/params/url", "value": "https:/example.com"}], "pointer": "/steps/5/args/params/url"},
    {"name": "url-backslashes", "base": "case-example-app.json", "layer": "schema", "patch": [{"op": "replace", "path": "/steps/5/args/params/url", "value": "http:\\\\example.com"}], "pointer": "/steps/5/args/params/url"},
    {"name": "url-upper-scheme", "base": "case-example-app.json", "layer": "schema", "patch": [{"op": "replace", "path": "/steps/5/args/params/url", "value": "HTTP:example.com"}], "pointer": "/steps/5/args/params/url"},
    {"name": "url-ws-no-slashes", "base": "case-example-app.json", "layer": "schema", "patch": [{"op": "replace", "path": "/steps/5/args/params/url", "value": "ws:example.com"}], "pointer": "/steps/5/args/params/url"},
    {"name": "url-scheme-relative", "base": "case-example-app.json", "layer": "schema", "patch": [{"op": "replace", "path": "/steps/5/args/params/url", "value": "//example.com/x"}], "pointer": "/steps/5/args/params/url"},
    {"name": "url-unc", "base": "case-example-app.json", "layer": "schema", "patch": [{"op": "replace", "path": "/steps/5/args/params/url", "value": "\\\\example.com\\share"}], "pointer": "/steps/5/args/params/url"},
    {"name": "url-file-host", "base": "case-example-app.json", "layer": "schema", "patch": [{"op": "replace", "path": "/steps/5/args/params/url", "value": "file://example.com/x"}], "pointer": "/steps/5/args/params/url"},
    {"name": "url-file-four-slashes", "base": "case-example-app.json", "layer": "schema", "patch": [{"op": "replace", "path": "/steps/5/args/params/url", "value": "file:////example.com/x"}], "pointer": "/steps/5/args/params/url"},
    {"name": "url-file-backslashes", "base": "case-example-app.json", "layer": "schema", "patch": [{"op": "replace", "path": "/steps/5/args/params/url", "value": "file:\\\\example.com\\x"}], "pointer": "/steps/5/args/params/url"},
    {"name": "url-tab-in-host", "base": "case-example-app.json", "layer": "schema", "patch": [{"op": "replace", "path": "/steps/5/args/params/url", "value": "http://127.0.0.1\t.example.com/"}], "pointer": "/steps/5/args/params/url"},
    {"name": "url-other-scheme", "base": "case-example-app.json", "layer": "schema", "patch": [{"op": "replace", "path": "/steps/5/args/params/url", "value": "gopher://example.com/"}], "pointer": "/steps/5/args/params/url"},
    {"name": "url-chrome-not-debug", "base": "case-example-app.json", "layer": "schema", "patch": [{"op": "replace", "path": "/steps/5/args/params/url", "value": "chrome://settings"}], "pointer": "/steps/5/args/params/url"},
    {"name": "url-in-key", "base": "case-example-app.json", "layer": "schema", "patch": [{"op": "add", "path": "/steps/5/args/params/http:example.com", "value": 1}], "pointer": "/steps/5/args/params"},
    {"name": "url-in-cli-argv", "base": "case-example-app.json", "layer": "schema", "patch": [{"op": "add", "path": "/steps/4/args/argv/-", "value": "--url=//example.com"}], "pointer": "/steps/4/args/argv/3"},
    {"name": "url-loopback-port", "base": "case-example-app.json", "layer": "valid", "patch": [{"op": "replace", "path": "/steps/5/args/params/url", "value": "http://127.0.0.1:8080/x"}]},
    {"name": "url-localhost", "base": "case-example-app.json", "layer": "valid", "patch": [{"op": "replace", "path": "/steps/5/args/params/url", "value": "http://localhost/"}]},
    {"name": "url-ipv6-loopback", "base": "case-example-app.json", "layer": "valid", "patch": [{"op": "replace", "path": "/steps/5/args/params/url", "value": "http://[::1]:9/"}]},
    {"name": "url-ws-loopback", "base": "case-example-app.json", "layer": "valid", "patch": [{"op": "replace", "path": "/steps/5/args/params/url", "value": "ws://localhost:9222/devtools"}]},
    {"name": "url-file", "base": "case-example-app.json", "layer": "valid", "patch": [{"op": "replace", "path": "/steps/5/args/params/url", "value": "file:///tmp/x"}]},
    {"name": "url-file-localhost", "base": "case-example-app.json", "layer": "valid", "patch": [{"op": "replace", "path": "/steps/5/args/params/url", "value": "file://localhost/tmp/x"}]},
    {"name": "url-web-fixture", "base": "case-example-app.json", "layer": "valid", "patch": [{"op": "replace", "path": "/steps/5/args/params/url", "value": "$WEB/other.html"}]},
    {"name": "crash-allowance-for-whole-case", "base": "case-example-app.json", "layer": "valid", "patch": [{"op": "remove", "path": "/allow_crashes/0/steps"}]},
    {"name": "ends-outside-allowance-steps", "base": "case-example-daemon.json", "layer": "x-oracle", "patch": [{"op": "add", "path": "/allow_crashes/0/max", "value": 2}, {"op": "add", "path": "/steps/2/ends", "value": "daemon"}], "error": "/steps/2: step \"split-right\" ends a daemon process, but no allow_crashes entry of kind daemon lists it in its steps"},
    {"name": "ends-listed", "base": "case-example-daemon.json", "layer": "valid", "patch": [{"op": "replace", "path": "/allow_crashes/0/steps", "value": ["split-right", "kill-daemon"]}, {"op": "add", "path": "/allow_crashes/0/max", "value": 2}, {"op": "add", "path": "/steps/2/ends", "value": "daemon"}]},
    {"name": "ends-on-a-read", "base": "case-example-daemon.json", "layer": "schema", "patch": [{"op": "add", "path": "/steps/4/ends", "value": "daemon"}], "pointer": "/steps/4/readOnly"},
    {"name": "ends-a-holder", "base": "case-example-daemon.json", "layer": "schema", "patch": [{"op": "add", "path": "/steps/2/ends", "value": "holder"}], "pointer": "/steps/2/ends"},
    {"name": "result-except-without-result", "base": "case-example-daemon.json", "layer": "schema", "patch": [{"op": "add", "path": "/steps/4/expect/resultExcept", "value": ["/cursor"]}], "pointer": "/steps/4/expect"},
    {"name": "result-except-equal-reply", "base": "case-example-daemon.json", "layer": "valid", "patch": [{"op": "add", "path": "/steps/9", "value": {"id": "list-again", "op": "resource.call", "readOnly": true, "args": {"method": "workspace.list", "params": {"order": "session"}}, "expect": {"outcome": "ok", "result": "$step:list-workspaces#", "resultExcept": ["/workspaces/*/revision"]}}}]},
    {"name": "two-kills-two-allowed","base": "case-example-daemon.json", "layer": "valid", "patch": [{"op": "replace", "path": "/allow_crashes/0/steps", "value": ["kill-daemon", "kill-daemon-again"]}, {"op": "add", "path": "/allow_crashes/0/max", "value": 2}, {"op": "add", "path": "/steps/8", "value": {"id": "kill-daemon-again", "op": "kill", "target": {"process": "daemon"}, "expect": {"outcome": "ok", "noReceiptReason": "a killed process sends no reply"}}}]},
    {"name": "error-details-subset", "base": "case-example-daemon.json", "layer": "valid", "patch": [{"op": "add", "path": "/steps/3/expect/errorDetails", "value": {"scope": "pane"}}]},
    {"name": "restart-the-app", "base": "case-example-daemon.json", "layer": "valid", "patch": [{"op": "add", "path": "/steps/8", "value": {"id": "restart-app", "op": "restart", "target": {"process": "app"}, "expect": {"outcome": "ok", "receipt": "identify"}}}]}
