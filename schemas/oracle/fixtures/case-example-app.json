{
  "$schema": "../case-v1.schema.json",
  "corpusVersion": 1,
  "id": "case-example-app",
  "suite": "journeys",
  "title": "Split, palette, browser page and renderer crash in the app",
  "journey": "tabs-and-browser",
  "priority": "P0",
  "surface": "cmux-next-native",
  "source": {
    "repo": "manaflow-ai/cmux",
    "ref": "$RUN",
    "artifact": "$RUN"
  },
  "environment": {
    "viewport": {"width": 1440, "height": 900},
    "scale": 2,
    "theme": "dark",
    "locale": "en-US",
    "reducedMotion": false,
    "engine": "chromium"
  },
  "fixture": {
    "seed": "case-example-app-v1",
    "network": "offline",
    "clock": "fixed",
    "agent": "none",
    "setup": "browser",
    "web": true
  },
  "preconditions": ["private scratch config", "tagged bench build", "no unrelated app instance"],
  "requires": ["actions", "keys", "gui", "chromium", "resource_api"],
  "switches": ["layer-hosting"],
  "platforms": ["mac"],
  "allow_crashes": [
    {
      "kind": "renderer",
      "reason": "crash-renderer opens chrome://crash on purpose",
      "steps": ["crash-renderer"],
      "max": 1
    }
  ],
  "steps": [
    {
      "id": "split-right",
      "op": "action.run",
      "target": {"window": "main", "pane": "shell"},
      "args": {"action": "splitRight", "entrypoint": "script"},
      "expect": {"outcome": "ok", "receipt": "action.applied"},
      "waitFor": {"pointer": "/focus/windows/0/pane", "predicate": "changed", "maxMs": 2000},
      "checkpoint": ["before", "turn", "settled"]
    },
    {
      "id": "split-key",
      "op": "key",
      "target": {"window": "main"},
      "args": {"keys": ["cmd+d"]},
      "expect": {"outcome": "ok", "receipt": "action.applied"},
      "checkpoint": ["turn", "settled"]
    },
    {
      "id": "open-palette",
      "op": "key",
      "target": {"window": "main"},
      "args": {"keys": ["cmd+shift+p"]},
      "expect": {"outcome": "ok", "receipt": "action.done"},
      "waitFor": {"pointer": "/overlays/stack/0/kind", "equals": "palette", "maxMs": 2000}
    },
    {
      "id": "dismiss-palette",
      "op": "key",
      "target": {"window": "main"},
      "args": {"keys": ["escape"]},
      "expect": {"outcome": "ok", "receipt": "action.done"},
      "waitFor": {"pointer": "/overlays/stack", "predicate": "empty", "maxMs": 2000}
    },
    {
      "id": "list-panes",
      "op": "cli",
      "readOnly": true,
      "args": {"argv": ["pane", "list", "--json"]},
      "expect": {"outcome": "ok"}
    },
    {
      "id": "open-page",
      "op": "action.run",
      "target": {"window": "main"},
      "args": {"action": "newBrowserWorkspace", "params": {"url": "$WEB/load.html"}},
      "expect": {"outcome": "ok", "receipt": "action.applied"},
      "waitFor": {"pointer": "/tabs/selected/loading", "equals": false, "maxMs": 5000}
    },
    {
      "id": "crash-renderer",
      "op": "resource.call",
      "target": {"machine": "local", "session": "fixture", "browser": "$step:open-page#/browser_id"},
      "args": {
        "method": "browser.navigate",
        "params": {"url": "chrome://crash"},
        "idempotencyKey": "case-example-app.crash-renderer"
      },
      "expect": {"outcome": "ok", "receipt": "mutation_result"},
      "waitFor": {"pointer": "/tabs/selected/error", "predicate": "exists", "maxMs": 5000}
    },
    {
      "id": "reload-page",
      "op": "key",
      "target": {"window": "main", "browser": "$step:open-page#/browser_id"},
      "args": {"keys": ["cmd+r"]},
      "expect": {"outcome": "ok", "receipt": "action.done"},
      "waitFor": {"pointer": "/tabs/selected/error", "predicate": "absent", "maxMs": 5000}
    },
    {
      "id": "final-snapshot",
      "op": "snapshot",
      "args": {"facets": ["topology", "focus", "tabs", "overlays", "crashes", "switches"]}
    }
  ],
  "invariants": [
    "the app pid does not change when the renderer crashes",
    "the crashed tab shows an error state with retry, and the other facets do not change"
  ],
  "teardown": ["quit the tagged app the run started", "verify its debug socket is gone"],
  "untested": ["GPU process crash", "pointer entrypoints"]
}
