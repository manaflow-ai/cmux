{
  "$comment": "Which material each kind of cmux NEXT surface may show, and the kind of every native file that builds glass. design/surface-materials.md is the rule; scripts/cmux-next/check-surface-materials.py enforces it. Leo, 2026-11-09: \"what is supposed to be native-looking, what is supposed to be not as native ... it's just a consistency, okay?\"",
  "kinds": {
    "material-source": {
      "render": "native",
      "materials": [
        "real-glass"
      ],
      "for": "the shared glass itself (Glass, GlassPanelView, OverlaySurface, the role table) and the shared native hosts built on it (tooltip, hover card, find pill, chips)"
    },
    "window-chrome": {
      "render": "native",
      "materials": [
        "real-glass",
        "clear"
      ],
      "for": "the window's material and what sits clear on it: titlebar, sidebar, tab strip, browser omnibar"
    },
    "system-menu": {
      "render": "native",
      "materials": [
        "system"
      ],
      "for": "NSMenu menus: the app menu, right-click menus a page hands to the App (rows and SF Symbols only)"
    },
    "native-overlay": {
      "render": "native",
      "materials": [
        "real-glass"
      ],
      "for": "floating native surfaces that exist today: palette, toasts' and sheets' native bodies, HUDs, drag ghosts, browser bubbles. Closed set: a new floating surface is web-floating."
    },
    "web-host": {
      "render": "native shell, web content",
      "materials": [
        "real-glass"
      ],
      "for": "the App's glass drawn under or around a web page's own content: host glass, popups past a pane's edge, toast and dialog pages, web cards, the Updated card"
    },
    "sidebar-card": {
      "render": "native",
      "materials": [
        "card-veil"
      ],
      "for": "cards in the sidebar: a veil and rim over the sidebar glass, never a second glass"
    },
    "scene-renderer": {
      "render": "native",
      "materials": [
        "real-glass",
        "card-veil"
      ],
      "for": "the Apps scene renderer, which draws the material each scene node names"
    },
    "web-floating": {
      "render": "web",
      "materials": [
        "host-glass",
        "page-glass"
      ],
      "for": "menus, pickers, popovers, hover cards, lists in a web page: host glass in a see-through Chromium agent pane (data-host-glass), the page's glass level elsewhere"
    },
    "web-content": {
      "render": "web",
      "materials": [
        "clear",
        "page-glass"
      ],
      "for": "panes and pages: chat, New Tab, Settings, markdown, diff, history. Clear on the window material; docked bars at the chrome level"
    },
    "debug": {
      "render": "native",
      "materials": [
        "real-glass"
      ],
      "for": "Debug fixtures and playgrounds, never shipped"
    }
  },
