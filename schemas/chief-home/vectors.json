      "name": "the default Chief",
      "user_home": "/Users/cmux",
      "tag": null,
      "environment": {},
      "root": "/Users/cmux/.cmux/chief/default",
      "session": "cmux-chief-b902d10e",
      "isolated": false
    },
    {
      "name": "every tag opens the default Chief",
      "user_home": "/Users/cmux",
      "tag": "nxdog80-v1",
      "environment": {},
      "root": "/Users/cmux/.cmux/chief/default",
      "session": "cmux-chief-b902d10e",
      "isolated": false
    },
    {
