  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}([0-9a-f]{2})?$",
      "description": "Lowercase #rrggbb or #rrggbbaa."
    },
    "opaqueColor": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$",
      "description": "Lowercase #rrggbb."
    },
    "fontFamily": {
      "type": "string",
      "pattern": "^[A-Za-z0-9 ,\"'_-]{1,200}$",
      "description": "A CSS font-family list. Only installed system fonts; the host never sends font CSS."
    },
    "fontWeight": {
      "type": "string",
      "pattern": "^[1-9]00$"
    },
    "px": {
      "type": "string",
      "pattern": "^[0-9]{1,4}(\\.[0-9]{1,3})?px$"
    },
    "lineHeight": {
      "type": "string",
      "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3})?(px)?$"
    },
    "shadow": {
      "type": "string",
      "pattern": "^(none|[0-9a-z#., -]{1,200})$",
      "description": "none, or a box-shadow list with hex colors."
    },
    "duration": {
      "type": "string",
      "pattern": "^[0-9]{1,4}ms$"
    },
    "density": {
      "type": "string",
      "pattern": "^[0-9](\\.[0-9]{1,3})?$"
    }
  }
