{
  "$comment": "GET /v1/cloud/keyset answers and the VM daemon's expected read (CLOUD-LINK-FOLLOWUPS 1). Only an ok:true read replaces the held keyset; keep_held:true means keep it. Body value has the same shape as the bind answer's keyset: {version: 16 hex (first 8 bytes of sha256 over the canonical public keyset), keys: {kid: {kty: OKP, crv: Ed25519, x, kid, alg: EdDSA, use: sig}}}, at most 2 kids. Refetch on an unknown kid (rate-limited on the daemon side) and once a day; a new kid is published at least 24 h before it signs. Generated by backend/packages/protocol/scripts/export-keyset-vectors.ts.",
  "version": 1,
  "cases": [
    {
      "name": "ok",
      "note": "A 200 with one or two Ed25519 kids replaces the held keyset.",
      "answers": [
        {
          "status": 200,
          "headers": {
            "content-type": "application/json",
            "cache-control": "public, max-age=300"
          },
          "body": {
            "ok": true,
            "value": {
              "version": "16f32fd56d465cc3",
              "keys": {
                "test-k1": {
                  "kty": "OKP",
                  "crv": "Ed25519",
                  "x": "tRRe5k08ymM7wh1Rh9EZkgf1p8UAskG2c_3dH0bYSGY",
                  "kid": "test-k1",
                  "alg": "EdDSA",
                  "use": "sig"
                },
                "test-k2": {
                  "kty": "OKP",
                  "crv": "Ed25519",
                  "x": "-IW5hjSjOqC3WBiaZ8uwfsemALBF4XaHTp8jxg8zcuY",
                  "kid": "test-k2",
                  "alg": "EdDSA",
                  "use": "sig"
                }
              }
            }
          },
          "expect": {
            "ok": true,
            "version": "16f32fd56d465cc3",
            "kids": [
              "test-k1",
              "test-k2"
            ]
          }
        }
      ]
    },
