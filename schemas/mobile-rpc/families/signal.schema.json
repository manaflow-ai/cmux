{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "families/signal.schema.json",
  "title": "cmux.mobile/1 signal family (control; relayed by HostDO, never stored)",
  "description": "signal.<kind> is a `signal` frame with that kind; the schema below is its body. The relay sets `from` from the authenticated install.",
  "$defs": {
    "signal.turn_credentials": { "type": "object", "additionalProperties": false, "required": ["host"], "properties": { "host": { "$ref": "../common.schema.json#/$defs/HostId" } } },
    "signal.turn_credentials:result": {
      "type": "object", "additionalProperties": false, "required": ["ice_servers", "expires_at"],
      "properties": {
        "ice_servers": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["urls"],
            "properties": { "urls": { "type": "array", "items": { "type": "string", "pattern": "^(stun|turn|turns):" } }, "username": { "type": "string" }, "credential": { "type": "string" } }
          }
        },
        "expires_at": { "$ref": "../common.schema.json#/$defs/Timestamp" }
      }
    },
    "signal.offer": {
      "type": "object", "additionalProperties": false, "required": ["sdp"],
      "properties": { "sdp": { "type": "string", "minLength": 1, "maxLength": 65536 }, "ice_restart": { "type": "boolean" }, "carrier": { "enum": ["webrtc", "webrtc-wg"] } }
    },
    "signal.answer": { "type": "object", "additionalProperties": false, "required": ["sdp"], "properties": { "sdp": { "type": "string", "minLength": 1, "maxLength": 65536 } } },
    "signal.ice": {
      "type": "object", "additionalProperties": false, "required": ["candidate", "sdp_mid", "sdp_mline_index"],
      "properties": { "candidate": { "type": "string", "maxLength": 1024 }, "sdp_mid": { "type": ["string", "null"], "maxLength": 64 }, "sdp_mline_index": { "type": ["integer", "null"], "minimum": 0 } }
    },
    "signal.ice.end": { "type": "object", "additionalProperties": false, "properties": {} },
    "signal.bye": { "type": "object", "additionalProperties": false, "required": ["reason"], "properties": { "reason": { "enum": ["closed", "failed", "superseded", "revoked"] } } }
  }
}
