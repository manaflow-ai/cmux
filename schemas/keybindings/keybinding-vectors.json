{
  "version": 1,
  "description": "Conformance vectors for cmux key binding resolution (R59). Every client (the Mac key router, the GPUI and browser clients) resolves each vector with the default table of the action catalog, every action runnable where its catalog context holds, plus the vector's own user entries and removals. keys: one stroke per array element in keybindings.json syntax (cmd, ctrl, opt, shift; tab, pagedown, right, escape, f1...). context: the live context keys (bool, string or number values). expect: {\"action\": id, \"args\": {...}} when the last key runs an entry, {\"armed\": true} when the chord waits for more keys, {\"none\": true} when a key completes nothing. {\"refused\": true}: every entry of the vector is refused when it loads (the daemon leaves it out of keybindings.json's entries, the app's loader refuses it too) and its keys run nothing. A first stroke without cmd or ctrl (a bare key: no cmd, ctrl or opt) binds only when the entry's when requires a bare-key context (diffViewerFocused, markdownReadOnlyFocused: an && term) and no text-field context (textInputFocus, textBoxFocused, omnibarFocused, terminalFocused, agentPaneFocused, codeEditorFocused, markdownEditorFocused, browserFocused); such a sequence arms only while the context owns bare keys (a bare-key context holds and textInputFocus does not). Rules: plans/cmux-next/keybindings.md section 8.",
  "vectors": [
    {
      "name": "Ctrl-Tab in an agent chat is the focused pane's next tab",
      "context": {"surfaceKind": "agent", "agentPaneFocused": true},
      "keys": ["ctrl+tab"],
      "expect": {"action": "nextSurface"}
    },
    {
      "name": "Ctrl-Shift-Tab in Settings is the focused pane's previous tab",
      "context": {"surfaceKind": "settings"},
      "keys": ["ctrl+shift+tab"],
      "expect": {"action": "prevSurface"}
    },
    {
      "name": "Ctrl-PageDown in Home has no cmux default (it reaches the page)",
      "context": {"surfaceKind": "home"},
      "keys": ["ctrl+pagedown"],
      "expect": {"none": true}
    },
    {
      "name": "Ctrl-Tab in a terminal is the focused pane's next tab too (#20116: from every focus)",
      "context": {"surfaceKind": "terminal", "terminalFocused": true},
      "keys": ["ctrl+tab"],
      "expect": {"action": "nextSurface"}
    },
    {
      "name": "Ctrl-Tab in terminal copy mode is the focused pane's next tab",
      "context": {"surfaceKind": "terminal", "terminalFocused": true, "terminal.copyMode": true},
      "keys": ["ctrl+tab"],
      "expect": {"action": "nextSurface"}
    },
    {
      "name": "Cmd-Shift-] in a web page is the focused pane's next tab",
      "context": {"surfaceKind": "page", "browserFocused": true},
      "keys": ["cmd+shift+]"],
      "expect": {"action": "nextSurface"}
    },
    {
      "name": "Cmd-R in a web page reloads",
      "context": {"surfaceKind": "page", "browserFocused": true},
      "keys": ["cmd+r"],
      "expect": {"action": "browserReload"}
    },
    {
      "name": "Cmd-R in a terminal renames the tab",
      "context": {"surfaceKind": "terminal", "terminalFocused": true},
      "keys": ["cmd+r"],
      "expect": {"action": "renameTab"}
    },
    {
      "name": "Cmd-J arms the leader",
      "context": {"surfaceKind": "terminal", "terminalFocused": true},
      "keys": ["cmd+j"],
      "expect": {"armed": true}
    },
    {
      "name": "Cmd-J then J scrolls to the selection in a terminal",
      "context": {"surfaceKind": "terminal", "terminalFocused": true},
      "keys": ["cmd+j", "j"],
      "expect": {"action": "terminal.scrollToSelection"}
    },
    {
      "name": "Cmd-J then an unbound key completes nothing",
      "context": {"surfaceKind": "terminal", "terminalFocused": true},
      "keys": ["cmd+j", "q"],
      "expect": {"none": true}
    },
    {
      "name": "A user entry wins over a more specific default on the same key",
      "context": {"surfaceKind": "page", "browserFocused": true},
      "bindings": [{"key": "cmd+r", "command": "toggleSidebar"}],
      "keys": ["cmd+r"],
      "expect": {"action": "toggleSidebar"}
    },
    {
      "name": "A three-key user chord arms twice, then runs",
      "context": {"surfaceKind": "terminal", "terminalFocused": true},
      "bindings": [{"key": "ctrl+k ctrl+x y", "command": "toggleSidebar", "when": "surfaceKind == terminal"}],
      "keys": ["ctrl+k", "ctrl+x", "y"],
      "expect": {"action": "toggleSidebar"}
    },
    {
      "name": "A user chord prefix waits for more keys",
      "context": {"surfaceKind": "terminal", "terminalFocused": true},
      "bindings": [{"key": "ctrl+k ctrl+x y", "command": "toggleSidebar"}],
      "keys": ["ctrl+k", "ctrl+x"],
      "expect": {"armed": true}
    },
    {
      "name": "A user chord whose when is false does not arm",
      "context": {"surfaceKind": "page", "browserFocused": true},
      "bindings": [{"key": "ctrl+k ctrl+x y", "command": "toggleSidebar", "when": "surfaceKind == terminal"}],
      "keys": ["ctrl+k"],
      "expect": {"none": true}
    },
    {
      "name": "A four-key user chord runs on its fourth key",
      "context": {"surfaceKind": "agent", "agentPaneFocused": true},
      "bindings": [{"key": "ctrl+k a b c", "command": "toggleSidebar"}],
      "keys": ["ctrl+k", "a", "b", "c"],
      "expect": {"action": "toggleSidebar"}
    },
    {
      "name": "A longer chord wins over a shorter one with the same keys",
      "context": {"surfaceKind": "agent", "agentPaneFocused": true},
      "bindings": [
        {"key": "ctrl+k a", "command": "toggleSidebar"},
        {"key": "ctrl+k a b", "command": "toggleRightSidebar"}
      ],
      "keys": ["ctrl+k", "a"],
      "expect": {"armed": true}
    },
    {
      "name": "Arguments travel with the entry",
      "context": {"surfaceKind": "terminal", "terminalFocused": true},
      "bindings": [{"key": "ctrl+k t", "command": "terminal.setTheme", "args": {"theme": "Builtin Dark"}}],
      "keys": ["ctrl+k", "t"],
      "expect": {"action": "terminal.setTheme", "args": {"theme": "Builtin Dark"}}
    },
    {
      "name": "A removal takes out the Ctrl-Tab default",
      "context": {"surfaceKind": "agent", "agentPaneFocused": true},
      "removals": [{"key": "ctrl+tab", "command": "nextSurface"}],
      "keys": ["ctrl+tab"],
      "expect": {"none": true}
    },
    {
      "name": "A removal with a when leaves a default without one",
      "context": {"surfaceKind": "agent", "agentPaneFocused": true},
      "removals": [{"key": "ctrl+tab", "command": "nextSurface", "when": "surfaceKind == agent"}],
      "keys": ["ctrl+tab"],
      "expect": {"action": "nextSurface"}
    },
    {
      "name": "A removal keeps the action's other keys",
      "context": {"surfaceKind": "agent", "agentPaneFocused": true},
      "removals": [{"key": "cmd+shift+]", "command": "nextSurface"}],
      "keys": ["ctrl+tab"],
      "expect": {"action": "nextSurface"}
    },
    {
      "name": "Cmd-Opt-Up in a terminal focuses the pane above",
      "context": {"surfaceKind": "terminal", "terminalFocused": true},
      "keys": ["cmd+opt+up"],
      "expect": {"action": "focusUp"}
    },
    {
      "name": "Cmd-Opt-Left in a terminal focuses the pane to the left (Ghostty goto_split, reserved)",
      "context": {"surfaceKind": "terminal", "terminalFocused": true},
      "keys": ["cmd+opt+left"],
      "expect": {"action": "focusLeft"}
    },
    {
      "name": "Cmd-Opt-Right in a web page focuses the pane to the right (Ghostty goto_split, reserved)",
      "context": {"surfaceKind": "page", "browserFocused": true},
      "keys": ["cmd+opt+right"],
      "expect": {"action": "focusRight"}
    },
    {
      "name": "A removal with the default's own when takes it out (one-clause when)",
      "context": {"surfaceKind": "terminal", "terminalFocused": true},
      "removals": [{"key": "cmd+opt+up", "command": "focusUp", "when": "!codeEditorFocused"}],
      "keys": ["cmd+opt+up"],
      "expect": {"none": true}
    },
    {
      "name": "A bare g g user entry arms on g in a read-only markdown page (K1)",
      "context": {"pageId": "cmux.markdown", "markdownFocused": true, "markdownReadOnlyFocused": true},
      "bindings": [{"key": "g g", "command": "markdownGoToTop", "when": "markdownReadOnlyFocused"}],
      "keys": ["g"],
      "expect": {"armed": true}
    },
    {
      "name": "A bare g g user entry runs on the second g in a read-only markdown page",
      "context": {"pageId": "cmux.markdown", "markdownFocused": true, "markdownReadOnlyFocused": true},
      "bindings": [{"key": "g g", "command": "markdownGoToTop", "when": "markdownReadOnlyFocused"}],
      "keys": ["g", "g"],
      "expect": {"action": "markdownGoToTop"}
    },
    {
      "name": "A bare g g entry does not arm in the markdown editor",
      "context": {"pageId": "cmux.markdown", "markdownFocused": true, "markdownEditorFocused": true},
      "bindings": [{"key": "g g", "command": "markdownGoToTop", "when": "markdownReadOnlyFocused"}],
      "keys": ["g"],
      "expect": {"none": true}
    },
    {
      "name": "A bare g g entry does not arm while a text field in the page has the keyboard",
      "context": {"pageId": "cmux.markdown", "markdownFocused": true, "markdownReadOnlyFocused": true, "textInputFocus": true},
      "bindings": [{"key": "g g", "command": "markdownGoToTop", "when": "markdownReadOnlyFocused"}],
      "keys": ["g"],
      "expect": {"none": true}
    },
    {
      "name": "A bare first key may arm under a when with other terms that requires a bare-key page",
      "context": {"pageId": "cmux.markdown", "markdownFocused": true, "markdownReadOnlyFocused": true},
      "bindings": [{"key": "g g", "command": "markdownGoToTop", "when": "pageId == cmux.markdown && markdownReadOnlyFocused"}],
      "keys": ["g", "g"],
      "expect": {"action": "markdownGoToTop"}
    },
    {
      "name": "A bare sequence runs in the diff viewer, the other bare-key page",
      "context": {"pageId": "cmux.diff", "diffViewerFocused": true},
      "bindings": [{"key": "] f", "command": "diffViewerNextFile", "when": "diffViewerFocused"}],
      "keys": ["]", "f"],
      "expect": {"action": "diffViewerNextFile"}
    },
    {
      "name": "A bare first key without a when that requires a bare-key page is refused",
      "context": {"pageId": "cmux.markdown", "markdownFocused": true, "markdownReadOnlyFocused": true},
      "bindings": [{"key": "g g", "command": "markdownGoToTop"}],
      "keys": ["g"],
      "expect": {"refused": true}
    },
    {
      "name": "A bare first key whose when also requires a text field is refused",
      "context": {"pageId": "cmux.markdown", "markdownFocused": true, "markdownReadOnlyFocused": true},
      "bindings": [{"key": "g g", "command": "markdownGoToTop", "when": "markdownReadOnlyFocused && textInputFocus"}],
      "keys": ["g"],
      "expect": {"refused": true}
    },
    {
      "name": "A bare first key whose when holds in a terminal too is refused",
      "context": {"pageId": "cmux.markdown", "markdownFocused": true, "markdownReadOnlyFocused": true},
      "bindings": [{"key": "g g", "command": "markdownGoToTop", "when": "markdownReadOnlyFocused || terminalFocused"}],
      "keys": ["g"],
      "expect": {"refused": true}
    },
    {
      "name": "A bare first key in the markdown editor is refused",
      "context": {"pageId": "cmux.markdown", "markdownFocused": true, "markdownEditorFocused": true},
      "bindings": [{"key": "g g", "command": "markdownGoToTop", "when": "markdownEditorFocused"}],
      "keys": ["g"],
      "expect": {"refused": true}
    }
  ]
}
