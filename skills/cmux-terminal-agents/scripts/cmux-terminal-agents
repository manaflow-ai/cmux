#!/usr/bin/env python3
"""cmux-terminal-agents: run Claude Code or Codex agents in cmux terminals.

The Chief (or any agent) starts each agent as the real `claude` / `codex`
TUI in its own background cmux workspace, in the "Chief agents" sidebar
group, sends it prompts, waits for its turn to end, reads its last answer
and sends follow-ups. There is no fixed limit on how many run at once.

Turn-end signals, first one that fires wins (`wait` reports which):
  hook      the cmux agent hook state of the terminal left `running`
            (Claude Code and Codex hooks: `cmux agent hook install`)
  osc7501   the agent's OSC 7501 program-status record left `working`
            (`cmux terminal <t> status`; Codex emits app=codex)
  transcript Claude Code wrote a `turn_duration` record to its transcript
  exit      the agent process exited
  screen    the screen did not change for --idle-seconds and shows no
            "esc to interrupt" spinner (last resort)

Only workspaces this tool started (recorded in its state directory) are
ever closed. Nothing here focuses a workspace or raises a window.
"""

import argparse
import base64
import glob
import json
import os
import re
import subprocess
import sys
import threading
import time

STATE_DIR = os.path.expanduser(
    os.environ.get("CMUX_TERMINAL_AGENTS_DIR", "~/.cmux/terminal-agents")
)
GROUP = os.environ.get("CMUX_TERMINAL_AGENTS_GROUP", "Chief agents")
BUSY_MARKERS = ("esc to interrupt", "esc to cancel")
# Transient daemon/app answers under load; retried with the printed idempotency key.
TRANSIENT = (
    "does not speak cmux.protocol",
    "Broken pipe",
    "did not finish within",
    "Connection reset",
    "transport error",
)


def cmux_bin():
    explicit = os.environ.get("CMUX_TERMINAL_AGENTS_CMUX") or os.environ.get("CMUX_BUNDLED_CLI_PATH")
    if explicit and os.path.exists(explicit):
        return explicit
    return "cmux"


def now_ms():
    return int(time.time() * 1000)


class CmuxError(Exception):
    pass


def cmux(*args, json_out=True, retries=6, timeout=30):
    """Runs the cmux CLI; retries transient failures, reusing the idempotency key."""
    base = [cmux_bin()] + (["--json"] if json_out else [])
    key = None
    last = ""
    for attempt in range(retries):
        cmd = base + (["--idempotency-key", key] if key else []) + list(args)
        try:
            p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        except subprocess.TimeoutExpired:
            last = "cmux timed out"
            time.sleep(min(0.5 * (attempt + 1), 3))
            continue
        if p.returncode == 0:
            out = p.stdout.strip()
            if not json_out:
                return out
            # Mutations may print a receipt before the JSON on some builds.
            for chunk in (out, out[out.find("{"):] if "{" in out else "", out[out.find("["):] if "[" in out else ""):
                try:
                    return json.loads(chunk)
                except ValueError:
                    continue
            return out
        last = (p.stderr or p.stdout).strip()
        m = re.search(r"mutation_[0-9a-f]+", last)
        if m:
            key = m.group(0)
        if not any(t in last for t in TRANSIENT):
            break
        time.sleep(min(0.5 * (attempt + 1), 3))
    raise CmuxError(f"cmux {' '.join(args)}: {last}")


# ---------------------------------------------------------------- state


def state_path(name):
    return os.path.join(STATE_DIR, "agents", f"{name}.json")


def load(name):
    try:
        with open(state_path(name)) as f:
            return json.load(f)
    except FileNotFoundError:
        raise SystemExit(f"cmux-terminal-agents: no agent {name} started by this tool")


def save(rec):
    os.makedirs(os.path.join(STATE_DIR, "agents"), exist_ok=True)
    tmp = state_path(rec["name"]) + ".tmp"
    with open(tmp, "w") as f:
        json.dump(rec, f, indent=2)
    os.replace(tmp, state_path(rec["name"]))


def all_agents():
    out = []
    for p in sorted(glob.glob(os.path.join(STATE_DIR, "agents", "*.json"))):
        with open(p) as f:
            out.append(json.load(f))
    return out


# ---------------------------------------------------------------- probes


def agent_hook_state(terminal):
    """The cmux agent record (hook-reported) of `terminal`, or None."""
    try:
        items = cmux("agent", "list", retries=2, timeout=8)
    except CmuxError:
        return None
    if isinstance(items, dict):
        items = items.get("agents", [])
    best = None
    for a in items or []:
        if isinstance(a, dict) and a.get("terminal_id") == terminal:
            if best is None or int(a.get("updated_at_ms") or 0) > int(best.get("updated_at_ms") or 0):
                best = a
    return best


def program_status(terminal):
    try:
        recs = cmux("terminal", terminal, "status", retries=2, timeout=8)
    except CmuxError:
        return None
    return recs if isinstance(recs, list) else None


def screen(terminal):
    try:
        s = cmux("terminal", terminal, "screen", "read", retries=2, timeout=8)
    except CmuxError:
        return None
    return s if isinstance(s, dict) else None


def process(terminal):
    try:
        p = cmux("terminal", terminal, "process", "show", retries=2, timeout=8)
    except CmuxError as e:
        if "exited" in str(e) or "not found" in str(e) or "no terminal" in str(e):
            return {"exited": True}
        return None
    return p if isinstance(p, dict) else None


def claude_transcript(session_id):
    if not session_id:
        return None
    hits = glob.glob(os.path.expanduser(f"~/.claude/projects/*/{session_id}.jsonl"))
    return hits[0] if hits else None


def transcript_turns(path):
    """(turn_duration count, last assistant text) of a Claude Code transcript."""
    turns, last = 0, None
    try:
        with open(path) as f:
            for line in f:
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                if d.get("type") == "system" and d.get("subtype") == "turn_duration":
                    turns += 1
                m = d.get("message") or {}
                if d.get("type") == "assistant" and m.get("role") == "assistant":
                    texts = [c.get("text", "") for c in m.get("content") or [] if isinstance(c, dict) and c.get("type") == "text"]
                    if any(t.strip() for t in texts):
                        last = "\n".join(t for t in texts if t.strip())
    except OSError:
        pass
    return turns, last


def busy_on_screen(text):
    tail = "\n".join(text.splitlines()[-12:]).lower()
    return any(m in tail for m in BUSY_MARKERS)


def screen_answer(text, harness):
    """The text after the last submitted prompt, minus the input box and status lines."""
    lines = text.splitlines()
    if harness == "claude":
        # Claude's input box sits between the last two rule lines.
        rules = [i for i, l in enumerate(lines) if l.startswith("────")]
        if len(rules) >= 2:
            lines = lines[: rules[-2]]
        mark = "❯ "
    else:
        mark = "› "
    starts = [i for i, l in enumerate(lines) if l.startswith(mark) and l.strip() != mark.strip()]
    if harness != "claude" and len(starts) >= 2:
        # Codex's composer is the last `› ` line; the answer ends there.
        lines = lines[: starts[-1]]
        starts = starts[:-1]
    body = lines[starts[-1] + 1 :] if starts else lines
    status = re.compile(r"^\s*([✻✽✶✳·*]\s.*(for \d|done)|Worked for \d)")
    keep = [l for l in body if not status.match(l)]
    return "\n".join(keep).strip()


# ---------------------------------------------------------------- group


def ensure_group():
    try:
        groups = cmux("workspace", "group", "list")
    except CmuxError:
        return None
    for g in groups or []:
        if g.get("name") == GROUP:
            return g["id"]
    try:
        g = cmux("workspace", "group", "create", "--name", GROUP, "--color", "purple")
    except CmuxError as e:
        print(f"cmux-terminal-agents: no sidebar group ({e})", file=sys.stderr)
        return None
    val = g.get("value", g) if isinstance(g, dict) else {}
    return val.get("id") or GROUP


# ---------------------------------------------------------------- verbs


# Claude goes through subrouter2 (`sr2 claude`) unless the caller names a
# launcher: CMUX_TERMINAL_AGENTS_CLAUDE="claude" (or any argv) overrides it.
def claude_launcher():
    override = os.environ.get("CMUX_TERMINAL_AGENTS_CLAUDE", "").split()
    if override:
        return override
    return ["sr2", "claude"]


def harness_argv(harness, prompt, extra):
    if harness == "claude":
        return claude_launcher() + extra + ([prompt] if prompt else [])
    if harness == "codex":
        return ["codex"] + extra + ([prompt] if prompt else [])
    raise SystemExit(f"unknown harness {harness}; use claude or codex")


def cmd_start(a):
    if os.path.exists(state_path(a.name)):
        raise SystemExit(f"agent {a.name} exists; close it or pick another name")
    cwd = os.path.abspath(os.path.expanduser(a.cwd or os.getcwd()))
    prompt = read_text(a.prompt)
    t0 = time.time()
    created = cmux(
        "workspace", "create", "--name", a.name, "--cwd", cwd,
        "--", *harness_argv(a.harness, prompt, a.extra or []),
    )
    val = created.get("value", created)
    t_created = time.time()
    rec = {
        "name": a.name,
        "harness": a.harness,
        "cwd": cwd,
        "workspace_id": val["workspace_id"],
        "terminal_id": val["terminal_id"],
        "tab_id": val.get("tab_id"),
        "created_ms": int(t0 * 1000),
        "turns": [{"sent_ms": int(t0 * 1000), "prompt": prompt}] if prompt else [],
    }
    save(rec)
    group = None if a.no_group else ensure_group()
    if group:
        try:
            cmux("workspace", "group", group, "add", "--workspace", rec["workspace_id"])
            rec["group"] = group
        except CmuxError as e:
            print(f"cmux-terminal-agents: group add failed ({e})", file=sys.stderr)
    save(rec)
    result = {"agent": rec, "create_seconds": round(t_created - t0, 3)}
    try:
        result["start"] = verify_start(rec, prompt, a.start_timeout)
    except ActionFailed as e:
        result["start"] = e.result
        result["error"] = e.result.get("error")
        fail_json(result, 3 if e.result.get("stage") == "blocked_on_prompt" else 2)
    if a.wait and prompt:
        result["wait"] = wait_turn(rec, a.timeout, a.idle_seconds)
    print(json.dumps(result, indent=2, ensure_ascii=False))


def verify_start(rec, prompt, timeout):
    """After launch, checks the TUI came up and (with a first prompt) took it."""
    if not prompt:
        text = wait_ready(rec, timeout)
        return {"verified": "composer_ready", "screen": screen_tail(text)}
    snip = snippet(prompt)[:12]
    t0 = now_ms()

    def check(text):
        if blocking_prompt(text):
            return "blocked"
        if busy_on_screen(text):
            return "working"
        region = norm(composer_region(text))
        for l in text.splitlines():
            if l.lstrip().startswith(("❯", "›")) and snip and snip in norm(l) and norm(l) not in region:
                return "prompt_in_transcript"
        if user_records(rec, prompt):
            return "transcript_user_record"
        return None

    how, text = poll_screen(rec, check, timeout, interval=0.3)
    if not how and osc_working_since(rec, t0):
        how = "osc7501_working"
    if how == "blocked":
        raise ActionFailed({"verified": None, "stage": "blocked_on_prompt",
                            "error": "the agent shows a prompt or menu before its first turn; answer it with choose/steer/key",
                            "prompt": blocking_prompt(text), "screen": screen_tail(text)})
    if not how:
        raise ActionFailed({"verified": None, "stage": "first_prompt_not_seen",
                            "error": f"no sign the first prompt was taken within {timeout:g}s",
                            "screen": screen_tail(text)})
    return {"verified": how, "screen": screen_tail(text)}


def read_text(words):
    text = " ".join(words) if words else ""
    if text == "-":
        text = sys.stdin.read()
    return text.strip()


# ---------------------------------------------------------------- verified actions
#
# Every action is followed by a screen check: a key is never assumed to have
# landed. A send pastes, reads the screen until the paste is rendered in the
# composer, then presses Enter as a separate mutation and checks the submit
# took. TUIs drop a CR that arrives while a paste is still being processed,
# and drop all input sent before they are ready.

PASTE_MARKS = re.compile(r"\[Pasted (text|Content)", re.I)
RULE = re.compile(r"^\s*[─━]{8,}")


class ActionFailed(Exception):
    def __init__(self, result):
        super().__init__(result.get("error", "action failed"))
        self.result = result


def norm(text):
    return re.sub(r"\s+", "", text or "")


def snippet(text):
    """The part of the text a composer shows first, without whitespace."""
    return norm(text)[:24]


def composer_region(text):
    """The composer: from the last prompt-marker line (❯ / ›) to the next rule.
    Without one, the last few non-empty lines."""
    lines = (text or "").rstrip("\n").splitlines()
    marks = [i for i, l in enumerate(lines) if l.lstrip().startswith(("❯", "›"))]
    if not marks:
        return "\n".join([l for l in lines if l.strip()][-6:])
    i = marks[-1]
    end = next((j for j in range(i + 1, len(lines)) if RULE.match(lines[j])), len(lines))
    return "\n".join(lines[i:end])


def in_composer(text, sent):
    region = norm(composer_region(text))
    snip = snippet(sent)
    return bool(snip) and snip in region or bool(PASTE_MARKS.search(composer_region(text)))


def screen_tail(text, n=30):
    lines = [l for l in (text or "").splitlines() if l.strip()]
    return "\n".join(lines[-n:])


def write_bytes(rec, data):
    cmux("terminal", rec["terminal_id"], "write", "--bytes-base64", base64.b64encode(data).decode())


def read_screen(rec):
    s = screen(rec["terminal_id"])
    if s is None:
        return None
    return s.get("text") or (s.get("result") or {}).get("text") or ""


def poll_screen(rec, check, timeout, interval=0.15):
    """Reads the screen until check(text) is truthy; returns (value, text)."""
    deadline = time.time() + timeout
    text = None
    while True:
        got = read_screen(rec)
        if got is not None:
            text = got
            v = check(text)
            if v:
                return v, text
        if time.time() >= deadline:
            return None, text
        time.sleep(interval)


def user_records(rec, text):
    """Claude transcript user records that contain the text (None: no transcript)."""
    path = session_transcript(rec) if rec.get("harness") == "claude" else None
    if not path:
        return None
    snip, n = snippet(text), 0
    try:
        with open(path) as f:
            for line in f:
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                if d.get("type") != "user":
                    continue
                c = (d.get("message") or {}).get("content")
                if isinstance(c, list):
                    c = " ".join(x.get("text", "") for x in c if isinstance(x, dict))
                if isinstance(c, str) and snip and snip in norm(c):
                    n += 1
    except OSError:
        return None
    return n


def osc_working_since(rec, since_ms):
    app = [r for r in program_status(rec["terminal_id"]) or [] if r.get("app") in ("claude-code", "codex")]
    return any(r.get("state") == "working" and int(r.get("updated_at_ms") or 0) >= since_ms for r in app)


def wait_ready(rec, timeout):
    """Waits until the TUI shows a composer and holds still; fails on a prompt/menu."""
    last = {"text": None, "since": time.time()}

    def ready(text):
        if text != last["text"]:
            last["text"], last["since"] = text, time.time()
        if blocking_prompt(text):
            return "blocked"
        has_composer = any(l.lstrip().startswith(("❯", "›")) for l in text.splitlines())
        return "ready" if has_composer and time.time() - last["since"] >= 0.4 else None

    state, text = poll_screen(rec, ready, timeout)
    if state == "blocked":
        raise ActionFailed({"submitted": False, "stage": "blocked_on_prompt",
                            "error": "a prompt or menu is on screen; answer it (choose/steer) first",
                            "prompt": blocking_prompt(text), "screen": screen_tail(text)})
    if state != "ready":
        raise ActionFailed({"submitted": False, "stage": "not_ready",
                            "error": f"no composer on screen within {timeout:g}s",
                            "screen": screen_tail(text)})
    return text


def submit_signal(rec, text, before, sent_ms):
    """Why we believe the Enter took, or None."""
    def check(screen_text):
        if not in_composer(screen_text, text):
            return "composer_cleared"
        if busy_on_screen(screen_text) and not before["busy"]:
            return "esc_to_interrupt"
        if before["user_records"] is not None:
            n = user_records(rec, text)
            if n is not None and n > before["user_records"]:
                return "transcript_user_record"
        return None
    return check


def verified_send(rec, text, submit=True, ready_timeout=30, render_timeout=10, submit_timeout=6):
    """Paste, see it rendered, Enter, see it submitted. Raises ActionFailed."""
    wait_ready(rec, ready_timeout)
    before_text = read_screen(rec) or ""
    before = {"busy": busy_on_screen(before_text), "user_records": user_records(rec, text)}
    paste = b"\x1b[200~" + text.encode() + b"\x1b[201~"
    if in_composer(before_text, text):
        # The same text already sits unsent in the composer (an Enter that was
        # lost earlier): press Enter for it instead of pasting it twice.
        rendered, shown, pastes = True, before_text, 0
    else:
        write_bytes(rec, paste)
        pastes = 1
        rendered, shown = poll_screen(rec, lambda t: in_composer(t, text), render_timeout)
    if not rendered and blocking_prompt(shown):
        raise ActionFailed({"submitted": False, "stage": "blocked_on_prompt", "pastes": pastes,
                            "error": "a prompt or menu came up; answer it (choose/steer/key) first",
                            "prompt": blocking_prompt(shown), "screen": screen_tail(shown)})
    if not rendered and snippet(text) not in norm(shown or ""):
        # Nothing of it anywhere on screen: the TUI dropped the input. Paste once more.
        write_bytes(rec, paste)
        pastes += 1
        rendered, shown = poll_screen(rec, lambda t: in_composer(t, text), render_timeout)
    if not rendered:
        raise ActionFailed({"submitted": False, "stage": "paste_not_rendered", "pastes": pastes,
                            "error": f"the pasted text never showed in the composer within {render_timeout:g}s",
                            "screen": screen_tail(shown)})
    if not submit:
        return {"submitted": False, "rendered": True, "verified": "composer_has_text",
                "pastes": pastes, "enter_presses": 0, "screen": screen_tail(shown)}
    sent_ms = now_ms()
    check = submit_signal(rec, text, before, sent_ms)
    for presses in (1, 2):
        write_bytes(rec, b"\r")
        how, shown = poll_screen(rec, check, submit_timeout)
        if not how and osc_working_since(rec, sent_ms) and not before["busy"]:
            how = "osc7501_working"
        if how:
            return {"submitted": True, "verified": how, "pastes": pastes,
                    "enter_presses": presses, "sent_ms": sent_ms, "screen": screen_tail(shown)}
    raise ActionFailed({"submitted": False, "stage": "enter_not_taken", "pastes": pastes, "enter_presses": 2,
                        "error": f"Enter pressed twice; the text still sits in the composer after {2 * submit_timeout:g}s",
                        "screen": screen_tail(shown)})


def fail_json(result, code=2):
    print(json.dumps(result, indent=2, ensure_ascii=False))
    raise SystemExit(code)


def cmd_send(a, text=None):
    rec = load(a.name)
    text = text if text is not None else read_text(a.text)
    if not text:
        raise SystemExit("nothing to send")
    before = turn_marks(rec)
    try:
        res = verified_send(rec, text, submit=not a.no_submit, ready_timeout=a.ready_timeout,
                            render_timeout=a.render_timeout, submit_timeout=a.submit_timeout)
    except ActionFailed as e:
        fail_json({"sent": False, "agent": rec["name"], **e.result})
    result = {"sent": res["submitted"], "agent": rec["name"], **res}
    if res["submitted"]:
        rec.setdefault("turns", []).append({"sent_ms": res["sent_ms"], "prompt": text, "before": before})
        save(rec)
        if a.wait:
            result["wait"] = wait_turn(rec, a.timeout, a.idle_seconds)
    print(json.dumps(result, indent=2, ensure_ascii=False))


def session_transcript(rec):
    """Claude Code's transcript of this agent (cached in the record), or None."""
    if rec["harness"] != "claude":
        return None
    sid = rec.get("session_id")
    if not sid:
        hook = agent_hook_state(rec["terminal_id"])
        sid = ((hook or {}).get("extra") or {}).get("agent_session_id")
    if not sid:
        # No hook: the newest transcript of the agent's directory since it started.
        slug = re.sub(r"[^A-Za-z0-9]", "-", os.path.realpath(rec["cwd"]))
        files = [f for f in glob.glob(os.path.expanduser(f"~/.claude/projects/{slug}/*.jsonl"))
                 if os.path.getmtime(f) * 1000 >= rec.get("created_ms", 0)]
        if not files:
            return None
        sid = os.path.basename(max(files, key=os.path.getmtime))[:-6]
    if sid != rec.get("session_id"):
        rec["session_id"] = sid
        save(rec)
    return claude_transcript(sid)


def turn_marks(rec):
    """Counters a later wait compares against: transcript turns."""
    path = session_transcript(rec)
    return {"transcript_turns": transcript_turns(path)[0] if path else None}


class Probes:
    """Reads the cmux-side signals (hook, OSC 7501, process, screen) in the
    background, one thread per signal: under load one cmux call takes
    seconds, and neither the local transcript check nor the other signals
    may wait behind a slow one."""

    def __init__(self, term):
        self.latest = {}
        self.stop = False
        readers = {
            "hook": lambda: agent_hook_state(term),
            "status": lambda: program_status(term),
            "proc": lambda: process(term),
            "screen": lambda: screen(term),
        }
        for key, read in readers.items():
            threading.Thread(target=self._loop, args=(key, read), daemon=True).start()

    def _loop(self, key, read):
        while not self.stop:
            value = read()
            if value is not None or key == "hook":
                self.latest = {**self.latest, key: value, "at": time.time(), "changed": key}
            time.sleep(0.25)


def wait_turn(rec, timeout, idle_seconds):
    """Blocks until the agent's current turn ends; returns how it was seen."""
    term = rec["terminal_id"]
    turn = (rec.get("turns") or [{}])[-1]
    sent = turn.get("sent_ms", 0)
    before = turn.get("before") or {}
    start = time.time()
    seen_running = False
    # Each signal ends the wait only after it saw this turn running itself:
    # Codex's hook says idle right after submit, before it says working.
    hook_running_ms, osc_working = None, False
    last_text, last_change = None, time.time()
    probes = Probes(term)
    path, seen_at = None, None
    try:
        while True:
            elapsed = time.time() - start
            if timeout and elapsed > timeout:
                return {"ended": False, "via": "timeout", "waited_seconds": round(elapsed, 2)}
            if rec["harness"] == "claude":
                path = path or session_transcript(rec)
                base = before.get("transcript_turns")
                if path and base is None:
                    base = 0  # a fresh session: its first turn ends the wait
                if path and transcript_turns(path)[0] > base:
                    return ended("transcript", start, sent)
            got = probes.latest
            if got.get("at") != seen_at:
                seen_at = got.get("at")
                hook = got.get("hook")
                if hook:
                    st = hook.get("state")
                    upd = int(hook.get("updated_at_ms") or 0)
                    if st in ("running", "working"):
                        seen_running = True
                        if upd >= sent - 1000:
                            hook_running_ms = max(hook_running_ms or 0, upd)
                    elif hook_running_ms and upd > hook_running_ms and st in ("idle", "done", "needs_input", "blocked", "waiting"):
                        return ended("hook", start, sent, state=st, signal_ms=upd)
                app = [r for r in got.get("status") or [] if r.get("app") in ("claude-code", "codex")]
                if any(r.get("state") == "working" for r in app):
                    seen_running = osc_working = True
                elif osc_working and app and all(r.get("state") in ("idle", "done", "blocked", "error") for r in app):
                    return ended("osc7501", start, sent, state=app[0].get("state"), signal_ms=max(int(r.get("updated_at_ms") or 0) for r in app))
                if (got.get("proc") or {}).get("exited"):
                    return ended("exit", start, sent)
                s = got.get("screen")
                if s is not None:
                    text = s.get("text", "")
                    if text != last_text:
                        last_text, last_change = text, time.time()
                    if busy_on_screen(text):
                        seen_running = True
                        last_change = time.time()
                    elif idle_seconds and time.time() - last_change >= idle_seconds and elapsed > idle_seconds:
                        return ended("screen", start, sent)
            time.sleep(0.1)
    finally:
        probes.stop = True


def ended(via, start, sent, **extra):
    t = time.time()
    out = {"ended": True, "via": via, "waited_seconds": round(t - start, 2),
           "since_send_seconds": round(t - sent / 1000, 2) if sent else None}
    if "signal_ms" in extra:
        out["detect_lag_seconds"] = round(t - extra.pop("signal_ms") / 1000, 2)
    out.update(extra)
    return out


def cmd_wait(a):
    print(json.dumps(wait_turn(load(a.name), a.timeout, a.idle_seconds), indent=2))


def last_answer(rec):
    if rec["harness"] == "claude":
        path = session_transcript(rec)
        if path:
            text = transcript_turns(path)[1]
            if text:
                return {"source": "transcript", "text": text}
    s = screen(rec["terminal_id"]) or {}
    return {"source": "screen", "text": screen_answer(s.get("text", ""), rec["harness"])}


def cmd_read(a):
    rec = load(a.name)
    ans = last_answer(rec)
    if a.json:
        print(json.dumps(ans, indent=2))
    else:
        print(ans["text"])


def cmd_continue(a):
    cmd_send(a, text=a.message or "continue")


PROMPT_MARKS = ("Do you want to proceed", "Do you want to make this edit", "Do you want to create",
                "❯ 1. Yes", "Esc to cancel", "(y/n)", "[Y/n]", "Allow command?", "Press Enter to continue",
                "Trust this folder", "I trust this folder", "Hooks need review", "enter confirm · esc",
                "enter continue · esc")


def target(name_or_term):
    """An agent record from this tool, or a bare term_… id (any terminal)."""
    if name_or_term.startswith("term_"):
        return {"name": name_or_term, "terminal_id": name_or_term}
    return load(name_or_term)


def screen_text(terminal):
    s = screen(terminal) or {}
    return s.get("text") or (s.get("result") or {}).get("text") or ""


def prompt_on_screen(text):
    tail = "\n".join([l for l in text.splitlines() if l.strip()][-25:])
    return tail if any(m in tail for m in PROMPT_MARKS) else None


# A selected numbered option ("› 1. Trust and continue", "❯ 2. No"): a menu.
MENU_ROW = re.compile(r"^\s*[›❯]\s*\d+\.\s", re.M)


def selected_row(text):
    """The number of the selected option of a numbered menu on screen, or None."""
    rows = MENU_ROW.findall("\n".join([l for l in (text or "").splitlines() if l.strip()][-12:]))
    if not rows:
        return None
    m = re.search(r"\d+", rows[-1])
    return int(m.group(0)) if m else None


def blocking_prompt(text):
    """A prompt/menu in the bottom lines of the screen (where a live one sits)."""
    tail = "\n".join([l for l in (text or "").splitlines() if l.strip()][-12:])
    return tail if any(m in tail for m in PROMPT_MARKS) or MENU_ROW.search(tail) else None


def cmd_prompts(a):
    """Agents (this tool's, plus --terminal ids) blocked on a prompt/menu."""
    recs = all_agents() + [{"name": t, "terminal_id": t} for t in (a.terminal or [])]
    out = []
    for rec in recs:
        p = prompt_on_screen(screen_text(rec["terminal_id"]))
        if p:
            out.append({"name": rec["name"], "terminal_id": rec["terminal_id"], "prompt": p})
    print(json.dumps(out, indent=2, ensure_ascii=False))


def verified_esc(rec, presses, timeout):
    """Presses Esc and checks what it did: a prompt went away, a turn stopped,
    or (nothing to dismiss) the screen after it."""
    before = read_screen(rec) or ""
    had_prompt, was_busy = blocking_prompt(before), busy_on_screen(before)
    for _ in range(max(1, presses)):
        write_bytes(rec, b"\x1b")
        time.sleep(0.4)

    def check(text):
        if had_prompt and not blocking_prompt(text):
            return "prompt_gone"
        if not had_prompt and was_busy and not busy_on_screen(text):
            return "turn_interrupted"
        return None

    how, text = poll_screen(rec, check, timeout if (had_prompt or was_busy) else 0)
    if how:
        return {"verified": how, "esc_presses": presses, "screen": screen_tail(text)}
    if had_prompt:
        raise ActionFailed({"verified": None, "stage": "prompt_still_on_screen", "esc_presses": presses,
                            "error": f"Esc pressed; the prompt is still on screen after {timeout:g}s",
                            "screen": screen_tail(text)})
    if was_busy:
        return {"verified": "still_busy", "esc_presses": presses, "screen": screen_tail(text),
                "note": "the turn is still running; --esc 2 interrupts it"}
    return {"verified": "nothing_to_dismiss", "esc_presses": presses, "screen": screen_tail(text)}


def cmd_steer(a):
    """Esc (dismiss prompt/menu or interrupt the turn), then a verified send."""
    rec = target(a.name)
    text = read_text(a.text)
    result = {"agent": rec["name"]}
    try:
        result["esc"] = verified_esc(rec, a.esc, a.esc_timeout)
        result["escaped"] = True
        if text:
            before = turn_marks(rec) if "turns" in rec else None
            result["send"] = verified_send(rec, text, ready_timeout=a.ready_timeout,
                                           render_timeout=a.render_timeout, submit_timeout=a.submit_timeout)
            result["sent"] = text
            if "turns" in rec:
                rec["turns"].append({"sent_ms": result["send"]["sent_ms"], "prompt": text, "before": before})
                save(rec)
    except ActionFailed as e:
        key = "send" if "esc" in result else "esc"
        result[key] = e.result
        result["error"] = e.result.get("error")
        fail_json(result)
    print(json.dumps(result, indent=2, ensure_ascii=False))


def cmd_choose(a):
    """Pick a numbered option on a visible menu (types the digit, no Esc), then
    check the menu went away."""
    rec = target(a.name)
    before = read_screen(rec) or ""
    menu = blocking_prompt(before)
    if not menu:
        fail_json({"chose": None, "agent": rec["name"], "stage": "no_menu",
                   "error": "no prompt or menu on screen; nothing to choose",
                   "screen": screen_tail(before)})
    write_bytes(rec, str(a.option).encode())

    def check(text):
        if not blocking_prompt(text):
            return "prompt_gone"
        if blocking_prompt(text) != menu:
            return "menu_changed"
        return None

    how, text = poll_screen(rec, check, a.timeout)
    method = "digit"
    if not how and selected_row(text):
        # Some menus ignore digits (Codex): move the selection with arrows, checking
        # each step on screen, then Enter.
        method = "arrows"
        for _ in range(12):
            cur = selected_row(text)
            if cur is None or cur == a.option:
                break
            write_bytes(rec, b"\x1b[B" if cur < a.option else b"\x1b[A")
            moved, text = poll_screen(rec, lambda t, c=cur: selected_row(t) != c, a.timeout)
            if not moved:
                break
        if selected_row(text) == a.option:
            write_bytes(rec, b"\r")
            how, text = poll_screen(rec, check, a.timeout)
    out = {"chose": a.option, "agent": rec["name"], "verified": how, "method": method, "screen": screen_tail(text)}
    if not how:
        out.update(stage="menu_unchanged", error=f"tried option {a.option} ({method}); the same menu is still on screen after {a.timeout:g}s")
        fail_json(out)
    print(json.dumps(out, indent=2, ensure_ascii=False))


KEY_BYTES = {
    "enter": b"\r", "escape": b"\x1b", "esc": b"\x1b", "tab": b"\t", "backtab": b"\x1b[Z",
    "up": b"\x1b[A", "down": b"\x1b[B", "right": b"\x1b[C", "left": b"\x1b[D",
    "backspace": b"\x7f", "space": b" ", "ctrl-c": b"\x03", "ctrl-d": b"\x04", "ctrl-l": b"\x0c",
    "shift-tab": b"\x1b[Z",
}


def cmd_key(a):
    """Presses a named key (or a digit/letter) and returns the screen after it,
    with whether it changed (--expect REGEX: fail unless it shows)."""
    rec = target(a.name)
    data = KEY_BYTES.get(a.key.lower()) or (a.key.encode() if len(a.key) == 1 else None)
    if data is None:
        raise SystemExit(f"unknown key {a.key}; use one of {', '.join(KEY_BYTES)} or one character")
    before = read_screen(rec) or ""
    for i in range(max(1, a.repeat)):
        write_bytes(rec, data)
        if i + 1 < a.repeat:
            time.sleep(a.delay)
    want = re.compile(a.expect, re.M | re.I) if a.expect else None

    def check(text):
        if want:
            return "expect_matched" if want.search(text) else None
        return "screen_changed" if text != before else None

    how, text = poll_screen(rec, check, a.timeout)
    out = {"key": a.key, "repeat": a.repeat, "agent": rec["name"],
           "verified": how or ("no_visible_change" if not want else None), "screen": screen_tail(text)}
    if want and not how:
        out.update(stage="expect_not_seen", error=f"{a.expect!r} did not show within {a.timeout:g}s")
        fail_json(out)
    print(json.dumps(out, indent=2, ensure_ascii=False))


def cmd_list(a):
    out = []
    for rec in all_agents():
        hook = agent_hook_state(rec["terminal_id"]) if not a.fast else None
        out.append({
            "name": rec["name"],
            "harness": rec["harness"],
            "workspace_id": rec["workspace_id"],
            "terminal_id": rec["terminal_id"],
            "turns": len(rec.get("turns") or []),
            "state": (hook or {}).get("state"),
        })
    print(json.dumps(out, indent=2))


def cmd_close(a):
    names = [r["name"] for r in all_agents()] if a.all else a.names
    for name in names:
        rec = load(name)
        try:
            cmux("workspace", rec["workspace_id"], "close")
        except CmuxError as e:
            if "not found" not in str(e) and "no workspace" not in str(e):
                print(f"{name}: {e}", file=sys.stderr)
                continue
        os.remove(state_path(name))
        print(json.dumps({"closed": name, "workspace_id": rec["workspace_id"]}))


def main():
    p = argparse.ArgumentParser(prog="cmux-terminal-agents", description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="verb", required=True)

    def waits(sp):
        sp.add_argument("--wait", action="store_true", help="wait for the turn to end")
        sp.add_argument("--timeout", type=float, default=1800, help="seconds; 0 waits forever")
        sp.add_argument("--idle-seconds", type=float, default=20, help="screen-unchanged fallback; 0 turns it off")

    def checks(sp):
        sp.add_argument("--ready-timeout", type=float, default=30, help="seconds to wait for a composer before pasting")
        sp.add_argument("--render-timeout", type=float, default=10, help="seconds to wait for the paste to show")
        sp.add_argument("--submit-timeout", type=float, default=6, help="seconds per Enter to see the submit take")

    s = sub.add_parser("start", help="start an agent in a new background workspace")
    s.add_argument("--start-timeout", type=float, default=60, help="seconds to see the TUI up / the first prompt taken")
    s.add_argument("name")
    s.add_argument("--harness", default="claude", choices=["claude", "codex"])
    s.add_argument("--cwd")
    s.add_argument("--no-group", action="store_true")
    s.add_argument("--extra", action="append", help="one more harness argument (repeat)")
    s.add_argument("prompt", nargs="*", help="first prompt ('-' reads stdin)")
    waits(s)
    s.set_defaults(fn=cmd_start)

    s = sub.add_parser("send", help="paste a prompt, see it in the composer, Enter, see it submitted")
    s.add_argument("name")
    s.add_argument("text", nargs="*", help="'-' reads stdin")
    s.add_argument("--no-submit", action="store_true", help="paste and verify it shows; no Enter")
    waits(s)
    checks(s)
    s.set_defaults(fn=cmd_send)

    s = sub.add_parser("wait", help="wait until the current turn ends")
    s.add_argument("name")
    s.add_argument("--timeout", type=float, default=1800)
    s.add_argument("--idle-seconds", type=float, default=20)
    s.set_defaults(fn=cmd_wait)

    s = sub.add_parser("read", help="print the last answer")
    s.add_argument("name")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_read)

    s = sub.add_parser("continue", help="send 'continue' (or --message)")
    s.add_argument("name")
    s.add_argument("--message")
    waits(s)
    checks(s)
    s.set_defaults(fn=cmd_continue, no_submit=False)

    s = sub.add_parser("list", help="agents this tool started")
    s.add_argument("--fast", action="store_true", help="skip live state")
    s.set_defaults(fn=cmd_list)

    s = sub.add_parser("prompts", help="list agents blocked on a permission prompt/menu")
    s.add_argument("--terminal", action="append", help="also check this term_… id (repeat)")
    s.set_defaults(fn=cmd_prompts)

    s = sub.add_parser("steer", help="press Esc, then send instructions + Enter (name or term_… id)")
    s.add_argument("name")
    s.add_argument("text", nargs="*", help="'-' reads stdin; empty = Esc only")
    s.add_argument("--esc", type=int, default=1, help="Esc presses (2 also interrupts a running turn)")
    s.add_argument("--esc-timeout", type=float, default=5, help="seconds to see the Esc take")
    checks(s)
    s.set_defaults(fn=cmd_steer)

    s = sub.add_parser("choose", help="pick option N on a visible menu, then check it went (name or term_… id)")
    s.add_argument("name")
    s.add_argument("option", type=int)
    s.add_argument("--timeout", type=float, default=5, help="seconds to see the menu go")
    s.set_defaults(fn=cmd_choose)

    s = sub.add_parser("key", help="press a key and return the screen after it (name or term_… id)")
    s.add_argument("name")
    s.add_argument("key", help="enter, escape, tab, backtab, up, down, left, right, backspace, space, ctrl-c, ctrl-d, ctrl-l, or one character")
    s.add_argument("--repeat", type=int, default=1)
    s.add_argument("--delay", type=float, default=0.15, help="seconds between repeats (TUIs drop unpaced bursts)")
    s.add_argument("--expect", help="regex the screen must show after the key (else exit 2)")
    s.add_argument("--timeout", type=float, default=3, help="seconds to see the change / --expect")
    s.set_defaults(fn=cmd_key)

    s = sub.add_parser("close", help="close agents this tool started (never others)")
    s.add_argument("names", nargs="*")
    s.add_argument("--all", action="store_true")
    s.set_defaults(fn=cmd_close)

    a = p.parse_args()
    try:
        a.fn(a)
    except CmuxError as e:
        raise SystemExit(f"cmux-terminal-agents: {e}")


if __name__ == "__main__":
    main()
