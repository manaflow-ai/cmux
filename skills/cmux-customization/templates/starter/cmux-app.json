{
  "$schema": "https://cmux.dev/schemas/cmux-app/2.json",
  "manifestVersion": 2,
  "id": "local/customize",
  "name": "My views",
  "version": "1.0.0",
  "description": "A starting point: one sidebar section built from the kit.",
  "engines": { "cmux": "^2.0" },
  "runtime": { "main": "main.js" },
  "implements": {
    "cmux.section/1": {
      "export": "renderSection",
      "title": "My section",
      "symbol": "sparkles",
      "options": { "defaultRegion": "bottom" }
    }
  }
}
