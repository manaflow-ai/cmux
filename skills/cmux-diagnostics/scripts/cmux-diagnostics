#!/usr/bin/env bash
set -euo pipefail

include_context=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --include-context)
      include_context=1
      shift
      ;;
    -h|--help)
      cat <<'EOF'
Usage: cmux-diagnostics [--include-context]

Print a read-only, support-safe cmux diagnostics report. By default this avoids
workspace names, cwd paths, hook contents, session JSON, and secrets.
EOF
      exit 0
      ;;
    *)
      printf 'cmux-diagnostics: unknown option: %s\n' "$1" >&2
      exit 1
      ;;
  esac
done

section() {
  printf '\n== %s ==\n' "$1"
}

safe_path() {
  local path="$1"
  if [[ "$path" == "$HOME" ]]; then
    printf '~'
  elif [[ "$path" == "$HOME"/* ]]; then
    printf '~/%s' "${path#"$HOME"/}"
  else
    printf '%s' "$path"
  fi
}

run_status() {
  local label="$1"
  shift
  printf '%s: ' "$label"
  if "$@" >/dev/null 2>&1; then
    printf 'ok\n'
  else
    printf 'failed\n'
  fi
}

file_summary() {
  local path="$1"
  if [[ -f "$path" ]]; then
    local bytes modified
    bytes="$(wc -c <"$path" 2>/dev/null | tr -d ' ' || true)"
    modified="$(stat -f '%Sm' -t '%Y-%m-%d %H:%M:%S %z' "$path" 2>/dev/null || stat -c '%y' "$path" 2>/dev/null || printf 'unknown')"
    printf 'present bytes=%s modified=%s\n' "${bytes:-unknown}" "$modified"
  elif [[ -e "$path" ]]; then
    printf 'non-regular\n'
  else
    printf 'missing\n'
  fi
}

section "cmux diagnostics"
printf 'date: %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
printf 'shell: %s\n' "${SHELL:-unknown}"
printf 'inside_cmux: '
if [[ -n "${CMUX_TUI_TERMINAL_ID:-}" ]]; then
  printf 'yes\n'
else
  printf 'no\n'
fi
printf 'cmux_tui_terminal_id_set: %s\n' "$([[ -n "${CMUX_TUI_TERMINAL_ID:-}" ]] && printf yes || printf no)"
if [[ -n "${CMUX_TUI_SOCKET:-}" ]]; then
  printf 'cmux_tui_socket: %s (from CMUX_TUI_SOCKET)\n' "$(safe_path "$CMUX_TUI_SOCKET")"
else
  printf 'cmux_tui_socket: unset\n'
fi
if [[ -n "${CMUX_SOCKET_PATH:-}" ]]; then
  printf 'cmux_app_socket: %s (from CMUX_SOCKET_PATH)\n' "$(safe_path "$CMUX_SOCKET_PATH")"
else
  printf 'cmux_app_socket: unset\n'
fi
printf 'cmux_tag: %s\n' "${CMUX_TAG:-unset}"

section "cli"
if command -v cmux >/dev/null 2>&1; then
  printf 'cmux_path: %s\n' "$(safe_path "$(command -v cmux)")"
  if cmux --version >/dev/null 2>&1; then
    printf 'cmux_version: %s\n' "$(cmux --version 2>/dev/null | head -n 1)"
  else
    printf 'cmux_version: unavailable\n'
  fi
  run_status "cmux_app_ping" cmux app ping
  run_status "cmux_app_capabilities" cmux app capabilities
  run_status "cmux_daemon_session_list" cmux session list
  if [[ "$include_context" -eq 1 ]]; then
    printf 'app_identify_json:\n'
    cmux --json app identify 2>/dev/null || printf '  unavailable\n'
    if [[ -n "${CMUX_TUI_TERMINAL_ID:-}" ]]; then
      printf 'caller_terminal_json:\n'
      cmux --json terminal "$CMUX_TUI_TERMINAL_ID" show 2>/dev/null || printf '  unavailable\n'
    fi
  fi
else
  printf 'cmux_path: missing\n'
fi

section "settings"
printf 'cmux_json: '
file_summary "$HOME/.config/cmux/cmux.json"
printf 'legacy_settings_json: '
file_summary "$HOME/.config/cmux/settings.json"
if command -v cmux >/dev/null 2>&1; then
  printf 'auto_resume_agent_sessions: '
  cmux settings get terminal.autoResumeAgentSessions 2>/dev/null || printf 'unavailable\n'
fi

section "agent hooks"
if command -v cmux >/dev/null 2>&1; then
  # Read-only: reports installed, partial or absent per provider.
  cmux agent hook status 2>&1 | sed "s#$HOME#~#g" || printf 'agent_hook_status: failed\n'
else
  printf 'agent_hook_status: cmux missing\n'
fi

section "agent binaries"
for bin in claude codex opencode pi amp cursor-agent gemini grok hermes omp campfire kiro-cli agy acli copilot codebuddy droid qodercli kimi; do
  if command -v "$bin" >/dev/null 2>&1; then
    printf '%s: present (%s)\n' "$bin" "$(safe_path "$(command -v "$bin")")"
  else
    printf '%s: missing\n' "$bin"
  fi
done
