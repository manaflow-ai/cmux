# The stability lab's Rust build profile (p10-stability-033). Only the lab's
# Rust lanes source this; CI, dev, nightly and release builds never do, so
# they build without tokio's unstable API and without the poll watch.
#
# Use from cmux-tui/:
#   set -a; . lab/stability.env; set +a
#   cargo nextest run -p acpmux -p cmux-tui -p cmux-blocking \
#     --features "$CMUX_STABILITY_FEATURES"
#
# Watched runtimes: the acpmux daemon's (slow polls and a summary at exit in
# $ACPMUX_HOME/hangs.jsonl) and the cmux-tui owner's remote daemon worker
# (owner-hangs-<session>.jsonl). runtime::multi_thread/current_thread in
# cmux-blocking watch themselves.
#
# tokio's task poll hooks (crates/cmux-blocking/src/poll_watch.rs) exist only
# with this cfg. RUSTFLAGS replaces any rustflags from Cargo config; cmux-tui
# has none.
RUSTFLAGS="--cfg tokio_unstable"
RUSTDOCFLAGS="--cfg tokio_unstable"
# Each consumer crate forwards its own cmux-stability feature to cmux-blocking.
CMUX_STABILITY_FEATURES=acpmux/cmux-stability,cmux-tui/cmux-stability,cmux-blocking/cmux-stability
# A blocking wrapper on a current_thread runtime panics instead of only
# being recorded (cmux-blocking).
CMUX_BLOCKING_STRICT=1
# Other RUSTFLAGS rebuild every artifact: keep the lab's apart from the
# normal target directory.
CARGO_TARGET_DIR=target/lab-stability
