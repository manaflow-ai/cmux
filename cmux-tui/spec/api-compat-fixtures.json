    {
      "id": "untouched-values-copied-byte-for-byte",
      "title": "Spacing, number forms, raw UTF-8 and escapes outside the rule path survive as written",
      "translation": {
        "schema": {
          "protocol": "test",
          "base": 1,
          "revisions": [
            {
              "rev": 2,
              "changes": [
                {
                  "message": "event:workspace",
                  "op": "rename",
                  "path": "/a/name",
                  "to": "title"
                }
              ]
            }
          ]
        },
        "message": "event:workspace",
        "from": 1,
        "to": 2,
        "input": "{ \"big\" : [1.0e10, -0.0, \"é\\u00e9\\n\"] , \"a\" : {\"name\" : 1 , \"x\" : { \"y\" : 2 }}}\n"
      },
      "expect": {
        "bytes": "{\"big\":[1.0e10, -0.0, \"é\\u00e9\\n\"],\"a\":{\"title\":1,\"x\":{ \"y\" : 2 }}}\n"
      }
    },
    {
      "id": "escaped-key-matches-its-rule",
      "title": "An escaped key (a\\/b) matches the rule path /a~1b",
      "translation": {
        "schema": {
          "protocol": "test",
          "base": 1,
          "revisions": [
            {
              "rev": 2,
              "changes": [
                {
                  "message": "event:workspace",
                  "op": "rename",
                  "path": "/a~1b",
                  "to": "c"
                }
              ]
            }
          ]
        },
        "message": "event:workspace",
        "from": 1,
        "to": 2,
        "input": "{\"a\\/b\":1}"
      },
      "expect": {
        "bytes": "{\"c\":1}"
      }
    },
    {
      "id": "empty-revision-copies-the-input",
