    },
    {
      "id": "malformed-input-on-a-rule-path-is-refused",
      "title": "Truncated JSON on a rule path is a malformed refusal",
      "translation": {
        "schema": {
          "protocol": "test",
          "base": 1,
          "revisions": [
            {
              "rev": 2,
              "changes": [
                {
                  "message": "event:workspace",
