                  "screen.create",
                  "screen.focus",
                  "screen.layout.undo",
                  "screen.move",
                  "screen.rename",
                  "screen.update",
                  "screen_group.add_screens",
                  "screen_group.create",
                  "screen_group.remove_screens",
                  "screen_group.ungroup",
                  "screen_group.update",
