{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmux.dev/schemas/resource-api-v2.json",
  "title": "cmux.protocol/2 envelope",
  "description": "This endpoint describes exactly one local mux session. Cross-machine aggregation requires a later broker protocol.",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/response"},
    {"$ref": "#/$defs/streamItem"},
    {"$ref": "#/$defs/streamEnd"}
  ],
  "$defs": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "idempotencyKey": {
      "type": "string",
      "description": "Contains 1 to 128 UTF-8 bytes, at least one Unicode scalar outside the White_Space property, and no Unicode General_Category=Cc control scalar. Leading, trailing, and internal non-control whitespace is preserved.",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?=[\\s\\S]*[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])[^\\u0000-\\u001F\\u007F-\\u009F]+$",
      "x-cmux-max-utf8-bytes": 128
    },
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 20
    },
    "resourceId": {
      "type": "string",
      "pattern": "^(machine|session|ws|screen|pane|tab|term|browser|client|split|notification|agent|projection|pairing|sidebar_view|sidebar_plugin)_[0-9a-f]{32}$"
    },
    "streamId": {
      "type": "string",
      "pattern": "^stream_[0-9a-f]{32}$"
    },
