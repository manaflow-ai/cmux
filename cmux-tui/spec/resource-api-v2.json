        "protocol": {"const": "cmux.protocol/2"},
        "type": {"const": "request"},
        "id": {"$ref": "#/$defs/requestId"},
        "operation": {"$ref": "#/$defs/operation"},
        "params": {"type": "object"},
        "idempotency_key": {"$ref": "#/$defs/idempotencyKey"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "agent.message.mark",
                  "agent.message.receiving.set",
                  "agent.message.send",
                  "agent.report",
                  "browser.activate",
                  "browser.back",
                  "browser.close",
                  "browser.forward",
                  "browser.input.key",
                  "browser.input.mouse",
                  "browser.input.text",
                  "browser.input.wheel",
                  "browser.navigate",
                  "browser.reload",
                  "closed.reopen",
                  "frontend_projection.put",
                  "notification.ack",
                  "notification.clear",
                  "notification.create",
                  "pairing_request.resolve",
                  "pane.close",
                  "pane.create",
                  "pane.focus",
                  "pane.focus_direction",
                  "pane.rename",
                  "pane.run",
                  "pane.split",
                  "pane.split_ratio.set",
                  "pane.swap",
