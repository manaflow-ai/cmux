    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "type", "id", "ok"],
      "properties": {
        "protocol": {"const": "cmux.protocol/2"},
        "type": {"const": "response"},
        "id": {"$ref": "#/$defs/requestId"},
        "ok": {"type": "boolean"},
        "result": {},
        "error": {"$ref": "#/$defs/error"}
      },
      "oneOf": [
        {
          "properties": {"ok": {"const": true}},
          "required": ["result"],
          "not": {"required": ["error"]}
        },
        {
          "properties": {"ok": {"const": false}},
          "required": ["error"],
          "not": {"required": ["result"]}
        }
