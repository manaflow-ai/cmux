    { "name": "accent", "title": "Accent share at the rim", "default": 0.18, "min": 0, "max": 1 },
    { "name": "stretch", "title": "Velocity stretch", "default": 1.0, "min": 0, "max": 2 },
    { "name": "size", "title": "Particle size", "default": 1.0, "min": 0.3, "max": 2.5 }
