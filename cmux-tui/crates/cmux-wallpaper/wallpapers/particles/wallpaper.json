{
  "id": "particles",
  "name": "Particles",
  "description": "A dithered dust field that drifts slowly and parts around the pointer, closing behind it.",
  "shader": "wallpaper.wgsl",
  "fps": 30,
  "scale": 0.5,
  "interactive": true,
  "params": [
    { "name": "cell", "title": "Particle spacing (pt)", "default": 12, "min": 6, "max": 40 },
