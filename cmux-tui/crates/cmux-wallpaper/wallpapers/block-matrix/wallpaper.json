    { "name": "Storage Bright", "accent": "#3D7BFF", "params": { "pitch": 5, "block": 4, "radius": 12, "glow": 1.0, "base": 0.1, "ambient": 0.52, "tint": 0.0, "activity": 0.7 } },
    { "name": "Ion", "accent": "#3D7BFF", "params": { "pitch": 5, "block": 4, "radius": 11, "glow": 1.0, "base": 0.08, "ambient": 0.39, "tint": 1.0, "activity": 0.5 } },
    { "name": "Phosphor", "accent": "#35D07F", "params": { "pitch": 4, "block": 3, "radius": 10, "glow": 1.0, "base": 0.09, "ambient": 0.39, "tint": 0.95, "activity": 0.5 } },
