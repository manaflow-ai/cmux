{
  "id": "block-matrix",
  "name": "Block Matrix",
  "description": "A fine dot matrix where rectangular blocks of dots light up, hold and fade at their own levels, drifting a dot at a time. Blocks near the pointer glow brighter, and the agents' output lights blocks as it arrives.",
  "shader": "wallpaper.wgsl",
  "fps": 30,
  "scale": 0.75,
  "interactive": true,
  "agents": true,
  "params": [
    { "name": "pitch", "title": "Dot pitch (points)", "default": 6, "min": 3, "max": 16 },
    { "name": "density", "title": "Block density", "default": 0.22, "min": 0, "max": 0.8 },
    { "name": "speed", "title": "Speed", "default": 1.0, "min": 0, "max": 3 },
    { "name": "glow", "title": "Pointer glow", "default": 1.0, "min": 0, "max": 2 },
    { "name": "radius", "title": "Glow radius (dots)", "default": 9, "min": 2, "max": 30 },
    { "name": "base", "title": "Matrix level", "default": 0.06, "min": 0, "max": 0.3 },
    { "name": "activity", "title": "Agent response", "default": 1.0, "min": 0, "max": 2 },
    { "name": "block", "title": "Block size (dots)", "default": 6, "min": 2, "max": 16 }
  ],
  "still": { "time": 21.0, "pointer": [0.7, 0.45] },
  "variants": [
    { "name": "Storage", "accent": "#3D7BFF", "params": { "pitch": 6, "density": 0.22, "speed": 1.0, "glow": 1.0, "radius": 9, "base": 0.06, "activity": 1.0, "block": 6 } },
    { "name": "Phosphor", "accent": "#35D07F", "params": { "pitch": 5, "density": 0.3, "speed": 1.4, "glow": 1.2, "radius": 7, "base": 0.09, "activity": 1.3, "block": 4 } },
    { "name": "Ember", "accent": "#FF7A45", "params": { "pitch": 8, "density": 0.16, "speed": 0.7, "glow": 0.9, "radius": 12, "base": 0.05, "activity": 0.8, "block": 9 } }
  ]
}
