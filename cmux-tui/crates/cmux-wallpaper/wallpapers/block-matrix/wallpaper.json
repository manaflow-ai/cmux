{
  "id": "block-matrix",
  "name": "Block Matrix",
  "description": "A fine, even matrix of faint dots. Blocks of dots ease in and out like a store filling and draining, a soft glow follows the pointer, and the agents' output lights a block now and then.",
  "shader": "wallpaper.wgsl",
  "fps": 30,
  "scale": 0.75,
  "interactive": true,
  "agents": true,
  "params": [
    { "name": "pitch", "title": "Dot pitch (points)", "default": 5, "min": 3, "max": 16 },
    { "name": "block", "title": "Block size (dots)", "default": 4, "min": 1, "max": 12 },
    { "name": "radius", "title": "Glow radius (dots)", "default": 11, "min": 3, "max": 40 },
    { "name": "glow", "title": "Pointer glow", "default": 1.0, "min": 0, "max": 1.5 },
    { "name": "base", "title": "Matrix level", "default": 0.08, "min": 0, "max": 0.4 },
    { "name": "ambient", "title": "Background blocks", "default": 0.39, "min": 0, "max": 1 },
    { "name": "tint", "title": "Accent tint", "default": 0.0, "min": 0, "max": 1 },
    { "name": "activity", "title": "Agent response", "default": 0.5, "min": 0, "max": 1.5 }
  ],
