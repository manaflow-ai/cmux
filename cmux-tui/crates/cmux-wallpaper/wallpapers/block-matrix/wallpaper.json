{
  "id": "block-matrix",
  "name": "Block Matrix",
  "description": "A fine, even matrix of faint dots lit by a soft glow that follows the pointer, a few slow drifting lights and the agents' output, arriving in blocks that ease between levels.",
  "shader": "wallpaper.wgsl",
  "fps": 30,
  "scale": 0.75,
  "interactive": true,
  "agents": true,
  "params": [
    { "name": "pitch", "title": "Dot pitch (points)", "default": 5, "min": 3, "max": 16 },
    { "name": "block", "title": "Block size (dots)", "default": 4, "min": 1, "max": 12 },
    { "name": "radius", "title": "Glow radius (dots)", "default": 10, "min": 3, "max": 40 },
    { "name": "glow", "title": "Pointer glow", "default": 1.0, "min": 0, "max": 1.5 },
    { "name": "base", "title": "Matrix level", "default": 0.15, "min": 0, "max": 0.5 },
    { "name": "ambient", "title": "Drifting light", "default": 0.22, "min": 0, "max": 1 },
    { "name": "tint", "title": "Accent tint", "default": 0.0, "min": 0, "max": 1 },
    { "name": "activity", "title": "Agent response", "default": 0.8, "min": 0, "max": 1.5 }
  ],
  "still": { "time": 21.0, "pointer": [0.3, 0.55] },
  "variants": [
    { "name": "Storage", "accent": "#3D7BFF", "params": { "pitch": 5, "block": 4, "radius": 10, "glow": 1.0, "base": 0.15, "ambient": 0.22, "tint": 0.0, "activity": 0.8 } },
    { "name": "Ion", "accent": "#3D7BFF", "params": { "pitch": 5, "block": 4, "radius": 12, "glow": 1.0, "base": 0.14, "ambient": 0.26, "tint": 1.0, "activity": 0.9 } },
    { "name": "Phosphor", "accent": "#35D07F", "params": { "pitch": 4, "block": 3, "radius": 10, "glow": 1.0, "base": 0.16, "ambient": 0.22, "tint": 0.95, "activity": 1.0 } },
    { "name": "Ember", "accent": "#FF7A45", "params": { "pitch": 6, "block": 2, "radius": 8, "glow": 0.95, "base": 0.14, "ambient": 0.24, "tint": 0.9, "activity": 0.7 } }
  ]
}
