    },
    {
      "name": "Fine",
      "accent": "#6E8BFF",
      "params": { "period": 4.2, "duty": 0.45, "contrast": 0.06, "amplitude": 30, "wavelength": 420, "speed": 0.7, "chroma": 0.15, "bow": 0.35 }
