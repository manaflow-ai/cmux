    },
    {
      "name": "Coarse riso",
      "accent": "#FF4F8B",
      "params": { "cell": 22, "angle": 15, "tone": 0.26, "speed": 0.7, "wake": 1.1, "radius": 3.5, "misregister": 4.0, "grain": 0.1 }
    },
    {
      "name": "Fine mist",
      "accent": "#F2A33A",
      "params": { "cell": 8, "angle": 75, "tone": 0.15, "speed": 1.4, "wake": 1.2, "radius": 7, "misregister": 1.6, "grain": 0.04 }
    }
  ]
}
