{
  "id": "halftone",
  "name": "Halftone",
  "description": "A rotated dot screen whose dots follow slow waves of tone; where the pointer passes, the dots swell and print in a second, slightly misregistered ink.",
  "shader": "wallpaper.wgsl",
  "fps": 30,
  "scale": 0.5,
  "interactive": true,
  "params": [
    { "name": "cell", "title": "Dot pitch (points)", "default": 12, "min": 6, "max": 32 },
    { "name": "angle", "title": "Screen angle", "default": 45, "min": 0, "max": 90 },
    { "name": "tone", "title": "Tone", "default": 0.22, "min": 0.05, "max": 0.5 },
    { "name": "speed", "title": "Drift speed", "default": 1.0, "min": 0, "max": 3 },
    { "name": "wake", "title": "Swell", "default": 1.0, "min": 0, "max": 1.5 },
    { "name": "radius", "title": "Wake radius (dots)", "default": 5, "min": 2, "max": 12 },
    { "name": "misregister", "title": "Misregister (points)", "default": 2.5, "min": 0, "max": 6 },
    { "name": "grain", "title": "Paper grain", "default": 0.06, "min": 0, "max": 0.2 }
  ],
  "still": { "time": 23.0, "pointer": [0.64, 0.46] },
