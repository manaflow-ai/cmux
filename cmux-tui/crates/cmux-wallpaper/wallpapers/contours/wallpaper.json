{
  "id": "contours",
  "name": "Contours",
  "description": "A map of a place that is thinking: topographic contours, every 5th an index line, over a height field that swells and parts over minutes, on faintly tinted, hill-shaded paper. The pointer raises a gentle hill under it.",
  "shader": "wallpaper.wgsl",
  "fps": 15,
  "scale": 0.5,
  "interactive": true,
  "idle_after": 20,
  "params": [
    { "name": "levels", "title": "Contours per unit of height", "default": 9, "min": 3, "max": 24 },
    { "name": "line", "title": "Line width (points)", "default": 0.8, "min": 0.4, "max": 1.6 },
    { "name": "contrast", "title": "Line contrast", "default": 0.24, "min": 0.06, "max": 0.5 },
    { "name": "speed", "title": "Evolution speed", "default": 1.0, "min": 0, "max": 3 },
    { "name": "hill", "title": "Pointer hill", "default": 0.7, "min": 0, "max": 1.5 },
    { "name": "accent", "title": "Line toward accent", "default": 0.45, "min": 0, "max": 1 },
    { "name": "tint", "title": "Paper tint", "default": 0.35, "min": 0, "max": 1 },
    { "name": "hue", "title": "Tint hue turn (degrees)", "default": 0, "min": -180, "max": 180 }
  ],
  "still": { "time": 40.0, "pointer": [0.62, 0.44] },
  "variants": [
