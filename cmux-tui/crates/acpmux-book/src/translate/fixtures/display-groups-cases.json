{
  "about": "A turn's display groups (transcript-motion-model.md step 9). The daemon's rule (translate/groups.rs) and the page's toolGroups (conversation/toolGroups.ts) both read these cases: groups_tests.rs runs each case's classes, displayGroupCases.test.ts runs the same calls through toolGroups and checks the page classifies each call as `class` says. A group is [type, ...entry ids]; a run is [\"run:KIND\", ...]. `card` is a coordination card or a lone sub-session start, `sent` one sent message, `sentGroup` two or more in a row.",
  "calls": {
    "command": { "class": "commands", "tool": { "kind": "execute", "title": "npm test", "command": "npm test", "status": "completed", "output": "ok" } },
    "shellRead": { "class": "reads", "tool": { "kind": "execute", "title": "cat /repo/a.ts", "command": "cat /repo/a.ts", "status": "completed", "output": "x" } },
    "read": { "class": "reads", "tool": { "kind": "read", "title": "Read a.ts", "locations": [{ "path": "/repo/a.ts" }], "status": "completed", "output": "one" } },
    "search": { "class": "searches", "tool": { "kind": "search", "title": "Grep foo", "inputSummary": "{\"pattern\":\"foo\"}", "status": "completed", "output": "a.ts:1" } },
    "edit": { "class": "edits", "tool": { "kind": "edit", "title": "Edit b.ts", "locations": [{ "path": "/repo/b.ts" }], "status": "completed" } },
    "diffEdit": { "class": "edits+diff", "tool": { "kind": "edit", "title": "Edit a.ts", "diffs": [{ "path": "/repo/a.ts", "oldText": "a", "newText": "b" }], "status": "completed" } },
    "pendingEdit": { "class": "plain", "tool": { "kind": "edit", "title": "Edit a.ts", "diffs": [{ "path": "/repo/a.ts", "oldText": "a", "newText": "b" }], "status": "pending" } },
    "fetch": { "class": "plain", "tool": { "kind": "fetch", "title": "Fetch https://example.com", "inputSummary": "{\"url\":\"https://example.com\"}", "status": "completed" } },
    "mcpSearch": { "class": "mcp:github.search_issues", "tool": { "kind": "other", "title": "mcp__github__search_issues", "inputSummary": "{\"q\":\"bug\"}", "status": "completed", "output": "found" } },
    "mcpIssue": { "class": "mcp:github.get_issue", "tool": { "kind": "other", "title": "mcp__github__get_issue", "inputSummary": "{\"number\":1}", "status": "completed", "output": "issue" } },
    "start": { "class": "subsession-start", "tool": { "kind": "other", "title": "mcp__cmux-subsessions__start_session", "inputSummary": "{\"prompt\":\"Run the tests\",\"name\":\"tests\"}", "status": "completed", "output": "Started sub-session tests (sessionId 0199a-child, depth 1)." } },
    "message": { "class": "sent", "tool": { "kind": "other", "title": "mcp__cmux-sessions__send_to_session", "inputSummary": "{\"session\":\"lint\",\"text\":\"go\"}", "status": "completed", "output": "sent" } },
    "wait": { "class": "card", "tool": { "kind": "other", "title": "mcp__cmux-subsessions__wait_for_sessions", "inputSummary": "{}", "status": "completed", "output": "[]" } }
  },
  "cases": [
    { "name": "three commands gather", "entries": ["c1:command", "c2:command", "c3:command"], "groups": [["run:commands", "c1", "c2", "c3"]] },
    { "name": "one command keeps its row", "entries": ["c1:command"], "groups": [["item", "c1"]] },
    { "name": "a thought leads a run of commands", "entries": ["t1:thought", "c1:command", "c2:command"], "groups": [["run:commands", "t1", "c1", "c2"]] },
    { "name": "a thought before one command keeps its row", "entries": ["t1:thought", "c1:command"], "groups": [["item", "t1"], ["item", "c1"]] },
    { "name": "a thought between two commands stays in their run", "entries": ["c1:command", "t1:thought", "c2:command"], "groups": [["run:commands", "c1", "t1", "c2"]] },
    { "name": "a run's trailing thought draws before what follows", "entries": ["c1:command", "c2:command", "t1:thought", "f1:fetch"], "groups": [["run:commands", "c1", "c2"], ["item", "t1"], ["item", "f1"]] },
    { "name": "a run's trailing thought leads the next run", "entries": ["c1:command", "c2:command", "t1:thought", "s1:search", "s2:search"], "groups": [["run:commands", "c1", "c2"], ["run:searches", "t1", "s1", "s2"]] },
    { "name": "consecutive thoughts are one", "entries": ["t1:thought", "t2:thought", "c1:command", "c2:command"], "groups": [["run:commands", "t1", "c1", "c2"]] },
    { "name": "reads never gather", "entries": ["r1:read", "r2:read", "r3:shellRead"], "groups": [["item", "r1"], ["item", "r2"], ["item", "r3"]] },
    { "name": "a thought between reads keeps its place", "entries": ["r1:read", "t1:thought", "r2:read"], "groups": [["item", "r1"], ["item", "t1"], ["item", "r2"]] },
    { "name": "a shell read of one file is a read, not a command", "entries": ["c1:command", "r1:shellRead", "c2:command"], "groups": [["item", "c1"], ["item", "r1"], ["item", "c2"]] },
    { "name": "two edits gather", "entries": ["e1:edit", "e2:edit"], "groups": [["run:edits", "e1", "e2"]] },
    { "name": "one edit with a diff gathers alone", "entries": ["e1:diffEdit"], "groups": [["run:edits", "e1"]] },
    { "name": "one edit without a diff keeps its row", "entries": ["e1:edit"], "groups": [["item", "e1"]] },
    { "name": "a thought ends an edit run", "entries": ["e1:diffEdit", "t1:thought", "e2:diffEdit"], "groups": [["run:edits", "e1"], ["item", "t1"], ["run:edits", "e2"]] },
    { "name": "a thought does not lead an edit run", "entries": ["t1:thought", "e1:edit", "e2:edit"], "groups": [["item", "t1"], ["run:edits", "e1", "e2"]] },
    { "name": "an edit waiting for permission keeps its row", "entries": ["c1:command", "p1:pendingEdit", "c2:command"], "groups": [["item", "c1"], ["item", "p1"], ["item", "c2"]] },
    { "name": "a kind change ends a run", "entries": ["c1:command", "c2:command", "s1:search", "s2:search"], "groups": [["run:commands", "c1", "c2"], ["run:searches", "s1", "s2"]] },
    { "name": "calls to one MCP tool gather, from one call", "entries": ["m1:mcpSearch", "m2:mcpSearch", "m3:mcpIssue"], "groups": [["mcp", "m1", "m2"], ["mcp", "m3"]] },
    { "name": "a thought ends an MCP run", "entries": ["m1:mcpSearch", "t1:thought", "m2:mcpSearch"], "groups": [["mcp", "m1"], ["item", "t1"], ["mcp", "m2"]] },
    { "name": "adjacent sub-session starts gather", "entries": ["a1:start", "a2:start", "c1:command"], "groups": [["subsessionGroup", "a1", "a2"], ["item", "c1"]] },
    { "name": "a lone sub-session start is a card", "entries": ["c1:command", "c2:command", "a1:start"], "groups": [["run:commands", "c1", "c2"], ["card", "a1"]] },
    { "name": "two sent messages gather", "entries": ["n1:message", "n2:message"], "groups": [["sentGroup", "n1", "n2"]] },
    { "name": "a lone sent message keeps its row", "entries": ["c1:command", "n1:message", "c2:command"], "groups": [["item", "c1"], ["sent", "n1"], ["item", "c2"]] },
    { "name": "a card splits a run", "entries": ["c1:command", "c2:command", "w1:wait", "c3:command"], "groups": [["run:commands", "c1", "c2"], ["card", "w1"], ["item", "c3"]] },
    { "name": "a thought before a card keeps its row", "entries": ["t1:thought", "w1:wait"], "groups": [["item", "t1"], ["card", "w1"]] },
    { "name": "a thought leads into sends", "entries": ["c1:command", "c2:command", "t1:thought", "n1:message", "n2:message"], "groups": [["run:commands", "c1", "c2"], ["item", "t1"], ["sentGroup", "n1", "n2"]] },
    { "name": "a long mixed turn", "entries": ["t1:thought", "r1:read", "r2:read", "t2:thought", "c1:command", "c2:command", "e1:diffEdit", "e2:edit", "c3:command", "t3:thought", "c4:command", "m1:mcpSearch", "f1:fetch"], "groups": [["item", "t1"], ["item", "r1"], ["item", "r2"], ["run:commands", "t2", "c1", "c2"], ["run:edits", "e1", "e2"], ["run:commands", "c3", "t3", "c4"], ["mcp", "m1"], ["item", "f1"]] }
  ]
}
