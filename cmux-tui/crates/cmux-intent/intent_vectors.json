{
 "schema": "intent-vectors.v1",
 "about": "The contract of tools/intent.py and its Rust twin: a parser spec, an argv it refuses, the outcome. Spec: flags {\"--a,-b\": \"value\"|\"int\"|\"switch\"|[choices]}, required [flag], args [name | {name, choices, int, optional}], subs {name: spec}. cli: the table's per-CLI part for that vector.",
 "parsers": {
  "disk": {"subs": {"report": {"flags": {"--json": "switch"}}, "keepup": {"flags": {"--floor": "int"}}}},
  "gh2": {
   "flags": {"--repo": "value"},
   "subs": {
    "status": {"subs": {"pr": {"args": ["target"], "flags": {"--json": "switch", "--field": "value"}}, "run": {"args": ["target"], "flags": {"--jobs": "switch"}}}},
    "wait": {"subs": {"pr": {"args": ["target"], "flags": {"--timeout": "int", "--until": ["green", "done", "merged"]}}}},
    "land": {"subs": {"status": {"args": ["repo"]}, "outcome": {"args": ["repo"]}}},
    "log": {"args": [{"name": "kind", "choices": ["job", "errors", "search", "flaky"]}, "repo", {"name": "id", "int": true}], "flags": {"--max": "int"}},
    "post": {"args": ["target"], "flags": {"--body-file": "value"}},
    "search": {"args": ["query"], "flags": {"--limit": "int"}}
   }
  },
  "mem": {"subs": {"search": {"args": ["query"]}, "get": {"args": [{"name": "id", "int": true}]}, "remember": {"args": ["text"]}}},
  "sess": {"subs": {"new": {"flags": {"--takes-from": "value", "--reason": "value", "--name,-n": "value"}, "required": ["--name"]}, "list": {"flags": {"--json": "switch"}}, "rotate": {"args": ["name"], "flags": {"--yes": "switch"}}}},
  "owner": {"flags": {"--repo": "value"}, "subs": {"who": {"args": [{"name": "pr", "int": true}], "flags": {"--json": "switch"}}, "claim": {"args": [{"name": "pr", "int": true}], "flags": {"--session": "value"}}, "release": {"args": [{"name": "pr", "int": true}]}}},
  "amb": {"subs": {"show": {"args": ["id"], "flags": {"--field": "value", "--find": "value"}}, "get": {"args": ["id"]}, "list": {}}},
  "flat": {"flags": {"--dry-run": "switch", "--reason": "value", "--force": "switch", "--wait": "int"}, "args": ["name"]}
 },
 "vectors": [
  {"name": "synonym subcommand (glaeda-disk status)", "parser": "disk", "argv": ["status"], "outcome": "ran", "to": ["report"]},
  {"name": "synonym with a flag kept", "parser": "disk", "argv": ["show", "--json"], "outcome": "ran", "to": ["report", "--json"]},
  {"name": "close subcommand", "parser": "disk", "argv": ["keepupp", "--floor", "5"], "outcome": "ran", "to": ["keepup", "--floor", "5"]},
  {"name": "unique prefix subcommand", "parser": "disk", "argv": ["rep"], "outcome": "ran", "to": ["report"]},
  {"name": "nothing close", "parser": "disk", "argv": ["zzzz"], "outcome": "none"},
  {"name": "a form that parses", "parser": "disk", "argv": ["report"], "outcome": "ok"},
  {"name": "glued subcommand (glaeda-gh land-status REPO)", "parser": "gh2", "argv": ["land-status", "o/r"], "outcome": "ran", "to": ["land", "status", "o/r"]},
  {"name": "flag names the subcommand (glaeda-gh land --status REPO)", "parser": "gh2", "argv": ["land", "--status", "o/r"], "outcome": "ran", "to": ["land", "status", "o/r"]},
  {"name": "swapped subcommand words", "parser": "gh2", "argv": ["pr", "status", "o/r#1"], "outcome": "ran", "to": ["status", "pr", "o/r#1"]},
  {"name": "parent flag after the subcommand (glaeda-gh status pr N --repo R)", "parser": "gh2", "argv": ["status", "pr", "12", "--repo", "o/r", "--json"], "outcome": "ran", "to": ["--repo", "o/r", "status", "pr", "12", "--json"]},
  {"name": "positionals out of order (glaeda-gh log REPO ID with kind last)", "parser": "gh2", "argv": ["log", "o/r", "123", "errors"], "outcome": "ran", "to": ["log", "errors", "o/r", "123"]},
  {"name": "value synonym for a choice", "parser": "gh2", "argv": ["log", "failed", "o/r", "123"], "outcome": "ran", "to": ["log", "errors", "o/r", "123"]},
  {"name": "value close to a choice", "parser": "gh2", "argv": ["wait", "pr", "o/r#1", "--until", "gren"], "outcome": "ran", "to": ["wait", "pr", "o/r#1", "--until", "green"]},
  {"name": "flag synonym", "parser": "gh2", "argv": ["search", "x", "--max", "5"], "outcome": "ran", "to": ["search", "x", "--limit", "5"]},
  {"name": "flag spelling: underscore", "parser": "flat", "argv": ["x", "--dry_run"], "outcome": "ran", "to": ["x", "--dry-run"]},
  {"name": "flag spelling: single dash", "parser": "flat", "argv": ["x", "-reason", "y"], "outcome": "ran", "to": ["x", "--reason", "y"]},
  {"name": "flag synonym --why", "parser": "flat", "argv": ["x", "--why", "y"], "outcome": "ran", "to": ["x", "--reason", "y"]},
  {"name": "flag synonym with =", "parser": "flat", "argv": ["x", "--why=y"], "outcome": "ran", "to": ["x", "--reason=y"]},
  {"name": "close flag", "parser": "flat", "argv": ["x", "--reasn", "y"], "outcome": "ran", "to": ["x", "--reason", "y"]},
  {"name": "unsafe flag is never guessed", "parser": "flat", "argv": ["x", "--forse"], "outcome": "exact", "to": [["x", "--force"]]},
  {"name": "a repair beside an exact unsafe flag does not run", "parser": "flat", "argv": ["x", "--force", "--why", "y"], "outcome": "exact", "to": [["x", "--force", "--reason", "y"]]},
  {"name": "unsafe subcommand: outward post needs its exact form", "parser": "gh2", "argv": ["post", "o/r#1", "--message-file", "f"], "outcome": "exact", "to": [["post", "o/r#1", "--body-file", "f"]]},
  {"name": "unsafe subcommand is never a synonym's target", "parser": "sess", "argv": ["rotat", "x"], "outcome": "exact", "to": [["rotate", "x"]]},
  {"name": "missing verb: the one that takes the rest (agent-memory 11296)", "parser": "mem", "argv": ["11296"], "outcome": "candidates", "to": [["search", "11296"], ["get", "11296"], ["remember", "11296"]]},
  {"name": "synonym beats close (agent-memory show N)", "parser": "mem", "argv": ["show", "11296"], "outcome": "ran", "to": ["get", "11296"]},
  {"name": "missing verb by the table's default", "parser": "mem", "argv": ["some words"], "cli": {"mem": {"default": "search"}}, "outcome": "ran", "to": ["search", "some words"]},
  {"name": "table alias", "parser": "mem", "argv": ["recall", "x"], "cli": {"mem": {"aliases": [{"from": ["recall"], "to": ["search"]}]}}, "outcome": "ran", "to": ["search", "x"]},
  {"name": "table alias under a subcommand", "parser": "gh2", "argv": ["status", "checks", "o/r#1"], "cli": {"gh2": {"aliases": [{"under": ["status"], "from": ["checks"], "to": ["pr"]}]}}, "outcome": "ran", "to": ["status", "pr", "o/r#1"]},
  {"name": "a required flag missing is not guessed (sessions new --reason without --name)", "parser": "sess", "argv": ["new", "--reason", "x"], "outcome": "none"},
  {"name": "synonym flag fills the required one", "parser": "sess", "argv": ["new", "--session", "x"], "outcome": "ran", "to": ["new", "--name", "x"]},
  {"name": "synonym subcommand ls", "parser": "sess", "argv": ["ls", "--json"], "outcome": "ran", "to": ["list", "--json"]},
  {"name": "parent flag after the subcommand and positional int", "parser": "owner", "argv": ["who", "14141", "--repo", "o/r"], "outcome": "ran", "to": ["--repo", "o/r", "who", "14141"]},
  {"name": "unknown flag with nothing close stays refused (pr-owner claim --wait 120)", "parser": "owner", "argv": ["claim", "5", "--wait", "120"], "outcome": "none"},
  {"name": "unsafe table exact", "parser": "owner", "argv": ["clam", "5"], "cli": {"owner": {"exact": ["claim"]}}, "outcome": "exact", "to": [["claim", "5"]]},
  {"name": "two synonyms present are listed, not guessed", "parser": "amb", "argv": ["info", "x"], "outcome": "candidates", "to": [["show", "x"], ["get", "x"]]},
  {"name": "two close flags are listed, not guessed", "parser": "amb", "argv": ["show", "x", "--fild", "a"], "outcome": "candidates", "to": [["show", "x", "--field", "a"], ["show", "x", "--find", "a"]]}
 ]
}
