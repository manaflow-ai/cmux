diff -ruN a/encoder/core/inc/cmux_ablate.h b/encoder/core/inc/cmux_ablate.h
--- a/encoder/core/inc/cmux_ablate.h	1970-01-01 00:00:00.000000000 +0000
+++ b/encoder/core/inc/cmux_ablate.h	2026-11-23 05:23:26.973015292 +0000
@@ -0,0 +1,33 @@
+/*!
+ * cmux measurement patch (cmux-tui/crates/cmux-codecs/openh264-ablation.patch), never shipped:
+ * CMUX_OH264_ABLATE holds a comma list of screen-content tools to turn off, one at a time or
+ * together, so codec-bench can say which one costs screen usage its encode time. Unset, the
+ * encoder is upstream's, unchanged.
+ *   scroll   no scroll detection (METHOD_SCROLL_DETECTION)
+ *   scd      no screen scene-change pass (METHOD_SCENE_CHANGE_DETECTION_SCREEN): every frame
+ *            is SIMILAR_SCENE against the closest reference, every 8x8 block NO_STATIC
+ *   pskip    no SCD P-skip decision (static and scrolled skip before motion search)
+ *   fme      no feature-based motion search (no FME preprocess, no ME_DIA_CROSS_FME)
+ *   cross    16x16 motion search is the camera's diamond, not ME_DIA_CROSS
+ *   staticme no static or scrolled 8x8 motion search shortcuts
+ *   finemd   camera's fine-partition mode decision, not WelsMdInterFinePartitionVaaOnScreen
+ *   mvrange  camera's motion vector range (64), not the expanded 504
+ *   fasti    the fast coding functions on I slices too, as camera usage has
+ */
+#ifndef CMUX_ABLATE_H
+#define CMUX_ABLATE_H
+#include <stdlib.h>
+#include <string.h>
+
+static inline bool CmuxAblate (const char* kpKey) {
+  const char* kpList = getenv ("CMUX_OH264_ABLATE");
+  if (kpList == NULL)
+    return false;
+  const size_t kiLen = strlen (kpKey);
+  for (const char* p = kpList; (p = strstr (p, kpKey)) != NULL; p += kiLen) {
+    if ((p == kpList || p[-1] == ',') && (p[kiLen] == '\0' || p[kiLen] == ','))
+      return true;
+  }
+  return false;
+}
+#endif
