{
  "name": "Paper Mill",
  "type": "light",
  "colors": {
    "editor.background": "#fafafa",
    "editor.foreground": "#383a42",
    "editor.selectionBackground": "#e5e5e6",
    "editorCursor.foreground": "#526fff"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#a0a1a7", "fontStyle": "italic" } },
    { "scope": "keyword, storage.type", "settings": { "foreground": "#a626a4" } },
    { "scope": "string", "settings": { "foreground": "#50a14f" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#4078f2" } },
    { "scope": ["variable.other.constant", "constant.numeric"], "settings": { "foreground": "#c18401" } },
    { "scope": "entity.name.tag", "settings": { "foreground": "#e45649" } },
    { "scope": "support.type.property-name", "settings": { "foreground": "#0184bc" } }
  ]
}
