// A dark VS Code color theme as an extension ships it: JSON with comments
// and trailing commas, a full terminal palette.
{
  "$schema": "vscode://schemas/color-theme",
  "name": "Midnight Harbor",
  "type": "dark",
  "colors": {
    /* editor */
    "editor.background": "#14161b",
    "editor.foreground": "#c8ccd4",
    "editor.selectionBackground": "#3a405080", // 50% over the background
    "editorCursor.foreground": "#ffcc66",
    "focusBorder": "#5ccfe6",
    // terminal
    "terminal.ansiBlack": "#1c1f26",
    "terminal.ansiRed": "#f07178",
    "terminal.ansiGreen": "#bae67e",
    "terminal.ansiYellow": "#ffd580",
    "terminal.ansiBlue": "#73d0ff",
    "terminal.ansiMagenta": "#d4bfff",
    "terminal.ansiCyan": "#95e6cb",
    "terminal.ansiWhite": "#c8ccd4",
    "terminal.ansiBrightBlack": "#5c6773",
    "terminal.ansiBrightRed": "#ff8f95",
    "terminal.ansiBrightGreen": "#d5ff9e",
    "terminal.ansiBrightYellow": "#ffe6a3",
    "terminal.ansiBrightBlue": "#a3e1ff",
    "terminal.ansiBrightMagenta": "#e6d9ff",
    "terminal.ansiBrightCyan": "#b8f2df",
    "terminal.ansiBrightWhite": "#ffffff",
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#5c6773" } },
  ],
}
