+//export TsnetSetAdvertiseTags
+// cmux: the ACL tags this node asks for at login (comma separated; empty clears). The control
+// server grants them only when the auth key's owner may use them.
+func TsnetSetAdvertiseTags(sd C.int, str *C.char) C.int {
+	s := getServer(sd)
+	if s == nil {
+		return C.EBADF
+	}
+	s.s.AdvertiseTags = nil
+	for _, tag := range strings.Split(C.GoString(str), ",") {
+		if tag = strings.TrimSpace(tag); tag != "" {
+			s.s.AdvertiseTags = append(s.s.AdvertiseTags, tag)
+		}
+	}
+	return 0
+}
