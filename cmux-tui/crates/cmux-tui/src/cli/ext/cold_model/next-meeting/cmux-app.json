{
  "$schema": "https://cmux.dev/schemas/cmux-app/2.json",
  "manifestVersion": 2,
  "id": "local/next-meeting",
  "name": "next-meeting",
  "version": "0.1.0",
  "description": "A widget made with cmux ext new.",
  "engines": {
    "cmux": "^2.0"
  },
  "runtime": {
    "main": "dist/main.js"
  },
  "implements": {
    "cmux.widget/1": {
      "export": "renderWidget",
      "title": "next-meeting",
      "symbol": "clock",
      "options": {
        "sizes": [
          "small",
          "medium"
        ],
        "defaultSize": "small",
        "refresh": {
          "everySeconds": 60
        },
        "places": [
          "newtab",
          "sidebar"
        ]
      }
    }
  },
  "files": [
    "dist/",
    "preview/"
  ]
}
