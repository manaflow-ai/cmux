{
  "$schema": "https://cmux.dev/schemas/cmux-app/2.json",
  "manifestVersion": 2,
  "id": "local/{{NAME}}",
  "name": "{{TITLE}}",
  "version": "0.1.0",
  "description": "A Session Info section made with cmux ext new.",
  "engines": { "cmux": "^2.0" },
  "runtime": { "main": "dist/main.js" },
  "implements": {
    "cmux.session.info.section/1": {
      "export": "renderSessionInfo",
      "title": "{{TITLE}}",
      "symbol": "info.circle",
      "options": { "maxRows": 8 }
    }
  },
  "files": ["dist/"]
}
