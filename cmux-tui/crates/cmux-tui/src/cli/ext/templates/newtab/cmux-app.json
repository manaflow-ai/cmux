{
  "$schema": "https://cmux.dev/schemas/cmux-app/2.json",
  "manifestVersion": 2,
  "id": "local/{{NAME}}",
  "name": "{{TITLE}}",
  "version": "0.1.0",
  "description": "A New Tab page made with cmux ext new.",
  "engines": { "cmux": "^2.0" },
  "runtime": { "main": "dist/main.js" },
  "implements": {
    "cmux.newtab/1": {
      "export": "renderNewTab",
      "title": "{{TITLE}}",
      "symbol": "house"
    }
  },
  "files": ["dist/"]
}
