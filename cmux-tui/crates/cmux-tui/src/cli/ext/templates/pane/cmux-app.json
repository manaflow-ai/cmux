{
  "$schema": "https://cmux.dev/schemas/cmux-app/2.json",
  "manifestVersion": 2,
  "id": "local/{{NAME}}",
  "name": "{{TITLE}}",
  "version": "0.1.0",
  "description": "A pane made with cmux ext new.",
  "engines": { "cmux": "^2.0" },
  "runtime": { "main": "dist/main.js" },
  "implements": {
    "cmux.pane/1": {
      "export": "renderPane",
      "title": "{{TITLE}}",
      "symbol": "rectangle.stack"
    }
  },
  "scopes": {
    "workspace:read": "List your workspaces in the pane."
  },
  "files": ["dist/"]
}
