# cmux screen host: shares this Linux desktop with cmux on the person's Mac
# (`cmux-rd linux-host run`, cmux-tui/crates/cmux-rd-host/src/linux_host/).
#
# This is a *user* unit. It must run as the user who owns the seat0 graphical session,
# inside that session's D-Bus and environment: the screen belongs to that session, the
# Wayland portal (xdg-desktop-portal ScreenCast) answers only on its session bus, and an
# X11 session's DISPLAY and XAUTHORITY come from it. A system unit, another user, or a
# headless login without the graphical session cannot capture this screen.
#
# Install (as the desktop user, once `cmux-rd linux-host enable ...` has run):
#   install -Dm644 cmux-screen-host.service ~/.config/systemd/user/cmux-screen-host.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now cmux-screen-host.service
# GNOME and KDE import DISPLAY, WAYLAND_DISPLAY, XAUTHORITY and XDG_SESSION_TYPE into the user
# manager when the session starts; on other desktops run, from the session:
#   systemctl --user import-environment DISPLAY WAYLAND_DISPLAY XAUTHORITY XDG_SESSION_TYPE
# Logs: journalctl --user -u cmux-screen-host (viewers asking for access are logged there;
# answer with `cmux-rd linux-host approve SESSION` or `deny SESSION`).

[Unit]
Description=cmux screen host (share this desktop with cmux)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/cmux-rd linux-host run
Restart=on-failure
RestartSec=5
# 78 (EXIT_NEEDS_SETUP in src/linux_host/mod.rs): the hub removed this desktop or its anchor
# ended. Restarting cannot fix that; the journal names the command to run.
RestartPreventExitStatus=78
# No privileges beyond the desktop user's own.
NoNewPrivileges=yes
# No namespace sandboxing (PrivateTmp, PrivateUsers, ProtectSystem, ProtectHome, ReadOnlyPaths
# and the like): in a user unit each one makes systemd set up a user namespace, which several
# distributions forbid unprivileged processes, so the unit would not start there. PrivateTmp
# would also hide an XAUTHORITY file or X socket kept in /tmp. The host needs the session's own
# view of the screen anyway; test user_unit_needs_no_user_namespace keeps it so.

[Install]
WantedBy=graphical-session.target
