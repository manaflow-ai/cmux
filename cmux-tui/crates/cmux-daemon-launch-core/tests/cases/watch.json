[
 {
  "name": "it replaces only after two stuck ensures over the sustained window",
  "steps": [
   {
    "op": "note",
    "request": {
     "ensure": {
      "kind": "ready",
      "pid": 41
     },
     "enabled": true
    },
    "expect": {
     "cancel": true
    }
   },
   {
    "op": "note",
    "request": {
     "ensure": {
      "kind": "stuck"
     },
     "enabled": true
    },
    "expect": {
     "schedule": {
      "streak": 1,
      "afterMs": 30000
     },
     "evaluate": true
    }
   },
   {
    "op": "evaluate",
    "request": {
     "enabled": true
    },
    "expect": null
   },
   {
    "op": "note",
    "request": {
     "ensure": {
      "kind": "stuck"
     },
     "enabled": true
    },
    "expect": {
     "evaluate": true
    }
   },
   {
    "op": "evaluate",
    "request": {
     "enabled": true
    },
    "expect": null
   },
   {
    "op": "replace_count",
    "request": {},
    "expect": 0
   },
   {
    "op": "window_passed",
    "request": {
     "streak": 1,
     "enabled": true
    },
    "expect": {
     "evaluate": true
    }
   },
   {
    "op": "evaluate",
    "request": {
     "enabled": true
    },
    "expect": {
     "streak": 1,
     "owner": 41
    }
   },
   {
    "op": "claim",
    "request": {
     "streak": 1,
     "owner": 41,
     "enabled": true
    },
    "expect": {
     "yes": true
    }
   },
   {
    "op": "finish",
    "request": {
     "streak": 1,
     "owner": 41
    },
    "expect": {}
   },
   {
    "op": "replace_count",
    "request": {},
    "expect": 1
   }
  ]
 },
