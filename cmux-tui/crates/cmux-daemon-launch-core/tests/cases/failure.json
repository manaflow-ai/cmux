  "request": {
   "error": {
    "kind": "launch_failed",
    "detail": "exit 3: {\"code\":\"server.spawn_failed\",\"message\":\"m\",\"details\":{},\"retryable\":false}",
    "description": "d"
   }
  },
  "expect": {
   "stuck": false,
   "diskFull": false,
   "watch": {
    "kind": "failed"
   },
   "failure": {
    "kind": "failed",
    "detail": "d"
   }
  }
 },
 {
  "name": "another session does not offer Restart",
  "op": "classify_error",
  "request": {
   "error": {
    "kind": "launch_failed",
    "detail": "exit 3: {\"code\":\"server.different_session\",\"message\":\"m\"}",
    "description": "d"
   }
  },
  "expect": {
   "stuck": false,
   "diskFull": false,
