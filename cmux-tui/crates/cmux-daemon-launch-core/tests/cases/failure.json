[
 {
  "name": "an owner at its connection limit offers Restart, and is busy for the watch",
  "op": "classify_error",
  "request": {
   "error": {
    "kind": "launch_failed",
    "detail": "exit 3: {\"code\":\"server.busy\",\"message\":\"m\",\"details\":{},\"retryable\":false}",
    "description": "d"
   }
  },
  "expect": {
   "stuck": true,
   "diskFull": false,
   "watch": {
    "kind": "busy"
   },
   "failure": {
    "kind": "failed",
    "detail": "d"
   }
  }
 },
 {
  "name": "no owner became ready is stuck",
  "op": "classify_error",
  "request": {
   "error": {
    "kind": "launch_failed",
    "detail": "exit 3: {\"code\":\"server.unavailable\",\"message\":\"m\",\"details\":{},\"retryable\":false}",
    "description": "d"
   }
  },
  "expect": {
   "stuck": true,
   "diskFull": false,
   "watch": {
    "kind": "stuck"
   },
   "failure": {
    "kind": "failed",
    "detail": "d"
   }
  }
 },
 {
  "name": "a spawn failure does not offer Restart",
