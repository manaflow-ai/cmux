    "kind": "failed"
   },
   "failure": {
    "kind": "failed",
    "detail": "d"
   }
  }
 },
 {
  "name": "a restore past its bound is stuck",
  "op": "classify_error",
  "request": {
   "error": {
    "kind": "restore_timeout",
