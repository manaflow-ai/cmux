{
  "protocol": "acpmux",
  "base": 1,
  "revisions": [
    {
      "rev": 2,
      "note": "#55935 removed the agent to-do list: taskList on sessions, turn.planStep, and the _acpmux/task_list/get and _acpmux/task_list/set messages. Old peers get taskList and planStep as null (the old schema allowed both).",
