          "op": "remove",
          "path": "/*untyped*",
          "default": null
        },
        {
          "message": "response:_acpmux/task_list/get",
          "op": "remove",
          "path": "/data/*untyped*",
          "default": null
        },
        {
          "message": "request:_acpmux/task_list/set",
          "op": "remove",
          "path": "/*untyped*",
          "default": null
        },
        {
          "message": "response:_acpmux/task_list/set",
          "op": "remove",
          "path": "/data/*untyped*",
          "default": null
        }
      ]
    }
  ]
}
