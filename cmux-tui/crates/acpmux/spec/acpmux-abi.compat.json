          "op": "remove",
          "path": "/session/taskList",
          "default": null
        },
        {
          "message": "event:_acpmux/session_changed",
          "op": "remove",
          "path": "/session/turn/planStep",
          "default": null
        },
        {
          "message": "response:_acpmux/attach",
          "op": "remove",
          "path": "/data/session/taskList",
          "default": null
        },
        {
          "message": "response:_acpmux/attach",
          "op": "remove",
          "path": "/data/session/turn/planStep",
          "default": null
        },
        {
          "message": "response:_acpmux/sessions",
          "op": "remove",
          "path": "/data/sessions/*/taskList",
          "default": null
        },
        {
          "message": "response:_acpmux/sessions",
          "op": "remove",
          "path": "/data/sessions/*/turn/planStep",
          "default": null
        },
        {
          "message": "response:_acpmux/watch",
          "op": "remove",
          "path": "/data/sessions/*/taskList",
          "default": null
        },
        {
          "message": "response:_acpmux/watch",
          "op": "remove",
          "path": "/data/sessions/*/turn/planStep",
          "default": null
        },
        {
