 "_doc": "Golden vectors of the JSON ops (src/ops.rs), each from the Swift rule it replaces (source). request goes to cmux_daemon_conn_call(op); expect is the whole reply.",
 "cases": [
  {"source": "DaemonHandshake.run: a cmux-tui at protocol 12 with every required capability", "op": "handshake_verdict",
   "request": {"identity_reply": "{\"id\":1,\"ok\":true,\"data\":{\"app\":\"cmux-tui\",\"version\":\"1.0.0\",\"protocol\":12,\"capabilities\":[\"a-v1\",\"b-v1\"],\"session\":\"main\",\"pid\":7,\"generation\":\"g1\"}}", "required": ["a-v1", "b-v1"]},
   "expect": {"verdict": "accept"}},
  {"source": "DaemonHandshake.run: another program on the socket closes at once", "op": "handshake_verdict",
   "request": {"identity": {"app": "other", "protocol": 12}, "required": ["a-v1"]},
   "expect": {"verdict": "wrong_app", "app": "other"}},
  {"source": "DaemonHandshake.run: another protocol is refused before capabilities", "op": "handshake_verdict",
   "request": {"identity": {"app": "cmux-tui", "protocol": 11, "capabilities": []}, "required": ["a-v1"]},
   "expect": {"verdict": "unsupported_protocol", "protocol": 11}},
  {"source": "DaemonHandshake.run: missing required capabilities, in the order asked", "op": "handshake_verdict",
   "request": {"identity": {"app": "cmux-tui", "protocol": 12, "capabilities": ["b-v1"]}, "required": ["c-v1", "b-v1", "a-v1"]},
   "expect": {"verdict": "missing_capabilities", "names": ["c-v1", "a-v1"]}},
  {"source": "PageRelayHandshake.run: no origin claim fails the connect", "op": "page_relay_verdict",
   "request": {"identity": {"app": "cmux-tui", "protocol": 12, "capabilities": []}, "page": "history"},
   "expect": {"verdict": "missing_capabilities", "names": ["origin-claim-v1"]}},
  {"source": "PageRelayHandshake.run: the page only to a daemon that knows page ids", "op": "page_relay_verdict",
