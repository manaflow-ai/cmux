{
  "manifestVersion": 2,
  "id": "local/clock",
  "name": "Clock",
  "version": "1.0.0",
  "description": "A widget (cmux.widget/1): the time and the date, in three sizes.",
  "engines": { "cmux": "^2.0" },
  "runtime": { "main": "dist/main.js" },
  "implements": {
    "cmux.widget/1": {
      "export": "renderClock",
      "title": { "en": "Clock" },
      "symbol": "clock",
      "options": {
        "sizes": ["small", "medium", "large"],
        "defaultSize": "small",
        "refresh": { "everySeconds": 60 },
        "places": ["newtab", "sidebar"]
      }
    }
  }
}
