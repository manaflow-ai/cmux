{
  "name": "cmux.composer.control/1",
  "version": 1,
  "docs": "Controls in the agent chat composer's footer, beside its own pickers: a button, or a menu of items. A button or item either runs an action (an action catalog id, or cmuxConfig.<name> for the customize app) or writes its insert text at the caret. The daemon lists them (apps.composer.list, controls) from the manifest, so no script runs and a save of the manifest updates the footer; a click goes back to the daemon (apps.composer.control.run), which runs the control as the app with the person's click as the gesture.",
  "props": {
    "controls": "ComposerControl[]"
  },
  "methods": {},
  "events": [],
  "options": {
    "type": "object",
    "additionalProperties": false,
    "required": ["controls"],
    "properties": {
      "controls": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "label"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$",
              "description": "The control's id in this app: lowercase letters, digits, - and _."
            },
            "kind": {
              "enum": ["button", "menu"],
              "description": "button runs or inserts on click; menu opens its items."
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "description": "The control's text; the accessible name when a symbol is shown alone."
            },
            "symbol": {
              "type": "string",
              "maxLength": 64,
              "description": "An SF Symbol name; when set, a button shows the symbol alone and its label as the tooltip."
            },
            "tooltip": {
              "type": "string",
              "maxLength": 120,
              "description": "Hover text; defaults to the label."
            },
            "placement": {
              "enum": ["left", "right"],
              "default": "left",
              "description": "left: after the + menu; right: before the send control."
            },
            "order": {
              "type": "integer",
              "minimum": -100,
              "maximum": 100,
              "default": 0,
              "description": "Lower first within its placement; ties keep app then manifest order."
            },
            "action": { "$ref": "#/$defs/action" },
            "args": { "$ref": "#/$defs/args" },
            "insert": { "$ref": "#/$defs/insert" },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "label"],
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$" },
                  "label": { "type": "string", "minLength": 1, "maxLength": 60 },
                  "description": { "type": "string", "maxLength": 120 },
                  "symbol": { "type": "string", "maxLength": 64 },
                  "action": { "$ref": "#/$defs/action" },
                  "args": { "$ref": "#/$defs/args" },
                  "insert": { "$ref": "#/$defs/insert" }
                },
                "oneOf": [
                  { "required": ["action"], "not": { "required": ["insert"] } },
                  { "required": ["insert"], "not": { "anyOf": [{ "required": ["action"] }, { "required": ["args"] }] } }
                ]
              }
            }
          },
          "oneOf": [
            {
              "properties": { "kind": { "const": "button" } },
              "required": ["action"],
              "not": { "anyOf": [{ "required": ["insert"] }, { "required": ["items"] }] }
            },
            {
              "properties": { "kind": { "const": "button" } },
              "required": ["insert"],
              "not": { "anyOf": [{ "required": ["action"] }, { "required": ["args"] }, { "required": ["items"] }] }
            },
            {
              "properties": { "kind": { "const": "menu" } },
              "required": ["items"],
              "not": { "anyOf": [{ "required": ["action"] }, { "required": ["args"] }, { "required": ["insert"] }] }
            }
          ]
        }
      }
    },
    "$defs": {
      "action": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
        "description": "An action catalog id, or cmuxConfig.<name> (the customize app only)."
      },
      "args": {
        "type": "object",
        "description": "The action's arguments, as action.run takes them."
      },
      "insert": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8000,
        "description": "Text written at the composer's caret."
      }
    }
  },
  "status": "draft: shapes are refined with the first implementing app before the interface is public"
}
