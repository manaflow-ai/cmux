{
  "name": "cmux.editor/1",
  "version": 1,
  "docs": "Edit one document handle in a pane or an embed.",
  "props": {
    "doc": "doc_ handle",
    "readOnly": "boolean?",
    "language": "string?",
    "revealRange": "Range?",
    "decorations": "Decoration[]?"
  },
  "methods": {
    "render": "web|scene|native"
  },
  "events": [
    "selectionChanged",
    "requestSave",
    "requestOpen"
  ],
  "options": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "capabilities": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "enum": [
            "diff",
            "readOnly",
            "multiCursor",
            "decorations"
          ]
        }
      },
      "paneCommands": {
        "type": "array",
        "uniqueItems": true,
        "maxItems": 16,
        "items": {
          "enum": [
            "save",
            "revert",
            "toggleReadOnly",
            "focus"
          ]
        },
        "description": "Commands the shell routes to the focused editor pane (palette, shortcut)."
      }
    }
  },
  "status": "draft: shapes are refined with the first implementing app before the interface is public"
}
