[
 {
  "name": "initialize first gets the token",
  "text": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}",
  "first": true,
  "token": "abc",
  "expect": {
   "send": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "initialize",
    "params": {
     "_meta": {
      "acpmux": {
       "localAppToken": "abc"
      }
     }
    }
   }
  }
 },
 {
  "name": "initialize keeps other meta and gets the token",
  "text": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":1,\"_meta\":{\"acpmux\":{\"x\":1},\"y\":2}}}",
  "first": true,
  "token": "abc",
  "expect": {
   "send": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "initialize",
    "params": {
     "protocolVersion": 1,
     "_meta": {
      "acpmux": {
       "x": 1,
       "localAppToken": "abc"
      },
      "y": 2
     }
    }
   }
  }
 },
 {
  "name": "initialize without a token is sent as written",
  "text": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}",
  "first": true,
  "token": null,
  "expect": {
   "send": "unchanged"
  }
 },
 {
  "name": "first frame not initialize",
  "text": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"session/new\",\"params\":{}}",
  "first": true,
  "token": "abc",
  "expect": {
   "refuse": "transport.first_frame",
   "method": "session/new",
   "id": "1"
  }
 },
 {
  "name": "first initialize without id",
  "text": "{\"jsonrpc\":\"2.0\",\"method\":\"initialize\",\"params\":{}}",
  "first": true,
  "token": "abc",
  "expect": {
   "refuse": "transport.first_frame",
   "method": "initialize",
   "id": null
  }
 },
 {
  "name": "first frame string id",
  "text": "{\"jsonrpc\":\"2.0\",\"id\":\"a/b\",\"method\":\"session/new\",\"params\":{}}",
  "first": true,
  "token": null,
  "expect": {
   "refuse": "transport.first_frame",
   "method": "session/new",
   "id": "\"a\\/b\""
  }
 },
 {
