 {
  "name": "a reply to a starting request adds its sessions",
  "steps": [
   {
    "sent": {
     "method": "session/new",
     "id": "9",
     "handoff": null,
     "owned": false
    }
   },
   {
    "observe": {
     "jsonrpc": "2.0",
     "id": 9,
     "result": {
      "sessionId": "s5"
     }
    }
   },
   {
    "sent": {
     "method": "acp.session.fork",
     "id": "\"f\"",
     "handoff": null,
     "owned": false
    }
   },
   {
    "observe": {
     "jsonrpc": "2.0",
     "id": "f",
     "result": {
      "sessionId": "s6",
      "targetSessionId": "s7"
     }
    }
   }
  ],
  "holds": [
   [
    {
     "sessionId": "s7"
    },
    true
   ]
  ],
  "contains": [
   [
    "s5",
    true
   ],
   [
    "s6",
    true
   ],
   [
    "s7",
    true
   ]
  ]
 },
