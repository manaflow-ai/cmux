 {
  "name": "a handoff record from a held session holds it",
  "steps": [
   {
    "add": "s1"
   },
   {
    "sent": {
     "method": "_acpmux/handoff_prepare",
     "id": "5",
     "handoff": null,
     "owned": false
    }
   },
   {
    "observe": {
     "jsonrpc": "2.0",
     "id": 5,
     "result": {
      "handoffId": "h1",
      "source": {
       "sessionId": "s1"
      }
     }
    }
   }
  ],
  "holds": [
   [
    {
     "handoffId": "h1"
    },
    true
   ],
   [
    {
     "handoffId": "h2"
    },
    false
   ]
  ],
  "contains": []
 },
 {
