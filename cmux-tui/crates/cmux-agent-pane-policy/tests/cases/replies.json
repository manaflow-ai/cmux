    "code": -32000,
    "message": "no"
   }
  }
 },
 {
  "name": "status error without code",
  "method": "_acpmux/status",
  "page_id": "3",
  "reply": {
   "jsonrpc": "2.0",
   "id": 99,
   "error": {
    "message": 5
   }
  },
  "expected": {
   "jsonrpc": "2.0",
   "id": 3,
   "error": {
    "code": -32603,
    "message": ""
   }
  }
 },
 {
