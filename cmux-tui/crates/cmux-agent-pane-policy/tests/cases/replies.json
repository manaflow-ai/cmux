 {
  "name": "peer reconnect keeps doctor state but drops peer endpoints and metadata",
  "method": "_acpmux/peer_reconnect",
  "page_id": "8",
  "reply": {
   "jsonrpc": "2.0",
   "id": 99,
   "result": {
    "peers": [
     {
      "name": "cloud-1",
      "url": "wss://cloud-1.cmux.dev/?token=secret",
      "connected": false,
      "state": "offline",
      "error": "doctor refused",
      "health": {
       "host": "hidden"
      }
     }
    ]
   }
  },
  "expected": {
   "jsonrpc": "2.0",
   "id": 8,
   "result": {
    "peers": [
     {
      "name": "cloud-1",
      "transport": "wss",
      "connected": false,
      "state": "offline",
      "error": "doctor refused"
     }
    ]
   }
  }
 },
 {
