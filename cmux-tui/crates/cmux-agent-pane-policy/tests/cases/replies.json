   "result": {}
  }
 },
 {
  "name": "peer reconnect keeps each peer's name, state and error, never its endpoint",
  "method": "_acpmux/peer_reconnect",
  "page_id": "8",
  "reply": {
   "jsonrpc": "2.0",
   "id": 41,
   "result": {
    "peers": [
     {
      "name": "studio",
      "url": "wss://studio.example/acpmux?token=s",
      "connected": false,
      "state": "failed",
      "error": "doctor: host unreachable",
      "attempts": 3
     },
     {
      "name": "box",
      "state": "connected",
      "url": "ssh://box"
     }
    ],
    "token": "s"
   }
  },
  "expected": {
   "jsonrpc": "2.0",
   "id": 8,
   "result": {
    "peers": [
     {
      "name": "studio",
      "transport": "wss",
      "connected": false,
      "state": "failed",
      "attempts": 3,
      "error": "doctor: host unreachable"
     },
     {
      "name": "box",
      "transport": "ssh",
      "state": "connected"
     }
    ]
   }
  }
 },
 {
  "name": "peer snapshot keeps each peer's name, state, lastSeen and error, never its endpoint or a boolean lastSeen",
  "method": "_acpmux/peers",
  "page_id": "9",
  "reply": {
   "jsonrpc": "2.0",
   "id": 42,
   "result": {
    "peers": [
     {
      "name": "studio",
      "url": "ssh://studio",
      "token": "s",
      "state": "restarting",
      "lastSeen": 1793357781599,
      "error": "daemon restarting",
      "attempts": 2
     },
     {
      "name": "box",
      "state": "connected",
      "lastSeen": true,
      "error": null
     }
    ],
    "token": "s"
   }
  },
  "expected": {
   "jsonrpc": "2.0",
   "id": 9,
   "result": {
    "peers": [
     {
      "name": "studio",
      "state": "restarting",
      "lastSeen": 1793357781599,
      "error": "daemon restarting"
     },
     {
      "name": "box",
      "state": "connected"
     }
    ]
   }
  }
 },
 {
  "name": "status: each peer keeps its name, transport and connected, never its URL (Swift AgentPaneStatusReplyShapeTests)",
  "method": "_acpmux/status",
  "page_id": "7",
  "reply": {
   "jsonrpc": "2.0",
   "id": 99,
   "result": {
    "peers": [
     {
      "name": "gpu-box",
      "url": "ssh://dev@gpu-box",
      "connected": true
     },
     {
      "name": "cloud-1",
      "url": "wss://cloud-1.cmux.dev/acp?token=secret",
      "connected": false
     }
    ]
   }
  },
  "expected": {
   "jsonrpc": "2.0",
   "id": 7,
   "result": {
    "peers": [
     {
      "name": "gpu-box",
      "transport": "ssh",
      "connected": true
     },
     {
      "name": "cloud-1",
      "transport": "wss",
      "connected": false
     }
    ]
   }
  }
 },
 {
  "name": "status: each peer keeps its link state, lastSeen and attempts",
  "method": "_acpmux/status",
  "page_id": "7",
  "reply": {
   "jsonrpc": "2.0",
   "id": 99,
   "result": {
    "peers": [
     {
      "name": "laptop",
      "url": "ssh://me@laptop",
      "connected": false,
      "state": "reconnecting",
      "lastSeen": 1792600000000,
      "attempts": 4,
      "downSince": 1792600001000,
      "error": "refused"
     }
    ]
   }
  },
  "expected": {
   "jsonrpc": "2.0",
   "id": 7,
   "result": {
    "peers": [
     {
      "name": "laptop",
      "transport": "ssh",
      "connected": false,
      "state": "reconnecting",
      "lastSeen": 1792600000000,
      "attempts": 4
     }
    ]
   }
  }
 },
 {
  "name": "status: a lastSeen or attempts that is not a number is dropped",
  "method": "_acpmux/status",
  "page_id": "7",
  "reply": {
   "jsonrpc": "2.0",
   "id": 99,
   "result": {
    "peers": [
     {
      "name": "one",
      "lastSeen": true,
      "attempts": "3"
     }
    ]
   }
  },
  "expected": {
   "jsonrpc": "2.0",
   "id": 7,
   "result": {
    "peers": [
     {
      "name": "one"
     }
    ]
   }
  }
 },
 {
  "name": "status: a connected that is not a boolean is dropped",
  "method": "_acpmux/status",
  "page_id": "7",
  "reply": {
   "jsonrpc": "2.0",
   "id": 99,
   "result": {
    "peers": [
     {
      "name": "one",
      "connected": 1
     },
     {
      "name": "yes",
      "connected": "true"
     }
    ]
   }
  },
  "expected": {
   "jsonrpc": "2.0",
   "id": 7,
   "result": {
    "peers": [
     {
      "name": "one"
     },
     {
      "name": "yes"
     }
    ]
   }
  }
 },
 {
