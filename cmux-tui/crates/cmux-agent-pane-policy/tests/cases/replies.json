[
 {
  "name": "status keeps peer names",
  "method": "_acpmux/status",
  "page_id": "7",
  "reply": {
   "jsonrpc": "2.0",
   "id": 99,
   "result": {
    "peers": [
     {
      "name": "a",
      "url": "ws://x?token=s"
     },
     {
      "url": "y"
     },
     {
      "name": 5
     },
     {
      "name": "b"
     }
    ],
    "webUrl": "http://t",
    "token": "s"
   }
  },
  "expected": {
   "jsonrpc": "2.0",
   "id": 7,
   "result": {
    "peers": [
     {
      "name": "a",
      "transport": "ws"
     },
     {
      "name": "b"
     }
    ]
   }
  }
 },
 {
  "name": "status with nothing kept",
  "method": "_acpmux/status",
  "page_id": "\"p\"",
  "reply": {
   "jsonrpc": "2.0",
   "id": 99,
   "result": {
    "webUrl": "x"
   }
  },
  "expected": {
   "jsonrpc": "2.0",
   "id": "p",
   "result": {}
  }
 },
 {
  "name": "status error keeps code and message",
