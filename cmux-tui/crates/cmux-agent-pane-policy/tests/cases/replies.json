[
 {
  "name": "status keeps peer names",
  "method": "_acpmux/status",
  "page_id": "7",
  "reply": {
   "jsonrpc": "2.0",
   "id": 99,
   "result": {
    "peers": [
     {
      "name": "a",
      "url": "ws://x?token=s"
     },
     {
      "url": "y"
     },
     {
      "name": 5
     },
     {
      "name": "b"
     }
    ],
    "webUrl": "http://t",
    "token": "s"
   }
  },
  "expected": {
   "jsonrpc": "2.0",
   "id": 7,
   "result": {
    "peers": [
     {
      "name": "a"
     },
     {
      "name": "b"
     }
    ]
   }
  }
 },
 {
  "name": "status with nothing kept",
  "method": "_acpmux/status",
  "page_id": "\"p\"",
  "reply": {
   "jsonrpc": "2.0",
   "id": 99,
   "result": {
    "webUrl": "x"
   }
  },
  "expected": {
   "jsonrpc": "2.0",
   "id": "p",
   "result": {}
  }
 },
 {
  "name": "status error keeps code and message",
  "method": "_acpmux/status",
  "page_id": "3",
  "reply": {
   "jsonrpc": "2.0",
   "id": 99,
   "error": {
    "code": -32000,
    "message": "no",
    "data": {
     "secret": 1
    }
   }
  },
  "expected": {
   "jsonrpc": "2.0",
   "id": 3,
   "error": {
    "code": -32000,
    "message": "no"
   }
  }
 },
 {
  "name": "status error without code",
  "method": "_acpmux/status",
  "page_id": "3",
  "reply": {
   "jsonrpc": "2.0",
   "id": 99,
   "error": {
    "message": 5
   }
  },
  "expected": {
   "jsonrpc": "2.0",
   "id": 3,
   "error": {
    "code": -32603,
    "message": ""
   }
  }
 },
 {
  "name": "status bad page id",
  "method": "_acpmux/status",
  "page_id": "{",
  "reply": {
   "jsonrpc": "2.0",
   "id": 99,
   "result": {}
  },
  "expected": {
   "jsonrpc": "2.0",
   "id": null,
   "result": {}
  }
 },
 {
  "name": "peer reconnect keeps each peer's name, state and error, never its endpoint",
  "method": "_acpmux/peer_reconnect",
  "page_id": "8",
  "reply": {
   "jsonrpc": "2.0",
   "id": 41,
   "result": {
    "peers": [
     {
      "name": "studio",
      "url": "wss://studio.example/acpmux?token=s",
      "connected": false,
      "state": "failed",
      "error": "doctor: host unreachable",
      "attempts": 3
     },
     {
      "name": "box",
      "state": "connected",
      "url": "ssh://box"
     }
    ],
    "token": "s"
   }
  },
  "expected": {
   "jsonrpc": "2.0",
   "id": 8,
   "result": {
    "peers": [
     {
      "name": "studio",
      "state": "failed",
      "error": "doctor: host unreachable"
     },
     {
      "name": "box",
      "state": "connected"
     }
    ]
   }
  }
 },
 {
  "name": "peer snapshot keeps each peer's name, state, lastSeen and error, never its endpoint or a boolean lastSeen",
  "method": "_acpmux/peers",
  "page_id": "9",
  "reply": {
   "jsonrpc": "2.0",
   "id": 42,
   "result": {
    "peers": [
     {
      "name": "studio",
      "url": "ssh://studio",
      "token": "s",
      "state": "restarting",
      "lastSeen": 1793357781599,
      "error": "daemon restarting",
      "attempts": 2
     },
     {
      "name": "box",
      "state": "connected",
      "lastSeen": true,
      "error": null
     }
    ],
    "token": "s"
   }
  },
  "expected": {
   "jsonrpc": "2.0",
   "id": 9,
   "result": {
    "peers": [
     {
      "name": "studio",
      "state": "restarting",
      "lastSeen": 1793357781599,
      "error": "daemon restarting"
     },
     {
      "name": "box",
      "state": "connected"
     }
    ]
   }
  }
 }
]
