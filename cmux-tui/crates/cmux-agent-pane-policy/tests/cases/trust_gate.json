{
 "description": "AGENT-TRUST-GATE: what a cmux host must do so acpmux's folder-trust gate (cmux-tui/crates/acpmux/src/server/trust_gate.rs `gated`: LocalApp and Web origins are gated, a peer only for `_meta.acpmux.via` app or web) holds for the agent pane. The host makes the pane LocalApp-origin (the token goes into the first frame only, after the rules read the page's frame: AcpmuxPaneMethods.swift `decide`, `withLocalAppToken`; AgentPaneTransport+Check.swift `checkOne`), the page cannot write the token or a forward mark (P1: AcpmuxPaneMethods.swift `knownParams`, `breaksParamsRule`), Trust needs a gesture and Don't trust does not (`gestureRules`, `needsGesture`), and the gate's refusals reach the page as acpmux wrote them (AcpmuxRequestIds.swift `toPage`: only `replyShapes` methods are rebuilt), where direct.ts `isTrustRefusal` reads data.reason.",
 "frames": [
  {
   "name": "trust gate: the first initialize gets the host's LocalApp token (LocalApp origin, gated)",
   "text": "{\"jsonrpc\":\"2.0\",\"method\":\"initialize\",\"id\":1,\"params\":{\"protocolVersion\":1}}",
   "first": true,
   "token": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
   "expect": {
    "send": {
     "jsonrpc": "2.0",
     "method": "initialize",
     "id": 1,
     "params": {
      "protocolVersion": 1,
      "_meta": {
       "acpmux": {
        "localAppToken": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
       }
      }
     }
    }
   }
  },
  {
   "name": "trust gate: a page token in the first frame is replaced by the host's",
   "text": "{\"jsonrpc\":\"2.0\",\"method\":\"initialize\",\"id\":1,\"params\":{\"_meta\":{\"acpmux\":{\"localAppToken\":\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"}}}}",
   "first": true,
   "token": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
   "expect": {
    "send": {
     "jsonrpc": "2.0",
     "method": "initialize",
     "id": 1,
     "params": {
      "_meta": {
       "acpmux": {
        "localAppToken": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
       }
      }
     }
    }
   }
  },
  {
   "name": "trust gate: a later initialize is refused (no second token, no origin change)",
   "text": "{\"jsonrpc\":\"2.0\",\"method\":\"initialize\",\"id\":2,\"params\":{}}",
   "first": false,
   "token": null,
   "expect": {
    "refuse": "transport.method_refused",
    "method": "initialize",
    "id": "2"
   }
  },
  {
   "name": "trust gate: a later frame never gets the token",
   "text": "{\"jsonrpc\":\"2.0\",\"method\":\"acp.trust.get\",\"id\":3,\"params\":{\"cwd\":\"/x\"}}",
   "first": false,
   "token": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
   "expect": {
    "send": "unchanged"
   }
  },
  {
   "name": "trust gate: acp.trust.set is a request",
   "text": "{\"jsonrpc\":\"2.0\",\"method\":\"acp.trust.set\",\"id\":4,\"params\":{\"cwd\":\"/x\",\"level\":\"trusted\"}}",
   "first": false,
   "token": null,
   "expect": {
    "send": "unchanged"
   }
  },
  {
   "name": "trust gate: acp.trust.set as a notification is refused",
   "text": "{\"jsonrpc\":\"2.0\",\"method\":\"acp.trust.set\",\"params\":{\"cwd\":\"/x\",\"level\":\"trusted\"}}",
   "first": false,
   "token": null,
   "expect": {
    "refuse": "transport.method_refused",
    "method": "acp.trust.set"
   }
  },
  {
   "name": "trust gate: the first frame cannot be a prompt",
   "text": "{\"jsonrpc\":\"2.0\",\"method\":\"session/prompt\",\"id\":1,\"params\":{\"sessionId\":\"s\",\"prompt\":[]}}",
   "first": true,
   "token": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
   "expect": {
    "refuse": "transport.first_frame",
    "method": "session/prompt",
    "id": "1"
   }
  }
