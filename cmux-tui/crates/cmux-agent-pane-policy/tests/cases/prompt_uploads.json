   "jsonrpc": "2.0",
   "id": 17,
   "method": "session/prompt",
   "params": {
    "sessionId": "chat",
    "prompt": [
     {
      "type": "image",
      "name": "original.pem",
      "_meta": {
       "untrusted": true,
       "acpmux": {
        "context": "spoof",
        "upload": {
         "uploadId": "019c6e27-e55b-73d1-87d8-4e01f1f75043",
         "fileName": "original.pem"
        }
       }
      },
      "annotations": {
       "_meta": {
        "acpmux": {
         "upload": {
          "uploadId": "019c6e27-e55b-73d1-87d8-4e01f1f75043",
          "fileName": "nested"
         }
        }
       }
      }
     },
     {
      "type": "text",
      "text": "hello",
      "_meta": {
       "context": true
      }
     }
    ],
    "_meta": {
     "acpmux": {
      "promptId": "prompt"
     },
     "cmuxGesture": "ticket"
