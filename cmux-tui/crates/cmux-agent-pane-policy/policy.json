{
  "description": "What a cmux host lets the agent pane page send to acpmux through the host-owned socket. Data copied from CmuxNextAgentPane AcpmuxPaneMethods.swift, AcpmuxPathPolicy.swift (path_keys) and AcpmuxConnection.swift; tests/swift.rs fails when requests or known_params differ from the Swift tables. Changing it needs the protocol/origin lead's review (ad349).",
  "pane_origin": "cmux-agent://pane",
  "initialize": "initialize",
  "requests": [
    "session/new", "session/prompt", "session/set_model", "session/set_mode", "session/set_config_option",
    "_acpmux/watch", "_acpmux/sessions", "_acpmux/events", "_acpmux/attachment", "_acpmux/attach", "_acpmux/detach", "_acpmux/view", "_acpmux/typing", "_acpmux/warm",
    "_acpmux/peer_snapshot", "_acpmux/peer_reconnect", "_acpmux/retry",
    "_acpmux/kill", "_acpmux/prewarm", "_acpmux/harnesses", "_acpmux/models", "_acpmux/permission_respond",
    "_acpmux/status", "_acpmux/peers", "_acpmux/draft_get", "_acpmux/draft_set", "_acpmux/inbox_thread", "_acpmux/bookmark_get", "_acpmux/bookmark_set", "_acpmux/btw", "_acpmux/queue_remove", "_acpmux/queue_edit",
    "_acpmux/handoff_prepare", "_acpmux/handoff_get", "_acpmux/handoff_draft", "_acpmux/handoff_start",
    "_acpmux/handoff_discard",
    "_acpmux/permission_groups", "_acpmux/permission_group_respond", "_acpmux/permission_chat_revoke",
    "acp.session.fork", "acp.trust.get", "acp.trust.set", "_acpmux/harness_enable",
    "_acpmux/secret_submit", "_acpmux/archive", "_acpmux/markUnread",
    "_acpmux/harness/health", "_acpmux/side", "_acpmux/offer_respond", "_acpmux/start_mode",
    "_acpmux/subagent_stop", "_acpmux/subagent_transcript", "_acpmux/native_history", "_acpmux/agent_pair_resume", "_acpmux/app_reply", "_acpmux/watch_take_over",
    "_acpmux/process/list", "_acpmux/process/tail", "_acpmux/process/kill", "_acpmux/process/background",
    "_acpmux/session/auth", "_acpmux/route/list", "_acpmux/chat/route.set", "_acpmux/forum/rules", "_acpmux/set_tools",
    "_acpmux/mcp/reconnect", "_acpmux/subsession/limits",
    "_acpmux/agent_login/start", "_acpmux/agent_login/finish", "_acpmux/agent_login/api_key", "_acpmux/agent_login/cancel"
  ],
  "notifications": ["session/cancel"],
  "maximum_frame_bytes": 33554432,
  "servers_key": "mcpServers",
  "gesture_ticket_key": "cmuxGesture",
  "session_scoped": [
    "session/prompt", "session/set_mode", "session/set_config_option", "session/set_model", "session/cancel",
    "_acpmux/kill", "_acpmux/draft_get", "_acpmux/draft_set", "_acpmux/inbox_thread", "_acpmux/bookmark_get", "_acpmux/bookmark_set", "_acpmux/btw", "_acpmux/queue_remove", "_acpmux/queue_edit", "_acpmux/permission_respond", "_acpmux/permission_group_respond", "_acpmux/permission_chat_revoke",
    "_acpmux/secret_submit", "_acpmux/archive", "_acpmux/markUnread", "_acpmux/side",
    "_acpmux/offer_respond", "_acpmux/subagent_stop", "_acpmux/subagent_transcript", "_acpmux/native_history", "_acpmux/agent_pair_resume", "_acpmux/app_reply",
    "_acpmux/watch_take_over",
    "_acpmux/process/kill", "_acpmux/process/background", "_acpmux/chat/route.set", "_acpmux/set_tools",
    "_acpmux/mcp/reconnect", "_acpmux/subsession/limits"
  ],
  "optionally_session_scoped": [
    "acp.trust.get", "acp.trust.set", "_acpmux/session/auth",
    "_acpmux/agent_login/start", "_acpmux/agent_login/finish", "_acpmux/agent_login/api_key",
    "_acpmux/agent_login/cancel"
  ],
  "scoped_session_params": {"_acpmux/side": ["chat"]},
  "optional_scoped_session_params": {"_acpmux/offer_respond": ["childSessionId"]},
  "source_scoped": [
    "acp.session.fork", "_acpmux/handoff_prepare", "_acpmux/handoff_draft", "_acpmux/handoff_start",
    "_acpmux/handoff_discard", "_acpmux/retry"
  ],
  "gesture_rules": {
    "session/prompt": "always",
    "_acpmux/btw": "always",
    "session/set_mode": "always",
    "session/set_config_option": "always",
    "acp.trust.set": "when_trusting",
    "_acpmux/harness_enable": "always",
    "_acpmux/permission_respond": "when_option_allows",
    "_acpmux/permission_group_respond": "when_decision_allows",
    "_acpmux/secret_submit": "always",
    "_acpmux/agent_pair_resume": "always",
    "_acpmux/app_reply": "always",
    "_acpmux/agent_login/start": "always",
    "_acpmux/agent_login/api_key": "always"
  },
  "non_trusting_levels": ["untrusted", "unknown"],
  "setting_methods": ["session/set_mode", "session/set_config_option"],
  "known_params": {
    "initialize": {"params": ["protocolVersion", "clientInfo", "clientCapabilities"], "acpmux": []},
    "session/new": {"params": ["cwd", "mcpServers", "_meta"], "acpmux": ["harness", "adopt", "peer", "noProject", "model"]},
    "session/prompt": {"params": ["sessionId", "prompt", "_meta"], "acpmux": ["promptId", "steer", "interrupt", "context", "surface", "inlineParts"]},
    "session/set_model": {"params": ["sessionId", "modelId"], "acpmux": []},
    "session/cancel": {"params": ["sessionId"], "acpmux": []},
    "_acpmux/watch": {"params": ["enabled", "limit"], "acpmux": []},
    "_acpmux/sessions": {"params": ["limit", "cursor", "usage"], "acpmux": []},
    "_acpmux/events": {"params": ["sessionId", "afterSeq", "beforeSeq", "limit", "maxBytes", "kinds"], "acpmux": []},
    "_acpmux/attachment": {"params": ["sessionId", "id"], "acpmux": []},
    "_acpmux/peer_snapshot": {"params": ["sessionId"], "acpmux": []},
    "_acpmux/peer_reconnect": {"params": ["name", "wait"], "acpmux": []},
    "_acpmux/retry": {"params": ["sessionId", "subagentId"], "acpmux": []},
    "_acpmux/attach": {"params": ["sessionId", "limit", "maxBytes", "kinds", "eventStream", "visible", "waitLogs"], "acpmux": []},
    "_acpmux/detach": {"params": ["sessionId"], "acpmux": []},
    "_acpmux/view": {"params": ["sessionId", "visible"], "acpmux": []},
    "_acpmux/typing": {"params": ["sessionId", "on"], "acpmux": []},
    "_acpmux/warm": {"params": ["sessionIds", "limit"], "acpmux": []},
    "_acpmux/kill": {"params": ["sessionId", "purge"], "acpmux": []},
    "_acpmux/prewarm": {"params": ["harness", "cwd", "release"], "acpmux": []},
    "_acpmux/start_mode": {"params": ["harness", "cwd"], "acpmux": []},
    "_acpmux/harnesses": {"params": ["cwd"], "acpmux": []},
    "_acpmux/models": {"params": ["refresh"], "acpmux": []},
    "_acpmux/status": {"params": [], "acpmux": []},
    "_acpmux/peers": {"params": [], "acpmux": []},
    "_acpmux/draft_get": {"params": ["sessionId"], "acpmux": []},
    "_acpmux/inbox_thread": {"params": ["sessionId", "threadId"], "acpmux": []},
    "_acpmux/draft_set": {"params": ["sessionId", "text"], "acpmux": []},
    "_acpmux/bookmark_get": {"params": ["sessionId"], "acpmux": []},
    "_acpmux/bookmark_set": {"params": ["sessionId", "seq", "bookmarked"], "acpmux": []},
    "_acpmux/btw": {"params": ["sessionId", "question", "model", "inline"], "acpmux": []},
    "_acpmux/queue_remove": {"params": ["sessionId", "promptId"], "acpmux": []},
    "_acpmux/queue_edit": {"params": ["sessionId", "promptId", "op", "text", "images", "index"], "acpmux": []},
    "_acpmux/permission_respond": {"params": ["sessionId", "permissionId", "optionId", "answers", "annotations", "_meta"], "acpmux": []},
    "_acpmux/handoff_prepare": {"params": ["sessionId", "harness", "handoffKey"], "acpmux": []},
    "_acpmux/handoff_get": {"params": ["sessionId", "handoffId"], "acpmux": []},
    "_acpmux/handoff_draft": {"params": ["handoffId", "revision", "draftKey", "capsule", "checkpoint"], "acpmux": []},
    "_acpmux/handoff_start": {"params": ["handoffId", "revision", "promptId", "capsule", "checkpoint"], "acpmux": []},
    "_acpmux/handoff_discard": {"params": ["handoffId"], "acpmux": []},
    "_acpmux/permission_groups": {"params": ["sessionId"], "acpmux": []},
    "_acpmux/permission_group_respond": {"params": ["sessionId", "groupId", "revision", "decisionKey", "decision"], "acpmux": []},
    "_acpmux/permission_chat_revoke": {"params": ["sessionId"], "acpmux": []},
    "_acpmux/secret_submit": {"params": ["sessionId", "secretId", "value"], "acpmux": []},
    "_acpmux/archive": {"params": ["sessionId", "archived"], "acpmux": []},
    "_acpmux/markUnread": {"params": ["sessionId"], "acpmux": []},
    "_acpmux/harness/health": {"params": ["refresh", "rescan"], "acpmux": []},
    "_acpmux/forum/rules": {"params": [], "acpmux": []},
    "_acpmux/side": {"params": ["sessionId", "chat"], "acpmux": []},
    "_acpmux/offer_respond": {"params": ["sessionId", "offerId", "outcome", "childSessionId"], "acpmux": []},
    "_acpmux/subagent_transcript": {"params": ["sessionId", "runId", "agentId", "before", "after", "limit"], "acpmux": []},
    "_acpmux/native_history": {"params": ["sessionId", "before", "mark"], "acpmux": []},
    "_acpmux/subagent_stop": {"params": ["sessionId", "subagentSessionId"], "acpmux": []},
    "_acpmux/agent_pair_resume": {"params": ["sessionId", "peerSessionId"], "acpmux": []},
    "_acpmux/app_reply": {"params": ["sessionId", "to", "replyTo", "threadId", "text", "replyId"], "acpmux": []},
    "_acpmux/watch_take_over": {"params": ["sessionId", "ifLive"], "acpmux": []},
    "_acpmux/set_tools": {"params": ["sessionId", "id", "enabled"], "acpmux": []},
    "_acpmux/agent_login/start": {"params": ["agent", "sessionId"], "acpmux": []},
    "_acpmux/agent_login/finish": {"params": ["loginId", "code", "sessionId"], "acpmux": []},
    "_acpmux/agent_login/api_key": {"params": ["agent", "key", "sessionId"], "acpmux": []},
    "_acpmux/agent_login/cancel": {"params": ["loginId", "sessionId"], "acpmux": []},
    "_acpmux/process/list": {"params": ["sessionId"], "acpmux": []},
    "_acpmux/process/tail": {"params": ["processId", "maxBytes"], "acpmux": []},
    "_acpmux/process/kill": {"params": ["sessionId", "processId"], "acpmux": []},
    "_acpmux/process/background": {"params": ["sessionId", "toolCallId"], "acpmux": []},
    "_acpmux/route/list": {"params": ["sessionId"], "acpmux": []},
    "_acpmux/session/auth": {"params": ["sessionId", "target", "refresh"], "acpmux": []},
    "_acpmux/chat/route.set": {"params": ["sessionId", "routeId", "when"], "acpmux": []},
    "_acpmux/subsession/limits": {"params": ["sessionId", "maxRunning"], "acpmux": []},
    "_acpmux/mcp/reconnect": {"params": ["sessionId", "server"], "acpmux": []},
    "acp.session.fork": {"params": ["sessionId", "throughSeq", "live"], "acpmux": []},
    "acp.trust.get": {"params": ["cwd", "sessionId"], "acpmux": []},
    "acp.trust.set": {"params": ["cwd", "level", "sessionId"], "acpmux": []},
    "_acpmux/harness_enable": {"params": ["folder", "id"], "acpmux": []},
    "session/set_mode": {"params": ["sessionId", "modeId", "_meta"], "acpmux": []},
    "session/set_config_option": {"params": ["sessionId", "configId", "value", "_meta"], "acpmux": []}
  },
  "reply_shapes": {
    "_acpmux/status": {"object": {"peers": {"list": {"object": {"name": "string"}}}}},
    "_acpmux/peer_reconnect": {"object": {"peers": {"list": {"object": {"name": "string", "state": "string", "error": "string"}}}}},
    "_acpmux/peers": {"object": {"peers": {"list": {"object": {"name": "string", "state": "string", "lastSeen": "number", "error": "string"}}}}}
  },
  "history_replies": ["_acpmux/attach", "_acpmux/events"],
  "path_keys": ["cwd", "path", "additionalDirectories", "directory", "directories", "workingDirectory",
    "folder", "folders", "root", "roots", "worktree", "worktreePath"],
  "question_answers": {
    "description": "Answers are allowed only for a pending question (toolCall._meta.acpmux.question), as an object of 1 to maximum_items of its item ids or prompts; each value is a string, a list of at most maximum_list_strings strings, or Codex's {answers: [string]}. Each id and each string is at most maximum_value_bytes UTF-8 bytes; the bound is per string, never a list's strings together. Annotations (Claude Code's {preview?, notes?} per question) go only beside answers, keyed by the same items, each field a string of at most maximum_annotation_bytes. Swift (AcpmuxPaneMethods+Answers.swift) and Rust (src/answers.rs) enforce the same rule.",
    "method": "_acpmux/permission_respond",
    "param": "answers",
    "maximum_items": 64,
    "maximum_list_strings": 64,
    "maximum_value_bytes": 4096,
    "annotations_param": "annotations",
    "maximum_annotation_bytes": 65536
  }
}
