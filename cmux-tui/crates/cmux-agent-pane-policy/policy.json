  "question_answers": {
    "description": "Answers are allowed only for a pending question (toolCall._meta.acpmux.question), as an object of 1 to maximum_items of its item ids or prompts; each value is a string, a list of at most maximum_list_strings strings, or Codex's {answers: [string]}. Each id and each string is at most maximum_value_bytes UTF-8 bytes; the bound is per string, never a list's strings together. Annotations (Claude Code's {preview?, notes?} per question) go only beside answers, keyed by the same items, each field a string of at most maximum_annotation_bytes. Swift (AcpmuxPaneMethods+Answers.swift) and Rust (src/answers.rs) enforce the same rule.",
    "method": "_acpmux/permission_respond",
    "param": "answers",
    "maximum_items": 64,
    "maximum_list_strings": 64,
    "maximum_value_bytes": 4096,
    "annotations_param": "annotations",
    "maximum_annotation_bytes": 65536
  }
