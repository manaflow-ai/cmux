{
  "name": "cmux-extension-sdk",
  "version": "1.0.0",
  "description": "Build cmux extensions: typed places (sidebar sections, panes), live data, workspace, agent and chat events, and the scene DSL, for code cmux runs in its extension sandbox.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manaflow-ai/cmux.git",
    "directory": "cmux-tui/crates/cmux-extension-sdk/typescript"
  },
  "license": "MIT",
  "keywords": ["cmux", "extension", "sdk"],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./testing": { "types": "./src/testing.ts", "default": "./src/testing.ts" },
    "./web": { "types": "./src/web.ts", "default": "./src/web.ts" }
  },
  "files": ["src/", "runtime-files.json", "README.md"],
  "engines": { "cmux": "^2.0" }
}
