// The Claude desktop app's Code tab, dark: a neutral #191919 page, a neutral #151515 sidebar a step
// darker than the page with a 0.5 pt #2d2d2d hairline at its edge, a #393939 selected row, the clay
// accent kept for marks only. The page and composer are measured from the 2x pipeline captures of the
// app (home-empty-composer-import-banner, transcript-tool-call-row-user-bubble). That build has no
// capture of its sidebar, so the sidebar, its edge and its selected row keep the steps the live capture
// measures against its own page (code-home-overview: #111111 sidebar, #292929 edge and #353535 row on a
// #151515 page), moved onto this page: sidebar -4, edge +20, row +36 over the sidebar.
{
  "name": "Claude Code app",
  "description": "Neutral dark gray with a clay accent.",

  "appearance.theme": "Builtin Dark",
  // The window, sidebar and pages take these colors, over an App Theme of your own.
  "appearance.appTheme": "followTerminal",
  // Page, chat prose ink, selected row card, clay.
  "colors": { "background": "#191919", "foreground": "#efefef", "selection": "#393939", "accent": "#d97757" },
  // The app keeps its chrome neutral: clay shows only on the logo and the working mark.
  "appearance.accent": "neutral",

  "appearance.background": "none",
  "appearance.backgroundBlur": "none",
  // A flat window with the one line between the sidebar and the chat.
  "appearance.chromeStyle": "flat-sidebar-line",
  "appearance.borders": "default",

  "appearance.sidebarSurface": "separate",
  "appearance.surfaces.sidebar.color": "#151515",
  "appearance.surfaces.sidebar.opacity": 1,
  "appearance.surfaces.agentPane.color": "#191919",
  "appearance.surfaces.agentPane.opacity": 1,
  "appearance.surfaces.tabBar.color": "#191919",
  "appearance.surfaces.tabBar.opacity": 1,
  "appearance.surfaces.newTabPage.color": "#191919",
  "appearance.surfaces.newTabPage.opacity": 1,
  "appearance.surfaces.splitDivider.color": "#2d2d2d",
  "appearance.surfaces.splitDivider.opacity": 1,
  // The app's edge is one device pixel at 2x: 0.5 pt, the thinnest this setting takes.
  "sidebar.border": true,
  "sidebar.borderWidth": 0.5,
  "sidebar.sectionLook": "quiet",
  "appearance.statusIndicator.style": "dot",
  "appearance.statusIndicator.color": "#d97757"
  // No appearance.density: the app's sidebar rows are 26 pt tall (code-home-overview), nearer cmux's
  // Default (28 pt) than Comfortable (30 pt), and Compact (26 pt) would also shrink the text by 0.9. So
  // the look keeps your own density and moves no row.
}
