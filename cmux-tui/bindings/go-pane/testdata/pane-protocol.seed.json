{
  "version": "0.1.0",
  "namespaces": [
    { "name": "cmux", "owner": "first-party" },
    { "name": "com.example.hello", "owner": "app:com.example.hello" }
  ],
  "ops": [
    {
      "name": "cmux.git.status",
      "kind": "read",
      "scope": "git:read",
      "params": { "$ref": "#/types/GitStatusParams" },
      "result": { "$ref": "#/types/GitStatus" },
      "errors": ["cmux.git.not_a_repo"]
    },
    {
      "name": "cmux.git.diff",
      "kind": "read",
      "scope": "git:read",
      "params": { "$ref": "#/types/GitDiffParams" },
      "result": { "$ref": "#/types/GitDiff" },
      "errors": ["cmux.git.not_a_repo", "cmux.git.bad_ref"]
    },
    {
      "name": "com.example.hello.greet.say",
      "kind": "read",
      "scope": "com.example.hello:use",
      "params": { "$ref": "#/types/HelloParams" },
      "result": { "$ref": "#/types/HelloResult" },
      "errors": []
    }
  ],
  "events": [
    { "name": "cmux.git.status.changed", "scope": "git:read", "data": { "$ref": "#/types/GitStatus" } }
  ],
  "interfaces": [
    { "name": "cmux.diff.source/1", "ops": ["list", "open"], "events": ["changed"] }
  ],
  "types": {
    "GitStatusParams": { "type": "object", "properties": { "cwd": { "type": "string" } }, "required": ["cwd"], "additionalProperties": false },
    "GitFileStatus": { "type": "object", "properties": { "path": { "type": "string" }, "index": { "type": "string" }, "worktree": { "type": "string" } }, "required": ["path", "index", "worktree"], "additionalProperties": false },
    "GitStatus": { "type": "object", "properties": { "branch": { "type": ["string", "null"] }, "files": { "type": "array", "items": { "$ref": "#/types/GitFileStatus" } } }, "required": ["branch", "files"], "additionalProperties": false },
    "GitDiffParams": { "type": "object", "properties": { "cwd": { "type": "string" }, "base": { "type": ["string", "null"] }, "include_patch": { "type": "boolean" } }, "required": ["cwd"], "additionalProperties": false },
    "GitDiffFile": { "type": "object", "properties": { "path": { "type": "string" }, "additions": { "type": "integer" }, "deletions": { "type": "integer" }, "patch": { "type": ["string", "null"] } }, "required": ["path", "additions", "deletions"], "additionalProperties": false },
    "GitDiff": { "type": "object", "properties": { "files": { "type": "array", "items": { "$ref": "#/types/GitDiffFile" } } }, "required": ["files"], "additionalProperties": false },
    "HelloParams": { "type": "object", "properties": { "name": { "type": "string" } }, "required": ["name"], "additionalProperties": false },
    "HelloResult": { "type": "object", "properties": { "message": { "type": "string" } }, "required": ["message"], "additionalProperties": false }
  }
}
