            "saved"
          ],
          "fields": {
            "saved": {
              "type": "SavedScreenGroupID"
            }
          },
          "response": "EmptyResponse"
        },
        "remove-screens-from-screen-group": {
          "name": "RemoveScreensFromScreenGroupRequest",
