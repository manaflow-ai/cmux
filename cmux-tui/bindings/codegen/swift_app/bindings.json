              "type": "String"
            }
          },
          "response": "IconAssetBlob"
        }
      }
    },
    "Bookmarks": {
      "objects": {
        "BookmarkRecord": {
          "type": "Bookmark",
          "doc": [
            "One bookmark node as the daemon reports it (`bookmarks-v1`; plans/cmux-next/bookmarks.md section 2.1)."
          ],
          "order": [
            "id",
            "browser_profile_id",
            "parent",
            "kind",
            "index",
            "title",
            "url",
            "favicon_key",
            "source_key",
            "created_ms",
            "last_used_ms",
            "icon"
          ],
          "fields": {
            "index": {
              "type": "Int"
            },
            "created_ms": {
              "type": "Int64"
            },
            "last_used_ms": {
              "type": "Int64"
            },
            "icon": {
              "doc": [
                "A folder's icon (`bookmark-icon-v1`): one emoji, an SF Symbol name or a",
                "stored `image:`/`svg:sha256-<hex>` asset. Nil for none, for a URL",
                "bookmark, and from a daemon without the capability."
              ]
            }
          }
        },
        "BookmarkList": {
          "result": "list-bookmarks",
          "doc": [
            "`list-bookmarks` data."
          ],
          "order": [
            "bookmarks_revision",
            "bookmarks"
          ],
          "fields": {
            "bookmarks_revision": {
              "name": "revision"
            }
          }
        },
        "BookmarkResult": {
          "type": "BookmarkChangeResult",
          "doc": [
            "`create-bookmark`, `update-bookmark` and `move-bookmark` data."
          ],
          "order": [
            "bookmark",
            "changed",
            "replayed"
          ],
          "fields": {
            "changed": {
              "optional": true
            },
            "replayed": {
              "optional": true,
              "doc": [
                "True when the daemon replayed an earlier write with the same mutation key."
              ]
            }
          }
        },
        "BookmarkDeletion": {
          "result": "delete-bookmark",
          "doc": [
            "`delete-bookmark` data."
          ],
          "order": [
            "deleted"
          ],
          "omit": [
            "replayed"
          ]
        },
        "BookmarkImportNode": {
          "type": "BookmarkImportNode",
          "conformances": [
            "Encodable",
            "Sendable",
            "Equatable"
          ],
          "doc": [
            "A node of `import-bookmarks`: a folder with children or a URL."
          ],
          "order": [
            "kind",
            "title",
            "url",
            "created_ms",
            "children"
          ],
          "fields": {
            "created_ms": {
              "type": "Int64"
            }
          }
        },
        "BookmarkImportResult": {
          "result": "import-bookmarks",
          "doc": [
            "`import-bookmarks` data."
          ],
          "order": [
            "root_ids",
            "count"
          ],
          "omit": [
            "replayed"
          ],
          "fields": {
            "count": {
              "type": "Int"
            }
          }
        }
      }
    },
    "Conversations": {
      "objects": {
        "ConversationList": {
          "result": "conversation-list",
          "doc": [
            "`conversation-list` data."
          ]
        },
        "ConversationSnapshot": {
          "result": "conversation-snapshot",
