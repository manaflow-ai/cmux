          ],
          "fields": {
            "screens": {
              "type": "[ScreenID]"
            },
            "name": {
              "type": "String"
            },
            "color": {
              "type": "String"
            }
          },
          "response": "ScreenGroupResult"
        },
        "delete-saved-screen-group": {
          "name": "DeleteSavedScreenGroupRequest",
