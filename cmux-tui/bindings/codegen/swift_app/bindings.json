{
  "$comment": "What the SDK schema cannot say about the Swift side of each generated CmuxNextDaemon request type (swift_app/emit.py explains the rules). A family is one Requests/<Family> folder; it moves here from hand-written Swift in one change.",
  "output_root": "Packages/macOS/CmuxNext/Sources/CmuxNextDaemon/Requests",
  "ids": {},
  "types": {},
  "families": {
    "Agents": {
      "requests": {
        "list-agents": {
          "name": "ListAgentsRequest",
          "response": "generate",
          "response_fields": {
            "agents": {
              "type": "[AgentStatus]"
            }
          },
          "response_order": [
            "agents"
          ],
          "order": [
            "surface",
            "state"
          ],
          "fields": {
            "surface": {
              "type": "SurfaceID"
            },
            "state": {
              "type": "AgentState"
            }
          }
        },
        "feed-local-handoff-abort": {
          "name": "FeedLocalHandoffAbortRequest",
          "doc": [
            "`feed-local-handoff-abort {item}` (the verified app connection only): the",
            "cloud owner answered `feed.adopt.cancel` with `cancelled: true`, so the",
            "item is open here again. Never on a timeout or a lost reply."
          ],
          "order": [
            "item"
          ],
          "response": "FeedLocalHandoffBeginRequest.Response"
        },
        "feed-local-handoff-done": {
          "name": "FeedLocalHandoffDoneRequest",
          "doc": [
            "`feed-local-handoff-done {item, home}` (the verified app connection only):",
            "the new owner committed the item; it becomes `moved`."
          ],
          "order": [
            "item",
            "home"
          ],
          "response": "FeedLocalHandoffBeginRequest.Response"
        }
      }
    },
    "Bookmarks": {
      "requests": {
        "list-bookmarks": {
          "name": "ListBookmarksRequest",
          "doc": [
            "`list-bookmarks`: one profile's nodes, ordered by parent then index."
          ],
          "order": [
            "browser_profile_id"
          ],
          "response": "BookmarkList"
        },
        "create-bookmark": {
          "name": "CreateBookmarkRequest",
          "doc": [
            "`create-bookmark`: an existing `bookmark` id returns the stored node."
          ],
          "order": [
            "bookmark",
            "browser_profile_id",
            "parent",
            "index",
            "kind",
            "title",
            "url",
            "favicon_key",
            "source_key",
            "created_ms",
            "mutation"
          ],
          "fields": {
            "index": {
              "type": "Int"
            },
            "created_ms": {
              "type": "Int64"
            }
          },
          "groups": {
            "mutation": {
              "type": "MutationIdentity?",
              "doc": [
                "The exactly-once key; reuse it on every retry of this write."
              ],
              "wire": [
                "origin",
                "mutation_id"
              ],
              "encode": "MutationFields(identity: mutation)"
            }
          },
          "response": "BookmarkResult"
        },
        "update-bookmark": {
          "name": "UpdateBookmarkRequest",
          "doc": [
            "`update-bookmark`: absent keeps; `.clear` sends null. `icon`",
            "(`bookmark-icon-v1`) is for folders only: the daemon refuses it, null",
            "included, on a URL bookmark, and an asset icon must already be stored there."
          ],
          "order": [
            "bookmark",
            "title",
            "url",
            "favicon_key",
            "last_used_ms",
            "icon",
            "mutation"
          ],
          "fields": {
            "favicon_key": {
              "update": true
            },
            "last_used_ms": {
              "update": true,
              "type": "Int64"
            },
            "icon": {
              "update": true
            }
          },
          "groups": {
            "mutation": {
              "type": "MutationIdentity?",
              "wire": [
                "origin",
                "mutation_id"
              ],
              "encode": "MutationFields(identity: mutation)"
            }
          },
          "response": "BookmarkResult"
        },
        "move-bookmark": {
          "name": "MoveBookmarkRequest",
          "doc": [
            "`move-bookmark`: `index` is the final position among the new siblings."
          ],
          "order": [
            "bookmark",
            "parent",
            "index",
            "mutation"
          ],
          "fields": {
            "index": {
              "type": "Int"
            }
          },
          "groups": {
            "mutation": {
              "type": "MutationIdentity?",
              "wire": [
                "origin",
                "mutation_id"
              ],
              "encode": "MutationFields(identity: mutation)"
            }
          },
          "response": "BookmarkResult"
        },
        "delete-bookmark": {
          "name": "DeleteBookmarkRequest",
          "doc": [
            "`delete-bookmark`: removes the node and its subtree."
          ],
          "order": [
            "bookmark",
            "mutation"
          ],
          "groups": {
            "mutation": {
              "type": "MutationIdentity?",
              "wire": [
                "origin",
                "mutation_id"
              ],
              "encode": "MutationFields(identity: mutation)"
            }
          },
          "response": "BookmarkDeletion"
        },
        "import-bookmarks": {
          "name": "ImportBookmarksRequest",
          "doc": [
            "`import-bookmarks`: one transaction. With `sourceKey` and `replace`, the",
            "folder carrying `sourceKey` keeps its id and position and takes",
            "`nodes[0]`'s title and children."
          ],
          "order": [
            "browser_profile_id",
            "parent",
            "index",
            "source_key",
            "replace",
            "nodes",
            "mutation"
          ],
          "fields": {
            "index": {
              "type": "Int"
            },
            "nodes": {
              "type": "[BookmarkImportNode]"
            }
          },
          "groups": {
            "mutation": {
              "type": "MutationIdentity?",
              "wire": [
                "origin",
                "mutation_id"
              ],
              "encode": "MutationFields(identity: mutation)"
            }
          },
          "response": "BookmarkImportResult"
        }
      }
    },
    "Layout": {
      "requests": {
        "set-split-ratio": {
          "name": "SetSplitRatioRequest",
          "doc": [
            "Divider drag. Reuse one `transaction` per gesture so undo coalesces."
          ],
          "order": [
            "split",
            "ratio",
            "transaction"
          ],
          "fields": {
            "split": {
              "type": "SplitID"
            },
            "ratio": {
              "doc": [
                "Clamped by the daemon to 0.05...0.95."
              ]
            }
          }
        },
        "move-column": {
          "name": "MoveColumnRequest",
          "doc": [
            "Moves the whole viewport column holding `pane` (every pane, split and",
            "row in it) one place left or right (`column-move-v1`). The daemon refuses",
            "a column at the strip's edge or next to a docked column",
            "(`column-move-edge`) and a docked column (`column-move-docked`)."
          ],
          "order": [
            "pane",
            "direction"
          ],
          "fields": {
            "pane": {
              "type": "PaneID",
              "doc": [
                "Any pane of the column that moves."
              ]
            },
            "direction": {
              "type": "ColumnMoveDirection"
            }
          },
          "response": "EmptyResponse"
        },
        "set-divider-visible": {
          "name": "SetDividerVisibleRequest",
          "doc": [
            "A split's divider drawn or not (`split-divider-visibility-v1`): a hidden divider draws no line",
            "and still drags. The daemon keeps it on the split node, so it persists with the layout."
          ],
          "order": [
            "split",
            "visible"
          ],
          "fields": {
            "split": {
              "type": "SplitID"
            }
          },
          "capability": null
        },
        "set-viewport-pane-width": {
          "name": "SetColumnWidthRequest",
          "doc": [
            "Column width drag (`viewport-column-resize-v1`)."
          ],
          "order": [
            "pane",
            "width",
            "transaction"
          ],
          "fields": {
            "pane": {
              "type": "PaneID"
            },
            "width": {
              "doc": [
                "0.1...1.0 of the viewport."
              ]
            }
          },
          "response": "EmptyResponse",
          "capability": null
        },
        "set-row-heights": {
          "name": "SetRowHeightsRequest",
          "doc": [
            "`set-row-heights` (`rows-v1`): every row of one column at once. `fit`",
            "requires a sum of exactly 1000."
          ],
          "order": [
            "column",
            "heights",
            "fit",
            "transaction"
          ],
          "fields": {
            "column": {
              "type": "ColumnID"
            },
            "heights": {
              "type": "[RowHeightValue]"
            },
            "fit": {
              "required": true,
              "default": "false"
            }
          },
          "response": "EmptyResponse"
        }
      }
    },
