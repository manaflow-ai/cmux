          "response_fields": {
            "saved_groups": {
              "type": "[SavedTabGroupSnapshot]"
            }
          },
          "response_order": [
            "saved_groups"
          ],
          "doc": [
            "Every saved record."
          ]
        },
        "save-tab-group": {
          "name": "SaveTabGroupRequest",
          "response": "generate",
          "response_fields": {
            "group": {
              "type": "TabGroupID"
            },
            "saved": {
              "type": "SavedTabGroupID"
            }
          },
          "response_order": [
            "group",
            "saved"
          ],
          "doc": [
            "Saves a live group. Result: `{group, saved}` (the record id)."
          ],
          "order": [
            "group"
          ],
          "fields": {
            "group": {
              "type": "TabGroupID"
            }
          }
        },
        "list-tab-groups": {
          "name": "ListTabGroupsRequest",
          "response": "generate",
          "response_fields": {
            "groups": {
              "type": "[TabGroupSnapshot]"
            }
          },
          "response_order": [
            "groups"
          ],
          "doc": [
            "Every live group with its pane, in the `Pane.tab_groups` shape."
          ]
        },
        "move-tab-group-to-split": {
          "name": "MoveTabGroupToSplitRequest",
          "doc": [
            "Drops a whole group on a pane edge."
          ],
          "order": [
            "group",
            "pane",
            "edge",
            "ratio",
            "transaction"
          ],
          "fields": {
            "group": {
              "type": "TabGroupID"
            },
            "pane": {
              "type": "PaneID"
            },
            "edge": {
              "type": "PaneEdge"
            },
            "transaction": {
              "type": "ClientTransactionID"
            }
          },
          "response": "TabGroupResult"
        },
        "move-tab-group-to-new-workspace": {
          "name": "MoveTabGroupToNewWorkspaceRequest",
          "doc": [
            "Drops a whole group on the sidebar: a new workspace holding the group,",
            "optionally in a sidebar group at a section index. Tear-off = this + open",
            "the returned workspace in a new window."
          ],
          "order": [
            "group",
            "workspace_group",
            "index",
            "transaction"
          ],
          "fields": {
            "group": {
              "type": "TabGroupID"
            },
            "workspace_group": {
              "type": "WorkspaceGroupID",
              "doc": [
                "Sidebar (workspace) group for the new workspace."
              ]
            },
            "index": {
              "type": "Int"
            },
            "transaction": {
              "type": "ClientTransactionID"
            }
          },
          "response": "TabGroupResult"
        },
        "remove-tabs-from-tab-group": {
          "name": "RemoveTabsFromGroupRequest",
          "doc": [
            "Removes tabs from their groups; each lands just after its former group.",
            "A group left without members disappears."
          ],
          "order": [
            "surfaces",
            "transaction"
          ],
          "fields": {
            "surfaces": {
              "type": "[SurfaceID]",
              "name": "tabs",
              "doc": [
                "Wire `surfaces`."
              ]
            },
            "transaction": {
              "type": "ClientTransactionID"
            }
          },
          "response": "TabGroupResult"
        },
        "move-tab-group": {
          "name": "MoveTabGroupRequest",
          "doc": [
            "Reorders a group in its strip or moves it into another pane at `index`."
          ],
          "order": [
            "group",
            "pane",
            "index",
            "transaction"
          ],
          "fields": {
            "group": {
              "type": "TabGroupID"
            },
            "pane": {
              "required": true,
              "type": "PaneID"
            },
            "index": {
              "required": true,
              "type": "Int"
            },
            "transaction": {
              "type": "ClientTransactionID"
            }
          },
          "response": "TabGroupResult"
        }
      }
    },
    "TabMove": {
      "requests": {
        "move-tab": {
          "name": "MoveTabRequest",
          "doc": [
            "Reorder within a strip or move into any pane (across screens and",
            "workspaces). Pinned tabs stay first (`tab-metadata-v1`)."
          ],
          "order": [
            "surface",
            "pane",
            "index",
            "transaction"
          ],
          "fields": {
            "surface": {
              "type": "SurfaceID"
            },
            "pane": {
              "type": "PaneID"
            },
            "index": {
              "type": "Int"
            },
            "transaction": {
              "type": "ClientTransactionID",
              "doc": [
                "Echoed in `tab-changed` (`tab-drag-v1`); 1-128 printable ASCII."
              ]
            }
          },
          "response": "TabMoveResult"
        },
        "move-tab-to-new-workspace": {
          "name": "MoveTabToNewWorkspaceRequest",
          "doc": [
            "Drop on the sidebar: new workspace holding the tab, optionally in a group",
            "at a final section index. Tear-off = this + open the workspace in a new window."
          ],
          "order": [
            "surface",
            "group",
            "index",
            "name",
            "transaction"
          ],
          "fields": {
            "surface": {
              "type": "SurfaceID"
            },
            "group": {
              "type": "WorkspaceGroupID"
            },
            "index": {
              "type": "Int"
            },
            "name": {
              "doc": [
                "The new workspace's name (`tab-workspace-name-v1`); nil keeps the",
                "daemon's default. Sent only to a daemon that advertises it."
              ]
            },
            "transaction": {
              "type": "ClientTransactionID"
            }
          },
          "response": "TabMoveResult"
        },
        "move-tab-to-workspace": {
          "name": "MoveTabToWorkspaceRequest",
          "doc": [
            "Move into an existing workspace's active pane, or a new workspace when",
            "`workspace` is nil (`tab-workspace-move-v1`)."
          ],
          "order": [
            "surface",
            "workspace",
            "transaction"
          ],
          "fields": {
            "surface": {
              "type": "SurfaceID"
            },
            "workspace": {
              "type": "WorkspaceHandle"
            },
            "transaction": {
              "type": "ClientTransactionID"
            }
          },
          "response": "TabMoveResult",
          "capability": null
        },
        "move-tab-to-split": {
          "name": "MoveTabToSplitRespawnRequest",
          "doc": [
            "`move-tab-to-split` with `respawn`: one owner op that moves the tab into",
            "a new pane beside its own pane and spawns `respawn` in the pane it left.",
            "It can launch a terminal host, so it uses the spawn deadline."
          ],
          "protocol": "TerminalSpawningRequest",
          "order": [
            "surface",
            "pane",
            "edge",
            "ratio",
            "respawn",
            "transaction"
          ],
          "fields": {
            "surface": {
              "type": "SurfaceID"
            },
            "pane": {
              "type": "PaneID"
            },
            "edge": {
              "type": "PaneEdge"
            },
            "respawn": {
              "required": true,
              "type": "SplitRespawn"
            },
            "transaction": {
              "type": "ClientTransactionID"
            }
          },
          "response": "TabMoveResult",
          "capability": "tab-split-respawn-v1"
        }
      }
    },
    "Tabs": {
      "requests": {
        "close-surface": {
          "name": "CloseTabRequest",
          "order": [
            "surface"
          ],
          "fields": {
            "surface": {
              "type": "SurfaceID"
            }
          }
        },
        "rename-surface": {
          "name": "RenameTabRequest",
          "doc": [
            "Renames a tab. Empty name clears it."
          ],
          "order": [
            "surface",
            "name"
          ],
          "fields": {
            "surface": {
              "type": "SurfaceID"
            }
          }
        },
        "rename-pane": {
          "name": "RenamePaneRequest",
          "order": [
            "pane",
            "name"
          ],
          "fields": {
            "pane": {
              "type": "PaneID"
            }
          }
        },
        "rename-screen": {
          "name": "RenameScreenRequest",
          "order": [
            "screen",
            "name"
          ],
          "fields": {
            "screen": {
              "type": "ScreenID"
            }
          }
        }
      }
    },
    "TerminalIO": {
      "requests": {
        "send-key": {
          "name": "SendKeyRequest",
          "order": [
            "surface",
            "keys"
          ],
          "fields": {
            "surface": {
              "type": "SurfaceID"
            }
          }
        },
        "set-client-sizing": {
          "name": "SetClientSizingRequest",
          "doc": [
            "Claims (`enabled && exclusive`) or releases canonical geometry."
          ],
          "order": [
            "surface",
            "enabled",
            "exclusive",
            "client"
          ],
          "fields": {
            "surface": {
              "type": "SurfaceID"
            },
            "client": {
              "type": "ClientID"
            }
          }
        }
      }
    },
    "Terminals": {
      "requests": {
        "list-terminals": {
          "name": "ListTerminalsRequest",
          "doc": [
            "`list-terminals`: every terminal in the daemon's registry with its",
            "workspace and, once ended, its exit record (cmux-tui terminal-host.md)."
          ],
          "response": "TerminalRegistryList"
        }
      }
    },
    "Workspace": {
      "requests": {
        "get-blob": {
          "name": "GetBlobRequest",
          "doc": [
            "`get-blob`: `blob` is `blob:sha256-<hex>` or an asset icon value."
          ],
          "order": [
            "blob"
          ],
          "response": "IconAssetBlob"
        }
      }
    },
    "Creation": {
      "requests": {
        "new-screen": {
          "name": "NewScreenRequest",
          "protocol": "TerminalSpawningRequest",
          "order": [
            "workspace",
            "size"
          ],
          "fields": {
            "workspace": {
              "type": "WorkspaceHandle"
            }
          },
          "groups": {
            "size": {
              "type": "CellSize?",
              "default": "nil",
              "members": {
                "cols": "size?.cols",
                "rows": "size?.rows"
              }
            }
          },
          "response": "SurfaceCreated"
        },
        "new-pane": {
          "name": "NewPaneRequest",
          "doc": [
            "Adds a pane to the pane's column (vertical stack inside a column)."
          ],
          "protocol": "TerminalSpawningRequest",
          "order": [
            "pane",
            "options"
          ],
          "fields": {
            "pane": {
              "type": "PaneID"
            }
          },
          "groups": {
            "options": {
              "type": "SpawnOptions",
              "default": "SpawnOptions()",
              "wire": [
                "cwd",
                "cols",
                "rows",
                "env",
                "keep",
                "terminal_id",
                "shell_args",
                "pane_id",
                "tab_id"
              ]
            }
          },
          "response": "SurfaceCreated"
        }
      }
    }
  }
}
