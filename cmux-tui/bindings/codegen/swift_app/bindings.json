          }
        },
        "ConversationHistory": {
          "result": "conversation-history",
          "doc": [
            "`conversation-history` data: one older page, ascending."
          ],
          "order": [
            "messages",
            "threads"
          ],
          "fields": {
            "threads": {
              "default": "[]",
              "doc": [
                "The owner's stats of the thread roots in `messages` (`conversation-thread-v1`)."
              ]
            }
          }
        },
        "ConversationCreated": {
          "result": "conversation-create",
