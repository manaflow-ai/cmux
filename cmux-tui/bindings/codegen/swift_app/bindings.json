              "type": "ScreenID"
            },
            "name": {
              "type": "String"
            }
          },
          "response": "EmptyResponse"
        },
        "rename-surface": {
          "name": "RenameTabRequest",
          "doc": [
            "Renames a tab. Empty name clears it."
          ],
          "order": [
            "surface",
            "name"
          ],
          "fields": {
            "surface": {
              "type": "SurfaceID"
            },
            "name": {
              "type": "String"
            }
          },
          "response": "EmptyResponse"
        }
      }
    },
    "TerminalIO": {
      "requests": {
