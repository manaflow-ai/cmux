            },
            "screens": {
              "type": "[ScreenID]"
            },
            "index": {
              "type": "Int"
            }
          },
          "response": "ScreenGroupResult"
        },
        "create-screen-group": {
          "name": "CreateScreenGroupRequest",
          "order": [
            "screens",
