          ],
          "order": [
            "screens"
          ],
          "fields": {
            "screens": {
              "type": "[ScreenID]"
            }
          },
          "response": "ScreenGroupResult"
        },
        "save-screen-group": {
          "name": "SaveScreenGroupRequest",
          "order": [
            "group"
          ],
          "fields": {
            "group": {
              "type": "ScreenGroupID"
            }
          },
          "response": "ScreenGroupResult"
        },
        "ungroup-screen-group": {
          "name": "UngroupScreenGroupRequest",
          "order": [
            "group"
          ],
          "fields": {
            "group": {
              "type": "ScreenGroupID"
            }
          },
          "response": "ScreenGroupResult"
        },
        "unsave-screen-group": {
          "name": "UnsaveScreenGroupRequest",
          "order": [
            "group"
          ],
          "fields": {
            "group": {
              "type": "ScreenGroupID"
            }
          },
          "response": "ScreenGroupResult"
        }
      }
    },
    "Session": {
      "requests": {
        "remote-host-status": {
          "name": "RemoteHostStatusRequest",
          "doc": [
            "`remote-host-status` (`remote-host-v1`, docs/cmux-remote.md): cmux Remote's state as the",
            "daemon sees it (never starts the host)."
          ],
          "order": [],
          "response": "JSONValue"
        }
      }
    },
    "TabGroups": {
      "requests": {
        "move-tab-group-to-split": {
          "name": "MoveTabGroupToSplitRequest",
          "doc": [
            "Drops a whole group on a pane edge."
          ],
          "order": [
            "group",
            "pane",
            "edge",
            "ratio",
            "transaction"
          ],
          "fields": {
            "group": {
              "type": "TabGroupID"
            },
            "pane": {
              "type": "PaneID"
            },
            "edge": {
              "type": "PaneEdge"
            },
            "ratio": {
              "type": "Double"
            },
            "transaction": {
              "type": "ClientTransactionID"
            }
          },
          "response": "TabGroupResult"
        },
        "reopen-saved-tab-group": {
          "name": "ReopenSavedTabGroupRequest",
          "doc": [
            "Reopens a saved group into `pane`. A still-linked live group is returned",
            "unchanged; otherwise running terminals reattach, others start in their",
            "saved directory, and browsers reopen at their saved URL."
          ],
          "order": [
            "saved",
            "pane",
            "transaction"
          ],
          "fields": {
            "saved": {
              "type": "SavedTabGroupID"
            },
            "pane": {
              "type": "PaneID"
            },
            "transaction": {
              "type": "ClientTransactionID"
            }
          },
          "response": "TabGroupResult"
        }
      }
    },
    "Tabs": {
