{
  "name": "cmux-presence-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "bun test",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p tsconfig.test.json && tsgo --noEmit -p tsconfig.e2e.json",
    "relay-catalog:check": "bun ../../web/tools/generate-managed-iroh-relay-catalog.ts --check",
    "check": "bun run relay-catalog:check && bun run typecheck && bun test && bun run test:e2e && wrangler deploy --dry-run --outdir dist",
    "test:e2e": "node e2e/account.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260525.0",
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "7.0.0-dev.20260616.1",
    "typescript": "^5.8.0",
    "wrangler": "^4.20.0",
    "miniflare": "4.20260601.0",
    "esbuild": "0.27.3"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-beta.22",
    "zod": "4.3.6"
  }
}
