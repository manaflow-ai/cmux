    },
    "delete_placeholder_branding": {
      "status": "denied",
      "reason": "Placeholder branding is one account-wide setting for every verified domain of every tenant; a tenant cannot own it."
    },
    "get_placeholder_branding": {
      "status": "denied",
      "reason": "Placeholder branding is one account-wide setting for every verified domain of every tenant; a tenant cannot own it."
    },
    "set_placeholder_branding": {
      "status": "denied",
      "reason": "Placeholder branding is one account-wide setting for every verified domain of every tenant; letting one tenant set it would change every other tenant's pages."
    },
