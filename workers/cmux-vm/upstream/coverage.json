    "list_hardware": {
      "status": "denied",
      "reason": "Physical machines attached to the provider account's private networks are operator infrastructure, not tenant resources."
    },
    "get_hardware_power": {
      "status": "denied",
      "reason": "Physical machine power state is operator infrastructure, not a tenant resource."
    },
    "set_hardware_power": {
      "status": "denied",
      "reason": "Switches a real power outlet on operator hardware; never exposed to tenants."
    },
    "upsert_customer": {
      "status": "denied",
      "reason": "Customer profiles are account-wide provider abuse-protection records keyed by our own ids; cmux VM sets each VM's customer inline on create from the caller's tenant id and never lets a tenant read or write a profile."
    },
    "get_customer": {
      "status": "denied",
