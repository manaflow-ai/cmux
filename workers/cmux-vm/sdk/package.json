{
  "name": "@cmux/vm",
  "version": "0.1.0",
  "description": "TypeScript client for the cmux VM API, generated from its OpenAPI document",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "bun install --cwd codegen --frozen-lockfile && bun codegen/node_modules/openapi-typescript/bin/cli.js ../openapi.json --output src/schema.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "bun run generate && bun run typecheck"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
