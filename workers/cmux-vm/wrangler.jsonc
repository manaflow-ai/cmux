{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // cmux VM API. Top level is local development (`wrangler dev`) and tests.
  // Secrets, set per environment by the deploy workflow from GitHub
  // environment secrets (never committed, never printed):
  //   UPSTREAM_API_KEY, STACK_PROJECT_ID, STACK_SECRET_SERVER_KEY
  // Optional Worker secret, set by the operator with `wrangler secret put` (not by the deploy):
  //   STACK_WEBHOOK_SECRET  Stack webhook signing secret; without it POST /v1/webhooks/stack answers 503.
  "name": "cmux-vm-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ENVIRONMENT": "local",
    "STACK_API_URL": "https://api.stack-auth.com",
    "UPSTREAM_API_URL": "https://api.freestyle.sh",
    "CMUX_VM_MESH_EXPERIMENT": "0",
    "CMUX_VM_MESH_TENANT_IDS": "",
    "CMUX_VM_MESH_SERVICE_IDS": ""
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://cmux_vm:cmux_vm@127.0.0.1:5432/cmux_vm"
    }
  ],
  // One Durable Object per tenant: rate limits, quota reservations and
  // idempotency keys (src/limits/). Bindings are not inherited by
  // environments, so each environment repeats them.
  "durable_objects": { "bindings": [{ "name": "TENANT_LIMITS", "class_name": "TenantLimitsObject" }] },
  "migrations": [{ "tag": "v1-tenant-limits", "new_sqlite_classes": ["TenantLimitsObject"] }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true }
  },
  "env": {
    // Environments carry no Hyperdrive id: scripts/deploy.sh resolves the
    // config named cmux-vm-<env> through the Cloudflare API at deploy time and
    // writes it into wrangler.generated.json. The top-level placeholder id is
    // for wrangler dev and the tests only.
    // scripts/deploy.sh renames the preview Worker per lane branch
    // (feat-cmux-vm-s2 deploys cmux-vm-preview-s2), so lanes do not overwrite
    // each other; they share the preview Hyperdrive config.
    "preview": {
      "name": "cmux-vm-preview",
      "workers_dev": true,
      // The tunnel orphan sweep runs wherever the VM API runs (src/cron-plan.ts): a revoke's 200 relies on it. In
      // preview the cron runs only that sweep.
      "triggers": { "crons": ["*/5 * * * *"] },
      "durable_objects": { "bindings": [{ "name": "TENANT_LIMITS", "class_name": "TenantLimitsObject" }] },
      "migrations": [{ "tag": "v1-tenant-limits", "new_sqlite_classes": ["TenantLimitsObject"] }],
      "vars": {
        "ENVIRONMENT": "preview",
        "STACK_API_URL": "https://api.stack-auth.com",
        "UPSTREAM_API_URL": "https://api.freestyle.sh",
        // Mesh experiment (cx-0op): off. "1" plus listed team ids turns it on for those teams only.
        "CMUX_VM_MESH_EXPERIMENT": "0",
        "CMUX_VM_MESH_TENANT_IDS": "",
        "CMUX_VM_MESH_SERVICE_IDS": ""
      }
    },
    // Workers custom domain in the cmux.dev zone (CMUX-VM-API amendment 2).
    // Nothing of cmux VM is published under cmux.com or cmux.sh.
    "staging": {
      "name": "cmux-vm-staging",
      "workers_dev": false,
      "routes": [{ "pattern": "vm-staging.cmux.dev", "custom_domain": true }],
      // The agent reaper (src/agents/reaper.ts): expired and revoked agent keys' VMs, orphaned client sessions.
      "triggers": { "crons": ["*/5 * * * *"] },
      "durable_objects": { "bindings": [{ "name": "TENANT_LIMITS", "class_name": "TenantLimitsObject" }] },
      "migrations": [{ "tag": "v1-tenant-limits", "new_sqlite_classes": ["TenantLimitsObject"] }],
      "vars": {
        "ENVIRONMENT": "staging",
        "STACK_API_URL": "https://api.stack-auth.com",
        "UPSTREAM_API_URL": "https://api.freestyle.sh",
        // Immutable development images approved for the Cloud backend services (cloud-native: the root Native receiver, bake run 41315172830;
        // cloud-platform-dev is cmux-platform development's key, cloud-platform-staging cmux-platform staging's).
        // cloud-native-dev: the same Native receiver image with cmux-tui 8ac30a41 (acpmux clone boot, cmux#33140), bake run
        // 41613000089, for cmux-platform development only (sign-in-once seeding, cmux-platform#627).
        // cloud-native-dev-772323f (ids are unique in this list): the same image again with cmux-tui 772323f0 (it also has 8ac30a41), so the root
        // Native receiver journals why each bootstrap fails (cmux#33424); bake run 41616651292, development only.
        // cloud-native-4a7a845: the Cloud Native image with cmux-tui 4a7a8450 (bake run 41632518116, smoke 28 checks), for
        // development and staging: the activity report never says idle while acpmux may be at work (cmux#33468), and
        // /etc/cmux/agent-auth.sh for the app's Cloud sign-in (cmux#33566).
        // cloud-native-af078d6: the Cloud Native image with cmux-tui af078d6c and Claude Code 2.1.299 (bake run 41671798764, smoke 28
        // checks), for development and staging: Claude Code the API accepts (cmux#34020), and the busy-daemon expiry fix (cmux#33795).
        // cloud-native-5e57723: the Cloud Native image with cmux-tui 5e577237 (bake run 41701438675, smoke 28 checks), for development
        // and staging: a rebind drops the whole remote session, so a stale lifecycle fence no longer stops the session host (cmux#34128).
        // cloud-native-b1f8fc4: the Cloud Native image with cmux-tui b1f8fc4d (bake run 41857345925, smoke 31 checks), for development
        // and staging: the receiver renews its policy before the lease ends, so the Mac link no longer drops every ~27 s (cmux#35467).
        // cloud-native-f7b9c57: the Cloud Native image with cmux-tui f7b9c571 (bake run 41815796727, smoke 31 checks), for development
        // and staging: a provider clock sync is no longer a resume, so the Native receiver stays up through execs (cmux#35193).
        // cloud-native-91d3ea0: the Cloud Native image with cmux-tui 91d3ea01 (bake run 41961401076, smoke 31 checks), for development
        // and staging: the daemon has the features the current app requires, and the receiver journals why each stream ended (cmux#35996).
        // cloud-native-a6d444a: the Cloud Native image with cmux-tui a6d444aa (bake run 41966716765, smoke 30 checks), for development
        // and staging: the owner's Native link carries a Cloud chat's folder copy, so a new machine no longer reads outdated (cmux#36044),
        // and local receiver admission keeps streams up when the control plane is slow (cmux#36014).
        // cloud-native-4171772: the Cloud Native image with cmux-tui 4171772a (bake run 42002335565, smoke 30 checks), for development
        // and staging: the owner's link takes terminal commands, so `cmux cloud ssh` no longer meets remote_denied, and the daemon
        // makes /home/cmux/work at start (cmux#36271).
        // cloud-native-0cda689: the Cloud Native image with cmux-tui 0cda6896 (bake run 42034389148, smoke 31 checks), for development
        // and staging: the Cloud receiver listens before its first policy read and waits 20 s for the hello (cmux#36176).
        // cloud-native-cbbeec1: the Cloud Native image with cmux-tui cbbeec18 (bake run 42072549493, smoke 31 checks), for development
        // and staging: the daemon enrolls itself with `acpmux daemon enroll` (cmux#36564) and logs its receiver policy read (cmux#36551).
        // cloud-native-cbbeec1-rd021: the same Cloud Native image with cmux-tui cbbeec18 plus the agent desktop host cmux-rd 0.2.1
        // (role desktop: cmux-agent-rd.socket, cmux#36416, #36615, #36748; bake run 42097744382, smoke 32 checks), for development and staging.
        // cloud-native-8c00572: the Cloud Native image with cmux-tui 8c00572a (bake run 42120053634, smoke 29 checks): cmux-tui
        // cbbeec18 of cloud-native-cbbeec1 plus only the relay thread panic fix (cmux#36739; hq#7086). Appended, so nothing
        // boots it before CLOUD_VM_API_IMAGE names it.
        // cloud-native-0e017c6-rd022: cmux-tui 0e017c60 (8c00572a of cloud-native-8c00572 plus only #36519's cmux-tui part: the host
        // reports link-desktop-v1) and cmux-rd 0.2.2 (bake run 42135775035, smoke 34 checks, agent tools probe passed), for development and staging.
        // cloud-native-0bf7c32-rd022: cmux-tui 0bf7c32c (feat-cmux-next with #36519 and the updater holds #36854 and #36972: a fresh machine never
        // restarts inside a running chat) and cmux-rd 0.2.2 (bake run 42156400556, smoke 34 checks, agent tools probe passed), for development and staging.
        // cloud-native-f1c3afd-rd022: cmux-tui f1c3afd0 (0bf7c32c of cloud-native-0bf7c32-rd022 plus #37047, agent-session-start-no-cwd-v1, and
        // #37059, the relay only observes a turn) and cmux-rd 0.2.2 (bake run 42207671618, smoke 29 checks), for development and staging.
        // cloud-native-bd31f93-rd022: cmux-tui bd31f93e (with the updater's connect hold, #37256 and #37280: no profile flip or restart within
        // 5 min of a boot, bind or resume) and cmux-rd 0.2.2 (bake run 42343087798, smoke 29 checks, agent tools probe passed), for development and staging.
        // Trimmed under Cloudflare's 5.1 kB text binding limit (MAX_BYTES in images/cmux-vm/auto-roll.ts): cloud-native-dev,
        // -dev-772323f, -4a7a845, -af078d6, -5e57723, -f7b9c57, -b1f8fc4, -4171772 and -0cda689 left; no config or code names them,
        // and cmux-vm checks the list only when a VM is created with that image.
        "VM_BOOT_IMAGES": "[{\"id\":\"cloud-standard\",\"revision\":\"ci-41026036265-1\",\"displayName\":\"Cloud development\",\"snapshotId\":\"sh-0afbb63e9a6046b4a58068dfe30a5bc7\",\"services\":[\"cloud-driver\"]},{\"id\":\"cloud-native\",\"revision\":\"ci-41315172830-1\",\"displayName\":\"Cloud Native\",\"snapshotId\":\"sh-b601e8b3084a4876911688c8b464fb5e\",\"services\":[\"cloud-platform-dev\",\"cloud-platform-staging\"]},{\"id\":\"cloud-native-91d3ea0\",\"revision\":\"ci-41961401076-1\",\"displayName\":\"Cloud Native (cmux-tui 91d3ea01)\",\"snapshotId\":\"sh-ea70074ae3de445d83bdf6474bb5f836\",\"services\":[\"cloud-platform-dev\",\"cloud-platform-staging\"]},{\"id\":\"cloud-native-a6d444a\",\"revision\":\"ci-41966716765-2\",\"displayName\":\"Cloud Native (cmux-tui a6d444aa)\",\"snapshotId\":\"sh-580bb95a3a874b22a472f0761983ba30\",\"services\":[\"cloud-platform-dev\",\"cloud-platform-staging\"]},{\"id\":\"cloud-native-cbbeec1\",\"revision\":\"ci-42072549493-1\",\"displayName\":\"Cloud Native (cmux-tui cbbeec18)\",\"snapshotId\":\"sh-49e831e5fb5142199c64c1ff184a4ed7\",\"services\":[\"cloud-platform-dev\",\"cloud-platform-staging\"]},{\"id\":\"cloud-native-cbbeec1-rd021\",\"revision\":\"ci-42097744382-1\",\"displayName\":\"Cloud Native (cmux-tui cbbeec18, cmux-rd 0.2.1 desktop)\",\"snapshotId\":\"sh-519e258e915444c0acd7141f9ddf2745\",\"services\":[\"cloud-platform-dev\",\"cloud-platform-staging\"]},{\"id\":\"cloud-native-8c00572\",\"revision\":\"ci-42120053634-1\",\"displayName\":\"Cloud Native (cmux-tui 8c00572a)\",\"snapshotId\":\"sh-9d5702e010b04824aa9c29e794b07db9\",\"services\":[\"cloud-platform-dev\",\"cloud-platform-staging\"]},{\"id\":\"cloud-native-0e017c6-rd022\",\"revision\":\"ci-42135775035-1\",\"displayName\":\"Cloud Native (cmux-tui 0e017c60, cmux-rd 0.2.2 desktop)\",\"snapshotId\":\"sh-d65842ff27d54ed99b3273ffb8e984e0\",\"services\":[\"cloud-platform-dev\",\"cloud-platform-staging\"]},{\"id\":\"cloud-native-0bf7c32-rd022\",\"revision\":\"ci-42156400556-1\",\"displayName\":\"Cloud Native (cmux-tui 0bf7c32c, cmux-rd 0.2.2 desktop)\",\"snapshotId\":\"sh-cc1edf7cc003439a8e3d76ac6e3e51f2\",\"services\":[\"cloud-platform-dev\",\"cloud-platform-staging\"]},{\"id\":\"cloud-native-f1c3afd-rd022\",\"revision\":\"ci-42207671618-1\",\"displayName\":\"Cloud Native (cmux-tui f1c3afd0, cmux-rd 0.2.2 desktop)\",\"snapshotId\":\"sh-daaf9859b42a47c7b3d6f3215050f29a\",\"services\":[\"cloud-platform-dev\",\"cloud-platform-staging\"]},{\"id\":\"cloud-native-bd31f93-rd022\",\"revision\":\"ci-42343087798-1\",\"displayName\":\"Cloud Native (cmux-tui bd31f93e, cmux-rd 0.2.2 desktop)\",\"snapshotId\":\"sh-79cc22cf8c7f4fe1a030a882423ad1c9\",\"services\":[\"cloud-platform-dev\",\"cloud-platform-staging\"]},{\"id\":\"cloud-native-auto-eef1188e-43170615695-1\",\"revision\":\"ci-43170615695-1\",\"displayName\":\"Cloud Native (cmux-tui eef1188e, image roll 43170615695.1)\",\"snapshotId\":\"sh-97b3dd53060c40e39c4c94e39eb7f039\",\"services\":[\"cloud-platform-dev\",\"cloud-platform-staging\"]},{\"id\":\"cloud-native-auto-99a6d8f4-43171578740-1\",\"revision\":\"ci-43171578740-1\",\"displayName\":\"Cloud Native (cmux-tui 99a6d8f4, image roll 43171578740.1)\",\"snapshotId\":\"sh-20d354ffdb3241bda2906094bca07fed\",\"services\":[\"cloud-platform-dev\",\"cloud-platform-staging\"]},{\"id\":\"cloud-native-auto-53139ac8-43172324514-1\",\"revision\":\"ci-43172324514-1\",\"displayName\":\"Cloud Native (cmux-tui 53139ac8, image roll 43172324514.1)\",\"snapshotId\":\"sh-e64a6d2778714cce9cf6abbed1441ae6\",\"services\":[\"cloud-platform-dev\",\"cloud-platform-staging\"]},{\"id\":\"cloud-native-auto-7a9e55a1-43173457946-1\",\"revision\":\"ci-43173457946-1\",\"displayName\":\"Cloud Native (cmux-tui 7a9e55a1, image roll 43173457946.1)\",\"snapshotId\":\"sh-5b73d95bf3214059a3a011a8459342a4\",\"services\":[\"cloud-platform-dev\",\"cloud-platform-staging\"]},{\"id\":\"cloud-native-auto-c3fda594-43177370763-1\",\"revision\":\"ci-43177370763-1\",\"displayName\":\"Cloud Native (cmux-tui c3fda594, image roll 43177370763.1)\",\"snapshotId\":\"sh-92162d33b2614715ab816a54543375bb\",\"services\":[\"cloud-platform-dev\",\"cloud-platform-staging\"]},{\"id\":\"cloud-native-auto-66c56ea9-43180192396-1\",\"revision\":\"ci-43180192396-1\",\"displayName\":\"Cloud Native (cmux-tui 66c56ea9, image roll 43180192396.1)\",\"snapshotId\":\"sh-293bea07b88c4d2dbfc037eb12e3c276\",\"services\":[\"cloud-platform-dev\",\"cloud-platform-staging\"]}]",
        // The Cloud guest's coderouter.cmux.internal proxy targets one of these exact origins: the shared coderouter, or
        // cmux-platform-development or -staging itself for a team in inference gateway mode (cmux-platform InferenceGateway.ts).
        // Then each platform's own lifelines (cmux-platform PrivateEgress.ts privateLifelines): its CLOUD_API_ORIGIN and its
        // CLOUD_CARRIER_RELAY_HOST, development's and staging's (this Worker serves both). A machine keeps cmux through
        // these when its public internet is off (made without it, or network access `none`, cmux#13742).
        "VM_HTTPS_PROXY_ORIGINS": "[\"https://cmux-staging.vercel.app\",\"https://cmux-platform-development.debussy.workers.dev\",\"https://cmux-platform-staging.debussy.workers.dev\",\"https://cmux-api-development.debussy.workers.dev\",\"https://cmux-remote-relay-development.debussy.workers.dev\",\"https://cloud-api-staging.cmux.dev\",\"https://cmux-remote-relay-staging.debussy.workers.dev\"]",
        // Mesh experiment (cx-0op): on for internal manaflow dogfood teams only (coordinator, 2026-10-07),
        // ids checked against the staging Stack project: "cmux-agent-dev@manaflow.ai's Team" and
        // "Lawrence Chen's Team". No customer team. Production stays off.
        "CMUX_VM_MESH_EXPERIMENT": "1",
        "CMUX_VM_MESH_TENANT_IDS": "d8284bb7-c83e-4314-9c2c-8e702ac96ea9,b8f12e8e-7893-4a52-89a5-f1fdf0145b07",
        // Service key ids (CMUX_VM_SERVICE_KEYS ids, never key material) that have the experiment for every team
        // they act for: cmux Cloud's dev and staging platforms make each team's mesh in that team's personal tenant, which
        // no hand-kept tenant list would know in advance. Only those services' own requests pass; the
        // tenant's other callers still get 404.
        "CMUX_VM_MESH_SERVICE_IDS": "cloud-platform-dev,cloud-platform-staging",
        // Mesh ACL scopes added to those service keys (their entries are write-only secrets minted with mesh read/write
        // only): cmux-platform writes each team Cloud mesh's first ACL, devices to VMs on ssh and the daemon. Only
        // acl:read and acl:write may be granted here (src/auth/service-keys.ts).
        "CMUX_VM_SERVICE_KEY_SCOPE_GRANTS": "{\"cloud-platform-dev\":[\"acl:read\",\"acl:write\"],\"cloud-platform-staging\":[\"acl:read\",\"acl:write\"]}",
        // A 120 s receiving-policy lease (default 30 s): every image in VM_BOOT_IMAGES above that dev and staging boot runs a
        // receiver that renews ahead and accepts it (cmux#35467). Production keeps 30 s until its image has that receiver.
        "CMUX_VM_RECEIVER_POLICY_LEASE_MS": "120000"
      }
    },
    // Workers custom domain in the cmux.dev zone; attached by the first
    // production deploy (cx-b4h.5), not before.
    "production": {
      "name": "cmux-vm-production",
      "workers_dev": false,
      "routes": [{ "pattern": "vm.cmux.dev", "custom_domain": true }],
      "triggers": { "crons": ["*/5 * * * *"] },
      "durable_objects": { "bindings": [{ "name": "TENANT_LIMITS", "class_name": "TenantLimitsObject" }] },
      "migrations": [{ "tag": "v1-tenant-limits", "new_sqlite_classes": ["TenantLimitsObject"] }],
      "vars": {
        "ENVIRONMENT": "production",
        // Stack team ids treated as dev/test in production (idle timeout <= 300 s).
        // cmux-vm-smoke-service is no Stack team: only the production smoke service key
        // (teams ["cmux-vm-smoke-service"], role=chief VMs only) acts for it (smoke-production).
        "DEV_TEST_TENANT_IDS": "cmux-vm-smoke-service",
        // The manaflow-team flag (cx-b4h.16): production Stack teams entitled to create without billing
        // during the internal phase; product tenants (no dev/test idle cap). Checked 2026-10-09 in the
        // production Stack project: "cmux" (austin, aziz, lawrence) and those three people's personal teams
        // (Lawrence Chen's workspace, AUSTIN, Aziz Albahar's Team). Add a team id here in a reviewed change.
        "MANAFLOW_TEAM_TENANT_IDS": "d13acd51-c77d-438a-9610-5369455e2a2f,eff137f0-2e49-409e-bd6e-6e2d46cf3f1d,8e288bf9-264c-44a3-9d85-f22cbff2a6ad,50c7631c-c546-45d8-9b98-2a5744b4cdad",
        // JSON object of Stack team id to live VM limit; product tenants have no default cap, dev/test tenants 20.
        "TENANT_VM_QUOTAS": "{\"cmux-vm-product-smoke\":2}",
        "STACK_API_URL": "https://api.stack-auth.com",
        "UPSTREAM_API_URL": "https://api.freestyle.sh",
        // NEXT Cloud in production: the same Cloud Native image staging runs (cloud-native-cbbeec1-rd021, bake run 42097744382,
        // smoke 32 checks; cmux-tui cbbeec18 as cloud-native-cbbeec1, plus the agent desktop host cmux-rd 0.2.1, role desktop,
        // #36416, #36615, #36748), approved for cmux-platform production's service key and for the CI product smoke
        // (CMUX_VM_CI_TRUST), which boots exactly what the product boots (the first entry). cloud-native-cbbeec1 (bake run
        // 42072549493, #36564) and cloud-native-0cda689 (bake run 42034389148, #36176) stay listed for rollback.
        // cloud-native-8c00572: the Cloud Native image with cmux-tui 8c00572a (bake run 42120053634, smoke 29 checks): cmux-tui
        // cbbeec18 of cloud-native-cbbeec1 plus only the relay thread panic fix (cmux#36739; hq#7086). Appended, so nothing
        // boots it before CLOUD_VM_API_IMAGE names it.
        // cloud-native-0e017c6-rd022 (bake run 42135775035, smoke 34 checks): cmux-tui 0e017c60, 8c00572a plus only #36519's cmux-tui part, so
        // the host reports link-desktop-v1 and Open Desktop's rd viewer works; first, so the CI product smoke boots it. The others stay for rollback.
        // cloud-native-0bf7c32-rd022 (bake run 42156400556, smoke 34 checks, agent tools probe passed): cmux-tui 0bf7c32c, feat-cmux-next with
        // #36519 (link-desktop-v1) and the updater holds (#36854, #36972), cmux-rd 0.2.2; first, so the CI product smoke boots it. The others stay for rollback.
        // cloud-native-f1c3afd-rd022 (bake run 42207671618, smoke 29 checks): cmux-tui f1c3afd0, 0bf7c32c plus #37047 (agent-session-start-no-cwd-v1)
        // and #37059 (a relay socket loss or host restart no longer cancels a turn), cmux-rd 0.2.2; first, so the CI product smoke boots it. The others stay for rollback.
        // cloud-native-bd31f93-rd022 (bake run 42343087798, smoke 29 checks, agent tools probe passed): cmux-tui bd31f93e, with the updater's
        // connect hold (#37256, #37280), cmux-rd 0.2.2; first, so the CI product smoke boots it. The others stay for rollback.
        "VM_BOOT_IMAGES": "[{\"id\":\"cloud-native-auto-66c56ea9-43180192396-1\",\"revision\":\"ci-43180192396-1\",\"displayName\":\"Cloud Native (cmux-tui 66c56ea9, image roll 43180192396.1)\",\"snapshotId\":\"sh-293bea07b88c4d2dbfc037eb12e3c276\",\"services\":[\"cloud-platform-production\",\"ci-product-smoke\"]},{\"id\":\"cloud-native-auto-c3fda594-43177370763-1\",\"revision\":\"ci-43177370763-1\",\"displayName\":\"Cloud Native (cmux-tui c3fda594, image roll 43177370763.1)\",\"snapshotId\":\"sh-92162d33b2614715ab816a54543375bb\",\"services\":[\"cloud-platform-production\",\"ci-product-smoke\"]},{\"id\":\"cloud-native-auto-7a9e55a1-43173457946-1\",\"revision\":\"ci-43173457946-1\",\"displayName\":\"Cloud Native (cmux-tui 7a9e55a1, image roll 43173457946.1)\",\"snapshotId\":\"sh-5b73d95bf3214059a3a011a8459342a4\",\"services\":[\"cloud-platform-production\",\"ci-product-smoke\"]},{\"id\":\"cloud-native-auto-53139ac8-43172324514-1\",\"revision\":\"ci-43172324514-1\",\"displayName\":\"Cloud Native (cmux-tui 53139ac8, image roll 43172324514.1)\",\"snapshotId\":\"sh-e64a6d2778714cce9cf6abbed1441ae6\",\"services\":[\"cloud-platform-production\",\"ci-product-smoke\"]},{\"id\":\"cloud-native-auto-99a6d8f4-43171578740-1\",\"revision\":\"ci-43171578740-1\",\"displayName\":\"Cloud Native (cmux-tui 99a6d8f4, image roll 43171578740.1)\",\"snapshotId\":\"sh-20d354ffdb3241bda2906094bca07fed\",\"services\":[\"cloud-platform-production\",\"ci-product-smoke\"]},{\"id\":\"cloud-native-auto-eef1188e-43170615695-1\",\"revision\":\"ci-43170615695-1\",\"displayName\":\"Cloud Native (cmux-tui eef1188e, image roll 43170615695.1)\",\"snapshotId\":\"sh-97b3dd53060c40e39c4c94e39eb7f039\",\"services\":[\"cloud-platform-production\",\"ci-product-smoke\"]},{\"id\":\"cloud-native-bd31f93-rd022\",\"revision\":\"ci-42343087798-1\",\"displayName\":\"Cloud Native (cmux-tui bd31f93e, cmux-rd 0.2.2 desktop)\",\"snapshotId\":\"sh-79cc22cf8c7f4fe1a030a882423ad1c9\",\"services\":[\"cloud-platform-production\",\"ci-product-smoke\"]},{\"id\":\"cloud-native-f1c3afd-rd022\",\"revision\":\"ci-42207671618-1\",\"displayName\":\"Cloud Native (cmux-tui f1c3afd0, cmux-rd 0.2.2 desktop)\",\"snapshotId\":\"sh-daaf9859b42a47c7b3d6f3215050f29a\",\"services\":[\"cloud-platform-production\",\"ci-product-smoke\"]},{\"id\":\"cloud-native-0bf7c32-rd022\",\"revision\":\"ci-42156400556-1\",\"displayName\":\"Cloud Native (cmux-tui 0bf7c32c, cmux-rd 0.2.2 desktop)\",\"snapshotId\":\"sh-cc1edf7cc003439a8e3d76ac6e3e51f2\",\"services\":[\"cloud-platform-production\",\"ci-product-smoke\"]},{\"id\":\"cloud-native-0e017c6-rd022\",\"revision\":\"ci-42135775035-1\",\"displayName\":\"Cloud Native (cmux-tui 0e017c60, cmux-rd 0.2.2 desktop)\",\"snapshotId\":\"sh-d65842ff27d54ed99b3273ffb8e984e0\",\"services\":[\"cloud-platform-production\",\"ci-product-smoke\"]},{\"id\":\"cloud-native-cbbeec1-rd021\",\"revision\":\"ci-42097744382-1\",\"displayName\":\"Cloud Native (cmux-tui cbbeec18, cmux-rd 0.2.1 desktop)\",\"snapshotId\":\"sh-519e258e915444c0acd7141f9ddf2745\",\"services\":[\"cloud-platform-production\",\"ci-product-smoke\"]},{\"id\":\"cloud-native-cbbeec1\",\"revision\":\"ci-42072549493-1\",\"displayName\":\"Cloud Native (cmux-tui cbbeec18)\",\"snapshotId\":\"sh-49e831e5fb5142199c64c1ff184a4ed7\",\"services\":[\"cloud-platform-production\",\"ci-product-smoke\"]},{\"id\":\"cloud-native-0cda689\",\"revision\":\"ci-42034389148-1\",\"displayName\":\"Cloud Native (cmux-tui 0cda6896)\",\"snapshotId\":\"sh-bfa754a4920142cda9e36684767b77b0\",\"services\":[\"cloud-platform-production\",\"ci-product-smoke\"]},{\"id\":\"cloud-native-8c00572\",\"revision\":\"ci-42120053634-1\",\"displayName\":\"Cloud Native (cmux-tui 8c00572a)\",\"snapshotId\":\"sh-9d5702e010b04824aa9c29e794b07db9\",\"services\":[\"cloud-platform-production\",\"ci-product-smoke\"]}]",
        // The production counterpart of staging's guest coderouter.cmux.internal proxy origin, and cmux-platform-production
        // itself for a team in inference gateway mode (cmux-platform InferenceGateway.ts; its gateway token is that Worker's
        // own, CLOUD_MACHINE_TOKEN_JWK). Without it, a gateway-mode team's create is refused by the network check.
        // Then cmux-platform-production's lifelines, as staging's: its CLOUD_API_ORIGIN and CLOUD_CARRIER_RELAY_HOST.
        "VM_HTTPS_PROXY_ORIGINS": "[\"https://cmux.com\",\"https://cmux-platform-production.debussy.workers.dev\",\"https://cloud-api.cmux.dev\",\"https://cmux-remote-relay-production.debussy.workers.dev\"]",
        // A request made with these service keys (CMUX_VM_SERVICE_KEYS ids, never key material) is entitled for the team it
        // acts for: cmux-platform has already decided that team's plan (the company grant for @cmux.com members), so a
        // member's personal team needs no entry in MANAFLOW_TEAM_TENANT_IDS. The key's teams, scopes and labels still apply.
        // ci-product-smoke is the CI trust row below, entitled for its own team only (its row names one team).
        "CMUX_VM_ENTITLED_SERVICE_IDS": "cloud-platform-production,ci-product-smoke",
        // GitHub Actions jobs trusted by their OIDC token (src/auth/ci-trust.ts); no key exists to leak or rotate, and
        // removing a row revokes it. ci-product-smoke: cmux-vm.yml's smoke-production job on feat-cmux-next in the
        // cmux-vm-production environment. It acts only for cmux-vm-product-smoke (no Stack team, not dev/test, so its
        // VMs take the product's never-pause idle default), only on VMs labelled cmux.ci=product-smoke, at most 2 live
        // (and TENANT_VM_QUOTAS above), each paused after 15 minutes and deleted once stopped.
        "CMUX_VM_CI_TRUST": "[{\"id\":\"ci-product-smoke\",\"audience\":\"https://vm.cmux.dev\",\"repository\":\"manaflow-ai/cmux\",\"environment\":\"cmux-vm-production\",\"workflowRef\":\"manaflow-ai/cmux/.github/workflows/cmux-vm.yml@refs/heads/feat-cmux-next\",\"team\":\"cmux-vm-product-smoke\",\"scopes\":[\"vm:read\",\"vm:write\",\"vm:exec\"],\"labels\":{\"cmux.ci\":\"product-smoke\"},\"maxVms\":2,\"maxUsdPerHour\":1,\"maxRunSeconds\":900}]",
        // Mesh experiment (cx-0op): on for cmux-platform production's own requests only, as staging has it for its
        // platforms: each team's Cloud mesh is made in that team's personal tenant, which no hand-kept list knows in
        // advance. No tenant is listed, so every other caller still gets 404.
        "CMUX_VM_MESH_EXPERIMENT": "1",
        "CMUX_VM_MESH_TENANT_IDS": "",
        "CMUX_VM_MESH_SERVICE_IDS": "cloud-platform-production",
        // Mesh ACL scopes added to that service key, as on staging (only acl:read and acl:write may be granted here).
        "CMUX_VM_SERVICE_KEY_SCOPE_GRANTS": "{\"cloud-platform-production\":[\"acl:read\",\"acl:write\"]}"
      }
    }
  }
}
