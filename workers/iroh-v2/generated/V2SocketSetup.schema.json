{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.cmux.invalid/iroh-v2/V2SocketSetup.json",
  "type": "object",
  "properties": {
    "schemaId": {
      "type": "string",
      "const": "session.open.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "device": {
      "$ref": "https://contracts.cmux.invalid/iroh-v2/V2DeviceDescriptor.json"
    },
    "proof": {
      "allOf": [
        {
          "$ref": "https://contracts.cmux.invalid/iroh-v2/V2DeviceProof.json"
        }
      ]
    },
    "haveRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaId",
    "requestId",
    "device"
  ],
  "additionalProperties": false
}
