    "metadata": {
      "$ref": "https://contracts.cmux.invalid/iroh-v2/V2DeviceMetadata.json"
    }
  },
  "required": [
    "identity",
    "endpointId",
    "identityGeneration",
    "metadata"
  ],
  "additionalProperties": false
}
