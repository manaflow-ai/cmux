{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.cmux.invalid/iroh-v2/V2DeviceDescriptor.json",
  "type": "object",
  "properties": {
    "identity": {
      "$ref": "https://contracts.cmux.invalid/iroh-v2/V2Identity.json"
    },
    "endpointId": {
      "type": "string",
