{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.cmux.invalid/iroh-v2/V2RelayResponse.json",
  "type": "object",
  "properties": {
    "schemaId": {
      "type": "string",
      "const": "relay.result.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "credentials": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "$ref": "https://contracts.cmux.invalid/iroh-v2/V2RelayCredential.json"
      }
    },
    "deliveryReceipt": {
      "allOf": [
        {
          "$ref": "https://contracts.cmux.invalid/iroh-v2/V2DeliveryReceipt.json"
        }
      ]
    }
  },
  "required": [
    "schemaId",
    "requestId",
    "credentials"
  ],
  "additionalProperties": false
}
