{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.cmux.invalid/iroh-v2/V2ReadyResponse.json",
  "type": "object",
  "properties": {
    "schemaId": {
      "type": "string",
      "const": "session.ready.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "teamRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ticket": {
      "allOf": [
        {
          "$ref": "https://contracts.cmux.invalid/iroh-v2/V2Ticket.json"
        }
      ]
    },
    "challenge": {
      "allOf": [
        {
          "$ref": "https://contracts.cmux.invalid/iroh-v2/V2Challenge.json"
        }
      ]
    },
    "device": {
      "allOf": [
        {
          "$ref": "https://contracts.cmux.invalid/iroh-v2/V2DeviceRecord.json"
        }
      ]
    }
  },
  "required": [
    "schemaId",
    "requestId",
    "sessionId",
    "teamRevision"
  ],
  "additionalProperties": false
}
