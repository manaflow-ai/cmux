{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.cmux.invalid/iroh-v2/V2AcknowledgementRequest.json",
  "type": "object",
  "properties": {
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "schemaId": {
      "type": "string",
      "const": "session.ack.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "sequence",
    "token",
    "schemaId",
    "requestId"
  ],
  "additionalProperties": false
}
