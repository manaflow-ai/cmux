{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.cmux.invalid/iroh-v2/V2DashboardDirectory.json",
  "type": "object",
  "properties": {
    "teamId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "devices": {
      "maxItems": 1024,
      "type": "array",
      "items": {
        "$ref": "https://contracts.cmux.invalid/iroh-v2/V2DeviceRecord.json"
      }
    },
    "relayURLs": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2048,
        "format": "uri"
      }
    },
    "issuedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nextCursor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "canManageTeam": {
      "type": "boolean"
    },
    "managedDeviceIds": {
      "maxItems": 1024,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    }
  },
  "required": [
    "teamId",
    "revision",
    "devices",
    "relayURLs",
    "issuedAt",
    "nextCursor",
    "canManageTeam",
    "managedDeviceIds"
  ],
  "additionalProperties": false
}
