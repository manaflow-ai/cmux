{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.cmux.invalid/iroh-v2/V2AccountDirectory.json",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "macs": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "$ref": "https://contracts.cmux.invalid/iroh-v2/V2DeviceRecord.json"
      }
    },
    "inboundMacs": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "$ref": "https://contracts.cmux.invalid/iroh-v2/V2InboundPeerPermission.json"
      }
    },
    "relayURLs": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2048,
        "format": "uri"
      }
    },
    "issuedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "permissionExpiresAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rules": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "nextCursor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "userId",
    "revision",
    "macs",
    "inboundMacs",
    "relayURLs",
    "issuedAt",
    "permissionExpiresAt",
    "rules",
    "nextCursor"
  ],
  "additionalProperties": false
}
