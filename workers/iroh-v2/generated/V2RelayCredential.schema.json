{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.cmux.invalid/iroh-v2/V2RelayCredential.json",
  "type": "object",
  "properties": {
    "relayURL": {
      "type": "string",
      "maxLength": 2048,
      "format": "uri"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "refreshAfter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "relayURL",
    "token",
    "expiresAt",
    "refreshAfter"
  ],
  "additionalProperties": false
}
