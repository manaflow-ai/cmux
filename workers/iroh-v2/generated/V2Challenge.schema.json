{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.cmux.invalid/iroh-v2/V2Challenge.json",
  "type": "object",
  "properties": {
    "challengeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "payloadHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "challengeId",
    "nonce",
    "payloadHash",
    "expiresAt"
  ],
  "additionalProperties": false
}
