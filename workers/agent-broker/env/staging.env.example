# Copy to /etc/cmux/agent-broker-staging.env on the staging worker.
# The value must point to a non-production PlanetScale branch.
DATABASE_URL=postgres://user:password@staging-branch.example/db?sslmode=require
CMUX_BROKER_WORKER_ID=big-red-staging-1
CMUX_BROKER_HOST_CLASS=huge-blue
CMUX_BROKER_ADAPTER_MODULE=/app/workers/agent-broker/adapters/host-lease-adapters.ts
CMUX_BROKER_POLL_MS=1000
CMUX_BROKER_LEASE_TTL_MS=30000
# Provider gateway credentials are injected by the deployment secret manager.
# HUGE_BLUE_HOST_LEASE_URL=https://...
# HUGE_BLUE_HOST_LEASE_TOKEN=...
# HUGE_BLUE_HOST_ID=...
# Or use the existing SSH host route for Huge Blue:
# HUGE_BLUE_SSH_HOST=huge-blue
# HUGE_BLUE_SSH_USER=leo
# HUGE_BLUE_SSH_KEY=/run/secrets/huge-blue-key
# HUGE_BLUE_SSH_PROXY_COMMAND=/usr/local/bin/tailscale-manaflow nc %h %p
# FREESTYLE_HOST_LEASE_URL=https://...
# FREESTYLE_HOST_LEASE_TOKEN=...
# FREESTYLE_HOST_ID=...
