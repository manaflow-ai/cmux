{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // GitHub Actions OIDC -> 15-minute R2 credentials (src/r2-credentials.ts).
  // No bindings: it reaches R2 only through Cloudflare's temporary-credentials API.
  "name": "cmux-ci-r2-credentials",
  "main": "src/r2-credentials.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "secrets": {
    "required": [
      "CLOUDFLARE_API_TOKEN",
      "R2_ACCOUNT_ID",
      "R2_PARENT_ACCESS_KEY_ID"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": []
}
