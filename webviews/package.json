{
  "name": "@cmux/webviews",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run verify:tanstack-router && bun run typecheck && vp build",
    "benchmark": "bun run bench/diff-stream.bench.ts",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "dev": "vp dev",
    "dev:agent-pane": "vp dev --config vite.config.acpmux-pane.mjs",
    "dev:settings": "vp dev --config vite.config.settings-page.mjs",
    "strings:settings": "node scripts/pages/gen-strings.mjs settings",
    "compare:agent-pane": "node scripts/agent-pane/compare.mjs",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "protocol:codegen": "bun scripts/pane-protocol-codegen.ts",
    "protocol:check": "bun scripts/pane-protocol-codegen.ts --check",
    "protocol:demo": "vp dev --config vite.config.pane-protocol-demo.ts",
    "preview:dev": "vp dev --config vite.config.acpmux-preview.mjs",
    "preview:build": "vp build --config vite.config.acpmux-preview.mjs",
    "test": "bun test",
    "typecheck": "vp check --no-fmt --no-lint",
    "verify:tanstack-router": "node scripts/verify-tanstack-router-security.mjs",
    "react-doctor": "react-doctor . --full --no-score --fail-on none",
    "react-doctor:ci": "react-doctor . --full --no-score --fail-on none"
  },
  "dependencies": {
    "@chenglou/pretext": "0.0.9",
    "@milkdown/kit": "7.22.2",
    "@pierre/diffs": "1.2.7",
    "@pierre/trees": "1.0.0-beta.4",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.11",
    "@vitejs/plugin-react": "^5.1.2",
    "marked": "17.0.5",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-model": "^1.25.7",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.41.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shiki": "3.23.0",
    "solid-js": "^1.9.13",
    "vega-interpreter": "1.0.5",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@types/jsdom": "^28.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "0.27.7",
    "jsdom": "^29.1.1",
    "pixelmatch": "7.2.0",
    "playwright": "1.62.1",
    "pngjs": "7.0.0",
    "react-doctor": "^0.2.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "error"
    }
  }
}
