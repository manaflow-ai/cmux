{
  "name": "@cmux/webviews",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "bun scripts/pages/gen-strings.mjs --best-effort",
    "build": "node scripts/pages/gen-strings.mjs && bun run verify:tanstack-router && bun run typecheck && vp build",
    "benchmark": "bun run bench/diff-stream.bench.ts",
    "check": "bun run check:browser-lanes && bun run check:fixed-waits && bun run check:design-tokens && bun run check:layers && bun run check:type-scale && bun run check:motion-scale && bun run check:status-glyphs && bun run check:system-blue && bun run check:text-focus && bun run check:dialog-keys && bun run check:switch-fetches && bun run check:catalog-keys && vp fmt --check && vp lint && vp check --no-fmt --no-lint && bun run acpmux-protocol:check",
    "check:layers": "python3 ../scripts/cmux-next/check-layers.py",
    "check:type-scale": "python3 ../scripts/cmux-next/gen-type-scale.py --check && python3 ../scripts/cmux-next/check-type-scale.py",
    "check:motion-scale": "python3 ../scripts/cmux-next/gen-motion-scale.py --check",
    "check:status-glyphs": "python3 ../scripts/cmux-next/gen-status-glyphs.py --check",
    "check:ui-rulings": "bun scripts/check-ui-rulings.ts",
    "check:system-blue": "python3 ../scripts/cmux-next/check-system-blue.py",
    "check:text-focus": "python3 ../scripts/cmux-next/check-text-focus-rings.py",
    "check:dialog-keys": "python3 -I ../scripts/cmux-next/check-dialog-key-hints.py ..",
    "check:switch-fetches": "python3 -I ../scripts/cmux-next/check-switch-fetches.py --root ..",
    "check:catalog-keys": "python3 -I ../scripts/cmux-next/check-xcstrings-keys.py --root ..",
    "check:browser-lanes": "bun scripts/check-browser-test-lanes.ts",
    "check:fixed-waits": "bun scripts/check-fixed-waits.ts",
    "check:design-tokens": "bun scripts/check-design-tokens.ts",
    "check:fix": "vp check --fix",
    "dev": "vp dev",
    "dev:agent-pane": "vp dev --config vite.config.acpmux-pane.mjs",
    "dev:settings": "vp dev --config vite.config.settings-page.mjs",
    "dev:pages": "vp dev --config vite.config.pages-dev.ts",
    "strings": "node scripts/pages/gen-strings.mjs",
    "strings:settings": "node scripts/pages/gen-strings.mjs settings",
    "compare:agent-pane": "node scripts/agent-pane/compare.mjs",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "latency": "bun scripts/latency/run.ts",
    "latency:ci": "bun scripts/latency/run.ts --ci",
    "acpmux-protocol:codegen": "bun scripts/acpmux-protocol-codegen.ts",
    "acpmux-protocol:check": "bun scripts/acpmux-protocol-codegen.ts --check",
    "protocol:codegen": "bun scripts/pane-protocol-codegen.ts",
    "protocol:check": "bun scripts/pane-protocol-codegen.ts --check",
    "protocol:demo": "vp dev --config vite.config.pane-protocol-demo.ts",
    "preview:dev": "vp dev --config vite.config.acpmux-preview.mjs",
    "preview:build": "vp build --config vite.config.acpmux-preview.mjs",
    "test": "bun test",
    "typecheck": "vp check --no-fmt --no-lint",
    "verify:tanstack-router": "node scripts/verify-tanstack-router-security.mjs",
    "react-doctor": "react-doctor . --full --no-score --fail-on none",
    "react-doctor:ci": "react-doctor . --full --no-score --fail-on none",
    "gallery:build": "node scripts/pages/gen-strings.mjs && vp build --config vite.config.gallery.ts",
    "gallery:dev": "vp dev --config vite.config.gallery-dev.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@chenglou/pretext": "0.0.9",
    "@milkdown/kit": "7.22.2",
    "@pierre/diffs": "1.2.7",
    "@pierre/trees": "1.0.0-beta.4",
    "@shikijs/monaco": "3.23.0",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.11",
    "@tanstack/react-virtual": "3.14.13",
    "@vitejs/plugin-react": "6.1.1",
    "katex": "0.16.25",
    "marked": "17.0.5",
    "monaco-editor": "0.57.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-model": "1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "1.42.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shiki": "3.23.0",
    "solid-js": "^1.9.17",
    "sucrase": "3.35.1",
    "vega-interpreter": "1.2.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@types/jsdom": "^28.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "axe-core": "4.13.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "0.27.7",
    "happy-dom": "^20.14.5",
    "jsdom": "^29.1.1",
    "oxc-transform-react": "0.145.0",
    "pixelmatch": "7.2.0",
    "playwright": "1.62.1",
    "pngjs": "7.0.0",
    "react-doctor": "^0.2.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "baseline-browser-mapping": "^2.11.0",
    "brace-expansion": "^5.0.12",
    "browserslist": "^4.28.7",
    "dompurify": "3.4.17",
    "fast-uri": "^3.1.8",
    "seroval": "^1.6.9",
    "seroval-plugins": "^1.6.9",
    "source-map-js": "^1.2.2",
    "toml": "^4.2.0",
    "undici": "^7.29.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "error"
    }
  }
}
