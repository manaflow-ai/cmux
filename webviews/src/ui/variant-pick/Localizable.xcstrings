    "error": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not confirm your pick. Check the tracker before retrying."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تأكيد اختيارك. تحقق من المتتبع قبل المحاولة مجددًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće potvrditi odabir. Provjerite evidenciju zadataka prije ponovnog pokušaja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit valg kunne ikke bekræftes. Tjek opgavestyringen, før du prøver igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Auswahl konnte nicht bestätigt werden. Prüfe den Tracker vor einem erneuten Versuch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar tu elección. Revisa el registro de tareas antes de volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de confirmer votre choix. Vérifiez le suivi des tâches avant de réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile confermare la scelta. Controlla il registro delle attività prima di riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択を確認できませんでした。再試行する前にトラッカーを確認してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចបញ្ជាក់ជម្រើសរបស់អ្នកបានទេ។ ពិនិត្យកម្មវិធីតាមដានមុនពេលព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택을 확인할 수 없습니다. 다시 시도하기 전에 트래커를 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke bekrefte valget ditt. Sjekk oppgavesporingen før du prøver igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można potwierdzić wyboru. Sprawdź rejestr zadań przed ponowną próbą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar sua escolha. Confira o rastreador antes de tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить выбор. Проверьте трекер перед повторной попыткой."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถยืนยันตัวเลือกของคุณได้ ตรวจสอบตัวติดตามก่อนลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçiminiz doğrulanamadı. Tekrar denemeden önce görev izleyicisini kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося підтвердити вибір. Перевірте трекер перед повторною спробою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác nhận lựa chọn. Hãy kiểm tra trình theo dõi trước khi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认你的选择。请先检查任务跟踪器，然后再重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認你的選擇。請先檢查任務追蹤器，然後再重試。"
          }
        }
      }
    },
