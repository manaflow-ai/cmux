    "diff.subtitle": {
      "comment": "Help under the diff viewer empty state title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the changes in a git repository. Choose a folder, pick a recent one, or drop a folder here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "راجع التغييرات في مستودع git. اختر مجلدًا، أو أحد المستودعات الأخيرة، أو أفلت مجلدًا هنا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pregledajte promjene u git repozitoriju. Odaberite mapu, nedavni repozitorij ili ispustite mapu ovdje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gennemgå ændringerne i et git-repositorium. Vælg en mappe, et nyligt repositorium, eller slip en mappe her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prüfe die Änderungen in einem Git-Repository. Wähle einen Ordner, ein zuletzt verwendetes Repository oder lege einen Ordner hier ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Revisa los cambios de un repositorio git. Elige una carpeta, uno reciente o suelta una carpeta aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Examinez les modifications d’un dépôt git. Choisissez un dossier, un dépôt récent ou déposez un dossier ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esamina le modifiche di un repository git. Scegli una cartella, uno recente o trascina qui una cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "gitリポジトリの変更を確認します。フォルダを選ぶか、最近使った項目を選ぶか、ここにフォルダをドロップしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ពិនិត្យការផ្លាស់ប្ដូរក្នុងឃ្លាំង git។ ជ្រើសថត ជ្រើសឃ្លាំងថ្មីៗ ឬទម្លាក់ថតនៅទីនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git 저장소의 변경 사항을 검토합니다. 폴더를 선택하거나 최근 항목을 고르거나 여기에 폴더를 놓으세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gå gjennom endringene i et git-repositorium. Velg en mappe, et nylig repositorium, eller slipp en mappe her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przejrzyj zmiany w repozytorium git. Wybierz folder, jedno z ostatnich lub upuść tutaj folder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Revise as alterações de um repositório git. Escolha uma pasta, um recente ou solte uma pasta aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Просмотрите изменения в git-репозитории. Выберите папку, недавний репозиторий или перетащите папку сюда."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ตรวจดูการเปลี่ยนแปลงในที่เก็บ git เลือกโฟลเดอร์ เลือกรายการล่าสุด หรือวางโฟลเดอร์ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir git deposundaki değişiklikleri inceleyin. Bir klasör seçin, son kullanılanlardan birini seçin veya buraya bir klasör bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перегляньте зміни в git-репозиторії. Виберіть папку, нещодавній репозиторій або перетягніть папку сюди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xem lại các thay đổi trong một kho git. Chọn một thư mục, một kho gần đây, hoặc thả thư mục vào đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "查看 git 仓库中的更改。选择一个文件夹、最近使用的仓库，或将文件夹拖到这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "檢視 git 儲存庫中的變更。選擇資料夾、最近使用的儲存庫，或將資料夾拖到這裡。"
          }
        }
      }
    },
