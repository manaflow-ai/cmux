    "markdown.subtitle": {
      "comment": "Help under the markdown empty state title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read and edit a markdown file. Choose a file, pick a recent one, or drop a file here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اقرأ ملف Markdown وحرّره. اختر ملفًا، أو أحد الملفات الأخيرة، أو أفلت ملفًا هنا."
