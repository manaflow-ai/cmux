    "picker.hintPath": {
      "comment": "Hint under the picker's field. Keep / and ~/ as written; ⌘↑ is Command-Up Arrow",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type / or ~/ to enter a path. ⌘↑ opens the enclosing folder."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اكتب / أو ~/ لإدخال مسار. ⌘↑ يفتح المجلد الأعلى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Upišite / ili ~/ za unos putanje. ⌘↑ otvara nadređenu mapu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skriv / eller ~/ for at angive en sti. ⌘↑ åbner den overordnede mappe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tippe / oder ~/ für einen Pfad. ⌘↑ öffnet den übergeordneten Ordner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escribe / o ~/ para indicar una ruta. ⌘↑ abre la carpeta superior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tapez / ou ~/ pour saisir un chemin. ⌘↑ ouvre le dossier parent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Digita / o ~/ per inserire un percorso. ⌘↑ apre la cartella superiore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "/ または ~/ でパスを入力。⌘↑ で親フォルダを開きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "វាយ / ឬ ~/ ដើម្បីបញ្ចូលផ្លូវ។ ⌘↑ បើកថតមេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "/ 또는 ~/를 입력하여 경로를 입력합니다. ⌘↑는 상위 폴더를 엽니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skriv / eller ~/ for å angi en bane. ⌘↑ åpner mappen over."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wpisz / lub ~/, aby podać ścieżkę. ⌘↑ otwiera folder nadrzędny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Digite / ou ~/ para inserir um caminho. ⌘↑ abre a pasta acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Введите / или ~/, чтобы указать путь. ⌘↑ открывает папку уровнем выше."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "พิมพ์ / หรือ ~/ เพื่อป้อนพาธ ⌘↑ เปิดโฟลเดอร์ที่อยู่ด้านบน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yol girmek için / veya ~/ yazın. ⌘↑ üst klasörü açar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Введіть / або ~/, щоб указати шлях. ⌘↑ відкриває батьківську папку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gõ / hoặc ~/ để nhập đường dẫn. ⌘↑ mở thư mục cha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "输入 / 或 ~/ 以输入路径。⌘↑ 打开上层文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "輸入 / 或 ~/ 以輸入路徑。⌘↑ 開啟上層檔案夾。"
          }
        }
      }
    },
