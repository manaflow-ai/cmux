        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lies und bearbeite eine Markdown-Datei. Wähle eine Datei, eine zuletzt verwendete oder lege eine Datei hier ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lee y edita un archivo Markdown. Elige un archivo, uno reciente o suelta un archivo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lisez et modifiez un fichier Markdown. Choisissez un fichier, un fichier récent ou déposez un fichier ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leggi e modifica un file Markdown. Scegli un file, uno recente o trascina qui un file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdownファイルを読み、編集します。ファイルを選ぶか、最近使った項目を選ぶか、ここにファイルをドロップしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អាន និងកែសម្រួលឯកសារ Markdown។ ជ្រើសឯកសារ ជ្រើសឯកសារថ្មីៗ ឬទម្លាក់ឯកសារនៅទីនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Markdown 파일을 읽고 편집합니다. 파일을 선택하거나 최근 항목을 고르거나 여기에 파일을 놓으세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les og rediger en Markdown-fil. Velg en fil, en nylig fil, eller slipp en fil her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Czytaj i edytuj plik Markdown. Wybierz plik, jeden z ostatnich lub upuść tutaj plik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leia e edite um arquivo Markdown. Escolha um arquivo, um recente ou solte um arquivo aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Читайте и редактируйте файл Markdown. Выберите файл, недавний файл или перетащите файл сюда."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อ่านและแก้ไขไฟล์ Markdown เลือกไฟล์ เลือกรายการล่าสุด หรือวางไฟล์ที่นี่"
