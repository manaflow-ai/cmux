    "edited.undoHostLabel": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أعد هذه الملفات كما كانت قبل هذا الدور. تبقى الملفات التي تغيرت منذ ذلك الحين كما هي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vrati ove datoteke kakve su bile prije ovog poteza. Datoteke promijenjene nakon toga ostaju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sæt disse filer tilbage, som de var før denne tur. Filer, der er ændret siden, bevares."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Setzt diese Dateien auf den Stand vor diesem Durchgang zurück. Seitdem geänderte Dateien bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put these files back as they were before this turn. Files changed since then are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Devuelve estos archivos a como estaban antes de este turno. Los archivos cambiados desde entonces se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Remet ces fichiers dans l’état d’avant ce tour. Les fichiers modifiés depuis sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Riporta questi file a com’erano prima di questo turno. I file modificati da allora restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのファイルをこのターンの前の状態に戻します。その後に変更されたファイルはそのまま残ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ដាក់ឯកសារទាំងនេះត្រឡប់ទៅដូចមុនវេននេះ។ ឯកសារដែលបានផ្លាស់ប្ដូរបន្ទាប់មកត្រូវបានរក្សាទុក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 파일들을 이번 턴 이전 상태로 되돌립니다. 그 후 변경된 파일은 그대로 둡니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sett disse filene tilbake slik de var før denne runden. Filer som er endret siden, beholdes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przywraca te pliki do stanu sprzed tej tury. Pliki zmienione później pozostają bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volta estes arquivos ao que eram antes deste turno. Arquivos alterados depois são mantidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вернуть эти файлы к состоянию до этого хода. Файлы, изменённые после него, остаются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คืนไฟล์เหล่านี้ให้เหมือนก่อนรอบนี้ ไฟล์ที่เปลี่ยนหลังจากนั้นจะคงไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu dosyaları bu turdan önceki hâline döndür. O zamandan beri değişen dosyalar korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Повернути ці файли до стану перед цим ходом. Файли, змінені після нього, залишаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đưa các tệp này về như trước lượt này. Tệp đã thay đổi từ đó được giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将这些文件恢复到本轮之前的状态。之后更改过的文件会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "將這些檔案還原為本輪之前的狀態。之後變更過的檔案會保留。"
          }
        }
      }
    },
