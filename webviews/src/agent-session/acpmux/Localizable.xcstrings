    "cloudStart.networkLimited": {"comment":"Agent pane: a new chat starting in Cloud, the machine's network: only what its policy allows","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"محدود"}},"bs":{"stringUnit":{"state":"needs_review","value":"Ograničena"}},"da":{"stringUnit":{"state":"needs_review","value":"Begrænset"}},"de":{"stringUnit":{"state":"translated","value":"Eingeschränkt"}},"en":{"stringUnit":{"state":"translated","value":"Limited"}},"es":{"stringUnit":{"state":"translated","value":"Limitado"}},"fr":{"stringUnit":{"state":"translated","value":"Limité"}},"it":{"stringUnit":{"state":"needs_review","value":"Limitata"}},"ja":{"stringUnit":{"state":"translated","value":"制限あり"}},"km":{"stringUnit":{"state":"needs_review","value":"មានកំណត់"}},"ko":{"stringUnit":{"state":"translated","value":"제한됨"}},"nb":{"stringUnit":{"state":"needs_review","value":"Begrenset"}},"pl":{"stringUnit":{"state":"needs_review","value":"Ograniczona"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Limitada"}},"ru":{"stringUnit":{"state":"needs_review","value":"Ограниченный"}},"th":{"stringUnit":{"state":"needs_review","value":"จำกัด"}},"tr":{"stringUnit":{"state":"needs_review","value":"Sınırlı"}},"uk":{"stringUnit":{"state":"needs_review","value":"Обмежений"}},"vi":{"stringUnit":{"state":"needs_review","value":"Giới hạn"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"受限"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"受限"}}}},
    "composer.cloudAttachments": {"comment":"Agent pane: a notice when a new chat set to run in Cloud has attachments, which a Cloud chat does not take yet (preview)","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"A Cloud chat takes text only for now. Remove the attachments, or start the chat on this Mac."}},"de":{"stringUnit":{"state":"translated","value":"Ein Cloud-Chat nimmt vorerst nur Text an. Entferne die Anhänge oder starte den Chat auf diesem Mac."}},"fr":{"stringUnit":{"state":"translated","value":"Une discussion Cloud n’accepte que du texte pour l’instant. Retirez les pièces jointes ou démarrez la discussion sur ce Mac."}},"ar":{"stringUnit":{"state":"translated","value":"تقبل دردشة Cloud النص فقط حاليًا. أزل المرفقات أو ابدأ الدردشة على هذا الـ Mac."}},"es":{"stringUnit":{"state":"translated","value":"Por ahora, un chat de Cloud solo acepta texto. Quita los adjuntos o inicia el chat en este Mac."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Cloud 對話目前只接受文字。請移除附件，或在這台 Mac 上開始對話。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Cloud 对话目前只接受文字。请移除附件，或在这台 Mac 上开始对话。"}},"ko":{"stringUnit":{"state":"translated","value":"Cloud 채팅은 지금은 텍스트만 받습니다. 첨부 파일을 지우거나 이 Mac에서 채팅을 시작하세요."}},"ja":{"stringUnit":{"state":"translated","value":"Cloud チャットは現在テキストのみ受け付けます。添付を外すか、この Mac でチャットを始めてください。"}},"bs":{"stringUnit":{"state":"needs_review","value":"Cloud chat zasad prima samo tekst. Uklonite priloge ili pokrenite chat na ovom Macu."}},"da":{"stringUnit":{"state":"needs_review","value":"En Cloud-chat tager kun tekst indtil videre. Fjern vedhæftningerne, eller start chatten på denne Mac."}},"it":{"stringUnit":{"state":"needs_review","value":"Per ora una chat Cloud accetta solo testo. Rimuovi gli allegati o avvia la chat su questo Mac."}},"km":{"stringUnit":{"state":"needs_review","value":"ការជជែក Cloud ទទួលតែអត្ថបទប៉ុណ្ណោះសម្រាប់ពេលនេះ។ ដកឯកសារភ្ជាប់ចេញ ឬចាប់ផ្តើមការជជែកនៅលើ Mac នេះ។"}},"nb":{"stringUnit":{"state":"needs_review","value":"En Cloud-chat tar bare tekst foreløpig. Fjern vedleggene, eller start chatten på denne Macen."}},"pl":{"stringUnit":{"state":"needs_review","value":"Czat Cloud przyjmuje na razie tylko tekst. Usuń załączniki albo rozpocznij czat na tym Macu."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Por enquanto, um chat Cloud aceita só texto. Remova os anexos ou inicie o chat neste Mac."}},"ru":{"stringUnit":{"state":"needs_review","value":"Чат в Cloud пока принимает только текст. Уберите вложения или начните чат на этом Mac."}},"th":{"stringUnit":{"state":"needs_review","value":"แชต Cloud รับได้แค่ข้อความในตอนนี้ เอาไฟล์แนบออก หรือเริ่มแชตบน Mac เครื่องนี้"}},"tr":{"stringUnit":{"state":"needs_review","value":"Cloud sohbeti şimdilik yalnızca metin alır. Ekleri kaldırın ya da sohbeti bu Mac’te başlatın."}},"uk":{"stringUnit":{"state":"needs_review","value":"Чат у Cloud поки приймає лише текст. Приберіть вкладення або почніть чат на цьому Mac."}},"vi":{"stringUnit":{"state":"needs_review","value":"Hiện tại, cuộc trò chuyện Cloud chỉ nhận văn bản. Hãy gỡ tệp đính kèm hoặc bắt đầu trò chuyện trên máy Mac này."}}}},
    "composer.cloudRunDetail": {"comment":"Environment picker: one line under the Cloud row (preview): a new chat runs on a Cloud machine the app picks and sizes for it, with no setup","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Picks and sizes a machine for this chat. Nothing to set up."}},"de":{"stringUnit":{"state":"translated","value":"Wählt und dimensioniert eine Maschine für diesen Chat. Nichts einzurichten."}},"fr":{"stringUnit":{"state":"translated","value":"Choisit et dimensionne une machine pour cette discussion. Rien à configurer."}},"ar":{"stringUnit":{"state":"translated","value":"يختار جهازًا لهذه الدردشة ويحدد حجمه. لا شيء لإعداده."}},"es":{"stringUnit":{"state":"translated","value":"Elige y dimensiona una máquina para este chat. Nada que configurar."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"為這段對話挑選並配置合適大小的機器，無需任何設定。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"为这段对话挑选并配置合适大小的机器，无需任何设置。"}},"ko":{"stringUnit":{"state":"translated","value":"이 채팅에 맞는 머신을 골라 크기를 정합니다. 설정할 것이 없습니다."}},"ja":{"stringUnit":{"state":"translated","value":"このチャットに合うマシンを選んでサイズを決めます。設定は不要です。"}},"bs":{"stringUnit":{"state":"needs_review","value":"Bira i dimenzionira mašinu za ovaj chat. Ništa za podešavanje."}},"da":{"stringUnit":{"state":"needs_review","value":"Vælger og dimensionerer en maskine til denne chat. Intet at sætte op."}},"it":{"stringUnit":{"state":"needs_review","value":"Sceglie e dimensiona una macchina per questa chat. Niente da configurare."}},"km":{"stringUnit":{"state":"needs_review","value":"ជ្រើសរើស និងកំណត់ទំហំម៉ាស៊ីនសម្រាប់ការជជែកនេះ។ មិនចាំបាច់រៀបចំអ្វីទេ។"}},"nb":{"stringUnit":{"state":"needs_review","value":"Velger og dimensjonerer en maskin for denne chatten. Ingenting å sette opp."}},"pl":{"stringUnit":{"state":"needs_review","value":"Wybiera i dobiera rozmiar maszyny dla tego czatu. Nic do konfigurowania."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Escolhe e dimensiona uma máquina para este chat. Nada para configurar."}},"ru":{"stringUnit":{"state":"needs_review","value":"Подбирает машину нужного размера для этого чата. Ничего настраивать не нужно."}},"th":{"stringUnit":{"state":"needs_review","value":"เลือกและกำหนดขนาดเครื่องให้แชตนี้ ไม่ต้องตั้งค่าอะไร"}},"tr":{"stringUnit":{"state":"needs_review","value":"Bu sohbet için bir makine seçer ve boyutlandırır. Kurulacak bir şey yok."}},"uk":{"stringUnit":{"state":"needs_review","value":"Підбирає машину потрібного розміру для цього чату. Нічого налаштовувати не треба."}},"vi":{"stringUnit":{"state":"needs_review","value":"Chọn và định cỡ một máy cho cuộc trò chuyện này. Không cần thiết lập gì."}}}},
    "host.peerUnreachable": {"comment":"Agent pane: one muted line above the composer once a chat's machine has been unreachable for minutes (never while it reconnects); {machine} is a machine name such as dev-vm-2","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"needs_review","value":"تعذّر الوصول إلى {machine}."}},"bs":{"stringUnit":{"state":"needs_review","value":"Nije moguće dosegnuti {machine}."}},"da":{"stringUnit":{"state":"needs_review","value":"Kan ikke nå {machine}."}},"de":{"stringUnit":{"state":"needs_review","value":"{machine} ist nicht erreichbar."}},"en":{"stringUnit":{"state":"translated","value":"Can't reach {machine}."}},"es":{"stringUnit":{"state":"needs_review","value":"No se puede conectar con {machine}."}},"fr":{"stringUnit":{"state":"needs_review","value":"Impossible de joindre {machine}."}},"it":{"stringUnit":{"state":"needs_review","value":"Impossibile raggiungere {machine}."}},"ja":{"stringUnit":{"state":"needs_review","value":"{machine} に接続できません。"}},"km":{"stringUnit":{"state":"needs_review","value":"មិនអាចភ្ជាប់ទៅ {machine} បានទេ។"}},"ko":{"stringUnit":{"state":"needs_review","value":"{machine}에 연결할 수 없습니다."}},"nb":{"stringUnit":{"state":"needs_review","value":"Får ikke kontakt med {machine}."}},"pl":{"stringUnit":{"state":"needs_review","value":"Nie można połączyć się z {machine}."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Não foi possível alcançar {machine}."}},"ru":{"stringUnit":{"state":"needs_review","value":"Не удаётся связаться с {machine}."}},"th":{"stringUnit":{"state":"needs_review","value":"ไม่สามารถเชื่อมต่อ {machine} ได้"}},"tr":{"stringUnit":{"state":"needs_review","value":"{machine} makinesine ulaşılamıyor."}},"uk":{"stringUnit":{"state":"needs_review","value":"Не вдається зв'язатися з {machine}."}},"vi":{"stringUnit":{"state":"needs_review","value":"Không thể kết nối tới {machine}."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"无法连接到 {machine}。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"無法連線到 {machine}。"}}}},
    "host.peerUnreachableUnnamed": {"comment":"Agent pane: one muted line above the composer once a chat's machine has been unreachable for minutes, when its name is unknown","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"needs_review","value":"تعذّر الوصول إلى جهاز هذه الدردشة."}},"bs":{"stringUnit":{"state":"needs_review","value":"Nije moguće dosegnuti računar ovog chata."}},"da":{"stringUnit":{"state":"needs_review","value":"Kan ikke nå denne chats maskine."}},"de":{"stringUnit":{"state":"needs_review","value":"Der Rechner dieses Chats ist nicht erreichbar."}},"en":{"stringUnit":{"state":"translated","value":"Can't reach this chat's machine."}},"es":{"stringUnit":{"state":"needs_review","value":"No se puede conectar con la máquina de este chat."}},"fr":{"stringUnit":{"state":"needs_review","value":"Impossible de joindre la machine de cette discussion."}},"it":{"stringUnit":{"state":"needs_review","value":"Impossibile raggiungere la macchina di questa chat."}},"ja":{"stringUnit":{"state":"needs_review","value":"このチャットのマシンに接続できません。"}},"km":{"stringUnit":{"state":"needs_review","value":"មិនអាចភ្ជាប់ទៅម៉ាស៊ីនរបស់ការជជែកនេះបានទេ។"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 채팅의 머신에 연결할 수 없습니다."}},"nb":{"stringUnit":{"state":"needs_review","value":"Får ikke kontakt med maskinen til denne chatten."}},"pl":{"stringUnit":{"state":"needs_review","value":"Nie można połączyć się z maszyną tego czatu."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Não foi possível alcançar a máquina deste chat."}},"ru":{"stringUnit":{"state":"needs_review","value":"Не удаётся связаться с машиной этого чата."}},"th":{"stringUnit":{"state":"needs_review","value":"ไม่สามารถเชื่อมต่อเครื่องของแชตนี้ได้"}},"tr":{"stringUnit":{"state":"needs_review","value":"Bu sohbetin makinesine ulaşılamıyor."}},"uk":{"stringUnit":{"state":"needs_review","value":"Не вдається зв'язатися з машиною цього чату."}},"vi":{"stringUnit":{"state":"needs_review","value":"Không thể kết nối tới máy của cuộc trò chuyện này."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"无法连接到此聊天所在的机器。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"無法連線到此聊天所在的機器。"}}}},
    "host.unavailable": {"comment":"Agent pane: one muted line above the composer when the agent service failed in words meant for its command line (they are behind Details)","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"needs_review","value":"تعذّر الوصول إلى خدمة الوكيل."}},"bs":{"stringUnit":{"state":"needs_review","value":"Nije moguće dosegnuti uslugu agenta."}},"da":{"stringUnit":{"state":"needs_review","value":"Kan ikke nå agenttjenesten."}},"de":{"stringUnit":{"state":"needs_review","value":"Der Agent-Dienst ist nicht erreichbar."}},"en":{"stringUnit":{"state":"translated","value":"Can't reach the agent service."}},"es":{"stringUnit":{"state":"needs_review","value":"No se puede conectar con el servicio de agentes."}},"fr":{"stringUnit":{"state":"needs_review","value":"Impossible de joindre le service d'agents."}},"it":{"stringUnit":{"state":"needs_review","value":"Impossibile raggiungere il servizio degli agenti."}},"ja":{"stringUnit":{"state":"needs_review","value":"エージェントサービスに接続できません。"}},"km":{"stringUnit":{"state":"needs_review","value":"មិនអាចភ្ជាប់ទៅសេវាភ្នាក់ងារបានទេ។"}},"ko":{"stringUnit":{"state":"needs_review","value":"에이전트 서비스에 연결할 수 없습니다."}},"nb":{"stringUnit":{"state":"needs_review","value":"Får ikke kontakt med agenttjenesten."}},"pl":{"stringUnit":{"state":"needs_review","value":"Nie można połączyć się z usługą agenta."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Não foi possível alcançar o serviço de agentes."}},"ru":{"stringUnit":{"state":"needs_review","value":"Не удаётся связаться со службой агентов."}},"th":{"stringUnit":{"state":"needs_review","value":"ไม่สามารถเชื่อมต่อบริการเอเจนต์ได้"}},"tr":{"stringUnit":{"state":"needs_review","value":"Ajan hizmetine ulaşılamıyor."}},"uk":{"stringUnit":{"state":"needs_review","value":"Не вдається зв'язатися зі службою агентів."}},"vi":{"stringUnit":{"state":"needs_review","value":"Không thể kết nối tới dịch vụ tác tử."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"无法连接到智能体服务。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"無法連線到代理服務。"}}}},
    "host.details": {"comment":"Agent pane: a quiet button on the line above the composer that shows the agent service's own error text","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"needs_review","value":"التفاصيل"}},"bs":{"stringUnit":{"state":"needs_review","value":"Detalji"}},"da":{"stringUnit":{"state":"needs_review","value":"Detaljer"}},"de":{"stringUnit":{"state":"needs_review","value":"Details"}},"en":{"stringUnit":{"state":"translated","value":"Details"}},"es":{"stringUnit":{"state":"needs_review","value":"Detalles"}},"fr":{"stringUnit":{"state":"needs_review","value":"Détails"}},"it":{"stringUnit":{"state":"needs_review","value":"Dettagli"}},"ja":{"stringUnit":{"state":"needs_review","value":"詳細"}},"km":{"stringUnit":{"state":"needs_review","value":"ព័ត៌មានលម្អិត"}},"ko":{"stringUnit":{"state":"needs_review","value":"세부 정보"}},"nb":{"stringUnit":{"state":"needs_review","value":"Detaljer"}},"pl":{"stringUnit":{"state":"needs_review","value":"Szczegóły"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Detalhes"}},"ru":{"stringUnit":{"state":"needs_review","value":"Подробности"}},"th":{"stringUnit":{"state":"needs_review","value":"รายละเอียด"}},"tr":{"stringUnit":{"state":"needs_review","value":"Ayrıntılar"}},"uk":{"stringUnit":{"state":"needs_review","value":"Подробиці"}},"vi":{"stringUnit":{"state":"needs_review","value":"Chi tiết"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"详细信息"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"詳細資料"}}}},
    "prompt.failure.tooLarge": {"comment":"Agent pane: under a prompt refused because it was larger than one message can carry (inline attachments); Retry is not offered, Edit is","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Not sent: this message is too large to send at once. Take out an attachment with Edit, or send the attachments in separate messages."}},"ar":{"stringUnit":{"state":"needs_review","value":"لم تُرسَل: هذه الرسالة أكبر من أن تُرسَل دفعة واحدة. أزِل مرفقًا عبر «تعديل»، أو أرسل المرفقات في رسائل منفصلة."}},"bs":{"stringUnit":{"state":"needs_review","value":"Nije poslano: ova poruka je prevelika da bi se poslala odjednom. Uklonite prilog pomoću Uredi ili pošaljite priloge u zasebnim porukama."}},"da":{"stringUnit":{"state":"needs_review","value":"Ikke sendt: denne besked er for stor til at blive sendt på én gang. Fjern en vedhæftning med Rediger, eller send vedhæftningerne i separate beskeder."}},"de":{"stringUnit":{"state":"needs_review","value":"Nicht gesendet: Diese Nachricht ist zu groß, um auf einmal gesendet zu werden. Entferne mit Bearbeiten einen Anhang oder sende die Anhänge in getrennten Nachrichten."}},"es":{"stringUnit":{"state":"needs_review","value":"No enviado: este mensaje es demasiado grande para enviarlo de una vez. Quita un adjunto con Editar o envía los adjuntos en mensajes separados."}},"fr":{"stringUnit":{"state":"needs_review","value":"Non envoyé : ce message est trop volumineux pour être envoyé en une fois. Retirez une pièce jointe avec Modifier, ou envoyez les pièces jointes dans des messages séparés."}},"it":{"stringUnit":{"state":"needs_review","value":"Non inviato: questo messaggio è troppo grande per essere inviato in una volta. Rimuovi un allegato con Modifica o invia gli allegati in messaggi separati."}},"ja":{"stringUnit":{"state":"needs_review","value":"未送信：このメッセージは一度に送信するには大きすぎます。「編集」で添付ファイルを外すか、添付ファイルを別々のメッセージで送信してください。"}},"km":{"stringUnit":{"state":"needs_review","value":"មិនបានផ្ញើ៖ សារនេះធំពេកមិនអាចផ្ញើក្នុងពេលតែមួយបានទេ។ ដកឯកសារភ្ជាប់មួយចេញដោយប្រើ កែសម្រួល ឬផ្ញើឯកសារភ្ជាប់ក្នុងសារដាច់ដោយឡែក។"}},"ko":{"stringUnit":{"state":"needs_review","value":"보내지 않음: 이 메시지는 한 번에 보내기에 너무 큽니다. 편집으로 첨부 파일을 빼거나 첨부 파일을 별도의 메시지로 보내세요."}},"nb":{"stringUnit":{"state":"needs_review","value":"Ikke sendt: denne meldingen er for stor til å sendes på én gang. Fjern et vedlegg med Rediger, eller send vedleggene i separate meldinger."}},"pl":{"stringUnit":{"state":"needs_review","value":"Nie wysłano: ta wiadomość jest za duża, by wysłać ją naraz. Usuń załącznik przez Edytuj albo wyślij załączniki w osobnych wiadomościach."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Não enviada: esta mensagem é grande demais para ser enviada de uma vez. Remova um anexo com Editar ou envie os anexos em mensagens separadas."}},"ru":{"stringUnit":{"state":"needs_review","value":"Не отправлено: это сообщение слишком велико, чтобы отправить его за раз. Уберите вложение через «Изменить» или отправьте вложения отдельными сообщениями."}},"th":{"stringUnit":{"state":"needs_review","value":"ไม่ได้ส่ง: ข้อความนี้ใหญ่เกินกว่าจะส่งในครั้งเดียว นำไฟล์แนบออกด้วย แก้ไข หรือส่งไฟล์แนบแยกเป็นหลายข้อความ"}},"tr":{"stringUnit":{"state":"needs_review","value":"Gönderilmedi: bu ileti tek seferde gönderilemeyecek kadar büyük. Düzenle ile bir eki çıkarın ya da ekleri ayrı iletilerde gönderin."}},"uk":{"stringUnit":{"state":"needs_review","value":"Не надіслано: це повідомлення завелике, щоб надіслати його за раз. Приберіть вкладення через «Редагувати» або надішліть вкладення окремими повідомленнями."}},"vi":{"stringUnit":{"state":"needs_review","value":"Chưa gửi: tin nhắn này quá lớn để gửi một lần. Gỡ một tệp đính kèm bằng Sửa, hoặc gửi các tệp đính kèm trong các tin nhắn riêng."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"未发送：此消息太大，无法一次发送。请用“编辑”移除一个附件，或将附件分成多条消息发送。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"未傳送：此訊息太大，無法一次傳送。請用「編輯」移除一個附件，或將附件分成多則訊息傳送。"}}}},
    "prompt.failure.tooLargeFile": {"comment":"Agent pane: under a prompt refused because it was larger than one message can carry; {name} is the attachment that takes the most of it. Retry is not offered, Edit is","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Not sent: this message is too large to send at once. Take out {name} with Edit, or send it in a message of its own."}},"ar":{"stringUnit":{"state":"needs_review","value":"لم تُرسَل: هذه الرسالة أكبر من أن تُرسَل دفعة واحدة. أزِل {name} عبر «تعديل»، أو أرسله في رسالة مستقلة."}},"bs":{"stringUnit":{"state":"needs_review","value":"Nije poslano: ova poruka je prevelika da bi se poslala odjednom. Uklonite {name} pomoću Uredi ili ga pošaljite u zasebnoj poruci."}},"da":{"stringUnit":{"state":"needs_review","value":"Ikke sendt: denne besked er for stor til at blive sendt på én gang. Fjern {name} med Rediger, eller send den i en besked for sig."}},"de":{"stringUnit":{"state":"needs_review","value":"Nicht gesendet: Diese Nachricht ist zu groß, um auf einmal gesendet zu werden. Entferne {name} mit Bearbeiten oder sende es in einer eigenen Nachricht."}},"es":{"stringUnit":{"state":"needs_review","value":"No enviado: este mensaje es demasiado grande para enviarlo de una vez. Quita {name} con Editar o envíalo en un mensaje aparte."}},"fr":{"stringUnit":{"state":"needs_review","value":"Non envoyé : ce message est trop volumineux pour être envoyé en une fois. Retirez {name} avec Modifier, ou envoyez-le dans un message à part."}},"it":{"stringUnit":{"state":"needs_review","value":"Non inviato: questo messaggio è troppo grande per essere inviato in una volta. Rimuovi {name} con Modifica o invialo in un messaggio a parte."}},"ja":{"stringUnit":{"state":"needs_review","value":"未送信：このメッセージは一度に送信するには大きすぎます。「編集」で {name} を外すか、別のメッセージで送信してください。"}},"km":{"stringUnit":{"state":"needs_review","value":"មិនបានផ្ញើ៖ សារនេះធំពេកមិនអាចផ្ញើក្នុងពេលតែមួយបានទេ។ ដក {name} ចេញដោយប្រើ កែសម្រួល ឬផ្ញើវាក្នុងសារដាច់ដោយឡែក។"}},"ko":{"stringUnit":{"state":"needs_review","value":"보내지 않음: 이 메시지는 한 번에 보내기에 너무 큽니다. 편집으로 {name}을(를) 빼거나 별도의 메시지로 보내세요."}},"nb":{"stringUnit":{"state":"needs_review","value":"Ikke sendt: denne meldingen er for stor til å sendes på én gang. Fjern {name} med Rediger, eller send den i en egen melding."}},"pl":{"stringUnit":{"state":"needs_review","value":"Nie wysłano: ta wiadomość jest za duża, by wysłać ją naraz. Usuń {name} przez Edytuj albo wyślij to w osobnej wiadomości."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Não enviada: esta mensagem é grande demais para ser enviada de uma vez. Remova {name} com Editar ou envie em uma mensagem separada."}},"ru":{"stringUnit":{"state":"needs_review","value":"Не отправлено: это сообщение слишком велико, чтобы отправить его за раз. Уберите {name} через «Изменить» или отправьте отдельным сообщением."}},"th":{"stringUnit":{"state":"needs_review","value":"ไม่ได้ส่ง: ข้อความนี้ใหญ่เกินกว่าจะส่งในครั้งเดียว นำ {name} ออกด้วย แก้ไข หรือส่งแยกเป็นข้อความของมันเอง"}},"tr":{"stringUnit":{"state":"needs_review","value":"Gönderilmedi: bu ileti tek seferde gönderilemeyecek kadar büyük. Düzenle ile {name} ögesini çıkarın ya da ayrı bir iletide gönderin."}},"uk":{"stringUnit":{"state":"needs_review","value":"Не надіслано: це повідомлення завелике, щоб надіслати його за раз. Приберіть {name} через «Редагувати» або надішліть окремим повідомленням."}},"vi":{"stringUnit":{"state":"needs_review","value":"Chưa gửi: tin nhắn này quá lớn để gửi một lần. Gỡ {name} bằng Sửa, hoặc gửi nó trong một tin nhắn riêng."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"未发送：此消息太大，无法一次发送。请用“编辑”移除 {name}，或单独发送它。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"未傳送：此訊息太大，無法一次傳送。請用「編輯」移除 {name}，或單獨傳送它。"}}}},
    "host.tooLarge": {"comment":"Agent pane: the line above the composer when a chat could not be opened because acpmux's reply was larger than one message; the pane no longer retries on its own, the line's Retry does","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This chat is too large to open. Update acpmux, then Retry."}},"ar":{"stringUnit":{"state":"needs_review","value":"هذه المحادثة أكبر من أن تُفتح. حدّث acpmux، ثم أعد المحاولة."}},"bs":{"stringUnit":{"state":"needs_review","value":"Ovaj chat je prevelik za otvaranje. Ažurirajte acpmux, pa pokušajte ponovo."}},"da":{"stringUnit":{"state":"needs_review","value":"Denne chat er for stor til at åbne. Opdater acpmux, og prøv igen."}},"de":{"stringUnit":{"state":"needs_review","value":"Dieser Chat ist zu groß zum Öffnen. Aktualisiere acpmux und versuche es erneut."}},"es":{"stringUnit":{"state":"needs_review","value":"Este chat es demasiado grande para abrirlo. Actualiza acpmux y vuelve a intentarlo."}},"fr":{"stringUnit":{"state":"needs_review","value":"Cette discussion est trop volumineuse pour s’ouvrir. Mettez à jour acpmux, puis réessayez."}},"it":{"stringUnit":{"state":"needs_review","value":"Questa chat è troppo grande per essere aperta. Aggiorna acpmux, poi riprova."}},"ja":{"stringUnit":{"state":"needs_review","value":"このチャットは大きすぎて開けません。acpmux を更新してから再試行してください。"}},"km":{"stringUnit":{"state":"needs_review","value":"ការជជែកនេះធំពេកមិនអាចបើកបានទេ។ ធ្វើបច្ចុប្បន្នភាព acpmux រួចព្យាយាមម្ដងទៀត។"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 채팅은 너무 커서 열 수 없습니다. acpmux를 업데이트한 다음 다시 시도하세요."}},"nb":{"stringUnit":{"state":"needs_review","value":"Denne chatten er for stor til å åpnes. Oppdater acpmux, og prøv igjen."}},"pl":{"stringUnit":{"state":"needs_review","value":"Ten czat jest za duży, by go otworzyć. Zaktualizuj acpmux, a potem spróbuj ponownie."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Este chat é grande demais para abrir. Atualize o acpmux e tente novamente."}},"ru":{"stringUnit":{"state":"needs_review","value":"Этот чат слишком велик, чтобы его открыть. Обновите acpmux и повторите попытку."}},"th":{"stringUnit":{"state":"needs_review","value":"แชทนี้ใหญ่เกินกว่าจะเปิดได้ อัปเดต acpmux แล้วลองอีกครั้ง"}},"tr":{"stringUnit":{"state":"needs_review","value":"Bu sohbet açılamayacak kadar büyük. acpmux'u güncelleyip yeniden deneyin."}},"uk":{"stringUnit":{"state":"needs_review","value":"Цей чат завеликий, щоб його відкрити. Оновіть acpmux, а тоді повторіть спробу."}},"vi":{"stringUnit":{"state":"needs_review","value":"Cuộc trò chuyện này quá lớn để mở. Hãy cập nhật acpmux rồi thử lại."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"此聊天太大，无法打开。请更新 acpmux，然后重试。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"此聊天太大，無法開啟。請更新 acpmux，然後重試。"}}}},
    "featureTip.new": {"comment":"Agent pane feature tip: the pill beside a new feature's title","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"New"}},"ar":{"stringUnit":{"state":"needs_review","value":"جديد"}},"bs":{"stringUnit":{"state":"needs_review","value":"Novo"}},"da":{"stringUnit":{"state":"needs_review","value":"Ny"}},"de":{"stringUnit":{"state":"needs_review","value":"Neu"}},"es":{"stringUnit":{"state":"needs_review","value":"Nuevo"}},"fr":{"stringUnit":{"state":"needs_review","value":"Nouveau"}},"it":{"stringUnit":{"state":"needs_review","value":"Novità"}},"ja":{"stringUnit":{"state":"needs_review","value":"新機能"}},"km":{"stringUnit":{"state":"needs_review","value":"ថ្មី"}},"ko":{"stringUnit":{"state":"needs_review","value":"새 기능"}},"nb":{"stringUnit":{"state":"needs_review","value":"Ny"}},"pl":{"stringUnit":{"state":"needs_review","value":"Nowość"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Novo"}},"ru":{"stringUnit":{"state":"needs_review","value":"Новое"}},"th":{"stringUnit":{"state":"needs_review","value":"ใหม่"}},"tr":{"stringUnit":{"state":"needs_review","value":"Yeni"}},"uk":{"stringUnit":{"state":"needs_review","value":"Нове"}},"vi":{"stringUnit":{"state":"needs_review","value":"Mới"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"新"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"新"}}}},
    "featureTip.close": {"comment":"Agent pane feature tip: the close button's accessible name","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Close tip"}},"ar":{"stringUnit":{"state":"needs_review","value":"إغلاق التلميح"}},"bs":{"stringUnit":{"state":"needs_review","value":"Zatvori savjet"}},"da":{"stringUnit":{"state":"needs_review","value":"Luk tip"}},"de":{"stringUnit":{"state":"needs_review","value":"Tipp schließen"}},"es":{"stringUnit":{"state":"needs_review","value":"Cerrar consejo"}},"fr":{"stringUnit":{"state":"needs_review","value":"Fermer l’astuce"}},"it":{"stringUnit":{"state":"needs_review","value":"Chiudi suggerimento"}},"ja":{"stringUnit":{"state":"needs_review","value":"ヒントを閉じる"}},"km":{"stringUnit":{"state":"needs_review","value":"បិទគន្លឹះ"}},"ko":{"stringUnit":{"state":"needs_review","value":"팁 닫기"}},"nb":{"stringUnit":{"state":"needs_review","value":"Lukk tips"}},"pl":{"stringUnit":{"state":"needs_review","value":"Zamknij wskazówkę"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Fechar dica"}},"ru":{"stringUnit":{"state":"needs_review","value":"Закрыть подсказку"}},"th":{"stringUnit":{"state":"needs_review","value":"ปิดเคล็ดลับ"}},"tr":{"stringUnit":{"state":"needs_review","value":"İpucunu kapat"}},"uk":{"stringUnit":{"state":"needs_review","value":"Закрити підказку"}},"vi":{"stringUnit":{"state":"needs_review","value":"Đóng mẹo"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"关闭提示"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"關閉提示"}}}},
    "access.addCredits": {"comment":"Agent pane: a failed turn's action that opens the cmux paid-plan Checkout (cmux credits), when the cmux model router refused the turn for want of credits or a plan","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Add Credits…"}},"ar":{"stringUnit":{"state":"needs_review","value":"إضافة رصيد…"}},"bs":{"stringUnit":{"state":"needs_review","value":"Dodaj kredite…"}},"da":{"stringUnit":{"state":"needs_review","value":"Tilføj kreditter…"}},"de":{"stringUnit":{"state":"needs_review","value":"Guthaben hinzufügen…"}},"es":{"stringUnit":{"state":"needs_review","value":"Añadir créditos…"}},"fr":{"stringUnit":{"state":"needs_review","value":"Ajouter des crédits…"}},"it":{"stringUnit":{"state":"needs_review","value":"Aggiungi crediti…"}},"ja":{"stringUnit":{"state":"needs_review","value":"クレジットを追加…"}},"km":{"stringUnit":{"state":"needs_review","value":"បន្ថែមឥណទាន…"}},"ko":{"stringUnit":{"state":"needs_review","value":"크레딧 추가…"}},"nb":{"stringUnit":{"state":"needs_review","value":"Legg til kreditter…"}},"pl":{"stringUnit":{"state":"needs_review","value":"Dodaj kredyty…"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Adicionar créditos…"}},"ru":{"stringUnit":{"state":"needs_review","value":"Добавить кредиты…"}},"th":{"stringUnit":{"state":"needs_review","value":"เพิ่มเครดิต…"}},"tr":{"stringUnit":{"state":"needs_review","value":"Kredi ekle…"}},"uk":{"stringUnit":{"state":"needs_review","value":"Додати кредити…"}},"vi":{"stringUnit":{"state":"needs_review","value":"Thêm tín dụng…"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"添加额度…"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"新增額度…"}}}},
    "turn.failure.needsCredits": {"comment":"Agent pane: a failed turn's note when the cmux model router refused it for want of cmux credits or a plan; {harness} is the agent's name","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"{harness} needs cmux credits or your own API key for this model."}},"ar":{"stringUnit":{"state":"needs_review","value":"يحتاج {harness} إلى رصيد cmux أو مفتاح API خاص بك لهذا النموذج."}},"bs":{"stringUnit":{"state":"needs_review","value":"{harness} treba cmux kredite ili vaš vlastiti API ključ za ovaj model."}},"da":{"stringUnit":{"state":"needs_review","value":"{harness} skal bruge cmux-kreditter eller din egen API-nøgle til denne model."}},"de":{"stringUnit":{"state":"needs_review","value":"{harness} braucht für dieses Modell cmux-Guthaben oder deinen eigenen API-Schlüssel."}},"es":{"stringUnit":{"state":"needs_review","value":"{harness} necesita créditos de cmux o tu propia clave de API para este modelo."}},"fr":{"stringUnit":{"state":"needs_review","value":"{harness} a besoin de crédits cmux ou de votre propre clé API pour ce modèle."}},"it":{"stringUnit":{"state":"needs_review","value":"{harness} ha bisogno di crediti cmux o della tua chiave API per questo modello."}},"ja":{"stringUnit":{"state":"needs_review","value":"このモデルを使うには、{harness} に cmux クレジットまたは自分の API キーが必要です。"}},"km":{"stringUnit":{"state":"needs_review","value":"{harness} ត្រូវការឥណទាន cmux ឬកូនសោ API ផ្ទាល់ខ្លួនរបស់អ្នកសម្រាប់ម៉ូដែលនេះ។"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 모델을 사용하려면 {harness}에 cmux 크레딧이나 본인 API 키가 필요합니다."}},"nb":{"stringUnit":{"state":"needs_review","value":"{harness} trenger cmux-kreditter eller din egen API-nøkkel for denne modellen."}},"pl":{"stringUnit":{"state":"needs_review","value":"{harness} potrzebuje kredytów cmux lub własnego klucza API do tego modelu."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"{harness} precisa de créditos cmux ou da sua própria chave de API para este modelo."}},"ru":{"stringUnit":{"state":"needs_review","value":"Для этой модели {harness} нужны кредиты cmux или ваш собственный ключ API."}},"th":{"stringUnit":{"state":"needs_review","value":"{harness} ต้องใช้เครดิต cmux หรือคีย์ API ของคุณเองสำหรับโมเดลนี้"}},"tr":{"stringUnit":{"state":"needs_review","value":"{harness}, bu model için cmux kredisine veya kendi API anahtarınıza ihtiyaç duyuyor."}},"uk":{"stringUnit":{"state":"needs_review","value":"Для цієї моделі {harness} потрібні кредити cmux або ваш власний ключ API."}},"vi":{"stringUnit":{"state":"needs_review","value":"{harness} cần tín dụng cmux hoặc khóa API của riêng bạn cho mô hình này."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"{harness} 需要 cmux 额度或你自己的 API 密钥才能使用此模型。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"{harness} 需要 cmux 額度或你自己的 API 金鑰才能使用此模型。"}}}},
    "backgroundTurn.task": {"comment":"Agent pane transcript: the one muted line of a turn the agent ran on its own after a background task or subagent finished, which had nothing new to say; it opens to show that turn","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Background task finished"}},"ar":{"stringUnit":{"state":"needs_review","value":"انتهت مهمة في الخلفية"}},"bs":{"stringUnit":{"state":"needs_review","value":"Pozadinski zadatak je završen"}},"da":{"stringUnit":{"state":"needs_review","value":"Baggrundsopgave afsluttet"}},"de":{"stringUnit":{"state":"needs_review","value":"Hintergrundaufgabe beendet"}},"es":{"stringUnit":{"state":"needs_review","value":"Tarea en segundo plano terminada"}},"fr":{"stringUnit":{"state":"needs_review","value":"Tâche en arrière-plan terminée"}},"it":{"stringUnit":{"state":"needs_review","value":"Attività in background completata"}},"ja":{"stringUnit":{"state":"needs_review","value":"バックグラウンドタスクが完了"}},"km":{"stringUnit":{"state":"needs_review","value":"កិច្ចការផ្ទៃខាងក្រោយបានបញ្ចប់"}},"ko":{"stringUnit":{"state":"needs_review","value":"백그라운드 작업 완료"}},"nb":{"stringUnit":{"state":"needs_review","value":"Bakgrunnsoppgave fullført"}},"pl":{"stringUnit":{"state":"needs_review","value":"Zadanie w tle zakończone"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Tarefa em segundo plano concluída"}},"ru":{"stringUnit":{"state":"needs_review","value":"Фоновая задача завершена"}},"th":{"stringUnit":{"state":"needs_review","value":"งานเบื้องหลังเสร็จแล้ว"}},"tr":{"stringUnit":{"state":"needs_review","value":"Arka plan görevi bitti"}},"uk":{"stringUnit":{"state":"needs_review","value":"Фонове завдання завершено"}},"vi":{"stringUnit":{"state":"needs_review","value":"Tác vụ nền đã xong"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"后台任务已完成"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"背景工作已完成"}}}},
    "backgroundTurn.scheduled": {"comment":"Agent pane transcript: the one muted line of a turn the agent ran on its own at a scheduled wakeup or loop tick, which had nothing new to say; it opens to show that turn","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Scheduled check"}},"ar":{"stringUnit":{"state":"needs_review","value":"فحص مجدول"}},"bs":{"stringUnit":{"state":"needs_review","value":"Zakazana provjera"}},"da":{"stringUnit":{"state":"needs_review","value":"Planlagt tjek"}},"de":{"stringUnit":{"state":"needs_review","value":"Geplante Prüfung"}},"es":{"stringUnit":{"state":"needs_review","value":"Comprobación programada"}},"fr":{"stringUnit":{"state":"needs_review","value":"Vérification planifiée"}},"it":{"stringUnit":{"state":"needs_review","value":"Controllo pianificato"}},"ja":{"stringUnit":{"state":"needs_review","value":"スケジュールされた確認"}},"km":{"stringUnit":{"state":"needs_review","value":"ការពិនិត្យតាមកាលវិភាគ"}},"ko":{"stringUnit":{"state":"needs_review","value":"예약된 확인"}},"nb":{"stringUnit":{"state":"needs_review","value":"Planlagt sjekk"}},"pl":{"stringUnit":{"state":"needs_review","value":"Zaplanowane sprawdzenie"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Verificação agendada"}},"ru":{"stringUnit":{"state":"needs_review","value":"Плановая проверка"}},"th":{"stringUnit":{"state":"needs_review","value":"การตรวจสอบตามกำหนดเวลา"}},"tr":{"stringUnit":{"state":"needs_review","value":"Zamanlanmış kontrol"}},"uk":{"stringUnit":{"state":"needs_review","value":"Запланована перевірка"}},"vi":{"stringUnit":{"state":"needs_review","value":"Kiểm tra theo lịch"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"定时检查"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"排程檢查"}}}},
    "backgroundTurn.other": {"comment":"Agent pane transcript: the one muted line of a turn the agent ran on its own (a hook, say), which had nothing new to say; it opens to show that turn","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Background update"}},"ar":{"stringUnit":{"state":"needs_review","value":"تحديث في الخلفية"}},"bs":{"stringUnit":{"state":"needs_review","value":"Pozadinsko ažuriranje"}},"da":{"stringUnit":{"state":"needs_review","value":"Baggrundsopdatering"}},"de":{"stringUnit":{"state":"needs_review","value":"Hintergrundaktualisierung"}},"es":{"stringUnit":{"state":"needs_review","value":"Actualización en segundo plano"}},"fr":{"stringUnit":{"state":"needs_review","value":"Mise à jour en arrière-plan"}},"it":{"stringUnit":{"state":"needs_review","value":"Aggiornamento in background"}},"ja":{"stringUnit":{"state":"needs_review","value":"バックグラウンドの更新"}},"km":{"stringUnit":{"state":"needs_review","value":"បច្ចុប្បន្នភាពផ្ទៃខាងក្រោយ"}},"ko":{"stringUnit":{"state":"needs_review","value":"백그라운드 업데이트"}},"nb":{"stringUnit":{"state":"needs_review","value":"Bakgrunnsoppdatering"}},"pl":{"stringUnit":{"state":"needs_review","value":"Aktualizacja w tle"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Atualização em segundo plano"}},"ru":{"stringUnit":{"state":"needs_review","value":"Фоновое обновление"}},"th":{"stringUnit":{"state":"needs_review","value":"อัปเดตเบื้องหลัง"}},"tr":{"stringUnit":{"state":"needs_review","value":"Arka plan güncellemesi"}},"uk":{"stringUnit":{"state":"needs_review","value":"Фонове оновлення"}},"vi":{"stringUnit":{"state":"needs_review","value":"Cập nhật nền"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"后台更新"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"背景更新"}}}},
