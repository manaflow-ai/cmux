    "sessionInfo.subagents.limit.resetLabel" : {
      "comment" : "Agent pane Inspector, Subagents: the Reset button's label: this chat goes back to the running limit it inherits (its parent's, the workspace's or the settings')",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
