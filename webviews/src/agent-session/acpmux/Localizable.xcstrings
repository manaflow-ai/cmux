    "git.commit.pathNotFound": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يعد أحد الملفات المراد إيداعها موجودًا. حدّث وحاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fajl za commit više ne postoji. Osvježite i pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En fil, der skal committes, findes ikke længere. Opdater, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine zu committende Datei existiert nicht mehr. Aktualisiere und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A file to commit no longer exists. Refresh and try again."
