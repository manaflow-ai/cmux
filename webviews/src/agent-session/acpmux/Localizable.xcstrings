        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "보내지 않았습니다. 다시 시도를 눌러 보내세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ikke sendt. Trykk Prøv igjen for å sende den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie wysłano. Naciśnij Ponów, aby wysłać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não enviado. Pressione Tentar novamente para enviar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не отправлено. Нажмите «Повторить», чтобы отправить."
