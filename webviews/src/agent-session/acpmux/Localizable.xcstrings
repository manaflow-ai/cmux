    "permission.error.busy": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتم إرسال قرار إذن بالفعل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odluka o dozvoli se već šalje."
          }
        },
        "da": {
