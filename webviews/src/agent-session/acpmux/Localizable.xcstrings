    "turn.signIn.keyStored": {
      "comment": "Agent pane: Cloud sign-in card, under the API key field.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The key is stored only on this machine." } },
        "ar": { "stringUnit": { "state": "translated", "value": "يُخزَّن المفتاح على هذا الجهاز فقط." } },
        "bs": { "stringUnit": { "state": "translated", "value": "Ključ se čuva samo na ovoj mašini." } },
