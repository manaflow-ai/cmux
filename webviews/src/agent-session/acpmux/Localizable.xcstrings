        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar um novo chat com esta transcrição como primeiro prompt"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начать новый чат с этой записью разговора в качестве первого запроса"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มแชตใหม่โดยใช้บันทึกนี้เป็นพรอมต์แรก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dökümü ilk istem olarak kullanarak yeni bir sohbet başlat"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почати новий чат із цим записом розмови як першим запитом"
