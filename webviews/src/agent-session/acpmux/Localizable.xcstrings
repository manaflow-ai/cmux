      }
    },
    "context.messages":{"comment":"Agent pane: context card row for the tokens the chat's messages use.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Messages"}},"ar":{"stringUnit":{"state":"needs_review","value":"الرسائل"}},"bs":{"stringUnit":{"state":"needs_review","value":"Poruke"}},"da":{"stringUnit":{"state":"needs_review","value":"Beskeder"}},"de":{"stringUnit":{"state":"needs_review","value":"Nachrichten"}},"es":{"stringUnit":{"state":"needs_review","value":"Mensajes"}},"fr":{"stringUnit":{"state":"needs_review","value":"Messages"}},"it":{"stringUnit":{"state":"needs_review","value":"Messaggi"}},"ja":{"stringUnit":{"state":"needs_review","value":"メッセージ"}},"km":{"stringUnit":{"state":"needs_review","value":"សារ"}},"ko":{"stringUnit":{"state":"needs_review","value":"메시지"}},"nb":{"stringUnit":{"state":"needs_review","value":"Meldinger"}},"pl":{"stringUnit":{"state":"needs_review","value":"Wiadomości"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Mensagens"}},"ru":{"stringUnit":{"state":"needs_review","value":"Сообщения"}},"th":{"stringUnit":{"state":"needs_review","value":"ข้อความ"}},"tr":{"stringUnit":{"state":"needs_review","value":"Mesajlar"}},"uk":{"stringUnit":{"state":"needs_review","value":"Повідомлення"}},"vi":{"stringUnit":{"state":"needs_review","value":"Tin nhắn"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"消息"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"訊息"}}}},
    "composer.slashStatus":{"comment":"Composer slash menu: description of cmux's /status command, which opens the Session status card.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Show the effective harness session status."}},"ar":{"stringUnit":{"state":"needs_review","value":"عرض حالة جلسة الأداة الفعلية."}},"bs":{"stringUnit":{"state":"needs_review","value":"Prikaži stvarni status sesije alata."}},"da":{"stringUnit":{"state":"needs_review","value":"Vis den aktuelle sessionsstatus for værktøjet."}},"de":{"stringUnit":{"state":"needs_review","value":"Den tatsächlichen Sitzungsstatus des Harness anzeigen."}},"es":{"stringUnit":{"state":"needs_review","value":"Mostrar el estado efectivo de la sesión del agente."}},"fr":{"stringUnit":{"state":"needs_review","value":"Afficher l'état effectif de la session de l'agent."}},"it":{"stringUnit":{"state":"needs_review","value":"Mostra lo stato effettivo della sessione dell'agente."}},"ja":{"stringUnit":{"state":"needs_review","value":"ハーネスの実際のセッション状態を表示します。"}},"km":{"stringUnit":{"state":"needs_review","value":"បង្ហាញស្ថានភាពវគ្គពិតប្រាកដរបស់ឧបករណ៍។"}},"ko":{"stringUnit":{"state":"needs_review","value":"하네스의 실제 세션 상태를 표시합니다."}},"nb":{"stringUnit":{"state":"needs_review","value":"Vis den faktiske øktstatusen for verktøyet."}},"pl":{"stringUnit":{"state":"needs_review","value":"Pokaż rzeczywisty stan sesji narzędzia."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Mostrar o status efetivo da sessão do agente."}},"ru":{"stringUnit":{"state":"needs_review","value":"Показать фактический статус сеанса."}},"th":{"stringUnit":{"state":"needs_review","value":"แสดงสถานะเซสชันจริงของเครื่องมือ"}},"tr":{"stringUnit":{"state":"needs_review","value":"Aracın geçerli oturum durumunu göster."}},"uk":{"stringUnit":{"state":"needs_review","value":"Показати фактичний стан сеансу."}},"vi":{"stringUnit":{"state":"needs_review","value":"Hiển thị trạng thái phiên thực tế của công cụ."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"显示工具当前的实际会话状态。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"顯示工具目前的實際工作階段狀態。"}}}},
    "composer.slashCd":{"comment":"Composer slash menu: description of cmux's /cd command, which moves the chat to another folder (a chat with turns opens a new chat there).","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Work in another folder."}},"ar":{"stringUnit":{"state":"needs_review","value":"العمل في مجلد آخر."}},"bs":{"stringUnit":{"state":"needs_review","value":"Radi u drugoj mapi."}},"da":{"stringUnit":{"state":"needs_review","value":"Arbejd i en anden mappe."}},"de":{"stringUnit":{"state":"needs_review","value":"In einem anderen Ordner arbeiten."}},"es":{"stringUnit":{"state":"needs_review","value":"Trabajar en otra carpeta."}},"fr":{"stringUnit":{"state":"needs_review","value":"Travailler dans un autre dossier."}},"it":{"stringUnit":{"state":"needs_review","value":"Lavora in un'altra cartella."}},"ja":{"stringUnit":{"state":"needs_review","value":"別のフォルダで作業します。"}},"km":{"stringUnit":{"state":"needs_review","value":"ធ្វើការក្នុងថតផ្សេង។"}},"ko":{"stringUnit":{"state":"needs_review","value":"다른 폴더에서 작업합니다."}},"nb":{"stringUnit":{"state":"needs_review","value":"Arbeid i en annen mappe."}},"pl":{"stringUnit":{"state":"needs_review","value":"Pracuj w innym folderze."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Trabalhar em outra pasta."}},"ru":{"stringUnit":{"state":"needs_review","value":"Работать в другой папке."}},"th":{"stringUnit":{"state":"needs_review","value":"ทำงานในโฟลเดอร์อื่น"}},"tr":{"stringUnit":{"state":"needs_review","value":"Başka bir klasörde çalış."}},"uk":{"stringUnit":{"state":"needs_review","value":"Працювати в іншій папці."}},"vi":{"stringUnit":{"state":"needs_review","value":"Làm việc trong thư mục khác."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"在另一个文件夹中工作。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"在另一個資料夾中工作。"}}}},
    "composer.cmuxCdPath":{"comment":"Agent pane: inline refusal for /cd with a path the pane cannot read (~ or a relative path with no chat folder).","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Type the folder's full path, starting with /, or a path relative to this chat's folder."}},"ar":{"stringUnit":{"state":"needs_review","value":"اكتب المسار الكامل للمجلد بدءًا بـ /، أو مسارًا نسبيًا إلى مجلد هذه الدردشة."}},"bs":{"stringUnit":{"state":"needs_review","value":"Upišite punu putanju mape koja počinje sa /, ili putanju u odnosu na mapu ovog razgovora."}},"da":{"stringUnit":{"state":"needs_review","value":"Skriv mappens fulde sti, der starter med /, eller en sti i forhold til denne chats mappe."}},"de":{"stringUnit":{"state":"needs_review","value":"Gib den vollständigen Pfad des Ordners ein, beginnend mit /, oder einen Pfad relativ zum Ordner dieses Chats."}},"es":{"stringUnit":{"state":"needs_review","value":"Escribe la ruta completa de la carpeta, empezando por /, o una ruta relativa a la carpeta de este chat."}},"fr":{"stringUnit":{"state":"needs_review","value":"Saisissez le chemin complet du dossier, commençant par /, ou un chemin relatif au dossier de cette discussion."}},"it":{"stringUnit":{"state":"needs_review","value":"Digita il percorso completo della cartella, che inizia con /, o un percorso relativo alla cartella di questa chat."}},"ja":{"stringUnit":{"state":"needs_review","value":"/ で始まるフォルダのフルパス、またはこのチャットのフォルダからの相対パスを入力してください。"}},"km":{"stringUnit":{"state":"needs_review","value":"វាយផ្លូវពេញរបស់ថតដែលចាប់ផ្តើមដោយ / ឬផ្លូវទាក់ទងនឹងថតរបស់ការជជែកនេះ។"}},"ko":{"stringUnit":{"state":"needs_review","value":"/로 시작하는 폴더의 전체 경로 또는 이 채팅 폴더 기준의 상대 경로를 입력하세요."}},"nb":{"stringUnit":{"state":"needs_review","value":"Skriv inn mappens fullstendige bane som starter med /, eller en bane relativt til denne chattens mappe."}},"pl":{"stringUnit":{"state":"needs_review","value":"Wpisz pełną ścieżkę folderu zaczynającą się od / lub ścieżkę względną wobec folderu tego czatu."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Digite o caminho completo da pasta, começando com /, ou um caminho relativo à pasta deste chat."}},"ru":{"stringUnit":{"state":"needs_review","value":"Введите полный путь к папке, начиная с /, или путь относительно папки этого чата."}},"th":{"stringUnit":{"state":"needs_review","value":"พิมพ์พาธเต็มของโฟลเดอร์ที่ขึ้นต้นด้วย / หรือพาธที่สัมพันธ์กับโฟลเดอร์ของแชทนี้"}},"tr":{"stringUnit":{"state":"needs_review","value":"Klasörün / ile başlayan tam yolunu veya bu sohbetin klasörüne göre bir yol yazın."}},"uk":{"stringUnit":{"state":"needs_review","value":"Введіть повний шлях до папки, що починається з /, або шлях відносно папки цього чату."}},"vi":{"stringUnit":{"state":"needs_review","value":"Nhập đường dẫn đầy đủ của thư mục, bắt đầu bằng /, hoặc đường dẫn tương đối với thư mục của cuộc trò chuyện này."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"请输入以 / 开头的文件夹完整路径，或相对于此聊天文件夹的路径。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"請輸入以 / 開頭的資料夾完整路徑，或相對於此聊天資料夾的路徑。"}}}},
    "composer.cmuxCdNotFolder":{"comment":"Agent pane: inline refusal for /cd when the host says the path is not a folder. {folder} is the resolved path.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"{folder} is not a folder."}},"ar":{"stringUnit":{"state":"needs_review","value":"{folder} ليس مجلدًا."}},"bs":{"stringUnit":{"state":"needs_review","value":"{folder} nije mapa."}},"da":{"stringUnit":{"state":"needs_review","value":"{folder} er ikke en mappe."}},"de":{"stringUnit":{"state":"needs_review","value":"{folder} ist kein Ordner."}},"es":{"stringUnit":{"state":"needs_review","value":"{folder} no es una carpeta."}},"fr":{"stringUnit":{"state":"needs_review","value":"{folder} n'est pas un dossier."}},"it":{"stringUnit":{"state":"needs_review","value":"{folder} non è una cartella."}},"ja":{"stringUnit":{"state":"needs_review","value":"{folder} はフォルダではありません。"}},"km":{"stringUnit":{"state":"needs_review","value":"{folder} មិនមែនជាថតទេ។"}},"ko":{"stringUnit":{"state":"needs_review","value":"{folder}은(는) 폴더가 아닙니다."}},"nb":{"stringUnit":{"state":"needs_review","value":"{folder} er ikke en mappe."}},"pl":{"stringUnit":{"state":"needs_review","value":"{folder} nie jest folderem."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"{folder} não é uma pasta."}},"ru":{"stringUnit":{"state":"needs_review","value":"{folder} не является папкой."}},"th":{"stringUnit":{"state":"needs_review","value":"{folder} ไม่ใช่โฟลเดอร์"}},"tr":{"stringUnit":{"state":"needs_review","value":"{folder} bir klasör değil."}},"uk":{"stringUnit":{"state":"needs_review","value":"{folder} не є папкою."}},"vi":{"stringUnit":{"state":"needs_review","value":"{folder} không phải là thư mục."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"{folder} 不是文件夹。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"{folder} 不是資料夾。"}}}},
    "composer.cmuxCdNewTab":{"comment":"Agent pane: inline refusal for /cd on New Tab, where the project chip picks the folder.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Pick the folder in the project menu below."}},"ar":{"stringUnit":{"state":"needs_review","value":"اختر المجلد من قائمة المشروع أدناه."}},"bs":{"stringUnit":{"state":"needs_review","value":"Odaberite mapu u meniju projekta ispod."}},"da":{"stringUnit":{"state":"needs_review","value":"Vælg mappen i projektmenuen nedenfor."}},"de":{"stringUnit":{"state":"needs_review","value":"Wähle den Ordner im Projektmenü unten."}},"es":{"stringUnit":{"state":"needs_review","value":"Elige la carpeta en el menú de proyecto de abajo."}},"fr":{"stringUnit":{"state":"needs_review","value":"Choisissez le dossier dans le menu du projet ci-dessous."}},"it":{"stringUnit":{"state":"needs_review","value":"Scegli la cartella nel menu del progetto qui sotto."}},"ja":{"stringUnit":{"state":"needs_review","value":"下のプロジェクトメニューでフォルダを選んでください。"}},"km":{"stringUnit":{"state":"needs_review","value":"ជ្រើសថតនៅក្នុងម៉ឺនុយគម្រោងខាងក្រោម។"}},"ko":{"stringUnit":{"state":"needs_review","value":"아래 프로젝트 메뉴에서 폴더를 선택하세요."}},"nb":{"stringUnit":{"state":"needs_review","value":"Velg mappen i prosjektmenyen nedenfor."}},"pl":{"stringUnit":{"state":"needs_review","value":"Wybierz folder w menu projektu poniżej."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Escolha a pasta no menu de projeto abaixo."}},"ru":{"stringUnit":{"state":"needs_review","value":"Выберите папку в меню проекта ниже."}},"th":{"stringUnit":{"state":"needs_review","value":"เลือกโฟลเดอร์ในเมนูโปรเจกต์ด้านล่าง"}},"tr":{"stringUnit":{"state":"needs_review","value":"Klasörü aşağıdaki proje menüsünden seçin."}},"uk":{"stringUnit":{"state":"needs_review","value":"Виберіть папку в меню проєкту нижче."}},"vi":{"stringUnit":{"state":"needs_review","value":"Chọn thư mục trong menu dự án bên dưới."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"请在下方的项目菜单中选择文件夹。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"請在下方的專案選單中選擇資料夾。"}}}},
    "upload.notStarted":{"comment":"Composer: an attachment's error when the host refused to start its upload.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The upload could not be started."}},"ar":{"stringUnit":{"state":"needs_review","value":"تعذر بدء الرفع."}},"bs":{"stringUnit":{"state":"needs_review","value":"Otpremanje nije moguće započeti."}},"da":{"stringUnit":{"state":"needs_review","value":"Overførslen kunne ikke startes."}},"de":{"stringUnit":{"state":"needs_review","value":"Der Upload konnte nicht gestartet werden."}},"es":{"stringUnit":{"state":"needs_review","value":"No se pudo iniciar la carga."}},"fr":{"stringUnit":{"state":"needs_review","value":"Impossible de démarrer l'envoi."}},"it":{"stringUnit":{"state":"needs_review","value":"Impossibile avviare il caricamento."}},"ja":{"stringUnit":{"state":"needs_review","value":"アップロードを開始できませんでした。"}},"km":{"stringUnit":{"state":"needs_review","value":"មិនអាចចាប់ផ្តើមការផ្ទុកឡើងបានទេ។"}},"ko":{"stringUnit":{"state":"needs_review","value":"업로드를 시작할 수 없습니다."}},"nb":{"stringUnit":{"state":"needs_review","value":"Opplastingen kunne ikke startes."}},"pl":{"stringUnit":{"state":"needs_review","value":"Nie można rozpocząć przesyłania."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Não foi possível iniciar o envio."}},"ru":{"stringUnit":{"state":"needs_review","value":"Не удалось начать загрузку."}},"th":{"stringUnit":{"state":"needs_review","value":"ไม่สามารถเริ่มการอัปโหลดได้"}},"tr":{"stringUnit":{"state":"needs_review","value":"Yükleme başlatılamadı."}},"uk":{"stringUnit":{"state":"needs_review","value":"Не вдалося почати завантаження."}},"vi":{"stringUnit":{"state":"needs_review","value":"Không thể bắt đầu tải lên."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"无法开始上传。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"無法開始上傳。"}}}},
    "upload.notRead":{"comment":"Composer: an attachment's error when the page could not read the file's bytes.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The file could not be read."}},"ar":{"stringUnit":{"state":"needs_review","value":"تعذرت قراءة الملف."}},"bs":{"stringUnit":{"state":"needs_review","value":"Datoteku nije moguće pročitati."}},"da":{"stringUnit":{"state":"needs_review","value":"Filen kunne ikke læses."}},"de":{"stringUnit":{"state":"needs_review","value":"Die Datei konnte nicht gelesen werden."}},"es":{"stringUnit":{"state":"needs_review","value":"No se pudo leer el archivo."}},"fr":{"stringUnit":{"state":"needs_review","value":"Impossible de lire le fichier."}},"it":{"stringUnit":{"state":"needs_review","value":"Impossibile leggere il file."}},"ja":{"stringUnit":{"state":"needs_review","value":"ファイルを読み込めませんでした。"}},"km":{"stringUnit":{"state":"needs_review","value":"មិនអាចអានឯកសារបានទេ។"}},"ko":{"stringUnit":{"state":"needs_review","value":"파일을 읽을 수 없습니다."}},"nb":{"stringUnit":{"state":"needs_review","value":"Filen kunne ikke leses."}},"pl":{"stringUnit":{"state":"needs_review","value":"Nie można odczytać pliku."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Não foi possível ler o arquivo."}},"ru":{"stringUnit":{"state":"needs_review","value":"Не удалось прочитать файл."}},"th":{"stringUnit":{"state":"needs_review","value":"ไม่สามารถอ่านไฟล์ได้"}},"tr":{"stringUnit":{"state":"needs_review","value":"Dosya okunamadı."}},"uk":{"stringUnit":{"state":"needs_review","value":"Не вдалося прочитати файл."}},"vi":{"stringUnit":{"state":"needs_review","value":"Không thể đọc tệp."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"无法读取文件。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"無法讀取檔案。"}}}},
    "upload.cancelled":{"comment":"Composer: an attachment's error when its upload was cancelled, by the person or by the host, before the host had the whole file.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The upload was cancelled."}},"ar":{"stringUnit":{"state":"needs_review","value":"تم إلغاء الرفع."}},"bs":{"stringUnit":{"state":"needs_review","value":"Otpremanje je otkazano."}},"da":{"stringUnit":{"state":"needs_review","value":"Overførslen blev annulleret."}},"de":{"stringUnit":{"state":"needs_review","value":"Der Upload wurde abgebrochen."}},"es":{"stringUnit":{"state":"needs_review","value":"Se canceló la carga."}},"fr":{"stringUnit":{"state":"needs_review","value":"L'envoi a été annulé."}},"it":{"stringUnit":{"state":"needs_review","value":"Il caricamento è stato annullato."}},"ja":{"stringUnit":{"state":"needs_review","value":"アップロードはキャンセルされました。"}},"km":{"stringUnit":{"state":"needs_review","value":"ការផ្ទុកឡើងត្រូវបានបោះបង់។"}},"ko":{"stringUnit":{"state":"needs_review","value":"업로드가 취소되었습니다."}},"nb":{"stringUnit":{"state":"needs_review","value":"Opplastingen ble avbrutt."}},"pl":{"stringUnit":{"state":"needs_review","value":"Przesyłanie zostało anulowane."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O envio foi cancelado."}},"ru":{"stringUnit":{"state":"needs_review","value":"Загрузка отменена."}},"th":{"stringUnit":{"state":"needs_review","value":"การอัปโหลดถูกยกเลิก"}},"tr":{"stringUnit":{"state":"needs_review","value":"Yükleme iptal edildi."}},"uk":{"stringUnit":{"state":"needs_review","value":"Завантаження скасовано."}},"vi":{"stringUnit":{"state":"needs_review","value":"Đã hủy tải lên."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"上传已取消。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"上傳已取消。"}}}},
    "upload.notCompleted":{"comment":"Composer: an attachment's error when its upload stopped before the host had the whole file.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The upload could not be completed."}},"ar":{"stringUnit":{"state":"needs_review","value":"تعذر إكمال الرفع."}},"bs":{"stringUnit":{"state":"needs_review","value":"Otpremanje nije moguće dovršiti."}},"da":{"stringUnit":{"state":"needs_review","value":"Overførslen kunne ikke fuldføres."}},"de":{"stringUnit":{"state":"needs_review","value":"Der Upload konnte nicht abgeschlossen werden."}},"es":{"stringUnit":{"state":"needs_review","value":"No se pudo completar la carga."}},"fr":{"stringUnit":{"state":"needs_review","value":"Impossible de terminer l'envoi."}},"it":{"stringUnit":{"state":"needs_review","value":"Impossibile completare il caricamento."}},"ja":{"stringUnit":{"state":"needs_review","value":"アップロードを完了できませんでした。"}},"km":{"stringUnit":{"state":"needs_review","value":"មិនអាចបញ្ចប់ការផ្ទុកឡើងបានទេ។"}},"ko":{"stringUnit":{"state":"needs_review","value":"업로드를 완료할 수 없습니다."}},"nb":{"stringUnit":{"state":"needs_review","value":"Opplastingen kunne ikke fullføres."}},"pl":{"stringUnit":{"state":"needs_review","value":"Nie można ukończyć przesyłania."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Não foi possível concluir o envio."}},"ru":{"stringUnit":{"state":"needs_review","value":"Не удалось завершить загрузку."}},"th":{"stringUnit":{"state":"needs_review","value":"ไม่สามารถอัปโหลดให้เสร็จได้"}},"tr":{"stringUnit":{"state":"needs_review","value":"Yükleme tamamlanamadı."}},"uk":{"stringUnit":{"state":"needs_review","value":"Не вдалося завершити завантаження."}},"vi":{"stringUnit":{"state":"needs_review","value":"Không thể hoàn tất tải lên."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"无法完成上传。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"無法完成上傳。"}}}},
    "upload.hostTooLarge":{"comment":"Composer: an attachment's error when an older host can take the file only in one message and it is too large for that.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This host cannot stream an attachment this large."}},"ar":{"stringUnit":{"state":"needs_review","value":"لا يستطيع هذا المضيف نقل مرفق بهذا الحجم."}},"bs":{"stringUnit":{"state":"needs_review","value":"Ovaj host ne može prenijeti ovako veliki prilog."}},"da":{"stringUnit":{"state":"needs_review","value":"Denne vært kan ikke overføre en så stor vedhæftet fil."}},"de":{"stringUnit":{"state":"needs_review","value":"Dieser Host kann einen so großen Anhang nicht übertragen."}},"es":{"stringUnit":{"state":"needs_review","value":"Este host no puede transmitir un adjunto tan grande."}},"fr":{"stringUnit":{"state":"needs_review","value":"Cet hôte ne peut pas transmettre une pièce jointe aussi volumineuse."}},"it":{"stringUnit":{"state":"needs_review","value":"Questo host non può trasmettere un allegato così grande."}},"ja":{"stringUnit":{"state":"needs_review","value":"このホストはこのサイズの添付ファイルを転送できません。"}},"km":{"stringUnit":{"state":"needs_review","value":"ម៉ាស៊ីននេះមិនអាចបញ្ជូនឯកសារភ្ជាប់ធំបែបនេះបានទេ។"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 호스트는 이렇게 큰 첨부 파일을 전송할 수 없습니다."}},"nb":{"stringUnit":{"state":"needs_review","value":"Denne verten kan ikke overføre et så stort vedlegg."}},"pl":{"stringUnit":{"state":"needs_review","value":"Ten host nie może przesłać tak dużego załącznika."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Este host não consegue transmitir um anexo tão grande."}},"ru":{"stringUnit":{"state":"needs_review","value":"Этот хост не может передать такое большое вложение."}},"th":{"stringUnit":{"state":"needs_review","value":"โฮสต์นี้ไม่สามารถส่งไฟล์แนบขนาดใหญ่ขนาดนี้ได้"}},"tr":{"stringUnit":{"state":"needs_review","value":"Bu ana bilgisayar bu kadar büyük bir eki aktaramaz."}},"uk":{"stringUnit":{"state":"needs_review","value":"Цей хост не може передати таке велике вкладення."}},"vi":{"stringUnit":{"state":"needs_review","value":"Máy chủ này không thể truyền tệp đính kèm lớn như vậy."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"此主机无法传输这么大的附件。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"此主機無法傳輸這麼大的附件。"}}}},
    "attachment.source":{"comment":"Agent pane: an attachment's tooltip line naming the app it came from; {name} is the app, such as Google Chrome or cmux.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"From {name}"}},"ar":{"stringUnit":{"state":"needs_review","value":"المصدر: {name}"}},"bs":{"stringUnit":{"state":"needs_review","value":"Izvor: {name}"}},"da":{"stringUnit":{"state":"needs_review","value":"Kilde: {name}"}},"de":{"stringUnit":{"state":"needs_review","value":"Quelle: {name}"}},"es":{"stringUnit":{"state":"needs_review","value":"Origen: {name}"}},"fr":{"stringUnit":{"state":"needs_review","value":"Source : {name}"}},"it":{"stringUnit":{"state":"needs_review","value":"Origine: {name}"}},"ja":{"stringUnit":{"state":"needs_review","value":"取得元: {name}"}},"km":{"stringUnit":{"state":"needs_review","value":"ប្រភព៖ {name}"}},"ko":{"stringUnit":{"state":"needs_review","value":"출처: {name}"}},"nb":{"stringUnit":{"state":"needs_review","value":"Kilde: {name}"}},"pl":{"stringUnit":{"state":"needs_review","value":"Źródło: {name}"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Origem: {name}"}},"ru":{"stringUnit":{"state":"needs_review","value":"Источник: {name}"}},"th":{"stringUnit":{"state":"needs_review","value":"แหล่งที่มา: {name}"}},"tr":{"stringUnit":{"state":"needs_review","value":"Kaynak: {name}"}},"uk":{"stringUnit":{"state":"needs_review","value":"Джерело: {name}"}},"vi":{"stringUnit":{"state":"needs_review","value":"Nguồn: {name}"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"来源：{name}"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"來源：{name}"}}}},
    "attachment.sourceSite":{"comment":"Agent pane: an attachment's tooltip line naming the app it came from and the website it was downloaded from; {name} is the app, {site} the site's host, such as github.com.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"From {name} · {site}"}},"ar":{"stringUnit":{"state":"needs_review","value":"المصدر: {name} · {site}"}},"bs":{"stringUnit":{"state":"needs_review","value":"Izvor: {name} · {site}"}},"da":{"stringUnit":{"state":"needs_review","value":"Kilde: {name} · {site}"}},"de":{"stringUnit":{"state":"needs_review","value":"Quelle: {name} · {site}"}},"es":{"stringUnit":{"state":"needs_review","value":"Origen: {name} · {site}"}},"fr":{"stringUnit":{"state":"needs_review","value":"Source : {name} · {site}"}},"it":{"stringUnit":{"state":"needs_review","value":"Origine: {name} · {site}"}},"ja":{"stringUnit":{"state":"needs_review","value":"取得元: {name} · {site}"}},"km":{"stringUnit":{"state":"needs_review","value":"ប្រភព៖ {name} · {site}"}},"ko":{"stringUnit":{"state":"needs_review","value":"출처: {name} · {site}"}},"nb":{"stringUnit":{"state":"needs_review","value":"Kilde: {name} · {site}"}},"pl":{"stringUnit":{"state":"needs_review","value":"Źródło: {name} · {site}"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Origem: {name} · {site}"}},"ru":{"stringUnit":{"state":"needs_review","value":"Источник: {name} · {site}"}},"th":{"stringUnit":{"state":"needs_review","value":"แหล่งที่มา: {name} · {site}"}},"tr":{"stringUnit":{"state":"needs_review","value":"Kaynak: {name} · {site}"}},"uk":{"stringUnit":{"state":"needs_review","value":"Джерело: {name} · {site}"}},"vi":{"stringUnit":{"state":"needs_review","value":"Nguồn: {name} · {site}"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"来源：{name} · {site}"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"來源：{name} · {site}"}}}},
    "attachment.unavailable":{"comment":"Agent pane: error when a sent prompt's attachment can no longer be read back for Edit or Retry; {name} is the attachment's name.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Attachment unavailable: {name}"}},"ar":{"stringUnit":{"state":"needs_review","value":"المرفق غير متاح: {name}"}},"bs":{"stringUnit":{"state":"needs_review","value":"Prilog nije dostupan: {name}"}},"da":{"stringUnit":{"state":"needs_review","value":"Vedhæftet fil er ikke tilgængelig: {name}"}},"de":{"stringUnit":{"state":"needs_review","value":"Anhang nicht verfügbar: {name}"}},"es":{"stringUnit":{"state":"needs_review","value":"Adjunto no disponible: {name}"}},"fr":{"stringUnit":{"state":"needs_review","value":"Pièce jointe indisponible : {name}"}},"it":{"stringUnit":{"state":"needs_review","value":"Allegato non disponibile: {name}"}},"ja":{"stringUnit":{"state":"needs_review","value":"添付ファイルを利用できません: {name}"}},"km":{"stringUnit":{"state":"needs_review","value":"ឯកសារភ្ជាប់មិនអាចប្រើបាន៖ {name}"}},"ko":{"stringUnit":{"state":"needs_review","value":"첨부 파일을 사용할 수 없음: {name}"}},"nb":{"stringUnit":{"state":"needs_review","value":"Vedlegget er ikke tilgjengelig: {name}"}},"pl":{"stringUnit":{"state":"needs_review","value":"Załącznik niedostępny: {name}"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Anexo indisponível: {name}"}},"ru":{"stringUnit":{"state":"needs_review","value":"Вложение недоступно: {name}"}},"th":{"stringUnit":{"state":"needs_review","value":"ไฟล์แนบไม่พร้อมใช้งาน: {name}"}},"tr":{"stringUnit":{"state":"needs_review","value":"Ek kullanılamıyor: {name}"}},"uk":{"stringUnit":{"state":"needs_review","value":"Вкладення недоступне: {name}"}},"vi":{"stringUnit":{"state":"needs_review","value":"Tệp đính kèm không khả dụng: {name}"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"附件不可用：{name}"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"附件無法使用：{name}"}}}},
    "attachment.notLocal":{"comment":"Agent pane: error when a sent prompt's linked attachment is not a file on this Mac, so Edit or Retry cannot attach it again.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Attachment is not a local file"}},"ar":{"stringUnit":{"state":"needs_review","value":"المرفق ليس ملفًا محليًا"}},"bs":{"stringUnit":{"state":"needs_review","value":"Prilog nije lokalna datoteka"}},"da":{"stringUnit":{"state":"needs_review","value":"Den vedhæftede fil er ikke en lokal fil"}},"de":{"stringUnit":{"state":"needs_review","value":"Der Anhang ist keine lokale Datei"}},"es":{"stringUnit":{"state":"needs_review","value":"El adjunto no es un archivo local"}},"fr":{"stringUnit":{"state":"needs_review","value":"La pièce jointe n'est pas un fichier local"}},"it":{"stringUnit":{"state":"needs_review","value":"L'allegato non è un file locale"}},"ja":{"stringUnit":{"state":"needs_review","value":"添付ファイルはローカルファイルではありません"}},"km":{"stringUnit":{"state":"needs_review","value":"ឯកសារភ្ជាប់មិនមែនជាឯកសារមូលដ្ឋានទេ"}},"ko":{"stringUnit":{"state":"needs_review","value":"첨부 파일이 로컬 파일이 아닙니다"}},"nb":{"stringUnit":{"state":"needs_review","value":"Vedlegget er ikke en lokal fil"}},"pl":{"stringUnit":{"state":"needs_review","value":"Załącznik nie jest plikiem lokalnym"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O anexo não é um arquivo local"}},"ru":{"stringUnit":{"state":"needs_review","value":"Вложение не является локальным файлом"}},"th":{"stringUnit":{"state":"needs_review","value":"ไฟล์แนบไม่ใช่ไฟล์ในเครื่อง"}},"tr":{"stringUnit":{"state":"needs_review","value":"Ek yerel bir dosya değil"}},"uk":{"stringUnit":{"state":"needs_review","value":"Вкладення не є локальним файлом"}},"vi":{"stringUnit":{"state":"needs_review","value":"Tệp đính kèm không phải là tệp cục bộ"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"附件不是本地文件"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"附件不是本機檔案"}}}},
