    "picker.modeRefused": {
      "comment": "Agent pane: why a permission mode row is disabled, after the agent or the organization's managed settings refused it",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "غير مسموح به على هذا الـMac: رفض الوكيل أو إعدادات مؤسستك هذا الوضع"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nije dozvoljeno na ovom Macu: agent ili postavke vaše organizacije odbili su ovaj način"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ikke tilladt på denne Mac: agenten eller din organisations indstillinger afviste denne tilstand"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auf diesem Mac nicht erlaubt: Der Agent oder die Einstellungen deiner Organisation haben diesen Modus abgelehnt"
