        "it": { "stringUnit": { "state": "translated", "value": "La chiave è salvata solo su questa macchina." } },
        "ja": { "stringUnit": { "state": "translated", "value": "キーはこのマシンにのみ保存されます。" } },
        "km": { "stringUnit": { "state": "translated", "value": "សោត្រូវបានរក្សាទុកតែលើម៉ាស៊ីននេះប៉ុណ្ណោះ។" } },
        "ko": { "stringUnit": { "state": "translated", "value": "키는 이 머신에만 저장됩니다." } },
        "nb": { "stringUnit": { "state": "translated", "value": "Nøkkelen lagres bare på denne maskinen." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Klucz jest przechowywany tylko na tej maszynie." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "A chave fica armazenada apenas nesta máquina." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Ключ хранится только на этой машине." } },
        "th": { "stringUnit": { "state": "translated", "value": "คีย์จะถูกเก็บไว้บนเครื่องนี้เท่านั้น" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Anahtar yalnızca bu makinede saklanır." } },
