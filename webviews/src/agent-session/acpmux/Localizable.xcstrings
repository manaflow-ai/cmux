{
  "sourceLanguage": "en",
  "strings": {
    "approval.title": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "كيف تتم الموافقة على إجراءات الوكيل؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kako treba odobravati radnje agenta?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvordan skal agentens handlinger godkendes?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wie sollen die Aktionen des Agenten genehmigt werden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How should the agent's actions be approved?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Cómo se deben aprobar las acciones del agente?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comment approuver les actions de l'agent ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Come devono essere approvate le azioni dell'agente?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントの操作をどのように承認しますか？"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "តើគួរអនុម័តសកម្មភាពរបស់ភ្នាក់ងារយ៉ាងដូចម្តេច?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트의 작업을 어떻게 승인할까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvordan skal agentens handlinger godkjennes?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jak zatwierdzać działania agenta?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Como as ações do agente devem ser aprovadas?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Как подтверждать действия агента?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "จะอนุมัติการทำงานของเอเจนต์อย่างไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajanın eylemleri nasıl onaylansın?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Як схвалювати дії агента?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Duyệt các hành động của tác nhân như thế nào?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "如何批准代理的操作？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "要如何核准代理的動作？"
          }
        }
      }
    },
