    "trust.allowsFolder": {
      "comment": "Agent pane: the folder trust question above the composer (scope: repo or folder; what trusting allows; Not now)",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكن لـ {agent} تشغيل الأوامر وتعديل الملفات هنا، وتُحمَّل خطافات المجلد وخوادم MCP والإعدادات. ليس الآن: لن يعمل {agent} هنا حتى تثق به."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} može ovdje pokretati naredbe i uređivati fajlove, a učitavaju se hookovi, MCP serveri i postavke fascikle. Ne sada: {agent} se neće pokretati ovdje dok mu ne vjerujete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} kan køre kommandoer og redigere filer her, og mappens hooks, MCP-servere og indstillinger indlæses. Ikke nu: {agent} kører ikke her, før du stoler på det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} kann hier Befehle ausführen und Dateien bearbeiten, und die Hooks, MCP-Server und Einstellungen des Ordners werden geladen. Nicht jetzt: {agent} läuft hier erst, wenn du vertraust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{agent} can run commands and edit files here, and the folder's hooks, MCP servers and settings load. Not now: {agent} won't run here until you trust it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} puede ejecutar comandos y editar archivos aquí, y se cargan los hooks, servidores MCP y ajustes de la carpeta. Ahora no: {agent} no se ejecutará aquí hasta que confíes en él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} peut exécuter des commandes et modifier des fichiers ici, et les hooks, serveurs MCP et réglages du dossier sont chargés. Pas maintenant : {agent} ne s'exécutera pas ici tant que vous ne lui ferez pas confiance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} può eseguire comandi e modificare file qui, e vengono caricati hook, server MCP e impostazioni della cartella. Non ora: {agent} non verrà eseguito qui finché non ti fidi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{agent} はここでコマンドを実行し、ファイルを編集できます。フォルダのフック、MCP サーバー、設定も読み込まれます。後で: 信頼するまで {agent} はここで実行されません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} អាចដំណើរការពាក្យបញ្ជា និងកែឯកសារនៅទីនេះ ហើយ hooks, ម៉ាស៊ីនមេ MCP និងការកំណត់របស់ថតនឹងត្រូវផ្ទុក។ មិនមែនឥឡូវ៖ {agent} នឹងមិនដំណើរការនៅទីនេះទេ រហូតដល់អ្នកទុកចិត្ត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent}이(가) 여기서 명령을 실행하고 파일을 편집할 수 있으며, 폴더의 훅, MCP 서버, 설정이 로드됩니다. 나중에: 신뢰하기 전까지 {agent}은(는) 여기서 실행되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
