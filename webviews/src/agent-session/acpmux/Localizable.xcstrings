    "git.commit.identityMissing": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يحتوي git على اسم مستخدم أو بريد إلكتروني. عيّن user.name وuser.email، ثم أعد الإيداع."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git nema korisničko ime ili e-mail. Postavite user.name i user.email, pa ponovo commitajte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git har intet brugernavn eller e-mail. Angiv user.name og user.email, og commit derefter igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git hat keinen Benutzernamen oder keine E-Mail-Adresse. Lege user.name und user.email fest und committe dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "git has no user name or email. Set user.name and user.email, then commit again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git no tiene nombre de usuario ni correo electrónico. Configura user.name y user.email y vuelve a confirmar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
