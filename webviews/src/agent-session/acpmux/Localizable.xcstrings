    "permission.claude.alwaysAllowRule": {
      "comment": "Agent pane: a Claude Code permission option's rule, under 'Yes, and don't ask again'; {rules} is the tool rules Claude would remember",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "السماح بـ {rules} لهذه الجلسة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dozvoli {rules} za ovu sesiju"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tillad {rules} i denne session"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{rules} für diese Sitzung erlauben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow {rules} for this session"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permitir {rules} en esta sesión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autoriser {rules} pour cette session"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consenti {rules} per questa sessione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このセッションで {rules} を許可"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អនុញ្ញាត {rules} សម្រាប់វគ្គនេះ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 세션에서 {rules} 허용"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tillat {rules} i denne økten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zezwól na {rules} w tej sesji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permitir {rules} nesta sessão"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Разрешить {rules} в этом сеансе"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อนุญาต {rules} สำหรับเซสชั่นนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu oturum için {rules} izni ver"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дозволити {rules} у цьому сеансі"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cho phép {rules} trong phiên này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在本次会话中允许 {rules}"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在本次工作階段允許 {rules}"
          }
        }
      }
    },
    "permission.claude.dontAskAgain": {
      "comment": "Agent pane: Claude Code's permission button that allows the tool and remembers the rule (Claude Code's own wording)",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "نعم، ولا تسأل مرة أخرى في هذه الجلسة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Da, i ne pitaj ponovo u ovoj sesiji"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ja, og spørg ikke igen i denne session"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ja, und in dieser Sitzung nicht mehr fragen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, and don't ask again this session"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sí, y no volver a preguntar en esta sesión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oui, et ne plus demander pendant cette session"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sì, e non chiedere più in questa sessione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "はい、このセッションでは今後確認しない"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បាទ/ចាស ហើយកុំសួរម្ដងទៀតក្នុងវគ្គនេះ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "예, 이 세션에서는 다시 묻지 않음"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ja, og ikke spør igjen i denne økten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tak, i nie pytaj ponownie w tej sesji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sim, e não perguntar de novo nesta sessão"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Да, и больше не спрашивать в этом сеансе"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ใช่ และไม่ต้องถามอีกในเซสชั่นนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Evet, bu oturumda bir daha sorma"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Так, і більше не питати в цьому сеансі"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Có, và không hỏi lại trong phiên này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "是，本次会话中不再询问"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "是，本次工作階段不再詢問"
          }
        }
      }
    },
    "permission.claude.tellDifferently": {
      "comment": "Agent pane: Claude Code's permission button that declines the tool so the user can redirect Claude (Claude Code's own wording; Claude is a product name)",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا، أخبر Claude بما يجب فعله بشكل مختلف"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ne, reci Claudeu šta da uradi drugačije"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nej, fortæl Claude, hvad der skal gøres anderledes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nein, Claude sagen, was anders zu tun ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No, tell Claude what to do differently"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No, decirle a Claude qué hacer de otra forma"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non, dire à Claude quoi faire autrement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No, di' a Claude cosa fare diversamente"
          }
        },
