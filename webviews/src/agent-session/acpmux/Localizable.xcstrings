    "steer.sendNowHelp": {
      "comment": "Agent pane: tooltip of Send now under a steer; the turn keeps running, only the current step stops",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف الخطوة الحالية ليقرأ الوكيل هذه الرسالة الآن. يستمر الدور."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaustavi trenutni korak da agent odmah pročita ovo. Potez se nastavlja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop det aktuelle trin, så agenten læser dette nu. Turen fortsætter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den aktuellen Schritt anhalten, damit der Agent das jetzt liest. Der Durchgang läuft weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop the current step so the agent reads this now. The turn goes on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detén el paso actual para que el agente lea esto ahora. El turno continúa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter l’étape en cours pour que l’agent lise ceci maintenant. Le tour continue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferma il passaggio corrente perché l’agente legga subito questo. Il turno continua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のステップを止めて、エージェントにすぐ読ませます。ターンは続きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ឈប់ជំហានបច្ចុប្បន្ន ដើម្បីឱ្យភ្នាក់ងារអានសារនេះឥឡូវ។ វេននៅបន្ត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 단계를 멈추고 에이전트가 지금 이 메시지를 읽게 합니다. 턴은 계속됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopp gjeldende trinn så agenten leser dette nå. Runden fortsetter."
          }
        },
