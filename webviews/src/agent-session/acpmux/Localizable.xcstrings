        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការព្យាយាមចំណុចត្រួតពិនិត្យម្តងទៀតត្រូវផ្អាក រហូតដល់សម័យដែលបានជ្រើសរើសភ្ជាប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "선택한 세션이 연결될 때까지 체크포인트 재시도가 일시 중지되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nytt forsøk på sjekkpunkt er satt på pause til den valgte økten er tilkoblet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ponawianie punktu kontrolnego wstrzymane do czasu połączenia wybranej sesji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nova tentativa de checkpoint pausada até a sessão selecionada se conectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Повтор создания контрольной точки приостановлен до подключения выбранного сеанса."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หยุดลองบันทึกเช็กพอยต์ใหม่ชั่วคราวจนกว่าเซสชันที่เลือกจะเชื่อมต่อ"
