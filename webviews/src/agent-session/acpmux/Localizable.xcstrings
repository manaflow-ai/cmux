            "value": "Start en ny samtale med denne transkripsjonen som første ledetekst"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpocznij nowy czat z tym zapisem jako pierwszym poleceniem"
          }
