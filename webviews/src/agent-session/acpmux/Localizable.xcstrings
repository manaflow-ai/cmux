    "changes.skipped.one": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تخطّى تبويب التغييرات ملفًا واحدًا غير متتبَّع للحفاظ على الاستجابة. إذا كانت هذه الملفات مُنشأة تلقائيًا، فنظّفها ثم حدّث"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kartica Promjene je preskočila 1 nepraćenu datoteku radi brzine odziva. Ako su datoteke generirane, očistite ih i osvježite"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fanen Ændringer sprang 1 usporet fil over for at forblive responsiv. Hvis filerne er genereret, så ryd op og opdater"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Tab „Änderungen“ hat 1 nicht verfolgte Datei übersprungen, um reaktionsfähig zu bleiben. Wenn diese Dateien generiert wurden, bereinige sie und aktualisiere die Ansicht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Changes tab skipped 1 untracked file to stay responsive. If these files are generated, clean them up and refresh"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La pestaña Cambios omitió 1 archivo sin seguimiento para mantenerse ágil. Si estos archivos son generados, límpialos y actualiza"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’onglet Modifications a ignoré 1 fichier non suivi pour rester réactif. Si ces fichiers sont générés, nettoyez-les et actualisez"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La scheda Modifiche ha saltato 1 file non tracciato per restare reattiva. Se questi file sono generati, ripuliscili e aggiorna"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "応答性を保つため、「変更」タブは未追跡ファイル1件をスキップしました。これらのファイルが生成物の場合は、削除してから更新してください"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទាំងការផ្លាស់ប្តូរបានរំលងឯកសារដែលមិនបានតាមដាន 1 ដើម្បីរក្សាភាពឆ្លើយតបលឿន។ ប្រសិនបើឯកសារទាំងនេះត្រូវបានបង្កើតដោយស្វ័យប្រវត្តិ សូមសម្អាត រួចផ្ទុកឡើងវិញ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "응답성을 유지하기 위해 변경 사항 탭에서 추적되지 않는 파일 1개를 건너뛰었습니다. 생성된 파일이라면 정리한 후 새로 고치세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Endringer-fanen hoppet over 1 usporet fil for å holde seg responsiv. Hvis filene er generert, rydd opp og oppdater"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Karta Zmiany pominęła 1 nieśledzony plik, aby zachować płynność. Jeśli te pliki są generowane, usuń je i odśwież"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A aba Alterações ignorou 1 arquivo não rastreado para continuar responsiva. Se esses arquivos forem gerados, limpe-os e atualize"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вкладка «Изменения» пропустила 1 неотслеживаемый файл, чтобы не тормозить. Если эти файлы сгенерированы, удалите их и обновите"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แท็บการเปลี่ยนแปลงข้ามไฟล์ที่ไม่ได้ติดตาม 1 ไฟล์เพื่อให้ตอบสนองได้ดี หากไฟล์เหล่านี้ถูกสร้างขึ้นโดยอัตโนมัติ ให้ล้างออกแล้วรีเฟรช"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Değişiklikler sekmesi yanıt vermeye devam etmek için 1 izlenmeyen dosyayı atladı. Bu dosyalar oluşturulmuşsa temizleyip yenileyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вкладка «Зміни» пропустила 1 невідстежуваний файл, щоб не гальмувати. Якщо ці файли згенеровані, видаліть їх і оновіть"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tab Thay đổi đã bỏ qua 1 tệp chưa theo dõi để giữ độ phản hồi. Nếu các tệp này do công cụ tạo ra, hãy dọn dẹp rồi làm mới"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "为保持响应速度，“更改”标签页跳过了 1 个未跟踪的文件。如果这些文件是生成的，请清理后刷新"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "為保持回應速度，「變更」分頁略過了 1 個未追蹤的檔案。如果這些檔案是產生的，請清理後重新整理"
          }
        }
      }
    },
