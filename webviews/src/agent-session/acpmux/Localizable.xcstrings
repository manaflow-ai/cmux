    "link.sessionMissingDetail": {
      "comment": "Agent pane: under \"This chat isn't available\"; {machine} is the machine the tab's chat ran on, {session} the start of its session id",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "كانت تعمل على {machine} (الجلسة {session})."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Radio je na {machine} (sesija {session})."
          }
        },
        "da": {
