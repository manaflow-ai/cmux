    "link.sessionMissing": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هذه الدردشة غير متاحة. حُذفت أو أنها على جهاز غير متصل."
