    "trust.notTrustedNoPrompts": {
      "comment": "Agent pane: the folder trust question above the composer (scope: repo or folder; what trusting allows; Not now)",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اخترت ليس الآن، لذا لا يشغّل الوكيل أي طلبات هنا. اضغط تراجع أو امنحه الثقة للبدء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odabrali ste Ne sada, pa agent ovdje ne pokreće upite. Pritisnite Poništi ili mu vjerujte da počnete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du valgte Ikke nu, så agenten kører ingen prompts her. Tryk på Fortryd, eller stol på det, for at starte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du hast Nicht jetzt gewählt, daher führt der Agent hier keine Prompts aus. Drücke Rückgängig oder vertraue, um zu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You chose Not now, so the agent runs no prompts here. Press Undo, or trust it, to start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elegiste Ahora no, así que el agente no ejecuta prompts aquí. Pulsa Deshacer o confía para empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous avez choisi Pas maintenant : l'agent n'exécute aucune requête ici. Appuyez sur Annuler ou faites-lui confiance pour commencer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hai scelto Non ora, quindi l'agente non esegue prompt qui. Premi Annulla o fidati per iniziare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「後で」を選んだため、エージェントはここでプロンプトを実行しません。開始するには、元に戻すか信頼してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អ្នកបានជ្រើស មិនមែនឥឡូវ ដូច្នេះភ្នាក់ងារមិនដំណើរការសំណើនៅទីនេះទេ។ ចុច មិនធ្វើវិញ ឬទុកចិត្ត ដើម្បីចាប់ផ្តើម។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "나중에를 선택했으므로 에이전트가 여기서 프롬프트를 실행하지 않습니다. 시작하려면 실행 취소를 누르거나 신뢰하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du valgte Ikke nå, så agenten kjører ingen prompter her. Trykk Angre, eller stol på den, for å starte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybrano Nie teraz, więc agent nie uruchamia tu poleceń. Naciśnij Cofnij lub zaufaj, aby zacząć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você escolheu Agora não, então o agente não executa prompts aqui. Pressione Desfazer ou confie para começar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вы выбрали «Не сейчас», поэтому агент не выполняет здесь запросы. Нажмите «Отменить» или доверьтесь, чтобы начать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คุณเลือก ไม่ใช่ตอนนี้ เอเจนต์จึงไม่เรียกใช้พรอมต์ที่นี่ กด เลิกทำ หรือเชื่อถือเพื่อเริ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Şimdi değil'i seçtiniz, bu yüzden ajan burada istem çalıştırmaz. Başlamak için Geri Al'a basın veya güvenin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ви вибрали «Не зараз», тому агент не виконує тут запити. Натисніть «Скасувати» або довіртеся, щоб почати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bạn đã chọn Để sau nên tác nhân không chạy lời nhắc nào ở đây. Nhấn Hoàn tác hoặc tin cậy để bắt đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你选择了“以后再说”，因此代理不会在此运行提示。按“撤销”或信任它即可开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你選擇了「稍後再說」，因此代理不會在此執行提示。按「復原」或信任它即可開始。"
          }
        }
      }
    },
