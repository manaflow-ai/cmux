            "state": "translated",
            "value": "/{command} ne fonctionne que dans le terminal de Claude Code, pas dans cmux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "/{command} funziona solo nel terminale di Claude Code, non in cmux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "/{command} は Claude Code のターミナルでのみ使えます。cmux では使えません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
