    "status.usageLimit.used":{"comment":"Agent pane: Session status card's Usage limits value for one window; {name} is the window's name, {percent} the share of it used.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"{name}: {percent}% used"}},"ar":{"stringUnit":{"state":"needs_review","value":"{name}: تم استخدام {percent}%"}},"bs":{"stringUnit":{"state":"needs_review","value":"{name}: iskorišteno {percent}%"}},"da":{"stringUnit":{"state":"needs_review","value":"{name}: {percent} % brugt"}},"de":{"stringUnit":{"state":"needs_review","value":"{name}: {percent} % genutzt"}},"es":{"stringUnit":{"state":"needs_review","value":"{name}: {percent} % usado"}},"fr":{"stringUnit":{"state":"needs_review","value":"{name} : {percent} % utilisé"}},"it":{"stringUnit":{"state":"needs_review","value":"{name}: {percent}% utilizzato"}},"ja":{"stringUnit":{"state":"translated","value":"{name}: {percent}% 使用"}},"km":{"stringUnit":{"state":"needs_review","value":"{name}: បានប្រើ {percent}%"}},"ko":{"stringUnit":{"state":"needs_review","value":"{name}: {percent}% 사용됨"}},"nb":{"stringUnit":{"state":"needs_review","value":"{name}: {percent} % brukt"}},"pl":{"stringUnit":{"state":"needs_review","value":"{name}: wykorzystano {percent}%"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"{name}: {percent}% usado"}},"ru":{"stringUnit":{"state":"needs_review","value":"{name}: использовано {percent}%"}},"th":{"stringUnit":{"state":"needs_review","value":"{name}: ใช้ไปแล้ว {percent}%"}},"tr":{"stringUnit":{"state":"needs_review","value":"{name}: %{percent} kullanıldı"}},"uk":{"stringUnit":{"state":"needs_review","value":"{name}: використано {percent}%"}},"vi":{"stringUnit":{"state":"needs_review","value":"{name}: đã dùng {percent}%"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"{name}：已用 {percent}%"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"{name}：已用 {percent}%"}}}},
    "status.usageLimit.usedResets":{"comment":"Agent pane: Session status card's Usage limits value for one window with its reset time; {name} is the window's name, {percent} the share of it used, {time} the local date and time (with time zone) it resets.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"{name}: {percent}% used, resets {time}"}},"ar":{"stringUnit":{"state":"needs_review","value":"{name}: تم استخدام {percent}%، يُعاد التعيين {time}"}},"bs":{"stringUnit":{"state":"needs_review","value":"{name}: iskorišteno {percent}%, resetuje se {time}"}},"da":{"stringUnit":{"state":"needs_review","value":"{name}: {percent} % brugt, nulstilles {time}"}},"de":{"stringUnit":{"state":"needs_review","value":"{name}: {percent} % genutzt, zurückgesetzt am {time}"}},"es":{"stringUnit":{"state":"needs_review","value":"{name}: {percent} % usado, se restablece el {time}"}},"fr":{"stringUnit":{"state":"needs_review","value":"{name} : {percent} % utilisé, réinitialisation le {time}"}},"it":{"stringUnit":{"state":"needs_review","value":"{name}: {percent}% utilizzato, si azzera il {time}"}},"ja":{"stringUnit":{"state":"translated","value":"{name}: {percent}% 使用、{time} にリセット"}},"km":{"stringUnit":{"state":"needs_review","value":"{name}: បានប្រើ {percent}%, កំណត់ឡើងវិញ {time}"}},"ko":{"stringUnit":{"state":"needs_review","value":"{name}: {percent}% 사용됨, {time}에 초기화"}},"nb":{"stringUnit":{"state":"needs_review","value":"{name}: {percent} % brukt, nullstilles {time}"}},"pl":{"stringUnit":{"state":"needs_review","value":"{name}: wykorzystano {percent}%, reset {time}"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"{name}: {percent}% usado, redefine em {time}"}},"ru":{"stringUnit":{"state":"needs_review","value":"{name}: использовано {percent}%, сброс {time}"}},"th":{"stringUnit":{"state":"needs_review","value":"{name}: ใช้ไปแล้ว {percent}% รีเซ็ต {time}"}},"tr":{"stringUnit":{"state":"needs_review","value":"{name}: %{percent} kullanıldı, {time} sıfırlanır"}},"uk":{"stringUnit":{"state":"needs_review","value":"{name}: використано {percent}%, скидання {time}"}},"vi":{"stringUnit":{"state":"needs_review","value":"{name}: đã dùng {percent}%, đặt lại lúc {time}"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"{name}：已用 {percent}%，{time} 重置"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"{name}：已用 {percent}%，{time} 重設"}}}},
