    "git.commit.stagedHint": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يودع التغييرات المُجهّزة فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Commituje samo pripremljene promjene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Committer kun de stagede ændringer."
          }
