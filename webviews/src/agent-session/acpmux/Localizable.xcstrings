    "chatMenu.deleteConfirmBody": {
      "comment": "Agent pane chat header: confirmation before permanently deleting a chat",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the chat's history and uploaded files."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سيؤدي هذا إلى إزالة سجل الدردشة والملفات المرفوعة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovim se uklanjaju historija chata i otpremljene datoteke."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dette fjerner chattens historik og uploadede filer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dadurch werden Chatverlauf und hochgeladene Dateien entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esto elimina el historial del chat y los archivos subidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cela supprime l’historique du chat et les fichiers importés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo rimuove la cronologia della chat e i file caricati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "チャットの履歴とアップロードしたファイルが削除されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "វានឹងលុបប្រវត្តិជជែក និងឯកសារដែលបានផ្ទុកឡើង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "채팅 기록과 업로드한 파일이 삭제됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dette fjerner chattens historikk og opplastede filer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spowoduje to usunięcie historii czatu i przesłanych plików."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isso remove o histórico do chat e os arquivos enviados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "История чата и загруженные файлы будут удалены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การดำเนินการนี้จะลบประวัติแชทและไฟล์ที่อัปโหลด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu işlem sohbet geçmişini ve yüklenen dosyaları kaldırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Це видалить історію чату та завантажені файли."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thao tác này sẽ xóa lịch sử trò chuyện và các tệp đã tải lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这会删除聊天记录和已上传的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這會刪除聊天記錄和已上傳的檔案。"
          }
