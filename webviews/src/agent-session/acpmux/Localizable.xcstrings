    "composer.originalFailed": {"comment":"Agent pane: the tooltip of the Retry badge on a staged image whose full-size original could not be uploaded to the session's machine; the preview still sends. {name} is the image, {reason} the upload's error","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The original of {name} was not uploaded: {reason}"}},"ar":{"stringUnit":{"state":"needs_review","value":"لم يتم رفع النسخة الأصلية من {name}: {reason}"}},"bs":{"stringUnit":{"state":"needs_review","value":"Original za {name} nije otpremljen: {reason}"}},"da":{"stringUnit":{"state":"needs_review","value":"Originalen af {name} blev ikke uploadet: {reason}"}},"de":{"stringUnit":{"state":"needs_review","value":"Das Original von {name} wurde nicht hochgeladen: {reason}"}},"es":{"stringUnit":{"state":"needs_review","value":"No se subió el original de {name}: {reason}"}},"fr":{"stringUnit":{"state":"needs_review","value":"L’original de {name} n’a pas été envoyé : {reason}"}},"it":{"stringUnit":{"state":"needs_review","value":"L’originale di {name} non è stato caricato: {reason}"}},"ja":{"stringUnit":{"state":"needs_review","value":"{name} の元の画像はアップロードされませんでした: {reason}"}},"km":{"stringUnit":{"state":"needs_review","value":"រូបភាពដើមនៃ {name} មិនត្រូវបានផ្ទុកឡើងទេ៖ {reason}"}},"ko":{"stringUnit":{"state":"needs_review","value":"{name}의 원본이 업로드되지 않았습니다: {reason}"}},"nb":{"stringUnit":{"state":"needs_review","value":"Originalen av {name} ble ikke lastet opp: {reason}"}},"pl":{"stringUnit":{"state":"needs_review","value":"Oryginał {name} nie został przesłany: {reason}"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O original de {name} não foi enviado: {reason}"}},"ru":{"stringUnit":{"state":"needs_review","value":"Оригинал {name} не загружен: {reason}"}},"th":{"stringUnit":{"state":"needs_review","value":"ไม่ได้อัปโหลดต้นฉบับของ {name}: {reason}"}},"tr":{"stringUnit":{"state":"needs_review","value":"{name} için orijinal yüklen