        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다른 권한 결정이 재시도를 기다리고 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En annen tillatelsesbeslutning venter på nytt forsøk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inna decyzja o uprawnieniu czeka na ponowienie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Outra decisão de permissão aguarda nova tentativa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Другое решение о разрешении ожидает повтора."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การตัดสินใจเรื่องสิทธิ์อีกรายการหนึ่งกำลังรอลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Başka bir izin kararı yeniden deneme bekliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Інше рішення щодо дозволу очікує повторної спроби."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Một quyết định quyền khác đang chờ thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "另一个权限决定正在等待重试。"
          }
        },
        "zh-Hant": {
