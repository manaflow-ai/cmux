    "edited.undoSkip.unknown.one": {
      "comment": "Agent pane: the edited-files card's Undo confirmation, for a file the turn changed that Undo leaves as it is (the pane never had its earlier contents; the card may list it with or without +/- counts). \"Undo\" is the card's Undo button. {file} is the file's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يستطيع «تراجع» استعادة {file}."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Poništi“ ne može vratiti {file}."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fortryd kan ikke gendanne {file}."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Rückgängig“ kann {file} nicht wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo can't restore {file}."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deshacer no puede restaurar {file}."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Annuler ne peut pas restaurer {file}."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Annulla non può ripristinare {file}."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "元に戻すでは {file} を復元できません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនធ្វើវិញ មិនអាចស្ដារ {file} បានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "실행 취소로 {file}을(를) 복원할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Angre kan ikke gjenopprette {file}."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cofnij nie przywróci pliku {file}."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desfazer não pode restaurar {file}."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Отменить» не восстановит файл {file}."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เลิกทำไม่สามารถกู้คืน {file} ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geri al, {file} dosyasını geri yükleyemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
