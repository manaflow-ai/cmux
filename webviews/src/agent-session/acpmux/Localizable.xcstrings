    "notice.forkNothingYet": {
      "comment": "Agent pane: Fork Conversation on a chat with no finished turn yet",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد ما يمكن تفريعه بعد. أرسل رسالة أولاً."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nema ničega za račvanje. Prvo pošaljite poruku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er intet at forgrene endnu. Send først en besked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts zum Abzweigen. Sende zuerst eine Nachricht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to fork yet. Send a message first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay nada que bifurcar. Envía un mensaje primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à dupliquer pour l’instant. Envoyez d’abord un message."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c’è ancora nulla da biforcare. Invia prima un messaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだフォークする内容がありません。先にメッセージを送信してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនទាន់មានអ្វីដើម្បីបំបែកនៅឡើយទេ។ សូមផ្ញើសារជាមុនសិន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 포크할 내용이 없습니다. 먼저 메시지를 보내세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ingenting å forgreine ennå. Send en melding først."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze czego rozgałęziać. Najpierw wyślij wiadomość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há nada para bifurcar. Envie uma mensagem primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нечего ответвлять. Сначала отправьте сообщение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีอะไรให้แยกสาขา ส่งข้อความก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz çatallanacak bir şey yok. Önce bir mesaj gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки що нічого відгалужувати. Спершу надішліть повідомлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có gì để phân nhánh. Hãy gửi một tin nhắn trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有可分叉的内容。请先发送一条消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有可分叉的內容。請先傳送一則訊息。"
          }
        }
      }
    },
