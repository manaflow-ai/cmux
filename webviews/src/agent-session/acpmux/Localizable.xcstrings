    },
    "permission.coverageDetail": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تغطي الحماية الإجراءات التي يطلبها الوكيل عبر ACP فقط. عزل المضيف غير متحقق منه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokriveni su samo zahtjevi koje agent šalje putem ACP-a. Izolacija hosta nije provjerena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kun handlinger, som agenten anmoder om via ACP, er dækket. Værtsisolering er ikke verificeret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nur Aktionen, die der Agent über ACP anfragt, sind abgedeckt. Die Host-Isolation ist nicht verifiziert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only actions the agent requests through ACP are covered. Host isolation is unverified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo se cubren las acciones que el agente solicita mediante ACP. El aislamiento del host no está verificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seules les actions que l'agent demande via ACP sont couvertes. L'isolation de l'hôte n'est pas vérifiée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sono coperte solo le azioni richieste dall'agente tramite ACP. L'isolamento dell'host non è verificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象はエージェントが ACP 経由で要求する操作のみです。ホストの隔離は未検証です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្របដណ្តប់តែសកម្មភាពដែលភ្នាក់ងារស្នើតាម ACP ប៉ុណ្ណោះ។ ភាពឯកោនៃម៉ាស៊ីនមេមិនទាន់បានផ្ទៀងផ្ទាត់ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트가 ACP를 통해 요청하는 작업만 적용됩니다. 호스트 격리는 확인되지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bare handlinger agenten ber om via ACP dekkes. Vertsisolering er ikke verifisert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uwzględniane są tylko działania, o które agent prosi przez ACP. Izolacja hosta nie jest zweryfikowana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Somente ações que o agente solicita por ACP são cobertas. O isolamento do host não foi verificado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Учитываются только действия, которые агент запрашивает через ACP. Изоляция хоста не проверена."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ครอบคลุมเฉพาะการทำงานที่เอเจนต์ร้องขอผ่าน ACP ยังไม่ได้ตรวจสอบการแยกโฮสต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yalnızca ajanın ACP üzerinden istediği eylemler kapsanır. Ana makine yalıtımı doğrulanmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Охоплюються лише дії, які агент запитує через ACP. Ізоляцію хоста не перевірено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chỉ bao gồm các hành động mà tác nhân yêu cầu qua ACP. Chưa xác minh cách ly máy chủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
