          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот чат недоступен. Он удалён или находится на компьютере, который не подключён."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
