    "turn.failure.tailscale": {
      "comment": "Agent pane: a failed turn's error card (the cause in one line); {harness} is the agent's name",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّر على {harness} الوصول إلى جهازه عبر Tailscale. تحقّق من اتصال Tailscale ثم أعد المحاولة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} nije mogao doći do svog računara preko Tailscalea. Provjerite je li Tailscale povezan, pa pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} kunne ikke nå sin maskine via Tailscale. Tjek, at Tailscale er forbundet, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} hat seinen Rechner über Tailscale nicht erreicht. Prüfe, ob Tailscale verbunden ist, und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{harness} couldn’t reach its machine over Tailscale. Check that Tailscale is connected, then retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} no pudo llegar a su máquina por Tailscale. Comprueba que Tailscale esté conectado y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} n’a pas pu joindre sa machine via Tailscale. Vérifiez que Tailscale est connecté, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} non è riuscito a raggiungere la sua macchina tramite Tailscale. Controlla che Tailscale sia connesso, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} が Tailscale 経由でマシンに接続できませんでした。Tailscale が接続されているか確認してから再試行してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} មិនអាចភ្ជាប់ទៅម៉ាស៊ីនរបស់វាតាម Tailscale បានទេ។ សូមពិនិត្យថា Tailscale បានភ្ជាប់ រួចព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness}이(가) Tailscale로 컴퓨터에 연결하지 못했습니다. Tailscale이 연결되어 있는지 확인한 뒤 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} nådde ikke maskinen sin via Tailscale. Sjekk at Tailscale er tilkoblet, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} nie mógł połączyć się ze swoim komputerem przez Tailscale. Sprawdź, czy Tailscale jest połączony, i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} não conseguiu acessar a máquina pelo Tailscale. Verifique se o Tailscale está conectado e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} не смог связаться со своей машиной через Tailscale. Проверьте подключение Tailscale и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} เชื่อมต่อเครื่องผ่าน Tailscale ไม่ได้ ตรวจสอบว่า Tailscale เชื่อมต่ออยู่ แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness}, Tailscale üzerinden makinesine ulaşamadı. Tailscale’in bağlı olduğunu kontrol edin, sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} не зміг зв’язатися зі своєю машиною через Tailscale. Перевірте підключення Tailscale й повторіть спробу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} không kết nối được tới máy qua Tailscale. Hãy kiểm tra Tailscale đã kết nối rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} 无法通过 Tailscale 连接到它的机器。请确认 Tailscale 已连接后重试。"
          }
