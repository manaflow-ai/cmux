    "prCard.checksFailingOnBase": {
      "comment": "Agent pane: a pull request's hover card, its checks when some failed and {onBase} of those failures also fail at the base branch's tip",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نجح {passed} من {total} من الفحوصات، وفشل {failed}، و{onBase} منها فاشلة في الفرع الأساسي أيضًا"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "prošlo {passed} od {total} provjera, {failed} ne prolazi, {onBase} ne prolazi ni na osnovnoj grani"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "{passed} af {total} tjek bestået, {failed} fejler, {onBase} fejler også på basisgrenen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{passed} von {total} Checks bestanden, {failed} fehlgeschlagen, {onBase} schlagen auch auf dem Basis-Branch fehl"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{passed} of {total} checks passed, {failed} failing, {onBase} also red on base"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{passed} de {total} comprobaciones superadas, {failed} con errores, {onBase} también fallan en la rama base"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{passed} vérifications réussies sur {total}, {failed} en échec, dont {onBase} en échec aussi sur la branche de base"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "{passed} controlli superati su {total}, {failed} non riusciti, {onBase} non riusciti anche sul branch di base"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{total} 件中 {passed} 件のチェックに合格、{failed} 件が失敗、うち {onBase} 件はベースでも失敗"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការពិនិត្យ {passed} ក្នុងចំណោម {total} បានឆ្លងកាត់, {failed} បរាជ័យ, {onBase} បរាជ័យនៅសាខាមូលដ្ឋានផងដែរ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검사 {total}개 중 {passed}개 통과, {failed}개 실패, 그중 {onBase}개는 베이스에서도 실패"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "{passed} av {total} sjekker bestått, {failed} feiler, {onBase} feiler også på basisgrenen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaliczono {passed} z {total} testów, {failed} nie przechodzi, {onBase} nie przechodzi też na gałęzi bazowej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "{passed} de {total} verificações aprovadas, {failed} com falha, {onBase} também falham na branch base"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пройдено проверок: {passed} из {total}, с ошибкой: {failed}, из них {onBase} падают и в базовой ветке"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผ่านการตรวจสอบ {passed} จาก {total} รายการ ล้มเหลว {failed} รายการ โดย {onBase} รายการล้มเหลวบนเบรนช์ฐานด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "{total} denetimden {passed} tanesi geçti, {failed} tanesi başarısız, {onBase} tanesi temel dalda da başarısız"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пройдено перевірок: {passed} з {total}, з помилкою: {failed}, з них {onBase} падають і в базовій гілці"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã đạt {passed}/{total} lượt kiểm tra, {failed} lượt lỗi, {onBase} lượt cũng lỗi trên nhánh gốc"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{total} 项检查中通过 {passed} 项，{failed} 项失败，其中 {onBase} 项在基础分支上同样失败"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "{total} 項檢查中通過 {passed} 項，{failed} 項失敗，其中 {onBase} 項在基礎分支上同樣失敗"
          }
        }
      }
    },
