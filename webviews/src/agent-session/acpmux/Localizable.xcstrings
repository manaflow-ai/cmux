    "composer.bringBackLocalDetail": {
      "comment": "Agent pane: the line under Bring Back Local in a started Cloud chat's environment picker: what it does",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يدمج تغييرات الجهاز في المجلد على جهاز Mac هذا ويواصل المحادثة هنا"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spaja promjene s mašine u folder na ovom Macu i nastavlja chat ovdje"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fletter maskinens ændringer ind i mappen på denne Mac og fortsætter chatten her"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Führt die Änderungen der Maschine in den Ordner auf diesem Mac zusammen und setzt den Chat hier fort"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merges the machine's changes into the folder on this Mac and continues the chat here"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Combina los cambios de la máquina en la carpeta de este Mac y continúa el chat aquí"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fusionne les modifications de la machine dans le dossier sur ce Mac et poursuit la discussion ici"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unisce le modifiche della macchina nella cartella su questo Mac e continua la chat qui"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "マシンの変更をこの Mac のフォルダに統合し、ここでチャットを続けます"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បញ្ចូលការផ្លាស់ប្ដូររបស់ម៉ាស៊ីនទៅក្នុងថតនៅលើ Mac នេះ ហើយបន្តការជជែកនៅទីនេះ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "머신의 변경 사항을 이 Mac의 폴더에 병합하고 여기에서 채팅을 이어갑니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slår sammen maskinens endringer med mappen på denne Macen og fortsetter chatten her"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scala zmiany z maszyny z folderem na tym Macu i kontynuuje tu czat"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mescla as alterações da máquina na pasta deste Mac e continua o chat aqui"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Объединяет изменения с машины с папкой на этом Mac и продолжает чат здесь"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "รวมการเปลี่ยนแปลงจากเครื่องเข้ากับโฟลเดอร์บน Mac เครื่องนี้ และทำแชตต่อที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Makinedeki değişiklikleri bu Mac'teki klasörle birleştirir ve sohbete burada devam eder"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Об'єднує зміни з машини з папкою на цьому Mac і продовжує чат тут"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hợp nhất các thay đổi từ máy vào thư mục trên máy Mac này và tiếp tục cuộc trò chuyện tại đây"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将机器上的更改合并到此 Mac 上的文件夹,并在这里继续聊天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "將機器上的變更合併到此 Mac 上的資料夾,並在這裡繼續聊天"
          }
        }
      }
    },
