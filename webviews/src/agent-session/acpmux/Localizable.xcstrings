        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten czat pracuje w {folder}. Zaufanie repozytorium pozwala agentowi {agent} uruchamiać polecenia i edytować pliki w nim i we wszystkich jego worktree oraz wczytuje jego hooki, serwery MCP i ustawienia. Nie teraz: {agent} nie uruchomi się tu, dopóki mu nie zaufasz."
          }
