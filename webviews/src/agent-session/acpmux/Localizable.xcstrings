    "transport.intentInvalid": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "حدث خطأ، فلم يتم ذلك. حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nešto je pošlo po zlu, pa to nije uspjelo. Pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noget gik galt, så det blev ikke gennemført. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Etwas ist schiefgelaufen, daher hat das nicht geklappt. Versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong, so that didn’t go through. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Algo salió mal y no se completó. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un problème est survenu, l’action n’a pas abouti. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Qualcosa è andato storto e l’azione non è riuscita. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "問題が発生したため、完了できませんでした。もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មានបញ្ហាកើតឡើង ដូច្នេះវាមិនបានសម្រេចទេ។ សូមព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "문제가 발생해 완료되지 않았습니다. 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noe gikk galt, så det ble ikke gjennomført. Prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Coś poszło nie tak, więc to się nie udało. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Algo deu errado e isso não foi concluído. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Что-то пошло не так, и действие не выполнено. Попробуйте ещё раз."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
