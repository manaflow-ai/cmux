          "stringUnit": {
            "state": "needs_review",
            "value": "Non inviato. Premi Riprova per inviarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信されていません。再試行を押して送信してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
