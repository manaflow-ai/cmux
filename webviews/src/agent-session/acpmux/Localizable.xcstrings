          "stringUnit": {
            "state": "needs_review",
            "value": "{agent}은(는) 다음 프롬프트와 함께 시작됩니다. 이 응답은 계속됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} starter med neste prompt. Dette svaret fortsetter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} uruchomi się z Twoim następnym promptem. Ta odpowiedź trwa nadal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} inicia com seu próximo prompt. Esta resposta continua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} запустится с вашим следующим запросом. Этот ответ продолжается."
          }
        },
        "th": {
          "stringUnit": {
