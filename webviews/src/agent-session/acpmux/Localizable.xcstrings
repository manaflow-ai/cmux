    "retry.ask": {"comment":"Agent pane: the message Ask parent to retry sends the chat's agent for a failed subagent (subagents/retryState.ts); {name} is the subagent's name. Sent to the agent as a prompt","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The subagent \"{name}\" failed on a transient error. Run it again."}},"ar":{"stringUnit":{"state":"needs_review","value":"فشل الوكيل الفرعي \"{name}\" بسبب خطأ مؤقت. شغّله مرة أخرى."}},"bs":{"stringUnit":{"state":"needs_review","value":"Podagent \"{name}\" nije uspio zbog privremene greške. Pokreni ga ponovo."}},"da":{"stringUnit":{"state":"needs_review","value":"Underagenten \"{name}\" fejlede på en midlertidig fejl. Kør den igen."}},"de":{"stringUnit":{"state":"needs_review","value":"Der Subagent \"{name}\" ist an einem vorübergehenden Fehler gescheitert. Führe ihn erneut aus."}},"es":{"stringUnit":{"state":"needs_review","value":"El subagente \"{name}\" falló por un error transitorio. Ejecútalo de nuevo."}},"fr":{"stringUnit":{"state":"needs_review","value":"Le sous-agent \"{name}\" a échoué sur une erreur passagère. Relance-le."}},"it":{"stringUnit":{"state":"needs_review","value":"Il subagente \"{name}\" non è riuscito per un errore temporaneo. Eseguilo di nuovo."}},"ja":{"stringUnit":{"state":"needs_review","value":"サブエージェント「{name}」が一時的なエラーで失敗しました。もう一度実行してください。"}},"km":{"stringUnit":{"state":"needs_review","value":"ភ្នាក់ងាររង \"{name}\" បានបរាជ័យដោយកំហុសបណ្ដោះអាសន្ន។ ដំណើរការវាម្តងទៀត។"}},"ko":{"stringUnit":{"state":"needs_review","value":"하위 에이전트 \"{name}\"이(가) 일시적인 오류로 실패했습니다. 다시 실행하세요."}},"nb":{"stringUnit":{"state":"needs_review","value":"Underagenten \"{name}\" feilet på en midlertidig feil. Kjør den på nytt."}},"pl":{"stringUnit":{"state":"needs_review","value":"Podagent \"{name}\" zawiódł z powodu przejściowego błędu. Uruchom go ponownie."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O subagente \"{name}\" falhou por um erro temporário. Execute-o novamente."}},"ru":{"stringUnit":{"state":"needs_review","value":"Субагент \"{name}\" завершился с временной ошибкой. Запусти его снова."}},"th":{"stringUnit":{"state":"needs_review","value":"เอเจนต์ย่อย \"{name}\" ล้มเหลวจากข้อผิดพลาดชั่วคราว ให้รันอีกครั้ง"}},"tr":{"stringUnit":{"state":"needs_review","value":"\"{name}\" alt ajanı geçici bir hata nedeniyle başarısız oldu. Yeniden çalıştır."}},"uk":{"stringUnit":{"state":"needs_review","value":"Субагент \"{name}\" завершився з тимчасовою помилкою. Запусти його знову."}},"vi":{"stringUnit":{"state":"needs_review","value":"Tác tử con \"{name}\" thất bại do lỗi tạm thời. Hãy chạy lại."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"子代理“{name}”因临时错误失败。请重新运行它。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"子代理程式「{name}」因暫時性錯誤失敗。請重新執行。"}}}},
    "retry.askTask": {"comment":"Agent pane: the message Ask parent to retry sends the chat's agent for a failed subagent (subagents/retryState.ts); {name} is the subagent's name, {task} its description. Sent to the agent as a prompt","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The subagent \"{name}\" ({task}) failed on a transient error. Run it again."}},"ar":{"stringUnit":{"state":"needs_review","value":"فشل الوكيل الفرعي \"{name}\" ({task}) بسبب خطأ مؤقت. شغّله مرة أخرى."}},"bs":{"stringUnit":{"state":"needs_review","value":"Podagent \"{name}\" ({task}) nije uspio zbog privremene greške. Pokreni ga ponovo."}},"da":{"stringUnit":{"state":"needs_review","value":"Underagenten \"{name}\" ({task}) fejlede på en midlertidig fejl. Kør den igen."}},"de":{"stringUnit":{"state":"needs_review","value":"Der Subagent \"{name}\" ({task}) ist an einem vorübergehenden Fehler gescheitert. Führe ihn erneut aus."}},"es":{"stringUnit":{"state":"needs_review","value":"El subagente \"{name}\" ({task}) falló por un error transitorio. Ejecútalo de nuevo."}},"fr":{"stringUnit":{"state":"needs_review","value":"Le sous-agent \"{name}\" ({task}) a échoué sur une erreur passagère. Relance-le."}},"it":{"stringUnit":{"state":"needs_review","value":"Il subagente \"{name}\" ({task}) non è riuscito per un errore temporaneo. Eseguilo di nuovo."}},"ja":{"stringUnit":{"state":"needs_review","value":"サブエージェント「{name}」（{task}）が一時的なエラーで失敗しました。もう一度実行してください。"}},"km":{"stringUnit":{"state":"needs_review","value":"ភ្នាក់ងាររង \"{name}\" ({task}) បានបរាជ័យដោយកំហុសបណ្ដោះអាសន្ន។ ដំណើរការវាម្តងទៀត។"}},"ko":{"stringUnit":{"state":"needs_review","value":"하위 에이전트 \"{name}\" ({task})이(가) 일시적인 오류로 실패했습니다. 다시 실행하세요."}},"nb":{"stringUnit":{"state":"needs_review","value":"Underagenten \"{name}\" ({task}) feilet på en midlertidig feil. Kjør den på nytt."}},"pl":{"stringUnit":{"state":"needs_review","value":"Podagent \"{name}\" ({task}) zawiódł z powodu przejściowego błędu. Uruchom go ponownie."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O subagente \"{name}\" ({task}) falhou por um erro temporário. Execute-o novamente."}},"ru":{"stringUnit":{"state":"needs_review","value":"Субагент \"{name}\" ({task}) завершился с временной ошибкой. Запусти его снова."}},"th":{"stringUnit":{"state":"needs_review","value":"เอเจนต์ย่อย \"{name}\" ({task}) ล้มเหลวจากข้อผิดพลาดชั่วคราว ให้รันอีกครั้ง"}},"tr":{"stringUnit":{"state":"needs_review","value":"\"{name}\" ({task}) alt ajanı geçici bir hata nedeniyle başarısız oldu. Yeniden çalıştır."}},"uk":{"stringUnit":{"state":"needs_review","value":"Субагент \"{name}\" ({task}) завершився з тимчасовою помилкою. Запусти його знову."}},"vi":{"stringUnit":{"state":"needs_review","value":"Tác tử con \"{name}\" ({task}) thất bại do lỗi tạm thời. Hãy chạy lại."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"子代理“{name}”（{task}）因临时错误失败。请重新运行它。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"子代理程式「{name}」（{task}）因暫時性錯誤失敗。請重新執行。"}}}},
    "retry.nothingFailed": {"comment":"Agent pane: short note after a failed subagent's line when acpmux found nothing to retry (subagents/SubagentDoneLine.tsx)","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Nothing to retry"}},"ar":{"stringUnit":{"state":"needs_review","value":"لا يوجد ما يُعاد"}},"bs":{"stringUnit":{"state":"needs_review","value":"Nema šta ponoviti"}},"da":{"stringUnit":{"state":"needs_review","value":"Intet at prøve igen"}},"de":{"stringUnit":{"state":"needs_review","value":"Nichts zu wiederholen"}},"es":{"stringUnit":{"state":"needs_review","value":"Nada que reintentar"}},"fr":{"stringUnit":{"state":"needs_review","value":"Rien à réessayer"}},"it":{"stringUnit":{"state":"needs_review","value":"Niente da riprovare"}},"ja":{"stringUnit":{"state":"needs_review","value":"再試行するものはありません"}},"km":{"stringUnit":{"state":"needs_review","value":"គ្មានអ្វីត្រូវព្យាយាមម្តងទៀតទេ"}},"ko":{"stringUnit":{"state":"needs_review","value":"재시도할 항목 없음"}},"nb":{"stringUnit":{"state":"needs_review","value":"Ingenting å prøve igjen"}},"pl":{"stringUnit":{"state":"needs_review","value":"Nic do ponowienia"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Nada para tentar novamente"}},"ru":{"stringUnit":{"state":"needs_review","value":"Нечего повторять"}},"th":{"stringUnit":{"state":"needs_review","value":"ไม่มีอะไรให้ลองใหม่"}},"tr":{"stringUnit":{"state":"needs_review","value":"Yeniden denenecek bir şey yok"}},"uk":{"stringUnit":{"state":"needs_review","value":"Нічого повторювати"}},"vi":{"stringUnit":{"state":"needs_review","value":"Không có gì để thử lại"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"没有可重试的内容"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"沒有可重試的內容"}}}},
    "retry.busy": {"comment":"Agent pane: short note after a failed subagent's line when acpmux refused a retry because the session is busy (subagents/SubagentDoneLine.tsx)","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Busy, try again shortly"}},"ar":{"stringUnit":{"state":"needs_review","value":"مشغول، حاول بعد قليل"}},"bs":{"stringUnit":{"state":"needs_review","value":"Zauzeto, pokušaj uskoro"}},"da":{"stringUnit":{"state":"needs_review","value":"Optaget, prøv igen om lidt"}},"de":{"stringUnit":{"state":"needs_review","value":"Beschäftigt, gleich erneut versuchen"}},"es":{"stringUnit":{"state":"needs_review","value":"Ocupado, inténtalo en breve"}},"fr":{"stringUnit":{"state":"needs_review","value":"Occupé, réessaie bientôt"}},"it":{"stringUnit":{"state":"needs_review","value":"Occupato, riprova a breve"}},"ja":{"stringUnit":{"state":"needs_review","value":"処理中です。少ししてから再試行してください"}},"km":{"stringUnit":{"state":"needs_review","value":"រវល់ សូមព្យាយាមម្តងទៀតឆាប់ៗ"}},"ko":{"stringUnit":{"state":"needs_review","value":"사용 중, 잠시 후 다시 시도"}},"nb":{"stringUnit":{"state":"needs_review","value":"Opptatt, prøv igjen snart"}},"pl":{"stringUnit":{"state":"needs_review","value":"Zajęte, spróbuj za chwilę"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Ocupado, tente novamente em breve"}},"ru":{"stringUnit":{"state":"needs_review","value":"Занято, попробуйте чуть позже"}},"th":{"stringUnit":{"state":"needs_review","value":"ไม่ว่าง ลองใหม่อีกครู่"}},"tr":{"stringUnit":{"state":"needs_review","value":"Meşgul, birazdan yeniden dene"}},"uk":{"stringUnit":{"state":"needs_review","value":"Зайнято, спробуйте трохи згодом"}},"vi":{"stringUnit":{"state":"needs_review","value":"Đang bận, thử lại sau ít phút"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"忙碌中，请稍后重试"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"忙碌中，請稍後重試"}}}},
    "retry.failed": {"comment":"Agent pane: short note after a failed subagent's line when its Retry could not be sent (subagents/SubagentDoneLine.tsx)","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Couldn't retry"}},"ar":{"stringUnit":{"state":"needs_review","value":"تعذرت إعادة المحاولة"}},"bs":{"stringUnit":{"state":"needs_review","value":"Ponovni pokušaj nije uspio"}},"da":{"stringUnit":{"state":"needs_review","value":"Kunne ikke prøve igen"}},"de":{"stringUnit":{"state":"needs_review","value":"Wiederholen fehlgeschlagen"}},"es":{"stringUnit":{"state":"needs_review","value":"No se pudo reintentar"}},"fr":{"stringUnit":{"state":"needs_review","value":"Impossible de réessayer"}},"it":{"stringUnit":{"state":"needs_review","value":"Impossibile riprovare"}},"ja":{"stringUnit":{"state":"needs_review","value":"再試行できませんでした"}},"km":{"stringUnit":{"state":"needs_review","value":"មិនអាចព្យាយាមម្តងទៀតបានទេ"}},"ko":{"stringUnit":{"state":"needs_review","value":"재시도할 수 없음"}},"nb":{"stringUnit":{"state":"needs_review","value":"Kunne ikke prøve igjen"}},"pl":{"stringUnit":{"state":"needs_review","value":"Nie udało się ponowić"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Não foi possível tentar novamente"}},"ru":{"stringUnit":{"state":"needs_review","value":"Не удалось повторить"}},"th":{"stringUnit":{"state":"needs_review","value":"ลองใหม่ไม่สำเร็จ"}},"tr":{"stringUnit":{"state":"needs_review","value":"Yeniden denenemedi"}},"uk":{"stringUnit":{"state":"needs_review","value":"Не вдалося повторити"}},"vi":{"stringUnit":{"state":"needs_review","value":"Không thể thử lại"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"无法重试"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"無法重試"}}}},
