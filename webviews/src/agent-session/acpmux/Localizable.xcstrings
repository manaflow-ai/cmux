          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ikke tilgængelig herfra: denne agent har ingen tilstand, der spørger før hver ændring"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Von hier aus nicht verfügbar: Dieser Agent hat keinen Modus, der vor jeder Änderung fragt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not available from here: this agent has no mode that asks before each change"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No disponible desde aquí: este agente no tiene un modo que pregunte antes de cada cambio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
