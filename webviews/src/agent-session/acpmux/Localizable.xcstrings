            "state": "translated",
            "value": "Masquer À l’écoute"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi In riproduzione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生中を非表示"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "លាក់​អ្វី​ដែល​កំពុង​ចាក់"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 재생 중 가리기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjul Spilles nå"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryj Teraz odtwarzane"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar Tocando Agora"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыть «Сейчас играет»"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซ่อนกำลังเล่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi Çalıyor’u Gizle"
