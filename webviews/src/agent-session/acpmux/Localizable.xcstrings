    "turn.outside.title": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تغيّر أثناء الجولة، ولكن ليس بتعديلات الوكيل. للقراءة فقط."
