    "permission.error.wrongGroup": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أعاد رد الإذن مجموعة مختلفة. اقرأ قبل إعادة المحاولة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
