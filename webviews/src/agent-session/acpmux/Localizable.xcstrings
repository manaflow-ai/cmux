    "agentPair.paused.alternating": {
      "comment": "Agent pane: transcript note where acpmux paused messages between this chat's agent and another agent that kept messaging each other without progress; {peer} is the other chat's name, {n} how many exchanges",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "zero": {
