    "sandbox.vmPending": {"comment":"Receipt: the VM's destroy is still owed (the server finishes it)","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Destroy pending"}},"de":{"stringUnit":{"state":"translated","value":"Löschen ausstehend"}},"fr":{"stringUnit":{"state":"translated","value":"Destruction en attente"}},"ar":{"stringUnit":{"state":"translated","value":"الحذف قيد الانتظار"}},"es":{"stringUnit":{"state":"translated","value":"Destrucción pendiente"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"等待銷毀"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"等待销毁"}},"ko":{"stringUnit":{"state":"translated","value":"삭제 대기 중"}},"ja":{"stringUnit":{"state":"translated","value":"破棄待ち"}},"bs":{"stringUnit":{"state":"needs_review","value":"Brisanje na čekanju"}},"da":{"stringUnit":{"state":"needs_review","value":"Sletning afventer"}},"it":{"stringUnit":{"state":"needs_review","value":"Distruzione in attesa"}},"km":{"stringUnit":{"state":"needs_review","value":"កំពុងរង់ចាំលុប"}},"nb":{"stringUnit":{"state":"needs_review","value":"Sletting venter"}},"pl":{"stringUnit":{"state":"needs_review","value":"Usuwanie oczekuje"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Destruição pendente"}},"ru":{"stringUnit":{"state":"needs_review","value":"Удаление ожидается"}},"th":{"stringUnit":{"state":"needs_review","value":"รอลบ"}},"tr":{"stringUnit":{"state":"needs_review","value":"Silme bekliyor"}},"uk":{"stringUnit":{"state":"needs_review","value":"Очікує видалення"}},"vi":{"stringUnit":{"state":"needs_review","value":"Đang chờ xóa"}}}},
    "sandbox.elsewhereRunning": {"comment":"Chat: notice that a sandboxed run started from another new chat in this pane is still running","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"A sandboxed run you started is still running."}},"de":{"stringUnit":{"state":"translated","value":"Ein von dir gestarteter Sandbox-Lauf läuft noch."}},"fr":{"stringUnit":{"state":"translated","value":"Une exécution isolée que vous avez lancée est toujours en cours."}},"ar":{"stringUnit":{"state":"translated","value":"لا يزال تشغيل معزول بدأته قيد التنفيذ."}},"es":{"stringUnit":{"state":"translated","value":"Una ejecución aislada que iniciaste sigue en curso."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"你啟動的沙箱執行仍在進行。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你启动的沙箱运行仍在进行。"}},"ko":{"stringUnit":{"state":"translated","value":"시작한 샌드박스 실행이 아직 진행 중입니다."}},"ja":{"stringUnit":{"state":"translated","value":"開始したサンドボックス実行はまだ実行中です。"}},"bs":{"stringUnit":{"state":"needs_review","value":"Izolovano pokretanje koje ste pokrenuli još traje."}},"da":{"stringUnit":{"state":"needs_review","value":"En sandkassekørsel, du startede, kører stadig."}},"it":{"stringUnit":{"state":"needs_review","value":"Un'esecuzione in sandbox che hai avviato è ancora in corso."}},"km":{"stringUnit":{"state":"needs_review","value":"ដំណើរការក្នុងប្រអប់ខ្សាច់ដែលអ្នកបានចាប់ផ្ដើមនៅតែដំណើរការ។"}},"nb":{"stringUnit":{"state":"needs_review","value":"En sandkassekjøring du startet kjører fortsatt."}},"pl":{"stringUnit":{"state":"needs_review","value":"Uruchomienie w piaskownicy, które rozpocząłeś, nadal trwa."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Uma execução isolada que você iniciou ainda está em andamento."}},"ru":{"stringUnit":{"state":"needs_review","value":"Запуск в песочнице, который вы начали, ещё идёт."}},"th":{"stringUnit":{"state":"needs_review","value":"การเรียกใช้แบบแซนด์บ็อกซ์ที่คุณเริ่มยังทำงานอยู่"}},"tr":{"stringUnit":{"state":"needs_review","value":"Başlattığınız korumalı çalıştırma hâlâ sürüyor."}},"uk":{"stringUnit":{"state":"needs_review","value":"Запуск у пісочниці, який ви почали, ще триває."}},"vi":{"stringUnit":{"state":"needs_review","value":"Lần chạy hộp cát bạn bắt đầu vẫn đang chạy."}}}},
    "sandbox.elsewhereDone": {"comment":"Chat: notice that a sandboxed run started from another new chat in this pane has finished","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"A sandboxed run you started has finished."}},"de":{"stringUnit":{"state":"translated","value":"Ein von dir gestarteter Sandbox-Lauf ist fertig."}},"fr":{"stringUnit":{"state":"translated","value":"Une exécution isolée que vous avez lancée est terminée."}},"ar":{"stringUnit":{"state":"translated","value":"انتهى تشغيل معزول بدأته."}},"es":{"stringUnit":{"state":"translated","value":"Una ejecución aislada que iniciaste ha terminado."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"你啟動的沙箱執行已完成。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你启动的沙箱运行已完成。"}},"ko":{"stringUnit":{"state":"translated","value":"시작한 샌드박스 실행이 끝났습니다."}},"ja":{"stringUnit":{"state":"translated","value":"開始したサンドボックス実行が終わりました。"}},"bs":{"stringUnit":{"state":"needs_review","value":"Izolovano pokretanje koje ste pokrenuli je završeno."}},"da":{"stringUnit":{"state":"needs_review","value":"En sandkassekørsel, du startede, er færdig."}},"it":{"stringUnit":{"state":"needs_review","value":"Un'esecuzione in sandbox che hai avviato è terminata."}},"km":{"stringUnit":{"state":"needs_review","value":"ដំណើរការក្នុងប្រអប់ខ្សាច់ដែលអ្នកបានចាប់ផ្ដើមបានបញ្ចប់។"}},"nb":{"stringUnit":{"state":"needs_review","value":"En sandkassekjøring du startet er ferdig."}},"pl":{"stringUnit":{"state":"needs_review","value":"Uruchomienie w piaskownicy, które rozpocząłeś, zakończyło się."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Uma execução isolada que você iniciou terminou."}},"ru":{"stringUnit":{"state":"needs_review","value":"Запуск в песочнице, который вы начали, завершён."}},"th":{"stringUnit":{"state":"needs_review","value":"การเรียกใช้แบบแซนด์บ็อกซ์ที่คุณเริ่มเสร็จแล้ว"}},"tr":{"stringUnit":{"state":"needs_review","value":"Başlattığınız korumalı çalıştırma bitti."}},"uk":{"stringUnit":{"state":"needs_review","value":"Запуск у пісочниці, який ви почали, завершено."}},"vi":{"stringUnit":{"state":"needs_review","value":"Lần chạy hộp cát bạn bắt đầu đã xong."}}}},
    "sandbox.show": {"comment":"Chat: button that opens a sandboxed run's receipt","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Show"}},"de":{"stringUnit":{"state":"translated","value":"Anzeigen"}},"fr":{"stringUnit":{"state":"translated","value":"Afficher"}},"ar":{"stringUnit":{"state":"translated","value":"عرض"}},"es":{"stringUnit":{"state":"translated","value":"Mostrar"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"顯示"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"显示"}},"ko":{"stringUnit":{"state":"translated","value":"보기"}},"ja":{"stringUnit":{"state":"translated","value":"表示"}},"bs":{"stringUnit":{"state":"needs_review","value":"Prikaži"}},"da":{"stringUnit":{"state":"needs_review","value":"Vis"}},"it":{"stringUnit":{"state":"needs_review","value":"Mostra"}},"km":{"stringUnit":{"state":"needs_review","value":"បង្ហាញ"}},"nb":{"stringUnit":{"state":"needs_review","value":"Vis"}},"pl":{"stringUnit":{"state":"needs_review","value":"Pokaż"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Mostrar"}},"ru":{"stringUnit":{"state":"needs_review","value":"Показать"}},"th":{"stringUnit":{"state":"needs_review","value":"แสดง"}},"tr":{"stringUnit":{"state":"needs_review","value":"Göster"}},"uk":{"stringUnit":{"state":"needs_review","value":"Показати"}},"vi":{"stringUnit":{"state":"needs_review","value":"Hiện"}}}},
    "sandbox.back": {"comment":"Chat: button that leaves a sandboxed run's receipt and returns to the chat","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Back"}},"de":{"stringUnit":{"state":"translated","value":"Zurück"}},"fr":{"stringUnit":{"state":"translated","value":"Retour"}},"ar":{"stringUnit":{"state":"translated","value":"رجوع"}},"es":{"stringUnit":{"state":"translated","value":"Volver"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"返回"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"返回"}},"ko":{"stringUnit":{"state":"translated","value":"뒤로"}},"ja":{"stringUnit":{"state":"translated","value":"戻る"}},"bs":{"stringUnit":{"state":"needs_review","value":"Nazad"}},"da":{"stringUnit":{"state":"needs_review","value":"Tilbage"}},"it":{"stringUnit":{"state":"needs_review","value":"Indietro"}},"km":{"stringUnit":{"state":"needs_review","value":"ត្រឡប់"}},"nb":{"stringUnit":{"state":"needs_review","value":"Tilbake"}},"pl":{"stringUnit":{"state":"needs_review","value":"Wstecz"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Voltar"}},"ru":{"stringUnit":{"state":"needs_review","value":"Назад"}},"th":{"stringUnit":{"state":"needs_review","value":"กลับ"}},"tr":{"stringUnit":{"state":"needs_review","value":"Geri"}},"uk":{"stringUnit":{"state":"needs_review","value":"Назад"}},"vi":{"stringUnit":{"state":"needs_review","value":"Quay lại"}}}},
    "sandbox.usePersistent": {"comment":"Chat: button that switches a new chat's Run as back to Persistent","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Use Persistent"}},"de":{"stringUnit":{"state":"translated","value":"Dauerhaft verwenden"}},"fr":{"stringUnit":{"state":"translated","value":"Utiliser Persistant"}},"ar":{"stringUnit":{"state":"translated","value":"استخدام الدائم"}},"es":{"stringUnit":{"state":"translated","value":"Usar Persistente"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"改用「持續」"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"改用“持久”"}},"ko":{"stringUnit":{"state":"translated","value":"지속 사용"}},"ja":{"stringUnit":{"state":"translated","value":"永続を使う"}},"bs":{"stringUnit":{"state":"needs_review","value":"Koristi Trajno"}},"da":{"stringUnit":{"state":"needs_review","value":"Brug Vedvarende"}},"it":{"stringUnit":{"state":"needs_review","value":"Usa Persistente"}},"km":{"stringUnit":{"state":"needs_review","value":"ប្រើ ជាប់លាប់"}},"nb":{"stringUnit":{"state":"needs_review","value":"Bruk Vedvarende"}},"pl":{"stringUnit":{"state":"needs_review","value":"Użyj Trwały"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Usar Persistente"}},"ru":{"stringUnit":{"state":"needs_review","value":"Использовать Постоянный"}},"th":{"stringUnit":{"state":"needs_review","value":"ใช้แบบถาวร"}},"tr":{"stringUnit":{"state":"needs_review","value":"Kalıcı'yı kullan"}},"uk":{"stringUnit":{"state":"needs_review","value":"Використати Постійний"}},"vi":{"stringUnit":{"state":"needs_review","value":"Dùng Lâu dài"}}}},
    "sandbox.checkAgain": {"comment":"Chat: button that asks the app again for a sandboxed run whose answer was lost","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Check again"}},"de":{"stringUnit":{"state":"translated","value":"Erneut prüfen"}},"fr":{"stringUnit":{"state":"translated","value":"Vérifier à nouveau"}},"ar":{"stringUnit":{"state":"translated","value":"تحقّق مجددًا"}},"es":{"stringUnit":{"state":"translated","value":"Comprobar de nuevo"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"再次檢查"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"再次检查"}},"ko":{"stringUnit":{"state":"translated","value":"다시 확인"}},"ja":{"stringUnit":{"state":"translated","value":"もう一度確認"}},"bs":{"stringUnit":{"state":"needs_review","value":"Provjeri ponovo"}},"da":{"stringUnit":{"state":"needs_review","value":"Tjek igen"}},"it":{"stringUnit":{"state":"needs_review","value":"Controlla di nuovo"}},"km":{"stringUnit":{"state":"needs_review","value":"ពិនិត្យម្ដងទៀត"}},"nb":{"stringUnit":{"state":"needs_review","value":"Sjekk igjen"}},"pl":{"stringUnit":{"state":"needs_review","value":"Sprawdź ponownie"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Verificar de novo"}},"ru":{"stringUnit":{"state":"needs_review","value":"Проверить снова"}},"th":{"stringUnit":{"state":"needs_review","value":"ตรวจสอบอีกครั้ง"}},"tr":{"stringUnit":{"state":"needs_review","value":"Tekrar denetle"}},"uk":{"stringUnit":{"state":"needs_review","value":"Перевірити знову"}},"vi":{"stringUnit":{"state":"needs_review","value":"Kiểm tra lại"}}}},
    "sandbox.unchecked": {"comment":"Chat: notice that the app didn't answer whether this tab has a sandboxed run","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Couldn't check this tab for a sandboxed run."}},"de":{"stringUnit":{"state":"translated","value":"Dieser Tab konnte nicht auf einen Sandbox-Lauf geprüft werden."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de vérifier si cet onglet a une exécution isolée."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر التحقق من وجود تشغيل معزول في علامة التبويب هذه."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo comprobar si esta pestaña tiene una ejecución aislada."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法檢查此分頁是否有沙箱執行。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法检查此标签页是否有沙箱运行。"}},"ko":{"stringUnit":{"state":"translated","value":"이 탭에 샌드박스 실행이 있는지 확인하지 못했습니다."}},"ja":{"stringUnit":{"state":"translated","value":"このタブにサンドボックス実行があるか確認できませんでした。"}},"bs":{"stringUnit":{"state":"needs_review","value":"Nije bilo moguće provjeriti ima li ova kartica izolovano pokretanje."}},"da":{"stringUnit":{"state":"needs_review","value":"Kunne ikke tjekke, om denne fane har en sandkassekørsel."}},"it":{"stringUnit":{"state":"needs_review","value":"Impossibile verificare se questa scheda ha un'esecuzione in sandbox."}},"km":{"stringUnit":{"state":"needs_review","value":"មិនអាចពិនិត្យថាផ្ទាំងនេះមានដំណើរការក្នុងប្រអប់ខ្សាច់ឬទេ។"}},"nb":{"stringUnit":{"state":"needs_review","value":"Kunne ikke sjekke om denne fanen har en sandkassekjøring."}},"pl":{"stringUnit":{"state":"needs_review","value":"Nie udało się sprawdzić, czy ta karta ma uruchomienie w piaskownicy."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Não foi possível verificar se esta aba tem uma execução isolada."}},"ru":{"stringUnit":{"state":"needs_review","value":"Не удалось проверить, есть ли в этой вкладке запуск в песочнице."}},"th":{"stringUnit":{"state":"needs_review","value":"ตรวจสอบไม่ได้ว่าแท็บนี้มีการเรียกใช้แบบแซนด์บ็อกซ์หรือไม่"}},"tr":{"stringUnit":{"state":"needs_review","value":"Bu sekmede korumalı çalıştırma olup olmadığı denetlenemedi."}},"uk":{"stringUnit":{"state":"needs_review","value":"Не вдалося перевірити, чи є в цій вкладці запуск у пісочниці."}},"vi":{"stringUnit":{"state":"needs_review","value":"Không thể kiểm tra thẻ này có lần chạy hộp cát hay không."}}}},
    "sandbox.error.failed": {"comment":"Chat: the sandboxed run could not start, no further reason","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The sandbox couldn't run this message."}},"de":{"stringUnit":{"state":"translated","value":"Die Sandbox konnte diese Nachricht nicht ausführen."}},"fr":{"stringUnit":{"state":"translated","value":"Le bac à sable n’a pas pu exécuter ce message."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر على الصندوق المعزول تشغيل هذه الرسالة."}},"es":{"stringUnit":{"state":"translated","value":"El sandbox no pudo ejecutar este mensaje."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"沙箱無法執行這則訊息。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"沙箱无法运行这条消息。"}},"ko":{"stringUnit":{"state":"translated","value":"샌드박스에서 이 메시지를 실행할 수 없습니다."}},"ja":{"stringUnit":{"state":"translated","value":"サンドボックスでこのメッセージを実行できませんでした。"}},"bs":{"stringUnit":{"state":"needs_review","value":"Sandbox nije mogao pokrenuti ovu poruku."}},"da":{"stringUnit":{"state":"needs_review","value":"Sandkassen kunne ikke køre denne besked."}},"it":{"stringUnit":{"state":"needs_review","value":"Il sandbox non ha potuto eseguire questo messaggio."}},"km":{"stringUnit":{"state":"needs_review","value":"ប្រអប់ខ្សាច់មិនអាចដំណើរការសារនេះបានទេ។"}},"nb":{"stringUnit":{"state":"needs_review","value":"Sandkassen kunne ikke kjøre denne meldingen."}},"pl":{"stringUnit":{"state":"needs_review","value":"Piaskownica nie mogła uruchomić tej wiadomości."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O sandbox não conseguiu executar esta mensagem."}},"ru":{"stringUnit":{"state":"needs_review","value":"Песочнице не удалось выполнить это сообщение."}},"th":{"stringUnit":{"state":"needs_review","value":"แซนด์บ็อกซ์เรียกใช้ข้อความนี้ไม่ได้"}},"tr":{"stringUnit":{"state":"needs_review","value":"Korumalı alan bu mesajı çalıştıramadı."}},"uk":{"stringUnit":{"state":"needs_review","value":"Пісочниці не вдалося виконати це повідомлення."}},"vi":{"stringUnit":{"state":"needs_review","value":"Hộp cát không thể chạy tin nhắn này."}}}},
    "sandbox.error.labsOff": {"comment":"Chat: Sandboxed refused while the Labs preview flag is off","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Sandboxed runs are a preview. Turn on Settings > Advanced > Labs > Show Preview Features."}},"de":{"stringUnit":{"state":"translated","value":"Sandbox-Läufe sind eine Vorschau. Aktiviere Einstellungen > Erweitert > Labs > Vorschaufunktionen anzeigen."}},"fr":{"stringUnit":{"state":"translated","value":"Les exécutions isolées sont en aperçu. Activez Réglages > Avancé > Labs > Afficher les fonctions en aperçu."}},"ar":{"stringUnit":{"state":"translated","value":"التشغيلات المعزولة ميزة تجريبية. فعّل الإعدادات > متقدم > المختبرات > إظهار الميزات التجريبية."}},"es":{"stringUnit":{"state":"translated","value":"Las ejecuciones aisladas son una vista previa. Activa Ajustes > Avanzado > Labs > Mostrar funciones en vista previa."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"沙箱執行仍為預覽功能。請開啟「設定 > 進階 > Labs > 顯示預覽功能」。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"沙箱运行仍是预览功能。请打开“设置 > 高级 > Labs > 显示预览功能”。"}},"ko":{"stringUnit":{"state":"translated","value":"샌드박스 실행은 미리보기 기능입니다. 설정 > 고급 > Labs > 미리보기 기능 표시를 켜세요."}},"ja":{"stringUnit":{"state":"translated","value":"サンドボックス実行はプレビュー機能です。設定 > 詳細 > Labs > プレビュー機能を表示 をオンにしてください。"}},"bs":{"stringUnit":{"state":"needs_review","value":"Izolovana pokretanja su pregled. Uključite Postavke > Napredno > Labs > Prikaži funkcije pregleda."}},"da":{"stringUnit":{"state":"needs_review","value":"Sandkassekørsler er en forhåndsvisning. Slå Indstillinger > Avanceret > Labs > Vis forhåndsvisningsfunktioner til."}},"it":{"stringUnit":{"state":"needs_review","value":"Le esecuzioni in sandbox sono un'anteprima. Attiva Impostazioni > Avanzate > Labs > Mostra funzioni in anteprima."}},"km":{"stringUnit":{"state":"needs_review","value":"ដំណើរការក្នុងប្រអប់ខ្សាច់ជាការមើលជាមុន។ បើក ការកំណត់ > កម្រិតខ្ពស់ > Labs > បង្ហាញមុខងារមើលជាមុន។"}},"nb":{"stringUnit":{"state":"needs_review","value":"Sandkassekjøringer er en forhåndsvisning. Slå på Innstillinger > Avansert > Labs > Vis forhåndsvisningsfunksjoner."}},"pl":{"stringUnit":{"state":"needs_review","value":"Uruchomienia w piaskownicy to podgląd. Włącz Ustawienia > Zaawansowane > Labs > Pokaż funkcje podglądu."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Execuções isoladas são uma prévia. Ative Ajustes > Avançado > Labs > Mostrar recursos em prévia."}},"ru":{"stringUnit":{"state":"needs_review","value":"Запуски в песочнице — предварительная функция. Включите Настройки > Дополнительно > Labs > Показывать предварительные функции."}},"th":{"stringUnit":{"state":"needs_review","value":"การเรียกใช้แบบแซนด์บ็อกซ์เป็นฟีเจอร์ทดลอง เปิด การตั้งค่า > ขั้นสูง > Labs > แสดงฟีเจอร์ทดลอง"}},"tr":{"stringUnit":{"state":"needs_review","value":"Korumalı çalıştırmalar bir önizlemedir. Ayarlar > Gelişmiş > Labs > Önizleme Özelliklerini Göster'i açın."}},"uk":{"stringUnit":{"state":"needs_review","value":"Запуски в пісочниці — попередня функція. Увімкніть Налаштування > Додатково > Labs > Показувати попередні функції."}},"vi":{"stringUnit":{"state":"needs_review","value":"Chạy trong hộp cát là tính năng xem trước. Bật Cài đặt > Nâng cao > Labs > Hiện tính năng xem trước."}}}},
    "sandbox.error.notSignedIn": {"comment":"Chat: Sandboxed refused while signed out of cmux","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Sign in to cmux to run in a sandbox."}},"de":{"stringUnit":{"state":"translated","value":"Melde dich bei cmux an, um in einer Sandbox auszuführen."}},"fr":{"stringUnit":{"state":"translated","value":"Connectez-vous à cmux pour exécuter dans un bac à sable."}},"ar":{"stringUnit":{"state":"translated","value":"سجّل الدخول إلى cmux للتشغيل في صندوق معزول."}},"es":{"stringUnit":{"state":"translated","value":"Inicia sesión en cmux para ejecutar en un sandbox."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"登入 cmux 才能在沙箱中執行。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"登录 cmux 才能在沙箱中运行。"}},"ko":{"stringUnit":{"state":"translated","value":"샌드박스에서 실행하려면 cmux에 로그인하세요."}},"ja":{"stringUnit":{"state":"translated","value":"サンドボックスで実行するには cmux にサインインしてください。"}},"bs":{"stringUnit":{"state":"needs_review","value":"Prijavite se na cmux da pokrenete u sandboxu."}},"da":{"stringUnit":{"state":"needs_review","value":"Log ind på cmux for at køre i en sandkasse."}},"it":{"stringUnit":{"state":"needs_review","value":"Accedi a cmux per eseguire in un sandbox."}},"km":{"stringUnit":{"state":"needs_review","value":"ចូល cmux ដើម្បីដំណើរការក្នុងប្រអប់ខ្សាច់។"}},"nb":{"stringUnit":{"state":"needs_review","value":"Logg inn på cmux for å kjøre i en sandkasse."}},"pl":{"stringUnit":{"state":"needs_review","value":"Zaloguj się do cmux, aby uruchomić w piaskownicy."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Entre no cmux para executar em um sandbox."}},"ru":{"stringUnit":{"state":"needs_review","value":"Войдите в cmux, чтобы запускать в песочнице."}},"th":{"stringUnit":{"state":"needs_review","value":"ลงชื่อเข้า cmux เพื่อเรียกใช้ในแซนด์บ็อกซ์"}},"tr":{"stringUnit":{"state":"needs_review","value":"Korumalı alanda çalıştırmak için cmux'a giriş yapın."}},"uk":{"stringUnit":{"state":"needs_review","value":"Увійдіть у cmux, щоб запускати в пісочниці."}},"vi":{"stringUnit":{"state":"needs_review","value":"Đăng nhập cmux để chạy trong hộp cát."}}}},
    "sandbox.error.notEnabled": {"comment":"Chat: the server has not enabled sandboxed runs for this account","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Sandboxed runs aren't enabled for your cmux account yet."}},"de":{"stringUnit":{"state":"translated","value":"Sandbox-Läufe sind für dein cmux-Konto noch nicht aktiviert."}},"fr":{"stringUnit":{"state":"translated","value":"Les exécutions isolées ne sont pas encore activées pour votre compte cmux."}},"ar":{"stringUnit":{"state":"translated","value":"التشغيلات المعزولة غير مفعّلة لحساب cmux الخاص بك بعد."}},"es":{"stringUnit":{"state":"translated","value":"Las ejecuciones aisladas aún no están activadas para tu cuenta de cmux."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"你的 cmux 帳號尚未啟用沙箱執行。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的 cmux 账户尚未启用沙箱运行。"}},"ko":{"stringUnit":{"state":"translated","value":"cmux 계정에 아직 샌드박스 실행이 활성화되지 않았습니다."}},"ja":{"stringUnit":{"state":"translated","value":"お使いの cmux アカウントではサンドボックス実行がまだ有効になっていません。"}},"bs":{"stringUnit":{"state":"needs_review","value":"Izolovana pokretanja još nisu uključena za vaš cmux račun."}},"da":{"stringUnit":{"state":"needs_review","value":"Sandkassekørsler er endnu ikke slået til for din cmux-konto."}},"it":{"stringUnit":{"state":"needs_review","value":"Le esecuzioni in sandbox non sono ancora attive per il tuo account cmux."}},"km":{"stringUnit":{"state":"needs_review","value":"ដំណើរការក្នុងប្រអប់ខ្សាច់មិនទាន់បើកសម្រាប់គណនី cmux របស់អ្នកទេ។"}},"nb":{"stringUnit":{"state":"needs_review","value":"Sandkassekjøringer er ikke slått på for cmux-kontoen din ennå."}},"pl":{"stringUnit":{"state":"needs_review","value":"Uruchomienia w piaskownicy nie są jeszcze włączone dla twojego konta cmux."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Execuções isoladas ainda não estão ativas na sua conta cmux."}},"ru":{"stringUnit":{"state":"needs_review","value":"Запуски в песочнице ещё не включены для вашего аккаунта cmux."}},"th":{"stringUnit":{"state":"needs_review","value":"บัญชี cmux ของคุณยังไม่เปิดการเรียกใช้แบบแซนด์บ็อกซ์"}},"tr":{"stringUnit":{"state":"needs_review","value":"Korumalı çalıştırmalar cmux hesabınızda henüz açık değil."}},"uk":{"stringUnit":{"state":"needs_review","value":"Запуски в пісочниці ще не ввімкнено для вашого акаунта cmux."}},"vi":{"stringUnit":{"state":"needs_review","value":"Tài khoản cmux của bạn chưa bật chạy trong hộp cát."}}}},
    "sandbox.error.timeout": {"comment":"Chat: no receipt arrived in time; the run may still be going","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"No receipt arrived in time. The run may still be going; the server destroys its VM when it ends."}},"de":{"stringUnit":{"state":"translated","value":"Kein Beleg kam rechtzeitig. Der Lauf läuft vielleicht noch; der Server löscht seine VM, wenn er endet."}},"fr":{"stringUnit":{"state":"translated","value":"Aucun reçu n’est arrivé à temps. L’exécution est peut-être en cours ; le serveur détruit sa VM à la fin."}},"ar":{"stringUnit":{"state":"translated","value":"لم يصل إيصال في الوقت المحدد. قد يكون التشغيل مستمرًا؛ يحذف الخادم جهازه الافتراضي عند انتهائه."}},"es":{"stringUnit":{"state":"translated","value":"No llegó ningún recibo a tiempo. La ejecución puede seguir; el servidor destruye su VM al terminar."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"未及時收到收據。執行可能仍在進行；結束時伺服器會銷毀其 VM。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未及时收到收据。运行可能仍在进行；结束时服务器会销毁其 VM。"}},"ko":{"stringUnit":{"state":"translated","value":"제때 영수증이 오지 않았습니다. 실행이 계속 중일 수 있으며, 끝나면 서버가 VM을 삭제합니다."}},"ja":{"stringUnit":{"state":"translated","value":"時間内にレシートが届きませんでした。実行は続いている可能性があり、終了時にサーバーが VM を破棄します。"}},"bs":{"stringUnit":{"state":"needs_review","value":"Priznanica nije stigla na vrijeme. Pokretanje možda još traje; server briše njegovu VM kad završi."}},"da":{"stringUnit":{"state":"needs_review","value":"Ingen kvittering nåede frem i tide. Kørslen kører måske stadig; serveren sletter dens VM, når den slutter."}},"it":{"stringUnit":{"state":"needs_review","value":"Nessuna ricevuta in tempo. L'esecuzione potrebbe essere ancora in corso; il server distrugge la sua VM al termine."}},"km":{"stringUnit":{"state":"needs_review","value":"មិនបានទទួលបង្កាន់ដៃទាន់ពេល។ ដំណើរការអាចនៅបន្ត ម៉ាស៊ីនមេនឹងលុប VM របស់វានៅពេលបញ្ចប់។"}},"nb":{"stringUnit":{"state":"needs_review","value":"Ingen kvittering kom i tide. Kjøringen kan fortsatt pågå; serveren sletter VM-en når den er ferdig."}},"pl":{"stringUnit":{"state":"needs_review","value":"Potwierdzenie nie dotarło na czas. Uruchomienie może nadal trwać; serwer usunie jego maszynę po zakończeniu."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Nenhum recibo chegou a tempo. A execução pode continuar; o servidor destrói sua VM ao terminar."}},"ru":{"stringUnit":{"state":"needs_review","value":"Квитанция не пришла вовремя. Запуск может ещё идти; сервер удалит его ВМ по завершении."}},"th":{"stringUnit":{"state":"needs_review","value":"ไม่ได้รับใบเสร็จทันเวลา การเรียกใช้อาจยังทำงานอยู่ เซิร์ฟเวอร์จะลบ VM เมื่อจบ"}},"tr":{"stringUnit":{"state":"needs_review","value":"Makbuz zamanında gelmedi. Çalıştırma sürüyor olabilir; bitince sunucu VM'sini siler."}},"uk":{"stringUnit":{"state":"needs_review","value":"Квитанція не надійшла вчасно. Запуск може ще тривати; сервер видалить його ВМ після завершення."}},"vi":{"stringUnit":{"state":"needs_review","value":"Không nhận được biên nhận kịp thời. Lần chạy có thể vẫn đang diễn ra; máy chủ sẽ xóa VM khi kết thúc."}}}},
    "sandbox.error.attachments": {"comment":"Chat: a Sandboxed run was refused because the message has attachments","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"A sandboxed run takes text only. Remove the attachments or switch to Persistent."}},"de":{"stringUnit":{"state":"translated","value":"Ein Sandbox-Lauf nimmt nur Text. Entferne die Anhänge oder wechsle zu Dauerhaft."}},"fr":{"stringUnit":{"state":"translated","value":"Une exécution isolée n’accepte que du texte. Retirez les pièces jointes ou passez à Persistant."}},"ar":{"stringUnit":{"state":"translated","value":"التشغيل المعزول يقبل نصًا فقط. أزل المرفقات أو انتقل إلى دائم."}},"es":{"stringUnit":{"state":"translated","value":"Una ejecución aislada solo admite texto. Quita los adjuntos o cambia a Persistente."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"沙箱執行只接受文字。請移除附件或改用「持續」。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"沙箱运行只接受文字。请移除附件或改用“持久”。"}},"ko":{"stringUnit":{"state":"translated","value":"샌드박스 실행은 텍스트만 받습니다. 첨부 파일을 제거하거나 지속으로 바꾸세요."}},"ja":{"stringUnit":{"state":"translated","value":"サンドボックス実行はテキストのみです。添付を外すか、永続に切り替えてください。"}},"bs":{"stringUnit":{"state":"needs_review","value":"Izolovano pokretanje prima samo tekst. Uklonite priloge ili pređite na Trajno."}},"da":{"stringUnit":{"state":"needs_review","value":"En sandkassekørsel tager kun tekst. Fjern vedhæftningerne, eller skift til Vedvarende."}},"it":{"stringUnit":{"state":"needs_review","value":"Un'esecuzione in sandbox accetta solo testo. Rimuovi gli allegati o passa a Persistente."}},"km":{"stringUnit":{"state":"needs_review","value":"ដំណើរការក្នុងប្រអប់ខ្សាច់ទទួលតែអត្ថបទ។ ដកឯកសារភ្ជាប់ចេញ ឬប្ដូរទៅ ជាប់លាប់។"}},"nb":{"stringUnit":{"state":"needs_review","value":"En sandkassekjøring tar bare tekst. Fjern vedleggene eller bytt til Vedvarende."}},"pl":{"stringUnit":{"state":"needs_review","value":"Uruchomienie w piaskownicy przyjmuje tylko tekst. Usuń załączniki lub przełącz na Trwały."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Uma execução isolada aceita apenas texto. Remova os anexos ou mude para Persistente."}},"ru":{"stringUnit":{"state":"needs_review","value":"Запуск в песочнице принимает только текст. Уберите вложения или переключитесь на Постоянный."}},"th":{"stringUnit":{"state":"needs_review","value":"การเรียกใช้แบบแซนด์บ็อกซ์รับเฉพาะข้อความ นำไฟล์แนบออกหรือเปลี่ยนเป็นถาวร"}},"tr":{"stringUnit":{"state":"needs_review","value":"Korumalı çalıştırma yalnızca metin alır. Ekleri kaldırın veya Kalıcı'ya geçin."}},"uk":{"stringUnit":{"state":"needs_review","value":"Запуск у пісочниці приймає лише текст. Приберіть вкладення або перейдіть на Постійний."}},"vi":{"stringUnit":{"state":"needs_review","value":"Chạy trong hộp cát chỉ nhận văn bản. Gỡ tệp đính kèm hoặc chuyển sang Lâu dài."}}}},
    "sandbox.error.agent": {"comment":"Chat: a Sandboxed run was refused because the chosen agent can't run in a sandbox","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Sandboxes run Claude Code, Codex, OpenCode or Pi. Pick one of them or switch to Persistent."}},"de":{"stringUnit":{"state":"translated","value":"Sandboxen führen Claude Code, Codex, OpenCode oder Pi aus. Wähle einen davon oder wechsle zu Dauerhaft."}},"fr":{"stringUnit":{"state":"translated","value":"Les bacs à sable exécutent Claude Code, Codex, OpenCode ou Pi. Choisissez-en un ou passez à Persistant."}},"ar":{"stringUnit":{"state":"translated","value":"تشغّل الصناديق المعزولة Claude Code أو Codex أو OpenCode أو Pi. اختر أحدها أو انتقل إلى دائم."}},"es":{"stringUnit":{"state":"translated","value":"Los sandboxes ejecutan Claude Code, Codex, OpenCode o Pi. Elige uno o cambia a Persistente."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"沙箱可執行 Claude Code、Codex、OpenCode 或 Pi。請選擇其中一個或改用「持續」。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"沙箱可运行 Claude Code、Codex、OpenCode 或 Pi。请选择其中一个或改用“持久”。"}},"ko":{"stringUnit":{"state":"translated","value":"샌드박스는 Claude Code, Codex, OpenCode, Pi를 실행합니다. 이 중 하나를 고르거나 지속으로 바꾸세요."}},"ja":{"stringUnit":{"state":"translated","value":"サンドボックスで実行できるのは Claude Code・Codex・OpenCode・Pi です。いずれかを選ぶか、永続に切り替えてください。"}},"bs":{"stringUnit":{"state":"needs_review","value":"Sandboxi pokreću Claude Code, Codex, OpenCode ili Pi. Odaberite jedan ili pređite na Trajno."}},"da":{"stringUnit":{"state":"needs_review","value":"Sandkasser kører Claude Code, Codex, OpenCode eller Pi. Vælg en af dem, eller skift til Vedvarende."}},"it":{"stringUnit":{"state":"needs_review","value":"I sandbox eseguono Claude Code, Codex, OpenCode o Pi. Scegline uno o passa a Persistente."}},"km":{"stringUnit":{"state":"needs_review","value":"ប្រអប់ខ្សាច់ដំណើរការ Claude Code, Codex, OpenCode ឬ Pi។ ជ្រើសមួយ ឬប្ដូរទៅ ជាប់លាប់។"}},"nb":{"stringUnit":{"state":"needs_review","value":"Sandkasser kjører Claude Code, Codex, OpenCode eller Pi. Velg en av dem eller bytt til Vedvarende."}},"pl":{"stringUnit":{"state":"needs_review","value":"Piaskownice uruchamiają Claude Code, Codex, OpenCode lub Pi. Wybierz jeden lub przełącz na Trwały."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Sandboxes executam Claude Code, Codex, OpenCode ou Pi. Escolha um ou mude para Persistente."}},"ru":{"stringUnit":{"state":"needs_review","value":"Песочницы запускают Claude Code, Codex, OpenCode или Pi. Выберите один или переключитесь на Постоянный."}},"th":{"stringUnit":{"state":"needs_review","value":"แซนด์บ็อกซ์เรียกใช้ Claude Code, Codex, OpenCode หรือ Pi เลือกหนึ่งตัวหรือเปลี่ยนเป็นถาวร"}},"tr":{"stringUnit":{"state":"needs_review","value":"Korumalı alanlar Claude Code, Codex, OpenCode veya Pi çalıştırır. Birini seçin veya Kalıcı'ya geçin."}},"uk":{"stringUnit":{"state":"needs_review","value":"Пісочниці запускають Claude Code, Codex, OpenCode або Pi. Виберіть один або перейдіть на Постійний."}},"vi":{"stringUnit":{"state":"needs_review","value":"Hộp cát chạy Claude Code, Codex, OpenCode hoặc Pi. Chọn một trong số đó hoặc chuyển sang Lâu dài."}}}},
    "sandbox.error.uncertain": {"comment":"Chat: the sandbox's answer was lost after the request may have reached the server","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The sandbox's answer was lost. The run may still be going; the server destroys its VM when it ends."}},"de":{"stringUnit":{"state":"translated","value":"Die Antwort der Sandbox ging verloren. Der Lauf läuft vielleicht noch; der Server löscht seine VM, wenn er endet."}},"fr":{"stringUnit":{"state":"translated","value":"La réponse du bac à sable a été perdue. L’exécution est peut-être en cours ; le serveur détruit sa VM à la fin."}},"ar":{"stringUnit":{"state":"translated","value":"فُقد رد الصندوق المعزول. قد يكون التشغيل مستمرًا؛ يحذف الخادم جهازه الافتراضي عند انتهائه."}},"es":{"stringUnit":{"state":"translated","value":"Se perdió la respuesta del sandbox. La ejecución puede seguir; el servidor destruye su VM al terminar."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"沙箱的回應遺失了。執行可能仍在進行；結束時伺服器會銷毀其 VM。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"沙箱的响应丢失了。运行可能仍在进行；结束时服务器会销毁其 VM。"}},"ko":{"stringUnit":{"state":"translated","value":"샌드박스 응답이 유실되었습니다. 실행이 계속 중일 수 있으며, 끝나면 서버가 VM을 삭제합니다."}},"ja":{"stringUnit":{"state":"translated","value":"サンドボックスの応答が失われました。実行は続いている可能性があり、終了時にサーバーが VM を破棄します。"}},"bs":{"stringUnit":{"state":"needs_review","value":"Odgovor sandboxa je izgubljen. Pokretanje možda još traje; server briše njegovu VM kad završi."}},"da":{"stringUnit":{"state":"needs_review","value":"Sandkassens svar gik tabt. Kørslen kører måske stadig; serveren sletter dens VM, når den slutter."}},"it":{"stringUnit":{"state":"needs_review","value":"La risposta del sandbox è andata persa. L'esecuzione potrebbe essere in corso; il server distrugge la sua VM al termine."}},"km":{"stringUnit":{"state":"needs_review","value":"ចម្លើយរបស់ប្រអប់ខ្សាច់បានបាត់។ ដំណើរការអាចនៅបន្ត ម៉ាស៊ីនមេនឹងលុប VM របស់វានៅពេលបញ្ចប់។"}},"nb":{"stringUnit":{"state":"needs_review","value":"Sandkassens svar gikk tapt. Kjøringen kan fortsatt pågå; serveren sletter VM-en når den er ferdig."}},"pl":{"stringUnit":{"state":"needs_review","value":"Odpowiedź piaskownicy zaginęła. Uruchomienie może nadal trwać; serwer usunie jego maszynę po zakończeniu."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"A resposta do sandbox se perdeu. A execução pode continuar; o servidor destrói sua VM ao terminar."}},"ru":{"stringUnit":{"state":"needs_review","value":"Ответ песочницы потерян. Запуск может ещё идти; сервер удалит его ВМ по завершении."}},"th":{"stringUnit":{"state":"needs_review","value":"คำตอบของแซนด์บ็อกซ์หายไป การเรียกใช้อาจยังทำงานอยู่ เซิร์ฟเวอร์จะลบ VM เมื่อจบ"}},"tr":{"stringUnit":{"state":"needs_review","value":"Korumalı alanın yanıtı kayboldu. Çalıştırma sürüyor olabilir; bitince sunucu VM'sini siler."}},"uk":{"stringUnit":{"state":"needs_review","value":"Відповідь пісочниці втрачено. Запуск може ще тривати; сервер видалить його ВМ після завершення."}},"vi":{"stringUnit":{"state":"needs_review","value":"Phản hồi của hộp cát bị mất. Lần chạy có thể vẫn đang diễn ra; máy chủ sẽ xóa VM khi kết thúc."}}}},
    "sandbox.error.cloudDisabled": {"comment":"Chat: Sandboxed refused because an administrator turned off cmux Cloud","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"cmux Cloud is turned off on this Mac, so sandboxed runs aren't available."}},"de":{"stringUnit":{"state":"translated","value":"cmux Cloud ist auf diesem Mac deaktiviert, daher gibt es keine Sandbox-Läufe."}},"fr":{"stringUnit":{"state":"translated","value":"cmux Cloud est désactivé sur ce Mac : les exécutions isolées ne sont pas disponibles."}},"ar":{"stringUnit":{"state":"translated","value":"تم إيقاف cmux Cloud على هذا الـ Mac، لذا التشغيلات المعزولة غير متاحة."}},"es":{"stringUnit":{"state":"translated","value":"cmux Cloud está desactivado en este Mac, así que no hay ejecuciones aisladas."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"這部 Mac 已關閉 cmux Cloud，無法使用沙箱執行。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这台 Mac 已关闭 cmux Cloud，无法使用沙箱运行。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Mac에서 cmux Cloud가 꺼져 있어 샌드박스 실행을 사용할 수 없습니다."}},"ja":{"stringUnit":{"state":"translated","value":"この Mac では cmux Cloud がオフのため、サンドボックス実行は使えません。"}},"bs":{"stringUnit":{"state":"needs_review","value":"cmux Cloud je isključen na ovom Macu, pa izolovana pokretanja nisu dostupna."}},"da":{"stringUnit":{"state":"needs_review","value":"cmux Cloud er slået fra på denne Mac, så sandkassekørsler er ikke tilgængelige."}},"it":{"stringUnit":{"state":"needs_review","value":"cmux Cloud è disattivato su questo Mac, quindi le esecuzioni in sandbox non sono disponibili."}},"km":{"stringUnit":{"state":"needs_review","value":"cmux Cloud ត្រូវបានបិទលើ Mac នេះ ដូច្នេះមិនមានដំណើរការក្នុងប្រអប់ខ្សាច់ទេ។"}},"nb":{"stringUnit":{"state":"needs_review","value":"cmux Cloud er slått av på denne Macen, så sandkassekjøringer er ikke tilgjengelige."}},"pl":{"stringUnit":{"state":"needs_review","value":"cmux Cloud jest wyłączony na tym Macu, więc uruchomienia w piaskownicy są niedostępne."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O cmux Cloud está desativado neste Mac, então execuções isoladas não estão disponíveis."}},"ru":{"stringUnit":{"state":"needs_review","value":"cmux Cloud отключён на этом Mac, поэтому запуски в песочнице недоступны."}},"th":{"stringUnit":{"state":"needs_review","value":"cmux Cloud ถูกปิดบน Mac นี้ จึงใช้การเรียกใช้แบบแซนด์บ็อกซ์ไม่ได้"}},"tr":{"stringUnit":{"state":"needs_review","value":"cmux Cloud bu Mac'te kapalı, bu yüzden korumalı çalıştırmalar kullanılamaz."}},"uk":{"stringUnit":{"state":"needs_review","value":"cmux Cloud вимкнено на цьому Mac, тож запуски в пісочниці недоступні."}},"vi":{"stringUnit":{"state":"needs_review","value":"cmux Cloud đã tắt trên Mac này nên không thể chạy trong hộp cát."}}}},
    "sandbox.error.notNow": {"comment":"Chat: Sandboxed is picked but can't run while a chat is starting or opening in this tab","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Sandboxed can't run while a chat is starting or opening here. Wait, or send it as Persistent."}},"de":{"stringUnit":{"state":"translated","value":"Sandbox kann nicht laufen, während hier ein Chat startet oder öffnet. Warte oder sende es als Dauerhaft."}},"fr":{"stringUnit":{"state":"translated","value":"L’exécution isolée est impossible pendant qu’une discussion démarre ou s’ouvre ici. Patientez ou envoyez en Persistant."}},"ar":{"stringUnit":{"state":"translated","value":"لا يمكن التشغيل المعزول أثناء بدء محادثة أو فتحها هنا. انتظر أو أرسلها كدائم."}},"es":{"stringUnit":{"state":"translated","value":"No se puede ejecutar en sandbox mientras se inicia o abre un chat aquí. Espera o envíalo como Persistente."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此處正在啟動或開啟聊天時無法使用沙箱。請稍候，或改以「持續」傳送。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此处正在启动或打开聊天时无法使用沙箱。请稍候，或改为“持久”发送。"}},"ko":{"stringUnit":{"state":"translated","value":"여기서 채팅을 시작하거나 여는 중에는 샌드박스를 실행할 수 없습니다. 기다리거나 지속으로 보내세요."}},"ja":{"stringUnit":{"state":"translated","value":"ここでチャットを開始中または開いている間はサンドボックスを実行できません。待つか、永続で送信してください。"}},"bs":{"stringUnit":{"state":"needs_review","value":"Sandbox ne može raditi dok se ovdje pokreće ili otvara chat. Sačekajte ili pošaljite kao Trajno."}},"da":{"stringUnit":{"state":"needs_review","value":"Sandkassen kan ikke køre, mens en chat starter eller åbnes her. Vent, eller send som Vedvarende."}},"it":{"stringUnit":{"state":"needs_review","value":"Il sandbox non può partire mentre qui si avvia o apre una chat. Attendi o invia come Persistente."}},"km":{"stringUnit":{"state":"needs_review","value":"មិនអាចដំណើរការប្រអប់ខ្សាច់ពេលការជជែកកំពុងចាប់ផ្ដើម ឬបើកនៅទីនេះ។ រង់ចាំ ឬផ្ញើជា ជាប់លាប់។"}},"nb":{"stringUnit":{"state":"needs_review","value":"Sandkassen kan ikke kjøre mens en chat starter eller åpnes her. Vent, eller send som Vedvarende."}},"pl":{"stringUnit":{"state":"needs_review","value":"Piaskownica nie może działać, gdy uruchamia się tu lub otwiera czat. Poczekaj lub wyślij jako Trwały."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O sandbox não pode rodar enquanto um chat inicia ou abre aqui. Aguarde ou envie como Persistente."}},"ru":{"stringUnit":{"state":"needs_review","value":"Песочница не может работать, пока здесь запускается или открывается чат. Подождите или отправьте как Постоянный."}},"th":{"stringUnit":{"state":"needs_review","value":"เรียกใช้แซนด์บ็อกซ์ไม่ได้ขณะที่แชทกำลังเริ่มหรือเปิดที่นี่ รอ หรือส่งแบบถาวร"}},"tr":{"stringUnit":{"state":"needs_review","value":"Burada bir sohbet başlarken veya açılırken korumalı alan çalışamaz. Bekleyin veya Kalıcı olarak gönderin."}},"uk":{"stringUnit":{"state":"needs_review","value":"Пісочниця не може працювати, поки тут запускається або відкривається чат. Зачекайте або надішліть як Постійний."}},"vi":{"stringUnit":{"state":"needs_review","value":"Không thể chạy hộp cát khi một cuộc trò chuyện đang bắt đầu hoặc mở ở đây. Hãy đợi hoặc gửi dưới dạng Lâu dài."}}}},
    "sandbox.error.spent": {"comment":"Chat: this tab already ran its one sandboxed message (or one is running)","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This tab already ran a sandboxed message. Open a new tab for another."}},"de":{"stringUnit":{"state":"translated","value":"Dieser Tab hat schon eine Sandbox-Nachricht ausgeführt. Öffne für eine weitere einen neuen Tab."}},"fr":{"stringUnit":{"state":"translated","value":"Cet onglet a déjà exécuté un message isolé. Ouvrez un nouvel onglet pour un autre."}},"ar":{"stringUnit":{"state":"translated","value":"شغّلت علامة التبويب هذه رسالة معزولة بالفعل. افتح علامة تبويب جديدة لرسالة أخرى."}},"es":{"stringUnit":{"state":"translated","value":"Esta pestaña ya ejecutó un mensaje aislado. Abre una pestaña nueva para otro."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此分頁已執行過沙箱訊息。請開新分頁執行另一則。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此标签页已运行过沙箱消息。请打开新标签页运行另一条。"}},"ko":{"stringUnit":{"state":"translated","value":"이 탭은 이미 샌드박스 메시지를 실행했습니다. 다른 메시지는 새 탭에서 실행하세요."}},"ja":{"stringUnit":{"state":"translated","value":"このタブではすでにサンドボックスのメッセージを実行しました。別のメッセージは新しいタブで実行してください。"}},"bs":{"stringUnit":{"state":"needs_review","value":"Ova kartica je već pokrenula izolovanu poruku. Otvorite novu karticu za drugu."}},"da":{"stringUnit":{"state":"needs_review","value":"Denne fane har allerede kørt en sandkassebesked. Åbn en ny fane til en anden."}},"it":{"stringUnit":{"state":"needs_review","value":"Questa scheda ha già eseguito un messaggio in sandbox. Apri una nuova scheda per un altro."}},"km":{"stringUnit":{"state":"needs_review","value":"ផ្ទាំងនេះបានដំណើរការសារក្នុងប្រអប់ខ្សាច់រួចហើយ។ បើកផ្ទាំងថ្មីសម្រាប់សារផ្សេង។"}},"nb":{"stringUnit":{"state":"needs_review","value":"Denne fanen har allerede kjørt en sandkassemelding. Åpne en ny fane for en annen."}},"pl":{"stringUnit":{"state":"needs_review","value":"Ta karta uruchomiła już wiadomość w piaskownicy. Otwórz nową kartę dla kolejnej."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Esta aba já executou uma mensagem isolada. Abra uma nova aba para outra."}},"ru":{"stringUnit":{"state":"needs_review","value":"В этой вкладке уже запускалось сообщение в песочнице. Откройте новую вкладку для другого."}},"th":{"stringUnit":{"state":"needs_review","value":"แท็บนี้เรียกใช้ข้อความแบบแซนด์บ็อกซ์ไปแล้ว เปิดแท็บใหม่สำหรับข้อความอื่น"}},"tr":{"stringUnit":{"state":"needs_review","value":"Bu sekme zaten korumalı bir mesaj çalıştırdı. Başka biri için yeni sekme açın."}},"uk":{"stringUnit":{"state":"needs_review","value":"Ця вкладка вже запускала повідомлення в пісочниці. Відкрийте нову вкладку для іншого."}},"vi":{"stringUnit":{"state":"needs_review","value":"Thẻ này đã chạy một tin nhắn hộp cát. Hãy mở thẻ mới cho tin nhắn khác."}}}},
    "composer.envOpenMachine": {"comment":"Agent pane: environment picker and Computer menu, after a Cloud machine of the person's account that acpmux does not list: a pick opens the machine","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"needs_review","value":"فتح"}},"bs":{"stringUnit":{"state":"needs_review","value":"Otvori"}},"da":{"stringUnit":{"state":"needs_review","value":"Åbn"}},"de":{"stringUnit":{"state":"needs_review","value":"Öffnen"}},"en":{"stringUnit":{"state":"translated","value":"Open"}},"es":{"stringUnit":{"state":"needs_review","value":"Abrir"}},"fr":{"stringUnit":{"state":"needs_review","value":"Ouvrir"}},"it":{"stringUnit":{"state":"needs_review","value":"Apri"}},"ja":{"stringUnit":{"state":"needs_review","value":"開く"}},"km":{"stringUnit":{"state":"needs_review","value":"បើក"}},"ko":{"stringUnit":{"state":"needs_review","value":"열기"}},"nb":{"stringUnit":{"state":"needs_review","value":"Åpne"}},"pl":{"stringUnit":{"state":"needs_review","value":"Otwórz"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Abrir"}},"ru":{"stringUnit":{"state":"needs_review","value":"Открыть"}},"th":{"stringUnit":{"state":"needs_review","value":"เปิด"}},"tr":{"stringUnit":{"state":"needs_review","value":"Aç"}},"uk":{"stringUnit":{"state":"needs_review","value":"Відкрити"}},"vi":{"stringUnit":{"state":"needs_review","value":"Mở"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"打开"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"開啟"}}}},
    "composer.envPausedResume": {"comment":"Agent pane: environment picker and Computer menu, after a paused Cloud machine of the person's account: it is paused, and a pick resumes it","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"needs_review","value":"متوقف مؤقتًا · استئناف"}},"bs":{"stringUnit":{"state":"needs_review","value":"Pauzirano · Nastavi"}},"da":{"stringUnit":{"state":"needs_review","value":"Sat på pause · Genoptag"}},"de":{"stringUnit":{"state":"needs_review","value":"Pausiert · Fortsetzen"}},"en":{"stringUnit":{"state":"translated","value":"Paused · Resume"}},"es":{"stringUnit":{"state":"needs_review","value":"En pausa · Reanudar"}},"fr":{"stringUnit":{"state":"needs_review","value":"En pause · Reprendre"}},"it":{"stringUnit":{"state":"needs_review","value":"In pausa · Riprendi"}},"ja":{"stringUnit":{"state":"needs_review","value":"一時停止中 · 再開"}},"km":{"stringUnit":{"state":"needs_review","value":"បានផ្អាក · បន្ត"}},"ko":{"stringUnit":{"state":"needs_review","value":"일시 중지됨 · 재개"}},"nb":{"stringUnit":{"state":"needs_review","value":"Satt på pause · Gjenoppta"}},"pl":{"stringUnit":{"state":"needs_review","value":"Wstrzymano · Wznów"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Pausado · Retomar"}},"ru":{"stringUnit":{"state":"needs_review","value":"Приостановлено · Возобновить"}},"th":{"stringUnit":{"state":"needs_review","value":"หยุดชั่วคราว · ดำเนินการต่อ"}},"tr":{"stringUnit":{"state":"needs_review","value":"Duraklatıldı · Sürdür"}},"uk":{"stringUnit":{"state":"needs_review","value":"Призупинено · Відновити"}},"vi":{"stringUnit":{"state":"needs_review","value":"Đã tạm dừng · Tiếp tục"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"已暂停 · 恢复"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"已暫停 · 繼續"}}}},
