            "state": "needs_review",
            "value": "1 modifica non può essere annullata e verrà saltata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 件の編集は元に戻せないため、スキップします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការកែ 1 មិនអាចមិនធ្វើវិញបាន ហើយនឹងត្រូវរំលង។"
