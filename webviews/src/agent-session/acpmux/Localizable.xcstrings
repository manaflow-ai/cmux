    "managed.banner": {"comment":"Agent pane: the line over the composer of a chat the Chief or another chat's agent runs; {name} is that Chief or chat (shown bold)","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"needs_review","value":"{name} يدير هذه المحادثة"}},"bs":{"stringUnit":{"state":"needs_review","value":"{name} upravlja ovim razgovorom"}},"da":{"stringUnit":{"state":"needs_review","value":"{name} styrer denne chat"}},"de":{"stringUnit":{"state":"needs_review","value":"{name} führt diesen Chat"}},"en":{"stringUnit":{"state":"translated","value":"{name} is managing this chat"}},"es":{"stringUnit":{"state":"needs_review","value":"{name} gestiona este chat"}},"fr":{"stringUnit":{"state":"needs_review","value":"{name} gère cette discussion"}},"it":{"stringUnit":{"state":"needs_review","value":"{name} gestisce questa chat"}},"ja":{"stringUnit":{"state":"needs_review","value":"{name} がこのチャットを管理しています"}},"km":{"stringUnit":{"state":"needs_review","value":"{name} កំពុងគ្រប់គ្រងការជជែកនេះ"}},"ko":{"stringUnit":{"state":"needs_review","value":"{name}이(가) 이 채팅을 관리하고 있습니다"}},"nb":{"stringUnit":{"state":"needs_review","value":"{name} styrer denne chatten"}},"pl":{"stringUnit":{"state":"needs_review","value":"{name} zarządza tym czatem"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"{name} está gerenciando este chat"}},"ru":{"stringUnit":{"state":"needs_review","value":"{name} ведёт этот чат"}},"th":{"stringUnit":{"state":"needs_review","value":"{name} กำลังจัดการแชทนี้"}},"tr":{"stringUnit":{"state":"needs_review","value":"{name} bu sohbeti yönetiyor"}},"uk":{"stringUnit":{"state":"needs_review","value":"{name} веде цей чат"}},"vi":{"stringUnit":{"state":"needs_review","value":"{name} đang quản lý cuộc trò chuyện này"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"{name} 正在管理此聊天"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"{name} 正在管理此聊天"}}}},
