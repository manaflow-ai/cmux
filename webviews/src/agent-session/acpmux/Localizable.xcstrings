    "turn.nothingToContinue": {
      "comment": "Agent pane: notice when Continue After Error (palette, CLI, MCP) runs but the chat's last turn did not fail",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا شيء للمتابعة: الدور الأخير لم يفشل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nema se šta nastaviti: posljednji potez nije pao."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Intet at fortsætte: den sidste tur fejlede ikke."
          }
        },
