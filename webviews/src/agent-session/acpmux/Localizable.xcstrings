          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tylko żądania ACP · Izolacja niezweryfikowana"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Somente solicitações ACP · Isolamento não verificado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Только запросы ACP · Изоляция не проверена"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เฉพาะคำขอ ACP · ยังไม่ตรวจสอบการแยก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yalnızca ACP istekleri · Yalıtım doğrulanmadı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Лише запити ACP · Ізоляцію не перевірено"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chỉ yêu cầu ACP · Chưa xác minh cách ly"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅 ACP 请求 · 隔离未验证"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
