    "git.timedOut": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم ينتهِ git خلال دقيقتين فتم إيقافه. أعد المحاولة لمعرفة ما فعله."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git nije završio za 2 minute i zaustavljen je. Pokušajte ponovo da vidite šta je uradio."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git blev ikke færdig inden for 2 minutter og blev stoppet. Prøv igen for at se, hvad det gjorde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git wurde nicht innerhalb von 2 Minuten fertig und wurde gestoppt. Versuche es erneut, um zu sehen, was passiert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "git did not finish in 2 minutes and was stopped. Retry to see what it did."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git no terminó en 2 minutos y se detuvo. Reintenta para ver qué hizo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git ne s’est pas terminé en 2 minutes et a été arrêté. Réessayez pour voir ce qu’il a fait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git non è terminato entro 2 minuti ed è stato interrotto. Riprova per vedere cosa ha fatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "git が 2 分以内に終了しなかったため停止しました。再試行して結果を確認してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git មិនបានបញ្ចប់ក្នុងរយៈពេល 2 នាទី ហើយត្រូវបានបញ្ឈប់។ សូមព្យាយាមម្ដងទៀតដើម្បីមើលអ្វីដែលវាបានធ្វើ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git이 2분 안에 완료되지 않아 중지되었습니다. 다시 시도하여 수행된 작업을 확인하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git ble ikke ferdig innen 2 minutter og ble stoppet. Prøv igjen for å se hva det gjorde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git nie zakończył działania w ciągu 2 minut i został zatrzymany. Ponów, aby zobaczyć, co zrobił."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O git não terminou em 2 minutos e foi interrompido. Tente novamente para ver o que ele fez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git не завершился за 2 минуты и был остановлен. Повторите, чтобы узнать, что он сделал."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git ไม่เสร็จภายใน 2 นาทีและถูกหยุด ลองอีกครั้งเพื่อดูว่า git ทำอะไรไปแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git 2 dakika içinde bitmediği için durduruldu. Ne yaptığını görmek için yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git не завершився за 2 хвилини й був зупинений. Повторіть, щоб побачити, що він зробив."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
