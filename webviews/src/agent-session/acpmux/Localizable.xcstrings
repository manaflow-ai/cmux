    "picker.accountSecretHint": {"comment":"Local account route form in the model picker. Reference syntax remains literal.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Use keychain:NAME, env:VARIABLE or file:/absolute/path. Paste no API key here."}},"ar":{"stringUnit":{"state":"translated","value":"استخدم keychain:NAME أو env:VARIABLE أو file:/absolute/path. لا تلصق مفتاح API هنا."}},"bs":{"stringUnit":{"state":"translated","value":"Koristite keychain:NAME, env:VARIABLE ili file:/absolute/path. Ovdje nemojte lijepiti API ključ."}},"da":{"stringUnit":{"state":"translated","value":"Brug keychain:NAME, env:VARIABLE eller file:/absolute/path. Indsæt ikke en API-nøgle her."}},"de":{"stringUnit":{"state":"translated","value":"Verwende keychain:NAME, env:VARIABLE oder file:/absolute/path. Füge hier keinen API-Schlüssel ein."}},"es":{"stringUnit":{"state":"translated","value":"Usa keychain:NAME, env:VARIABLE o file:/absolute/path. No pegues una clave API aquí."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisez keychain:NAME, env:VARIABLE ou file:/absolute/path. Ne collez pas de clé API ici."}},"it":{"stringUnit":{"state":"translated","value":"Usa keychain:NAME, env:VARIABLE o file:/absolute/path. Non incollare qui una chiave API."}},"ja":{"stringUnit":{"state":"translated","value":"keychain:NAME、env:VARIABLE、または file:/absolute/path を使用してください。ここにAPIキーを貼り付けないでください。"}},"km":{"stringUnit":{"state":"translated","value":"ប្រើ keychain:NAME, env:VARIABLE ឬ file:/absolute/path។ កុំបិទភ្ជាប់សោ API នៅទីនេះ។"}},"ko":{"stringUnit":{"state":"translated","value":"keychain:NAME, env:VARIABLE 또는 file:/absolute/path를 사용하세요. 여기에 API 키를 붙여넣지 마세요."}},"nb":{"stringUnit":{"state":"translated","value":"Bruk keychain:NAME, env:VARIABLE eller file:/absolute/path. Ikke lim inn en API-nøkkel her."}},"pl":{"stringUnit":{"state":"translated","value":"Użyj keychain:NAME, env:VARIABLE lub file:/absolute/path. Nie wklejaj tutaj klucza API."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Use keychain:NAME, env:VARIABLE ou file:/absolute/path. Não cole uma chave de API aqui."}},"ru":{"stringUnit":{"state":"translated","value":"Используйте keychain:NAME, env:VARIABLE или file:/absolute/path. Не вставляйте здесь ключ API."}},"th":{"stringUnit":{"state":"translated","value":"ใช้ keychain:NAME, env:VARIABLE หรือ file:/absolute/path อย่าวางคีย์ API ที่นี่"}},"tr":{"stringUnit":{"state":"translated","value":"keychain:NAME, env:VARIABLE veya file:/absolute/path kullanın. Buraya API anahtarı yapıştırmayın."}},"uk":{"stringUnit":{"state":"translated","value":"Використовуйте keychain:NAME, env:VARIABLE або file:/absolute/path. Не вставляйте тут ключ API."}},"vi":{"stringUnit":{"state":"translated","value":"Dùng keychain:NAME, env:VARIABLE hoặc file:/absolute/path. Không dán khóa API vào đây."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用 keychain:NAME、env:VARIABLE 或 file:/absolute/path。请勿在此粘贴 API 密钥。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"使用 keychain:NAME、env:VARIABLE 或 file:/absolute/path。請勿在此貼上 API 金鑰。"}}}},
    "messageRun.sent.one": {"comment":"Agent pane transcript: a phrase of a folded run line that carries messages between agents, e.g. \"Sent a message, ran 2 commands\" (conversation/messageRuns.ts); lower case, the line capitalizes its first phrase","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"needs_review","value":"أرسل رسالة"}},"bs":{"stringUnit":{"state":"needs_review","value":"poslao poruku"}},"da":{"stringUnit":{"state":"needs_review","value":"sendte en besked"}},"de":{"stringUnit":{"state":"needs_review","value":"eine Nachricht gesendet"}},"en":{"stringUnit":{"state":"translated","value":"sent a message"}},"es":{"stringUnit":{"state":"needs_review","value":"envió un mensaje"}},"fr":{"stringUnit":{"state":"needs_review","value":"a envoyé un message"}},"it":{"stringUnit":{"state":"needs_review","value":"ha inviato un messaggio"}},"ja":{"stringUnit":{"state":"needs_review","value":"メッセージを送信"}},"km":{"stringUnit":{"state":"needs_review","value":"បានផ្ញើសារមួយ"}},"ko":{"stringUnit":{"state":"needs_review","value":"메시지 전송"}},"nb":{"stringUnit":{"state":"needs_review","value":"sendte en melding"}},"pl":{"stringUnit":{"state":"needs_review","value":"wysłano wiadomość"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"enviou uma mensagem"}},"ru":{"stringUnit":{"state":"needs_review","value":"отправлено сообщение"}},"th":{"stringUnit":{"state":"needs_review","value":"ส่งข้อความ"}},"tr":{"stringUnit":{"state":"needs_review","value":"bir mesaj gönderdi"}},"uk":{"stringUnit":{"state":"needs_review","value":"надіслано повідомлення"}},"vi":{"stringUnit":{"state":"needs_review","value":"đã gửi một tin nhắn"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"发送了消息"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"傳送了訊息"}}}},
    "messageRun.sent.other": {"comment":"Agent pane transcript: a phrase of a folded run line that carries messages between agents; {n} is how many messages this agent sent (conversation/messageRuns.ts)","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"needs_review","value":"أرسل {n} رسائل"}},"bs":{"stringUnit":{"state":"needs_review","value":"poslano poruka: {n}"}},"da":{"stringUnit":{"state":"needs_review","value":"sendte {n} beskeder"}},"de":{"stringUnit":{"state":"needs_review","value":"{n} Nachrichten gesendet"}},"en":{"stringUnit":{"state":"translated","value":"sent {n} messages"}},"es":{"stringUnit":{"state":"needs_review","value":"envió {n} mensajes"}},"fr":{"stringUnit":{"state":"needs_review","value":"a envoyé {n} messages"}},"it":{"stringUnit":{"state":"needs_review","value":"ha inviato {n} messaggi"}},"ja":{"stringUnit":{"state":"needs_review","value":"{n} 件のメッセージを送信"}},"km":{"stringUnit":{"state":"needs_review","value":"បានផ្ញើសារ {n}"}},"ko":{"stringUnit":{"state":"needs_review","value":"메시지 {n}개 전송"}},"nb":{"stringUnit":{"state":"needs_review","value":"sendte {n} meldinger"}},"pl":{"stringUnit":{"state":"needs_review","value":"wysłano wiadomości: {n}"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"enviou {n} mensagens"}},"ru":{"stringUnit":{"state":"needs_review","value":"отправлено сообщений: {n}"}},"th":{"stringUnit":{"state":"needs_review","value":"ส่ง {n} ข้อความ"}},"tr":{"stringUnit":{"state":"needs_review","value":"{n} mesaj gönderdi"}},"uk":{"stringUnit":{"state":"needs_review","value":"надіслано повідомлень: {n}"}},"vi":{"stringUnit":{"state":"needs_review","value":"đã gửi {n} tin nhắn"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"发送了 {n} 条消息"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"傳送了 {n} 則訊息"}}}},
