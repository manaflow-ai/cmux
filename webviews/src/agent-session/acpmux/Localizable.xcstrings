    "transport.personRequired": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يمكن الموافقة على هذا إلا من تطبيق cmux. وافق عليه في cmux على جهاز Mac الذي يشغّل هذه المحادثة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovo se može odobriti samo u aplikaciji cmux. Odobrite to u cmuxu na Macu na kojem radi ovaj chat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kun cmux-appen kan godkende dette. Godkend det i cmux på den Mac, der kører denne chat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nur die cmux-App kann das genehmigen. Genehmige es in cmux auf dem Mac, auf dem dieser Chat läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the cmux app can approve this. Approve it in cmux on the Mac that runs this chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
