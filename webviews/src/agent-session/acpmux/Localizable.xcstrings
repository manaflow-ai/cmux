    "multiplayer.viewing": {"comment":"Agent pane: accessibility label of the faces in a shared chat's header; {names} lists the other people who have the chat open","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"needs_review","value":"موجود أيضًا: {names}"}},"bs":{"stringUnit":{"state":"needs_review","value":"Također ovdje: {names}"}},"da":{"stringUnit":{"state":"needs_review","value":"Også her: {names}"}},"de":{"stringUnit":{"state":"needs_review","value":"Auch hier: {names}"}},"en":{"stringUnit":{"state":"translated","value":"Also here: {names}"}},"es":{"stringUnit":{"state":"needs_review","value":"También aquí: {names}"}},"fr":{"stringUnit":{"state":"needs_review","value":"Aussi ici : {names}"}},"it":{"stringUnit":{"state":"needs_review","value":"Anche qui: {names}"}},"ja":{"stringUnit":{"state":"needs_review","value":"ほかに参加中: {names}"}},"km":{"stringUnit":{"state":"needs_review","value":"នៅទីនេះផងដែរ: {names}"}},"ko":{"stringUnit":{"state":"needs_review","value":"함께 보는 중: {names}"}},"nb":{"stringUnit":{"state":"needs_review","value":"Også her: {names}"}},"pl":{"stringUnit":{"state":"needs_review","value":"Również tutaj: {names}"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Também aqui: {names}"}},"ru":{"stringUnit":{"state":"needs_review","value":"Также здесь: {names}"}},"th":{"stringUnit":{"state":"needs_review","value":"อยู่ที่นี่ด้วย: {names}"}},"tr":{"stringUnit":{"state":"needs_review","value":"Burada ayrıca: {names}"}},"uk":{"stringUnit":{"state":"needs_review","value":"Також тут: {names}"}},"vi":{"stringUnit":{"state":"needs_review","value":"Cũng đang xem: {names}"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"也在这里：{names}"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"也在這裡：{names}"}}}},
    "multiplayer.more": {"comment":"Agent pane: after the faces in a shared chat's header, how many more people have it open; {count} is a number","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"needs_review","value":"+{count}"}},"bs":{"stringUnit":{"state":"needs_review","value":"+{count}"}},"da":{"stringUnit":{"state":"needs_review","value":"+{count}"}},"de":{"stringUnit":{"state":"needs_review","value":"+{count}"}},"en":{"stringUnit":{"state":"translated","value":"+{count}"}},"es":{"stringUnit":{"state":"needs_review","value":"+{count}"}},"fr":{"stringUnit":{"state":"needs_review","value":"+{count}"}},"it":{"stringUnit":{"state":"needs_review","value":"+{count}"}},"ja":{"stringUnit":{"state":"needs_review","value":"+{count}"}},"km":{"stringUnit":{"state":"needs_review","value":"+{count}"}},"ko":{"stringUnit":{"state":"needs_review","value":"+{count}"}},"nb":{"stringUnit":{"state":"needs_review","value":"+{count}"}},"pl":{"stringUnit":{"state":"needs_review","value":"+{count}"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"+{count}"}},"ru":{"stringUnit":{"state":"needs_review","value":"+{count}"}},"th":{"stringUnit":{"state":"needs_review","value":"+{count}"}},"tr":{"stringUnit":{"state":"needs_review","value":"+{count}"}},"uk":{"stringUnit":{"state":"needs_review","value":"+{count}"}},"vi":{"stringUnit":{"state":"needs_review","value":"+{count}"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"+{count}"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"+{count}"}}}},
    "multiplayer.typing.one": {"comment":"Agent pane: over the composer while another person in a shared chat types; {name} is that person","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"needs_review","value":"{name} يكتب…"}},"bs":{"stringUnit":{"state":"needs_review","value":"{name} piše…"}},"da":{"stringUnit":{"state":"needs_review","value":"{name} skriver…"}},"de":{"stringUnit":{"state":"needs_review","value":"{name} schreibt…"}},"en":{"stringUnit":{"state":"translated","value":"{name} is typing…"}},"es":{"stringUnit":{"state":"needs_review","value":"{name} está escribiendo…"}},"fr":{"stringUnit":{"state":"needs_review","value":"{name} écrit…"}},"it":{"stringUnit":{"state":"needs_review","value":"{name} sta scrivendo…"}},"ja":{"stringUnit":{"state":"needs_review","value":"{name} が入力中…"}},"km":{"stringUnit":{"state":"needs_review","value":"{name} កំពុងវាយ…"}},"ko":{"stringUnit":{"state":"needs_review","value":"{name} 님이 입력 중…"}},"nb":{"stringUnit":{"state":"needs_review","value":"{name} skriver…"}},"pl":{"stringUnit":{"state":"needs_review","value":"{name} pisze…"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"{name} está digitando…"}},"ru":{"stringUnit":{"state":"needs_review","value":"{name} печатает…"}},"th":{"stringUnit":{"state":"needs_review","value":"{name} กำลังพิมพ์…"}},"tr":{"stringUnit":{"state":"needs_review","value":"{name} yazıyor…"}},"uk":{"stringUnit":{"state":"needs_review","value":"{name} друкує…"}},"vi":{"stringUnit":{"state":"needs_review","value":"{name} đang nhập…"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"{name} 正在输入…"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"{name} 正在輸入…"}}}},
    "multiplayer.typing.two": {"comment":"Agent pane: over the composer while two other people in a shared chat type; {first} and {second} are their names","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"needs_review","value":"{first} و{second} يكتبان…"}},"bs":{"stringUnit":{"state":"needs_review","value":"{first} i {second} pišu…"}},"da":{"stringUnit":{"state":"needs_review","value":"{first} og {second} skriver…"}},"de":{"stringUnit":{"state":"needs_review","value":"{first} und {second} schreiben…"}},"en":{"stringUnit":{"state":"translated","value":"{first} and {second} are typing…"}},"es":{"stringUnit":{"state":"needs_review","value":"{first} y {second} están escribiendo…"}},"fr":{"stringUnit":{"state":"needs_review","value":"{first} et {second} écrivent…"}},"it":{"stringUnit":{"state":"needs_review","value":"{first} e {second} stanno scrivendo…"}},"ja":{"stringUnit":{"state":"needs_review","value":"{first} と {second} が入力中…"}},"km":{"stringUnit":{"state":"needs_review","value":"{first} និង {second} កំពុងវាយ…"}},"ko":{"stringUnit":{"state":"needs_review","value":"{first} 님과 {second} 님이 입력 중…"}},"nb":{"stringUnit":{"state":"needs_review","value":"{first} og {second} skriver…"}},"pl":{"stringUnit":{"state":"needs_review","value":"{first} i {second} piszą…"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"{first} e {second} estão digitando…"}},"ru":{"stringUnit":{"state":"needs_review","value":"{first} и {second} печатают…"}},"th":{"stringUnit":{"state":"needs_review","value":"{first} และ {second} กำลังพิมพ์…"}},"tr":{"stringUnit":{"state":"needs_review","value":"{first} ve {second} yazıyor…"}},"uk":{"stringUnit":{"state":"needs_review","value":"{first} і {second} друкують…"}},"vi":{"stringUnit":{"state":"needs_review","value":"{first} và {second} đang nhập…"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"{first} 和 {second} 正在输入…"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"{first} 和 {second} 正在輸入…"}}}},
    "multiplayer.typing.many": {"comment":"Agent pane: over the composer while three or more other people in a shared chat type","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"needs_review","value":"عدة أشخاص يكتبون…"}},"bs":{"stringUnit":{"state":"needs_review","value":"Nekoliko osoba piše…"}},"da":{"stringUnit":{"state":"needs_review","value":"Flere skriver…"}},"de":{"stringUnit":{"state":"needs_review","value":"Mehrere Personen schreiben…"}},"en":{"stringUnit":{"state":"translated","value":"Several people are typing…"}},"es":{"stringUnit":{"state":"needs_review","value":"Varias personas están escribiendo…"}},"fr":{"stringUnit":{"state":"needs_review","value":"Plusieurs personnes écrivent…"}},"it":{"stringUnit":{"state":"needs_review","value":"Più persone stanno scrivendo…"}},"ja":{"stringUnit":{"state":"needs_review","value":"複数の人が入力中…"}},"km":{"stringUnit":{"state":"needs_review","value":"មនុស្សច្រើននាក់កំពុងវាយ…"}},"ko":{"stringUnit":{"state":"needs_review","value":"여러 명이 입력 중…"}},"nb":{"stringUnit":{"state":"needs_review","value":"Flere skriver…"}},"pl":{"stringUnit":{"state":"needs_review","value":"Kilka osób pisze…"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Várias pessoas estão digitando…"}},"ru":{"stringUnit":{"state":"needs_review","value":"Несколько человек печатают…"}},"th":{"stringUnit":{"state":"needs_review","value":"หลายคนกำลังพิมพ์…"}},"tr":{"stringUnit":{"state":"needs_review","value":"Birkaç kişi yazıyor…"}},"uk":{"stringUnit":{"state":"needs_review","value":"Кілька людей друкують…"}},"vi":{"stringUnit":{"state":"needs_review","value":"Nhiều người đang nhập…"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"多人正在输入…"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"多人正在輸入…"}}}},
    "multiplayer.answeredBy": {"comment":"Agent pane: after a permission receipt in a shared chat, who answered the ask; {name} is that person","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"needs_review","value":"أجاب {name}"}},"bs":{"stringUnit":{"state":"needs_review","value":"Odgovorio/la {name}"}},"da":{"stringUnit":{"state":"needs_review","value":"Besvaret af {name}"}},"de":{"stringUnit":{"state":"needs_review","value":"Beantwortet von {name}"}},"en":{"stringUnit":{"state":"translated","value":"Answered by {name}"}},"es":{"stringUnit":{"state":"needs_review","value":"Respondido por {name}"}},"fr":{"stringUnit":{"state":"needs_review","value":"Répondu par {name}"}},"it":{"stringUnit":{"state":"needs_review","value":"Risposto da {name}"}},"ja":{"stringUnit":{"state":"needs_review","value":"{name} が回答"}},"km":{"stringUnit":{"state":"needs_review","value":"ឆ្លើយដោយ {name}"}},"ko":{"stringUnit":{"state":"needs_review","value":"{name} 님이 응답함"}},"nb":{"stringUnit":{"state":"needs_review","value":"Besvart av {name}"}},"pl":{"stringUnit":{"state":"needs_review","value":"Odpowiedź: {name}"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Respondido por {name}"}},"ru":{"stringUnit":{"state":"needs_review","value":"Ответ: {name}"}},"th":{"stringUnit":{"state":"needs_review","value":"ตอบโดย {name}"}},"tr":{"stringUnit":{"state":"needs_review","value":"{name} yanıtladı"}},"uk":{"stringUnit":{"state":"needs_review","value":"Відповідь: {name}"}},"vi":{"stringUnit":{"state":"needs_review","value":"{name} đã trả lời"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"由 {name} 回答"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"由 {name} 回答"}}}},
    "composer.playVideo": {"comment":"Agent pane: the accessible label of an attached video's thumbnail in the composer or a sent message; a click plays it in Quick Look. {name} is the file name, {length} its length, like 0:42","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"needs_review","value":"تشغيل {name}، {length}"}},"bs":{"stringUnit":{"state":"needs_review","value":"Reproduciraj {name}, {length}"}},"da":{"stringUnit":{"state":"needs_review","value":"Afspil {name}, {length}"}},"de":{"stringUnit":{"state":"needs_review","value":"{name} abspielen, {length}"}},"en":{"stringUnit":{"state":"translated","value":"Play {name}, {length}"}},"es":{"stringUnit":{"state":"needs_review","value":"Reproducir {name}, {length}"}},"fr":{"stringUnit":{"state":"needs_review","value":"Lire {name}, {length}"}},"it":{"stringUnit":{"state":"needs_review","value":"Riproduci {name}, {length}"}},"ja":{"stringUnit":{"state":"needs_review","value":"{name}を再生、{length}"}},"km":{"stringUnit":{"state":"needs_review","value":"ចាក់ {name} {length}"}},"ko":{"stringUnit":{"state":"needs_review","value":"{name} 재생, {length}"}},"nb":{"stringUnit":{"state":"needs_review","value":"Spill av {name}, {length}"}},"pl":{"stringUnit":{"state":"needs_review","value":"Odtwórz {name}, {length}"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Reproduzir {name}, {length}"}},"ru":{"stringUnit":{"state":"needs_review","value":"Воспроизвести {name}, {length}"}},"th":{"stringUnit":{"state":"needs_review","value":"เล่น {name} {length}"}},"tr":{"stringUnit":{"state":"needs_review","value":"{name} oynat, {length}"}},"uk":{"stringUnit":{"state":"needs_review","value":"Відтворити {name}, {length}"}},"vi":{"stringUnit":{"state":"needs_review","value":"Phát {name}, {length}"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"播放 {name}，{length}"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"播放 {name}，{length}"}}}},
    "peerCopy.offline.title": {"comment":"Agent pane: a banner over a chat whose machine is offline; {machine} is a machine name such as huge-blue","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"{machine} is offline. This is the copy this Mac kept, and it may be out of date."}},"ar":{"stringUnit":{"state":"needs_review","value":"{machine} غير متصل. هذه هي النسخة التي احتفظ بها هذا الـMac، وقد تكون قديمة."}},"bs":{"stringUnit":{"state":"needs_review","value":"{machine} nije povezan. Ovo je kopija koju je ovaj Mac sačuvao i možda nije ažurna."}},"da":{"stringUnit":{"state":"needs_review","value":"{machine} er offline. Dette er kopien, som denne Mac har gemt, og den er måske ikke opdateret."}},"de":{"stringUnit":{"state":"needs_review","value":"{machine} ist offline. Dies ist die Kopie, die dieser Mac gespeichert hat; sie ist möglicherweise veraltet."}},"es":{"stringUnit":{"state":"needs_review","value":"{machine} está sin conexión. Esta es la copia que guardó este Mac y puede estar desactualizada."}},"fr":{"stringUnit":{"state":"needs_review","value":"{machine} est hors ligne. Ceci est la copie conservée par ce Mac ; elle n'est peut-être pas à jour."}},"it":{"stringUnit":{"state":"needs_review","value":"{machine} è offline. Questa è la copia salvata da questo Mac e potrebbe non essere aggiornata."}},"ja":{"stringUnit":{"state":"needs_review","value":"{machine} はオフラインです。これはこの Mac が保存したコピーで、最新ではない可能性があります。"}},"km":{"stringUnit":{"state":"needs_review","value":"{machine} មិនមានអ៊ីនធឺណិត។ នេះជាច្បាប់ចម្លងដែល Mac នេះបានរក្សាទុក ហើយប្រហែលជាមិនទាន់សម័យ។"}},"ko":{"stringUnit":{"state":"needs_review","value":"{machine}이(가) 오프라인입니다. 이 Mac에 저장된 사본이며 최신이 아닐 수 있습니다."}},"nb":{"stringUnit":{"state":"needs_review","value":"{machine} er frakoblet. Dette er kopien denne Macen har lagret, og den kan være utdatert."}},"pl":{"stringUnit":{"state":"needs_review","value":"{machine} jest offline. To kopia zapisana na tym Macu i może być nieaktualna."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"{machine} está offline. Esta é a cópia que este Mac guardou e pode estar desatualizada."}},"ru":{"stringUnit":{"state":"needs_review","value":"{machine} не в сети. Это копия, сохранённая на этом Mac, и она может быть устаревшей."}},"th":{"stringUnit":{"state":"needs_review","value":"{machine} ออฟไลน์อยู่ นี่คือสำเนาที่ Mac เครื่องนี้เก็บไว้ และอาจไม่เป็นปัจจุบัน"}},"tr":{"stringUnit":{"state":"needs_review","value":"{machine} çevrimdışı. Bu, bu Mac'in sakladığı kopyadır ve güncel olmayabilir."}},"uk":{"stringUnit":{"state":"needs_review","value":"{machine} не в мережі. Це копія, збережена на цьому Mac, і вона може бути застарілою."}},"vi":{"stringUnit":{"state":"needs_review","value":"{machine} đang ngoại tuyến. Đây là bản sao máy Mac này đã lưu và có thể chưa cập nhật."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"{machine} 已离线。这是此 Mac 保存的副本，可能不是最新的。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"{machine} 已離線。這是此 Mac 保存的副本，可能不是最新的。"}}}},
    "peerCopy.offline.savedAt": {"comment":"Agent pane: under the offline-machine banner; {time} is a relative time such as 5 minutes ago","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Last updated {time}. The chat catches up once it connects."}},"ar":{"stringUnit":{"state":"needs_review","value":"آخر تحديث {time}. ستُحدَّث الدردشة بمجرد اتصاله."}},"bs":{"stringUnit":{"state":"needs_review","value":"Posljednje ažurirano {time}. Chat se ažurira čim se poveže."}},"da":{"stringUnit":{"state":"needs_review","value":"Sidst opdateret {time}. Chatten opdateres, når den har forbindelse."}},"de":{"stringUnit":{"state":"needs_review","value":"Zuletzt aktualisiert {time}. Der Chat holt auf, sobald er verbunden ist."}},"es":{"stringUnit":{"state":"needs_review","value":"Actualizado por última vez {time}. El chat se pondrá al día cuando se conecte."}},"fr":{"stringUnit":{"state":"needs_review","value":"Dernière mise à jour {time}. La discussion se mettra à jour dès sa connexion."}},"it":{"stringUnit":{"state":"needs_review","value":"Ultimo aggiornamento {time}. La chat si aggiorna appena si connette."}},"ja":{"stringUnit":{"state":"needs_review","value":"最終更新: {time}。接続されるとチャットが更新されます。"}},"km":{"stringUnit":{"state":"needs_review","value":"បានធ្វើបច្ចុប្បន្នភាពចុងក្រោយ {time}។ ការជជែកនឹងធ្វើបច្ចុប្បន្នភាព នៅពេលវាភ្ជាប់។"}},"ko":{"stringUnit":{"state":"needs_review","value":"마지막 업데이트 {time}. 연결되면 채팅이 최신 상태로 갱신됩니다."}},"nb":{"stringUnit":{"state":"needs_review","value":"Sist oppdatert {time}. Chatten oppdateres når den kobler til."}},"pl":{"stringUnit":{"state":"needs_review","value":"Ostatnia aktualizacja {time}. Czat nadrobi zaległości po połączeniu."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Atualizado pela última vez {time}. O chat se atualiza quando ele se conectar."}},"ru":{"stringUnit":{"state":"needs_review","value":"Последнее обновление {time}. Чат догонит, как только появится связь."}},"th":{"stringUnit":{"state":"needs_review","value":"อัปเดตล่าสุด {time} แชตจะอัปเดตเมื่อเชื่อมต่อแล้ว"}},"tr":{"stringUnit":{"state":"needs_review","value":"Son güncelleme {time}. Bağlandığında sohbet güncellenir."}},"uk":{"stringUnit":{"state":"needs_review","value":"Останнє оновлення {time}. Чат оновиться, щойно з'явиться зв'язок."}},"vi":{"stringUnit":{"state":"needs_review","value":"Cập nhật lần cuối {time}. Cuộc trò chuyện sẽ cập nhật khi kết nối."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"上次更新于 {time}。连接后聊天会自动同步。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"上次更新於 {time}。連線後聊天會自動同步。"}}}},
    "peerCopy.offline.saved": {"comment":"Agent pane: under the offline-machine banner when the copy's time is unknown","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The chat catches up once it connects."}},"ar":{"stringUnit":{"state":"needs_review","value":"ستُحدَّث الدردشة بمجرد اتصاله."}},"bs":{"stringUnit":{"state":"needs_review","value":"Chat se ažurira čim se poveže."}},"da":{"stringUnit":{"state":"needs_review","value":"Chatten opdateres, når den har forbindelse."}},"de":{"stringUnit":{"state":"needs_review","value":"Der Chat holt auf, sobald er verbunden ist."}},"es":{"stringUnit":{"state":"needs_review","value":"El chat se pondrá al día cuando se conecte."}},"fr":{"stringUnit":{"state":"needs_review","value":"La discussion se mettra à jour dès sa connexion."}},"it":{"stringUnit":{"state":"needs_review","value":"La chat si aggiorna appena si connette."}},"ja":{"stringUnit":{"state":"needs_review","value":"接続されるとチャットが更新されます。"}},"km":{"stringUnit":{"state":"needs_review","value":"ការជជែកនឹងធ្វើបច្ចុប្បន្នភាព នៅពេលវាភ្ជាប់។"}},"ko":{"stringUnit":{"state":"needs_review","value":"연결되면 채팅이 최신 상태로 갱신됩니다."}},"nb":{"stringUnit":{"state":"needs_review","value":"Chatten oppdateres når den kobler til."}},"pl":{"stringUnit":{"state":"needs_review","value":"Czat nadrobi zaległości po połączeniu."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O chat se atualiza quando ele se conectar."}},"ru":{"stringUnit":{"state":"needs_review","value":"Чат догонит, как только появится связь."}},"th":{"stringUnit":{"state":"needs_review","value":"แชตจะอัปเดตเมื่อเชื่อมต่อแล้ว"}},"tr":{"stringUnit":{"state":"needs_review","value":"Bağlandığında sohbet güncellenir."}},"uk":{"stringUnit":{"state":"needs_review","value":"Чат оновиться, щойно з'явиться зв'язок."}},"vi":{"stringUnit":{"state":"needs_review","value":"Cuộc trò chuyện sẽ cập nhật khi kết nối."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"连接后聊天会自动同步。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"連線後聊天會自動同步。"}}}},
    "peerCopy.paused.title": {"comment":"Agent pane: a banner over a chat whose Cloud machine is paused; {machine} is a machine name such as dev-vm-2","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"{machine} is paused. This is the copy this Mac kept."}},"ar":{"stringUnit":{"state":"needs_review","value":"{machine} متوقف مؤقتًا. هذه هي النسخة التي احتفظ بها هذا الـMac."}},"bs":{"stringUnit":{"state":"needs_review","value":"{machine} je pauziran. Ovo je kopija koju je ovaj Mac sačuvao."}},"da":{"stringUnit":{"state":"needs_review","value":"{machine} er sat på pause. Dette er kopien, som denne Mac har gemt."}},"de":{"stringUnit":{"state":"needs_review","value":"{machine} ist pausiert. Dies ist die Kopie, die dieser Mac gespeichert hat."}},"es":{"stringUnit":{"state":"needs_review","value":"{machine} está en pausa. Esta es la copia que guardó este Mac."}},"fr":{"stringUnit":{"state":"needs_review","value":"{machine} est en pause. Ceci est la copie conservée par ce Mac."}},"it":{"stringUnit":{"state":"needs_review","value":"{machine} è in pausa. Questa è la copia salvata da questo Mac."}},"ja":{"stringUnit":{"state":"needs_review","value":"{machine} は一時停止中です。これはこの Mac が保存したコピーです。"}},"km":{"stringUnit":{"state":"needs_review","value":"{machine} ត្រូវបានផ្អាក។ នេះជាច្បាប់ចម្លងដែល Mac នេះបានរក្សាទុក។"}},"ko":{"stringUnit":{"state":"needs_review","value":"{machine}이(가) 일시 정지되었습니다. 이 Mac에 저장된 사본입니다."}},"nb":{"stringUnit":{"state":"needs_review","value":"{machine} er satt på pause. Dette er kopien denne Macen har lagret."}},"pl":{"stringUnit":{"state":"needs_review","value":"{machine} jest wstrzymana. To kopia zapisana na tym Macu."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"{machine} está pausada. Esta é a cópia que este Mac guardou."}},"ru":{"stringUnit":{"state":"needs_review","value":"{machine} приостановлена. Это копия, сохранённая на этом Mac."}},"th":{"stringUnit":{"state":"needs_review","value":"{machine} หยุดชั่วคราวอยู่ นี่คือสำเนาที่ Mac เครื่องนี้เก็บไว้"}},"tr":{"stringUnit":{"state":"needs_review","value":"{machine} duraklatıldı. Bu, bu Mac'in sakladığı kopyadır."}},"uk":{"stringUnit":{"state":"needs_review","value":"{machine} призупинено. Це копія, збережена на цьому Mac."}},"vi":{"stringUnit":{"state":"needs_review","value":"{machine} đang tạm dừng. Đây là bản sao máy Mac này đã lưu."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"{machine} 已暂停。这是此 Mac 保存的副本。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"{machine} 已暫停。這是此 Mac 保存的副本。"}}}},
    "peerCopy.paused.resume": {"comment":"Agent pane: the button on the paused-machine banner that starts the machine again","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Resume"}},"ar":{"stringUnit":{"state":"needs_review","value":"استئناف"}},"bs":{"stringUnit":{"state":"needs_review","value":"Nastavi"}},"da":{"stringUnit":{"state":"needs_review","value":"Genoptag"}},"de":{"stringUnit":{"state":"needs_review","value":"Fortsetzen"}},"es":{"stringUnit":{"state":"needs_review","value":"Reanudar"}},"fr":{"stringUnit":{"state":"needs_review","value":"Reprendre"}},"it":{"stringUnit":{"state":"needs_review","value":"Riprendi"}},"ja":{"stringUnit":{"state":"needs_review","value":"再開"}},"km":{"stringUnit":{"state":"needs_review","value":"បន្ត"}},"ko":{"stringUnit":{"state":"needs_review","value":"재개"}},"nb":{"stringUnit":{"state":"needs_review","value":"Gjenoppta"}},"pl":{"stringUnit":{"state":"needs_review","value":"Wznów"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Retomar"}},"ru":{"stringUnit":{"state":"needs_review","value":"Возобновить"}},"th":{"stringUnit":{"state":"needs_review","value":"ทำต่อ"}},"tr":{"stringUnit":{"state":"needs_review","value":"Sürdür"}},"uk":{"stringUnit":{"state":"needs_review","value":"Відновити"}},"vi":{"stringUnit":{"state":"needs_review","value":"Tiếp tục"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"恢复"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"恢復"}}}},
