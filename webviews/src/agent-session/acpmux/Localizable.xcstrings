        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 턴의 체크포인트에서 일부 파일이 누락되었습니다. 에이전트의 편집 내용을 표시합니다."
          }
        },
        "nb": {
          "stringUnit": {
