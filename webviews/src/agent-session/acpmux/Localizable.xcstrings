        "km": { "stringUnit": { "state": "translated", "value": "ភ្នាក់ងារមិនត្រូវបានដំឡើងលើម៉ាស៊ីននេះទេ។" } },
        "ko": { "stringUnit": { "state": "translated", "value": "이 머신에 에이전트가 설치되어 있지 않습니다." } },
        "nb": { "stringUnit": { "state": "translated", "value": "Agenten er ikke installert på denne maskinen." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Agent nie jest zainstalowany na tej maszynie." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "O agente não está instalado nesta máquina." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Агент не установлен на этой машине." } },
        "th": { "stringUnit": { "state": "translated", "value": "ไม่ได้ติดตั้งเอเจนต์บนเครื่องนี้" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Ajan bu makinede yüklü değil." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Агента не встановлено на цій машині." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Tác tử chưa được cài trên máy này." } },
