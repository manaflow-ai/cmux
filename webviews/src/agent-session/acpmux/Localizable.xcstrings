    "retry.running": {"comment":"Agent pane: short note after a failed subagent's or sub-session's line when acpmux refused a retry because it already runs again (subagents/SubagentDoneLine.tsx)","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Already running again"}},"ar":{"stringUnit":{"state":"needs_review","value":"يعمل مرة أخرى بالفعل"}},"bs":{"stringUnit":{"state":"needs_review","value":"Već ponovo radi"}},"da":{"stringUnit":{"state":"needs_review","value":"Kører allerede igen"}},"de":{"stringUnit":{"state":"needs_review","value":"Läuft bereits wieder"}},"es":{"stringUnit":{"state":"needs_review","value":"Ya se está ejecutando de nuevo"}},"fr":{"stringUnit":{"state":"needs_review","value":"Déjà relancé"}},"it":{"stringUnit":{"state":"needs_review","value":"Già di nuovo in esecuzione"}},"ja":{"stringUnit":{"state":"needs_review","value":"すでに再実行中です"}},"km":{"stringUnit":{"state":"needs_review","value":"កំពុងដំណើរការម្តងទៀតរួចហើយ"}},"ko":{"stringUnit":{"state":"needs_review","value":"이미 다시 실행 중"}},"nb":{"stringUnit":{"state":"needs_review","value":"Kjører allerede igjen"}},"pl":{"stringUnit":{"state":"needs_review","value":"Już działa ponownie"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Já está em execução novamente"}},"ru":{"stringUnit":{"state":"needs_review","value":"Уже снова выполняется"}},"th":{"stringUnit":{"state":"needs_review","value":"กำลังทำงานอีกครั้งแล้ว"}},"tr":{"stringUnit":{"state":"needs_review","value":"Zaten yeniden çalışıyor"}},"uk":{"stringUnit":{"state":"needs_review","value":"Уже знову виконується"}},"vi":{"stringUnit":{"state":"needs_review","value":"Đã chạy lại rồi"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"已在重新运行"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"已在重新執行"}}}},
    "retry.gone": {"comment":"Agent pane: short note after a failed subagent's or sub-session's line when acpmux can no longer retry it (the chat closed or stopped, or the subagent resumed, was replaced, ended or is unknown) (subagents/SubagentDoneLine.tsx)","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Can no longer be retried"}},"ar":{"stringUnit":{"state":"needs_review","value":"لم يعد من الممكن إعادة المحاولة"}},"bs":{"stringUnit":{"state":"needs_review","value":"Više se ne može ponoviti"}},"da":{"stringUnit":{"state":"needs_review","value":"Kan ikke længere prøves igen"}},"de":{"stringUnit":{"state":"needs_review","value":"Kann nicht mehr wiederholt werden"}},"es":{"stringUnit":{"state":"needs_review","value":"Ya no se puede reintentar"}},"fr":{"stringUnit":{"state":"needs_review","value":"Ne peut plus être réessayé"}},"it":{"stringUnit":{"state":"needs_review","value":"Non è più possibile riprovare"}},"ja":{"stringUnit":{"state":"needs_review","value":"再試行できなくなりました"}},"km":{"stringUnit":{"state":"needs_review","value":"មិនអាចព្យាយាមម្តងទៀតបានទៀតទេ"}},"ko":{"stringUnit":{"state":"needs_review","value":"더 이상 재시도할 수 없음"}},"nb":{"stringUnit":{"state":"needs_review","value":"Kan ikke lenger prøves igjen"}},"pl":{"stringUnit":{"state":"needs_review","value":"Nie można już ponowić"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Não é mais possível tentar novamente"}},"ru":{"stringUnit":{"state":"needs_review","value":"Повторить больше нельзя"}},"th":{"stringUnit":{"state":"needs_review","value":"ลองใหม่ไม่ได้อีกแล้ว"}},"tr":{"stringUnit":{"state":"needs_review","value":"Artık yeniden denenemez"}},"uk":{"stringUnit":{"state":"needs_review","value":"Більше не можна повторити"}},"vi":{"stringUnit":{"state":"needs_review","value":"Không thể thử lại nữa"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"已无法重试"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"已無法重試"}}}},
    "retry.resumed": {"comment":"Agent pane: quiet marker after the daemon automatically resumes this chat. {attempt} is its retry attempt number, not a duration.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Automatically resumed (attempt {attempt})"}},"ar":{"stringUnit":{"state":"translated","value":"تم الاستئناف تلقائيًا (المحاولة {attempt})"}},"bs":{"stringUnit":{"state":"translated","value":"Automatski nastavljeno (pokušaj {attempt})"}},"da":{"stringUnit":{"state":"translated","value":"Genoptaget automatisk (forsøg {attempt})"}},"de":{"stringUnit":{"state":"translated","value":"Automatisch fortgesetzt (Versuch {attempt})"}},"es":{"stringUnit":{"state":"translated","value":"Reanudado automáticamente (intento {attempt})"}},"fr":{"stringUnit":{"state":"translated","value":"Reprise automatique (tentative {attempt})"}},"it":{"stringUnit":{"state":"translated","value":"Ripreso automaticamente (tentativo {attempt})"}},"ja":{"stringUnit":{"state":"translated","value":"自動再開（試行 {attempt}）"}},"km":{"stringUnit":{"state":"translated","value":"បានបន្តដោយស្វ័យប្រវត្តិ (ការព្យាយាម {attempt})"}},"ko":{"stringUnit":{"state":"translated","value":"자동으로 재개됨 (시도 {attempt})"}},"nb":{"stringUnit":{"state":"translated","value":"Gjenopptatt automatisk (forsøk {attempt})"}},"pl":{"stringUnit":{"state":"translated","value":"Wznowiono automatycznie (próba {attempt})"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Retomado automaticamente (tentativa {attempt})"}},"ru":{"stringUnit":{"state":"translated","value":"Автоматически возобновлено (попытка {attempt})"}},"th":{"stringUnit":{"state":"translated","value":"กลับมาทำงานต่อโดยอัตโนมัติ (ครั้งที่ {attempt})"}},"tr":{"stringUnit":{"state":"translated","value":"Otomatik olarak sürdürüldü (deneme {attempt})"}},"uk":{"stringUnit":{"state":"translated","value":"Автоматично відновлено (спроба {attempt})"}},"vi":{"stringUnit":{"state":"translated","value":"Đã tự động tiếp tục (lần thử {attempt})"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已自动继续（第 {attempt} 次尝试）"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已自動繼續（第 {attempt} 次嘗試）"}}}},
    "retry.waiting": {"comment":"Agent pane: a subagent's or sub-session's state while acpmux waits to retry its failed turn (subagents/retryState.ts); {attempt} is this try, {of} how many acpmux makes","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Retrying ({attempt}/{of})"}},"ar":{"stringUnit":{"state":"needs_review","value":"إعادة المحاولة ({attempt}/{of})"}},"bs":{"stringUnit":{"state":"needs_review","value":"Ponovni pokušaj ({attempt}/{of})"}},"da":{"stringUnit":{"state":"needs_review","value":"Prøver igen ({attempt}/{of})"}},"de":{"stringUnit":{"state":"needs_review","value":"Neuer Versuch ({attempt}/{of})"}},"es":{"stringUnit":{"state":"needs_review","value":"Reintentando ({attempt}/{of})"}},"fr":{"stringUnit":{"state":"needs_review","value":"Nouvelle tentative ({attempt}/{of})"}},"it":{"stringUnit":{"state":"needs_review","value":"Nuovo tentativo ({attempt}/{of})"}},"ja":{"stringUnit":{"state":"needs_review","value":"再試行中（{attempt}/{of}）"}},"km":{"stringUnit":{"state":"needs_review","value":"កំពុងព្យាយាមម្តងទៀត ({attempt}/{of})"}},"ko":{"stringUnit":{"state":"needs_review","value":"재시도 중 ({attempt}/{of})"}},"nb":{"stringUnit":{"state":"needs_review","value":"Prøver igjen ({attempt}/{of})"}},"pl":{"stringUnit":{"state":"needs_review","value":"Ponawianie ({attempt}/{of})"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Tentando novamente ({attempt}/{of})"}},"ru":{"stringUnit":{"state":"needs_review","value":"Повторная попытка ({attempt}/{of})"}},"th":{"stringUnit":{"state":"needs_review","value":"กำลังลองใหม่ ({attempt}/{of})"}},"tr":{"stringUnit":{"state":"needs_review","value":"Yeniden deneniyor ({attempt}/{of})"}},"uk":{"stringUnit":{"state":"needs_review","value":"Повторна спроба ({attempt}/{of})"}},"vi":{"stringUnit":{"state":"needs_review","value":"Đang thử lại ({attempt}/{of})"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"正在重试（{attempt}/{of}）"}},"zh-Hant":{"stringUnit":{"state":"need