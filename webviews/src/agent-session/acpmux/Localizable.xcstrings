    "permission.coverage": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "طلبات ACP فقط · العزل غير متحقق منه"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Samo ACP zahtjevi · Izolacija nije provjerena"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kun ACP-anmodninger · Isolering ikke verificeret"
          }
        },
        "de": {
