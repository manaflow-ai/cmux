    "permission.error.wrongGroup": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أعاد رد الإذن مجموعة مختلفة. اقرأ قبل إعادة المحاولة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odgovor na dozvolu je vratio drugu grupu. Pročitajte prije ponovnog pokušaja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tilladelsessvaret returnerede en anden gruppe. Læs, før du prøver igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Berechtigungsantwort hat eine andere Gruppe zurückgegeben. Lies sie vor einem neuen Versuch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The permission answer returned a different group. Read before retrying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La respuesta de permiso devolvió un grupo distinto. Lee antes de reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La réponse d'autorisation a renvoyé un autre groupe. Lisez avant de réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La risposta di autorizzazione ha restituito un gruppo diverso. Leggi prima di riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限回答が別のグループを返しました。再試行する前に結果を取得してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ចម្លើយការអនុញ្ញាតបានបញ្ជូនក្រុមផ្សេង។ សូមអានមុនពេលព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "권한 응답이 다른 그룹을 반환했습니다. 다시 시도하기 전에 읽으세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tillatelsessvaret returnerte en annen gruppe. Les før du prøver igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odpowiedź na żądanie uprawnienia zwróciła inną grupę. Odczytaj przed ponowieniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A resposta de permissão retornou um grupo diferente. Leia antes de tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ответ на запрос разрешения вернул другую группу. Прочитайте перед повтором."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คำตอบเรื่องสิทธิ์ส่งกลุ่มอื่นกลับมา อ่านก่อนลองอีกครั้ง"
