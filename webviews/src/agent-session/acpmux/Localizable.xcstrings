          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Novi fajlovi su se promijenili otkako je lista prikazana. Provjerite listu, pa ponovo commitajte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De nye filer er ændret, siden listen blev vist. Tjek listen, og commit derefter igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die neuen Dateien haben sich seit dem Anzeigen der Liste geändert. Prüfe die Liste und committe dann erneut."
          }
