    "subagents.empty.detail": {
      "comment": "Empty child transcript; no recorded messages or tool calls.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا رسائل هذا الوكيل واستدعاءاته للأدوات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje se prikazuju poruke i pozivi alata ovog agenta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskeder og værktøjskald fra denne agent vises her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten und Werkzeugaufrufe dieses Agenten erscheinen hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages and tool calls from this agent appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes y las llamadas a herramientas de este agente aparecen aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages et les appels d’outils de cet agent apparaissent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui appaiono i messaggi e le chiamate agli strumenti di questo agente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエージェントのメッセージとツール呼び出しがここに表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សារ និងការហៅឧបករណ៍របស់ភ្នាក់ងារនេះបង្ហាញនៅទីនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 에이전트의 메시지와 도구 호출이 여기에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldinger og verktøykall fra denne agenten vises her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj pojawiają się wiadomości i wywołania narzędzi tego agenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens e chamadas de ferramentas deste agente aparecem aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появляются сообщения и вызовы инструментов этого агента."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความและการเรียกใช้เครื่องมือจากเอเจนต์นี้จะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ajanın mesajları ve araç çağrıları burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут з’являються повідомлення та виклики інструментів цього агента."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn và lệnh gọi công cụ từ tác nhân này xuất hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此代理的消息和工具调用会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此代理的訊息和工具呼叫會顯示在這裡。"
          }
        }
      }
    },
