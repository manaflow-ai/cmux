    "checkpoint.error.paused": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أُوقفت إعادة محاولة نقطة الاستعادة مؤقتًا إلى أن تتصل الجلسة المحددة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ponovni pokušaj kontrolne tačke je pauziran dok se odabrana sesija ne poveže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nyt forsøg med checkpoint er sat på pause, indtil den valgte session er forbundet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Checkpoint-Wiederholungsversuch ist pausiert, bis die ausgewählte Sitzung verbunden ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkpoint retry paused until the selected session is connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El reintento de punto de control está en pausa hasta que se conecte la sesión seleccionada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La nouvelle tentative de point de contrôle est suspendue jusqu’à la connexion de la session sélectionnée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il nuovo tentativo del checkpoint è in pausa finché la sessione selezionata non si connette."
