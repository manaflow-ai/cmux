    "git.push.authFailed": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "رفض المستودع البعيد بيانات الاعتماد. تحقق من مفتاح SSH أو مساعد بيانات الاعتماد في الطرفية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Remote je odbio akreditive. Provjerite SSH ključ ili credential helper u terminalu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Remotet afviste loginoplysningerne. Tjek din SSH-nøgle eller credential helper i en terminal."
