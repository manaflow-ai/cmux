    "permission.alwaysScope": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«دائمًا» يسمح أيضًا بطلبات هذه الدردشة اللاحقة حتى تتوقف الدردشة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uvijek dozvoljava i kasnije zahtjeve ovog razgovora dok se razgovor ne zaustavi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Altid tillader også chattens senere anmodninger, indtil chatten stopper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Immer“ erlaubt auch spätere Anfragen in diesem Chat, bis der Chat endet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always also allows this chat's later requests until the chat stops."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Siempre también permite las solicitudes posteriores de este chat hasta que el chat se detenga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toujours autorise aussi les demandes suivantes de ce chat jusqu'à son arrêt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sempre consente anche le richieste successive di questa chat finché la chat non si ferma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「常に許可」は、このチャットが終了するまで以降のリクエストも許可します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ជានិច្ច អនុញ្ញាតសំណើបន្ទាប់ៗក្នុងការជជែកនេះផងដែរ រហូតដល់ការជជែកឈប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "항상 허용은 채팅이 멈출 때까지 이 채팅의 이후 요청도 허용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alltid tillater også senere forespørsler i denne chatten til chatten stopper."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zawsze zezwala też na kolejne żądania w tym czacie, dopóki czat się nie zatrzyma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sempre também permite as próximas solicitações deste chat até que ele pare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Всегда» также разрешает последующие запросы в этом чате, пока чат не остановится."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อนุญาตเสมอจะอนุญาตคำขอต่อ ๆ ไปในแชตนี้ด้วยจนกว่าแชตจะหยุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her zaman, sohbet durana kadar bu sohbetin sonraki isteklerine de izin verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Завжди» також дозволяє наступні запити в цьому чаті, доки чат не зупиниться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Luôn cho phép cũng cho phép các yêu cầu sau này trong cuộc trò chuyện này cho đến khi nó dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“始终允许”也会允许此聊天之后的请求，直到聊天停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「一律允許」也會允許此聊天之後的請求，直到聊天停止。"
          }
        }
      }
    },
