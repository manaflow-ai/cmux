    "composer.slashResume": {"comment":"Agent pane: the slash menu's description of /resume, which opens the chats search (cmuxCommands.ts)","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"استأنف محادثة سابقة"}},"bs":{"stringUnit":{"state":"translated","value":"Nastavite raniji razgovor"}},"da":{"stringUnit":{"state":"translated","value":"Genoptag en tidligere samtale"}},"de":{"stringUnit":{"state":"translated","value":"Einen früheren Chat fortsetzen"}},"en":{"stringUnit":{"state":"translated","value":"Resume an earlier chat"}},"es":{"stringUnit":{"state":"translated","value":"Reanudar un chat anterior"}},"fr":{"stringUnit":{"state":"translated","value":"Reprendre une conversation précédente"}},"it":{"stringUnit":{"state":"translated","value":"Riprendi una chat precedente"}},"ja":{"stringUnit":{"state":"translated","value":"以前のチャットを再開"}},"km":{"stringUnit":{"state":"translated","value":"បន្តការជជែកមុន"}},"ko":{"stringUnit":{"state":"translated","value":"이전 채팅 이어서 하기"}},"nb":{"stringUnit":{"state":"translated","value":"Gjenoppta en tidligere chat"}},"pl":{"stringUnit":{"state":"translated","value":"Wznów wcześniejszy czat"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Retomar um chat anterior"}},"ru":{"stringUnit":{"state":"translated","value":"Продолжить предыдущий чат"}},"th":{"stringUnit":{"state":"translated","value":"แชทก่อนหน้าต่อ"}},"tr":{"stringUnit":{"state":"translated","value":"Önceki bir sohbete devam et"}},"uk":{"stringUnit":{"state":"translated","value":"Продовжити попередній чат"}},"vi":{"stringUnit":{"state":"translated","value":"Tiếp tục một cuộc trò chuyện trước"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"继续之前的聊天"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"繼續之前的聊天"}}}},
    "composer.slashLogin": {"comment":"Agent pane: the slash menu's description of /login, which signs in to the chat's agent in a terminal tab (cmuxCommands.ts)","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"سجّل الدخول إلى وكيل هذه المحادثة"}},"bs":{"stringUnit":{"state":"translated","value":"Prijavite se na agenta ovog razgovora"}},"da":{"stringUnit":{"state":"translated","value":"Log ind på denne samtales agent"}},"de":{"stringUnit":{"state":"translated","value":"Beim Agenten dieses Chats anmelden"}},"en":{"stringUnit":{"state":"translated","value":"Sign in to this chat's agent"}},"es":{"stringUnit":{"state":"translated","value":"Iniciar sesión en el agente de este chat"}},"fr":{"stringUnit":{"state":"translated","value":"Se connecter à l'agent de cette conversation"}},"it":{"stringUnit":{"state":"translated","value":"Accedi all'agente di questa chat"}},"ja":{"stringUnit":{"state":"translated","value":"このチャットのエージェントにサインイン"}},"km":{"stringUnit":{"state":"translated","value":"ចូលទៅភ្នាក់ងាររបស់ការជជែកនេះ"}},"ko":{"stringUnit":{"state":"translated","value":"이 채팅의 에이전트에 로그인"}},"nb":{"stringUnit":{"state":"translated","value":"Logg på agenten i denne chatten"}},"pl":{"stringUnit":{"state":"translated","value":"Zaloguj się do agenta tego czatu"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Entrar no agente deste chat"}},"ru":{"stringUnit":{"state":"translated","value":"Войти в агента этого чата"}},"th":{"stringUnit":{"state":"translated","value":"ลงชื่อเข้าใช้เอเจนต์ของแชทนี้"}},"tr":{"stringUnit":{"state":"translated","value":"Bu sohbetin ajanında oturum aç"}},"uk":{"stringUnit":{"state":"translated","value":"Увійти в агента цього чату"}},"vi":{"stringUnit":{"state":"translated","value":"Đăng nhập vào tác tử của cuộc trò chuyện này"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"登录此聊天的智能体"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"登入此聊天的代理程式"}}}},
    "composer.cmuxLoginElsewhere": {"comment":"Agent pane: /login refused for a chat bound to an account route or running on another host (App.tsx)","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"سجّل الدخول إلى حساب هذه المحادثة من قائمة الحساب، أو من الإعدادات > الوكلاء."}},"bs":{"stringUnit":{"state":"translated","value":"Prijavite se na račun ovog razgovora iz menija Račun ili u Postavke > Agenti."}},"da":{"stringUnit":{"state":"translated","value":"Log ind på denne samtales konto fra dens Konto-menu eller i Indstillinger > Agenter."}},"de":{"stringUnit":{"state":"translated","value":"Melde dich über das Konto-Menü dieses Chats oder unter Einstellungen > Agenten an."}},"en":{"stringUnit":{"state":"translated","value":"Sign in to this chat's account from its Account menu, or in Settings > Agents."}},"es":{"stringUnit":{"state":"translated","value":"Inicia sesión en la cuenta de este chat desde su menú Cuenta o en Ajustes > Agentes."}},"fr":{"stringUnit":{"state":"translated","value":"Connectez-vous au compte de cette conversation depuis son menu Compte, ou dans Réglages > Agents."}},"it":{"stringUnit":{"state":"translated","value":"Accedi all'account di questa chat dal suo menu Account o in Impostazioni > Agenti."}},"ja":{"stringUnit":{"state":"translated","value":"このチャットのアカウントには、アカウントメニューまたは「設定」>「エージェント」からサインインしてください。"}},"km":{"stringUnit":{"state":"translated","value":"ចូលគណនីរបស់ការជជែកនេះពីម៉ឺនុយគណនី ឬក្នុងការកំណត់ > ភ្នាក់ងារ។"}},"ko":{"stringUnit":{"state":"translated","value":"이 채팅의 계정 메뉴 또는 설정 > 에이전트에서 로그인하세요."}},"nb":{"stringUnit":{"state":"translated","value":"Logg på kontoen til denne chatten fra Konto-menyen, eller i Innstillinger > Agenter."}},"pl":{"stringUnit":{"state":"translated","value":"Zaloguj się na konto tego czatu z jego menu Konto lub w Ustawienia > Agenci."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Entre na conta deste chat pelo menu Conta ou em Ajustes > Agentes."}},"ru":{"stringUnit":{"state":"translated","value":"Войдите в аккаунт этого чата через его меню «Аккаунт» или в «Настройки» > «Агенты»."}},"th":{"stringUnit":{"state":"translated","value":"ลงชื่อเข้าใช้บัญชีของแชทนี้จากเมนูบัญชี หรือใน การตั้งค่า > เอเจนต์"}},"tr":{"stringUnit":{"state":"translated","value":"Bu sohbetin hesabında Hesap menüsünden ya da Ayarlar > Ajanlar'dan oturum aç."}},"uk":{"stringUnit":{"state":"translated","value":"Увійдіть в обліковий запис цього чату з його меню «Обліковий запис» або в «Налаштування» > «Агенти»."}},"vi":{"stringUnit":{"state":"translated","value":"Đăng nhập tài khoản của cuộc trò chuyện này từ menu Tài khoản, hoặc trong Cài đặt > Tác tử."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请从此聊天的“账户”菜单或“设置”>“智能体”登录。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請從此聊天的「帳號」選單或「設定」>「代理程式」登入。"}}}},
    "composer.slashImport": {
      "comment": "Agent pane: the slash menu's description of /import (cmuxCommands.ts)",
      "extractionState": "manual",
      "localizations": {
        "ar": {
