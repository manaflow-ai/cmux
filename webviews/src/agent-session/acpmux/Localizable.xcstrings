    "composer.moveToCloudDetail": {
      "comment": "Agent pane: the line under Move to Cloud in a started chat's environment picker: what the move does. It reuses a Cloud machine, or creates one when there is none",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ينسخ هذا المجلد إلى جهاز Cloud، أو جهاز جديد إن لم يكن لديك واحد، ويواصل المحادثة هناك"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kopira ovaj folder na Cloud mašinu, novu ako je nemate, i nastavlja chat tamo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kopierer denne mappe til en Cloud-maskine, en ny hvis du ikke har nogen, og fortsætter chatten der"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kopiert diesen Ordner auf eine Cloud-Maschine, eine neue, wenn du keine hast, und setzt den Chat dort fort"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies this folder to a Cloud machine, a new one if you have none, and continues the chat there"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Copia esta carpeta a una máquina de Cloud, una nueva si no tienes ninguna, y continúa el chat allí"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Copie ce dossier sur une machine Cloud, une nouvelle si vous n'en avez pas, et poursuit la discussion là-bas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Copia questa cartella su una macchina Cloud, una nuova se non ne hai, e continua la chat lì"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このフォルダを Cloud マシン(なければ新しいマシン)にコピーし、そこでチャットを続けます"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ចម្លងថតនេះទៅម៉ាស៊ីន Cloud ឬម៉ាស៊ីនថ្មីប្រសិនបើអ្នកមិនមាន ហើយបន្តការជជែកនៅទីនោះ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 폴더를 Cloud 머신(없으면 새 머신)에 복사하고 그곳에서 채팅을 이어갑니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kopierer denne mappen til en Cloud-maskin, en ny hvis du ikke har noen, og fortsetter chatten der"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kopiuje ten folder na maszynę Cloud, nową, jeśli żadnej nie masz, i kontynuuje tam czat"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Copia esta pasta para uma máquina do Cloud, uma nova se você não tiver nenhuma, e continua o chat lá"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Копирует эту папку на машину Cloud (новую, если у вас её нет) и продолжает чат там"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คัดลอกโฟลเดอร์นี้ไปยังเครื่อง Cloud หรือเครื่องใหม่หากคุณยังไม่มี และทำแชตต่อที่นั่น"
          }
        },
        "tr": {
          "stringUnit": {
