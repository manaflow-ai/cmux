    "error.closedBeforeConnect": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أُغلق الاتصال بالوكيل قبل أن يُفتح."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
