          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 답변은 전달되지 않았습니다. 요청이 다른 곳에서 이미 응답되었거나 철회되었을 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svaret gikk ikke gjennom. Forespørselen kan ha blitt besvart eller trukket tilbake et annet sted."
