    "runBoard.error.attachExpired" : {
      "comment" : "Agent pane run board: error shown when a worker's terminal endpoint expired before attaching",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "انتهت صلاحية نقطة نهاية الطرفية لهذا العامل. اطلب تذكرة إرفاق جديدة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Krajnja tačka terminala ovog radnika je istekla. Zatražite novu kartu za povezivanje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Denne arbejders terminalendepunkt er udløbet. Anmod om en ny tilknytningsbillet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Terminal-Endpunkt dieses Workers ist abgelaufen. Fordere ein neues Verbindungsticket an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This worker terminal endpoint has expired. Request a fresh attach ticket."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El punto de conexión de terminal de este worker ha caducado. Solicita un nuevo ticket de conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le point de terminaison du terminal de ce worker a expiré. Demandez un nouveau ticket de connexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'endpoint del terminale di questo worker è scaduto. Richiedi un nuovo ticket di collegamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このワーカーのターミナルエンドポイントは期限切れです。新しい接続チケットをリクエストしてください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ចំណុចបញ្ចប់ទែមីណាល់របស់ worker នេះបានផុតកំណត់ហើយ។ សូមស្នើសុំសំបុត្រភ្ជាប់ថ្មី។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 워커의 터미널 엔드포인트가 만료되었습니다. 새 연결 티켓을 요청하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Terminalendepunktet til denne arbeideren har utløpt. Be om en ny tilkoblingsbillett."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Punkt końcowy terminala tego workera wygasł. Poproś o nowy bilet połączenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O endpoint de terminal deste worker expirou. Solicite um novo tíquete de conexão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Срок действия точки подключения терминала этого воркера истёк. Запросите новый билет подключения."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ปลายทางเทอร์มินัลของ worker นี้หมดอายุแล้ว โปรดขอตั๋วเชื่อมต่อใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bu çalışanın terminal uç noktasının süresi doldu. Yeni bir bağlanma bileti isteyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Термін дії точки підключення термінала цього воркера минув. Запросіть новий квиток підключення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Điểm cuối terminal của worker này đã hết hạn. Hãy yêu cầu vé kết nối mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此工作器的终端端点已过期。请申请新的连接票据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此工作器的終端機端點已過期。請申請新的連線票證。"
          }
        }
      }
    },
