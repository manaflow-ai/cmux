    "harnesses.enableUnavailable": {
      "comment": "Agent pane: Enable harness when acpmux gave no prompt (cx-nt39g)",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على cmux الوصول إلى acpmux لتفعيل هذه الأداة. حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nije mogao doći do acpmux da omogući ovaj harness. Pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux kunne ikke nå acpmux for at aktivere denne harness. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux konnte acpmux nicht erreichen, um diesen Harness zu aktivieren. Versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux couldn't reach acpmux to enable this harness. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no pudo conectar con acpmux para activar este harness. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux n’a pas pu joindre acpmux pour activer ce harness. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux non è riuscito a raggiungere acpmux per attivare questo harness. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux が acpmux に接続できず、このハーネスを有効にできませんでした。もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux មិនអាចភ្ជាប់ទៅ acpmux ដើម្បីបើក harness នេះបានទេ។ សូមព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 acpmux에 연결하지 못해 이 하네스를 활성화할 수 없습니다. 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux fikk ikke kontakt med acpmux for å aktivere denne harnessen. Prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nie mógł połączyć się z acpmux, aby włączyć ten harness. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux não conseguiu acessar o acpmux para ativar este harness. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux не удалось связаться с acpmux, чтобы включить этот harness. Повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ติดต่อ acpmux เพื่อเปิดใช้ harness นี้ไม่ได้ โปรดลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux, bu harness'ı etkinleştirmek için acpmux'a ulaşamadı. Yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux не вдалося зв’язатися з acpmux, щоб увімкнути цей harness. Спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux không thể kết nối acpmux để bật harness này. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 无法连接 acpmux 来启用此 harness。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 無法連線 acpmux 來啟用此 harness。請再試一次。"
          }
        }
      }
    },
    "harnesses.stillCannotRun": {
      "comment": "Agent pane: the Harnesses page (cx-apoko)",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
