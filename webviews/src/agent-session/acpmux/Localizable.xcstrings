    "dictation.recordingOtherChat": {
      "comment": "Agent pane: notice when a dictation recording finished after the pane moved to another chat; it is not attached to the chat now shown",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
