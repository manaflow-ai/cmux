    "picker.planHint": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "وضع التخطيط يقرأ ويقترح دون تعديل؛ ووضع البناء يُجري التغييرات"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plan čita i predlaže bez uređivanja; Izgradnja unosi promjene"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plan læser og foreslår uden at redigere; Byg foretager ændringerne"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Plan“ liest und schlägt vor, ohne zu bearbeiten; „Umsetzen“ nimmt die Änderungen vor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan reads and proposes without editing; Build makes the changes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Plan» lee y propone sin editar; «Construir» hace los cambios"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "« Plan » lit et propose sans modifier ; « Construire » effectue les modifications"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Piano» legge e propone senza modificare; «Costruisci» apporta le modifiche"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「プラン」は編集せずに読み取って提案し、「ビルド」は変更を加えます"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផែនការអាន និងផ្តល់យោបល់ដោយមិនកែសម្រួល; បង្កើតធ្វើការផ្លាស់ប្តូរ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "계획은 편집 없이 읽고 제안만 하며, 빌드는 변경 사항을 적용합니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plan leser og foreslår uten å redigere; Bygg gjør endringene"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plan czyta i proponuje bez edycji; Budowa wprowadza zmiany"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Planejar lê e propõe sem editar; Construir faz as alterações"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«План» читает и предлагает без правок; «Сборка» вносит изменения"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "วางแผนจะอ่านและเสนอแนวทางโดยไม่แก้ไข ส่วนสร้างจะทำการเปลี่ยนแปลงจริง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plan, düzenlemeden okur ve önerir; Yap, değişiklikleri uygular"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«План» читає й пропонує без редагування; «Збірка» вносить зміни"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lập kế hoạch chỉ đọc và đề xuất, không chỉnh sửa; Xây dựng sẽ thực hiện thay đổi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“规划”只读取和提出方案，不做编辑；“构建”会实际进行更改"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「規劃」只會讀取並提出方案，不會編輯；「建置」會實際進行變更"
          }
        }
      }
    },
