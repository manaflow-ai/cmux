    "error.closedBeforeConnect": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أُغلق الاتصال بالوكيل قبل أن يُفتح."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Veza s agentom zatvorena je prije otvaranja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agentforbindelsen blev lukket, før den åbnede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Verbindung zum Agent wurde geschlossen, bevor sie geöffnet war."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent connection closed before it opened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La conexión con el agente se cerró antes de abrirse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La connexion à l’agent s’est fermée avant son ouverture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La connessione all’agente si è chiusa prima di aprirsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "エージェントとの接続が開く前に閉じられました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការតភ្ជាប់ទៅភ្នាក់ងារបានបិទមុនពេលបើក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트 연결이 열리기 전에 닫혔습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agenttilkoblingen ble lukket før den åpnet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Połączenie z agentem zostało zamknięte, zanim zostało otwarte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A conexão com o agente foi fechada antes de abrir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Соединение с агентом закрылось до открытия."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การเชื่อมต่อกับเอเจนต์ปิดลงก่อนจะเปิดสำเร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajan bağlantısı açılmadan önce kapandı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "З’єднання з агентом закрилося до відкриття."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kết nối với tác tử đã đóng trước khi mở được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
