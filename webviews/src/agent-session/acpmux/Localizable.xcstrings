    "adopt.live.notice": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا تزال هذه الدردشة مفتوحة في عملية أخرى. استئنافها هنا أيضًا سيشغّل وكيلين على محادثة واحدة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovaj chat je i dalje otvoren u drugom procesu. Ako ga nastaviš i ovdje, dva agenta će raditi na jednom razgovoru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne chat er stadig åben i en anden proces. Hvis du også genoptager den her, kører to agenter på én samtale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Chat ist noch in einem anderen Prozess geöffnet. Setzt du ihn auch hier fort, laufen zwei Agenten auf einer Unterhaltung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This chat is still open in another process. Resuming it here too would run two agents on one conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este chat sigue abierto en otro proceso. Si también lo reanudas aquí, dos agentes trabajarán en una misma conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce chat est encore ouvert dans un autre processus. Le reprendre ici aussi ferait tourner deux agents sur une même conversation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questa chat è ancora aperta in un altro processo. Riprenderla anche qui farebbe lavorare due agenti sulla stessa conversazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このチャットは別のプロセスでまだ開いています。ここでも再開すると、1つの会話で2つのエージェントが動きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការជជែកនេះនៅតែបើកក្នុងដំណើរការផ្សេងទៀត។ ការបន្តវានៅទីនេះផងដែរ នឹងធ្វើឱ្យភ្នាក់ងារពីរដំណើរការលើការសន្ទនាតែមួយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 채팅은 아직 다른 프로세스에서 열려 있습니다. 여기서도 다시 시작하면 한 대화에서 에이전트 두 개가 실행됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne chatten er fortsatt åpen i en annen prosess. Hvis du også gjenopptar den her, kjører to agenter på én samtale."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten czat jest nadal otwarty w innym procesie. Wznowienie go także tutaj uruchomi dwóch agentów w jednej rozmowie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este chat ainda está aberto em outro processo. Retomá-lo aqui também colocaria dois agentes na mesma conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот чат ещё открыт в другом процессе. Если продолжить его и здесь, в одном разговоре будут работать два агента."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แชทนี้ยังเปิดอยู่ในโปรเซสอื่น หากกลับมาทำต่อที่นี่ด้วย จะมีเอเจนต์สองตัวทำงานในบทสนทนาเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu sohbet hâlâ başka bir işlemde açık. Burada da sürdürmek tek bir konuşmada iki ajan çalıştırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цей чат ще відкритий в іншому процесі. Якщо продовжити його й тут, в одній розмові працюватимуть два агенти."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cuộc trò chuyện này vẫn đang mở trong một tiến trình khác. Tiếp tục nó ở đây nữa sẽ chạy hai tác nhân trên cùng một cuộc trò chuyện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此聊天仍在另一个进程中打开。在这里也继续它，会让两个代理同时处理同一段对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此聊天仍在另一個程序中開啟。在這裡也繼續它，會讓兩個代理同時處理同一段對話。"
          }
        }
      }
    },
