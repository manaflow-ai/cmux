    "status.copyAll":{"comment":"Agent pane: Session status card action that copies all rows as plain label-value lines.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Copy all"}},"ar":{"stringUnit":{"state":"needs_review","value":"نسخ الكل"}},"bs":{"stringUnit":{"state":"needs_review","value":"Kopiraj sve"}},"da":{"stringUnit":{"state":"needs_review","value":"Kopiér alt"}},"de":{"stringUnit":{"state":"needs_review","value":"Alles kopieren"}},"es":{"stringUnit":{"state":"needs_review","value":"Copiar todo"}},"fr":{"stringUnit":{"state":"needs_review","value":"Tout copier"}},"it":{"stringUnit":{"state":"needs_review","value":"Copia tutto"}},"ja":{"stringUnit":{"state":"needs_review","value":"すべてコピー"}},"km":{"stringUnit":{"state":"needs_review","value":"ចម្លងទាំងអស់"}},"ko":{"stringUnit":{"state":"needs_review","value":"모두 복사"}},"nb":{"stringUnit":{"state":"needs_review","value":"Kopier alt"}},"pl":{"stringUnit":{"state":"needs_review","value":"Kopiuj wszystko"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Copiar tudo"}},"ru":{"stringUnit":{"state":"needs_review","value":"Копировать всё"}},"th":{"stringUnit":{"state":"needs_review","value":"คัดลอกทั้งหมด"}},"tr":{"stringUnit":{"state":"needs_review","value":"Tümünü kopyala"}},"uk":{"stringUnit":{"state":"needs_review","value":"Копіювати все"}},"vi":{"stringUnit":{"state":"needs_review","value":"Sao chép tất cả"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"复制全部"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"複製全部"}}}},
    "turn.failure.cloudAuthExpired": {
      "comment": "Agent pane: Cloud provider auth failure with an expired or revoked credential; do not reveal machine host.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "{harness}’s provider credential has expired or been revoked on this Cloud machine. Set it up again to continue." } },
        "ar": { "stringUnit": { "state": "translated", "value": "انتهت صلاحية بيانات اعتماد مزوّد {harness} أو أُبطلت على جهاز Cloud هذا. أعد إعدادها للمتابعة." } },
        "bs": { "stringUnit": { "state": "translated", "value": "Vjerodajnice provajdera {harness} na ovom Cloud računaru su istekle ili opozvane. Ponovo ih postavite." } },
        "da": { "stringUnit": { "state": "translated", "value": "Udbyderlegitimationsoplysningerne for {harness} på denne Cloud-maskine er udløbet eller tilbagekaldt. Konfigurer dem igen." } },
        "de": { "stringUnit": { "state": "translated", "value": "Die Anmeldedaten für {harness} auf diesem Cloud-Computer sind abgelaufen oder wurden widerrufen. Richte sie erneut ein." } },
        "es": { "stringUnit": { "state": "translated", "value": "Las credenciales del proveedor para {harness} en esta máquina de Cloud han caducado o se han revocado. Configúralas de nuevo." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Les identifiants fournisseur de {harness} sur cette machine Cloud ont expiré ou ont été révoqués. Configurez-les à nouveau." } },
        "it": { "stringUnit": { "state": "translated", "value": "Le credenziali del provider per {harness} su questa macchina Cloud sono scadute o revocate. Configurale di nuovo." } },
        "ja": { "stringUnit": { "state": "translated", "value": "この Cloud マシンの {harness} のプロバイダー認証情報は期限切れまたは取り消されています。再設定してください。" } },
        "km": { "stringUnit": { "state": "translated", "value": "ព័ត៌មានសម្គាល់អ្នកផ្តល់សេវាសម្រាប់ {harness} នៅលើម៉ាស៊ីន Cloud នេះបានផុតកំណត់ ឬត្រូវបានដកហូត។ សូមរៀបចំវាម្តងទៀត។" } },
        "ko": { "stringUnit": { "state": "translated", "value": "이 Cloud 머신의 {harness} 제공업체 자격 증명이 만료되었거나 취소되었습니다. 다시 설정하세요." } },
        "nb": { "stringUnit": { "state": "translated", "value": "Leverandørlegitimasjonen for {harness} på denne Cloud-maskinen har utløpt eller blitt tilbakekalt. Konfigurer den på nytt." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Dane logowania dostawcy dla {harness} na tej maszynie Cloud wygasły lub zostały unieważnione. Skonfiguruj je ponownie." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "As credenciais do provedor para {harness} nesta máquina Cloud expiraram ou foram revogadas. Configure-as novamente." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Учётные данные провайдера для {harness} на этой машине Cloud истекли или отозваны. Настройте их заново." } },
        "th": { "stringUnit": { "state": "translated", "value": "ข้อมูลรับรองผู้ให้บริการสำหรับ {harness} บนเครื่อง Cloud นี้หมดอายุหรือถูกเพิกถอนแล้ว ตั้งค่าใหม่อีกครั้ง" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Bu Cloud makinesindeki {harness} sağlayıcı kimlik bilgileri süresi dolmuş veya iptal edilmiş. Yeniden kurun." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Термін дії облікових даних провайдера для {harness} на цій хмарній машині минув або їх відкликано. Налаштуйте їх знову." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Thông tin xác thực của nhà cung cấp cho {harness} trên máy Cloud này đã hết hạn hoặc bị thu hồi. Hãy thiết lập lại." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "这台 Cloud 机器上的 {harness} 提供商凭据已过期或被撤销。请重新设置。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "這台 Cloud 機器上的 {harness} 提供者憑證已過期或遭撤銷。請重新設定。" } }
      }
    },
    "turn.failure.cloudAuthMissing": {
      "comment": "Agent pane: Cloud provider auth failure with no credential present; do not reveal machine host.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This Cloud machine has no provider credential for {harness}. Set it up to continue." } },
        "ar": { "stringUnit": { "state": "translated", "value": "لا توجد بيانات اعتماد لمزوّد {harness} على جهاز Cloud هذا. أعد إعداد بيانات الاعتماد للمتابعة." } },
        "bs": { "stringUnit": { "state": "translated", "value": "Na ovom Cloud računaru nema vjerodajnica za provajdera {harness}. Postavite ih da nastavite." } },
        "da": { "stringUnit": { "state": "translated", "value": "Der er ingen udbyderlegitimationsoplysninger for {harness} på denne Cloud-maskine. Konfigurer dem for at fortsætte." } },
        "de": { "stringUnit": { "state": "translated", "value": "Auf diesem Cloud-Computer sind keine Anmeldedaten für {harness} vorhanden. Richte sie ein, um fortzufahren." } },
        "es": { "stringUnit": { "state": "translated", "value": "No hay credenciales del proveedor para {harness} en esta máquina de Cloud. Configúralas para continuar." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Aucun identifiant fournisseur pour {harness} n’est présent sur cette machine Cloud. Configurez-les pour continuer." } },
        "it": { "stringUnit": { "state": "translated", "value": "Su questa macchina Cloud non sono presenti credenziali del provider per {harness}. Configurale per continuare." } },
        "ja": { "stringUnit": { "state": "translated", "value": "この Cloud マシンに {harness} のプロバイダー認証情報がありません。続行するには設定してください。" } },
        "km": { "stringUnit": { "state": "translated", "value": "មិនមានព័ត៌មានសម្គាល់អ្នកផ្តល់សេវាសម្រាប់ {harness} នៅលើម៉ាស៊ីន Cloud នេះទេ។ សូមរៀបចំវាដើម្បីបន្ត។" } },
        "ko": { "stringUnit": { "state": "translated", "value": "이 Cloud 머신에 {harness} 제공업체 자격 증명이 없습니다. 계속하려면 설정하세요." } },
        "nb": { "stringUnit": { "state": "translated", "value": "Det finnes ingen leverandørlegitimasjon for {harness} på denne Cloud-maskinen. Konfigurer den for å fortsette." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Na tej maszynie Cloud nie ma danych logowania dostawcy dla {harness}. Skonfiguruj je, aby kontynuować." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Não há credenciais do provedor para {harness} nesta máquina Cloud. Configure-as para continuar." } },
        "ru": { "stringUnit": { "state": "translated", "value": "На этой машине Cloud нет учётных данных провайдера для {harness}. Настройте их, чтобы продолжить." } },
        "th": { "stringUnit": { "state": "translated", "value": "ไม่มีข้อมูลรับรองผู้ให้บริการสำหรับ {harness} บนเครื่อง Cloud นี้ ตั้งค่าเพื่อดำเนินการต่อ" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Bu Cloud makinesinde {harness} sağlayıcısına ait kimlik bilgileri yok. Devam etmek için kurun." } },
        "uk": { "stringUnit": { "state": "translated", "value": "На цій хмарній машині немає облікових даних провайдера для {harness}. Налаштуйте їх, щоб продовжити." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Máy Cloud này chưa có thông tin xác thực của nhà cung cấp cho {harness}. Hãy thiết lập để tiếp tục." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "这台 Cloud 机器上没有 {harness} 的提供商凭据。请设置凭据以继续。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "這台 Cloud 機器上沒有 {harness} 的提供者憑證。請設定憑證以繼續。" } }
      }
    },
    "turn.failure.cloudAuthRejected": {
      "comment": "Agent pane: Cloud provider rejected credentials; status is optional. Never include raw output or host.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The provider rejected {harness}’s credentials on this Cloud machine{status}. Set them up again to continue." } },
        "ar": { "stringUnit": { "state": "translated", "value": "رفض المزوّد بيانات اعتماد {harness} على جهاز Cloud هذا{status}. أعد إعدادها للمتابعة." } },
        "bs": { "stringUnit": { "state": "translated", "value": "Provajder je odbio vjerodajnice za {harness} na ovom Cloud računaru{status}. Ponovo ih postavite." } },
        "da": { "stringUnit": { "state": "translated", "value": "Udbyderen afviste legitimationsoplysningerne for {harness} på denne Cloud-maskine{status}. Konfigurer dem igen." } },
        "de": { "stringUnit": { "state": "translated", "value": "Der Anbieter hat die Anmeldedaten für {harness} auf diesem Cloud-Computer abgelehnt{status}. Richte sie erneut ein." } },
        "es": { "stringUnit": { "state": "translated", "value": "El proveedor rechazó las credenciales de {harness} en esta máquina de Cloud{status}. Configúralas de nuevo." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Le fournisseur a refusé les identifiants de {harness} sur cette machine Cloud{status}. Configurez-les à nouveau." } },
        "it": { "stringUnit": { "state": "translated", "value": "Il provider ha rifiutato le credenziali di {harness} su questa macchina Cloud{status}. Configurale di nuovo." } },
        "ja": { "stringUnit": { "state": "translated", "value": "この Cloud マシンでプロバイダーが {harness} の認証情報を拒否しました{status}。再設定してください。" } },
        "km": { "stringUnit": { "state": "translated", "value": "អ្នកផ្តល់សេវាបានបដិសេធព័ត៌មានសម្គាល់របស់ {harness} នៅលើម៉ាស៊ីន Cloud នេះ{status}។ សូមរៀបចំវាម្តងទៀត។" } },
        "ko": { "stringUnit": { "state": "translated", "value": "이 Cloud 머신에서 제공업체가 {harness} 자격 증명을 거부했습니다{status}. 다시 설정하세요." } },
        "nb": { "stringUnit": { "state": "translated", "value": "Leverandøren avviste legitimasjonen for {harness} på denne Cloud-maskinen{status}. Konfigurer den på nytt." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Dostawca odrzucił dane logowania {harness} na tej maszynie Cloud{status}. Skonfiguruj je ponownie." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "O provedor rejeitou as credenciais de {harness} nesta máquina Cloud{status}. Configure-as novamente." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Провайдер отклонил учётные данные {harness} на этой машине Cloud{status}. Настройте их заново." } },
        "th": { "stringUnit": { "state": "translated", "value": "ผู้ให้บริการปฏิเสธข้อมูลรับรองของ {harness} บนเครื่อง Cloud นี้{status} ตั้งค่าใหม่อีกครั้ง" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Sağlayıcı bu Cloud makinesinde {harness} kimlik bilgilerini reddetti{status}. Yeniden kurun." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Провайдер відхилив облікові дані {harness} на цій хмарній машині{status}. Налаштуйте їх знову." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Nhà cung cấp đã từ chối thông tin xác thực của {harness} trên máy Cloud này{status}. Hãy thiết lập lại." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "提供商在这台 Cloud 机器上拒绝了 {harness} 的凭据{status}。请重新设置。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "提供者在這台 Cloud 機器上拒絕了 {harness} 的憑證{status}。請重新設定。" } }
      }
    },
    "turn.failure.cloudTeamMachineNoLogin": {
      "comment": "Agent pane: a Claude sign-in failure on a team Cloud machine, where cmux passes no personal login. harness is the agent name. Never include raw output or host.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "{harness} on this team Cloud machine has no sign-in it can use. cmux doesn’t pass personal logins to shared team machines." } },
        "ar": { "stringUnit": { "state": "translated", "value": "لا يملك {harness} على جهاز Cloud الخاص بالفريق هذا أي تسجيل دخول يمكنه استخدامه. لا ينقل cmux تسجيلات الدخول الشخصية إلى أجهزة الفريق المشتركة." } },
        "bs": { "stringUnit": { "state": "translated", "value": "{harness} na ovom timskom Cloud računaru nema prijavu koju može koristiti. cmux ne prenosi lične prijave na dijeljene timske računare." } },
        "da": { "stringUnit": { "state": "translated", "value": "{harness} på denne team-Cloud-maskine har intet login, den kan bruge. cmux overfører ikke personlige logins til delte team-maskiner." } },
        "de": { "stringUnit": { "state": "translated", "value": "{harness} auf diesem Team-Cloud-Computer hat keine nutzbare Anmeldung. cmux überträgt keine persönlichen Anmeldungen auf gemeinsam genutzte Team-Computer." } },
        "es": { "stringUnit": { "state": "translated", "value": "{harness} en esta máquina de Cloud del equipo no tiene un inicio de sesión que pueda usar. cmux no pasa inicios de sesión personales a máquinas compartidas del equipo." } },
        "fr": { "stringUnit": { "state": "translated", "value": "{harness} sur cette machine Cloud d’équipe n’a aucune connexion utilisable. cmux ne transmet pas les connexions personnelles aux machines d’équipe partagées." } },
        "it": { "stringUnit": { "state": "translated", "value": "{harness} su questa macchina Cloud del team non ha un accesso utilizzabile. cmux non trasferisce gli accessi personali alle macchine condivise del team." } },
        "ja": { "stringUnit": { "state": "translated", "value": "このチームの Cloud マシンの {harness} には使えるサインインがありません。cmux は個人のログインを共有チームマシンに渡しません。" } },
        "km": { "stringUnit": { "state": "translated", "value": "{harness} នៅលើម៉ាស៊ីន Cloud របស់ក្រុមនេះ មិនមានការចូលគណនីដែលវាអាចប្រើបានទេ។ cmux មិនបញ្ជូនការចូលគណនីផ្ទាល់ខ្លួនទៅម៉ាស៊ីនក្រុមដែលចែករំលែកទេ។" } },
        "ko": { "stringUnit": { "state": "translated", "value": "이 팀 Cloud 머신의 {harness}에는 사용할 수 있는 로그인이 없습니다. cmux는 개인 로그인을 공유 팀 머신에 전달하지 않습니다." } },
        "nb": { "stringUnit": { "state": "translated", "value": "{harness} på denne team-Cloud-maskinen har ingen innlogging den kan bruke. cmux overfører ikke personlige innlogginger til delte team-maskiner." } },
        "pl": { "stringUnit": { "state": "translated", "value": "{harness} na tej zespołowej maszynie Cloud nie ma logowania, którego mógłby użyć. cmux nie przekazuje osobistych logowań na współdzielone maszyny zespołu." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "{harness} nesta máquina Cloud da equipe não tem um login que possa usar. O cmux não passa logins pessoais para máquinas compartilhadas da equipe." } },
        "ru": { "stringUnit": { "state": "translated", "value": "У {harness} на этой командной машине Cloud нет входа, который можно использовать. cmux не передаёт личные входы на общие машины команды." } },
        "th": { "stringUnit": { "state": "translated", "value": "{harness} บนเครื่อง Cloud ของทีมนี้ไม่มีการลงชื่อเข้าใช้ที่ใช้ได้ cmux ไม่ส่งการเข้าสู่ระบบส่วนตัวไปยังเครื่องที่ทีมใช้ร่วมกัน" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Bu ekip Cloud makinesindeki {harness} için kullanılabilir bir oturum yok. cmux kişisel oturumları paylaşılan ekip makinelerine aktarmaz." } },
        "uk": { "stringUnit": { "state": "translated", "value": "У {harness} на цій командній хмарній машині немає входу, який можна використати. cmux не передає особисті входи на спільні машини команди." } },
        "vi": { "stringUnit": { "state": "translated", "value": "{harness} trên máy Cloud của nhóm này không có thông tin đăng nhập nào dùng được. cmux không chuyển thông tin đăng nhập cá nhân sang máy dùng chung của nhóm." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "这台团队 Cloud 机器上的 {harness} 没有可用的登录。cmux 不会把个人登录传给共享的团队机器。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "這台團隊 Cloud 機器上的 {harness} 沒有可用的登入。cmux 不會把個人登入傳給共用的團隊機器。" } }
      }
    },
