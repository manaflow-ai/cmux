    "computerUse.preview.close": {"comment":"Agent pane: accessibility label of the live preview card's close button, which hides the card for that session (computerUse/ComputerUsePreviewCard.tsx)","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"needs_review","value":"إخفاء المعاينة"}},"bs":{"stringUnit":{"state":"needs_review","value":"Sakrij pregled"}},"da":{"stringUnit":{"state":"needs_review","value":"Skjul forhåndsvisning"}},"de":{"stringUnit":{"state":"needs_review","value":"Vorschau ausblenden"}},"en":{"stringUnit":{"state":"translated","value":"Hide Preview"}},"es":{"stringUnit":{"state":"needs_review","value":"Ocultar vista previa"}},"fr":{"stringUnit":{"state":"needs_review","value":"Masquer l'aperçu"}},"it":{"stringUnit":{"state":"needs_review","value":"Nascondi anteprima"}},"ja":{"stringUnit":{"state":"translated","value":"プレビューを隠す"}},"km":{"stringUnit":{"state":"needs_review","value":"លាក់ការមើលជាមុន"}},"ko":{"stringUnit":{"state":"needs_review","value":"미리보기 숨기기"}},"nb":{"stringUnit":{"state":"needs_review","value":"Skjul forhåndsvisning"}},"pl":{"stringUnit":{"state":"needs_review","value":"Ukryj podgląd"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Ocultar prévia"}},"ru":{"stringUnit":{"state":"needs_review","value":"Скрыть просмотр"}},"th":{"stringUnit":{"state":"needs_review","value":"ซ่อนตัวอย่าง"}},"tr":{"stringUnit":{"state":"needs_review","value":"Önizlemeyi gizle"}},"uk":{"stringUnit":{"state":"needs_review","value":"Сховати перегляд"}},"vi":{"stringUnit":{"state":"needs_review","value":"Ẩn bản xem trước"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"隐藏预览"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"隱藏預覽"}}}},
    "composer.sandboxed": {"comment":"Environment picker: run the first message once on a throwaway Cloud VM (preview)","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Sandboxed"}},"de":{"stringUnit":{"state":"translated","value":"Sandbox"}},"fr":{"stringUnit":{"state":"translated","value":"Isolé"}},"ar":{"stringUnit":{"state":"translated","value":"معزول"}},"es":{"stringUnit":{"state":"translated","value":"Aislado"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"沙箱"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"沙箱"}},"ko":{"stringUnit":{"state":"translated","value":"샌드박스"}},"ja":{"stringUnit":{"state":"translated","value":"サンドボックス"}},"bs":{"stringUnit":{"state":"needs_review","value":"Izolovano"}},"da":{"stringUnit":{"state":"needs_review","value":"Sandkasse"}},"it":{"stringUnit":{"state":"needs_review","value":"Sandbox"}},"km":{"stringUnit":{"state":"needs_review","value":"ប្រអប់ខ្សាច់"}},"nb":{"stringUnit":{"state":"needs_review","value":"Sandkasse"}},"pl":{"stringUnit":{"state":"needs_review","value":"Piaskownica"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Isolado"}},"ru":{"stringUnit":{"state":"needs_review","value":"Песочница"}},"th":{"stringUnit":{"state":"needs_review","value":"แซนด์บ็อกซ์"}},"tr":{"stringUnit":{"state":"needs_review","value":"Korumalı alan"}},"uk":{"stringUnit":{"state":"needs_review","value":"Пісочниця"}},"vi":{"stringUnit":{"state":"needs_review","value":"Hộp cát"}}}},
    "composer.sandboxedDetail": {"comment":"Environment picker: one line under Sandboxed (New Cloud Machine's alternate, preview): what a Sandboxed send does and costs","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Runs this message once on a throwaway Cloud VM, then destroys it. VM time is billed and shown on the receipt."}},"de":{"stringUnit":{"state":"translated","value":"Führt diese Nachricht einmal auf einer Wegwerf-Cloud-VM aus und löscht sie danach. Die VM-Zeit wird berechnet und auf dem Beleg angezeigt."}},"fr":{"stringUnit":{"state":"translated","value":"Exécute ce message une fois sur une VM Cloud jetable, puis la détruit. Le temps de VM est facturé et indiqué sur le reçu."}},"ar":{"stringUnit":{"state":"translated","value":"يشغّل هذه الرسالة مرة واحدة على جهاز Cloud افتراضي مؤقت ثم يحذفه. يُحتسب وقت الجهاز الافتراضي ويظهر في الإيصال."}},"es":{"stringUnit":{"state":"translated","value":"Ejecuta este mensaje una vez en una VM de Cloud desechable y luego la destruye. El tiempo de VM se factura y aparece en el recibo."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"在一次性的 Cloud 虛擬機上執行這則訊息一次，之後將其銷毀。虛擬機時間會計費，並顯示在收據上。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在一次性的 Cloud 虚拟机上运行这条消息一次，之后将其销毁。虚拟机时间会计费，并显示在回执上。"}},"ko":{"stringUnit":{"state":"translated","value":"이 메시지를 일회용 Cloud VM에서 한 번 실행한 뒤 VM을 삭제합니다. VM 시간은 청구되며 영수증에 표시됩니다."}},"ja":{"stringUnit":{"state":"translated","value":"このメッセージを使い捨ての Cloud VM で一度だけ実行し、その後 VM を破棄します。VM の利用時間は課金され、レシートに表示されます。"}},"bs":{"stringUnit":{"state":"needs_review","value":"Pokreće ovu poruku jednom na privremenoj Cloud VM, zatim je uništava. Vrijeme VM-a se naplaćuje i prikazuje na potvrdi."}},"da":{"stringUnit":{"state":"needs_review","value":"Kører denne besked én gang på en engangs-Cloud-VM og sletter den bagefter. VM-tiden faktureres og vises på kvitteringen."}},"it":{"stringUnit":{"state":"needs_review","value":"Esegue questo messaggio una volta su una VM Cloud usa e getta, poi la distrugge. Il tempo della VM viene addebitato e mostrato nella ricevuta."}},"km":{"stringUnit":{"state":"needs_review","value":"ដំណើរការសារនេះម្តងលើ Cloud VM ប្រើតែម្តង រួចលុបវាចោល។ ពេលវេលា VM ត្រូវគិតថ្លៃ ហើយបង្ហាញនៅលើបង្កាន់ដៃ។"}},"nb":{"stringUnit":{"state":"needs_review","value":"Kjører denne meldingen én gang på en engangs-Cloud-VM og sletter den etterpå. VM-tiden faktureres og vises på kvitteringen."}},"pl":{"stringUnit":{"state":"needs_review","value":"Uruchamia tę wiadomość raz na jednorazowej maszynie wirtualnej Cloud, a potem ją usuwa. Czas maszyny jest naliczany i widoczny na potwierdzeniu."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Executa esta mensagem uma vez em uma VM Cloud descartável e depois a destrói. O tempo de VM é cobrado e aparece no recibo."}},"ru":{"stringUnit":{"state":"needs_review","value":"Выполняет это сообщение один раз на одноразовой Cloud VM, затем удаляет её. Время VM оплачивается и указывается в квитанции."}},"th":{"stringUnit":{"state":"needs_review","value":"รันข้อความนี้หนึ่งครั้งบน Cloud VM แบบใช้แล้วทิ้ง แล้วลบ VM นั้น เวลาของ VM มีค่าใช้จ่ายและแสดงในใบเสร็จ"}},"tr":{"stringUnit":{"state":"needs_review","value":"Bu mesajı tek kullanımlık bir Cloud VM'de bir kez çalıştırır, ardından VM'i yok eder. VM süresi ücretlendirilir ve makbuzda gösterilir."}},"uk":{"stringUnit":{"state":"needs_review","value":"Виконує це повідомлення один раз на одноразовій Cloud VM, потім видаляє її. Час VM оплачується й показується в квитанції."}},"vi":{"stringUnit":{"state":"needs_review","value":"Chạy tin nhắn này một lần trên một Cloud VM dùng một lần, rồi hủy nó. Thời gian VM được tính phí và hiện trên biên nhận."}}}},
    "sandbox.running": {"comment":"Chat: a Sandboxed message is running on its throwaway VM","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Running in a sandbox…"}},"de":{"stringUnit":{"state":"translated","value":"Läuft in einer Sandbox…"}},"fr":{"stringUnit":{"state":"translated","value":"Exécution dans un bac à sable…"}},"ar":{"stringUnit":{"state":"translated","value":"يعمل في صندوق معزول…"}},"es":{"stringUnit":{"state":"translated","value":"Ejecutándose en un sandbox…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在沙箱中執行…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在沙箱中运行…"}},"ko":{"stringUnit":{"state":"translated","value":"샌드박스에서 실행 중…"}},"ja":{"stringUnit":{"state":"translated","value":"サンドボックスで実行中…"}},"bs":{"stringUnit":{"state":"needs_review","value":"Pokreće se u sandboxu…"}},"da":{"stringUnit":{"state":"needs_review","value":"Kører i en sandkasse…"}},"it":{"stringUnit":{"state":"needs_review","value":"In esecuzione in un sandbox…"}},"km":{"stringUnit":{"state":"needs_review","value":"កំពុងដំណើរការក្នុងប្រអប់ខ្សាច់…"}},"nb":{"stringUnit":{"state":"needs_review","value":"Kjører i en sandkasse…"}},"pl":{"stringUnit":{"state":"needs_review","value":"Działa w piaskownicy…"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Executando em um sandbox…"}},"ru":{"stringUnit":{"state":"needs_review","value":"Выполняется в песочнице…"}},"th":{"stringUnit":{"state":"needs_review","value":"กำลังทำงานในแซนด์บ็อกซ์…"}},"tr":{"stringUnit":{"state":"needs_review","value":"Korumalı alanda çalışıyor…"}},"uk":{"stringUnit":{"state":"needs_review","value":"Виконується в пісочниці…"}},"vi":{"stringUnit":{"state":"needs_review","value":"Đang chạy trong hộp cát…"}}}},
