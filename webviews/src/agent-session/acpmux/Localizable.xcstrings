        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo richieste ACP · Isolamento non verificato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ACP リクエストのみ · 隔離は未検証"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សំណើ ACP ប៉ុណ្ណោះ · ភាពឯកោមិនទាន់បានផ្ទៀងផ្ទាត់"
