    "newTab.nowPlaying.hidden": {
      "comment": "Agent pane: one-line note on the New Tab page after the user hid the Now Playing player from its menu; an Undo button follows it.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إخفاء قيد التشغيل الآن. يمكنك إظهاره مجددًا من الإعدادات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sada se reproducira je sakriveno. Možete ga ponovo prikazati u postavkama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspilles nu er skjult. Du kan vise det igen i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Aktuelle Wiedergabe“ ist ausgeblendet. Du kannst sie in den Einstellungen wieder einblenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now Playing is hidden. You can show it again in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduciendo ahora está oculto. Puedes volver a mostrarlo en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l’écoute est masqué. Vous pouvez le réafficher dans les réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In riproduzione è nascosto. Puoi mostrarlo di nuovo nelle impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生中を非表示にしました。設定でもう一度表示できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្វី​ដែល​កំពុង​ចាក់​ត្រូវ​បាន​លាក់។ អ្នក​អាច​បង្ហាញ​វា​ម្តង​ទៀត​ក្នុង​ការកំណត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 재생 중을 가렸습니다. 설정에서 다시 보이게 할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spilles nå er skjult. Du kan vise det igjen i Innstillinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz odtwarzane jest ukryte. Możesz je ponownie pokazać w ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocando Agora está oculto. Você pode mostrá-lo de novo nos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Сейчас играет» скрыто. Его можно снова показать в настройках."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซ่อนกำลังเล่นแล้ว คุณสามารถแสดงอีกครั้งได้ในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi Çalıyor gizlendi. Ayarlar’dan yeniden gösterebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Зараз грає» сховано. Його можна знову показати в налаштуваннях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã ẩn Đang phát. Bạn có thể hiện lại trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“正在播放”已隐藏。你可以在设置中重新显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「正在播放」已隱藏。你可以在設定中重新顯示。"
          }
        }
      }
    },
