    "turn.authExpired": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "انتهت صلاحية تسجيل الدخول. سجّل الدخول مرة أخرى للمتابعة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prijava je istekla. Ponovo se prijavite da nastavite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Din login er udløbet. Log ind igen for at fortsætte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Anmeldung ist abgelaufen. Melde dich erneut an, um fortzufahren."
