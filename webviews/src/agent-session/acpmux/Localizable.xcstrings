        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "아직 모델이 없습니다. 새로 고쳐 에이전트에 다시 요청하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen modeller ennå. Oppdater for å spørre agenten på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brak modeli. Odśwież, aby ponownie zapytać agenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ainda não há modelos. Atualize para perguntar ao agente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Моделей пока нет. Обновите, чтобы снова запросить агента."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
