        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "커밋할 파일이 더 이상 존재하지 않습니다. 새로 고친 후 다시 시도하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En fil som skal committes, finnes ikke lenger. Oppdater og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plik do zatwierdzenia już nie istnieje. Odśwież i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
