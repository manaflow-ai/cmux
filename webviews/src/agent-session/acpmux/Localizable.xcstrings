        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non consentito su questo Mac: l’agente o le impostazioni della tua organizzazione hanno rifiutato questa modalità"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このMacでは使用できません：エージェントまたは組織の設定がこのモードを拒否しました"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនត្រូវបានអនុញ្ញាតនៅលើ Mac នេះទេ៖ ភ្នាក់ងារ ឬការកំណត់របស់ស្ថាប័នអ្នកបានបដិសេធរបៀបនេះ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 Mac에서 허용되지 않음: 에이전트 또는 조직 설정이 이 모드를 거부했습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ikke tillatt på denne Macen: agenten eller organisasjonens innstillinger avviste denne modusen"
          }
        },
        "pl": {
          "stringUnit": {
