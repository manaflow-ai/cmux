    "host.waitingService": {"comment":"Agent pane: the pane waits for the agent service (acpmux) to answer; {time} is how long it has waited, as m:ss","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Waiting for the agent service ({time})"}},"ar":{"stringUnit":{"state":"needs_review","value":"بانتظار خدمة الوكيل ({time})"}},"bs":{"stringUnit":{"state":"needs_review","value":"Čeka se servis agenta ({time})"}},"da":{"stringUnit":{"state":"needs_review","value":"Venter på agenttjenesten ({time})"}},"de":{"stringUnit":{"state":"needs_review","value":"Warten auf den Agentendienst ({time})"}},"es":{"stringUnit":{"state":"needs_review","value":"Esperando al servicio de agentes ({time})"}},"fr":{"stringUnit":{"state":"needs_review","value":"En attente du service d’agents ({time})"}},"it":{"stringUnit":{"state":"needs_review","value":"In attesa del servizio agenti ({time})"}},"ja":{"stringUnit":{"state":"needs_review","value":"エージェントサービスを待機中（{time}）"}},"km":{"stringUnit":{"state":"needs_review","value":"កំពុងរង់ចាំសេវាភ្នាក់ងារ ({time})"}},"ko":{"stringUnit":{"state":"needs_review","value":"에이전트 서비스 대기 중 ({time})"}},"nb":{"stringUnit":{"state":"needs_review","value":"Venter på agenttjenesten ({time})"}},"pl":{"stringUnit":{"state":"needs_review","value":"Oczekiwanie na usługę agentów ({time})"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Aguardando o serviço de agentes ({time})"}},"ru":{"stringUnit":{"state":"needs_review","value":"Ожидание службы агентов ({time})"}},"th":{"stringUnit":{"state":"needs_review","value":"กำลังรอบริการเอเจนต์ ({time})"}},"tr":{"stringUnit":{"state":"needs_review","value":"Ajan hizmeti bekleniyor ({time})"}},"uk":{"stringUnit":{"state":"needs_review","value":"Очікування служби агентів ({time})"}},"vi":{"stringUnit":{"state":"needs_review","value":"Đang chờ dịch vụ tác tử ({time})"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"正在等待代理服务（{time}）"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"正在等待代理服務（{time}）"}}}},
