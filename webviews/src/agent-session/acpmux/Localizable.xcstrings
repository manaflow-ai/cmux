    "workflow.contentOmitted": {"comment":"Agent pane: the transcript reader omitted content exceeding its bounded page size","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Some transcript content is too large to display."}},"ar":{"stringUnit":{"state":"translated","value":"بعض محتوى المحادثة كبير جدًا ولا يمكن عرضه."}},"bs":{"stringUnit":{"state":"translated","value":"Dio sadržaja razgovora je prevelik za prikaz."}},"da":{"stringUnit":{"state":"translated","value":"Noget af samtalens indhold er for stort til at blive vist."}},"de":{"stringUnit":{"state":"translated","value":"Einige Gesprächsinhalte sind zu groß für die Anzeige."}},"es":{"stringUnit":{"state":"translated","value":"Parte del contenido de la conversación es demasiado grande para mostrarse."}},"fr":{"stringUnit":{"state":"translated","value":"Une partie du contenu de la conversation est trop volumineuse pour être affichée."}},"it":{"stringUnit":{"state":"translated","value":"Parte del contenuto della conversazione è troppo grande per essere visualizzata."}},"ja":{"stringUnit":{"state":"translated","value":"会話の一部は大きすぎるため表示できません。"}},"km":{"stringUnit":{"state":"translated","value":"ខ្លឹមសារសន្ទនាខ្លះធំពេកមិនអាចបង្ហាញបានទេ។"}},"ko":{"stringUnit":{"state":"translated","value":"일부 대화 내용이 너무 커서 표시할 수 없습니다."}},"nb":{"stringUnit":{"state":"translated","value":"Noe av samtaleinnholdet er for stort til å vises."}},"pl":{"stringUnit":{"state":"translated","value":"Część treści rozmowy jest zbyt duża, aby ją wyświetlić."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Parte do conteúdo da conversa é grande demais para ser exibida."}},"ru":{"stringUnit":{"state":"translated","value":"Некоторое содержимое разговора слишком велико для отображения."}},"th":{"stringUnit":{"state":"translated","value":"เนื้อหาบางส่วนของการสนทนามีขนาดใหญ่เกินกว่าจะแสดงได้"}},"tr":{"stringUnit":{"state":"translated","value":"Konuşma içeriğinin bir kısmı görüntülenemeyecek kadar büyük."