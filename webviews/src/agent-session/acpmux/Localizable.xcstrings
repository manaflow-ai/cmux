          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mistet forbindelsen til agenten; prøv igjen når den er tilbake"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utracono połączenie z agentem; spróbuj ponownie, gdy wróci"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A conexão com o agente caiu; tente novamente quando ela voltar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Соединение с агентом потеряно; повторите попытку, когда оно восстановится"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การเชื่อมต่อกับเอเจนต์ขาดหาย ลองอีกครั้งเมื่อเชื่อมต่อได้แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajanla bağlantı koptu; geri geldiğinde yeniden deneyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "З’єднання з агентом втрачено; спробуйте ще раз, коли його буде відновлено"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mất kết nối với tác nhân; hãy thử lại khi kết nối được khôi phục"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
