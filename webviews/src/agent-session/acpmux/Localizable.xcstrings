    "edited.undoLabel": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اطلب من الوكيل التراجع عن تغييرات هذه الجولة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zatraži od agenta da poništi promjene ovog kruga"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bed agenten om at fortryde denne turs ændringer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den Agenten bitten, die Änderungen dieses Durchgangs rückgängig zu machen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask the agent to undo this turn's changes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pedir al agente que deshaga los cambios de este turno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Demander à l'agent d'annuler les modifications de ce tour"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chiedi all'agente di annullare le modifiche di questo turno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このターンの変更を元に戻すようエージェントに依頼"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ស្នើអោយភ្នាក់ងារមិនធ្វើវិញការផ្លាស់ប្តូរនៃវេននេះ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트에게 이 턴의 변경 사항을 실행 취소하도록 요청"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Be agenten angre endringene fra denne runden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poproś agenta o cofnięcie zmian z tej tury"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pedir ao agente para desfazer as alterações deste turno"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Попросить агента отменить изменения этого хода"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ขอให้เอเจนต์เลิกทำการเปลี่ยนแปลงของเทิร์นนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajandan bu turun değişikliklerini geri almasını iste"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Попросити агента скасувати зміни цього ходу"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yêu cầu tác nhân hoàn tác các thay đổi của lượt này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请代理撤销此轮的更改"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請代理還原此輪的變更"
          }
        }
      }
    },
