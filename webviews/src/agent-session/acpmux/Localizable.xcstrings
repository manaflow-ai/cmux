    "permission.claude.feedbackPlaceholder": {
      "comment": "Agent pane: placeholder and label of the field Deny opens on a Claude Code permission card, for what Claude should do instead (Claude Code's own wording; Claude is a product name)",
      "extractionState": "manual",
      "localizations": {
