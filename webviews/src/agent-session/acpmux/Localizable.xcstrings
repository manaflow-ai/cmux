    "composer.stillSending": {
      "comment": "Agent pane composer note: Return or Send pressed while the last prompt is still on its way to the agent; the prompt stays in the composer",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زالت رسالتك الأخيرة قيد الإرسال. تبقى هنا حتى يستلمها الوكيل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja zadnja poruka se još šalje. Ostaje ovdje dok je agent ne preuzme."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din seneste besked sendes stadig. Den bliver her, indtil agenten tager imod den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine letzte Nachricht wird noch gesendet. Sie bleibt hier, bis der Agent sie annimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still sending your last message. It stays here until the agent takes it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu último mensaje aún se está enviando. Se queda aquí hasta que el agente lo reciba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton dernier message est encore en cours d’envoi. Il reste ici jusqu’à ce que l’agent le prenne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo ultimo messaggio è ancora in invio. Resta qui finché l’agente non lo riceve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前のメッセージを送信中です。エージェントが受け取るまでここに残ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សារចុងក្រោយរបស់អ្នកកំពុងផ្ញើនៅឡើយ។ វានៅទីនេះរហូតដល់ភ្នាក់ងារទទួលយក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 메시지를 아직 보내는 중입니다. 에이전트가 받을 때까지 여기에 남아 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den siste meldingen din sendes fortsatt. Den blir her til agenten tar imot den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja ostatnia wiadomość wciąż jest wysyłana. Zostaje tutaj, dopóki agent jej nie przyjmie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua última mensagem ainda está sendo enviada. Ela fica aqui até o agente recebê-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последнее сообщение ещё отправляется. Оно останется здесь, пока агент его не примет."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังส่งข้อความล่าสุดอยู่ ข้อความจะอยู่ที่นี่จนกว่าเอเจนต์จะรับไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son mesajın hâlâ gönderiliyor. Ajan alana kadar burada kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Останнє повідомлення ще надсилається. Воно залишиться тут, доки агент його не прийме."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn cuối của bạn vẫn đang được gửi. Nó ở lại đây cho đến khi tác nhân nhận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一条消息仍在发送。在智能体接收之前，它会留在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上一則訊息仍在傳送。在代理程式接收之前，它會留在這裡。"
          }
        }
      }
    },
