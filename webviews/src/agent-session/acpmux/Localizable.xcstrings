          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bare cmux-appen kan godkjenne dette. Godkjenn det i cmux på Macen som kjører denne chatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tylko aplikacja cmux może to zatwierdzić. Zatwierdź to w cmux na Macu, na którym działa ten czat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Só o app cmux pode aprovar isto. Aprove no cmux no Mac que executa este chat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Одобрить это можно только в приложении cmux. Одобрите в cmux на Mac, где работает этот чат."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "มีเพียงแอป cmux เท่านั้นที่อนุมัติสิ่งนี้ได้ อนุมัติใน cmux บน Mac ที่เรียกใช้แชทนี้"
