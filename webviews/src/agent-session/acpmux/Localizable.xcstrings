    "edited.undoSkip.cannot.one": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يمكن التراجع عن تعديل واحد وسيتم تخطيه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 izmjena se ne može poništiti i bit će preskočena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 ændring kan ikke fortrydes og springes over."
          }
        },
