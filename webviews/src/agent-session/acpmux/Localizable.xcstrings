    "header.worktreeRemoveUncommitted": {
      "comment": "Worktree pill: Remove the chat's worktree (cx-lyqio.5)",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي شجرة العمل على تغييرات غير مُودعة في {files}"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Radno stablo ima nepotvrđene izmjene u {files}"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbejdstræet har ikke-committede ændringer i {files}"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Worktree hat nicht committete Änderungen an {files}"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The worktree has uncommitted changes to {files}"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El worktree tiene cambios sin confirmar en {files}"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le worktree a des modifications non validées dans {files}"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il worktree ha modifiche non committate a {files}"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークツリーに未コミットの変更があります: {files}"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "worktree មានការផ្លាស់ប្ដូរមិនទាន់ commit ក្នុង {files}"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워크트리에 커밋하지 않은 변경 사항이 있습니다: {files}"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeidstreet har endringer som ikke er committet i {files}"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drzewo robocze ma niezatwierdzone zmiany w {files}"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O worktree tem alterações não confirmadas em {files}"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В рабочем дереве есть незафиксированные изменения: {files}"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวิร์กทรีมีการเปลี่ยนแปลงที่ยังไม่ได้คอมมิตใน {files}"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışma ağacında {files} için kaydedilmemiş değişiklikler var"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У робочому дереві є незафіксовані зміни: {files}"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree có thay đổi chưa commit trong {files}"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作树中 {files} 有未提交的更改"
