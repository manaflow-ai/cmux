    "error.interrupted": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "انقطع الاتصال بالوكيل. اقرأ حالته المحفوظة قبل إعادة المحاولة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Veza s agentom je prekinuta. Pročitajte njegovo spremljeno stanje prije ponovnog pokušaja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agentforbindelsen blev afbrudt. Læs dens gemte tilstand, før du prøver igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Verbindung zum Agent wurde unterbrochen. Lies den gespeicherten Zustand, bevor du es erneut versuchst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent connection was interrupted. Read its saved state before retrying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La conexión con el agente se interrumpió. Consulta su estado guardado antes de reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La connexion à l’agent a été interrompue. Consultez son état enregistré avant de réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La connessione all’agente è stata interrotta. Leggi lo stato salvato prima di riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "エージェントとの接続が中断されました。再試行する前に保存された状態を確認してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការតភ្ជាប់ទៅភ្នាក់ងារត្រូវបានរំខាន។ សូមអានស្ថានភាពដែលបានរក្សាទុករបស់វា មុនពេលព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트 연결이 중단되었습니다. 다시 시도하기 전에 저장된 상태를 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agenttilkoblingen ble avbrutt. Les den lagrede tilstanden før du prøver igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Połączenie z agentem zostało przerwane. Przed ponowieniem odczytaj zapisany stan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A conexão com o agente foi interrompida. Leia o estado salvo antes de tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Соединение с агентом прервано. Перед повтором прочитайте его сохранённое состояние."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การเชื่อมต่อกับเอเจนต์ถูกขัดจังหวะ อ่านสถานะที่บันทึกไว้ก่อนลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajan bağlantısı kesildi. Yeniden denemeden önce kayıtlı durumunu okuyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "З’єднання з агентом перервано. Перед повтором прочитайте його збережений стан."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kết nối với tác tử đã bị gián đoạn. Hãy đọc trạng thái đã lưu trước khi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "智能体连接已中断。重试前请先读取其已保存的状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "代理連線已中斷。重試前請先讀取其已儲存的狀態。"
          }
