            "value": "/{command} só funciona no terminal do Claude Code, não no cmux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "/{command} работает только в терминале Claude Code, а не в cmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "/{command} ใช้ได้เฉพาะในเทอร์มินัลของ Claude Code ไม่ใช่ใน cmux"
          }
