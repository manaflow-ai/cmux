          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Remote បានបដិសេធព័ត៌មានផ្ទៀងផ្ទាត់។ សូមពិនិត្យសោ SSH ឬកម្មវិធីជំនួយព័ត៌មានផ្ទៀងផ្ទាត់របស់អ្នកនៅក្នុងទែមីណាល់។"
          }
        },
        "ko": {
