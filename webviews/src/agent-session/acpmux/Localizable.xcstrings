    "picker.noModels": {
      "comment": "Agent pane: the model picker when the agent has reported no models",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا توجد نماذج بعد. حدّث لسؤال الوكيل مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Još nema modela. Osvježite da ponovo pitate agenta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen modeller endnu. Opdater for at spørge agenten igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noch keine Modelle. Aktualisieren, um den Agenten erneut zu fragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No models yet. Refresh to ask the agent again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aún no hay modelos. Actualiza para volver a preguntar al agente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun modèle pour l’instant. Actualisez pour interroger de nouveau l’agent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ancora nessun modello. Aggiorna per chiedere di nuovo all’agente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "モデルはまだありません。更新してエージェントにもう一度問い合わせます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនទាន់មានម៉ូដែលនៅឡើយ។ ធ្វើឱ្យស្រស់ ដើម្បីសួរភ្នាក់ងារម្តងទៀត។"
