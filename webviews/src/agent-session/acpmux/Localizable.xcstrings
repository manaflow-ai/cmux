          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Henüz model yok. Ajana yeniden sormak için yenileyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Моделей ще немає. Оновіть, щоб знову запитати агента."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
