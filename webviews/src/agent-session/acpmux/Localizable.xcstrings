            "value": "គ្មានអ្វីត្រូវមិនធ្វើវិញទេ៖ ឯកសារទាំងអស់បានផ្លាស់ប្ដូរតាំងពីវេននេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "실행 취소할 항목이 없습니다. 모든 파일이 이번 턴 이후 변경되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingenting å angre: alle filene er endret siden denne runden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie ma czego cofnąć: każdy plik zmienił się po tej turze."
          }
        },
