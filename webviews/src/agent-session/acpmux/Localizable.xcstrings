    "picker.approvesAll": {"comment":"Agent pane: the mode chip of a chat whose permission policy approves every request (ComposerPickers.tsx)","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Full access"}},"ar":{"stringUnit":{"state":"needs_review","value":"وصول كامل"}},"bs":{"stringUnit":{"state":"needs_review","value":"Potpuni pristup"}},"da":{"stringUnit":{"state":"needs_review","value":"Fuld adgang"}},"de":{"stringUnit":{"state":"needs_review","value":"Vollzugriff"}},"es":{"stringUnit":{"state":"needs_review","value":"Acceso total"}},"fr":{"stringUnit":{"state":"needs_review","value":"Accès complet"}},"it":{"stringUnit":{"state":"needs_review","value":"Accesso completo"}},"ja":{"stringUnit":{"state":"needs_review","value":"フルアクセス"}},"km":{"stringUnit":{"state":"needs_review","value":"សិទ្ធិចូលប្រើពេញលេញ"}},"ko":{"stringUnit":{"state":"needs_review","value":"전체 액세스"}},"nb":{"stringUnit":{"state":"needs_review","value":"Full tilgang"}},"pl":{"stringUnit":{"state":"needs_review","value":"Pełny dostęp"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Acesso total"}},"ru":{"stringUnit":{"state":"needs_review","value":"Полный доступ"}},"th":{"stringUnit":{"state":"needs_review","value":"สิทธิ์เข้าถึงเต็มรูปแบบ"}},"tr":{"stringUnit":{"state":"needs_review","value":"Tam erişim"}},"uk":{"stringUnit":{"state":"needs_review","value":"Повний доступ"}},"vi":{"stringUnit":{"state":"needs_review","value":"Toàn quyền truy cập"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"完全访问"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"完整存取"}}}},
    "picker.approvesAllDetail": {"comment":"Agent pane: the mode chip's tooltip line under Full access; {mode} is the agent's own mode name, such as Manual (ComposerPickers.tsx)","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Runs in {mode}, and cmux approves every request"}},"ar":{"stringUnit":{"state":"needs_review","value":"يعمل في وضع {mode}، ويوافق cmux على كل طلب"}},"bs":{"stringUnit":{"state":"needs_review","value":"Radi u načinu {mode}, a cmux odobrava svaki zahtjev"}},"da":{"stringUnit":{"state":"needs_review","value":"Kører i {mode}, og cmux godkender hver anmodning"}},"de":{"stringUnit":{"state":"needs_review","value":"Läuft in {mode}, und cmux genehmigt jede Anfrage"}},"es":{"stringUnit":{"state":"needs_review","value":"Se ejecuta en {mode} y cmux aprueba cada solicitud"}},"fr":{"stringUnit":{"state":"needs_review","value":"S’exécute en {mode}, et cmux approuve chaque demande"}},"it":{"stringUnit":{"state":"needs_review","value":"Funziona in {mode} e cmux approva ogni richiesta"}},"ja":{"stringUnit":{"state":"needs_review","value":"{mode}で実行し、cmuxがすべてのリクエストを承認します"}},"km":{"stringUnit":{"state":"needs_review","value":"ដំណើរការក្នុង {mode} ហើយ cmux អនុម័តរាល់សំណើ"}},"ko":{"stringUnit":{"state":"needs_review","value":"{mode}에서 실행되며 cmux가 모든 요청을 승인합니다"}},"nb":{"stringUnit":{"state":"needs_review","value":"Kjører i {mode}, og cmux godkjenner hver forespørsel"}},"pl":{"stringUnit":{"state":"needs_review","value":"Działa w trybie {mode}, a cmux zatwierdza każde żądanie"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Executa em {mode}, e o cmux aprova cada solicitação"}},"ru":{"stringUnit":{"state":"needs_review","value":"Работает в режиме {mode}, и cmux одобряет каждый запрос"}},"th":{"stringUnit":{"state":"needs_review","value":"ทำงานในโหมด {mode} และ cmux อนุมัติทุกคำขอ"}},"tr":{"stringUnit":{"state":"needs_review","value":"{mode} modunda çalışır ve cmux her isteği onaylar"}},"uk":{"stringUnit":{"state":"needs_review","value":"Працює в режимі {mode}, і cmux схвалює кожен запит"}},"vi":{"stringUnit":{"state":"needs_review","value":"Chạy ở chế độ {mode} và cmux phê duyệt mọi yêu cầu"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"以 {mode} 运行，cmux 会批准每个请求"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"以 {mode} 執行，cmux 會核准每個請求"}}}},
    "message.heldByStop": {"comment":"Agent pane: quiet note at the end of other agents' message lines while the person's Stop holds them in the chat's queue; Continue, or the person's next message, lets them in","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Held: you stopped this chat. Continue or send a message to let them in."}},"ar":{"stringUnit":{"state":"needs_review","value":"محتجزة: أوقفت هذه المحادثة. تابع أو أرسل رسالة لإدخالها."}},"bs":{"stringUnit":{"state":"needs_review","value":"Zadržano: zaustavili ste ovaj chat. Nastavite ili pošaljite poruku da ih pustite."}},"da":{"stringUnit":{"state":"needs_review","value":"Holdt tilbage: du stoppede denne chat. Fortsæt, eller send en besked for at lukke dem ind."}},"de":{"stringUnit":{"state":"needs_review","value":"Zurückgehalten: Du hast diesen Chat gestoppt. Fortfahren oder eine Nachricht senden, um sie durchzulassen."}},"es":{"stringUnit":{"state":"needs_review","value":"Retenidos: detuviste este chat. Continúa o envía un mensaje para dejarlos pasar."}},"fr":{"stringUnit":{"state":"needs_review","value":"En attente : vous avez arrêté ce chat. Continuez ou envoyez un message pour les laisser passer."}},"it":{"stringUnit":{"state":"needs_review","value":"Trattenuti: hai fermato questa chat. Continua o invia un messaggio per farli entrare."}},"ja":{"stringUnit":{"state":"needs_review","value":"保留中: このチャットを停止しました。続行するかメッセージを送ると届きます。"}},"km":{"stringUnit":{"state":"needs_review","value":"បានរក្សាទុក៖ អ្នកបានបញ្ឈប់ការជជែកនេះ។ បន្ត ឬផ្ញើសារដើម្បីឲ្យវាចូល។"}},"ko":{"stringUnit":{"state":"needs_review","value":"보류됨: 이 채팅을 중지했습니다. 계속하거나 메시지를 보내면 전달됩니다."}},"nb":{"stringUnit":{"state":"needs_review","value":"Holdt tilbake: du stoppet denne chatten. Fortsett eller send en melding for å slippe dem inn."}},"pl":{"stringUnit":{"state":"needs_review","value":"Wstrzymane: zatrzymano ten czat. Kontynuuj lub wyślij wiadomość, aby je wpuścić."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Retidas: você parou este chat. Continue ou envie uma mensagem para liberá-las."}},"ru":{"stringUnit":{"state":"needs_review","value":"Задержаны: вы остановили этот чат. Продолжите или отправьте сообщение, чтобы пропустить их."}},"th":{"stringUnit":{"state":"needs_review","value":"ถูกพักไว้: คุณหยุดแชตนี้ ดำเนินการต่อหรือส่งข้อความเพื่อให้เข้ามา"}},"tr":{"stringUnit":{"state":"needs_review","value":"Bekletiliyor: bu sohbeti durdurdunuz. İçeri almak için devam edin veya mesaj gönderin."}},"uk":{"stringUnit":{"state":"needs_review","value":"Затримано: ви зупинили цей чат. Продовжте або надішліть повідомлення, щоб пропустити їх."}},"vi":{"stringUnit":{"state":"needs_review","value":"Đang giữ: bạn đã dừng cuộc trò chuyện này. Tiếp tục hoặc gửi tin nhắn để cho chúng vào."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"已暂留：你停止了此聊天。继续或发送消息即可放行。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"已暫留：你停止了此聊天。繼續或傳送訊息即可放行。"}}}},
    "composer.cmuxImportSandbox": {
      "comment": "Agent pane: importing a transcript would create a persistent chat instead of the selected sandbox run.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استيراد نص المحادثة غير متاح في وضع العزل"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvoz transkripta nije dostupan u izoliranom režimu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Import af transskription er ikke tilgængelig i sandkassetilstand"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Transkriptimport ist im Sandbox-Modus nicht verfügbar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcript import is unavailable in Sandboxed mode"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La importación de transcripciones no está disponible en el modo aislado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’importation de transcriptions n’est pas disponible en mode bac à sable"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’importazione delle trascrizioni non è disponibile in modalità sandbox"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンドボックスモードではトランスクリプトをインポートできません"
          }
        },
        "km": {
          "stringUnit": {
