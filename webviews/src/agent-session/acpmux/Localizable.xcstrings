    "prompt.notSentGesture": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يُرسَل. اضغط «إعادة المحاولة» لإرساله."
