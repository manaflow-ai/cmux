        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ចម្លើយការអនុញ្ញាតបានបញ្ជូនក្រុមផ្សេង។ សូមអានមុនពេលព្យាយាមម្តងទៀត។"
