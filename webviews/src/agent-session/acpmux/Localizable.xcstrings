    "permission.error.disconnected": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مجموعات الأذونات غير متصلة. حدّث قبل الرد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Grupe dozvola nisu povezane. Osvježite prije odgovora."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tilladelsesgrupper har mistet forbindelsen. Opdater, før du svarer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Berechtigungsgruppen sind getrennt. Aktualisiere, bevor du antwortest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission groups are disconnected. Refresh before answering."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los grupos de permisos están desconectados. Actualiza antes de responder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les groupes d'autorisations sont déconnectés. Actualisez avant de répondre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I gruppi di autorizzazioni sono disconnessi. Aggiorna prima di rispondere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限グループとの接続が切れています。回答する前に更新してください。"
          }
        },
