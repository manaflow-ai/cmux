    "newTabPage.defaultKindHint": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ما يفتحه ⌘T و +. انقر للتغيير."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Šta otvaraju ⌘T i +. Kliknite za promjenu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det ⌘T og + åbner. Klik for at ændre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wird mit ⌘T und + geöffnet. Zum Ändern klicken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What ⌘T and + open. Click to change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo que abren ⌘T y +. Haz clic para cambiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce qu’ouvrent ⌘T et +. Cliquez pour modifier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cosa aprono ⌘T e +. Fai clic per cambiare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘Tと+で開くもの。クリックで変更。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អ្វីដែល ⌘T និង + បើក។ ចុចដើម្បីប្តូរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘T와 +로 열리는 항목입니다. 클릭하여 변경하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det ⌘T og + åpner. Klikk for å endre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Co otwierają ⌘T i +. Kliknij, aby zmienić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O que ⌘T e + abrem. Clique para alterar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Что открывают ⌘T и +. Нажмите, чтобы изменить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สิ่งที่ ⌘T และ + จะเปิด คลิกเพื่อเปลี่ยน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘T ve + tuşlarının açtığı şey. Değiştirmek için tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Що відкривають ⌘T і +. Клацніть, щоб змінити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nội dung mở bằng ⌘T và +. Nhấp để thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘T 和 + 打开的内容。点按可更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘T 和 + 會打開的內容。按一下即可變更。"
          }
        }
      }
    },
