          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odpowiedź na żądanie uprawnienia zwróciła inną grupę. Odczytaj przed ponowieniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
