    "git.commit.uncertain": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم تصل أي استجابة، لذا ربما تم الإيداع. أعد المحاولة للتحقق. لن يتم الإيداع مرتين."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odgovor nije stigao, pa je commit možda napravljen. Pokušajte ponovo da provjerite. Commit se neće napraviti dvaput."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der kom intet svar, så committet kan være lavet. Prøv igen for at tjekke. Der committes ikke to gange."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es kam keine Antwort, daher wurde der Commit möglicherweise erstellt. Erneut versuchen, um es zu prüfen. Es wird nicht doppelt committet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No answer came back, so the commit may have been made. Retry to check. It will not commit twice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No llegó respuesta, así que el commit puede haberse realizado. Reintenta para comprobarlo. No se confirmará dos veces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucune réponse n’a été reçue, la validation a donc peut-être eu lieu. Réessayez pour vérifier. Elle ne sera pas effectuée deux fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non è arrivata alcuna risposta, quindi il commit potrebbe essere stato eseguito. Riprova per verificare. Il commit non verrà eseguito due volte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答がなかったため、コミットされた可能性があります。再試行して確認してください。二重にコミットされることはありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនមានការឆ្លើយតបទេ ដូច្នេះ Commit អាចត្រូវបានធ្វើរួចហើយ។ សូមព្យាយាមម្ដងទៀតដើម្បីពិនិត្យ។ វានឹងមិន Commit ពីរដងទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "응답이 없어 커밋이 이미 완료되었을 수 있습니다. 다시 시도하여 확인하십시오. 두 번 커밋되지는 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det kom ikke noe svar, så commiten kan ha blitt utført. Prøv igjen for å sjekke. Den blir ikke committet to ganger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brak odpowiedzi, więc commit mógł zostać utworzony. Ponów, aby sprawdzić. Nie zostanie zatwierdzony dwukrotnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhuma resposta foi recebida, então o commit pode ter sido feito. Tente novamente para verificar. O commit não será feito duas vezes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ответ не получен, поэтому коммит мог быть создан. Повторите, чтобы проверить. Повторного коммита не будет."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่ได้รับการตอบกลับ คอมมิตอาจถูกสร้างแล้ว ลองอีกครั้งเพื่อตรวจสอบ ระบบจะไม่คอมมิตซ้ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yanıt gelmedi, bu nedenle commit yapılmış olabilir. Kontrol etmek için yeniden deneyin. İki kez commit edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відповіді не надійшло, тож коміт міг бути створений. Повторіть, щоб перевірити. Повторного коміту не буде."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không nhận được phản hồi, nên commit có thể đã được tạo. Thử lại để kiểm tra. Sẽ không commit hai lần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未收到响应，提交可能已经完成。请重试以检查，不会重复提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未收到回應，提交可能已經完成。請重試以檢查，不會重複提交。"
          }
        }
      }
    },
    "git.commit.failed": {
