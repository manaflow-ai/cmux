    "permission.chatAllowed": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "طلبات الأدوات المؤهلة المستقبلية مسموح بها في هذه الدردشة. تظل قواعد الرفض سارية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Budući prihvatljivi zahtjevi alata dozvoljeni su u ovom chatu. Pravila odbijanja i dalje vrijede."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fremtidige kvalificerede værktøjsanmodninger er tilladt i denne chat. Afvisningsregler gælder stadig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Künftige berechtigte Tool-Anfragen sind in diesem Chat erlaubt. Ablehnungsregeln gelten weiterhin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Future eligible tool requests are allowed in this chat. Deny rules still apply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las futuras solicitudes de herramientas elegibles están permitidas en este chat. Las reglas de denegación siguen aplicándose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les futures demandes d'outils éligibles sont autorisées dans ce chat. Les règles de refus s'appliquent toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le future richieste di strumenti idonee sono consentite in questa chat. Le regole di rifiuto restano valide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットでは今後の対象ツールリクエストを許可します。拒否ルールは引き続き適用されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សំណើឧបករណ៍ដែលមានសិទ្ធិនាពេលអនាគតត្រូវបានអនុញ្ញាតក្នុងការជជែកនេះ។ ច្បាប់បដិសេធនៅតែមានសុពលភាព។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 채팅에서 이후의 적격한 도구 요청이 허용됩니다. 거부 규칙은 계속 적용됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fremtidige kvalifiserte verktøyforespørsler er tillatt i denne chatten. Avslagsregler gjelder fortsatt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przyszłe kwalifikujące się żądania narzędzi w tym czacie są dozwolone. Reguły odmowy nadal obowiązują."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As próximas solicitações de ferramenta elegíveis são permitidas neste chat. As regras de negação continuam valendo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Будущие подходящие запросы инструментов в этом чате разрешены. Правила запрета по-прежнему действуют."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คำขอใช้เครื่องมือที่เข้าเงื่อนไขในอนาคตในแชตนี้ได้รับอนุญาต กฎการปฏิเสธยังคงมีผล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu sohbette uygun gelecek araç isteklerine izin verilir. Reddetme kuralları yine geçerlidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Майбутні відповідні запити інструментів у цьому чаті дозволені. Правила заборони й надалі діють."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các yêu cầu công cụ hợp lệ trong tương lai ở cuộc trò chuyện này được cho phép. Quy tắc từ chối vẫn áp dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此对话中未来符合条件的工具请求将被允许。拒绝规则仍然适用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此對話中未來符合條件的工具請求將被允許。拒絕規則仍然適用。"
          }
        }
      }
    },
    "permission.chatScope": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"السماح لهذه الدردشة\" يوافق أيضًا على الطلبات المؤهلة المستقبلية حتى تتوقف هذه الدردشة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Dozvoli za ovaj chat“ odobrava i buduće prihvatljive zahtjeve dok se ovaj chat ne zaustavi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"Tillad for denne chat\" godkender også fremtidige kvalificerede anmodninger, indtil denne chat stopper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Für diesen Chat erlauben“ genehmigt auch künftige berechtigte Anfragen, bis dieser Chat endet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow for this chat also approves future eligible requests until this chat stops."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Permitir en este chat» también aprueba las futuras solicitudes elegibles hasta que este chat se detenga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "« Autoriser pour ce chat » approuve aussi les futures demandes éligibles jusqu'à l'arrêt de ce chat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Consenti per questa chat» approva anche le future richieste idonee finché questa chat non si ferma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「このチャットで許可」は、チャットが停止するまで今後の対象リクエストも承認します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការអនុញ្ញាតសម្រាប់ការជជែកនេះក៏អនុម័តសំណើដែលមានសិទ្ធិនាពេលអនាគតរហូតដល់ការជជែកនេះបញ្ឈប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 채팅에 허용하면 이 채팅이 중지될 때까지 이후의 적격한 요청도 승인됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tillat for denne chatten godkjenner også fremtidige kvalifiserte forespørsler til denne chatten stopper."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zezwolenie dla tego czatu zatwierdza także przyszłe kwalifikujące się żądania, dopóki ten czat się nie zatrzyma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permitir para este chat também aprova as próximas solicitações elegíveis até este chat parar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Разрешение для этого чата также одобряет будущие подходящие запросы, пока этот чат не остановится."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การอนุญาตสำหรับแชตนี้จะอนุมัติคำขอที่เข้าเงื่อนไขในอนาคตด้วย จนกว่าแชตนี้จะหยุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu sohbet için izin ver, bu sohbet duruncaya kadar uygun gelecek istekleri de onaylar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Дозволити для цього чату» також схвалює майбутні відповідні запити, доки цей чат не зупиниться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cho phép trong cuộc trò chuyện này cũng duyệt các yêu cầu hợp lệ trong tương lai cho đến khi cuộc trò chuyện này dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“在此对话中允许”也会批准未来符合条件的请求，直到此对话停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「在此對話中允許」也會核准未來符合條件的請求，直到此對話停止。"
          }
        }
      }
    },
