    "turn.outside.title": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تغيّر أثناء الجولة، ولكن ليس بتعديلات الوكيل. للقراءة فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Promijenjeno tokom kruga, ali ne izmjenama agenta. Samo za čitanje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ændret under turen, men ikke af agentens ændringer. Skrivebeskyttet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Während des Durchgangs geändert, aber nicht durch Änderungen des Agenten. Schreibgeschützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changed during the turn, but not by the agent's edits. Read-only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cambiado durante el turno, pero no por las ediciones del agente. Solo lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Modifié pendant le tour, mais pas par les modifications de l'agent. Lecture seule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Modificato durante il turno, ma non dalle modifiche dell'agente. Sola lettura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターン中に変更されましたが、エージェントの編集によるものではありません。読み取り専用です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បានផ្លាស់ប្តូរក្នុងអំឡុងវេន ប៉ុន្តែមិនមែនដោយការកែសម្រួលរបស់ភ្នាក់ងារទេ។ អានតែប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "턴 중에 변경되었지만 에이전트의 편집에 의한 것은 아닙니다. 읽기 전용."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Endret i løpet av runden, men ikke av agentens redigeringer. Skrivebeskyttet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmieniono podczas tury, ale nie przez edycje agenta. Tylko do odczytu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alterado durante o turno, mas não pelas edições do agente. Somente leitura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Изменено во время хода, но не правками агента. Только чтение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปลี่ยนแปลงระหว่างเทิร์น แต่ไม่ได้เกิดจากการแก้ไขของเอเจนต์ อ่านอย่างเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tur sırasında değişti, ancak ajanın düzenlemelerinden kaynaklanmıyor. Salt okunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Змінено під час ходу, але не редагуваннями агента. Лише читання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã thay đổi trong lượt này, nhưng không phải do chỉnh sửa của tác nhân. Chỉ đọc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在此轮期间发生了更改，但不是由代理的编辑造成。只读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在此輪期間發生了變更，但不是由代理的編輯造成。唯讀。"
          }
        }
      }
    },
