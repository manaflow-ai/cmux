    "git.push.uncertain": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم تصل أي استجابة، لذا ربما تم إرسال الدفع. أعد المحاولة للتحقق. لن يتم الدفع مرتين."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odgovor nije stigao, pa je push možda poslan. Pokušajte ponovo da provjerite. Push se neće poslati dvaput."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der kom intet svar, så pushet kan være sendt. Prøv igen for at tjekke. Der pushes ikke to gange."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es kam keine Antwort, daher wurde der Push möglicherweise gesendet. Erneut versuchen, um es zu prüfen. Es wird nicht doppelt gepusht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No answer came back, so the push may have been sent. Retry to check. It will not push twice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No llegó respuesta, así que el push puede haberse enviado. Reintenta para comprobarlo. No se enviará dos veces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucune réponse n’a été reçue, l’envoi a donc peut-être eu lieu. Réessayez pour vérifier. Il ne sera pas effectué deux fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non è arrivata alcuna risposta, quindi il push potrebbe essere stato inviato. Riprova per verificare. Il push non verrà eseguito due volte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答がなかったため、プッシュされた可能性があります。再試行して確認してください。二重にプッシュされることはありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនមានការឆ្លើយតបទេ ដូច្នេះ Push អាចត្រូវបានផ្ញើរួចហើយ។ សូមព្យាយាមម្ដងទៀតដើម្បីពិនិត្យ។ វានឹងមិន Push ពីរដងទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "응답이 없어 푸시가 이미 전송되었을 수 있습니다. 다시 시도하여 확인하십시오. 두 번 푸시되지는 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det kom ikke noe svar, så pushen kan ha blitt sendt. Prøv igjen for å sjekke. Den blir ikke pushet to ganger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brak odpowiedzi, więc zmiany mogły zostać wypchnięte. Ponów, aby sprawdzić. Nie zostaną wypchnięte dwukrotnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhuma resposta foi recebida, então o push pode ter sido enviado. Tente novamente para verificar. O push não será feito duas vezes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ответ не получен, поэтому изменения могли быть отправлены. Повторите, чтобы проверить. Повторной отправки не будет."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่ได้รับการตอบกลับ การพุชอาจถูกส่งแล้ว ลองอีกครั้งเพื่อตรวจสอบ ระบบจะไม่พุชซ้ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yanıt gelmedi, bu nedenle push gönderilmiş olabilir. Kontrol etmek için yeniden deneyin. İki kez push edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відповіді не надійшло, тож push міг бути виконаний. Повторіть, щоб перевірити. Повторного push не буде."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không nhận được phản hồi, nên push có thể đã được gửi. Thử lại để kiểm tra. Sẽ không push hai lần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未收到响应，推送可能已经发送。请重试以检查，不会重复推送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未收到回應，推送可能已經送出。請重試以檢查，不會重複推送。"
          }
        }
      }
    },
    "git.push.failed": {
