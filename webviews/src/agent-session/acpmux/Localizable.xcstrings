    "retry.waiting.agentExited": {"comment":"Agent pane: a subagent's or sub-session's state while acpmux waits to retry a turn whose agent process exited (subagents/retryState.ts); {attempt} is this try, {of} how many acpmux makes","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Retrying ({attempt}/{of}) after the agent exited"}},"ar":{"stringUnit":{"state":"needs_review","value":"إعادة المحاولة ({attempt}/{of}) بعد خروج الوكيل"}},"bs":{"stringUnit":{"state":"needs_review","value":"Ponovni pokušaj ({attempt}/{of}) nakon izlaska agenta"}},"da":{"stringUnit":{"state":"needs_review","value":"Prøver igen ({attempt}/{of}) efter agenten afsluttede"}},"de":{"stringUnit":{"state":"needs_review","value":"Neuer Versuch ({attempt}/{of}) nach Beenden des Agenten"}},"es":{"stringUnit":{"state":"needs_review","value":"Reintentando ({attempt}/{of}) tras cerrarse el agente"}},"fr":{"stringUnit":{"state":"needs_review","value":"Nouvelle tentative ({attempt}/{of}) après l'arrêt de l'agent"}},"it":{"stringUnit":{"state":"needs_review","value":"Nuovo tentativo ({attempt}/{of}) dopo l'uscita dell'agente"}},"ja":{"stringUnit":{"state":"needs_review","value":"エージェント終了のため再試行中（{attempt}/{of}）"}},"km":{"stringUnit":{"state":"needs_review","value":"កំពុងព្យាយាមម្តងទៀត ({attempt}/{of}) បន្ទាប់ពីភ្នាក់ងារបានចេញ"}},"ko":{"stringUnit":{"state":"needs_review","value":"에이전트 종료로 재시도 중 ({attempt}/{of})"}},"nb":{"stringUnit":{"state":"needs_review","value":"Prøver igjen ({attempt}/{of}) etter at agenten avsluttet"}},"pl":{"stringUnit":{"state":"needs_review","value":"Ponawianie ({attempt}/{of}) po zamknięciu agenta"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Tentando novamente ({attempt}/{of}) após o agente encerrar"}},"ru":{"stringUnit":{"state":"needs_review","value":"Повторная попытка ({attempt}/{of}) после завершения агента"}},"th":{"stringUnit":{"state":"needs_review","value":"กำลังลองใหม่ ({attempt}/{of}) หลังเอเจนต์ปิดตัว"}},"tr":{"st