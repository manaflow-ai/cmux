    "guest.ended.revoked": {"comment":"Guest page: the owner revoked the link or closed the shared chat; no retry","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The owner ended sharing"}},"de":{"stringUnit":{"state":"translated","value":"Der Besitzer hat die Freigabe beendet"}},"fr":{"stringUnit":{"state":"translated","value":"Le propriétaire a arrêté le partage"}},"ar":{"stringUnit":{"state":"translated","value":"أنهى المالك المشاركة"}},"es":{"stringUnit":{"state":"translated","value":"El propietario dejó de compartir"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"擁有者已結束分享"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所有者已停止共享"}},"ko":{"stringUnit":{"state":"translated","value":"소유자가 공유를 종료했습니다"}},"ja":{"stringUnit":{"state":"translated","value":"オーナーが共有を終了しました"}},"bs":{"stringUnit":{"state":"needs_review","value":"Vlasnik je prekinuo dijeljenje"}},"da":{"stringUnit":{"state":"needs_review","value":"Ejeren har afsluttet delingen"}},"it":{"stringUnit":{"state":"needs_review","value":"Il proprietario ha interrotto la condivisione"}},"km":{"stringUnit":{"state":"needs_review","value":"ម្ចាស់បានបញ្ចប់ការចែករំលែក"}},"nb":{"stringUnit":{"state":"needs_review","value":"Eieren har avsluttet delingen"}},"pl":{"stringUnit":{"state":"needs_review","value":"Właściciel zakończył udostępnianie"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O dono encerrou o compartilhamento"}},"ru":{"stringUnit":{"state":"needs_review","value":"Владелец прекратил общий доступ"}},"th":{"stringUnit":{"state":"needs_review","value":"เจ้าของหยุดการแชร์แล้ว"}},"tr":{"stringUnit":{"state":"needs_review","value":"Sahibi paylaşımı sonlandırdı"}},"uk":{"stringUnit":{"state":"needs_review","value":"Власник припинив спільний доступ"}},"vi":{"stringUnit":{"state":"needs_review","value":"Chủ sở hữu đã dừng chia sẻ"}}}},
