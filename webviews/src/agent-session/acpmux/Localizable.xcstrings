    "turn.failure.auth": {
      "comment": "Agent pane: a failed turn's note (cx-w10a)",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "رفض المزوّد بيانات اعتماد {harness} ({status})."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pružalac je odbio akreditive za {harness} ({status})."
          }
