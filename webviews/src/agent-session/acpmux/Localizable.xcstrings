    "newTabPage.placeholder.browser": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ابحث أو اكتب عنوان URL، أو ! لتشغيل أمر"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pretraži ili upiši URL, ili ! za pokretanje naredbe"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Søg eller skriv en URL, eller ! for at køre en kommando"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Suchen oder URL eingeben, mit ! einen Befehl ausführen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search or type a URL, or ! to run a command"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Busca o escribe una URL, o usa ! para ejecutar un comando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rechercher ou saisir une URL, ou ! pour lancer une commande"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cerca o digita un URL, oppure ! per eseguire un comando"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "検索またはURLを入力、!でコマンドを実行"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ស្វែងរក ឬវាយ URL ឬវាយ ! ដើម្បីរត់ពាក្យបញ្ជា"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "검색하거나 URL 입력, 또는 !로 명령 실행"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Søk eller skriv en URL, eller ! for å kjøre en kommando"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wyszukaj lub wpisz adres URL albo ! aby uruchomić polecenie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pesquise ou digite um URL, ou ! para executar um comando"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Введите запрос или URL, либо ! для запуска команды"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ค้นหาหรือพิมพ์ URL หรือพิมพ์ ! เพื่อเรียกใช้คำสั่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arayın veya URL yazın, komut çalıştırmak için ! yazın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Введіть запит або URL, або ! для запуску команди"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tìm kiếm hoặc nhập URL, hoặc ! để chạy lệnh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "搜索或输入网址，或输入 ! 运行命令"
