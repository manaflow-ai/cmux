    "turn.signIn.enterCode": {
      "comment": "Agent pane: Cloud sign-in card, under Codex's device code while it waits for the user to approve.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Enter this code on the page. Waiting for approval…" } },
        "ar": { "stringUnit": { "state": "translated", "value": "أدخل هذا الرمز في الصفحة. بانتظار الموافقة…" } },
        "bs": { "stringUnit": { "state": "translated", "value": "Unesi ovaj kod na stranici. Čeka se odobrenje…" } },
        "da": { "stringUnit": { "state": "translated", "value": "Indtast denne kode på siden. Venter på godkendelse…" } },
        "de": { "stringUnit": { "state": "translated", "value": "Diesen Code auf der Seite eingeben. Warte auf Bestätigung …" } },
        "es": { "stringUnit": { "state": "translated", "value": "Introduce este código en la página. Esperando aprobación…" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Saisissez ce code sur la page. En attente d’approbation…" } },
        "it": { "stringUnit": { "state": "translated", "value": "Inserisci questo codice nella pagina. In attesa di approvazione…" } },
        "ja": { "stringUnit": { "state": "translated", "value": "このコードをページで入力してください。承認を待っています…" } },
        "km": { "stringUnit": { "state": "translated", "value": "បញ្ចូលកូដនេះនៅលើទំព័រ។ កំពុងរង់ចាំការយល់ព្រម…" } },
        "ko": { "stringUnit": { "state": "translated", "value": "페이지에 이 코드를 입력하세요. 승인을 기다리는 중…" } },
        "nb": { "stringUnit": { "state": "translated", "value": "Skriv inn denne koden på siden. Venter på godkjenning…" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Wpisz ten kod na stronie. Czekam na zatwierdzenie…" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Digite este código na página. Aguardando aprovação…" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Введите этот код на странице. Ожидание подтверждения…" } },
        "th": { "stringUnit": { "state": "translated", "value": "ป้อนรหัสนี้ในหน้า กำลังรอการอนุมัติ…" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Bu kodu sayfaya girin. Onay bekleniyor…" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Введіть цей код на сторінці. Очікування підтвердження…" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Nhập mã này trên trang. Đang chờ phê duyệt…" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "在页面上输入此代码。正在等待批准…" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "在頁面上輸入此代碼。正在等待核准…" } }
