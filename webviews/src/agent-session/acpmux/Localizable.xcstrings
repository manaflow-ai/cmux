    "newTabPage.placeholder.agent": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اطلب من {agent} البناء أو الإصلاح أو الشرح"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zatraži od {agent} da gradi, popravi ili objasni"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bed {agent} om at bygge, rette eller forklare"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} bitten, etwas zu bauen, zu beheben oder zu erklären"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask {agent} to build, fix or explain"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pide a {agent} que construya, corrija o explique"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Demander à {agent} de créer, corriger ou expliquer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chiedi a {agent} di creare, correggere o spiegare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent}に構築・修正・説明を依頼"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សុំឱ្យ {agent} បង្កើត កែ ឬពន្យល់"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent}에게 빌드, 수정 또는 설명 요청"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Be {agent} om å bygge, fikse eller forklare"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poproś agenta {agent} o zbudowanie, naprawę lub wyjaśnienie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Peça a {agent} para criar, corrigir ou explicar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Попросите {agent} создать, исправить или объяснить"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ให้ {agent} สร้าง แก้ไข หรืออธิบาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} ajanından geliştirmesini, düzeltmesini veya açıklamasını isteyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Попросіть {agent} створити, виправити або пояснити"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
