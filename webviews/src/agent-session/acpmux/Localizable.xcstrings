    "switch.action.shareWithMe": {"comment":"Agent pane: a teammate's Cloud machine refused the chat; grant yourself chats on it (team admins)","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Share with Me"}},"ar":{"stringUnit":{"state":"needs_review","value":"شاركه معي"}},"bs":{"stringUnit":{"state":"needs_review","value":"Podijeli sa mnom"}},"da":{"stringUnit":{"state":"needs_review","value":"Del med mig"}},"de":{"stringUnit":{"state":"needs_review","value":"Mit mir teilen"}},"es":{"stringUnit":{"state":"needs_review","value":"Compartir conmigo"}},"fr":{"stringUnit":{"state":"needs_review","value":"Partager avec moi"}},"it":{"stringUnit":{"state":"needs_review","value":"Condividi con me"}},"ja":{"stringUnit":{"state":"needs_review","value":"自分と共有"}},"km":{"stringUnit":{"state":"needs_review","value":"ចែករំលែកជាមួយខ្ញុំ"}},"ko":{"stringUnit":{"state":"needs_review","value":"나와 공유"}},"nb":{"stringUnit":{"state":"needs_review","value":"Del med meg"}},"pl":{"stringUnit":{"state":"needs_review","value":"Udostępnij mi"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Compartilhar comigo"}},"ru":{"stringUnit":{"state":"needs_review","value":"Поделиться со мной"}},"th":{"stringUnit":{"state":"needs_review","value":"แชร์ให้ฉัน"}},"tr":{"stringUnit":{"state":"needs_review","value":"Benimle paylaş"}},"uk":{"stringUnit":{"state":"needs_review","value":"Поділитися зі мною"}},"vi":{"stringUnit":{"state":"needs_review","value":"Chia sẻ với tôi"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"与我共享"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"與我共享"}}}},
    "switch.action.askOwner": {"comment":"Agent pane: copy a request asking the machine's owner to share it","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Ask the Owner"}},"ar":{"stringUnit":{"state":"needs_review","value":"اطلب من المالك"}},"bs":{"stringUnit":{"state":"needs_review","value":"Pitaj vlasnika"}},"da":{"stringUnit":{"state":"needs_review","value":"Spørg ejeren"}},"de":{"stringUnit":{"state":"needs_review","value":"Besitzer fragen"}},"es":{"stringUnit":{"state":"needs_review","value":"Pedir al propietario"}},"fr":{"stringUnit":{"state":"needs_review","value":"Demander au propriétaire"}},"it":{"stringUnit":{"state":"needs_review","value":"Chiedi al proprietario"}},"ja":{"stringUnit":{"state":"needs_review","value":"オーナーに依頼"}},"km":{"stringUnit":{"state":"needs_review","value":"សួរម្ចាស់"}},"ko":{"stringUnit":{"state":"needs_review","value":"소유자에게 요청"}},"nb":{"stringUnit":{"state":"needs_review","value":"Spør eieren"}},"pl":{"stringUnit":{"state":"needs_review","value":"Poproś właściciela"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Pedir ao dono"}},"ru":{"stringUnit":{"state":"needs_review","value":"Попросить владельца"}},"th":{"stringUnit":{"state":"needs_review","value":"ขอจากเจ้าของ"}},"tr":{"stringUnit":{"state":"needs_review","value":"Sahibine sor"}},"uk":{"stringUnit":{"state":"needs_review","value":"Попросити власника"}},"vi":{"stringUnit":{"state":"needs_review","value":"Hỏi chủ sở hữu"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"请求所有者"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"請求擁有者"}}}},
    "switch.share.forbidden": {"comment":"Agent pane: Share with Me was refused because the person is neither the machine's creator nor a team admin","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Only the machine's creator or a team admin can share it. Ask the owner to share it with you."}},"ar":{"stringUnit":{"state":"needs_review","value":"لا يمكن مشاركة الجهاز إلا لمنشئه أو لمسؤول الفريق. اطلب من المالك مشاركته معك."}},"bs":{"stringUnit":{"state":"needs_review","value":"Mašinu može podijeliti samo njen kreator ili administrator tima. Zamolite vlasnika da je podijeli s vama."}},"da":{"stringUnit":{"state":"needs_review","value":"Kun maskinens opretter eller en teamadministrator kan dele den. Bed ejeren om at dele den med dig."}},"de":{"stringUnit":{"state":"needs_review","value":"Nur wer die Maschine erstellt hat oder ein Team-Admin kann sie teilen. Bitte den Besitzer, sie mit dir zu teilen."}},"es":{"stringUnit":{"state":"needs_review","value":"Solo quien creó la máquina o un administrador del equipo puede compartirla. Pide al propietario que la comparta contigo."}},"fr":{"stringUnit":{"state":"needs_review","value":"Seul le créateur de la machine ou un administrateur de l'équipe peut la partager. Demandez au propriétaire de la partager avec vous."}},"it":{"stringUnit":{"state":"needs_review","value":"Solo chi ha creato la macchina o un amministratore del team può condividerla. Chiedi al proprietario di condividerla con te."}},"ja":{"stringUnit":{"state":"needs_review","value":"このマシンを共有できるのは作成者かチーム管理者だけです。オーナーに共有を依頼してください。"}},"km":{"stringUnit":{"state":"needs_review","value":"មានតែអ្នកបង្កើតម៉ាស៊ីន ឬអ្នកគ្រប់គ្រងក្រុមប៉ុណ្ណោះដែលអាចចែករំលែកវាបាន។ សូមស្នើម្ចាស់ឱ្យចែករំលែកវាជាមួយអ្នក។"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 기기는 만든 사람이나 팀 관리자만 공유할 수 있습니다. 소유자에게 공유를 요청하세요."}},"nb":{"stringUnit":{"state":"needs_review","value":"Bare den som opprettet maskinen eller en teamadministrator kan dele den. Be eieren om å dele den med deg."}},"pl":{"stringUnit":{"state":"needs_review","value":"Maszynę może udostępnić tylko jej twórca lub administrator zespołu. Poproś właściciela, aby ci ją udostępnił."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Só quem criou a máquina ou um administrador da equipe pode compartilhá-la. Peça ao dono para compartilhá-la com você."}},"ru":{"stringUnit":{"state":"needs_review","value":"Поделиться машиной может только её создатель или администратор команды. Попросите владельца поделиться ею с вами."}},"th":{"stringUnit":{"state":"needs_review","value":"มีเพียงผู้สร้างเครื่องหรือผู้ดูแลทีมเท่านั้นที่แชร์เครื่องนี้ได้ ขอให้เจ้าของแชร์ให้คุณ"}},"tr":{"stringUnit":{"state":"needs_review","value":"Makineyi yalnızca onu oluşturan kişi veya bir ekip yöneticisi paylaşabilir. Sahibinden makineyi sizinle paylaşmasını isteyin."}},"uk":{"stringUnit":{"state":"needs_review","value":"Поділитися машиною може лише її творець або адміністратор команди. Попросіть власника поділитися нею з вами."}},"vi":{"stringUnit":{"state":"needs_review","value":"Chỉ người tạo máy hoặc quản trị viên nhóm mới chia sẻ được máy này. Hãy nhờ chủ sở hữu chia sẻ với bạn."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"只有这台机器的创建者或团队管理员可以共享它。请让所有者与你共享。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"只有這台機器的建立者或團隊管理員可以共享它。請擁有者與你共享。"}}}},
    "switch.share.personal": {"comment":"Agent pane: the machine is on a personal account, so it cannot be shared","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This machine is on a personal account, so only its creator can start chats on it."}},"ar":{"stringUnit":{"state":"needs_review","value":"هذا الجهاز على حساب شخصي، لذا لا يمكن إلا لمنشئه بدء المحادثات عليه."}},"bs":{"stringUnit":{"state":"needs_review","value":"Ova mašina je na ličnom računu, pa samo njen kreator može pokretati razgovore na njoj."}},"da":{"stringUnit":{"state":"needs_review","value":"Denne maskine er på en personlig konto, så kun dens opretter kan starte chats på den."}},"de":{"stringUnit":{"state":"needs_review","value":"Diese Maschine gehört zu einem persönlichen Konto, daher kann nur ihr Ersteller dort Chats starten."}},"es":{"stringUnit":{"state":"needs_review","value":"Esta máquina está en una cuenta personal, así que solo quien la creó puede iniciar chats en ella."}},"fr":{"stringUnit":{"state":"needs_review","value":"Cette machine est sur un compte personnel : seul son créateur peut y démarrer des discussions."}},"it":{"stringUnit":{"state":"needs_review","value":"Questa macchina è su un account personale, quindi solo chi l'ha creata può avviarvi chat."}},"ja":{"stringUnit":{"state":"needs_review","value":"このマシンは個人アカウントにあるため、チャットを開始できるのは作成者だけです。"}},"km":{"stringUnit":{"state":"needs_review","value":"ម៉ាស៊ីននេះស្ថិតនៅលើគណនីផ្ទាល់ខ្លួន ដូច្នេះមានតែអ្នកបង្កើតប៉ុណ្ណោះដែលអាចចាប់ផ្ដើមការជជែកនៅលើវាបាន។"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 기기는 개인 계정에 있어서 만든 사람만 채팅을 시작할 수 있습니다."}},"nb":{"stringUnit":{"state":"needs_review","value":"Denne maskinen er på en personlig konto, så bare den som opprettet den kan starte chatter på den."}},"pl":{"stringUnit":{"state":"needs_review","value":"Ta maszyna należy do konta osobistego, więc czaty może na niej rozpoczynać tylko jej twórca."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Esta máquina está em uma conta pessoal, então só quem a criou pode iniciar chats nela."}},"ru":{"stringUnit":{"state":"needs_review","value":"Эта машина в личной учётной записи, поэтому чаты на ней может начинать только её создатель."}},"th":{"stringUnit":{"state":"needs_review","value":"เครื่องนี้อยู่ในบัญชีส่วนตัว จึงมีเพียงผู้สร้างเท่านั้นที่เริ่มแชทบนเครื่องนี้ได้"}},"tr":{"stringUnit":{"state":"needs_review","value":"Bu makine kişisel bir hesapta, bu yüzden üzerinde yalnızca onu oluşturan kişi sohbet başlatabilir."}},"uk":{"stringUnit":{"state":"needs_review","value":"Ця машина в особистому обліковому записі, тому чати на ній може починати лише її творець."}},"vi":{"stringUnit":{"state":"needs_review","value":"Máy này thuộc tài khoản cá nhân nên chỉ người tạo mới bắt đầu trò chuyện trên đó được."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"这台机器属于个人账户，因此只有其创建者可以在上面开始聊天。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"這台機器屬於個人帳號，因此只有其建立者可以在上面開始聊天。"}}}},
    "switch.share.unavailable": {"comment":"Agent pane: the Cloud could not change machine sharing right now","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Machine sharing is unavailable right now. Try again in a moment."}},"ar":{"stringUnit":{"state":"needs_review","value":"مشاركة الجهاز غير متاحة الآن. حاول مرة أخرى بعد قليل."}},"bs":{"stringUnit":{"state":"needs_review","value":"Dijeljenje mašine trenutno nije dostupno. Pokušajte ponovo za trenutak."}},"da":{"stringUnit":{"state":"needs_review","value":"Deling af maskiner er ikke tilgængelig lige nu. Prøv igen om lidt."}},"de":{"stringUnit":{"state":"needs_review","value":"Das Teilen von Maschinen ist gerade nicht verfügbar. Versuche es gleich noch einmal."}},"es":{"stringUnit":{"state":"needs_review","value":"Compartir máquinas no está disponible ahora. Inténtalo de nuevo en un momento."}},"fr":{"stringUnit":{"state":"needs_review","value":"Le partage de machines est indisponible pour le moment. Réessayez dans un instant."}},"it":{"stringUnit":{"state":"needs_review","value":"La condivisione delle macchine non è disponibile al momento. Riprova tra poco."}},"ja":{"stringUnit":{"state":"needs_review","value":"現在マシンを共有できません。しばらくしてからもう一度お試しください。"}},"km":{"stringUnit":{"state":"needs_review","value":"ការចែករំលែកម៉ាស៊ីនមិនអាចប្រើបានទេឥឡូវនេះ។ សូមព្យាយាមម្ដងទៀតបន្តិចទៀត។"}},"ko":{"stringUnit":{"state":"needs_review","value":"지금은 기기를 공유할 수 없습니다. 잠시 후 다시 시도하세요."}},"nb":{"stringUnit":{"state":"needs_review","value":"Deling av maskiner er ikke tilgjengelig akkurat nå. Prøv igjen om litt."}},"pl":{"stringUnit":{"state":"needs_review","value":"Udostępnianie maszyn jest teraz niedostępne. Spróbuj ponownie za chwilę."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O compartilhamento de máquinas está indisponível agora. Tente de novo em instantes."}},"ru":{"stringUnit":{"state":"needs_review","value":"Общий доступ к машинам сейчас недоступен. Повторите попытку чуть позже."}},"th":{"stringUnit":{"state":"needs_review","value":"ขณะนี้ยังแชร์เครื่องไม่ได้ ลองอีกครั้งในอีกสักครู่"}},"tr":{"stringUnit":{"state":"needs_review","value":"Makine paylaşımı şu anda kullanılamıyor. Birazdan yeniden deneyin."}},"uk":{"stringUnit":{"state":"needs_review","value":"Спільний доступ до машин зараз недоступний. Спробуйте ще раз за мить."}},"vi":{"stringUnit":{"state":"needs_review","value":"Hiện không thể chia sẻ máy. Hãy thử lại sau giây lát."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"机器共享暂时不可用。请稍后再试。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"機器共享暫時無法使用。請稍後再試。"}}}},
    "switch.share.failed": {"comment":"Agent pane: Share with Me failed; {reason} is why","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Couldn't share this machine: {reason}"}},"ar":{"stringUnit":{"state":"needs_review","value":"تعذّرت مشاركة هذا الجهاز: {reason}"}},"bs":{"stringUnit":{"state":"needs_review","value":"Dijeljenje ove mašine nije uspjelo: {reason}"}},"da":{"stringUnit":{"state":"needs_review","value":"Maskinen kunne ikke deles: {reason}"}},"de":{"stringUnit":{"state":"needs_review","value":"Diese Maschine konnte nicht geteilt werden: {reason}"}},"es":{"stringUnit":{"state":"needs_review","value":"No se pudo compartir esta máquina: {reason}"}},"fr":{"stringUnit":{"state":"needs_review","value":"Impossible de partager cette machine : {reason}"}},"it":{"stringUnit":{"state":"needs_review","value":"Impossibile condividere questa macchina: {reason}"}},"ja":{"stringUnit":{"state":"needs_review","value":"このマシンを共有できませんでした: {reason}"}},"km":{"stringUnit":{"state":"needs_review","value":"មិនអាចចែករំលែកម៉ាស៊ីននេះបានទេ៖ {reason}"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 기기를 공유하지 못했습니다: {reason}"}},"nb":{"stringUnit":{"state":"needs_review","value":"Kunne ikke dele denne maskinen: {reason}"}},"pl":{"stringUnit":{"state":"needs_review","value":"Nie udało się udostępnić tej maszyny: {reason}"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Não foi possível compartilhar esta máquina: {reason}"}},"ru":{"stringUnit":{"state":"needs_review","value":"Не удалось поделиться этой машиной: {reason}"}},"th":{"stringUnit":{"state":"needs_review","value":"แชร์เครื่องนี้ไม่สำเร็จ: {reason}"}},"tr":{"stringUnit":{"state":"needs_review","value":"Bu makine paylaşılamadı: {reason}"}},"uk":{"stringUnit":{"state":"needs_review","value":"Не вдалося поділитися цією машиною: {reason}"}},"vi":{"stringUnit":{"state":"needs_review","value":"Không thể chia sẻ máy này: {reason}"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"无法共享这台机器：{reason}"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"無法共享這台機器：{reason}"}}}},
    "switch.askOwner.copied": {"comment":"Agent pane: Ask the Owner copied a request to the clipboard","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Copied a request for the owner. Paste it to them in a message."}},"ar":{"stringUnit":{"state":"needs_review","value":"تم نسخ طلب إلى المالك. الصقه له في رسالة."}},"bs":{"stringUnit":{"state":"needs_review","value":"Zahtjev za vlasnika je kopiran. Zalijepite ga u poruku za njega."}},"da":{"stringUnit":{"state":"needs_review","value":"En anmodning til ejeren er kopieret. Indsæt den i en besked til dem."}},"de":{"stringUnit":{"state":"needs_review","value":"Eine Anfrage an den Besitzer wurde kopiert. Füge sie in eine Nachricht an ihn ein."}},"es":{"stringUnit":{"state":"needs_review","value":"Se copió una solicitud para el propietario. Pégala en un mensaje para él."}},"fr":{"stringUnit":{"state":"needs_review","value":"Une demande pour le propriétaire a été copiée. Collez-la dans un message à son intention."}},"it":{"stringUnit":{"state":"needs_review","value":"Richiesta per il proprietario copiata. Incollala in un messaggio per lui."}},"ja":{"stringUnit":{"state":"needs_review","value":"オーナーへの依頼文をコピーしました。メッセージに貼り付けて送ってください。"}},"km":{"stringUnit":{"state":"needs_review","value":"បានចម្លងសំណើសម្រាប់ម្ចាស់។ សូមបិទភ្ជាប់វាក្នុងសារទៅកាន់ពួកគេ។"}},"ko":{"stringUnit":{"state":"needs_review","value":"소유자에게 보낼 요청을 복사했습니다. 메시지에 붙여넣어 보내세요."}},"nb":{"stringUnit":{"state":"needs_review","value":"En forespørsel til eieren er kopiert. Lim den inn i en melding til dem."}},"pl":{"stringUnit":{"state":"needs_review","value":"Skopiowano prośbę do właściciela. Wklej ją w wiadomości do niego."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Um pedido para o dono foi copiado. Cole-o em uma mensagem para ele."}},"ru":{"stringUnit":{"state":"needs_review","value":"Запрос владельцу скопирован. Вставьте его в сообщение для него."}},"th":{"stringUnit":{"state":"needs_review","value":"คัดลอกคำขอถึงเจ้าของแล้ว วางในข้อความถึงเจ้าของได้เลย"}},"tr":{"stringUnit":{"state":"needs_review","value":"Sahibi için bir istek kopyalandı. Bir mesaja yapıştırıp gönderin."}},"uk":{"stringUnit":{"state":"needs_review","value":"Запит власнику скопійовано. Вставте його в повідомлення для нього."}},"vi":{"stringUnit":{"state":"needs_review","value":"Đã sao chép lời nhờ gửi chủ sở hữu. Hãy dán vào tin nhắn gửi họ."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"已复制给所有者的请求。请把它粘贴到消息中发给对方。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"已複製給擁有者的請求。請把它貼到訊息中傳給對方。"}}}},
    "switch.askOwner.request": {"comment":"Agent pane: the request Ask the Owner copies; {machine} is the machine's name. Keep 'Share Machine…' as the app's menu item is named in that language","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Could you share {machine} with me in cmux? Right-click it in the sidebar, choose Share Machine…, then pick me."}},"ar":{"stringUnit":{"state":"needs_review","value":"هل يمكنك مشاركة {machine} معي في cmux؟ انقر عليه بزر الماوس الأيمن في الشريط الجانبي، واختر مشاركة الجهاز…، ثم اخترني."}},"bs":{"stringUnit":{"state":"needs_review","value":"Možeš li podijeliti {machine} sa mnom u cmux? Desni klik na nju u bočnoj traci, odaberi Podijeli mašinu…, pa izaberi mene."}},"da":{"stringUnit":{"state":"needs_review","value":"Kan du dele {machine} med mig i cmux? Højreklik på den i sidepanelet, vælg Del maskine…, og vælg mig."}},"de":{"stringUnit":{"state":"needs_review","value":"Kannst du {machine} in cmux mit mir teilen? Klicke in der Seitenleiste mit rechts darauf, wähle „Maschine teilen …“ und dann mich."}},"es":{"stringUnit":{"state":"needs_review","value":"¿Puedes compartir {machine} conmigo en cmux? Haz clic derecho sobre ella en la barra lateral, elige Compartir máquina… y luego seleccióname."}},"fr":{"stringUnit":{"state":"needs_review","value":"Peux-tu partager {machine} avec moi dans cmux ? Fais un clic droit dessus dans la barre latérale, choisis Partager la machine…, puis sélectionne-moi."}},"it":{"stringUnit":{"state":"needs_review","value":"Puoi condividere {machine} con me in cmux? Fai clic destro su di essa nella barra laterale, scegli Condividi macchina…, poi seleziona me."}},"ja":{"stringUnit":{"state":"needs_review","value":"cmux で {machine} を共有してもらえますか？サイドバーで右クリックし、「マシンを共有…」を選んでから私を選んでください。"}},"km":{"stringUnit":{"state":"needs_review","value":"តើអ្នកអាចចែករំលែក {machine} ជាមួយខ្ញុំក្នុង cmux បានទេ? ចុចកណ្ដុរស្ដាំលើវានៅរបារចំហៀង ជ្រើស ចែករំលែកម៉ាស៊ីន… រួចជ្រើសខ្ញុំ។"}},"ko":{"stringUnit":{"state":"needs_review","value":"cmux에서 {machine}을(를) 저와 공유해 줄 수 있나요? 사이드바에서 마우스 오른쪽 버튼으로 클릭하고 기기 공유…를 선택한 다음 저를 고르면 됩니다."}},"nb":{"stringUnit":{"state":"needs_review","value":"Kan du dele {machine} med meg i cmux? Høyreklikk på den i sidefeltet, velg Del maskin …, og velg meg."}},"pl":{"stringUnit":{"state":"needs_review","value":"Czy możesz udostępnić mi {machine} w cmux? Kliknij ją prawym przyciskiem na pasku bocznym, wybierz Udostępnij maszynę…, a potem mnie."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Você pode compartilhar {machine} comigo no cmux? Clique com o botão direito nela na barra lateral, escolha Compartilhar Máquina… e depois me selecione."}},"ru":{"stringUnit":{"state":"needs_review","value":"Можешь поделиться со мной {machine} в cmux? Щёлкни по ней правой кнопкой в боковой панели, выбери «Поделиться машиной…» и выбери меня."}},"th":{"stringUnit":{"state":"needs_review","value":"ช่วยแชร์ {machine} ให้ฉันใน cmux ได้ไหม คลิกขวาที่เครื่องในแถบด้านข้าง เลือก แชร์เครื่อง… แล้วเลือกฉัน"}},"tr":{"stringUnit":{"state":"needs_review","value":"{machine} makinesini cmux'ta benimle paylaşabilir misin? Kenar çubuğunda üzerine sağ tıkla, Makineyi Paylaş…'ı seç, sonra beni seç."}},"uk":{"stringUnit":{"state":"needs_review","value":"Можеш поділитися зі мною {machine} у cmux? Клацни по ній правою кнопкою на бічній панелі, вибери «Поділитися машиною…» і вибери мене."}},"vi":{"stringUnit":{"state":"needs_review","value":"Bạn chia sẻ {machine} với tôi trong cmux được không? Nhấp chuột phải vào máy trong thanh bên, chọn Chia sẻ máy… rồi chọn tôi."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"你能在 cmux 里把 {machine} 共享给我吗？在边栏里右键点击它，选择“共享机器…”，然后选我。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"你能在 cmux 裡把 {machine} 共享給我嗎？在側邊欄裡按右鍵點它，選擇「共享機器…」，然後選我。"}}}},
    "switch.askOwner.requestUnnamed": {"comment":"Agent pane: the request Ask the Owner copies when the machine has no name to show","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Could you share your Cloud machine with me in cmux? Right-click it in the sidebar, choose Share Machine…, then pick me."}},"ar":{"stringUnit":{"state":"needs_review","value":"هل يمكنك مشاركة جهازك السحابي معي في cmux؟ انقر عليه بزر الماوس الأيمن في الشريط الجانبي، واختر مشاركة الجهاز…، ثم اخترني."}},"bs":{"stringUnit":{"state":"needs_review","value":"Možeš li podijeliti svoju Cloud mašinu sa mnom u cmux? Desni klik na nju u bočnoj traci, odaberi Podijeli mašinu…, pa izaberi mene."}},"da":{"stringUnit":{"state":"needs_review","value":"Kan du dele din Cloud-maskine med mig i cmux? Højreklik på den i sidepanelet, vælg Del maskine…, og vælg mig."}},"de":{"stringUnit":{"state":"needs_review","value":"Kannst du deine Cloud-Maschine in cmux mit mir teilen? Klicke in der Seitenleiste mit rechts darauf, wähle „Maschine teilen …“ und dann mich."}},"es":{"stringUnit":{"state":"needs_review","value":"¿Puedes compartir tu máquina en la nube conmigo en cmux? Haz clic derecho sobre ella en la barra lateral, elige Compartir máquina… y luego seleccióname."}},"fr":{"stringUnit":{"state":"needs_review","value":"Peux-tu partager ta machine Cloud avec moi dans cmux ? Fais un clic droit dessus dans la barre latérale, choisis Partager la machine…, puis sélectionne-moi."}},"it":{"stringUnit":{"state":"needs_review","value":"Puoi condividere con me la tua macchina Cloud in cmux? Fai clic destro su di essa nella barra laterale, scegli Condividi macchina…, poi seleziona me."}},"ja":{"stringUnit":{"state":"needs_review","value":"cmux であなたの Cloud マシンを共有してもらえますか？サイドバーで右クリックし、「マシンを共有…」を選んでから私を選んでください。"}},"km":{"stringUnit":{"state":"needs_review","value":"តើអ្នកអាចចែករំលែកម៉ាស៊ីន Cloud របស់អ្នកជាមួយខ្ញុំក្នុង cmux បានទេ? ចុចកណ្ដុរស្ដាំលើវានៅរបារចំហៀង ជ្រើស ចែករំលែកម៉ាស៊ីន… រួចជ្រើសខ្ញុំ។"}},"ko":{"stringUnit":{"state":"needs_review","value":"cmux에서 Cloud 기기를 저와 공유해 줄 수 있나요? 사이드바에서 마우스 오른쪽 버튼으로 클릭하고 기기 공유…를 선택한 다음 저를 고르면 됩니다."}},"nb":{"stringUnit":{"state":"needs_review","value":"Kan du dele Cloud-maskinen din med meg i cmux? Høyreklikk på den i sidefeltet, velg Del maskin …, og velg meg."}},"pl":{"stringUnit":{"state":"needs_review","value":"Czy możesz udostępnić mi swoją maszynę Cloud w cmux? Kliknij ją prawym przyciskiem na pasku bocznym, wybierz Udostępnij maszynę…, a potem mnie."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Você pode compartilhar sua máquina Cloud comigo no cmux? Clique com o botão direito nela na barra lateral, escolha Compartilhar Máquina… e depois me selecione."}},"ru":{"stringUnit":{"state":"needs_review","value":"Можешь поделиться со мной своей Cloud-машиной в cmux? Щёлкни по ней правой кнопкой в боковой панели, выбери «Поделиться машиной…» и выбери меня."}},"th":{"stringUnit":{"state":"needs_review","value":"ช่วยแชร์เครื่อง Cloud ของคุณให้ฉันใน cmux ได้ไหม คลิกขวาที่เครื่องในแถบด้านข้าง เลือก แชร์เครื่อง… แล้วเลือกฉัน"}},"tr":{"stringUnit":{"state":"needs_review","value":"Cloud makineni cmux'ta benimle paylaşabilir misin? Kenar çubuğunda üzerine sağ tıkla, Makineyi Paylaş…'ı seç, sonra beni seç."}},"uk":{"stringUnit":{"state":"needs_review","value":"Можеш поділитися зі мною своєю Cloud-машиною в cmux? Клацни по ній правою кнопкою на бічній панелі, вибери «Поділитися машиною…» і вибери мене."}},"vi":{"stringUnit":{"state":"needs_review","value":"Bạn chia sẻ máy Cloud của bạn với tôi trong cmux được không? Nhấp chuột phải vào máy trong thanh bên, chọn Chia sẻ máy… rồi chọn tôi."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"你能在 cmux 里把你的 Cloud 机器共享给我吗？在边栏里右键点击它，选择“共享机器…”，然后选我。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"你能在 cmux 裡把你的 Cloud 機器共享給我嗎？在側邊欄裡按右鍵點它，選擇「共享機器…」，然後選我。"}}}},
    "cloudStart.title": {"comment":"Agent pane: a new chat starting in Cloud, the line under the person's message while the start runs","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"جارٍ البدء في السحابة"}},"bs":{"stringUnit":{"state":"needs_review","value":"Pokretanje u Cloudu"}},"da":{"stringUnit":{"state":"needs_review","value":"Starter i Cloud"}},"de":{"stringUnit":{"state":"translated","value":"Wird in der Cloud gestartet"}},"en":{"stringUnit":{"state":"translated","value":"Starting in Cloud"}},"es":{"stringUnit":{"state":"translated","value":"Iniciando en la nube"}},"fr":{"stringUnit":{"state":"translated","value":"Démarrage dans le cloud"}},"it":{"stringUnit":{"state":"needs_review","value":"Avvio nel cloud"}},"ja":{"stringUnit":{"state":"translated","value":"クラウドで開始しています"}},"km":{"stringUnit":{"state":"needs_review","value":"កំពុងចាប់ផ្ដើមក្នុង Cloud"}},"ko":{"stringUnit":{"state":"translated","value":"클라우드에서 시작하는 중"}},"nb":{"stringUnit":{"state":"needs_review","value":"Starter i skyen"}},"pl":{"stringUnit":{"state":"needs_review","value":"Uruchamianie w chmurze"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Iniciando na nuvem"}},"ru":{"stringUnit":{"state":"needs_review","value":"Запуск в облаке"}},"th":{"stringUnit":{"state":"needs_review","value":"กำลังเริ่มบนคลาวด์"}},"tr":{"stringUnit":{"state":"needs_review","value":"Bulutta başlatılıyor"}},"uk":{"stringUnit":{"state":"needs_review","value":"Запуск у хмарі"}},"vi":{"stringUnit":{"state":"needs_review","value":"Đang khởi động trên đám mây"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在云端启动"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在雲端啟動"}}}},
    "cloudStart.step.machine": {
      "comment": "Agent pane: a new chat starting in Cloud, the step that takes or boots a Cloud machine",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "جارٍ تشغيل جهازك السحابي…"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokretanje vaše Cloud mašine…"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Starter din Cloud-maskine…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Cloud-Maschine wird gestartet…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting your Cloud machine…"
          }
        },
