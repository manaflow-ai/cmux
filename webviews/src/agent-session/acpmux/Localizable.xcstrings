    "git.commit.identityMissing": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يحتوي git على اسم مستخدم أو بريد إلكتروني. عيّن user.name وuser.email، ثم أعد الإيداع."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git nema korisničko ime ili e-mail. Postavite user.name i user.email, pa ponovo commitajte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git har intet brugernavn eller e-mail. Angiv user.name og user.email, og commit derefter igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git hat keinen Benutzernamen oder keine E-Mail-Adresse. Lege user.name und user.email fest und committe dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "git has no user name or email. Set user.name and user.email, then commit again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git no tiene nombre de usuario ni correo electrónico. Configura user.name y user.email y vuelve a confirmar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git n’a ni nom ni adresse e-mail d’utilisateur. Définissez user.name et user.email, puis validez à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git non ha un nome utente o un’email. Imposta user.name e user.email, poi esegui di nuovo il commit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "git にユーザー名またはメールアドレスがありません。user.name と user.email を設定してから、もう一度コミットしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git មិនមានឈ្មោះ ឬអ៊ីមែលអ្នកប្រើទេ។ សូមកំណត់ user.name និង user.email បន្ទាប់មក Commit ម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git에 사용자 이름 또는 이메일이 없습니다. user.name과 user.email을 설정한 후 다시 커밋하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git har ikke noe brukernavn eller e-post. Angi user.name og user.email, og commit på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git nie ma nazwy użytkownika ani adresu e-mail. Ustaw user.name i user.email, a następnie zatwierdź ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O git não tem nome de usuário nem e-mail. Defina user.name e user.email e faça o commit novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В git не заданы имя пользователя или email. Задайте user.name и user.email, затем повторите коммит."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git ไม่มีชื่อผู้ใช้หรืออีเมล ตั้งค่า user.name และ user.email แล้วคอมมิตอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git'te kullanıcı adı veya e-posta yok. user.name ve user.email değerlerini ayarlayıp yeniden commit edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У git не задано ім’я користувача або email. Задайте user.name і user.email, потім закомітьте знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git chưa có tên người dùng hoặc email. Đặt user.name và user.email, rồi commit lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git 未设置用户名或邮箱。请设置 user.name 和 user.email，然后重新提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "git 未設定使用者名稱或電子郵件。請設定 user.name 和 user.email，然後重新提交。"
          }
        }
      }
    },
