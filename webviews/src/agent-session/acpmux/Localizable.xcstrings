    "turn.checkpoint.failed": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّر تحميل نقطة تحقق هذه الجولة. يتم عرض تعديلات الوكيل."
          }
        },
        "bs": {
