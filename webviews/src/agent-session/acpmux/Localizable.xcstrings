          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่มีอะไรให้เลิกทำ: ทุกไฟล์เปลี่ยนไปหลังรอบนี้"
          }
        },
        "tr": {
          "stringUnit": {
