    "git.commit.newFilesSkipped": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّر سرد {n} من الملفات الجديدة الإضافية، لذا لا يمكن إيداع الملفات الجديدة من هنا. نظّفها أو أودِع من الطرفية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Još {n} novih fajlova nije moguće izlistati, pa se novi fajlovi ne mogu commitati odavde. Počistite ih ili commitajte u terminalu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{n} nye filer mere kunne ikke vises, så nye filer kan ikke committes herfra. Ryd op i dem, eller commit i en terminal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{n} weitere neue Dateien konnten nicht aufgelistet werden, daher können neue Dateien hier nicht committet werden. Räume sie auf oder committe in einem Terminal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{n} more new files could not be listed, so new files cannot be committed from here. Clean them up or commit in a terminal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se han podido listar {n} archivos nuevos más, así que no se pueden confirmar archivos nuevos desde aquí. Límpialos o confirma en un terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{n} autres nouveaux fichiers n’ont pas pu être listés, les nouveaux fichiers ne peuvent donc pas être validés ici. Faites le ménage ou validez dans un terminal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non è stato possibile elencare altri {n} nuovi file, quindi i nuovi file non possono essere inclusi nel commit da qui. Rimuovili o esegui il commit in un terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかに {n} 件の新しいファイルを一覧表示できなかったため、ここから新しいファイルをコミットできません。不要なファイルを削除するか、ターミナルでコミットしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ឯកសារថ្មី {n} ទៀតមិនអាចរាយបានទេ ដូច្នេះមិនអាច Commit ឯកសារថ្មីពីទីនេះបានទេ។ សូមសម្អាតវា ឬ Commit នៅក្នុងទែមីណាល់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "새 파일 {n}개를 더 나열할 수 없어 여기에서 새 파일을 커밋할 수 없습니다. 파일을 정리하거나 터미널에서 커밋하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{n} nye filer til kunne ikke listes opp, så nye filer kan ikke committes herfra. Rydd dem opp eller commit i en terminal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie można wyświetlić kolejnych nowych plików ({n}), więc nowych plików nie można tu zatwierdzić. Uporządkuj je lub zatwierdź w terminalu."
          }
        },
