    "permission.denyOnly": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يوجد لعنصر خيار موافقة لمرة واحدة. يمكن رفض هذه المجموعة فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stavka nema opciju jednokratnog odobrenja. Ova grupa se može samo odbiti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et element har ingen mulighed for engangsgodkendelse. Denne gruppe kan kun afvises."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Eintrag hat keine Option für eine einmalige Genehmigung. Diese Gruppe kann nur abgelehnt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An item has no single-use approval option. This group can only be denied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un elemento no tiene opción de aprobación de un solo uso. Este grupo solo se puede denegar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un élément n'a pas d'option d'approbation unique. Ce groupe ne peut qu'être refusé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un elemento non ha un'opzione di approvazione singola. Questo gruppo può solo essere rifiutato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 回限りの承認ができない項目があります。このグループは拒否のみ可能です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ធាតុមួយមិនមានជម្រើសអនុម័តតែម្តងទេ។ ក្រុមនេះអាចបដិសេធបានតែប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "일회용 승인 옵션이 없는 항목이 있습니다. 이 그룹은 거부만 할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ett element har ikke noe alternativ for engangsgodkjenning. Denne gruppen kan bare avslås."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeden z elementów nie ma opcji jednorazowego zatwierdzenia. Tę grupę można tylko odrzucić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um item não tem opção de aprovação única. Este grupo só pode ser negado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У одного из элементов нет варианта разового одобрения. Эту группу можно только запретить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "บางรายการไม่มีตัวเลือกอนุมัติครั้งเดียว กลุ่มนี้ปฏิเสธได้เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir öğenin tek kullanımlık onay seçeneği yok. Bu grup yalnızca reddedilebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Елемент не має варіанта одноразового схвалення. Цю групу можна лише заборонити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Một mục không có tùy chọn duyệt một lần. Nhóm này chỉ có thể bị từ chối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "某个项目没有单次批准选项。此组只能被拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "某個項目沒有單次核准選項。此群組只能被拒絕。"
          }
        }
      }
    },
    "permission.error.answerUncertain": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ربما طُبّق رد الإذن. اقرأ قبل إعادة المحاولة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odgovor na dozvolu je možda primijenjen. Pročitajte prije ponovnog pokušaja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tilladelsessvaret er måske blevet anvendt. Læs, før du prøver igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Berechtigungsantwort wurde möglicherweise angewendet. Lies sie vor einem neuen Versuch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The permission answer may have been applied. Read before retrying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es posible que la respuesta de permiso se haya aplicado. Lee antes de reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La réponse d'autorisation a peut-être été appliquée. Lisez avant de réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La risposta di autorizzazione potrebbe essere stata applicata. Leggi prima di riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限回答が適用された可能性があります。再試行する前に結果を取得してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ចម្លើយការអនុញ្ញាតប្រហែលជាត្រូវបានអនុវត្តហើយ។ សូមអានមុនពេលព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "권한 응답이 적용되었을 수 있습니다. 다시 시도하기 전에 읽으세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tillatelsessvaret kan ha blitt brukt. Les før du prøver igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odpowiedź na żądanie uprawnienia mogła zostać zastosowana. Odczytaj przed ponowieniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A resposta de permissão pode ter sido aplicada. Leia antes de tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ответ на запрос разрешения мог быть применён. Прочитайте перед повтором."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คำตอบเรื่องสิทธิ์อาจถูกนำไปใช้แล้ว อ่านก่อนลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İzin yanıtı uygulanmış olabilir. Yeniden denemeden önce okuyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відповідь щодо дозволу могла бути застосована. Перед повтором прочитайте."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Câu trả lời quyền có thể đã được áp dụng. Hãy đọc trước khi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "权限回复可能已生效。重试前请先读取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "權限回覆可能已生效。重試前請先讀取。"
          }
        }
      }
    },
    "permission.error.awaitingRetry": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
