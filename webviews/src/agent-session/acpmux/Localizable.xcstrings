    "turn.failure.unreachable": {
      "comment": "Agent pane: a failed turn's note (cx-w10a)",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّر على {harness} الوصول إلى الخادم."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} nije mogao doći do servera."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} kunne ikke nå sin server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} konnte seinen Server nicht erreichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{harness} could not reach its server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} no pudo conectar con su servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} n’a pas pu joindre son serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} non ha raggiunto il server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{harness} はサーバーに接続できませんでした。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} មិនអាចភ្ជាប់ទៅម៉ាស៊ីនមេបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness}이(가) 서버에 연결하지 못했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} nådde ikke serveren sin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} nie połączył się z serwerem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} não conseguiu acessar o servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} не смог подключиться к серверу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} เชื่อมต่อเซิร์ฟเวอร์ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} sunucusuna ulaşamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} не зміг підключитися до сервера."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} không kết nối được máy chủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{harness} 无法连接到服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
