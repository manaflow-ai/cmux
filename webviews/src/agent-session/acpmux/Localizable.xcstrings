    "composer.queuedSubagentRetry": {"comment":"Agent pane: label before a subagent's name on a queued request, from acpmux, that the agent resume that subagent after a transient error","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Resume subagent"}},"ar":{"stringUnit":{"state":"translated","value":"استئناف الوكيل الفرعي"}},"bs":{"stringUnit":{"state":"translated","value":"Nastavi podagenta"}},"da":{"stringUnit":{"state":"translated","value":"Genoptag subagent"}},"de":{"stringUnit":{"state":"translated","value":"Subagent fortsetzen"}},"es":{"stringUnit":{"state":"translated","value":"Reanudar subagente"}},"fr":{"stringUnit":{"state":"translated","value":"Reprendre le sous-agent"}},"it":{"stringUnit":{"state":"translated","value":"Riprendi subagente"}},"ja":{"stringUnit":{"state":"translated","value":"サブエージェントを再開"}},"km":{"stringUnit":{"state":"translated","value":"បន្តភ្នាក់ងាររង"}},"ko":{"stringUnit":{"state":"translated","value":"하위 에이전트 재개"}},"nb":{"stringUnit":{"state":"translated","value":"Gjenoppta underagent"}},"pl":{"stringUnit":{"state":"translated","value":"Wznów podagenta"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Retomar subagente"}},"ru":{"stringUnit":{"state":"translated","value":"Возобновить субагента"}},"th":{"stringUnit":{"state":"translated","value":"ทำงานเอเจนต์ย่อยต่อ"}},"tr":{"stringUnit":{"state":"translated","value":"Alt ajanı sürdür"}},"uk":{"stringUnit":{"state":"translated","value":"Відновити субагента"}},"vi":{"stringUnit":{"state":"translated","value":"Tiếp tục tác tử con"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"恢复子代理"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"恢復子代理"}}}},
