    "guest.join.title": {"comment":"Guest page: heading of the join page a guest sees before joining a shared chat (shows nothing about the chat)","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Join a shared cmux chat"}},"de":{"stringUnit":{"state":"translated","value":"Einem geteilten cmux-Chat beitreten"}},"fr":{"stringUnit":{"state":"translated","value":"Rejoindre une discussion cmux partagée"}},"ar":{"stringUnit":{"state":"translated","value":"انضم إلى محادثة cmux مشتركة"}},"es":{"stringUnit":{"state":"translated","value":"Unirse a un chat de cmux compartido"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"加入共享的 cmux 聊天"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"加入共享的 cmux 聊天"}},"ko":{"stringUnit":{"state":"translated","value":"공유된 cmux 채팅에 참여"}},"ja":{"stringUnit":{"state":"translated","value":"共有された cmux チャットに参加"}},"bs":{"stringUnit":{"state":"needs_review","value":"Pridruži se dijeljenom cmux chatu"}},"da":{"stringUnit":{"state":"needs_review","value":"Deltag i en delt cmux-chat"}},"it":{"stringUnit":{"state":"needs_review","value":"Partecipa a una chat cmux condivisa"}},"km":{"stringUnit":{"state":"needs_review","value":"ចូលរួមការជជែក cmux ដែលបានចែករំលែក"}},"nb":{"stringUnit":{"state":"needs_review","value":"Bli med i en delt cmux-chat"}},"pl":{"stringUnit":{"state":"needs_review","value":"Dołącz do udostępnionego czatu cmux"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Entrar em um chat do cmux compartilhado"}},"ru":{"stringUnit":{"state":"needs_review","value":"Присоединиться к общему чату cmux"}},"th":{"stringUnit":{"state":"needs_review","value":"เข้าร่วมแชต cmux ที่แชร์"}},"tr":{"stringUnit":{"state":"needs_review","value":"Paylaşılan bir cmux sohbetine katıl"}},"uk":{"stringUnit":{"state":"needs_review","value":"Приєднатися до спільного чату cmux"}},"vi":{"stringUnit":{"state":"needs_review","value":"Tham gia một cuộc trò chuyện cmux được chia sẻ"}}}},
    "guest.join.detail": {"comment":"Guest page: one line under the join heading; the chat's owner approves each message a guest sends","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The owner approves each message you send."}},"de":{"stringUnit":{"state":"translated","value":"Der Besitzer genehmigt jede Nachricht, die du sendest."}},"fr":{"stringUnit":{"state":"translated","value":"Le propriétaire approuve chaque message que vous envoyez."}},"ar":{"stringUnit":{"state":"translated","value":"يوافق المالك على كل رسالة ترسلها."}},"es":{"stringUnit":{"state":"translated","value":"El propietario aprueba cada mensaje que envías."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"擁有者會核准你傳送的每則訊息。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所有者会批准你发送的每条消息。"}},"ko":{"stringUnit":{"state":"translated","value":"보내는 모든 메시지는 소유자가 승인합니다."}},"ja":{"stringUnit":{"state":"translated","value":"送信するメッセージはすべてオーナーが承認します。"}},"bs":{"stringUnit":{"state":"needs_review","value":"Vlasnik odobrava svaku poruku koju pošalješ."}},"da":{"stringUnit":{"state":"needs_review","value":"Ejeren godkender hver besked, du sender."}},"it":{"stringUnit":{"state":"needs_review","value":"Il proprietario approva ogni messaggio che invii."}},"km":{"stringUnit":{"state":"needs_review","value":"ម្ចាស់អនុម័តសារនីមួយៗដែលអ្នកផ្ញើ។"}},"nb":{"stringUnit":{"state":"needs_review","value":"Eieren godkjenner hver melding du sender."}},"pl":{"stringUnit":{"state":"needs_review","value":"Właściciel zatwierdza każdą wysłaną przez ciebie wiadomość."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O dono aprova cada mensagem que você envia."}},"ru":{"stringUnit":{"state":"needs_review","value":"Владелец одобряет каждое ваше сообщение."}},"th":{"stringUnit":{"state":"needs_review","value":"เจ้าของจะอนุมัติทุกข้อความที่คุณส่ง"}},"tr":{"stringUnit":{"state":"needs_review","value":"Gönderdiğin her mesajı sahibi onaylar."}},"uk":{"stringUnit":{"state":"needs_review","value":"Власник схвалює кожне ваше повідомлення."}},"vi":{"stringUnit":{"state":"needs_review","value":"Chủ sở hữu duyệt từng tin nhắn bạn gửi."}}}},
    "guest.join.name": {"comment":"Guest page: label and placeholder of the one field on the join page, the name the guest shows as","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your name"}},"de":{"stringUnit":{"state":"translated","value":"Dein Name"}},"fr":{"stringUnit":{"state":"translated","value":"Votre nom"}},"ar":{"stringUnit":{"state":"translated","value":"اسمك"}},"es":{"stringUnit":{"state":"translated","value":"Tu nombre"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"你的名稱"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的名字"}},"ko":{"stringUnit":{"state":"translated","value":"이름"}},"ja":{"stringUnit":{"state":"translated","value":"名前"}},"bs":{"stringUnit":{"state":"needs_review","value":"Tvoje ime"}},"da":{"stringUnit":{"state":"needs_review","value":"Dit navn"}},"it":{"stringUnit":{"state":"needs_review","value":"Il tuo nome"}},"km":{"stringUnit":{"state":"needs_review","value":"ឈ្មោះរបស់អ្នក"}},"nb":{"stringUnit":{"state":"needs_review","value":"Navnet ditt"}},"pl":{"stringUnit":{"state":"needs_review","value":"Twoje imię"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Seu nome"}},"ru":{"stringUnit":{"state":"needs_review","value":"Ваше имя"}},"th":{"stringUnit":{"state":"needs_review","value":"ชื่อของคุณ"}},"tr":{"stringUnit":{"state":"needs_review","value":"Adın"}},"uk":{"stringUnit":{"state":"needs_review","value":"Ваше ім’я"}},"vi":{"stringUnit":{"state":"needs_review","value":"Tên của bạn"}}}},
    "guest.join.button": {"comment":"Guest page: the button that joins the shared chat","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Join"}},"de":{"stringUnit":{"state":"translated","value":"Beitreten"}},"fr":{"stringUnit":{"state":"translated","value":"Rejoindre"}},"ar":{"stringUnit":{"state":"translated","value":"انضمام"}},"es":{"stringUnit":{"state":"translated","value":"Unirse"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"加入"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"加入"}},"ko":{"stringUnit":{"state":"translated","value":"참여"}},"ja":{"stringUnit":{"state":"translated","value":"参加"}},"bs":{"stringUnit":{"state":"needs_review","value":"Pridruži se"}},"da":{"stringUnit":{"state":"needs_review","value":"Deltag"}},"it":{"stringUnit":{"state":"needs_review","value":"Partecipa"}},"km":{"stringUnit":{"state":"needs_review","value":"ចូលរួម"}},"nb":{"stringUnit":{"state":"needs_review","value":"Bli med"}},"pl":{"stringUnit":{"state":"needs_review","value":"Dołącz"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Entrar"}},"ru":{"stringUnit":{"state":"needs_review","value":"Присоединиться"}},"th":{"stringUnit":{"state":"needs_review","value":"เข้าร่วม"}},"tr":{"stringUnit":{"state":"needs_review","value":"Katıl"}},"uk":{"stringUnit":{"state":"needs_review","value":"Приєднатися"}},"vi":{"stringUnit":{"state":"needs_review","value":"Tham gia"}}}},
    "guest.join.joining": {"comment":"Guest page: the join button while the room checks the link","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Joining…"}},"de":{"stringUnit":{"state":"translated","value":"Wird beigetreten…"}},"fr":{"stringUnit":{"state":"translated","value":"Connexion…"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ الانضمام…"}},"es":{"stringUnit":{"state":"translated","value":"Uniéndote…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在加入…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在加入…"}},"ko":{"stringUnit":{"state":"translated","value":"참여하는 중…"}},"ja":{"stringUnit":{"state":"translated","value":"参加しています…"}},"bs":{"stringUnit":{"state":"needs_review","value":"Pridruživanje…"}},"da":{"stringUnit":{"state":"needs_review","value":"Deltager…"}},"it":{"stringUnit":{"state":"needs_review","value":"Partecipazione…"}},"km":{"stringUnit":{"state":"needs_review","value":"កំពុងចូលរួម…"}},"nb":{"stringUnit":{"state":"needs_review","value":"Blir med…"}},"pl":{"stringUnit":{"state":"needs_review","value":"Dołączanie…"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Entrando…"}},"ru":{"stringUnit":{"state":"needs_review","value":"Присоединение…"}},"th":{"stringUnit":{"state":"needs_review","value":"กำลังเข้าร่วม…"}},"tr":{"stringUnit":{"state":"needs_review","value":"Katılınıyor…"}},"uk":{"stringUnit":{"state":"needs_review","value":"Приєднання…"}},"vi":{"stringUnit":{"state":"needs_review","value":"Đang tham gia…"}}}},
    "guest.join.hostOffline": {"comment":"Guest page: join failed because the owner's computer is not connected; the guest may try again","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The owner's computer is offline. Try again in a moment."}},"de":{"stringUnit":{"state":"translated","value":"Der Computer des Besitzers ist offline. Versuche es gleich noch einmal."}},"fr":{"stringUnit":{"state":"translated","value":"L’ordinateur du propriétaire est hors ligne. Réessayez dans un instant."}},"ar":{"stringUnit":{"state":"translated","value":"حاسوب المالك غير متصل. حاول مرة أخرى بعد قليل."}},"es":{"stringUnit":{"state":"translated","value":"El ordenador del propietario está sin conexión. Inténtalo de nuevo en un momento."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"擁有者的電腦離線中。請稍後再試。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所有者的电脑处于离线状态。请稍后再试。"}},"ko":{"stringUnit":{"state":"translated","value":"소유자의 컴퓨터가 오프라인입니다. 잠시 후 다시 시도하세요."}},"ja":{"stringUnit":{"state":"translated","value":"オーナーのコンピュータがオフラインです。しばらくしてからもう一度お試しください。"}},"bs":{"stringUnit":{"state":"needs_review","value":"Vlasnikov računar je van mreže. Pokušaj ponovo za trenutak."}},"da":{"stringUnit":{"state":"needs_review","value":"Ejerens computer er offline. Prøv igen om et øjeblik."}},"it":{"stringUnit":{"state":"needs_review","value":"Il computer del proprietario è offline. Riprova tra un momento."}},"km":{"stringUnit":{"state":"needs_review","value":"កុំព្យូទ័ររបស់ម្ចាស់មិនមានអ៊ីនធឺណិតទេ។ សូមព្យាយាមម្តងទៀតបន្តិចទៀត។"}},"nb":{"stringUnit":{"state":"needs_review","value":"Eierens datamaskin er frakoblet. Prøv igjen om et øyeblikk."}},"pl":{"stringUnit":{"state":"needs_review","value":"Komputer właściciela jest offline. Spróbuj ponownie za chwilę."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O computador do dono está offline. Tente novamente em instantes."}},"ru":{"stringUnit":{"state":"needs_review","value":"Компьютер владельца не в сети. Повторите попытку чуть позже."}},"th":{"stringUnit":{"state":"needs_review","value":"คอมพิวเตอร์ของเจ้าของออฟไลน์อยู่ ลองอีกครั้งในอีกสักครู่"}},"tr":{"stringUnit":{"state":"needs_review","value":"Sahibinin bilgisayarı çevrimdışı. Birazdan tekrar dene."}},"uk":{"stringUnit":{"state":"needs_review","value":"Комп’ютер власника не в мережі. Спробуйте ще раз за мить."}},"vi":{"stringUnit":{"state":"needs_review","value":"Máy tính của chủ sở hữu đang ngoại tuyến. Hãy thử lại sau giây lát."}}}},
    "guest.join.failed": {"comment":"Guest page: join failed for another reason (network); the guest may try again","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Couldn't join. Check your connection and try again."}},"de":{"stringUnit":{"state":"translated","value":"Beitritt fehlgeschlagen. Prüfe deine Verbindung und versuche es erneut."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de rejoindre. Vérifiez votre connexion et réessayez."}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر الانضمام. تحقق من اتصالك وحاول مرة أخرى."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo unir. Comprueba tu conexión e inténtalo de nuevo."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法加入。請檢查連線後再試一次。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法加入。请检查网络连接后重试。"}},"ko":{"stringUnit":{"state":"translated","value":"참여할 수 없습니다. 연결을 확인하고 다시 시도하세요."}},"ja":{"stringUnit":{"state":"translated","value":"参加できませんでした。接続を確認してもう一度お試しください。"}},"bs":{"stringUnit":{"state":"needs_review","value":"Pridruživanje nije uspjelo. Provjeri vezu i pokušaj ponovo."}},"da":{"stringUnit":{"state":"needs_review","value":"Kunne ikke deltage. Tjek din forbindelse, og prøv igen."}},"it":{"stringUnit":{"state":"needs_review","value":"Impossibile partecipare. Controlla la connessione e riprova."}},"km":{"stringUnit":{"state":"needs_review","value":"មិនអាចចូលរួមបានទេ។ សូមពិនិត្យការតភ្ជាប់ ហើយព្យាយាមម្តងទៀត។"}},"nb":{"stringUnit":{"state":"needs_review","value":"Kunne ikke bli med. Sjekk tilkoblingen og prøv igjen."}},"pl":{"stringUnit":{"state":"needs_review","value":"Nie udało się dołączyć. Sprawdź połączenie i spróbuj ponownie."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Não foi possível entrar. Verifique sua conexão e tente novamente."}},"ru":{"stringUnit":{"state":"needs_review","value":"Не удалось присоединиться. Проверьте подключение и повторите попытку."}},"th":{"stringUnit":{"state":"needs_review","value":"เข้าร่วมไม่ได้ ตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"}},"tr":{"stringUnit":{"state":"needs_review","value":"Katılınamadı. Bağlantını kontrol edip tekrar dene."}},"uk":{"stringUnit":{"state":"needs_review","value":"Не вдалося приєднатися. Перевірте з’єднання та спробуйте ще раз."}},"vi":{"stringUnit":{"state":"needs_review","value":"Không thể tham gia. Hãy kiểm tra kết nối rồi thử lại."}}}},
    "guest.join.badLink": {"comment":"Guest page: the link opened has no secret part (it was cut when copied)","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This link is incomplete. Ask the owner for a new one."}},"de":{"stringUnit":{"state":"translated","value":"Dieser Link ist unvollständig. Bitte den Besitzer um einen neuen."}},"fr":{"stringUnit":{"state":"translated","value":"Ce lien est incomplet. Demandez-en un nouveau au propriétaire."}},"ar":{"stringUnit":{"state":"translated","value":"هذا الرابط غير مكتمل. اطلب رابطًا جديدًا من المالك."}},"es":{"stringUnit":{"state":"translated","value":"Este enlace está incompleto. Pide uno nuevo al propietario."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此連結不完整。請向擁有者索取新連結。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此链接不完整。请向所有者索取新链接。"}},"ko":{"stringUnit":{"state":"translated","value":"이 링크는 불완전합니다. 소유자에게 새 링크를 요청하세요."}},"ja":{"stringUnit":{"state":"translated","value":"このリンクは不完全です。オーナーに新しいリンクを依頼してください。"}},"bs":{"stringUnit":{"state":"needs_review","value":"Ovaj link je nepotpun. Zatraži novi od vlasnika."}},"da":{"stringUnit":{"state":"needs_review","value":"Dette link er ufuldstændigt. Bed ejeren om et nyt."}},"it":{"stringUnit":{"state":"needs_review","value":"Questo link è incompleto. Chiedine uno nuovo al proprietario."}},"km":{"stringUnit":{"state":"needs_review","value":"តំណនេះមិនពេញលេញទេ។ សូមស្នើតំណថ្មីពីម្ចាស់។"}},"nb":{"stringUnit":{"state":"needs_review","value":"Denne lenken er ufullstendig. Be eieren om en ny."}},"pl":{"stringUnit":{"state":"needs_review","value":"Ten link jest niekompletny. Poproś właściciela o nowy."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Este link está incompleto. Peça um novo ao dono."}},"ru":{"stringUnit":{"state":"needs_review","value":"Ссылка неполная. Попросите у владельца новую."}},"th":{"stringUnit":{"state":"needs_review","value":"ลิงก์นี้ไม่สมบูรณ์ ขอลิงก์ใหม่จากเจ้าของ"}},"tr":{"stringUnit":{"state":"needs_review","value":"Bu bağlantı eksik. Sahibinden yenisini iste."}},"uk":{"stringUnit":{"state":"needs_review","value":"Посилання неповне. Попросіть у власника нове."}},"vi":{"stringUnit":{"state":"needs_review","value":"Liên kết này không đầy đủ. Hãy xin chủ sở hữu một liên kết mới."}}}},
