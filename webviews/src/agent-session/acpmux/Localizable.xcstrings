          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferdig, men cmux kan ikke kjøre den ennå"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończono, ale cmux nie może go jeszcze uruchomić"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concluído, mas o cmux ainda não consegue executá-lo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово, но cmux пока не может его запустить"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสร็จแล้ว แต่ cmux ยังเรียกใช้ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlandı, ancak cmux henüz çalıştıramıyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово, але cmux ще не може його запустити"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xong, nhưng cmux chưa thể chạy nó"
          }
        },
        "zh-Hans": {
