    "workflow.historyLimited": {"comment":"Agent pane: the daemon retained only recent workflow transcript history; the omitted count is unknown","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Only recent transcript history is available."}},"ar":{"stringUnit":{"state":"translated","value":"يتوفر السجل الحديث للمحادثة فقط."}},"bs":{"stringUnit":{"state":"translated","value":"Dostupan je samo noviji dio historije razgovora."}},"da":{"stringUnit":{"state":"translated","value":"Kun den seneste samtalehistorik er tilgængelig."}},"de":{"stringUnit":{"state":"translated","value":"Nur der neueste Gesprächsverlauf ist verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"Solo está disponible el historial reciente de la conversación."}},"fr":{"stringUnit":{"state":"translated","value":"Seul l’historique récent de la conversation est disponible."}},"it":{"stringUnit":{"state":"translated","value":"È disponibile solo la cronologia recente della conversazione."}},"ja":{"stringUnit":{"state":"translated","value":"会話履歴は最近の分のみ利用できます。"}},"km":{"stringUnit":{"state":"translated","value":"មានតែប្រវត្តិសន្ទនាថ្មីៗប៉ុណ្ណោះ។"}},"ko":{"stringUnit":{"state":"translated","value":"최근 대화 기록만 볼 수 있습니다."}},"nb":{"stringUnit":{"state":"translated","value":"Bare den nyeste samtalehistorikken er tilgjengelig."}},"pl":{"stringUnit":{"state":"translated","value":"Dostępna jest tylko najnowsza historia rozmowy."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Apenas o histórico recente da conversa está disponível."}},"ru":{"stringUnit":{"state":"translated","value":"Доступна только недавняя история разговора."}},"th":{"stringUnit":{"state":"translated","value":"มีเฉพาะประวัติการสนทนาล่าสุดเท่านั้น"}},"tr":{"stringUnit":{"state":"translated","value":"Yalnızca son konuşma geçmişi kullanılabilir."}},"uk":{"stringUnit":{"state":"translated","value":"Доступна лише нещодавня історія розмови."}},"vi":{"stringUnit":{"state":"translated","value":