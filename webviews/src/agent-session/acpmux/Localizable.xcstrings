    "newTab.nowPlaying.hide": {
      "comment": "Agent pane: New Tab page Now Playing card right-click menu item that turns the player off on the New Tab page (a setting).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخفاء قيد التشغيل الآن"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakrij Sada se reproducira"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjul Afspilles nu"
          }
        },
        "de": {
          "stringUnit": {
