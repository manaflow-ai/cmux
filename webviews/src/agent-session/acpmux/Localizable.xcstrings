          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットは利用できません。削除されたか、接続されていないマシン上にあります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការជជែកនេះមិនអាចប្រើបានទេ។ វាត្រូវបានលុប ឬស្ថិតនៅលើម៉ាស៊ីនដែលមិនបានតភ្ជាប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 채팅을 사용할 수 없습니다. 삭제되었거나 연결되지 않은 기기에 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne chatten er ikke tilgjengelig. Den ble slettet, eller den er på en maskin som ikke er tilkoblet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten czat jest niedostępny. Został usunięty albo znajduje się na komputerze, który nie jest połączony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
