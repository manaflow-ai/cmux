    "secret.private": {
      "comment": "Agent pane: an agent's secret card (cx-ncc.42)",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خاص: يحصل الوكيل على مرجع لمرة واحدة، وليس على القيمة أبدًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Privatno: agent dobija jednokratnu referencu, nikad vrijednost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Privat: agenten får en engangsreference, aldrig værdien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Privat: Der Agent erhält einen einmaligen Verweis, nie den Wert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private: the agent gets a one-time reference, never the value."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Privado: el agente recibe una referencia de un solo uso, nunca el valor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Privé : l’agent reçoit une référence à usage unique, jamais la valeur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Privato: l’agente riceve un riferimento monouso, mai il valore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非公開: エージェントが受け取るのは一度だけ使える参照で、値そのものは渡りません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឯកជន៖ ភ្នាក់ងារទទួលបានឯកសារយោងប្រើតែម្តង មិនដែលទទួលបានតម្លៃទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비공개: 에이전트는 값이 아닌 일회용 참조만 받습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Privat: agenten får en engangsreferanse, aldri verdien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prywatne: agent dostaje jednorazowe odwołanie, nigdy wartość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Privado: o agente recebe uma referência de uso único, nunca o valor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфиденциально: агент получает одноразовую ссылку, но не само значение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่วนตัว: เอเจนต์ได้รับเพียงการอ้างอิงแบบใช้ครั้งเดียว ไม่ได้รับค่าจริง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizli: ajan değeri değil, tek kullanımlık bir başvuru alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приватно: агент отримує одноразове посилання, а не саме значення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Riêng tư: tác tử chỉ nhận một tham chiếu dùng một lần, không bao giờ nhận giá trị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保密：代理只会得到一次性引用，绝不会得到值本身。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保密：代理只會取得一次性參照，絕不會取得值本身。"
          }
        }
      }
    },
