    "turn.signIn.pasteCode": {
      "comment": "Agent pane: Cloud sign-in card, what to do after Claude's sign-in page opened.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Approve in your browser, then paste the code it shows." } },
        "ar": { "stringUnit": { "state": "translated", "value": "وافق في المتصفح، ثم الصق الرمز الذي يظهر." } },
        "bs": { "stringUnit": { "state": "translated", "value": "Odobri u pregledniku, a zatim zalijepi kod koji se prikaže." } },
        "da": { "stringUnit": { "state": "translated", "value": "Godkend i din browser, og indsæt så den kode, den viser." } },
        "de": { "stringUnit": { "state": "translated", "value": "Im Browser bestätigen und dann den angezeigten Code einfügen." } },
        "es": { "stringUnit": { "state": "translated", "value": "Aprueba en el navegador y pega el código que aparece." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Approuvez dans votre navigateur, puis collez le code affiché." } },
        "it": { "stringUnit": { "state": "translated", "value": "Approva nel browser, poi incolla il codice mostrato." } },
        "ja": { "stringUnit": { "state": "translated", "value": "ブラウザで承認し、表示されたコードを貼り付けてください。" } },
        "km": { "stringUnit": { "state": "translated", "value": "យល់ព្រមក្នុងកម្មវិធីរុករក រួចបិទភ្ជាប់កូដដែលវាបង្ហាញ។" } },
        "ko": { "stringUnit": { "state": "translated", "value": "브라우저에서 승인한 뒤 표시된 코드를 붙여 넣으세요." } },
        "nb": { "stringUnit": { "state": "translated", "value": "Godkjenn i nettleseren, og lim inn koden den viser." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Zatwierdź w przeglądarce, a potem wklej wyświetlony kod." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Aprove no navegador e cole o código exibido." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Подтвердите в браузере, затем вставьте показанный код." } },
        "th": { "stringUnit": { "state": "translated", "value": "อนุมัติในเบราว์เซอร์ แล้ววางรหัสที่แสดง" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Tarayıcınızda onaylayın, ardından gösterilen kodu yapıştırın." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Підтвердьте в браузері, потім вставте показаний код." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Phê duyệt trong trình duyệt, rồi dán mã được hiển thị." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "在浏览器中批准，然后粘贴显示的代码。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "在瀏覽器中核准，然後貼上顯示的代碼。" } }
      }
    },
