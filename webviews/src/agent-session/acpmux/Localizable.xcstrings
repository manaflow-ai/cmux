            "value": "Ovaj chat nema folder na ovom Macu, pa cmux ovdje ne može za njega uraditi commit ili push."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne chat har ingen mappe på denne Mac, så cmux kan ikke committe eller pushe for den her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Chat hat keinen Ordner auf diesem Mac, daher kann cmux hier nicht für ihn committen oder pushen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This chat has no folder on this Mac, so cmux cannot commit or push for it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este chat no tiene carpeta en este Mac, así que cmux no puede confirmar ni enviar por él aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette conversation n’a pas de dossier sur ce Mac, cmux ne peut donc pas valider ni pousser pour elle ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questa chat non ha una cartella su questo Mac, quindi cmux non può eseguire commit o push qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットにはこの Mac 上のフォルダがないため、cmux はここでコミットやプッシュを実行できません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការជជែកនេះមិនមានថតនៅលើ Mac នេះទេ ដូច្នេះ cmux មិនអាច Commit ឬ Push សម្រាប់វានៅទីនេះបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 채팅에는 이 Mac에 폴더가 없으므로 cmux가 여기에서 커밋하거나 푸시할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne chatten har ingen mappe på denne Macen, så cmux kan ikke committe eller pushe for den her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten czat nie ma folderu na tym Macu, więc cmux nie może tu dla niego zatwierdzać ani wypychać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este chat não tem uma pasta neste Mac, então o cmux não pode fazer commit nem push para ele aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У этого чата нет папки на этом Mac, поэтому cmux не может выполнить здесь коммит или отправку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แชทนี้ไม่มีโฟลเดอร์บน Mac เครื่องนี้ cmux จึงคอมมิตหรือพุชให้แชทนี้จากที่นี่ไม่ได้"
          }
