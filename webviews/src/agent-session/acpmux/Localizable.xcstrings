      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أضف إلى قائمة الانتظار؛ يُرسل بعد هذا الدور (Return)"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stavi u red; šalje se nakon ovog poteza (Return)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sæt i kø; sendes efter denne tur (Return)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Einreihen; wird nach diesem Durchgang gesendet (Return)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queue; sends after this turn (Return)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poner en cola; se envía después de este turno (Return)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mettre en file ; envoyé après ce tour (Return)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metti in coda; inviato dopo questo turno (Return)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "キューに追加。このターンの後に送信 (Return)"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ដាក់ក្នុងជួរ; ផ្ញើក្រោយវេននេះ (Return)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "대기열에 추가. 이 턴 후에 보냅니다 (Return)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sett i kø; sendes etter denne runden (Return)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dodaj do kolejki; wyśle się po tej turze (Return)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pôr na fila; envia depois deste turno (Return)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В очередь; отправится после этого хода (Return)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เข้าคิว ส่งหลังรอบนี้ (Return)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sıraya ekle; bu turdan sonra gönderilir (Return)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У чергу; надішлеться після цього ходу (Return)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
