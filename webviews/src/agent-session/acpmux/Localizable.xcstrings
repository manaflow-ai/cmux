    "turn.signIn.error.badCode": {
      "comment": "Agent pane: Cloud sign-in card, the pasted code was refused.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "That code didn't work. Try again." } },
        "ar": { "stringUnit": { "state": "translated", "value": "لم يعمل هذا الرمز. حاول مرة أخرى." } },
        "bs": { "stringUnit": { "state": "translated", "value": "Taj kod nije uspio. Pokušaj ponovo." } },
        "da": { "stringUnit": { "state": "translated", "value": "Den kode virkede ikke. Prøv igen." } },
        "de": { "stringUnit": { "state": "translated", "value": "Dieser Code hat nicht funktioniert. Versuche es erneut." } },
        "es": { "stringUnit": { "state": "translated", "value": "Ese código no funcionó. Inténtalo de nuevo." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Ce code n’a pas fonctionné. Réessayez." } },
        "it": { "stringUnit": { "state": "translated", "value": "Quel codice non ha funzionato. Riprova." } },
        "ja": { "stringUnit": { "state": "translated", "value": "そのコードは使えませんでした。もう一度お試しください。" } },
        "km": { "stringUnit": { "state": "translated", "value": "កូដនោះមិនដំណើរការទេ។ សូមព្យាយាមម្ដងទៀត។" } },
        "ko": { "stringUnit": { "state": "translated", "value": "그 코드는 작동하지 않았습니다. 다시 시도하세요." } },
        "nb": { "stringUnit": { "state": "translated", "value": "Den koden fungerte ikke. Prøv igjen." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Ten kod nie zadziałał. Spróbuj ponownie." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Esse código não funcionou. Tente novamente." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Этот код не подошёл. Попробуйте ещё раз." } },
        "th": { "stringUnit": { "state": "translated", "value": "รหัสนั้นใช้ไม่ได้ ลองอีกครั้ง" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Bu kod işe yaramadı. Tekrar deneyin." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Цей код не спрацював. Спробуйте ще раз." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Mã đó không dùng được. Hãy thử lại." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "该代码无效。请重试。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "該代碼無效。請再試一次。" } }
      }
    },
    "turn.signIn.error.expired": {
      "comment": "Agent pane: Cloud sign-in card, the sign-in lapsed before it finished.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The sign-in expired. Start again." } },
        "ar": { "stringUnit": { "state": "translated", "value": "انتهت صلاحية تسجيل الدخول. ابدأ من جديد." } },
        "bs": { "stringUnit": { "state": "translated", "value": "Prijava je istekla. Počni ponovo." } },
        "da": { "stringUnit": { "state": "translated", "value": "Login udløb. Start forfra." } },
        "de": { "stringUnit": { "state": "translated", "value": "Die Anmeldung ist abgelaufen. Beginne von vorn." } },
        "es": { "stringUnit": { "state": "translated", "value": "El inicio de sesión caducó. Empieza de nuevo." } },
        "fr": { "stringUnit": { "state": "translated", "value": "La connexion a expiré. Recommencez." } },
        "it": { "stringUnit": { "state": "translated", "value": "L’accesso è scaduto. Ricomincia." } },
        "ja": { "stringUnit": { "state": "translated", "value": "サインインの有効期限が切れました。最初からやり直してください。" } },
        "km": { "stringUnit": { "state": "translated", "value": "ការចូលបានផុតកំណត់។ ចាប់ផ្ដើមម្ដងទៀត។" } },
        "ko": { "stringUnit": { "state": "translated", "value": "로그인이 만료되었습니다. 다시 시작하세요." } },
        "nb": { "stringUnit": { "state": "translated", "value": "Påloggingen utløp. Start på nytt." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Logowanie wygasło. Zacznij od nowa." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "O acesso expirou. Comece novamente." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Время входа истекло. Начните заново." } },
        "th": { "stringUnit": { "state": "translated", "value": "การลงชื่อเข้าใช้หมดอายุ เริ่มใหม่อีกครั้ง" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Oturum açma süresi doldu. Yeniden başlayın." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Час входу минув. Почніть знову." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Phiên đăng nhập đã hết hạn. Hãy bắt đầu lại." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "登录已过期。请重新开始。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "登入已逾期。請重新開始。" } }
      }
    },
    "turn.signIn.error.sharedMachine": {
      "comment": "Agent pane: Cloud sign-in card, the chat's machine is shared with a team, so it takes no personal sign-in.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This is a shared team machine; sign-in is only available on your own machine." } },
        "ar": { "stringUnit": { "state": "translated", "value": "هذا جهاز فريق مشترك؛ تسجيل الدخول متاح فقط على جهازك الخاص." } },
        "bs": { "stringUnit": { "state": "translated", "value": "Ovo je zajednička timska mašina; prijava je dostupna samo na tvojoj mašini." } },
        "da": { "stringUnit": { "state": "translated", "value": "Dette er en delt teammaskine; login er kun muligt på din egen maskine." } },
        "de": { "stringUnit": { "state": "translated", "value": "Dies ist eine gemeinsame Team-Maschine; Anmelden geht nur auf deiner eigenen Maschine." } },
        "es": { "stringUnit": { "state": "translated", "value": "Esta es una máquina compartida del equipo; solo puedes iniciar sesión en tu propia máquina." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Il s’agit d’une machine d’équipe partagée ; la connexion n’est possible que sur votre propre machine." } },
        "it": { "stringUnit": { "state": "translated", "value": "Questa è una macchina condivisa del team; l’accesso è disponibile solo sulla tua macchina." } },
        "ja": { "stringUnit": { "state": "translated", "value": "これはチームの共有マシンです。サインインは自分のマシンでのみ利用できます。" } },
        "km": { "stringUnit": { "state": "translated", "value": "នេះជាម៉ាស៊ីនក្រុមរួម; ការចូលមានតែលើម៉ាស៊ីនផ្ទាល់ខ្លួនរបស់អ្នកប៉ុណ្ណោះ។" } },
        "ko": { "stringUnit": { "state": "translated", "value": "팀 공유 머신입니다. 로그인은 내 머신에서만 할 수 있습니다." } },
        "nb": { "stringUnit": { "state": "translated", "value": "Dette er en delt teammaskin; pålogging er bare mulig på din egen maskin." } },
        "pl": { "stringUnit": { "state": "translated", "value": "To wspólna maszyna zespołu; logowanie jest dostępne tylko na Twojej maszynie." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Esta é uma máquina compartilhada da equipe; o acesso só está disponível na sua própria máquina." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Это общая машина команды; вход доступен только на вашей собственной машине." } },
        "th": { "stringUnit": { "state": "translated", "value": "นี่คือเครื่องที่ทีมใช้ร่วมกัน ลงชื่อเข้าใช้ได้เฉพาะบนเครื่องของคุณเอง" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Bu, ekibin ortak makinesi; oturum açma yalnızca kendi makinenizde kullanılabilir." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Це спільна машина команди; вхід доступний лише на вашій власній машині." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Đây là máy dùng chung của nhóm; chỉ có thể đăng nhập trên máy của riêng bạn." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "这是团队共享的机器；只能在你自己的机器上登录。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "這是團隊共用的機器；只能在你自己的機器上登入。" } }
      }
    },
    "turn.signIn.error.cliMissing": {
