            "state": "needs_review",
            "value": "편집 1개는 실행 취소할 수 없어 건너뜁니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 endring kan ikke angres og hoppes over."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 zmiany nie można cofnąć i zostanie pominięta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 edição não pode ser desfeita e será ignorada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 правку нельзя отменить, она будет пропущена."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 การแก้ไขเลิกทำไม่ได้และจะถูกข้าม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 düzenleme geri alınamaz ve atlanacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 правку не можна скасувати, її буде пропущено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 chỉnh sửa không thể hoàn tác và sẽ bị bỏ qua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
