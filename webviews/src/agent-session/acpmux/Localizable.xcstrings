        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gönderilmedi. Göndermek için Yeniden Dene'ye basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
