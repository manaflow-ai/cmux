    "harness.needsEnable": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} مصدره {folder}. فعّله لتشغيله في هذا المجلد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} dolazi iz {folder}. Omogući ga da bi radio u ovom folderu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} kommer fra {folder}. Aktivér den for at køre den i denne mappe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} stammt aus {folder}. Aktiviere es, um es in diesem Ordner auszuführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{agent} comes from {folder}. Enable it to run it in this folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} viene de {folder}. Actívalo para ejecutarlo en esta carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} provient de {folder}. Activez-le pour l'exécuter dans ce dossier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} proviene da {folder}. Attivalo per eseguirlo in questa cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{agent} は {folder} のハーネスです。このフォルダで使うには有効にしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} មកពី {folder}។ សូមបើកវា ដើម្បីដំណើរការក្នុងថតនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent}은(는) {folder}에서 왔습니다. 이 폴더에서 실행하려면 사용하도록 설정하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} kommer fra {folder}. Aktiver den for å kjøre den i denne mappen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} pochodzi z {folder}. Włącz go, aby działał w tym folderze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} vem de {folder}. Ative-o para executá-lo nesta pasta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} взят из {folder}. Включите его, чтобы запускать в этой папке."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} มาจาก {folder} เปิดใช้เพื่อเรียกใช้ในโฟลเดอร์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent}, {folder} klasöründen geliyor. Bu klasörde çalıştırmak için etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} походить із {folder}. Увімкніть його, щоб запускати в цій папці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} đến từ {folder}. Hãy bật nó để chạy trong thư mục này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} 来自 {folder}。启用后才能在此文件夹中运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} 來自 {folder}。啟用後才能在此資料夾中執行。"
          }
        }
      }
    },
    "harness.needsTrust": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} مصدره {folder}. أجب أولًا عن سؤال الثقة لهذا المجلد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} dolazi iz {folder}. Prvo odgovori na pitanje o povjerenju za folder."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} kommer fra {folder}. Besvar først mappens spørgsmål om tillid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} stammt aus {folder}. Beantworte zuerst die Vertrauensfrage des Ordners."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{agent} comes from {folder}. Answer the folder's Trust question first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} viene de {folder}. Primero responde a la pregunta de confianza de la carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} provient de {folder}. Répondez d'abord à la question de confiance du dossier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} proviene da {folder}. Rispondi prima alla domanda di fiducia della cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{agent} は {folder} のハーネスです。先にこのフォルダの「信頼」の確認に答えてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} មកពី {folder}។ សូមឆ្លើយសំណួរទុកចិត្តរបស់ថតជាមុនសិន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent}은(는) {folder}에서 왔습니다. 먼저 폴더의 신뢰 질문에 답하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} kommer fra {folder}. Svar først på mappens spørsmål om tillit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} pochodzi z {folder}. Najpierw odpowiedz na pytanie o zaufanie do folderu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} vem de {folder}. Responda primeiro à pergunta de confiança da pasta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} взят из {folder}. Сначала ответьте на вопрос о доверии к папке."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} มาจาก {folder} ตอบคำถามเรื่องความเชื่อถือของโฟลเดอร์ก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent}, {folder} klasöründen geliyor. Önce klasörün güven sorusunu yanıtlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} походить із {folder}. Спершу дайте відповідь на запитання про довіру до папки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} đến từ {folder}. Hãy trả lời câu hỏi tin cậy của thư mục trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} 来自 {folder}。请先回答该文件夹的信任问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{agent} 來自 {folder}。請先回答此資料夾的信任問題。"
          }
        }
      }
    },
