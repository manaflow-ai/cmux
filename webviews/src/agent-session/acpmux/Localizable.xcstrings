        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sign-in expired. Sign in again to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu sesión ha caducado. Vuelve a iniciar sesión para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre session a expiré. Reconnectez-vous pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il tuo accesso è scaduto. Accedi di nuovo per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サインインの有効期限が切れました。続行するにはもう一度サインインしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការចូលគណនីរបស់អ្នកបានផុតកំណត់។ ចូលគណនីម្ដងទៀតដើម្បីបន្ត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "로그인이 만료되었습니다. 계속하려면 다시 로그인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Innloggingen din er utløpt. Logg inn på nytt for å fortsette."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Logowanie wygasło. Zaloguj się ponownie, aby kontynuować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sua sessão expirou. Entre novamente para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Срок действия входа истёк. Войдите снова, чтобы продолжить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เซสชันการลงชื่อเข้าใช้หมดอายุแล้ว ลงชื่อเข้าใช้อีกครั้งเพื่อดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
