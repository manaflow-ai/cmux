    "git.push.branchNotFound": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يعد الفرع موجودًا. حدّث لرؤية الحالة الحالية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Grana više ne postoji. Osvježite da vidite trenutno stanje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Grenen findes ikke længere. Opdater for at se den aktuelle tilstand."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
