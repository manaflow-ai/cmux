    "retry.retriedOut": {"comment":"Agent pane: after a failed subagent's 'Subagent failed: {name}' line and ' · ', that acpmux retried it and stopped (subagents/SubagentDoneLine.tsx); {of} is how many tries it made; lowercase, as a phrase in the line","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"gave up after {of} tries"}},"ar":{"stringUnit":{"state":"needs_review","value":"توقف بعد {of} محاولات"}},"bs":{"stringUnit":{"state":"needs_review","value":"odustao nakon {of} pokušaja"}},"da":{"stringUnit":{"state":"needs_review","value":"opgav efter {of} forsøg"}},"de":{"stringUnit":{"state":"needs_review","value":"nach {of} Versuchen aufgegeben"}},"es":{"stringUnit":{"state":"needs_review","value":"abandonado tras {of} intentos"}},"fr":{"stringUnit":{"state":"needs_review","value":"abandon après {of} tentatives"}},"it":{"stringUnit":{"state":"needs_review","value":"rinuncia dopo {of} tentativi"}},"ja":{"stringUnit":{"state":"needs_review","value":"{of} 回試行して中止"}},"km":{"stringUnit":{"state":"needs_review","value":"បោះបង់បន្ទាប់ពីព្យាយាម {of} ដង"}},"ko":{"stringUnit":{"state":"needs_review","value":"{of}회 시도 후 중단"}},"nb":{"stringUnit":{"state":"needs_review","value":"ga opp etter {of} forsøk"}},"pl":{"stringUnit":{"state":"needs_review","value":"przerwano po {of} próbach"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"desistiu após {of} tentativas"}},"ru":{"stringUnit":{"state":"needs_review","value":"прекращено после {of} попыток"}},"th":{"stringUnit":{"state":"needs_review","value":"เลิกหลังลอง {of} ครั้ง"}},"tr":{"stringUnit":{"state":"needs_review","value":"{of} denemeden sonra bırakıldı"}},"uk":{"stringUnit":{"state":"needs_review","value":"припинено після {of} спроб"}},"vi":{"stringUnit":{"state":"needs_review","value":"bỏ cuộc sau {of} lần thử"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"尝试 {of} 次后放弃"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"嘗試 {of} 次後放棄"}}}},
