    "host.retrying": {
      "comment": "Agent pane",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعيد cmux المحاولة تلقائيًا. يبقى الـ prompt هنا حتى يتصل acpmux."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux automatski pokušava ponovo. Vaš prompt ostaje ovdje dok se acpmux ne poveže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux prøver igen af sig selv. Din prompt bliver her, indtil acpmux har forbindelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux versucht es automatisch erneut. Dein Prompt bleibt hier, bis acpmux verbunden ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux tries again on its own. Your prompt stays here until acpmux connects."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux lo intenta de nuevo automáticamente. Tu prompt se queda aquí hasta que acpmux se conecte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux réessaie automatiquement. Votre prompt reste ici jusqu'à la connexion d'acpmux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux riprova da solo. Il prompt resta qui finché acpmux non si connette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux は自動で再試行します。acpmux に接続するまで、プロンプトはここに残ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux នឹងព្យាយាមម្តងទៀតដោយខ្លួនឯង។ ប្រអប់បញ្ចូលរបស់អ្នកនៅទីនេះរហូតដល់ acpmux តភ្ជាប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux가 자동으로 다시 시도합니다. acpmux가 연결될 때까지 프롬프트는 여기에 남아 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux prøver igjen av seg selv. Prompten din blir stående her til acpmux kobler til."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux spróbuje ponownie samodzielnie. Twój prompt zostaje tutaj, dopóki acpmux się nie połączy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cmux tenta novamente por conta própria. Seu prompt fica aqui até o acpmux conectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux повторит попытку сам. Ваш запрос останется здесь, пока не подключится acpmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux จะลองอีกครั้งเอง พรอมต์ของคุณจะอยู่ที่นี่จนกว่า acpmux จะเชื่อมต่อ"
