{
  "sourceLanguage" : "en",
  "strings" : {
    "subagents.relay" : {
      "comment" : "Agent pane: the prompt a subagent's own composer sends its chat when no id for the subagent is known; {name} is the subagent, {message} what the person typed, kept as is on the lines after",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send your subagent \"{name}\" the message below, word for word. If it can no longer take messages, say so.\n\n{message}"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسل إلى الوكيل الفرعي \"{name}\" الرسالة أدناه حرفيًا. إن لم يعد يستقبل الرسائل، فقل ذلك.\n\n{message}"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pošalji podagentu \"{name}\" poruku ispod, doslovno. Ako više ne prima poruke, reci to.\n\n{message}"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send din underagent \"{name}\" beskeden nedenfor, ord for ord. Hvis den ikke længere kan modtage beskeder, så sig det.\n\n{message}"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sende deinem Subagenten \"{name}\" die Nachricht unten, Wort für Wort. Kann er keine Nachrichten mehr annehmen, sag das.\n\n{message}"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía a tu subagente \"{name}\" el mensaje de abajo, palabra por palabra. Si ya no puede recibir mensajes, dilo.\n\n{message}"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie à ton sous-agent \"{name}\" le message ci-dessous, mot pour mot. S'il ne peut plus recevoir de messages, dis-le.\n\n{message}"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia al tuo subagente \"{name}\" il messaggio qui sotto, parola per parola. Se non può più ricevere messaggi, dillo.\n\n{message}"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブエージェント「{name}」 に下のメッセージをそのまま送ってください。もうメッセージを受け取れない場合は、そう伝えてください。\n\n{message}"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ផ្ញើសារខាងក្រោមទៅភ្នាក់ងាររង \"{name}\" ពាក្យដោយពាក្យ។ បើវាលែងទទួលសារបាន សូមប្រាប់។\n\n{message}"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하위 에이전트 \"{name}\"에게 아래 메시지를 그대로 보내세요. 더 이상 메시지를 받을 수 없다면 그렇다고 말해 주세요.\n\n{message}"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send underagenten \"{name}\" meldingen nedenfor, ord for ord. Hvis den ikke lenger kan ta imot meldinger, si fra.\n\n{message}"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyślij podagentowi \"{name}\" poniższą wiadomość, słowo w słowo. Jeśli nie może już przyjmować wiadomości, powiedz o tym.\n\n{message}"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie ao seu subagente \"{name}\" a mensagem abaixo, palavra por palavra. Se ele não puder mais receber mensagens, diga isso.\n\n{message}"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправь своему субагенту \"{name}\" сообщение ниже, слово в слово. Если он больше не принимает сообщения, так и скажи.\n\n{message}"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งข้อความด้านล่างถึงเอเจนต์ย่อย \"{name}\" แบบคำต่อคำ หากรับข้อความไม่ได้แล้ว ให้บอก\n\n{message}"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"{name}\" adlı alt ajanına aşağıdaki mesajı kelimesi kelimesine gönder. Artık mesaj alamıyorsa bunu söyle.\n\n{message}"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надішли своєму субагенту \"{name}\" повідомлення нижче, слово в слово. Якщо він більше не приймає повідомлень, так і скажи.\n\n{message}"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gửi cho subagent \"{name}\" tin nhắn bên dưới, nguyên văn. Nếu nó không còn nhận tin nhắn được, hãy nói vậy.\n\n{message}"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把下面的消息原样发给你的子代理“{name}”。如果它已无法再接收消息，请说明。\n\n{message}"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把下面的訊息原樣傳給你的子代理「{name}」。如果它已無法再接收訊息，請說明。\n\n{message}"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
