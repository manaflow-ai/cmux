{
  "sourceLanguage" : "en",
  "strings" : {
    "auth.key.expired" : {
      "comment" : "Agent pane: the composer's notice when the model provider expired the API key the agent uses; {provider} is the provider's name (OpenCode Go)",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت صلاحية مفتاح API الخاص بـ {provider}. أنشئ مفتاحًا جديدًا، ثم اختر «استبدال المفتاح»."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaš {provider} API ključ je istekao. Napravite novi ključ, pa odaberite Zamijeni ključ."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din {provider}-API-nøgle er udløbet. Opret en ny nøgle, og vælg derefter Erstat nøgle."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein {provider}-API-Schlüssel ist abgelaufen. Erstelle einen neuen Schlüssel und wähle dann „Schlüssel ersetzen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your {provider} API key expired. Create a new key, then choose Replace key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu clave de API de {provider} ha caducado. Crea una nueva y elige Reemplazar clave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre clé API {provider} a expiré. Créez une nouvelle clé, puis choisissez Remplacer la clé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua chiave API di {provider} è scaduta. Crea una nuova chiave, poi scegli Sostituisci chiave."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{provider} の API キーの有効期限が切れました。新しいキーを作成してから「キーを置き換える」を選んでください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "សោ API {provider} របស់អ្នកបានផុតកំណត់។ បង្កើតសោថ្មី រួចជ្រើស ប្ដូរសោ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{provider} API 키가 만료되었습니다. 새 키를 만든 다음 키 교체를 선택하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{provider}-API-nøkkelen din er utløpt. Lag en ny nøkkel, og velg så Bytt nøkkel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucz API {provider} wygasł. Utwórz nowy klucz, a potem wybierz Zastąp klucz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua chave de API do {provider} expirou. Crie uma nova chave e escolha Substituir chave."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Срок действия API-ключа {provider} истёк. Создайте новый ключ и выберите «Заменить ключ»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คีย์ API ของ {provider} หมดอายุแล้ว สร้างคีย์ใหม่ แล้วเลือก แทนที่คีย์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{provider} API anahtarınızın süresi doldu. Yeni bir anahtar oluşturun, ardından Anahtarı değiştir'i seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Термін дії API-ключа {provider} минув. Створіть новий ключ і виберіть «Замінити ключ»."
          }
