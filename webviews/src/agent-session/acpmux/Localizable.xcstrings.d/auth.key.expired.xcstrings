        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khóa API {provider} của bạn đã hết hạn. Hãy tạo khóa mới, rồi chọn Thay khóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 {provider} API 密钥已过期。请创建新密钥，然后选择“替换密钥”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 {provider} API 金鑰已過期。請建立新金鑰，然後選擇「替換金鑰」。"
