{
  "sourceLanguage" : "en",
  "strings" : {
    "turn.failure.cloudCredentialsExpired" : {
      "comment" : "Agent pane: a failed turn's note when the cloud provider credentials the agent uses expired or were refused and no refresh command is known; {harness} is the agent's name",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت صلاحية بيانات اعتماد مزوّد السحابة لـ {harness} أو رُفضت. سجّل الدخول مجددًا أو حدّث المفاتيح، ثم أعد المحاولة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akreditivi cloud provajdera za {harness} su istekli ili su odbijeni. Prijavite se ponovo ili ažurirajte ključeve, pa pokušajte ponovo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness}s legitimationsoplysninger til cloududbyderen er udløbet eller blev afvist. Log ind igen eller opdater nøglerne, og prøv så igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Cloud-Anbieter-Zugangsdaten von {harness} sind abgelaufen oder wurden abgelehnt. Melde dich neu an oder aktualisiere die Schlüssel und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness}'s cloud provider credentials expired or were refused. Sign in again or update the keys, then retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las credenciales del proveedor de nube de {harness} caducaron o fueron rechazadas. Vuelve a iniciar sesión o actualiza las claves y reintenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les identifiants du fournisseur cloud de {harness} ont expiré ou ont été refusés. Reconnectez-vous ou mettez à jour les clés, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le credenziali del provider cloud di {harness} sono scadute o rifiutate. Accedi di nuovo o aggiorna le chiavi, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness} のクラウドプロバイダの認証情報が期限切れか拒否されました。再度サインインするかキーを更新してから、再試行してください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អត្តសញ្ញាណអ្នកផ្ដល់ cloud របស់ {harness} ផុតកំណត់ ឬត្រូវបានបដិសេធ។ ចូលម្ដងទៀត ឬធ្វើបច្ចុប្បន្នភាពសោ រួចសាកម្ដងទៀត។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness}의 클라우드 제공자 자격 증명이 만료되었거나 거부되었습니다. 다시 로그인하거나 키를 업데이트한 뒤 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Påloggingsdataene for skyleverandøren til {harness} er utløpt eller ble avvist. Logg på igjen eller oppdater nøklene, og prøv igjen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dane logowania dostawcy chmury dla {harness} wygasły lub zostały odrzucone. Zaloguj się ponownie lub zaktualizuj klucze, potem spróbuj jeszcze raz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As credenciais do provedor de nuvem de {harness} expiraram ou foram recusadas. Entre de novo ou atualize as chaves e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учётные данные облачного провайдера для {harness} истекли или отклонены. Войдите снова или обновите ключи, затем повторите."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อมูลรับรองผู้ให้บริการคลาวด์ของ {harness} หมดอายุหรือถูกปฏิเสธ ลงชื่อเข้าใช้อีกครั้งหรืออัปเดตคีย์ แล้วลองใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness} için bulut sağlayıcı kimlik bilgilerinin süresi doldu ya da reddedildi. Yeniden oturum açın veya anahtarları güncelleyin, sonra yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Облікові дані хмарного провайдера для {harness} закінчилися або відхилені. Увійдіть знову або оновіть ключі, потім повторіть."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thông tin xác thực nhà cung cấp đám mây của {harness} đã hết hạn hoặc bị từ chối. Đăng nhập lại hoặc cập nhật khóa, rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness} 的云服务商凭据已过期或被拒绝。请重新登录或更新密钥，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness} 的雲端服務商憑證已過期或遭拒。請重新登入或更新金鑰，然後重試。"
          }
        }
      }
    }
  },
  "version" : "1.0"
