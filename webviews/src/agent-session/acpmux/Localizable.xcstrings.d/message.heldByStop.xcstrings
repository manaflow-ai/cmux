  "strings" : {
    "message.heldByStop" : {
      "comment" : "Agent pane: quiet note at the end of other agents' message lines while the person's Stop holds them in the chat's queue; Continue, or the person's next message, lets them in",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Held: you stopped this chat. Continue or send a message to let them in."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "محتجزة: أوقفت هذه المحادثة. تابع أو أرسل رسالة لإدخالها."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zadržano: zaustavili ste ovaj chat. Nastavite ili pošaljite poruku da ih pustite."
