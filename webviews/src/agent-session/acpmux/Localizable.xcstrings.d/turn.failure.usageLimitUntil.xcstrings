{
  "sourceLanguage" : "en",
  "strings" : {
    "turn.failure.usageLimitUntil" : {
      "comment" : "Agent pane: a failed turn's note when the agent's account used up a usage limit (Claude Code's weekly or session limit, Codex's usage limit; cmux#55066) and the refusal says when it resets; {harness} is the agent's name, {time} the reset as the agent or the local clock says it (\"Nov 27, 7am (UTC)\").",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بلغ حساب {harness} حد الاستخدام؛ يُعاد ضبطه {time}. استخدم وكيلًا آخر، أو سجّل الدخول بحساب آخر."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Račun za {harness} je dostigao ograničenje korištenja; resetuje se {time}. Koristi drugog agenta ili se prijavi drugim računom."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness}s konto har nået sin forbrugsgrænse; den nulstilles {time}. Brug en anden agent, eller log ind med en anden konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Konto von {harness} hat sein Nutzungslimit erreicht; es wird {time} zurückgesetzt. Nutze einen anderen Agenten oder melde dich mit einem anderen Konto an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness}'s account hit its usage limit; it resets {time}. Use another agent, or sign in with another account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuenta de {harness} alcanzó su límite de uso; se restablece {time}. Usa otro agente o inicia sesión con otra cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte {harness} a atteint sa limite d’utilisation ; elle se réinitialise {time}. Utilisez un autre agent ou connectez-vous avec un autre compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’account di {harness} ha raggiunto il limite di utilizzo; si azzera {time}. Usa un altro agente o accedi con un altro account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness} のアカウントが使用上限に達しました。リセットは {time} です。別のエージェントを使うか、別のアカウントでサインインしてください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "គណនី {harness} បានដល់ដែនកំណត់ការប្រើប្រាស់; វាកំណត់ឡើងវិញ {time}។ ប្រើភ្នាក់ងារផ្សេង ឬចូលដោយគណនីផ្សេង។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness} 계정이 사용 한도에 도달했습니다. {time} 초기화됩니다. 다른 에이전트를 사용하거나 다른 계정으로 로그인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontoen til {harness} har nådd bruksgrensen; den nullstilles {time}. Bruk en annen agent, eller logg på med en annen konto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto {harness} osiągnęło limit użycia; zresetuje się {time}. Użyj innego agenta albo zaloguj się innym kontem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conta de {harness} atingiu o limite de uso; ele é redefinido {time}. Use outro agente ou entre com outra conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккаунт {harness} исчерпал лимит использования; он сбросится {time}. Используйте другого агента или войдите в другой аккаунт."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บัญชี {harness} ใช้งานถึงขีดจำกัดแล้ว จะรีเซ็ต {time} ใช้เอเจนต์อื่น หรือลงชื่อเข้าด้วยบัญชีอื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness} hesabı kullanım sınırına ulaştı; sınır {time} sıfırlanır. Başka bir ajan kullanın ya da başka bir hesapla oturum açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обліковий запис {harness} вичерпав ліміт використання; він скинеться {time}. Скористайтеся іншим агентом або увійдіть з іншим обліковим записом."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tài khoản {harness} đã chạm giới hạn sử dụng; sẽ đặt lại {time}. Hãy dùng tác tử khác hoặc đăng nhập bằng tài khoản khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness} 的账户已达到使用上限，将于 {time} 重置。请使用其他智能体，或用其他账户登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness} 的帳號已達使用上限，將於 {time} 重設。請使用其他代理，或以其他帳號登入。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
