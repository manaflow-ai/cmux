{
  "sourceLanguage" : "en",
  "strings" : {
    "turn.failure.usageLimitUntil" : {
      "comment" : "Agent pane: a failed turn's note when the agent's account used up a usage limit (Claude Code's weekly or session limit, Codex's usage limit; cmux#55066) and the refusal says when it resets; {harness} is the agent's name, {time} the reset as the agent or the local clock says it (\"Nov 27, 7am (UTC)\").",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "وصل حساب {harness} إلى حد الاستخدام؛ يُعاد تعيينه {time}. استخدم وكيلًا آخر الآن، أو سجّل الدخول بحساب آخر."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Račun za {harness} je dostigao ograničenje korištenja; resetuje se {time}. Koristi drugog agenta odmah ili se prijavi drugim računom."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness}-kontoen har nået sin forbrugsgrænse; den nulstilles {time}. Brug en anden agent nu, eller log ind med en anden konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Konto von {harness} hat sein Nutzungslimit erreicht; es wird {time} zurückgesetzt. Nutze jetzt einen anderen Agenten oder melde dich mit einem anderen Konto an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness}'s account hit its usage limit; it resets {time}. Use another agent now, or sign in with another account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La cuenta de {harness} alcanzó su límite de uso; se restablece {time}. Usa otro agente ahora o inicia sesión con otra cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le compte {harness} a atteint sa limite d’utilisation ; elle se réinitialise {time}. Utilisez un autre agent maintenant, ou connectez-vous avec un autre compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’account di {harness} ha raggiunto il limite di utilizzo; si azzera {time}. Usa subito un altro agente o accedi con un altro account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness} のアカウントが使用上限に達しました。リセットは {time} です。今すぐ別のエージェントを使うか、別のアカウントでサインインしてください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "គណនី {harness} បានដល់ដែនកំណត់ប្រើប្រាស់; វានឹងកំណត់ឡើងវិញ {time}។ ប្រើភ្នាក់ងារផ្សេងឥឡូវ ឬចូលដោយគណនីផ្សេង។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness} 계정이 사용 한도에 도달했습니다. {time}에 초기화됩니다. 지금 다른 에이전트를 사용하거나 다른 계정으로 로그인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness}-kontoen har nådd bruksgrensen; den nullstilles {time}. Bruk en annen agent nå, eller logg inn med en annen konto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Konto {harness} osiągnęło limit użycia; zresetuje się {time}. Użyj teraz innego agenta albo zaloguj się innym kontem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A conta do {harness} atingiu o limite de uso; ele é redefinido {time}. Use outro agente agora ou entre com outra conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Аккаунт {harness} исчерпал лимит использования; он сбросится {time}. Используйте другого агента сейчас или войдите в другой аккаунт."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "บัญชี {harness} ใช้งานถึงขีดจำกัดแล้ว จะรีเซ็ต {time} ใช้เอเจนต์อื่นตอนนี้ หรือลงชื่อเข้าใช้ด้วยบัญชีอื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness} hesabı kullanım sınırına ulaştı; sınır {time} sıfırlanır. Şimdi başka bir ajan kullanın veya başka bir hesapla giriş yapın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Обліковий запис {harness} вичерпав ліміт використання; він скинеться {time}. Скористайтеся іншим агентом зараз або увійдіть в інший обліковий запис."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tài khoản {harness} đã chạm giới hạn sử dụng; giới hạn sẽ đặt lại {time}. Dùng agent khác ngay, hoặc đăng nhập bằng tài khoản khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness} 的账户已达到用量上限，将于 {time} 重置。现在请使用其他智能体，或用另一个账户登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness} 的帳戶已達到用量上限，將於 {time} 重設。現在請使用其他智慧代理，或以另一個帳戶登入。"
          }
        }
