{
  "sourceLanguage" : "en",
  "strings" : {
    "composer.cmuxResumeAmbiguous" : {
      "comment" : "Agent pane: inline refusal for /resume <ref> when several chats' session ids start with what the person pasted. {ref} is what they pasted.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبدأ أكثر من محادثة بـ {ref}. الصق جزءًا أطول من معرّف الجلسة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Više razgovora počinje sa {ref}. Zalijepite veći dio ID-a sesije."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mere end én chat starter med {ref}. Indsæt mere af sessions-id'et."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr als ein Chat beginnt mit {ref}. Füge mehr von der Sitzungs-ID ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More than one chat starts with {ref}. Paste more of the session id."
