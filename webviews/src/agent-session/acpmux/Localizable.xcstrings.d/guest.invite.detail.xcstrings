    "guest.invite.detail" : {
      "comment" : "Guest page, account invite: the join page's detail line; the visitor is signed in with their cmux account and joins as it. The role (view or talk) is known only after Join, so the approval note is conditional",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Join with your cmux account. If you can send messages, the owner approves each one."
          }
        },
