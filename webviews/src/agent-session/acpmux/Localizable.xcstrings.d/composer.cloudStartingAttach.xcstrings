{
  "sourceLanguage" : "en",
  "strings" : {
    "composer.cloudStartingAttach" : {
      "comment" : "Agent pane composer note when a file or a very large paste is refused while a new chat starts on a Cloud machine; typing stays open",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن إضافة الملفات واللصقات الكبيرة بعد فتح محادثة السحابة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datoteke i veliki zalijepljeni sadržaj mogu se dodati kada se otvori Cloud chat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer og store indsættelser kan tilføjes, når Cloud-chatten åbner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien und große Einfügungen kannst du hinzufügen, sobald der Cloud-Chat geöffnet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files and very large pastes can be added once the Cloud chat opens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrás añadir archivos y pegados muy grandes cuando se abra el chat en la nube."
