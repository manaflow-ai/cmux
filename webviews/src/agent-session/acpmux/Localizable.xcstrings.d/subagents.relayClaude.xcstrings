{
  "sourceLanguage" : "en",
  "strings" : {
    "subagents.relayClaude" : {
      "comment" : "Agent pane: the prompt a subagent's own composer sends its Claude Code chat when the subagent's agentId is not known yet (keep SendMessage as is); {name} is the subagent, {message} what the person typed, kept as is on the lines after",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use SendMessage to send your subagent \"{name}\" the message below, word for word. If it has finished, SendMessage resumes it.\n\n{message}"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم SendMessage لإرسال الرسالة أدناه حرفيًا إلى الوكيل الفرعي \"{name}\". إن كان قد انتهى، فإن SendMessage يستأنفه.\n\n{message}"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi SendMessage da podagentu \"{name}\" pošalješ poruku ispod, doslovno. Ako je završio, SendMessage ga nastavlja.\n\n{message}"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug SendMessage til at sende din underagent \"{name}\" beskeden nedenfor, ord for ord. Hvis den er færdig, genoptager SendMessage den.\n\n{message}"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sende deinem Subagenten \"{name}\" mit SendMessage die Nachricht unten, Wort für Wort. Ist er fertig, setzt SendMessage ihn fort.\n\n{message}"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa SendMessage para enviar a tu subagente \"{name}\" el mensaje de abajo, palabra por palabra. Si ya terminó, SendMessage lo reanuda.\n\n{message}"
          }
