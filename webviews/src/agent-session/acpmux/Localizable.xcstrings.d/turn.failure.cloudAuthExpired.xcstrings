{
  "sourceLanguage" : "en",
  "strings" : {
    "turn.failure.cloudAuthExpired" : {
      "comment" : "Agent pane: Cloud provider auth failure with an expired or revoked credential; do not reveal machine host.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness}’s provider credential has expired or been revoked on this Cloud machine. Set it up again to continue."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت صلاحية بيانات اعتماد مزوّد {harness} أو أُبطلت على جهاز Cloud هذا. أعد إعدادها للمتابعة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vjerodajnice provajdera {harness} na ovom Cloud računaru su istekle ili opozvane. Ponovo ih postavite."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udbyderlegitimationsoplysningerne for {harness} på denne Cloud-maskine er udløbet eller tilbagekaldt. Konfigurer dem igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldedaten für {harness} auf diesem Cloud-Computer sind abgelaufen oder wurden widerrufen. Richte sie erneut ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las credenciales del proveedor para {harness} en esta máquina de Cloud han caducado o se han revocado. Configúralas de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les identifiants fournisseur de {harness} sur cette machine Cloud ont expiré ou ont été révoqués. Configurez-les à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le credenziali del provider per {harness} su questa macchina Cloud sono scadute o revocate. Configurale di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Cloud マシンの {harness} のプロバイダー認証情報は期限切れまたは取り消されています。再設定してください。"
          }
