        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ព័ត៌មានសម្គាល់អ្នកផ្តល់សេវាសម្រាប់ {harness} នៅលើម៉ាស៊ីន Cloud នេះបានផុតកំណត់ ឬត្រូវបានដកហូត។ សូមរៀបចំវាម្តងទៀត។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Cloud 머신의 {harness} 제공업체 자격 증명이 만료되었거나 취소되었습니다. 다시 설정하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leverandørlegitimasjonen for {harness} på denne Cloud-maskinen har utløpt eller blitt tilbakekalt. Konfigurer den på nytt."
