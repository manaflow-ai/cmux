{
  "sourceLanguage" : "en",
  "strings" : {
    "subagents.restartPromptKind" : {
      "comment" : "Agent pane: the prompt Restart sends the chat's agent to run a stopped subagent again (subagents/restart.ts); {kind} is the subagent's type as the harness names it (Explore, general-purpose), kept as is; {name} is its name, {prompt} the prompt it was given, kept as is on the lines after",
