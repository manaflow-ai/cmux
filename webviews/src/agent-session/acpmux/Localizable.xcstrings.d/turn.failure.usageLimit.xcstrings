{
  "sourceLanguage" : "en",
  "strings" : {
    "turn.failure.usageLimit" : {
      "comment" : "Agent pane: a failed turn's note when the agent's account used up a usage limit and the refusal names no reset (cmux#55066); {harness} is the agent's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "وصل حساب {harness} إلى حد الاستخدام. استخدم وكيلًا آخر حتى يُعاد تعيينه، أو سجّل الدخول بحساب آخر."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Račun za {harness} je dostigao ograničenje korištenja. Koristi drugog agenta dok se ne resetuje ili se prijavi drugim računom."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness}-kontoen har nået sin forbrugsgrænse. Brug en anden agent, indtil den nulstilles, eller log ind med en anden konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Konto von {harness} hat sein Nutzungslimit erreicht. Nutze bis zum Zurücksetzen einen anderen Agenten oder melde dich mit einem anderen Konto an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness}'s account hit its usage limit. Use another agent until it resets, or sign in with another account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La cuenta de {harness} alcanzó su límite de uso. Usa otro agente hasta que se restablezca o inicia sesión con otra cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le compte {harness} a atteint sa limite d’utilisation. Utilisez un autre agent jusqu’à sa réinitialisation, ou connectez-vous avec un autre compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’account di {harness} ha raggiunto il limite di utilizzo. Usa un altro agente finché non si azzera o accedi con un altro account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness} のアカウントが使用上限に達しました。リセットされるまで別のエージェントを使うか、別のアカウントでサインインしてください。"
