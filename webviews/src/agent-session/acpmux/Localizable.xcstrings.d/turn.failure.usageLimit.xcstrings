{
  "sourceLanguage" : "en",
  "strings" : {
    "turn.failure.usageLimit" : {
      "comment" : "Agent pane: a failed turn's note when the agent's account used up a usage limit and the refusal names no reset (cmux#55066); {harness} is the agent's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "وصل حساب {harness} إلى حد الاستخدام؛ وتفشل كل رسالة بالطريقة نفسها حتى يُعاد تعيينه. استخدم وكيلًا آخر للمتابعة الآن، أو سجّل الدخول بحساب آخر."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Račun za {harness} je dostigao ograničenje korištenja; svaka poruka ne uspijeva na isti način dok se ne resetuje. Koristi drugog agenta da nastaviš odmah ili se prijavi drugim računom."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness}-kontoen har nået sin forbrugsgrænse; hver besked mislykkes på samme måde, indtil den nulstilles. Brug en anden agent for at fortsætte nu, eller log ind med en anden konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Konto von {harness} hat sein Nutzungslimit erreicht; bis zum Zurücksetzen scheitert jede Nachricht auf dieselbe Weise. Nutze einen anderen Agenten, um jetzt weiterzumachen, oder melde dich mit einem anderen Konto an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness}'s account hit its usage limit; every message fails the same way until it resets. Use another agent to keep going now, or sign in with another account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La cuenta de {harness} alcanzó su límite de uso; cada mensaje falla igual hasta que se restablezca. Usa otro agente para seguir ahora o inicia sesión con otra cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le compte {harness} a atteint sa limite d’utilisation ; chaque message échoue de la même façon jusqu’à sa réinitialisation. Utilisez un autre agent pour continuer maintenant, ou connectez-vous avec un autre compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’account di {harness} ha raggiunto il limite di utilizzo; ogni messaggio fallisce allo stesso modo finché non si azzera. Usa un altro agente per continuare subito o accedi con un altro account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness} のアカウントが使用上限に達しました。リセットされるまで、どのメッセージも同じように失敗します。今すぐ続けるには別のエージェントを使うか、別のアカウントでサインインしてください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "គណនី {harness} បានដល់ដែនកំណត់ប្រើប្រាស់; សារនីមួយៗនឹងបរាជ័យដូចគ្នា រហូតដល់វាកំណត់ឡើងវិញ។ ប្រើភ្នាក់ងារផ្សេងដើម្បីបន្តឥឡូវ ឬចូលដោយគណនីផ្សេង។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness} 계정이 사용 한도에 도달했습니다. 초기화될 때까지 모든 메시지가 같은 방식으로 실패합니다. 지금 계속하려면 다른 에이전트를 사용하거나 다른 계정으로 로그인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness}-kontoen har nådd bruksgrensen; hver melding mislykkes på samme måte til den nullstilles. Bruk en annen agent for å fortsette nå, eller logg inn med en annen konto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Konto {harness} osiągnęło limit użycia; każda wiadomość zakończy się tak samo, dopóki się nie zresetuje. Użyj innego agenta, aby kontynuować teraz, albo zaloguj się innym kontem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A conta do {harness} atingiu o limite de uso; toda mensagem falha do mesmo jeito até ele ser redefinido. Use outro agente para continuar agora ou entre com outra conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Аккаунт {harness} исчерпал лимит использования; до сброса каждое сообщение будет завершаться так же. Используйте другого агента, чтобы продолжить сейчас, или войдите в другой аккаунт."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "บัญชี {harness} ใช้งานถึงขีดจำกัดแล้ว ทุกข้อความจะล้มเหลวแบบเดียวกันจนกว่าจะรีเซ็ต ใช้เอเจนต์อื่นเพื่อทำต่อตอนนี้ หรือลงชื่อเข้าใช้ด้วยบัญชีอื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness} hesabı kullanım sınırına ulaştı; sıfırlanana kadar her mesaj aynı şekilde başarısız olur. Şimdi devam etmek için başka bir ajan kullanın veya başka bir hesapla giriş yapın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Обліковий запис {harness} вичерпав ліміт використання; до скидання кожне повідомлення завершуватиметься так само. Скористайтеся іншим агентом, щоб продовжити зараз, або увійдіть в інший обліковий запис."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tài khoản {harness} đã chạm giới hạn sử dụng; mọi tin nhắn đều thất bại như vậy cho đến khi giới hạn đặt lại. Dùng agent khác để tiếp tục ngay, hoặc đăng nhập bằng tài khoản khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness} 的账户已达到用量上限；在重置之前每条消息都会以同样方式失败。现在要继续，请使用其他智能体，或用另一个账户登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness} 的帳戶已達到用量上限；在重設之前每則訊息都會以同樣方式失敗。現在要繼續，請使用其他智慧代理，或以另一個帳戶登入。"
          }
        }
      }
    }
  },
  "version" : "1.0"
