{
  "sourceLanguage" : "en",
  "strings" : {
    "turn.failure.usageLimit" : {
      "comment" : "Agent pane: a failed turn's note when the agent's account used up a usage limit and the refusal names no reset (cmux#55066); {harness} is the agent's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بلغ حساب {harness} حد الاستخدام. استخدم وكيلًا آخر للمتابعة، أو سجّل الدخول بحساب آخر."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Račun za {harness} je dostigao ograničenje korištenja. Koristi drugog agenta da nastaviš ili se prijavi drugim računom."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness}s konto har nået sin forbrugsgrænse. Brug en anden agent for at fortsætte, eller log ind med en anden konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Konto von {harness} hat sein Nutzungslimit erreicht. Nutze einen anderen Agenten, um weiterzumachen, oder melde dich mit einem anderen Konto an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness}'s account hit its usage limit. Use another agent to keep going, or sign in with another account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuenta de {harness} alcanzó su límite de uso. Usa otro agente para seguir o inicia sesión con otra cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte {harness} a atteint sa limite d’utilisation. Utilisez un autre agent pour continuer, ou connectez-vous avec un autre compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’account di {harness} ha raggiunto il limite di utilizzo. Usa un altro agente per continuare o accedi con un altro account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness} のアカウントが使用上限に達しました。続けるには別のエージェントを使うか、別のアカウントでサインインしてください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "គណនី {harness} បានដល់ដែនកំណត់ការប្រើប្រាស់។ ប្រើភ្នាក់ងារផ្សេងដើម្បីបន្ត ឬចូលដោយគណនីផ្សេង។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness} 계정이 사용 한도에 도달했습니다. 계속하려면 다른 에이전트를 사용하거나 다른 계정으로 로그인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontoen til {harness} har nådd bruksgrensen. Bruk en annen agent for å fortsette, eller logg på med en annen konto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto {harness} osiągnęło limit użycia. Użyj innego agenta, aby kontynuować, albo zaloguj się innym kontem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conta de {harness} atingiu o limite de uso. Use outro agente para continuar ou entre com outra conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккаунт {harness} исчерпал лимит использования. Чтобы продолжить, используйте другого агента или войдите в другой аккаунт."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บัญชี {harness} ใช้งานถึงขีดจำกัดแล้ว ใช้เอเจนต์อื่นเพื่อทำต่อ หรือลงชื่อเข้าด้วยบัญชีอื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness} hesabı kullanım sınırına ulaştı. Devam etmek için başka bir ajan kullanın ya da başka bir hesapla oturum açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обліковий запис {harness} вичерпав ліміт використання. Щоб продовжити, скористайтеся іншим агентом або увійдіть з іншим обліковим записом."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tài khoản {harness} đã chạm giới hạn sử dụng. Hãy dùng tác tử khác để tiếp tục, hoặc đăng nhập bằng tài khoản khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness} 的账户已达到使用上限。请使用其他智能体继续，或用其他账户登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness} 的帳號已達使用上限。請使用其他代理繼續，或以其他帳號登入。"
          }
        }
      }
    }
  },
  "version" : "1.0"
