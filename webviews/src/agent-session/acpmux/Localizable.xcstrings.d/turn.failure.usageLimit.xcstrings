{
  "sourceLanguage" : "en",
  "strings" : {
    "turn.failure.usageLimit" : {
      "comment" : "Agent pane: a failed turn's note when the agent's account used up a usage limit and the refusal names no reset (cmux#55066); {harness} is the agent's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "وصل حساب {harness} إلى حد الاستخدام. استخدم وكيلًا آخر الآن، أو سجّل الدخول بحساب آخر."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Račun za {harness} je dostigao ograničenje korištenja. Koristi drugog agenta odmah ili se prijavi drugim računom."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness}-kontoen har nået sin forbrugsgrænse. Brug en anden agent nu, eller log ind med en anden konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Konto von {harness} hat sein Nutzungslimit erreicht. Nutze jetzt einen anderen Agenten oder melde dich mit einem anderen Konto an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness}'s account hit its usage limit. Use another agent now, or sign in with another account."
          }
