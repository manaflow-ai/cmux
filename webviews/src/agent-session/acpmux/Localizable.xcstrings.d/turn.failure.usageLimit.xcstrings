        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness} 계정이 사용 한도에 도달했습니다. 초기화될 때까지 다른 에이전트를 사용하거나 다른 계정으로 로그인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
