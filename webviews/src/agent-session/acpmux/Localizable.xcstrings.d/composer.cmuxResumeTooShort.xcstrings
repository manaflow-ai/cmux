{
  "sourceLanguage" : "en",
  "strings" : {
    "composer.cmuxResumeTooShort" : {
      "comment" : "Agent pane: inline refusal for /resume <ref> when the pasted session id start is shorter than 4 characters. {ref} is what the person pasted.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصق 4 أحرف على الأقل من معرّف الجلسة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zalijepite najmanje 4 znaka ID-a sesije."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indsæt mindst 4 tegn af sessions-id'et."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge mindestens 4 Zeichen der Sitzungs-ID ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste at least 4 characters of the session id."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega al menos 4 caracteres del ID de sesión."
          }
        },
