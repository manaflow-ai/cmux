        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vaš tim je dosegao ograničenje potrošnje, pa se nijedna Cloud mašina ne može pokrenuti. Administrator tima ga može povisiti, ili pokrenite ovaj chat na ovom Macu."
