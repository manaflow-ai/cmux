{
  "sourceLanguage" : "en",
  "strings" : {
    "picker.connectClaude.labelHint" : {
      "comment" : "Connect your Claude subscription dialog: help under the label field",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختياري، وإلا فسيظهر باسم اشتراك Claude"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neobavezno, inače se prikazuje kao Claude pretplata"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valgfrit, ellers vises det som Claude-abonnement"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional, sonst wird es als Claude-Abo angezeigt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional, otherwise shown as Claude subscription"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional; si no, se muestra como suscripción de Claude"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif, sinon affiché comme abonnement Claude"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facoltativo, altrimenti viene mostrato come abbonamento Claude"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "省略可。省略すると「Claude サブスクリプション」と表示されます"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ស្រេចចិត្ត បើមិនដូច្នោះទេ វានឹងបង្ហាញជា ការជាវ Claude"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택 사항이며, 비워 두면 Claude 구독으로 표시됩니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valgfritt, ellers vises det som Claude-abonnement"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcjonalnie, w przeciwnym razie wyświetlane jako subskrypcja Claude"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional; caso contrário, aparece como assinatura do Claude"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необязательно, иначе отображается как подписка Claude"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่บังคับ หากเว้นว่างจะแสดงเป็นการสมัครใช้งาน Claude"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İsteğe bağlı, aksi takdirde Claude aboneliği olarak gösterilir"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необов’язково, інакше показується як підписка Claude"
          }
