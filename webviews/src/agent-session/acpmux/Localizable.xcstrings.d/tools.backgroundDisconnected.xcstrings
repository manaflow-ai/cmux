{
  "sourceLanguage" : "en",
  "strings" : {
    "tools.backgroundDisconnected" : {
      "comment" : "Agent pane: a short notice above the composer after Ctrl-B when the connection to the agent was down or closed before it answered the request to move work to the background",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "انقطع الاتصال بالوكيل؛ حاول مجددًا عند عودته"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Veza s agentom je prekinuta; pokušajte ponovo kada se vrati"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Forbindelsen til agenten blev afbrudt; prøv igen, når den er tilbage"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Verbindung zum Agenten ist unterbrochen; versuche es erneut, wenn sie wieder steht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lost the connection to the agent; try again when it's back"
