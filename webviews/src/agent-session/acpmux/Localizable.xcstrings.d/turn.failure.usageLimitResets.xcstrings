{
  "sourceLanguage" : "en",
  "strings" : {
    "turn.failure.usageLimitResets" : {
      "comment" : "Agent pane: a failed turn's note when the agent used up a usage limit whose reset time the refusal names; {harness} is the agent's name, {time} the local date and time (with time zone) it resets.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "وصل {harness} إلى حد استخدام يُعاد تعيينه {time}. بدّل النموذج للمتابعة الآن، أو تابع بعد إعادة التعيين."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness} je dostigao ograničenje korištenja koje se resetuje {time}. Promijeni model da nastaviš odmah ili nastavi nakon resetovanja."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness} har nået en forbrugsgrænse, der nulstilles {time}. Skift model for at fortsætte nu, eller fortsæt, når den er nulstillet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness} hat ein Nutzungslimit erreicht, das am {time} zurückgesetzt wird. Wechsle das Modell, um jetzt weiterzumachen, oder mach nach dem Zurücksetzen weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness} reached a usage limit that resets {time}. Switch model to keep going now, or continue once it resets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness} alcanzó un límite de uso que se restablece el {time}. Cambia de modelo para seguir ahora o continúa cuando se restablezca."
          }
        },
        "fr" : {
          "stringUnit" : {
