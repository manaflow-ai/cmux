{
  "sourceLanguage" : "en",
  "strings" : {
    "askLedger.scope" : {
      "comment" : "Agent pane: experimental recent ask ledger scope or read error",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الطلبات الأخيرة منذ تشغيل هذه الخدمة. حتى 200 رسالة؛ تُعرض معاينة للرسائل الطويلة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedavni zahtjevi od pokretanja ovog demona. Do 200 poruka; duge poruke prikazuju pregled."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seneste anmodninger fra denne dæmonkørsel. Op til 200 beskeder; lange beskeder vises som forhåndsvisning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letzte Anfragen seit diesem Daemon-Start. Bis zu 200 Prompts; lange Prompts werden gekürzt angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recent asks from this daemon run. Up to 200 prompts; long prompts show a preview."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitudes recientes de esta ejecución del demonio. Hasta 200 mensajes; los largos muestran una vista previa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandes récentes depuis le démarrage de ce démon. Jusqu’à 200 messages ; les longs messages sont abrégés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richieste recenti da questo avvio del demone. Fino a 200 messaggi; quelli lunghi mostrano un’anteprima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデーモンの起動中に受け付けた最近の依頼です。最大200件まで表示し、長いプロンプトはプレビューを表示します。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "សំណើថ្មីៗពីការដំណើរការសេវានេះ។ រហូតដល់ 200 សារ; សារវែងបង្ហាញជាការមើលជាមុន។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 데몬 실행 중 받은 최근 요청입니다. 최대 200개까지 표시하며 긴 프롬프트는 미리보기로 표시합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nylige forespørsler fra denne daemonkjøringen. Opptil 200 meldinger; lange meldinger vises som forhåndsvisning."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostatnie prośby z bieżącego uruchomienia demona. Do 200 wiadomości; długie wiadomości mają podgląd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedidos recentes desta execução do daemon. Até 200 mensagens; mensagens longas mostram uma prévia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недавние запросы с момента запуска этого демона. До 200 сообщений; длинные сообщения показаны в сокращённом виде."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
