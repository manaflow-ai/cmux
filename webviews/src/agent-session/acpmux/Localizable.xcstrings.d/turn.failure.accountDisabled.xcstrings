{
  "sourceLanguage" : "en",
  "strings" : {
    "turn.failure.accountDisabled" : {
      "comment" : "Agent pane: a failed turn's note when the agent's provider disabled, suspended or banned its account (\"This organization has been disabled.\"; cmux#55066); {harness} is the agent's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقف مزوّد {harness} هذا الحساب (معطّل أو موقوف). استخدم وكيلًا آخر، أو سجّل الدخول بحساب آخر."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pružalac usluge {harness} je isključio ovaj račun (onemogućen ili suspendovan). Koristi drugog agenta ili se prijavi drugim računom."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness}s udbyder har slået denne konto fra (deaktiveret eller suspenderet). Brug en anden agent, eller log ind med en anden konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Anbieter von {harness} hat dieses Konto abgeschaltet (deaktiviert oder gesperrt). Nutze einen anderen Agenten oder melde dich mit einem anderen Konto an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness}'s provider turned this account off (disabled or suspended). Use another agent, or sign in with another account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El proveedor de {harness} desactivó esta cuenta (deshabilitada o suspendida). Usa otro agente o inicia sesión con otra cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fournisseur de {harness} a coupé ce compte (désactivé ou suspendu). Utilisez un autre agent ou connectez-vous avec un autre compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il provider di {harness} ha spento questo account (disattivato o sospeso). Usa un altro agente o accedi con un altro account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness} のプロバイダーがこのアカウントを停止しました（無効化または一時停止）。別のエージェントを使うか、別のアカウントでサインインしてください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកផ្ដល់សេវា {harness} បានបិទគណនីនេះ (បិទដំណើរការ ឬផ្អាក)។ ប្រើភ្នាក់ងារផ្សេង ឬចូលដោយគណនីផ្សេង។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness}의 제공자가 이 계정을 껐습니다(비활성화 또는 정지). 다른 에이전트를 사용하거나 다른 계정으로 로그인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leverandøren til {harness} har slått av denne kontoen (deaktivert eller suspendert). Bruk en annen agent, eller logg på med en annen konto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostawca {harness} wyłączył to konto (dezaktywowane lub zawieszone). Użyj innego agenta albo zaloguj się innym kontem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O provedor de {harness} desligou esta conta (desativada ou suspensa). Use outro agente ou entre com outra conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Провайдер {harness} отключил этот аккаунт (деактивирован или заблокирован). Используйте другого агента или войдите в другой аккаунт."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผู้ให้บริการของ {harness} ปิดบัญชีนี้แล้ว (ปิดใช้งานหรือระงับ) ใช้เอเจนต์อื่น หรือลงชื่อเข้าด้วยบัญชีอื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness} sağlayıcısı bu hesabı kapattı (devre dışı veya askıda). Başka bir ajan kullanın ya da başka bir hesapla oturum açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Провайдер {harness} вимкнув цей обліковий запис (деактивовано або призупинено). Скористайтеся іншим агентом або увійдіть з іншим обліковим записом."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhà cung cấp của {harness} đã tắt tài khoản này (bị vô hiệu hóa hoặc tạm ngưng). Hãy dùng tác tử khác hoặc đăng nhập bằng tài khoản khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness} 的提供方已停用此账户（已禁用或暂停）。请使用其他智能体，或用其他账户登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness} 的提供者已停用此帳號（已停用或暫停）。請使用其他代理，或以其他帳號登入。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
