{
  "sourceLanguage" : "en",
  "strings" : {
    "turn.failure.accountDisabled" : {
      "comment" : "Agent pane: a failed turn's note when the agent's provider disabled, suspended or banned its account (\"This organization has been disabled.\"; cmux#55066); {harness} is the agent's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أوقف مزوّد {harness} هذا الحساب. استخدم وكيلًا آخر، أو سجّل الدخول بحساب آخر."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pružatelj za {harness} je isključio ovaj račun. Koristi drugog agenta ili se prijavi drugim računom."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness}-udbyderen har slået denne konto fra. Brug en anden agent, eller log ind med en anden konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Anbieter von {harness} hat dieses Konto abgeschaltet. Nutze einen anderen Agenten oder melde dich mit einem anderen Konto an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness}'s provider turned this account off. Use another agent, or sign in with another account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El proveedor de {harness} desactivó esta cuenta. Usa otro agente o inicia sesión con otra cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le fournisseur de {harness} a désactivé ce compte. Utilisez un autre agent, ou connectez-vous avec un autre compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il provider di {harness} ha disattivato questo account. Usa un altro agente o accedi con un altro account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness} のプロバイダがこのアカウントを無効にしました。別のエージェントを使うか、別のアカウントでサインインしてください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "អ្នកផ្តល់សេវា {harness} បានបិទគណនីនេះ។ ប្រើភ្នាក់ងារផ្សេង ឬចូលដោយគណនីផ្សេង។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness} 제공업체가 이 계정을 사용 중지했습니다. 다른 에이전트를 사용하거나 다른 계정으로 로그인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness}-leverandøren har slått av denne kontoen. Bruk en annen agent, eller logg inn med en annen konto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dostawca {harness} wyłączył to konto. Użyj innego agenta albo zaloguj się innym kontem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O provedor do {harness} desativou esta conta. Use outro agente ou entre com outra conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Провайдер {harness} отключил этот аккаунт. Используйте другого агента или войдите в другой аккаунт."
          }
        },
        "th" : {
          "stringUnit" : {
