{
  "sourceLanguage" : "en",
  "strings" : {
    "turn.failure.accountDisabled" : {
      "comment" : "Agent pane: a failed turn's note when the agent's provider disabled, suspended or banned its account (\"This organization has been disabled.\"; cmux#55066); {harness} is the agent's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أوقف مزوّد {harness} هذا الحساب، فلا يمكن تشغيل أي رسالة. استخدم وكيلًا آخر، أو سجّل الدخول بحساب آخر."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pružalac za {harness} je isključio ovaj račun, pa nijedna poruka ne može raditi. Koristi drugog agenta ili se prijavi drugim računom."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness}-udbyderen har slået denne konto fra, så ingen besked kan køre. Brug en anden agent, eller log ind med en anden konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Anbieter von {harness} hat dieses Konto abgeschaltet, daher kann keine Nachricht laufen. Nutze einen anderen Agenten oder melde dich mit einem anderen Konto an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness}'s provider disabled this account, so no message can run. Use another agent, or sign in with another account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El proveedor de {harness} desactivó esta cuenta, así que ningún mensaje puede ejecutarse. Usa otro agente o inicia sesión con otra cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le fournisseur de {harness} a désactivé ce compte : aucun message ne peut s’exécuter. Utilisez un autre agent, ou connectez-vous avec un autre compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il fornitore di {harness} ha disattivato questo account, quindi nessun messaggio può essere eseguito. Usa un altro agente o accedi con un altro account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness} のプロバイダーがこのアカウントを停止したため、メッセージを実行できません。別のエージェントを使うか、別のアカウントでサインインしてください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "អ្នកផ្តល់សេវា {harness} បានបិទគណនីនេះ ដូច្នេះគ្មានសារណាអាចដំណើរការបានទេ។ ប្រើភ្នាក់ងារផ្សេង ឬចូលដោយគណនីផ្សេង។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness} 제공업체가 이 계정을 사용 중지해 메시지를 실행할 수 없습니다. 다른 에이전트를 사용하거나 다른 계정으로 로그인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness}-leverandøren har slått av denne kontoen, så ingen melding kan kjøre. Bruk en annen agent, eller logg inn med en annen konto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dostawca {harness} wyłączył to konto, więc żadna wiadomość nie może działać. Użyj innego agenta albo zaloguj się innym kontem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O provedor do {harness} desativou esta conta, então nenhuma mensagem pode rodar. Use outro agente ou entre com outra conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Провайдер {harness} отключил этот аккаунт, поэтому ни одно сообщение не может выполниться. Используйте другого агента или войдите в другой аккаунт."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ผู้ให้บริการ {harness} ปิดบัญชีนี้แล้ว จึงไม่มีข้อความใดทำงานได้ ใช้เอเจนต์อื่น หรือลงชื่อเข้าใช้ด้วยบัญชีอื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness} sağlayıcısı bu hesabı kapattı, bu yüzden hiçbir mesaj çalışamaz. Başka bir ajan kullanın veya başka bir hesapla giriş yapın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Постачальник {harness} вимкнув цей обліковий запис, тож жодне повідомлення не може виконатися. Скористайтеся іншим агентом або увійдіть в інший обліковий запис."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nhà cung cấp {harness} đã tắt tài khoản này, nên không tin nhắn nào chạy được. Dùng agent khác, hoặc đăng nhập bằng tài khoản khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness} 的服务提供方已停用此账户，因此无法运行任何消息。请使用其他智能体，或用另一个账户登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{harness} 的服務提供方已停用此帳戶，因此無法執行任何訊息。請使用其他智慧代理，或以另一個帳戶登入。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
