    "hybrid.auto.help" : {
      "comment" : "Agent pane, the cloud button's tooltip while it is off",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تنتقل إلى السحابة عند سكون هذا الـ Mac فقط إذا توفرت خانة. شغّل الخيار لتحصل هذه المحادثة على خانة أولًا."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prelazi u oblak kada ovaj Mac spava samo ako ima slobodnog mjesta. Uključite da ovaj razgovor prvi dobije mjesto."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Flytter kun til skyen, når denne Mac sover, hvis der er en ledig plads. Slå til for at give denne chat en plads først."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wechselt nur dann in die Cloud, wenn dieser Mac schläft und ein Platz frei ist. Einschalten, damit dieser Chat zuerst einen Platz bekommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves to Cloud when this Mac sleeps only if a slot is free. Turn on to give this chat a slot first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pasa a la nube cuando este Mac entra en reposo solo si hay un hueco libre. Actívalo para que este chat reciba un hueco primero."
