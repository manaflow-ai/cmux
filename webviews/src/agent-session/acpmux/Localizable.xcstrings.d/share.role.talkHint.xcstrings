{
  "sourceLanguage" : "en",
  "strings" : {
    "share.role.talkHint" : {
      "comment" : "Agent pane: Share dialog: line under the add-people field while the role picked is Can send, saying what it means",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تنتظر رسائلهم موافقتك قبل أن يراها الوكيل."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Njihove poruke čekaju tvoje odobrenje prije nego što ih agent vidi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deres beskeder venter på din godkendelse, før agenten ser dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ihre Nachrichten warten auf deine Freigabe, bevor der Agent sie sieht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Their messages wait for your approval before the agent sees them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sus mensajes esperan tu aprobación antes de que el agente los vea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Leurs messages attendent ton accord avant que l'agent les voie."
