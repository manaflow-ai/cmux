{
  "sourceLanguage" : "en",
  "strings" : {
    "hybrid.start.live.help" : {
      "comment" : "Agent pane, the three-state cloud control by the composer (hybrid start): tooltip once the chat runs on its Cloud machine",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تعمل هذه الدردشة على جهازها السحابي، وتستمر حتى عند إغلاق هذا الـ Mac."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ovaj chat radi na svojoj Cloud mašini i nastavlja kada zatvoriš ovaj Mac."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Denne chat kører på sin Cloud-maskine og fortsætter, når du lukker denne Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieser Chat läuft auf seiner Cloud-Maschine und läuft weiter, wenn du diesen Mac zuklappst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This chat runs on its Cloud machine and keeps going when you close this Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este chat se ejecuta en su máquina de Cloud y sigue cuando cierras este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ce chat tourne sur sa machine Cloud et continue quand vous fermez ce Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Questa chat gira sulla sua macchina Cloud e continua quando chiudi questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このチャットはCloudマシンで動いており、このMacを閉じても続きます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ការជជែកនេះដំណើរការលើម៉ាស៊ីន Cloud របស់វា ហើយបន្តនៅពេលអ្នកបិទ Mac នេះ។"
