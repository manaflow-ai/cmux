        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Этот чат работает на своей машине в Cloud и продолжается, когда вы закрываете этот Mac."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "แชทนี้ทำงานบนเครื่อง Cloud และทำต่อไปแม้คุณปิด Mac เครื่องนี้"
