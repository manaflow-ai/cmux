        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 채팅은 Cloud 머신에서 실행되며 이 Mac을 닫아도 계속됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Denne chatten kjører på Cloud-maskinen og fortsetter når du lukker denne Macen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ten czat działa na swojej maszynie Cloud i trwa dalej, gdy zamkniesz tego Maca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este chat roda na sua máquina do Cloud e continua quando você fecha este Mac."
