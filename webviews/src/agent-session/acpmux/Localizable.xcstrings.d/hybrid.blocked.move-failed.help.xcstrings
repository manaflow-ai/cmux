{
  "sourceLanguage" : "en",
  "strings" : {
    "hybrid.blocked.move-failed.help" : {
      "comment" : "Agent pane, the three-state cloud control: tooltip, what a click does when the chat's last move failed",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يعرض سبب فشل النقل ويتيح لك المحاولة مرة أخرى."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prikazuje zašto premještanje nije uspjelo i omogućava novi pokušaj."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Viser, hvorfor flytningen mislykkedes, og lader dig prøve igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zeigt, warum das Verschieben fehlschlug, und lässt dich es erneut versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows why the move failed and lets you try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Muestra por qué falló el traslado y te deja intentarlo de nuevo."
