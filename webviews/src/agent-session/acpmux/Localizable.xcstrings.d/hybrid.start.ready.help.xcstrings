{
  "sourceLanguage" : "en",
  "strings" : {
    "hybrid.start.ready.help" : {
      "comment" : "Agent pane, the three-state cloud control by the composer (hybrid start): tooltip when the chat's Cloud machine is up and the chat is about to move",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الجهاز السحابي يعمل. تنتقل الدردشة عند استدعاء الأداة التالي أو عند انتهاء هذا الدور."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cloud mašina radi. Chat se premješta pri sljedećem pozivu alata ili kada se ovaj krug završi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cloud-maskinen kører. Chatten flytter ved næste værktøjskald, eller når denne tur slutter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Cloud-Maschine läuft. Der Chat zieht beim nächsten Werkzeugaufruf oder am Ende dieser Runde um."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Cloud machine is up. The chat moves at its next tool call or when this turn ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La máquina de Cloud está lista. El chat se mueve en la próxima llamada a una herramienta o al terminar este turno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La machine Cloud est prête. Le chat y passe au prochain appel d’outil ou à la fin de ce tour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La macchina Cloud è attiva. La chat si sposta alla prossima chiamata di uno strumento o alla fine di questo turno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cloudマシンが起動しました。次のツール呼び出しか、このターンの終わりにチャットが移動します。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ម៉ាស៊ីន Cloud បានដំណើរការ។ ការជជែកនឹងផ្លាស់ទីនៅការហៅឧបករណ៍បន្ទាប់ ឬពេលវេននេះបញ្ចប់។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cloud 머신이 준비되었습니다. 다음 도구 호출이나 이번 턴이 끝날 때 채팅이 이동합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cloud-maskinen kjører. Chatten flytter ved neste verktøykall eller når denne runden er ferdig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Maszyna Cloud działa. Czat przeniesie się przy następnym wywołaniu narzędzia lub po zakończeniu tej tury."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A máquina do Cloud está pronta. O chat passa para ela na próxima chamada de ferramenta ou quando este turno terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Машина в Cloud запущена. Чат перейдёт при следующем вызове инструмента или в конце этого хода."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "เครื่อง Cloud พร้อมแล้ว แชทจะย้ายเมื่อเรียกใช้เครื่องมือครั้งถัดไปหรือเมื่อรอบนี้จบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cloud makinesi hazır. Sohbet bir sonraki araç çağrısında veya bu tur bittiğinde taşınır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Машина в Cloud запущена. Чат перейде під час наступного виклику інструмента або наприкінці цього ходу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Máy Cloud đã chạy. Cuộc trò chuyện sẽ chuyển ở lần gọi công cụ tiếp theo hoặc khi lượt này kết thúc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cloud 机器已启动。聊天会在下一次工具调用或本轮结束时移过去。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cloud 機器已啟動。聊天會在下一次工具呼叫或本輪結束時移過去。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
