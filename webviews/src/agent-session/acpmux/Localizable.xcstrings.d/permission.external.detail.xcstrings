    "permission.external.detail" : {
      "comment" : "Inline external access card explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حظر macOS هذه القراءة. يعيد السماح مرة واحدة محاولة هذه الخطوة؛ وقد تحتاج أولًا إلى منح الوصول في إعدادات النظام."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS je blokirao ovo čitanje. Dozvola jednom ponavlja ovaj korak; možda prvo trebate odobriti pristup u Postavkama sistema."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS blokerede denne læsning. Tillad én gang prøver dette trin igen; du skal muligvis først give adgang i Systemindstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hat diesen Lesevorgang blockiert. „Einmal erlauben“ versucht diesen Schritt erneut; möglicherweise musst du zuerst in den Systemeinstellungen Zugriff gewähren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS blocked this read. Allow once retries this step; you may need to grant access in System Settings first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS bloqueó esta lectura. Permitir una vez reintenta este paso; es posible que primero debas conceder acceso en Ajustes del Sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS a bloqué cette lecture. Autoriser une fois réessaie cette étape ; vous devrez peut-être d’abord accorder l’accès dans Réglages Système."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ha bloccato questa lettura. Consenti una volta riprova questo passaggio; potresti dover concedere prima l’accesso nelle Impostazioni di Sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS がこの読み取りをブロックしました。「一度だけ許可」でこの手順を再試行します。先にシステム設定でアクセスを許可する必要がある場合があります。"
