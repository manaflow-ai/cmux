{
  "sourceLanguage" : "en",
  "strings" : {
    "permission.fullAccessStillAsks" : {
      "comment" : "Agent pane: a muted line under a permission card's title when the chat runs its highest permission mode and the ask still came to the person (the mode does not answer it, for example because Claude Code marks it as needing the person). {mode} is the harness's native highest-permission mode label, such as 'Bypass permissions' or 'Full access'. 'Allow once' is the card's button label (permission.allowOnce).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا يشمل {mode} هذا الطلب. «السماح مرة واحدة» يتيح تشغيله هذه المرة فقط."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{mode} ne pokriva ovaj zahtjev. Dozvoli jednom ga pušta samo ovaj put."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{mode} dækker ikke denne. Tillad én gang lader den køre kun denne gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{mode} deckt diese Anfrage nicht ab. Einmal erlauben lässt sie nur dieses Mal laufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{mode} doesn't cover this one. Allow once lets it run this time only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{mode} no cubre esta solicitud. Permitir una vez la deja ejecutarse solo esta vez."
          }
        },
