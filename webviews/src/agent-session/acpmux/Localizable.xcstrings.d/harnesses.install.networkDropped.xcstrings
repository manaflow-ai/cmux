          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "បណ្តាញបានដាច់។ សូមពិនិត្យការតភ្ជាប់របស់អ្នក ហើយព្យាយាមម្តងទៀត។"
