{
  "sourceLanguage" : "en",
  "strings" : {
    "harnesses.install.networkDropped" : {
      "comment" : "Agent pane: a Harnesses row or the composer's setup strip when an install failed because the network dropped; a Retry button sits beside it",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقطعت الشبكة. تحقّق من اتصالك ثم أعد المحاولة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mreža je prekinuta. Provjerite vezu i pokušajte ponovo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Netværket faldt ud. Tjek din forbindelse, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Netzwerk ist abgebrochen. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The network dropped. Check your connection and retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La red se cortó. Comprueba tu conexión y vuelve a intentarlo."
          }
