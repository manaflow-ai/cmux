        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso está demorando mais que o normal. Retome a máquina de novo ou retome este chat pela transcrição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это занимает больше времени, чем обычно. Возобновите машину ещё раз или продолжите этот чат из его расшифровки."
