        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้เวลานานกว่าปกติ ให้ดำเนินการเครื่องต่ออีกครั้ง หรือดำเนินแชทนี้ต่อจากบันทึกการสนทนา"
