{
  "sourceLanguage" : "en",
  "strings" : {
    "composer.cmuxCdPath" : {
      "comment" : "Agent pane: inline refusal for /cd with a path the pane cannot read (~ or a relative path with no chat folder).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type the folder's full path, starting with /, or a path relative to this chat's folder."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اكتب المسار الكامل للمجلد بدءًا بـ /، أو مسارًا نسبيًا إلى مجلد هذه الدردشة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Upišite punu putanju mape koja počinje sa /, ili putanju u odnosu na mapu ovog razgovora."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skriv mappens fulde sti, der starter med /, eller en sti i forhold til denne chats mappe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gib den vollständigen Pfad des Ordners ein, beginnend mit /, oder einen Pfad relativ zum Ordner dieses Chats."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Escribe la ruta completa de la carpeta, empezando por /, o una ruta relativa a la carpeta de este chat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Saisissez le chemin complet du dossier, commençant par /, ou un chemin relatif au dossier de cette discussion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Digita il percorso completo della cartella, che inizia con /, o un percorso relativo alla cartella di questa chat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "/ で始まるフォルダのフルパス、またはこのチャットのフォルダからの相対パスを入力してください。"
