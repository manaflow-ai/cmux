        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "វាយផ្លូវពេញរបស់ថតដែលចាប់ផ្តើមដោយ / ឬផ្លូវទាក់ទងនឹងថតរបស់ការជជែកនេះ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "/로 시작하는 폴더의 전체 경로 또는 이 채팅 폴더 기준의 상대 경로를 입력하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skriv inn mappens fullstendige bane som starter med /, eller en bane relativt til denne chattens mappe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wpisz pełną ścieżkę folderu zaczynającą się od / lub ścieżkę względną wobec folderu tego czatu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Digite o caminho completo da pasta, começando com /, ou um caminho relativo à pasta deste chat."
