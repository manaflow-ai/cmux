        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ثابت منذ بدء هذا الوكيل الفرعي: يعمل على نموذج {chat}. افرّعه لتشغيله على نموذج آخر."
          }
        },
        "bs" : {
          "stringUnit" : {
