        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 기기는 만든 사람이나 팀 관리자만 공유할 수 있습니다. 소유자에게 공유를 요청하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bare den som opprettet maskinen eller en teamadministrator kan dele den. Be eieren om å dele den med deg."
