  "strings" : {
    "switch.share.forbidden" : {
      "comment" : "Agent pane: Share with Me was refused because the person is neither the machine's creator nor a team admin",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the machine's creator or a team admin can share it. Ask the owner to share it with you."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا يمكن مشاركة الجهاز إلا لمنشئه أو لمسؤول الفريق. اطلب من المالك مشاركته معك."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mašinu može podijeliti samo njen kreator ili administrator tima. Zamolite vlasnika da je podijeli s vama."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kun maskinens opretter eller en teamadministrator kan dele den. Bed ejeren om at dele den med dig."
