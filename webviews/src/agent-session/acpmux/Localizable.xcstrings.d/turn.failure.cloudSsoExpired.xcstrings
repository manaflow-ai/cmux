{
  "sourceLanguage" : "en",
  "strings" : {
    "turn.failure.cloudSsoExpired" : {
      "comment" : "Agent pane: a failed turn's note when the cloud SSO sign-in the agent uses expired and its profile is unknown; {harness} is the agent's name; keep the command aws sso login --profile as is",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت صلاحية تسجيل دخول SSO السحابي لـ {harness}. شغّل aws sso login --profile مع ملفه الشخصي، ثم أعد المحاولة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud SSO prijava za {harness} je istekla. Pokrenite aws sso login --profile s njegovim profilom, pa pokušajte ponovo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness}s cloud-SSO-login er udløbet. Kør aws sso login --profile med dens profil, og prøv så igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Cloud-SSO-Anmeldung von {harness} ist abgelaufen. Führe aws sso login --profile mit seinem Profil aus und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness}'s cloud SSO sign-in expired. Run aws sso login --profile with its profile, then retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
