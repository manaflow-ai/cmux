      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves to a Cloud VM if this Mac sleeps, runs low, you're away 10 min or a turn runs 15 min; returns when idle."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينتقل إلى Cloud VM إذا نام هذا الـ Mac أو انخفضت موارده أو غبت 10 دقائق أو استمر الدور 15 دقيقة؛ ويعود عند الخمول."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prelazi na Cloud VM ako ovaj Mac spava, ponestaje mu resursa, odsutan si 10 min ili potez traje 15 min; vraća se kad miruje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytter til en Cloud VM, hvis denne Mac sover, løber tør, du er væk i 10 min eller en tur varer 15 min; vender tilbage ved inaktivitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechselt auf eine Cloud VM, wenn dieser Mac schläft, knapp wird, du 10 Min. weg bist oder ein Durchlauf 15 Min. dauert; kehrt im Leerlauf zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasa a una Cloud VM si este Mac se suspende, se queda sin recursos, te ausentas 10 min o un turno dura 15 min; vuelve cuando está inactivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe sur une Cloud VM si ce Mac se met en veille, manque de ressources, si vous êtes absent 10 min ou si un tour dure 15 min ; revient au repos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa a una Cloud VM se questo Mac va in stop, è a corto di risorse, sei via da 10 min o un turno dura 15 min; torna quando è inattivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac がスリープ、リソース不足、10 分間の離席、またはターンが 15 分続くと Cloud VM に移動し、アイドル時に戻ります。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ផ្លាស់ទៅ Cloud VM ប្រសិនបើ Mac នេះដេក ខ្វះធនធាន អ្នកចាកចេញ 10 នាទី ឬវេនមួយដំណើរការ 15 នាទី; ត្រឡប់មកវិញពេលទំនេរ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac이 잠자기, 리소스 부족, 10분 자리 비움, 또는 턴이 15분 지속되면 Cloud VM으로 이동하고 유휴 시 돌아옵니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytter til en Cloud VM hvis denne Macen sover, går tom, du er borte i 10 min eller en tur varer 15 min; kommer tilbake ved inaktivitet."
