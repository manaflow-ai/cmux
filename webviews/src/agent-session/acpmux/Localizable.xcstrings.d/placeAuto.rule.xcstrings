      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs here. Moves to Cloud if the Mac sleeps, power, memory or disk run low, 10 min away or 15 min turns; back once idle."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يعمل هنا. ينتقل إلى Cloud إذا نام جهاز Mac أو انخفضت الطاقة أو الذاكرة أو القرص، أو بعد 10 دقائق من الغياب أو دور مدته 15 دقيقة؛ ويعود عند الخمول."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Radi ovdje. Prelazi u Cloud ako Mac spava, ponestaje napajanja, memorije ili diska, nakon 10 min odsutnosti ili poteza od 15 min; vraća se kad miruje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kører her. Flytter til Cloud, hvis Mac'en sover, strøm, hukommelse eller disk er lav, efter 10 min væk eller ture på 15 min; tilbage, når den er inaktiv."
          }
        },
        "de" : {
          "stringUnit" : {
