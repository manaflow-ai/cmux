          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux kiểm tra token trước khi lưu. Token nằm trong Chuỗi khóa của máy Mac này; máy Cloud chỉ nhận nó để chạy cuộc trò chuyện của bạn."
          }
