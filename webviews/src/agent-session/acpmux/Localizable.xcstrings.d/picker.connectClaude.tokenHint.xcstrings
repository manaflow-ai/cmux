    "picker.connectClaude.tokenHint" : {
      "comment" : "Connect your Claude subscription dialog: help under the token field",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحقق cmux من الرمز قبل حفظه. يبقى الرمز في سلسلة مفاتيح هذا الـ Mac، ولا تحصل عليه أجهزة Cloud إلا لتشغيل محادثتك."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux provjerava token prije nego što ga sačuva. Token ostaje u privjesku ključeva ovog Maca; Cloud mašine ga dobijaju samo da pokrenu tvoj chat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux tjekker tokenet, før det gemmes. Tokenet bliver i denne Macs nøglering; Cloud-maskiner får det kun for at køre din chat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux prüft das Token, bevor es gespeichert wird. Das Token bleibt im Schlüsselbund dieses Macs; Cloud-Maschinen erhalten es nur, um deinen Chat auszuführen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux checks the token before saving it. It stays in this Mac's Keychain; Cloud machines get it only to run your chat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux comprueba el token antes de guardarlo. El token se queda en el llavero de este Mac; las máquinas de Cloud solo lo reciben para ejecutar tu chat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux vérifie le jeton avant de l’enregistrer. Le jeton reste dans le trousseau de ce Mac ; les machines Cloud ne le reçoivent que pour exécuter votre conversation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux verifica il token prima di salvarlo. Il token resta nel portachiavi di questo Mac; le macchine Cloud lo ricevono solo per eseguire la tua chat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux は保存する前にトークンを確認します。トークンはこの Mac のキーチェーンに保存され、Cloud マシンにはチャットを実行するときだけ渡されます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux ពិនិត្យ token មុនពេលរក្សាទុក។ ថូខឹននៅក្នុង Keychain នៃ Mac នេះ ហើយម៉ាស៊ីន Cloud ទទួលបានវាតែដើម្បីដំណើរការការជជែករបស់អ្នកប៉ុណ្ណោះ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux가 저장하기 전에 토큰을 확인합니다. 토큰은 이 Mac의 키체인에 보관되며, Cloud 머신은 채팅을 실행할 때만 받습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux sjekker tokenet før det lagres. Tokenet blir i nøkkelringen på denne Macen; Cloud-maskiner får det bare for å kjøre chatten din."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux sprawdza token przed zapisaniem. Token zostaje w pęku kluczy tego Maca; maszyny Cloud dostają go tylko po to, by uruchomić Twój czat."
          }
