{
  "sourceLanguage" : "en",
  "strings" : {
    "edited.undoSkip.unknown.other" : {
      "comment" : "Agent pane: the edited-files card's Undo confirmation, for two or more files the turn changed that Undo leaves as they are (the pane never had their earlier contents; the card may list them with or without +/- counts). \"Undo\" is the card's Undo button. {files} is their names as a list (\"a.txt, b.txt and c.txt\").",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
