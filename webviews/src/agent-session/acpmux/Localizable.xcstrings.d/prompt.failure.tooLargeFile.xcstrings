{
  "sourceLanguage" : "en",
  "strings" : {
    "prompt.failure.tooLargeFile" : {
      "comment" : "Agent pane: under a prompt refused because it was larger than one message can carry; {name} is the attachment that takes the most of it. Retry is not offered, Edit is",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not sent: too large. Remove {name} with Edit, or send it separately."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُرسل: كبير جدًا. أزل {name} عبر «تعديل»، أو أرسله منفصلًا."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije poslano: prevelik. Uklonite {name} pomoću Uredi ili ga pošaljite zasebno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke sendt: for stor. Fjern {name} med Rediger, eller send den separat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht gesendet: zu groß. Entferne {name} mit Bearbeiten oder sende es einzeln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No enviado: demasiado grande. Quita {name} con Editar o envíalo por separado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non envoyé : trop volumineux. Retirez {name} avec Modifier, ou envoyez-le séparément."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non inviato: troppo grande. Rimuovi {name} con Modifica o invialo separatamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信されませんでした: 大きすぎます。「編集」で {name} を外すか、別に送ってください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "មិនបានផ្ញើ៖ ធំពេក។ ដក {name} ចេញដោយ កែ ឬផ្ញើវាដាច់ដោយឡែក។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보내지 않음: 너무 큽니다. 편집으로 {name}을(를) 제거하거나 따로 보내세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke sendt: for stor. Fjern {name} med Rediger, eller send den separat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie wysłano: za duże. Usuń {name} przez Edytuj albo wyślij osobno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não enviado: grande demais. Remova {name} com Editar ou envie separadamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не отправлено: слишком большое. Удалите {name} через «Изменить» или отправьте отдельно."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ได้ส่ง: ใหญ่เกินไป ลบ {name} ด้วย แก้ไข หรือส่งแยก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gönderilmedi: çok büyük. Düzenle ile {name} öğesini kaldırın ya da ayrı gönderin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не надіслано: завелике. Видаліть {name} через «Редагувати» або надішліть окремо."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa gửi: quá lớn. Gỡ {name} bằng Sửa, hoặc gửi riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未发送：太大。用“编辑”移除 {name}，或单独发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未傳送：太大。用「編輯」移除 {name}，或單獨傳送。"
          }
        }
      }
    }
  },
  "version" : "1.0"
