  "strings" : {
    "permission.alwaysAtSource" : {
      "comment" : "Agent pane: tooltip on a permission card's disabled Always allow button, for a chat that runs on a peer machine: the peer takes only a one-time Allow or a Deny from this Mac, so a lasting grant is answered on the machine that runs the chat",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always allow works only on the machine running this chat"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«السماح دائمًا» يعمل فقط على الجهاز الذي يشغّل هذه الدردشة"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uvijek dozvoli radi samo na računaru na kojem radi ovaj chat"
