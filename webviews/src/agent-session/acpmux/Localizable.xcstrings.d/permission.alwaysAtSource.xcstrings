        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tillad altid virker kun på den maskine, der kører denne chat"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Immer erlauben“ geht nur auf dem Rechner, auf dem dieser Chat läuft"
