{
  "sourceLanguage" : "en",
  "strings" : {
    "harnesses.install.incomplete" : {
      "comment" : "Agent pane: a Harnesses row or the composer's setup strip when an install failed with advice meant for a terminal user (such as a command-line flag); Retry and Setup guide buttons sit beside it",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يكتمل التثبيت. أعد المحاولة أو افتح دليل الإعداد."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalacija nije završena. Pokušajte ponovo ili otvorite vodič za postavljanje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installationen blev ikke færdig. Prøv igen, eller åbn opsætningsvejledningen."
