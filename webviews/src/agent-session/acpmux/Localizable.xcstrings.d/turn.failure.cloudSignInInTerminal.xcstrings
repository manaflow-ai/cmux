{
  "sourceLanguage" : "en",
  "strings" : {
    "turn.failure.cloudSignInInTerminal" : {
      "comment" : "Agent pane: after a Cloud sign-in failure on a machine whose cmux is too old to sign in from the card; Sign in again (turn.signInAgain) opens the agent's own login in a terminal on that machine.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يعمل هذا الجهاز بإصدار أقدم من cmux، لذا يفتح «سجّل الدخول مرة أخرى» تسجيل دخول {harness} نفسه في طرفية هناك."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ovaj računar koristi stariju verziju cmux-a, pa „Ponovo se prijavi” otvara vlastitu prijavu za {harness} u terminalu na njemu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Denne maskine kører en ældre cmux, så Log ind igen åbner {harness}s eget login i en terminal der."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieser Computer nutzt eine ältere cmux-Version, daher öffnet „Erneut anmelden“ die eigene Anmeldung von {harness} in einem Terminal dort."
          }
        },
        "en" : {
