{
  "sourceLanguage" : "en",
  "strings" : {
    "message.senderNotFoundOnHost" : {
      "comment" : "Agent pane: a notice after a click on a received message's sender chip naming a chat on another machine that acpmux cannot find; {name} is the chat, {host} the machine it was on",
