{
  "sourceLanguage" : "en",
  "strings" : {
    "cloudStartup.folderHome" : {
      "comment" : "Agent pane: Cloud startup checklist. A Cloud start refused on this Mac because its folder is the home folder or a folder above it, which Cloud never copies.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud doesn't copy your home folder or a folder above it; pick another folder."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا ينسخ Cloud مجلد المنزل أو مجلدًا أعلى منه؛ اختر مجلدًا آخر."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud ne kopira vaš početni folder niti folder iznad njega; odaberite drugi folder."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud kopierer ikke din hjemmemappe eller en mappe over den; vælg en anden mappe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud kopiert weder deinen Benutzerordner noch einen Ordner darüber; wähle einen anderen Ordner aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud no copia tu carpeta de inicio ni una carpeta superior; elige otra carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud ne copie pas votre dossier personnel ni un dossier au-dessus ; choisissez un autre dossier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud non copia la cartella Inizio né una cartella superiore; scegli un'altra cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud はホームフォルダやその上位のフォルダをコピーしません。別のフォルダを選んでください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud មិនចម្លងថតផ្ទះរបស់អ្នក ឬថតខាងលើវាទេ។ ជ្រើសរើសថតផ្សេង។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud는 홈 폴더나 그 상위 폴더를 복사하지 않습니다. 다른 폴더를 선택하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud kopierer ikke hjemmemappen din eller en mappe over den; velg en annen mappe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud nie kopiuje folderu domowego ani folderu nad nim; wybierz inny folder."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cloud não copia sua pasta pessoal nem uma pasta acima dela; escolha outra pasta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud не копирует домашнюю папку и папки выше неё; выберите другую папку."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud ไม่คัดลอกโฟลเดอร์บ้านหรือโฟลเดอร์ที่อยู่เหนือกว่า เลือกโฟลเดอร์อื่น"
