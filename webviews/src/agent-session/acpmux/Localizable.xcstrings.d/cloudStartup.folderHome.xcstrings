        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud ana klasörünüzü veya onun üstündeki bir klasörü kopyalamaz; başka bir klasör seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud не копіює домашню папку чи папки над нею; виберіть іншу папку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
