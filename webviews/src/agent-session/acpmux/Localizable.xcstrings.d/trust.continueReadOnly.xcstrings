{
  "sourceLanguage" : "en",
  "strings" : {
    "trust.continueReadOnly" : {
      "comment" : "Folder trust: what the read-only continuation in a declined folder does",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أو اقرأه هنا: يمكن للوكيل قراءة هذا المجلد والبحث فيه دون تغييره. تبقى خطافات المشروع وإعداداته وخوادم MCP متوقفة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ili ga čitajte ovdje: agent može čitati i pretraživati ovu mapu, ali je ne može mijenjati. Kuke projekta, postavke i MCP serveri ostaju isključeni."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eller læs den her: agenten kan læse og søge i mappen, men ikke ændre den. Projektets hooks, indstillinger og MCP-servere forbliver slået fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oder hier lesen: Der Agent kann diesen Ordner lesen und durchsuchen, aber nicht ändern. Projekt-Hooks, Einstellungen und MCP-Server bleiben aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Or read it here: the agent can read and search this folder but not change it. Project hooks, settings and MCP servers stay off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O léelo aquí: el agente puede leer y buscar en esta carpeta, pero no cambiarla. Los hooks del proyecto, los ajustes y los servidores MCP siguen desactivados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou lisez-le ici : l'agent peut lire et parcourir ce dossier, mais pas le modifier. Les hooks du projet, les réglages et les serveurs MCP restent désactivés."
          }
        },
        "it" : {
          "stringUnit" : {
