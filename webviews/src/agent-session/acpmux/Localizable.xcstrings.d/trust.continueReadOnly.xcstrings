{
  "sourceLanguage" : "en",
  "strings" : {
    "trust.continueReadOnly" : {
      "comment" : "Folder trust: what the read-only continuation in a declined folder does",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أو اقرأه هنا: يمكن للوكيل قراءة هذا المجلد والبحث فيه دون تغييره. تبقى خطافات المشروع وإعداداته وخوادم MCP متوقفة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ili ga čitaj ovdje: agent može čitati i pretraživati ovaj folder, ali ga ne može mijenjati. Hookovi projekta, postavke i MCP serveri ostaju isključeni."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eller læs den her: agenten kan læse og søge i denne mappe, men ikke ændre den. Projektets hooks, indstillinger og MCP-servere forbliver slået fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oder hier lesen: Der Agent kann diesen Ordner lesen und durchsuchen, aber nicht ändern. Projekt-Hooks, Einstellungen und MCP-Server bleiben aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Or read it here: the agent can read and search this folder but not change it. Project hooks, settings and MCP servers stay off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O léelo aquí: el agente puede leer y buscar en esta carpeta, pero no cambiarla. Los hooks, ajustes y servidores MCP del proyecto siguen desactivados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou lisez-le ici : l’agent peut lire et rechercher dans ce dossier, sans le modifier. Les hooks, réglages et serveurs MCP du projet restent désactivés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppure leggilo qui: l’agente può leggere e cercare in questa cartella, ma non modificarla. Hook, impostazioni e server MCP del progetto restano spenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "またはここで読む：エージェントはこのフォルダを読み取り・検索できますが、変更はできません。プロジェクトのフック、設定、MCP サーバーはオフのままです。"
