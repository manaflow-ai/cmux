{
  "sourceLanguage" : "en",
  "strings" : {
    "cloudStartup.folderTooBig" : {
      "comment" : "Agent pane: Cloud start card. The chosen folder is not a git repository and is too big to copy to a Cloud machine, with no git repositories inside it. {folder} is the folder as ~/path, {size} is how much it holds (cloudStartup.folderSize).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{folder} is too big to copy ({size}; the limit is 20 GB or 500,000 files). Pick a smaller folder, or start without one."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{folder} كبير جدًا للنسخ ({size}؛ الحد 20 GB أو 500,000 ملف). اختر مجلدًا أصغر، أو ابدأ بدون مجلد."
          }
        },
        "bs" : {
