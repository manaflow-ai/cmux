{
  "sourceLanguage" : "en",
  "strings" : {
    "turn.failure.codexConfig" : {
      "comment" : "Agent pane: a failed turn's error card when Codex could not load its own settings (config.toml, requirements.toml); {harness} is the agent's name. Keep the file names, [permissions] and default_permissions as they are",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على {harness} تحميل إعداداته. في ~/.codex/config.toml، يحتاج ملف [permissions] إلى default_permissions. ثم أعد المحاولة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness} nije mogao učitati postavke. U ~/.codex/config.toml, profil [permissions] treba default_permissions. Zatim pokušajte ponovo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness} kunne ikke indlæse sine indstillinger. I ~/.codex/config.toml skal en [permissions]-profil have default_permissions. Prøv så igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness} konnte seine Einstellungen nicht laden. In ~/.codex/config.toml braucht ein [permissions]-Profil default_permissions. Dann erneut versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{harness} couldn’t load its settings. In ~/.codex/config.toml, a [permissions] profile needs default_permissions. Then retry."
          }
        },
        "es" : {
