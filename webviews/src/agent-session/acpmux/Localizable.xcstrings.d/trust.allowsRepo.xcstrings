    "trust.allowsRepo" : {
      "comment" : "Agent pane: the folder trust question above the composer (scope: repo or folder; what trusting allows; Not now)",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لـ {agent} تشغيل الأوامر وتعديل الملفات فيه وفي كل أشجار العمل التابعة له، وتُحمَّل خطافات المستودع وخوادم MCP والإعدادات. ليس الآن: لن يعمل {agent} هنا حتى تثق به."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{agent} može pokretati naredbe i uređivati fajlove u njemu i svim njegovim radnim stablima, a učitavaju se hookovi, MCP serveri i postavke repozitorija. Ne sada: {agent} se neće pokretati ovdje dok mu ne vjerujete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{agent} kan køre kommandoer og redigere filer i det og alle dets worktrees, og repoets hooks, MCP-servere og indstillinger indlæses. Ikke nu: {agent} kører ikke her, før du stoler på det."
          }
        },
        "de" : {
