          "stringUnit" : {
            "state" : "needs_review",
            "value" : "استخدم ‎--on cloud‎ لبدئه في السحابة، أو احذف ‎--on‎."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koristite --on cloud da počne u Cloudu, ili izostavite --on."
