  "strings" : {
    "composer.cmuxOnPlace" : {
      "comment" : "Agent pane: inline refusal for a slash command whose --on names a place the composer cannot start a chat in (only here or cloud).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use --on cloud to start it in Cloud, or leave --on out."
