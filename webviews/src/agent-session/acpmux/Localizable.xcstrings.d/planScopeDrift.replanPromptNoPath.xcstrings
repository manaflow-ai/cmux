{
  "sourceLanguage" : "en",
  "strings" : {
    "planScopeDrift.replanPromptNoPath" : {
      "comment" : "Agent pane: the prompt Replan sends to the agent for the person, after an edit outside the approved plan, when the edited path is unknown",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replan before editing outside the approved plan: update the plan to include this area, then continue."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أعد التخطيط قبل التعديل خارج الخطة المعتمدة: حدّث الخطة لتشمل هذا الجزء، ثم تابع."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ponovo planiraj prije izmjena izvan odobrenog plana: ažuriraj plan da uključi ovaj dio, pa nastavi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Planlæg igen, før du redigerer uden for den godkendte plan: opdater planen, så den omfatter dette område, og fortsæt derefter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plane neu, bevor du außerhalb des genehmigten Plans bearbeitest: Ergänze den Plan um diesen Bereich und mach dann weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vuelve a planificar antes de editar fuera del plan aprobado: actualiza el plan para incluir esta área y luego continúa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Replanifie avant de modifier hors du plan approuvé : mets à jour le plan pour inclure cette zone, puis continue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ripianifica prima di modificare fuori dal piano approvato: aggiorna il piano per includere quest'area, poi continua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "承認済みの計画の外を編集する前に計画を見直してください。計画にこの範囲を含めてから続けてください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "រៀបចំផែនការឡើងវិញ មុនពេលកែក្រៅផែនការដែលបានអនុម័ត៖ ធ្វើបច្ចុប្បន្នភាពផែនការ ឱ្យរួមបញ្ចូលផ្នែកនេះ រួចបន្ត។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "승인된 계획 밖을 편집하기 전에 계획을 다시 세우세요. 계획에 이 영역을 포함한 뒤 계속하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Planlegg på nytt før du redigerer utenfor den godkjente planen: oppdater planen så den tar med dette området, og fortsett deretter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zaplanuj ponownie przed edycją poza zatwierdzonym planem: zaktualizuj plan, aby obejmował ten obszar, a potem kontynuuj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Replaneje antes de editar fora do plano aprovado: atualize o plano para incluir esta área e depois continue."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Перепланируй перед правкой вне утверждённого плана: обнови план, чтобы он включал эту область, и продолжай."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "วางแผนใหม่ก่อนแก้ไขนอกแผนที่อนุมัติ: อัปเดตแผนให้ครอบคลุมส่วนนี้ แล้วทำต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Onaylanan planın dışında düzenlemeden önce yeniden planla: planı bu alanı kapsayacak şekilde güncelle, sonra devam et."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Переплануй перед редагуванням поза затвердженим планом: онови план, щоб він охоплював цю ділянку, і продовжуй."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lập lại kế hoạch trước khi sửa ngoài kế hoạch đã duyệt: cập nhật kế hoạch để bao gồm phần này, rồi tiếp tục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在已批准的计划之外编辑之前请重新规划：更新计划以包含此范围，然后继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在已核准的計畫之外編輯之前請重新規劃：更新計畫以包含此範圍，然後繼續。"
          }
        }
      }
    }
