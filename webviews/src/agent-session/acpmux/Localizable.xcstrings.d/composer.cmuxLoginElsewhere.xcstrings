    "composer.cmuxLoginElsewhere" : {
      "comment" : "Agent pane: /login refused for a chat bound to an account route or running on another host (App.tsx)",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الدخول إلى حساب هذه المحادثة من قائمة الحساب، أو من الإعدادات > الوكلاء."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijavite se na račun ovog razgovora iz menija Račun ili u Postavke > Agenti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log ind på denne samtales konto fra dens Konto-menu eller i Indstillinger > Agenter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich über das Konto-Menü dieses Chats oder unter Einstellungen > Agenten an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in to this chat's account from its Account menu, or in Settings > Agents."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión en la cuenta de este chat desde su menú Cuenta o en Ajustes > Agentes."
