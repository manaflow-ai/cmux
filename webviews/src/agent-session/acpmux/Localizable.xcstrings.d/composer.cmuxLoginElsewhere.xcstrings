        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ចូលគណនីរបស់ការជជែកនេះពីម៉ឺនុយគណនី ឬក្នុងការកំណត់ > ភ្នាក់ងារ។"
