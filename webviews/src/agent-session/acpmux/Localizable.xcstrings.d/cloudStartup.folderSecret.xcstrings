{
  "sourceLanguage" : "en",
  "strings" : {
    "cloudStartup.folderSecret" : {
      "comment" : "Agent pane: Cloud startup checklist. A Cloud start refused on this Mac because its folder is, or holds, a folder of keys or credentials. {folder} is that folder, spelled from the home folder (~/.ssh).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud never copies {folder}, which holds keys or credentials; pick another folder."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا ينسخ Cloud المجلد {folder} أبدًا لأنه يحتوي على مفاتيح أو بيانات اعتماد؛ اختر مجلدًا آخر."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud nikad ne kopira {folder} jer sadrži ključeve ili vjerodajnice; odaberite drugi folder."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud kopierer aldrig {folder}, som indeholder nøgler eller loginoplysninger; vælg en anden mappe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
