{
  "sourceLanguage" : "en",
  "strings" : {
    "switch.serviceUnreachable" : {
      "comment" : "Agent pane: a new chat's agent did not start (or may not have) because the page could not open, or lost, its connection to cmux's agent service (acpmux), for example while it restarts. Reopening cmux reconnects. {agent} is the agent's name (Claude Code).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "فقد cmux اتصاله بخدمة الوكلاء أثناء بدء {agent}. حاول مرة أخرى، وإذا تكرر ذلك فأغلق cmux وأعد فتحه لإعادة الاتصال."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux je izgubio vezu sa uslugom agenata dok je pokretao {agent}. Pokušajte ponovo, a ako se ponavlja, zatvorite i ponovo otvorite cmux da se ponovo poveže."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux mistede forbindelsen til agenttjenesten, mens {agent} startede. Prøv igen, og hvis det bliver ved, så luk og genåbn cmux for at oprette forbindelse igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux hat beim Starten von {agent} die Verbindung zum Agentendienst verloren. Versuche es erneut, und wenn es weiter passiert, beende cmux und öffne es neu, um die Verbindung wiederherzustellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux lost its connection to the agent service while starting {agent}. Try again, and if it keeps happening, quit and reopen cmux to reconnect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux perdió la conexión con el servicio de agentes al iniciar {agent}. Inténtalo de nuevo y, si sigue pasando, cierra y vuelve a abrir cmux para reconectar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux a perdu la connexion au service d'agents en démarrant {agent}. Réessayez, et si cela se reproduit, quittez puis rouvrez cmux pour vous reconnecter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux ha perso la connessione al servizio agenti durante l'avvio di {agent}. Riprova e, se continua a succedere, chiudi e riapri cmux per riconnetterti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{agent} の開始中に cmux がエージェントサービスとの接続を失いました。もう一度お試しください。繰り返す場合は cmux を終了して開き直し、再接続してください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux បានបាត់ការតភ្ជាប់ទៅសេវាភ្នាក់ងារ ពេលកំពុងចាប់ផ្ដើម {agent}។ សូមព្យាយាមម្ដងទៀត ហើយបើវានៅតែកើតឡើង សូមបិទ cmux ហើយបើកវាឡើងវិញ ដើម្បីភ្ជាប់ឡើងវិញ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{agent}을(를) 시작하는 중에 cmux가 에이전트 서비스와의 연결을 잃었습니다. 다시 시도하고, 계속 발생하면 cmux를 종료한 뒤 다시 열어 재연결하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux mistet forbindelsen til agenttjenesten mens {agent} startet. Prøv igjen, og hvis det fortsetter, avslutt og åpne cmux på nytt for å koble til igjen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux utracił połączenie z usługą agentów podczas uruchamiania {agent}. Spróbuj ponownie, a jeśli to się powtarza, zamknij i ponownie otwórz cmux, aby połączyć się ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O cmux perdeu a conexão com o serviço de agentes ao iniciar {agent}. Tente de novo e, se continuar acontecendo, feche e abra o cmux novamente para reconectar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux потерял связь со службой агентов при запуске {agent}. Попробуйте ещё раз, а если это повторяется, закройте и снова откройте cmux, чтобы переподключиться."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux ขาดการเชื่อมต่อกับบริการเอเจนต์ขณะเริ่ม {agent} ลองอีกครั้ง และหากยังเกิดขึ้นอีก ให้ปิดแล้วเปิด cmux ใหม่เพื่อเชื่อมต่ออีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux, {agent} başlatılırken ajan hizmetiyle bağlantısını kaybetti. Yeniden deneyin; sürerse yeniden bağlanmak için cmux'tan çıkıp yeniden açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux втратив зв'язок зі службою агентів під час запуску {agent}. Спробуйте ще раз, а якщо це повторюється, закрийте й знову відкрийте cmux, щоб перепідключитися."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux mất kết nối với dịch vụ tác tử khi đang khởi động {agent}. Hãy thử lại, và nếu vẫn xảy ra, hãy thoát rồi mở lại cmux để kết nối lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux 在启动 {agent} 时与代理服务断开了连接。请重试；如果问题持续出现，请退出并重新打开 cmux 以重新连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux 在啟動 {agent} 時與代理服務中斷了連線。請再試一次；如果問題持續發生，請結束並重新開啟 cmux 以重新連線。"
          }
        }
      }
    }
  },
  "version" : "1.0"
