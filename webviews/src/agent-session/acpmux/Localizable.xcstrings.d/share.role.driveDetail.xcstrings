      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لهذا الشخص تشغيل الوكيل باسمك باستخدام خطتك وعلى جهازك."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova osoba može pokretati agenta u tvoje ime, koristeći tvoj plan i tvoj računar."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personen kan køre agenten som dig med dit abonnement på din computer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Person kann den Agenten unter deinem Namen mit deinem Abo auf deinem Rechner ausführen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They can run the agent as you, on your plan and your machine."
