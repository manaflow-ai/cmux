{
  "sourceLanguage" : "en",
  "strings" : {
    "subagents.fork.modeFixedTip" : {
      "comment" : "Agent pane: hover on a Codex subagent composer's read-only permission mode chip; the mode was copied from its chat when it started; {chat} is the chat",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set from {chat} when this subagent started. Fork it to run in another mode."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "عُيّن من {chat} عند بدء هذا الوكيل الفرعي. افرّعه لتشغيله بوضع آخر."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Postavljeno iz {chat} kad je ovaj podagent pokrenut. Granaj ga da radi u drugom načinu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sat fra {chat} da denne underagent startede. Forgren den for at køre i en anden tilstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beim Start dieses Subagenten von {chat} übernommen. Zweige ihn ab, um einen anderen Modus zu nutzen."
