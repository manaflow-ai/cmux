{
  "sourceLanguage" : "en",
  "strings" : {
    "composer.stashChipHint" : {
      "comment" : "Agent pane: tooltip of the Stashed chip in the composer's quiet row; ⌃S is the Control-S key (composer/StashedChip.tsx)",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "استعد مسودة مخبأة. ⌃S يخبئ الموجّه، وفي موجّه فارغ يستعيد أحدثها."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vrati skloni nacrt. ⌃S sklanja upit; u praznom upitu vraća najnoviji."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hent en gemt kladde tilbage. ⌃S gemmer prompten væk; i en tom prompt henter den den nyeste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Einen zurückgelegten Entwurf zurückholen. ⌃S legt den Prompt zurück; bei leerem Prompt holt es den neuesten zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring back a stashed draft. ⌃S stashes the prompt; on an empty prompt it brings back the newest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Recupera un borrador apartado. ⌃S aparta el prompt; con el prompt vacío recupera el más reciente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reprendre un brouillon mis de côté. ⌃S met le prompt de côté ; sur un prompt vide, il reprend le plus récent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Riprendi una bozza accantonata. ⌃S accantona il prompt; con il prompt vuoto riprende la più recente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "退避した下書きを戻します。⌃S でプロンプトを退避し、空のプロンプトでは最新のものを戻します。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "យកសេចក្ដីព្រាងដែលបានទុកមកវិញ។ ⌃S ទុកការបញ្ចូលមួយឡែក; នៅពេលការបញ្ចូលទទេ វាយកថ្មីបំផុតមកវិញ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "보관한 초안을 되돌립니다. ⌃S로 프롬프트를 보관하고, 빈 프롬프트에서는 가장 최근 초안을 되돌립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hent tilbake et utkast som er lagt til side. ⌃S legger prompten til side; i en tom prompt henter den det nyeste."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przywróć odłożony szkic. ⌃S odkłada prompt; przy pustym prompcie przywraca najnowszy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Traga de volta um rascunho guardado. ⌃S guarda o prompt; com o prompt vazio, traz o mais recente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вернуть отложенный черновик. ⌃S откладывает запрос; при пустом запросе возвращает последний."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "นำแบบร่างที่พักไว้กลับมา ⌃S พักพรอมต์ไว้ เมื่อพรอมต์ว่างจะนำฉบับล่าสุดกลับมา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kenara alınan bir taslağı geri getir. ⌃S istemi kenara alır; boş istemde en yenisini geri getirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Повернути відкладену чернетку. ⌃S відкладає запит; у порожньому запиті повертає найновішу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lấy lại một bản nháp đã cất. ⌃S cất lời nhắc; khi lời nhắc trống, nó lấy lại bản mới nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "取回一份暂存的草稿。⌃S 暂存提示词；提示词为空时取回最新的一份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "取回一份暫存的草稿。⌃S 暫存提示詞；提示詞為空時取回最新的一份。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
