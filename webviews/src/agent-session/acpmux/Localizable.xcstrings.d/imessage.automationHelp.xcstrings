{
  "sourceLanguage" : "en",
  "strings" : {
    "imessage.automationHelp" : {
      "comment" : "Session Info Connect iMessage connector: Sends need permission to control Messages. Open Messages, then allow access or skip for now.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends need permission to control Messages. Open Messages, then allow access or skip for now."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب الإرسال إذنًا للتحكم في تطبيق الرسائل. افتح تطبيق الرسائل، ثم اسمح بالوصول أو تخطَّ هذه الخطوة الآن."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slanje zahtijeva dozvolu za upravljanje aplikacijom Poruke. Otvorite Poruke, pa dozvolite pristup ili zasad preskočite ovaj korak."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afsendelse kræver tilladelse til at styre Beskeder. Åbn Beskeder, og tillad adgang eller spring over for nu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Senden ist die Erlaubnis zur Steuerung von Nachrichten nötig. Öffne Nachrichten und erlaube den Zugriff oder überspringe diesen Schritt vorerst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar requiere permiso para controlar Mensajes. Abre Mensajes y permite el acceso u omite este paso por ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’envoi nécessite l’autorisation de contrôler Messages. Ouvrez Messages, puis autorisez l’accès ou ignorez cette étape pour le moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’invio richiede il permesso di controllare Messaggi. Apri Messaggi, poi consenti l’accesso o salta questo passaggio per ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信には「メッセージ」を操作する許可が必要です。「メッセージ」を開いてアクセスを許可するか、今はスキップしてください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការផ្ញើត្រូវការការអនុញ្ញាតដើម្បីគ្រប់គ្រងកម្មវិធីសារ។ បើកកម្មវិធីសារ រួចអនុញ្ញាតការចូលប្រើ ឬរំលងជំហាននេះសិន។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전송하려면 메시지를 제어할 권한이 필요합니다. 메시지를 연 다음 접근을 허용하거나 지금은 건너뛰세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sending krever tillatelse til å styre Meldinger. Åpne Meldinger, og tillat tilgang eller hopp over dette nå."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyłanie wymaga pozwolenia na sterowanie aplikacją Wiadomości. Otwórz Wiadomości, a następnie zezwól na dostęp lub na razie pomiń ten krok."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O envio exige permissão para controlar o Mensagens. Abra o Mensagens e permita o acesso ou pule esta etapa por enquanto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для отправки нужно разрешение на управление Сообщениями. Откройте Сообщения, затем разрешите доступ или пока пропустите этот шаг."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การส่งต้องได้รับอนุญาตให้ควบคุมแอปข้อความ เปิดแอปข้อความ แล้วอนุญาตการเข้าถึงหรือข้ามขั้นตอนนี้ไปก่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Göndermek için Mesajlar’ı denetleme izni gerekir. Mesajlar’ı açın, ardından erişime izin verin veya şimdilik bu adımı atlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надсилання потребує дозволу на керування програмою Повідомлення. Відкрийте Повідомлення, а потім дозвольте доступ або поки пропустіть цей крок."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc gửi cần quyền điều khiển Tin nhắn. Hãy mở Tin nhắn, rồi cho phép truy cập hoặc tạm bỏ qua bước này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送需要控制“信息”的权限。打开“信息”，然后允许访问或暂时跳过此步骤。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "傳送需要控制「訊息」的權限。打開「訊息」，然後允許取用或暫時略過此步驟。"
          }
        }
      }
    }
