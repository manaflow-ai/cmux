{
  "sourceLanguage" : "en",
  "strings" : {
    "hybrid.start.failed.help" : {
      "comment" : "Agent pane, the three-state cloud control by the composer (hybrid start): tooltip after the Cloud machine or the move failed; the chat was not stopped",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لم ينتقل إلى السحابة؛ تستمر الدردشة على هذا الـ Mac."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nije prešao u Cloud; chat nastavlja na ovom Macu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kom ikke til Cloud; chatten fortsætter på denne Mac."
