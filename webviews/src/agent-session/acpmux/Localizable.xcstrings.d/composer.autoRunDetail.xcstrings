{
  "sourceLanguage" : "en",
  "strings" : {
    "composer.autoRunDetail" : {
      "comment" : "Environment picker: the hover card of the Auto row.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل على جهاز Mac هذا، أو على Cloud عندما يكون Mac مشغولًا. أعده في أي وقت."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radi na ovom Macu ili na Cloudu kada je ovaj Mac zauzet. Vratite ga bilo kada."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kører på denne Mac, eller i Cloud når denne Mac er optaget. Hent den tilbage når som helst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft auf diesem Mac oder in der Cloud, wenn dieser Mac ausgelastet ist. Jederzeit zurückholbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs on this Mac, or on Cloud when this Mac is busy. Bring it back any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ejecuta en este Mac, o en Cloud cuando este Mac está ocupado. Tráelo de vuelta cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’exécute sur ce Mac, ou dans le Cloud quand ce Mac est occupé. Ramenez-la à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene eseguita su questo Mac, o nel Cloud quando questo Mac è occupato. Riportala indietro quando vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac で実行し、この Mac が混んでいるときは Cloud で実行します。いつでも戻せます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ដំណើរការលើ Mac នេះ ឬលើ Cloud ពេល Mac នេះរវល់។ នាំវាត្រឡប់មកវិញបានគ្រប់ពេល។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서 실행하고, 이 Mac이 바쁘면 Cloud에서 실행합니다. 언제든 다시 가져올 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjører på denne Macen, eller i Cloud når denne Macen er opptatt. Hent den tilbake når som helst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Działa na tym Macu albo w Cloud, gdy ten Mac jest zajęty. Możesz go w każdej chwili przywrócić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roda neste Mac, ou no Cloud quando este Mac está ocupado. Traga de volta quando quiser."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работает на этом Mac или в Cloud, когда этот Mac занят. Верните его в любой момент."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำงานบน Mac เครื่องนี้ หรือบน Cloud เมื่อ Mac เครื่องนี้ไม่ว่าง นำกลับมาได้ทุกเมื่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Mac’te, bu Mac meşgulken Cloud’da çalışır. İstediğiniz zaman geri getirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Працює на цьому Mac або в Cloud, коли цей Mac зайнятий. Поверніть його будь-коли."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạy trên máy Mac này, hoặc trên Cloud khi máy Mac này bận. Mang về bất cứ lúc nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在这台 Mac 上运行，这台 Mac 繁忙时在 Cloud 上运行。随时可以带回来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在這台 Mac 上執行，這台 Mac 忙碌時在 Cloud 上執行。隨時可以帶回來。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
