{
  "sourceLanguage" : "en",
  "strings" : {
    "hybrid.start.moving.help" : {
      "comment" : "Agent pane, the three-state cloud control by the composer (hybrid start): tooltip while the chat moves to its Cloud machine",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "رسالة ترسلها الآن تنتظر وتصل إلى الدردشة بمجرد انتقالها."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Poruka koju sada pošalješ čeka i stiže u chat čim se premjesti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En besked, du sender nu, venter og når chatten, så snart den er flyttet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine Nachricht, die du jetzt sendest, wartet und erreicht den Chat, sobald er umgezogen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A message you send now waits and reaches the chat once it has moved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un mensaje que envíes ahora espera y llega al chat en cuanto se haya movido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un message envoyé maintenant attend et arrive au chat dès qu’il a changé de place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un messaggio inviato ora attende e arriva alla chat appena si è spostata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "今送ったメッセージは待機し、移動が終わるとチャットに届きます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "សារដែលអ្នកផ្ញើឥឡូវនេះនឹងរង់ចាំ ហើយទៅដល់ការជជែកពេលវាផ្លាស់ទីរួច។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "지금 보내는 메시지는 기다렸다가 이동이 끝나면 채팅에 전달됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En melding du sender nå, venter og når chatten når den har flyttet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wiadomość wysłana teraz poczeka i trafi do czatu, gdy tylko się przeniesie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uma mensagem enviada agora aguarda e chega ao chat assim que ele terminar de mudar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сообщение, отправленное сейчас, подождёт и попадёт в чат, как только он перейдёт."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ข้อความที่ส่งตอนนี้จะรอและไปถึงแชทเมื่อย้ายเสร็จ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Şimdi gönderdiğin mesaj bekler ve sohbet taşınır taşınmaz ona ulaşır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Повідомлення, надіслане зараз, зачекає й потрапить у чат, щойно він перейде."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tin nhắn bạn gửi bây giờ sẽ chờ và đến cuộc trò chuyện ngay khi chuyển xong."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "现在发送的消息会等待，聊天移好后立即送达。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "現在傳送的訊息會等待，聊天移好後立即送達。"
          }
        }
      }
    }
  },
  "version" : "1.0"
