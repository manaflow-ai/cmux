{
  "sourceLanguage" : "en",
  "strings" : {
    "auth.key.refused" : {
      "comment" : "Agent pane: the composer's notice when the model provider refused the API key the agent uses (invalid or revoked); {provider} is the provider's name",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يقبل {provider} مفتاح API الخاص بك. اختر «استبدال المفتاح» لإدخال مفتاح صالح."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{provider} nije prihvatio vaš API ključ. Odaberite Zamijeni ključ i unesite ispravan."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{provider} accepterede ikke din API-nøgle. Vælg Erstat nøgle for at indtaste en, der virker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{provider} hat deinen API-Schlüssel nicht akzeptiert. Wähle „Schlüssel ersetzen“, um einen gültigen einzugeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{provider} didn't accept your API key. Choose Replace key to enter a working one."
          }
        },
