{
  "sourceLanguage" : "en",
  "strings" : {
    "trust.allowsRepoFrom" : {
      "comment" : "Agent pane: the folder trust question above the composer (scope: repo or folder; what trusting allows; Not now)",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعمل هذه المحادثة في {folder}. الثقة بالمستودع تتيح لـ {agent} تشغيل الأوامر وتعديل الملفات فيه وفي كل أشجار العمل التابعة له، وتحمّل خطافاته وخوادم MCP وإعداداته. ليس الآن: لن يعمل {agent} هنا حتى تثق به."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj chat radi u {folder}. Povjerenje u repozitorij omogućava agentu {agent} da pokreće naredbe i uređuje fajlove u njemu i svim njegovim radnim stablima, i učitava njegove hookove, MCP servere i postavke. Ne sada: {agent} se neće pokretati ovdje dok mu ne vjerujete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne chat arbejder i {folder}. Når du stoler på repoet, kan {agent} køre kommandoer og redigere filer i det og alle dets worktrees, og dets hooks, MCP-servere og indstillinger indlæses. Ikke nu: {agent} kører ikke her, før du stoler på det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Chat arbeitet in {folder}. Vertraust du dem Repo, kann {agent} darin und in allen seinen Worktrees Befehle ausführen und Dateien bearbeiten, und seine Hooks, MCP-Server und Einstellungen werden geladen. Nicht jetzt: {agent} läuft hier erst, wenn du vertraust."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This chat is in {folder}. Trusting the repo lets {agent} run commands and edit files in it and all its worktrees, and loads its hooks, MCP servers and settings. Not now: {agent} won't run here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este chat trabaja en {folder}. Confiar en el repositorio permite a {agent} ejecutar comandos y editar archivos en él y en todos sus worktrees, y carga sus hooks, servidores MCP y ajustes. Ahora no: {agent} no se ejecutará aquí hasta que confíes en él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette discussion travaille dans {folder}. Faire confiance au dépôt permet à {agent} d'exécuter des commandes et de modifier des fichiers dans ce dépôt et tous ses worktrees, et charge ses hooks, serveurs MCP et réglages. Pas maintenant : {agent} ne s'exécutera pas ici tant que vous ne lui ferez pas confiance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa chat lavora in {folder}. Fidarti del repository permette a {agent} di eseguire comandi e modificare file al suo interno e in tutti i suoi worktree, e carica i suoi hook, server MCP e impostazioni. Non ora: {agent} non verrà eseguito qui finché non ti fidi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このチャットは {folder} で作業します。リポジトリを信頼すると、{agent} はリポジトリとそのすべてのワークツリーでコマンドを実行し、ファイルを編集でき、フック、MCP サーバー、設定も読み込まれます。後で: 信頼するまで {agent} はここで実行されません。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការជជែកនេះធ្វើការក្នុង {folder}។ ការទុកចិត្តឃ្លាំងអនុញ្ញាតឱ្យ {agent} ដំណើរការពាក្យបញ្ជា និងកែឯកសារក្នុងវា និង worktree ទាំងអស់ ហើយផ្ទុក hooks, ម៉ាស៊ីនមេ MCP និងការកំណត់របស់វា។ មិនមែនឥឡូវ៖ {agent} នឹងមិនដំណើរការនៅទីនេះទេ រហូតដល់អ្នកទុកចិត្ត។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 채팅은 {folder}에서 작업합니다. 저장소를 신뢰하면 {agent}이(가) 저장소와 모든 워크트리에서 명령을 실행하고 파일을 편집할 수 있으며, 훅, MCP 서버, 설정이 로드됩니다. 나중에: 신뢰하기 전까지 {agent}은(는) 여기서 실행되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne chatten jobber i {folder}. Stoler du på repoet, kan {agent} kjøre kommandoer og redigere filer i det og alle dets worktrees, og dets hooks, MCP-servere og innstillinger lastes inn. Ikke nå: {agent} kjører ikke her før du stoler på det."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten czat pracuje w {folder}. Zaufanie repozytorium pozwala agentowi {agent} uruchamiać polecenia i edytować pliki w nim i we wszystkich jego worktree oraz wczytuje jego hooki, serwery MCP i ustawienia. Nie teraz: {agent} nie uruchomi się tu, dopóki mu nie zaufasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este chat trabalha em {folder}. Confiar no repositório permite que {agent} execute comandos e edite arquivos nele e em todos os seus worktrees, e carrega seus hooks, servidores MCP e configurações. Agora não: {agent} não será executado aqui até você confiar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот чат работает в {folder}. Доверие к репозиторию позволяет {agent} выполнять команды и редактировать файлы в нём и во всех его рабочих деревьях, а также загружает его хуки, MCP-серверы и настройки. Не сейчас: {agent} не будет запускаться здесь, пока вы не доверитесь."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แชตนี้ทำงานใน {folder} การเชื่อถือรีโพทำให้ {agent} เรียกใช้คำสั่งและแก้ไขไฟล์ในรีโพและ worktree ทั้งหมดได้ และโหลด hooks, เซิร์ฟเวอร์ MCP และการตั้งค่าของรีโพ ไม่ใช่ตอนนี้: {agent} จะไม่ทำงานที่นี่จนกว่าคุณจะเชื่อถือ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sohbet {folder} içinde çalışıyor. Depoya güvenmek, {agent} için depoda ve tüm worktree'lerinde komut çalıştırmayı ve dosya düzenlemeyi açar; hook'ları, MCP sunucuları ve ayarları yüklenir. Şimdi değil: güvenene kadar {agent} burada çalışmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей чат працює в {folder}. Довіра до репозиторію дозволяє {agent} виконувати команди й редагувати файли в ньому та в усіх його робочих деревах і завантажує його хуки, MCP-сервери й налаштування. Не зараз: {agent} не запускатиметься тут, доки ви не довіритеся."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộc trò chuyện này làm việc trong {folder}. Tin cậy kho cho phép {agent} chạy lệnh và chỉnh sửa tệp trong kho và mọi worktree của nó, đồng thời tải hooks, máy chủ MCP và cài đặt của kho. Để sau: {agent} sẽ không chạy ở đây cho đến khi bạn tin cậy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此聊天在 {folder} 中工作。信任该仓库后，{agent} 可以在仓库及其所有工作树中运行命令和编辑文件，并加载其钩子、MCP 服务器和设置。以后再说：在你信任之前，{agent} 不会在此运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此聊天在 {folder} 中工作。信任該儲存庫後，{agent} 可以在儲存庫及其所有工作樹中執行指令和編輯檔案，並載入其掛鉤、MCP 伺服器和設定。稍後再說：在你信任之前，{agent} 不會在此執行。"
          }
        }
      }
    }
  },
  "version" : "1.0"
