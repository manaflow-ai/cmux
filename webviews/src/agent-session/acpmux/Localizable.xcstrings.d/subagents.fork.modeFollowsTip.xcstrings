{
  "sourceLanguage" : "en",
  "strings" : {
    "subagents.fork.modeFollowsTip" : {
      "comment" : "Agent pane: hover on a Claude subagent composer's read-only permission mode chip; the subagent's permissions follow its chat's live mode; {chat} is the chat",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Follows {chat}: this subagent asks for permission as the chat does. Fork it to run in another mode."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يتبع {chat}: يطلب هذا الوكيل الفرعي الإذن كما تفعل المحادثة. افرّعه لتشغيله بوضع آخر."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prati {chat}: ovaj podagent traži dozvolu kao i razgovor. Granaj ga da radi u drugom načinu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Følger {chat}: denne underagent beder om tilladelse som chatten. Forgren den for at køre i en anden tilstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folgt {chat}: Dieser Subagent fragt wie der Chat nach Erlaubnis. Zweige ihn ab, um einen anderen Modus zu nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sigue a {chat}: este subagente pide permiso como el chat. Bifúrcalo para usar otro modo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Suit {chat} : ce sous-agent demande l'autorisation comme le chat. Dérivez-le pour utiliser un autre mode."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Segue {chat}: questo subagente chiede i permessi come la chat. Derivalo per usare un'altra modalità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{chat} に従います：このサブエージェントはチャットと同じように許可を求めます。別のモードで動かすにはフォークしてください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ធ្វើតាម {chat}៖ ភ្នាក់ងាររងនេះសុំការអនុញ្ញាតដូចការជជែក។ បំបែកវាដើម្បីដំណើរការក្នុងរបៀបផ្សេង។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{chat}을(를) 따름: 이 하위 에이전트는 채팅과 같은 방식으로 권한을 요청합니다. 다른 모드로 실행하려면 분기하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Følger {chat}: denne underagenten ber om tillatelse slik chatten gjør. Forgren den for å kjøre i en annen modus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Podąża za {chat}: ten podagent prosi o zgodę tak jak czat. Rozgałęź go, by użyć innego trybu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Segue {chat}: este subagente pede permissão como o chat. Bifurque-o para usar outro modo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Следует за {chat}: этот субагент спрашивает разрешения так же, как чат. Ответвите его, чтобы запустить в другом режиме."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ตาม {chat}: ซับเอเจนต์นี้ขอสิทธิ์แบบเดียวกับแชต แยกออกเพื่อใช้โหมดอื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "{chat} sohbetini izler: bu alt ajan sohbet gibi izin ister. Başka bir modda çalıştırmak için çatallayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Слідує за {chat}: цей субагент питає дозволу так само, як чат. Відгалузьте його, щоб запустити в іншому режимі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Theo {chat}: tác tử phụ này xin quyền giống như cuộc trò chuyện. Tách nó ra để chạy ở chế độ khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "跟随 {chat}：此子代理像对话一样请求权限。分叉后可使用其他模式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "跟隨 {chat}：此子代理像對話一樣請求權限。分叉後可使用其他模式。"
          }
        }
