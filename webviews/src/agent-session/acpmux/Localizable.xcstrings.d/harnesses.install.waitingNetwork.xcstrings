{
  "sourceLanguage" : "en",
  "strings" : {
    "harnesses.install.waitingNetwork" : {
      "comment" : "Agent pane: a Harnesses row or the composer's setup strip while an install waits for the network to come back (it then goes on by itself)",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في انتظار الشبكة. يستمر التثبيت عند عودة الاتصال."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čeka se mreža. Instalacija se nastavlja kada se ponovo povežete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venter på netværket. Installationen fortsætter, når du er online igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warte auf das Netzwerk. Die Installation geht weiter, sobald du wieder online bist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waiting for the network. The install goes on when you're back online."
          }
        },
