{
  "sourceLanguage" : "en",
  "strings" : {
    "inspector.perfOffHint" : {
      "comment" : "Agent pane ACP inspector: the Perf tab (live perf watch)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off. Turn it on to time new chats, page loads and workspace switches, and to see what the app reads and sends."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متوقف. شغّله لقياس وقت المحادثات الجديدة وتحميل الصفحات والتبديل بين مساحات العمل، ولرؤية ما يقرؤه التطبيق ويرسله."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isključeno. Uključite da mjerite nove razgovore, učitavanja stranica i promjene radnog prostora, i da vidite šta aplikacija čita i šalje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slået fra. Slå det til for at tage tid på nye chats, sideindlæsninger og skift af arbejdsområde og se, hvad appen læser og sender."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus. Einschalten, um neue Chats, Seitenladevorgänge und Arbeitsbereichswechsel zu messen und zu sehen, was die App liest und sendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado. Actívalo para medir chats nuevos, cargas de página y cambios de espacio de trabajo, y ver qué lee y envía la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé. Activez-le pour chronométrer les nouvelles discussions, les chargements de page et les changements d’espace de travail, et voir ce que l’app lit et envoie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivato. Attivalo per misurare nuove chat, caricamenti di pagina e cambi di area di lavoro, e vedere cosa legge e invia l’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフです。オンにすると、新しいチャット、ページの読み込み、ワークスペースの切り替えにかかる時間と、アプリが読み書きするデータを確認できます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "បិទ។ បើកវា ដើម្បីវាស់ពេលការជជែកថ្មី ការផ្ទុកទំព័រ និងការប្ដូរកន្លែងធ្វើការ ហើយមើលអ្វីដែលកម្មវិធីអាន និងផ្ញើ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꺼짐. 켜면 새 채팅, 페이지 로드, 작업 공간 전환에 걸리는 시간과 앱이 읽고 보내는 데이터를 볼 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av. Slå på for å ta tiden på nye chatter, sideinnlastinger og bytte av arbeidsområde, og se hva appen leser og sender."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłączone. Włącz, aby mierzyć nowe czaty, wczytywanie stron i przełączanie obszarów roboczych oraz zobaczyć, co aplikacja czyta i wysyła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado. Ative para medir novos chats, carregamentos de página e trocas de espaço de trabalho, e ver o que o app lê e envia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключено. Включите, чтобы замерять новые чаты, загрузку страниц и переключение рабочих пространств и видеть, что приложение читает и отправляет."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดอยู่ เปิดเพื่อจับเวลาแชทใหม่ การโหลดหน้า และการสลับพื้นที่ทำงาน และดูว่าแอปอ่านและส่งอะไร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapalı. Yeni sohbetleri, sayfa yüklemelerini ve çalışma alanı geçişlerini ölçmek ve uygulamanın ne okuyup gönderdiğini görmek için açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимкнено. Увімкніть, щоб вимірювати нові чати, завантаження сторінок і перемикання робочих просторів та бачити, що застосунок читає й надсилає."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang tắt. Bật để đo thời gian cuộc trò chuyện mới, tải trang và chuyển không gian làm việc, và xem ứng dụng đọc và gửi gì."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已关闭。打开后可计时新对话、页面加载和工作区切换，并查看应用读取和发送的数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已關閉。開啟後可計時新對話、頁面載入和工作區切換，並查看應用程式讀取和傳送的資料。"
          }
        }
      }
