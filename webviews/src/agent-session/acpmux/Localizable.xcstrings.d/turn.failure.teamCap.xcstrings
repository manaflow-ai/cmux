      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رُفض {harness}: بلغ فريقك حدّ الإنفاق. اطلب من مسؤول رفعه، أو استخدم نموذجك الخاص."
          }
        },
