{
  "sourceLanguage" : "en",
  "strings" : {
    "cloudStartup.folderTooBigRepos" : {
      "comment" : "Agent pane: Cloud start card. The chosen folder is not a git repository and is too big to copy to a Cloud machine, but has git repositories inside it, offered as buttons below. {folder} is the folder as ~/path, {size} is how much it holds (cloudStartup.folderSize).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{folder} is too big to copy ({size}). Pick one of its repositories, or start without a folder."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{folder} كبير جدًا للنسخ ({size}). اختر أحد مستودعاته، أو ابدأ بدون مجلد."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{folder} je prevelik za kopiranje ({size}). Odaberite jedan od njegovih repozitorija ili počnite bez foldera."
          }
