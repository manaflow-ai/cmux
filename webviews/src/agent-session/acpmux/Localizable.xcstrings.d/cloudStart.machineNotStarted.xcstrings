{
  "sourceLanguage": "en",
  "strings": {
    "cloudStart.machineNotStarted": {
      "comment": "Agent pane: Cloud start card. A Cloud start failed and the app said no reason; the Cloud machine did not start. Retry follows it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Cloud machine didn't start. Try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يبدأ تشغيل جهاز السحابة. حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud mašina se nije pokrenula. Pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-maskinen startede ikke. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Cloud-Maschine wurde nicht gestartet. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La máquina en la nube no se inició. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La machine cloud n'a pas démarré. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La macchina cloud non si è avviata. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドマシンが起動しませんでした。もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម៉ាស៊ីន Cloud មិនបានចាប់ផ្ដើមទេ។ សូមព្យាយាមម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 머신이 시작되지 않았습니다. 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skymaskinen startet ikke. Prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maszyna w chmurze nie uruchomiła się. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A máquina na nuvem não foi iniciada. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Облачная машина не запустилась. Повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่อง Cloud ไม่เริ่มทำงาน โปรดลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulut makinesi başlatılamadı. Tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хмарна машина не запустилася. Спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Cloud không khởi động được. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端机器未能启动。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲端機器未能啟動。請再試一次。"
