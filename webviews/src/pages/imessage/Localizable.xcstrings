    "imessage.off.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Mirror Messages (local only) in Settings to read your Messages conversations here. The mirror is read only."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل «عكس الرسائل (محليًا فقط)» في الإعدادات لقراءة محادثات الرسائل هنا. المرآة للقراءة فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključite Zrcali poruke (samo lokalno) u postavkama da biste ovdje čitali svoje razgovore iz aplikacije Poruke. Zrcalo je samo za čitanje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå Spejl Beskeder (kun lokalt) til i Indstillinger for at læse dine samtaler fra Beskeder her. Spejlet er skrivebeskyttet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere „Nachrichten spiegeln (nur lokal)“ in den Einstellungen, um deine Unterhaltungen aus Nachrichten hier zu lesen. Der Spiegel ist schreibgeschützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Replicar Mensajes (solo local) en Ajustes para leer aquí tus conversaciones de Mensajes. El espejo es de solo lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Mettre en miroir Messages (local uniquement) dans les Réglages pour lire ici vos conversations Messages. Le miroir est en lecture seule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Replica Messaggi (solo locale) nelle Impostazioni per leggere qui le tue conversazioni di Messaggi. Lo specchio è in sola lettura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「メッセージをミラー（ローカルのみ）」を設定でオンにすると、メッセージの会話をここで読めます。ミラーは読み取り専用です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បើក ឆ្លុះសារ (តែក្នុងម៉ាស៊ីនប៉ុណ្ណោះ) នៅក្នុងការកំណត់ ដើម្បីអានការសន្ទនា សារ របស់អ្នកនៅទីនេះ។ កញ្ចក់នេះអានតែប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 ‘메시지 미러링(로컬 전용)’을 켜면 메시지 대화를 여기에서 읽을 수 있습니다. 미러는 읽기 전용입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Speil Meldinger (kun lokalt) i Innstillinger for å lese Meldinger-samtalene dine her. Speilet er skrivebeskyttet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz Dublowanie Wiadomości (tylko lokalnie) w Ustawieniach, aby czytać tutaj swoje rozmowy z Wiadomości. Lustro jest tylko do odczytu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative Espelhar Mensagens (somente local) em Ajustes para ler aqui suas conversas do Mensagens. O espelho é somente leitura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите «Зеркалировать Сообщения (только локально)» в настройках, чтобы читать здесь свои переписки из Сообщений. Зеркало работает только на чтение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด มิเรอร์ข้อความ (เฉพาะในเครื่อง) ในการตั้งค่าเพื่ออ่านการสนทนาใน ข้อความ ของคุณที่นี่ มิเรอร์เป็นแบบอ่านอย่างเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajlar konuşmalarınızı burada okumak için Ayarlar'da Mesajlar'ı Yansıt (yalnızca yerel) seçeneğini açın. Yansı salt okunurdur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть «Дзеркалити Повідомлення (лише локально)» в налаштуваннях, щоб читати тут свої розмови з Повідомлень. Дзеркало працює лише на читання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật Sao chép Tin nhắn (chỉ cục bộ) trong Cài đặt để đọc các cuộc trò chuyện Tin nhắn của bạn tại đây. Bản sao chỉ để đọc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”中打开“镜像信息（仅本地）”，即可在此阅读你的信息对话。镜像为只读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「設定」中開啟「鏡像訊息（僅限本機）」，即可在此閱讀你的訊息對話。鏡像為唯讀。"
          }
        }
      }
    },
    "imessage.off.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays on this Mac: nothing is copied, synced or sent anywhere."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء يبقى على هذا الـ Mac: لا يتم نسخ أي شيء أو مزامنته أو إرساله إلى أي مكان."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve ostaje na ovom Macu: ništa se ne kopira, sinkronizira niti šalje nigdje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt bliver på denne Mac: intet kopieres, synkroniseres eller sendes nogen steder hen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt auf diesem Mac: Nichts wird kopiert, synchronisiert oder irgendwohin gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se queda en este Mac: no se copia, sincroniza ni envía nada a ningún sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste sur ce Mac : rien n’est copié, synchronisé ni envoyé ailleurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto resta su questo Mac: nulla viene copiato, sincronizzato o inviato altrove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてこの Mac 上に留まります。コピー、同期、送信は一切行われません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្វីៗទាំងអស់នៅលើ Mac នេះ៖ គ្មានអ្វីត្រូវបានចម្លង ធ្វើសមកាលកម្ម ឬផ្ញើទៅកន្លែងណាទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 내용은 이 Mac에만 남으며, 어디에도 복사, 동기화 또는 전송되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt blir på denne Macen: ingenting kopieres, synkroniseres eller sendes noe sted."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko pozostaje na tym Macu: nic nie jest kopiowane, synchronizowane ani nigdzie wysyłane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo fica neste Mac: nada é copiado, sincronizado ou enviado para lugar nenhum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё остаётся на этом Mac: ничего не копируется, не синхронизируется и никуда не отправляется."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างอยู่บน Mac เครื่องนี้ ไม่มีการคัดลอก ซิงค์ หรือส่งไปที่ใด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey bu Mac'te kalır: hiçbir şey kopyalanmaz, senkronize edilmez veya herhangi bir yere gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе залишається на цьому Mac: нічого не копіюється, не синхронізується і нікуди не надсилається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ đều ở lại trên máy Mac này: không có gì được sao chép, đồng bộ hóa hay gửi đi đâu cả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都保留在这台 Mac 上：不会复制、同步或发送到任何地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都保留在這部 Mac 上：不會拷貝、同步或傳送到任何地方。"
          }
        }
      }
    },
