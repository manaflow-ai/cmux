    "imessage.error.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux couldn't read the Messages database right now."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على cmux قراءة قاعدة بيانات الرسائل حاليًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux trenutno ne može pročitati bazu podataka aplikacije Poruke."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux kunne ikke læse Beskeder-databasen lige nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux konnte die Nachrichten-Datenbank gerade nicht lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no pudo leer la base de datos de Mensajes en este momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux n’a pas pu lire la base de données de Messages pour le moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento cmux non è riuscito a leggere il database di Messaggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux は現在メッセージのデータベースを読み取れませんでした。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux មិនអាចអានមូលដ្ឋានទិន្នន័យ សារ បានទេនៅពេលនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 지금은 메시지 데이터베이스를 읽을 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux kunne ikke lese Meldinger-databasen akkurat nå."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nie mógł teraz odczytać bazy danych Wiadomości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux não conseguiu ler o banco de dados do Mensagens agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux сейчас не удалось прочитать базу данных Сообщений."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะนี้ cmux ไม่สามารถอ่านฐานข้อมูลข้อความได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux şu anda Mesajlar veritabanını okuyamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux зараз не вдалося прочитати базу даних Повідомлень."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện cmux không thể đọc cơ sở dữ liệu Tin nhắn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 目前无法读取“信息”数据库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 目前無法讀取「訊息」資料庫。"
          }
        }
      }
