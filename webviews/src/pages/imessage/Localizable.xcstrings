    "imessage.access.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The grant goes to the cmux app. cmux reads Messages only while the mirror is on."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُمنح الإذن لتطبيق cmux. يقرأ cmux الرسائل فقط أثناء تشغيل المرآة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvola se daje aplikaciji cmux. cmux čita poruke samo dok je zrcalo uključeno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilladelsen gives til cmux-appen. cmux læser kun Beskeder, mens spejlet er slået til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff wird der cmux-App erteilt. cmux liest Nachrichten nur, solange der Spiegel aktiviert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso se concede a la app cmux. cmux solo lee Mensajes mientras el espejo está activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation est accordée à l’app cmux. cmux ne lit Messages que lorsque le miroir est activé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorizzazione viene concessa all’app cmux. cmux legge Messaggi solo mentre lo specchio è attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可は cmux アプリに付与されます。cmux はミラーがオンの間だけメッセージを読み取ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការអនុញ្ញាតត្រូវបានផ្តល់ឱ្យកម្មវិធី cmux។ cmux អាន សារ តែនៅពេលកញ្ចក់បើកប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한은 cmux 앱에 부여됩니다. cmux는 미러가 켜져 있는 동안에만 메시지를 읽습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilgangen gis til cmux-appen. cmux leser Meldinger bare mens speilet er på."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uprawnienie otrzymuje aplikacja cmux. cmux odczytuje Wiadomości tylko wtedy, gdy lustro jest włączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão é concedida ao app cmux. O cmux lê o Mensagens apenas enquanto o espelho está ativado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение предоставляется приложению cmux. cmux читает Сообщения только при включённом зеркале."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิทธิ์จะมอบให้กับแอป cmux โดย cmux จะอ่านข้อความเฉพาะเมื่อเปิดมิเรอร์เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin cmux uygulamasına verilir. cmux, Mesajlar'ı yalnızca yansı açıkken okur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвіл надається застосунку cmux. cmux читає Повідомлення лише поки дзеркало ввімкнене."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền được cấp cho ứng dụng cmux. cmux chỉ đọc Tin nhắn khi bản sao đang bật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权将授予 cmux App。仅当镜像开启时，cmux 才会读取信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "授權會授予 cmux App。只有在鏡像開啟時，cmux 才會讀取訊息。"
          }
        }
      }
    },
