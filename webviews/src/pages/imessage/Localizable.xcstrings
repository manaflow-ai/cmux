    "imessage.empty.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Messages conversations show here as they arrive."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر محادثات الرسائل هنا فور وصولها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši razgovori iz aplikacije Poruke prikazuju se ovdje čim stignu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine samtaler fra Beskeder vises her, når de modtages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Unterhaltungen aus Nachrichten erscheinen hier, sobald sie eintreffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus conversaciones de Mensajes aparecerán aquí a medida que lleguen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos conversations Messages s’affichent ici à mesure qu’elles arrivent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue conversazioni di Messaggi appaiono qui man mano che arrivano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージの会話は、届き次第ここに表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការសន្ទនា សារ របស់អ្នកនឹងបង្ហាញនៅទីនេះនៅពេលមកដល់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지 대화가 도착하는 대로 여기에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldinger-samtalene dine vises her etter hvert som de kommer inn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje rozmowy z Wiadomości pojawią się tutaj, gdy tylko nadejdą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas conversas do Mensagens aparecem aqui conforme chegam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши переписки из Сообщений появятся здесь по мере поступления."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสนทนาในข้อความของคุณจะแสดงที่นี่เมื่อมีเข้ามา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajlar konuşmalarınız geldikçe burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші розмови з Повідомлень з’являтимуться тут, щойно надійдуть."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cuộc trò chuyện Tin nhắn của bạn sẽ hiển thị ở đây khi có tin mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的信息对话会在到达时显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的訊息對話會在收到時顯示在這裡。"
          }
        }
      }
    },
