    "imessage.access.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux needs Full Disk Access to read Messages"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج cmux إلى «الوصول الكامل إلى القرص» لقراءة الرسائل"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux treba Potpuni pristup disku za čitanje poruka"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux har brug for Fuld diskadgang for at læse Beskeder"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux benötigt Festplattenvollzugriff, um Nachrichten zu lesen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux necesita Acceso total al disco para leer Mensajes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux a besoin de l’Accès complet au disque pour lire Messages"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ha bisogno dell’Accesso completo al disco per leggere Messaggi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux がメッセージを読み取るにはフルディスクアクセスが必要です"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ត្រូវការ ការចូលប្រើថាសពេញលេញ ដើម្បីអាន សារ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux에서 메시지를 읽으려면 전체 디스크 접근 권한이 필요합니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux trenger Full disktilgang for å lese Meldinger"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux potrzebuje Pełnego dostępu do dysku, aby czytać Wiadomości"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux precisa de Acesso Total ao Disco para ler o Mensagens"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux нужен Доступ ко всему диску для чтения Сообщений"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ต้องมีการเข้าถึงดิสก์แบบเต็มเพื่ออ่านข้อความ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux'un Mesajlar'ı okumak için Tam Disk Erişimi'ne ihtiyacı var"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux потребує Повного доступу до диска для читання Повідомлень"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux cần Truy cập toàn bộ ổ đĩa để đọc Tin nhắn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 需要“完全磁盘访问权限”才能读取信息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 需要「完整磁碟取用權限」才能讀取訊息"
          }
        }
      }
    },
    "imessage.access.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS keeps the Messages database private. Turn on cmux under Full Disk Access, then come back here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُبقي macOS قاعدة بيانات الرسائل خاصة. شغّل cmux ضمن «الوصول الكامل إلى القرص»، ثم عد إلى هنا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS čuva bazu podataka aplikacije Poruke privatnom. Uključite cmux u Potpunom pristupu disku, a zatim se vratite ovdje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS holder databasen for Beskeder privat. Slå cmux til under Fuld diskadgang, og vend derefter tilbage hertil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hält die Nachrichten-Datenbank privat. Aktiviere cmux unter Festplattenvollzugriff und kehre dann hierher zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS mantiene privada la base de datos de Mensajes. Activa cmux en Acceso total al disco y vuelve aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS garde la base de données de Messages privée. Activez cmux dans Accès complet au disque, puis revenez ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS mantiene privato il database di Messaggi. Attiva cmux in Accesso completo al disco, poi torna qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS はメッセージのデータベースを非公開にしています。フルディスクアクセスで cmux をオンにしてから、ここに戻ってください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS រក្សាទុកមូលដ្ឋានទិន្នន័យ សារ ជាឯកជន។ បើក cmux នៅក្រោម ការចូលប្រើថាសពេញលេញ បន្ទាប់មកត្រឡប់មកទីនេះវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS는 메시지 데이터베이스를 비공개로 유지합니다. 전체 디스크 접근 권한에서 cmux를 켠 다음 여기로 돌아오세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS holder Meldinger-databasen privat. Slå på cmux under Full disktilgang, og kom deretter tilbake hit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS chroni bazę danych Wiadomości. Włącz cmux w Pełnym dostępie do dysku, a następnie wróć tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS mantém o banco de dados do Mensagens privado. Ative o cmux em Acesso Total ao Disco e volte aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS хранит базу данных Сообщений в закрытом виде. Включите cmux в разделе «Доступ ко всему диску», затем вернитесь сюда."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS เก็บฐานข้อมูลข้อความเป็นส่วนตัว เปิด cmux ในการเข้าถึงดิสก์แบบเต็ม แล้วกลับมาที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS, Mesajlar veritabanını gizli tutar. Tam Disk Erişimi altında cmux'u açın, ardından buraya dönün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS зберігає базу даних Повідомлень закритою. Увімкніть cmux у Повному доступі до диска, а потім поверніться сюди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS giữ cơ sở dữ liệu Tin nhắn ở chế độ riêng tư. Bật cmux trong Truy cập toàn bộ ổ đĩa, rồi quay lại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 会将“信息”数据库保密。请在“完全磁盘访问权限”中打开 cmux，然后返回此处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 會將「訊息」資料庫保密。請在「完整磁碟取用權限」中開啟 cmux，然後回到此處。"
          }
        }
      }
    },
    "imessage.access.action": {
