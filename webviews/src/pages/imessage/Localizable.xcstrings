    "imessage.missing.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no Messages database on this Mac yet. Sign in to Messages, then come back here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد قاعدة بيانات للرسائل على هذا الـ Mac بعد. سجّل الدخول إلى الرسائل ثم عد إلى هنا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ovom Macu još nema baze podataka aplikacije Poruke. Prijavite se u Poruke, a zatim se vratite ovdje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er endnu ingen Beskeder-database på denne Mac. Log ind på Beskeder, og vend derefter tilbage hertil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Mac gibt es noch keine Nachrichten-Datenbank. Melde dich bei Nachrichten an und kehre dann hierher zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay una base de datos de Mensajes en este Mac. Inicia sesión en Mensajes y vuelve aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a pas encore de base de données Messages sur ce Mac. Connectez-vous à Messages, puis revenez ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c’è ancora un database di Messaggi su questo Mac. Accedi a Messaggi, poi torna qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac にはまだメッセージのデータベースがありません。メッセージにサインインしてから、ここに戻ってください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនទាន់មានមូលដ្ឋានទិន្នន័យ សារ នៅលើ Mac នេះទេ។ ចូលទៅ សារ បន្ទាប់មកត្រឡប់មកទីនេះវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에는 아직 메시지 데이터베이스가 없습니다. 메시지에 로그인한 다음 여기로 돌아오세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finnes ingen Meldinger-database på denne Macen ennå. Logg inn på Meldinger, og kom deretter tilbake hit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tym Macu nie ma jeszcze bazy danych Wiadomości. Zaloguj się w Wiadomościach, a następnie wróć tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há um banco de dados do Mensagens neste Mac. Faça login no Mensagens e volte aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом Mac ещё нет базы данных Сообщений. Войдите в Сообщения, затем вернитесь сюда."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีฐานข้อมูลข้อความบน Mac เครื่องนี้ ลงชื่อเข้าใช้ข้อความ แล้วกลับมาที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'te henüz bir Mesajlar veritabanı yok. Mesajlar'da oturum açın, ardından buraya dönün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому Mac ще немає бази даних Повідомлень. Увійдіть у Повідомлення, а потім поверніться сюди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac này chưa có cơ sở dữ liệu Tin nhắn. Hãy đăng nhập vào Tin nhắn, rồi quay lại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上还没有“信息”数据库。请登录“信息”，然后返回此处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部 Mac 上還沒有「訊息」資料庫。請登入「訊息」，然後回到此處。"
          }
        }
      }
    },
