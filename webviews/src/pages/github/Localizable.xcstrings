    "github.ready.history": {
      "comment": "Merge readiness blocker: only part of the conversation was read, so a BLOCK review in older comments cannot be ruled out. The first %@ is how many entries were read, the second how many there are",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read %1$@ of %2$@ comments: an older BLOCK may be unread"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت قراءة %1$@ من %2$@ تعليقًا: قد يكون هناك BLOCK أقدم غير مقروء"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pročitano %1$@ od %2$@ komentara: stariji BLOCK možda nije pročitan"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læst %1$@ af %2$@ kommentarer: en ældre BLOCK kan være ulæst"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ von %2$@ Kommentaren gelesen: ein älterer BLOCK ist evtl. ungelesen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leídos %1$@ de %2$@ comentarios: puede haber un BLOCK anterior sin leer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ commentaires lus sur %2$@ : un BLOCK plus ancien peut être non lu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Letti %1$@ di %2$@ commenti: un BLOCK precedente potrebbe non essere letto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 件中 %1$@ 件のコメントを読み込み: 古い BLOCK が未読の可能性"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បានអាន %1$@ ក្នុងចំណោម %2$@ មតិ៖ BLOCK ចាស់ៗអាចមិនទាន់អាន"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "댓글 %2$@개 중 %1$@개 읽음: 이전 BLOCK을 못 읽었을 수 있음"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lest %1$@ av %2$@ kommentarer: en eldre BLOCK kan være ulest"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytano %1$@ z %2$@ komentarzy: starszy BLOCK może być nieodczytany"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lidos %1$@ de %2$@ comentários: um BLOCK mais antigo pode não ter sido lido"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитано %1$@ из %2$@ комментариев: более ранний BLOCK мог остаться непрочитанным"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านแล้ว %1$@ จาก %2$@ ความคิดเห็น: อาจมี BLOCK เก่าที่ยังไม่ได้อ่าน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ yorumdan %1$@ tanesi okundu: daha eski bir BLOCK okunmamış olabilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитано %1$@ з %2$@ коментарів: старіший BLOCK міг лишитися непрочитаним"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã đọc %1$@ trên %2$@ bình luận: có thể còn BLOCK cũ chưa đọc"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已读取 %2$@ 条评论中的 %1$@ 条：较早的 BLOCK 可能未读"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已讀取 %2$@ 則留言中的 %1$@ 則：較早的 BLOCK 可能未讀"
          }
        }
      }
    }
  },
