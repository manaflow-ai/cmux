    "github.ready.review.detail": {
      "comment": "Merge readiness detail: what the review gate needs. %@ is the short head commit",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs a SHIP receipt at %@ from a model family other than the author's, or from a person."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم إيصال SHIP عند %@ من عائلة نماذج غير عائلة المؤلف، أو من شخص."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebna je SHIP potvrda na %@ iz porodice modela različite od autorove ili od osobe."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kræver en SHIP-kvittering ved %@ fra en anden modelfamilie end forfatterens, eller fra en person."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Braucht eine SHIP-Quittung bei %@ von einer anderen Modellfamilie als der des Autors oder von einer Person."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita un recibo SHIP en %@ de una familia de modelos distinta de la del autor, o de una persona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut un reçu SHIP à %@ d'une famille de modèles autre que celle de l'auteur, ou d'une personne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve una ricevuta SHIP a %@ da una famiglia di modelli diversa da quella dell'autore, o da una persona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で、作成者とは別のモデルファミリーまたは人による SHIP レシートが必要です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ត្រូវការបង្កាន់ដៃ SHIP នៅ %@ ពីក្រុមម៉ូដែលផ្សេងពីអ្នកនិពន្ធ ឬពីមនុស្ស។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 작성자와 다른 모델 계열 또는 사람의 SHIP 영수증이 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenger en SHIP-kvittering ved %@ fra en annen modellfamilie enn forfatterens, eller fra en person."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrzebne jest potwierdzenie SHIP na %@ od rodziny modeli innej niż autora lub od osoby."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisa de um recibo SHIP em %@ de uma família de modelos diferente da do autor, ou de uma pessoa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужна SHIP-квитанция на %@ от семейства моделей, отличного от авторского, или от человека."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องมีใบรับ SHIP ที่ %@ จากตระกูลโมเดลอื่นที่ไม่ใช่ของผู้เขียน หรือจากบุคคล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ üzerinde, yazarınkinden farklı bir model ailesinden veya bir kişiden SHIP makbuzu gerekiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібна SHIP-квитанція на %@ від родини моделей, відмінної від авторської, або від людини."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần biên nhận SHIP tại %@ từ một họ mô hình khác với của tác giả, hoặc từ một người."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要在 %@ 上由作者以外的模型家族或真人给出的 SHIP 凭证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要在 %@ 上由作者以外的模型家族或真人給出的 SHIP 憑證。"
          }
        }
      }
    },
    "github.ready.review.own": {
      "comment": "Merge readiness detail: the passing review is by the author's own model family",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SHIP at the head is from the author's own model family, so it does not count."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "SHIP عند الرأس من عائلة نماذج المؤلف نفسها، لذا لا يُحتسب."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "SHIP na vrhu je iz autorove porodice modela, pa se ne računa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "SHIP ved head er fra forfatterens egen modelfamilie og tæller derfor ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der SHIP am Head stammt von der Modellfamilie des Autors und zählt daher nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El SHIP del head es de la misma familia de modelos que el autor, así que no cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le SHIP du head vient de la famille de modèles de l'auteur, il ne compte donc pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo SHIP sull'head è della stessa famiglia di modelli dell'autore, quindi non conta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先頭コミットの SHIP は作成者と同じモデルファミリーのものなので、有効になりません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "SHIP នៅ head មកពីក្រុមម៉ូដែលរបស់អ្នកនិពន្ធផ្ទាល់ ដូច្នេះមិនរាប់ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "헤드의 SHIP이 작성자와 같은 모델 계열의 것이라 인정되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "SHIP-en ved head er fra forfatterens egen modellfamilie og teller derfor ikke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "SHIP na head pochodzi z rodziny modeli autora, więc się nie liczy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SHIP no head é da própria família de modelos do autor, então não conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SHIP на head — от семейства моделей автора, поэтому он не засчитывается."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "SHIP ที่ head มาจากตระกูลโมเดลเดียวกับผู้เขียน จึงไม่นับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Head üzerindeki SHIP yazarın kendi model ailesinden olduğu için sayılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "SHIP на head — від родини моделей автора, тож він не зараховується."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "SHIP tại head đến từ chính họ mô hình của tác giả nên không được tính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "head 上的 SHIP 来自作者自己的模型家族,因此不计入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "head 上的 SHIP 來自作者自己的模型家族,因此不計入。"
          }
        }
      }
