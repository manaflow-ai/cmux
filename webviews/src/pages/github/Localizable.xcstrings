          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ny kjøring startet. De mislykkede jobbene kjører på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponowne uruchomienie rozpoczęte. Nieudane zadania działają ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nova execução iniciada. Os jobs com falha são executados de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезапуск начат. Упавшие задачи выполняются снова."
