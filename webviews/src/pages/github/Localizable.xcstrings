    "github.checks.rerunStarted": {
      "comment": "Shown after GitHub took the re-run of the failed jobs",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-run started. The failed jobs run again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدأت إعادة التشغيل. تعمل المهام الفاشلة مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno pokretanje je počelo. Neuspjeli poslovi se ponovo izvode."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genkørsel startet. De fejlede jobs kører igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneute Ausführung gestartet. Die fehlgeschlagenen Jobs laufen erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nueva ejecución iniciada. Los trabajos fallidos se ejecutan de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relance démarrée. Les tâches en échec s'exécutent à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riesecuzione avviata. I job non riusciti vengono eseguiti di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再実行を開始しました。失敗したジョブがもう一度実行されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បានចាប់ផ្ដើមដំណើរការឡើងវិញ។ ការងារដែលបរាជ័យកំពុងដំណើរការម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
