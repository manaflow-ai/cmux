    "github.unavailable": {
      "comment": "The GitHub page's title when the pull request could not be read",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux could not read this pull request. Check that the GitHub CLI (gh) is signed in, or open it on GitHub."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على cmux قراءة طلب السحب هذا. تحقّق من تسجيل الدخول في GitHub CLI ‏(gh)، أو افتحه على GitHub."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nije mogao pročitati ovaj pull request. Provjerite je li GitHub CLI (gh) prijavljen ili ga otvorite na GitHubu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux kunne ikke læse denne pull request. Kontrollér, at GitHub CLI (gh) er logget ind, eller åbn den på GitHub."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux konnte diesen Pull Request nicht lesen. Prüfe, ob die GitHub CLI (gh) angemeldet ist, oder öffne ihn auf GitHub."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no pudo leer esta pull request. Comprueba que GitHub CLI (gh) tenga la sesión iniciada o ábrela en GitHub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux n’a pas pu lire cette pull request. Vérifiez que GitHub CLI (gh) est connecté, ou ouvrez-la sur GitHub."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux non è riuscito a leggere questa pull request. Verifica l’accesso a GitHub CLI (gh) o aprila su GitHub."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux はこのプルリクエストを読み込めませんでした。GitHub CLI (gh) にサインインしているか確認するか、GitHub で開いてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux មិនអាចអាន pull request នេះបានទេ។ សូមពិនិត្យថា GitHub CLI (gh) បានចូលគណនី ឬបើកវានៅលើ GitHub។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 이 풀 리퀘스트를 읽지 못했습니다. GitHub CLI(gh)에 로그인되어 있는지 확인하거나 GitHub에서 여세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux kunne ikke lese denne pull requesten. Kontroller at GitHub CLI (gh) er logget på, eller åpne den på GitHub."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nie mógł odczytać tego pull requesta. Sprawdź, czy GitHub CLI (gh) jest zalogowane, lub otwórz go na GitHubie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux não conseguiu ler este pull request. Verifique se o GitHub CLI (gh) está conectado ou abra-o no GitHub."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux не удалось прочитать этот пул-реквест. Убедитесь, что вы вошли в GitHub CLI (gh), или откройте его на GitHub."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux อ่าน pull request นี้ไม่ได้ ตรวจสอบว่าได้ลงชื่อเข้าใช้ GitHub CLI (gh) แล้ว หรือเปิดบน GitHub"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux bu çekme isteğini okuyamadı. GitHub CLI (gh) oturumunun açık olduğunu denetleyin veya GitHub'da açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux не вдалося прочитати цей пул-реквест. Переконайтеся, що ви ввійшли в GitHub CLI (gh), або відкрийте його на GitHub."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux không đọc được pull request này. Hãy kiểm tra GitHub CLI (gh) đã đăng nhập, hoặc mở trên GitHub."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 无法读取此拉取请求。请确认 GitHub CLI (gh) 已登录，或在 GitHub 上打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 無法讀取此拉取請求。請確認 GitHub CLI (gh) 已登入，或在 GitHub 上開啟。"
          }
        }
      }
    },
