    "github.noPullRequest": {
      "comment": "The GitHub page with no pull request to show",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page shows a GitHub pull request. Open one from a chat."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض هذه الصفحة طلب سحب من GitHub. افتح واحدًا من محادثة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova stranica prikazuje GitHub pull request. Otvorite ga iz razgovora."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne side viser en GitHub-pull request. Åbn en fra en chat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Seite zeigt einen GitHub-Pull-Request. Öffne einen aus einem Chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página muestra una pull request de GitHub. Abre una desde un chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette page affiche une pull request GitHub. Ouvrez-en une depuis une discussion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa pagina mostra una pull request di GitHub. Aprine una da una chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページには GitHub のプルリクエストが表示されます。チャットから開いてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ទំព័រនេះបង្ហាញ pull request របស់ GitHub។ សូមបើកមួយពីការជជែក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 페이지는 GitHub 풀 리퀘스트를 보여 줍니다. 채팅에서 하나를 여세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne siden viser en GitHub-pull request. Åpne en fra en chat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta strona pokazuje pull request z GitHuba. Otwórz go z czatu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página mostra um pull request do GitHub. Abra um a partir de um chat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этой странице показывается пул-реквест GitHub. Откройте его из чата."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้านี้แสดง pull request ของ GitHub เปิดจากแชต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sayfa bir GitHub çekme isteğini gösterir. Bir sohbetten açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цій сторінці показано пул-реквест GitHub. Відкрийте його з чату."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trang này hiển thị một pull request trên GitHub. Hãy mở từ một cuộc trò chuyện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此页面显示 GitHub 拉取请求。请从聊天中打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此頁面顯示 GitHub 拉取請求。請從聊天中開啟。"
          }
        }
      }
    },
    "github.loading": {
