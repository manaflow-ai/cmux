    "stats.page.private": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From this computer's agent logs. Nothing leaves this computer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من سجلات الوكلاء على هذا الكمبيوتر. لا يغادر شيء هذا الكمبيوتر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Iz zapisnika agenata na ovom računaru. Ništa ne napušta ovaj računar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra agentlogfilerne på denne computer. Intet forlader denne computer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus den Agent-Protokollen dieses Computers. Nichts verlässt diesen Computer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir de los registros de agentes de este ordenador. Nada sale de este ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D'après les journaux des agents de cet ordinateur. Rien ne quitte cet ordinateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai log degli agenti di questo computer. Nulla lascia questo computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンピュータのエージェントログから集計。データはこのコンピュータの外に出ません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពីកំណត់ហេតុភ្នាក់ងារនៅលើកុំព្យូទ័រនេះ។ គ្មានអ្វីចេញពីកុំព្យូទ័រនេះទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 컴퓨터의 에이전트 로그에서 집계합니다. 어떤 데이터도 이 컴퓨터를 떠나지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra agentloggene på denne datamaskinen. Ingenting forlater denne datamaskinen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na podstawie dzienników agentów na tym komputerze. Nic nie opuszcza tego komputera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos registros de agentes deste computador. Nada sai deste computador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По журналам агентов на этом компьютере. Ничего не покидает этот компьютер."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จากบันทึกของเอเจนต์บนคอมพิวเตอร์เครื่องนี้ ไม่มีข้อมูลใดออกจากคอมพิวเตอร์เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bilgisayardaki ajan günlüklerinden. Hiçbir şey bu bilgisayardan çıkmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За журналами агентів на цьому комп'ютері. Ніщо не залишає цей комп'ютер."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từ nhật ký tác tử trên máy tính này. Không có gì rời khỏi máy tính này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自这台电脑上的智能体日志。任何数据都不会离开这台电脑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
