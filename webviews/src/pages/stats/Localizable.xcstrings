    "stats.usage.off": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Off. Turn on Record Usage Patterns in Settings > Privacy and Security to count which commands, layouts and agents you use most. Counts only, and they stay on this computer."}},
        "ar": {"stringUnit": {"state": "translated", "value": "متوقف. فعّل «تسجيل أنماط الاستخدام» في الإعدادات > الخصوصية والأمان لإحصاء الأوامر والتخطيطات والوكلاء التي تستخدمها أكثر. أعداد فقط، وتبقى على هذا الكمبيوتر."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Isključeno. Uključite Bilježi obrasce korištenja u Postavke > Privatnost i sigurnost kako biste brojali koje naredbe, rasporede i agente najviše koristite. Samo brojevi, i ostaju na ovom računaru."}},
        "da": {"stringUnit": {"state": "translated", "value": "Slået fra. Slå Registrer brugsmønstre til i Indstillinger > Anonymitet og sikkerhed for at tælle, hvilke kommandoer, layouts og agenter du bruger mest. Kun tællinger, og de bliver på denne computer."}},
        "de": {"stringUnit": {"state": "translated", "value": "Aus. Aktiviere Nutzungsmuster aufzeichnen unter Einstellungen > Datenschutz & Sicherheit, um zu zählen, welche Befehle, Layouts und Agenten du am meisten nutzt. Nur Zählwerte, und sie bleiben auf diesem Computer."}},
        "es": {"stringUnit": {"state": "translated", "value": "Desactivado. Activa Registrar patrones de uso en Ajustes > Privacidad y seguridad para contar qué comandos, diseños y agentes usas más. Solo recuentos, y se quedan en este ordenador."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Désactivé. Activez Enregistrer les habitudes d’utilisation dans Réglages > Confidentialité et sécurité pour compter les commandes, dispositions et agents que vous utilisez le plus. Seulement des compteurs, qui restent sur cet ordinateur."}},
        "it": {"stringUnit": {"state": "translated", "value": "Disattivato. Attiva Registra schemi di utilizzo in Impostazioni > Privacy e sicurezza per contare quali comandi, layout e agenti usi di più. Solo conteggi, che restano su questo computer."}},
        "ja": {"stringUnit": {"state": "translated", "value": "オフ。設定 > プライバシーとセキュリティで「使用パターンを記録」をオンにすると、よく使うコマンド、レイアウト、エージェントを集計します。集計のみで、このコンピュータ内に保存されます。"}},
        "km": {"stringUnit": {"state": "translated", "value": "បិទ។ បើក កត់ត្រាលំនាំនៃការប្រើប្រាស់ នៅក្នុង ការកំណត់ > ឯកជនភាព និងសុវត្ថិភាព ដើម្បីរាប់ពាក្យបញ្ជា ប្លង់ និងភ្នាក់ងារដែលអ្នកប្រើច្រើនបំផុត។ រាប់តែចំនួនប៉ុណ្ណោះ ហើយវានៅលើកុំព្យូទ័រនេះ។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "꺼짐. 설정 > 개인정보 보호 및 보안에서 '사용 패턴 기록'을 켜면 가장 많이 사용하는 명령, 레이아웃, 에이전트를 집계합니다. 횟수만 집계되며 이 컴퓨터에만 저장됩니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Av. Slå på Registrer bruksmønstre i Innstillinger > Personvern og sikkerhet for å telle hvilke kommandoer, oppsett og agenter du bruker mest. Kun tellinger, og de blir på denne datamaskinen."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Wyłączone. Włącz Rejestruj wzorce użycia w Ustawienia > Prywatność i ochrona, aby zliczać, których poleceń, układów i agentów używasz najczęściej. Tylko liczniki, które zostają na tym komputerze."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Desativado. Ative Registrar padrões de uso em Ajustes > Privacidade e Segurança para contar quais comandos, layouts e agentes você mais usa. Apenas contagens, que ficam neste computador."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Выключено. Включите «Записывать модели использования» в Настройки > Конфиденциальность и безопасность, чтобы считать, какие команды, раскладки и агенты вы используете чаще всего. Только счётчики, они остаются на этом компьютере."}},
        "th": {"stringUnit": {"state": "translated", "value": "ปิดอยู่ เปิด บันทึกรูปแบบการใช้งาน ใน การตั้งค่า > ความเป็นส่วนตัวและความปลอดภัย เพื่อนับว่าคุณใช้คำสั่ง เลย์เอาต์ และเอเจนต์ใดบ่อยที่สุด นับเฉพาะจำนวน และจะอยู่บนคอมพิวเตอร์เครื่องนี้เท่านั้น"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Kapalı. En çok hangi komutları, düzenleri ve ajanları kullandığınızı saymak için Ayarlar > Gizlilik ve Güvenlik içinde Kullanım düzenlerini kaydet seçeneğini açın. Yalnızca sayılar tutulur ve bu bilgisayarda kalır."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Вимкнено. Увімкніть «Записувати шаблони використання» в Параметри > Конфіденційність і безпека, щоб рахувати, які команди, розкладки й агенти ви використовуєте найчастіше. Лише лічильники, і вони залишаються на цьому комп’ютері."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Đang tắt. Bật Ghi lại mẫu sử dụng trong Cài đặt > Quyền riêng tư & Bảo mật để đếm các lệnh, bố cục và tác nhân bạn dùng nhiều nhất. Chỉ đếm số lượng và dữ liệu ở lại trên máy tính này."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "已关闭。在“设置 > 隐私与安全性”中开启“记录使用模式”，即可统计你最常用的命令、布局和智能体。仅统计次数，且保留在这台电脑上。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "已關閉。在「設定 > 隱私權與安全性」中開啟「記錄使用模式」，即可統計你最常用的指令、版面和代理程式。僅統計次數，且保留在這台電腦上。"}}
      }
    },
    "stats.usage.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Nothing counted yet."}},
        "ar": {"stringUnit": {"state": "translated", "value": "لم يتم إحصاء أي شيء بعد."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Još ništa nije izbrojano."}},
        "da": {"stringUnit": {"state": "translated", "value": "Intet talt endnu."}},
        "de": {"stringUnit": {"state": "translated", "value": "Noch nichts gezählt."}},
        "es": {"stringUnit": {"state": "translated", "value": "Aún no se ha contado nada."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Rien de compté pour l’instant."}},
        "it": {"stringUnit": {"state": "translated", "value": "Ancora nulla conteggiato."}},
        "ja": {"stringUnit": {"state": "translated", "value": "まだ集計されていません。"}},
        "km": {"stringUnit": {"state": "translated", "value": "មិនទាន់មានអ្វីត្រូវបានរាប់នៅឡើយ។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "아직 집계된 항목이 없습니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Ingenting telt ennå."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Nic jeszcze nie zliczono."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Nada contado ainda."}},
