          "stringUnit": {
            "state": "translated",
            "value": "Questo file è troppo grande per l'anteprima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは大きすぎてプレビューできません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឯកសារនេះធំពេកមិនអាចមើលជាមុនបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 너무 커서 미리 볼 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne filen er for stor til å forhåndsvises."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten plik jest zbyt duży, by wyświetlić podgląd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo é grande demais para pré-visualizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл слишком большой для просмотра."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์นี้ใหญ่เกินกว่าจะแสดงตัวอย่างได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya önizleme için çok büyük."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей файл завеликий для перегляду."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp này quá lớn để xem trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件太大，无法预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案太大，無法預覽。"
          }
        }
      }
    },
    "artifacts.history.noNewline": {
      "extractionState": "manual",
      "localizations": {
