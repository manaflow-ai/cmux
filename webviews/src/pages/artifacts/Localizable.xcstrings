{
  "sourceLanguage": "en",
  "strings": {
    "artifacts.file.binary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file has no text to preview."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي هذا الملف على نص لمعاينته."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova datoteka nema teksta za pregled."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen har ingen tekst at vise."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei enthält keinen Text für eine Vorschau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no tiene texto que previsualizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier ne contient pas de texte à prévisualiser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file non contiene testo da mostrare in anteprima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルにはプレビューできるテキストがありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឯកសារនេះគ្មានអត្ថបទសម្រាប់មើលជាមុនទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일에는 미리 볼 텍스트가 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne filen har ingen tekst å forhåndsvise."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten plik nie zawiera tekstu do podglądu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo não tem texto para pré-visualizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом файле нет текста для просмотра."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์นี้ไม่มีข้อความให้แสดงตัวอย่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosyada önizlenecek metin yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цьому файлі немає тексту для перегляду."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp này không có văn bản để xem trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件没有可预览的文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案沒有可預覽的文字。"
          }
        }
      }
    },
    "artifacts.file.choose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a file to preview it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ملفًا لمعاينته."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite datoteku za pregled."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en fil for at se den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Datei für die Vorschau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un archivo para previsualizarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un fichier pour le prévisualiser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un file per vederne l'anteprima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューするファイルを選択してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ជ្រើសឯកសារមួយដើម្បីមើលជាមុន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리 볼 파일을 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en fil for å forhåndsvise den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz plik, aby wyświetlić podgląd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um arquivo para pré-visualizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите файл для просмотра."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกไฟล์เพื่อดูตัวอย่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önizlemek için bir dosya seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть файл для перегляду."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một tệp để xem trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个文件以预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個檔案以預覽。"
          }
        }
      }
    },
    "artifacts.file.tooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file is too large to preview."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الملف أكبر من أن تتم معاينته."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova datoteka je prevelika za pregled."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen er for stor til at blive vist."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist zu groß für eine Vorschau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo es demasiado grande para previsualizarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier est trop volumineux pour être prévisualisé."
