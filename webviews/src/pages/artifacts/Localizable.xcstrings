    "artifacts.page.truncated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some folders are not listed: this tree is too large to show in full."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعض المجلدات غير مدرجة: هذه الشجرة أكبر من أن تُعرض كاملة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neke mape nisu navedene: ovo stablo je preveliko da bi se prikazalo cijelo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogle mapper vises ikke: træet er for stort til at blive vist helt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Ordner fehlen: Dieser Baum ist zu groß, um ihn vollständig anzuzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas carpetas no aparecen: este árbol es demasiado grande para mostrarlo completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains dossiers ne sont pas listés : cette arborescence est trop grande pour être affichée en entier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune cartelle non sono elencate: l'albero è troppo grande per essere mostrato per intero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のフォルダは表示されていません。ツリーが大きすぎてすべてを表示できません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ថតខ្លះមិនត្រូវបានរាយបញ្ជីទេ៖ មែកធាងនេះធំពេកមិនអាចបង្ហាញទាំងអស់បាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 폴더는 표시되지 않습니다. 트리가 너무 커서 전체를 표시할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen mapper vises ikke: treet er for stort til å vises i sin helhet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre foldery nie są wyświetlane: to drzewo jest zbyt duże, by pokazać je w całości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas pastas não aparecem: esta árvore é grande demais para ser exibida por inteiro."
          }
        },
