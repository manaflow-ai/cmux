    "forum.off.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When your team turns it on, threads from people and agents show up here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يفعّله فريقك، ستظهر هنا مواضيع الأشخاص والوكلاء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada ga vaš tim uključi, ovdje će se pojaviti teme ljudi i agenata."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når dit team slår det til, vises tråde fra personer og agenter her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald dein Team es aktiviert, erscheinen hier Threads von Personen und Agents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando tu equipo lo active, aquí aparecerán hilos de personas y agentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque votre équipe l’activera, les fils des personnes et des agents apparaîtront ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando il tuo team lo attiva, qui compariranno le discussioni di persone e agenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チームが有効にすると、メンバーやエージェントのスレッドがここに表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នៅពេលក្រុមរបស់អ្នកបើកវា ខ្សែសន្ទនាពីមនុស្ស និងភ្នាក់ងារនឹងបង្ហាញនៅទីនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팀에서 켜면 사람과 에이전트의 스레드가 여기에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når teamet ditt slår det på, vises tråder fra personer og agenter her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy Twój zespół je włączy, pojawią się tu wątki ludzi i agentów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando sua equipe ativá-lo, as conversas de pessoas e agentes aparecerão aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда ваша команда включит его, здесь появятся темы людей и агентов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อทีมของคุณเปิดใช้ เธรดจากผู้คนและเอเจนต์จะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekibiniz açtığında, kişilerin ve ajanların konuları burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли ваша команда його ввімкне, тут з’являться теми людей і агентів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi nhóm của bạn bật tính năng này, các chủ đề từ mọi người và tác tử sẽ hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "团队开启后，成员和智能体的帖子会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "團隊開啟後，成員和代理程式的討論串會顯示在這裡。"
          }
        }
      }
    },
