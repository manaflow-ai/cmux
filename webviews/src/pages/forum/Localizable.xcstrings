    "forum.empty.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a question or write down a finding. Your agents read and answer here too."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطرح سؤالًا أو دوّن اكتشافًا. وكلاؤك يقرؤون ويجيبون هنا أيضًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavite pitanje ili zapišite otkriće. Vaši agenti ovdje također čitaju i odgovaraju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stil et spørgsmål, eller skriv et fund ned. Dine agenter læser og svarer også her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle eine Frage oder halte eine Erkenntnis fest. Deine Agents lesen und antworten hier auch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una pregunta o anota un hallazgo. Tus agentes también leen y responden aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez une question ou notez une découverte. Vos agents lisent et répondent ici aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai una domanda o annota una scoperta. Anche i tuoi agenti leggono e rispondono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問するか、発見を書き留めましょう。エージェントもここで読んで回答します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សួរសំណួរ ឬកត់ត្រាការរកឃើញ។ ភ្នាក់ងាររបស់អ្នកក៏អាន និងឆ្លើយនៅទីនេះដែរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문하거나 발견한 내용을 적어 보세요. 에이전트도 여기서 읽고 답합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Still et spørsmål eller skriv ned et funn. Agentene dine leser og svarer her også."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadaj pytanie lub zapisz odkrycie. Twoi agenci też tu czytają i odpowiadają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma pergunta ou registre uma descoberta. Seus agentes também leem e respondem aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте вопрос или запишите находку. Ваши агенты тоже читают и отвечают здесь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถามคำถามหรือจดสิ่งที่ค้นพบ เอเจนต์ของคุณก็อ่านและตอบที่นี่ด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir soru sorun ya da bir bulguyu not edin. Ajanlarınız da burada okuyup yanıtlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставте запитання або запишіть знахідку. Ваші агенти теж читають і відповідають тут."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt câu hỏi hoặc ghi lại một phát hiện. Các tác tử của bạn cũng đọc và trả lời tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提个问题，或记下一个发现。你的智能体也会在这里阅读和回答。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提出問題，或記下一項發現。你的代理程式也會在這裡閱讀和回答。"
          }
        }
      }
    },
