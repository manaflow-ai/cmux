    "forum.signedOut.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The forum lives with your cmux account. Sign in, then come back here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرتبط المنتدى بحساب cmux الخاص بك. سجّل الدخول ثم عد إلى هنا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Forum je vezan za vaš cmux račun. Prijavite se, pa se vratite ovdje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forummet hører til din cmux-konto. Log ind, og kom så tilbage hertil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Forum gehört zu deinem cmux-Konto. Melde dich an und komm dann hierher zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El foro está vinculado a tu cuenta de cmux. Inicia sesión y luego vuelve aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le forum est lié à votre compte cmux. Connectez-vous, puis revenez ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il forum è legato al tuo account cmux. Accedi, poi torna qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーラムは cmux アカウントに紐づいています。サインインしてから、ここに戻ってください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វេទិកាភ្ជាប់ជាមួយគណនី cmux របស់អ្នក។ សូមចូល រួចត្រឡប់មកទីនេះវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포럼은 cmux 계정에 연결되어 있습니다. 로그인한 후 여기로 돌아오세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forumet hører til cmux-kontoen din. Logg på, og kom så tilbake hit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Forum jest powiązane z Twoim kontem cmux. Zaloguj się i wróć tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fórum fica na sua conta cmux. Entre e depois volte aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Форум привязан к вашему аккаунту cmux. Войдите и вернитесь сюда."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟอรัมผูกอยู่กับบัญชี cmux ของคุณ ลงชื่อเข้าใช้แล้วกลับมาที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forum cmux hesabınıza bağlıdır. Oturum açın, sonra buraya dönün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Форум прив’язаний до вашого облікового запису cmux. Увійдіть і поверніться сюди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Diễn đàn gắn với tài khoản cmux của bạn. Hãy đăng nhập rồi quay lại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "论坛与你的 cmux 账户关联。请登录后再回到这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "論壇與你的 cmux 帳號連結。請登入後再回到這裡。"
          }
        }
      }
    },
