    "connect.expired.detail": {
      "comment": "Line under a connection whose sign-in lapsed; %@ is a date and time",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in expired %@. Reconnect to use it again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية تسجيل الدخول في %@. أعد الاتصال لاستخدامه مجددًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijava je istekla %@. Ponovo povežite da biste ga opet koristili."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Login udløb %@. Forbind igen for at bruge det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung ist am %@ abgelaufen. Verbinde erneut, um es wieder zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión caducó el %@. Vuelve a conectar para usarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a expiré le %@. Reconnectez-vous pour l’utiliser à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso è scaduto il %@. Riconnetti per usarlo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインは%@に期限切れになりました。再び使うには再接続してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការចូលបានផុតកំណត់នៅ %@។ ភ្ជាប់ម្ដងទៀតដើម្បីប្រើវាម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인이 %@에 만료되었습니다. 다시 사용하려면 다시 연결하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Påloggingen utløp %@. Koble til på nytt for å bruke den igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie wygasło %@. Połącz ponownie, aby znów z niego korzystać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O login expirou em %@. Reconecte para usar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход истёк %@. Переподключитесь, чтобы снова пользоваться."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลงชื่อเข้าใช้หมดอายุเมื่อ %@ เชื่อมต่ออีกครั้งเพื่อใช้งานอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturumun süresi %@ tarihinde doldu. Yeniden kullanmak için yeniden bağlanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхід сплив %@. Під’єднайте знову, щоб знову користуватися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập đã hết hạn vào %@. Hãy kết nối lại để dùng tiếp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录已于 %@ 过期。重新连接即可再次使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入已於 %@ 過期。重新連接即可再次使用。"
          }
        }
      }
    },
    "connect.expiring.detail": {
      "comment": "Line under a connection whose sign-in lapses soon; %@ is a date and time",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in expires %@. Reconnect to keep it working."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
