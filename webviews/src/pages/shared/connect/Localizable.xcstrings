    "connect.all.help": {
      "comment": "One line under All connections",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your cmux account, GitHub, model accounts and apps, in one place."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حسابك في cmux وGitHub وحسابات النماذج والتطبيقات، في مكان واحد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš cmux račun, GitHub, računi modela i aplikacije na jednom mjestu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din cmux-konto, GitHub, modelkonti og apps samlet ét sted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein cmux-Konto, GitHub, Modellkonten und Apps an einem Ort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta de cmux, GitHub, las cuentas de modelos y las apps, en un solo lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte cmux, GitHub, vos comptes de modèles et vos apps, au même endroit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account cmux, GitHub, gli account dei modelli e le app, in un unico posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux アカウント、GitHub、モデルのアカウント、アプリをひとつの場所で。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គណនី cmux, GitHub, គណនីម៉ូដែល និងកម្មវិធីរបស់អ្នក នៅកន្លែងតែមួយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 계정, GitHub, 모델 계정과 앱을 한곳에서."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-kontoen din, GitHub, modellkontoer og apper, samlet på ett sted."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje konto cmux, GitHub, konta modeli i aplikacje w jednym miejscu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta do cmux, GitHub, contas de modelos e apps, em um só lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш аккаунт cmux, GitHub, аккаунты моделей и приложения — в одном месте."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชี cmux, GitHub, บัญชีโมเดล และแอปของคุณ รวมไว้ในที่เดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux hesabınız, GitHub, model hesapları ve uygulamalar tek bir yerde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш обліковий запис cmux, GitHub, облікові записи моделей і застосунки — в одному місці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản cmux, GitHub, tài khoản mô hình và ứng dụng của bạn, ở cùng một nơi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 cmux 账户、GitHub、模型账户和应用，集中在一处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 cmux 帳號、GitHub、模型帳號和 App，集中在一處。"
          }
        }
      }
    },
