          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijava ističe %@. Ponovo povežite da bi nastavilo raditi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Login udløber %@. Forbind igen for at det bliver ved med at virke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung läuft am %@ ab. Verbinde erneut, damit es weiter funktioniert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
