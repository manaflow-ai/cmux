          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion expire le %@. Reconnectez-vous pour que cela continue de fonctionner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso scade il %@. Riconnetti per continuare a usarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインは%@に期限切れになります。使い続けるには再接続してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការចូលផុតកំណត់នៅ %@។ ភ្ជាប់ម្ដងទៀតដើម្បីបន្តប្រើ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인이 %@에 만료됩니다. 계속 사용하려면 다시 연결하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Påloggingen utløper %@. Koble til på nytt for å fortsette."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie wygasa %@. Połącz ponownie, aby nadal działało."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O login expira em %@. Reconecte para continuar funcionando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход истекает %@. Переподключитесь, чтобы всё продолжало работать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลงชื่อเข้าใช้จะหมดอายุ %@ เชื่อมต่ออีกครั้งเพื่อให้ใช้งานต่อได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturumun süresi %@ tarihinde doluyor. Çalışmaya devam etmesi için yeniden bağlanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхід спливає %@. Під’єднайте знову, щоб усе працювало далі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập hết hạn vào %@. Hãy kết nối lại để tiếp tục dùng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录将于 %@ 过期。重新连接即可继续使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入將於 %@ 過期。重新連接即可繼續使用。"
          }
        }
      }
    },
