          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この cmux ではまだ cmux モデルを利用できません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម៉ូដែល cmux មិនទាន់មាននៅលើ cmux នេះនៅឡើយទេ។"
