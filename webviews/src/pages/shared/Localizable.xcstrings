          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos do cmux ainda não estão disponíveis neste cmux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модели cmux пока недоступны в этом cmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีโมเดลของ cmux ใน cmux นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux modelleri bu cmux'ta henüz kullanılamıyor."
