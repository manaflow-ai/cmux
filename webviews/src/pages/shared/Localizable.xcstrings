{
  "sourceLanguage": "en",
  "strings": {
    "error.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ ما. حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nešto nije u redu. Pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noget gik galt. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas ist schiefgelaufen. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème est survenu. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa è andato storto. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題が発生しました。もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មានបញ្ហាកើតឡើង។ សូមព្យាយាមម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제가 발생했습니다. 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noe gikk galt. Prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś poszło nie tak. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo deu errado. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то пошло не так. Повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกิดข้อผิดพลาด ลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sorun oluştu. Yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щось пішло не так. Спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xảy ra lỗi. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出了点问题。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發生問題。請再試一次。"
          }
        }
      }
    },
    "error.disconnected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux isn't connected right now."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux غير متصل الآن."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux trenutno nije povezan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux er ikke forbundet lige nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ist gerade nicht verbunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no está conectado ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux n'est pas connecté pour le moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux non è connesso al momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux は現在接続されていません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux មិនបានភ្ជាប់ទេឥឡូវនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 cmux에 연결되어 있지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux er ikke tilkoblet akkurat nå."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nie jest teraz połączony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux não está conectado agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux сейчас не подключен."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ยังไม่ได้เชื่อมต่อในขณะนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux şu anda bağlı değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux зараз не підключено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux hiện chưa được kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 目前未连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 目前未連線。"
          }
        }
      }
    },
    "error.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This needs a newer version of cmux. Update cmux, then try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب هذا إصدارًا أحدث من cmux. حدّث cmux، ثم حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za ovo je potrebna novija verzija cmuxa. Ažurirajte cmux, pa pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette kræver en nyere version af cmux. Opdater cmux, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dafür ist eine neuere Version von cmux nötig. Aktualisiere cmux und versuche es dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto requiere una versión más reciente de cmux. Actualiza cmux y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action nécessite une version plus récente de cmux. Mettez cmux à jour, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve una versione più recente di cmux. Aggiorna cmux, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これには新しいバージョンの cmux が必要です。cmux をアップデートしてから、もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការនេះត្រូវការ cmux កំណែថ្មីជាង។ សូមធ្វើបច្ចុប្បន្នភាព cmux រួចព្យាយាមម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신 버전의 cmux가 필요합니다. cmux를 업데이트한 다음 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette krever en nyere versjon av cmux. Oppdater cmux, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymaga to nowszej wersji cmux. Zaktualizuj cmux, a potem spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso requer uma versão mais recente do cmux. Atualize o cmux e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого нужна более новая версия cmux. Обновите cmux и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องใช้ cmux เวอร์ชันใหม่กว่านี้ อัปเดต cmux แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunun için daha yeni bir cmux sürümü gerekiyor. cmux'u güncelleyin, ardından yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для цього потрібна новіша версія cmux. Оновіть cmux і спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần phiên bản cmux mới hơn. Hãy cập nhật cmux rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这需要更新版本的 cmux。请更新 cmux 后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這需要較新版本的 cmux。請更新 cmux 後再試一次。"
          }
        }
      }
    },
    "error.agentExists": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An agent with this name already exists. Choose another name."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد وكيل بهذا الاسم بالفعل. اختر اسمًا آخر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent s ovim imenom već postoji. Odaberite drugo ime."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der findes allerede en agent med dette navn. Vælg et andet navn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt bereits einen Agenten mit diesem Namen. Wähle einen anderen Namen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe un agente con este nombre. Elige otro nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agent porte déjà ce nom. Choisissez un autre nom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esiste già un agente con questo nome. Scegli un altro nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この名前のエージェントはすでに存在します。別の名前を選んでください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មានភ្នាក់ងារដែលមានឈ្មោះនេះរួចហើយ។ សូមជ្រើសរើសឈ្មោះផ្សេង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이름의 에이전트가 이미 있습니다. 다른 이름을 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finnes allerede en agent med dette navnet. Velg et annet navn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent o tej nazwie już istnieje. Wybierz inną nazwę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já existe um agente com este nome. Escolha outro nome."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент с таким именем уже существует. Выберите другое имя."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีเอเจนต์ชื่อนี้อยู่แล้ว เลือกชื่ออื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adda bir ajan zaten var. Başka bir ad seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент із такою назвою вже існує. Виберіть іншу назву."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã có một tác tử có tên này. Hãy chọn tên khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存在同名的代理。请选择其他名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有同名的代理程式。請選擇其他名稱。"
          }
        }
      }
    },
    "error.cmuxModelsSignedOut": {
      "comment": "Shown when cmux models (open-weight models cmux hosts, Settings > Agents > Add > Endpoint) cannot be listed or added; keep cmux lowercase",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to cmux to use cmux models."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول إلى cmux لاستخدام نماذج cmux."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se u cmux da koristite cmux modele."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind på cmux for at bruge cmux-modeller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich bei cmux an, um cmux-Modelle zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en cmux para usar los modelos de cmux."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à cmux pour utiliser les modèles cmux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi a cmux per usare i modelli cmux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux モデルを使うには cmux にサインインしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចូលគណនី cmux ដើម្បីប្រើម៉ូដែល cmux។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 모델을 사용하려면 cmux에 로그인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg på cmux for å bruke cmux-modeller."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się do cmux, aby używać modeli cmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre no cmux para usar os modelos do cmux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в cmux, чтобы использовать модели cmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้า cmux เพื่อใช้โมเดลของ cmux"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux modellerini kullanmak için cmux'a giriş yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть у cmux, щоб користуватися моделями cmux."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập cmux để dùng mô hình cmux."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录 cmux 以使用 cmux 模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入 cmux 以使用 cmux 模型。"
          }
        }
      }
    },
    "error.cmuxModelsOff": {
      "comment": "Shown when cmux models (open-weight models cmux hosts, Settings > Agents > Add > Endpoint) cannot be listed or added; keep cmux lowercase",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux models aren't available on this cmux yet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نماذج cmux غير متاحة على cmux هذا بعد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux modeli još nisu dostupni na ovom cmuxu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-modeller er ikke tilgængelige på denne cmux endnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-Modelle sind auf diesem cmux noch nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos de cmux aún no están disponibles en este cmux."
          }
        },
        "fr": {
