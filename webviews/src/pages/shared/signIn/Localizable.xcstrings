        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そこにコードをペーストしてください。すでにクリップボードにあります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បិទភ្ជាប់លេខកូដនៅទីនោះ។ វាមាននៅក្នុងក្ដារតម្បៀតខ្ទាស់រួចហើយ។"
