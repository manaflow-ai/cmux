    "signIn.expired": {
      "comment": "The one-time code ran out of time",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code expired before it was used."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية هذا الرمز قبل استخدامه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj kod je istekao prije nego što je iskorišten."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne kode udløb, før den blev brugt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code ist abgelaufen, bevor er verwendet wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código caducó antes de usarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code a expiré avant d’être utilisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo codice è scaduto prima di essere usato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードは使用される前に期限切れになりました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "លេខកូដនេះបានផុតកំណត់មុនពេលប្រើ។"
