    "signIn.step.paste": {
      "comment": "Sheet step 2",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the code there. It's already on the clipboard."
          }
        },
        "ar": {
          "stringUnit": {
