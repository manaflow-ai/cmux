          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onayladığınızda kendiliğinden tamamlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після підтвердження все завершиться автоматично."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi bạn phê duyệt, quá trình sẽ tự hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你批准后会自动完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
