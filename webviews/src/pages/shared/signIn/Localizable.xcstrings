    "signIn.approve.lead": {
      "comment": "Claude without a code: approve in the page",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve on the sign-in page beside this window. It finishes by itself."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وافق في صفحة تسجيل الدخول بجانب هذه النافذة. سيكتمل الأمر تلقائيًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odobrite na stranici za prijavu pored ovog prozora. Završit će se samo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Godkend på loginsiden ved siden af dette vindue. Det afsluttes af sig selv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige auf der Anmeldeseite neben diesem Fenster. Der Rest passiert automatisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprueba en la página de inicio de sesión junto a esta ventana. Termina por sí solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approuvez sur la page de connexion à côté de cette fenêtre. La suite est automatique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Approva nella pagina di accesso accanto a questa finestra. Il resto è automatico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウインドウの横にあるサインインページで承認してください。自動的に完了します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "យល់ព្រមនៅលើទំព័រចូលនៅក្បែរផ្ទាំងនេះ។ វានឹងបញ្ចប់ដោយខ្លួនឯង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 창 옆의 로그인 페이지에서 승인하세요. 자동으로 완료됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Godkjenn på påloggingssiden ved siden av dette vinduet. Resten skjer automatisk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatwierdź na stronie logowania obok tego okna. Reszta wykona się sama."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprove na página de login ao lado desta janela. O resto é automático."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите на странице входа рядом с этим окном. Остальное произойдет автоматически."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุมัติในหน้าลงชื่อเข้าใช้ข้างหน้าต่างนี้ แล้วจะเสร็จสิ้นเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu pencerenin yanındaki oturum açma sayfasında onaylayın. Gerisi kendiliğinden tamamlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтвердьте на сторінці входу поруч із цим вікном. Решта відбудеться автоматично."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phê duyệt trên trang đăng nhập bên cạnh cửa sổ này. Phần còn lại sẽ tự hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此窗口旁的登录页面上批准，之后会自动完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
