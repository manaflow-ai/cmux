        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그곳에 코드를 붙여넣으세요. 이미 클립보드에 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lim inn koden der. Den ligger allerede på utklippstavlen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej tam kod. Jest już w schowku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole o código lá. Ele já está na área de transferência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте туда код. Он уже в буфере обмена."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางรหัสที่นั่น รหัสอยู่ในคลิปบอร์ดแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodu oraya yapıştırın. Kod zaten panoda."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставте туди код. Він уже в буфері обміну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán mã vào đó. Mã đã có trong bộ nhớ tạm."
