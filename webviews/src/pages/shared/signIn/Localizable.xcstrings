    "signIn.failed.cancelled": {
      "comment": "Failure: cancelled on the provider page",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in was cancelled on the provider's page."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء تسجيل الدخول في صفحة المزوّد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijava je otkazana na stranici dobavljača."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Login blev annulleret på udbyderens side."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung wurde auf der Seite des Anbieters abgebrochen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se canceló el inicio de sesión en la página del proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a été annulée sur la page du fournisseur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso è stato annullato nella pagina del provider."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダのページでサインインがキャンセルされました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការចូលត្រូវបានបោះបង់នៅលើទំព័ររបស់អ្នកផ្ដល់សេវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공급자 페이지에서 로그인이 취소되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Påloggingen ble avbrutt på leverandørens side."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie zostało anulowane na stronie dostawcy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O login foi cancelado na página do provedor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход отменен на странице провайдера."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลงชื่อเข้าใช้ถูกยกเลิกในหน้าของผู้ให้บริการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum açma, sağlayıcının sayfasında iptal edildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхід скасовано на сторінці провайдера."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc đăng nhập đã bị hủy trên trang của nhà cung cấp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
