    "signIn.paste.lead": {
      "comment": "Claude with a code to paste back",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve on the sign-in page beside this window, then paste the code it shows here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وافق في صفحة تسجيل الدخول بجانب هذه النافذة، ثم الصق هنا الرمز الذي تعرضه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odobrite na stranici za prijavu pored ovog prozora, pa ovdje zalijepite kod koji prikaže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Godkend på loginsiden ved siden af dette vindue, og indsæt derefter koden, den viser, her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige auf der Anmeldeseite neben diesem Fenster und füge dann den angezeigten Code hier ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprueba en la página de inicio de sesión junto a esta ventana y luego pega aquí el código que muestra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approuvez sur la page de connexion à côté de cette fenêtre, puis collez ici le code affiché."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Approva nella pagina di accesso accanto a questa finestra, poi incolla qui il codice mostrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウインドウの横にあるサインインページで承認し、表示されたコードをここにペーストしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "យល់ព្រមនៅលើទំព័រចូលនៅក្បែរផ្ទាំងនេះ រួចបិទភ្ជាប់លេខកូដដែលវាបង្ហាញនៅទីនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 창 옆의 로그인 페이지에서 승인한 다음, 표시된 코드를 여기에 붙여넣으세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Godkjenn på påloggingssiden ved siden av dette vinduet, og lim deretter inn koden den viser her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatwierdź na stronie logowania obok tego okna, a potem wklej tutaj wyświetlony kod."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprove na página de login ao lado desta janela e depois cole aqui o código exibido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите на странице входа рядом с этим окном, затем вставьте сюда показанный код."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุมัติในหน้าลงชื่อเข้าใช้ข้างหน้าต่างนี้ แล้ววางรหัสที่แสดงไว้ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu pencerenin yanındaki oturum açma sayfasında onaylayın, ardından gösterilen kodu buraya yapıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтвердьте на сторінці входу поруч із цим вікном, потім вставте сюди показаний код."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
