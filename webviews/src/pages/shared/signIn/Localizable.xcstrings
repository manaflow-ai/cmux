        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 코드는 사용되기 전에 만료되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne koden utløp før den ble brukt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten kod wygasł, zanim został użyty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código expirou antes de ser usado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок действия кода истек до его использования."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสนี้หมดอายุก่อนถูกใช้งาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kodun süresi kullanılmadan doldu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Термін дії коду сплив до його використання."
