        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det fullføres automatisk når du godkjenner."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy zatwierdzisz, reszta wykona się sama."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso termina sozinho assim que você aprovar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После подтверждения все завершится автоматически."
