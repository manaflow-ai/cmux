    "signIn.failed.sharedMachine": {
      "comment": "Failure: shared machine refuses personal sign-ins",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a shared team machine. Sign in from your own Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا جهاز فريق مشترك. سجّل الدخول من جهاز Mac الخاص بك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo je zajednički timski računar. Prijavite se sa svog Mac računara."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er en delt teammaskine. Log ind fra din egen Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist ein gemeinsam genutzter Teamrechner. Melde dich auf deinem eigenen Mac an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es un equipo compartido del equipo. Inicia sesión desde tu propio Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette machine est partagée par l’équipe. Connectez-vous depuis votre propre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è una macchina condivisa del team. Accedi dal tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはチームの共有マシンです。自分のMacからサインインしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នេះជាម៉ាស៊ីនក្រុមប្រើរួម។ សូមចូលពី Mac ផ្ទាល់ខ្លួនរបស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팀 공유 머신입니다. 본인의 Mac에서 로그인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er en delt teammaskin. Logg på fra din egen Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To współdzielona maszyna zespołu. Zaloguj się na własnym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma máquina compartilhada da equipe. Entre pelo seu próprio Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это общая машина команды. Войдите со своего Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือเครื่องที่ใช้ร่วมกันในทีม โปรดลงชื่อเข้าใช้จาก Mac ของคุณเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, paylaşılan bir ekip makinesi. Kendi Mac’inizden oturum açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це спільна машина команди. Увійдіть зі свого Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là máy dùng chung của nhóm. Hãy đăng nhập từ máy Mac của riêng bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是团队共享的机器。请在你自己的 Mac 上登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是團隊共用的機器。請在你自己的 Mac 上登入。"
          }
        }
      }
    },
