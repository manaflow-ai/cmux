    "history.pasteHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask the assistant to share what it remembers, then paste the answer here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اطلب من المساعد مشاركة ما يتذكره، ثم الصق الإجابة هنا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zamolite asistenta da podijeli čega se sjeća, a zatim ovdje zalijepite odgovor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bed assistenten dele, hvad den husker, og indsæt derefter svaret her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bitte den Assistenten, alles zu teilen, woran er sich erinnert, und füge die Antwort hier ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pide al asistente que comparta lo que recuerda y pega aquí la respuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Demandez à l’assistant de partager ce dont il se souvient, puis collez la réponse ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chiedi all’assistente di condividere ciò che ricorda, poi incolla qui la risposta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントに覚えていることを書き出してもらい、その回答をここに貼り付けます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ស្នើឱ្យជំនួយការចែករំលែកអ្វីដែលវាចងចាំ ហើយបិទភ្ជាប់ចម្លើយនៅទីនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "어시스턴트에게 기억하는 내용을 작성해 달라고 한 뒤 답변을 여기에 붙여넣으세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Be assistenten dele det den husker, og lim deretter inn svaret her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poproś asystenta o opisanie tego, co pamięta, a następnie wklej odpowiedź tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Peça ao assistente para compartilhar o que ele lembra e cole a resposta aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Попросите ассистента рассказать, что он помнит, затем вставьте ответ сюда."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ขอให้ผู้ช่วยแบ่งปันสิ่งที่จำได้ แล้ววางคำตอบที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Asistandan hatırladığı şeyleri paylaşmasını isteyin, sonra yanıtı buraya yapıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Попросіть асистента поділитися тим, що він пам’ятає, а потім вставте відповідь сюди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yêu cầu trợ lý chia sẻ những gì họ nhớ, rồi dán câu trả lời vào đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请让助手写出它记得的内容，然后将回答粘贴到这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請讓助理寫出它記得的內容，然後將回答貼到這裡。"
          }
        }
      }
    },
