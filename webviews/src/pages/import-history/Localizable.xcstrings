        }
      }
    },
    "history.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what to bring into your Chief. Detected sources are checked for you."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اختر ما تريد إحضاره إلى Chief. تم تحديد المصادر المكتشفة لك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odaberite šta želite prenijeti u Chief. Pronađeni izvori su označeni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vælg, hvad du vil tage med til din Chief. Fundne kilder er markeret for dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wähle aus, was du in deinen Chief übernehmen möchtest. Gefundene Quellen sind vorausgewählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elige qué llevar a tu Chief. Las fuentes detectadas están marcadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisissez ce que vous souhaitez apporter à votre Chief. Les sources détectées sont cochées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scegli cosa portare nel tuo Chief. Le fonti rilevate sono selezionate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief に引き継ぐ内容を選択します。検出されたソースはあらかじめ選択されています。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ជ្រើសរើសអ្វីដែលត្រូវនាំចូល Chief។ ប្រភពដែលរកឃើញត្រូវបានជ្រើសជូន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief로 가져올 항목을 선택하세요. 발견된 소스는 미리 선택되어 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Velg hva du vil ta med til Chief. Kilder som er funnet, er valgt for deg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybierz, co przenieść do Chief. Wykryte źródła są zaznaczone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolha o que levar para o Chief. As fontes encontradas já vêm selecionadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выберите, что перенести в Chief. Найденные источники уже отмечены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เลือกสิ่งที่จะนำเข้า Chief แหล่งที่พบถูกเลือกไว้ให้แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief’e getirmek istediklerinizi seçin. Bulunan kaynaklar sizin için seçildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Виберіть, що перенести до Chief. Знайдені джерела вже позначено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chọn nội dung muốn mang vào Chief. Các nguồn tìm thấy đã được chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "选择要带入 Chief 的内容。检测到的来源已为你勾选。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選擇要帶入 Chief 的內容。偵測到的來源已為你勾選。"
          }
        }
      }
    },
