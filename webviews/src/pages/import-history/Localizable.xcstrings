        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geçmişinizi getirin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перенесіть свою історію"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mang theo lịch sử của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "带入你的历史记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "帶入你的歷史記錄"
