    "history.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your history"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أحضر سجلك"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prenesite svoju historiju"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tag din historik med"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verlauf mitnehmen"
          }
        },
        "es": {
          "stringUnit": {
