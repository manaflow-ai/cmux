            "value": "នាំយកប្រវត្តិរបស់អ្នក"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기록 가져오기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ta med historikken din"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przenieś swoją historię"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Traga seu histórico"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перенесите историю"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
