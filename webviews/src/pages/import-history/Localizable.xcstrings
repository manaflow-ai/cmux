    "history.prompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write out everything you remember about me: my preferences, people, projects, and routines. Include useful context and recurring details. Do not include passwords, API keys, tokens, or other secrets."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اكتب كل ما تتذكره عني: تفضيلاتي، والأشخاص، والمشاريع، والروتين اليومي. أضف السياق المفيد والتفاصيل المتكررة. لا تذكر كلمات المرور أو مفاتيح API أو الرموز أو أي أسرار أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Napiši sve čega se sjećaš o meni: moje sklonosti, ljude, projekte i rutine. Uključi koristan kontekst i ponavljajuće detalje. Nemoj uključivati lozinke, API ključeve, tokene ili druge tajne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skriv alt, du husker om mig: mine præferencer, personer, projekter og rutiner. Medtag nyttig kontekst og tilbagevendende detaljer. Medtag ikke adgangskoder, API-nøgler, tokens eller andre hemmeligheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schreibe alles auf, woran du dich über mich erinnerst: meine Vorlieben, Personen, Projekte und Routinen. Füge hilfreichen Kontext und wiederkehrende Details hinzu. Füge keine Passwörter, API-Schlüssel, Tokens oder andere Geheimnisse ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escribe todo lo que recuerdes sobre mí: mis preferencias, personas, proyectos y rutinas. Incluye contexto útil y detalles recurrentes. No incluyas contraseñas, claves API, tokens ni otros secretos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Écrivez tout ce dont vous vous souvenez à mon sujet : mes préférences, les personnes, les projets et les habitudes. Ajoutez le contexte utile et les détails récurrents. N’incluez pas les mots de passe, clés API, jetons ni autres secrets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scrivi tutto ciò che ricordi di me: preferenze, persone, progetti e abitudini. Includi il contesto utile e i dettagli ricorrenti. Non includere password, chiavi API, token o altri segreti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私について覚えていることをすべて書き出してください。好み、人、プロジェクト、習慣を含め、役立つ背景や繰り返し出てくる詳細も書いてください。パスワード、API キー、トークンなどの秘密情報は含めないでください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សរសេរអ្វីៗទាំងអស់ដែលអ្នកចងចាំអំពីខ្ញុំ៖ ចំណូលចិត្ត មនុស្ស គម្រោង និងទម្លាប់។ បញ្ចូលបរិបទដែលមានប្រយោជន៍ និងព័ត៌មានដែលកើតឡើងញឹកញាប់។ កុំបញ្ចូលពាក្យសម្ងាត់ កូនសោ API ថូខិន ឬសម្ងាត់ផ្សេងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "나에 대해 기억하는 모든 것을 작성해 주세요. 내 선호, 사람, 프로젝트, 일상을 포함하고 유용한 맥락과 반복되는 세부 사항도 적어 주세요. 비밀번호, API 키, 토큰 또는 기타 비밀은 포함하지 마세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skriv ned alt du husker om meg: preferanser, personer, prosjekter og rutiner. Ta med nyttig kontekst og gjentakende detaljer. Ikke ta med passord, API-nøkler, token eller andre hemmeligheter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zapisz wszystko, co pamiętasz o mnie: moje preferencje, osoby, projekty i rutyny. Dodaj przydatny kontekst i powtarzające się szczegóły. Nie dodawaj haseł, kluczy API, tokenów ani innych sekretów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escreva tudo o que você lembra sobre mim: minhas preferências, pessoas, projetos e rotinas. Inclua contexto útil e detalhes recorrentes. Não inclua senhas, chaves de API, tokens ou outros segredos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Напишите всё, что вы помните обо мне: мои предпочтения, людей, проекты и привычки. Добавьте полезный контекст и повторяющиеся детали. Не включайте пароли, ключи API, токены и другие секреты."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เขียนทุกสิ่งที่คุณจำได้เกี่ยวกับฉัน: ความชอบ ผู้คน โครงการ และกิจวัตร รวมบริบทที่เป็นประโยชน์และรายละเอียดที่เกิดขึ้นซ้ำ อย่าใส่รหัสผ่าน คีย์ API โทเค็น หรือความลับอื่น ๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Benimle ilgili hatırladığın her şeyi yaz: tercihlerimi, kişileri, projeleri ve rutinleri. Yararlı bağlamı ve tekrarlanan ayrıntıları ekle. Parolaları, API anahtarlarını, belirteçleri veya başka sırları ekleme."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запишіть усе, що ви пам’ятаєте про мене: мої вподобання, людей, проєкти й звички. Додайте корисний контекст і повторювані деталі. Не додавайте паролі, ключі API, токени чи інші секрети."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hãy viết mọi điều bạn nhớ về tôi: sở thích, mọi người, dự án và thói quen. Thêm bối cảnh hữu ích và các chi tiết lặp lại. Không thêm mật khẩu, khóa API, mã thông báo hoặc bí mật khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "写下你记得的关于我的所有内容：我的偏好、人物、项目和日常。包括有用的背景和反复出现的细节。不要包含密码、API 密钥、令牌或其他秘密。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "寫下你記得的關於我的所有內容：我的偏好、人物、專案和日常。包括有用的背景和反覆出現的細節。不要包含密碼、API 金鑰、權杖或其他秘密。"
          }
        }
      }
    },
