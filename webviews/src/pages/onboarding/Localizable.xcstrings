    "onboarding.makeItYours.noise.banners.line": {
      "comment": "Make cmux Yours: what Banners means.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A silent banner when an agent finishes or needs you."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشعار صامت عندما ينتهي وكيل أو يحتاجك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiha obavijest kad agent završi ili vas treba."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et lydløst banner, når en agent er færdig eller har brug for dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein stummes Banner, wenn ein Agent fertig ist oder dich braucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aviso silencioso cuando un agente termina o te necesita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une bannière silencieuse quand un agent a fini ou a besoin de vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un banner silenzioso quando un agente finisce o ha bisogno di te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが終わったときや対応が必要なときに、音なしのバナー。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្ទាំងជូនដំណឹងស្ងាត់ ពេលភ្នាក់ងារបញ្ចប់ ឬត្រូវការអ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 끝나거나 도움이 필요할 때 소리 없는 배너."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et lydløst banner når en agent er ferdig eller trenger deg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cichy baner, gdy agent skończy lub Cię potrzebuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um banner silencioso quando um agente termina ou precisa de você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Беззвучный баннер, когда агент закончил или ждёт вас."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แบนเนอร์แบบเงียบเมื่อเอเจนต์ทำเสร็จหรือต้องการคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ajan bitince veya size ihtiyaç duyunca sessiz bir bildirim."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Беззвучний банер, коли агент завершив або чекає на вас."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biểu ngữ không tiếng khi agent xong hoặc cần bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体完成或需要你时，显示无声横幅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理完成或需要你時，顯示無聲橫幅。"
          }
        }
      }
    },
