    "onboarding.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac is offline. Sign-ins and installs work once it’s back."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الـ Mac غير متصل بالإنترنت. سيعمل تسجيل الدخول والتثبيت عند عودة الاتصال."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj Mac nije na mreži. Prijave i instalacije rade kad se veza vrati."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac er offline. Login og installationer virker, når den er tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac ist offline. Anmelden und Installieren funktionieren, sobald er wieder online ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no tiene conexión. Los inicios de sesión y las instalaciones funcionarán cuando vuelva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac est hors ligne. Connexions et installations fonctionneront dès son retour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac è offline. Accessi e installazioni funzioneranno quando torna online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacはオフラインです。接続が戻るとサインインとインストールができます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac នេះគ្មានអ៊ីនធឺណិត។ ការចូល និងការដំឡើងនឹងដំណើរការពេលវាត្រឡប់មកវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac은 오프라인입니다. 연결이 돌아오면 로그인과 설치가 됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Macen er frakoblet. Pålogging og installering virker når den er tilbake."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac jest offline. Logowanie i instalacje zadziałają po powrocie sieci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac está offline. Logins e instalações funcionam quando a conexão voltar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac не в сети. Вход и установка заработают, когда сеть вернётся."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac เครื่องนี้ออฟไลน์อยู่ การลงชื่อเข้าและการติดตั้งจะใช้ได้เมื่อกลับมาออนไลน์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac çevrimdışı. Bağlantı dönünce giriş ve kurulumlar çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей Mac не в мережі. Вхід і встановлення запрацюють, коли мережа повернеться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac này đang ngoại tuyến. Đăng nhập và cài đặt sẽ hoạt động khi có mạng lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 处于离线状态。恢复联网后即可登录和安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 目前離線。恢復連線後即可登入和安裝。"
          }
        }
      }
    },
    "onboarding.makeItYours.look.body": {
      "comment": "Make cmux Yours, screen 1: the sentence under the title over the look tiles.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a whole look in one click. Each one follows your Mac's light or dark mode."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مظهرًا كاملًا بنقرة واحدة. كل مظهر يتبع الوضع الفاتح أو الداكن في جهاز Mac."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite cijeli izgled jednim klikom. Svaki prati svijetli ili tamni način vašeg Maca."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg et helt look med ét klik. Hvert look følger din Macs lyse eller mørke tilstand."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle mit einem Klick einen ganzen Look. Jeder folgt dem hellen oder dunklen Modus deines Macs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un aspecto completo con un clic. Cada uno sigue el modo claro u oscuro de tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un style complet en un clic. Chacun suit le mode clair ou sombre de votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un intero aspetto con un clic. Ognuno segue la modalità chiara o scura del tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンクリックで全体の見た目を選べます。どれもMacのライト／ダークモードに従います。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ជ្រើសរូបរាងទាំងមូលដោយចុចតែម្តង។ រូបរាងនីមួយៗធ្វើតាមរបៀបភ្លឺ ឬងងឹតរបស់ Mac អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭 한 번으로 전체 모습을 고르세요. 모두 Mac의 라이트 또는 다크 모드를 따릅니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg et helt utseende med ett klikk. Hvert av dem følger Macens lyse eller mørke modus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz cały wygląd jednym kliknięciem. Każdy podąża za jasnym lub ciemnym trybem Twojego Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um visual completo com um clique. Cada um segue o modo claro ou escuro do seu Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите оформление целиком одним щелчком. Каждое следует светлому или тёмному режиму Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกรูปลักษณ์ทั้งหมดได้ในคลิกเดียว แต่ละแบบเปลี่ยนตามโหมดสว่างหรือมืดของ Mac"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek tıklamayla bütün bir görünüm seçin. Her biri Mac'inizin açık veya koyu modunu izler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть цілий вигляд одним клацанням. Кожен стежить за світлим або темним режимом Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn cả một diện mạo chỉ với một cú nhấp. Mỗi diện mạo đều theo chế độ sáng hoặc tối của máy Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一键选择整体外观。每种外观都跟随 Mac 的浅色或深色模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一鍵選擇整體外觀。每種外觀都跟隨 Mac 的淺色或深色模式。"
          }
        }
      }
    },
