            "value": "チャット、ブラウザ、ターミナルを並べて使えます。⌘Tで新しいチャットを開始。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحادثات والمتصفحات والطرفيات جنبًا إلى جنب. ‏⌘T يبدأ محادثة جديدة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Razgovori, preglednici i terminali jedni pored drugih. ⌘T pokreće novi razgovor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats, browsere og terminaler side om side. ⌘T starter en ny chat."
          }
        },
