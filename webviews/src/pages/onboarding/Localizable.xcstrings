    "onboarding.makeItYours.permission.fullAccess.line": {
      "comment": "Make cmux Yours: what Full Access means.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents edit files and run commands without asking. Stop one any time."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعدّل الوكلاء الملفات ويشغّلون الأوامر دون سؤال. أوقف أيًّا منهم في أي وقت."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenti mijenjaju datoteke i pokreću naredbe bez pitanja. Zaustavite ih bilo kada."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenter ændrer filer og kører kommandoer uden at spørge. Stop en når som helst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten ändern Dateien und führen Befehle ohne Nachfrage aus. Stoppe einen jederzeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes editan archivos y ejecutan comandos sin preguntar. Detén uno cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les agents modifient des fichiers et lancent des commandes sans demander. Arrêtez-en un à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli agenti modificano file ed eseguono comandi senza chiedere. Fermane uno quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントは確認せずにファイルを編集しコマンドを実行します。いつでも止められます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្នាក់ងារកែឯកសារ និងដំណើរការពាក្យបញ្ជាដោយមិនសួរ។ បញ្ឈប់បានគ្រប់ពេល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 묻지 않고 파일을 고치고 명령을 실행합니다. 언제든 멈출 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenter endrer filer og kjører kommandoer uten å spørre. Stopp en når som helst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenci zmieniają pliki i uruchamiają polecenia bez pytania. Zatrzymaj dowolnego w każdej chwili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os agentes editam arquivos e executam comandos sem perguntar. Pare um quando quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты меняют файлы и выполняют команды без вопросов. Остановить можно в любой момент."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์แก้ไขไฟล์และรันคำสั่งโดยไม่ถาม หยุดได้ทุกเมื่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanlar sormadan dosya düzenler ve komut çalıştırır. İstediğiniz an durdurun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенти змінюють файли й виконують команди без питань. Зупинити можна будь-коли."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent sửa tệp và chạy lệnh mà không hỏi. Dừng bất cứ lúc nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体无需询问即可编辑文件和运行命令。随时可以停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理無需詢問即可編輯檔案和執行命令。隨時可以停止。"
          }
        }
      }
    },
