    "onboarding.makeItYours.trust.body": {
      "comment": "Make cmux Yours, screen 3: the sentence under the title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much agents may do on their own, and how cmux tells you when one is done."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما المسموح للوكلاء فعله بمفردهم، وكيف يخبرك cmux عندما ينتهي أحدهم."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko agenti smiju sami, i kako vam cmux javlja kad neki završi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor meget agenter må gøre selv, og hvordan cmux siger til, når en er færdig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel Agenten selbst tun dürfen und wie cmux dir sagt, wenn einer fertig ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto pueden hacer los agentes por su cuenta y cómo te avisa cmux cuando uno termina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que les agents peuvent faire seuls, et comment cmux vous prévient quand l'un a fini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto possono fare da soli gli agenti e come cmux ti avvisa quando uno ha finito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが自分でどこまでできるか、そして終わったときにcmuxがどう知らせるか。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្នាក់ងារអាចធ្វើដោយខ្លួនឯងបានប៉ុណ្ណា និងរបៀបដែល cmux ប្រាប់អ្នកពេលមួយបញ្ចប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 스스로 얼마나 할 수 있는지, 그리고 끝났을 때 cmux가 어떻게 알려 줄지."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor mye agenter får gjøre selv, og hvordan cmux sier fra når en er ferdig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ile agenci mogą robić sami i jak cmux da znać, gdy któryś skończy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto os agentes podem fazer sozinhos e como o cmux avisa quando um termina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько агентам можно делать самим и как cmux сообщит, когда один закончит."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์ทำอะไรเองได้แค่ไหน และ cmux จะบอกคุณอย่างไรเมื่องานเสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanların kendi başına ne kadar yapabileceği ve biri bitince cmux'un size nasıl haber vereceği."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки агентам можна робити самим і як cmux повідомить, коли один завершить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent được tự làm đến đâu, và cmux báo cho bạn thế nào khi một agent xong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体可以自行做多少，以及完成时 cmux 如何告诉你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理可以自行做多少，以及完成時 cmux 如何告訴你。"
          }
        }
      }
    },
