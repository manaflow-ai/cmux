        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معتم وهادئ. اللافتات في الخلفية فقط؛ والوكلاء يسألون أولًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neprozirno i mirno. Baneri samo u pozadini; agenti prvo pitaju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uigennemsigtig og rolig. Bannere kun i baggrunden; agenter spørger først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deckend und ruhig. Banner nur im Hintergrund; Agenten fragen zuerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opaco y tranquilo. Banners solo en segundo plano; los agentes preguntan primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Opaque et calme. Bannières seulement en arrière-plan ; les agents demandent d’abord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Opaco e calmo. Banner solo in background; gli agenti chiedono prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不透明で落ち着いた見た目。通知は背面のときだけ、エージェントはまず確認します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ស្រអាប់ និងស្ងប់។ បដាតែនៅផ្ទៃខាងក្រោយ; ភ្នាក់ងារសួរជាមុន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "불투명하고 차분하게. 배너는 백그라운드에서만, 에이전트는 먼저 묻습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugjennomsiktig og rolig. Bannere bare i bakgrunnen; agenter spør først."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieprzezroczysty i spokojny. Banery tylko w tle; agenci pytają najpierw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opaco e calmo. Banners só em segundo plano; agentes perguntam antes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Непрозрачно и спокойно. Баннеры только в фоне; агенты сначала спрашивают."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทึบและสงบ แบนเนอร์เฉพาะตอนอยู่เบื้องหลัง เอเจนต์ถามก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Opak ve sakin. Afişler yalnızca arka planda; ajanlar önce sorar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Непрозоро й спокійно. Банери лише у фоні; агенти спершу питають."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đục và yên tĩnh. Biểu ngữ chỉ khi ở nền; tác tử hỏi trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不透明且安静。仅在后台时显示横幅；智能体先询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不透明且安靜。僅在背景時顯示橫幅；代理先詢問。"
          }
        }
      }
    },
