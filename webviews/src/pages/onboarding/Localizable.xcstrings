    "onboarding.makeItYours.runIn.cloud.detail": {
      "comment": "Make cmux Yours: what running chats in Cloud means. A person with no agent installed can start here.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to install. Chats keep working while your Mac sleeps."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء لتثبيته. تستمر المحادثات في العمل أثناء نوم الـ Mac."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa za instalirati. Razgovori rade i dok Mac spava."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet at installere. Chats kører videre, mens din Mac sover."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts zu installieren. Chats laufen weiter, während dein Mac schläft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada que instalar. Los chats siguen funcionando mientras tu Mac duerme."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à installer. Les discussions continuent pendant que votre Mac est en veille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente da installare. Le chat continuano mentre il Mac è in stop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール不要。Macがスリープしてもチャットは動き続けます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានអ្វីត្រូវដំឡើងទេ។ ការជជែកនៅតែដំណើរការពេល Mac របស់អ្នកដេក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치할 것이 없습니다. Mac이 잠자기 중에도 채팅은 계속 작동합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting å installere. Chatter fortsetter mens Mac-en sover."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic do instalowania. Czaty działają, gdy Mac śpi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada para instalar. Os chats continuam funcionando enquanto seu Mac dorme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не нужно устанавливать. Чаты продолжают работать, пока Mac спит."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องติดตั้งอะไร แชทยังทำงานต่อขณะที่ Mac พักเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulacak bir şey yok. Mac'iniz uyurken sohbetler çalışmaya devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не треба встановлювати. Чати працюють, поки Mac спить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cần cài gì. Cuộc trò chuyện vẫn chạy khi máy Mac ngủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需安装。Mac 睡眠时聊天仍在运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無需安裝。Mac 睡眠時聊天仍在執行。"
          }
        }
      }
    },
