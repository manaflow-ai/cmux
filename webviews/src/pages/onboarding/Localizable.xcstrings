    "onboarding.makeItYours.setups.detail": {
      "comment": "Make cmux Yours (experiments.setupShelf): the line under the setups shelf's heading.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each changes only its own settings. Try one, then keep it or put yours back."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل إعداد يغيّر إعداداته فقط. جرّب واحدًا، ثم احتفظ به أو أعِد إعداداتك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka mijenja samo svoje postavke. Isprobaj jednu, pa je zadrži ili vrati svoje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver ændrer kun sine egne indstillinger. Prøv en, og behold den eller sæt dine tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes ändert nur seine eigenen Einstellungen. Probier eins aus und behalte es oder stell deine wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada una cambia solo sus propios ajustes. Prueba una y quédatela o recupera los tuyos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chacune ne change que ses propres réglages. Essayez-en une, puis gardez-la ou rétablissez les vôtres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ognuna cambia solo le proprie impostazioni. Provane una, poi tienila o ripristina le tue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それぞれ自分の設定だけを変えます。試してから、残すか元に戻せます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នីមួយៗផ្លាស់ប្តូរតែការកំណត់របស់វា។ សាកល្បងមួយ បន្ទាប់មករក្សាទុក ឬដាក់របស់អ្នកវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 묶음은 자기 설정만 바꿉니다. 써 보고 유지하거나 원래대로 되돌리세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert endrer bare sine egne innstillinger. Prøv ett, og behold det eller sett dine tilbake."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy zmienia tylko swoje ustawienia. Wypróbuj jeden, a potem go zachowaj albo przywróć swoje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada uma muda só as próprias configurações. Experimente uma e depois mantenha ou volte às suas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый меняет только свои настройки. Попробуйте один, затем оставьте его или верните свои."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ละชุดเปลี่ยนเฉพาะการตั้งค่าของตัวเอง ลองหนึ่งชุด แล้วเก็บไว้หรือคืนค่าของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her biri yalnızca kendi ayarlarını değiştirir. Birini deneyin, sonra tutun ya da kendi ayarlarınızı geri alın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен змінює лише свої налаштування. Спробуйте один, а потім залиште його або поверніть свої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi bộ chỉ đổi cài đặt của riêng nó. Thử một bộ, rồi giữ lại hoặc khôi phục của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每种预设只更改自己的设置。试用一种，然后保留或恢复你的设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每種預設只更改自己的設定。試用一種，然後保留或還原你的設定。"
          }
        }
      }
    },
