            "state": "translated",
            "value": "Poucas interrupções, nada pisca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало отвлечений, ничего не мигает."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รบกวนน้อย และไม่มีอะไรกะพริบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Az bölünme, hiçbir şey yanıp sönmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало відволікань, нічого не блимає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ít làm phiền, không có gì nhấp nháy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打扰更少，也不会闪烁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打擾更少，也不會閃爍。"
          }
        }
      }
    },
