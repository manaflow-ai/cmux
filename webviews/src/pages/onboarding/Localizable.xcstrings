        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចូលគណនី CLI ភ្នាក់ងារដែលអ្នកប្រើ។ អ្នកក៏អាចធ្វើវានៅពេលក្រោយក្នុងការកំណត់ផងដែរ។"
          }
        },
        "ko": {
          "stringUnit": {
