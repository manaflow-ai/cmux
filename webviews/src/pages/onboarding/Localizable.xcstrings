    "onboarding.makeItYours.setup.terminalFirst.line": {
      "comment": "Make cmux Yours (experiments.setupShelf): one line under the Terminal-first setup.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No chat main pane; new panes split."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا لوحة محادثة رئيسية؛ الألواح الجديدة تنقسم."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez glavnog chat okna; nova okna se dijele."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen chat-hovedrude; nye ruder deler sig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Chat-Hauptbereich; neue Bereiche teilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin panel principal de chat; los paneles nuevos dividen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de chat principal ; les nouveaux panneaux se divisent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna chat principale; i nuovi riquadri dividono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットのメインペインなし。新しいペインは分割。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានផ្ទាំងជជែកមេ; ផ្ទាំងថ្មីបំបែក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅 메인 패널 없이, 새 패널은 분할로."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen chat-hovedrute; nye ruter deler seg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez głównego czatu; nowe panele dzielą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem painel principal de chat; novos painéis dividem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без главного чата; новые панели делят окно."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีแผงแชตหลัก แผงใหม่จะแบ่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana sohbet bölmesi yok; yeni bölmeler bölünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без головного чату; нові панелі ділять вікно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có khung trò chuyện chính; khung mới tách đôi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有聊天主窗格；新窗格分屏。"
          }
        },
        "zh-Hant": {
