        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ប្រវត្តិរូបខ្លះមិនអាចអានបាន ដាក់ទស្សន៍ទ្រនិចលើវាដើម្បីដឹងមូលហេតុ។"
