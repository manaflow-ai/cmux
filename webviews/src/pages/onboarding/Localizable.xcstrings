{
  "sourceLanguage": "en",
  "strings": {
    "onboarding.access.allow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Access…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بالوصول…"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvoli pristup…"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv adgang…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff erlauben …"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir acceso…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser l’accès…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti accesso…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスを許可…"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អនុញ្ញាតការចូលប្រើ…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근 허용…"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi tilgang …"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na dostęp…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir acesso…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить доступ…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการเข้าถึง…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişime İzin Ver…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволити доступ…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép truy cập…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许访问…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許取用…"
          }
        }
      }
    },
    "onboarding.access.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To import from %@, give cmux access to its profile folder:"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للاستيراد من %@، امنح cmux حق الوصول إلى مجلد ملف التعريف الخاص به:"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za uvoz iz %@, dajte cmuxu pristup njegovoj mapi profila:"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv cmux adgang til mappen med profiler for at importere fra %@:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um aus %@ zu importieren, gib cmux Zugriff auf seinen Profilordner:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para importar desde %@, da a cmux acceso a su carpeta de perfiles:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour importer depuis %@, donnez à cmux l’accès à son dossier de profils :"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per importare da %@, consenti a cmux l’accesso alla sua cartella dei profili:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ から読み込むには、そのプロファイルフォルダへのアクセスを cmux に許可してください:"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដើម្បីនាំចូលពី %@ សូមអនុញ្ញាតឱ្យ cmux ចូលប្រើថតប្រវត្តិរូបរបស់វា៖"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 가져오려면 cmux가 해당 프로필 폴더에 접근하도록 허용하세요:"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å importere fra %@ må du gi cmux tilgang til profilmappen:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby zaimportować z %@, daj cmux dostęp do folderu profili:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para importar do %@, dê ao cmux acesso à pasta de perfis dele:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы импортировать из %@, дайте cmux доступ к папке его профилей:"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการนำเข้าจาก %@ ให้อนุญาตให้ cmux เข้าถึงโฟลเดอร์โปรไฟล์ของเบราว์เซอร์นั้น:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tarayıcısından içe aktarmak için cmux’a profil klasörüne erişim verin:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб імпортувати з %@, надайте cmux доступ до його теки профілів:"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để nhập từ %@, hãy cấp cho cmux quyền truy cập thư mục hồ sơ của trình duyệt đó:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要从 %@ 导入，请允许 cmux 访问其个人资料文件夹："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要從 %@ 輸入，請允許 cmux 取用其設定檔資料夾："
          }
        }
      }
    },
    "onboarding.access.needed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No access yet"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا وصول بعد"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nema pristupa"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen adgang endnu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Zugriff"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún sin acceso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d’accès"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun accesso per ora"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだアクセスできません"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនទាន់មានការចូលប្រើ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 접근 권한 없음"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen tilgang ennå"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak dostępu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem acesso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступа пока нет"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีสิทธิ์เข้าถึง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz erişim yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступу ще немає"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có quyền truy cập"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无访问权限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無取用權限"
          }
        }
      }
    },
    "onboarding.access.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux doesn’t have access to other browsers’ profiles on this Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يملك cmux وصولًا إلى ملفات تعريف المتصفحات الأخرى على هذا الـ Mac."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nema pristup profilima drugih preglednika na ovom Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux har ikke adgang til andre browseres profiler på denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux hat keinen Zugriff auf die Profile anderer Browser auf diesem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no tiene acceso a los perfiles de otros navegadores en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux n’a pas accès aux profils des autres navigateurs sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux non ha accesso ai profili degli altri browser su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux はこの Mac 上のほかのブラウザのプロファイルにアクセスできません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux មិនមានសិទ្ធិចូលប្រើប្រវត្តិរូបរបស់កម្មវិធីរុករកផ្សេងទៀតនៅលើ Mac នេះទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux는 이 Mac에 있는 다른 브라우저의 프로필에 접근할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux har ikke tilgang til andre nettleseres profiler på denne Macen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nie ma dostępu do profili innych przeglądarek na tym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux não tem acesso aos perfis de outros navegadores neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У cmux нет доступа к профилям других браузеров на этом Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ไม่มีสิทธิ์เข้าถึงโปรไฟล์ของเบราว์เซอร์อื่นบน Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux’un bu Mac’teki diğer tarayıcıların profillerine erişimi yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux не має доступу до профілів інших браузерів на цьому Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux không có quyền truy cập hồ sơ của các trình duyệt khác trên máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 无法访问此 Mac 上其他浏览器的个人资料。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 無法取用這台 Mac 上其他瀏覽器的設定檔。"
          }
        }
      }
    },
    "onboarding.access.notGranted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux didn’t get access. Choose %@ in the file picker."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يحصل cmux على حق الوصول. اختر %@ في منتقي الملفات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nije dobio pristup. Odaberite %@ u biraču datoteka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux fik ikke adgang. Vælg %@ i filvælgeren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux hat keinen Zugriff erhalten. Wähle %@ in der Dateiauswahl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no obtuvo acceso. Elige %@ en el selector de archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux n’a pas obtenu l’accès. Choisissez %@ dans le sélecteur de fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux non ha ottenuto l’accesso. Scegli %@ nel selettore di file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux はアクセスできませんでした。ファイルピッカーで %@ を選択してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux មិនបានទទួលសិទ្ធិចូលប្រើទេ។ ជ្រើសរើស %@ នៅក្នុងកម្មវិធីជ្រើសឯកសារ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 접근 권한을 얻지 못했습니다. 파일 선택기에서 %@ 폴더를 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux fikk ikke tilgang. Velg %@ i filvelgeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nie uzyskał dostępu. Wybierz %@ w oknie wyboru plików."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux não obteve acesso. Escolha %@ no seletor de arquivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux не получил доступ. Выберите %@ в окне выбора файлов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ไม่ได้รับสิทธิ์เข้าถึง เลือก %@ ในตัวเลือกไฟล์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux erişim alamadı. Dosya seçicide %@ klasörünü seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux не отримав доступу. Виберіть %@ у вікні вибору файлів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux chưa có quyền truy cập. Hãy chọn %@ trong bộ chọn tệp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 未获得访问权限。请在文件选择器中选择 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 未取得取用權限。請在檔案選擇器中選擇 %@。"
          }
        }
      }
    },
    "onboarding.access.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Select Continue."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "1. اختر متابعة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Odaberite Nastavi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Vælg Fortsæt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Wähle „Fortfahren“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Selecciona Continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Sélectionnez Continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Seleziona Continua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 「続ける」を選択します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "1. ជ្រើសរើស បន្ត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 계속을 선택합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Velg Fortsett."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Wybierz Kontynuuj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Selecione Continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Выберите «Продолжить»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "1. เลือก ดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Devam’ı seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Виберіть «Продовжити»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Chọn Tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 选择“继续”。"
