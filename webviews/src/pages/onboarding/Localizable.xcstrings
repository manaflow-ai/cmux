    "onboarding.makeItYours.tidy.detail": {
      "comment": "Make cmux Yours: what the Tidy switch does.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archive chats idle for 7 days, suggest archiving finished workspaces, and settle finished agents in the sidebar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرشفة المحادثات الخاملة منذ 7 أيام، واقتراح أرشفة مساحات العمل المنتهية، وتهدئة الوكلاء المنتهين في الشريط الجانبي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Arhiviraj razgovore neaktivne 7 dana, predloži arhiviranje završenih radnih prostora i smiri završene agente u bočnoj traci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkivér chats, der har været inaktive i 7 dage, foreslå arkivering af færdige arbejdsområder, og læg færdige agenter til ro i sidebjælken."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats nach 7 Tagen Inaktivität archivieren, fertige Workspaces zum Archivieren vorschlagen und fertige Agenten in der Seitenleiste ablegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiva chats inactivos 7 días, sugiere archivar espacios de trabajo terminados y asienta los agentes terminados en la barra lateral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Archive les discussions inactives depuis 7 jours, suggère d'archiver les espaces de travail terminés et range les agents terminés dans la barre latérale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivia le chat inattive da 7 giorni, suggerisce di archiviare gli spazi di lavoro finiti e riordina gli agenti finiti nella barra laterale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "7日間動きのないチャットをアーカイブし、終わったワークスペースのアーカイブを提案し、終わったエージェントをサイドバーで落ち着かせます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ទុកក្នុងបណ្ណសារការជជែកដែលស្ងៀម 7 ថ្ងៃ ស្នើទុកកន្លែងធ្វើការដែលបញ្ចប់ និងរៀបភ្នាក់ងារដែលបញ្ចប់នៅរបារចំហៀង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "7일 동안 쉬던 채팅을 보관하고, 끝난 작업 공간의 보관을 제안하고, 끝난 에이전트를 사이드바에서 정리합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkiver chatter som har vært inaktive i 7 dager, foreslå arkivering av ferdige arbeidsområder, og legg ferdige agenter til ro i sidefeltet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiwizuj czaty bezczynne od 7 dni, proponuj archiwizację ukończonych obszarów roboczych i porządkuj ukończonych agentów na pasku bocznym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquiva chats parados há 7 dias, sugere arquivar espaços de trabalho concluídos e acomoda agentes concluídos na barra lateral."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архивировать чаты, неактивные 7 дней, предлагать архивировать завершённые рабочие области и убирать завершённых агентов в боковой панели."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บแชตที่ไม่เคลื่อนไหว 7 วันเข้าคลัง แนะนำให้เก็บพื้นที่ทำงานที่เสร็จแล้ว และจัดเอเจนต์ที่เสร็จแล้วในแถบด้านข้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "7 gündür boşta olan sohbetleri arşivler, biten çalışma alanlarını arşivlemeyi önerir ve biten ajanları kenar çubuğunda yerleştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Архівувати чати, неактивні 7 днів, пропонувати архівувати завершені робочі області й прибирати завершених агентів на бічній панелі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu trữ cuộc trò chuyện không hoạt động 7 ngày, gợi ý lưu trữ không gian làm việc đã xong và xếp gọn agent đã xong ở thanh bên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档闲置 7 天的聊天，建议归档已完成的工作区，并在侧边栏收起已完成的智能体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封存閒置 7 天的聊天，建議封存已完成的工作區，並在側邊欄收起已完成的代理。"
          }
        }
      }
    },
    "onboarding.makeItYours.work.body": {
      "comment": "Make cmux Yours, screen 2 (how you work): the sentence under the title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Either is a good start. You can switch any time in Settings."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلاهما بداية جيدة. يمكنك التبديل في أي وقت من الإعدادات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oba su dobar početak. Možete promijeniti bilo kada u Postavkama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Begge er en god start. Du kan skifte når som helst i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beides ist ein guter Start. Du kannst jederzeit in den Einstellungen wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos son un buen comienzo. Puedes cambiar cuando quieras en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux sont un bon départ. Vous pouvez changer à tout moment dans les Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrambi sono un buon inizio. Puoi cambiare quando vuoi nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらでも良いスタートです。設定でいつでも切り替えられます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ទាំងពីរជាការចាប់ផ្ដើមល្អ។ អ្នកអាចប្ដូរបានគ្រប់ពេលក្នុងការកំណត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 쪽이든 좋은 시작입니다. 설정에서 언제든 바꿀 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Begge er en god start. Du kan bytte når som helst i Innstillinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oba są dobrym początkiem. Możesz zmienić w każdej chwili w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dois são um bom começo. Você pode trocar quando quiser em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оба варианта хороши для начала. Переключиться можно в любой момент в настройках."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทั้งสองแบบเป็นจุดเริ่มต้นที่ดี เปลี่ยนได้ทุกเมื่อในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İkisi de iyi bir başlangıç. İstediğiniz zaman Ayarlar'dan değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обидва варіанти добрі для початку. Перемкнути можна будь-коли в налаштуваннях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả hai đều là khởi đầu tốt. Bạn có thể đổi bất cứ lúc nào trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两种都是不错的开始。随时可以在设置中切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩種都是不錯的開始。隨時可以在設定中切換。"
          }
        }
      }
    },
