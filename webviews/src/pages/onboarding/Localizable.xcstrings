    "onboarding.makeItYours.work.gui.detail": {
      "comment": "Make cmux Yours: what Agents First means. ⌘T is the New Tab shortcut.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats, browsers and terminals side by side. ⌘T starts a new chat."
          }
        },
        "ja": {
          "stringUnit": {
