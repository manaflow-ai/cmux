          "stringUnit": {
            "state": "translated",
            "value": "Chats, Browser und Terminals nebeneinander. ⌘T startet einen neuen Chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats, navegadores y terminales lado a lado. ⌘T inicia un chat nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discussions, navigateurs et terminaux côte à côte. ⌘T lance une nouvelle discussion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat, browser e terminali fianco a fianco. ⌘T avvia una nuova chat."
