    "onboarding.makeItYours.noise.quiet.line": {
      "comment": "Make cmux Yours: what Quiet means.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No banners or sounds. The sidebar marks a chat that needs you."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا إشعارات ولا أصوات. يميّز الشريط الجانبي المحادثة التي تحتاجك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez obavijesti i zvukova. Bočna traka označi razgovor koji vas treba."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen bannere eller lyde. Sidebjælken markerer en chat, der har brug for dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Banner oder Töne. Die Seitenleiste markiert einen Chat, der dich braucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin avisos ni sonidos. La barra lateral marca el chat que te necesita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni bannières ni sons. La barre latérale signale la discussion qui a besoin de vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente banner né suoni. La barra laterale segna la chat che ha bisogno di te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バナーも音もなし。対応が必要なチャットはサイドバーに印が付きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានផ្ទាំងជូនដំណឹង ឬសំឡេង។ របារចំហៀងសម្គាល់ការជជែកដែលត្រូវការអ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배너와 소리 없음. 도움이 필요한 채팅은 사이드바에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen bannere eller lyder. Sidefeltet markerer en chat som trenger deg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez banerów i dźwięków. Pasek boczny oznacza czat, który Cię potrzebuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem banners nem sons. A barra lateral marca o chat que precisa de você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без баннеров и звуков. Боковая панель отметит чат, которому вы нужны."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีแบนเนอร์หรือเสียง แถบด้านข้างจะทำเครื่องหมายแชตที่ต้องการคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirim veya ses yok. Kenar çubuğu size ihtiyaç duyan sohbeti işaretler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без банерів і звуків. Бічна панель позначить чат, якому ви потрібні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không báo hay âm thanh. Thanh bên đánh dấu cuộc trò chuyện cần bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有横幅或声音。侧边栏会标出需要你的聊天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有橫幅或聲音。側邊欄會標出需要你的聊天。"
          }
        }
      }
    },
