    "onboarding.passwords.authDenied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was read: the confirmation didn’t finish. Click Begin Importing to try again, or import without passwords."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتم قراءة أي شيء: لم يكتمل التأكيد. انقر على بدء الاستيراد للمحاولة مرة أخرى، أو استورد بدون كلمات السر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa nije pročitano: potvrda nije završena. Kliknite Započni uvoz da pokušate ponovo ili uvezite bez lozinki."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet blev læst: bekræftelsen blev ikke fuldført. Klik på Start import for at prøve igen, eller importer uden adgangskoder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde nichts gelesen: Die Bestätigung wurde nicht abgeschlossen. Klicke auf „Import starten“, um es erneut zu versuchen, oder importiere ohne Passwörter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se leyó nada: la confirmación no terminó. Haz clic en Empezar a importar para volver a intentarlo, o importa sin contraseñas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’a été lu : la confirmation n’a pas abouti. Cliquez sur Commencer l’importation pour réessayer, ou importez sans les mots de passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato letto nulla: la conferma non è stata completata. Fai clic su Inizia l’importazione per riprovare, oppure importa senza password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も読み取られていません: 確認が完了しませんでした。「読み込みを開始」をクリックしてもう一度試すか、パスワードなしで読み込んでください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានអ្វីត្រូវបានអានទេ៖ ការបញ្ជាក់មិនបានបញ្ចប់។ ចុច ចាប់ផ្ដើមនាំចូល ដើម្បីសាកល្បងម្ដងទៀត ឬនាំចូលដោយគ្មានពាក្យសម្ងាត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 읽지 않았습니다. 확인이 완료되지 않았습니다. 가져오기 시작을 클릭해 다시 시도하거나 암호 없이 가져오세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting ble lest: bekreftelsen ble ikke fullført. Klikk på Start import for å prøve igjen, eller importer uten passord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie zostało odczytane: potwierdzenie nie zostało ukończone. Kliknij Rozpocznij import, aby spróbować ponownie, lub importuj bez haseł."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi lido: a confirmação não terminou. Clique em Começar a importar para tentar de novo ou importe sem senhas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не прочитано: подтверждение не завершено. Нажмите «Начать импорт», чтобы повторить попытку, или импортируйте без паролей."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีการอ่านข้อมูลใดๆ: การยืนยันไม่เสร็จสิ้น คลิก เริ่มนำเข้า เพื่อลองอีกครั้ง หรือนำเข้าโดยไม่มีรหัสผ่าน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey okunmadı: Onay tamamlanmadı. Yeniden denemek için İçe Aktarmayı Başlat’ı tıklayın veya parolalar olmadan içe aktarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не прочитано: підтвердження не завершено. Натисніть «Почати імпорт», щоб спробувати ще раз, або імпортуйте без паролів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa đọc gì: việc xác nhận chưa hoàn tất. Bấm Bắt đầu nhập để thử lại, hoặc nhập mà không có mật khẩu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未读取任何内容：确认未完成。点按“开始导入”重试，或在不导入密码的情况下导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未讀取任何內容：確認未完成。按一下「開始輸入」再試一次，或不含密碼輸入。"
          }
        }
      },
      "extractionState": "manual"
    },
    "onboarding.passwords.firefoxOnly": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يطلب الاستيراد تأكيدًا باستخدام Touch ID أو كلمة المرور. يحتفظ Firefox بمفتاحه داخل الملف الشخصي، لذا لا يطلب macOS أي عنصر من سلسلة المفاتيح. إذا كان لملف Firefox الشخصي كلمة مرور رئيسية، فسيطلبها cmux مرة واحدة ولن يحتفظ بها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uvoz traži potvrdu putem Touch ID-a ili lozinke. Firefox čuva svoj ključ u profilu, pa macOS ne traži nijednu stavku iz Keychaina. Ako Firefox profil ima glavnu lozinku, cmux će je zatražiti jednom i neće je zadržati."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Import beder dig bekræfte med Touch ID eller din adgangskode. Firefox gemmer sin nøgle i profilen, så macOS beder ikke om noget nøgleringselement. Hvis en Firefox-profil har en primær adgangskode, beder cmux om den én gang og gemmer den ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Import fordert eine Bestätigung mit Touch ID oder deinem Passwort an. Firefox bewahrt seinen Schlüssel im Profil auf, daher fragt macOS nach keinem Schlüsselbundeintrag. Hat ein Firefox-Profil ein Hauptpasswort, fragt cmux einmal danach und speichert es nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import asks you to confirm with Touch ID or your password. Firefox keeps its key in the profile, so macOS asks for no Keychain item. If a Firefox profile has a primary password, cmux asks for it once and does not keep it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La importación te pide confirmar con Touch ID o tu contraseña. Firefox guarda su clave en el perfil, así que macOS no pide ningún elemento del llavero. Si un perfil de Firefox tiene una contraseña principal, cmux la pide una vez y no la guarda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’importation vous demande de confirmer avec Touch ID ou votre mot de passe. Firefox conserve sa clé dans le profil, donc macOS ne demande aucun élément du trousseau. Si un profil Firefox a un mot de passe principal, cmux le demande une fois et ne le conserve pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’importazione ti chiede di confermare con Touch ID o con la password. Firefox conserva la sua chiave nel profilo, quindi macOS non chiede alcun elemento del portachiavi. Se un profilo Firefox ha una password principale, cmux la chiede una volta e non la conserva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込み時に Touch ID またはパスワードでの確認を求めます。Firefox は鍵をプロファイル内に保存するため、macOS はキーチェーン項目を求めません。Firefox プロファイルにプライマリパスワードがある場合、cmux は一度だけそれを尋ね、保存しません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការនាំចូលស្នើឱ្យអ្នកបញ្ជាក់ដោយ Touch ID ឬពាក្យសម្ងាត់របស់អ្នក។ Firefox រក្សាសោរបស់វានៅក្នុងប្រវត្តិរូប ដូច្នេះ macOS មិនស្នើរកធាតុ Keychain ទេ។ ប្រសិនបើប្រវត្តិរូប Firefox មានពាក្យសម្ងាត់មេ cmux នឹងសួររកវាម្តង ហើយមិនរក្សាទុកវាទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "가져오기 시 Touch ID 또는 암호로 확인을 요청합니다. Firefox는 키를 프로필에 보관하므로 macOS는 키체인 항목을 요청하지 않습니다. Firefox 프로필에 기본 비밀번호가 있으면 cmux가 한 번 요청하며 보관하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importen ber deg bekrefte med Touch ID eller passordet ditt. Firefox lagrer nøkkelen sin i profilen, så macOS ber ikke om noe nøkkelringelement. Hvis en Firefox-profil har et hovedpassord, ber cmux om det én gang og beholder det ikke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Import poprosi o potwierdzenie za pomocą Touch ID lub hasła. Firefox przechowuje swój klucz w profilu, więc macOS nie prosi o żaden element pęku kluczy. Jeśli profil Firefoksa ma hasło główne, cmux poprosi o nie raz i go nie zachowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A importação pede que você confirme com o Touch ID ou sua senha. O Firefox guarda a chave no perfil, então o macOS não pede nenhum item das Chaves. Se um perfil do Firefox tiver uma senha principal, o cmux a pede uma vez e não a guarda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Импорт попросит подтвердить действие с помощью Touch ID или пароля. Firefox хранит ключ в профиле, поэтому macOS не запрашивает объект связки ключей. Если у профиля Firefox есть основной пароль, cmux спросит его один раз и не сохранит."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การนำเข้าจะขอให้คุณยืนยันด้วย Touch ID หรือรหัสผ่าน Firefox เก็บกุญแจไว้ในโปรไฟล์ macOS จึงไม่ขอรายการพวงกุญแจใดๆ หากโปรไฟล์ Firefox มีรหัสผ่านหลัก cmux จะถามหนึ่งครั้งและไม่เก็บไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İçe aktarma, Touch ID veya parolanla onaylamanı ister. Firefox anahtarını profilde tuttuğu için macOS hiçbir Anahtar Zinciri öğesi istemez. Bir Firefox profilinin ana parolası varsa cmux onu bir kez sorar ve saklamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Імпорт попросить підтвердити дію за допомогою Touch ID або пароля. Firefox зберігає ключ у профілі, тож macOS не запитує жодного елемента зв’язки ключів. Якщо профіль Firefox має основний пароль, cmux запитає його один раз і не збереже."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khi nhập, bạn sẽ được yêu cầu xác nhận bằng Touch ID hoặc mật khẩu. Firefox giữ khóa trong hồ sơ nên macOS không yêu cầu mục Chuỗi khóa nào. Nếu hồ sơ Firefox có mật khẩu chính, cmux sẽ hỏi một lần và không lưu lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "导入时会要求你用 Touch ID 或密码确认。Firefox 将密钥保存在配置文件中，因此 macOS 不会请求钥匙串项目。如果 Firefox 配置文件设有主密码，cmux 会询问一次且不会保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "匯入時會要求你以 Touch ID 或密碼確認。Firefox 將金鑰保存在設定檔中，因此 macOS 不會要求鑰匙圈項目。若 Firefox 設定檔設有主要密碼，cmux 會詢問一次且不會保留。"
          }
        }
      }
    },
