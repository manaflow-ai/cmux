    "onboarding.agents.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to the agent CLIs you use. You can also do this later in Settings."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول إلى واجهات سطر أوامر الوكلاء التي تستخدمها. يمكنك أيضًا فعل ذلك لاحقًا في الإعدادات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se u CLI agente koje koristite. To možete uraditi i kasnije u Postavkama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind på de agent-CLI'er, du bruger. Du kan også gøre det senere i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich bei den Agenten-CLIs an, die du nutzt. Das geht auch später in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en las CLI de agentes que usas. También puedes hacerlo más tarde en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous aux CLI d’agents que vous utilisez. Vous pouvez aussi le faire plus tard dans Réglages."
