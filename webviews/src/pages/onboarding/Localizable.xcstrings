    "onboarding.makeItYours.body": {
      "comment": "Make cmux Yours: the sentence under the title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three quick choices. You can change any of them later in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3つの簡単な選択です。どれも後から設定で変更できます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثلاثة اختيارات سريعة. يمكنك تغيير أي منها لاحقًا في الإعدادات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tri brza izbora. Svaki možete kasnije promijeniti u Postavkama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre hurtige valg. Du kan ændre dem alle senere i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei kurze Entscheidungen. Du kannst jede später in den Einstellungen ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres elecciones rápidas. Puedes cambiar cualquiera más tarde en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois choix rapides. Vous pourrez tous les modifier plus tard dans les Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre scelte veloci. Puoi cambiarle in qualsiasi momento nelle Impostazioni."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ជម្រើសរហ័សបី។ អ្នកអាចផ្លាស់ប្តូរវានៅពេលក្រោយក្នុងការកំណត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "간단한 세 가지 선택입니다. 나중에 설정에서 언제든 바꿀 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre raske valg. Du kan endre alle senere i Innstillinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzy szybkie wybory. Każdy możesz później zmienić w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Três escolhas rápidas. Você pode mudar qualquer uma depois em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Три быстрых выбора. Любой из них можно изменить позже в настройках."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเลือกสั้นๆ สามข้อ คุณเปลี่ยนได้ภายหลังในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üç hızlı seçim. Hepsini daha sonra Ayarlar'dan değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Три швидкі вибори. Будь-який можна змінити пізніше в налаштуваннях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba lựa chọn nhanh. Bạn có thể thay đổi bất kỳ lúc nào trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三个快速选择。之后都可以在设置中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "三個快速選擇。之後都可以在設定中更改。"
          }
        }
      }
    },
