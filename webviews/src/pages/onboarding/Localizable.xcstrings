    "onboarding.makeItYours.permission.standard.line": {
      "comment": "Make cmux Yours: what Standard means.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each agent keeps its own rules, as it does outside cmux."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ كل وكيل بقواعده الخاصة كما يفعل خارج cmux."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki agent zadržava svoja pravila, kao i izvan cmuxa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver agent beholder sine egne regler, som uden for cmux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Agent behält seine eigenen Regeln, wie außerhalb von cmux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada agente mantiene sus propias reglas, como fuera de cmux."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque agent garde ses propres règles, comme hors de cmux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni agente mantiene le proprie regole, come fuori da cmux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各エージェントはcmuxの外と同じ自分のルールに従います。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្នាក់ងារនីមួយៗរក្សាច្បាប់ផ្ទាល់ខ្លួន ដូចនៅក្រៅ cmux។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 에이전트는 cmux 밖에서처럼 자기 규칙을 따릅니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver agent beholder sine egne regler, som utenfor cmux."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy agent zachowuje własne zasady, jak poza cmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada agente mantém as próprias regras, como fora do cmux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый агент следует своим правилам, как и вне cmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์แต่ละตัวใช้กฎของตัวเอง เหมือนนอก cmux"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ajan cmux dışında olduğu gibi kendi kurallarını korur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен агент дотримується своїх правил, як і поза cmux."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi agent giữ quy tắc riêng, như khi ở ngoài cmux."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个智能体沿用自己的规则，与在 cmux 之外一样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個代理沿用自己的規則，與在 cmux 之外一樣。"
          }
        }
      }
    },
