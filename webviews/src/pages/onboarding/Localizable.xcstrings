          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Computer Use 도우미가 응답하지 않았습니다. 다시 시도하려면 도우미를 재시작하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjelperen for cmux Computer Use svarte ikke. Start hjelperen på nytt for å prøve igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomocnik cmux Computer Use nie odpowiedział. Uruchom go ponownie, aby spróbować jeszcze raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
