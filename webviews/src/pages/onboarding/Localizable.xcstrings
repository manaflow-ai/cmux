    "onboarding.computerUse.accessibility.line": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets agents click and type in your apps"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح للوكلاء النقر والكتابة في تطبيقاتك"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogućava agentima da klikću i kucaju u vašim aplikacijama"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lader agenter klikke og skrive i dine apps"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents können in deinen Apps klicken und tippen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite a los agentes hacer clic y escribir en tus apps"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet aux agents de cliquer et de saisir dans vos apps"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente agli agenti di fare clic e scrivere nelle tue app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントがあなたのアプリでクリックや入力をできます"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អនុញ្ញាតឱ្យភ្នាក់ងារចុច និងវាយក្នុងកម្មវិធីរបស់អ្នក"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 앱에서 클릭하고 입력할 수 있습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lar agenter klikke og skrive i appene dine"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala agentom klikać i pisać w Twoich aplikacjach"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que agentes cliquem e digitem nos seus apps"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты смогут нажимать и вводить текст в ваших приложениях"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้เอเจนต์คลิกและพิมพ์ในแอปของคุณได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanların uygulamalarınızda tıklamasına ve yazmasına izin verir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенти зможуть натискати й вводити текст у ваших застосунках"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép tác tử bấm và gõ trong ứng dụng của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让代理在你的 App 中点按和输入"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓代理在你的 App 中點按和輸入"
          }
        }
      }
    },
