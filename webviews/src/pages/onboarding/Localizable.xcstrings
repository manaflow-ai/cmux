          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina de iniciar sesión en la pestaña del terminal y vuelve aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez la connexion dans l’onglet du terminal, puis revenez ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa l’accesso nella scheda del terminale, poi torna qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルタブでサインインを終えてから、ここに戻ってください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ចប់ការចូលនៅក្នុងផ្ទាំងទែមីណាល់ រួចត្រឡប់មកទីនេះវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 탭에서 로그인을 마친 다음 여기로 돌아오세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fullfør påloggingen i terminalfanen, og kom så tilbake hit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokończ logowanie w karcie terminala, a potem wróć tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine de entrar na aba do terminal e depois volte aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершите вход во вкладке терминала, затем вернитесь сюда."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าใช้ในแท็บเทอร์มินัลให้เสร็จ แล้วกลับมาที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal sekmesinde oturum açmayı bitirin, ardından buraya dönün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершіть вхід у вкладці термінала, потім поверніться сюди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoàn tất đăng nhập trong tab terminal, rồi quay lại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在终端标签页中完成登录，然后回到这里。"
