    "onboarding.makeItYours.permission.ask.line": {
      "comment": "Make cmux Yours: what Ask First means.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents ask before they edit a file or run a command."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسأل الوكلاء قبل تعديل ملف أو تشغيل أمر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenti pitaju prije nego što izmijene datoteku ili pokrenu naredbu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenter spørger, før de ændrer en fil eller kører en kommando."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten fragen, bevor sie eine Datei ändern oder einen Befehl ausführen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes preguntan antes de editar un archivo o ejecutar un comando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les agents demandent avant de modifier un fichier ou de lancer une commande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli agenti chiedono prima di modificare un file o eseguire un comando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントはファイルの編集やコマンドの実行前に確認します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្នាក់ងារសួរមុនកែឯកសារ ឬដំណើរការពាក្យបញ្ជា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 파일을 고치거나 명령을 실행하기 전에 묻습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenter spør før de endrer en fil eller kjører en kommando."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenci pytają, zanim zmienią plik lub uruchomią polecenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os agentes perguntam antes de editar um arquivo ou executar um comando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты спрашивают, прежде чем изменить файл или выполнить команду."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์ถามก่อนแก้ไขไฟล์หรือรันคำสั่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanlar bir dosyayı düzenlemeden veya komut çalıştırmadan önce sorar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенти питають, перш ніж змінити файл або виконати команду."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent hỏi trước khi sửa tệp hay chạy lệnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体在编辑文件或运行命令前先询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理在編輯檔案或執行命令前先詢問。"
          }
        }
      }
    },
