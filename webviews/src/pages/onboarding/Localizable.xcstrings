            "state": "translated",
            "value": "Poche interruzioni, niente lampeggia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "割り込みは少なく、点滅もしません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រំខានតិច ហើយគ្មានអ្វីភ្លឹបភ្លែតទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방해는 적게, 깜빡임은 없이."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Få avbrudd, og ingenting blinker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mało przerw, nic nie miga."
          }
        },
        "pt-BR": {
