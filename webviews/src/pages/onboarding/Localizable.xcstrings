        "pl": {"stringUnit": {"state": "translated", "value": "Obsługa komputera jest gotowa"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O uso do computador está pronto"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Управление компьютером готово"}},
        "th": {"stringUnit": {"state": "translated", "value": "การใช้คอมพิวเตอร์พร้อมแล้ว"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Bilgisayar kullanımı hazır"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Керування комп’ютером готове"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Sử dụng máy tính đã sẵn sàng"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "电脑操控已就绪"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "電腦操控已就緒"}}
      }
    },
    "onboarding.computerUse.done.line": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup is complete. Agents can now use apps on your Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتمل الإعداد. يمكن للوكلاء الآن استخدام التطبيقات على جهاز Mac."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavljanje je završeno. Agenti sada mogu koristiti aplikacije na tvom Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsætningen er færdig. Agenter kan nu bruge apps på din Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einrichtung ist abgeschlossen. Agents können jetzt Apps auf deinem Mac nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración está completa. Los agentes ya pueden usar apps en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration est terminée. Les agents peuvent désormais utiliser les apps de votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurazione completata. Ora gli agenti possono usare le app sul tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定が完了しました。エージェントが Mac のアプリを使えるようになりました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការរៀបចំបានបញ្ចប់។ ភ្នាក់ងារអាចប្រើកម្មវិធីនៅលើ Mac របស់អ្នកឥឡូវនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정이 완료되었습니다. 이제 에이전트가 Mac의 앱을 사용할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppsettet er ferdig. Agenter kan nå bruke apper på Macen din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguracja zakończona. Agenci mogą teraz używać aplikacji na Twoim Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração foi concluída. Agentes já podem usar apps no seu Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройка завершена. Теперь агенты могут пользоваться приложениями на вашем Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งค่าเสร็จแล้ว ตอนนี้เอเจนต์ใช้แอปบน Mac ของคุณได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulum tamamlandı. Ajanlar artık Mac'inizdeki uygulamaları kullanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування завершено. Тепер агенти можуть користуватися застосунками на вашому Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã thiết lập xong. Giờ tác tử có thể dùng ứng dụng trên Mac của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置完成。智能体现在可以使用你 Mac 上的应用了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定完成。代理現在可以使用你 Mac 上的 App 了。"
          }
        }
      }
    },
    "onboarding.computerUse.screenshots.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "macOS asks for confirmation. Allow screen capture."}},
        "ar": {"stringUnit": {"state": "translated", "value": "يطلب macOS التأكيد. اسمح بالتقاط الشاشة."}},
        "bs": {"stringUnit": {"state": "translated", "value": "macOS traži potvrdu. Dozvolite snimanje ekrana."}},
        "da": {"stringUnit": {"state": "translated", "value": "macOS beder om bekræftelse. Tillad skærmoptagelse."}},
        "de": {"stringUnit": {"state": "translated", "value": "macOS fragt nach einer Bestätigung. Erlaube die Bildschirmaufnahme."}},
        "es": {"stringUnit": {"state": "translated", "value": "macOS pide confirmación. Permite la captura de pantalla."}},
        "fr": {"stringUnit": {"state": "translated", "value": "macOS demande une confirmation. Autorisez la capture d’écran."}},
        "it": {"stringUnit": {"state": "translated", "value": "macOS chiede una conferma. Consenti la cattura dello schermo."}},
        "ja": {"stringUnit": {"state": "translated", "value": "macOS から確認を求められます。画面の取り込みを許可してください。"}},
        "km": {"stringUnit": {"state": "translated", "value": "macOS ស្នើការបញ្ជាក់។ អនុញ្ញាតការថតអេក្រង់។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "macOS에서 확인을 요청합니다. 화면 캡처를 허용하세요."}},
        "nb": {"stringUnit": {"state": "translated", "value": "macOS ber om bekreftelse. Tillat skjermopptak."}},
        "pl": {"stringUnit": {"state": "translated", "value": "macOS prosi o potwierdzenie. Zezwól na przechwytywanie ekranu."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O macOS pede uma confirmação. Permita a captura de tela."}},
        "ru": {"stringUnit": {"state": "translated", "value": "macOS попросит подтверждение. Разрешите захват экрана."}},
        "th": {"stringUnit": {"state": "translated", "value": "macOS จะขอการยืนยัน อนุญาตการจับภาพหน้าจอ"}},
        "tr": {"stringUnit": {"state": "translated", "value": "macOS onay ister. Ekran yakalamaya izin verin."}},
        "uk": {"stringUnit": {"state": "translated", "value": "macOS попросить підтвердження. Дозвольте захоплення екрана."}},
        "vi": {"stringUnit": {"state": "translated", "value": "macOS sẽ yêu cầu xác nhận. Hãy cho phép chụp màn hình."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "macOS 会请求确认。请允许屏幕捕获。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "macOS 會要求確認。請允許螢幕擷取。"}}
      }
    },
    "onboarding.computerUse.screenshots.confirmDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The system “bypass” warning is expected here."}},
        "ar": {"stringUnit": {"state": "translated", "value": "تحذير النظام بشأن «التجاوز» متوقع هنا."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Sistemsko upozorenje o „zaobilaženju“ ovdje je očekivano."}},
        "da": {"stringUnit": {"state": "translated", "value": "Systemets advarsel om »omgåelse« er forventet her."}},
        "de": {"stringUnit": {"state": "translated", "value": "Die Systemwarnung zum „Umgehen“ ist hier zu erwarten."}},
        "es": {"stringUnit": {"state": "translated", "value": "Aquí es normal que aparezca el aviso del sistema sobre «omitir»."}},
        "fr": {"stringUnit": {"state": "translated", "value": "L’avertissement système « contourner » est normal ici."}},
        "it": {"stringUnit": {"state": "translated", "value": "L’avviso di sistema su «aggirare» è previsto in questo passaggio."}},
        "ja": {"stringUnit": {"state": "translated", "value": "ここではシステムの「バイパス」に関する警告が表示されますが、問題ありません。"}},
        "km": {"stringUnit": {"state": "translated", "value": "ការព្រមានរបស់ប្រព័ន្ធអំពី «ការរំលង» គឺជារឿងធម្មតានៅទីនេះ។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "여기서 시스템의 ‘우회’ 경고가 표시되는 것은 정상입니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Systemvarselet om «omgåelse» er forventet her."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Systemowe ostrzeżenie o „pominięciu” jest tu oczekiwane."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O aviso do sistema sobre “ignorar” é esperado aqui."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Системное предупреждение об «обходе» здесь ожидаемо."}},
        "th": {"stringUnit": {"state": "translated", "value": "คำเตือน “ข้าม” ของระบบเป็นเรื่องปกติในขั้นตอนนี้"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Sistemin “atlama” uyarısı burada beklenen bir durumdur."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Системне попередження про «обхід» тут очікуване."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Cảnh báo “bỏ qua” của hệ thống là bình thường ở bước này."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "此处出现系统的“绕过”警告属于正常情况。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "此處出現系統的「略過」警告屬於正常情況。"}}
      }
    },
    "onboarding.computerUse.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Computer Use runs in its own helper app. You can quit or reopen it without closing cmux or your terminals."}},
        "ar": {"stringUnit": {"state": "translated", "value": "يعمل استخدام الكمبيوتر في تطبيق مساعد خاص به. يمكنك إنهاؤه أو إعادة فتحه دون إغلاق cmux أو الطرفيات."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Korištenje računara radi u vlastitoj pomoćnoj aplikaciji. Možete je zatvoriti ili ponovo otvoriti bez zatvaranja cmuxa ili vaših terminala."}},
        "da": {"stringUnit": {"state": "translated", "value": "Computerbrug kører i sin egen hjælpeapp. Du kan afslutte eller genåbne den uden at lukke cmux eller dine terminaler."}},
        "de": {"stringUnit": {"state": "translated", "value": "Computernutzung läuft in einer eigenen Hilfs-App. Du kannst sie beenden oder neu öffnen, ohne cmux oder deine Terminals zu schließen."}},
        "es": {"stringUnit": {"state": "translated", "value": "El uso del ordenador se ejecuta en su propia app auxiliar. Puedes cerrarla o volver a abrirla sin cerrar cmux ni tus terminales."}},
        "fr": {"stringUnit": {"state": "translated", "value": "L’utilisation de l’ordinateur s’exécute dans sa propre app d’assistance. Vous pouvez la quitter ou la rouvrir sans fermer cmux ni vos terminaux."}},
        "it": {"stringUnit": {"state": "translated", "value": "L’uso del computer funziona in un’app di supporto separata. Puoi chiuderla o riaprirla senza chiudere cmux o i tuoi terminali."}},
        "ja": {"stringUnit": {"state": "translated", "value": "コンピュータの操作は専用のヘルパーアプリで動作します。cmux やターミナルを閉じずに、終了したり開き直したりできます。"}},
        "km": {"stringUnit": {"state": "translated", "value": "ការប្រើកុំព្យូទ័រដំណើរការក្នុងកម្មវិធីជំនួយផ្ទាល់ខ្លួន។ អ្នកអាចបិទ ឬបើកវាឡើងវិញ ដោយមិនបិទ cmux ឬទែមីណាល់របស់អ្នក។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "컴퓨터 사용은 별도의 도우미 앱에서 실행됩니다. cmux나 터미널을 닫지 않고도 종료하거나 다시 열 수 있습니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Datamaskinbruk kjører i sin egen hjelpeapp. Du kan avslutte eller åpne den igjen uten å lukke cmux eller terminalene dine."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Obsługa komputera działa we własnej aplikacji pomocniczej. Możesz ją zamknąć lub otworzyć ponownie bez zamykania cmux ani terminali."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O uso do computador roda em um app auxiliar próprio. Você pode encerrá-lo ou abri-lo de novo sem fechar o cmux nem seus terminais."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Управление компьютером работает в отдельном вспомогательном приложении. Его можно закрыть или открыть снова, не закрывая cmux и терминалы."}},
        "th": {"stringUnit": {"state": "translated", "value": "การใช้คอมพิวเตอร์ทำงานในแอปตัวช่วยของตัวเอง คุณออกหรือเปิดใหม่ได้โดยไม่ต้องปิด cmux หรือเทอร์มินัล"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Bilgisayar kullanımı kendi yardımcı uygulamasında çalışır. cmux’u veya terminallerinizi kapatmadan ondan çıkabilir ya da yeniden açabilirsiniz."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Керування комп’ютером працює в окремому допоміжному застосунку. Його можна закрити або відкрити знову, не закриваючи cmux і термінали."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Sử dụng máy tính chạy trong ứng dụng trợ giúp riêng. Bạn có thể thoát hoặc mở lại mà không cần đóng cmux hay các terminal."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "电脑操控在独立的辅助 App 中运行。你可以退出或重新打开它，而无需关闭 cmux 或终端。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "電腦操控在獨立的輔助 App 中執行。你可以結束或重新開啟它，而不必關閉 cmux 或終端機。"}}
      }
    },
