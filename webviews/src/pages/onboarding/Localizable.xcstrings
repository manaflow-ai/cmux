    "onboarding.computerUse.screenshots.line": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets agents see the window they work in"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح للوكلاء رؤية النافذة التي يعملون فيها"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogućava agentima da vide prozor u kojem rade"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lader agenter se det vindue, de arbejder i"
