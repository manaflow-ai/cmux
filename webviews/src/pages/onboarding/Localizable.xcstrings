        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅, 브라우저, 터미널을 나란히. ⌘T로 새 채팅을 시작합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatter, nettlesere og terminaler side om side. ⌘T starter en ny chat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czaty, przeglądarki i terminale obok siebie. ⌘T rozpoczyna nowy czat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats, navegadores e terminais lado a lado. ⌘T inicia um novo chat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаты, браузеры и терминалы рядом. ⌘T начинает новый чат."
