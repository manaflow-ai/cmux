        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2. ファイルピッカーでこのフォルダを開き、「アクセスを許可」を選択します:"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "2. នៅក្នុងកម្មវិធីជ្រើសឯកសារ បើកថតនេះ ហើយជ្រើសរើស អនុញ្ញាតការចូលប្រើ៖"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 파일 선택기에서 이 폴더를 열고 접근 허용을 선택합니다:"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Åpne denne mappen i filvelgeren, og velg Gi tilgang:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "2. W oknie wyboru plików otwórz ten folder i wybierz Zezwól na dostęp:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "2. No seletor de arquivos, abra esta pasta e escolha Permitir acesso:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "2. В окне выбора файлов откройте эту папку и выберите «Разрешить доступ»:"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "2. ในตัวเลือกไฟล์ ให้เปิดโฟลเดอร์นี้ แล้วเลือก อนุญาตการเข้าถึง:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Dosya seçicide bu klasörü açın ve Erişime İzin Ver’i seçin:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
