    "onboarding.makeItYours.tune.body": {
      "comment": "Make cmux Yours, screen 4: the sentence under the title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fit the window to you. Every row is in Settings > Appearance too."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجعل النافذة تناسبك. كل صف موجود أيضًا في الإعدادات > المظهر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilagodite prozor sebi. Svaki red je i u Postavke > Izgled."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpas vinduet til dig. Hver række findes også i Indstillinger > Udseende."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass das Fenster an dich an. Jede Zeile gibt es auch unter Einstellungen > Darstellung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta la ventana a ti. Cada fila también está en Ajustes > Apariencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptez la fenêtre à vous. Chaque ligne est aussi dans Réglages > Apparence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
