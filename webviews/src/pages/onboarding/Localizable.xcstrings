    "onboarding.import.keepInSync.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New pages you visit in these browsers show up in cmux too. Everything stays on this Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Seiten, die du in diesen Browsern besuchst, erscheinen auch in cmux. Alles bleibt auf diesem Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouvelles pages que vous visitez dans ces navigateurs apparaissent aussi dans cmux. Tout reste sur ce Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الصفحات الجديدة التي تزورها في هذه المتصفحات في cmux أيضًا. يبقى كل شيء على جهاز Mac هذا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las páginas nuevas que visites en estos navegadores también aparecen en cmux. Todo se queda en este Mac."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在這些瀏覽器中造訪的新網頁也會出現在 cmux 中。所有資料都留在這台 Mac 上。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在这些浏览器中访问的新网页也会出现在 cmux 中。所有数据都保留在这台 Mac 上。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 브라우저에서 방문한 새 페이지가 cmux에도 표시됩니다. 모든 데이터는 이 Mac에 남습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのブラウザで新しく開いたページも cmux に表示されます。データはすべてこの Mac に残ります。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nove stranice koje posjetite u ovim preglednicima pojavit će se i u cmuxu. Sve ostaje na ovom Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nye sider, du besøger i disse browsere, vises også i cmux. Alt bliver på denne Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nuove pagine che visiti in questi browser compaiono anche in cmux. Tutto resta su questo Mac."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ទំព័រថ្មីដែលអ្នកចូលមើលក្នុងកម្មវិធីរុករកទាំងនេះ ក៏បង្ហាញក្នុង cmux ដែរ។ អ្វីៗទាំងអស់នៅលើ Mac នេះ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nye sider du besøker i disse nettleserne, vises også i cmux. Alt blir på denne Macen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowe strony odwiedzane w tych przeglądarkach pojawią się też w cmux. Wszystko zostaje na tym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As novas páginas que você visitar nesses navegadores também aparecem no cmux. Tudo fica neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые страницы, которые вы открываете в этих браузерах, появятся и в cmux. Всё остаётся на этом Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าใหม่ที่คุณเข้าชมในเบราว์เซอร์เหล่านี้จะแสดงใน cmux ด้วย ข้อมูลทั้งหมดอยู่บน Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tarayıcılarda ziyaret ettiğiniz yeni sayfalar cmux'ta da görünür. Her şey bu Mac'te kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нові сторінки, які ви відвідуєте в цих браузерах, з’являться і в cmux. Усе залишається на цьому Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các trang mới bạn truy cập trong những trình duyệt này cũng hiện trong cmux. Mọi thứ đều ở lại trên máy Mac này."
          }
        }
      }
    },
