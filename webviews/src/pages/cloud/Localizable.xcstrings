    "files.transferBusy": {
      "comment": "Message when the server refuses a new file copy because too many are running; a Retry button follows",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يجري الآن عدد كبير جدًا من عمليات نقل الملفات. حاول مرة أخرى عند انتهاء إحداها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokrenuto je previše prijenosa datoteka. Pokušajte ponovo kada se jedan završi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der kører for mange filoverførsler. Prøv igen, når en er færdig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es laufen zu viele Dateiübertragungen. Versuche es erneut, wenn eine beendet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many file transfers are running. Try again when one ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hay demasiadas transferencias de archivos en curso. Vuelve a intentarlo cuando termine una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trop de transferts de fichiers sont en cours. Réessayez quand l’un d’eux sera terminé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sono in corso troppi trasferimenti di file. Riprova quando uno sarà terminato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中のファイル転送が多すぎます。いずれかが終わってから再試行してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មានការផ្ទេរឯកសារច្រើនពេកកំពុងដំណើរការ។ សូមព្យាយាមម្តងទៀតនៅពេលមួយបញ្ចប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "실행 중인 파일 전송이 너무 많습니다. 하나가 끝나면 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "For mange filoverføringer kjører. Prøv igjen når én er ferdig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trwa zbyt wiele transferów plików. Spróbuj ponownie, gdy jeden się zakończy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Há transferências de arquivos demais em andamento. Tente novamente quando uma terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выполняется слишком много передач файлов. Повторите попытку, когда одна из них завершится."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "มีการถ่ายโอนไฟล์ทำงานอยู่มากเกินไป ลองอีกครั้งเมื่อมีรายการหนึ่งเสร็จสิ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Çok fazla dosya aktarımı çalışıyor. Biri bittiğinde yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Виконується забагато передавань файлів. Спробуйте ще раз, коли одне з них завершиться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Có quá nhiều lượt truyền tệp đang chạy. Hãy thử lại khi một lượt kết thúc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "正在运行的文件传输过多。请在其中一个结束后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "正在執行的檔案傳輸過多。請在其中一個結束後重試。"
          }
        }
      }
