        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンを作成すると、クラウドでターミナルとエージェントを実行できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បង្កើតម៉ាស៊ីនដើម្បីដំណើរការទែមីណាល់ និងភ្នាក់ងារនៅក្នុងក្លោដ។"
