    "migration.body": {
      "comment": "Banner text under the classic machines title",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "انقلها لاستخدامها هنا. حتى ذلك الحين تكون للقراءة فقط. النقل في اتجاه واحد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Premjestite ih da biste ih koristili ovdje. Do tada su samo za čitanje. Premještanje je jednosmjerno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Flyt dem for at bruge dem her. Indtil da er de skrivebeskyttede. Flytningen kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verschiebe sie, um sie hier zu nutzen. Bis dahin sind sie schreibgeschützt. Das Verschieben ist endgültig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move them to use them here. Until then they are read-only. The move is one way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Muévelas para usarlas aquí. Hasta entonces son de solo lectura. El traslado no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Déplacez-les pour les utiliser ici. D'ici là, elles sont en lecture seule. Le déplacement est définitif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spostale per usarle qui. Fino ad allora sono di sola lettura. Lo spostamento è definitivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで使うには移動してください。移動するまでは読み取り専用です。移動は元に戻せません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្លាស់ទីពួកវាដើម្បីប្រើនៅទីនេះ។ រហូតដល់ពេលនោះ ពួកវាអានបានតែប៉ុណ្ណោះ។ ការផ្លាស់ទីគឺមួយផ្លូវ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "여기에서 사용하려면 옮기세요. 그전까지는 읽기 전용입니다. 이동은 되돌릴 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Flytt dem for å bruke dem her. Inntil da er de skrivebeskyttet. Flyttingen er endelig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przenieś je, aby ich tu używać. Do tego czasu są tylko do odczytu. Przeniesienia nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mova-as para usá-las aqui. Até lá, elas ficam somente leitura. A mudança não pode ser desfeita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перенесите их, чтобы пользоваться ими здесь. До этого они доступны только для чтения. Перенос необратим."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ย้ายเครื่องเหล่านี้เพื่อใช้งานที่นี่ จนกว่าจะย้าย เครื่องจะอ่านได้อย่างเดียว การย้ายเป็นแบบทางเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Burada kullanmak için taşıyın. O zamana kadar salt okunurdur. Taşıma geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перенесіть їх, щоб користуватися ними тут. До того вони лише для читання. Перенесення незворотне."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Di chuyển để dùng chúng ở đây. Trước đó chúng chỉ đọc. Việc di chuyển là một chiều."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "移动后即可在这里使用。在此之前为只读。移动无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "移動後即可在這裡使用。在此之前為唯讀。移動無法復原。"
          }
        }
      }
    },
