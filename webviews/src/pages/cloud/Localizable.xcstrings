    "ports.browserTabRefused": {
      "comment": "The browser refused a proxied tab",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يمكن للمتصفح فتح صفحة هذا الجهاز: يلزم محرك Chromium مع وكيل الجهاز. لم يُفتح شيء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Preglednik ne može otvoriti stranicu ove mašine: potreban je Chromium mehanizam s proxyjem mašine. Ništa nije otvoreno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Browseren kan ikke åbne denne maskines side: den kræver Chromium-motoren med maskinens proxy. Intet blev åbnet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Browser kann die Seite dieser Maschine nicht öffnen: Dafür ist die Chromium-Engine mit dem Proxy der Maschine nötig. Es wurde nichts geöffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The browser cannot open this machine's page: it needs the Chromium engine with the machine's proxy. Nothing was opened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El navegador no puede abrir la página de esta máquina: necesita el motor Chromium con el proxy de la máquina. No se abrió nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le navigateur ne peut pas ouvrir la page de cette machine : il faut le moteur Chromium avec le proxy de la machine. Rien n'a été ouvert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il browser non può aprire la pagina di questa macchina: serve il motore Chromium con il proxy della macchina. Non è stato aperto nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザはこのマシンのページを開けません。マシンのプロキシを使う Chromium エンジンが必要です。何も開いていません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កម្មវិធីរុករកមិនអាចបើកទំព័ររបស់ម៉ាស៊ីននេះបានទេ៖ វាត្រូវការម៉ាស៊ីន Chromium ជាមួយប្រូកស៊ីរបស់ម៉ាស៊ីន។ គ្មានអ្វីត្រូវបានបើកទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "브라우저가 이 머신의 페이지를 열 수 없습니다. 머신의 프록시를 사용하는 Chromium 엔진이 필요합니다. 아무것도 열리지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nettleseren kan ikke åpne denne maskinens side: den trenger Chromium-motoren med maskinens proxy. Ingenting ble åpnet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przeglądarka nie może otworzyć strony tej maszyny: potrzebny jest silnik Chromium z proxy maszyny. Nic nie zostało otwarte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O navegador não pode abrir a página desta máquina: é preciso o mecanismo Chromium com o proxy da máquina. Nada foi aberto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Браузер не может открыть страницу этой машины: нужен движок Chromium с прокси машины. Ничего не открыто."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เบราว์เซอร์เปิดหน้าของเครื่องนี้ไม่ได้: ต้องใช้เอนจิน Chromium พร้อมพร็อกซีของเครื่อง ไม่มีสิ่งใดถูกเปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tarayıcı bu makinenin sayfasını açamıyor: makinenin proxy'si ile Chromium motoru gerekiyor. Hiçbir şey açılmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Браузер не може відкрити сторінку цієї машини: потрібен рушій Chromium із проксі машини. Нічого не відкрито."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trình duyệt không thể mở trang của máy này: cần công cụ Chromium với proxy của máy. Không có gì được mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "浏览器无法打开这台机器的页面：需要使用该机器代理的 Chromium 引擎。未打开任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "瀏覽器無法開啟這台機器的頁面：需要使用該機器代理的 Chromium 引擎。未開啟任何內容。"
          }
        }
      }
    },
