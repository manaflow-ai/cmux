    "auth.signedOutBody": {
      "comment": "Signed-out state text",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "شغّل الطرفيات والوكلاء على أجهزة السحابة. سجّل الدخول لرؤية أجهزتك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokrećite terminale i agente na mašinama u oblaku. Prijavite se da vidite svoje mašine."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kør terminaler og agenter på Cloud-maskiner. Log ind for at se dine maskiner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Führe Terminals und Agenten auf Cloud-Maschinen aus. Melde dich an, um deine Maschinen zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run terminals and agents on Cloud machines. Sign in to see your machines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ejecuta terminales y agentes en máquinas de la nube. Inicia sesión para ver tus máquinas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Exécutez des terminaux et des agents sur des machines cloud. Connectez-vous pour voir vos machines."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esegui terminali e agenti su macchine cloud. Accedi per vedere le tue macchine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドマシンでターミナルとエージェントを実行します。サインインするとマシンが表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ដំណើរការទែមីណាល់ និងភ្នាក់ងារលើម៉ាស៊ីនក្លោដ។ ចូលដើម្បីមើលម៉ាស៊ីនរបស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "클라우드 머신에서 터미널과 에이전트를 실행하세요. 로그인하면 머신이 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kjør terminaler og agenter på skymaskiner. Logg på for å se maskinene dine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uruchamiaj terminale i agentów na maszynach w chmurze. Zaloguj się, aby zobaczyć swoje maszyny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Execute terminais e agentes em máquinas na nuvem. Entre para ver suas máquinas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запускайте терминалы и агентов на облачных машинах. Войдите, чтобы увидеть свои машины."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เรียกใช้เทอร์มินัลและเอเจนต์บนเครื่องคลาวด์ ลงชื่อเข้าใช้เพื่อดูเครื่องของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminalleri ve ajanları Bulut makinelerinde çalıştırın. Makinelerinizi görmek için oturum açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запускайте термінали й агентів на хмарних машинах. Увійдіть, щоб побачити свої машини."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chạy terminal và agent trên máy đám mây. Đăng nhập để xem các máy của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在云机器上运行终端和代理。登录即可查看你的机器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在雲端機器上執行終端機和代理程式。登入即可查看你的機器。"
          }
        }
      }
    },
