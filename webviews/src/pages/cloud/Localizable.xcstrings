    "machines.classicReadOnly": {
      "comment": "Note on a classic machine: it cannot be changed here until it is upgraded",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "للقراءة فقط إلى أن تتم ترقية هذا الجهاز."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Samo za čitanje dok se ova mašina ne nadogradi."
          }
        },
        "da": {
