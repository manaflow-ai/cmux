    "machines.emptyBody": {
      "comment": "Empty list text",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أنشئ جهازًا لتشغيل الطرفيات والوكلاء في السحابة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Napravite mašinu za pokretanje terminala i agenata u oblaku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opret en maskine for at køre terminaler og agenter i skyen."
          }
        },
        "de": {
          "stringUnit": {
