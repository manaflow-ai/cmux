            "value": "プランの上限に達しました（{limit} 中 {used} を使用中）。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បានដល់ដែនកំណត់នៃគម្រោងរបស់អ្នក៖ កំពុងប្រើ {used} ក្នុងចំណោម {limit}។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "요금제 한도에 도달했습니다: {limit}개 중 {used}개 사용 중."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abonnementets grense er nådd: {used} av {limit} i bruk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Osiągnięto limit planu: w użyciu {used} z {limit}."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
