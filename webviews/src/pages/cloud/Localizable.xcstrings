    "create.limitReached": {
      "comment": "Plan limit reached; same placeholders",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "جميع أجهزة خطة {plan} البالغ عددها {limit} قيد الاستخدام ({used}). احذف جهازًا أو رقِّ الخطة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svih {limit} mašina plana {plan} je u upotrebi ({used}). Izbrišite mašinu ili nadogradite plan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle {limit} maskiner på {plan}-abonnementet er i brug ({used}). Slet en maskine, eller opgrader abonnementet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle {limit} Maschinen des Tarifs {plan} sind belegt ({used}). Lösche eine Maschine oder wechsle den Tarif."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All {limit} machines of the {plan} plan are in use ({used}). Delete a machine or upgrade the plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las {limit} máquinas del plan {plan} están en uso ({used}). Elimina una máquina o mejora el plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les {limit} machines du forfait {plan} sont utilisées ({used}). Supprimez une machine ou changez de forfait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tutte le {limit} macchine del piano {plan} sono in uso ({used}). Elimina una macchina o aggiorna il piano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{plan} プランの {limit} 台をすべて使用中です（{used}）。マシンを削除するか、プランをアップグレードしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ម៉ាស៊ីនទាំង {limit} នៃគម្រោង {plan} កំពុងប្រើ ({used})។ លុបម៉ាស៊ីនមួយ ឬដំឡើងគម្រោង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{plan} 요금제의 머신 {limit}대를 모두 사용 중입니다({used}). 머신을 삭제하거나 요금제를 업그레이드하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle {limit} maskiner på {plan}-abonnementet er i bruk ({used}). Slett en maskin eller oppgrader abonnementet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wszystkie {limit} maszyn planu {plan} są w użyciu ({used}). Usuń maszynę lub zmień plan na wyższy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todas as {limit} máquinas do plano {plan} estão em uso ({used}). Exclua uma máquina ou faça upgrade do plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Все {limit} машин тарифа {plan} заняты ({used}). Удалите машину или повысьте тариф."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ใช้เครื่องครบทั้ง {limit} เครื่องของแพ็กเกจ {plan} แล้ว ({used}) ลบเครื่องหรืออัปเกรดแพ็กเกจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{plan} planının {limit} makinesinin tümü kullanımda ({used}). Bir makineyi silin veya planı yükseltin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Усі {limit} машин тарифу {plan} зайняті ({used}). Видаліть машину або підвищте тариф."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã dùng hết {limit} máy của gói {plan} ({used}). Hãy xóa một máy hoặc nâng cấp gói."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{plan} 套餐的 {limit} 台机器都在使用中（{used}）。请删除一台机器或升级套餐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{plan} 方案的 {limit} 台機器都在使用中（{used}）。請刪除一台機器或升級方案。"
          }
        }
      }
    },
