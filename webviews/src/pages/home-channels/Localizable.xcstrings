    "run.cost.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What these tokens would cost at pay-per-token API prices. A subscription doesn't bill this; it counts against the plan's usage limits."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ما ستكلفه هذه الرموز بأسعار API التي تُدفع لكل رمز. الاشتراك لا يُحاسب على ذلك، بل يُحتسب ضمن حدود استخدام الخطة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koliko bi ovi tokeni koštali po API cijenama koje se plaćaju po tokenu. Pretplata ovo ne naplaćuje; računa se u ograničenja korištenja plana."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hvad disse tokens ville koste til API-priser, hvor man betaler pr. token. Et abonnement opkræver ikke dette; det tæller med i planens forbrugsgrænser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Was diese Token zu API-Preisen pro Token kosten würden. Ein Abo rechnet das nicht ab; es zählt gegen die Nutzungslimits des Tarifs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lo que costarían estos tokens con precios de API por token. Una suscripción no cobra esto; cuenta para los límites de uso del plan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ce que coûteraient ces jetons au tarif de l'API, payé au jeton. Un abonnement ne facture pas ce montant ; il compte dans les limites d'utilisation du forfait."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quanto costerebbero questi token ai prezzi API a consumo. Un abbonamento non lo addebita; conta nei limiti di utilizzo del piano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "これらのトークンをトークン単位の API 料金で払った場合の金額です。サブスクリプションではこの金額は請求されず、プランの使用量上限に含まれます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "តម្លៃដែលថូខឹនទាំងនេះនឹងត្រូវចំណាយតាមតម្លៃ API បង់តាមថូខឹន។ ការជាវមិនគិតប្រាក់នេះទេ វារាប់ចូលក្នុងដែនកំណត់ការប្រើប្រាស់របស់គម្រោង។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 토큰을 토큰당 과금되는 API 가격으로 계산한 금액입니다. 구독에서는 청구되지 않으며 요금제 사용 한도에 포함됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hva disse tokenene ville kostet til API-priser per token. Et abonnement fakturerer ikke dette; det teller mot planens bruksgrenser."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ile kosztowałyby te tokeny według cen API płaconych za token. Subskrypcja tego nie nalicza; liczy się to do limitów użycia planu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quanto esses tokens custariam a preços de API por token. Uma assinatura não cobra isso; conta para os limites de uso do plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сколько стоили бы эти токены по ценам API с оплатой за токен. Подписка это не списывает; это идёт в лимиты использования тарифа."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ค่าใช้จ่ายของโทเค็นเหล่านี้หากคิดตามราคา API แบบจ่ายต่อโทเค็น การสมัครสมาชิกไม่เรียกเก็บส่วนนี้ แต่นับรวมในขีดจำกัดการใช้งานของแพ็กเกจ"
