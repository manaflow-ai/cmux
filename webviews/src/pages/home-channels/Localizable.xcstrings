    "chief.picture.pixels" : {
      "comment" : "Shown when a picture chosen for a Chief has too many pixels to place.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب ألا تتجاوز دقة الصورة 50 ميغابكسل."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slika smije imati najviše 50 megapiksela."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billedet må højst være på 50 megapixel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Bild darf höchstens 50 Megapixel haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The image must be 50 megapixels or fewer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La imagen debe tener 50 megapíxeles o menos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’image doit faire 50 mégapixels au maximum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’immagine deve avere al massimo 50 megapixel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像は 5,000 万画素以下にしてください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "រូបភាពត្រូវមានមិនលើស 50 មេហ្គាភីកសែល។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지는 5,000만 화소 이하여야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildet kan ha høyst 50 megapiksler."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obraz może mieć najwyżej 50 megapikseli."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A imagem deve ter no máximo 50 megapixels."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изображение должно быть не больше 50 мегапикселей."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รูปภาพต้องมีไม่เกิน 50 ล้านพิกเซล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görsel en fazla 50 megapiksel olmalıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зображення має бути не більше 50 мегапікселів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hình ảnh phải có tối đa 50 megapixel."
