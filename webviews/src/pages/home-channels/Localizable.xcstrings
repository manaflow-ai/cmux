    "sheet.newChief.lead" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Chief runs work for you and answers in its own messages."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يدير Chief العمل نيابةً عنك ويرد في رسائله."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief radi posao za vas i odgovara u svojim porukama."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En Chief udfører arbejde for dig og svarer i sine egne beskeder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein Chief erledigt Arbeit für dich und antwortet in seinen eigenen Nachrichten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un Chief trabaja por ti y responde en sus propios mensajes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un Chief travaille pour vous et répond dans ses propres messages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un Chief lavora per te e risponde nei suoi messaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief はあなたの代わりに作業し、自分のメッセージで返信します。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief ធ្វើការងារជំនួសអ្នក ហើយឆ្លើយក្នុងសាររបស់វា។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief는 당신을 위해 일하고 자신의 메시지로 답합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En Chief gjør arbeid for deg og svarer i sine egne meldinger."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief wykonuje pracę za Ciebie i odpowiada we własnych wiadomościach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um Chief trabalha por você e responde nas próprias mensagens."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief выполняет работу за вас и отвечает в своих сообщениях."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief ทำงานแทนคุณและตอบในข้อความของตัวเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
