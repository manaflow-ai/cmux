    "sheet.archive.lead" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Chief stops and is removed for good, with its memory and settings. You can’t undo this."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يتوقف Chief ويُزال نهائيًا مع ذاكرته وإعداداته. لا يمكن التراجع عن ذلك."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief se zaustavlja i trajno uklanja, zajedno s memorijom i postavkama. Ovo se ne može poništiti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief stopper og fjernes for altid sammen med sin hukommelse og sine indstillinger. Det kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Chief wird angehalten und mit seinem Gedächtnis und seinen Einstellungen endgültig entfernt. Das lässt sich nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El Chief se detiene y se elimina para siempre, con su memoria y sus ajustes. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le Chief s’arrête et est supprimé définitivement, avec sa mémoire et ses réglages. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il Chief si ferma e viene rimosso per sempre, con la sua memoria e le sue impostazioni. Non è possibile annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chiefは停止し、メモリと設定ごと完全に削除されます。この操作は取り消せません。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief ឈប់ ហើយត្រូវបានលុបជាអចិន្ត្រៃយ៍ រួមទាំងការចងចាំ និងការកំណត់របស់វា។ អ្នកមិនអាចមិនធ្វើវិញបានទេ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief가 중지되고 메모리와 설정과 함께 영구적으로 제거됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief stopper og fjernes for godt, med minne og innstillinger. Dette kan ikke angres."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief zatrzymuje się i zostaje trwale usunięty wraz z pamięcią i ustawieniami. Tego nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Chief para e é removido para sempre, com sua memória e seus ajustes. Não é possível desfazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief остановится и будет удалён навсегда вместе с памятью и настройками. Это нельзя отменить."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief จะหยุดและถูกลบถาวร พร้อมความจำและการตั้งค่า เลิกทำไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief durur ve belleği ile ayarlarıyla birlikte kalıcı olarak kaldırılır. Bu geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief зупиниться й буде видалений назавжди разом із пам’яттю та налаштуваннями. Це не можна скасувати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief dừng lại và bị xóa vĩnh viễn cùng bộ nhớ và cài đặt. Không thể hoàn tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief 会停止,并连同其记忆和设置被永久移除。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief 會停止,並連同其記憶與設定被永久移除。此動作無法復原。"
          }
        }
      }
    },
