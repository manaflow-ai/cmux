            "state": "translated",
            "value": "この差分を表示できませんでした。パッチの入力を確認してもう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចបង្ហាញភាពខុសគ្នានេះបានទេ។ ពិនិត្យបំណះហើយព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 변경 사항을 렌더링할 수 없습니다. 패치 입력을 확인하고 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke vise denne diffen. Kontroller patch-inndataene og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wyświetlić różnic. Sprawdź łatkę i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível exibir as diferenças. Verifique o patch e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отобразить различия. Проверьте патч и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงความแตกต่างนี้ไม่ได้ ตรวจสอบแพตช์แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu fark görüntülenemedi. Yama girdisini kontrol edip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відобразити відмінності. Перевірте патч і спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法渲染此差异。请检查补丁输入后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
