    "empty.subtitle": {
      "comment": "Help line of the code editor's empty state",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View and edit a text file. Choose a file, pick a recent one, or drop a file here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اعرض ملفًا نصيًا وعدّله. اختر ملفًا أو ملفًا حديثًا أو أفلت ملفًا هنا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pregledajte i uredite tekstualnu datoteku. Odaberite datoteku, nedavnu ili je ispustite ovdje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se og rediger en tekstfil. Vælg en fil, en nylig fil, eller slip en fil her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Textdatei ansehen und bearbeiten. Wähle eine Datei, eine zuletzt geöffnete oder lege eine hier ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ve y edita un archivo de texto. Elige un archivo, uno reciente o suelta uno aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Affichez et modifiez un fichier texte. Choisissez un fichier, un fichier récent, ou déposez-en un ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Visualizza e modifica un file di testo. Scegli un file, uno recente o trascinane uno qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストファイルを表示・編集します。ファイルを選ぶか、最近のファイルを選ぶか、ここにドロップします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មើល និងកែឯកសារអត្ថបទ។ ជ្រើសឯកសារ ឯកសារថ្មីៗ ឬទម្លាក់ឯកសារនៅទីនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "텍스트 파일을 보고 편집합니다. 파일이나 최근 파일을 선택하거나 여기에 놓으세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vis og rediger en tekstfil. Velg en fil, en nylig fil, eller slipp en fil her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przeglądaj i edytuj plik tekstowy. Wybierz plik, ostatni plik lub upuść go tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Veja e edite um arquivo de texto. Escolha um arquivo, um recente ou solte um aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Просматривайте и редактируйте текстовый файл. Выберите файл, недавний файл или перетащите его сюда."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ดูและแก้ไขไฟล์ข้อความ เลือกไฟล์ เลือกไฟล์ล่าสุด หรือวางไฟล์ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir metin dosyasını görüntüleyin ve düzenleyin. Bir dosya ya da son dosyalardan birini seçin veya buraya bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Переглядайте й редагуйте текстовий файл. Виберіть файл, недавній файл або перетягніть його сюди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xem và sửa tệp văn bản. Chọn một tệp, một tệp gần đây, hoặc thả tệp vào đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "查看和编辑文本文件。选取文件、最近的文件，或将文件拖放到此处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "檢視和編輯文字檔案。選擇檔案、最近的檔案，或將檔案拖放到此處。"
          }
        }
      }
    },
