    "agentBoard.waiting.step1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ وكيلًا في أي مساحة عمل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokrenite agenta u bilo kojem radnom prostoru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Start en agent i et vilkårligt arbejdsområde."
          }
        },
        "de": {
