            "value": "¿Activar el tablero de agentes?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer le tableau des agents ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivare la bacheca degli agenti?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントボードをオンにしますか？"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បើកក្ដារភ្នាក់ងារ?"
          }
