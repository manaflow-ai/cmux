    "agentBoard.waiting.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتفظ جلسات الوكلاء التي تبدأها من الآن بسجل، ويظهر عملها هنا مع انتهاء كل خطوة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesije agenata koje pokrenete od sada vode zapis, a njihov rad se ovdje prikazuje kako završavaju svaki korak."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentsessioner, du starter fra nu af, fører en log, og deres arbejde vises her, efterhånden som de afslutter hvert trin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab jetzt gestartete Agentensitzungen führen ein Protokoll; ihre Arbeit erscheint hier nach jedem Schritt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent sessions you start from now on keep a ledger, and their work shows here as they finish each step."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sesiones de agente que inicies a partir de ahora llevan un registro, y su trabajo aparece aquí al terminar cada paso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sessions d’agent démarrées dès maintenant tiennent un registre, et leur travail apparaît ici à chaque étape terminée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sessioni dell’agente che avvii da ora tengono un registro, e il loro lavoro compare qui al termine di ogni passaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後開始するエージェントセッションは記録を残し、各ステップを終えるたびに作業がここに表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វគ្គភ្នាក់ងារដែលអ្នកចាប់ផ្ដើមពីពេលនេះតទៅ រក្សាកំណត់ត្រា ហើយការងាររបស់វាបង្ហាញនៅទីនេះពេលបញ្ចប់ជំហាននីមួយៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제부터 시작하는 에이전트 세션은 기록을 남기며, 각 단계를 마칠 때마다 작업이 여기에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentøkter du starter fra nå av, fører en logg, og arbeidet deres vises her etter hvert som de fullfører hvert steg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesje agentów uruchomione od teraz prowadzą dziennik, a ich praca pojawia się tutaj po zakończeniu każdego kroku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As sessões de agente que você iniciar a partir de agora mantêm um registro, e o trabalho aparece aqui conforme cada etapa termina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеансы агентов, запущенные с этого момента, ведут журнал, и их работа появляется здесь по завершении каждого шага."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซสชันเอเจนต์ที่คุณเริ่มนับจากนี้จะเก็บบันทึก และงานจะปรากฏที่นี่เมื่อเสร็จแต่ละขั้นตอน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundan sonra başlattığınız ajan oturumları kayıt tutar ve çalışmaları her adımı bitirdikçe burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанси агентів, запущені відтепер, ведуть журнал, і їхня робота з’являється тут після кожного кроку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phiên tác tử bạn bắt đầu từ bây giờ sẽ ghi nhật ký, và công việc hiện ở đây khi hoàn tất mỗi bước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从现在起启动的智能体会话都会保留记录，每完成一步，其工作都会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從現在起啟動的代理程式工作階段都會保留記錄，每完成一步，其工作都會顯示在這裡。"
          }
        }
      }
    },
