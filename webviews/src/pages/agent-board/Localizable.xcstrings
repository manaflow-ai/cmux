    "agentBoard.onboard.lede": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند تشغيلها، يحتفظ كل وكيل بسجل قصير أثناء عمله: ما بناه، والقرارات التي اتخذها والخيارات التي رفضها، وكل حالة بناها (فاتح وداكن، Mac وiPhone، فارغ، تحميل، خطأ) ولقطة الشاشة أو الفيديو أو الاختبار الذي يثبت كل حالة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada je uključeno, svaki agent vodi kratak zapis dok radi: šta je napravio, koje je odluke donio i koje je opcije odbacio, svako stanje koje je napravio (svijetlo i tamno, Mac i iPhone, prazno, učitavanje, greška) i snimak ekrana, video ili test koji svako od njih dokazuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når den er slået til, fører hver agent en kort log, mens den arbejder: hvad den har bygget, de beslutninger den har truffet og de muligheder den har fravalgt, hver tilstand den har bygget (lys og mørk, Mac og iPhone, tom, indlæser, fejl) og det skærmbillede, den video eller den testkørsel, der beviser hver enkelt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn es aktiv ist, führt jeder Agent beim Arbeiten ein kurzes Protokoll: was er gebaut hat, welche Entscheidungen er getroffen und welche Optionen er verworfen hat, jeden gebauten Zustand (hell und dunkel, Mac und iPhone, leer, lädt, Fehler) und den Screenshot, das Video oder den Testlauf, der ihn belegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When it is on, each agent keeps a short ledger as it works: what it built, the decisions it made and the options it turned down, every state it built (light and dark, Mac and iPhone, empty, loading, error) and the screenshot, video or test run that proves each one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está activado, cada agente lleva un registro breve mientras trabaja: lo que construyó, las decisiones que tomó y las opciones que descartó, cada estado que construyó (claro y oscuro, Mac e iPhone, vacío, cargando, error) y la captura, el vídeo o la prueba que lo demuestra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois activé, chaque agent tient un court registre pendant son travail : ce qu’il a construit, ses décisions et les options écartées, chaque état réalisé (clair et sombre, Mac et iPhone, vide, chargement, erreur) et la capture, la vidéo ou le test qui le prouve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando è attiva, ogni agente tiene un breve registro mentre lavora: cosa ha costruito, le decisioni prese e le opzioni scartate, ogni stato realizzato (chiaro e scuro, Mac e iPhone, vuoto, caricamento, errore) e lo screenshot, il video o il test che lo dimostra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、各エージェントは作業しながら短い記録を残します。作ったもの、下した判断と見送った選択肢、作ったすべての状態（ライトとダーク、Mac と iPhone、空、読み込み中、エラー）、そしてそれぞれを証明するスクリーンショット、動画、テスト実行です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពេលបើក ភ្នាក់ងារនីមួយៗរក្សាកំណត់ត្រាខ្លីមួយពេលធ្វើការ៖ អ្វីដែលវាបានបង្កើត ការសម្រេចចិត្តដែលវាបានធ្វើ និងជម្រើសដែលវាបានបដិសេធ ស្ថានភាពនីមួយៗដែលវាបានបង្កើត (ភ្លឺ និងងងឹត Mac និង iPhone ទទេ កំពុងផ្ទុក កំហុស) និងរូបថតអេក្រង់ វីដេអូ ឬការធ្វើតេស្តដែលបញ្ជាក់ស្ថានភាពនីមួយៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 각 에이전트가 작업하면서 짧은 기록을 남깁니다. 만든 것, 내린 결정과 거절한 선택지, 만든 모든 상태(라이트와 다크, Mac과 iPhone, 비어 있음, 로딩, 오류), 그리고 각 상태를 증명하는 스크린샷, 동영상 또는 테스트 실행입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når den er på, fører hver agent en kort logg mens den jobber: hva den har bygget, beslutningene den tok og alternativene den forkastet, hver tilstand den bygget (lys og mørk, Mac og iPhone, tom, laster, feil) og skjermbildet, videoen eller testkjøringen som beviser hver av dem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy jest włączona, każdy agent prowadzi podczas pracy krótki dziennik: co zbudował, jakie decyzje podjął i jakie opcje odrzucił, każdy zbudowany stan (jasny i ciemny, Mac i iPhone, pusty, ładowanie, błąd) oraz zrzut ekranu, wideo lub test, który go potwierdza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, cada agente mantém um registro curto enquanto trabalha: o que construiu, as decisões que tomou e as opções que descartou, cada estado que construiu (claro e escuro, Mac e iPhone, vazio, carregando, erro) e a captura de tela, o vídeo ou o teste que comprova cada um."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда доска включена, каждый агент ведёт короткий журнал во время работы: что он сделал, какие решения принял и какие варианты отклонил, каждое созданное состояние (светлое и тёмное, Mac и iPhone, пусто, загрузка, ошибка) и снимок экрана, видео или тест, подтверждающие каждое из них."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปิด เอเจนต์แต่ละตัวจะเก็บบันทึกสั้นๆ ระหว่างทำงาน: สิ่งที่สร้าง การตัดสินใจและตัวเลือกที่ไม่เลือก ทุกสถานะที่สร้าง (สว่างและมืด, Mac และ iPhone, ว่าง, กำลังโหลด, ข้อผิดพลาด) และภาพหน้าจอ วิดีโอ หรือการทดสอบที่พิสูจน์แต่ละสถานะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıkken her ajan çalışırken kısa bir kayıt tutar: ne yaptığını, verdiği kararları ve reddettiği seçenekleri, yaptığı her durumu (açık ve koyu, Mac ve iPhone, boş, yükleniyor, hata) ve her birini kanıtlayan ekran görüntüsünü, videoyu veya test çalıştırmasını."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли дошку ввімкнено, кожен агент веде короткий журнал під час роботи: що він зробив, які рішення ухвалив і які варіанти відхилив, кожен створений стан (світлий і темний, Mac і iPhone, порожній, завантаження, помилка) та знімок екрана, відео чи тест, що підтверджує кожен із них."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bật, mỗi tác tử ghi một nhật ký ngắn trong lúc làm việc: những gì nó đã làm, các quyết định đã đưa ra và các lựa chọn đã bỏ, mọi trạng thái đã làm (sáng và tối, Mac và iPhone, trống, đang tải, lỗi) cùng ảnh chụp màn hình, video hoặc lần chạy kiểm thử chứng minh từng trạng thái."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，每个智能体在工作时都会保留一份简短记录：构建了什么、做了哪些决定以及放弃了哪些方案、构建的每种状态（浅色和深色、Mac 和 iPhone、空、加载中、错误），以及证明每种状态的截图、视频或测试运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，每個代理程式在工作時都會保留一份簡短記錄：建置了什麼、做了哪些決定以及放棄了哪些方案、建置的每種狀態（淺色和深色、Mac 和 iPhone、空白、載入中、錯誤），以及證明每種狀態的截圖、影片或測試執行。"
          }
        }
      }
    },
    "agentBoard.onboard.permutations.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الحالات الناقصة والمعطلة بدلًا من أن تختبئ في سجل المحادثة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stanja koja nedostaju ili su pokvarena vide se umjesto da se skrivaju u transkriptu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Manglende og defekte tilstande vises i stedet for at gemme sig i en samtalelog."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlende und defekte Zustände werden sichtbar, statt in einem Verlauf zu verschwinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing and broken states show up instead of hiding in a transcript."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los estados que faltan o fallan aparecen en lugar de esconderse en una transcripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les états manquants ou cassés apparaissent au lieu de se cacher dans une transcription."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli stati mancanti o rotti emergono invece di nascondersi in una trascrizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "欠けている状態や壊れた状態が、記録に埋もれずに表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ស្ថានភាពដែលបាត់ ឬខូច បង្ហាញឡើងជំនួសឱ្យការលាក់ក្នុងកំណត់ត្រាសន្ទនា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠지거나 깨진 상태가 대화 기록에 묻히지 않고 드러납니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Manglende og ødelagte tilstander vises i stedet for å gjemme seg i en samtalelogg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brakujące i zepsute stany są widoczne, zamiast chować się w transkrypcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estados ausentes ou quebrados aparecem em vez de se esconder em uma transcrição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостающие и сломанные состояния видны, а не прячутся в стенограмме."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สถานะที่ขาดหายหรือเสียจะปรากฏ แทนที่จะซ่อนอยู่ในบันทึกการสนทนา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksik ve bozuk durumlar bir dökümde saklanmak yerine görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відсутні та зламані стани видно, а не ховаються в стенограмі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trạng thái thiếu hoặc hỏng hiện ra thay vì ẩn trong bản ghi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺失和损坏的状态会直接显示，而不是藏在对话记录里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少和損壞的狀態會直接顯示，而不是藏在對話記錄裡。"
          }
        }
      }
    },
    "agentBoard.onboard.permutations.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل حالة، سواء تم التحقق منها أم لا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svako stanje, provjereno ili ne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver tilstand, tjekket eller ej."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Zustand, geprüft oder nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every state, checked or not."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada estado, comprobado o no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque état, vérifié ou non."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni stato, verificato o no."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認済みかどうかにかかわらず、すべての状態。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ស្ថានភាពនីមួយៗ ទោះបានពិនិត្យឬអត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인 여부와 관계없이 모든 상태."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver tilstand, sjekket eller ikke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy stan, sprawdzony czy nie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada estado, verificado ou não."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое состояние, проверено оно или нет."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกสถานะ ไม่ว่าจะตรวจแล้วหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her durum, kontrol edilmiş ya da edilmemiş."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен стан, перевірений чи ні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi trạng thái, đã kiểm tra hay chưa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每种状态，无论是否已验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每種狀態，無論是否已驗證。"
          }
        }
      }
    },
    "agentBoard.onboard.settingHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متاح أيضًا في الإعدادات › الوكلاء › الإرشادات والمهارات"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Također u Postavke › Agenti › Smjernice i vještine"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Også i Indstillinger › Agenter › Vejledning og færdigheder"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
