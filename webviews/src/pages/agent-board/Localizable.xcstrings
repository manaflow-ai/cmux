            "value": "Riga %1$@: il campo %2$@ manca o ha un valore errato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 行目：フィールド %2$@ がないか、値が正しくありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បន្ទាត់ %1$@៖ វាល %2$@ បាត់ ឬមានតម្លៃខុស។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@번째 줄: %2$@ 필드가 없거나 값이 잘못되었습니다."
          }
        },
        "nb": {
