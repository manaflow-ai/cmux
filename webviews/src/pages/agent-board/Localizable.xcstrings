{
  "sourceLanguage": "en",
  "strings": {
    "agentBoard.agent.quiet": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا كتابة في السجل خلال آخر 5 دقائق"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez upisa u zapis u posljednjih 5 minuta"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen skrivning i loggen de seneste 5 minutter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Protokolleinträge in den letzten 5 Minuten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No ledger writes in the last 5 minutes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin escrituras en el registro en los últimos 5 minutos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune écriture dans le registre ces 5 dernières minutes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna scrittura nel registro negli ultimi 5 minuti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この 5 分間は記録への書き込みがありません"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនបានសរសេរកំណត់ត្រាក្នុង 5 នាទីចុងក្រោយ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 5분 동안 기록 없음"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen skriving i loggen de siste 5 minuttene"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak wpisów w dzienniku w ciągu ostatnich 5 minut"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada escrito no registro nos últimos 5 minutos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет записей в журнал за последние 5 минут"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีการเขียนบันทึกใน 5 นาทีที่ผ่านมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 5 dakikada kayda yazılmadı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає записів у журнал за останні 5 хвилин"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không ghi nhật ký trong 5 phút qua"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去 5 分钟内没有写入记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過去 5 分鐘內沒有寫入記錄"
          }
        }
      }
    },
    "agentBoard.agent.recent": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كتب في سجله خلال آخر 5 دقائق"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisao u zapis u posljednjih 5 minuta"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Har skrevet i sin log inden for de seneste 5 minutter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hat in den letzten 5 Minuten ins Protokoll geschrieben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrote to its ledger in the last 5 minutes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribió en su registro en los últimos 5 minutos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "A écrit dans son registre ces 5 dernières minutes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha scritto nel registro negli ultimi 5 minuti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この 5 分以内に記録を書き込みました"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បានសរសេរក្នុងកំណត់ត្រាក្នុងរយៈពេល 5 នាទីចុងក្រោយ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 5분 안에 기록을 남김"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Har skrevet i loggen de siste 5 minuttene"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisał do dziennika w ciągu ostatnich 5 minut"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreveu no registro nos últimos 5 minutos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Писал в журнал за последние 5 минут"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขียนบันทึกภายใน 5 นาทีที่ผ่านมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 5 dakikada kaydına yazdı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Писав у журнал за останні 5 хвилин"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã ghi nhật ký trong 5 phút qua"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去 5 分钟内写入过记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過去 5 分鐘內寫入過記錄"
          }
        }
      }
    },
    "agentBoard.allVerified": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل الحالات هنا تم التحقق منها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svako stanje ovdje je provjereno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle tilstande her er tjekket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Zustände hier sind geprüft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every state here is verified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los estados aquí están verificados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les états ici sont vérifiés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli stati qui sono verificati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここの状態はすべて確認済みです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ស្ថានភាពទាំងអស់នៅទីនេះបានផ្ទៀងផ្ទាត់ហើយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기의 모든 상태가 확인되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle tilstandene her er sjekket."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy stan tutaj jest sprawdzony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os estados aqui estão verificados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все состояния здесь проверены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกสถานะที่นี่ตรวจแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buradaki her durum doğrulandı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі стани тут перевірено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi trạng thái ở đây đã được xác minh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里的所有状态都已验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡的所有狀態都已驗證。"
          }
        }
      }
    },
    "agentBoard.banner.needsYou": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرارات تحتاج إليك:"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odluke koje trebaju vas:"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
