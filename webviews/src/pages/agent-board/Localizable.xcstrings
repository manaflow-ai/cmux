    "agentBoard.dialog.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد تشغيل لوحة الوكلاء؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključiti ploču agenata?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå Agenttavle til?"
          }
        },
        "de": {
          "stringUnit": {
