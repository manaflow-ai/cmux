    "agentBoard.cost.scope": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينطبق على جلسات الوكلاء التي تبدأ بعد تشغيلها. لا تتغير الجلسات الجارية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Važi za sesije agenata pokrenute nakon uključivanja. Sesije koje su u toku se ne mijenjaju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gælder agentsessioner, der startes, efter du slår det til. Kørende sessioner ændres ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gilt für Agentensitzungen, die nach dem Einschalten starten. Laufende Sitzungen bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It applies to agent sessions started after you turn it on. Running sessions are not changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a las sesiones de agente iniciadas después de activarlo. Las sesiones en curso no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela s’applique aux sessions d’agent démarrées après l’activation. Les sessions en cours ne changent pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale per le sessioni dell’agente avviate dopo l’attivazione. Le sessioni in corso non cambiano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにした後に開始したエージェントセッションに適用されます。実行中のセッションは変わりません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វាអនុវត្តចំពោះវគ្គភ្នាក់ងារដែលចាប់ផ្ដើមបន្ទាប់ពីអ្នកបើក។ វគ្គដែលកំពុងដំណើរការមិនផ្លាស់ប្ដូរទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켠 뒤 시작한 에이전트 세션에만 적용됩니다. 실행 중인 세션은 바뀌지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gjelder agentøkter som startes etter at du slår det på. Økter som kjører, endres ikke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotyczy sesji agentów uruchomionych po włączeniu. Trwające sesje się nie zmieniają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale para sessões de agente iniciadas depois que você ativar. Sessões em andamento não mudam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действует для сеансов агентов, запущенных после включения. Текущие сеансы не меняются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีผลกับเซสชันเอเจนต์ที่เริ่มหลังจากเปิด เซสชันที่กำลังทำงานจะไม่เปลี่ยน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açtıktan sonra başlatılan ajan oturumlarına uygulanır. Çalışan oturumlar değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Діє для сеансів агентів, запущених після ввімкнення. Поточні сеанси не змінюються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng cho các phiên tác tử bắt đầu sau khi bạn bật. Các phiên đang chạy không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅适用于开启后启动的智能体会话。正在运行的会话不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅適用於開啟後啟動的代理程式工作階段。執行中的工作階段不受影響。"
          }
        }
      }
    },
    "agentBoard.cost.skill.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُدرجها Claude Code في كل دور (نحو 110 رموز)، ويقرأ كل وكيل قواعدها مرة في كل جلسة (نحو 1200 رمز)."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code je navodi u svakom potezu (oko 110 tokena), a svaki agent čita njena pravila jednom po sesiji (oko 1.200 tokena)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code viser den i hver tur (ca. 110 tokens), og hver agent læser dens regler én gang pr. session (ca. 1.200 tokens)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code listet sie in jedem Zug auf (etwa 110 Tokens), und jeder Agent liest ihre Regeln einmal pro Sitzung (etwa 1.200 Tokens)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code lists it on every turn (about 110 tokens), and each agent reads its rules once per session (about 1,200 tokens)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code la incluye en cada turno (unos 110 tokens) y cada agente lee sus reglas una vez por sesión (unos 1200 tokens)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code la liste à chaque tour (environ 110 jetons) et chaque agent lit ses règles une fois par session (environ 1 200 jetons)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code la elenca a ogni turno (circa 110 token) e ogni agente ne legge le regole una volta per sessione (circa 1.200 token)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code は毎ターンこれを一覧に含め（約 110 トークン）、各エージェントはセッションごとに一度ルールを読みます（約 1,200 トークン）。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code រាយវានៅរៀងរាល់វេន (ប្រហែល 110 token) ហើយភ្នាក់ងារនីមួយៗអានច្បាប់របស់វាម្ដងក្នុងមួយវគ្គ (ប្រហែល 1,200 token)។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code가 매 턴마다 목록에 넣고(약 110 토큰), 각 에이전트는 세션마다 한 번 규칙을 읽습니다(약 1,200 토큰)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code lister den i hver tur (omtrent 110 tokens), og hver agent leser reglene én gang per økt (omtrent 1 200 tokens)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code wymienia ją w każdej turze (ok. 110 tokenów), a każdy agent czyta jej zasady raz na sesję (ok. 1200 tokenów)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Claude Code a lista a cada turno (cerca de 110 tokens), e cada agente lê suas regras uma vez por sessão (cerca de 1.200 tokens)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code указывает его в каждом ходе (около 110 токенов), а каждый агент читает его правила один раз за сеанс (около 1200 токенов)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code แสดงทักษะนี้ในทุกตา (ประมาณ 110 โทเค็น) และเอเจนต์แต่ละตัวอ่านกฎหนึ่งครั้งต่อเซสชัน (ประมาณ 1,200 โทเค็น)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code bunu her turda listeler (yaklaşık 110 token) ve her ajan kurallarını oturum başına bir kez okur (yaklaşık 1.200 token)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code вказує її в кожному ході (близько 110 токенів), а кожен агент читає її правила раз за сеанс (близько 1200 токенів)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code liệt kê nó ở mỗi lượt (khoảng 110 token), và mỗi tác tử đọc quy tắc một lần mỗi phiên (khoảng 1.200 token)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code 每一轮都会列出它（约 110 个 token），每个智能体每次会话读取一次其规则（约 1,200 个 token）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code 每一輪都會列出它（約 110 個 token），每個代理程式每個工作階段讀取一次其規則（約 1,200 個 token）。"
          }
        }
      }
    },
    "agentBoard.cost.skill.title": {
      "extractionState": "manual",
      "localizations": {
