    "agentBoard.cost.work.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف الوكيل سطرًا إلى السجل بعد كل خطوة ويلتقط دليلًا لكل حالة يبنيها. لقطات الشاشة والتسجيلات واستدعاءات الأدوات الخاصة بها هي التكلفة الأكبر: غالبًا 5 إلى 15% رموز أكثر في مهمة واجهة، وأقل في مهام الخادم."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent dodaje red u zapis nakon svakog koraka i bilježi dokaz za svako stanje koje napravi. Snimci ekrana, snimke i njihovi pozivi alata su veći trošak: često 5 do 15% više tokena na UI zadatku, manje na backend zadatku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten tilføjer en loglinje efter hvert trin og gemmer beviser for hver tilstand, den bygger. Skærmbilleder, optagelser og deres værktøjskald er den største udgift: ofte 5 til 15 % flere tokens på en UI-opgave, mindre på en backend-opgave."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent ergänzt nach jedem Schritt eine Protokollzeile und sichert Nachweise für jeden gebauten Zustand. Screenshots, Aufnahmen und ihre Tool-Aufrufe sind der größere Teil: oft 5 bis 15 % mehr Tokens bei einer UI-Aufgabe, weniger bei Backend-Arbeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent appends a ledger line after each step and captures evidence for each state it builds. Screenshots, recordings and their tool calls are the larger cost: often 5 to 15% more tokens on a UI task, less on a backend one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente añade una línea al registro tras cada paso y captura pruebas de cada estado que construye. Las capturas, grabaciones y sus llamadas a herramientas son el mayor coste: a menudo entre un 5 y un 15 % más de tokens en una tarea de interfaz, menos en una de backend."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agent ajoute une ligne au registre après chaque étape et capture une preuve pour chaque état réalisé. Les captures, enregistrements et appels d’outils associés coûtent le plus : souvent 5 à 15 % de jetons en plus pour une tâche d’interface, moins pour le backend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agente aggiunge una riga al registro dopo ogni passaggio e raccoglie prove per ogni stato che costruisce. Screenshot, registrazioni e relative chiamate agli strumenti sono il costo maggiore: spesso dal 5 al 15% di token in più su un’attività di interfaccia, meno su una di backend."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントは各ステップの後に記録を 1 行追加し、作った状態ごとに証拠を残します。スクリーンショットや録画とそのツール呼び出しが主なコストで、UI の作業では多くの場合トークンが 5〜15% 増え、バックエンドではそれより少なくなります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្នាក់ងារបន្ថែមបន្ទាត់កំណត់ត្រាមួយបន្ទាប់ពីជំហាននីមួយៗ ហើយថតភស្តុតាងសម្រាប់ស្ថានភាពនីមួយៗដែលវាបង្កើត។ រូបថតអេក្រង់ ការថត និងការហៅឧបករណ៍របស់វាជាចំណាយធំជាង៖ ជាញឹកញាប់ token ច្រើនជាង 5 ទៅ 15% លើកិច្ចការ UI និងតិចជាងលើកិច្ចការ backend។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트는 각 단계 후 기록 한 줄을 추가하고 만든 상태마다 증거를 남깁니다. 스크린샷, 녹화와 그 도구 호출이 주된 비용으로, UI 작업에서는 보통 토큰이 5~15% 더 들고 백엔드 작업에서는 더 적습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten legger til en logglinje etter hvert steg og tar bevis for hver tilstand den bygger. Skjermbilder, opptak og verktøykallene deres er den største kostnaden: ofte 5 til 15 % flere tokens på en UI-oppgave, mindre på en backend-oppgave."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent dopisuje wiersz dziennika po każdym kroku i zbiera dowody dla każdego zbudowanego stanu. Zrzuty ekranu, nagrania i ich wywołania narzędzi to większy koszt: często 5–15% więcej tokenów przy zadaniu interfejsu, mniej przy zadaniu backendowym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O agente adiciona uma linha ao registro após cada etapa e captura evidências para cada estado que constrói. Capturas de tela, gravações e suas chamadas de ferramentas são o custo maior: muitas vezes 5 a 15% mais tokens em uma tarefa de interface, menos em uma de backend."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После каждого шага агент добавляет строку в журнал и сохраняет доказательство для каждого созданного состояния. Снимки экрана, записи и вызовы инструментов для них — основная статья расходов: часто на 5–15% больше токенов в задаче интерфейса, меньше в задаче бэкенда."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์จะเพิ่มบรรทัดบันทึกหลังทุกขั้นตอน และเก็บหลักฐานสำหรับทุกสถานะที่สร้าง ภาพหน้าจอ การบันทึก และการเรียกเครื่องมือเป็นต้นทุนหลัก: งาน UI มักใช้โทเค็นมากขึ้น 5 ถึง 15% งานแบ็กเอนด์ใช้น้อยกว่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajan her adımdan sonra bir kayıt satırı ekler ve yaptığı her durum için kanıt alır. Ekran görüntüleri, kayıtlar ve bunların araç çağrıları asıl maliyettir: bir UI görevinde çoğu zaman yüzde 5 ila 15 daha fazla token, arka uç görevinde daha az."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після кожного кроку агент додає рядок до журналу й зберігає доказ для кожного створеного стану. Знімки екрана, записи та їхні виклики інструментів — основна стаття витрат: часто на 5–15% більше токенів у завданні інтерфейсу, менше в завданні бекенду."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác tử thêm một dòng nhật ký sau mỗi bước và lưu bằng chứng cho mỗi trạng thái nó làm. Ảnh chụp màn hình, bản ghi hình và các lệnh gọi công cụ là chi phí lớn hơn: thường thêm 5 đến 15% token cho tác vụ giao diện, ít hơn cho tác vụ backend."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体每完成一步都会追加一行记录，并为构建的每种状态截取证据。截图、录屏及其工具调用是主要开销：界面任务通常多用 5% 到 15% 的 token，后端任务更少。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理程式每完成一步都會追加一行記錄，並為建置的每種狀態擷取證據。截圖、錄影及其工具呼叫是主要開銷：介面任務通常多用 5% 到 15% 的 token，後端任務更少。"
          }
        }
      }
    },
