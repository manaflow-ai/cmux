          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рядок %1$@: поле %2$@ відсутнє або має неправильне значення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dòng %1$@: trường %2$@ bị thiếu hoặc có giá trị sai."
          }
        },
