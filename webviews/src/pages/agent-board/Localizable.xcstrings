        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiersz %1$@: pole %2$@ jest puste lub ma złą wartość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Linha %1$@: o campo %2$@ está ausente ou tem um valor errado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строка %1$@: поле %2$@ отсутствует или имеет неверное значение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บรรทัด %1$@: ฟิลด์ %2$@ ขาดหายหรือมีค่าไม่ถูกต้อง"
          }
        },
        "tr": {
          "stringUnit": {
