    "agentBoard.onboard.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاهد كل ما بناه وكلاؤك مع الإثبات"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogledajte sve što su vaši agenti napravili, s dokazima"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se alt, dine agenter har bygget, med beviser"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles sehen, was Ihre Agenten gebaut haben – mit Nachweis"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See everything your agents built, with the proof"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira todo lo que construyeron tus agentes, con pruebas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez tout ce que vos agents ont construit, preuves à l’appui"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tutto ciò che hanno costruito i tuoi agenti, con le prove"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが作ったものすべてを証拠とともに確認"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មើលអ្វីៗទាំងអស់ដែលភ្នាក់ងាររបស់អ្នកបានបង្កើត ព្រមទាំងភស្តុតាង"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 만든 모든 것을 증거와 함께 확인하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se alt agentene dine har bygget, med bevis"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz wszystko, co zbudowali twoi agenci, wraz z dowodami"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja tudo o que seus agentes construíram, com provas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрите всё, что сделали ваши агенты, с доказательствами"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูทุกอย่างที่เอเจนต์ของคุณสร้าง พร้อมหลักฐาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanlarınızın yaptığı her şeyi kanıtıyla görün"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бачте все, що зробили ваші агенти, з доказами"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem mọi thứ tác tử đã làm, kèm bằng chứng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看智能体构建的一切及其证据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看代理程式建置的一切及其證據"
          }
        }
      }
    },
    "agentBoard.problems.field": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السطر %1$@: الحقل %2$@ مفقود أو قيمته غير صحيحة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Red %1$@: polje %2$@ nedostaje ili ima pogrešnu vrijednost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Linje %1$@: feltet %2$@ mangler eller har en forkert værdi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeile %1$@: Das Feld %2$@ fehlt oder hat einen falschen Wert."
