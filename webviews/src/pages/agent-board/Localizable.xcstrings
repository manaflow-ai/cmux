    "agentBoard.onboard.decisions.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض كل مفترق ما اختير وما رُفض، ويُبرز ما يجب أن تقرره أنت وحدك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka raskrsnica pokazuje šta je izabrano, a šta odbačeno, i označava one koje samo vi trebate odlučiti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert valg viser, hvad der blev valgt og fravalgt, og markerer dem, kun du bør beslutte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Weggabelung zeigt, was gewählt und was verworfen wurde, und markiert die, die nur Sie entscheiden sollten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each fork lists what was chosen and what was rejected, and flags the ones only you should decide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada bifurcación muestra lo elegido y lo descartado, y marca las que solo tú deberías decidir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque choix indique l’option retenue et celles écartées, et signale ceux que vous seul devez trancher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni bivio mostra cosa è stato scelto e cosa scartato, e segnala quelli che dovresti decidere solo tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分岐ごとに選んだものと見送ったものを示し、あなたが決めるべきものに印を付けます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្លូវបំបែកនីមួយៗបង្ហាញអ្វីដែលបានជ្រើស និងអ្វីដែលបានបដិសេធ ហើយសម្គាល់អ្វីដែលមានតែអ្នកគួរសម្រេច។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "갈림길마다 선택한 것과 거절한 것을 보여 주고, 직접 결정해야 할 것을 표시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert veivalg viser hva som ble valgt og forkastet, og markerer dem bare du bør avgjøre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde rozwidlenie pokazuje, co wybrano, a co odrzucono, i oznacza te, o których powinieneś zdecydować tylko ty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada bifurcação mostra o que foi escolhido e o que foi descartado, e marca as que só você deve decidir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая развилка показывает, что выбрано и что отклонено, и отмечает те, что решать только вам."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกทางแยกแสดงสิ่งที่เลือกและสิ่งที่ไม่เลือก และทำเครื่องหมายสิ่งที่คุณควรตัดสินใจเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her yol ayrımı neyin seçilip neyin reddedildiğini gösterir ve yalnızca sizin karar vermeniz gerekenleri işaretler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожне роздоріжжя показує, що обрано і що відхилено, та позначає ті, що маєте вирішити лише ви."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi ngã rẽ cho thấy lựa chọn đã chọn và đã bỏ, đồng thời đánh dấu những gì chỉ bạn nên quyết định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个分岔都列出所选和所弃的方案，并标出只应由你决定的部分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個分岔都列出所選和所棄的方案，並標出只應由你決定的部分。"
          }
        }
      }
    },
