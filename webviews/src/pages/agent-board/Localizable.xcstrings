    "agentBoard.dialog.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحصل جلسات الوكلاء الجديدة على مهارة work-tracking وتستهلك رموزًا أكثر لتسجيل عملها والتقاط الأدلة. تبقى الجلسات الجارية كما هي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nove sesije agenata dobijaju vještinu work-tracking i troše više tokena na bilježenje rada i dokaze. Sesije koje su već u toku ostaju kakve jesu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nye agentsessioner får færdigheden work-tracking og bruger flere tokens på at registrere deres arbejde og gemme beviser. Sessioner, der allerede kører, forbliver som de er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Agentensitzungen erhalten die Work-Tracking-Fähigkeit und verbrauchen mehr Tokens für Protokoll und Nachweise. Bereits laufende Sitzungen bleiben, wie sie sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New agent sessions get the work-tracking skill and spend more tokens recording their work and capturing evidence. Sessions already running stay as they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las nuevas sesiones de agente reciben la habilidad work-tracking y gastan más tokens en registrar su trabajo y capturar pruebas. Las sesiones en curso no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouvelles sessions d’agent reçoivent la compétence work-tracking et consomment plus de jetons pour consigner leur travail et capturer des preuves. Les sessions en cours restent inchangées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nuove sessioni dell’agente ricevono la competenza work-tracking e spendono più token per registrare il lavoro e raccogliere prove. Le sessioni già in corso restano come sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいエージェントセッションは work-tracking スキルを受け取り、作業の記録と証拠の取得により多くのトークンを使います。実行中のセッションはそのままです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វគ្គភ្នាក់ងារថ្មីទទួលបានជំនាញ work-tracking ហើយចំណាយ token ច្រើនជាងដើម្បីកត់ត្រាការងារ និងថតភស្តុតាង។ វគ្គដែលកំពុងដំណើរការនៅដដែល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 에이전트 세션은 work-tracking 스킬을 받아 작업을 기록하고 증거를 남기는 데 토큰을 더 씁니다. 이미 실행 중인 세션은 그대로입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nye agentøkter får ferdigheten work-tracking og bruker flere tokens på å registrere arbeidet og ta bevis. Økter som allerede kjører, forblir som de er."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowe sesje agentów otrzymują umiejętność work-tracking i zużywają więcej tokenów na zapisywanie pracy i zbieranie dowodów. Sesje już trwające pozostają bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Novas sessões de agente recebem a habilidade work-tracking e gastam mais tokens registrando o trabalho e capturando evidências. Sessões já em andamento continuam como estão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые сеансы агентов получают навык work-tracking и тратят больше токенов на запись работы и сбор доказательств. Уже запущенные сеансы остаются как есть."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซสชันเอเจนต์ใหม่จะได้ทักษะ work-tracking และใช้โทเค็นมากขึ้นในการบันทึกงานและเก็บหลักฐาน เซสชันที่ทำงานอยู่แล้วจะคงเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni ajan oturumları work-tracking becerisini alır ve çalışmalarını kaydetmek ve kanıt almak için daha fazla token harcar. Zaten çalışan oturumlar olduğu gibi kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нові сеанси агентів отримують навичку work-tracking і витрачають більше токенів на записування роботи й збирання доказів. Уже запущені сеанси залишаються як є."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên tác tử mới nhận kỹ năng work-tracking và tốn nhiều token hơn để ghi lại công việc và lưu bằng chứng. Các phiên đang chạy giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新的智能体会话将获得 work-tracking 技能，并会花更多 token 记录工作和截取证据。已在运行的会话保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新的代理程式工作階段將取得 work-tracking 技能，並會花更多 token 記錄工作和擷取證據。已在執行的工作階段保持不變。"
          }
        }
      }
    },
