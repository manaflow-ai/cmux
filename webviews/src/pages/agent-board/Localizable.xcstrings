    "agentBoard.viewer.imageFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة الصورة. ربما نُقلت أو حُذفت."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slika nije mogla biti pročitana. Možda je premještena ili obrisana."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billedet kunne ikke læses. Det er måske flyttet eller slettet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild konnte nicht gelesen werden. Es wurde vielleicht verschoben oder gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image could not be read. It may have been moved or deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la imagen. Puede que se haya movido o eliminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire l’image. Elle a peut-être été déplacée ou supprimée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere l’immagine. Potrebbe essere stata spostata o eliminata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像を読み込めませんでした。移動または削除された可能性があります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចអានរូបភាពបានទេ។ វាអាចត្រូវបានផ្លាស់ទី ឬលុប។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 읽을 수 없습니다. 옮겨졌거나 삭제되었을 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildet kunne ikke leses. Det kan ha blitt flyttet eller slettet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać obrazu. Mógł zostać przeniesiony lub usunięty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a imagem. Ela pode ter sido movida ou apagada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать изображение. Возможно, его переместили или удалили."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านรูปภาพไม่ได้ อาจถูกย้ายหรือลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görsel okunamadı. Taşınmış veya silinmiş olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати зображення. Можливо, його переміщено або видалено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc hình ảnh. Có thể nó đã bị di chuyển hoặc xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取图片，它可能已被移动或删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取圖片，它可能已被移動或刪除。"
          }
        }
      }
    },
