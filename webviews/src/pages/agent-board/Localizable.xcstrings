    "agentBoard.viewer.stale": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التُقط في التزام أقدم من أحدث دليل"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snimljeno na starijem commitu od najnovijeg dokaza"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Taget på et ældre commit end det nyeste bevis"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An einem älteren Commit als der neueste Nachweis aufgenommen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taken at an older commit than the newest evidence"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomada en un commit anterior a la prueba más reciente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pris sur un commit plus ancien que la preuve la plus récente"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquisito su un commit più vecchio della prova più recente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新の証拠より古いコミットで取得されました"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ថតនៅ commit ចាស់ជាងភស្តុតាងថ្មីបំផុត"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신 증거보다 오래된 커밋에서 찍었습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatt på en eldre commit enn det nyeste beviset"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykonano na starszym commicie niż najnowszy dowód"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturado em um commit mais antigo que a evidência mais recente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снято на более старом коммите, чем самое новое доказательство"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ่ายที่ commit ที่เก่ากว่าหลักฐานล่าสุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En yeni kanıttan daha eski bir commit'te alındı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знято на старішому коміті, ніж найновіший доказ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chụp ở commit cũ hơn bằng chứng mới nhất"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄时的提交早于最新证据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擷取時的提交早於最新證據"
          }
        }
      }
    },
    "agentBoard.viewer.tooLarge": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الصورة كبيرة جدًا لعرضها هنا. افتحها بدلًا من ذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova slika je prevelika za prikaz ovdje. Umjesto toga je otvorite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billedet er for stort til at blive vist her. Åbn det i stedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Bild ist zu groß für die Vorschau. Öffnen Sie es stattdessen."
