        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Línea %1$@: el campo %2$@ falta o tiene un valor incorrecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligne %1$@ : le champ %2$@ est absent ou a une valeur incorrecte."
