        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Também em Ajustes › Agentes › Orientação e habilidades"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Также в Настройки › Агенты › Указания и навыки"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับได้ใน การตั้งค่า › เอเจนต์ › คำแนะนำและทักษะ ด้วย"
