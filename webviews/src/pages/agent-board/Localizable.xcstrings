        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aussi dans Réglages › Agents › Consignes et compétences"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche in Impostazioni › Agenti › Indicazioni e competenze"
          }
        },
        "ja": {
          "stringUnit": {
