            "state": "translated",
            "value": "เพิ่มทักษะหนึ่งอย่างในทุกเซสชันของเอเจนต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ajan oturumunda bir beceri daha."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На одну навичку більше в кожному сеансі агента."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm một kỹ năng trong mỗi phiên tác tử."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
