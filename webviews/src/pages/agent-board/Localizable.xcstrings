    },
    "agentBoard.onboard.evidence.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقطات شاشة وفيديوهات واختبارات وبُنى، كلٌّ مع الالتزام الذي يثبته؛ وتُعلَّم القديمة بأنها متقادمة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snimci ekrana, videi, testovi i buildovi, svaki s commitom koji dokazuje; stariji su označeni kao zastarjeli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skærmbilleder, videoer, tests og builds, hver med det commit, de beviser; ældre markeres som forældede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshots, Videos, Tests und Builds, jeweils mit dem belegten Commit; ältere werden als veraltet markiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshots, videos, tests and builds, each with the commit it proves; older ones are marked stale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturas, vídeos, pruebas y compilaciones, cada uno con el commit que demuestra; los antiguos se marcan como obsoletos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Captures, vidéos, tests et builds, chacun avec le commit qu’il prouve ; les plus anciens sont marqués comme périmés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshot, video, test e build, ciascuno con il commit che dimostra; quelli più vecchi sono segnati come superati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショット、動画、テスト、ビルドにはそれぞれ証明するコミットが付き、古いものは古いと表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រូបថតអេក្រង់ វីដេអូ តេស្ត និង build នីមួយៗមាន commit ដែលវាបញ្ជាក់ ហើយអ្វីដែលចាស់ត្រូវសម្គាល់ថាហួសសម័យ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린샷, 동영상, 테스트, 빌드마다 증명하는 커밋이 표시되고, 오래된 것은 지난 것으로 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjermbilder, videoer, tester og bygg, hver med commiten de beviser; eldre merkes som utdaterte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrzuty ekranu, filmy, testy i buildy, każdy z commitem, który potwierdza; starsze są oznaczone jako nieaktualne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturas de tela, vídeos, testes e builds, cada um com o commit que comprova; os mais antigos são marcados como desatualizados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимки экрана, видео, тесты и сборки, каждый с коммитом, который он подтверждает; старые помечаются как устаревшие."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพหน้าจอ วิดีโอ การทดสอบ และบิลด์ แต่ละรายการมี commit ที่พิสูจน์ ส่วนที่เก่ากว่าจะถูกทำเครื่องหมายว่าล้าสมัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran görüntüleri, videolar, testler ve derlemeler, her biri kanıtladığı commit ile; eskileri güncel değil olarak işaretlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знімки екрана, відео, тести й збірки, кожен із комітом, який він підтверджує; старіші позначено як застарілі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh chụp màn hình, video, kiểm thử và bản dựng, mỗi thứ kèm commit nó chứng minh; cái cũ hơn được đánh dấu là cũ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图、视频、测试和构建，各自附带所证明的提交；较旧的会标为过时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "截圖、影片、測試和建置，各自附帶所證明的提交；較舊的會標為過時。"
          }
        }
      }
    },
