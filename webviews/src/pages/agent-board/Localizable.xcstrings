    "agentBoard.waiting.step2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل كل قدرة وقرار وحالة مع الدليل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilježi svaku mogućnost, odluku i stanje, s dokazima."
