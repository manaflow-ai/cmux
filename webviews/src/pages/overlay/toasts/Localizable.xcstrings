          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na maszynie zabrakło miejsca na dysku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A máquina está sem espaço em disco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На машине закончилось место на диске."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เครื่องมีพื้นที่ดิสก์ไม่เพียงพอ"
          }
        },
        "tr": {
          "stringUnit": {
