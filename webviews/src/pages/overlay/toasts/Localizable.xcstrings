    "overlay.toasts.detail.noSpace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The machine is out of disk space."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Rechner ist kein Speicherplatz mehr frei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La machine n'a plus d'espace disque."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نفدت مساحة القرص على الجهاز."
          }
