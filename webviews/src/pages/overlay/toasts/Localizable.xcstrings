          "stringUnit": {
            "state": "translated",
            "value": "머신의 디스크 공간이 부족합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンのディスク容量が不足しています。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mašini je ponestalo prostora na disku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maskinen er løbet tør for diskplads."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La macchina ha esaurito lo spazio su disco."
