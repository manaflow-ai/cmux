    "overlay.toasts.detail.permissionDenied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The machine didn't allow access to that location."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
