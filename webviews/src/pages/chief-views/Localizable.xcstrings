    "chiefViews.view.everybody.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every agent and session on every machine: what it is doing, when it last spoke and its pull request."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل وكيل وجلسة على كل جهاز: ما يفعله، ومتى تحدّث آخر مرة، وطلب الدمج الخاص به."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki agent i sesija na svakoj mašini: šta radi, kada se zadnji put javio i njegov pull request."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle agenter og sessioner på alle maskiner: hvad de laver, hvornår de sidst skrev, og deres pull request."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Agent und jede Sitzung auf jedem Rechner: was er tut, wann er zuletzt etwas ausgab, und sein Pull Request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada agente y sesión en cada máquina: qué hace, cuándo habló por última vez y su pull request."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque agent et session sur chaque machine : ce qu’il fait, quand il a parlé pour la dernière fois et sa pull request."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni agente e sessione su ogni macchina: cosa fa, quando ha parlato l’ultima volta e la sua pull request."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのマシンのすべてのエージェントとセッション。何をしているか、最後の出力はいつか、そのプルリクエスト。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្នាក់ងារ និងវគ្គនីមួយៗលើម៉ាស៊ីននីមួយៗ៖ អ្វីដែលវាកំពុងធ្វើ ពេលវានិយាយចុងក្រោយ និង pull request របស់វា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 머신의 모든 에이전트와 세션: 무엇을 하는지, 마지막 출력이 언제였는지, 그리고 풀 리퀘스트."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle agenter og økter på alle maskiner: hva de gjør, når de sist skrev noe, og deres pull request."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy agent i sesja na każdej maszynie: co robi, kiedy ostatnio coś napisał i jego pull request."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada agente e sessão em cada máquina: o que está fazendo, quando falou pela última vez e seu pull request."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый агент и сеанс на каждой машине: что он делает, когда последний раз что-то вывел и его пул-реквест."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์และเซสชันทุกตัวในทุกเครื่อง: กำลังทำอะไร พูดครั้งล่าสุดเมื่อไร และ pull request ของมัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her makinedeki her ajan ve oturum: ne yaptığı, en son ne zaman çıktı verdiği ve çekme isteği."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен агент і сеанс на кожній машині: що він робить, коли востаннє щось вивів і його пул-реквест."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi tác tử và phiên trên mọi máy: đang làm gì, lần cuối lên tiếng khi nào và pull request của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每台机器上的每个智能体和会话：在做什么、上次输出是什么时候，以及它的拉取请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每台機器上的每個代理程式和工作階段：在做什麼、上次輸出是什麼時候，以及它的提取要求。"
          }
        }
      }
    },
