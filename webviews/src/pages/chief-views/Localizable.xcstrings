    "chiefViews.gallery.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental views beside the Chief. Turn one on, then open it as a pane, a split or a sidebar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عروض تجريبية بجانب Chief. فعّل عرضًا، ثم افتحه كجزء أو تقسيم أو شريط جانبي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksperimentalni prikazi pored Chiefa. Uključite jedan, pa ga otvorite kao okno, podjelu ili bočnu traku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksperimentelle visninger ved siden af Chief. Slå en til, og åbn den som rude, opdeling eller sidepanel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimentelle Ansichten neben dem Chief. Schalte eine ein und öffne sie als Bereich, Teilung oder Seitenleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vistas experimentales junto al Chief. Activa una y ábrela como panel, división o barra lateral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des vues expérimentales à côté du Chief. Activez-en une, puis ouvrez-la en volet, en partage ou en barre latérale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viste sperimentali accanto al Chief. Attivane una e aprila come riquadro, divisione o barra laterale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief の横に置く実験的なビューです。オンにして、ペイン、分割、サイドバーのいずれかで開きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ទិដ្ឋភាពពិសោធន៍នៅក្បែរ Chief។ បើកមួយ រួចបើកវាជាផ្ទាំង ការបំបែក ឬរបារចំហៀង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief 옆에 두는 실험적 보기입니다. 켜고 나서 창, 분할 또는 사이드바로 엽니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksperimentelle visninger ved siden av Chief. Slå på én, og åpne den som rute, deling eller sidepanel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksperymentalne widoki obok Chiefa. Włącz jeden, a potem otwórz go jako panel, podział lub pasek boczny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualizações experimentais ao lado do Chief. Ative uma e abra-a como painel, divisão ou barra lateral."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспериментальные представления рядом с Chief. Включите одно и откройте его как панель, разделение или боковую панель."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มุมมองทดลองข้าง Chief เปิดใช้หนึ่งมุมมอง แล้วเปิดเป็นบานหน้าต่าง แบ่งจอ หรือแถบด้านข้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief'in yanında deneysel görünümler. Birini açın, sonra bölme, bölünmüş görünüm veya kenar çubuğu olarak açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Експериментальні подання поруч із Chief. Увімкніть одне й відкрийте його як панель, поділ або бічну панель."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các chế độ xem thử nghiệm bên cạnh Chief. Bật một chế độ, rồi mở nó dưới dạng ngăn, chia đôi hoặc thanh bên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief 旁边的实验视图。打开一个，然后以窗格、分屏或边栏的方式打开它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief 旁邊的實驗檢視。開啟一個，然後以窗格、分割或側邊欄的方式開啟它。"
          }
        }
      }
    },
