    "chiefViews.landing.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull requests could not be read right now. Try Refresh in a few minutes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة طلبات الدمج الآن. جرّب التحديث بعد بضع دقائق."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull requestovi se trenutno ne mogu pročitati. Pokušajte Osvježi za nekoliko minuta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull requests kunne ikke læses lige nu. Prøv Opdater om et par minutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull Requests konnten gerade nicht gelesen werden. Versuche es in ein paar Minuten mit „Aktualisieren“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer los pull requests ahora. Prueba Actualizar en unos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire les pull requests pour l’instant. Essayez Actualiser dans quelques minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere le pull request adesso. Prova Aggiorna tra qualche minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今はプルリクエストを読み込めません。数分後に更新を試してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចអាន pull request ពេលនេះបានទេ។ សាកល្បងផ្ទុកឡើងវិញក្នុងរយៈពេលពីរបីនាទី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 풀 리퀘스트를 읽을 수 없습니다. 몇 분 후 새로 고침을 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull requests kunne ikke leses akkurat nå. Prøv Oppdater om noen minutter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się teraz odczytać pull requestów. Spróbuj Odśwież za kilka minut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler os pull requests agora. Tente Atualizar em alguns minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас не удалось прочитать пул-реквесты. Попробуйте «Обновить» через несколько минут."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่าน pull request ไม่ได้ในตอนนี้ ลองรีเฟรชอีกครั้งในอีกไม่กี่นาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çekme istekleri şu anda okunamadı. Birkaç dakika sonra Yenile'yi deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз не вдалося прочитати пул-реквести. Спробуйте «Оновити» за кілька хвилин."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện không đọc được các pull request. Hãy thử Làm mới sau vài phút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法读取拉取请求。几分钟后再试试刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法讀取提取要求。幾分鐘後再試試重新整理。"
          }
        }
      }
    },
