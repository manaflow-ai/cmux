    "chiefViews.view.fleet.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The CI machines: load, busy runners, the queue and the agents on each."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أجهزة CI: الحمل، والمشغّلات المشغولة، وقائمة الانتظار، والوكلاء على كل جهاز."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "CI mašine: opterećenje, zauzeti runneri, red čekanja i agenti na svakoj."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
