        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les machines de CI : charge, runners occupés, file d’attente et agents sur chacune."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le macchine CI: carico, runner occupati, la coda e gli agenti su ciascuna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CI マシン。負荷、使用中のランナー、キュー、各マシンのエージェント。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម៉ាស៊ីន CI៖ បន្ទុក runner ដែលរវល់ ជួររង់ចាំ និងភ្នាក់ងារលើនីមួយៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CI 머신: 부하, 사용 중인 러너, 대기열, 그리고 각 머신의 에이전트."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "CI-maskinene: belastning, opptatte runnere, køen og agentene på hver."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maszyny CI: obciążenie, zajęte runnery, kolejka i agenci na każdej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As máquinas de CI: carga, runners ocupados, a fila e os agentes em cada uma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Машины CI: нагрузка, занятые раннеры, очередь и агенты на каждой."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่อง CI: โหลด รันเนอร์ที่ไม่ว่าง คิว และเอเจนต์ในแต่ละเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CI makineleri: yük, meşgul çalıştırıcılar, kuyruk ve her birindeki ajanlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Машини CI: навантаження, зайняті ранери, черга й агенти на кожній."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các máy CI: tải, runner đang bận, hàng đợi và tác tử trên mỗi máy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CI 机器：负载、忙碌的运行器、队列以及每台机器上的智能体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CI 機器：負載、忙碌的執行器、佇列以及每台機器上的代理程式。"
          }
        }
      }
    },
