    "chiefViews.fleet.unreachable.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The CI dashboard did not answer. Check the address or try Refresh."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تستجب لوحة CI. تحقق من العنوان أو جرّب التحديث."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "CI kontrolna tabla nije odgovorila. Provjerite adresu ili pokušajte Osvježi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CI-dashboardet svarede ikke. Tjek adressen, eller prøv Opdater."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das CI-Dashboard hat nicht geantwortet. Prüfe die Adresse oder versuche „Aktualisieren“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El panel de CI no respondió. Comprueba la dirección o prueba Actualizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tableau de bord CI n’a pas répondu. Vérifiez l’adresse ou essayez Actualiser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dashboard CI non ha risposto. Controlla l’indirizzo o prova Aggiorna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CI ダッシュボードが応答しませんでした。アドレスを確認するか、更新を試してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្ទាំងគ្រប់គ្រង CI មិនបានឆ្លើយតបទេ។ ពិនិត្យអាសយដ្ឋាន ឬសាកល្បងផ្ទុកឡើងវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CI 대시보드가 응답하지 않았습니다. 주소를 확인하거나 새로 고침을 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "CI-dashbordet svarte ikke. Sjekk adressen, eller prøv Oppdater."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulpit CI nie odpowiedział. Sprawdź adres lub spróbuj Odśwież."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O painel de CI não respondeu. Verifique o endereço ou tente Atualizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель CI не ответила. Проверьте адрес или попробуйте «Обновить»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แดชบอร์ด CI ไม่ตอบสนอง ตรวจสอบที่อยู่หรือลองรีเฟรช"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CI panosu yanıt vermedi. Adresi kontrol edin veya Yenile'yi deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель CI не відповіла. Перевірте адресу або спробуйте «Оновити»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảng điều khiển CI không phản hồi. Hãy kiểm tra địa chỉ hoặc thử Làm mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CI 仪表盘没有响应。请检查地址或试试刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CI 儀表板沒有回應。請檢查位址或試試重新整理。"
          }
        }
      }
    },
