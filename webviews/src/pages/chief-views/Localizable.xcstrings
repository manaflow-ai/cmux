    "chiefViews.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open this page in cmux to see your agents."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح هذه الصفحة في cmux لترى وكلاءك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite ovu stranicu u cmuxu da vidite svoje agente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn denne side i cmux for at se dine agenter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne diese Seite in cmux, um deine Agenten zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre esta página en cmux para ver tus agentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez cette page dans cmux pour voir vos agents."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri questa pagina in cmux per vedere i tuoi agenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントを見るには cmux でこのページを開いてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បើកទំព័រនេះក្នុង cmux ដើម្បីមើលភ្នាក់ងាររបស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트를 보려면 cmux에서 이 페이지를 여세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne denne siden i cmux for å se agentene dine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz tę stronę w cmux, aby zobaczyć swoich agentów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra esta página no cmux para ver seus agentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте эту страницу в cmux, чтобы увидеть своих агентов."
