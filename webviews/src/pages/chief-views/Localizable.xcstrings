    "chiefViews.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No view is on. Open the gallery to turn one on."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد عرض مفعّل. افتح المعرض لتفعيل عرض."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nijedan prikaz nije uključen. Otvorite galeriju da uključite jedan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen visning er slået til. Åbn galleriet for at slå en til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Ansicht ist eingeschaltet. Öffne die Galerie, um eine einzuschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna vista activa. Abre la galería para activar una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune vue n’est activée. Ouvrez la galerie pour en activer une."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna vista è attiva. Apri la galleria per attivarne una."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンのビューがありません。ギャラリーを開いてオンにしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនមានទិដ្ឋភាពណាបើកទេ។ បើកវិចិត្រសាលដើម្បីបើកមួយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜진 보기가 없습니다. 갤러리를 열어 하나를 켜세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen visning er slått på. Åpne galleriet for å slå på én."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żaden widok nie jest włączony. Otwórz galerię, aby włączyć jeden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma visualização está ativa. Abra a galeria para ativar uma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни одно представление не включено. Откройте галерею, чтобы включить его."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้เปิดมุมมองใด เปิดแกลเลอรีเพื่อเปิดใช้หนึ่งมุมมอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık görünüm yok. Birini açmak için galeriyi açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жодне подання не ввімкнено. Відкрийте галерею, щоб увімкнути одне."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa bật chế độ xem nào. Mở thư viện để bật một chế độ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有打开的视图。打开画廊来打开一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有開啟的檢視。打開畫廊來開啟一個。"
          }
        }
      }
    },
