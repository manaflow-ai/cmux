    "chiefViews.view.board.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents and pull requests as cards, from working to landed today."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوكلاء وطلبات الدمج كبطاقات، من قيد العمل إلى المدموجة اليوم."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenti i pull requestovi kao kartice, od rada do spojenih danas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenter og pull requests som kort, fra i gang til landet i dag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten und Pull Requests als Karten, von „arbeitet“ bis „heute gelandet“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentes y pull requests como tarjetas, desde trabajando hasta integrados hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents et pull requests en cartes, du travail en cours à l’intégration du jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenti e pull request come schede, dal lavoro in corso a quelle integrate oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントとプルリクエストをカードで。作業中から今日のマージまで。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្នាក់ងារ និង pull request ជាកាត ចាប់ពីកំពុងធ្វើការ ដល់បានបញ្ចូលថ្ងៃនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트와 풀 리퀘스트를 카드로: 작업 중부터 오늘 반영된 것까지."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenter og pull requests som kort, fra i arbeid til landet i dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenci i pull requesty jako karty, od pracy w toku po scalone dzisiaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentes e pull requests como cartões, de em andamento a integrados hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты и пул-реквесты в виде карточек: от работающих до влитых сегодня."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์และ pull request เป็นการ์ด ตั้งแต่กำลังทำงานจนถึงรวมเข้าวันนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanlar ve çekme istekleri kart olarak: çalışıyordan bugün birleştirilene kadar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенти й пул-реквести у вигляді карток: від тих, що працюють, до влитих сьогодні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác tử và pull request dưới dạng thẻ, từ đang làm đến đã hợp nhất hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以卡片显示智能体和拉取请求，从工作中到今天已合并。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以卡片顯示代理程式和提取要求，從工作中到今天已合併。"
          }
        }
      }
    },
