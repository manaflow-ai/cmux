    "chiefViews.view.timeline.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today across every agent, newest first: started, waiting, failed, finished, opened and merged."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اليوم عبر كل الوكلاء، الأحدث أولًا: بدأ، ينتظر، فشل، انتهى، فُتح ودُمج."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Današnji dan svih agenata, najnovije prvo: pokrenuto, čeka, nije uspjelo, završeno, otvoreno i spojeno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I dag på tværs af alle agenter, nyeste først: startet, venter, mislykkedes, færdig, åbnet og landet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der heutige Tag über alle Agenten, das Neueste zuerst: gestartet, wartet, fehlgeschlagen, fertig, geöffnet und gemergt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy en todos los agentes, lo más reciente primero: iniciado, esperando, fallido, terminado, abierto e integrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La journée de tous les agents, le plus récent d’abord : démarré, en attente, échec, terminé, ouvert et intégré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La giornata di tutti gli agenti, dal più recente: avviato, in attesa, non riuscito, finito, aperto e integrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のすべてのエージェントの出来事を新しい順に。開始、待機、失敗、完了、オープン、マージ。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ថ្ងៃនេះលើភ្នាក់ងារទាំងអស់ ថ្មីបំផុតមុន៖ បានចាប់ផ្ដើម កំពុងរង់ចាំ បរាជ័យ បានបញ្ចប់ បានបើក និងបានបញ្ចូល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 모든 에이전트의 일을 최신순으로: 시작, 대기, 실패, 완료, 열림, 병합."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I dag på tvers av alle agenter, nyeste først: startet, venter, mislyktes, ferdig, åpnet og flettet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzisiaj u wszystkich agentów, od najnowszych: uruchomiono, czeka, niepowodzenie, zakończono, otwarto i scalono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje em todos os agentes, mais recentes primeiro: iniciado, esperando, falhou, concluído, aberto e integrado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня по всем агентам, сначала новое: запущен, ждёт, ошибка, закончил, открыт и влит."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้ของทุกเอเจนต์ ล่าสุดก่อน: เริ่ม รอ ล้มเหลว เสร็จ เปิด และรวม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün tüm ajanlarda, en yeni önce: başladı, bekliyor, başarısız, bitti, açıldı ve birleştirildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сьогодні за всіма агентами, спершу нове: запущено, чекає, помилка, завершено, відкрито й влито."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm nay trên mọi tác tử, mới nhất trước: bắt đầu, đang chờ, thất bại, hoàn tất, mở và hợp nhất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天所有智能体的动态，最新的在前：开始、等待、失败、完成、打开和合并。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天所有代理程式的動態，最新的在前：開始、等待、失敗、完成、開啟和合併。"
          }
        }
      }
    },
