    "chiefViews.view.landing.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull requests on their way in: open, ready to land, CI red and merged today."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلبات الدمج في طريقها: مفتوحة، وجاهزة للدمج، وCI أحمر، ومدموجة اليوم."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull requestovi na putu: otvoreni, spremni za spajanje, CI crven i spojeni danas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull requests på vej ind: åbne, klar til landing, CI rød og landet i dag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull Requests auf dem Weg hinein: offen, bereit zum Landen, CI rot und heute gemergt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull requests en camino: abiertos, listos para integrar, CI en rojo e integrados hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pull requests en route : ouvertes, prêtes à intégrer, CI en rouge et intégrées aujourd’hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull request in arrivo: aperte, pronte da integrare, CI rossa e integrate oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り込み途中のプルリクエスト。オープン、マージ待ち、CI 失敗、今日マージ済み。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "pull request កំពុងចូល៖ បើក រួចរាល់សម្រាប់បញ្ចូល CI ក្រហម និងបានបញ្ចូលថ្ងៃនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "들어오는 중인 풀 리퀘스트: 열림, 반영 준비됨, CI 실패, 오늘 병합됨."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull requests på vei inn: åpne, klare til landing, CI rød og flettet i dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull requesty w drodze: otwarte, gotowe do scalenia, CI na czerwono i scalone dzisiaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull requests a caminho: abertos, prontos para integrar, CI vermelho e integrados hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пул-реквесты на пути внутрь: открытые, готовые к вливанию, с красным CI и влитые сегодня."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "pull request ที่กำลังเข้า: เปิดอยู่ พร้อมรวม CI แดง และรวมแล้ววันนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yoldaki çekme istekleri: açık, birleştirmeye hazır, CI kırmızı ve bugün birleştirilen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пул-реквести на шляху всередину: відкриті, готові до вливання, з червоним CI і влиті сьогодні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các pull request đang vào: đang mở, sẵn sàng hợp nhất, CI đỏ và đã hợp nhất hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在合入的拉取请求：打开的、准备合入的、CI 失败的和今天已合并的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在合入的提取要求：開啟的、準備合入的、CI 失敗的和今天已合併的。"
          }
        }
      }
    },
