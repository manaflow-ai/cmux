    "chiefViews.fleet.unavailable.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name the CI dashboard to read its machines, runners and queue."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّد لوحة CI لقراءة أجهزتها ومشغّلاتها وقائمة انتظارها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Navedite CI kontrolnu tablu da biste čitali njene mašine, runnere i red čekanja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv CI-dashboardet for at læse dets maskiner, runners og kø."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib das CI-Dashboard an, um seine Rechner, Runner und Warteschlange zu lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica el panel de CI para leer sus máquinas, runners y cola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez le tableau de bord CI pour lire ses machines, runners et file d’attente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica la dashboard CI per leggerne macchine, runner e coda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシン、ランナー、キューを読み込むには CI ダッシュボードを指定してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កំណត់ផ្ទាំងគ្រប់គ្រង CI ដើម្បីអានម៉ាស៊ីន runner និងជួររបស់វា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머신, 러너, 대기열을 읽으려면 CI 대시보드를 지정하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppgi CI-dashbordet for å lese maskinene, runnerne og køen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj pulpit CI, aby odczytać jego maszyny, runnery i kolejkę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique o painel de CI para ler suas máquinas, runners e fila."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите панель CI, чтобы читать её машины, раннеры и очередь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบุแดชบอร์ด CI เพื่ออ่านเครื่อง รันเนอร์ และคิวของมัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Makinelerini, çalıştırıcılarını ve kuyruğunu okumak için CI panosunu belirtin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажіть панель CI, щоб читати її машини, ранери й чергу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chỉ định bảng điều khiển CI để đọc các máy, runner và hàng đợi của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指定 CI 仪表盘以读取其机器、运行器和队列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指定 CI 儀表板以讀取其機器、執行器和佇列。"
          }
        }
      }
    },
