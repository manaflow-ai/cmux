    "settingsPage.dictationEngine.cloud": {
      "comment": "A keyed engine's line; %@ is the provider's host name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُرسَل التسجيلات إلى %@ مع مفتاحك. يُحفظ المفتاح في سلسلة مفاتيح الـMac."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snimci se šalju na %@ s vašim ključem. Ključ se čuva u Keychainu vašeg Maca."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optagelser sendes til %@ med din nøgle. Nøglen gemmes i din Macs nøglering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahmen werden mit deinem Schlüssel an %@ gesendet. Der Schlüssel liegt im Schlüsselbund deines Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordings are sent to %@ with your key. The key is kept in your Mac's Keychain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las grabaciones se envían a %@ con tu clave. La clave se guarda en el llavero de tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements sont envoyés à %@ avec votre clé. La clé est conservée dans le trousseau de votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le registrazioni vengono inviate a %@ con la tua chiave. La chiave è conservata nel portachiavi del Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音はあなたのキーとともに %@ に送信されます。キーはMacのキーチェーンに保管されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការថតត្រូវបានផ្ញើទៅ %@ ជាមួយសោរបស់អ្នក។ សោត្រូវបានរក្សាទុកក្នុង Keychain នៃ Mac របស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음은 사용자의 키와 함께 %@(으)로 전송됩니다. 키는 Mac의 키체인에 보관됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opptak sendes til %@ med nøkkelen din. Nøkkelen oppbevares i nøkkelringen på Macen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrania są wysyłane do %@ wraz z Twoim kluczem. Klucz jest przechowywany w pęku kluczy Twojego Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As gravações são enviadas para %@ com a sua chave. A chave fica guardada nas Chaves do seu Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи отправляются на %@ вместе с вашим ключом. Ключ хранится в Связке ключей вашего Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์บันทึกเสียงจะถูกส่งไปยัง %@ พร้อมคีย์ของคุณ คีย์จะถูกเก็บไว้ในพวงกุญแจของ Mac"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlar anahtarınızla birlikte %@ adresine gönderilir. Anahtar, Mac’inizin Anahtar Zinciri’nde saklanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи надсилаються на %@ разом із вашим ключем. Ключ зберігається у Звʼязці ключів вашого Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi âm được gửi đến %@ cùng với khóa của bạn. Khóa được giữ trong Chuỗi khóa của máy Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音会连同你的密钥发送到 %@。密钥保存在你 Mac 的钥匙串中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音會連同你的金鑰傳送到 %@。金鑰保存在你 Mac 的鑰匙圈中。"
          }
        }
      }
    },
