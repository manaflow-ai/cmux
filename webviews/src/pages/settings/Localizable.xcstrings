    "settingsPage.dictationEngine.needsUrl": {
      "comment": "A custom engine with no URL yet: the key needs one.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل عنوان URL للمزوّد أعلاه لإضافة مفتاحه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite URL pružatelja iznad da dodate njegov ključ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast udbyderens URL ovenfor for at tilføje dens nøgle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib oben die URL des Anbieters ein, um seinen Schlüssel hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the provider's URL above to add its key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce arriba la URL del proveedor para añadir su clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez l’URL du fournisseur ci-dessus pour ajouter sa clé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci sopra l’URL del fornitore per aggiungere la sua chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを追加するには、上でプロバイダのURLを入力してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ចូល URL របស់អ្នកផ្តល់សេវាខាងលើ ដើម្បីបន្ថែមសោរបស់វា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 추가하려면 위에 제공자의 URL을 입력하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn leverandørens URL ovenfor for å legge til nøkkelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz powyżej URL dostawcy, aby dodać jego klucz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite a URL do provedor acima para adicionar a chave dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите URL провайдера выше, чтобы добавить его ключ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อน URL ของผู้ให้บริการด้านบนเพื่อเพิ่มคีย์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarını eklemek için sağlayıcının URL’sini yukarıya girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть URL постачальника вище, щоб додати його ключ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập URL của nhà cung cấp ở trên để thêm khóa của họ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在上方输入提供商的 URL 以添加其密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在上方輸入供應商的 URL 以加入其金鑰。"
          }
        }
      }
    },
    "settingsPage.dictationEngine.onDevice": {
      "comment": "The on-device engine's one line: what happens to speech.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحوَّل الكلام إلى نص على هذا الـMac. لا يُرسَل أي شيء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Govor se pretvara u tekst na ovom Macu. Ništa se ne šalje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tale bliver til tekst på denne Mac. Intet sendes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprache wird auf diesem Mac in Text umgewandelt. Es wird nichts gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech is turned into text on this Mac. Nothing is sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La voz se convierte en texto en este Mac. No se envía nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La parole est convertie en texte sur ce Mac. Rien n’est envoyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La voce viene trasformata in testo su questo Mac. Non viene inviato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声はこのMac上でテキストに変換されます。何も送信されません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សំឡេងត្រូវបានបំប្លែងជាអត្ថបទនៅលើ Mac នេះ។ គ្មានអ្វីត្រូវបានផ្ញើទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성은 이 Mac에서 텍스트로 변환됩니다. 아무것도 전송되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tale gjøres om til tekst på denne Macen. Ingenting sendes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mowa jest zamieniana na tekst na tym Macu. Nic nie jest wysyłane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fala é convertida em texto neste Mac. Nada é enviado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Речь превращается в текст на этом Mac. Ничего не отправляется."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงพูดจะถูกแปลงเป็นข้อความบน Mac เครื่องนี้ ไม่มีการส่งข้อมูลใดๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşma bu Mac’te metne dönüştürülür. Hiçbir şey gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мовлення перетворюється на текст на цьому Mac. Нічого не надсилається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giọng nói được chuyển thành văn bản trên máy Mac này. Không có gì được gửi đi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音在这台 Mac 上转为文字，不会发送任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音會在這部 Mac 上轉為文字，不會傳送任何內容。"
          }
        }
      }
    },
    "settingsPage.dictationEngine.removeConfirm": {
      "comment": "Asked before the saved key is removed from the Keychain.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد إزالة المفتاح المحفوظ؟ ستحتاج إلى لصقه مجددًا لاستخدام هذا المزوّد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukloniti sačuvani ključ? Morat ćete ga ponovo zalijepiti da koristite ovog pružatelja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern den gemte nøgle? Du skal indsætte den igen for at bruge denne udbyder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesicherten Schlüssel entfernen? Du musst ihn erneut einfügen, um diesen Anbieter zu nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the saved key? You'll need to paste it again to use this provider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar la clave guardada? Tendrás que pegarla de nuevo para usar este proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer la clé enregistrée ? Vous devrez la coller à nouveau pour utiliser ce fournisseur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere la chiave salvata? Dovrai incollarla di nuovo per usare questo fornitore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたキーを削除しますか？ このプロバイダを使うには、もう一度キーを貼り付ける必要があります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "លុបសោដែលបានរក្សាទុកឬ? អ្នកនឹងត្រូវបិទភ្ជាប់វាម្តងទៀត ដើម្បីប្រើអ្នកផ្តល់សេវានេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 키를 제거하겠습니까? 이 제공자를 사용하려면 키를 다시 붙여넣어야 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerne den lagrede nøkkelen? Du må lime den inn på nytt for å bruke denne leverandøren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć zapisany klucz? Aby korzystać z tego dostawcy, trzeba będzie wkleić go ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover a chave salva? Você precisará colá-la de novo para usar este provedor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить сохранённый ключ? Чтобы пользоваться этим провайдером, его нужно будет вставить снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบคีย์ที่บันทึกไว้ไหม คุณจะต้องวางคีย์อีกครั้งเพื่อใช้ผู้ให้บริการนี้"
          }
        },
        "tr": {
