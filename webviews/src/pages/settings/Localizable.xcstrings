    "settingsPage.dictationEngine.unavailable": {
      "comment": "The card could not read the engine's state (cmux's daemon did not answer).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة مزوّد الإملاء. قد لا تكون خدمة cmux في الخلفية قيد التشغيل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće pročitati pružatelja diktiranja. cmux usluga u pozadini možda nije pokrenuta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke læse dikteringsudbyderen. cmux' baggrundstjeneste kører måske ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Diktieranbieter konnte nicht gelesen werden. Der Hintergrunddienst von cmux läuft möglicherweise nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read the dictation provider. cmux's background service may not be running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el proveedor de dictado. Puede que el servicio en segundo plano de cmux no esté en ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire le fournisseur de dictée. Le service d’arrière-plan de cmux n’est peut-être pas lancé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il fornitore di dettatura. Il servizio in background di cmux potrebbe non essere in esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力プロバイダを読み込めませんでした。cmuxのバックグラウンドサービスが動作していない可能性があります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចអានអ្នកផ្តល់សេវាសរសេរតាមសំឡេងបានទេ។ សេវាផ្ទៃខាងក្រោយរបស់ cmux ប្រហែលជាមិនកំពុងដំណើរការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기 제공자를 읽을 수 없습니다. cmux의 백그라운드 서비스가 실행 중이 아닐 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke lese dikteringsleverandøren. Bakgrunnstjenesten til cmux kjører kanskje ikke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać dostawcy dyktowania. Usługa cmux działająca w tle może nie być uruchomiona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o provedor de ditado. O serviço em segundo plano do cmux pode não estar em execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать провайдера диктовки. Возможно, фоновая служба cmux не запущена."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านข้อมูลผู้ให้บริการการป้อนตามคำบอกไม่ได้ บริการเบื้องหลังของ cmux อาจไม่ได้ทำงานอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte sağlayıcısı okunamadı. cmux’un arka plan hizmeti çalışmıyor olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати постачальника диктування. Можливо, фонова служба cmux не запущена."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc nhà cung cấp đọc chính tả. Dịch vụ chạy nền của cmux có thể chưa chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取听写提供商。cmux 的后台服务可能未在运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取聽寫供應商。cmux 的背景服務可能未在執行。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
