            "value": "لم يُجب %@ في الوقت المحدد. أعد المحاولة بعد قليل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nije odgovorio na vrijeme. Pokušajte ponovo za trenutak."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ svarede ikke i tide. Prøv igen om et øjeblik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat nicht rechtzeitig geantwortet. Versuche es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn't answer in time. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no respondió a tiempo. Vuelve a intentarlo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas répondu à temps. Réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha risposto in tempo. Riprova tra un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ から時間内に応答がありませんでした。少し待ってからもう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ មិនបានឆ្លើយតបទាន់ពេលទេ។ ព្យាយាមម្តងទៀតបន្តិចទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 제시간에 응답하지 않았습니다. 잠시 후 다시 시도하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ svarte ikke i tide. Prøv igjen om et øyeblikk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie odpowiedział na czas. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não respondeu a tempo. Tente novamente em instantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не ответил вовремя. Повторите попытку чуть позже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ไม่ตอบกลับภายในเวลาที่กำหนด ลองอีกครั้งในอีกสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zamanında yanıt vermedi. Biraz sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не відповів вчасно. Спробуйте ще раз за мить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không phản hồi kịp. Hãy thử lại sau giây lát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未及时响应。请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未及時回應。請稍後再試一次。"
          }
        }
      }
    },
