          }
        }
      }
    },
    "settingsPage.dictationEngine.error.badEndpoint": {
      "comment": "Check failed: the URL is not allowed or not a transcription route.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن استخدام عنوان URL هذا للإملاء. استخدم عنوان https، أو http فقط لخادم على هذا الـMac أو على شبكتك المحلية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj URL se ne može koristiti za diktiranje. Koristite https adresu, ili http samo za server na ovom Macu ili vašoj lokalnoj mreži."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne URL kan ikke bruges til diktering. Brug en https-adresse, eller kun http til en server på denne Mac eller dit lokale netværk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese URL kann nicht zum Diktieren verwendet werden. Verwende eine https-Adresse oder http nur für einen Server auf diesem Mac oder in deinem lokalen Netzwerk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This URL can't be used for dictation. Use an https address, or http only for a server on this Mac or your local network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta URL no se puede usar para el dictado. Usa una dirección https, o http solo para un servidor en este Mac o en tu red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette URL ne peut pas servir à la dictée. Utilisez une adresse https, ou http uniquement pour un serveur sur ce Mac ou sur votre réseau local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo URL non può essere usato per la dettatura. Usa un indirizzo https, oppure http solo per un server su questo Mac o sulla tua rete locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このURLは音声入力に使えません。httpsのアドレスを使ってください。httpはこのMacまたはローカルネットワーク上のサーバに限り使えます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "URL នេះមិនអាចប្រើសម្រាប់ការសរសេរតាមសំឡេងបានទេ។ ប្រើអាសយដ្ឋាន https ឬ http សម្រាប់តែម៉ាស៊ីនមេនៅលើ Mac នេះ ឬបណ្តាញមូលដ្ឋានរបស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 URL은 받아쓰기에 사용할 수 없습니다. https 주소를 사용하고, http는 이 Mac 또는 로컬 네트워크의 서버에만 사용하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne URL-en kan ikke brukes til diktering. Bruk en https-adresse, eller http bare for en server på denne Macen eller det lokale nettverket."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego URL nie można użyć do dyktowania. Użyj adresu https albo http tylko dla serwera na tym Macu lub w sieci lokalnej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta URL não pode ser usada para ditado. Use um endereço https, ou http apenas para um servidor neste Mac ou na sua rede local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот URL нельзя использовать для диктовки. Используйте адрес https, а http — только для сервера на этом Mac или в вашей локальной сети."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ URL นี้สำหรับการป้อนตามคำบอกไม่ได้ ใช้ที่อยู่ https หรือใช้ http เฉพาะกับเซิร์ฟเวอร์บน Mac เครื่องนี้หรือในเครือข่ายภายในของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu URL dikte için kullanılamaz. Bir https adresi kullanın; http’yi yalnızca bu Mac’teki veya yerel ağınızdaki bir sunucu için kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей URL не можна використати для диктування. Використовуйте адресу https, а http — лише для сервера на цьому Mac або у вашій локальній мережі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể dùng URL này để đọc chính tả. Hãy dùng địa chỉ https, hoặc http chỉ cho máy chủ trên máy Mac này hoặc mạng cục bộ của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 URL 无法用于听写。请使用 https 地址；http 仅可用于这台 Mac 或本地网络上的服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 URL 無法用於聽寫。請使用 https 位址；http 僅可用於這部 Mac 或區域網路上的伺服器。"
          }
        }
      }
    },
    "settingsPage.dictationEngine.error.badResponse": {
      "comment": "Check failed: the answer was not the expected JSON.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أجاب الخادم، لكن ليس كخدمة تفريغ صوتي. تحقّق من عنوان URL."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server je odgovorio, ali ne kao usluga transkripcije. Provjerite URL."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren svarede, men ikke som en transskriptionstjeneste. Tjek URL'en."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat geantwortet, aber nicht wie ein Transkriptionsdienst. Prüfe die URL."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server answered, but not like a transcription service. Check the URL."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor respondió, pero no como un servicio de transcripción. Comprueba la URL."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a répondu, mais pas comme un service de transcription. Vérifiez l’URL."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha risposto, ma non come un servizio di trascrizione. Controlla l’URL."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバは応答しましたが、文字起こしサービスの応答ではありませんでした。URLを確認してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម៉ាស៊ីនមេបានឆ្លើយតប ប៉ុន្តែមិនដូចសេវាបំប្លែងសំឡេងជាអត្ថបទទេ។ ពិនិត្យ URL។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 응답했지만 전사 서비스의 응답이 아닙니다. URL을 확인하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren svarte, men ikke som en transkripsjonstjeneste. Sjekk URL-en."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer odpowiedział, ale nie jak usługa transkrypcji. Sprawdź URL."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor respondeu, mas não como um serviço de transcrição. Verifique a URL."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер ответил, но не как служба транскрипции. Проверьте URL."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์ตอบกลับ แต่ไม่ใช่ในแบบของบริการถอดเสียง ตรวจสอบ URL"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu yanıt verdi, ancak bir döküm hizmeti gibi değil. URL’yi denetleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер відповів, але не як служба транскрипції. Перевірте URL."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ đã phản hồi, nhưng không giống một dịch vụ chép lời. Hãy kiểm tra URL."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器有响应，但不像转录服务。请检查 URL。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器有回應，但不像轉錄服務。請檢查 URL。"
          }
        }
      }
    },
    "settingsPage.dictationEngine.error.keyInvalid": {
      "comment": "Check failed: the provider refused the key (401/403).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يقبل المزوّد المفتاح. احفظ مفتاح API صالحًا، ثم افحص مجددًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pružatelj nije prihvatio ključ. Sačuvajte važeći API ključ, pa ponovo provjerite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udbyderen accepterede ikke nøglen. Gem en gyldig API-nøgle, og tjek igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter hat den Schlüssel nicht akzeptiert. Sichere einen gültigen API-Schlüssel und prüfe erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider didn't accept the key. Save a valid API key, then check again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor no aceptó la clave. Guarda una clave de API válida y vuelve a comprobar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur n’a pas accepté la clé. Enregistrez une clé d’API valide, puis vérifiez à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fornitore non ha accettato la chiave. Salva una chiave API valida, poi verifica di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダがキーを受け付けませんでした。有効なAPIキーを保存してから、もう一度確認してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកផ្តល់សេវាមិនបានទទួលយកសោនេះទេ។ រក្សាទុកសោ API ដែលត្រឹមត្រូវ រួចពិនិត្យម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자가 키를 수락하지 않았습니다. 유효한 API 키를 저장한 후 다시 확인하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leverandøren godtok ikke nøkkelen. Lagre en gyldig API-nøkkel, og sjekk på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostawca nie zaakceptował klucza. Zapisz prawidłowy klucz API i sprawdź ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O provedor não aceitou a chave. Salve uma chave de API válida e verifique de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Провайдер не принял ключ. Сохраните действительный ключ API и проверьте снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ให้บริการไม่ยอมรับคีย์นี้ บันทึกคีย์ API ที่ถูกต้อง แล้วตรวจสอบอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcı anahtarı kabul etmedi. Geçerli bir API anahtarı kaydedin, ardından yeniden denetleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Постачальник не прийняв ключ. Збережіть дійсний ключ API і перевірте знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhà cung cấp không chấp nhận khóa. Hãy lưu một khóa API hợp lệ rồi kiểm tra lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供商未接受该密钥。请保存有效的 API 密钥，然后再次检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "供應商未接受此金鑰。請儲存有效的 API 金鑰，然後再檢查一次。"
          }
        }
      }
    },
    "settingsPage.dictationEngine.error.keyMissing": {
      "comment": "Check failed: no key saved.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد مفتاح محفوظ. الصق مفتاح API واختر حفظ."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nijedan ključ nije sačuvan. Zalijepite svoj API ključ i odaberite Sačuvaj."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen nøgle er gemt. Indsæt din API-nøgle, og vælg Gem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Schlüssel gesichert. Füge deinen API-Schlüssel ein und wähle „Sichern“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No key is saved. Paste your API key and choose Save."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna clave guardada. Pega tu clave de API y elige Guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune clé n’est enregistrée. Collez votre clé d’API et choisissez Enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna chiave salvata. Incolla la tua chiave API e scegli Salva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーが保存されていません。APIキーを貼り付けて「保存」を選んでください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនមានសោបានរក្សាទុកទេ។ បិទភ្ជាប់សោ API របស់អ្នក ហើយជ្រើសរើស រក្សាទុក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 키가 없습니다. API 키를 붙여넣고 저장을 선택하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen nøkkel er lagret. Lim inn API-nøkkelen din og velg Lagre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zapisano żadnego klucza. Wklej swój klucz API i wybierz Zapisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma chave salva. Cole sua chave de API e escolha Salvar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ не сохранён. Вставьте ключ API и выберите «Сохранить»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้บันทึกคีย์ วางคีย์ API ของคุณแล้วเลือก บันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı anahtar yok. API anahtarınızı yapıştırıp Kaydet’i seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ не збережено. Вставте свій ключ API і виберіть «Зберегти»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa lưu khóa nào. Dán khóa API của bạn rồi chọn Lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未存储任何密钥。粘贴你的 API 密钥并选择“保存”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未儲存任何金鑰。貼上你的 API 金鑰並選擇「儲存」。"
          }
        }
      }
    },
    "settingsPage.dictationEngine.error.notConfigured": {
      "comment": "Check failed: no engine or no URL set.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مزوّد إملاء أعلاه، وعنوان URL الخاص به إن كان يحتاج إليه، ثم افحص مجددًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite pružatelja diktiranja iznad, i njegov URL ako ga treba, pa ponovo provjerite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en dikteringsudbyder ovenfor, og dens URL hvis den skal bruge en, og tjek igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle oben einen Diktieranbieter und, falls nötig, seine URL und prüfe dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a dictation provider above, and its URL if it needs one, then check again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige arriba un proveedor de dictado, y su URL si la necesita, y vuelve a comprobar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un fournisseur de dictée ci-dessus, et son URL s’il en faut une, puis vérifiez à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli sopra un fornitore di dettatura, e il suo URL se ne serve uno, poi verifica di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上で音声入力プロバイダを選び、必要ならURLを入力してから、もう一度確認してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ជ្រើសរើសអ្នកផ្តល់សេវាសរសេរតាមសំឡេងខាងលើ និង URL របស់វាប្រសិនបើត្រូវការ រួចពិនិត្យម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위에서 받아쓰기 제공자를 선택하고 필요하면 URL을 입력한 후 다시 확인하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en dikteringsleverandør ovenfor, og URL-en hvis den trenger en, og sjekk på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz powyżej dostawcę dyktowania i jego URL, jeśli jest potrzebny, a potem sprawdź ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um provedor de ditado acima, e a URL dele se precisar de uma, e verifique de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите выше провайдера диктовки и, если нужно, его URL, затем проверьте снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกผู้ให้บริการการป้อนตามคำบอกด้านบน และ URL หากจำเป็น แล้วตรวจสอบอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yukarıdan bir dikte sağlayıcısı ve gerekiyorsa URL’sini seçip yeniden denetleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть вище постачальника диктування і, якщо потрібно, його URL, потім перевірте знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chọn một nhà cung cấp đọc chính tả ở trên, cùng URL nếu cần, rồi kiểm tra lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在上方选择听写提供商，如有需要再填写其 URL，然后再次检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在上方選擇聽寫供應商，如有需要再填寫其 URL，然後再檢查一次。"
          }
        }
      }
    },
    "settingsPage.dictationEngine.error.offline": {
      "comment": "Check failed: no connection; %@ is the provider's host name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى %@. تحقّق من اتصال الشبكة وعنوان URL، ثم أعد المحاولة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće doći do %@. Provjerite mrežnu vezu i URL, pa pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke nå %@. Tjek din netværksforbindelse og URL'en, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht erreichbar. Prüfe deine Netzwerkverbindung und die URL und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't reach %@. Check your network connection and the URL, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con %@. Comprueba tu conexión de red y la URL, y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre %@. Vérifiez votre connexion réseau et l’URL, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere %@. Controlla la connessione di rete e l’URL, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に接続できませんでした。ネットワーク接続とURLを確認してから、もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចទៅដល់ %@ បានទេ។ ពិនិត្យការតភ្ជាប់បណ្តាញ និង URL រួចព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 연결할 수 없습니다. 네트워크 연결과 URL을 확인한 후 다시 시도하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke nå %@. Sjekk nettverkstilkoblingen og URL-en, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można połączyć się z %@. Sprawdź połączenie sieciowe i URL, a następnie spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar %@. Verifique sua conexão de rede e a URL e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с %@. Проверьте сетевое подключение и URL, затем повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อ %@ ไม่ได้ ตรวจสอบการเชื่อมต่อเครือข่ายและ URL แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adresine ulaşılamadı. Ağ bağlantınızı ve URL’yi denetleyip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося звʼязатися з %@. Перевірте мережеве зʼєднання та URL, потім спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể kết nối tới %@. Hãy kiểm tra kết nối mạng và URL rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到 %@。请检查网络连接和 URL，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線到 %@。請檢查網路連線和 URL，然後再試一次。"
          }
        }
      }
    },
    "settingsPage.dictationEngine.error.other": {
      "comment": "Check failed for another reason.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فحص الاتصال. أعد المحاولة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće provjeriti vezu. Pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke tjekke forbindelsen. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung konnte nicht geprüft werden. Versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't check the connection. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo comprobar la conexión. Vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier la connexion. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare la connessione. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を確認できませんでした。もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចពិនិត្យការតភ្ជាប់បានទេ។ ព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결을 확인할 수 없습니다. 다시 시도하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke sjekke tilkoblingen. Prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można sprawdzić połączenia. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a conexão. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить подключение. Повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบการเชื่อมต่อไม่ได้ ลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı denetlenemedi. Yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося перевірити зʼєднання. Спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể kiểm tra kết nối. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查连接。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法檢查連線。請再試一次。"
          }
        }
      }
    },
    "settingsPage.dictationEngine.error.providerError": {
      "comment": "Check failed: the provider's server failed (5xx).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدثت مشكلة لدى المزوّد. أعد المحاولة لاحقًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pružatelj ima problem na svojoj strani. Pokušajte ponovo kasnije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udbyderen havde et problem i sin ende. Prøv igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Anbieter ist ein Problem aufgetreten. Versuche es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider had a problem on its side. Try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor tuvo un problema por su parte. Vuelve a intentarlo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur a rencontré un problème de son côté. Réessayez plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fornitore ha avuto un problema. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダ側で問題が発生しました。後でもう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកផ្តល់សេវាមានបញ្ហានៅខាងខ្លួន។ ព្យាយាមម្តងទៀតពេលក្រោយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자 측에 문제가 발생했습니다. 나중에 다시 시도하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leverandøren hadde et problem på sin side. Prøv igjen senere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wystąpił problem po stronie dostawcy. Spróbuj ponownie później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O provedor teve um problema do lado dele. Tente novamente mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На стороне провайдера произошла ошибка. Повторите попытку позже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ให้บริการเกิดปัญหาทางฝั่งของตน ลองอีกครั้งในภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcı tarafında bir sorun oluştu. Daha sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На боці постачальника сталася помилка. Спробуйте пізніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhà cung cấp gặp sự cố ở phía họ. Hãy thử lại sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供商那边出现了问题。请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "供應商端發生問題。請稍後再試一次。"
          }
        }
      }
    },
    "settingsPage.dictationEngine.error.rateLimited": {
      "comment": "Check failed: too many requests (429).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدّ المزوّد من الطلبات حاليًا. انتظر دقيقة، ثم أعد المحاولة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pružatelj ograničava zahtjeve. Sačekajte minutu, pa pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udbyderen begrænser anmodninger. Vent et minut, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter begrenzt gerade Anfragen. Warte eine Minute und versuche es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider is limiting requests. Wait a minute, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor está limitando las solicitudes. Espera un minuto y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur limite les requêtes. Patientez une minute, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fornitore sta limitando le richieste. Attendi un minuto, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダがリクエストを制限しています。1分ほど待ってからもう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកផ្តល់សេវាកំពុងកំណត់សំណើ។ រង់ចាំមួយនាទី រួចព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자가 요청을 제한하고 있습니다. 1분 후 다시 시도하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leverandøren begrenser forespørsler. Vent et minutt, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostawca ogranicza liczbę żądań. Odczekaj minutę i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O provedor está limitando as solicitações. Aguarde um minuto e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Провайдер ограничивает запросы. Подождите минуту и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ให้บริการกำลังจำกัดจำนวนคำขอ รอหนึ่งนาที แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcı istekleri sınırlıyor. Bir dakika bekleyip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Постачальник обмежує запити. Зачекайте хвилину й спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhà cung cấp đang giới hạn yêu cầu. Hãy đợi một phút rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供商正在限制请求。请等待一分钟后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "供應商正在限制要求。請等待一分鐘後再試一次。"
          }
        }
      }
    },
    "settingsPage.dictationEngine.error.rejected": {
      "comment": "Check failed: the provider refused the request; %@ is the provider's own message (English).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض المزوّد الطلب (%@). تحقّق من اسم النموذج وعنوان URL."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pružatelj je odbio zahtjev (%@). Provjerite naziv modela i URL."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udbyderen afviste anmodningen (%@). Tjek modelnavnet og URL'en."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter hat die Anfrage abgelehnt (%@). Prüfe den Modellnamen und die URL."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider refused the request (%@). Check the model name and the URL."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor rechazó la solicitud (%@). Comprueba el nombre del modelo y la URL."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur a refusé la requête (%@). Vérifiez le nom du modèle et l’URL."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fornitore ha rifiutato la richiesta (%@). Controlla il nome del modello e l’URL."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダがリクエストを拒否しました（%@）。モデル名とURLを確認してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកផ្តល់សេវាបានបដិសេធសំណើ (%@)។ ពិនិត្យឈ្មោះម៉ូដែល និង URL។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자가 요청을 거부했습니다(%@). 모델 이름과 URL을 확인하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leverandøren avviste forespørselen (%@). Sjekk modellnavnet og URL-en."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostawca odrzucił żądanie (%@). Sprawdź nazwę modelu i URL."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O provedor recusou a solicitação (%@). Verifique o nome do modelo e a URL."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Провайдер отклонил запрос (%@). Проверьте название модели и URL."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ให้บริการปฏิเสธคำขอ (%@) ตรวจสอบชื่อโมเดลและ URL"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcı isteği reddetti (%@). Model adını ve URL’yi denetleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Постачальник відхилив запит (%@). Перевірте назву моделі та URL."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhà cung cấp đã từ chối yêu cầu (%@). Hãy kiểm tra tên mô hình và URL."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供商拒绝了请求（%@）。请检查模型名称和 URL。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "供應商拒絕了要求（%@）。請檢查模型名稱和 URL。"
          }
        }
      }
    },
