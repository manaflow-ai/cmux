    "readOnly.outside": {
      "comment": "Explains the read-only badge",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file is outside the workspace, so it opens read only."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هذا الملف خارج مساحة العمل، لذا يُفتح للقراءة فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ova datoteka je izvan radnog prostora, pa se otvara samo za čitanje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne fil ligger uden for arbejdsområdet, så den åbnes skrivebeskyttet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Datei liegt außerhalb des Arbeitsbereichs und wird daher schreibgeschützt geöffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este archivo está fuera del espacio de trabajo, así que se abre en solo lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce fichier est hors de l’espace de travail ; il s’ouvre donc en lecture seule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo file è fuori dall’area di lavoro, quindi si apre in sola lettura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルはワークスペースの外にあるため、読み取り専用で開きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ឯកសារនេះនៅក្រៅកន្លែងធ្វើការ ដូច្នេះវាបើកសម្រាប់អានតែប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 파일은 작업 공간 밖에 있으므로 읽기 전용으로 열립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne filen ligger utenfor arbeidsområdet, så den åpnes skrivebeskyttet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten plik jest poza obszarem roboczym, więc otwiera się tylko do odczytu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este arquivo está fora do espaço de trabalho, então abre somente para leitura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот файл находится вне рабочей области, поэтому он открыт только для чтения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไฟล์นี้อยู่นอกพื้นที่ทำงาน จึงเปิดแบบอ่านอย่างเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu dosya çalışma alanının dışında olduğundan salt okunur açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цей файл поза робочою областю, тому він відкривається лише для читання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tệp này nằm ngoài không gian làm việc nên được mở ở chế độ chỉ đọc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此文件位于工作区之外，因此以只读方式打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此檔案位於工作區之外，因此以唯讀方式開啟。"
          }
        }
      }
