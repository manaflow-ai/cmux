    "conflict.changed": {
      "comment": "Banner: the file changed on disk during editing",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file changed on disk while you were editing."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تغيّر هذا الملف على القرص أثناء التحرير."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ova datoteka je promijenjena na disku dok ste je uređivali."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Filen blev ændret på disken, mens du redigerede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Datei wurde auf dem Datenträger geändert, während du sie bearbeitet hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este archivo cambió en el disco mientras lo editabas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce fichier a été modifié sur le disque pendant que vous le modifiiez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo file è cambiato sul disco mentre lo modificavi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集中にこのファイルがディスク上で変更されました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ឯកសារនេះបានផ្លាស់ប្តូរនៅលើថាស ខណៈពេលអ្នកកំពុងកែសម្រួល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "편집하는 동안 디스크에서 이 파일이 변경되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Filen ble endret på disken mens du redigerte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten plik zmienił się na dysku podczas edycji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este arquivo mudou no disco enquanto você editava."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот файл изменился на диске, пока вы его редактировали."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไฟล์นี้ถูกเปลี่ยนบนดิสก์ระหว่างที่คุณแก้ไข"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Siz düzenlerken bu dosya diskte değişti."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цей файл змінився на диску, поки ви його редагували."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tệp này đã thay đổi trên đĩa trong lúc bạn chỉnh sửa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "编辑期间此文件在磁盘上已更改。"
