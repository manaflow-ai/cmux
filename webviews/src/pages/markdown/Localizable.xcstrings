    "reading.width.hint": {
      "comment": "Tooltip on the text width field and its label",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type a width such as 120, 120ch or 1600pt. Up and Down change it by 1, Shift by 10. Drag the label to scrub."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اكتب عرضًا مثل 120 أو 120ch أو 1600pt. يغيّره السهمان لأعلى ولأسفل بمقدار 1، ومع Shift بمقدار 10. اسحب التسمية لتغييره."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Upišite širinu, npr. 120, 120ch ili 1600pt. Gore i Dolje mijenjaju je za 1, sa Shiftom za 10. Povucite oznaku za promjenu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skriv en bredde som 120, 120ch eller 1600pt. Op og Ned ændrer den med 1, med Skift med 10. Træk i etiketten for at justere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gib eine Breite ein, z. B. 120, 120ch oder 1600pt. Auf und Ab ändern sie um 1, mit Umschalt um 10. Ziehe an der Beschriftung, um sie zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escribe un ancho como 120, 120ch o 1600pt. Arriba y Abajo lo cambian en 1; con Mayúsculas, en 10. Arrastra la etiqueta para ajustarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tapez une largeur comme 120, 120ch ou 1600pt. Haut et Bas la changent de 1, avec Maj de 10. Faites glisser l’étiquette pour l’ajuster."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Digita una larghezza come 120, 120ch o 1600pt. Su e Giù la cambiano di 1, con Maiusc di 10. Trascina l’etichetta per regolarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "120、120ch、1600pt のように幅を入力します。上下キーで 1、Shift を押しながらで 10 ずつ変わります。ラベルをドラッグして調整できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "វាយទទឹង ដូចជា 120, 120ch ឬ 1600pt។ ឡើង និងចុះ ប្ដូរ 1 ហើយជាមួយ Shift ប្ដូរ 10។ អូសស្លាកដើម្បីកែ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "120, 120ch, 1600pt처럼 너비를 입력하세요. 위/아래 키로 1씩, Shift와 함께 10씩 바뀝니다. 레이블을 드래그해 조절할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skriv en bredde som 120, 120ch eller 1600pt. Opp og Ned endrer den med 1, med Shift med 10. Dra etiketten for å justere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wpisz szerokość, np. 120, 120ch lub 1600pt. Strzałki w górę i w dół zmieniają ją o 1, z Shift o 10. Przeciągnij etykietę, aby ją dostosować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Digite uma largura como 120, 120ch ou 1600pt. Para cima e Para baixo mudam em 1; com Shift, em 10. Arraste o rótulo para ajustar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Введите ширину, например 120, 120ch или 1600pt. Вверх и Вниз меняют её на 1, с Shift на 10. Потяните подпись, чтобы изменить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "พิมพ์ความกว้าง เช่น 120, 120ch หรือ 1600pt ปุ่มขึ้นและลงเปลี่ยนทีละ 1 กด Shift ด้วยเปลี่ยนทีละ 10 ลากป้ายเพื่อปรับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "120, 120ch veya 1600pt gibi bir genişlik yazın. Yukarı ve Aşağı 1, Shift ile 10 değiştirir. Ayarlamak için etiketi sürükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Введіть ширину, наприклад 120, 120ch або 1600pt. Угору й Униз змінюють її на 1, із Shift на 10. Потягніть підпис, щоб змінити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhập độ rộng như 120, 120ch hoặc 1600pt. Lên và Xuống đổi 1, giữ Shift đổi 10. Kéo nhãn để chỉnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "输入宽度，例如 120、120ch 或 1600pt。上下键每次改 1，按住 Shift 改 10。拖动标签可调整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "輸入寬度，例如 120、120ch 或 1600pt。上下鍵每次改 1，按住 Shift 改 10。拖移標籤可調整。"
          }
        }
      }
    },
