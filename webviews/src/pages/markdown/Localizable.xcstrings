    "readOnly.transcript": {
      "comment": "Note: why the file opens read only",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a chat transcript, so it opens read only."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا نص محادثة، لذا يُفتح للقراءة فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo je zapis chata, pa se otvara samo za čitanje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er en chatudskrift, så den åbnes skrivebeskyttet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist ein Chatprotokoll, daher wird es schreibgeschützt geöffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es una transcripción de chat, por eso se abre como solo lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est une transcription de chat : elle s’ouvre en lecture seule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è una trascrizione di chat, quindi si apre in sola lettura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはチャットの記録なので、読み取り専用で開きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នេះជាប្រតិចារឹកការជជែក ដូច្នេះវាបើកសម្រាប់តែអានប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅 기록이므로 읽기 전용으로 열립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er en chatlogg, så den åpnes skrivebeskyttet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To jest zapis czatu, więc otwiera się tylko do odczytu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma transcrição de chat, por isso abre somente para leitura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это расшифровка чата, поэтому она открывается только для чтения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือบันทึกแชต จึงเปิดแบบอ่านอย่างเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir sohbet dökümü, bu yüzden salt okunur açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це стенограма чату, тому вона відкривається лише для читання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là bản ghi cuộc trò chuyện nên nó được mở ở chế độ chỉ đọc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是聊天记录，因此以只读方式打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是聊天記錄，因此以唯讀方式開啟。"
          }
        }
      }
    },
