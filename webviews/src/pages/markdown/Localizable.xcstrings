    "readOnly.binary": {
      "comment": "Note: why the file opens read only",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file looks binary, so it is read only."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو هذا الملف ثنائيًا، لذا فهو للقراءة فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova datoteka izgleda binarno, pa je samo za čitanje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen ser binær ud og er derfor skrivebeskyttet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei scheint binär zu sein und ist daher schreibgeschützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo parece binario, así que es de solo lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier semble binaire ; il est donc en lecture seule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file sembra binario, quindi è di sola lettura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルはバイナリのようなので、読み出し専用です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឯកសារនេះមើលទៅជាប្រព័ន្ធគោលពីរ ដូច្នេះវាអានតែប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 바이너리로 보이므로 읽기 전용입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne filen ser binær ut og er derfor skrivebeskyttet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten plik wygląda na binarny, więc jest tylko do odczytu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo parece binário, por isso é somente leitura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл похож на двоичный, поэтому доступен только для чтения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์นี้ดูเหมือนไฟล์ไบนารี จึงอ่านได้อย่างเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya ikili görünüyor, bu yüzden salt okunurdur."
          }
        },
        "uk": {
