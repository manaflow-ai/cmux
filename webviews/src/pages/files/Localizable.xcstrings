    "files.page.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files can’t be shown in this tab. Open Files from the chat again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن عرض الملفات في علامة التبويب هذه. افتح الملفات من الدردشة مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteke se ne mogu prikazati u ovoj kartici. Ponovo otvorite Datoteke iz chata."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filerne kan ikke vises i denne fane. Åbn Filer fra chatten igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateien können in diesem Tab nicht angezeigt werden. Öffne „Dateien“ erneut aus dem Chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos no se pueden mostrar en esta pestaña. Vuelve a abrir Archivos desde el chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers ne peuvent pas s’afficher dans cet onglet. Rouvrez Fichiers depuis la conversation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file non possono essere mostrati in questa scheda. Riapri File dalla chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタブではファイルを表示できません。チャットからもう一度ファイルを開いてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចបង្ហាញឯកសារនៅក្នុងផ្ទាំងនេះបានទេ។ សូមបើកឯកសារពីការជជែកម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 탭에서는 파일을 표시할 수 없습니다. 채팅에서 파일을 다시 여세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filene kan ikke vises i denne fanen. Åpne Filer fra chatten igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można wyświetlić plików w tej karcie. Otwórz Pliki ponownie z czatu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível mostrar os arquivos nesta aba. Abra Arquivos pelo chat novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы нельзя показать в этой вкладке. Снова откройте «Файлы» из чата."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถแสดงไฟล์ในแท็บนี้ได้ เปิดไฟล์จากแชทอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar bu sekmede gösterilemiyor. Dosyalar’ı sohbetten yeniden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файли не можна показати в цій вкладці. Знову відкрийте «Файли» з чату."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể hiển thị tệp trong thẻ này. Hãy mở lại Tệp từ cuộc trò chuyện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此标签页无法显示文件。请从聊天中再次打开“文件”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此分頁無法顯示檔案。請從聊天中再次打開「檔案」。"
          }
        }
      }
