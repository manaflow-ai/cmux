    "iconPicker.svg.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم إزالة البرامج النصية والروابط والمراجع الخارجية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skripte, veze i vanjske reference se uklanjaju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scripts, links og eksterne referencer fjernes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skripte, Links und externe Verweise werden entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scripts, links and external references are removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan los scripts, los enlaces y las referencias externas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les scripts, les liens et les références externes sont supprimés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Script, link e riferimenti esterni vengono rimossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリプト、リンク、外部参照は削除されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ស្គ្រីប តំណ និងឯកសារយោងខាងក្រៅត្រូវបានលុប។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크립트, 링크 및 외부 참조는 제거됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skript, lenker og eksterne referanser fjernes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrypty, łącza i odwołania zewnętrzne są usuwane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Scripts, links e referências externas são removidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрипты, ссылки и внешние ссылки на ресурсы удаляются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สคริปต์ ลิงก์ และการอ้างอิงภายนอกจะถูกลบออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Betikler, bağlantılar ve dış başvurular kaldırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрипти, посилання та зовнішні ресурси видаляються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tập lệnh, liên kết và tham chiếu bên ngoài sẽ bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
