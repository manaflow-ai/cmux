    "stash.import.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في OneTab، اختر Export / Import URLs، وانسخ النص، والصقه هنا. تصبح كل مجموعة مفصولة بسطر فارغ مجموعة مخبأة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "U OneTabu odaberite Export / Import URLs, kopirajte tekst i zalijepite ga ovdje. Svaka grupa odvojena praznim redom postaje spremljena grupa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I OneTab skal du vælge Export / Import URLs, kopiere teksten og indsætte den her. Hver gruppe adskilt af en tom linje bliver til en gemt gruppe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle in OneTab „Export / Import URLs“, kopiere den Text und füge ihn hier ein. Jede durch eine Leerzeile getrennte Gruppe wird zu einer zurückgelegten Gruppe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In OneTab, choose Export / Import URLs, copy the text, and paste it here. Each blank-line-separated group becomes a stashed group."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En OneTab, elige Export / Import URLs, copia el texto y pégalo aquí. Cada grupo separado por una línea en blanco se convierte en un grupo guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans OneTab, choisissez Export / Import URLs, copiez le texte et collez-le ici. Chaque groupe séparé par une ligne vide devient un groupe mis de côté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In OneTab, scegli Export / Import URLs, copia il testo e incollalo qui. Ogni gruppo separato da una riga vuota diventa un gruppo messo da parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OneTab で「Export / Import URLs」を選び、テキストをコピーしてここに貼り付けてください。空行で区切られた各グループが保留グループになります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នៅក្នុង OneTab សូមជ្រើសរើស Export / Import URLs ចម្លងអត្ថបទ ហើយបិទភ្ជាប់វានៅទីនេះ។ ក្រុមនីមួយៗដែលបំបែកដោយបន្ទាត់ទទេ នឹងក្លាយជាក្រុមដែលបានទុក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OneTab에서 Export / Import URLs를 선택하고 텍스트를 복사해 여기에 붙여 넣으세요. 빈 줄로 구분된 각 그룹이 보관 그룹이 됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I OneTab velger du Export / Import URLs, kopierer teksten og limer den inn her. Hver gruppe skilt med en tom linje blir en lagret gruppe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W OneTab wybierz Export / Import URLs, skopiuj tekst i wklej go tutaj. Każda grupa oddzielona pustym wierszem staje się odłożoną grupą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No OneTab, escolha Export / Import URLs, copie o texto e cole aqui. Cada grupo separado por uma linha em branco vira um grupo guardado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В OneTab выберите Export / Import URLs, скопируйте текст и вставьте его сюда. Каждая группа, отделённая пустой строкой, станет отложенной группой."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใน OneTab ให้เลือก Export / Import URLs คัดลอกข้อความ แล้ววางที่นี่ แต่ละกลุ่มที่คั่นด้วยบรรทัดว่างจะกลายเป็นกลุ่มที่เก็บไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OneTab’de Export / Import URLs’i seçin, metni kopyalayın ve buraya yapıştırın. Boş satırla ayrılan her grup saklanan bir grup olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "В OneTab виберіть Export / Import URLs, скопіюйте текст і вставте його сюди. Кожна група, відокремлена порожнім рядком, стане відкладеною групою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong OneTab, chọn Export / Import URLs, sao chép văn bản rồi dán vào đây. Mỗi nhóm được ngăn bằng một dòng trống sẽ thành một nhóm đã cất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 OneTab 中选择“Export / Import URLs”，拷贝文本并粘贴到这里。每个以空行分隔的组都会成为一个收起的组。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 OneTab 中選擇「Export / Import URLs」，拷貝文字並貼上到這裡。每個以空行分隔的群組都會成為一個收起的群組。"
          }
        }
      }
    },
