    "stash.import.nothing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على علامات تبويب في النص الملصق."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "U zalijepljenom tekstu nema kartica."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke fundet faner i den indsatte tekst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im eingefügten Text wurden keine Tabs gefunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tabs found in the pasted text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron pestañas en el texto pegado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun onglet trouvé dans le texte collé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna scheda trovata nel testo incollato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "貼り付けたテキストにタブが見つかりません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រកមិនឃើញផ្ទាំងក្នុងអត្ថបទដែលបានបិទភ្ជាប់ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "붙여 넣은 텍스트에서 탭을 찾을 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ingen faner i den innlimte teksten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono kart we wklejonym tekście."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma aba encontrada no texto colado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во вставленном тексте не найдено вкладок."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบแท็บในข้อความที่วาง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapıştırılan metinde sekme bulunamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У вставленому тексті не знайдено вкладок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy tab nào trong văn bản đã dán."
          }
        },
        "zh-Hans": {
