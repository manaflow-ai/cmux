    "label.notKept": {
      "comment": "Under a message I sent that has not gone yet and is too large for the app to keep: if cmux quits before it goes, it is lost.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Saved: Too Large to Keep"
          }
        },
        "ar": {
          "stringUnit": {
