{
  "sourceLanguage": "en",
  "strings": {
    "home.compose.close": {
      "comment": "The x on the Home list's New Message row (tooltip, VoiceOver): discards the draft.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close New Message"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إغلاق الرسالة الجديدة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatvori novu poruku"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Luk ny besked"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Nachricht schließen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar mensaje nuevo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer le nouveau message"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi nuovo messaggio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規メッセージを閉じる"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បិទសារថ្មី"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 메시지 닫기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukk ny melding"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknij nową wiadomość"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar nova mensagem"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть новое сообщение"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดข้อความใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni Mesajı Kapat"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрити нове повідомлення"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đóng tin nhắn mới"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭新信息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉新訊息"
          }
        }
      },
      "extractionState": "manual"
    },
