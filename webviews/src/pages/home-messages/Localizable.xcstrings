    "home.list.cloudUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud conversations are not available right now."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محادثات السحابة غير متاحة الآن."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Razgovori u oblaku trenutno nisu dostupni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cloud-samtaler er ikke tilgængelige lige nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-Unterhaltungen sind gerade nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las conversaciones en la nube no están disponibles ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conversations Cloud ne sont pas disponibles pour le moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le conversazioni Cloud non sono disponibili al momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドの会話は現在利用できません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការសន្ទនាលើ Cloud មិនអាចប្រើបានឥឡូវនេះទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 클라우드 대화를 사용할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cloud-samtaler er ikke tilgjengelige akkurat nå."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rozmowy w chmurze są teraz niedostępne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As conversas na nuvem não estão disponíveis agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Разговоры в облаке сейчас недоступны."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การสนทนาบนคลาวด์ใช้งานไม่ได้ในขณะนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bulut sohbetleri şu anda kullanılamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Розмови в хмарі зараз недоступні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các cuộc trò chuyện trên Cloud hiện không khả dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端对话目前不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲端對話目前無法使用。"
          }
        }
      },
      "extractionState": "manual"
    },
    "home.list.filterChipHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns the Unread filter off and shows every chat"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يوقف عامل تصفية غير المقروءة ويعرض كل الدردشات"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isključuje filter nepročitanih i prikazuje sve četove"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slår filteret Ulæste fra og viser alle chats"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schaltet den Filter „Ungelesen“ aus und zeigt alle Chats"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desactiva el filtro No leídos y muestra todos los chats"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désactive le filtre Non lus et affiche toutes les discussions"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Disattiva il filtro Non letti e mostra tutte le chat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未読フィルタをオフにして、すべてのチャットを表示します"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បិទតម្រងមិនទាន់អាន ហើយបង្ហាញការជជែកទាំងអស់"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "읽지 않음 필터를 끄고 모든 채팅을 표시합니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slår av filteret Uleste og viser alle chatter"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wyłącza filtr Nieprzeczytane i pokazuje wszystkie czaty"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desativa o filtro Não lidas e mostra todos os chats"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Отключает фильтр «Непрочитанные» и показывает все чаты"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ปิดตัวกรองยังไม่ได้อ่านและแสดงแชททั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Okunmamış filtresini kapatır ve tüm sohbetleri gösterir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вимикає фільтр «Непрочитані» і показує всі чати"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tắt bộ lọc Chưa đọc và hiện mọi cuộc trò chuyện"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "关闭“未读”过滤并显示所有聊天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "關閉「未讀」篩選並顯示所有聊天"
          }
        }
      },
      "extractionState": "manual"
    },
