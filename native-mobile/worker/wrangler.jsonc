{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cmux-next-native",
  "main": "src/index.ts",
  // Lawrencechen2002@gmail.com's Account. Never deploy to the f6dc... account.
  "account_id": "0c1675e0def6de1ab3a50a4e17dc5656",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    "APPLE_AUDIENCES": "dev.cmux.next.native,dev.cmux.next.native.dev",
    "APNS_TEAM_ID": "7WLXT3NR37"
  },
  "durable_objects": {
    "bindings": [
      { "name": "HOST_SIGNAL", "class_name": "HostSignal" },
      { "name": "USER_PUSH", "class_name": "UserPush" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HostSignal"] },
    { "tag": "v2", "new_sqlite_classes": ["UserPush"] }
  ]
  // Secrets (wrangler secret put): DB_HOST, DB_USERNAME, DB_PASSWORD,
  // TURN_KEY_ID, TURN_KEY_API_TOKEN, DEV_LOGIN_SECRET, and for push
  // APNS_KEY_P8 + APNS_KEY_ID (sending is a logged no-op without them)
}
