// Meadow: Moss in daylight. Sage and cream blocks with no lines between them, a fern-green accent,
// Everforest's light palette. Copy it to ~/.config/cmux/themes/meadow.json (yours wins over this
// one), edit and save: the running app repaints at once, no relaunch.
{
  "name": "Meadow",
  "description": "Sage and cream blocks, fern-green accent, Everforest light.",

  // Everforest's light terminal theme, with darker text so it reads at 5:1 or better.
  "appearance.theme": "Everforest Light Med",
  "colors": { "background": "#efebd4", "foreground": "#3f4a50", "selection": "#d6e0b0", "accent": "#43602c" },
  "appearance.accent": "theme",

  // Solid tonal blocks with rounded panes: no wallpaper and no glass.
  "appearance.background": "none",
  "appearance.backgroundBlur": "none",
  "appearance.glassTransparency": 0,
  "appearance.chromeStyle": "blocks",

  // A sage sidebar and tab bar around cream panes.
  "appearance.sidebarSurface": "separate",
  "appearance.surfaces.sidebar.color": "#dfe2c4",
  "appearance.surfaces.sidebar.opacity": 1,
  "appearance.surfaces.tabBar.color": "#e5e4ca",
  "appearance.surfaces.tabBar.opacity": 1,
  "sidebar.sectionLook": "card",

  "terminal.fontSize": 14
}
