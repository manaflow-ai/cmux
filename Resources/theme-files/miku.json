// Miku: Miku's teal (#39c5bb) and a pink second accent on deep sea-green glass, a teal cursor, and
// five teal paintings that change through the day. Copy this file to
// ~/.config/cmux/themes/miku.json (yours wins over this one), edit and save: the running app
// repaints at once, no relaunch.
//
// The paintings are public-domain works from cmux's art library; each shows its artist and source
// in the app. No character art ships here (it is not ours to give away), so bring your own
// wallpapers: put your pictures in ~/.config/cmux/themes/miku/, then in your copy set
// "appearance.background" to "folder:miku" (or "folder:/absolute/path/to/your/folder"). The window
// then shuffles them, a new one every 15 minutes.
{
  "name": "Miku",
  "description": "Miku teal on sea-green glass, pink accents, teal paintings through the day.",

  // The terminal theme and its own colors: teal accent and cursor, pink and teal in the palette.
  "appearance.theme": "Soft Blue",
  "appearance.appTheme": "followTerminal",
  "colors": {
    "background": "#0b1d1f",
    "foreground": "#e6f7f5",
    "selection": "#17494a",
    "accent": "#39c5bb",
    "cursor": "#39c5bb",
    "5": "#e12885",
    "6": "#39c5bb",
    "13": "#ff7eb9",
    "14": "#86e3dc"
  },
  "appearance.accent": "theme",

  // Five teal paintings, one for each part of the day. To shuffle your own pictures instead, see
  // the top of this file.
  "appearance.background": "schedule",
  "appearance.backgroundSchedule": {
    "06:00": "monet-cliff-pourville",
    "10:00": "van-gogh-almond-blossom",
    "14:00": "monet-water-lilies",
    "18:00": "hokusai-great-wave",
    "22:00": "grimshaw-silver-moonlight"
  },
  "appearance.backgroundRotation": "15m",
  "appearance.backgroundOpacity": 0.82,
  "appearance.backgroundBlur": "glass",

  // The sidebar: a deeper teal glass with a hairline edge, sections as cards.
  "appearance.sidebarSurface": "separate",
  "appearance.surfaces.sidebar.color": "#061e20",
  "appearance.surfaces.sidebar.opacity": 0.74,
  "appearance.surfaces.tabBar.color": "#061e20",
  "appearance.surfaces.tabBar.opacity": 0.74,
  "sidebar.border": true,
  "sidebar.sectionLook": "card",

  // The pane background behind every terminal.
  "appearance.surfaces.terminal.color": "#0b1d1f",
  "appearance.surfaces.terminal.opacity": 0.86,

  "terminal.fontSize": 14
}
