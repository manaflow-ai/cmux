// Moss: a forest floor. Deep green-gray blocks with no lines between them, a lichen-green accent,
// Everforest's soft cream text. Copy it to ~/.config/cmux/themes/moss.json (yours wins over this
// one), edit and save: the running app repaints at once, no relaunch.
{
  "name": "Moss",
  "description": "Deep forest-green blocks, lichen accent, Everforest text.",

  // Everforest's darkest terminal theme, with a moss-green selection.
  "appearance.theme": "Everforest Dark Hard",
  "appearance.appTheme": "followTerminal",
  "colors": { "background": "#1e2326", "foreground": "#d3c6aa", "selection": "#3c4d3b", "accent": "#a7c080" },
  "appearance.accent": "theme",

  // Solid tonal blocks with rounded panes: no wallpaper and no glass.
  "appearance.background": "none",
  "appearance.backgroundBlur": "none",
  "appearance.glassTransparency": 0,
  "appearance.chromeStyle": "blocks",

  // The sidebar and tab bar a shade darker than the panes, like shade under a canopy.
  "appearance.sidebarSurface": "separate",
  "appearance.surfaces.sidebar.color": "#161a1c",
  "appearance.surfaces.sidebar.opacity": 1,
  "appearance.surfaces.tabBar.color": "#191e20",
  "appearance.surfaces.tabBar.opacity": 1,
  "sidebar.sectionLook": "card",

  "terminal.fontSize": 14
}
