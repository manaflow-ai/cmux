#!/bin/sh
set -eu
bun=$(command -v bun || true)
[ -n "$bun" ] || { echo 'cmux code mode MCP: bun is required' >&2; exit 2; }
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
if [ -f "$root/cmux-tui/bindings/typescript/code-mode/mcp.mjs" ]; then
  script="$root/cmux-tui/bindings/typescript/code-mode/mcp.mjs"
elif [ -f "$root/Resources/code-mode/mcp.mjs" ] || [ -f "$root/Resources/code-mode.tar.xz" ]; then
  # Packed in the app (code-mode.tar.xz); mcp.mjs then runs from the unpacked copy in the
  # user's cache and finds the runner beside this script, not beside itself.
  here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
  script="$("$here/cmux-code-mode-unpack" "$root/Resources")/mcp.mjs"
  export CMUX_CODE_MODE_RUNNER="$here/cmux-code-mode-runner"
else
  script="$root/code-mode/mcp.mjs"
fi
exec "$bun" "$script"
