#!/bin/sh
set -eu
root=${CMUX_CODE_MODE_ROOT:-}
if [ -z "$root" ]; then
  root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
fi
bun=${BUN_BIN:-$(command -v bun || true)}
[ -n "$bun" ] || { echo 'cmux code mode MCP: bun is required' >&2; exit 2; }
exec "$bun" "$root/cmux-tui/bindings/typescript/code-mode/mcp.mjs"
