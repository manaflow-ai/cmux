#!/usr/bin/env bash
# cmux muse wrapper - installs cmux hooks and captures launch metadata.

find_real_muse() {
    local self_dir
    self_dir="$(cd "$(dirname "$0")" && pwd)"
    local IFS=:
    for d in $PATH; do
        [[ "$d" == "$self_dir" ]] && continue
        local candidate="$d/muse"
        [[ -x "$candidate" ]] || continue
        if [[ "$candidate" -ef "$0" ]]; then
            continue
        fi
        printf '%s' "$candidate"
        return 0
    done
    return 1
}

resolve_cmux_bin() {
    local bundled_cli self_dir
    bundled_cli="${CMUX_BUNDLED_CLI_PATH:-}"
    if [[ -n "$bundled_cli" && -x "$bundled_cli" ]]; then
        printf '%s' "$bundled_cli"
        return 0
    fi

    self_dir="$(cd "$(dirname "$0")" && pwd)"
    bundled_cli="$self_dir/cmux"
    if [[ -x "$bundled_cli" ]]; then
        printf '%s' "$bundled_cli"
        return 0
    fi

    bundled_cli="$(command -v cmux || true)"
    if [[ -n "$bundled_cli" ]]; then
        printf '%s' "$bundled_cli"
        return 0
    fi

    return 1
}

cmux_socket_available() {
    local socket="${CMUX_SOCKET_PATH:-}"
    [[ -n "$socket" && -S "$socket" ]] || return 1

    local cmux_bin
    cmux_bin="$(resolve_cmux_bin)" || return 1
    CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.75 \
        "$cmux_bin" --socket "$socket" ping >/dev/null 2>&1
}

encode_launch_argv() {
    {
        printf '%s\0' "$REAL_MUSE"
        if (( $# > 0 )); then
            printf '%s\0' "$@"
        fi
    } | base64 | tr -d '\n'
}

muse_option_consumes_value() {
    case "$1" in
        --agents|--provider|--preset|--model|--contributor-mode|-c|--config|\
        --reasoning-effort|--effort|--base-url|--image|--workspace|\
        --worktree-base|--worktree-existing|--approval-mode|--permission-profile|\
        --approval-judge|--echo-delay-ms|--sandbox-network)
            return 0
            ;;
    esac
    return 1
}

muse_passthrough_option_flag() {
    case "$1" in
        --help|-h|--version|-V)
            return 0
            ;;
    esac
    return 1
}

muse_builtin_command_name() {
    case "$1" in
        exec|config|export|trace|model-profile|skills|voice|plugins|sandbox|\
        schema|serve|session-message|mcp|auth|login|logout|init|help)
            return 0
            ;;
    esac
    return 1
}

# Interactive sessions (bare `muse`, a prompt, or `muse resume`) get hooks;
# one-shot and management subcommands run untouched.
should_install_muse_hooks() {
    (( $# == 0 )) && return 0

    local arg
    local skip_next=false
    for arg in "$@"; do
        if [[ "$skip_next" == true ]]; then
            skip_next=false
            continue
        fi
        case "$arg" in
            --)
                continue
                ;;
            -*)
                if muse_passthrough_option_flag "$arg"; then
                    return 1
                fi
                if [[ "$arg" != *=* ]] && muse_option_consumes_value "$arg"; then
                    skip_next=true
                fi
                continue
                ;;
            *)
                if muse_builtin_command_name "$arg"; then
                    return 1
                fi
                return 0
                ;;
        esac
    done

    return 0
}

REAL_MUSE="$(find_real_muse)" || { echo "Error: muse not found in PATH" >&2; exit 127; }

IN_CMUX=0
if [[ -n "${CMUX_SURFACE_ID:-}" ]]; then
    IN_CMUX=1
fi

if [[ "$IN_CMUX" == "1" && "${CMUX_MUSE_HOOKS_DISABLED:-}" != "1" ]] \
    && cmux_socket_available \
    && should_install_muse_hooks "$@"; then
    CMUX_BIN="$(resolve_cmux_bin || true)"
    if [[ -n "$CMUX_BIN" ]]; then
        CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=2 \
            "$CMUX_BIN" --socket "$CMUX_SOCKET_PATH" hooks muse install --yes >/dev/null 2>&1 || true
    fi
    export CMUX_AGENT_LAUNCH_KIND="muse"
    export CMUX_AGENT_LAUNCH_EXECUTABLE="$REAL_MUSE"
    export CMUX_AGENT_LAUNCH_ARGV_B64="$(encode_launch_argv "$@")"
    export CMUX_AGENT_LAUNCH_CWD="$PWD"
fi

exec "$REAL_MUSE" "$@"
