#!/bin/bash
# cmux's per-surface Pi launcher. It injects the bundled extension only when
# Pi would otherwise discover no cmux-managed copy, leaving the user's Pi
# configuration and other extensions untouched.

set -u

cmux_pi_wrapper_shim="${CMUX_PI_WRAPPER_SHIM:-}"
cmux_pi_wrapper_root="${CMUX_PI_WRAPPER_SHIM_ROOT:-}"
self_path="$0"

resolve_pi() {
    # PATH entries are literal directories, even when they contain glob characters.
    set -f
    local entry candidate
    local old_ifs="$IFS"
    IFS=:
    for entry in ${PATH:-}; do
        [ -n "$entry" ] || continue
        if [ -n "$cmux_pi_wrapper_root" ] && [ "$entry" = "$cmux_pi_wrapper_root" ]; then
            continue
        fi
        case "$entry" in
            */cmux-cli-shims|*/cmux-cli-shims/*) continue ;;
        esac
        candidate="$entry/pi"
        if [ -x "$candidate" ] && [ "$candidate" != "$self_path" ] &&
           { [ -z "$cmux_pi_wrapper_shim" ] || [ "$candidate" != "$cmux_pi_wrapper_shim" ]; }; then
            printf '%s' "$candidate"
            IFS="$old_ifs"
            return 0
        fi
    done
    IFS="$old_ifs"
    return 1
}

cmux_pi="$(resolve_pi 2>/dev/null || true)"
if [ -z "$cmux_pi" ]; then
    echo "Configured agent is unavailable. Install it or check the command configuration." >&2
    exit 127
fi

if [ "${CMUX_PI_HOOKS_DISABLED:-0}" = "1" ]; then
    exec "$cmux_pi" "$@"
fi

# Pi dispatches these commands before parsing options. These commands must
# receive the original argv: prepending `-e` makes the command name look like a
# prompt and can send it to the model instead. Keep this list in sync with
# Pi's dispatcher when new subcommands are added.
case "${1:-}" in
    install|remove|uninstall|update|list|config|auth|mcp|--help|-h|--version|-v)
        exec "$cmux_pi" "$@"
        ;;
esac

# `--no-extensions` is an explicit request to run without extensions. It can
# appear anywhere in Pi's option list, so honor it before creating a managed
# extension rather than defeating the user's opt-out with an explicit `-e`.
for cmux_pi_arg in "$@"; do
    [ "$cmux_pi_arg" = "--" ] && break
    if [ "$cmux_pi_arg" = "--no-extensions" ]; then
        exec "$cmux_pi" "$@"
    fi
done

# The native cmux-cua profile (also used by Claude) authenticates with the
# app-owned socket token. Never use the Codex compatibility socket: that
# profile requires a signed OpenAI Codex parent and owns a separate broker.
cmux_pi_cua_args=()
cmux_pi_cua_prepare() {
    [ -n "${CMUX_SURFACE_ID:-}" ] && [ -S "${CMUX_SOCKET_PATH:-}" ] || return 1
    [ "${CMUX_COMPUTER_USE_MCP_DISABLED:-0}" != "1" ] || return 1
    local setting="${HOME:-}/Library/Application Support/cmux/cmux-cua/enabled"
    local enabled="${CMUX_COMPUTER_USE_APP_ENABLED:-1}"
    if [ -r "$setting" ]; then IFS= read -r enabled < "$setting" || true; fi
    [ "$enabled" != "0" ] || return 1

    local resource_dir policy client token_file metadata owner mode token
    resource_dir="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd -P)" || return 1
    policy="$resource_dir/cmux-cua/client-policy.sh"
    [ -r "$policy" ] && [ -r "$resource_dir/bin/cmux-pi-cua-extension.ts" ] || return 1
    # shellcheck source=/dev/null
    . "$policy" || return 1
    client="$(cmux_computer_use_resolve_client)" || return 1
    [ -n "$client" ] || return 1
    [ -S "${CMUX_CUA_SOCKET_PATH:-}" ] || return 1
    token_file="${CMUX_CUA_AUTH_TOKEN_FILE:-}"
    [ -n "$token_file" ] && [ "${token_file#/}" != "$token_file" ] &&
        [ -f "$token_file" ] && [ ! -L "$token_file" ] || return 1
    metadata="$(/usr/bin/stat -f '%u %Lp' "$token_file" 2>/dev/null)" || return 1
    read -r owner mode <<< "$metadata"
    [ "$owner" = "$(/usr/bin/id -u)" ] && [ "$mode" = "600" ] || return 1
    IFS= read -r token < "$token_file" || true
    [ -n "$token" ] || return 1

    # The wrapper execs Pi, so $$ remains the session owner pid. Credentials
    # stay in the child environment, never in argv, MCP JSON, or disk config.
    export CMUX_CUA_SOCKET_AUTH_TOKEN="$token"
    export CMUX_PI_CUA_CLIENT="$client"
    export CMUX_PI_CUA_SOCKET="$CMUX_CUA_SOCKET_PATH"
    export CMUX_PI_CUA_SESSION="cmux-${CMUX_SURFACE_ID}"
    export CMUX_PI_CUA_STATE_DIR="${CMUX_CUA_STATE_DIR:-${HOME}/Library/Application Support/cmux/cmux-cua/runtime/${CMUX_CUA_RUNTIME_SCOPE:-${CMUX_TAG:-default}}/state}"
    cmux_pi_cua_args=(-e "$resource_dir/bin/cmux-pi-cua-extension.ts")
}
cmux_pi_cua_prepare || true

cmux_pi_managed_extension() {
    local candidate="$1"
    [ -f "$candidate" ] || return 1
    grep -q "cmux-pi-session-extension-marker" "$candidate" 2>/dev/null
}

cmux_pi_agent_dir="${PI_CODING_AGENT_DIR:-${HOME:-}/.pi/agent}"
if cmux_pi_managed_extension "$cmux_pi_agent_dir/extensions/cmux-session.ts" ||
   cmux_pi_managed_extension "$PWD/.pi/extensions/cmux-session.ts"; then
    exec "$cmux_pi" ${cmux_pi_cua_args[@]+"${cmux_pi_cua_args[@]}"} "$@"
fi

cmux_cli="${CMUX_BUNDLED_CLI_PATH:-}"
if [ -z "$cmux_cli" ] || [ ! -x "$cmux_cli" ]; then
    cmux_cli="$(command -v cmux 2>/dev/null || true)"
fi
if [ -z "$cmux_cli" ] || [ ! -x "$cmux_cli" ]; then
    exec "$cmux_pi" ${cmux_pi_cua_args[@]+"${cmux_pi_cua_args[@]}"} "$@"
fi

cmux_surface_tag="${CMUX_SURFACE_ID:-default}"
cmux_extension_root="${TMPDIR:-/tmp}/cmux-pi-extensions/$cmux_surface_tag"
cmux_extension="$cmux_extension_root/cmux-session.ts"
cmux_extension_tmp="$cmux_extension_root/.cmux-session.ts.$$"
if [ -s "$cmux_extension" ] && cmux_pi_managed_extension "$cmux_extension"; then
    # Refresh a valid per-surface copy when the bundled source changes. If the
    # CLI is temporarily unavailable, keep the last known-good copy.
    if "$cmux_cli" hooks pi extension-source >"$cmux_extension_tmp" 2>/dev/null &&
       cmux_pi_managed_extension "$cmux_extension_tmp"; then
        if ! cmp -s "$cmux_extension_tmp" "$cmux_extension"; then
            mv -f "$cmux_extension_tmp" "$cmux_extension"
            chmod 600 "$cmux_extension" 2>/dev/null || true
        else
            rm -f "$cmux_extension_tmp"
        fi
    else
        rm -f "$cmux_extension_tmp"
    fi
fi
if [ ! -s "$cmux_extension" ] || ! cmux_pi_managed_extension "$cmux_extension"; then
    if mkdir -p "$cmux_extension_root" &&
       "$cmux_cli" hooks pi extension-source >"$cmux_extension_tmp" 2>/dev/null &&
       cmux_pi_managed_extension "$cmux_extension_tmp"; then
        mv -f "$cmux_extension_tmp" "$cmux_extension"
        chmod 600 "$cmux_extension" 2>/dev/null || true
    else
        rm -f "$cmux_extension_tmp"
        exec "$cmux_pi" ${cmux_pi_cua_args[@]+"${cmux_pi_cua_args[@]}"} "$@"
    fi
fi

exec "$cmux_pi" ${cmux_pi_cua_args[@]+"${cmux_pi_cua_args[@]}"} -e "$cmux_extension" "$@"
