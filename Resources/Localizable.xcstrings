    "update.error.didNotStart.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على cmux بدء التحديث. تحقق من اتصالك بالإنترنت وحاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nije mogao pokrenuti ažuriranje. Provjerite internetsku vezu i pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux kunne ikke starte opdateringen. Kontrollér din internetforbindelse, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux konnte das Update nicht starten. Prüfe deine Internetverbindung und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux couldn’t start the update. Check your internet connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no pudo iniciar la actualización. Comprueba tu conexión a internet e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux n’a pas pu lancer la mise à jour. Vérifiez votre connexion Internet, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux non è riuscito ad avviare l’aggiornamento. Controlla la connessione a Internet e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmuxはアップデートを開始できませんでした。インターネット接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 업데이트를 시작할 수 없습니다. 인터넷 연결을 확인한 다음 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux kunne ikke starte oppdateringen. Kontroller internettforbindelsen og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nie mógł rozpocząć aktualizacji. Sprawdź połączenie z internetem i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux não conseguiu iniciar a atualização. Verifique sua conexão com a internet e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux не удалось запустить обновление. Проверьте подключение к интернету и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ไม่สามารถเริ่มการอัปเดตได้ ตรวจสอบการเชื่อมต่ออินเทอร์เน็ตแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux güncellemeyi başlatamadı. İnternet bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux не вдалося запустити оновлення. Перевірте підключення до інтернету й повторіть спробу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 无法开始更新。请检查互联网连接，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 無法開始更新。請檢查網際網路連線，然後再試一次。"
          }
        }
      }
    },
    "update.error.didNotStart.technicalDetails": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقفت محاولة التثبيت قبل بدء التنزيل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokušaj instalacije je zastao prije početka preuzimanja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Installationsforsøget stoppede, før download begyndte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Installationsversuch blieb stehen, bevor der Download begann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install attempt stalled without reaching download."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El intento de instalación se detuvo antes de iniciar la descarga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tentative d’installation s’est bloquée avant le téléchargement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tentativo di installazione si è bloccato prima del download."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールの試行はダウンロードに到達する前に停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치 시도가 다운로드 단계에 도달하기 전에 중단되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Installasjonsforsøket stoppet før nedlastingen startet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Próba instalacji zatrzymała się przed rozpoczęciem pobierania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tentativa de instalação travou antes de iniciar o download."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попытка установки остановилась до начала загрузки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความพยายามติดตั้งหยุดก่อนถึงขั้นตอนดาวน์โหลด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yükleme denemesi indirme aşamasına ulaşmadan takıldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спроба інсталяції зупинилася до початку завантаження."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装尝试在开始下载前停滞。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝嘗試在開始下載前停滯。"
          }
        }
      }
    },
