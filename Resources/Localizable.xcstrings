    "notifications.empty.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر إشعارات سطح المكتب هنا للمراجعة السريعة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavještenja na radnoj površini će se pojavljivati ovdje radi brzog pregleda."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivebordsnotifikationer vises her til hurtig gennemgang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop-Benachrichtigungen werden hier zur schnellen Überprüfung angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop notifications will appear here for quick review."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones de escritorio aparecerán aquí para su revisión rápida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications de bureau apparaîtront ici pour une consultation rapide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche desktop appariranno qui per una rapida consultazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップ通知がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데스크톱 알림이 여기에 표시되어 빠르게 확인할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivebordsvarsler vises her for rask gjennomgang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia pulpitu będą się tu pojawiać do szybkiego przeglądu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações da área de trabalho aparecerão aqui para revisão rápida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления рабочего стола будут отображаться здесь для быстрого просмотра."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนเดสก์ท็อปจะปรากฏที่นี่เพื่อตรวจสอบอย่างรวดเร็ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masaüstü bildirimleri hızlı inceleme için burada görünecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення робочого столу з'являтимуться тут для швидкого перегляду."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面通知将在此处显示，方便快速查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面通知將在這裡顯示，方便您快速查看。"
          }
        }
      }
    },
