        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配置已套用至工作區 %1$@（機器 %2$@），但目前尚無法在此開啟（%3$@）。請使用以下指令開啟：cmux vm workspace open %4$@ %5$@"
          }
        }
      }
    },
