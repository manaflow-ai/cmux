    "settings.terminal.agentHibernation.idleSeconds": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hibernate After Idle Seconds"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "休止までのアイドル秒数"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空闲多少秒后休眠"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Ruhezustand versetzen nach Sekunden im Leerlauf"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiberner après plusieurs secondes d'inactivité"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السبات بعد ثوانٍ من الخمول"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hibernar después de segundos de inactividad"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閒置指定秒數後休眠"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유휴 시간(초) 후 최대 절전"
          }
        }
      }
    },
    "settings.terminal.agentHibernation.idleSeconds.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A terminal must have no output and report an idle agent lifecycle for this long before it can be hibernated."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この時間だけ出力がなく、エージェントのライフサイクルがアイドルと報告された端末だけを休止できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端必须持续这么久没有输出并报告代理生命周期为空闲，才能被休眠。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Terminal darf keine Ausgabe haben und muss so lange einen inaktiven Agenten-Lebenszyklus melden, bevor es in den Ruhezustand versetzt werden kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un terminal ne doit produire aucune sortie et signaler un cycle de vie d’agent inactif pendant cette durée avant de pouvoir être hiberné."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب ألا تحتوي الطرفية على أي مخرجات وتُبلغ عن دورة حياة وكيل خاملة لهذه المدة قبل إدخالها في السبات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una terminal no debe tener salida y debe reportar un ciclo de vida de agente inactivo durante este tiempo antes de poder ser hibernada."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終端機必須在此期間內無任何輸出，且回報代理生命週期處於閒置狀態，才能進入休眠。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널은 최대 절전 모드로 전환되기 전에 출력물이 없고 에이전트 라이프사이클이 이 시간 동안 유휴 상태임을 보고해야 합니다."
          }
        }
      }
    },
    "settings.terminal.agentHibernation.maxLiveTerminals": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Max Live Agent Terminals"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブエージェント端末の上限"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最大活动代理终端数"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximale Anzahl aktiver Agenten-Terminals"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre max de terminaux d'agent actifs"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحد الأقصى للطرفيات النشطة للوكيل"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminales de agentes activas máximas"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "作用中代理終端機數量上限"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 활성 에이전트 터미널 수"
          }
        }
      }
    },
    "settings.terminal.agentHibernation.maxLiveTerminals.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visible terminals stay live. Extra idle background agent terminals hibernate oldest first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示中の端末はライブのままです。余分なアイドル中のバックグラウンドエージェント端末は古い順に休止します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可见的终端保持活动。多出的空闲后台代理终端按最旧优先休眠。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichtbare Terminals bleiben aktiv. Zusätzliche im Hintergrund befindliche, inaktive Agenten-Terminals werden beginnend mit dem ältesten in den Ruhezustand versetzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les terminaux visibles restent actifs. Les terminaux d’agent inactifs supplémentaires en arrière-plan hibernent en commençant par les plus anciens."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظل الطرفيات المرئية نشطة. وتدخل طرفيات الوكيل الخلفية الخاملة الإضافية في السبات، الأقدم أولاً."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las terminales visibles permanecen activas. Las terminales de agentes inactivas adicionales en segundo plano se hibernan empezando por la más antigua."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可見的終端機會保持作用中。超出上限的閒置背景代理終端機將從最舊的開始休眠。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면에 보이는 터미널은 활성 상태로 유지됩니다. 백그라운드에 있는 추가 유휴 에이전트 터미널은 오래된 순서대로 최대 절전 모드로 전환됩니다."
          }
        }
      }
    },
    "settings.terminal.agentHibernation.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled hibernation is off. During critical memory pressure, cmux may still hibernate safe idle background agents."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常の休止はオフです。メモリ負荷が危険な状態では、安全なアイドル中のバックグラウンドエージェントを cmux が休止する場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定时休眠已关闭。在内存压力临界时，cmux 仍可能休眠安全的空闲后台代理。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der geplante Ruhezustand ist deaktiviert. Bei kritischem Speicherengpass kann cmux dennoch im Hintergrund befindliche, inaktive Agenten sicher in den Ruhezustand versetzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’hibernation planifiée est désactivée. En cas de pression mémoire critique, cmux peut tout de même hiberner les agents en arrière-plan inactifs sûrs."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السبات المجدول متوقف. أثناء ضغط الذاكرة الحرج، قد يستمر cmux في إدخال وكلاء الخلفية الخاملين والآمنين في السبات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hibernación programada está desactivada. Durante una presión de memoria crítica, cmux aún puede hibernar agentes en segundo plano inactivos seguros."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排程休眠已關閉。當面臨緊急記憶體壓力時，cmux 仍可能會休眠安全且閒置的背景代理。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예약된 최대 절전 기능이 꺼져 있습니다. 다만 메모리가 극도로 부족할 때 cmux는 백그라운드에 있는 안전한 유휴 에이전트를 최대 절전 모드로 전환할 수 있습니다."
          }
        }
      }
    },
    "settings.terminal.agentHibernation.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Idle background agent terminals can be hibernated when the live-terminal limit is exceeded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ端末数の上限を超えると、アイドル状態のバックグラウンドエージェント端末を休止できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超出活动终端数量上限时，空闲的后台代理终端可以被休眠。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Hintergrund befindliche, inaktive Agenten-Terminals können in den Ruhezustand versetzt werden, wenn das Limit für aktive Terminals überschritten wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les terminaux d’agent en arrière-plan inactifs peuvent être hibernés lorsque la limite de terminaux actifs est dépassée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن إدخال طرفيات الوكيل الخلفية الخاملة في السبات عند تجاوز الحد الأقصى للطرفيات النشطة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las terminales de agentes inactivas en segundo plano se pueden hibernar cuando se supera el límite de terminales activas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當超出作用中終端機限制時，閒置的背景代理終端機可以進入休眠。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 터미널 한도를 초과하면 백그라운드의 유휴 에이전트 터미널을 최대 절전 모드로 전환할 수 있습니다."
          }
        }
      }
    },
    "settings.terminal.copyOnSelect": {
