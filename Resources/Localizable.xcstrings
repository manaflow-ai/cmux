          }
        }
      }
    },
    "settings.betaFeatures.sourceControl.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows Source Control in the right sidebar mode switcher for Git changes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Git の変更を表示するソース管理を右サイドバーのモード切り替えに表示します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض التحكم بالمصدر في مبدّل أوضاع الشريط الجانبي الأيمن لتغييرات Git."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje kontrolu izvornog koda u prebacivaču desne bočne trake za Git promjene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser kildekodekontrol i højre sidepanels tilstandsvælger for Git-ændringer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Quellcodeverwaltung im Modusumschalter der rechten Seitenleiste für Git-Änderungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el control de código fuente en el selector de modos de la barra lateral derecha para cambios de Git."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le contrôle de code source dans le sélecteur de modes de la barre latérale droite pour les modifications Git."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il controllo del codice sorgente nel selettore della barra laterale destra per le modifiche Git."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បង្ហាញការគ្រប់គ្រងកូដប្រភពក្នុងកម្មវិធីប្ដូររបៀបរបារចំហៀងខាងស្តាំសម្រាប់ការផ្លាស់ប្តូរ Git។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 변경 사항을 위해 오른쪽 사이드바 모드 전환기에 소스 제어를 표시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser kildekodekontroll i høyre sidepanels modusvelger for Git-endringer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje kontrolę kodu źródłowego w przełączniku trybu prawego paska bocznego dla zmian Git."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o controle de código-fonte no seletor de modo da barra lateral direita para alterações do Git."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает управление исходным кодом в переключателе режимов правой боковой панели для изменений Git."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงการควบคุมซอร์สโค้ดในตัวสลับโหมดแถบด้านขวาสำหรับการเปลี่ยนแปลง Git"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Git değişiklikleri için Kaynak Denetimini sağ kenar çubuğu mod seçicisinde gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує керування вихідним кодом у перемикачі режимів правої бічної панелі для змін Git."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在右侧边栏模式切换器中显示源代码管理以查看 Git 更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在右側邊欄模式切換器中顯示原始碼管理以查看 Git 變更。"
          }
        }
      }
