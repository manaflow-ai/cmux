          "stringUnit": {
            "state": "translated",
            "value": "تتم إدارة اشتراكك بواسطة نظام الفوترة السابق الخاص بنا. اتصل بالدعم لإجراء تغييرات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suscripción se gestiona a través de nuestro sistema de facturación anterior. Ponte en contacto con el soporte técnico para realizar cambios."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的訂閱由我們先前的計費系統所管理。如需進行變更，請聯絡支援團隊。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 구독은 이전 결제 시스템에서 관리됩니다. 변경하려면 고객 지원팀에 문의하세요."
          }
        }
      }
    },
