                  }
                }
              }
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le renommage du terminal a modifié %1$d de %#@count2@. Un autre changement a empêché un rétablissement sécurisé. Actualisez et réessayez."
          },
          "substitutions": {
            "count2": {
              "argNum": 2,
              "formatSpecifier": "d",
