    "socket.cloudVM.publication.invalidAccess": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ requires `accessMode` to be personal, team, or public."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の `accessMode` は personal、team、または public で指定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 要求 `accessMode` 为 personal、team 或 public。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erfordert, dass `accessMode` „personal“, „team“ oder „public“ ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ requiert que `accessMode` soit personal, team ou public."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب %@ أن يكون `accessMode` إما personal أو team أو public."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ requiere que `accessMode` sea personal, team o public."
          }
        },
        "zh-Hant": {
