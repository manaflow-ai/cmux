    "browser.externalOpenPrompt.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A web page in cmux wants to open a link in another app. You can stay in the browser instead."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux のウェブページが別のアプリでリンクを開こうとしています。代わりにブラウザに留まることもできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 中的网页想在其他应用中打开链接。你也可以留在浏览器中。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Webseite in cmux möchte einen Link in einer anderen App öffnen. Sie können stattdessen im Browser bleiben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une page Web dans cmux souhaite ouvrir un lien dans une autre application. Vous pouvez plutôt rester dans le navigateur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تريد صفحة ويب في cmux فتح رابط في تطبيق آخر. يمكنك البقاء في المتصفح بدلاً من ذلك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una página web en cmux quiere abrir un enlace en otra aplicación. Puedes permanecer en el navegador en su lugar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 中的網頁想要在其他應用程式中開啟連結。您也可以選擇留在瀏覽器中。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux의 웹 페이지가 다른 앱에서 링크를 열려고 합니다. 대신 브라우저에 계속 머무를 수 있습니다."
          }
        }
      }
    },
