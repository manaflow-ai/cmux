    "cloudTree.pane.retryHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close this pane and open it again from the sidebar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このペインを閉じて、サイドバーからもう一度開いてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请关闭此窗格，然后从侧边栏重新打开。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie dieses Teilfenster und öffnen Sie es erneut über die Seitenleiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez ce volet et ouvrez-le à nouveau depuis la barre latérale."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أغلق هذا الجزء وافتحه مجددًا من الشريط الجانبي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra este panel y ábrelo de nuevo desde la barra lateral."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉此窗格，並從側邊欄重新開啟它。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 분할 창을 닫고 사이드바에서 다시 여십시오."
          }
        }
      }
    },
    "cloudTree.pane.unsupportedHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This provider cannot open port previews. Do not retry; use `cmux vm exec` inside the machine or choose another machine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロバイダーはポートのプレビューを開けません。再試行せず、マシン内で `cmux vm exec` を使うか、別のマシンを選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此提供方无法打开端口预览。请不要重试；改在机器内使用 `cmux vm exec`，或换一台机器。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Anbieter kann keine Port-Vorschauen öffnen. Versuchen Sie es nicht erneut; verwenden Sie `cmux vm exec` innerhalb der Maschine oder wählen Sie eine andere Maschine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fournisseur ne peut pas ouvrir de prévisualisations de ports. Ne réessayez pas ; utilisez `cmux vm exec` à l’intérieur de la machine ou choisissez une autre machine."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لهذا المزود فتح معاينات المنفذ. لا تعد المحاولة؛ استخدم `cmux vm exec` داخل الجهاز أو اختر جهازًا آخر."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este proveedor no puede abrir vistas previas de puertos. No reintentes; usa `cmux vm exec` dentro de la máquina o elige otra máquina."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此提供者無法開啟連接埠預覽。請勿重試；請在機器內使用 `cmux vm exec` 或選擇其他機器。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로바이더는 포트 미리보기를 열 수 없습니다. 다시 시도하지 마십시오. 가상 머신 내부에서 `cmux vm exec`을 사용하거나 다른 가상 머신을 선택하십시오."
          }
        }
      }
    },
    "cloudTree.port.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@’s provider cannot open machine ports as previews; reach the service from inside the machine with `cmux vm exec %@ -- …`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のプロバイダーはマシンポートをプレビューとして開けません。`cmux vm exec %@ -- …` でマシン内からアクセスしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的提供方无法把机器端口作为预览打开；请在机器内用 `cmux vm exec %@ -- …` 访问该服务。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter von %@ kann keine Maschinen-Ports als Vorschau öffnen; greifen Sie von innerhalb der Maschine auf den Dienst zu mit `cmux vm exec %@ -- …`."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur de %@ ne peut pas ouvrir de ports de machine en tant qu'aperçus ; accédez au service depuis l'intérieur de la machine avec `cmux vm exec %@ -- …`."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لمزود %@ فتح منافذ الجهاز كمعاينات؛ يرجى الوصول إلى الخدمة من داخل الجهاز عبر `cmux vm exec %@ -- …`."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor de %@ no puede abrir puertos de máquina como vistas previas; accede al servicio desde dentro de la máquina con `cmux vm exec %@ -- …`."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的提供者無法將機器連接埠開啟為預覽；請在機器內部使用 `cmux vm exec %@ -- …` 來存取此服務。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 프로바이더는 가상 머신 포트를 미리보기로 열 수 없습니다. 가상 머신 내부에서 `cmux vm exec %@ -- …` 명령을 사용하여 서비스에 접속하십시오."
          }
        }
      }
    },
    "cloudTree.port.noLocalWorkspace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No local workspace is showing %@; select a workspace and retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を表示しているローカルワークスペースがありません。ワークスペースを選択して再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有本机工作区正在显示 %@；请先选择一个工作区再重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein lokaler Arbeitsbereich zeigt %@ an; wählen Sie einen Arbeitsbereich aus und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun espace de travail local n'affiche %@ ; sélectionnez un espace de travail et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مساحة عمل محلية تعرض %@؛ يرجى تحديد مساحة عمل وإعادة المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún espacio de trabajo local está mostrando %@; selecciona un espacio de trabajo e inténtalo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有本機工作區正在顯示 %@；請選取工作區並重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 보여주는 로컬 작업 공간이 없습니다. 작업 공간을 선택하고 다시 시도하십시오."
          }
        }
      }
    },
    "cloudTree.port.invalidMachine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ports can only be opened on a cloud machine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポートを開けるのは Cloud マシンのみです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口只能在云端机器上打开。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ports können nur auf einer Cloud-Maschine geöffnet werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ports ne peuvent être ouverts que sur une machine cloud."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن فتح المنافذ فقط على جهاز سحابي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los puertos solo se pueden abrir en una máquina en la nube."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只能在雲端機器上開啟連接埠。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포트는 클라우드 가상 머신에서만 열 수 있습니다."
