          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្មានការតភ្ជាប់អ៊ីនធឺណិត។ ភ្ជាប់ Wi-Fi ឬទិន្នន័យចល័ត រួចព្យាយាមម្ដងទៀត។"
          }
        },
        "nb": {
          "stringUnit": {
