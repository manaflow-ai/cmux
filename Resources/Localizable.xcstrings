    "cli.mobile.compatibleTags.applied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Granted Mac dev tags for paired phones: %@ (pushed to connected device(s))."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング済みの iPhone に許可した Mac 開発タグ: %@（接続中のデバイスへ送信済み）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已为配对的手机授权 Mac 开发标记：%@（已推送到已连接的设备）。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac-Entwickler-Tags für gekoppelte Telefone erteilt: %@ (an verbundene(s) Gerät(e) gesendet)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balises de développement Mac attribuées pour les téléphones jumelés : %@ (envoyées aux appareils connectés)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم منح علامات تطوير Mac للهواتف المقترنة: %@ (تم دفعها إلى الأجهزة المتصلة)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiquetas de desarrollo de Mac otorgadas para teléfonos emparejados: %@ (enviadas a los dispositivos conectados)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已為配對的手機授予 Mac 開發標記：%@ (已推送至已連線的裝置)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링된 휴대폰에 대한 Mac 개발자 태그 부여됨: %@ (연결된 기기로 푸시됨)."
          }
        }
      }
    },
