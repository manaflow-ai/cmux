    "cloudTunnel.error.deadlineExceeded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tunnel did not come up in time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トンネルが時間内に接続されませんでした。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tunnel wurde nicht rechtzeitig aufgebaut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tunnel ne s'est pas activé à temps."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تشغيل النفق في الوقت المحدد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El túnel no se activó a tiempo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通道未在時間內啟動。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隧道未能在规定时间内启动。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제한 시간 내에 터널이 연결되지 않았습니다."
          }
        }
      }
    },
    "cloudTunnel.error.linkDropped": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS reported the VPN as disconnected before it came up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が確立する前に macOS が VPN の切断を報告しました。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat gemeldet, dass die VPN-Verbindung getrennt wurde, bevor sie aufgebaut war."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a signalé que le VPN était déconnecté avant qu'il ne soit activé."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبلغ نظام macOS عن قطع اتصال VPN قبل أن يتم تشغيلها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS reportó la VPN como desconectada antes de que se activara."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 在 VPN 啟動前回報已中斷連線。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 在 VPN 启动前便报告其已断开连接。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터널이 연결되기 전에 macOS가 VPN 연결 해제를 보고했습니다."
          }
        }
      }
    },
    "cloudTunnel.error.linkStatusUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN status updates stopped arriving."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN の状態更新が届かなくなりました。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gingen keine VPN-Statusaktualisierungen mehr ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mises à jour de statut du VPN ont cessé d'arriver."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقفت تحديثات حالة VPN عن الوصول."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejaron de llegar actualizaciones de estado de la VPN."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 狀態更新已停止傳送。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 状态更新已停止接收。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 상태 업데이트 수신이 중단되었습니다."
          }
        }
      }
    },
    "cloudTunnel.error.genericFailure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux could not start the Cloud VPN. Try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux はクラウド VPN を開始できませんでした。もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux konnte das Cloud-VPN nicht starten. Versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux n'a pas pu démarrer le VPN Cloud. Réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتمكن cmux من بدء اتصال Cloud VPN. حاول مجددًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no pudo iniciar la VPN de la nube. Inténtelo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 無法啟動雲端 VPN。請再試一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 无法启动云 VPN。请重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 Cloud VPN을 시작할 수 없습니다. 다시 시도해 주세요."
          }
        }
      }
    },
    "cloudTunnel.error.vpnConfiguration": {
