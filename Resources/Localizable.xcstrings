    "simulator.failure.applicationMutationPreparation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Simulator worker could not release camera and inspector ownership of the app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulatorワーカーはアプリのカメラとインスペクタの所有権を解放できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟器工作进程无法释放该应用的摄像头和检查器占用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Simulator-Worker konnte die Kamera- und Inspektor-Berechtigungen der App nicht freigeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le worker Simulator n’a pas pu libérer la propriété de l’appareil photo et de l’inspecteur de l’application."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتمكن عامل الـ Simulator من تحرير ملكية الكاميرا والمفتش الخاصة بالتطبيق."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El worker del simulador no pudo liberar la propiedad de la cámara y del inspector de la aplicación."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator 工作者無法釋放該應用程式的相機與檢查器所有權。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시뮬레이터 워커가 앱의 카메라 및 검사기 소유권을 해제하지 못했습니다."
          }
        }
      }
    },
    "simulator.failure.cameraAdapterCapability": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
