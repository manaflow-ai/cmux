    "settings.app.fileEditorCurrentLineHighlight.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ميّز السطر الذي يحتوي على المؤشر عندما لا يوجد تحديد."
          }
        },
        "bs": {
          "stringUnit": {
