          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個用戶端已取代此裝置的位置路線。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 클라이언트가 이 기기의 위치 경로를 대체했습니다."
          }
        }
      }
    },
    "simulator.control.logIntervalInvalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The log interval must be positive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログの期間は正の値で指定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日志间隔必须为正数。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Protokollierungsintervall muss positiv sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’intervalle de journalisation doit être positif."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تكون الفترة الزمنية للسجل موجبة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El intervalo de registro debe ser positivo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "日誌間隔必須為正數。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그 간격은 양수여야 합니다."
          }
        }
      }
    },
    "simulator.control.nativeInputRequiresWorker": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native input actions require the isolated Simulator worker."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブ入力操作には分離されたSimulatorワーカーが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生输入操作需要隔离的模拟器工作进程。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Native Eingabeaktionen erfordern den isolierten Simulator-Worker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les actions de saisie natives nécessitent le worker Simulator isolé."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب إجراءات الإدخال الأصلية عامل الـ Simulator المعزول."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las acciones de entrada nativa requieren el worker aislado del simulador."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原生輸入動作需要隔離的 Simulator 工作者。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네이티브 입력 작업은 격리된 시뮬레이터 워커가 필요합니다."
          }
        }
      }
    },
    "simulator.control.privacyBundleIdentifierRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Granting or revoking privacy access requires a bundle identifier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライバシーアクセスの許可または取り消しにはバンドル識別子が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授予或撤销隐私访问权限需要提供包标识符。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gewähren oder Entziehen des Datenschutzzugriffs erfordert einen Bundle-Identifier."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’octroi ou la révocation de l’accès à la confidentialité nécessite un identifiant de bundle."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب منح أو إلغاء الوصول إلى الخصوصية معرف حزمة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otorgar o revocar el acceso de privacidad requiere un identificador de bundle."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許或撤銷隱私權存取需要 Bundle Identifier。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인정보 보호 권한을 허용하거나 취소하려면 번들 식별자가 필요합니다."
          }
        }
      }
    },
    "simulator.control.privacyServiceUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The active Xcode does not expose %@ through simctl; cmux will not mutate private TCC or BulletinBoard stores in the host process."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なXcodeはsimctl経由の%@に対応していません。cmuxはホストプロセスから非公開のTCCまたはBulletinBoardストアを変更しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 Xcode 未通过 simctl 暴露 %@；cmux 不会在宿主进程中修改私有的 TCC 或 BulletinBoard 存储。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das aktive Xcode gibt %@ nicht über simctl frei; cmux wird keine privaten TCC- oder BulletinBoard-Speicher im Host-Prozess ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version active de Xcode n'expose pas %@ via simctl ; cmux ne modifiera pas les bases de données privées TCC ou BulletinBoard du processus hôte."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يعرض Xcode النشط %@ عبر simctl؛ لن يقوم cmux بتعديل مخازن TCC أو BulletinBoard الخاصة في العملية المضيفة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Xcode activo no expone %@ a través de simctl; cmux no modificará los almacenes privados de TCC o BulletinBoard en el proceso host."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "作用中的 Xcode 未透過 simctl 揭露 %@；cmux 將不會修改主機程序中的私有 TCC 或 BulletinBoard 儲存庫。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화된 Xcode가 simctl을 통해 %@을(를) 노출하지 않습니다. cmux는 호스트 프로세스의 비공개 TCC 또는 BulletinBoard 저장소를 수정하지 않습니다."
          }
        }
      }
    },
    "simulator.control.statusBarValueOutOfRange": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %1$@ value must be from %2$lld through %3$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の値は%2$lldから%3$lldまでで指定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的值必须在 %2$lld 到 %3$lld 之间。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wert für %1$@ muss zwischen %2$lld und %3$lld liegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La valeur de %1$@ doit être comprise entre %2$lld et %3$lld."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تكون قيمة %1$@ من %2$lld إلى %3$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor de %1$@ debe estar entre %2$lld y %3$lld."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的值必須介於 %2$lld 至 %3$lld 之間。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 값은 %2$lld에서 %3$lld 사이여야 합니다."
          }
        }
      }
    },
