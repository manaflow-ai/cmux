    "computerUse.onboarding.dragHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag this app into the list in System Settings, turn it on, then come back here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリをシステム設定のリストにドラッグしてオンにし、ここに戻ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把这个应用拖到「系统设置」的列表里，打开它，然后回到这里。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie diese App in die Liste in den Systemeinstellungen, schalten Sie sie ein und kehren Sie dann hierher zurück."
