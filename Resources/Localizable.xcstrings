    "cli.browser.help.keyboardNaming": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Named keys follow Playwright/W3C names. Space, Spacebar, and space emit DOM key \" \" with code \"Space\"; --key ' ' passes the raw DOM key."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前付きキーは Playwright/W3C の名前に従います。Space、Spacebar、space は DOM key \" \" と code \"Space\" を送信し、--key ' ' では生の DOM key を渡せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "具名按键遵循 Playwright/W3C 命名。Space、Spacebar 和 space 会发出 DOM key \" \"，code 为 \"Space\"；--key ' ' 则直接传递原始 DOM key。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benannte Tasten folgen den Playwright/W3C-Namen. Space, Spacebar und space senden die DOM-Taste \" \" mit dem Code \"Space\"; --key ' ' übergibt die rohe DOM-Taste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches nommées suivent les noms de Playwright/W3C. Space, Spacebar et space émettent la touche DOM \" \" avec le code \"Space\" ; --key ' ' transmet la touche DOM brute."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبع المفاتيح المسماة أسماء Playwright/W3C. يصدر Space و Spacebar و space مفتاح DOM \" \" برمز \"Space\"؛ ويمرر --key ' ' مفتاح DOM الخام."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas con nombre siguen los nombres de Playwright/W3C. Space, Spacebar y space emiten la tecla DOM \" \" con el código \"Space\"; --key ' ' pasa la tecla DOM sin procesar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "具名按鍵遵循 Playwright/W3C 名稱。Space、Spacebar 和 space 會發出 DOM 鍵 \" \"，其 code 為 \"Space\"；--key ' ' 則傳遞原始 DOM 鍵。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름이 지정된 키는 Playwright/W3C 이름을 따릅니다. Space, Spacebar 및 space는 \"Space\" 코드와 함께 DOM 키 \" \"를 생성하며, --key ' '는 원시 DOM 키를 전달합니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Imenovani tasteri prate Playwright/W3C nazive. Space, Spacebar i space emituju DOM key \" \" s kodom \"Space\"; --key ' ' prosljeđuje sirovi DOM key."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Navngivne taster følger Playwright/W3C-navne. Space, Spacebar og space udsender DOM-tasten \" \" med koden \"Space\"; --key ' ' sender den rå DOM-tast."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I tasti con nome seguono le convenzioni Playwright/W3C. Space, Spacebar e space emettono il tasto DOM \" \" con codice \"Space\"; --key ' ' passa il tasto DOM grezzo."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្រាប់ចុចដែលមានឈ្មោះអនុវត្តតាមឈ្មោះ Playwright/W3C។ Space, Spacebar, និង space បំភាយ DOM key \" \" ដែលមាន code \"Space\"; --key ' ' បញ្ជូន DOM key ដើម។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Navngitte taster følger Playwright/W3C-navn. Space, Spacebar og space sender DOM-tasten \" \" med kode «Space»; --key ' ' sender den rå DOM-tasten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nazwane klawisze stosują nazwy Playwright/W3C. Space, Spacebar oraz space emitują klucz DOM \" \" z kodem \"Space\"; --key ' ' przekazuje surowy klucz DOM."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teclas nomeadas seguem os nomes Playwright/W3C. Space, Spacebar e space emitem a tecla DOM \" \" com código \"Space\"; --key ' ' passa a tecla DOM bruta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Именованные клавиши следуют именам Playwright/W3C. Space, Spacebar и space отправляют DOM-клавишу \" \" с кодом \"Space\"; --key ' ' передаёт исходную DOM-клавишу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ชื่อคีย์ตามชื่อ Playwright/W3C Space, Spacebar และ space ส่ง DOM key \" \" พร้อม code \"Space\"; --key ' ' ส่ง DOM key ดิบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adlandırılmış tuşlar Playwright/W3C adlarını izler. Space, Spacebar ve space; \"Space\" koduyla \" \" DOM tuşu gönderir; --key ' ' ham DOM tuşunu iletir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Іменовані клавіші відповідають назвам Playwright/W3C. Space, Spacebar та space генерують DOM-клавішу \" \" з кодом \"Space\"; --key ' ' передає необроблену DOM-клавішу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các phím được đặt tên theo quy tắc Playwright/W3C. Space, Spacebar và space phát sinh DOM key \" \" với code \"Space\"; --key ' ' truyền DOM key thô."
          }
        }
      }
    },
    "cli.browser.help.viewportEmulationDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emulate an exact 1...4096 CSS-pixel viewport inside the pane without resizing it"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペインのサイズを変更せず、正確な 1...4096 CSS ピクセルのビューポートをエミュレートします"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在窗格内模拟精确的 1...4096 CSS 像素视口，而不改变窗格大小"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Emuliert einen exakten CSS-Pixel-Viewport von 1...4096 im Teilfenster, ohne dessen Größe zu ändern"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Émuler une zone d’affichage CSS d’exactement 1...4096 pixels à l’intérieur du volet sans le redimensionner"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاكاة منفذ عرض بدقة بكسل CSS تتراوح بين 1...4096 داخل الجزء دون تغيير حجمه"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Emula un viewport exacto de 1...4096 píxeles CSS dentro del panel sin cambiar su tamaño"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在不調整窗格大小的情況下，於窗格內模擬精確的 1...4096 CSS 像素檢視區"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기를 조정하지 않고 분할 창 내부에서 정확히 1...4096 CSS 픽셀의 뷰포트를 에뮬레이션합니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Emulira tačan 1...4096 CSS-pixel viewport unutar okna bez promjene njegove veličine"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Emulér et præcist 1...4096 CSS-pixel-viewport inde i ruden uden at ændre størrelsen på den"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Emula un viewport CSS da 1...4096 pixel esatti all'interno del riquadro senza ridimensionarlo"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ក្លែងធ្វើ viewport CSS-pixel 1...4096 ពិតប្រាកដនៅក្នុង pane ដោយមិនប្ដូរទំហំវា"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Emulerer et nøyaktig 1...4096 CSS-piksel viewport inne i vinduet uten å endre størrelsen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Emuluj dokładny rzutnik CSS o wymiarach 1...4096 pikseli wewnątrz panelu bez zmiany jego rozmiaru"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Emula um viewport CSS de 1...4096 pixels exatos dentro do painel sem redimensioná-lo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Эмулирует точный viewport от 1 до 4096 CSS-пикселей внутри панели без её изменения"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "จำลอง viewport ขนาด 1...4096 CSS-pixel ภายใน pane โดยไม่ปรับขนาด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bölmeyi yeniden boyutlandırmadan içinde tam 1...4096 CSS-piksel viewport öykünmesi yapar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Емулювати точний вʼюпорт від 1 до 4096 CSS-пікселів у межах панелі без зміни її розміру"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Giả lập viewport CSS-pixel chính xác từ 1...4096 bên trong ngăn mà không thay đổi kích thước"
          }
        }
      }
    },
    "cli.browser.help.viewportPresentationDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page is aspect-fitted in the existing pane; reset restores native pane sizing"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページは既存のペイン内にアスペクトフィットされ、reset でペイン本来のサイズに戻ります"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面会按比例适配到现有窗格中；reset 可恢复窗格的原生尺寸"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seite wird seitenverhältnistreu in das bestehende Teilfenster eingepasst; Reset stellt die native Teilfenstergröße wieder her"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page est ajustée au format dans le volet existant ; la réinitialisation rétablit la taille d’origine du volet"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم ملائمة الصفحة مع الحفاظ على نسبة العرض إلى الارتفاع في الجزء الحالي؛ ويعيد reset حجم الجزء الأصلي"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La página se ajusta a la relación de aspecto en el panel existente; reset restaura el tamaño nativo del panel"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頁面會依比例適應現有的窗格；reset 會還原為原始的窗格尺寸"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지가 기존 분할 창에 가로세로 비율에 맞춰 채워집니다. reset은 원래의 분할 창 크기를 복원합니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stranica se prilagođava proporcijama u postojećem oknu; reset vraća nativnu veličinu okna"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Siden tilpasses billedformatet i den eksisterende rude; reset gendanner native rudestr størrelse"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La pagina viene adattata proporzionalmente nel riquadro esistente; reset ripristina il dimensionamento nativo del riquadro"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ទំព័រត្រូវបានបង្ហាញដោយអនុលោមតាមសមាមាត្រនៅក្នុង pane ដែលមានស្រាប់; reset ស្ដារការធ្វើទំហំ pane ដើម"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Siden tilpasses proporsjonalt i det eksisterende vinduet; reset gjenoppretter nativ vindustørrelse"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Strona jest dopasowywana proporcjonalnie do istniejącego panelu; reset przywraca natywne wymiary panelu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A página é ajustada proporcionalmente no painel existente; reset restaura o dimensionamento nativo do painel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Страница вписывается по соотношению сторон в существующую панель; reset восстанавливает исходный размер панели"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หน้าจะพอดีสัดส่วนใน pane ที่มีอยู่ reset คืนค่าขนาด pane ตามปกติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sayfa mevcut bölmeye en-boy oranı korunarak sığdırılır; reset yerel bölme boyutlandırmasını geri yükler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сторінка вміщується в існуючу панель зі збереженням пропорцій; reset відновлює рідний розмір панелі"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trang được khớp tỷ lệ trong ngăn hiện tại; reset khôi phục kích thước ngăn gốc"
          }
        }
      }
    },
    "cli.browser.help.viewportRenderLimitDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oversized viewport and page-zoom combinations return structured render-limit details"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きすぎるビューポートとページズームの組み合わせでは、レンダリング上限の詳細が構造化形式で返されます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视口与页面缩放的组合过大时，会返回结构化的渲染上限详情"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kombinationen aus übergroßem Viewport und Seiten-Zoom geben strukturierte Details zum Rendering-Limit zurück"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les combinaisons de zones d’affichage surdimensionnées et de zooms de page renvoient des détails structurés sur les limites de rendu"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجع تركيبات منفذ العرض وتكبير الصفحة ذات الحجم الكبير تفاصيل منظمة لحدود التصيير"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las combinaciones de viewport de gran tamaño y zoom de página devuelven detalles estructurados del límite de renderizado"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超出大小的檢視區與頁面縮放組合將傳回結構化的轉譯限制詳細資訊"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규격을 초과하는 뷰포트 및 페이지 배율 조합은 구조화된 렌더링 한계 상세 정보를 반환합니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prevelike kombinacije viewporta i zuma stranice vraćaju strukturirane detalje ograničenja renderiranja"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oversized viewport- og side-zoom-kombinationer returnerer strukturerede render-limit-detaljer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le combinazioni di viewport e zoom pagina eccessive restituiscono dettagli strutturati sul limite di rendering"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការរួមបញ្ចូលគ្នារវាង viewport ធំពេក និង page-zoom ត្រឡប់ព័ត៌មានលម្អិត render-limit ដែលមានរចនាសម្ព័ន្ធ"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oversized viewport og sidezoom-kombinasjoner returnerer strukturerte render-limit-detaljer"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kombinacje zbyt dużego rzutnika i powiększenia strony zwracają szczegółowe informacje o limicie renderowania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Combinações de viewport e zoom de página excessivos retornam detalhes estruturados de limite de renderização"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сочетания увеличенного viewport и масштаба страницы возвращают структурированные сведения об ограничениях рендеринга"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การรวม viewport ขนาดใหญ่และ page-zoom จะคืนข้อมูล render-limit แบบมีโครงสร้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aşırı büyük viewport ve sayfa-zoom kombinasyonları yapılandırılmış render-limit ayrıntıları döndürür"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Надмірні комбінації вʼюпорта та масштабу сторінки повертають структуровані деталі обмеження рендерингу"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các kết hợp viewport quá lớn và page-zoom trả về chi tiết giới hạn kết xuất có cấu trúc"
          }
        }
      }
    },
