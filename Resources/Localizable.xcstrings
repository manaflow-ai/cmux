    "featureFlags.footer.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local overrides apply only when no remote value is available."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカル上書きは、リモート値がない場合にのみ適用されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地覆盖项仅在没有远程值可用时生效。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Überschreibungen gelten nur, wenn kein Remote-Wert verfügbar ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les surcharges locales s’appliquent uniquement lorsqu’aucune valeur distante n’est disponible."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنطبق التجاوزات المحلية فقط في حال عدم توفر قيمة عن بعد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las anulaciones locales se aplican solo cuando no hay ningún valor remoto disponible."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在無可用遠端值時套用本機覆蓋。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 재정의는 원격 값을 사용할 수 없는 경우에만 적용됩니다."
          }
        }
      }
    },
    "featureFlags.mobileConnect.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the Tailscale Pairing button in the sidebar footer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーのフッターにTailscaleペアリングボタンを表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在侧边栏底部显示 Tailscale 配对按钮。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Tailscale-Kopplungstaste in der Fußzeile der Seitenleiste an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le bouton d’association Tailscale dans le pied de page de la barre latérale."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض زر اقتران Tailscale في تذييل الشريط الجانبي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el botón de emparejamiento de Tailscale en el pie de página de la barra lateral."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在側邊欄頁尾中顯示 Tailscale 配對按鈕。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이드바 하단에 Tailscale 페어링 버튼을 표시합니다."
          }
        }
      }
    },
