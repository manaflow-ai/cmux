    "cli.fork.error.noRecord": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: هذه الدورة ليس لديها ما يتفرع. قم بتشغيل الوكيل مرة أخرى في هذه المحطة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: ova sesija nema šta da se račva. Ponovo pokrenite agenta u ovom terminalu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: Denne session har ikke noget, der kan forkes. Start agenten igen i denne terminal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: Diese Sitzung hat nichts zu forken. Starten Sie den Agenten in diesem Terminal erneut."
          }
