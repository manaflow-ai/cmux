    "settings.automation.autoNamingAgent.requirement.auto": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each session is named by its own agent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各セッションはそのセッション自身のエージェントによって命名されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个会话由其自身的代理命名。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Sitzung wird von ihrem eigenen Agenten benannt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque session est nommée par son propre agent."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تسمية كل جلسة بواسطة العميل الخاص بها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada sesión es nombrada por su propio agente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個工作階段皆由其專屬代理程式命名。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 세션은 자체 에이전트에 의해 이름이 지정됩니다."
          }
        }
      }
    },
    "settings.automation.autoNamingAgent.requirement.supported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ names every session. Requires its CLI on your PATH; if it can't produce a name, existing names are left unchanged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がすべてのセッションを命名します。PATH にその CLI が必要です。名前を生成できない場合、既存の名前はそのまま保持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 为每个会话命名。需要其 CLI 在 PATH 中；如果无法生成名称，现有名称保持不变。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ benennt jede Sitzung. Erfordert das zugehörige CLI in Ihrem PATH; wenn kein Name generiert werden kann, bleiben bestehende Namen unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nomme chaque session. Nécessite sa CLI dans votre PATH ; s'il ne peut pas produire de nom, les noms existants restent inchangés."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم %@ بتسمية كل جلسة. يتطلب وجود واجهة خط الأوامر (CLI) الخاصة به في PATH الخاص بك؛ وإذا لم يتمكن من إنشاء اسم، تظل الأسماء الحالية دون تغيير."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nombra cada sesión. Requiere su CLI en tu PATH; si no puede generar un nombre, los nombres existentes no se modificarán."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 會命名每個工作階段。需要在您的 PATH 中有其 CLI；如果無法產生名稱，現有名稱將保持不變。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 모든 세션의 이름을 지정합니다. PATH에 해당 CLI가 있어야 합니다. 이름을 생성할 수 없는 경우 기존 이름은 변경되지 않은 상태로 유지됩니다."
          }
        }
      }
    },
    "settings.automation.autoNamingAgent.requirement.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can't generate names yet, so cmux uses each session's own agent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はまだ名前を生成できないため、cmux は各セッション自身のエージェントを使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 目前无法生成名称，因此 cmux 会使用每个会话自身的代理。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann noch keine Namen generieren, daher verwendet cmux den eigenen Agenten der jeweiligen Sitzung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne peut pas encore générer de noms, cmux utilise donc le propre agent de chaque session."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لـ %@ توليد أسماء بعد، لذا يستخدم cmux العميل الخاص بكل جلسة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aún no puede generar nombres, por lo que cmux utiliza el propio agente de cada sesión."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 目前還無法產生名稱，因此 cmux 會使用每個工作階段專屬的代理程式。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 아직 이름을 생성할 수 없으므로, cmux는 각 세션의 자체 에이전트를 사용합니다."
          }
        }
      }
    },
