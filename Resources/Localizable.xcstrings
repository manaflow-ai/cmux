    },
    "cloudTree.error.renameTerminalPartial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal rename changed %1$d of %#@count2@. Another change prevented a safe rollback. Refresh and retry."
          },
          "substitutions": {
            "count2": {
              "argNum": 2,
              "formatSpecifier": "d",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%d remote tab"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%d remote tabs"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルの名前変更により、%1$d個が変更されました（対象：%#@count2@）。別の変更により安全なロールバックが妨げられました。更新して再試行してください。"
          },
          "substitutions": {
            "count2": {
              "argNum": 2,
              "formatSpecifier": "d",
              "variations": {
