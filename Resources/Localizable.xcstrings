    },
    "account.signIn.error.cancelled.recovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No changes were made. Try again when you’re ready, or use the browser link below."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更はありません。準備ができたらもう一度試すか、下のブラウザリンクを使用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未做任何更改。准备好后可重试，或使用下方的浏览器链接。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurden keine Änderungen vorgenommen. Versuchen Sie es erneut, wenn Sie bereit sind, oder verwenden Sie den unten stehenden Browser-Link."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune modification n'a été apportée. Réessayez quand vous serez prêt, ou utilisez le lien de navigateur ci-dessous."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُجرَ أي تغييرات. أعد المحاولة عندما تكون مستعدًا، أو استخدم رابط المتصفح أدناه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se realizaron cambios. Vuelve a intentarlo cuando estés listo, o usa el enlace del navegador de abajo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未做任何變更。準備好時請再試一次，或使用下方的瀏覽器連結。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경된 사항이 없습니다. 준비가 되면 다시 시도하거나 아래의 브라우저 링크를 사용하세요."
          }
        }
      }
    },
    "account.signIn.error.cancelled.title": {
