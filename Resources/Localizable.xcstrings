    "auth.error.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No internet connection. Connect to Wi-Fi or cellular and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターネットに接続されていません。Wi-Fiまたはモバイル回線に接続して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无互联网连接。请连接 Wi-Fi 或蜂窝网络后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Internetverbindung. Stellen Sie eine Verbindung mit dem WLAN oder Mobilfunknetz her und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune connexion Internet. Connectez-vous au Wi-Fi ou au réseau cellulaire et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد اتصال بالإنترنت. اتصل بشبكة Wi-Fi أو الشبكة الخلوية وأعد المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión a internet. Conéctate a una red Wi-Fi o móvil e inténtalo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無網際網路連線。請連線至 Wi-Fi 或行動網路後再試一次。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터넷 연결이 없습니다. Wi-Fi 또는 셀룰러에 연결한 후 다시 시도해 주세요."
          }
        }
      }
    },
    "auth.error.server_error": {
