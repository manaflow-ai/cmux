    "cli.sshPtyAttach.incompatibleDaemon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH attach stopped because the remote daemon version does not match this cmux client. Install a cmux release with its matching remote daemon, then reconnect the workspace. Do not substitute a daemon from an older release."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートデーモンのバージョンがこの cmux クライアントと一致しないため、SSH 接続を停止しました。対応するリモートデーモンを含む cmux リリースをインストールしてから、ワークスペースに再接続してください。古いリリースのデーモンで代用しないでください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der SSH-Verbindungsaufbau wurde gestoppt, weil die Version des Remote-Daemons nicht zu diesem cmux-Client passt. Installiere eine cmux-Version mit dem zugehörigen Remote-Daemon und verbinde den Arbeitsbereich erneut. Verwende keinen Daemon einer älteren Version."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion SSH a été interrompue car la version du démon distant ne correspond pas à ce client cmux. Installez une version de cmux avec le démon distant correspondant, puis reconnectez l’espace de travail. Ne le remplacez pas par le démon d’une ancienne version."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف اتصال SSH لأن إصدار البرنامج الخفي البعيد لا يطابق عميل cmux هذا. ثبّت إصدار cmux مع البرنامج الخفي البعيد المطابق له، ثم أعد توصيل مساحة العمل. لا تستخدم برنامجًا خفيًا من إصدار أقدم."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión SSH se detuvo porque la versión del demonio remoto no coincide con este cliente cmux. Instala una versión de cmux con su demonio remoto correspondiente y vuelve a conectar el espacio de trabajo. No uses un demonio de una versión anterior."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 連線已停止，因為遠端常駐程式版本與此 cmux 用戶端不符。請安裝包含對應遠端常駐程式的 cmux 版本，再重新連線工作區。請勿使用舊版本的常駐程式替代。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 连接已停止，因为远程守护进程版本与此 cmux 客户端不匹配。请安装包含对应远程守护进程的 cmux 版本，然后重新连接工作区。请勿使用旧版本的守护进程替代。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 데몬 버전이 이 cmux 클라이언트와 일치하지 않아 SSH 연결을 중단했습니다. 해당 원격 데몬이 포함된 cmux 릴리스를 설치한 후 작업 공간에 다시 연결하세요. 이전 릴리스의 데몬으로 대체하지 마세요."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH spajanje je zaustavljeno jer verzija udaljenog daemona ne odgovara ovom cmux klijentu. Instalirajte cmux izdanje s odgovarajućim udaljenim daemonom, a zatim ponovo povežite radni prostor. Nemojte koristiti daemon iz starijeg izdanja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH-tilknytning stoppede, fordi den eksterne daemon-version ikke matcher denne cmux-klient. Installér en cmux-udgivelse med dens tilsvarende eksterne daemon, og tilslut derefter workspace igen. Erstat ikke en daemon fra en ældre udgivelse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il collegamento SSH è stato interrotto perché la versione del daemon remoto non corrisponde a questo client cmux. Installa una versione di cmux con il daemon remoto corrispondente, poi riconnetti il workspace. Non sostituire un daemon proveniente da una versione precedente."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH attach បានឈប់ ដោយសារកំណែ daemon នៅចម្ងាយមិនត្រូវគ្នានឹង cmux client នេះ។ ដំឡើង cmux release ដែលមាន daemon ផ្គូផ្គង រួចភ្ជាប់ workspace ឡើងវិញ។ កុំជំនួស daemon ពី release ចាស់។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH-tilkobling stoppet fordi versjonen av ekstern daemon ikke samsvarer med denne cmux-klienten. Installer en cmux-utgivelse med tilhørende ekstern daemon, og koble til arbeidsområdet på nytt. Ikke erstatt en daemon fra en eldre utgivelse."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dołączanie SSH zostało zatrzymane, ponieważ wersja zdalnego demona nie jest zgodna z tym klientem cmux. Zainstaluj wydanie cmux z pasującym zdalnym demonem, a następnie ponownie połącz obszar roboczy. Nie zastępuj demona z wcześniejszego wydania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O attach SSH foi interrompido porque a versão do daemon remoto não corresponde a este cliente cmux. Instale uma versão do cmux com seu daemon remoto correspondente e reconecte o workspace. Não substitua um daemon de uma versão anterior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH-подключение прервано: версия удалённого демона не совпадает с версией клиента cmux. Установите выпуск cmux с соответствующим удалённым демоном, затем переподключите рабочее пространство. Не заменяйте демон версией из более старого выпуска."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH attach หยุดทำงานเนื่องจากเวอร์ชัน daemon ระยะไกลไม่ตรงกับ cmux client นี้ ติดตั้ง cmux release พร้อม daemon ที่ตรงกัน จากนั้นเชื่อมต่อ workspace ใหม่ อย่าใช้ daemon จาก release เก่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH ekleme, uzak daemon sürümü bu cmux istemcisiyle eşleşmediği için durduruldu. Eşleşen uzak daemon'ıyla birlikte bir cmux sürümü yükleyin, ardından çalışma alanını yeniden bağlayın. Eski bir sürümden daemon kullanmayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH-підключення зупинено, оскільки версія віддаленого демона не збігається з цим клієнтом cmux. Встановіть випуск cmux із відповідним віддаленим демоном, а потім повторно підключіть робочий простір. Не замінюйте демон із старішого випуску."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH attach bị dừng do phiên bản remote daemon không khớp với cmux client này. Hãy cài đặt bản phát hành cmux kèm remote daemon tương ứng, sau đó kết nối lại workspace. Không thay thế daemon từ bản phát hành cũ hơn."
          }
        }
      }
    },
    "cli.sshPtyAttach.terminalModeFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH attach stopped because terminal input could not be placed in raw forwarding mode. Reconnect the workspace to try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナル入力を raw 転送モードに切り替えられなかったため、SSH 接続を停止しました。ワークスペースに再接続して再試行してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der SSH-Verbindungsaufbau wurde gestoppt, weil die Terminaleingabe nicht in den Raw-Weiterleitungsmodus wechseln konnte. Verbinde den Arbeitsbereich erneut, um es noch einmal zu versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion SSH a été interrompue car la saisie du terminal n’a pas pu passer en mode de transmission brute. Reconnectez l’espace de travail pour réessayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف اتصال SSH لتعذر وضع إدخال الطرفية في وضع التمرير الخام. أعد توصيل مساحة العمل للمحاولة مجددًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión SSH se detuvo porque la entrada del terminal no pudo pasar al modo de reenvío sin procesar. Vuelve a conectar el espacio de trabajo para intentarlo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 連線已停止，因為無法將終端機輸入切換為原始轉送模式。請重新連線工作區再試一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 连接已停止，因为无法将终端输入切换为原始转发模式。请重新连接工作区再试一次。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 입력을 원시 전달 모드로 전환할 수 없어 SSH 연결을 중단했습니다. 작업 공간에 다시 연결하여 재시도하세요."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH spajanje je zaustavljeno jer terminalni ulaz nije mogao biti postavljen u raw mod prosljeđivanja. Ponovo povežite radni prostor i pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH-tilknytning stoppede, fordi terminalinput ikke kunne sættes i rå videresendelsestilstand. Tilslut workspace igen for at prøve på ny."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il collegamento SSH è stato interrotto perché non è stato possibile impostare l'input del terminale in modalità di inoltro raw. Riconnetti il workspace per riprovare."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH attach បានឈប់ ដោយសារ terminal input មិនអាចដាក់ក្នុងរបៀប raw forwarding បាន។ ភ្ជាប់ workspace ឡើងវិញដើម្បីព្យាយាម។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH-tilkobling stoppet fordi terminalinndata ikke kunne settes i rå videresendingsmodus. Koble til arbeidsområdet på nytt for å prøve igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dołączanie SSH zostało zatrzymane, ponieważ nie można było przełączyć wejścia terminala w tryb surowego przekazywania. Ponownie połącz obszar roboczy, aby spróbować ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O attach SSH foi interrompido porque a entrada do terminal não pôde ser colocada em modo de encaminhamento raw. Reconecte o workspace para tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH-подключение прервано: не удалось перевести ввод терминала в режим прямой передачи. Переподключите рабочее пространство и попробуйте снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH attach หยุดทำงานเนื่องจากไม่สามารถตั้งค่า terminal input เป็นโหมด raw forwarding ได้ เชื่อมต่อ workspace ใหม่แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH ekleme, terminal girişi ham iletme moduna alınamadığı için durduruldu. Tekrar denemek için çalışma alanını yeniden bağlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH-підключення зупинено, оскільки термінальний ввід не вдалося перевести у режим необробленого пересилання. Повторно підключіть робочий простір і спробуйте знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH attach bị dừng do không thể đặt terminal input ở chế độ raw forwarding. Kết nối lại workspace để thử lại."
          }
        }
      }
    },
