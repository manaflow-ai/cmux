        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: la directory di lavoro salvata è inaccessibile. Ripristina l'accesso e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: 保存された作業ディレクトリにアクセスできません。アクセスを復元してから、再試行してください。"
