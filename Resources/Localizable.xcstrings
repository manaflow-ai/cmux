    "settings.browser.reactGrabVersion.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned npm version of react-grab injected by the toolbar button (Cmd+Shift+G). Only versions with a known integrity hash are accepted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールバーボタン（Cmd+Shift+G）で注入されるreact-grabのnpmバージョン。既知の整合性ハッシュを持つバージョンのみ使用可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 모음 버튼(Cmd+Shift+G)으로 주입되는 react-grab의 고정된 npm 버전입니다. 알려진 무결성 해시가 있는 버전만 허용됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具栏按钮（Cmd+Shift+G）注入的 react-grab 固定 npm 版本。仅接受具有已知完整性哈希的版本。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Festgepinnte npm-Version von react-grab, die über die Symbolleisten-Schaltfläche (Cmd+Shift+G) injiziert wird. Es werden nur Versionen mit einem bekannten Integritätshash akzeptiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Version npm épinglée de react-grab injectée par le bouton de la barre d’outils (Cmd+Shift+G). Seules les versions avec un hachage d’intégrité connu sont acceptées."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إصدار npm المثبت من react-grab والمحقون بواسطة زر شريط الأدوات (Cmd+Shift+G). تُقبل فقط الإصدارات التي تحتوي على ترميز تحقق من السلامة (integrity hash) معروف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Versión fijada de npm de react-grab inyectada por el botón de la barra de herramientas (Cmd+Shift+G). Solo se aceptan versiones con un hash de integridad conocido."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由工具列按鈕 (Cmd+Shift+G) 插入的固定 react-grab npm 版本。僅接受具有已知完整性雜湊值的版本。"
          }
        }
      }
    },
