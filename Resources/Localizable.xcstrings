    "cli.workflow.guidance.validate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Validate the JSON or JSONC, run cmux reload-config, and check the resulting entry point."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Validiere JSON oder JSONC, führe cmux reload-config aus und prüfe den resultierenden Einstiegspunkt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Validez le JSON ou JSONC, exécutez cmux reload-config et vérifiez le point d’accès obtenu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
