    "settings.networking.diagnostics.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The report stays on this Mac until you share it. It excludes terminal content, account and endpoint identities, network addresses, relay URLs, credentials, and raw errors."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレポートは共有するまでこの Mac にのみ保存されます。ターミナルの内容、アカウントおよびエンドポイントの識別情報、ネットワークアドレス、リレー URL、認証情報、生のエラーは含まれません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你分享之前，报告只保留在此 Mac 上。报告不含终端内容、账户和端点身份、网络地址、中继 URL、凭据以及原始错误。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bericht bleibt auf diesem Mac, bis Sie ihn teilen. Er schließt Terminal-Inhalte, Konto- und Endpunkt-Identitäten, Netzwerkadressen, Relay-URLs, Anmeldedaten und Rohfehler aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rapport reste sur ce Mac jusqu'à ce que vous le partagiez. Il exclut le contenu du terminal, les identités de comptes et de points de terminaison (endpoints), les adresses réseau, les URL des relais, les identifiants et les erreurs brutes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى التقرير على جهاز Mac هذا حتى تقوم بمشاركته. وهو يستبعد محتوى الطرفية، وهويات الحساب ونقاط النهاية، وعناوين الشبكة، وعناوين URL للمرحل، وبيانات الاعتماد، والأخطاء الخام."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El informe permanece en esta Mac hasta que lo compartas. Excluye el contenido de la terminal, las identidades de cuentas y puntos de conexión, las direcciones de red, las URL de retransmisión, las credenciales y los errores sin procesar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此報告在您分享之前會一直保留在此 Mac 上。報告中不包含終端機內容、帳戶與端點身分、網路地址、中繼 URL、憑證以及原始錯誤。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보고서는 공유하기 전까지 이 Mac에 보관됩니다. 터미널 콘텐츠, 계정 및 엔드포인트 식별 정보, 네트워크 주소, 릴레이 URL, 자격 증명 및 원시 에러는 제외됩니다."
          }
        }
      }
    },
