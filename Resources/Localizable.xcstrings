    "cli.cloud.domains.confirmPublic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public access lets anyone open %@ (VM %@, port %@). Continue? [y/N]"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開すると誰でも%@（VM %@、ポート%@）にアクセスできます。続けますか？[y/N]"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公开访问将允许任何人打开 %@（VM %@，端口 %@）。是否继续？[y/N]"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffentlicher Zugriff ermöglicht es jedem, %@ zu öffnen (VM %@, Port %@). Fortfahren? [j/N]"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès public permet à quiconque d’ouvrir %@ (VM %@, port %@). Continuer ? [y/N]"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمح الوصول العام لأي شخص بفتح %@ (الآلة الافتراضية VM %@، المنفذ %@). هل تريد الاستمرار؟ [y/N]"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso público permite que cualquiera abra %@ (VM %@, puerto %@). ¿Continuar? [s/N]"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "公開存取將允許任何人開啟 %@（虛擬機器 %@，連接埠 %@）。是否繼續？[y/N]"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공공 액세스를 허용하면 누구나 %@(VM %@, 포트 %@)을(를) 열 수 있습니다. 계속하시겠습니까? [y/N]"
          }
        }
      }
    },
