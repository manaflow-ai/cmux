        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចំណងជើងកន្លែងធ្វើការនឹងនៅលើបន្ទាត់តែមួយ ហើយត្រូវកាត់ឱ្យខ្លីនៅចុង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워크스페이스 제목은 한 줄로 유지되고 끝에서 잘립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeidsområdetitler vises på én linje og avkortes på slutten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tytuły obszarów roboczych pozostają w jednym wierszu i są ucinane na końcu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os títulos dos espaços de trabalho ficam em uma linha e são truncados no final."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Названия рабочих областей остаются в одной строке и обрезаются в конце."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
