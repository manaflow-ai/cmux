    "cli.session.move.error.liveOnSource": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "session move: the session is still running on %@; exit the agent at the end of its turn, then move it"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "session move: الجلسة لا تزال قيد التشغيل على %@؛ أغلق الوكيل عند نهاية دوره ثم انقلها"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "session move: Die Sitzung läuft noch auf %@; beende den Agenten am Ende seines Zuges und verschiebe sie dann"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "session move: la sesión sigue ejecutándose en %@; sal del agente al final de su turno y luego muévela"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "session move : la session s'exécute encore sur %@ ; quittez l'agent à la fin de son tour, puis déplacez-la"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "session move: セッションはまだ %@ で実行中です。ターンの終わりにエージェントを終了してから移動してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "session move: 세션이 아직 %@에서 실행 중입니다. 에이전트가 턴을 마치면 종료한 뒤 이동하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "session move：会话仍在 %@ 上运行；请在代理本轮结束后退出，再移动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "session move：此工作階段仍在 %@ 上執行；請在代理完成本輪後結束它，再移動"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "session move: sesija još uvijek radi na %@; izađi iz agenta na kraju njegove ture, pa je premjesti"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "session move: sessionen kører stadig på %@; afslut agenten ved slutningen af sin tur, og flyt den derefter"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "session move: la sessione è ancora in esecuzione su %@; esci dall'agente al termine del suo turno, poi spostala"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "session move: session នៅតែដំណើរការនៅ %@; ចេញពី agent នៅចុងវេននោះ ហើយផ្លាស់ទីវា"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "session move: økten kjører fortsatt på %@; avslutt agenten på slutten av turen, og flytt den deretter"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "session move: sesja jest nadal uruchomiona na %@; zakończ agenta po jego turze, a następnie przenieś ją"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "session move: a sessão ainda está em execução em %@; saia do agente ao fim do seu turno e então mova-a"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "session move: сессия ещё работает на %@; выйдите из агента по окончании его хода, затем выполните перемещение"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "session move: session ยังรันอยู่บน %@; ออกจาก agent เมื่อสิ้นสุด turn แล้วจึงย้าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "session move: oturum hâlâ %@ üzerinde çalışıyor; ajanın sırası bitince çıkın, sonra taşıyın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "session move: сесія ще виконується на %@; завершіть роботу агента в кінці його черги, потім перемістіть її"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "session move: phiên vẫn đang chạy trên %@; thoát agent khi hết lượt, rồi di chuyển"
          }
        }
      }
    },
    "cli.session.move.error.repositoryMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "session move: no checkout at %@ and no repository at %@ on the destination; clone it there first"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "session move: لا يوجد checkout في %1$@ ولا مستودع في %2$@ على الوجهة؛ انسخه (clone) هناك أولًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "session move: Am Ziel gibt es keinen Checkout unter %1$@ und kein Repository unter %2$@; klone es dort zuerst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "session move: no hay checkout en %1$@ ni repositorio en %2$@ en el destino; clónalo allí primero"
