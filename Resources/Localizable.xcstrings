        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى السر في وحدة التخزين الآمنة لهذا الجهاز ولا يتزامن أبدًا مع حسابك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El secreto permanece en el almacenamiento seguro de este dispositivo y nunca se sincroniza con tu cuenta."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此金鑰會保留在此裝置的安全儲存空間中，且絕不會與您的帳戶同步。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
