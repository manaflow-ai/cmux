    "machines.unavailable.stale": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud unreachable — showing last known"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドに接続できません — 最後の状態を表示中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端无法连接 —— 显示的是最后已知状态"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud nicht erreichbar – zeige letzten bekannten Stand"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud inaccessible — affichage des dernières informations connues"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الوصول إلى السحابة — يتم عرض آخر حالة معروفة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nube inaccesible — se muestra el último estado conocido"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線至雲端 — 顯示上次已知的狀態"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드에 연결할 수 없음 — 마지막으로 확인된 상태 표시 중"
          }
        }
      }
    },
    "machines.unavailable.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your machines are still there. cmux couldn’t reach the Cloud service just now; it retries on its own."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンはそのまま残っています。cmux は今クラウドサービスに接続できませんでした。自動的に再試行します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的机器都还在。cmux 此刻无法连接云端服务；它会自动重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Maschinen sind noch da. cmux konnte den Cloud-Dienst gerade nicht erreichen und versucht es selbstständig erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos machines sont toujours là. cmux n’a pas pu contacter le service Cloud à l’instant ; il va réessayer automatiquement."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أجهزتك لا تزال موجودة. تعذر على cmux الوصول إلى الخدمة السحابية الآن؛ سيتم إعادة المحاولة تلقائيًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus máquinas siguen ahí. cmux no pudo conectarse al servicio de la nube en este momento; volverá a intentarlo automáticamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的機器依然存在。cmux 剛才無法連線至雲端服務；它會自動重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머신은 그대로 유지됩니다. 현재 cmux가 클라우드 서비스에 연결할 수 없습니다. 자동으로 다시 시도합니다."
          }
        }
      }
    },
    "machines.unavailable.title": {
      "extractionState": "manual",
