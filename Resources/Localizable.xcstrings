          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] 遠端 PTY 已重新連線 (嘗試第 %s/%s 次)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] 원격 PTY가 재연결되었습니다 (시도 횟수: %s/%s)."
          }
        }
      }
    },
    "cli.sshPtyAttach.bridgeClosedSessionRunning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SSH terminal connection ended; the remote session may still be running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH ターミナル接続が終了しました。リモートセッションはまだ実行中の可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 终端连接已结束；远程会话可能仍在运行。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die SSH-Terminalverbindung wurde beendet; die Remote-Sitzung läuft möglicherweise noch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion du terminal SSH a pris fin ; la session distante est peut-être encore en cours d'exécution."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهى اتصال طرفية SSH؛ قد لا تزال الجلسة البعيدة قيد التشغيل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalizó la conexión de terminal SSH; es posible que la sesión remota aún se esté ejecutando."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 終端機連線已結束；遠端工作階段可能仍在執行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 터미널 연결이 종료되었습니다. 원격 세션은 계속 실행 중일 수 있습니다."
          }
        }
      }
    },
    "cli.sshPtyAttach.bridgeClosedSessionRunningReconnecting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SSH terminal connection ended while the remote session is still running; cmux is reconnecting."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH ターミナル接続が終了しましたが、リモートセッションは引き続き実行中です。再接続します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 终端连接已结束，但远程会话仍在运行；cmux 正在重连。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die SSH-Terminalverbindung wurde beendet, während die Remote-Sitzung noch läuft; cmux stellt die Verbindung wieder her."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion du terminal SSH a pris fin alors que la session distante est toujours en cours d'exécution ; cmux se reconnecte."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهى اتصال طرفية SSH بينما لا تزال الجلسة البعيدة قيد التشغيل؛ يقوم cmux بإعادة الاتصال."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalizó la conexión de terminal SSH mientras la sesión remota aún se está ejecutando; cmux se está reconectando."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 終端機連線已結束，但遠端工作階段仍在執行；cmux 正在重新連線。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 세션이 계속 실행 중인 상태에서 SSH 터미널 연결이 종료되었습니다. cmux가 재연결을 시도하고 있습니다."
          }
        }
      }
    },
    "cli.sshPtyAttach.bridgeClosedWithoutProgress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-pty-attach: bridge closed without receiving new output while the remote PTY session is still running"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-pty-attach: 新しい出力を受信しないままブリッジが閉じましたが、リモート PTY セッションは引き続き実行中です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-pty-attach：远程 PTY 会话仍在运行，但桥接在未收到新输出的情况下关闭"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-pty-attach: Brücke geschlossen, ohne dass neue Ausgaben empfangen wurden, während die Remote-PTY-Sitzung noch läuft"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-pty-attach : pont fermé sans recevoir de nouvelle sortie alors que la session PTY distante est toujours en cours d'exécution"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-pty-attach: تم إغلاق الجسر دون تلقي مخرجات جديدة بينما لا تزال جلسة PTY البعيدة قيد التشغيل"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-pty-attach: puente cerrado sin recibir nueva salida mientras la sesión remota de PTY aún se está ejecutando"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-pty-attach：遠端 PTY 工作階段仍在執行，但橋接器在未收到新輸出的情況下關閉"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-pty-attach: 원격 PTY 세션이 계속 실행 중인 상태에서 새로운 출력을 수신하지 못하고 브릿지가 닫혔습니다"
          }
        }
      }
    },
    "cli.sshPtyAttach.flushInputUsage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Internal SSH input flush does not accept arguments."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内部 SSH 入力フラッシュは引数を受け付けません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内部 SSH 输入清空命令不接受参数。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das interne Leeren der SSH-Eingabe akzeptiert keine Argumente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vidange interne des saisies SSH n'accepte aucun argument."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يقبل إفراغ إدخال SSH الداخلي وسيطات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La purga interna de entrada SSH no acepta argumentos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內部 SSH 輸入清除不接受引數。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내부 SSH 입력 플러시는 인수를 허용하지 않습니다."
          }
        }
      }
    },
    "cli.sshPtyAttach.flushInputFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH terminal input could not be discarded safely."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH ターミナルの入力を安全に破棄できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全丢弃 SSH 终端输入。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die SSH-Terminal-Eingabe konnte nicht sicher verworfen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La saisie du terminal SSH n'a pas pu être rejetée en toute sécurité."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تجاهل إدخال طرفية SSH بأمان."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La entrada de la terminal SSH no pudo ser descartada de forma segura."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法安全地捨棄 SSH 終端機輸入。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 터미널 입력을 안전하게 삭제할 수 없습니다."
          }
        }
      }
    },
    "cli.sshPtyAttach.noProgressRetryLimitReached.one": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] remote PTY bridge made no progress after %s attempt; stopping retries."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] リモート PTY ブリッジは %s 回試行しても進行しなかったため、再試行を停止します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] 远程 PTY 桥接在 %s 次尝试后仍无进展；停止重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] Die Remote-PTY-Brücke hat nach %s Versuch keine Fortschritte gemacht; Versuche werden gestoppt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] le pont PTY distant n'a pas progressé après %s tentative ; arrêt des tentatives."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] لم يحرز جسر PTY البعيد أي تقدم بعد محاولة واحدة (%s)؛ سيتم إيقاف محاولات إعادة الاتصال."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] el puente de PTY remoto no progresó después del intento %s; se detienen los reintentos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] 遠端 PTY 橋接器在嘗試 %s 次後仍無進展；停止重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] 원격 PTY 브릿지가 %s회 시도 후에도 전혀 응답하지 않아 재시도를 중단합니다."
          }
        }
      }
    },
    "cli.sshPtyAttach.noProgressRetryLimitReached.other": {
      "extractionState": "manual",
      "localizations": {
