    "cli.socketControlStatus.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستخدام: cmux socket-status [--json]\n\nاعرض سياسة مقبس التشغيل الآلي الفعّالة ومصدر الإدارة\nمن دون الاتصال بالمقبس. يظل هذا متاحًا عند إيقاف المقبس؛\nويُبلغ عن الإنفاذ المباشر على أنه غير ملاحظ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendung: cmux socket-status [--json]\n\nZeigt die effektive Automatisierungs-Socketrichtlinie und ihre\nVerwaltungsquelle ohne Socket-Verbindung. Verfügbar auch bei\ndeaktiviertem Socket; Live-Durchsetzung wird als nicht beobachtet gemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage: cmux socket-status [--json]\n\nPrint the effective automation socket policy and managed source\nwithout connecting to the socket. This remains available when\nthe socket is off; live enforcement is reported as unobserved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso: cmux socket-status [--json]\n\nMuestra la política efectiva del socket de automatización y su origen\ngestionado sin conectarse al socket. Sigue disponible con el socket\ndesactivado; la aplicación en vivo se informa como no observada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage : cmux socket-status [--json]\n\nAffiche la politique effective du socket d'automatisation et sa source\ngérée sans se connecter au socket. Disponible même lorsque le socket est\ndésactivé ; l'application en direct est indiquée comme non observée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用法: cmux socket-status [--json]\n\nソケットに接続せず、自動化ソケットの有効なポリシーと\n管理ソースを表示します。ソケットがオフでも利用でき、\n実行中の適用は未確認として表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용법: cmux socket-status [--json]\n\n소켓에 연결하지 않고 유효한 자동화 소켓 정책과 관리 소스를\n출력합니다. 소켓이 꺼져 있어도 사용할 수 있으며 실행 중 적용은\n확인되지 않음으로 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用法：cmux socket-status [--json]\n\n在不连接套接字的情况下输出有效的自动化套接字策略和管理来源\n套接字关闭时仍可使用；\n实时执行会报告为未观察到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用法：cmux socket-status [--json]\n\n不連線至 Socket，顯示有效的自動化 Socket 政策與管理來源\nSocket 關閉時仍可使用；\n即時執行會顯示為未觀察到。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upotreba: cmux socket-status [--json]\n\nPrikažite efektivnu politiku automatizacijskog socketa i izvor upravljanja\nbez povezivanja na socket. Dostupno je i kada\nje socket isključen; izvršavanje uživo prikazuje se kao neprovjereno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug: cmux socket-status [--json]\n\nVis den effektive politik for automatiseringssocket og den administrerede\nkilde uden at oprette forbindelse til socketen. Er også tilgængelig,\nnår socketen er slået fra; live-håndhævelse rapporteres som ikke observeret."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso: cmux socket-status [--json]\n\nMostra la politica effettiva del socket di automazione e l’origine\ngestita senza connettersi al socket. È disponibile anche quando il\nsocket è disattivato; l’applicazione live viene indicata come non osservata."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការប្រើប្រាស់៖ cmux socket-status [--json]\n\nបង្ហាញគោលការណ៍ socket ស្វ័យប្រវត្តិកម្មដែលមានប្រសិទ្ធភាព\nនិងប្រភពដែលគ្រប់គ្រង ដោយមិនភ្ជាប់ទៅ socket។\nអាចប្រើបាននៅពេល socket បិទផងដែរ; ការអនុវត្តផ្ទាល់ត្រូវបានរាយការណ៍ថាមិនបានសង្កេត។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk: cmux socket-status [--json]\n\nSkriv ut effektiv policy for automatiseringssocket og administrert kilde\nuten å koble til socketen. Dette fungerer også når\nsocketen er av; aktiv håndheving rapporteres som ikke observert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użycie: cmux socket-status [--json]\n\nWyświetla skuteczną zasadę gniazda automatyzacji i źródło\nzarządzania bez łączenia z gniazdem. Działa także przy\nwyłączonym gnieździe; aktywne egzekwowanie jest oznaczane jako nieobserwowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso: cmux socket-status [--json]\n\nExibe a política efetiva do socket de automação e a origem\ngerenciada sem conectar ao socket. Continua disponível quando o socket está\ndesligado; a aplicação em tempo real é indicada como não observada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использование: cmux socket-status [--json]\n\nПоказывает действующую политику сокета автоматизации и управляемый источник\nбез подключения к сокету. Доступно и при отключённом\nсокете; применение в реальном времени обозначается как ненаблюдаемое."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การใช้งาน: cmux socket-status [--json]\n\nแสดงนโยบายซ็อกเก็ตการทำงานอัตโนมัติและแหล่งที่มาที่จัดการอยู่โดยไม่เชื่อมต่อซ็อกเก็ต\nใช้ได้แม้ซ็อกเก็ตปิดอยู่\nการบังคับใช้แบบสดจะแสดงว่าไม่ได้สังเกต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanım: cmux socket-status [--json]\n\nOtomasyon soketinin etkin politikasını ve yönetilen\nkaynağı sokete bağlanmadan gösterir. Soket kapalıyken\nde kullanılabilir; canlı uygulama gözlemlenmedi olarak raporlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використання: cmux socket-status [--json]\n\nПоказує чинну політику сокета автоматизації та кероване\nджерело без підключення до сокета. Працює навіть коли\nсокет вимкнено; живе застосування позначається як не спостережене."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cách dùng: cmux socket-status [--json]\n\nIn ra chính sách automation socket và managed source hiện hành\nmà không kết nối tới socket. Lệnh này vẫn khả dụng khi\nsocket tắt; live enforcement được báo là chưa quan sát được."
          }
        }
      }
    },
