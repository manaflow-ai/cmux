        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Su %d terminal se cerrará con él. Para conservarla, usa “Cerrar espacio de trabajo” en su lugar — se moverá al grupo de terminales."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Sus %d terminales se cerrarán con él. Para conservarlas, usa “Cerrar espacio de trabajo” en su lugar — se moverán al grupo de terminales."
                }
