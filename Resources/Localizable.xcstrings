    "mobile.chat.error.sessionNotFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That agent session is no longer available."
          }
        },
        "ja": {
          "stringUnit": {
