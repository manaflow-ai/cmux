    "settings.configMutation.undoConflict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo preserved a newer choice. Review this setting before changing it:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消しでは新しい選択を保持しました。変更する前にこの設定を確認してください："
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neuere Auswahl wurde beim Rückgängigmachen beibehalten. Prüfen Sie diese Einstellung vor einer Änderung:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’annulation a conservé un choix plus récent. Vérifiez ce réglage avant de le modifier :"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservó una elección más reciente al deshacer. Revisa este ajuste antes de cambiarlo:"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ التراجع باختيار أحدث. راجع هذا الإعداد قبل تغييره:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销操作保留了较新的选择。更改前请检查此设置："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原操作保留了較新的選擇。變更前請檢查此設定："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 취소 시 더 최근의 선택을 유지했습니다. 변경하기 전에 이 설정을 검토하세요:"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poništavanje je sačuvalo noviji odabir. Pregledajte ovu postavku prije promjene:"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fortryd bevarede et nyere valg. Gennemgå denne indstilling, før du ændrer den:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'annullamento ha preservato una scelta più recente. Rivedi questa impostazione prima di modificarla:"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Undo បានរក្សាជម្រើសថ្មីជាង។ ពិនិត្យការកំណត់នេះ មុននឹងផ្លាស់ប្តូរ:"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Angre bevarte et nyere valg. Se gjennom denne innstillingen før du endrer den:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cofnięcie zachowało nowszy wybór. Sprawdź to ustawienie przed jego zmianą:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O desfazer preservou uma escolha mais recente. Revise esta configuração antes de alterá-la:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Отмена сохранила более новый выбор. Проверьте этот параметр перед изменением:"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การ Undo ได้รักษาตัวเลือกที่ใหม่กว่าไว้ ตรวจสอบการตั้งค่านี้ก่อนเปลี่ยน:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geri al, daha yeni bir seçimi korudu. Değiştirmeden önce bu ayarı inceleyin:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Скасування зберегло новіший вибір. Перегляньте це налаштування перед зміною:"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Undo đã giữ lại lựa chọn mới hơn. Xem lại cài đặt này trước khi thay đổi:"
          }
        }
      }
    },
    "settings.configMutation.invalidCandidate": {
      "localizations": {
