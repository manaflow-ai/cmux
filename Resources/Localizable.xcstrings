    "featureFlags.mobileTaskComposer.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enables the iOS New Task composer, including task model discovery, directory picking, and attachment staging."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSの新規タスク作成を有効にします。タスクモデル検出、ディレクトリ選択、添付ファイルのステージングを含みます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用 iOS 的「新建任务」编辑器，包括任务模型发现、目录选择与附件暂存。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviert den iOS-Composer für neue Aufgaben, einschließlich der Erkennung von Aufgabenmodellen, Verzeichnisauswahl und Bereitstellung von Anhängen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active le compositeur de nouvelles tâches iOS, y compris la découverte de modèles de tâches, la sélection de répertoires et la mise en attente (staging) des pièces jointes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكّن منشئ المهام الجديدة لنظام iOS، بما في ذلك اكتشاف نموذج المهمة، واختيار الدليل، وتجهيز المرفقات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilita el creador de nuevas tareas de iOS, incluido el descubrimiento de modelos de tareas, la selección de directorios y la preparación de archivos adjuntos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用 iOS 新增任務編輯器，包含任務模型探索、目錄選取及附件暫存。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 모델 탐색, 디렉터리 선택 및 첨부 파일 준비를 포함한 iOS 새 작업 작성기를 활성화합니다."
          }
        }
      }
    },
    "featureFlags.mobileTaskComposer.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
