          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il trasporto del terminale remoto deve essere SSH o Mosh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートターミナルのトランスポートは SSH または Mosh にする必要があります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មធ្យោបាយស្ថានីយពីចម្ងាយត្រូវតែជា SSH ឬ Mosh។"
