    },
    "simulator.failure.outgoingQueueOverflow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator input exceeded its bounded host queue; held input was released and the worker stopped."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator入力がホストの制限付きキューを超えたため、保持中の入力を解放してワーカーを停止しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟器输入超出了宿主队列上限；已释放暂存的输入，工作进程已停止。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Simulator-Eingabe hat ihre begrenzte Host-Warteschlange überschritten; die gehaltene Eingabe wurde freigegeben und der Worker wurde gestoppt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’entrée du Simulateur a dépassé sa file d’attente d’hôte délimitée ; l’entrée retenue a été libérée et le worker s’est arrêté."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجاوزت مدخلات الـ Simulator قائمة انتظار المضيف المحدودة الخاصة بها؛ وتم تحرير المدخلات المحتجزة وتوقف العامل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La entrada del simulador excedió su cola de host limitada; se liberó la entrada retenida y el worker se detuvo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator 輸入已超過其主機佇列上限；保留的輸入已被釋放，且工作者已停止。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시뮬레이터 입력이 제한된 호스트 대기열을 초과했습니다. 보관된 입력이 해제되고 워커가 중지되었습니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unos Simulatora je premašio ograničeni red hosta; zadržani unos je oslobođen i worker je zaustavljen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Simulator-input overskred den afgrænsede værtskø; tilbageholdt input blev frigivet og workeren stoppede."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'input del simulatore ha superato la coda host limitata; l'input trattenuto è stato rilasciato e il worker si è fermato."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Simulator input លើសដែនកំណត់ host queue; input ដែលបានរក្សាទុកត្រូវបានលែង ហើយកម្មករបានឈប់។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Simulator-inndata overskred den begrensede vertskøen; holdt inndata ble frigitt og arbeideren stoppet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wejście symulatora przekroczyło ograniczoną kolejkę hosta; wstrzymane wejście zostało zwolnione, a proces zatrzymany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A entrada do Simulator excedeu a fila limitada do host; a entrada retida foi liberada e o worker parou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ввод симулятора превысил ограниченную очередь хоста; удержанный ввод был освобождён, воркер остановлен."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อินพุต Simulator เกินคิวโฮสต์ที่จำกัด; อินพุตที่ค้างอยู่ถูกปล่อยและ worker หยุดทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Simülatör girişi sınırlı ana bilgisayar kuyruğunu aştı; tutulan giriş serbest bırakıldı ve işçi durdu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Введення симулятора перевищило обмежену чергу хоста; утримане введення було звільнено, а воркер зупинений."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đầu vào Simulator vượt quá hàng đợi máy chủ giới hạn; đầu vào đã giữ được giải phóng và tiến trình đã dừng."
          }
        }
      }
    },
    "simulator.failure.permissionBundleIdentifierRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private permission changes require an installed application bundle identifier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非公開の権限を変更するには、インストール済みアプリのバンドル識別子が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改私有权限需要提供已安装应用的包标识符。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Private Berechtigungsänderungen erfordern einen Bundle-Identifier einer installierten Anwendung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications de permissions privées nécessitent un identifiant de bundle d’application installée."
