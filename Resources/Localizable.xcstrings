    "socket.cloudVM.transportUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ offers no `%2$@` transport (its provider has no cmux-tui daemon route), so cmux cannot attach a terminal to it. %3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ には `%2$@` トランスポートがありません（プロバイダーに cmux-tui デーモンへの経路がないため）。そのため cmux はこのマシンにターミナルを接続できません。%3$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوفر %1$@ وسيلة نقل `%2$@` (ليس لدى المزود الخاص به مسار لبرنامج cmux-tui الخلفي)، لذا لا يمكن لـ cmux ربط طرفية به. %3$@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needsReview",
            "value": "%1$@ offers no `%2$@` transport (its provider has no cmux-tui daemon route), so cmux cannot attach a terminal to it. %3$@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needsReview",
            "value": "%1$@ offers no `%2$@` transport (its provider has no cmux-tui daemon route), so cmux cannot attach a terminal to it. %3$@"
          }
        },
        "de": {
          "stringUnit": {
