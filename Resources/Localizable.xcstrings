          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш Mac отправил тестовое уведомление в cmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ของคุณส่งการแจ้งเตือนทดสอบไปยัง cmux แล้ว"
