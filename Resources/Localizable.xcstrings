    "settings.app.paneFirstClickFocus.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When cmux is inactive, the first click only activates the window. Click again to focus the pane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmuxが非アクティブのとき、最初のクリックはウインドウをアクティブにするだけです。ペインにフォーカスするにはもう一度クリックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 비활성 상태일 때, 첫 번째 클릭은 윈도우만 활성화합니다. 패인을 포커스하려면 다시 클릭하세요."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли cmux неактивний, перший клік лише активує вікно. Клацніть ще раз, щоб сфокусувати панель."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 未激活时，第一次点击只会激活窗口。需再点击一次才能聚焦窗格。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn cmux inaktiv ist, aktiviert der erste Klick nur das Fenster. Klicken Sie erneut, um das Teilfenster zu fokussieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque cmux est inactif, le premier clic active uniquement la fenêtre. Cliquez à nouveau pour placer le focus sur le volet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يكون cmux غير نشط، فإن النقرة الأولى تنشط النافذة فقط. انقر مرة أخرى لتركيز الجزء."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando cmux está inactivo, el primer clic solo activa la ventana. Haz clic de nuevo para enfocar el panel."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 cmux 處於非作用中狀態時，第一次點擊僅會啟用視窗。再次點擊以聚焦窗格。"
          }
        }
      }
    },
    "settings.app.paneFirstClickFocus.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When cmux is inactive, clicking a pane activates the window and focuses that pane in one click."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmuxが非アクティブのとき、ペインをクリックすると1回でウインドウをアクティブにしてそのペインへフォーカスします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 비활성 상태일 때, 패인을 클릭하면 윈도우 활성화와 패인 포커스가 한 번에 이루어집니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли cmux неактивний, клік на панель активує вікно та фокусує панель одним кліком."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 未激活时，点击窗格会激活窗口并一次点击即聚焦该窗格。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn cmux inaktiv ist, aktiviert das Klicken auf ein Teilfenster das Fenster und fokussiert dieses Teilfenster mit einem einzigen Klick."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque cmux est inactif, cliquer sur un volet active la fenêtre et place le focus sur ce volet en un seul clic."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يكون cmux غير نشط، فإن النقر على جزء ينشط النافذة ويركز ذلك الجزء بنقرة واحدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando cmux está inactivo, hacer clic en un panel activa la ventana y enfoca ese panel con un solo clic."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 cmux 處於非作用中狀態時，點擊窗格會同時啟用視窗並聚焦該窗格。"
          }
        }
      }
    },
