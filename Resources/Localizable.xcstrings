    "cli.cloud.domains.dns.routingNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Routing: the apex record serves %@ itself; the * record serves every subdomain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルーティング: apex レコードは %@ 自体を、* レコードはすべてのサブドメインを配信します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "路由：裸域记录服务 %@ 本身；* 记录服务所有子域名。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Routing: Der Apex-Eintrag bedient %@ selbst; der *-Eintrag bedient jede Subdomain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Routage : l'enregistrement apex dessert %@ lui-même ; l'enregistrement * dessert tous les sous-domaines."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التوجيه: يخدم سجل الأوج (apex) %@ نفسه؛ ويخدم السجل * كل نطاق فرعي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enrutamiento: el registro apex sirve al propio %@; el registro * sirve a todos los subdominios."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "路由：apex 紀錄服務 %@ 本身；* 紀錄服務每個子網域。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라우팅: apex 레코드는 %@ 자체를 처리하고, * 레코드는 모든 하위 도메인을 처리합니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usmjeravanje: apex zapis služi sam %@; * zapis služi svaku poddomenu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Routing: apex-posten betjener %@ selv; *-posten betjener ethvert underdomæne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Routing: il record apex serve %@ direttamente; il record * serve tutti i sottodomini."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Routing: កំណត់ត្រា apex បម្រើ %@ ខ្លួនឯង; កំណត់ត្រា * បម្រើ subdomain ទាំងអស់។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ruting: apex-posten betjener %@ selv; *-posten betjener hvert subdomene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Routing: rekord apex obsługuje sam %@; rekord * obsługuje każdą subdomenę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Roteamento: o registro apex serve %@ em si; o registro * serve todos os subdomínios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Routing: apex-запись обслуживает %@ напрямую; запись * обслуживает все поддомены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Routing: apex record ให้บริการ %@ โดยตรง; * record ให้บริการทุก subdomain"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yönlendirme: apex kaydı %@'ın kendisine, * kaydı tüm alt etki alanlarına hizmet verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Маршрутизація: apex-запис обслуговує %@ безпосередньо; запис * обслуговує кожен піддомен."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Routing: bản ghi apex phục vụ %@ trực tiếp; bản ghi * phục vụ mọi subdomain."
          }
        }
      }
    },
