        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud VM コマンドがステータス %d で終了しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud VM 命令以状态码 %d 退出。"
