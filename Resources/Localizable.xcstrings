    "cli.help.notify.clear": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "--clear                Clear notifications for the resolved caller/target instead of posting"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "--clear                解決された呼び出し元／対象の通知を投稿せずに消去"
