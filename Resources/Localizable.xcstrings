        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: このエージェントセッションの別の起動がすでに始まっています。表示されるまで待つか、「cmux restore --surface」を再試行してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
