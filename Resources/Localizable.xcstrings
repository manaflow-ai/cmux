    "remote.state.suspended.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach %@ — automatic reconnect is paused. Use Reconnect when your network is back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に到達できないため、自動再接続を一時停止しました。ネットワーク復帰後に「再接続」を実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 연결할 수 없어 자동 재연결을 일시 중지했습니다. 네트워크가 복구되면 재연결을 사용하세요."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдається з'єднатися з %@ — автоматичне перепідключення призупинено. Скористайтеся «Перепідключити», коли мережа відновиться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问 %@ — 自动重连已暂停。网络恢复后请使用「重新连接」。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann nicht erreicht werden — die automatische Wiederverbindung ist pausiert. Verwenden Sie „Erneut verbinden“, wenn Ihr Netzwerk wieder aktiv ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de contacter %@ — la reconnexion automatique est suspendue. Utilisez Se reconnecter lorsque votre réseau sera rétabli."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن الوصول إلى %@ — تم تعليق إعادة الاتصال التلقائي مؤقتًا. استخدم \"إعادة الاتصال\" عندما تعود شبكتك للعمل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar a %@ — la reconexión automática está pausada. Usa Reconectar cuando tu red vuelva a estar disponible."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線至 %@ — 已暫停自動重新連線。請在網路恢復後使用「重新連線」。"
          }
        }
      }
    },
