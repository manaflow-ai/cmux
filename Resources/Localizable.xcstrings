    "settings.computerUse.enabled.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use runs locally in the bundled cmux Computer Use app. Its permissions and restart lifecycle are independent from cmux. Telemetry and update checks are disabled."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Useは、cmuxに同梱されたcmux Computer Useアプリでローカル実行されます。権限と再起動のライフサイクルはcmuxから独立しています。テレメトリと更新確認は無効です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use 在内置的 cmux Computer Use 应用中本地运行。它的权限与重启生命周期都独立于 cmux。遥测与更新检查均已禁用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use läuft lokal in der mitgelieferten cmux Computer Use-App. Ihre Berechtigungen und ihr Neustart-Lebenszyklus sind unabhängig von cmux. Telemetrie und Update-Prüfungen sind deaktiviert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use s’exécute localement dans l’application cmux Computer Use intégrée. Ses autorisations et son cycle de vie de redémarrage sont indépendants de cmux. La télémétrie et les vérifications de mise à jour sont désactivées."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تشغيل استخدام الكمبيوتر محلياً في تطبيق استخدام الكمبيوتر لـ cmux المضمن. أذوناته ودورة حياة إعادة تشغيله مستقلة عن cmux. تم تعطيل القياس البعدي وفحوصات التحديث."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use se ejecuta localmente en la aplicación integrada cmux Computer Use. Sus permisos y ciclo de vida de reinicio son independientes de cmux. La telemetría y las comprobaciones de actualizaciones están desactivadas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電腦操作於隨附的本機 cmux 電腦操作應用程式中執行。其權限和重新啟動生命週期與 cmux 獨立。遙測和更新檢查已停用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터 사용은 내장된 cmux 컴퓨터 사용 앱에서 로컬로 실행됩니다. 이 앱의 권한 및 재시작 수명 주기는 cmux와 독립적입니다. 텔레메트리 및 업데이트 확인은 비활성화되어 있습니다."
          }
        }
      }
    },
    "settings.computerUse.enabled.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New agent launches start without the computer-use tools, including in terminals that are already open."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに開いているターミナルも含め、新しく起動するエージェントはコンピュータ操作ツールなしで開始されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新启动的代理不再带 Computer Use 工具，已经打开的终端同样如此。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Agenten-Starts erfolgen ohne die Computer-Use-Tools, auch in bereits geöffneten Terminals."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lancements de nouveaux agents démarrent sans les outils computer-use, y compris dans les terminaux déjà ouverts."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدأ عمليات إطلاق العميل الجديدة بدون أدوات استخدام الكمبيوتر، بما في ذلك الطرفيات المفتوحة بالفعل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nuevos inicios de agentes se iniciarán sin las herramientas de uso de computadora, incluso en las terminales que ya estén abiertas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新啟動的代理程式將不包含電腦操作工具，這也包括已開啟的終端機。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 열려 있는 터미널을 포함하여 새로 시작하는 에이전트는 컴퓨터 사용 도구 없이 시작됩니다."
          }
        }
      }
    },
    "settings.computerUse.enabled.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supported agent sessions can see and drive apps on this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応するエージェントセッションがこのMac上のアプリを表示して操作できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受支持的代理会话可以查看并操作这台 Mac 上的应用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterstützte Agenten-Sitzungen können Apps auf diesem Mac sehen und steuern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sessions d’agent prises en charge peuvent voir et contrôler les applications sur ce Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لجلسات العملاء المدعومة رؤية وتشغيل التطبيقات على جهاز Mac هذا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sesiones de agentes compatibles pueden ver y controlar aplicaciones en este Mac."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援的代理程式工作階段可檢視並操作此 Mac 上的應用程式。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원되는 에이전트 세션은 이 Mac의 앱을 보고 제어할 수 있습니다."
          }
        }
      }
    },
