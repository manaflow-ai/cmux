    "cli.workflow.quick-agent-buttons.instantiate.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Quick Agent Buttons recipe, keep the agent actions you use, merge actions/ui into cmux.json, then run cmux reload-config."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorlage Quick Agent Buttons öffnen, benötigte Agentenaktionen behalten, actions/ui in cmux.json übernehmen und cmux reload-config ausführen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la recette Quick Agent Buttons, gardez les actions d’agent utilisées, ajoutez actions/ui à cmux.json, puis exécutez cmux reload-config."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la receta Quick Agent Buttons, conserva las acciones de agentes que uses, incorpora actions/ui en cmux.json y ejecuta cmux reload-config."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح وصفة Quick Agent Buttons، واحتفظ بإجراءات الوكلاء المستخدمة، وأضف actions/ui إلى cmux.json، ثم شغّل cmux reload-config."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Quick Agent Buttons 配方，保留使用的代理操作，将 actions/ui 合并到 cmux.json，然后运行 cmux reload-config。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 Quick Agent Buttons 配方，保留使用的代理動作，將 actions/ui 合併到 cmux.json，然後執行 cmux reload-config。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick Agent Buttons 설정 예제를 열고 사용하는 에이전트 작업을 남긴 뒤 actions/ui를 cmux.json에 병합하고 cmux reload-config를 실행하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick Agent Buttons レシピを開き、使用するエージェントアクションを残し、actions/ui を cmux.json に追加して cmux reload-config を実行します。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otvorite recept Quick Agent Buttons, zadržite akcije agenata koje koristite, spojite actions/ui u cmux.json, zatim pokrenite cmux reload-config."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åbn Quick Agent Buttons-opskriften, behold de agenthandlinger du bruger, flet actions/ui ind i cmux.json, og kør derefter cmux reload-config."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apri la ricetta Quick Agent Buttons, mantieni le azioni agente che usi, unisci actions/ui in cmux.json, poi esegui cmux reload-config."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បើក recipe Quick Agent Buttons, រក្សា action agent ដែលអ្នកប្រើ, បញ្ចូល actions/ui ក្នុង cmux.json, បន្ទាប់មកដំណើរការ cmux reload-config។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åpne quick-agent-buttons-oppskriften, behold agenthandlingene du bruker, slå actions/ui sammen med cmux.json, og kjør deretter cmux reload-config."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otwórz przepis Quick Agent Buttons, zachowaj akcje agentów, których używasz, scal actions/ui z cmux.json, a następnie uruchom cmux reload-config."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra a receita Quick Agent Buttons, mantenha as ações de agente que utiliza, mescle actions/ui em cmux.json e execute cmux reload-config."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Откройте рецепт Quick Agent Buttons, оставьте нужные действия агентов, объедините actions/ui с cmux.json, затем выполните cmux reload-config."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิด recipe Quick Agent Buttons เก็บ agent action ที่ใช้ รวม actions/ui เข้า cmux.json แล้วรัน cmux reload-config"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quick Agent Buttons tarifini açın, kullandığınız ajan eylemlerini saklayın, actions/ui bölümünü cmux.json ile birleştirin, ardından cmux reload-config komutunu çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відкрийте рецепт Quick Agent Buttons, залиште потрібні дії агентів, об'єднайте actions/ui з cmux.json, потім виконайте cmux reload-config."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mở recipe Quick Agent Buttons, giữ lại các hành động agent bạn dùng, hợp nhất actions/ui vào cmux.json, rồi chạy cmux reload-config."
          }
        }
      }
    },
