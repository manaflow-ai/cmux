    "settings.notifications.command.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run a shell command when a notification arrives. $CMUX_NOTIFICATION_TITLE, $CMUX_NOTIFICATION_SUBTITLE, $CMUX_NOTIFICATION_BODY are set."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知が届いたときにシェルコマンドを実行します。$CMUX_NOTIFICATION_TITLE、$CMUX_NOTIFICATION_SUBTITLE、$CMUX_NOTIFICATION_BODY が設定されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知到达时运行一条 shell 命令。会设置 $CMUX_NOTIFICATION_TITLE、$CMUX_NOTIFICATION_SUBTITLE、$CMUX_NOTIFICATION_BODY。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Shell-Befehl ausführen, wenn eine Benachrichtigung eingeht. $CMUX_NOTIFICATION_TITLE, $CMUX_NOTIFICATION_SUBTITLE und $CMUX_NOTIFICATION_BODY sind gesetzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécuter une commande shell lorsqu'une notification arrive. $CMUX_NOTIFICATION_TITLE, $CMUX_NOTIFICATION_SUBTITLE, $CMUX_NOTIFICATION_BODY sont définis."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتشغيل أمر غلاف (shell) عند وصول إشعار. يتم تعيين $CMUX_NOTIFICATION_TITLE و $CMUX_NOTIFICATION_SUBTITLE و $CMUX_NOTIFICATION_BODY."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta un comando de shell cuando llega una notificación. Se definen $CMUX_NOTIFICATION_TITLE, $CMUX_NOTIFICATION_SUBTITLE y $CMUX_NOTIFICATION_BODY."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當通知送達時執行 shell 指令。已設定 $CMUX_NOTIFICATION_TITLE、$CMUX_NOTIFICATION_SUBTITLE、$CMUX_NOTIFICATION_BODY 變數。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 도착했을 때 쉘 명령을 실행합니다. $CMUX_NOTIFICATION_TITLE, $CMUX_NOTIFICATION_SUBTITLE, $CMUX_NOTIFICATION_BODY가 설정됩니다."
          }
        }
      }
    },
