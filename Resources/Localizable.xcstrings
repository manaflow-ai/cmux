        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppdateringsserveren brukte for lang tid på å svare. Prøv igjen om et øyeblikk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer aktualizacji zbyt długo nie odpowiadał. Spróbuj ponownie za chwilę."
