          }
        }
      }
    },
    "settings.mobile.iOSPairingHost.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the Mac-side iOS pairing listener off until you enable it here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで有効にするまで、Mac 側の iOS ペアリングリスナーをオフにします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此处启用之前，Mac 端的 iOS 配对监听保持关闭。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält den iOS-Kopplungs-Listener auf der Mac-Seite deaktiviert, bis Sie ihn hier aktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintient l’écouteur de jumelage iOS côté Mac désactivé jusqu’à ce que vous l’activiez ici."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقي مستمع اقتران iOS من جانب جهاز Mac قيد الإيقاف حتى تقوم بتمكينه هنا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene desactivado el receptor de emparejamiento de iOS en el Mac hasta que lo habilite aquí."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持 Mac 端 iOS 配對接聽程式關閉，直到您在此處啟用它為止。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에서 활성화하기 전까지 Mac 측의 iOS 페어링 리스너를 비활성화 상태로 유지합니다."
          }
        }
      }
    },
    "settings.mobile.iOSPairingHost.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allows the iOS app to discover and sync with this Mac on your local network."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS アプリがローカルネットワーク上でこの Mac を検出し、同期できるようにします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 iOS 应用在本地网络中发现此 Mac 并与之同步。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermöglicht der iOS-App, diesen Mac im lokalen Netzwerk zu finden und mit ihm zu synchronisieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à l’application iOS de découvrir ce Mac et de se synchroniser avec lui sur votre réseau local."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح لتطبيق iOS اكتشاف جهاز Mac هذا والمزامنة معه على شبكتك المحلية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que la aplicación iOS descubra este Mac y se sincronice con él en su red local."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 iOS 應用程式在您的區域網路上偵測此 Mac 並與其同步。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 앱이 로컬 네트워크에서 이 Mac을 검색하고 동기화할 수 있도록 허용합니다."
          }
        }
      }
    },
    "settings.mobile.managedByOrganization": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote control from the iOS app is disabled by your organization."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS アプリからのリモート操作は組織によって無効化されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你所在组织已禁用来自 iOS 应用的远程控制。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fernsteuerung über die iOS-App ist von Ihrer Organisation deaktiviert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contrôle à distance depuis l’application iOS est désactivé par votre organisation."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تعطيل التحكم عن بُعد من تطبيق iOS بواسطة مؤسستك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su organización ha desactivado el control remoto desde la aplicación iOS."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的組織已停用來自 iOS 應用程式的遠端控制。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조직에서 iOS 앱의 원격 제어를 비활성화했습니다."
          }
        }
      }
    },
