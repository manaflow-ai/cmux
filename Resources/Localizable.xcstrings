    "settings.betaFeatures.cloudMachines.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides every Cloud Machines surface, and keeps the Cloud tunnel and fleet polling off, until you enable it here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで有効にするまで、クラウドマシンのすべての画面を非表示にし、クラウドトンネルとフリートのポーリングもオフのままにします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏云端机器的所有界面，并保持云端隧道和机群轮询关闭，直到你在此启用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet alle Oberflächen für Cloud-Maschinen aus und lässt den Cloud-Tunnel und die Flottenabfragen ausgeschaltet, bis Sie die Funktion hier aktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque toutes les interfaces des machines cloud et désactive le tunnel cloud ainsi que l’interrogation de la flotte jusqu’à ce que vous activiez cette option ici."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخفي جميع واجهات الأجهزة السحابية، ويبقي النفق السحابي والاستعلام الدوري عن الأسطول متوقفين حتى تفعّل هذه الميزة هنا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta todas las interfaces de Máquinas en la nube y mantiene desactivados el túnel en la nube y las consultas periódicas a la flota hasta que lo actives aquí."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏雲端機器的所有介面，並維持雲端通道與機群輪詢關閉，直到您在此啟用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에서 활성화할 때까지 모든 클라우드 머신 화면을 숨기고 클라우드 터널과 플릿 폴링을 꺼 둡니다."
          }
        }
      }
    },
    "settings.betaFeatures.cloudMachines.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows Cloud in the right sidebar plus the Cloud Machines settings, palette commands, and new-workspace entries."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右サイドバーにクラウドを表示し、クラウドマシンの設定、パレットコマンド、新規ワークスペースの項目も有効にします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在右侧边栏显示 Cloud，并显示云端机器设置、命令面板命令与新建工作区入口。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt „Cloud“ in der rechten Seitenleiste sowie die Cloud-Maschinen-Einstellungen, Palettenbefehle und Einträge für neue Arbeitsbereiche an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche Cloud dans la barre latérale droite ainsi que les paramètres de Machines cloud, les commandes de la palette et les entrées de nouvel espace de travail."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض السحابة في الشريط الجانبي الأيمن بالإضافة إلى إعدادات الأجهزة السحابية، وأوامر لوحة الأوامر، ومدخلات مساحة العمل الجديدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la nube en la barra lateral derecha además de la configuración de Máquinas en la nube, los comandos de la paleta y las entradas de nuevos espacios de trabajo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在右側側邊欄顯示「雲端」，並顯示雲端機器設定、命令面板指令以及新增工作區項目。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 사이드바에 클라우드를 표시하고 클라우드 머신 설정, 팔레트 명령 및 새 작업 공간 항목을 보여줍니다."
          }
        }
      }
    },
