        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクタイトルに非表示の制御文字または書式文字が含まれているため、cmux は使用を拒否しました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចំណងជើងតំណមានវត្ថុបញ្ជាដែលលាក់ ឬទម្រង់តួអក្សរ ដូច្នេះ cmux បដិសេធមិនប្រើវាទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크 제목에 숨겨진 제어 또는 서식 지정 문자가 포함되어 있어 cmux는 이를 사용을 거부했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koblingstittelen inneholder skjulte kontroll- eller formateringstegn, så cmux nektet å bruke den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tytuł linku zawiera ukryte znaki sterujące lub formatujące, więc cmux odmówił jego użycia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O título do link contém controles ocultos ou caracteres de formatação, então cmux se recusou a usá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовок ссылки содержит скрытые управляющие или форматирующие символы, поэтому cmux отказался его использовать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อลิงก์มีอักขระควบคุมหรือการจัดรูปแบบที่ซ่อนอยู่ ดังนั้น cmux จึงปฏิเสธที่จะใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı başlığı gizli kontrol veya biçimlendirme karakterleri içerdiğinden cmux bunu kullanmayı reddetti."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовок посилання містить приховані символи керування або форматування, тому cmux відмовився його використовувати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接标题包含隐藏的控制或格式字符，因此 cmux 拒绝使用它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結標題包含隱藏的控製或格式字符，因此 cmux 拒絕使用它。"
          }
        }
      }
    },
    "dialog.textURL.error.titleTooLong": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان الرابط طويل جدًا. الحد الأقصى للطول هو أحرف %lld."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naslov veze je predugačak. Maksimalna dužina je %lld znakova."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Linktitlen er for lang. Den maksimale længde er %lld tegn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Linktitel ist zu lang. Die maximale Länge beträgt %lld Zeichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link title is too long. The maximum length is %lld characters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El título del enlace es demasiado largo. La longitud máxima es caracteres %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le titre du lien est trop long. La longueur maximale est de caractères %lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il titolo del collegamento è troppo lungo. La lunghezza massima è di %lld caratteri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクタイトルが長すぎます。最大長は %lld 文字です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចំណងជើងតំណវែងពេក។ ប្រវែងអតិបរមាគឺតួអក្សរ %lld ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크 제목이 너무 깁니다. 최대 길이는 %lld 문자입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Linktittelen er for lang. Maksimal lengde er %lld tegn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tytuł linku jest za długi. Maksymalna długość to znaki %lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O título do link é muito longo. O comprimento máximo é de caracteres %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Название ссылки слишком длинное. Максимальная длина — %lld символов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อลิงก์ยาวเกินไป ความยาวสูงสุดคืออักขระ %lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı başlığı çok uzun. Maksimum uzunluk %lld karakterdir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва посилання задовга. Максимальна довжина – %lld символів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接标题太长。最大长度为 %lld 个字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結標題太長。最大長度為 %lld 個字元。"
          }
        }
      }
    },
