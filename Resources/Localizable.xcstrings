    "notifications.forwardToPhone.mode.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Away means the screen is locked or asleep, the screensaver is running, or there has been no keyboard or mouse input for %lld minute."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Away means the screen is locked or asleep, the screensaver is running, or there has been no keyboard or mouse input for %lld minutes."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "「離席中」とは、画面がロックまたはスリープ状態であるか、スクリーンセーバーが動作しているか、あるいはキーボードやマウスの入力が%lld分間ない状態を指します。"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“离开”是指屏幕已锁定或处于睡眠状态、屏幕保护程序正在运行，或者已持续 %lld 分钟没有键盘或鼠标输入。"
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Abwesend bedeutet, dass der Bildschirm gesperrt ist oder sich im Ruhezustand befindet, der Bildschirmschoner läuft oder seit %lld Minute keine Tastatur- oder Mauseingabe erfolgt ist."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Abwesend bedeutet, dass der Bildschirm gesperrt ist oder sich im Ruhezustand befindet, der Bildschirmschoner läuft oder seit %lld Minuten keine Tastatur- oder Mauseingabe erfolgt ist."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "« Absent » signifie que l’écran est verrouillé ou en veille, que l’économiseur d’écran fonctionne, ou qu’il n’y a eu aucune saisie au clavier ou à la souris pendant %lld minute."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "« Absent » signifie que l’écran est verrouillé ou en veille, que l’économiseur d’écran fonctionne, ou qu’il n’y a eu aucune saisie au clavier ou à la souris pendant %lld de minutes."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "« Absent » signifie que l’écran est verrouillé ou en veille, que l’économiseur d’écran fonctionne, ou qu’il n’y a eu aucune saisie au clavier ou à la souris pendant %lld minutes."
                }
              }
            }
          }
        },
        "ar": {
          "variations": {
            "plural": {
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "الغياب يعني أن الشاشة مقفلة أو في وضع السكون، أو أن شاشة التوقف قيد التشغيل، أو عدم وجود أي إدخال من لوحة المفاتيح أو الماوس لصفر دقيقة (%lld)."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "الغياب يعني أن الشاشة مقفلة أو في وضع السكون، أو أن شاشة التوقف قيد التشغيل، أو عدم وجود أي إدخال من لوحة المفاتيح أو الماوس لدقيقة واحدة (%lld)."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "الغياب يعني أن الشاشة مقفلة أو في وضع السكون، أو أن شاشة التوقف قيد التشغيل، أو عدم وجود أي إدخال من لوحة المفاتيح أو الماوس لدقيقتين (%lld)."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "الغياب يعني أن الشاشة مقفلة أو في وضع السكون، أو أن شاشة التوقف قيد التشغيل، أو عدم وجود أي إدخال من لوحة المفاتيح أو الماوس لمدة %lld دقائق."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "الغياب يعني أن الشاشة مقفلة أو في وضع السكون، أو أن شاشة التوقف قيد التشغيل، أو عدم وجود أي إدخال من لوحة المفاتيح أو الماوس لمدة %lld دقيقة."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "الغياب يعني أن الشاشة مقفلة أو في وضع السكون، أو أن شاشة التوقف قيد التشغيل، أو عدم وجود أي إدخال من لوحة المفاتيح أو الماوس لمدة %lld دقيقة."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ausente significa que la pantalla está bloqueada o en reposo, el salvapantallas está activo o no ha habido actividad del teclado o del ratón durante %lld minuto."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ausente significa que la pantalla está bloqueada o en reposo, el salvapantallas está activo o no ha habido actividad del teclado o del ratón durante %lld minutos."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ausente significa que la pantalla está bloqueada o en reposo, el salvapantallas está activo o no ha habido actividad del teclado o del ratón durante %lld minutos."
                }
              }
            }
          }
        },
        "zh-Hant": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "「離開」代表螢幕已鎖定或進入睡眠、螢幕保護程式正在執行，或是已達 %lld 分鐘沒有鍵盤或滑鼠輸入。"
                }
              }
            }
          }
        },
        "ko": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "자리 비움은 화면이 잠겼거나 대기 상태일 때, 화면 보호기가 실행 중일 때, 또는 %lld분 동안 키보드나 마우스 입력이 없을 때를 의미합니다."
                }
              }
            }
          }
        }
      }
    },
    "notifications.forwardToPhone.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل إشعارات الوكيل إلى تطبيق cmux على iPhone. تكون الميزة متوقفة افتراضيًا، ولا يتم رفع أي شيء إلا عند تشغيلها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šalji obavještenja agenata u cmux aplikaciju za iPhone. Isključeno je po zadanim postavkama; ništa se ne šalje dok ovo ne uključite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Send agentnotifikationer til cmux-appen på iPhone. Funktionen er slået fra som standard; intet uploades, medmindre den er slået til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentenmitteilungen an die cmux-App auf dem iPhone senden. Standardmäßig deaktiviert; ohne Aktivierung wird nichts hochgeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send local agent notifications to cmux on your iPhone. Enabled by default; turn this off to stop this Mac from forwarding them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía notificaciones de agentes a la app cmux del iPhone. Está desactivado de forma predeterminada; no se carga nada a menos que lo actives."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez les notifications des agents à l’app cmux sur iPhone. Cette option est désactivée par défaut ; rien n’est téléversé tant qu’elle ne l’est pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia le notifiche degli agenti all’app cmux per iPhone. L’opzione è disattivata per impostazione predefinita; non viene caricato nulla finché non la attivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルエージェントの通知を iPhone の cmux に送信します。デフォルトでオンです。この Mac からの転送を停止するにはオフにしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្ញើការជូនដំណឹងរបស់ភ្នាក់ងារទៅកម្មវិធី cmux លើ iPhone។ មុខងារនេះបិទតាមលំនាំដើម ហើយគ្មានអ្វីត្រូវបានផ្ទុកឡើងទេ លុះត្រាតែអ្នកបើកវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 알림을 iPhone용 cmux 앱으로 보냅니다. 기본적으로 꺼져 있으며, 이 설정을 켜기 전에는 아무것도 업로드되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Send agentvarslinger til cmux-appen på iPhone. Funksjonen er av som standard; ingenting lastes opp med mindre den er slått på."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyłaj powiadomienia agentów do aplikacji cmux na iPhonie. Funkcja jest domyślnie wyłączona; nic nie jest przesyłane, dopóki jej nie włączysz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie notificações dos agentes ao app cmux no iPhone. O recurso vem desativado; nada é enviado até que você o ative."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправлять уведомления агентов в приложение cmux на iPhone. По умолчанию выключено; данные не загружаются, пока вы не включите эту функцию."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งการแจ้งเตือนของเอเจนต์ไปยังแอป cmux บน iPhone ปิดไว้ตามค่าเริ่มต้น และจะไม่มีการอัปโหลดข้อมูลจนกว่าจะเปิดใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aracı bildirimlerini iPhone’daki cmux uygulamasına gönderir. Varsayılan olarak kapalıdır; açılmadıkça hiçbir şey yüklenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилати сповіщення агентів у застосунок cmux на iPhone. Типово вимкнено; нічого не завантажується, доки ви не ввімкнете цю функцію."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将代理通知发送到 iPhone 上的 cmux App。默认关闭；只有开启后才会上传内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將代理程式通知傳送到 iPhone 上的 cmux App。預設關閉；只有開啟後才會上傳內容。"
          }
        }
      }
    },
