    "settings.networking.check.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux automatically uses direct internet, LAN, or any VPN route available to macOS, then falls back to an allowed relay. Every route remains end-to-end encrypted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux は macOS で利用可能なインターネット、LAN、または任意の VPN 経路を自動的に使用し、必要に応じて許可されたリレーへ切り替えます。すべての経路でエンドツーエンド暗号化が維持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 会自动使用 macOS 可用的直连、局域网或任意 VPN 路由，再回退到已放行的中继。所有路由都保持端到端加密。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux verwendet automatisch direktes Internet, LAN, oder jede für macOS verfügbare VPN-Route und weicht dann auf ein zugelassenes Relay aus. Jede Route bleibt Ende-zu-Ende verschlüsselt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux utilise automatiquement une connexion Internet directe, un réseau local ou toute route VPN disponible pour macOS, puis se rabat sur un relais autorisé. Chaque route reste chiffrée de bout en bout."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم cmux تلقائيًا الإنترنت المباشر أو الشبكة المحلية (LAN) أو أي مسار VPN متاح لنظام macOS، ثم يتراجع إلى مرحل مسموح به. يظل كل مسار مشفرًا بالكامل من البداية إلى النهاية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux utiliza automáticamente internet directa, LAN o cualquier ruta VPN disponible para macOS, y luego recurre a una retransmisión permitida. Cada ruta permanece cifrada de extremo a extremo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 會自動使用 macOS 可用的直接網際網路、區域網路 (LAN) 或任何 VPN 路由，接著在無法連線時改用允許的中繼。所有路由皆維持端到端加密。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux는 자동으로 macOS에서 사용 가능한 직접 인터넷, LAN 또는 임의의 VPN 경로를 사용한 후 허용된 릴레이로 대체 적용합니다. 모든 경로는 종단간 암호화 상태를 유지합니다."
          }
        }
      }
    },
