        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب تغييرات الأذونات الخاصة معرف حزمة تطبيق مثبت."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios de permisos privados requieren un identificador de bundle de aplicación instalada."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變更私有權限需要已安裝應用程式的 Bundle Identifier。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 권한 변경에는 설치된 애플리케이션 번들 식별자가 필요합니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Privatne promjene dozvola zahtijevaju identifikator paketa instalirane aplikacije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Private tilladelsesændringer kræver en bundle-identifikator for en installeret applikation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le modifiche ai permessi privati richiedono un identificatore bundle di un'applicazione installata."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការផ្លាស់ប្តូរសិទ្ធិ private ត្រូវការ bundle identifier របស់ application ដែលបានដំឡើង។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Private tillatelsesendringer krever en installert applikasjons-bunke-identifikator."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prywatne zmiany uprawnień wymagają identyfikatora pakietu zainstalowanej aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alterações de permissão privadas requerem um identificador de bundle de aplicativo instalado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Изменение приватных разрешений требует идентификатора пакета установленного приложения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การเปลี่ยนแปลงสิทธิ์ส่วนตัวต้องการ bundle identifier ของแอปที่ติดตั้งแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Özel izin değişiklikleri için yüklü bir uygulama paket tanımlayıcısı gereklidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Зміна приватних дозволів потребує ідентифікатора пакету встановленого застосунку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thay đổi quyền riêng tư yêu cầu mã bundle identifier của ứng dụng đã cài đặt."
          }
        }
      }
    },
    "simulator.failure.permissionMutationCapability": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The active Xcode worker did not negotiate a safe adapter for %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なXcodeワーカーは%@用の安全なアダプタに対応していません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 Xcode 工作进程未为 %@ 协商安全适配器。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktive Xcode-Worker hat keinen sicheren Adapter für %@ ausgehandelt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'exécuteur Xcode actif n'a pas négocié d'adaptateur sécurisé pour %@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتفاوض عامل Xcode النشط على محول آمن لـ %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El worker activo de Xcode no negoció un adaptador seguro para %@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "作用中的 Xcode 工作者未針對 %@ 協調安全轉接器。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화된 Xcode 워커가 %@을(를) 위한 안전한 어댑터를 협상하지 못했습니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktivni Xcode worker nije pregovarao sigurni adapter za %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den aktive Xcode-worker forhandlede ikke en sikker adapter for %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il worker Xcode attivo non ha negoziato un adapter sicuro per %@."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កម្មករ Xcode សកម្មបានបដិសេធការចរចា adapter សុវត្ថិភាពសម្រាប់ %@។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den aktive Xcode-arbeideren forhandlet ikke en sikker adapter for %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktywny proces Xcode nie wynegocjował bezpiecznego adaptera dla %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O worker ativo do Xcode não negociou um adaptador seguro para %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Активный воркер Xcode не согласовал безопасный адаптер для %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode worker ที่ใช้งานอยู่ไม่ได้เจรจา adapter ที่ปลอดภัยสำหรับ %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Etkin Xcode işçisi %@ için güvenli bağdaştırıcıyı müzakere etmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Активний воркер Xcode не узгодив безпечний адаптер для %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiến trình Xcode đang hoạt động không thương lượng được bộ điều hợp an toàn cho %@."
          }
        }
      }
    },
