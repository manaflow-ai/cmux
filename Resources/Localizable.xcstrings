          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CMUX hat die Konfiguration dieser Erweiterung nicht rechtzeitig erhalten. Es werden keine Arbeitsbereichsdaten oder Aktionen geteilt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CMUX n’a pas reçu la configuration de cette extension à temps. Aucune donnée d’espace de travail ni aucune action ne sont partagées."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتلقَ CMUX تكوين هذا الامتداد في الوقت المحدد. لا تتم مشاركة أي بيانات لمساحة العمل أو إجراءات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CMUX no recibió la configuración de esta extensión a tiempo. No se están compartiendo datos ni acciones del espacio de trabajo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CMUX 未及時收到此擴充功能的設定。未分享任何工作區資料或動作。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CMUX가 제시간에 이 확장 프로그램의 구성을 받지 못했습니다. 작업 공간 데이터나 작업이 공유되지 않습니다."
          }
