    "socket.workspace.remote.terminalProfile.invalid": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تفتح الطرفية البعيدة صدفة أو جلسة tmux مسماة صالحة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Udaljeni terminal mora otvoriti ljusku ili važeću imenovanu tmux sesiju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjernterminalen skal åbne en shell eller en gyldig navngivet tmux-session."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Remote-Terminal muss eine Shell oder eine gültige benannte tmux-Sitzung öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote terminal must open a shell or a valid named tmux session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El terminal remoto debe abrir un shell o una sesión tmux válida con nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le terminal distant doit ouvrir un shell ou une session tmux nommée valide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il terminale remoto deve aprire una shell o una sessione tmux denominata valida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートターミナルではシェルまたは有効な名前付き tmux セッションを開く必要があります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ស្ថានីយពីចម្ងាយត្រូវបើក shell ឬ tmux session មានឈ្មោះត្រឹមត្រូវ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 터미널은 셸 또는 유효한 이름의 tmux 세션을 열어야 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjernterminalen må åpne et skall eller en gyldig navngitt tmux-økt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdalny terminal musi otworzyć powłokę lub poprawną nazwaną sesję tmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O terminal remoto deve abrir um shell ou uma sessão tmux nomeada válida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалённый терминал должен открывать оболочку или допустимый именованный сеанс tmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เทอร์มินัลระยะไกลต้องเปิด shell หรือ tmux session ที่มีชื่อถูกต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzak terminal bir kabuk veya geçerli bir adlandırılmış tmux oturumu açmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Віддалений термінал має відкривати оболонку або дійсний іменований сеанс tmux."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程终端必须打开 shell 或有效的命名 tmux 会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端終端必須開啟 shell 或有效的具名 tmux 工作階段。"
