    "settings.automation.kiro.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks must be installed with `cmux hooks kiro install`, then run Kiro with `kiro-cli chat --agent cmux` (or set it as your default agent). They no-op outside cmux terminals."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フックは`cmux hooks kiro install`でインストールし、Kiroを`kiro-cli chat --agent cmux`で起動（またはデフォルトエージェントに設定）してください。cmuxターミナル外では動作しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`cmux hooks kiro install`로 훅을 설치한 다음 `kiro-cli chat --agent cmux`로 Kiro를 실행(또는 기본 에이전트로 설정)하세요. cmux 터미널 외부에서는 작동하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须用 `cmux hooks kiro install` 安装钩子，然后用 `kiro-cli chat --agent cmux` 运行 Kiro（或将其设为默认代理）。它们在 cmux 终端之外不生效。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks müssen mit `cmux hooks kiro install` installiert werden, führen Sie Kiro dann mit `kiro-cli chat --agent cmux` aus (oder legen Sie es als Standardagent fest). Sie haben außerhalb von cmux-Terminals keine Funktion (no-op)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les hooks doivent être installés avec `cmux hooks kiro install`, puis exécutez Kiro avec `kiro-cli chat --agent cmux` (ou définissez-le comme agent par défaut). Ils n’ont aucun effet en dehors des terminaux cmux."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب تثبيت الخطافات باستخدام `cmux hooks kiro install` ثم تشغيل Kiro عبر `kiro-cli chat --agent cmux` (أو تعيينه كعميلك الافتراضي). وهي لا تؤدي أي وظيفة خارج طرفيات cmux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ganchos se deben instalar con `cmux hooks kiro install`, luego ejecute Kiro con `kiro-cli chat --agent cmux` (o establézcalo como su agente predeterminado). No realizan ninguna operación fuera de las terminales de cmux."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必須透過 `cmux hooks kiro install` 安裝 Hook，然後使用 `kiro-cli chat --agent cmux` 執行 Kiro（或將其設定為您的預設代理程式）。它們在 cmux 終端機外不會執行任何操作。"
          }
        }
      }
    },
