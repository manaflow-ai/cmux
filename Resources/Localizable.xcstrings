    "update.error.failed.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong while checking for updates. Try again, or check the update log for details."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートの確認中に問題が発生しました。もう一度お試しいただくか、アップデートログをご確認ください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查更新时出现问题。请重试，或查看更新日志了解详情。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Suchen nach Updates ist ein Fehler aufgetreten. Versuche es erneut oder prüfe das Update-Protokoll für Details."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur est survenue lors de la recherche de mises à jour. Réessayez ou consultez le journal des mises à jour pour plus de détails."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ ما أثناء التحقق من وجود تحديثات. حاول مجددًا، أو تحقق من سجل التحديثات لمزيد من التفاصيل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocurrió un error al buscar actualizaciones. Inténtalo de nuevo o consulta el registro de actualizaciones para obtener más detalles."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查更新時發生錯誤。請再試一次，或查看更新記錄以取得詳細資訊。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트를 확인하는 동안 문제가 발생했습니다. 다시 시도하거나 자세한 내용은 업데이트 로그를 확인해 주세요."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nešto je pošlo po krivu prilikom provjere ažuriranja. Pokušaj ponovo ili provjeri zapis ažuriranja za detalje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noget gik galt under søgning efter opdateringer. Prøv igen, eller se opdateringsloggen for detaljer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si è verificato un errore durante la ricerca di aggiornamenti. Riprova o controlla il log degli aggiornamenti per i dettagli."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មានបញ្ហាកើតឡើងពេលពិនិត្យការអាប់ដេត។ សូមព្យាយាមម្តងទៀត ឬពិនិត្យកំណត់ហេតុការអាប់ដេតសម្រាប់ព័ត៌មានលម្អិត។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noe gikk galt under søk etter oppdateringer. Prøv igjen, eller sjekk oppdateringsloggen for detaljer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wystąpił błąd podczas sprawdzania aktualizacji. Spróbuj ponownie lub sprawdź dziennik aktualizacji, aby uzyskać szczegóły."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Algo deu errado ao verificar atualizações. Tente novamente ou consulte o log de atualizações para mais detalhes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Что-то пошло не так при проверке обновлений. Попробуйте ещё раз или просмотрите журнал обновлений для получения подробной информации."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เกิดข้อผิดพลาดขณะตรวจสอบอัปเดต ลองอีกครั้ง หรือดูบันทึกการอัปเดตเพื่อดูรายละเอียด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Güncellemeler denetlenirken bir sorun oluştu. Tekrar deneyin veya ayrıntılar için güncelleme günlüğünü inceleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Під час перевірки оновлень сталася помилка. Спробуйте ще раз або перегляньте журнал оновлень для деталей."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã xảy ra sự cố khi kiểm tra cập nhật. Hãy thử lại hoặc xem log cập nhật để biết chi tiết."
          }
        }
      }
    },
