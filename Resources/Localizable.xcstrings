    "settings.computerUse.permission.accessibility.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets cmux Computer Use inspect and control app interfaces."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Computer Useがアプリのインターフェースを確認して操作できるようにします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 cmux Computer Use 能够检查并控制应用界面。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermöglicht es cmux Computer Use, App-Oberflächen zu prüfen und zu steuern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à cmux Computer Use d’inspecter et de contrôler les interfaces des applications."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمح لميزة استخدام الكمبيوتر لـ cmux بفحص واجهات التطبيق والتحكم فيها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite a cmux Computer Use inspeccionar y controlar las interfaces de las aplicaciones."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 cmux 電腦操作檢查與控制應用程式介面。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 컴퓨터 사용이 앱 인터페이스를 검사하고 제어할 수 있도록 허용합니다."
          }
        }
      }
    },
