    },
    "sudo.cli.timeout.approved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: request %@ was approved, but execution did not complete before the timeout"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: リクエスト %@ は承認されましたが、タイムアウトまでに実行が完了しませんでした"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: Anfrage %@ wurde genehmigt, aber die Ausführung wurde vor dem Timeout nicht abgeschlossen"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: تمت الموافقة على طلب %@، ولكن لم يكتمل التنفيذ قبل انتهاء المهلة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: zahtjev %@ je odobren, ali izvršenje nije završeno prije isteka vremena"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo:request%@ blev godkendt, men udførelsen blev ikke gennemført før timeouten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: se aprobó la solicitud %@, pero la ejecución no se completó antes del tiempo de espera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo : la demande %@ a été approuvée, mais l'exécution n'a pas été terminée avant l'expiration du délai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: la richiesta %@ è stata approvata, ma l'esecuzione non è stata completata prima del timeout"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo៖ សំណើ %@ ត្រូវបានអនុម័ត ប៉ុន្តែការប្រតិបត្តិមិនបានបញ្ចប់មុនពេលអស់ពេលនោះទេ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: forespørsel %@ ble godkjent, men utførelse ble ikke fullført før tidsavbruddet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: żądanie %@ zostało zatwierdzone, ale wykonanie nie zostało zakończone przed upływem limitu czasu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: a solicitação %@ foi aprovada, mas a execução não terminou antes do tempo limite"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: запрос %@ был одобрен, но выполнение не завершилось до истечения времени ожидания."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: คำขอ %@ ได้รับการอนุมัติแล้ว แต่การดำเนินการไม่เสร็จสมบูรณ์ก่อนหมดเวลา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: %@ isteği onaylandı ancak yürütme zaman aşımından önce tamamlanmadı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: запит %@ схвалено, але виконання не завершилося до закінчення часу очікування"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo：请求%@已批准，但在超时之前执行未完成"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo：請求%@已批准，但在逾時之前執行未完成"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: %@ 요청이 승인되었지만 시간 초과 전에 실행이 완료되지 않았습니다."
          }
        }
      }
    },
    "sudo.cli.error.runner_context": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: could not start secure execution; retry from a cmux terminal"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: 安全な実行を開始できませんでした。cmux ターミナルから再試行してください"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: konnte die sichere Ausführung nicht starten; von einem cmux-Terminal aus erneut versuchen"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: تعذر بدء التنفيذ الآمن؛ أعد المحاولة من محطة cmux"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: nije moguće pokrenuti sigurno izvršenje; pokušajte ponovo sa terminala cmux"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: kunne ikke starte sikker udførelse; prøv igen fra en cmux terminal"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: no se pudo iniciar la ejecución segura; reintentar desde un terminal cmux"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo : impossible de démarrer l'exécution sécurisée ; réessayer depuis un terminal cmux"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: impossibile avviare l’esecuzione sicura; riprova da un terminale cmux"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo៖ មិនអាចចាប់ផ្តើមការប្រតិបត្តិប្រកបដោយសុវត្ថិភាពបានទេ។ ព្យាយាមម្តងទៀតពីស្ថានីយ cmux"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: kunne ikke starte sikker kjøring; prøv på nytt fra en cmux-terminal"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: nie można rozpocząć bezpiecznego wykonywania; spróbuj ponownie z terminala cmux"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: não foi possível iniciar a execução segura; tente novamente em um terminal cmux"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: не удалось запустить безопасное выполнение; повторить попытку с терминала cmux"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: ไม่สามารถเริ่มการดำเนินการที่ปลอดภัยได้ ลองอีกครั้งจากเทอร์มินัล cmux"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: güvenli yürütme başlatılamadı; cmux terminalinden yeniden deneyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: не вдалося почати безпечне виконання; повторіть спробу з терміналу cmux"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo：无法启动安全执行；从 cmux 终端重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo：無法啟動安全執行；從 cmux 終端重試"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: 보안 실행을 시작할 수 없습니다. cmux 터미널에서 다시 시도"
          }
        }
      }
    },
