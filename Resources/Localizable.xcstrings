    "remote.disconnectBanner.reconnectHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] اضغط على Enter لإعادة الاتصال. ستظل هذه الطرفية غير متصلة حتى تقوم بذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "new",
            "value": "[cmux] Press Enter to reconnect. This terminal will stay disconnected until then."
          }
        },
        "da": {
          "stringUnit": {
            "state": "new",
            "value": "[cmux] Press Enter to reconnect. This terminal will stay disconnected until then."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] Drücken Sie die Eingabetaste, um die Verbindung wiederherzustellen. Dieses Terminal bleibt bis dahin getrennt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] Press Enter to reconnect. This terminal will stay disconnected until then."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] Presiona Enter para volver a conectar. Esta terminal permanecerá desconectada hasta entonces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] Appuyez sur Entrée pour vous reconnecter. Ce terminal restera déconnecté d'ici là."
          }
        },
        "it": {
          "stringUnit": {
            "state": "new",
            "value": "[cmux] Press Enter to reconnect. This terminal will stay disconnected until then."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] Enter キーを押すと再接続します。それまではこのターミナルは切断されたままです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "new",
            "value": "[cmux] Press Enter to reconnect. This terminal will stay disconnected until then."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] 다시 연결하려면 Enter 키를 누르세요. 그전까지 이 터미널은 연결되지 않은 상태로 유지됩니다."
          }
        },
