    "socket.surface.create.remoteTmuxPaneUnsupportedType": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only terminal surfaces can target a remote tmux pane; the terminal is created as a new tmux window after the pane's window."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモート tmux ペインを対象にできるのはターミナルサーフェスだけです。ターミナルは対象ペインのウインドウの後に新しい tmux ウインドウとして作成されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有终端表面可以指向远程 tmux 窗格；终端会作为新的 tmux 窗口创建在该窗格所在窗口之后。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Terminal-Oberflächen können auf ein Remote-tmux-Teilfenster verweisen; das Terminal wird als neues tmux-Fenster nach dem Fenster des Teilfensters erstellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les surfaces d’affichage de terminal peuvent cibler un volet tmux distant ; le terminal est créé en tant que nouvelle fenêtre tmux après la fenêtre du volet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لأسطح الطرفية فقط استهداف جزء tmux بعيد؛ يتم إنشاء الطرفية كنافذة tmux جديدة بعد نافذة الجزء."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo las superficies de terminal pueden tener como objetivo un panel tmux remoto; la terminal se crea como una nueva ventana de tmux después de la ventana del panel."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有終端機介面可以指向遠端 tmux 窗格；終端機將在該窗格的視窗後方建立為新的 tmux 視窗。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 화면만 원격 tmux 분할 창을 대상으로 지정할 수 있습니다. 터미널은 분할 창의 창 뒤에 새 tmux 창으로 생성됩니다."
          }
        }
      }
    },
