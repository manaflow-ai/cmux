    "notificationHook.failure.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux used default notification behavior because '%@' failed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' が失敗したため、cmux は既定の通知動作を使用しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 使用了默认通知行为，因为 '%@' 失败。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux hat das Standard-Benachrichtigungsverhalten verwendet, da „%@“ fehlgeschlagen ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux a utilisé le comportement de notification par défaut car '%@' a échoué."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم cmux سلوك الإشعارات الافتراضي بسبب فشل «%@»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux utilizó el comportamiento de notificación predeterminado porque '%@' falló."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因為「%@」失敗，cmux 已使用預設通知行為。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'이(가) 실패하여 cmux가 기본 알림 동작을 사용했습니다."
          }
        }
      }
    },
