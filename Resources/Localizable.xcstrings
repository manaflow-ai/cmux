    "cloud.operation.diagnosticsNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud sends connection timing and error codes while you are signed in. Terminal content and credentials are excluded."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud sendet Verbindungszeiten und Fehlercodes, während Sie angemeldet sind. Terminalinhalte und Zugangsdaten werden nicht gesendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud envoie les durées de connexion et les codes d’erreur lorsque vous êtes connecté. Le contenu du terminal et les identifiants sont exclus."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترسل Cloud أوقات الاتصال ورموز الأخطاء أثناء تسجيل دخولك. لا يُرسل محتوى الطرفية أو بيانات الاعتماد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud envía tiempos de conexión y códigos de error mientras tienes la sesión iniciada. Se excluyen el contenido del terminal y las credenciales."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入期間，Cloud 會傳送連線時間與錯誤代碼。不包含終端機內容與憑證。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录期间，Cloud 会发送连接时间和错误代码。不包含终端内容和凭证。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
