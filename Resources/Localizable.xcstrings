    "socket.pane.resize.localMetricsUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pane resize metrics are not ready; wait for the pane to finish loading and retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペインのサイズ変更メトリクスの準備ができていません。ペインの読み込みが完了してからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗格尺寸调整所需的度量尚未就绪；请等待窗格加载完成后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Metriken für die Teilfenster-Größenänderung sind nicht bereit; warte, bis das Teilfenster vollständig geladen ist, und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mesures de redimensionnement du volet ne sont pas prêtes ; attendez la fin du chargement du volet et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقاييس تغيير حجم الجزء ليست جاهزة بعد؛ انتظر حتى ينتهي الجزء من التحميل وأعد المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las métricas de cambio de tamaño del panel no están listas; espere a que el panel termine de cargarse y vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "窗格調整大小指標尚未就緒；請等待窗格載入完成後重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분할 창 크기 조정 메트릭이 준비되지 않았습니다. 분할 창 로드가 완료될 때까지 기다린 후 다시 시도하십시오."
          }
        }
      }
    },
    "socket.pane.resize.remoteUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote tmux pane is not ready to resize; wait for it to become available and retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモート tmux ペインのサイズを変更する準備ができていません。利用可能になってからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程 tmux 窗格尚不能调整尺寸；请等待其可用后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Remote-tmux-Teilfenster ist nicht bereit für eine Größenänderung; warte, bis es verfügbar ist, und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le volet tmux distant n'est pas prêt à être redimensionné ; attendez qu'il soit disponible et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جزء tmux البعيد ليس جاهزاً لتغيير الحجم؛ انتظر حتى يصبح متاحاً وأعد المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El panel remoto de tmux no está listo para cambiar de tamaño; espere a que esté disponible y vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端 tmux 窗格尚未準備好調整大小；請等待其可用後重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 tmux 분할 창의 크기를 조정할 준비가 되지 않았습니다. 사용 가능해질 때까지 기다린 후 다시 시도하십시오."
          }
        }
      }
    },
