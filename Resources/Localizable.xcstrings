    "account.signIn.error.timedOut.recovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in window did not return to cmux. Reopen the browser link or start a new attempt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインウインドウから cmux に戻りませんでした。ブラウザリンクをもう一度開くか、新しいサインインを開始してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录窗口未返回 cmux。请重新打开浏览器链接，或重新发起一次登录。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Anmeldefenster ist nicht zu cmux zurückgekehrt. Öffnen Sie den Browser-Link erneut oder starten Sie einen neuen Versuch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fenêtre de connexion n'a pas redirigé vers cmux. Ouvrez à nouveau le lien ou réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تعد نافذة تسجيل الدخول إلى cmux. أعد فتح رابط المتصفح أو ابدأ محاولة جديدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ventana de inicio de sesión no regresó a cmux. Vuelve a abrir el enlace del navegador o inicia un nuevo intento."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入視窗未返回至 cmux。請重新開啟瀏覽器連結，或重新嘗試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 창이 cmux로 신호를 보내지 못했습니다. 브라우저 링크를 다시 열거나 새로 시도해 주세요."
          }
        }
      }
    },
