    "panel.cloudVM.loading.failed.serviceUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Cloud VM service could not create a VM yet. Retry keeps using this pinned Cloud VM slot, and once a VM exists cmux will always reattach to that same VM."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数回再試行しましたが、Cloud VMサービスの準備が完了しませんでした。ワークスペースは残っています。少し待ってからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud VM 服务暂时无法创建 VM。重试会继续使用这个已固定的 Cloud VM 槽位，一旦 VM 存在，cmux 将始终重新附加到同一个 VM。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Cloud-VM-Dienst konnte noch keine VM erstellen. Ein erneuter Versuch verwendet weiterhin diesen angehefteten Cloud-VM-Slot, und sobald eine VM existiert, wird cmux immer wieder an dieselbe VM angehängt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service de VM Cloud n’a pas encore pu créer de VM. Réessayer continue d’utiliser cet emplacement de VM Cloud épinglé, et dès qu’une VM existe, cmux s’attachera toujours à cette même VM."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتمكن خدمة الأجهزة الافتراضية السحابية (Cloud VM) من إنشاء جهاز افتراضي بعد. استخدام إعادة المحاولة يحافظ على فتحة الجهاز الافتراضي السحابي المثبتة هذه، وبمجرد وجود جهاز افتراضي، سيعيد cmux دائمًا إرفاقه بنفس الجهاز الافتراضي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio Cloud VM aún no pudo crear una VM. Al reintentar, se seguirá usando este espacio de Cloud VM fijado, y once que exista una VM, cmux siempre se volverá a acoplar a esa misma VM."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud VM 服務目前無法建立 VM。重試將繼續使用此釘選的 Cloud VM 插槽，且一旦 VM 建立，cmux 將一律重新附加到該同一個 VM。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud VM 서비스가 아직 VM을 생성하지 못했습니다. 다시 시도하면 이 고정된 Cloud VM 슬롯을 계속 사용하며, VM이 생성되면 cmux가 항상 해당 VM에 다시 연결합니다."
          }
        }
      }
    },
