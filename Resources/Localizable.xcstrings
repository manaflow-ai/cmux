    "account.signIn.error.offline.recovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to Wi-Fi or another network, then try again. You can keep this pane open."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi または別のネットワークに接続して、もう一度試してください。このペインは開いたままにできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请连接 Wi-Fi 或其他网络后重试。可以保持此窗格打开。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie eine Verbindung zum WLAN oder einem anderen Netzwerk her und versuchen Sie es erneut. Sie können dieses Teilfenster geöffnet lassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous au Wi-Fi ou à un autre réseau, puis réessayez. Vous pouvez laisser ce volet ouvert."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصل بشبكة Wi-Fi أو شبكة أخرى، ثم أعد المحاولة. يمكنك إبقاء هذا الجزء مفتوحًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate a una red Wi-Fi u otra red, y vuelve a intentarlo. Puedes mantener este panel abierto."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請連線至 Wi-Fi 或其他網路，然後再試一次。您可以保持此窗格開啟。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi 또는 다른 네트워크에 연결한 후 다시 시도하세요. 이 분할 창을 계속 열어두셔도 됩니다."
          }
        }
      }
    },
