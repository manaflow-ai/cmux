    "update.error.invalidFeed.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان URL لموجز التحديثات غير صالح. يرجى الاتصال بالدعم."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "URL feeda ažuriranja je nevažeći. Kontaktirajte podršku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "URL'en til opdateringsfeedet er ugyldig. Kontakt venligst supporten."
          }
        },
        "de": {
