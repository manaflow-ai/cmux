          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱을 시스템 설정 목록으로 드래그하여 활성화한 다음, 여기로 돌아오십시오."
          }
        }
      }
    },
    "computerUse.onboarding.dragTip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the app card, not this window, into the permission list."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウインドウではなく、アプリカードを権限リストにドラッグしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请拖移应用卡片，而不是这个窗口，把它拖到权限列表中。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
