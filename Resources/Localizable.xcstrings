    "sidebar.extensions.blocked.detail.connectionInterrupted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CMUX lost the extension connection. No workspace data or actions are being shared."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CMUXは拡張機能との接続を失いました。ワークスペースデータや操作は共有されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CMUX 已失去与扩展的连接。未共享任何工作区数据或操作。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CMUX hat die Verbindung zur Erweiterung verloren. Es werden keine Arbeitsbereichsdaten oder Aktionen geteilt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CMUX a perdu la connexion avec l’extension. Aucune donnée d’espace de travail ni aucune action ne sont partagées."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقد CMUX الاتصال بالامتداد. لا تتم مشاركة أي بيانات لمساحة العمل أو إجراءات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CMUX perdió la conexión con la extensión. No se están compartiendo datos ni acciones del espacio de trabajo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CMUX 遺失擴充功能連線。未分享任何工作區資料或動作。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CMUX가 확장 프로그램과의 연결을 잃었습니다. 작업 공간 데이터나 작업이 공유되지 않습니다."
          }
        }
      }
    },
    "sidebar.extensions.blocked.detail.failedManifest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CMUX could not load this extension's configuration. No workspace data or actions were shared."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CMUXはこの拡張機能の設定を読み込めませんでした。ワークスペースデータや操作は共有されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CMUX 无法加载此扩展的配置。未共享任何工作区数据或操作。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CMUX konnte die Konfiguration dieser Erweiterung nicht laden. Es wurden keine Arbeitsbereichsdaten oder Aktionen geteilt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CMUX n’a pas pu charger la configuration de cette extension. Aucune donnée d’espace de travail ni aucune action n’ont été partagées."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على CMUX تحميل تكوين هذا الامتداد. لم تتم مشاركة أي بيانات لمساحة العمل أو إجراءات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CMUX no pudo cargar la configuración de esta extensión. No se compartieron datos ni acciones del espacio de trabajo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CMUX 無法載入此擴充功能的設定。未分享任何工作區資料或動作。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CMUX가 이 확장 프로그램의 구성을 로드하지 못했습니다. 작업 공간 데이터나 작업이 공유되지 않았습니다."
          }
        }
      }
    },
