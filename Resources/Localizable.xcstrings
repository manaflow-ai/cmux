    "sudo.cli.error.timeout_positive_integer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: timeout must be a positive integer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: タイムアウトには正の整数を指定してください"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: Timeout muss eine positive ganze Zahl sein"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: يجب أن تكون المهلة عددًا صحيحًا موجبًا"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: timeout mora biti pozitivan cijeli broj"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: timeout skal være et positivt heltal"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: timeout debe ser un entero positivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo : le délai d'attente doit être un entier positif"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: il timeout deve essere un numero intero positivo"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo៖ អស់ពេលត្រូវតែជាចំនួនគត់វិជ្ជមាន"
