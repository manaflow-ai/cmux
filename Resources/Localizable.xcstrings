    "account.signIn.error.unknown.recovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again. If the sign-in window still fails, copy the link and open it in your browser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度試してください。サインインウインドウが引き続き失敗する場合は、リンクをコピーしてブラウザで開いてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重试。如果登录窗口仍然失败，请复制链接并在浏览器中打开。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie es erneut. Wenn das Anmeldefenster weiterhin fehlschlägt, kopieren Sie den Link und öffnen Sie ihn in Ihrem Browser."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez. Si la fenêtre de connexion échoue toujours, copiez le lien et ouvrez-le dans votre navigateur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد المحاولة. إذا استمر فشل نافذة تسجيل الدخول، فانسخ الرابط وافتحه في متصفحك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a intentarlo. Si la ventana de inicio de sesión sigue fallando, copia el enlace y ábrelo en tu navegador."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請再試一次。如果登入視窗仍然失敗，請複製連結並在您的瀏覽器中開啟。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 시도하세요. 로그인 창이 여전히 작동하지 않으면 링크를 복사하여 브라우저에서 직접 열어주세요."
          }
        }
      }
    },
