    },
    "settings.notifications.agentPermissionPrompt.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify when an agent is blocked waiting for your permission to run a tool."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントがツールの実行にあなたの許可を待って停止しているときに通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 도구 실행에 대한 사용자의 허가를 기다리며 멈췄을 때 알립니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщати, коли агент заблоковано в очікуванні вашого дозволу на запуск інструмента."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当代理因等待你授权运行工具而阻塞时通知。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigen, wenn ein Agent blockiert ist und auf Ihre Erlaubnis zum Ausführen eines Werkzeugs wartet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifier lorsqu'un agent est bloqué en attente de votre autorisation pour exécuter un outil."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعلامي عندما يكون الوكيل محجوبًا بانتظار إذنك لتشغيل أداة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificar cuando un agente esté bloqueado esperando tu permiso para ejecutar una herramienta."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當代理程式因等待您允許執行工具而受阻時發出通知。"
          }
        }
      }
    },
