    "cli.codexTeams.watcher.subagent.depthExceeded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux codex-teams watcher skipped a Codex subagent: depth %1$lld exceeds the automatic pane limit %2$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux codex-teams ウォッチャーは Codex サブエージェントをスキップしました: 深さ %1$lld がペイン自動作成の上限 %2$lld を超えています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux codex-teams 监视器跳过了一个 Codex 子代理：深度 %1$lld 超过自动窗格上限 %2$lld。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux codex-teams-Watcher hat einen Codex-Subagenten übersprungen: Die Tiefe %1$lld überschreitet das automatische Teilfenster-Limit %2$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’observateur cmux codex-teams a ignoré un sous-agent Codex : la profondeur %1$lld dépasse la limite automatique de volets de %2$lld."
