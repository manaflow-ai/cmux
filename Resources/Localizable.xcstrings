    "cloud.ports.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect Cloud VPN, or choose Forward Port. Forwarding stays off until you start it. This table shows the address and lets you stop it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie Cloud VPN oder wählen Sie Port weiterleiten. Die Weiterleitung bleibt aus, bis Sie sie starten. Diese Tabelle zeigt die Adresse und ermöglicht das Stoppen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez le VPN Cloud ou choisissez Transférer le port. Le transfert reste désactivé tant que vous ne le démarrez pas. Ce tableau affiche l’adresse et permet de l’arrêter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta Cloud VPN o elige Reenviar puerto. El reenvío permanece desactivado hasta que lo inicies. Esta tabla muestra la dirección y permite detenerlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud VPNに接続するか、「ポートを転送」を選択してください。開始するまで転送はオフのままです。この表でアドレスを確認し、転送を停止できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud VPN에 연결하거나 포트 전달을 선택하세요. 직접 시작하기 전까지 전달은 꺼져 있습니다. 이 표에서 주소를 확인하고 전달을 중지할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 Cloud VPN 或选择“转发端口”。转发在您启动前保持关闭。此表显示地址，并可让您停止转发。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接 Cloud VPN 或選擇「轉送連接埠」。轉送會保持關閉，直到您啟動為止。此表顯示位址，並可讓您停止轉送。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصل بـ Cloud VPN أو اختر إعادة توجيه المنفذ. تظل إعادة التوجيه متوقفة حتى تبدأها. يعرض هذا الجدول العنوان ويتيح لك إيقافها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povežite Cloud VPN ili izaberite Proslijedi port. Prosljeđivanje ostaje isključeno dok ga ne pokrenete. Ova tabela prikazuje adresu i omogućava zaustavljanje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbind Cloud VPN, eller vælg Videresend port. Videresendelse forbliver slået fra, indtil du starter den. Tabellen viser adressen og lader dig stoppe den."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connetti Cloud VPN o scegli Inoltra porta. L’inoltro resta disattivato finché non lo avvii. Questa tabella mostra l’indirizzo e consente di interromperlo."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til Cloud VPN eller velg Videresend port. Videresending er av til du starter den. Tabellen viser adressen og lar deg stoppe den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz z Cloud VPN lub wybierz Przekieruj port. Przekierowanie pozostaje wyłączone, dopóki go nie uruchomisz. Ta tabela pokazuje adres i pozwala je zatrzymać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte o Cloud VPN ou escolha Encaminhar porta. O encaminhamento fica desativado até você iniciá-lo. Esta tabela mostra o endereço e permite pará-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите Cloud VPN или выберите Перенаправить порт. Перенаправление выключено, пока вы его не запустите. В таблице указан адрес и можно остановить перенаправление."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіть Cloud VPN або виберіть Перенаправити порт. Перенаправлення вимкнене, доки ви його не запустите. Таблиця показує адресу й дозволяє його зупинити."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud VPN’e bağlanın veya Portu yönlendir’i seçin. Siz başlatana kadar yönlendirme kapalı kalır. Bu tablo adresi gösterir ve yönlendirmeyi durdurmanızı sağlar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อ Cloud VPN หรือเลือกส่งต่อพอร์ต การส่งต่อจะปิดอยู่จนกว่าคุณจะเริ่ม ตารางนี้แสดงที่อยู่และให้คุณหยุดการส่งต่อได้"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្ជាប់ Cloud VPN ឬជ្រើស បញ្ជូនច្រកបន្ត។ ការបញ្ជូនបន្តនៅតែបិទរហូតដល់អ្នកចាប់ផ្តើមវា។ តារាងនេះបង្ហាញអាសយដ្ឋាន និងអនុញ្ញាតឱ្យអ្នកបញ្ឈប់វា។"
          }
        }
      }
    },
