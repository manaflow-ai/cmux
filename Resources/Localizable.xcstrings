    "cli.fork.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستخدام: cmux fork [--surface <id|ref>] <kind> <checkpoint-id>\n             cmux fork <kind> <checkpoint-id> --surface <id|ref>\n             cmux fork --surface=<id|ref> <kind> <checkpoint-id>\n             cmux fork --surface [id|ref]\n\nابدأ تفريعاً من الجلسة المحفوظة على السطح المحدد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upotreba: cmux fork [--surface <id|ref>] <kind> <checkpoint-id>\n          cmux fork <kind> <checkpoint-id> --surface <id|ref>\n          cmux fork --surface=<id|ref> <kind> <checkpoint-id>\n          cmux fork --surface [id|ref]\n\nPokrenite fork iz sačuvane sesije na izabranoj površini."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug: cmux fork [--surface <id|ref>] <kind> <checkpoint-id>\n      cmux fork <kind> <checkpoint-id> --surface <id|ref>\n      cmux fork --surface=<id|ref> <kind> <checkpoint-id>\n      cmux fork --surface [id|ref]\n\nStart en fork fra den gemte session på den valgte overflade."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendung: cmux fork [--surface <id|ref>] <kind> <checkpoint-id>\n            cmux fork <kind> <checkpoint-id> --surface <id|ref>\n            cmux fork --surface=<id|ref> <kind> <checkpoint-id>\n            cmux fork --surface [id|ref]\n\nStarten Sie einen Fork aus der gespeicherten Sitzung auf der ausgewählten Oberfläche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage: cmux fork [--surface <id|ref>] <kind> <checkpoint-id>\n       cmux fork <kind> <checkpoint-id> --surface <id|ref>\n       cmux fork --surface=<id|ref> <kind> <checkpoint-id>\n       cmux fork --surface [id|ref]\n\nStart a fork from the saved session on the selected surface."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso: cmux fork [--surface <id|ref>] <kind> <checkpoint-id>\n     cmux fork <kind> <checkpoint-id> --surface <id|ref>\n     cmux fork --surface=<id|ref> <kind> <checkpoint-id>\n     cmux fork --surface [id|ref]\n\nInicia una bifurcación desde la sesión guardada en la superficie seleccionada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisation : cmux fork [--surface <id|ref>] <kind> <checkpoint-id>\n              cmux fork <kind> <checkpoint-id> --surface <id|ref>\n              cmux fork --surface=<id|ref> <kind> <checkpoint-id>\n              cmux fork --surface [id|ref]\n\nDémarrez un fork depuis la session enregistrée sur la surface sélectionnée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso: cmux fork [--surface <id|ref>] <kind> <checkpoint-id>\n     cmux fork <kind> <checkpoint-id> --surface <id|ref>\n     cmux fork --surface=<id|ref> <kind> <checkpoint-id>\n     cmux fork --surface [id|ref]\n\nAvvia un fork dalla sessione salvata sulla superficie selezionata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用法: cmux fork [--surface <id|ref>] <kind> <checkpoint-id>\n        cmux fork <kind> <checkpoint-id> --surface <id|ref>\n        cmux fork --surface=<id|ref> <kind> <checkpoint-id>\n        cmux fork --surface [id|ref]\n\n選択したサーフェスの保存済みセッションからフォークを開始します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការប្រើប្រាស់៖ cmux fork [--surface <id|ref>] <kind> <checkpoint-id>\n              cmux fork <kind> <checkpoint-id> --surface <id|ref>\n              cmux fork --surface=<id|ref> <kind> <checkpoint-id>\n              cmux fork --surface [id|ref]\n\nចាប់ផ្តើម fork ពីសម័យដែលបានរក្សាទុកនៅលើផ្ទៃដែលបានជ្រើសរើស។"
