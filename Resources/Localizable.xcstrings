    "settings.betaFeatures.remoteTmux.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirrors a remote host's tmux sessions in the sidebar over ssh tmux -CC; sessions become workspaces and windows become tabs. Quitting cmux leaves the remote tmux server running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh tmux -CC でリモートホストの tmux セッションをサイドバーにミラーリングします。セッションはワークスペースに、ウィンドウはタブになります。cmux を終了してもリモートの tmux サーバーは動作し続けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 ssh tmux -CC 在侧边栏镜像远程主机的 tmux 会话；会话变为工作区，窗口变为标签页。退出 cmux 后，远程 tmux 服务器仍继续运行。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiegelt die tmux-Sitzungen eines Remote-Hosts über ssh tmux -CC in der Seitenleiste; Sitzungen werden zu Arbeitsbereichen und Fenster zu Tabs. Das Beenden von cmux lässt den Remote-tmux-Server weiterlaufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met en miroir les sessions tmux d’un hôte distant dans la barre latérale via ssh tmux -CC ; les sessions deviennent des espaces de travail et les fenêtres deviennent des onglets. Quitter cmux laisse le serveur tmux distant en cours d’exécution."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعكس جلسات tmux للمضيف البعيد في الشريط الجانبي عبر ssh tmux -CC؛ وتتحول الجلسات إلى مساحات عمل والنوافذ إلى علامات تبويب. ويؤدي الخروج من cmux إلى ترك خادم tmux البعيد قيد التشغيل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Refleja las sesiones de tmux de un host remoto en la barra lateral a través de ssh tmux -CC; las sesiones se convierten en espacios de trabajo y las ventanas en pestañas. Salir de cmux deja el servidor tmux remoto en ejecución."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 ssh tmux -CC 在側邊欄鏡像遠端主機的 tmux 工作階段；工作階段會變成工作區，視窗會變成標籤頁。退出 cmux 會讓遠端 tmux 伺服器保持執行狀態。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh tmux -CC를 통해 원격 호스트의 tmux 세션을 사이드바에 미러링합니다. 세션은 작업 공간이 되고 창은 탭이 됩니다. cmux를 종료해도 원격 tmux 서버는 계속 실행 중인 상태로 유지됩니다."
          }
        }
      }
    },
    "settings.betaFeatures.warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These features are experimental and may change or break. Enable them only when you are testing them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの機能は実験的で、変更されたり壊れたりする可能性があります。テストする場合だけ有効にしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些功能属于实验性功能，可能变更或失效。仅在测试时启用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Funktionen sind experimentell und können sich ändern oder fehlerhaft sein. Aktivieren Sie sie nur, wenn Sie sie testen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces fonctionnalités sont expérimentales et peuvent changer ou cesser de fonctionner. Ne les activez que lorsque vous les testez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الميزات تجريبية وقد تتغير أو تتعطل. قم بتمكينها فقط عندما تقوم باختبارها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas funciones son experimentales y pueden cambiar o dejar de funcionar. Habilítelas solo cuando las esté probando."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些是實驗性功能，可能會變更或損壞。請僅在測試時啟用它們。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기능들은 실험적이며 변경되거나 제대로 작동하지 않을 수 있습니다. 테스트 목적일 때만 활성화하십시오."
          }
        }
      }
    },
    "settings.betaFeatures.workspaceTodoControls": {
      "extractionState": "manual",
      "localizations": {
        "en": {
