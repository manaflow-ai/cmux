    "cli.browser.inputFiles.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files --selector <css> (--file <path> ... | --clear) [--snapshot-after]\n    Select local files (up to 128 files, 32 MiB total) or clear the selection. Directory uploads are unsupported."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files --selector <css> (--file <path> ... | --clear) [--snapshot-after]\n    اختر ملفات محلية (حتى 128 ملفًا بإجمالي 32 MiB) أو امسح الاختيار. رفع المجلدات غير مدعوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files --selector <css> (--file <path> ... | --clear) [--snapshot-after]\n    Lokale Dateien auswählen (bis zu 128 Dateien, insgesamt 32 MiB) oder die Auswahl leeren. Ordner-Uploads werden nicht unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files --selector <css> (--file <path> ... | --clear) [--snapshot-after]\n    Selecciona archivos locales (hasta 128 archivos, 32 MiB en total) o borra la selección. No se admite subir carpetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files --selector <css> (--file <path> ... | --clear) [--snapshot-after]\n    Sélectionner des fichiers locaux (jusqu’à 128 fichiers, 32 MiB au total) ou effacer la sélection. L’envoi de dossiers n’est pas pris en charge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files --selector <css> (--file <path> ... | --clear) [--snapshot-after]\n    ローカルファイルを選択（最大128個、合計32 MiB）するか、選択を解除します。ディレクトリのアップロードには対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files --selector <css> (--file <path> ... | --clear) [--snapshot-after]\n    로컬 파일을 선택하거나(최대 128개, 총 32 MiB) 선택을 지웁니다. 디렉터리 업로드는 지원되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files --selector <css> (--file <path> ... | --clear) [--snapshot-after]\n    选择本地文件（最多 128 个文件，总计 32 MiB）或清除选择。不支持上传目录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files --selector <css> (--file <path> ... | --clear) [--snapshot-after]\n    選取本機檔案（最多 128 個檔案，總計 32 MiB）或清除選取。不支援上傳目錄。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "set-input-files --selector <css> (--file <path> ... | --clear) [--snapshot-after]\n    Odaberite lokalne datoteke (do 128 datoteka, ukupno 32 MiB) ili obrišite odabir. Prijenos direktorija nije podržan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "set-input-files --selector <css> (--file <path> ... | --clear) [--snapshot-after]\n    Vælg lokale filer (op til 128 filer, 32 MiB i alt) eller ryd markeringen. Mappeoverførsler understøttes ikke."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "set-input-files --selector <css> (--file <path> ... | --clear) [--snapshot-after]\n    Seleziona file locali (fino a 128 file, 32 MiB totali) o cancella la selezione. Il caricamento di directory non è supportato."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "set-input-files --selector <css> (--file <path> ... | --clear) [--snapshot-after]\n    ជ្រើសរើសឯកសារក្នុងម៉ាស៊ីន (រហូតដល់ 128 ឯកសារ, 32 MiB សរុប) ឬ លុបការជ្រើសរើស។ ការបញ្ចូល directory មិនត្រូវបានគាំទ្រ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "set-input-files --selector <css> (--file <path> ... | --clear) [--snapshot-after]\n    Velg lokale filer (opptil 128 filer, 32 MiB totalt) eller tøm utvalget. Opplasting av mapper støttes ikke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "set-input-files --selector <css> (--file <path> ... | --clear) [--snapshot-after]\n    Wybierz pliki lokalne (do 128 plików, łącznie 32 MiB) lub wyczyść zaznaczenie. Przesyłanie katalogów nie jest obsługiwane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "set-input-files --selector <css> (--file <path> ... | --clear) [--snapshot-after]\n    Seleciona arquivos locais (até 128 arquivos, 32 MiB no total) ou limpa a seleção. Upload de diretórios não é suportado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "set-input-files --selector <css> (--file <path> ... | --clear) [--snapshot-after]\n    Выбрать локальные файлы (до 128 файлов, суммарно до 32 МиБ) или сбросить выбор. Загрузка каталогов не поддерживается."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
