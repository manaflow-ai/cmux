            "value": "Naslovi radnih prostora ostaju u jednom redu i skraćuju se na kraju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbejdsområdetitler vises på én linje og afkortes i slutningen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeitsbereichstitel bleiben in einer Zeile und werden am Ende gekürzt."
          }
        },
        "en": {
          "stringUnit": {
