            "value": "모바일 터미널 파일 칩"
          }
        }
      }
    },
    "featureFlags.mobileWorkspaceChanges.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Serves workspace diffs to paired phones: the iOS changes chip, toolbar button, and Changes sheet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング済みのスマートフォンにワークスペースの差分を提供します（iOSの変更チップ、ツールバーボタン、変更シート）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向已配对的手机提供工作区差异：iOS 更改标记、工具栏按钮和「更改」面板。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt Arbeitsbereich-Diffs für gekoppelte Telefone bereit: den iOS-Änderungs-Chip, die Symbolleisten-Schaltfläche und das Änderungsblatt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fournit les diffs de l’espace de travail aux téléphones jumelés : la puce des modifications iOS, le bouton de la barre d’outils et la feuille de modifications."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقدم فروقات مساحة العمل للهواتف المقترنة: شريحة تغييرات iOS، وزر شريط الأدوات، وورقة التغييرات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sirve diffs del espacio de trabajo a teléfonos emparejados: el chip de cambios de iOS, el botón de la barra de herramientas y la hoja de cambios."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向配對的手機提供工作區差異比對：iOS 變更標籤、工具列按鈕及變更表單。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링된 휴대폰에 작업 공간 변경 사항(iOS 변경 사항 칩, 도구 모음 버튼 및 변경 사항 시트)을 제공합니다."
          }
        }
      }
    },
