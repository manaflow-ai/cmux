    "cloudTree.deleteWorkspace.message.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workspace closes on the machine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシン上のワークスペースが閉じます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该工作区会在机器上关闭。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Arbeitsbereich wird auf der Maschine geschlossen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’espace de travail se ferme sur la machine."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم إغلاق مساحة العمل على الجهاز."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio de trabajo se cierra en la máquina."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作區將在該機器上關閉。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머신에서 작업 공간이 닫힙니다."
          }
        }
      }
    },
    "cloudTree.deleteWorkspace.message.one": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its terminal is killed with it. To keep it, use “Close Workspace” instead — it moves to the Terminals pool."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中のターミナルも一緒に終了します。残す場合は「ワークスペースを閉じる」を使ってください。ターミナルはプールに移動します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它的终端会随之被终止。若想保留，请改用「关闭工作区」—— 终端会移到 Terminals 池中。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sein Terminal wird mitbeendet. Um es zu behalten, verwende stattdessen „Arbeitsbereich schließen“ – es wird in den Terminal-Pool verschoben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son terminal est arrêté en même temps. Pour le conserver, utilisez plutôt « Fermer l’espace de travail » — il sera déplacé vers le groupe de terminaux."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم إنهاء الطرفية الخاصة بها معها. للاحتفاظ بها، استخدم \"إغلاق مساحة العمل\" بدلاً من ذلك — حيث ستنتقل إلى تجمع الطرفيات (Terminals pool)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su terminal se cerrará con él. Para conservarla, usa «Cerrar espacio de trabajo» en su lugar: se moverá al grupo de terminales."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其終端機將隨之被終止。若要保留它，請改用「關閉工作區」——它將移至終端機集區。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널도 함께 종료됩니다. 유지하려면 대신 “작업 공간 닫기”를 사용하십시오. 해당 터미널은 터미널 풀로 이동합니다."
          }
        }
      }
    },
    "cloudTree.deleteWorkspace.message.other": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Its %d terminal is killed with it. To keep it, use “Close Workspace” instead — it moves to the Terminals pool."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
