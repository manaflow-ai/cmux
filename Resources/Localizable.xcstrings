    "command.markOldestUnreadAndJumpNext.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark as Oldest Unread and Jump to Next Latest Unread"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最古の未読としてマークして次の最新未読にジャンプ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记为最早未读并跳转到下一条最新未读"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als älteste ungelesene markieren und zur nächsten aktuellen ungelesenen springen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquer comme le plus ancien non lu et aller au non lu suivant"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمييز كأقدم غير مقروء والانتقال إلى غير المقروء الأحدث التالي"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcar como no leído más antiguo e ir al siguiente no leído más reciente"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標記為最早未讀並跳至下一個最新未讀"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 오래된 읽지 않은 상태로 표시하고 다음 읽지 않은 항목으로 이동"
          }
        }
      }
    },
