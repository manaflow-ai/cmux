    "cloudTunnel.error.activationCanceled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request to load the cmux Cloud Tunnel extension was canceled."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux クラウドトンネル機能拡張の読み込み要求がキャンセルされました。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anforderung zum Laden der cmux Cloud Tunnel-Extension wurde abgebrochen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande de chargement de l'extension Tunnel Cloud cmux a été annulée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء طلب تحميل امتداد cmux Cloud Tunnel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se canceló la solicitud para cargar la extensión Túnel en la nube de cmux."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "載入 cmux Cloud Tunnel 延伸功能的請求已取消。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载 cmux 云隧道扩展的请求已被取消。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud Tunnel 확장 프로그램 로드 요청이 취소되었습니다."
          }
        }
      }
    },
    "cloudTunnel.error.activationNotAllowed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS did not allow the cmux Cloud Tunnel extension to load. Allow it in System Settings › General › Login Items & Extensions, then retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS が cmux クラウドトンネル機能拡張の読み込みを許可しませんでした。「システム設定」›「一般」›「ログイン項目と機能拡張」で許可してから再試行してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat das Laden der cmux Cloud Tunnel-Extension nicht zugelassen. Erlauben Sie es unter Systemeinstellungen › Allgemein › Anmeldeobjekte & Erweiterungen, und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n'a pas autorisé le chargement de l'extension Tunnel Cloud cmux. Autorisez-la dans Réglages Système › Général › Ouverture et extensions, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يسمح نظام macOS بتحميل امتداد cmux Cloud Tunnel. اسمح به في إعدادات النظام › عام › عناصر تسجيل الدخول والامتدادات، ثم حاول مجددًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no permitió cargar la extensión Túnel en la nube de cmux. Permítala en Ajustes del Sistema › General › Ítems de inicio y extensiones, luego vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 不允許載入 cmux Cloud Tunnel 延伸功能。請在「系統設定」›「一般」›「登入項目與延伸功能」中允許它，然後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 不允许加载 cmux 云隧道扩展。请在“系统设置 › 通用 › 登录项与扩展”中允许它，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS에서 cmux Cloud Tunnel 확장 프로그램의 로드를 허용하지 않았습니다. 시스템 설정 › 일반 › 로그인 항목 및 확장 프로그램에서 허용한 후 다시 시도하세요."
          }
        }
      }
    },
