    "simulator.control.applicationListUnexpected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode returned an unexpected installed-application list."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcodeから予期しない形式のインストール済みアプリ一覧が返されました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 返回了意外的已安装应用列表。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode hat eine unerwartete Liste installierter Anwendungen zurückgegeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode a renvoyé une liste d’applications installées inattendue."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرجع Xcode قائمة تطبيقات مثبتة غير متوقعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode devolvió una lista inesperada de aplicaciones instaladas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 傳回了非預期的已安裝應用程式清單。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode가 예기치 않은 설치된 애플리케이션 목록을 반환했습니다."
          }
        }
      }
    },
    "simulator.control.applicationListUnreadable": {
