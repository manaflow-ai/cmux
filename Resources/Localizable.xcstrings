    "settings.mobile.displayName.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name the iOS app shows for this Mac when pairing. Empty uses this Mac's name."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング時に iOS アプリがこの Mac に表示する名前。空の場合はこの Mac の名前を使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对时 iOS 应用为此 Mac 显示的名称。留空则使用此 Mac 的名称。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Name, den die iOS-App für diesen Mac beim Koppeln anzeigt. Wenn leer, wird der Name dieses Macs verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nom que l’application iOS affiche pour ce Mac lors du jumelage. Si vide, le nom de ce Mac est utilisé."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاسم الذي يظهره تطبيق iOS لجهاز Mac هذا عند الاقتران. في حال تركه فارغًا، سيتم استخدام اسم جهاز Mac هذا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre que muestra la aplicación iOS para este Mac al realizar el emparejamiento. Si se deja vacío, se usa el nombre de este Mac."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配對時 iOS 應用程式為此 Mac 顯示的名稱。留空則使用此 Mac 的名稱。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링 시 iOS 앱에서 이 Mac을 나타낼 이름입니다. 비워 두면 이 Mac의 이름이 사용됩니다."
          }
        }
      }
    },
