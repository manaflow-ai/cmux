            "value": "Indtast et gruppenavn. Tryk Enter for at omdøbe, Escape for at annullere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie einen Gruppennamen ein. Eingabetaste zum Umbenennen, Escape zum Abbrechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a group name. Press Enter to rename, Escape to cancel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un nombre de grupo. Pulsa Intro para renombrar, Escape para cancelar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un nom de groupe. Appuyez sur Entrée pour renommer, Échap pour annuler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un nome per il gruppo. Premi Invio per rinominare, Esc per annullare."
