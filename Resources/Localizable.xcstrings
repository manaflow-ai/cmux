            "state": "translated",
            "value": "macOS はすべてのデフォルトターミナルハンドラを更新できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 无法更新全部默认终端处理程序。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS konnte nicht jeden Standard-Terminal-Handler aktualisieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n’a pas pu mettre à jour tous les gestionnaires de terminal par défaut."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتمكن نظام macOS من تحديث كل معالجات الطرفية الافتراضية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no pudo actualizar todos los controladores de terminal predeterminados."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 無法更新所有預設終端機處理常式。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS에서 모든 기본 터미널 핸들러를 업데이트하지 못했습니다."
          }
        }
      }
    },
