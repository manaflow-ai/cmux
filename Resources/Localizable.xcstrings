          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo៖ អស់ពេលរង់ចាំការយល់ព្រម (សំណើ %@ មិនត្រូវបានអនុម័តទេ)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: tidsavbrudd venter på godkjenning (forespørsel %@ ble ikke godkjent)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: upłynął limit czasu oczekiwania na zatwierdzenie (żądanie %@ nie zostało zatwierdzone)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
