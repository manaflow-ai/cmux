    "remoteDaemon.bootstrap.reconnectPaused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic reconnect paused because bootstrap cannot proceed; repair the reported remote failure and use Reconnect to try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブートストラップを続行できないため自動再接続を一時停止しました。表示されたリモートの問題を修復して「再接続」を実行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于引导流程无法继续，自动重连已暂停；请修复报告的远程故障，然后用「重新连接」再试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische Wiederverbindung pausiert, da das Bootstrapping nicht fortgesetzt werden kann; beheben Sie den gemeldeten Remote-Fehler und verwenden Sie „Wiederverbinden“, um es erneut zu versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnexion automatique en pause car l’amorçage (bootstrap) ne peut pas continuer ; réparez la défaillance distante signalée et utilisez Reconnecter pour réessayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تعليق إعادة الاتصال التلقائي مؤقتًا لأن عملية التهيئة الذاتية (bootstrap) لا يمكنها الاستمرار؛ يرجى إصلاح العطل البعيد المبلغ عنه واستخدام \"إعادة الاتصال\" للمحاولة مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconexión automática pausada porque el arranque no puede continuar; repara el fallo remoto notificado y usa Reconectar para volver a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動重新連線已暫停，因為無法繼續引導；請修復回報的遠端錯誤，然後使用「重新連線」重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부트스트랩을 진행할 수 없어 자동 재연결이 일시 중지되었습니다. 보고된 원격 오류를 해결한 후 '다시 연결'을 사용하여 다시 시도하세요."
          }
        }
      }
    },
