    "settings.app.warnBeforeClosingTabXButton": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحذير قبل استخدام زر إغلاق التبويب"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozori prije zatvaranja kartice dugmetom za zatvaranje"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Advar før fanen lukkes med luk-knappen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Schließen eines Tabs per Schließen-Taste warnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warn Before Tab Close Button"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisar antes de cerrar una pestaña con el botón"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avertir avant de fermer un onglet avec le bouton"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvisa prima di chiudere una scheda con il pulsante"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブの閉じるボタンで閉じる前に確認"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ព្រមានមុនពេលបិទផ្ទាំងដោយប៊ូតុងបិទ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭 닫기 버튼으로 닫기 전에 확인"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Advar før fanen lukkes med lukkeknappen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostrzegaj przed zamknięciem karty przyciskiem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisar antes de fechar a aba pelo botão"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предупреждать перед закрытием вкладки кнопкой"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เตือนก่อนปิดแท็บด้วยปุ่มปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekme kapatma düğmesiyle kapatmadan önce uyar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Попереджати перед закриттям вкладки кнопкою"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用标签页关闭按钮前警告"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用分頁關閉按鈕前警告"
          }
        }
      }
    },
    "settings.app.warnBeforeClosingTabXButton.subtitleHidden": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أزرار إغلاق التبويبات مخفية، لذلك يكون هذا التحذير غير نشط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dugmad za zatvaranje kartica su skrivena, pa je ovo upozorenje neaktivno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanernes luk-knapper er skjult, så denne advarsel er inaktiv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tab-Schließen-Tasten sind ausgeblendet, daher ist diese Warnung inaktiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab close buttons are hidden, so this warning is inactive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los botones de cerrar pestañas están ocultos, por lo que este aviso está inactivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les boutons de fermeture d’onglet sont masqués, donc cet avertissement est inactif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I pulsanti di chiusura delle schede sono nascosti, quindi questo avviso è inattivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブの閉じるボタンは非表示のため、この警告は無効です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ប៊ូតុងបិទផ្ទាំងត្រូវបានលាក់ ដូច្នេះការព្រមាននេះមិនដំណើរការទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭 닫기 버튼이 숨겨져 있어 이 경고는 비활성 상태입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukkeknappene for faner er skjult, så denne advarselen er inaktiv."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyciski zamykania kart są ukryte, więc to ostrzeżenie jest nieaktywne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os botões de fechar abas estão ocultos, então este aviso fica inativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопки закрытия вкладок скрыты, поэтому это предупреждение неактивно."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่มปิดแท็บถูกซ่อนอยู่ ดังนั้นคำเตือนนี้จึงไม่ทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekme kapatma düğmeleri gizli olduğu için bu uyarı etkin değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопки закриття вкладок приховано, тому це попередження неактивне."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签页关闭按钮已隐藏，因此此警告处于非活动状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分頁關閉按鈕已隱藏，因此此警告未啟用。"
          }
        }
      }
    },
