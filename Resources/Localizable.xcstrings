          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuert Arbeitsbereichstitel, Metadaten, Badges und Tastaturkürzel-Hinweise in der linken Seitenleiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle les titres d’espace de travail, les métadonnées, les badges et les indices de raccourcis dans la barre latérale gauche."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحكم في عناوين مساحات العمل، والبيانات الوصفية، والشارات، وتلميحات الاختصارات في الشريط الجانبي الأيسر."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla los títulos de espacio de trabajo, metadatos, insignias y sugerencias de atajos en la barra lateral izquierda."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制左側側邊欄中的工作區標題、中繼資料、徽章與快速鍵提示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 사이드바의 작업 공간 제목, 메타데이터, 배지 및 단축키 힌트를 조절합니다."
          }
        }
      }
    },
