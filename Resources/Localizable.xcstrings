    "cli.fork.error.execveFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: لا يمكن بدء العملية المحفوظة. أعد محاولة أمر الشوكة المرئية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: Sačuvani proces nije moguće pokrenuti. Ponovo pokrenite prikazanu fork naredbu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: Den gemte proces kunne ikke startes. Kør den viste fork-kommando igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: Der gespeicherte Prozess konnte nicht gestartet werden. Führen Sie den angezeigten Fork-Befehl erneut aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: the saved process could not be started. Retry the visible fork command."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: No se pudo iniciar el proceso guardado. Vuelva a intentar el comando de bifurcación visible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: le processus enregistré n'a pas pu être démarré. Réessayez la commande visible fork."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: Non è stato possibile avviare il processo salvato. Riprovare il comando fork visibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: 保存されたプロセスを開始できませんでした。表示されているフォークコマンドを再実行してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: ដំណើរការដែលបានរក្សាទុកមិនអាចចាប់ផ្តើមបានទេ។ សាកល្បងពាក្យបញ្ជា fork ដែលអាចមើលឃើញម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: 저장된 프로세스를 시작할 수 없습니다. 보이는 분기 명령을 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: den lagrede prosessen kunne ikke startes. Prøv synlig gaffel-kommandoen på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: nie można uruchomić zapisanego procesu. Ponów polecenie widocznego rozwidlenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: o processo salvo não pôde ser iniciado. Tente novamente o comando de fork visível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: сохраненный процесс не удалось запустить. Повторите команду видимой вилки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: ไม่สามารถเริ่มกระบวนการที่บันทึกไว้ได้ ลองคำสั่ง fork ที่มองเห็นอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: kaydedilen işlem başlatılamadı. Görünür çatal komutunu yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: не вдалося запустити збережений процес. Повторіть команду видимої розгалуження."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: 无法启动保存的进程。重试可见的 fork 命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: 無法啟動已儲存的進程。重試可見的 fork 指令。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "fork: không thể khởi động tiến trình đã lưu. Thử lại lệnh fork hiển thị trên màn hình."
          }
        }
      }
    },
