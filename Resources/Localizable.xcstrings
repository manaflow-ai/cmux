    "simulator.failure.accessibilityCapability": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The active Xcode worker did not negotiate accessibility inspection."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なXcodeワーカーはアクセシビリティ検査に対応していません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 Xcode 工作进程未协商辅助功能检查能力。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktive Xcode-Worker hat keine Prüfung der Bedienungshilfen ausgehandelt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le worker Xcode actif n’a pas négocié l’inspection d’accessibilité."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتفاوض عامل Xcode النشط على فحص تسهيل الاستخدام."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El worker activo de Xcode no negoció la inspección de accesibilidad."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "作用中的 Xcode 工作者未協調輔助功能檢查。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 Xcode 워커가 접근성 검사 협상을 완료하지 못했습니다."
          }
        }
      }
    },
    "simulator.failure.accessibilityFramebufferRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility requires a live framebuffer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティにはライブフレームバッファが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能需要实时帧缓冲。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bedienungshilfen erfordern einen aktiven Framebuffer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accessibilité nécessite un framebuffer actif."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب تسهيل الاستخدام مخزن إطارات مباشرًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La accesibilidad requiere un framebuffer en vivo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助功能需要即時的 framebuffer。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근성에는 실시간 프레임버퍼가 필요합니다."
          }
        }
      }
    },
    "simulator.failure.accessibilityHighlightFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The worker could not update the accessibility highlight overlay."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワーカーはアクセシビリティハイライトのオーバーレイを更新できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作进程无法更新辅助功能高亮叠加层。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
