    "settings.app.notificationBadgePosition.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار شارة الإشعارات غير المقروءة على يسار صف مساحة العمل أو على يمينه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje značku nepročitanih obavijesti lijevo ili desno u redu radnog prostora."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser ulæst-notifikationsmærket til venstre eller højre i arbejdsområdets række."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Ungelesen-Plakette links oder rechts in der Arbeitsbereichszeile."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the unread notification badge on the left or the right of the workspace row."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la insignia de notificaciones no leídas a la izquierda o a la derecha de la fila del espacio de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le badge de notifications non lues à gauche ou à droite de la ligne de l’espace de travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il badge delle notifiche non lette a sinistra o a destra della riga dello spazio di lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未読通知バッジをワークスペース行の左または右に表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽지 않은 알림 배지를 워크스페이스 행의 왼쪽 또는 오른쪽에 표시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser ulest-varselmerket til venstre eller høyre i arbeidsområderaden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje plakietkę nieprzeczytanych powiadomień po lewej lub prawej stronie wiersza obszaru roboczego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o selo de notificações não lidas à esquerda ou à direita da linha do espaço de trabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает значок непрочитанных уведомлений слева или справа в строке рабочего пространства."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงป้ายการแจ้งเตือนที่ยังไม่ได้อ่านทางซ้ายหรือทางขวาของแถวเวิร์กสเปซ"
