    "statusMenu.profiling.permissionExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS may ask for administrator permission because Instruments samples the running cmux process."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrumentsが実行中のcmuxプロセスをサンプリングするため、macOSが管理者権限を求める場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于 Instruments 需要对运行中的 cmux 进程采样，macOS 可能会请求管理员权限。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS fragt möglicherweise nach Administratorberechtigungen, da Instruments den laufenden cmux-Prozess analysiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS peut demander une autorisation d'administrateur car Instruments échantillonne le processus cmux en cours d'exécution."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يطلب نظام macOS إذن المسؤول لأن Instruments يأخذ عينات من عملية cmux قيد التشغيل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS puede solicitar permisos de administrador debido a que Instruments realiza un muestreo del proceso cmux en ejecución."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 可能會要求管理員權限，因為 Instruments 會對執行中的 cmux 程序進行採樣。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Instruments가 실행 중인 cmux 프로세스를 샘플링하기 때문에 macOS에서 관리자 권한을 요청할 수 있습니다."
          }
        }
      }
    },
