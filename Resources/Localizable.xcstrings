          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្មាន pool machine ទំនេរសម្រាប់ %@ — `cmux vm run` នឹង provision machine ថ្មីមួយ (បន្ថែម --provision ដើម្បីបង្កើតឥឡូវនេះ)។"
