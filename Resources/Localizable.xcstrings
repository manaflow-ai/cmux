    "remoteDaemon.error.cloudNotificationClearWorkspaceInvalid": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب مسح إشعار CLI السحابي workspace_id صالحًا"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Brisanje cloud CLI obavijesti zahtijeva važeći workspace_id"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rydning af cloud-CLI-meddelelser kræver et gyldigt workspace_id"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Löschen von Cloud-CLI-Benachrichtigungen erfordert eine gültige workspace_id"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud CLI notification clear requires a valid workspace_id"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para limpiar notificaciones de Cloud CLI se necesita un workspace_id válido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’effacement des notifications Cloud CLI nécessite un workspace_id valide"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cancellazione delle notifiche Cloud CLI richiede un workspace_id valido"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud CLI 通知の消去には有効な workspace_id が必要です"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការសម្អាតការជូនដំណឹង Cloud CLI ត្រូវការ workspace_id ត្រឹមត្រូវ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud CLI 알림을 지우려면 유효한 workspace_id가 필요합니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tømming av Cloud CLI-varsler krever en gyldig workspace_id"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czyszczenie powiadomień Cloud CLI wymaga prawidłowego workspace_id"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A limpeza de notificações do Cloud CLI exige um workspace_id válido"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для очистки уведомлений Cloud CLI требуется корректный workspace_id"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การล้างการแจ้งเตือน Cloud CLI ต้องใช้ workspace_id ที่ถูกต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud CLI bildirim temizleme için geçerli bir workspace_id gerekir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для очищення сповіщень Cloud CLI потрібен дійсний workspace_id"
          }
        },
        "zh-Hans": {
