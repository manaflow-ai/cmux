          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les points d'entrée des VM Cloud dans le menu déroulant du nouvel espace de travail et la palette de commandes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
