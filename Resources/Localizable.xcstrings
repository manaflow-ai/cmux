    "settings.app.focusHistoryIncludesPanesAndTabs.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back and forward navigate focus changes between panes, tabs, and workspaces."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "戻る／進むではペイン、タブ、ワークスペース間のフォーカス移動をたどります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后退和前进会在窗格、标签页和工作区之间的焦点变化中导航。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
