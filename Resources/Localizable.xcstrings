          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O transporte de terminal Mosh exige um workspace gerenciado por SSH."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транспорт терминала Mosh требует рабочего пространства под управлением SSH."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การส่งเทอร์มินัล Mosh ต้องใช้เวิร์กสเปซที่จัดการด้วย SSH"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
