    "featureFlags.agentChat.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the Agent chat entrypoints in the new-workspace dropdown, command palette, and surface tab bar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規ワークスペースのドロップダウン、コマンドパレット、サーフェスタブバーにエージェントチャットの入口を表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在新建工作区下拉菜单、命令面板和表面标签栏中显示代理聊天入口。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Agent-Chat-Einstiegspunkte im Dropdown-Menü für neue Arbeitsbereiche, in der Befehlspalette und in der Tab-Leiste der Oberfläche an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les points d’entrée du chat de l’Agent dans le menu déroulant du nouvel espace de travail, la palette de commandes et la barre d’onglets de la surface d’affichage."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض نقاط دخول دردشة الوكيل في القائمة المنسدلة لـ 'مساحة عمل جديدة'، ولوحة الأوامر، وشريط علامات تبويب السطح."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los puntos de entrada del chat del agente en el menú desplegable de nuevo espacio de trabajo, la paleta de comandos y la barra de pestañas de la superficie."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「新增工作區」下拉選單、命令面板及介面標籤頁列中顯示 Agent 對話入口。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 작업 공간 드롭다운, 명령 팔레트 및 화면 탭 표시줄에 에이전트 채팅 진입점을 표시합니다."
          }
        }
      }
    },
    "featureFlags.agentChat.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
