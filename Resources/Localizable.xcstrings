          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Web Inspector 指令必須包含字串或數字 ID。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹 검사기 명령에는 문자열 또는 숫자 ID가 포함되어야 합니다."
          }
        }
      }
    },
    "simulator.failure.webInspectorResponseCancelled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Web Inspector response wait was cancelled."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Web Inspectorの応答待機がキャンセルされました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待 Web 检查器响应的操作已取消。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Warten auf die Web-Inspektor-Antwort wurde abgebrochen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’attente de la réponse de l’Inspecteur web a été annulée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء انتظار استجابة Web Inspector."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se canceló la espera de respuesta de Web Inspector."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待 Web Inspector 回應已被取消。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹 검사기 응답 대기가 취소되었습니다."
          }
        }
      }
    },
    "simulator.failure.webInspectorResponseOverflow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The inspector response stream exceeded its bounded in-flight buffer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Web Inspectorの応答ストリームが処理中バッファの上限を超えました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查器响应流超出了在途缓冲区上限。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Antwortstrom des Inspektors hat seinen begrenzten In-Flight-Puffer überschritten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le flux de réponse de l’inspecteur a dépassé son tampon en cours délimité."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجاوز تدفق استجابة المفتش المخزن المؤقت المحدد قيد النقل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El flujo de respuesta del inspector excedió su búfer en tránsito limitado."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查器回應串流已超過其傳輸中緩衝區上限。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검사기 응답 스트림이 제한된 인플라이트 버퍼를 초과했습니다."
          }
        }
      }
    },
    "simulator.failure.webInspectorResponseTimedOut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Web Inspector response did not arrive before the bounded deadline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Web Inspectorの応答は設定された期限までに届きませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Web 检查器响应未在限定时限内到达。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Web-Inspektor-Antwort ist nicht vor Ablauf des begrenzten Zeitlimits eingetroffen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse de l’Inspecteur web n’est pas arrivée avant la date limite délimitée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تصل استجابة Web Inspector قبل المهلة المحددة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta de Web Inspector no llegó antes del límite de tiempo establecido."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Web Inspector 回應未在截止時間前抵達。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹 검사기 응답이 제한된 제한 시간 내에 도착하지 않았습니다."
          }
        }
      }
    },
