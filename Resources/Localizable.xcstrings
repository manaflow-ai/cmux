    "cli.automation.output.enableRequested": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable request queued for %@. Run cmux automation logs to verify completion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の有効化要求をキューに追加しました。完了を確認するには cmux automation logs を実行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已排队 %@ 的启用请求。运行 cmux automation logs 确认是否完成。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivierungsanforderung für %@ in Warteschlange eingereiht. Führe cmux automation logs aus, um den Abschluss zu überprüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande d'activation mise en file d'attente pour %@. Exécutez cmux automation logs pour vérifier la finalisation."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم وضع طلب التمكين في قائمة الانتظار لـ %@. شغّل cmux automation logs للتحقق من الاكتمال."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitud de habilitación en cola para %@. Ejecute cmux automation logs para verificar la finalización."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已將啟用請求排入 %@ 的佇列。請執行 cmux automation logs 以驗證是否完成。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화 요청이 대기열에 추가됨: %@. 완료 여부를 확인하려면 cmux automation logs를 실행하세요."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zahtjev za omogućavanje u redu za %@. Pokrenite cmux automation logs za provjeru završetka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktiveringsanmodning sat i kø for %@. Kør cmux automation logs for at bekræfte fuldførelse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Richiesta di abilitazione in coda per %@. Esegui cmux automation logs per verificarne il completamento."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សំណើបើកត្រូវបានដាក់ក្នុងជួររង់ចាំសម្រាប់ %@។ រត់ cmux automation logs ដើម្បីផ្ទៀងផ្ទាត់ការបញ្ចប់។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktiveringforespørsel satt i kø for %@. Kjør cmux automation logs for å bekrefte fullføring."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Żądanie włączenia dodane do kolejki dla %@. Uruchom cmux automation logs, aby zweryfikować ukończenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solicitação de habilitação enfileirada para %@. Execute cmux automation logs para verificar a conclusão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запрос на включение поставлен в очередь для %@. Выполните cmux automation logs для проверки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "จัดคิวคำขอเปิดใช้งาน %@ แล้ว รัน cmux automation logs เพื่อยืนยันการดำเนินการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ için etkinleştirme isteği kuyruğa alındı. Tamamlandığını doğrulamak için cmux automation logs komutunu çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запит на увімкнення поставлено в чергу для %@. Запустіть cmux automation logs, щоб перевірити виконання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yêu cầu bật đã được xếp hàng cho %@. Chạy cmux automation logs để xác nhận hoàn tất."
          }
        }
      }
    },
