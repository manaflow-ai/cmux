    "simulator.clipboard.inputTooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard text must be 1 MiB or smaller."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードのテキストは1 MiB以下にしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板文本不得超过 1 MiB。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text der Zwischenablage darf maximal 1 MiB groß sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte du presse-papiers doit être inférieur ou égal à 1 Mio."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون نص الحافظة 1 ميبي بايت أو أصغر."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto del portapapeles debe ser de 1 MiB o menos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剪貼簿文字必須為 1 MiB 或更小。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드 텍스트는 1 MiB 이하여야 합니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tekst u međuspremniku mora biti 1 MiB ili manji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Udklipsholdertekst må højst fylde 1 MiB."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il testo degli appunti deve essere 1 MiB o meno."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អត្ថបទក្ដារតម្បៀតខ្ទាស់ត្រូវតែមាន 1 MiB ឬតូចជាងនេះ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utklippstavletekst må være 1 MiB eller mindre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tekst schowka musi mieć co najwyżej 1 MiB."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O texto da área de transferência deve ter 1 MiB ou menos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Текст буфера обмена не должен превышать 1 МиБ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ข้อความ Clipboard ต้องมีขนาด 1 MiB หรือน้อยกว่า"
          }
        },
        "tr": {
