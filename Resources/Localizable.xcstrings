    "settings.betaFeatures.workspaceTodosChecklistStyle.subtitleInline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicking a row's checklist summary expands the items inline under the row."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行のチェックリスト概要をクリックすると、行の下に項目がインライン展開されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击行内的清单摘要，会在该行下方内联展开清单项。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Klicken auf die Checklisten-Zusammenfassung einer Zeile klappt die Einträge inline unter der Zeile auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquer sur le résumé de la liste de contrôle d’une ligne développe les éléments de manière intégrée sous la ligne."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي النقر فوق ملخص قائمة التحقق الخاص بالصف إلى توسيع العناصر بشكل مضمن أسفل الصف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer clic en el resumen de la lista de verificación de una fila expande los elementos en línea debajo de la fila."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下列的檢查清單摘要可在該列下方展開行內項目。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "행의 체크리스트 요약을 클릭하면 해당 행 아래에 항목들이 인라인으로 확장됩니다."
          }
        }
      }
    },
    "settings.betaFeatures.workspaceTodosChecklistStyle.subtitlePopover": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicking a row's checklist summary opens an anchored popover."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行のチェックリスト概要をクリックすると、アンカー付きのポップオーバーが開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击行内的清单摘要，会打开一个锚定的浮层。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Klicken auf die Checklisten-Zusammenfassung einer Zeile öffnet ein verankertes Popover."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquer sur le résumé de la liste de contrôle d’une ligne ouvre une fenêtre contextuelle ancrée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي النقر فوق ملخص قائمة التحقق الخاص بالصف إلى فتح نافذة منبثقة مثبتة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer clic en el resumen de la lista de verificación de una fila abre un popover anclado."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下列的檢查清單摘要可開啟錨定的彈出視窗。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "행의 체크리스트 요약을 클릭하면 고정된 팝오버가 열립니다."
          }
        }
      }
    },
