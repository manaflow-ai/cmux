        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ไม่ได้ติดตั้ง mosh-server บนโฮสต์ระยะไกล จึงดำเนินการต่อผ่าน SSH"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] Uzak ana makinede mosh-server kurulu değil; SSH üzerinden devam ediliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] mosh-server не встановлено на віддаленому хості; продовження через SSH."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] 远程主机未安装 mosh-server；将继续使用 SSH。"
          }
