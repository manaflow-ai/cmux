    "sleepyMode.settings.securityNote.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleepy Mode is a screensaver, not a lock — any key wakes it. For real security, use the “Lock Mac” button in the scene, which engages the actual macOS login lock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おやすみモードはロックではなくスクリーンセーバーです（任意のキーで解除）。本当のセキュリティが必要な場合は、画面内の「Mac をロック」ボタンを使うと、実際の macOS ログインロックがかかります。"
          }
        }
      }
    },
