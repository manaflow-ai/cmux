          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដំឡើង និងបើកផ្នែកបន្ថែមរបារចំហៀង CMUX ដើម្បីបង្ហាញវានៅទីនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
