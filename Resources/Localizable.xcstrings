        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TextBox はベータ機能です。テスト中のため、既定値や動作が変わる場合があります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TextBox គឺជាមុខងារបេតា។ តម្លៃលំនាំដើម និងឥរិយាបថអាចផ្លាស់ប្តូរនៅពេលកំពុងសាកល្បង។"
