    "cli.auth.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage: cmux auth <status|login|logout|team>\n\nstatus   Print whether the user is signed in (add `cmux --json` for JSON).\nlogin    Open the sign-in popup on the cmux web app and wait for it to finish.\nlogout   Clear the current session.\nteam     List teams or select one (`team list|use <team-id>|create <name>`)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使い方: cmux auth <status|login|logout|team>\n\nstatus   サインイン状態を表示します（JSON には `cmux --json` を追加）。\nlogin    cmux Web アプリのサインインポップアップを開き、完了を待ちます。\nlogout   現在のセッションを消去します。\nteam     チームを一覧表示または選択します（`team list|use <team-id>|create <name>`）。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendung: cmux auth <status|login|logout|team>\n\nstatus   Zeigt den Anmeldestatus an.\nlogin    Öffnet das Anmeldefenster.\nlogout   Löscht die aktuelle Sitzung.\nteam     Listet Teams auf oder wählt ein Team aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisation : cmux auth <status|login|logout|team>\n\nstatus   Affiche l’état de connexion.\nlogin    Ouvre la fenêtre de connexion.\nlogout   Efface la session actuelle.\nteam     Liste ou sélectionne une équipe."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستخدام: cmux auth <status|login|logout|team>\n\nstatus   يعرض حالة تسجيل الدخول.\nlogin    يفتح نافذة تسجيل الدخول.\nlogout   يمسح الجلسة الحالية.\nteam     يعرض الفرق أو يحدد فريقًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso: cmux auth <status|login|logout|team>\n\nstatus   Muestra el estado de inicio de sesión.\nlogin    Abre la ventana de inicio de sesión.\nlogout   Borra la sesión actual.\nteam     Lista o selecciona un equipo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用法：cmux auth <status|login|logout|team>\n\nstatus   顯示登入狀態。\nlogin    開啟登入視窗。\nlogout   清除目前工作階段。\nteam     列出或選取團隊。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用法：cmux auth <status|login|logout|team>\n\nstatus   显示登录状态。\nlogin    打开登录窗口。\nlogout   清除当前会话。\nteam     列出或选择团队。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용법: cmux auth <status|login|logout|team>\n\nstatus   로그인 상태를 표시합니다.\nlogin    로그인 창을 엽니다.\nlogout   현재 세션을 지웁니다.\nteam     팀을 나열하거나 선택합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bruk: cmux auth <status|login|logout|team>\n\nstatus   Skriv ut om brukeren er innlogget (legg til `cmux --json` for JSON).\nlogin    Åpne innloggingspopupen i cmux-webappen og vent til den er ferdig.\nlogout   Tøm gjeldende økt.\nteam     List opp team eller velg ett (`team list|use <team-id>|create <name>`)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Использование: cmux auth <status|login|logout|team>\n\nstatus   Показать, выполнен ли вход (добавьте `cmux --json` для JSON).\nlogin    Открыть окно входа в веб-приложении cmux и дождаться завершения.\nlogout   Завершить текущий сеанс.\nteam     Список команд или выбор одной (`team list|use <team-id>|create <name>`)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kullanım: cmux auth <status|login|logout|team>\n\nstatus   Kullanıcının oturum açıp açmadığını yazdırır (JSON için `cmux --json` ekleyin).\nlogin    cmux web uygulamasında oturum açma açılır penceresini açar ve bitmesini bekler.\nlogout   Mevcut oturumu temizler.\nteam     Takımları listeler veya birini seçer (`team list|use <team-id>|create <name>`)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Використання: cmux auth <status|login|logout|team>\n\nstatus   Вивести, чи увійшов користувач (додайте `cmux --json` для JSON).\nlogin    Відкрити спливаюче вікно входу у веб-застосунку cmux і чекати завершення.\nlogout   Очистити поточний сеанс.\nteam     Перелічити команди або вибрати одну (`team list|use <team-id>|create <name>`)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usage: cmux auth <status|login|logout|team>\n\nstatus   In trạng thái đăng nhập của người dùng (thêm `cmux --json` để có JSON).\nlogin    Mở cửa sổ đăng nhập trên ứng dụng web cmux và chờ hoàn tất.\nlogout   Xóa phiên hiện tại.\nteam     Liệt kê nhóm hoặc chọn một nhóm (`team list|use <team-id>|create <name>`)."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usage: cmux auth <status|login|logout|team>\n\nstatus   បង្ហាញថាតើអ្នកប្រើបានចូលគណនីឬអត់ (បន្ថែម `cmux --json` សម្រាប់ JSON)។\nlogin    បើក popup ចូលគណនីនៅលើ cmux web app ហើយរង់ចាំរហូតដល់ចប់។\nlogout   លុបសម័យប្រើបច្ចុប្បន្ន។\nteam     រាយបញ្ជីក្រុម ឬជ្រើសរើសមួយ (`team list|use <team-id>|create <name>`)។"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การใช้งาน: cmux auth <status|login|logout|team>\n\nstatus   แสดงสถานะการลงชื่อเข้าใช้ (เพิ่ม `cmux --json` สำหรับ JSON)\nlogin    เปิดป๊อปอัปลงชื่อเข้าใช้บนเว็บแอป cmux และรอจนเสร็จสิ้น\nlogout   ล้างเซสชันปัจจุบัน\nteam     แสดงรายการทีมหรือเลือกทีม (`team list|use <team-id>|create <name>`)"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Upotreba: cmux auth <status|login|logout|team>\n\nstatus   Ispiši je li korisnik prijavljen (dodaj `cmux --json` za JSON).\nlogin    Otvori popup za prijavu u cmux web aplikaciji i čekaj završetak.\nlogout   Obriši trenutnu sesiju.\nteam     Navedi timove ili odaberi jedan (`team list|use <team-id>|create <name>`)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uso: cmux auth <status|login|logout|team>\n\nstatus   Mostra se l'utente è connesso (aggiungi `cmux --json` per JSON).\nlogin    Apre il popup di accesso nell'app web cmux e attende il completamento.\nlogout   Cancella la sessione corrente.\nteam     Elenca i team o ne seleziona uno (`team list|use <team-id>|create <name>`)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Użycie: cmux auth <status|login|logout|team>\n\nstatus   Wyświetla stan zalogowania użytkownika (dodaj `cmux --json` dla JSON).\nlogin    Otwiera okno logowania w aplikacji webowej cmux i czeka na zakończenie.\nlogout   Czyści bieżącą sesję.\nteam     Wyświetla zespoły lub wybiera jeden (`team list|use <team-id>|create <name>`)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uso: cmux auth <status|login|logout|team>\n\nstatus   Exibe se o usuário está autenticado (use `cmux --json` para JSON).\nlogin    Abre o popup de login no app web cmux e aguarda a conclusão.\nlogout   Encerra a sessão atual.\nteam     Lista equipes ou seleciona uma (`team list|use <team-id>|create <name>`)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brug: cmux auth <status|login|logout|team>\n\nstatus   Udskriv om brugeren er logget ind (tilføj `cmux --json` for JSON).\nlogin    Åbn login-popup i cmux-webappen og vent på, at den afsluttes.\nlogout   Ryd den aktuelle session.\nteam     Vis teams eller vælg et (`team list|use <team-id>|create <name>`)."
          }
        }
      }
    },
