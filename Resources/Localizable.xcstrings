            "state": "translated",
            "value": "الطرفية ليست جاهزة للاتصال"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "el terminal no está listo para conectarse"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終端機尚未準備好連線"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端尚未准备好连接"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널이 연결할 준비가 되지 않았습니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルの接続準備ができていません"
          }
        }
      }
    },
    "cloud.portAccess.invalidURL": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This port does not have a valid HTTP or HTTPS address."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Port hat keine gültige HTTP- oder HTTPS-Adresse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce port n’a pas d’adresse HTTP ou HTTPS valide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este puerto no tiene una dirección HTTP o HTTPS válida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このポートには有効なHTTPまたはHTTPSアドレスがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 포트에 유효한 HTTP 또는 HTTPS 주소가 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此端口没有有效的 HTTP 或 HTTPS 地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此連接埠沒有有效的 HTTP 或 HTTPS 位址。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي هذا المنفذ على عنوان HTTP أو HTTPS صالح."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj port nema važeću HTTP ili HTTPS adresu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne port har ingen gyldig HTTP- eller HTTPS-adresse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa porta non ha un indirizzo HTTP o HTTPS valido."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne porten har ingen gyldig HTTP- eller HTTPS-adresse."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten port nie ma prawidłowego adresu HTTP ani HTTPS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta porta não tem um endereço HTTP ou HTTPS válido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого порта нет действительного адреса HTTP или HTTPS."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей порт не має дійсної адреси HTTP або HTTPS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bağlantı noktasının geçerli bir HTTP veya HTTPS adresi yok."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พอร์ตนี้ไม่มีที่อยู่ HTTP หรือ HTTPS ที่ถูกต้อง"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ច្រកនេះមិនមានអាសយដ្ឋាន HTTP ឬ HTTPS ត្រឹមត្រូវទេ។"
