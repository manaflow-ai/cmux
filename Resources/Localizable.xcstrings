          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjernet Campfire cmux-utvidelse fra %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięto rozszerzenie Campfire cmux z %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Extensão Campfire cmux removida de %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расширение Campfire cmux удалено из %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบส่วนขยาย Campfire cmux ออกจาก %@ แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Campfire cmux uzantısı %@ konumundan kaldırıldı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розширення Campfire cmux видалено з %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已从 %@ 移除 Campfire cmux 扩展"
          }
        },
        "zh-Hant": {
