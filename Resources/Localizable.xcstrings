    "cli.error.notifyClearSurfaceRequiresTarget": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface requires workspace or window context; specify --workspace or --window"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface にはワークスペースまたはウィンドウのコンテキストが必要です。--workspace または --window を指定してください"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب notify --clear --surface سياق مساحة عمل أو نافذة؛ حدّد --workspace أو --window"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface zahtijeva kontekst radnog prostora ili prozora; navedite --workspace ili --window"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface kræver workspace- eller vindueskontekst; angiv --workspace eller --window"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface erfordert einen Workspace- oder Fensterkontext; geben Sie --workspace oder --window an"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface requiere un contexto de espacio de trabajo o ventana; especifica --workspace o --window"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface nécessite un contexte d’espace de travail ou de fenêtre ; indiquez --workspace ou --window"
          }
        },
        "it": {
          "stringUnit": {
