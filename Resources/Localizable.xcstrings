    "cloudTree.terminal.detached.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still running on the machine, but no tab shows it. Click to open it in a pane; right-click to kill it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシン上でまだ実行中ですが、表示しているタブはありません。クリックでペインに開き、右クリックで強制終了できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在机器上运行，但没有标签页显示它。点按可在窗格中打开；右键点按可终止它。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft weiterhin auf der Maschine, wird aber in keinem Tab angezeigt. Klicken, um es in einem Teilfenster zu öffnen; Rechtsklick, um es zu beenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours en cours d’exécution sur la machine, mais aucun onglet ne l’affiche. Cliquez pour l’ouvrir dans un volet ; faites un clic droit pour le tuer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تزال تعمل على الجهاز، ولكن لا تظهر في أي علامة تبويب. انقر لفتحها في جزء؛ وانقر بزر الماوس الأيمن لإنهائها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue ejecutándose en la máquina, pero ninguna pestaña la muestra. Haz clic para abrirla en un panel; haz clic derecho para finalizarla."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在機器上執行，但沒有標籤頁顯示它。點擊以在窗格中開啟；按右鍵以強制結束。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에서 계속 실행 중이지만 표시하는 탭이 없습니다. 클릭하여 분할 창에서 열거나 우클릭하여 종료하세요."
          }
        }
      }
    },
