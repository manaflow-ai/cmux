    "cli.browser.profile.error.navigateUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "--profile is only supported when browser open creates a new pane; omit the surface selector"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "--profile は browser open が新しいペインを作成する場合にのみ使用できます。サーフェスセレクターを省略してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "--profile 仅在 browser open 创建新窗格时受支持；请省略 surface 选择器"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "--profile wird nur unterstützt, wenn das Öffnen des Browsers ein neues Teilfenster erstellt; lassen Sie den Oberflächen-Selektor weg"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "--profile est uniquement pris en charge lorsque l'ouverture d'un navigateur crée un nouveau volet ; omettez le sélecteur de surface d’affichage"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم دعم --profile فقط عندما ينشئ browser open جزءًا جديدًا؛ احذف محدد السطح"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "--profile solo se admite cuando browser open crea un panel nuevo; omite el selector de superficie"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在 browser open 建立新窗格時才支援 --profile；請省略介面選擇器"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "--profile은 브라우저 열기가 새 분할 창을 생성할 때만 지원됩니다. 화면 선택기를 생략하세요."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "--profile je podržan samo kada browser open kreira novo okno; izostavite selektor površine"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "--profile understøttes kun, når browser open opretter en ny rude; udelad surface-selektoren"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "--profile è supportato solo quando browser open crea un nuovo riquadro; ometti il selettore di superficie"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "--profile គាំទ្រតែពេល browser open បង្កើត pane ថ្មី; លុប surface selector ចេញ"
          }
        },
        "nb": {
