    "sessionIndex.checkpoints.restoreHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore rewinds by forking a new session — the original session is never modified"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元は新しいセッションをフォークして巻き戻します。元のセッションは変更されません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复是通过分叉出新会话来回退的 —— 原会话永远不会被修改"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wiederherstellen spult zurück, indem eine neue Sitzung abgespalten wird — die originale Sitzung wird nie geändert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauration rembobine en bifurquant une nouvelle session — la session d’origine n’est jamais modifiée"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم الاسترداد بالتراجع عن طريق تفريع جلسة جديدة — ولا يتم تعديل الجلسة الأصلية أبداً"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauración rebobina bifurcando una nueva sesión — la sesión original nunca se modifica"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還原會透過分支新的工作階段來倒回 — 絕不會修改原始的工作階段"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원은 새 세션을 포크하여 되돌립니다 — 원본 세션은 전혀 수정되지 않습니다"
          }
        }
      }
    },
