    "panel.cloudVM.loading.failed.auth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux could not open a passwordless terminal session. Try opening the Cloud VM again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmuxはパスワードなしのターミナルセッションを開けませんでした。Cloud VMをもう一度開いてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 无法打开免密码的终端会话。请重新尝试打开 Cloud VM。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux konnte keine kennwortlose Terminal-Sitzung öffnen. Versuchen Sie erneut, die Cloud-VM zu öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux n’a pas pu ouvrir une session de terminal sans mot de passe. Réessayez d’ouvrir la VM Cloud."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على cmux فتح جلسة طرفية بدون كلمة مرور. حاول فتح الجهاز الافتراضي السحابي (Cloud VM) مجددًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no pudo abrir una sesión de terminal sin contraseña. Intenta abrir la Cloud VM de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 無法開啟免密碼的終端機工作階段。請嘗試重新開啟 Cloud VM。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 비밀번호 없는 터미널 세션을 열 수 없습니다. Cloud VM을 다시 열어 보세요."
          }
        }
      }
    },
