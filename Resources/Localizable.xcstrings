    "settings.notifications.agentIdleReminder.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify when an agent has been idle waiting for your input. Suppressed while background work is still running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントがあなたの入力を待って待機しているときに通知します。バックグラウンド作業の実行中は抑制されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 사용자의 입력을 기다리며 유휴 상태일 때 알립니다. 백그라운드 작업이 실행 중일 때는 억제됩니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщати, коли агент неактивний і очікує вашого вводу. Придушується, доки виконується фонова робота."
          }
        }
      }
    },
    "settings.notifications.agentIdleReminder.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent Waiting for Input"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが入力待ち"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 입력 대기 중"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент очікує вводу"
          }
        }
      }
    },
    "settings.notifications.agentPermissionPrompt.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify when an agent is blocked waiting for your permission to run a tool."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントがツールの実行にあなたの許可を待って停止しているときに通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 도구 실행에 대한 사용자의 허가를 기다리며 멈췄을 때 알립니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщати, коли агент заблоковано в очікуванні вашого дозволу на запуск інструмента."
          }
        }
      }
    },
    "settings.notifications.agentPermissionPrompt.title": {
