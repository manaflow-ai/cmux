    "settings.terminal.copyOnSelect.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يضيف cmux نسخًا إلى حافظة النظام عند التحديد. لا تزال إعدادات Ghostty تتحكم في «لصق التحديد»."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ne dodaje kopiranje u sistemski međuspremnik pri odabiru. Ghostty konfiguracija i dalje kontroliše Lijepljenje odabira."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux tilføjer ikke kopiering til systemets udklipsholder ved markering. Ghostty-konfiguration styrer stadig Indsæt markering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux fügt beim Auswählen kein Kopieren in die Systemzwischenablage hinzu. Die Ghostty-Konfiguration steuert weiterhin „Auswahl einfügen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux does not add system-clipboard copy on selection. Ghostty config still controls Paste Selection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no añade copia al portapapeles del sistema al seleccionar. La configuración de Ghostty sigue controlando Pegar selección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux n’ajoute pas de copie vers le presse-papiers système lors de la sélection. La configuration Ghostty contrôle toujours Coller la sélection."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux non aggiunge la copia negli appunti di sistema alla selezione. La configurazione di Ghostty controlla ancora Incolla selezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux は選択時のシステムクリップボードへのコピーを追加しません。Ghostty 設定が引き続き「選択をペースト」を制御します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux មិនបន្ថែមការចម្លងទៅ clipboard របស់ប្រព័ន្ធពេលជ្រើសទេ។ ការកំណត់ Ghostty នៅតែគ្រប់គ្រង Paste Selection។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux는 선택 시 시스템 클립보드 복사를 추가하지 않습니다. Ghostty 설정이 계속 Paste Selection을 제어합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux legger ikke til kopiering til systemutklippstavlen ved markering. Ghostty-konfigurasjonen styrer fortsatt Lim inn markering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nie dodaje kopiowania do schowka systemowego przy zaznaczaniu. Konfiguracja Ghostty nadal steruje funkcją Wklej zaznaczenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux não adiciona cópia para a área de transferência do sistema ao selecionar. A configuração do Ghostty ainda controla Colar seleção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux не добавляет копирование в системный буфер обмена при выделении. Конфигурация Ghostty по-прежнему управляет «Вставить выделение»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux จะไม่เพิ่มการคัดลอกไปยังคลิปบอร์ดของระบบเมื่อเลือก การกำหนดค่า Ghostty ยังคงควบคุม Paste Selection"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux seçim sırasında sistem panosuna kopyalamayı eklemez. Ghostty yapılandırması Paste Selection denetimini sürdürür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux не додає копіювання до системного буфера обміну під час виділення. Конфігурація Ghostty й надалі керує «Вставити виділення»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 不会在选择时额外复制到系统剪贴板。Ghostty 配置仍控制“粘贴选择”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 不會在選取時額外複製到系統剪貼簿。Ghostty 設定仍控制「貼上選取」。"
          }
        }
      }
    },
    "settings.terminal.copyOnSelect.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُنسخ نص الطرفية المحدد أيضًا إلى حافظة النظام عند تثبيت التحديد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odabrani tekst terminala također se kopira u sistemski međuspremnik kada se odabir potvrdi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeret terminaltekst kopieres også til systemets udklipsholder, når markeringen bekræftes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählter Terminaltext wird zusätzlich in die Systemzwischenablage kopiert, sobald die Auswahl bestätigt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected terminal text is also copied to the system clipboard when the selection is committed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto seleccionado del terminal también se copia al portapapeles del sistema cuando se confirma la selección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte sélectionné dans le terminal est aussi copié dans le presse-papiers système lorsque la sélection est validée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo selezionato nel terminale viene copiato anche negli appunti di sistema quando la selezione viene confermata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択が確定したとき、ターミナルで選択したテキストをシステムクリップボードにもコピーします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អត្ថបទ terminal ដែលបានជ្រើសនឹងត្រូវចម្លងទៅ clipboard របស់ប្រព័ន្ធផងដែរ ពេលការជ្រើសត្រូវបានបញ្ជាក់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택이 확정되면 선택한 터미널 텍스트도 시스템 클립보드에 복사됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Markert terminaltekst kopieres også til systemutklippstavlen når markeringen bekreftes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznaczony tekst terminala jest też kopiowany do schowka systemowego po zatwierdzeniu zaznaczenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto selecionado no terminal também é copiado para a área de transferência do sistema quando a seleção é confirmada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделенный текст терминала также копируется в системный буфер обмена после подтверждения выделения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความเทอร์มินัลที่เลือกจะถูกคัดลอกไปยังคลิปบอร์ดของระบบด้วยเมื่อยืนยันการเลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçim kesinleştiğinde seçilen terminal metni sistem panosuna da kopyalanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибраний текст термінала також копіюється до системного буфера обміну після підтвердження виділення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认选择后，所选终端文本也会复制到系统剪贴板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認選取後，所選終端機文字也會複製到系統剪貼簿。"
          }
        }
      }
    },
    "settings.terminal.memoryGuardrail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runaway Memory Guardrail"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暴走メモリガードレール"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内存失控防护"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schutz vor ausufernder Speichernutzung"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde-fou pour mémoire hors de contrôle"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاجز حماية الذاكرة الجامحة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protección contra memoria descontrolada"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記憶體失控防護機制"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모리 폭주 가드레일"
          }
        }
      }
    },
    "settings.terminal.memoryGuardrail.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No warning is shown when a pane's process tree grows large. A leaking process can OOM-suspend the entire app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペインのプロセスツリーが大きくなっても警告は表示されません。リークしたプロセスがアプリ全体を OOM で停止させる可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗格的进程树变大时不显示警告。泄漏的进程可能因内存不足导致整个应用被挂起。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird keine Warnung angezeigt, wenn der Prozessbaum eines Teilfensters stark anwächst. Ein Speicherleck in einem Prozess kann die gesamte App durch einen Out-of-Memory-Fehler lahmlegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun avertissement ne s’affiche lorsque l’arborescence des processus d’un volet s'agrandit. Un processus qui fuit peut suspendre l’application entière par manque de mémoire (OOM)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يظهر أي تحذير عندما تصبح شجرة عمليات الجزء كبيرة. يمكن أن تؤدي عملية تسريب إلى تعليق التطبيق بأكمله بسبب نفاد الذاكرة (OOM)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se muestra ninguna advertencia cuando el árbol de procesos de un panel crece demasiado. Un proceso con fugas de memoria puede suspender toda la aplicación por falta de memoria (OOM)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當窗格的處理程序樹增長過大時，不會顯示任何警告。發生洩漏的處理程序可能會導致整個軟體因記憶體耗盡（OOM）而暫停。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분할 창의 프로세스 트리가 거대해져도 경고가 표시되지 않습니다. 프로세스 누수로 인해 앱 전체가 OOM(메모리 부족)으로 정지될 수 있습니다."
          }
        }
      }
    },
    "settings.terminal.memoryGuardrail.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux warns you with a badge and a banner when one pane's process tree uses too much memory, so a single leak can't crash the whole app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つのペインのプロセスツリーが過剰なメモリを使用すると、バッジとバナーで警告します。1件のリークでアプリ全体がクラッシュするのを防ぎます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当某个窗格的进程树占用过多内存时，cmux 会用角标和横幅提示，避免单个泄漏拖垮整个应用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux warnt Sie mit einem Badge und einem Banner, wenn der Prozessbaum eines Teilfensters zu viel Speicher verbraucht, sodass ein einzelnes Leck nicht die gesamte App abstürzen lassen kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux vous avertit par un badge et une bannière lorsque l’arborescence des processus d’un volet utilise trop de mémoire, afin qu’une simple fuite ne fasse pas planter toute l’application."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذرك cmux بشارة ولافتة عندما تستهلك شجرة عمليات جزء واحد ذاكرة أكثر من اللازم، حتى لا يتسبب تسريب واحد في تعطل التطبيق بأكمله."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux te advierte con una insignia y un banner cuando el árbol de procesos de un panel usa demasiada memoria, de modo que una sola fuga no pueda colapsar toda la aplicación."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當單一窗格的處理程序樹耗用過多記憶體時，cmux 會以徽章和橫幅警告您，如此一來，單一洩漏就不會導致整個軟體當機。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나의 분할 창에 속한 프로세스 트리가 메모리를 지나치게 많이 사용하면 cmux가 배지와 배너로 경고를 표시하므로, 단일 누수로 인해 앱 전체가 다운되는 것을 방지합니다."
          }
        }
      }
    },
    "settings.terminal.memoryGuardrail.threshold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory Warning Threshold (GB)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリ警告のしきい値（GB）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内存警告阈值（GB）"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grenzwert für Speicherwarnung (GB)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuil d'avertissement de mémoire (Go)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عتبة تحذير الذاكرة (جيجابايت)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Umbral de advertencia de memoria (GB)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記憶體警告門檻值 (GB)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모리 경고 임계값 (GB)"
          }
        }
      }
    },
    "settings.terminal.memoryGuardrail.threshold.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pane is flagged once its combined process-tree memory crosses this many gigabytes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペインのプロセスツリーの合計メモリがこのギガバイト数を超えるとフラグが立てられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当窗格的进程树内存合计超过这么多 GB 时，该窗格会被标记。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Teilfenster wird markiert, sobald der Speicher des gesamten Prozessbaums diese Anzahl an Gigabytes überschreitet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un volet est signalé dès que la mémoire combinée de son arborescence de processus dépasse ce nombre de gigaoctets."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تمييز الجزء بمجرد أن تتجاوز الذاكرة المجمعة لشجرة عملياته هذا العدد من الجيجابايت."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un panel se marca una vez que la memoria combinada de su árbol de procesos supera esta cantidad de gigabytes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一旦窗格的處理程序樹合併記憶體超過此 GB 數，該窗格就會被標記。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분할 창의 결합된 프로세스 트리 메모리가 지정된 기가바이트를 초과하면 해당 분할 창에 플래그가 지정됩니다."
          }
        }
      }
    },
    "settings.terminal.rendererRealization": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim Offscreen Terminal Memory"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフスクリーン端末のメモリを回収"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回收屏幕外终端内存"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicher von nicht sichtbaren Terminals freigeben"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupérer la mémoire du terminal hors écran"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعادة ذاكرة الطرفية الخارجة عن الشاشة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclama la memoria de las terminales fuera de pantalla"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回收螢幕外終端機記憶體"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 밖 터미널 메모리 회수"
          }
        }
      }
    },
    "settings.terminal.rendererRealization.idleSeconds": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim After Idle Seconds"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイドル秒数経過後に回収"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空闲多少秒后回收"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigeben nach Sekunden im Leerlauf"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupérer après plusieurs secondes d'inactivité"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستعادة بعد ثوانٍ من الخمول"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclamar después de segundos de inactividad"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閒置指定秒數後回收"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유휴 시간(초) 후 회수"
          }
        }
      }
    },
    "settings.terminal.rendererRealization.idleSeconds.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An off-screen terminal must stay off-screen this long before its renderer memory is reclaimed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフスクリーンの端末は、レンダラーのメモリが回収されるまでこの時間オフスクリーンのままである必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕外终端必须保持在屏幕外这么久，其渲染器内存才会被回收。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein nicht sichtbares Terminal muss so lange außerhalb des Bildschirms bleiben, bevor der Speicher seines Renderers freigegeben wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un terminal hors écran doit le rester pendant cette durée avant que la mémoire de son moteur de rendu ne soit récupérée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تظل الطرفية الخارجة عن الشاشة خارج الشاشة لهذه المدة قبل استعادة ذاكرة مصيرها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una terminal fuera de pantalla debe permanecer fuera de pantalla este tiempo antes de que se reclame la memoria de su renderizador."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕外終端機必須保持在螢幕外達此長度，其轉譯器記憶體才會被回收。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 밖의 터미널이 이 시간 동안 화면 밖에 유지되어야 렌더러 메모리가 회수됩니다."
          }
        }
      }
    },
    "settings.terminal.rendererRealization.maxWarmRenderers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Max Warm Renderers"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォームレンダラーの最大数"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最大热渲染器数"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximale Anzahl warmer Renderer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre max de moteurs de rendu prêts"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحد الأقصى للمصيرات الجاهزة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderizadores listos máximos"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持預熱的轉譯器數量上限"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 웜 렌더러 수"
          }
        }
      }
    },
    "settings.terminal.rendererRealization.maxWarmRenderers.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most recently visible terminals keep their renderer ready so switching stays instant. Extra off-screen renderers are reclaimed oldest first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近表示した端末はレンダラーを準備状態に保ち、切り替えを高速に保ちます。余分なオフスクリーンのレンダラーは古いものから回収されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近可见的终端会保留其渲染器就绪状态，以便切换保持瞬时。多出的屏幕外渲染器按最旧优先回收。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die zuletzt sichtbaren Terminals halten ihren Renderer bereit, damit das Umschalten sofort erfolgt. Zusätzliche nicht sichtbare Renderer werden beginnend mit dem ältesten freigegeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les terminaux les plus récemment visibles maintiennent leur moteur de rendu prêt pour un changement instantané. Les moteurs de rendu hors écran supplémentaires sont récupérés en commençant par les plus anciens."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتفظ الطرفيات الأحدث ظهورًا بمصيرها جاهزًا بحيث يظل التبديل فوريًا. يتم استعادة المصيرات الخارجة عن الشاشة الإضافية، الأقدم أولاً."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las terminales visibles más recientemente mantienen su renderizador listo para que el cambio siga siendo instantáneo. Los renderizadores fuera de pantalla adicionales se reclaman empezando por el más antiguo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近顯示的終端機會保持其轉譯器就緒，以便即時進行切換。超出上限的螢幕外轉譯器將從最舊的開始回收。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 최근에 표시된 터미널은 렌더러를 준비 상태로 유지하여 전환이 즉시 이루어지도록 합니다. 추가로 존재하는 화면 밖의 렌더러는 가장 오래된 것부터 차례대로 회수됩니다."
          }
        }
      }
    },
    "settings.terminal.rendererRealization.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every visited terminal keeps its full GPU renderer allocated until you close it, even when off-screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訪問した端末は、オフスクリーンでも閉じるまでGPUレンダラーをすべて確保し続けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个访问过的终端在关闭前都会一直占用完整的 GPU 渲染器，即使在屏幕外也是如此。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes geöffnete Terminal behält seinen zugewiesenen GPU-Renderer, bis Sie es schließen, selbst wenn es nicht sichtbar ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque terminal visité conserve la totalité de son moteur de rendu GPU alloué jusqu’à sa fermeture, même lorsqu’il est hors écran."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتفظ كل طرفية تمت زيارتها بمصير GPU الكامل المخصص لها حتى تقوم بإغلاقها، حتى عندما تكون خارج الشاشة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada terminal visitada mantiene su renderizador de GPU completo asignado hasta que la cierres, incluso cuando está fuera de pantalla."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使位於螢幕外，每個存取過的終端機都會維持配置完整的 GPU 轉譯器，直到您將其關閉為止。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 방문한 모든 터미널은 닫기 전까지는 화면 밖에 있더라도 전체 GPU 렌더러를 할당된 상태로 유지합니다."
          }
        }
      }
    },
    "settings.terminal.rendererRealization.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off-screen terminals release their GPU renderer memory while idle and rebuild it instantly when you switch back. The process keeps running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフスクリーンの端末はアイドル中にGPUレンダラーのメモリを解放し、切り替え時に即座に再構築します。プロセスは動作し続けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕外终端在空闲时释放其 GPU 渲染器内存，切换回来时会瞬时重建。进程会继续运行。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht sichtbare Terminals geben ihren GPU-Renderer-Speicher im Leerlauf frei und bauen ihn beim Zurückwechseln sofort wieder auf. Der Prozess läuft im Hintergrund weiter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les terminaux hors écran libèrent la mémoire de leur moteur de rendu GPU lorsqu’ils sont inactifs et la reconstruisent instantanément lorsque vous y revenez. Le processus continue de s’exécuter."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحرر الطرفيات الخارجة عن الشاشة ذاكرة مصير GPU الخاص بها أثناء الخمول وتقوم بإعادة بنائها فورًا عند الرجوع إليها. وتستمر العملية في العمل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las terminales fuera de pantalla liberan su memoria de renderizador de GPU mientras están inactivas y la reconstruyen instantáneamente cuando vuelves a cambiar a ellas. El proceso sigue ejecutándose."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕外的終端機在閒置時會釋放其 GPU 轉譯器記憶體，並在您切換回時立即重建。程序將保持執行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 밖에 있는 터미널은 유휴 상태일 때 GPU 렌더러 메모리를 해제하고, 사용자가 다시 전환할 때 즉시 재구축합니다. 해당 프로세스는 계속 실행됩니다."
          }
        }
      }
    },
