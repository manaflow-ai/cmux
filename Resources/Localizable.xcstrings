    "cli.workflow.full-stack-dev.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a dev server, test watcher, and browser preview, with optional Git and Feed Dock controls."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne einen Dev-Server, Test-Watcher und eine Browservorschau mit optionalen Git- und Feed-Dock-Steuerelementen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez un serveur de développement, un observateur de tests et un aperçu navigateur, avec des contrôles Git et Feed facultatifs dans le Dock."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح خادم التطوير ومراقب الاختبارات ومعاينة المتصفح، مع عناصر Git وFeed اختيارية في Dock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un servidor de desarrollo, un observador de pruebas y una vista previa del navegador, con controles opcionales de Git y Feed en el Dock."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟開發伺服器、測試監看器與瀏覽器預覽，並可加入 Git 和 Feed Dock 控制項。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开开发服务器、测试监视器和浏览器预览，并可添加 Git 和 Feed Dock 控件。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발 서버, 테스트 감시기, 브라우저 미리보기를 열고 Git 및 Feed Dock 제어기를 선택적으로 추가합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発サーバー、テスト監視、ブラウザプレビューを開き、Git と Feed Dock 操作を追加できます。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otvorite dev server, praćenje testova i pregled u browseru, s opcionalnim Git i Feed Dock kontrolama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åbn en dev-server, test-overvåger og browserforhåndsvisning med valgfri Git- og Feed Dock-betjeningselementer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apre un server di sviluppo, un watcher per i test e un'anteprima browser, con controlli opzionali per Git e Feed Dock."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បើក dev server, test watcher, និង browser preview ជាមួយការគ្រប់គ្រង Git និង Feed Dock ស្រេចចិត្ត។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åpne en dev-server, testwatcher og nettleserforhåndsvisning, med valgfrie Git- og Feed Dock-kontroller."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otwiera serwer deweloperski, obserwator testów i podgląd przeglądarki z opcjonalnymi kontrolkami Git i Feed Dock."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abre um servidor de desenvolvimento, observador de testes e pré-visualização no browser, com controles opcionais de Git e Feed Dock."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Открыть dev-сервер, наблюдатель тестов и предпросмотр браузера с опциональным управлением Git и Feed Dock."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิด dev server, test watcher และ browser preview พร้อมตัวควบคุม Git และ Feed Dock เสริม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İsteğe bağlı Git ve Feed Dock kontrolleriyle bir geliştirici sunucusu, test izleyici ve tarayıcı önizlemesi açar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відкрити dev-сервер, спостерігач тестів і браузерний попередній перегляд із необов'язковими елементами керування Git і Feed Dock."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mở dev server, test watcher và browser preview, với các điều khiển Git và Feed Dock tùy chọn."
          }
        }
      }
    },
