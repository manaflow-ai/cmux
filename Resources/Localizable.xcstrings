    "settings.app.openSupportedFilesInCmux.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-clicking readable files opens text, code, PDFs, images, audio, video, and Quick Look previews in cmux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り可能なファイルを Cmd+クリックすると、テキスト、コード、PDF、画像、音声、動画、Quick Look プレビューを cmux で開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd+点击可读文件时，会在 cmux 中打开文本、代码、PDF、图片、音频、视频和快速查看预览。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-Klick auf lesbare Dateien öffnet Text, Code, PDFs, Bilder, Audio, Video und Quick-Look-Vorschauen in cmux."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquer sur un fichier lisible tout en maintenant la touche Cmd enfoncée ouvre du texte, du code, des PDF, des images, de l’audio, de la vidéo ainsi que des aperçus Coup d’œil dans cmux."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي النقر مع الضغط على مفتاح Cmd على الملفات القابلة للقراءة إلى فتح النصوص والتعليمات البرمجية وملفات PDF والصور والملفات الصوتية ومقاطع الفيديو ومعاينات نظرة سريعة (Quick Look) في cmux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer Cmd-clic en archivos legibles abre texto, código, archivos PDF, imágenes, audio, video y previsualizaciones de Quick Look en cmux."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Cmd 並點擊可讀檔案，即可在 cmux 中開啟文字、程式碼、PDF、圖片、音訊、影片和快速查看預覽。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽을 수 있는 파일을 Cmd-클릭하면 텍스트, 코드, PDF, 이미지, 오디오, 비디오 및 훑어보기(Quick Look) 미리보기가 cmux에서 열립니다."
          }
        }
      }
    },
    "settings.app.paneFirstClickFocus": {
      "extractionState": "manual",
