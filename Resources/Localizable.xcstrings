            "value": "Überprüfen Sie die Kontodetails im Browser und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les détails du compte dans le navigateur et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
