    "sidebar.extensions.empty.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت امتداد شريط جانبي لـ CMUX وفعّله لعرضه هنا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalirajte i omogućite CMUX ekstenziju bočne trake da bi se prikazala ovdje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer og aktivér en CMUX-sidebjælkeudvidelse for at vise den her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installieren und aktivieren Sie eine CMUX-Seitenleisten-Erweiterung, um sie hier anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install and enable a CMUX sidebar extension to show it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala y activa una extensión de barra lateral de CMUX para mostrarla aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez et activez une extension de barre latérale CMUX pour l’afficher ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa e abilita un’estensione della barra laterale di CMUX per mostrarla qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに表示するには、CMUXサイドバー拡張機能をインストールして有効にしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដំឡើង និងបើកផ្នែកបន្ថែមរបារចំហៀង CMUX ដើម្បីបង្ហាញវានៅទីនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 표시하려면 CMUX 사이드바 확장 기능을 설치하고 활성화하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer og aktiver en CMUX-sidefeltutvidelse for å vise den her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstaluj i włącz rozszerzenie paska bocznego CMUX, aby wyświetlić je tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale e ative uma extensão da barra lateral do CMUX para mostrá-la aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите и включите расширение боковой панели CMUX, чтобы показать его здесь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้งและเปิดใช้ส่วนขยายแถบด้านข้าง CMUX เพื่อแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada göstermek için bir CMUX kenar çubuğu uzantısı yükleyip etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Установіть і ввімкніть розширення бічної панелі CMUX, щоб показати його тут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装并启用 CMUX 边栏扩展后，它会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝並啟用 CMUX 側邊欄擴充功能後，它會顯示在這裡。"
