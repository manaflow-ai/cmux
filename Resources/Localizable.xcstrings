    "update.popover.autoUpdatesDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لـ cmux التحقق تلقائيًا من التحديثات في الخلفية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux može automatski provjeravati ažuriranja u pozadini."
          }
