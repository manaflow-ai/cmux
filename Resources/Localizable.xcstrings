    "settings.browser.import.hint.note.hidden": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The blank-tab import hint is hidden. Turn it back on here any time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空タブのインポート案内は非表示です。ここでいつでも再表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 탭 가져오기 힌트가 숨겨져 있습니다. 여기서 언제든 다시 켤 수 있습니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підказка імпорту на порожній вкладці прихована. Увімкніть її тут у будь-який час."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空白标签页导入提示已隐藏。可随时在此处重新开启。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Importhinweis für leere Tabs ist ausgeblendet. Sie können ihn hier jederzeit wieder aktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suggestion d’importation pour les onglets vides est masquée. Réactivez-la ici à tout moment."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلميح استيراد علامة التبويب الفارغة مخفي. يمكنك إعادة تشغيله هنا في أي وقت."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sugerencia de importación de pestaña en blanco está oculta. Vuelva a activarla aquí en cualquier momento."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空白標籤頁的匯入提示已隱藏。您可以隨時在此處重新開啟。"
          }
        }
      }
    },
    "settings.browser.import.hint.note.settingsOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blank tabs are currently using Settings only mode from the debug window."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、空タブはデバッグウィンドウの「設定のみ」モードになっています。"
          }
        },
        "ko": {
          "stringUnit": {
