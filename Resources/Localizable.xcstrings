    "cli.fork.codexCheckpointUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: جلسة الوكيل المحفوظة غير متاحة. تظل الوحدة الطرفية في الدليل المحفوظ الخاص بها؛ أعد المحاولة لاحقًا أو ابدأ جلسة وكيل جديدة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: sačuvana sesija agenta nije dostupna. Terminal ostaje u svom sačuvanom direktorijumu; pokušajte kasnije ili započnite novu sesiju agenta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: den gemte agentsession er ikke tilgængelig. Terminalen forbliver i dens gemte mappe; prøv igen senere eller start en ny agentsession."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: Die gespeicherte Agentensitzung ist nicht verfügbar. Das Terminal bleibt in seinem gespeicherten Verzeichnis; Versuchen Sie es später erneut oder starten Sie eine neue Agentensitzung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: the saved agent session is unavailable. The terminal remains in its saved directory; retry later or start a new agent session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: la sesión guardada del agente no está disponible. El terminal permanece en su directorio guardado; Vuelva a intentarlo más tarde o inicie una nueva sesión de agente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: la session d'agent enregistrée n'est pas disponible. Le terminal reste dans son répertoire enregistré ; réessayez plus tard ou démarrez une nouvelle session d'agent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: la sessione dell'agente salvata non è disponibile. Il terminale rimane nella directory salvata; riprovare più tardi o avviare una nuova sessione dell'agente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: 保存されたエージェント セッションを利用できません。ターミナルは保存されたディレクトリに残っています。後でもう一度試すか、新しいエージェント セッションを開始してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: សម័យភ្នាក់ងារដែលបានរក្សាទុកគឺមិនមានទេ។ ស្ថានីយនៅតែមាននៅក្នុងថតដែលបានរក្សាទុករបស់វា; ព្យាយាមម្តងទៀតនៅពេលក្រោយ ឬចាប់ផ្តើមវគ្គភ្នាក់ងារថ្មី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: 저장된 에이전트 세션을 사용할 수 없습니다. 터미널은 저장된 디렉토리에 남아 있습니다. 나중에 다시 시도하거나 새 에이전트 세션을 시작하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: den lagrede agentøkten er utilgjengelig. Terminalen forblir i sin lagrede katalog; prøv på nytt senere eller start en ny agentøkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: zapisana sesja agenta jest niedostępna. Terminal pozostaje w zapisanym katalogu; spróbuj ponownie później lub rozpocznij nową sesję agenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: a sessão do agente salva não está disponível. O terminal permanece no diretório salvo; tente novamente mais tarde ou inicie uma nova sessão do agente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: сохраненный сеанс агента недоступен. Терминал остается в сохраненном каталоге; повторите попытку позже или начните новый сеанс агента."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: เซสชันตัวแทนที่บันทึกไว้ไม่พร้อมใช้งาน เทอร์มินัลยังคงอยู่ในไดเร็กทอรีที่บันทึกไว้ ลองอีกครั้งในภายหลังหรือเริ่มเซสชันตัวแทนใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: kayıtlı temsilci oturumu kullanılamıyor. Terminal kayıtlı dizininde kalır; daha sonra tekrar deneyin veya yeni bir temsilci oturumu başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: збережена сесія агента недоступна. Термінал залишається у збереженому каталозі; повторіть спробу пізніше або почніть новий сеанс агента."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: 保存的代理会话不可用。终端保留在其保存的目录中；稍后重试或启动新的代理会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: 保存的代理會話不可用。終端保留在其保存的目錄中；稍後重試或啟動新的代理會話。"
          }
        }
      }
    },
