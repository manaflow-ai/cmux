    "settings.app.confirmQuit.subtitleDevOverride": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في بنية DEV، تأكيدات الإنهاء معطلة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "U DEV buildu potvrde izlaska su onemogućene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I DEV-builds er afslutningsbekræftelser deaktiveret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In DEV-Builds sind Beendigungsbestätigungen deaktiviert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DEV build: quit confirmations are disabled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En las compilaciones DEV, las confirmaciones de salida están desactivadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans les builds DEV, les confirmations de fermeture sont désactivées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nelle build DEV le conferme di uscita sono disattivate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DEV ビルドでは終了確認は無効です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នៅក្នុង DEV build ការបញ្ជាក់ពេលចាកចេញត្រូវបានបិទ។"
