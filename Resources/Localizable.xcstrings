      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TextBox ميزة تجريبية. قد تتغير القيم الافتراضية والسلوك أثناء الاختبار."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TextBox je beta funkcija. Zadane vrijednosti i ponašanje mogu se promijeniti tokom testiranja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TextBox er en beta-funktion. Standarder og adfærd kan ændre sig under test."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
