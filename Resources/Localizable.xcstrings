    "settings.terminal.sessionContentWidth.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal and agent chat content uses the full pane width."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルとエージェントチャットのコンテンツはペインの全幅を使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端和代理对话内容使用窗格的完整宽度。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal- und Agenten-Chat-Inhalte nutzen die gesamte Breite des Teilfensters."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu du terminal et du chat de l'agent utilise toute la largeur du volet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم محتوى الطرفية ودردشة الوكيل العرض الكامل للجزء."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido de la terminal y del chat de agentes usa el ancho completo del panel."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終端機與代理對話內容會使用完整窗格寬度。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 및 에이전트 채팅 콘텐츠가 분할 창의 전체 너비를 사용합니다."
          }
        }
      }
    },
    "settings.terminal.sessionContentWidth.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal and agent chat content wraps within this width. Narrow panes still use all available space."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルとエージェントチャットのコンテンツはこの幅内で折り返します。狭いペインでは利用可能な幅をすべて使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端和代理对话内容在此宽度内换行。窄窗格仍会使用全部可用空间。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal- und Agenten-Chat-Inhalte werden auf diese Breite umgebrochen. Schmale Teilfenster nutzen weiterhin den gesamten verfügbaren Platz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu du terminal et du chat de l’agent s’adapte à cette largeur. Les volets étroits continuent d’utiliser tout l’espace disponible."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلتف محتوى الطرفية ودردشة الوكيل ضمن هذا العرض. تستمر الأجزاء الضيقة في استخدام كل المساحة المتاحة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido de la terminal y del chat de agentes se ajusta dentro de este ancho. Los paneles estrechos siguen usando todo el espacio disponible."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終端機與代理對話內容會限制在此寬度內換行。狹窄的窗格仍會使用所有可用空間。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 및 에이전트 채팅 콘텐츠가 지정된 너비 내에서 줄바꿈됩니다. 좁은 분할 창에서는 사용 가능한 모든 공간을 계속 사용합니다."
          }
        }
      }
    },
