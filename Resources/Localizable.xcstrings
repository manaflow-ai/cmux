              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "سيتم إنهاء %d طرفيات تابعة لها معها. وللاحتفاظ بها، استخدم “إغلاق مساحة العمل” بدلاً من ذلك — حيث ستنتقل إلى مجمع الطرفيات."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "سيتم إنهاء %d طرفية تابعة لها معها. وللاحتفاظ بها, استخدم “إغلاق مساحة العمل” بدلاً من ذلك — حيث ستنتقل إلى مجمع الطرفيات."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "سيتم إنهاء %d طرفية تابعة لها معها. وللاحتفاظ بها، استخدم “إغلاق مساحة العمل” بدلاً من ذلك — حيث ستنتقل إلى مجمع الطرفيات."
                }
