        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brug --remove-generated-anchor kun til en anker-eneste gruppe, hvis anker blev oprettet af cmux."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ប្រើ --remove-generated-anchor តែសម្រាប់ anchor-only group ដែល anchor ត្រូវបានបង្កើតដោយ cmux ប៉ុណ្ណោះ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bruk --remove-generated-anchor kun for en anker-only-gruppe der ankeret ble opprettet av cmux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Используйте --remove-generated-anchor только для группы только с якорем, созданным cmux."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Використовуйте --remove-generated-anchor лише для групи, що складається тільки з якоря, який був створений cmux."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chỉ dùng --remove-generated-anchor cho nhóm chỉ có anchor được tạo bởi cmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ใช้ --remove-generated-anchor เฉพาะกับกลุ่มแบบ anchor เท่านั้น ที่ anchor ถูกสร้างโดย cmux"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koristite --remove-generated-anchor samo za grupu samo s sidrom čije je sidro kreirao cmux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usare --remove-generated-anchor solo per un gruppo solo-anchor il cui anchor è stato creato da cmux."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Użyj --remove-generated-anchor tylko dla grupy tylko z kotwicą, której kotwica została utworzona przez cmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use --remove-generated-anchor apenas para um grupo somente âncora cuja âncora foi criada pelo cmux."
          }
