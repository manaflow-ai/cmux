        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez d’abord un espace de travail de VM Cloud, puis réessayez cette commande."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد مساحة عمل لـ Cloud VM أولاً، ثم أعد محاولة هذا الأمر."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona primero un espacio de trabajo de máquina virtual en la nube, luego reintenta este comando."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先選取雲端虛擬機器 (Cloud VM) 工作區，然後重試此指令。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 Cloud VM 작업 공간을 선택한 후 이 명령을 다시 시도하세요."
          }
        }
      }
    },
    "command.cloudVM.current.missing.title": {
