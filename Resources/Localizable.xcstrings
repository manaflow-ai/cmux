    "cli.hooks.antigravity.aborted": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الإلغاء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aborted."
          }
        },
