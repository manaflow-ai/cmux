          "stringUnit": {
            "state": "translated",
            "value": "ロックせず全画面で表示します。任意のキーまたはクリックで終了します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏显示场景但不锁定；按任意键或点击即可退出。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Szene im Vollbildmodus ohne Sperrung; jede Taste oder jeder Klick beendet sie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche la scène en plein écran sans verrouiller ; n’importe quelle touche ou clic permet de quitter."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض المشهد بملء الشاشة دون قفل؛ الخروج بالضغط على أي مفتاح أو نقرة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la escena a pantalla completa sin bloquear; cualquier tecla o clic sale de ella."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以全螢幕顯示場景而不鎖定；按任意鍵或點擊即可退出。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 없이 장면을 전체 화면으로 보여줍니다. 아무 키나 누르거나 클릭하면 종료됩니다."
          }
        }
      }
    },
