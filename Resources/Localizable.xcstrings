    "cli.restore.error.providerSetupConfigurationFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: provider setup could not start. Check the agent's provider settings, then retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: プロバイダー設定を開始できませんでした。エージェントのプロバイダー設定を確認してから、再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "restore：无法启动提供方设置。请检查该代理的提供方设置，然后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: Provider-Setup konnte nicht gestartet werden. Überprüfen Sie die Provider-Einstellungen des Agenten und versuchen Sie es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "restore : la configuration du fournisseur n'a pas pu démarrer. Vérifiez les paramètres de fournisseur de l'agent, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: تعذر بدء إعداد المزود. تحقق من إعدادات مزود الوكيل، ثم أعد المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: la configuración del proveedor no pudo iniciarse. Verifique los ajustes de proveedor del agente y vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "restore：提供者設定無法啟動。請檢查代理程式的提供者設定，然後重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 공급자(provider) 설정을 시작할 수 없습니다. 에이전트의 공급자 설정을 확인한 후 다시 시도하십시오."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: postavljanje provajdera nije moglo biti pokrenuto. Provjerite postavke provajdera agenta, zatim pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: provider-opsætning kunne ikke starte. Kontrollér agentens providerindstillinger, og prøv igen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: impossibile avviare la configurazione del provider. Verificare le impostazioni del provider dell'agente, poi riprovare."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: ការដំឡើង provider មិនអាចចាប់ផ្តើមបានទេ។ ពិនិត្យការកំណត់ provider របស់ agent រួចព្យាយាមម្តងទៀត។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: leverandøroppsett kunne ikke starte. Kontroller agentens leverandørinnstillinger, og prøv på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: konfiguracja dostawcy nie mogła się uruchomić. Sprawdź ustawienia dostawcy agenta, a następnie ponów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: a configuração do provider não pôde ser iniciada. Verifique as configurações de provider do agente e repita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: не удалось запустить настройку провайдера. Проверьте настройки провайдера агента и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: ไม่สามารถเริ่มการตั้งค่า provider ได้ ตรวจสอบการตั้งค่า provider ของ agent แล้วลองใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: sağlayıcı kurulumu başlatılamadı. Agent'ın sağlayıcı ayarlarını kontrol edip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: налаштування провайдера не вдалося запустити. Перевірте налаштування провайдера агента і повторіть спробу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: không thể bắt đầu thiết lập provider. Kiểm tra cài đặt provider của agent, sau đó thử lại."
          }
        }
      }
    },
