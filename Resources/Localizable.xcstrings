            "value": "Öffnen Sie den Link in Ihrem Browser oder kopieren Sie ihn und fügen Sie ihn in einen beliebigen Browser ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez le lien dans votre navigateur, ou copiez-le et collez-le dans n’importe quel navigateur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الرابط في متصفحك، أو انسخه والصقه في أي متصفح."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el enlace en tu navegador, o cópialo y pégalo en cualquier navegador."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您的瀏覽器中開啟此連結，或將其複製並貼上到任何瀏覽器中。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저에서 링크를 열거나, 복사하여 아무 브라우저에나 붙여넣으세요."
          }
        }
      }
    },
    "account.signIn.error.browserUnavailable.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
