    "cli.coderouter.bootstrap.offer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter CLI is not installed. cmux can install it now by running the official installer:\n  %1$@\nThis downloads the checksum-verified CodeRouter binary into %2$@ and adds that directory to your shell PATH."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter CLI がインストールされていません。cmux は公式インストーラーを実行して今すぐインストールできます:\n  %1$@\nチェックサムを検証した CodeRouter バイナリを %2$@ にダウンロードし、そのディレクトリをシェルの PATH に追加します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die CodeRouter-CLI ist nicht installiert. cmux kann sie jetzt installieren, indem der offizielle Installer ausgeführt wird:\n  %1$@\nDadurch wird die per Prüfsumme verifizierte CodeRouter-Binärdatei nach %2$@ heruntergeladen und dieses Verzeichnis zu deinem Shell-PATH hinzugefügt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le CLI CodeRouter n'est pas installé. cmux peut l'installer maintenant en exécutant l'installateur officiel :\n  %1$@\nCela télécharge le binaire CodeRouter vérifié par somme de contrôle dans %2$@ et ajoute ce répertoire au PATH de votre shell."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن CodeRouter CLI غير مثبت. يمكن لـ cmux تثبيته الآن عن طريق تشغيل برنامج التثبيت الرسمي:\n  %1$@\nيؤدي هذا إلى تنزيل ثنائي CodeRouter الذي تم التحقق من المجموع الاختباري (checksum) الخاص به إلى %2$@ ويضيف هذا الدليل إلى متغير البيئة PATH الخاص بالصدفة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La CLI de CodeRouter no está instalada. cmux puede instalarla ahora ejecutando el instalador oficial:\n  %1$@\nEsto descarga el binario de CodeRouter verificado por suma de comprobación en %2$@ y añade ese directorio al PATH de tu shell."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未安裝 CodeRouter CLI。cmux 現在可以藉由執行官方安裝程式來安裝它：\n  %1$@\n這會將經總和檢查碼 (checksum) 驗證的 CodeRouter 二進位檔下載到 %2$@，並將該目錄新增至您的 shell PATH。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未安装 CodeRouter CLI。cmux 现在可以通过运行官方安装程序来进行安装：\n  %1$@\n这将下载经过校验和验证的 CodeRouter 二进制文件到 %2$@，并将该目录添加到您的 shell PATH 中。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter CLI가 설치되어 있지 않습니다. cmux가 지금 공식 설치 프로그램을 실행하여 설치할 수 있습니다:\n  %1$@\n이를 통해 체크섬이 확인된 CodeRouter 바이너리를 %2$@에 다운로드하고 해당 디렉토리를 쉘 PATH에 추가합니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CodeRouter CLI nije instaliran. cmux ga može instalirati odmah pokretanjem službenog instalacijskog programa:\n  %1$@\nOvo preuzima binarnu datoteku CodeRouter-a s verificiranom kontrolnom sumom u %2$@ i dodaje taj direktorij u vaš shell PATH."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CodeRouter CLI er ikke installeret. cmux kan installere det nu ved at køre det officielle installationsprogram:\n  %1$@\nDette downloader den checksum-verificerede CodeRouter-binær til %2$@ og tilføjer den mappe til din shell-PATH."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La CLI di CodeRouter non è installata. cmux può installarla ora eseguendo il programma di installazione ufficiale:\n  %1$@\nQuesto scarica il binario di CodeRouter verificato tramite checksum in %2$@ e aggiunge quella directory al PATH della shell."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CodeRouter CLI មិនទាន់ติดตั้ง។ cmux អាចติดตั้งវាឥឡូវដោយដំណើរការ installer ផ្លូវការ:\n  %1$@\nនេះទាញយក CodeRouter binary ដែលផ្ទៀងផ្ទាត់ checksum ចូល %2$@ ហើយបន្ថែម directory នោះទៅ shell PATH របស់អ្នក។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CodeRouter CLI er ikke installert. cmux kan installere det nå ved å kjøre det offisielle installasjonsprogrammet:\n  %1$@\nDette laster ned den sjekksum-verifiserte CodeRouter-binærfilen til %2$@ og legger den katalogen til shell-PATH."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CLI CodeRouter nie jest zainstalowane. cmux może zainstalować je teraz, uruchamiając oficjalny instalator:\n  %1$@\nPobiera to zweryfikowany sumą kontrolną plik binarny CodeRouter do %2$@ i dodaje ten katalog do PATH powłoki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A CLI do CodeRouter não está instalada. O cmux pode instalá-la agora executando o instalador oficial:\n  %1$@\nIsso baixa o binário do CodeRouter com checksum verificado em %2$@ e adiciona esse diretório ao PATH do seu shell."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CLI CodeRouter не установлен. cmux может установить его сейчас, запустив официальный установщик:\n  %1$@\nЭто загрузит верифицированный по контрольной сумме бинарный файл CodeRouter в %2$@ и добавит эту директорию в PATH вашей оболочки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่ได้ติดตั้ง CodeRouter CLI cmux สามารถติดตั้งให้ตอนนี้โดยรันตัวติดตั้งอย่างเป็นทางการ:\n  %1$@\nดาวน์โหลด CodeRouter binary ที่ตรวจสอบ checksum แล้วลงใน %2$@ และเพิ่มไดเรกทอรีนั้นใน shell PATH"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CodeRouter CLI yüklü değil. cmux, resmi yükleyiciyi çalıştırarak şimdi yükleyebilir:\n  %1$@\nBu işlem, sağlama toplamı doğrulamalı CodeRouter ikili dosyasını %2$@ içine indirir ve bu dizini kabuk PATH'inize ekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CodeRouter CLI не встановлено. cmux може встановити його зараз, запустивши офіційний інсталятор:\n  %1$@\nЦе завантажує перевірений за контрольною сумою бінарний файл CodeRouter у %2$@ та додає цю директорію до PATH вашої оболонки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CodeRouter CLI chưa được cài đặt. cmux có thể cài đặt ngay bằng cách chạy trình cài đặt chính thức:\n  %1$@\nThao tác này tải xuống tệp nhị phân CodeRouter đã xác minh checksum vào %2$@ và thêm thư mục đó vào PATH shell của bạn."
          }
        }
      }
    },
    "cli.coderouter.commands": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "coderouter <status|machines|claude> [--team <id>] [--json]    (إعدادات مستوى النماذج للفريق؛ تُمرَّر الأوامر الأخرى كما هي)"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "coderouter <status|machines|claude> [--team <id>] [--json]    (postavke modelne ravni tima; ostale komande se prosljeđuju)"
          }
