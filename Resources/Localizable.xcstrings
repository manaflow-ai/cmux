    "cli.workflow.ssh-devbox.instantiate.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the SSH Devbox recipe, replace ssh devbox and the preview URL for the project, merge the command into cmux.json, then run cmux reload-config."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorlage SSH Devbox öffnen, ssh devbox und Vorschau-URL an das Projekt anpassen, den Befehl in cmux.json übernehmen und cmux reload-config ausführen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la recette SSH Devbox, adaptez ssh devbox et l’URL d’aperçu au projet, ajoutez la commande à cmux.json, puis exécutez cmux reload-config."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la receta SSH Devbox, adapta ssh devbox y la URL de vista previa al proyecto, incorpora el comando en cmux.json y ejecuta cmux reload-config."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح وصفة SSH Devbox، واستبدل ssh devbox وعنوان URL للمعاينة بما يناسب المشروع، وأضف الأمر إلى cmux.json، ثم شغّل cmux reload-config."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 SSH Devbox 配方，按项目需要替换 ssh devbox 和预览 URL，将命令合并到 cmux.json，然后运行 cmux reload-config。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 SSH Devbox 配方，依專案需求替換 ssh devbox 和預覽 URL，將命令合併到 cmux.json，然後執行 cmux reload-config。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH Devbox 설정 예제를 열고 ssh devbox와 미리보기 URL을 프로젝트에 맞게 교체한 뒤 명령을 cmux.json에 병합하고 cmux reload-config를 실행하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH Devbox レシピを開き、ssh devbox とプレビュー URL をプロジェクトに合わせて変更し、コマンドを cmux.json に追加して cmux reload-config を実行します。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otvorite SSH Devbox recept, zamijenite ssh devbox i URL pregleda za projekat, spojite naredbu u cmux.json, zatim pokrenite cmux reload-config."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åbn SSH Devbox-opskriften, erstat ssh devbox og forhåndsvisnings-URL for projektet, flet kommandoen ind i cmux.json, og kør derefter cmux reload-config."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apri la ricetta SSH Devbox, sostituisci ssh devbox e l'URL di anteprima per il progetto, unisci il comando in cmux.json, quindi esegui cmux reload-config."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បើក recipe SSH Devbox, ជំនួស ssh devbox និង URL preview សម្រាប់គម្រោង, បញ្ចូល command ទៅ cmux.json, រួចដំណើរការ cmux reload-config."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åpne SSH Devbox-oppskriften, erstatt ssh devbox og forhåndsvisnings-URL for prosjektet, flett kommandoen inn i cmux.json, og kjør deretter cmux reload-config."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otwórz przepis SSH Devbox, zastąp ssh devbox i adres URL podglądu dla projektu, scal polecenie do cmux.json, a następnie uruchom cmux reload-config."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra a receita SSH Devbox, substitua ssh devbox e a URL de pré-visualização pelo projeto, mescle o comando no cmux.json e execute cmux reload-config."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Откройте рецепт SSH Devbox, замените ssh devbox и URL предпросмотра для проекта, объедините команду в cmux.json, затем выполните cmux reload-config."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิด recipe SSH Devbox, แทนที่ ssh devbox และ preview URL ของ project, รวมคำสั่งเข้ากับ cmux.json แล้วรัน cmux reload-config"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH Devbox tarifini açın, ssh devbox ve önizleme URL'sini projeye göre değiştirin, komutu cmux.json'a ekleyin, ardından cmux reload-config komutunu çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відкрийте рецепт SSH Devbox, замініть ssh devbox і URL попереднього перегляду для проєкту, об'єднайте команду у cmux.json, а потім виконайте cmux reload-config."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mở recipe SSH Devbox, thay thế ssh devbox và URL xem trước cho dự án, gộp lệnh vào cmux.json, sau đó chạy cmux reload-config."
          }
        }
      }
    },
