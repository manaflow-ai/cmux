    "pricing.native.sizes.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro includes up to 50 Cloud VMs, with 24 GB RAM and 6 vCPUs shared across all VMs. Team includes the same limits per user. There is no metering or overage billing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro では最大 50 台の Cloud VM で、24 GB RAM と 6 vCPU を共有します。Team ではユーザーごとに同じ上限が適用されます。従量課金や超過料金はありません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتضمن باقة Pro ما يصل إلى 50 جهازًا افتراضيًا سحابيًا، مع ذاكرة وصول عشوائي بسعة 24 جيجابايت و6 وحدات معالجة مركزية افتراضية مشتركة بين جميع الأجهزة. وتمنح باقة Team الحدود نفسها لكل مستخدم. لا توجد فوترة حسب الاستهلاك أو رسوم إضافية لتجاوز الحدود."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro includes up to 50 Cloud VMs, with 24 GB RAM and 6 vCPUs shared across all VMs. Team includes the same limits per user. There is no metering or overage billing."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro includes up to 50 Cloud VMs, with 24 GB RAM and 6 vCPUs shared across all VMs. Team includes the same limits per user. There is no metering or overage billing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro beinhaltet bis zu 50 Cloud-VMs mit 24 GB RAM und 6 vCPUs, die von allen VMs gemeinsam genutzt werden. Team beinhaltet dieselben Limits pro Benutzer. Es gibt keine verbrauchsabhängige Abrechnung oder Nachberechnung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro incluye hasta 50 VM en la nube, con 24 GB de RAM y 6 vCPUs compartidos entre todas las VM. Team incluye los mismos límites por usuario. No hay facturación por consumo ni por exceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro inclut jusqu'à 50 VM Cloud, avec 24 Go de RAM et 6 vCPUs partagés entre toutes les VM. Team inclut les mêmes limites par utilisateur. Il n'y a pas de facturation à l'utilisation ou de dépassement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro includes up to 50 Cloud VMs, with 24 GB RAM and 6 vCPUs shared across all VMs. Team includes the same limits per user. There is no metering or overage billing."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro includes up to 50 Cloud VMs, with 24 GB RAM and 6 vCPUs shared across all VMs. Team includes the same limits per user. There is no metering or overage billing."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro는 최대 50개의 클라우드 VM을 포함하며, 모든 VM이 RAM 24 GB와 vCPU 6개를 공유합니다. Team은 사용자마다 동일한 한도가 적용됩니다. 사용량 기반 과금이나 초과 요금은 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro includes up to 50 Cloud VMs, with 24 GB RAM and 6 vCPUs shared across all VMs. Team includes the same limits per user. There is no metering or overage billing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro includes up to 50 Cloud VMs, with 24 GB RAM and 6 vCPUs shared across all VMs. Team includes the same limits per user. There is no metering or overage billing."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro includes up to 50 Cloud VMs, with 24 GB RAM and 6 vCPUs shared across all VMs. Team includes the same limits per user. There is no metering or overage billing."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro includes up to 50 Cloud VMs, with 24 GB RAM and 6 vCPUs shared across all VMs. Team includes the same limits per user. There is no metering or overage billing."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro includes up to 50 Cloud VMs, with 24 GB RAM and 6 vCPUs shared across all VMs. Team includes the same limits per user. There is no metering or overage billing."
          }
