          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Establecer cmux como la terminal predeterminada?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要將 cmux 設為預設終端機嗎？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux를 기본 터미널로 설정하시겠습니까?"
          }
        }
      }
    },
    "settings.app.defaultTerminal.subtitleDefault": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux handles SSH links, .command/.tool files, and UNIX executables."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux は SSH リンク、.command/.tool ファイル、UNIX 実行ファイルを処理します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 负责处理 SSH 链接、.command/.tool 文件和 UNIX 可执行文件。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux verarbeitet SSH-Links, .command/.tool-Dateien und UNIX-Ausführungsdateien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux gère les liens SSH, les fichiers .command/.tool et les exécutables UNIX."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعامل cmux مع روابط SSH، وملفات .command/.tool، وملفات UNIX التنفيذية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux maneja enlaces SSH, archivos .command/.tool y ejecutables de UNIX."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 會處理 SSH 連結、.command/.tool 檔案和 UNIX 可執行檔。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 SSH 링크, .command/.tool 파일 및 UNIX 실행 파일을 처리합니다."
          }
