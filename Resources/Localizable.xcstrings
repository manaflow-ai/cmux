    "cli.help.unknownTopic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown topics keep the top-level help behavior."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbekannte Themen zeigen weiterhin die oberste Hilfe an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sujets inconnus conservent le comportement de l’aide générale."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحافظ المواضيع غير المعروفة على سلوك المساعدة العامة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los temas desconocidos mantienen el comportamiento de la ayuda general."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未知主題會維持頂層說明行為。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知主题会保持顶层帮助行为。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알 수 없는 주제는 최상위 도움말 동작을 유지합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不明なトピックではトップレベルのヘルプが表示されます。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nepoznate teme zadržavaju ponašanje pomoći na najvišoj razini."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ukendte emner bevarer hjælpeadfærden på øverste niveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli argomenti sconosciuti mantengono il comportamento della guida di primo livello."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ប្រធានបទដែលមិនស្គាល់នឹងរក្សាឥរិយាបថជំនួយកម្រិតខ្ពស់។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ukjente emner beholder oppførselen til toppnivåhjelpen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nieznane tematy zachowują zachowanie pomocy najwyższego poziomu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tópicos desconhecidos mantêm o comportamento da ajuda geral."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Неизвестные темы сохраняют поведение справки верхнего уровня."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หัวข้อที่ไม่รู้จักจะแสดงวิธีใช้ระดับบนสุดตามเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bilinmeyen konular üst düzey yardım davranışını korur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Невідомі теми зберігають поведінку довідки верхнього рівня."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chủ đề không xác định sẽ giữ nguyên hành vi trợ giúp cấp cao nhất."
          }
        }
      }
    },
