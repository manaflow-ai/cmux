    "sleepyMode.settings.securityNote.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleepy Mode is a screensaver, not a lock — any key wakes it. For real security, use the “Lock Mac” button in the scene, which engages the actual macOS login lock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おやすみモードはロックではなくスクリーンセーバーです（任意のキーで解除）。本当のセキュリティが必要な場合は、画面内の「Mac をロック」ボタンを使うと、実際の macOS ログインロックがかかります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠模式是屏保而不是锁屏 — 按任意键即可唤醒。若需要真正的安全保护，请使用场景中的「锁定 Mac」按钮，它会启用 macOS 真正的登录锁定。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sleepy Mode ist ein Bildschirmschoner, keine Sperre — jede Taste weckt ihn auf. Verwende für echte Sicherheit die Schaltfläche „Mac sperren“ in der Szene, die die tatsächliche macOS-Anmeldesperre aktiviert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode Veille (Sleepy Mode) est un écran de veille, pas un verrouillage — n’importe quelle touche le réveille. Pour une véritable sécurité, utilisez le bouton « Verrouiller le Mac » dans la scène, qui active le véritable verrouillage de session macOS."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وضع النوم (Sleepy Mode) هو شاشة توقف وليس قفلاً — أي مفتاح يوقظه. للأمان الحقيقي، استخدم زر “قفل Mac” في المشهد، والذي يقوم بتشغيل قفل تسجيل الدخول الفعلي لنظام macOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleepy Mode es un salvapantallas, no un bloqueo; cualquier tecla lo desactiva. Para una seguridad real, usa el botón “Bloquear Mac” de la escena, que activa el bloqueo de inicio de sesión real de macOS."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleepy Mode 是螢幕保護程式，而非鎖定功能 — 按任意鍵即可喚醒。若要獲得真正的安全性，請使用場景中的「鎖定 Mac」按鈕，這會啟動實際的 macOS 登入鎖定。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleepy Mode는 화면 보호기이며 잠금 장치가 아닙니다. 아무 키나 누르면 깨어납니다. 완전한 보안을 위해 실제 macOS 로그인 잠금을 활성화하는 화면 내 “Mac 잠금” 버튼을 사용하십시오."
          }
        }
      }
    },
