    "simulator.control.locationCoordinateInvalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latitude must be from -90 through 90 and longitude from -180 through 180."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緯度は-90から90、経度は-180から180の範囲で指定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纬度必须在 -90 到 90 之间，经度必须在 -180 到 180 之间。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Breitengrad muss zwischen -90 und 90 und der Längengrad zwischen -180 und 180 liegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La latitude doit être comprise entre -90 et 90, et la longitude entre -180 et 180."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون خط العرض من -90 إلى 90 وخط الطول من -180 إلى 180."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La latitud debe estar entre -90 y 90, y la longitud entre -180 y 180."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "緯度必須介於 -90 至 90 之間，經度必須介於 -180 至 180 之間。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위도는 -90에서 90 사이, 경도는 -180에서 180 사이여야 합니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geografska širina mora biti od -90 do 90, a dužina od -180 do 180."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Breddegrad skal være fra -90 til 90 og længdegrad fra -180 til 180."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La latitudine deve essere compresa tra -90 e 90 e la longitudine tra -180 e 180."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "រយៈទទឹងត្រូវតែចាប់ពី -90 ដល់ 90 និងរយៈបណ្ដោយចាប់ពី -180 ដល់ 180។"
          }
