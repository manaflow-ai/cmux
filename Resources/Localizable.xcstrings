    "settings.settingsJSON.file.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit cmux-owned app settings, shortcuts, automation, sidebar, notifications, and browser behavior."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 管理のアプリ設定、ショートカット、オートメーション、サイドバー、通知、ブラウザ動作を編集します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 관리하는 앱 설정, 단축키, 자동화, 사이드바, 알림, 브라우저 동작을 편집합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑由 cmux 管理的应用设置、快捷键、自动化、侧边栏、通知和浏览器行为。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeiten Sie von cmux verwaltete App-Einstellungen, Tastaturkürzel, Automatisierung, Seitenleiste, Benachrichtigungen und Browser-Verhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier les paramètres de l’application propres à cmux, les raccourcis, l’automatisation, la barre latérale, les notifications et le comportement du navigateur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعديل إعدادات التطبيق المملوكة لـ cmux، والاختصارات، والأتمتة، والشريط الجانبي، والإشعارات، وسلوك المتصفح."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita los ajustes de la aplicación propiedad de cmux, atajos, automatización, barra lateral, notificaciones y comportamiento del navegador."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯 cmux 所屬的軟體設定、快速鍵、自動化、側邊欄、通知與瀏覽器行為。"
          }
        }
      }
    },
