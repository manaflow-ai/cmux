    "cli.workflow.docs-workspace.instantiate.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Docs Workspace recipe, replace the docs command, Markdown path, and preview URL, merge it into cmux.json, then run cmux reload-config."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorlage Docs Workspace öffnen, Dokumentationsbefehl, Markdown-Pfad und Vorschau-URL ersetzen, in cmux.json übernehmen und cmux reload-config ausführen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la recette Docs Workspace, remplacez la commande de documentation, le chemin Markdown et l’URL d’aperçu, ajoutez-la à cmux.json, puis exécutez cmux reload-config."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la receta Docs Workspace, sustituye el comando de documentación, la ruta Markdown y la URL de vista previa, incorpórala en cmux.json y ejecuta cmux reload-config."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح وصفة Docs Workspace، واستبدل أمر التوثيق ومسار Markdown وعنوان URL للمعاينة، وأضفها إلى cmux.json، ثم شغّل cmux reload-config."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Docs Workspace 配方，替换文档命令、Markdown 路径和预览 URL，合并到 cmux.json，然后运行 cmux reload-config。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 Docs Workspace 配方，替換文件命令、Markdown 路徑和預覽 URL，合併到 cmux.json，然後執行 cmux reload-config。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Docs Workspace 설정 예제를 열고 문서 명령, Markdown 경로, 미리보기 URL을 교체한 뒤 cmux.json에 병합하고 cmux reload-config를 실행하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Docs Workspace レシピを開き、ドキュメントのコマンド、Markdown パス、プレビュー URL を変更し、cmux.json に追加して cmux reload-config を実行します。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otvorite recept Docs Workspace, zamijenite naredbu docs, putanju Markdown i URL pregleda, spojite to u cmux.json, zatim pokrenite cmux reload-config."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åbn Docs Workspace-opskriften, erstat docs-kommandoen, Markdown-stien og forhåndsvisnings-URL'en, flet den ind i cmux.json, og kør derefter cmux reload-config."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apri la ricetta Docs Workspace, sostituisci il comando docs, il percorso Markdown e l'URL di anteprima, uniscila in cmux.json, poi esegui cmux reload-config."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បើក recipe Docs Workspace, ជំនួស command docs, ផ្លូវ Markdown, និង URL preview, បញ្ចូលទៅ cmux.json, រួចដំណើរការ cmux reload-config."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åpne docs-workspace-oppskriften, erstatt docs-kommandoen, Markdown-stien og forhåndsvisnings-URL-en, slå den sammen med cmux.json, og kjør deretter cmux reload-config."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otwórz przepis Docs Workspace, zastąp polecenie docs, ścieżkę Markdown i adres URL podglądu, scal z cmux.json, a następnie uruchom cmux reload-config."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra a receita Docs Workspace, substitua o comando de docs, o caminho do Markdown e a URL de prévia, mescle em cmux.json e execute cmux reload-config."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Откройте рецепт Docs Workspace, замените команду docs, путь к Markdown и URL предпросмотра, объедините с cmux.json, затем выполните cmux reload-config."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิด recipe Docs Workspace แทนที่คำสั่ง docs, พาธ Markdown และ URL พรีวิว รวมเข้า cmux.json แล้วรัน cmux reload-config"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Docs Workspace tarifini açın, docs komutunu, Markdown yolunu ve önizleme URL'sini değiştirin, cmux.json ile birleştirin, ardından cmux reload-config komutunu çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відкрийте рецепт Docs Workspace, замініть команду docs, шлях Markdown та URL попереднього перегляду, об'єднайте з cmux.json, потім виконайте cmux reload-config."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mở recipe Docs Workspace, thay thế lệnh docs, đường dẫn Markdown và URL xem trước, gộp vào cmux.json, sau đó chạy cmux reload-config."
          }
        }
      }
    },
