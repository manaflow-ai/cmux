        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: Bu oturumun çatallanacak hiçbir şeyi yok. Aracıyı bu terminalde yeniden başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: цій сесії нема чого роздвоюватися. Знову запустіть агента в цьому терміналі."
          }
        },
        "zh-Hans": {
