            "value": "Прилипання на полотні"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画布吸附"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫布吸附"
          }
        }
