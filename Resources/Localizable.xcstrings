    "cli.sshPtyAttach.reconciliationUnavailableReattach": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SSH terminal connection ended before the remote session state could be confirmed; preserving the remote session for reconnection."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートセッションの状態を確認できる前に SSH ターミナル接続が終了しました。再接続のためセッションを維持します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 终端连接在远程会话状态确认前就已结束；将保留该远程会话以便重连。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die SSH-Terminal-Verbindung endete, bevor der Status der Remote-Sitzung bestätigt werden konnte; die Remote-Sitzung wird für eine erneute Verbindung beibehalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion SSH du terminal s’est terminée avant que l’état de la session distante n’ait pu être confirmé ; conservation de la session distante pour reconnexion."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهى اتصال طرفية SSH قبل تأكيد حالة الجلسة البعيدة؛ سيتم الحفاظ على الجلسة البعيدة لإعادة الاتصال."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalizó la conexión de terminal SSH antes de que pudiera confirmarse el estado de la sesión remota; se conserva la sesión remota para la reconexión."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在確認遠端工作階段狀態前，SSH 終端機連線已結束；保留遠端工作階段以便重新連線。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 세션 상태를 확인하기 전에 SSH 터미널 연결이 종료되었습니다. 재연결을 위해 원격 세션을 보존합니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH terminalna veza je prekinuta prije nego je stanje udaljene sesije moglo biti potvrđeno; čuva se udaljena sesija za ponovni spoj."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH-terminalforbindelsen blev afbrudt, før fjernssessionstilstanden kunne bekræftes; bevarer fjernssessionen til genopretnning."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La connessione SSH al terminale è terminata prima che lo stato della sessione remota potesse essere confermato; la sessione remota viene conservata per la riconnessione."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការតភ្ជាប់ terminal SSH បានបញ្ចប់មុនពេលបញ្ជាក់ស្ថានភាព session ពីចម្ងាយ; កំពុងរក្សា session ពីចម្ងាយសម្រាប់ការភ្ជាប់ឡើងវិញ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH-terminalforbindelsen ble avsluttet før tilstanden til den eksterne sesjonen kunne bekreftes; bevarer den eksterne sesjonen for gjenkobling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Połączenie terminalu SSH zostało zakończone przed potwierdzeniem stanu zdalnej sesji; zachowuję zdalną sesję do ponownego połączenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A conexão SSH do terminal foi encerrada antes que o estado da sessão remota pudesse ser confirmado; preservando a sessão remota para reconexão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH-соединение с терминалом завершилось до подтверждения состояния удалённой сессии; удалённая сессия сохранена для переподключения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การเชื่อมต่อ SSH terminal สิ้นสุดก่อนที่จะยืนยันสถานะ session ระยะไกลได้ กำลังเก็บรักษา session ระยะไกลไว้สำหรับการเชื่อมต่อใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uzak oturum durumu doğrulanamadan SSH terminal bağlantısı kesildi; uzak oturum yeniden bağlantı için korunuyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH-з'єднання термінала завершено до підтвердження стану віддаленого сеансу; віддалений сеанс збережено для перепідключення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kết nối terminal SSH đã kết thúc trước khi trạng thái phiên từ xa được xác nhận; lưu giữ phiên từ xa để kết nối lại."
          }
        }
      }
    },
    "cli.sshPtyAttach.remoteSessionLostRespawn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] remote session was lost; starting a new shell."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] リモートセッションが失われました。新しいシェルを開始します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] 远程会话已丢失；正在启动新的 shell。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] Remote-Sitzung ging verloren; eine neue Shell wird gestartet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] la session distante a été perdue ; démarrage d’un nouveau shell."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] فُقدت الجلسة البعيدة؛ يجري بدء شل جديد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] se perdió la sesión remota; iniciando un nuevo shell."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] 遠端工作階段已遺失；正在啟動新的 Shell。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] 원격 세션이 유실되었습니다. 새로운 셸을 시작합니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "[cmux] udaljena sesija je izgubljena; pokretanje nove ljuske."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "[cmux] fjernssession gik tabt; starter en ny shell."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "[cmux] la sessione remota è andata persa; avvio di una nuova shell."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "[cmux] session ពីចម្ងាយបានបាត់បង់; កំពុងចាប់ផ្ដើម shell ថ្មី។"
          }
        },
        "nb": {
