    "dialog.deleteWorkspaceLayout.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes “%1$@” from %2$@. Workspaces it already created stay open."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」を %2$@ から削除します。作成済みのワークスペースはそのまま残ります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt „%1$@“ aus %2$@. Bereits erstellte Arbeitsbereiche bleiben geöffnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime “%1$@” de %2$@. Les espaces de travail déjà créés restent ouverts."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل “%1$@” من %2$@. وتبقى مساحات العمل التي تم إنشاؤها بالفعل مفتوحة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina “%1$@” de %2$@. Los espacios de trabajo que ya haya creado permanecerán abiertos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將「%1$@」自 %2$@ 移除。其已建立的工作區將維持開啟。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将“%1$@”从 %2$@ 移除。其已创建的工作区将保持打开状态。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”을(를) %2$@에서 제거합니다. 이미 생성된 작업 공간들은 열린 상태로 유지됩니다."
          }
        }
      }
    },
