    "cli.vault.checkpoints.viewOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "note: this agent's checkpoints are view-only (fork not supported yet)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "注: このエージェントのチェックポイントは表示専用です（フォーク未対応）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注意：该代理的检查点仅供查看（暂不支持分叉）"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweis: Die Checkpoints dieses Agenten sind schreibgeschützt (Fork wird noch nicht unterstützt)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "note : les points de contrôle de cet agent sont en lecture seule (la bifurcation n’est pas encore prise en charge)"
