    "settings.terminal.adaptiveDefaultTheme": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapt Default Theme to Appearance"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトテーマを外観に合わせる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让默认主题跟随外观"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard-Theme an das Erscheinungsbild anpassen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapter le thème par défaut à l’apparence"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تكييف السمة الافتراضية مع المظهر"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptar el tema predeterminado a la apariencia"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依外觀調整預設主題"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외양에 맞춰 기본 테마 조정"
          }
        }
      }
    },
    "settings.terminal.adaptiveDefaultTheme.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An untouched Ghostty config uses Ghostty's fixed built-in palette. Existing Ghostty settings, including light/dark theme pairs, are always preserved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghostty 設定が空の場合は、固定された組み込みパレットを使用します。ライト／ダークのテーマペアを含む既存の Ghostty 設定は常に保持します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未改动过的 Ghostty 配置会使用 Ghostty 固定的内置调色板。已有的 Ghostty 设置（包括浅色/深色主题配对）始终会被保留。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine unberührte Ghostty-Konfiguration verwendet die feste, integrierte Palette von Ghostty. Bestehende Ghostty-Einstellungen, einschließlich hell/dunkel-Theme-Paaren, bleiben immer erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une configuration Ghostty intacte utilise la palette fixe intégrée de Ghostty. Les paramètres Ghostty existants, y compris les paires de thèmes clair/sombre, sont toujours préservés."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم تكوين Ghostty غير المعدل لوحة الألوان المدمجة الثابتة لـ Ghostty. يتم دائمًا حفظ إعدادات Ghostty الحالية، بما في ذلك أزواج السمات الفاتحة والداكنة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una configuración de Ghostty intacta usa la paleta integrada fija de Ghostty. Los ajustes existentes de Ghostty, incluidos los pares de temas claro/oscuro, siempre se conservan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未修改的 Ghostty 設定檔將使用 Ghostty 固定的內建調色盤。現有的 Ghostty 設定（包括淺色/深色主題配對）會始終保留。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수정되지 않은 Ghostty 설정은 Ghostty의 고정된 기본 팔레트를 사용합니다. 라이트/다크 테마 쌍을 포함한 기존 Ghostty 설정은 항상 유지됩니다."
          }
        }
      }
    },
    "settings.terminal.adaptiveDefaultTheme.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux's managed light and dark palettes follow the app appearance only when your Ghostty config has no settings. Existing Ghostty settings are never overlaid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghostty 設定が空の場合のみ、cmux の管理するライト／ダークパレットがアプリの外観に追従します。既存の Ghostty 設定には重ねて適用しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当你的 Ghostty 配置没有任何设置时，cmux 托管的浅色与深色调色板才会跟随应用外观。已有的 Ghostty 设置永远不会被覆盖。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die von cmux verwalteten hellen und dunklen Paletten folgen dem Erscheinungsbild der App nur dann, wenn Ihre Ghostty-Konfiguration keine Einstellungen enthält. Bestehende Ghostty-Einstellungen werden niemals überschrieben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les palettes claire et sombre gérées de cmux suivent l’apparence de l’application uniquement si votre configuration Ghostty ne contient aucun paramètre. Les paramètres Ghostty existants ne sont jamais écrasés."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبع لوحات الألوان الفاتحة والداكنة المدارة لـ cmux مظهر التطبيق فقط عندما لا يحتوي تكوين Ghostty على إعدادات. لا يتم تداخل إعدادات Ghostty الحالية مطلقًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las paletas clara y oscura administradas de cmux siguen la apariencia de la aplicación solo cuando tu configuración de Ghostty no tiene ajustes. Los ajustes existentes de Ghostty nunca se sobrescriben."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在您的 Ghostty 設定檔中沒有任何設定時，cmux 管理的淺色與深色調色盤才會隨軟體外觀變更。現有的 Ghostty 設定絕不會被覆蓋。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghostty 설정에 아무런 설정이 없는 경우에만 cmux가 관리하는 라이트 및 다크 팔레트가 앱 외양을 따릅니다. 기존 Ghostty 설정은 절대로 덮어씌워지지 않습니다."
          }
        }
      }
    },
    "settings.terminal.agentAutoResume": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume Agent Sessions on Reopen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再起動時にエージェントセッションを再開"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新打开时恢复代理会话"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten-Sitzungen beim erneuten Öffnen fortsetzen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprendre les sessions d'agent à la réouverture"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استئناف جلسات الوكيل عند إعادة الفتح"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reanudar sesiones de agentes al volver a abrir"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新開啟時恢復代理工作階段"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재열기 시 에이전트 세션 재개"
          }
        }
      }
    },
    "settings.terminal.agentAutoResume.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When cmux reopens after quit, restored agent terminals stay idle until you resume them manually."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux を終了後に再度開いたとき、復元されたエージェント端末は手動で再開するまで待機します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 退出后重新打开时，已恢复的代理终端保持空闲，直到手动恢复它们。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn cmux nach dem Beenden wieder geöffnet wird, bleiben wiederhergestellte Agenten-Terminals im Leerlauf, bis Sie sie manuell fortsetzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque cmux se rouvre après avoir été quitté, les terminaux d’agent restaurés restent inactifs jusqu’à ce que vous les repreniez manuellement."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند إعادة فتح cmux بعد الإنهاء، تظل طرفيات الوكلاء المستعادة خاملة حتى تقوم باستئنافها يدويًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando cmux se vuelve a abrir después de salir, las terminales de agentes restauradas permanecen inactivas hasta que las reanudes manualmente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當結束後重新開啟 cmux 時，還原的代理終端機會保持閒置，直到您手動恢復為止。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료 후 cmux를 다시 열었을 때, 복원된 에이전트 터미널은 사용자가 수동으로 재개할 때까지 대기 상태로 유지됩니다."
          }
        }
      }
    },
    "settings.terminal.agentAutoResume.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When cmux reopens after quit, restored agent terminals automatically run their resume command."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux を終了後に再度開いたとき、復元されたエージェント端末で再開コマンドを自動実行します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 退出后重新打开时，已恢复的代理终端会自动运行其恢复命令。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn cmux nach dem Beenden wieder geöffnet wird, führen wiederhergestellte Agenten-Terminals automatisch ihren Fortsetzungsbefehl aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque cmux se rouvre après avoir été quitté, les terminaux d’agent restaurés exécutent automatiquement leur commande de reprise."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند إعادة فتح cmux بعد الإنهاء، تقوم طرفيات الوكلاء المستعادة بتشغيل أمر الاستئناف الخاص بها تلقائيًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando cmux se vuelve a abrir después de salir, las terminales de agentes restauradas ejecutan automáticamente su comando de reanudación."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當結束後重新開啟 cmux 時，還原的代理終端機會自動執行其恢復指令。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료 후 cmux를 다시 열었을 때, 복원된 에이전트 터미널이 재개 명령을 자동으로 실행합니다."
          }
        }
      }
    },
    "settings.terminal.agentHibernation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent Hibernation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェント休止"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理休眠"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
