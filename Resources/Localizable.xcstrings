    "settings.betaFeatures.customSidebars.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides custom sidebars from the sidebar picker until you enable them here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで有効にするまで、カスタムサイドバーをサイドバーピッカーに表示しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此处启用之前，自定义侧边栏不会出现在侧边栏选择器中。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet benutzerdefinierte Seitenleisten im Seitenleisten-Wähler aus, bis Sie sie hier aktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque les barres latérales personnalisées du sélecteur de barre latérale jusqu’à ce que vous les activiez ici."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخفي الأشرطة الجانبية المخصصة من منتقي الأشرطة الجانبية حتى تقوم بتمكينها هنا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta las barras laterales personalizadas del selector de barra lateral hasta que las habilite aquí."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在側邊欄選取器中隱藏自訂側邊欄，直到您在此處啟用它們為止。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에서 활성화할 때까지 사이드바 선택기에서 맞춤 사이드바를 숨깁니다."
          }
        }
      }
    },
    "settings.betaFeatures.customSidebars.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists your sidebars from ~/.config/cmux/sidebars in the sidebar picker, rendered in an isolated helper process."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.config/cmux/sidebars のサイドバーをサイドバーピッカーに表示し、分離されたヘルパープロセスで描画します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在侧边栏选择器中列出 ~/.config/cmux/sidebars 中的侧边栏，并在独立的辅助进程中渲染。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Listet Ihre Seitenleisten aus ~/.config/cmux/sidebars im Seitenleisten-Wähler auf, gerendert in einem isolierten Hilfsprozess."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste vos barres latérales depuis ~/.config/cmux/sidebars dans le sélecteur de barre latérale, rendues dans un processus auxiliaire isolé."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسرد الأشرطة الجانبية الخاصة بك من ~/.config/cmux/sidebars في منتقي الأشرطة الجانبية، مع تصييرها في عملية مساعدة معزولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enumera sus barras laterales de ~/.config/cmux/sidebars en el selector de barra lateral, representadas en un proceso auxiliar aislado."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在側邊欄選取器中列出您位於 ~/.config/cmux/sidebars 的側邊欄，並在隔離的輔助程序中進行轉譯。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "격리된 도우미 프로세스에서 렌더링된 ~/.config/cmux/sidebars의 사이드바를 사이드바 선택기에 나열합니다."
          }
        }
      }
    },
