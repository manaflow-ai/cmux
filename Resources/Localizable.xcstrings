          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción requiere una ejecución correlacionada en el worker aislado del simulador."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此動作需要在隔離的 Simulator 工作者中進行關聯執行。"
