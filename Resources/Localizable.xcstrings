    "dialog.textURL.error.nameContainsUnsafeCharacters": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي اسم الارتباط على أحرف تحكم أو تنسيق مخفية، لذا رفضت cmux استخدامه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ime veze sadrži skrivene znakove za kontrolu ili formatiranje, tako da je cmux odbio da ga koristi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Linknavnet indeholder skjulte kontrol- eller formateringstegn, så cmux nægtede at bruge det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Linkname enthält versteckte Steuer- oder Formatierungszeichen, daher weigerte sich cmux, ihn zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link name contains hidden control or formatting characters, so cmux refused to use it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre del enlace contiene caracteres de control o formato ocultos, por lo que cmux se negó a usarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom du lien contient des caractères de contrôle ou de formatage cachés, donc cmux a refusé de l'utiliser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome del collegamento contiene caratteri di controllo o formattazione nascosti, quindi cmux ha rifiutato di utilizzarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンク名に非表示の制御文字または書式文字が含まれているため、cmux は使用を拒否しました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឈ្មោះតំណមានតួអក្សរដែលលាក់ ឬធ្វើទ្រង់ទ្រាយ ដូច្នេះ cmux បដិសេធមិនប្រើវាទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크 이름에 숨겨진 제어 또는 서식 지정 문자가 포함되어 있으므로 cmux는 이를 사용하기를 거부했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koblingsnavnet inneholder skjulte kontroll- eller formateringstegn, så cmux nektet å bruke det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa łącza zawiera ukryte znaki sterujące lub formatujące, więc cmux odmówił jego użycia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome do link contém controles ocultos ou caracteres de formatação, então cmux se recusou a usá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя ссылки содержит скрытые управляющие или форматирующие символы, поэтому cmux отказался ее использовать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อลิงก์มีอักขระควบคุมหรือการจัดรูปแบบที่ซ่อนอยู่ ดังนั้น cmux จึงปฏิเสธที่จะใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı adı gizli kontrol veya biçimlendirme karakterleri içerdiğinden cmux onu kullanmayı reddetti."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва посилання містить приховані символи керування або форматування, тому cmux відмовився від її використання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接名称包含隐藏控制或格式字符，因此 cmux 拒绝使用它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結名稱包含隱藏控製或格式字符，因此 cmux 拒絕使用它。"
          }
        }
      }
    },
