    "command.cloudVM.failed.action.exit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a terminal and run `cmux auth status`, `cmux vm ls`, then `cmux vm base open`. If you hit the active VM limit, delete one with `cmux vm rm <id>` and retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルを開いて `cmux auth status`、`cmux vm ls`、`cmux vm base open` を実行してください。アクティブな VM 数の上限に達している場合は `cmux vm rm <id>` で削除してから再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开终端依次运行 `cmux auth status`、`cmux vm ls`，然后运行 `cmux vm base open`。若达到了活跃 VM 上限，用 `cmux vm rm <id>` 删除一台后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie ein Terminal und führen Sie `cmux auth status`, `cmux vm ls` und dann `cmux vm base open` aus. Wenn Sie das Limit für aktive VMs erreichen, löschen Sie eine mit `cmux vm rm <id>` und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez un terminal et exécutez `cmux auth status`, `cmux vm ls`, puis `cmux vm base open`. Si vous atteignez la limite de VM actives, supprimez-en une avec `cmux vm rm <id>` et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح طرفية وشغّل `cmux auth status` و `cmux vm ls` ثم `cmux vm base open`. إذا تجاوزت الحد الأقصى لآلات VM النشطة، فاحذف إحداها باستخدام `cmux vm rm <id>` وأعد المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una terminal y ejecuta `cmux auth status`, `cmux vm ls`, luego `cmux vm base open`. Si alcanzas el límite de máquinas virtuales activas, elimina una con `cmux vm rm <id>` y reintenta."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請開啟終端機並執行 `cmux auth status`、`cmux vm ls`，然後執行 `cmux vm base open`。如果達到作用中虛擬機器限制，請使用 `cmux vm rm <id>` 刪除一部，然後重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널을 열고 `cmux auth status`, `cmux vm ls`를 실행한 후 `cmux vm base open`을 실행하세요. 활성 VM 제한에 도달한 경우 `cmux vm rm <id>`로 하나를 삭제하고 다시 시도하세요."
          }
        }
      }
    },
    "command.cloudVM.failed.action.delete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh the Machines list and retry. A machine that no longer exists is removed from the list automatically. To see the full output, run `cmux vm rm <id>` in a terminal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシン一覧を更新して再試行してください。存在しないマシンは一覧から自動的に削除されます。完全な出力はターミナルで `cmux vm rm <id>` を実行して確認できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请刷新机器列表后重试。已不存在的机器会自动从列表中移除。若要查看完整输出，请在终端中运行 `cmux vm rm <id>`。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren Sie die Liste der Maschinen und versuchen Sie es erneut. Eine Maschine, die nicht mehr existiert, wird automatisch aus der Liste entfernt. Um die vollständige Ausgabe zu sehen, führen Sie `cmux vm rm <id>` in einem Terminal aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualisez la liste des machines et réessayez. Une machine qui n’existe plus est automatiquement supprimée de la liste. Pour voir la sortie complète, exécutez `cmux vm rm <id>` dans un terminal."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث قائمة الأجهزة وأعد المحاولة. يُزال الجهاز الذي لم يعد موجودًا من القائمة تلقائيًا. لعرض المخرج بالكامل، شغّل `cmux vm rm <id>` في طرفية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza la lista de máquinas y reintenta. Las máquinas que ya no existen se eliminan de la lista automáticamente. Para ver la salida completa, ejecuta `cmux vm rm <id>` en una terminal."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新整理機器列表並重試。已不存在的機器會自動從列表中移除。若要查看完整輸出，請在終端機中執行 `cmux vm rm <id>`。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 목록을 새로 고침하고 다시 시도하세요. 더 이상 존재하지 않는 기기는 목록에서 자동으로 제거됩니다. 전체 출력을 보려면 터미널에서 `cmux vm rm <id>`를 실행하세요."
          }
        }
      }
    },
    "command.cloudVM.failed.action.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry, or run the Cloud VM command in a terminal to see the full output."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行するか、ターミナルで Cloud VM コマンドを実行して完全な出力を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重试，或在终端中运行该 Cloud VM 命令以查看完整输出。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie es erneut oder führen Sie den Cloud-VM-Befehl in einem Terminal aus, um die vollständige Ausgabe zu sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez, ou exécutez la commande Cloud VM dans un terminal pour voir la sortie complète."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد المحاولة، أو شغّل أمر Cloud VM في طرفية لعرض المخرج بالكامل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reintenta, o ejecuta el comando de la máquina virtual en la nube en una terminal para ver la salida completa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重試，或在終端機中執行雲端虛擬機器 (Cloud VM) 指令以查看完整輸出。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 시도하거나, 전체 출력을 보려면 터미널에서 Cloud VM 명령을 실행하세요."
          }
        }
      }
    },
    "command.cloudVM.failed.action.rename": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A label is printable text of at most 64 characters. Retry, or run `cmux vm rename <id> <label>` in a terminal to see the full output."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラベルは 64 文字以内の印刷可能なテキストにしてください。再試行するか、ターミナルで `cmux vm rename <id> <label>` を実行して完全な出力を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签为不超过 64 个字符的可打印文本。请重试，或在终端中运行 `cmux vm rename <id> <label>` 以查看完整输出。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Label ist druckbarer Text von höchstens 64 Zeichen. Versuchen Sie es erneut oder führen Sie `cmux vm rename <id> <label>` in einem Terminal aus, um die vollständige Ausgabe zu sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une étiquette est un texte imprimable de 64 caractères maximum. Réessayez, ou exécutez `cmux vm rename <id> <label>` dans un terminal pour voir la sortie complète."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التسمية هي نص قابل للطباعة لا يتعدى 64 حرفًا. أعد المحاولة، أو شغّل `cmux vm rename <id> <label>` في طرفية لعرض المخرج بالكامل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una etiqueta es texto imprimible de como máximo 64 caracteres. Reintenta, o ejecuta `cmux vm rename <id> <label>` en una terminal para ver la salida completa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤為最多 64 個字元的可列印文字。請重試，或在終端機中執行 `cmux vm rename <id> <label>` 以查看完整輸出。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이블은 최대 64자의 출력 가능한 텍스트여야 합니다. 다시 시도하거나, 전체 출력을 보려면 터미널에서 `cmux vm rename <id> <label>`을 실행하세요."
          }
        }
      }
    },
    "command.cloudVM.failed.action.launch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload cmux so its command-line tools are available, then retry. If it still fails, run the Cloud VM command in a terminal and send us the output."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドラインツールを使えるように cmux を再読み込みしてから再試行してください。それでも失敗する場合は、ターミナルで Cloud VM コマンドを実行して出力を送ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新加载 cmux，使其命令行工具可用，然后重试。若仍然失败，请在终端中运行该 Cloud VM 命令，并把输出发给我们。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden Sie cmux neu, damit seine Befehlszeilenwerkzeuge verfügbar sind, und versuchen Sie es erneut. Wenn es immer noch fehlschlägt, führen Sie den Cloud-VM-Befehl in einem Terminal aus und senden Sie uns die Ausgabe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechargez cmux pour que ses outils en ligne de commande soient disponibles, puis réessayez. Si cela échoue toujours, exécutez la commande Cloud VM dans un terminal et envoyez-nous la sortie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد تحميل cmux لتصبح أدوات سطر الأوامر الخاصة به متاحة، ثم أعد المحاولة. إذا استمر الفشل، فشغّل أمر Cloud VM في طرفية وأرسل إلينا المخرج."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a cargar cmux para que sus herramientas de línea de comandos estén disponibles, luego reintenta. Si sigue fallando, ejecuta el comando de la máquina virtual en la nube en una terminal y envíanos la salida."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新載入 cmux 以使其命令列工具可用，然後重試。如果仍然失敗，請在終端機中執行雲端虛擬機器 (Cloud VM) 指令，並將輸出傳送給我們。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux의 명령줄 도구를 사용할 수 있도록 cmux를 다시 로드한 후 다시 시도하세요. 계속 실패하는 경우 터미널에서 Cloud VM 명령을 실행하고 그 출력을 보내주세요."
          }
        }
      }
    },
    "command.cloudVM.failed.action.missingCLI": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install or reload a fresh cmux build, then retry. You can also run the Cloud VM command in a terminal to see the full error."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい cmux ビルドをインストールまたは再読み込みしてから再試行してください。ターミナルで Cloud VM コマンドを実行すると完全なエラーも確認できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请安装或重新加载新的 cmux 构建，然后重试。你也可以在终端中运行该 Cloud VM 命令以查看完整错误。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installieren oder laden Sie einen neuen cmux-Build neu und versuchen Sie es erneut. Sie können den Cloud-VM-Befehl auch in einem Terminal ausführen, um den vollständigen Fehler anzuzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez ou rechargez une nouvelle version de cmux, puis réessayez. Vous pouvez également exécuter la commande Cloud VM dans un terminal pour voir l’erreur complète."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت نسخة بناء جديدة من cmux أو أعد تحميلها، ثم أعد المحاولة. يمكنك أيضًا تشغيل أمر Cloud VM في طرفية لعرض الخطأ بالكامل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala o vuelve a cargar una versión reciente de cmux, luego reintenta. También puedes ejecutar el comando de la máquina virtual en la nube en una terminal para ver el error completo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝或重新載入全新的 cmux 版本，然後重試。您也可以在終端機中執行 Cloud VM 命令以查看完整錯誤。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신 cmux 빌드를 설치하거나 다시 로드한 후 다시 시도하세요. 터미널에서 Cloud VM 명령을 실행하여 전체 오류를 확인할 수도 있습니다."
          }
        }
      }
    },
