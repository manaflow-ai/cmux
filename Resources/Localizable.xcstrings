    "settings.mobile.port.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferred port for the iOS pairing listener (TCP) and the Iroh endpoint that Direct addresses dial (UDP), 1–65535."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ペアリングリスナー（TCP）と、Direct アドレスの接続先となる Iroh エンドポイント（UDP）の優先ポート（1〜65535）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 配对监听器（TCP）以及 Direct 地址所拨的 Iroh 端点（UDP）首选的端口，取值 1–65535。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevorzugter Port für den iOS-Kopplungs-Listener (TCP) und den Iroh-Endpunkt, den Direkt-Adressen anwählen (UDP), 1–65535."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Port préféré pour l’écouteur de jumelage iOS (TCP) et le point de terminaison Iroh composé par les adresses directes (UDP), 1–65535."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المنفذ المفضل لمستمع اقتران iOS ‏(TCP) ونقطة نهاية Iroh التي تطلبها العناوين المباشرة (UDP)، من 1 إلى 65535."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puerto preferido para el receptor de vinculación de iOS (TCP) y el punto de conexión de Iroh al que llaman las direcciones directas (UDP), de 1 a 65535."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 配對接聽程式 (TCP) 以及直接地址撥號之 Iroh 端點 (UDP) 的偏好連接埠，範圍為 1–65535。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 페어링 리스너(TCP) 및 직접 주소가 연결하는 Iroh 엔드포인트(UDP)가 선호하는 포트(1~65535)입니다."
          }
        }
      }
    },
