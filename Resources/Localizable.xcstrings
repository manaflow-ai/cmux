          "stringUnit": {
            "state": "translated",
            "value": "Il trasporto terminale Mosh richiede un workspace gestito da SSH."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosh ターミナルトランスポートには SSH 管理のワークスペースが必要です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មធ្យោបាយស្ថានីយ Mosh ត្រូវការកន្លែងធ្វើការដែលគ្រប់គ្រងដោយ SSH។"
