    "cli.vm.output.invalidPage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The machine returned an invalid output page. Reconnect and retry."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Maschine hat eine ungültige Ausgabeseite zurückgegeben. Verbinden Sie sich erneut und versuchen Sie es noch einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La machine a renvoyé une page de sortie invalide. Reconnectez-vous et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرجع الجهاز صفحة مخرجات غير صالحة. أعد الاتصال وأعد المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La máquina devolvió una página de salida no válida. Vuelva a conectarse y reintente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "機器傳回了無效的輸出頁面。請重新連接並重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机器返回了无效的输出页。请重新连接并重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머신이 유효하지 않은 출력 페이지를 반환했습니다. 다시 연결한 후 시도하십시오."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンが無効な出力ページを返しました。再接続して再試行してください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maskinen returnerte en ugyldig utdataside. Koble til på nytt og prøv igjen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Машина вернула недопустимую страницу вывода. Переподключитесь и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Makine geçersiz bir çıktı sayfası döndürdü. Yeniden bağlanın ve tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Машина повернула невалідну сторінку виводу. Перепідключіться і повторіть спробу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Máy trả về trang đầu ra không hợp lệ. Kết nối lại và thử lại."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ម៉ាស៊ីនបានត្រឡប់ទំព័រលទ្ធផលមិនត្រឹមត្រូវ។ ភ្ជាប់ឡើងវិញ ហើយព្យាយាមម្ដងទៀត។"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เครื่องส่งคืนหน้าเอาต์พุตที่ไม่ถูกต้อง กรุณาเชื่อมต่อใหม่แล้วลองอีกครั้ง"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mašina je vratila nevažeću stranicu izlaza. Ponovo se povežite i pokušajte."
          }
        },
