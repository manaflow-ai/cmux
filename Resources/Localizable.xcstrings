    "cli.vpn.status.state.awaitingApproval": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnel: waiting for approval in System Settings › General › Login Items & Extensions"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トンネル: 「システム設定」›「一般」›「ログイン項目と機能拡張」での承認を待っています"
          }
        },
        "de": {
