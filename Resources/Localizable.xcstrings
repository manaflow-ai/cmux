    "cli.ssh.authenticationFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH authentication did not open the connection. Check your SSH credentials and retry."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتمكن مصادقة SSH من فتح الاتصال. تحقق من بيانات اعتماد SSH وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die SSH-Authentifizierung konnte die Verbindung nicht öffnen. Prüfen Sie Ihre SSH-Zugangsdaten und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La autenticación SSH no abrió la conexión. Revisa tus credenciales SSH e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’authentification SSH n’a pas permis d’ouvrir la connexion. Vérifiez vos identifiants SSH et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 認証で接続を確立できませんでした。SSH の認証情報を確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 인증으로 연결을 열지 못했습니다. SSH 자격 증명을 확인하고 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 身份验证未能建立连接。请检查您的 SSH 凭据后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 驗證未能建立連線。請檢查您的 SSH 認證資料後再試一次。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH autentifikacija nije otvorila vezu. Provjerite SSH akreditive i pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH-godkendelse åbnede ikke forbindelsen. Tjek dine SSH-legitimationsoplysninger og prøv igen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'autenticazione SSH non ha aperto la connessione. Verifica le credenziali SSH e riprova."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការផ្ទៀងផ្ទាត់ SSH មិនបានបើកការតភ្ជាប់។ ពិនិត្យ SSH credentials របស់អ្នក ហើយព្យាយាមម្តងទៀត។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH-godkjenning åpnet ikke tilkoblingen. Kontroller SSH-legitimasjonen og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uwierzytelnienie SSH nie otworzyło połączenia. Sprawdź dane uwierzytelniające SSH i spróbuj ponownie."
