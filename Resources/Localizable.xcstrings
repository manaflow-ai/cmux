        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시뮬레이터 이벤트 구독자가 제한된 대기열을 초과했습니다."
          }
        }
      }
    },
    "simulator.failure.tccUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator permissions are not available yet. Wait for the device to finish starting."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シミュレータの権限はまだ利用できません。デバイスの起動が完了するまでお待ちください。"
