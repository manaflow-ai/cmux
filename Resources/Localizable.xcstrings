        }
      }
    },
    "simulator.failure.workerCommandOutcomeUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Simulator worker accepted a command but disconnected before confirming its outcome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulatorワーカーはコマンドを受け付けましたが、結果を確認する前に切断されました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟器工作进程接受了命令，但在确认结果前断开了连接。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
