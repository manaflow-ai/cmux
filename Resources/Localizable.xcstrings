          }
        }
      }
    },
    "simulator.failure.duplicateWorkerRequest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Simulator worker request reused an active correlation identifier."
          }
