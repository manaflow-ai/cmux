          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmuxの通知が無効になっています。アラートを表示するにはシステム設定で有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
