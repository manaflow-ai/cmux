          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nota: i checkpoint di questo agent sono in sola lettura (fork non ancora supportato)"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
