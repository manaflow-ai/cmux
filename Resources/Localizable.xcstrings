    "settings.notifications.soundOverrides.invalidConfiguration": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعدادات الصوت المحفوظة لكل وكيل غير صالحة. أصلح notifications.soundOverrides في cmux.json قبل التحرير."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sačuvane postavke zvuka po agentu nisu važeće. Ispravite notifications.soundOverrides u cmux.json prije uređivanja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De gemte lydindstillinger pr. agent er ugyldige. Ret notifications.soundOverrides i cmux.json, før du redigerer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherten agentenspezifischen Toneinstellungen sind ungültig. Korrigiere notifications.soundOverrides in cmux.json vor dem Bearbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved per-agent sound settings are invalid. Fix notifications.soundOverrides in cmux.json before editing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración de sonido por agente guardada no es válida. Corrige notifications.soundOverrides en cmux.json antes de editarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages de son par agent enregistrés sont invalides. Corrigez notifications.soundOverrides dans cmux.json avant de modifier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni del suono per agente salvate non sono valide. Correggi notifications.soundOverrides in cmux.json prima di modificarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたエージェント別サウンド設定が無効です。編集する前に cmux.json の notifications.soundOverrides を修正してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការកំណត់សំឡេងតាមភ្នាក់ងារដែលបានរក្សាទុកមិនត្រឹមត្រូវទេ។ កែ notifications.soundOverrides ក្នុង cmux.json មុនពេលកែសម្រួល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 에이전트별 소리 설정이 잘못되었습니다. 편집하기 전에 cmux.json의 notifications.soundOverrides를 수정하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De lagrede lydinnstillingene per agent er ugyldige. Rett notifications.soundOverrides i cmux.json før du redigerer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane ustawienia dźwięku dla agentów są nieprawidłowe. Popraw notifications.soundOverrides w cmux.json przed edycją."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As configurações de som por agente salvas são inválidas. Corrija notifications.soundOverrides em cmux.json antes de editar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённые настройки звука для агентов недействительны. Исправьте notifications.soundOverrides в cmux.json перед редактированием."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่าเสียงแยกตามเอเจนต์ที่บันทึกไว้ไม่ถูกต้อง แก้ไข notifications.soundOverrides ใน cmux.json ก่อนแก้ไข"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen ajan başına ses ayarları geçersiz. Düzenlemeden önce cmux.json içindeki notifications.soundOverrides değerini düzeltin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережені налаштування звуку для агентів недійсні. Виправте notifications.soundOverrides у cmux.json перед редагуванням."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的代理声音设置无效。请先修复 cmux.json 中的 notifications.soundOverrides，再进行编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的代理程式聲音設定無效。請先修正 cmux.json 中的 notifications.soundOverrides，再進行編輯。"
          }
        }
      }
    },
