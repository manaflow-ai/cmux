    "machines.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes the machine and everything stored on it. This cannot be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンと保存されているすべてのデータが完全に削除されます。この操作は取り消せません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会永久删除该机器以及其上存储的一切内容，且无法撤销。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies löscht die Maschine und alle darauf gespeicherten Daten dauerhaft. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement la machine et tout ce qui y est stocké. Cette action est irréversible."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف الجهاز وكل ما تم تخزينه عليه نهائيًا. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará permanentemente la máquina y todo lo que esté almacenado en ella. Esta acción no se puede deshacer."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將永久刪除此機器及其上儲存的所有內容。此操作無法復原。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 머신과 그 안에 저장된 모든 데이터를 영구적으로 삭제합니다. 이 작업은 되돌릴 수 없습니다."
          }
        }
      }
    },
