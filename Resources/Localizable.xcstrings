        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio de nombre de la terminal modificó %1$d de %#@count2@. Otro cambio impidió una reversión segura. Actualiza e inténtalo de nuevo."
          },
          "substitutions": {
