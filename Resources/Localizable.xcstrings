          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Valider JSON eller JSONC, kør cmux reload-config, og kontrollér det resulterende indgangspunkt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Valida il JSON o JSONC, esegui cmux reload-config e verifica l'entry point risultante."
