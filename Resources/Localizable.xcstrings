    "cli.error.workspaceLoadingInvalidId": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid --id '%@'. Use letters, digits, '.', '_', or '-' (no spaces)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効な --id '%@' です。英数字、'.'、'_'、'-' のみ使用できます（空白不可）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘못된 --id '%@'입니다. 영문자, 숫자, '.', '_', '-'만 사용할 수 있습니다(공백 불가)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неприпустимий --id '%@'. Використовуйте літери, цифри, '.', '_' або '-' (без пробілів)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无效的 --id '%@'。请使用字母、数字、'.'、'_' 或 '-'（不能有空格）。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültige --id „%@“. Verwende Buchstaben, Ziffern, „.“, „_“ oder „-“ (keine Leerzeichen)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "--id '%@' non valide. Utilisez des lettres, des chiffres, '.', '_', ou '-' (sans espaces)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المعرف --id غير صالح '%@'. استخدم الحروف، أو الأرقام، أو '.'، أو '_'، أو '-' (بدون مسافات)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "--id '%@' no válido. Usa letras, dígitos, '.', '_' o '-' (sin espacios)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無效的 --id '%@'。請使用字母、數字、'.'、'_' 或 '-' (不能有空格)。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nevažeći --id '%@'. Koristite slova, cifre, '.', '_' ili '-' (bez razmaka)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ugyldigt --id '%@'. Brug bogstaver, cifre, '.', '_' eller '-' (ingen mellemrum)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "--id '%@' non valido. Usa lettere, cifre, '.', '_' o '-' (senza spazi)."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "--id '%@' មិនត្រឹមត្រូវ។ ប្រើអក្សរ, លេខ, '.', '_', ឬ '-' (គ្មានដកឃ្លា)។"
          }
        },
        "nb": {
          "stringUnit": {
