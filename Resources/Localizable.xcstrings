            "state": "translated",
            "value": "notify --clear --surface krever arbeidsområde- eller vinduskontekst; angi --workspace eller --window"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface wymaga kontekstu obszaru roboczego lub okna; podaj --workspace lub --window"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
