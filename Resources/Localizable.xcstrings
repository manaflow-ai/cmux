    "cli.workflow.layouts.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved layouts capture a live workspace arrangement. Use an example as a starting point, adapt the workspace, and save the result for reuse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Layouts halten eine aktive Workspace-Anordnung fest. Verwende ein Beispiel als Ausgangspunkt, passe den Workspace an und speichere das Ergebnis zur Wiederverwendung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les layouts enregistrés capturent une organisation active. Utilisez un exemple, adaptez l’espace de travail, puis enregistrez le résultat."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلتقط التخطيطات المحفوظة ترتيب مساحة عمل حيّة. استخدم مثالاً كنقطة بداية، وعدّل المساحة، ثم احفظ النتيجة لإعادة استخدامها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los diseños guardados capturan una disposición activa. Usa un ejemplo, adapta el espacio de trabajo y guarda el resultado para reutilizarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的版面配置會記錄目前的工作區排列。以範例開始、調整工作區，再儲存結果以便重複使用。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的布局会记录当前工作区排列。以示例开始，调整工作区，再保存结果以便重复使用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 레이아웃은 현재 작업 공간 배치를 기록합니다. 예제로 시작해 작업 공간을 조정한 뒤 결과를 저장해 재사용하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みレイアウトは現在のワークスペース配置を記録します。例を元に調整し、結果を保存して再利用できます。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sačuvani rasporedi bilježe živu organizaciju radnog prostora. Koristite primjer kao polazišnu tačku, prilagodite radni prostor i sačuvajte rezultat za ponovnu upotrebu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gemte layouts registrerer en aktiv workspace-opsætning. Brug et eksempel som udgangspunkt, tilpas workspace, og gem resultatet til genbrug."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I layout salvati acquisiscono la disposizione live di un workspace. Usa un esempio come punto di partenza, adatta il workspace e salva il risultato per riutilizzarlo."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Layout ដែលបានរក្សាទុករក្សាការរៀបចំ workspace ផ្ទាល់ប្រើ។ ប្រើឧទាហរណ៍ជាចំណុចចាប់ផ្តើម កែសម្រួល workspace ហើយរក្សាទុកលទ្ធផលសម្រាប់ប្រើជាថ្មី។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lagrede oppsett fanger et aktivt arbeidsområdearrangement. Bruk et eksempel som utgangspunkt, tilpass arbeidsområdet og lagre resultatet for gjenbruk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zapisane układy utrwalają aktywne rozmieszczenie obszaru roboczego. Użyj przykładu jako punktu wyjścia, dostosuj obszar roboczy i zapisz wynik do ponownego użycia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Layouts salvos capturam uma disposição de workspace ao vivo. Use um exemplo como ponto de partida, adapte o workspace e salve o resultado para reutilização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сохранённые макеты фиксируют живое расположение рабочего пространства. Используйте пример как отправную точку, адаптируйте рабочее пространство и сохраните результат для повторного использования."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Layout ที่บันทึกไว้จะจับการจัดเรียง workspace แบบสด ใช้ตัวอย่างเป็นจุดเริ่มต้น ปรับ workspace แล้วบันทึกผลลัพธ์เพื่อนำมาใช้ซ้ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kayıtlı düzenler canlı bir çalışma alanı düzenlemesini yakalar. Başlangıç noktası olarak bir örnek kullanın, çalışma alanını uyarlayın ve sonucu yeniden kullanmak üzere kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
