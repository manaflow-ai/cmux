          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] PTY distant reconnecté (tentative %s/%s)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] تمت إعادة اتصال PTY البعيد (المحاولة %s/%s)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
