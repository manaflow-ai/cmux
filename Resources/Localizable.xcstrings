          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存。开启 iOS 配对后，配对监听器将使用端口 %lld。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert. Der Kopplungs-Listener verwendet Port %lld, wenn die iOS-Kopplung aktiviert ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré. L’écouteur de jumelage utilisera le port %lld lorsque le jumelage iOS sera activé."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الحفظ. سيستخدم مستمع الاقتران المنفذ %lld عندما يكون اقتران iOS قيد التشغيل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado. El receptor de vinculación usará el puerto %lld cuando la vinculación con iOS esté activada."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存。啟用 iOS 配對時，配對接聽程式將會使用連接埠 %lld。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장되었습니다. iOS 페어링이 활성화되면 페어링 리스너가 %lld 포트를 사용합니다."
          }
        }
      }
    },
    "settings.mobile.port.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Apply to change the port. cmux checks the port is free first: if it's in use, the current listener keeps running untouched; if it's free, the pairing listener rebinds now and connected devices reconnect. The Iroh endpoint adopts the new port the next time cmux starts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポートを変更するには「適用」をクリックします。cmux はまずポートが空いているか確認します。使用中の場合は現在のリスナーをそのまま維持し、空いている場合はペアリングリスナーを直ちに再バインドして、接続中のデバイスは新しいポートで再接続します。Iroh エンドポイントは次回の cmux 起動時に新しいポートを使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按「应用」以更改端口。cmux 会先检查端口是否空闲：若已被占用，当前监听器保持原样继续运行；若空闲，配对监听器会立即重新绑定，已连接的设备会重新连接。Iroh 端点会在 cmux 下次启动时采用新端口。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie auf „Anwenden“, um den Port zu ändern. cmux prüft zuerst, ob der Port frei ist: Wenn er belegt ist, läuft der aktuelle Listener unverändert weiter; wenn er frei ist, bindet sich der Kopplungs-Listener jetzt neu und verbundene Geräte verbinden sich wieder. Der Iroh-Endpunkt übernimmt den neuen Port beim nächsten Start von cmux."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur Appliquer pour changer le port. cmux vérifie d’abord que le port est libre : s’il est utilisé, l’écouteur actuel continue de fonctionner sans modification ; s’il est libre, l’écouteur de jumelage se relie immédiatement et les appareils connectés se reconnectent. Le point de terminaison Iroh adoptera le nouveau port au prochain démarrage de cmux."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على \"تطبيق\" لتغيير المنفذ. يتحقق cmux أولاً من أن المنفذ فارغ: إذا كان قيد الاستخدام، يستمر المستمع الحالي في العمل دون تغيير؛ وإذا كان فارغًا، يعيد مستمع الاقتران الارتباط الآن وتتصل الأجهزة المتصلة مجددًا. تتبنى نقطة نهاية Iroh المنفذ الجديد في المرة التالية التي يبدأ فيها تشغيل cmux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en Aplicar para cambiar el puerto. cmux comprueba primero si el puerto está libre: si está en uso, el receptor actual sigue funcionando sin cambios; si está libre, el receptor de vinculación se vuelve a enlazar ahora y los dispositivos conectados se vuelven a conectar. El punto de conexión de Iroh adoptará el nuevo puerto la próxima vez que se inicie cmux."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下套用以變更連接埠。cmux 會先檢查該連接埠是否可用：若已被佔用，目前的接聽程式將繼續執行且不受影響；若為可用，配對接聽程式會立即重新繫結，且已連線的裝置將會重新連線。Iroh 端點將在下次 cmux 啟動時採用新的連接埠。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포트를 변경하려면 적용을 클릭하세요. cmux는 먼저 포트가 비어 있는지 확인합니다. 사용 중인 경우 현재 리스너가 변경 없이 계속 실행되고, 비어 있는 경우 페어링 리스너가 지금 다시 바인딩되며 연결된 기기가 다시 연결됩니다. Iroh 엔드포인트는 다음 번에 cmux가 시작될 때 새 포트를 적용합니다."
          }
        }
      }
    },
