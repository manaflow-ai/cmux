    "settings.app.fileDrop.defaultBehavior.preview.subtitle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي سحب الملفات إلى فتح المعاينات أو الأجزاء المقسمة. اضغط Shift فوق الطرفيات والمحررات لإدراج نص المسار."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevlačenje datoteka otvara preglede ili podijeljene panele. Držite Shift iznad terminala i editora za umetanje teksta putanje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når filer trækkes ind, åbnes forhåndsvisninger eller splitpaneler. Hold Skift nede over terminaler og editorer for at indsætte stitekst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezogene Dateien öffnen Vorschauen oder Split-Bereiche. Halten Sie über Terminals und Editoren die Umschalttaste, um Pfadtext einzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dragging files opens previews or split panes. Hold Shift over terminals and editors to insert path text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastrar archivos abre vistas previas o paneles divididos. Mantén Shift sobre terminales y editores para insertar texto de ruta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire glisser des fichiers ouvre des aperçus ou des volets divisés. Maintenez Maj sur les terminaux et les éditeurs pour insérer le chemin sous forme de texte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascinare file apre anteprime o riquadri divisi. Tieni premuto Maiuscole sopra terminali ed editor per inserire il percorso come testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルをドラッグするとプレビューまたは分割ペインで開きます。ターミナルやエディタ上で Shift キーを押したままにするとパス文字列を挿入します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 드래그하면 미리보기 또는 분할 창이 열립니다. 터미널과 편집기 위에서 Shift를 누르면 경로 텍스트가 삽입됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når filer dras inn, åpnes forhåndsvisninger eller delte ruter. Hold Skift over terminaler og redigerere for å sette inn stitekst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciąganie plików otwiera podglądy lub podzielone panele. Przytrzymaj Shift nad terminalami i edytorami, aby wstawić tekst ścieżki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastar arquivos abre pré-visualizações ou painéis divididos. Segure Shift sobre terminais e editores para inserir texto de caminho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивание файлов открывает предпросмотр или разделённые панели. Удерживайте Shift над терминалами и редакторами, чтобы вставить путь как текст."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลากไฟล์จะเปิดตัวอย่างหรือบานหน้าต่างแบบแบ่ง กด Shift ค้างไว้เหนือเทอร์มินัลและตัวแก้ไขเพื่อแทรกข้อความพาธ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyaları sürüklemek önizlemeleri veya bölünmüş bölmeleri açar. Yol metni eklemek için terminal ve düzenleyicilerin üzerinde Shift tuşunu basılı tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягування файлів відкриває попередній перегляд або розділені панелі. Утримуйте Shift над терміналами й редакторами, щоб вставити шлях як текст."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖入文件会打开预览或拆分窗格。在终端和编辑器上按住 Shift 可插入路径文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖入檔案會開啟預覽或分割窗格。在終端機和編輯器上按住 Shift 可插入路徑文字。"
          }
        }
      }
    },
