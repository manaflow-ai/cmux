      }
    },
    "computerUse.onboarding.accessibility.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility lets the Computer Use helper inspect controls, click buttons, and type in apps you ask an agent to use."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティを許可すると、Computer Useヘルパーはエージェントに操作を依頼したアプリのコントロールを確認し、ボタンのクリックや文字入力を行えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能让 Computer Use 助手能够检查控件、点按按钮，并在你让代理使用的应用中输入。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bedienungshilfen ermöglichen es dem Computer-Use-Helfer, Steuerelemente zu überprüfen, auf Schaltflächen zu klicken und in Apps zu schreiben, die Sie einem Agenten zur Verwendung vorgeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accessibilité permet à l’assistant Computer Use d’inspecter les commandes, de cliquer sur les boutons et de saisir du texte dans les applications que vous demandez à un agent d’utiliser."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتيح ميزة إمكانية الوصول لمساعد استخدام الكمبيوتر فحص عناصر التحكم، والنقر على الأزرار، والكتابة في التطبيقات التي تطلب من العميل استخدامها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La accesibilidad permite que el asistente de Computer Use inspeccione controles, haga clic en botones y escriba en las aplicaciones que le pidas al agente que use."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「輔助功能」可讓電腦操作協助程式檢查控制項、點擊按鈕，並在您要求代理程式使用的應用程式中進行輸入。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용 권한을 허용하면 컴퓨터 사용 도우미가 에이전트에게 사용을 요청한 앱의 컨트롤을 검사하고, 버튼을 클릭하고, 입력할 수 있습니다."
          }
        }
      }
    },
