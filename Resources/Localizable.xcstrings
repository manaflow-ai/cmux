                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%d paneles de navegador lo estén usando"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%d paneles de navegador lo estén usando"
                    }
                  }
