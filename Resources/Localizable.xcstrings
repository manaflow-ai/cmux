    "simulator.camera.experimentalHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera injection uses private Simulator interfaces and may stop working after an Xcode update."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ注入は非公開のSimulatorインターフェイスを使用するため、Xcodeの更新後に動作しなくなる場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头注入使用模拟器的私有接口，Xcode 更新后可能失效。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera-Einspeisung verwendet private Simulator-Schnittstellen und funktioniert nach einem Xcode-Update möglicherweise nicht mehr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’injection d’appareil photo utilise des interfaces privées du Simulator et peut cesser de fonctionner après une mise à jour de Xcode."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم حقن الكاميرا واجهات Simulator الخاصة وقد يتوقف عن العمل بعد تحديث Xcode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La inyección de cámara utiliza interfaces privadas del simulador y puede dejar de funcionar después de una actualización de Xcode."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機插入功能使用的是私有的模擬器介面，在 Xcode 更新後可能會停止運作。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 주입은 비공개 Simulator 인터페이스를 사용하므로 Xcode 업데이트 후에 작동이 중단될 수 있습니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ubacivanje kamere koristi privatna sučelja Simulatora i može prestati raditi nakon ažuriranja Xcode-a."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kameraindjektion bruger private Simulator-grænseflader og fungerer muligvis ikke efter en Xcode-opdatering."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'iniezione della fotocamera usa interfacce private del Simulator e potrebbe smettere di funzionare dopo un aggiornamento di Xcode."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការបញ្ចូលកាមេរ៉ាប្រើចំណុចប្រទាក់ Simulator ឯកជន ហើយអាចឈប់ដំណើរការបន្ទាប់ពីអាប់ដេត Xcode។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kamerainjeksjon bruker private Simulator-grensesnitt og kan slutte å fungere etter en Xcode-oppdatering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wstrzykiwanie kamery używa prywatnych interfejsów Simulatora i może przestać działać po aktualizacji Xcode."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A injeção de câmera usa interfaces privadas do Simulator e pode parar de funcionar após uma atualização do Xcode."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Инъекция камеры использует приватные интерфейсы Simulator и может перестать работать после обновления Xcode."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การฉีด Camera ใช้อินเทอร์เฟซส่วนตัวของ Simulator และอาจหยุดทำงานหลัง Xcode อัปเดต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kamera enjeksiyonu, Simulator'ın özel arayüzlerini kullanır ve Xcode güncellemesinden sonra çalışmayı durdurabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ін'єкція камери використовує приватні інтерфейси Simulator і може перестати працювати після оновлення Xcode."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tính năng chèn camera sử dụng giao diện riêng tư của Simulator và có thể ngừng hoạt động sau khi cập nhật Xcode."
          }
        }
      }
    },
