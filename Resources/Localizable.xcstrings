        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "--remove-generated-anchor yalnızca anchor'ı cmux tarafından oluşturulmuş, anchor'a özgü gruplar için kullanın."
          }
        }
      }
    },
    "cli.workspaceGroup.help.deleteSafety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dissolve a group, preserving all members"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全メンバーを保持したままグループを解除"
          }
