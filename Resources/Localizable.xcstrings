    "cli.coderouter.bootstrap.downloadFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not download the CodeRouter installer (curl exited with status %1$d). Retry, or install it with:\n  %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter インストーラーをダウンロードできませんでした (curl の終了ステータス: %1$d)。もう一度お試しいただくか、次のコマンドでインストールしてください:\n  %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der CodeRouter-Installer konnte nicht heruntergeladen werden (curl wurde mit Status %1$d beendet). Versuche es erneut oder installiere es mit:\n  %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de télécharger l'installateur de CodeRouter (curl a quitté avec le statut %1$d). Réessayez, ou installez-le avec :\n  %2$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تنزيل برنامج تثبيت CodeRouter (خرج curl بالحالة %1$d). أعد المحاولة، أو ثبته باستخدام:\n  %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo descargar el instalador de CodeRouter (curl finalizó con el estado %1$d). Reinténtalo o instálalo con:\n  %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法下載 CodeRouter 安裝程式 (curl 結束，狀態碼為 %1$d)。請重試，或使用以下命令安裝：\n  %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法下载 CodeRouter 安装程序 (curl 以状态码 %1$d 退出)。请重试，或使用以下命令安装：\n  %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter 설치 프로그램을 다운로드할 수 없습니다 (curl이 상태 코드 %1$d(으)로 종료됨). 다시 시도하거나 다음 명령어로 설치하십시오:\n  %2$@"
          }
        }
      }
    },
    "cli.coderouter.bootstrap.installedNotFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The CodeRouter installer finished, but its command could not be found in %@. Check the installation and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter のインストールは完了しましたが、%@ にコマンドが見つかりませんでした。インストールを確認して、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Installation von CodeRouter ist abgeschlossen, aber der Befehl wurde in %@ nicht gefunden. Prüfen Sie die Installation und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’installation de CodeRouter est terminée, mais sa commande est introuvable dans %@. Vérifiez l’installation et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتمل تثبيت CodeRouter، لكن لم يتم العثور على أمره في %@. تحقق من التثبيت وحاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La instalación de CodeRouter finalizó, pero no se encontró su comando en %@. Comprueba la instalación y vuelve a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter 安裝已完成，但在 %@ 中找不到其指令。請檢查安裝結果後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter 安装已完成，但在 %@ 中找不到其命令。请检查安装结果后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter 설치가 완료되었지만 %@에서 명령을 찾을 수 없습니다. 설치 상태를 확인한 후 다시 시도하세요."
          }
        }
      }
    },
