    "cli.cloud.domains.malformedDomainResponse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cmux app returned a domain response this CLI could not read."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux アプリから、この CLI では読み取れないドメインレスポンスが返されました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 应用返回的域名响应，本 CLI 无法解析。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die cmux-App hat eine Domain-Antwort zurückgegeben, die diese CLI nicht lesen konnte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’application cmux a renvoyé une réponse de domaine que cette CLI n’a pas pu lire."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرجع تطبيق cmux استجابة نطاق لم يتمكن واجهة خط الأوامر (CLI) من قراءتها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación cmux devolvió una respuesta de dominio que esta CLI no pudo leer."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 應用程式傳回了此 CLI 無法讀取的網域回應。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 앱이 이 CLI에서 읽을 수 없는 도메인 응답을 반환했습니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux aplikacija je vratila odgovor domene koji ovaj CLI nije mogao pročitati."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux-appen returnerede et domænesvar, som denne CLI ikke kunne læse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'app cmux ha restituito una risposta di dominio che questa CLI non è riuscita a leggere."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កម្មវិធី cmux បានត្រឡប់ការឆ្លើយតប domain ដែល CLI នេះមិនអាចអាន។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux-appen returnerte et domensvar som dette CLI-verktøyet ikke kunne lese."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aplikacja cmux zwróciła odpowiedź domeny, której to CLI nie mogło odczytać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O app cmux retornou uma resposta de domínio que esta CLI não conseguiu ler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Приложение cmux вернуло ответ домена, который этот CLI не смог прочитать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แอป cmux ส่งคืน domain response ที่ CLI ไม่สามารถอ่านได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux uygulaması bu CLI'ın okuyamadığı bir etki alanı yanıtı döndürdü."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Застосунок cmux повернув відповідь домену, яку цей CLI не зміг прочитати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ứng dụng cmux trả về phản hồi tên miền mà CLI này không thể đọc được."
          }
        }
      }
    },
