    "cli.workflow.ssh-devbox.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair a remote shell with a browser preview in one workspace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kombiniere eine entfernte Shell mit einer Browservorschau in einem Workspace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associez un shell distant et un aperçu navigateur dans un même espace de travail."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجمع بين shell بعيد ومعاينة متصفح في مساحة عمل واحدة."
          }
        },
        "es": {
          "stringUnit": {
