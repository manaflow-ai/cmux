      }
    },
    "cli.restore.error.currentSurfaceUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: the current cmux surface could not be identified. Retry from this terminal or pass --surface <id|ref>."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 現在の cmux サーフェスを特定できませんでした。このターミナルから再試行するか、--surface <id|ref> を指定してください。"
          }
        },
        "zh-Hans": {
