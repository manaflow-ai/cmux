          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thể tải xuống trình cài đặt CodeRouter (curl thoát với mã %1$d). Thử lại, hoặc cài đặt bằng:\n  %2$@"
          }
        }
      }
