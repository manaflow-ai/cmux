    "browser.viewport.error.attachedBrowserInspector": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close or detach the browser inspector before changing the browser viewport"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザのビューポートを変更する前にブラウザインスペクタを閉じるか切り離してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改浏览器视口前，请先关闭或分离浏览器检查器"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen oder trennen Sie den Browser-Inspektor, bevor Sie den Browser-Viewport ändern"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez ou détachez l'inspecteur du navigateur avant de modifier la fenêtre d'affichage du navigateur"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أغلق فاحص المتصفح أو افصله قبل تغيير منفذ عرض المتصفح"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra o desacopla el inspector del navegador antes de cambiar el viewport del navegador"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在變更瀏覽器檢視區之前，請先關閉或分離瀏覽器檢查器"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 뷰포트를 변경하기 전에 브라우저 검사기를 닫거나 분리하세요."
          }
        }
      }
    },
    "browser.viewport.error.dimensionsOutOfRange": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Viewport dimensions must be between 1 and 4096"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビューポートの寸法は 1 から 4096 の範囲で指定してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视口尺寸必须介于 1 到 4096 之间"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Viewport-Abmessungen müssen zwischen 1 und 4096 liegen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dimensions de la fenêtre d'affichage doivent être comprises entre 1 et 4096"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تكون أبعاد منفذ العرض بين 1 و 4096"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las dimensiones del viewport deben estar entre 1 y 4096"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視區尺寸必須介於 1 到 4096 之間"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뷰포트 크기는 1에서 4096 사이여야 합니다."
          }
        }
      }
    },
    "browser.viewport.error.elementFullscreen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exit browser element fullscreen before changing the browser viewport"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザのビューポートを変更する前に、ブラウザの要素フルスクリーンを終了してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改浏览器视口前，请先退出浏览器元素全屏"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlassen Sie den Vollbildmodus des Browser-Elements, bevor Sie den Browser-Viewport ändern"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quittez le mode plein écran de l'élément de navigateur avant de modifier la fenêtre d'affichage du navigateur"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اخرج من وضع ملء الشاشة لعنصر المتصفح قبل تغيير منفذ عرض المتصفح"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sal de la pantalla completa del elemento del navegador antes de cambiar el viewport del navegador"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在變更瀏覽器檢視區之前，請先退出瀏覽器元素的全螢幕模式"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 뷰포트를 변경하기 전에 브라우저 요소의 전체 화면을 종료하세요."
          }
        }
      }
    },
    "browser.viewport.error.renderGeometryTooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Viewport and page zoom exceed browser render limits"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビューポートとページズームがブラウザのレンダリング上限を超えています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视口与页面缩放超出浏览器渲染上限"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Viewport und Seitenzoom überschreiten die Rendergrenzen des Browsers"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le zoom de la fenêtre d'affichage et de la page dépasse les limites de rendu du navigateur"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجاوز منفذ العرض وتكبير الصفحة حدود تصيير المتصفح"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El viewport y el zoom de la página superan los límites de renderizado del navegador"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視區和頁面縮放超出瀏覽器轉譯限制"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뷰포트 및 페이지 배율이 브라우저 렌더링 한계를 초과합니다."
          }
        }
      }
    },
    "browser.viewport.error.requiresIntegerDimensions": {
