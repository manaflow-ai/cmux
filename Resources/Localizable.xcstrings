    "cloudTree.killTerminal.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The process ends on the machine, everywhere it is shown. Panes keep their scrollback."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシン上のプロセスが終了し、表示中のすべての場所に反映されます。ペインのスクロールバックは残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该进程会在机器上结束，所有显示它的位置都会随之结束。窗格会保留各自的回滚内容。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Prozess wird auf der Maschine beendet, überall wo er angezeigt wird. Teilfenster behalten ihren Scrollback-Verlauf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le processus se termine sur la machine, partout où il est affiché. Les volets conservent leur historique de défilement."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتهي العملية على الجهاز في كل مكان تُعرض فيه. تحتفظ الأجزاء بسجل التمرير الخاص بها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proceso finaliza en la máquina, en cualquier lugar donde se muestre. Los paneles conservan su historial de desplazamiento."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該程序將在機器上結束，並在所有顯示它的地方同步關閉。窗格將保留其回捲記錄。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로세스는 가상 머신 내부 및 표시되는 모든 곳에서 종료됩니다. 분할 창의 스크롤백은 유지됩니다."
          }
        }
      }
    },
