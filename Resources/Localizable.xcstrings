            "value": "Delivery target resolution is unavailable; retry after cmux finishes starting."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配信先の解決を利用できません。cmux の起動が完了してから再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投递目标解析不可用；请在 cmux 启动完成后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auflösung des Zustellungsziels ist nicht verfügbar; versuchen Sie es erneut, nachdem cmux den Start abgeschlossen hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
