        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳遞目標解析不可用；請在 cmux 完成啟動後重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전달 대상 확인을 사용할 수 없습니다. cmux 시작이 완료된 후 다시 시도하세요."
          }
        }
      }
    },
