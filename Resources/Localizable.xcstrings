    "settings.app.defaultTerminal.subtitleNotDefault": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set cmux as the handler for SSH links, .command/.tool files, and UNIX executables."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH リンク、.command/.tool ファイル、UNIX 実行ファイルのハンドラとして cmux を設定します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 cmux 设为 SSH 链接、.command/.tool 文件和 UNIX 可执行文件的处理程序。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie cmux als Handler für SSH-Links, .command/.tool-Dateien und UNIX-Ausführungsdateien fest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définir cmux comme gestionnaire pour les liens SSH, les fichiers .command/.tool et les exécutables UNIX."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعيين cmux كمعالج لروابط SSH، وملفات .command/.tool، وملفات UNIX التنفيذية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece cmux como el manejador para enlaces SSH, archivos .command/.tool y ejecutables de UNIX."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 cmux 設為 SSH 連結、.command/.tool 檔案和 UNIX 可執行檔的處理常式。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 링크, .command/.tool 파일 및 UNIX 실행 파일의 처리기로 cmux를 설정합니다."
          }
        }
      }
    },
