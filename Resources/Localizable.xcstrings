    "simulator.control.correlatedActionRequiresWorker": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action requires correlated execution in the isolated Simulator worker."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は分離されたSimulatorワーカーで関連付けて実行する必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
