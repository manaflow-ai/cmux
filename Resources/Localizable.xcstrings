    "cli.session.restore.cleanQuit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No agent sessions restored: cmux last quit normally. To restore one anyway, pass --session <id> from --list."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Agent-Sitzungen wiederhergestellt: cmux wurde zuletzt normal beendet. Um trotzdem eine wiederherzustellen, übergib --session <id> aus --list."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune session d’agent restaurée : cmux s’est fermé normalement la dernière fois. Pour en restaurer une quand même, passez --session <id> depuis --list."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتم استعادة أي جلسات وكيل: أُغلق cmux بشكل طبيعي آخر مرة. لاستعادة جلسة على أي حال، مرّر --session <id> من --list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se restauró ninguna sesión de agente: cmux se cerró normalmente la última vez. Para restaurar una de todos modos, pasa --session <id> de --list."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未還原任何代理工作階段：cmux 上次是正常結束。若仍要還原，請傳入 --list 中的 --session <id>。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未恢复任何代理会话：cmux 上次是正常退出。若仍要恢复，请传入 --list 中的 --session <id>。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원된 에이전트 세션이 없습니다. cmux가 마지막에 정상적으로 종료되었습니다. 그래도 복원하려면 --list에서 확인한 --session <id>를 전달하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントセッションは復元されませんでした。cmux は前回正常に終了しています。それでも復元する場合は、--list の --session <id> を指定してください。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nijedna agent sesija nije vraćena: cmux je posljednji put zatvoren normalno. Za povrat svejedno, proslijedi --session <id> iz --list."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen agentsessioner gendannet: cmux stoppede normalt sidst. For at gendanne én alligevel, angiv --session <id> fra --list."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessuna sessione agente ripristinata: cmux è terminato normalmente. Per ripristinarne comunque una, passare --session <id> da --list."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្មាន agent session ណាត្រូវបានស្តារ: cmux បញ្ឈប់ដំណើរការធម្មតាចុងក្រោយ។ ដើម្បីស្តារ session ណាមួយ សូមបញ្ជូន --session <id> ពី --list។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen agentøkter gjenopprettet: cmux avsluttet normalt sist. For å gjenopprette én likevel, bruk --session <id> fra --list."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie przywrócono żadnych sesji agenta: cmux ostatnio zakończył pracę normalnie. Aby mimo to przywrócić sesję, podaj --session <id> z --list."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhuma sessão de agente restaurada: o cmux encerrou normalmente. Para restaurar mesmo assim, passe --session <id> a partir de --list."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сессии агента не восстановлены: cmux завершился нормально. Чтобы восстановить всё равно, передайте --session <id> из --list."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่มี agent session ที่กู้คืน: cmux ออกตามปกติครั้งล่าสุด หากต้องการกู้คืนให้ใช้ --session <id> จาก --list"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hiçbir ajan oturumu geri yüklenmedi: cmux en son normal şekilde kapatıldı. Yine de geri yüklemek için --list'ten --session <id> geçirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сесії агентів не відновлено: cmux завершив роботу в штатному режимі. Щоб відновити примусово, передайте --session <id> зі списку --list."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không có phiên agent nào được khôi phục: cmux thoát bình thường lần trước. Để khôi phục dù vậy, truyền --session <id> từ --list."
          }
        }
      }
    },
