    "cli.help.ssh.initialCommand": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأمر الأولي:\n  --command <text>        شغّل نص الأمر مرة واحدة في الطرفية البعيدة الأولية بعد بدء الصدفة\n\nمثال:\n  cmux ssh dev@my-host --command 'omp \"investigate auth\"'"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Početna naredba:\n  --command <text>        Pokrenite tekst naredbe jednom u početnom udaljenom terminalu nakon pokretanja ljuske\n\nPrimjer:\n  cmux ssh dev@my-host --command 'omp \"investigate auth\"'"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indledende kommando:\n  --command <text>        Kør kommandoteksten én gang i den første fjernterminal efter shell-start\n\nEksempel:\n  cmux ssh dev@my-host --command 'omp \"investigate auth\"'"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Initialer Befehl:\n  --command <text>        Befehlstext nach dem Shell-Start einmal im ersten Remote-Terminal ausführen\n\nBeispiel:\n  cmux ssh dev@my-host --command 'omp \"investigate auth\"'"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Initial command:\n  --command <text>        Run text once in the initial remote terminal after shell startup\n\nExample:\n  cmux ssh dev@my-host --command 'omp \"investigate auth\"'"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comando inicial:\n  --command <text>        Ejecutar el texto del comando una vez en el terminal remoto inicial después de iniciar el shell\n\nEjemplo:\n  cmux ssh dev@my-host --command 'omp \"investigate auth\"'"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commande initiale :\n  --command <text>        Exécuter le texte de la commande une seule fois dans le terminal distant initial après le démarrage du shell\n\nExemple :\n  cmux ssh dev@my-host --command 'omp \"investigate auth\"'"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Comando iniziale:\n  --command <text>        Esegui il testo del comando una volta nel terminale remoto iniziale dopo l'avvio della shell\n\nEsempio:\n  cmux ssh dev@my-host --command 'omp \"investigate auth\"'"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期コマンド:\n  --command <text>        シェル起動後、最初のリモートターミナルでテキストを一度だけ実行\n\n例:\n  cmux ssh dev@my-host --command 'omp \"investigate auth\"'"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពាក្យបញ្ជាដំបូង៖\n  --command <text>        ដំណើរការអត្ថបទពាក្យបញ្ជាម្តងនៅក្នុងស្ថានីយពីចម្ងាយដំបូង បន្ទាប់ពី shell ចាប់ផ្តើម\n\nឧទាហរណ៍៖\n  cmux ssh dev@my-host --command 'omp \"investigate auth\"'"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초기 명령:\n  --command <text>        셸 시작 후 첫 원격 터미널에서 명령 텍스트를 한 번만 실행\n\n예:\n  cmux ssh dev@my-host --command 'omp \"investigate auth\"'"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Første kommando:\n  --command <text>        Kjør kommandoteksten én gang i den første eksterne terminalen etter skalloppstart\n\nEksempel:\n  cmux ssh dev@my-host --command 'omp \"investigate auth\"'"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polecenie początkowe:\n  --command <text>        Uruchom tekst polecenia jeden raz w początkowym zdalnym terminalu po starcie powłoki\n\nPrzykład:\n  cmux ssh dev@my-host --command 'omp \"investigate auth\"'"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comando inicial:\n  --command <text>        Execute o texto do comando uma vez no terminal remoto inicial após iniciar o shell\n\nExemplo:\n  cmux ssh dev@my-host --command 'omp \"investigate auth\"'"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начальная команда:\n  --command <text>        Выполнить текст команды один раз в исходном удалённом терминале после запуска оболочки\n\nПример:\n  cmux ssh dev@my-host --command 'omp \"investigate auth\"'"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำสั่งเริ่มต้น:\n  --command <text>        เรียกใช้ข้อความคำสั่งหนึ่งครั้งในเทอร์มินัลระยะไกลเริ่มต้นหลังจากเชลล์เริ่มทำงาน\n\nตัวอย่าง:\n  cmux ssh dev@my-host --command 'omp \"investigate auth\"'"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk komut:\n  --command <text>        Komut metnini kabuk başladıktan sonra ilk uzak terminalde bir kez çalıştırın\n\nÖrnek:\n  cmux ssh dev@my-host --command 'omp \"investigate auth\"'"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Початкова команда:\n  --command <text>        Виконати текст команди один раз у початковому віддаленому терміналі після запуску оболонки\n\nПриклад:\n  cmux ssh dev@my-host --command 'omp \"investigate auth\"'"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "初始命令：\n  --command <text>        在 shell 启动后于初始远程终端中运行一次命令文本\n\n示例：\n  cmux ssh dev@my-host --command 'omp \"investigate auth\"'"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "初始命令：\n  --command <text>        在 shell 啟動後於初始遠端終端機中執行一次命令文字\n\n範例：\n  cmux ssh dev@my-host --command 'omp \"investigate auth\"'"
          }
        }
      }
    },
    "cli.help.ssh.mosh": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقل طرفية Mosh:\n  --transport <ssh|mosh>  نقل الطرفية التفاعلية (الافتراضي: ssh)\n\nيدير SSH الميزات البعيدة، وينقل Mosh الطرفية التفاعلية فقط. إذا لم يتوفر Mosh محليًا أو عن بُعد، يوضّح cmux ذلك ويستخدم SSH.\n\nمثال:\n  cmux ssh dev@my-host --transport mosh"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosh transport terminala:\n  --transport <ssh|mosh>  Transport interaktivnog terminala (zadano: ssh)\n\nSSH upravlja udaljenim funkcijama, a Mosh prenosi samo terminal. Ako Mosh nedostaje lokalno ili udaljeno, cmux to prijavljuje i koristi SSH.\n\nPrimjer:\n  cmux ssh dev@my-host --transport mosh"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosh-terminaltransport:\n  --transport <ssh|mosh>  Interaktiv terminaltransport (standard: ssh)\n\nSSH håndterer fjernfunktioner, og Mosh bærer kun terminalen. Hvis Mosh mangler lokalt eller på fjernværten, oplyser cmux det og bruger SSH.\n\nEksempel:\n  cmux ssh dev@my-host --transport mosh"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosh-Terminaltransport:\n  --transport <ssh|mosh>  Interaktiver Terminaltransport (Standard: ssh)\n\nSSH verwaltet Remote-Funktionen, Mosh überträgt nur das Terminal. Fehlt Mosh lokal oder remote, meldet cmux dies und verwendet SSH.\n\nBeispiel:\n  cmux ssh dev@my-host --transport mosh"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosh terminal transport:\n  --transport <ssh|mosh>  Interactive terminal transport (default: ssh)\n\nSSH continues to handle remote features; Mosh carries only the interactive\nterminal. If Mosh is missing locally or remotely, cmux reports it and uses SSH.\n\nExample:\n  cmux ssh dev@my-host --transport mosh"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transporte de terminal Mosh:\n  --transport <ssh|mosh>  Transporte del terminal interactivo (predeterminado: ssh)\n\nSSH gestiona las funciones remotas y Mosh solo transporta el terminal. Si falta Mosh localmente o en remoto, cmux lo indica y usa SSH.\n\nEjemplo:\n  cmux ssh dev@my-host --transport mosh"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transport de terminal Mosh :\n  --transport <ssh|mosh>  Transport du terminal interactif (par défaut : ssh)\n\nSSH gère les fonctions distantes et Mosh transporte seulement le terminal. Si Mosh manque en local ou à distance, cmux le signale et utilise SSH.\n\nExemple :\n  cmux ssh dev@my-host --transport mosh"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasporto terminale Mosh:\n  --transport <ssh|mosh>  Trasporto del terminale interattivo (predefinito: ssh)\n\nSSH gestisce le funzioni remote e Mosh trasporta solo il terminale. Se Mosh manca in locale o in remoto, cmux lo segnala e usa SSH.\n\nEsempio:\n  cmux ssh dev@my-host --transport mosh"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosh ターミナルトランスポート:\n  --transport <ssh|mosh>  対話型ターミナルのトランスポート（デフォルト: ssh）\n\nリモート機能は SSH が管理し、Mosh は対話型ターミナルだけを運びます。ローカルまたはリモートに Mosh がない場合、cmux はその旨を表示して SSH を使用します。\n\n例:\n  cmux ssh dev@my-host --transport mosh"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មធ្យោបាយស្ថានីយ Mosh៖\n  --transport <ssh|mosh>  មធ្យោបាយស្ថានីយអន្តរកម្ម (លំនាំដើម៖ ssh)\n\nSSH គ្រប់គ្រងមុខងារពីចម្ងាយ ហើយ Mosh ដឹកតែស្ថានីយ។ បើខ្វះ Mosh cmux នឹងជូនដំណឹង ហើយប្រើ SSH។\n\nឧទាហរណ៍៖\n  cmux ssh dev@my-host --transport mosh"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosh 터미널 전송 방식:\n  --transport <ssh|mosh>  대화형 터미널 전송 방식(기본값: ssh)\n\n원격 기능은 SSH가 관리하고 Mosh는 터미널만 전송합니다. 로컬 또는 원격에 Mosh가 없으면 cmux가 알리고 SSH를 사용합니다.\n\n예:\n  cmux ssh dev@my-host --transport mosh"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosh-terminaltransport:\n  --transport <ssh|mosh>  Interaktiv terminaltransport (standard: ssh)\n\nSSH håndterer eksterne funksjoner, og Mosh bærer bare terminalen. Hvis Mosh mangler lokalt eller eksternt, sier cmux fra og bruker SSH.\n\nEksempel:\n  cmux ssh dev@my-host --transport mosh"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transport terminala Mosh:\n  --transport <ssh|mosh>  Transport terminala interaktywnego (domyślnie: ssh)\n\nSSH obsługuje funkcje zdalne, a Mosh tylko terminal. Jeśli brakuje Mosh lokalnie lub zdalnie, cmux informuje o tym i używa SSH.\n\nPrzykład:\n  cmux ssh dev@my-host --transport mosh"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transporte de terminal Mosh:\n  --transport <ssh|mosh>  Transporte do terminal interativo (padrão: ssh)\n\nO SSH gerencia os recursos remotos e o Mosh transporta apenas o terminal. Se faltar Mosh local ou remotamente, o cmux informa e usa SSH.\n\nExemplo:\n  cmux ssh dev@my-host --transport mosh"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транспорт терминала Mosh:\n  --transport <ssh|mosh>  Транспорт интерактивного терминала (по умолчанию: ssh)\n\nSSH управляет удалёнными функциями, а Mosh передаёт только терминал. Если Mosh отсутствует локально или удалённо, cmux сообщает об этом и использует SSH.\n\nПример:\n  cmux ssh dev@my-host --transport mosh"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การส่งเทอร์มินัล Mosh:\n  --transport <ssh|mosh>  การส่งเทอร์มินัลแบบโต้ตอบ (ค่าเริ่มต้น: ssh)\n\nSSH จัดการคุณสมบัติระยะไกล ส่วน Mosh ส่งเฉพาะเทอร์มินัล หากไม่มี Mosh cmux จะแจ้งและใช้ SSH\n\nตัวอย่าง:\n  cmux ssh dev@my-host --transport mosh"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosh terminal aktarımı:\n  --transport <ssh|mosh>  Etkileşimli terminal aktarımı (varsayılan: ssh)\n\nUzak özellikleri SSH yönetir, Mosh yalnızca terminali taşır. Mosh yerelde veya uzakta yoksa cmux bunu bildirir ve SSH kullanır.\n\nÖrnek:\n  cmux ssh dev@my-host --transport mosh"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транспорт термінала Mosh:\n  --transport <ssh|mosh>  Транспорт інтерактивного термінала (типово: ssh)\n\nSSH керує віддаленими функціями, а Mosh передає лише термінал. Якщо Mosh відсутній локально або віддалено, cmux повідомляє про це й використовує SSH.\n\nПриклад:\n  cmux ssh dev@my-host --transport mosh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosh 终端传输：\n  --transport <ssh|mosh>  交互式终端传输方式（默认：ssh）\n\nSSH 管理远程功能，Mosh 仅承载终端。如果本地或远程缺少 Mosh，cmux 会说明原因并使用 SSH。\n\n示例：\n  cmux ssh dev@my-host --transport mosh"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosh 終端傳輸：\n  --transport <ssh|mosh>  互動式終端傳輸方式（預設：ssh）\n\nSSH 管理遠端功能，Mosh 只承載終端。如果本機或遠端缺少 Mosh，cmux 會說明原因並使用 SSH。\n\n範例：\n  cmux ssh dev@my-host --transport mosh"
          }
        }
      }
    },
