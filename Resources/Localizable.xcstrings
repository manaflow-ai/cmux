        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បង្ហាញការប្រើប្រាស់ CLI កម្រិតខ្ពស់ ឬក្រុមពាក្យបញ្ជាតែមួយដែលផ្តោតលើភារកិច្ច។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
