    "detectedSSH.fileDrop.error.notFileURL": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر رفع العنصر الذي تم إفلاته لأنه ليس ملفًا محليًا. أفلت ملفًا من Finder، ثم حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće otpremiti ispuštenu stavku jer nije lokalna datoteka. Ispustite datoteku iz Findera, pa pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det emne, du slap, kunne ikke uploades, fordi det ikke er en lokal fil. Træk en fil fra Finder, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das abgelegte Objekt konnte nicht hochgeladen werden, weil es keine lokale Datei ist. Ziehe eine Datei aus dem Finder hinein und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't upload the dropped item because it isn't a local file. Drop a file from Finder, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo subir el elemento soltado porque no es un archivo local. Suelta un archivo desde Finder e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de téléverser l’élément déposé, car ce n’est pas un fichier local. Déposez un fichier depuis le Finder, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare l’elemento rilasciato perché non è un file locale. Rilascia un file dal Finder e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドロップされた項目はローカルファイルではないためアップロードできません。Finder からファイルをドロップして、もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចផ្ទុកឡើងធាតុដែលបានទម្លាក់បានទេ ព្រោះវាមិនមែនជាឯកសារមូលដ្ឋាន។ សូមទម្លាក់ឯកសារពី Finder ហើយព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드롭한 항목이 로컬 파일이 아니어서 업로드할 수 없습니다. Finder에서 파일을 드롭한 다음 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke laste opp elementet som ble sluppet, fordi det ikke er en lokal fil. Slipp en fil fra Finder, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można przesłać upuszczonego elementu, ponieważ nie jest plikiem lokalnym. Upuść plik z Findera i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível enviar o item solto porque ele não é um arquivo local. Solte um arquivo do Finder e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить перетащенный объект, потому что это не локальный файл. Перетащите файл из Finder и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถอัปโหลดรายการที่วางได้เพราะไม่ใช่ไฟล์ในเครื่อง ให้วางไฟล์จาก Finder แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bırakılan öğe yerel bir dosya olmadığı için yüklenemedi. Finder’dan bir dosya bırakıp yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити скинутий елемент, бо це не локальний файл. Перетягніть файл із Finder і повторіть спробу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法上传拖放的项目，因为它不是本地文件。请从 Finder 拖放一个文件，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法上傳拖放的項目，因為它不是本機檔案。請從 Finder 拖放檔案，然後再試一次。"
          }
        }
      }
    },
    "detectedSSH.fileDrop.error.scpTimedOut": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت مهلة نقل الملف. تحقق من المضيف البعيد واتصال الشبكة، ثم حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijenos datoteke je istekao. Provjerite udaljeni host i mrežnu vezu, pa pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filoverførslen fik timeout. Kontrollér fjernværten og netværksforbindelsen, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateiübertragung hat das Zeitlimit überschritten. Prüfe den Remote-Host und die Netzwerkverbindung und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File transfer timed out. Check the remote host and network connection, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia del archivo agotó el tiempo de espera. Comprueba el host remoto y la conexión de red e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transfert du fichier a expiré. Vérifiez l’hôte distant et la connexion réseau, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il trasferimento del file è scaduto. Verifica l’host remoto e la connessione di rete, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル転送がタイムアウトしました。リモートホストとネットワーク接続を確認して、もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការផ្ទេរឯកសារអស់ពេលកំណត់។ សូមពិនិត្យម៉ាស៊ីនពីចម្ងាយ និងការតភ្ជាប់បណ្តាញ ហើយព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 전송 시간이 초과되었습니다. 원격 호스트와 네트워크 연결을 확인한 다음 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filoverføringen tidsavbrøt. Kontroller den eksterne verten og nettverkstilkoblingen, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upłynął limit czasu transferu pliku. Sprawdź host zdalny i połączenie sieciowe, a następnie spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência do arquivo expirou. Verifique o host remoto e a conexão de rede e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время передачи файла истекло. Проверьте удалённый хост и сетевое подключение, затем повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การถ่ายโอนไฟล์หมดเวลา ตรวจสอบโฮสต์ระยะไกลและการเชื่อมต่อเครือข่าย แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya aktarımı zaman aşımına uğradı. Uzak ana makineyi ve ağ bağlantısını kontrol edip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час передавання файлу минув. Перевірте віддалений хост і мережеве з’єднання, а потім повторіть спробу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件传输超时。请检查远程主机和网络连接，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案傳輸逾時。請檢查遠端主機和網路連線，然後再試一次。"
          }
        }
      }
    },
    "detectedSSH.fileDrop.error.uploadFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر رفع الملف إلى الجلسة البعيدة. تحقق من أن المضيف البعيد قابل للوصول، ثم حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteku nije moguće otpremiti u udaljenu sesiju. Provjerite da li je udaljeni host dostupan, pa pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen kunne ikke uploades til den eksterne session. Kontrollér, at fjernværten kan nås, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei konnte nicht in die Remote-Sitzung hochgeladen werden. Prüfe, ob der Remote-Host erreichbar ist, und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't upload the file to the remote session. Check that the remote host is reachable, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo subir el archivo a la sesión remota. Comprueba que el host remoto esté accesible e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de téléverser le fichier vers la session distante. Vérifiez que l’hôte distant est joignable, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare il file nella sessione remota. Verifica che l’host remoto sia raggiungibile e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートセッションへファイルをアップロードできませんでした。リモートホストに到達できることを確認して、もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចផ្ទុកឡើងឯកសារទៅសម័យពីចម្ងាយបានទេ។ សូមពិនិត្យថាម៉ាស៊ីនពីចម្ងាយអាចចូលដំណើរការបាន ហើយព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 세션에 파일을 업로드할 수 없습니다. 원격 호스트에 연결할 수 있는지 확인한 다음 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke laste opp filen til den eksterne økten. Kontroller at den eksterne verten er tilgjengelig, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można przesłać pliku do sesji zdalnej. Sprawdź, czy host zdalny jest osiągalny, i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível enviar o arquivo para a sessão remota. Verifique se o host remoto está acessível e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить файл в удалённый сеанс. Проверьте доступность удалённого хоста и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถอัปโหลดไฟล์ไปยังเซสชันระยะไกลได้ ตรวจสอบว่าโฮสต์ระยะไกลเข้าถึงได้ แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya uzak oturuma yüklenemedi. Uzak ana makinenin erişilebilir olduğunu kontrol edip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити файл у віддалений сеанс. Перевірте доступність віддаленого хоста й повторіть спробу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将文件上传到远程会话。请检查远程主机是否可访问，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法將檔案上傳到遠端工作階段。請確認遠端主機可連線，然後再試一次。"
          }
        }
      }
    },
    "dialog.closeAnchor.message.lone": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إغلاق مساحة العمل هذه سيحذف المجموعة «%@»."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatvaranje ovog radnog prostora ukloniti će grupu „%@“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du lukker dette arbejdsområde, fjernes gruppen “%@”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du diesen Arbeitsbereich schließt, wird die Gruppe „%@“ entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing this workspace will remove the group “%@”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar este espacio de trabajo eliminará el grupo «%@»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer cet espace de travail supprimera le groupe « %@ »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudere quest’area di lavoro rimuoverà il gruppo «%@»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースを閉じるとグループ「%@」が削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업 공간을 닫으면 그룹 “%@”이(가) 삭제됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du lukker dette arbeidsområdet, fjernes gruppen «%@»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknięcie tej przestrzeni usunie grupę „%@”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar esta área de trabalho removerá o grupo “%@”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрытие этого рабочего пространства удалит группу «%@»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การปิดเวิร์กสเปซนี้จะลบกลุ่ม “%@”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çalışma alanını kapatmak “%@” grubunu kaldıracak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закриття цієї робочої області видалить групу «%@»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭此工作区将删除分组「%@」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉此工作區將移除群組「%@」。"
          }
        }
      }
    },
    "dialog.closeAnchor.message.many": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إغلاق مساحة العمل هذه سيُلغي تجميع «%1$@» وسيُحرّر %2$lld مساحات عمل أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatvaranje ovog radnog prostora razgrupisaće „%1$@“ i osloboditi %2$lld drugih radnih prostora."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du lukker dette arbejdsområde, opdeles “%1$@” og %2$lld andre arbejdsområder frigives."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du diesen Arbeitsbereich schließt, wird die Gruppe „%1$@“ aufgelöst und %2$lld weitere Arbeitsbereiche werden freigegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing this workspace will ungroup “%1$@” and release %2$lld other workspaces."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar este espacio de trabajo desagrupará «%1$@» y liberará %2$lld espacios de trabajo más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer cet espace de travail dissociera « %1$@ » et libérera %2$lld autres espaces de travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudere quest’area di lavoro dividerà «%1$@» e libererà altre %2$lld aree di lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースを閉じるとグループ「%1$@」が解除され、他の %2$lld 個のワークスペースが切り離されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업 공간을 닫으면 그룹 “%1$@”이(가) 해제되고 다른 작업 공간 %2$lld개가 분리됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du lukker dette arbeidsområdet, oppløses «%1$@» og %2$lld andre arbeidsområder frigjøres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknięcie tej przestrzeni rozgrupuje „%1$@” i uwolni %2$lld innych przestrzeni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar esta área de trabalho desagrupará “%1$@” e liberará outras %2$lld áreas de trabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрытие этого рабочего пространства разгруппирует «%1$@» и освободит ещё %2$lld рабочих пространств."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การปิดเวิร์กสเปซนี้จะเลิกจัดกลุ่ม “%1$@” และปล่อยอีก %2$lld เวิร์กสเปซ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çalışma alanını kapatmak “%1$@” grubunu çözer ve %2$lld başka çalışma alanını serbest bırakır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закриття цієї робочої області розгрупує «%1$@» та звільнить ще %2$lld робочих областей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭此工作区将解散分组「%1$@」并释放另外 %2$lld 个工作区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉此工作區將解散群組「%1$@」並釋出另外 %2$lld 個工作區。"
          }
        }
      }
    },
    "dialog.closeAnchor.message.one": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إغلاق مساحة العمل هذه سيُلغي تجميع «%@» وسيُحرّر مساحة عمل أخرى واحدة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatvaranje ovog radnog prostora razgrupisaće „%@“ i osloboditi 1 drugi radni prostor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du lukker dette arbejdsområde, opdeles “%@” og 1 andet arbejdsområde frigives."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du diesen Arbeitsbereich schließt, wird die Gruppe „%@“ aufgelöst und 1 weiterer Arbeitsbereich freigegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing this workspace will ungroup “%@” and release 1 other workspace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar este espacio de trabajo desagrupará «%@» y liberará 1 espacio de trabajo más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer cet espace de travail dissociera « %@ » et libérera 1 autre espace de travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudere quest’area di lavoro dividerà «%@» e libererà 1 altra area di lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースを閉じるとグループ「%@」が解除され、他のワークスペース 1 個が切り離されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업 공간을 닫으면 그룹 “%@”이(가) 해제되고 다른 작업 공간 1개가 분리됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du lukker dette arbeidsområdet, oppløses «%@» og 1 annet arbeidsområde frigjøres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknięcie tej przestrzeni rozgrupuje „%@” i uwolni 1 inną przestrzeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar esta área de trabalho desagrupará “%@” e liberará 1 outra área de trabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрытие этого рабочего пространства разгруппирует «%@» и освободит 1 другое рабочее пространство."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การปิดเวิร์กสเปซนี้จะเลิกจัดกลุ่ม “%@” และปล่อยอีก 1 เวิร์กสเปซ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çalışma alanını kapatmak “%@” grubunu çözer ve 1 başka çalışma alanını serbest bırakır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закриття цієї робочої області розгрупує «%@» та звільнить ще 1 робочу область."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭此工作区将解散分组「%@」并释放另外 1 个工作区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉此工作區將解散群組「%@」並釋出另外 1 個工作區。"
          }
        }
      }
    },
    "dialog.closeAnchor.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد إغلاق مساحة العمل هذه؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatvoriti ovaj radni prostor?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Luk dette arbejdsområde?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Arbeitsbereich schließen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close this workspace?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cerrar este espacio de trabajo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer cet espace de travail ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudere quest’area di lavoro?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースを閉じますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업 공간을 닫을까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukke dette arbeidsområdet?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknąć tę przestrzeń?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar esta área de trabalho?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть это рабочее пространство?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดเวิร์กสเปซนี้ใช่ไหม?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çalışma alanı kapatılsın mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрити цю робочу область?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭此工作区？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉此工作區？"
          }
        }
      }
    },
    "dialog.closeLastTabWindow.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى إغلاق آخر لسان وإغلاق النافذة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo će zatvoriti posljednji tab i zatvoriti prozor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette lukker den sidste fane og lukker vinduet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der letzte Tab geschlossen und das Fenster geschlossen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will close the last tab and close the window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto cerrará la última pestaña y cerrará la ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela fermera le dernier onglet et fermera la fenêtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione chiuderà l'ultima scheda e la finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後のタブを閉じ、ウインドウを閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 탭이 닫히면 윈도우도 닫힙니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil lukke den siste fanen og lukke vinduet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to zamknięcie ostatniej karty i zamknięcie okna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto fechará a última aba e fechará a janela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это закроет последнюю вкладку и окно."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะปิดแท็บสุดท้ายและปิดหน้าต่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, son sekmeyi kapatacak ve pencereyi kapatacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це закриє останню вкладку та закриє вікно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将关闭最后一个标签页并关闭窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將關閉最後一個標籤頁並關閉視窗。"
          }
        }
      }
    },
