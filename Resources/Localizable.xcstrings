          }
        }
      }
    },
    "featureFlags.appKitSidebarList.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renders the workspace sidebar with a native AppKit list and divider for smoother scrolling and resizing with many workspaces."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースサイドバーをネイティブの AppKit リストとディバイダーで描画し、多数のワークスペースでもスクロールとリサイズを滑らかにします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用原生 AppKit 列表和分隔线渲染工作区侧边栏，工作区较多时滚动和调整大小更流畅。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendert die Arbeitsbereich-Seitenleiste mit einer nativen AppKit-Liste und einem Trenner für flüssigeres Scrollen und Skalieren bei vielen Arbeitsbereichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Génère le rendu de la barre latérale de l’espace de travail avec une liste AppKit native et un séparateur pour un défilement et un redimensionnement plus fluides avec de nombreux espaces de travail."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُصيّر الشريط الجانبي لمساحة العمل باستخدام قائمة AppKit أصلية وفاصل لتمرير وتغيير حجم أكثر سلاسة مع وجود مساحات عمل متعددة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderiza la barra lateral del espacio de trabajo con una lista y divisor nativos de AppKit para un desplazamiento y cambio de tamaño más fluidos con muchos espacios de trabajo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用原生 AppKit 清單和分隔線來轉譯工作區側邊欄，以便在工作區眾多時能更流暢地捲動及調整大小。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 공간이 많을 때 더 부드러운 스크롤 및 크기 조절을 위해 네이티브 AppKit 목록 및 구분선으로 작업 공간 사이드바를 렌더링합니다."
          }
        }
      }
    },
