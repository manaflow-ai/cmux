    "socket.cloudVM.transportUnsupported.useExec": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use `cmux vm exec %1$@ -- <command>`; `cmux vm ssh %1$@` works where the provider offers SSH."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`cmux vm exec %1$@ -- <command>` を使用してください。プロバイダーが SSH に対応していれば `cmux vm ssh %1$@` も使えます。"
          }
