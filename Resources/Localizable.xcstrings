    "workspace.placement.end.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلحاق مساحات العمل الجديدة في أسفل القائمة."
          }
        },
        "bs": {
          "stringUnit": {
