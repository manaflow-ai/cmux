    "cli.events.help.timeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exit unsuccessfully if no matching event arrives before the deadline"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限までに一致するイベントが届かない場合はエラーで終了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제한 시간 전에 일치하는 이벤트가 도착하지 않으면 오류로 종료"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершити з помилкою, якщо відповідна подія не надійде до кінцевого терміну"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若在截止前没有匹配事件到达，则以失败退出"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlgeschlagen beenden, wenn vor Ablauf der Frist kein passendes Ereignis eintrifft"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitte en échec si aucun événement correspondant n’arrive avant l’échéance"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخروج غير الناجح في حال عدم وصول أي حدث مطابق قبل الموعد النهائي"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale de forma incorrecta si no llega ningún evento coincidente antes del tiempo límite"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果在截止時間前沒有相符事件到達，則結束並顯示失敗"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Izađi neuspješno ako nijedan odgovarajući događaj ne stigne prije roka"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Afslut med fejl, hvis ingen matchende hændelse ankommer inden fristen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esci con errore se nessun evento corrispondente arriva entro il termine"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បញ្ចប់ដោយមិនជោគជ័យបើគ្មាន event ដែលត្រូវគ្នាមកដល់មុនកំណត់"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avslutt mislykket hvis ingen samsvarende hendelse ankommer før tidsfristen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zakończ z błędem, jeśli żadne pasujące zdarzenie nie pojawi się przed upływem terminu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Encerra com falha se nenhum evento correspondente chegar antes do prazo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Завершить с ошибкой, если подходящее событие не поступит до дедлайна"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ออกด้วยสถานะผิดพลาดหากไม่มี event ที่ตรงกันก่อนกำหนดเวลา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Son tarihe kadar eşleşen olay gelmezse başarısız çık"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thoát không thành công nếu không có sự kiện phù hợp nào đến trước deadline"
          }
        }
      }
    },
    "cli.help.clearNotifications": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage: cmux clear-notifications [--workspace <id|ref|index>] [--surface <id|ref|index>] [--window <id|ref|index>]\n\nClear queued notifications, optionally scoped to a workspace and surface.\n\nFlags: --workspace <id|ref|index> --surface <id|ref|index> --window <id|ref|index>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使い方: cmux clear-notifications [--workspace <id|ref|index>] [--surface <id|ref|index>] [--window <id|ref|index>]\n\n通知を消去し、必要に応じてワークスペースとサーフェスで限定します。\n\nFlags: --workspace <id|ref|index> --surface <id|ref|index> --window <id|ref|index>"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستخدام: cmux clear-notifications [--workspace <id|ref|index>] [--surface <id|ref|index>] [--window <id|ref|index>]\n\nمسح الإشعارات الموجودة في قائمة الانتظار، مع إمكانية تحديد النطاق بمساحة عمل وسطح معينة.\n\nالخيارات: --workspace <id|ref|index> --surface <id|ref|index> --window <id|ref|index>"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Upotreba: cmux clear-notifications [--workspace <id|ref|index>] [--surface <id|ref|index>] [--window <id|ref|index>]\n\nOčisti stavljene obavijesti u red, opcionalno ograničeno na radni prostor i površinu.\n\nZastavice: --workspace <id|ref|index> --surface <id|ref|index> --window <id|ref|index>"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brug: cmux clear-notifications [--workspace <id|ref|index>] [--surface <id|ref|index>] [--window <id|ref|index>]\n\nRyd ventende notifikationer, valgfrit begrænset til et workspace og en surface.\n\nFlag: --workspace <id|ref|index> --surface <id|ref|index> --window <id|ref|index>"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendung: cmux clear-notifications [--workspace <id|ref|index>] [--surface <id|ref|index>] [--window <id|ref|index>]\n\nIn Warteschlange eingereihte Benachrichtigungen löschen, optional beschränkt auf einen Arbeitsbereich und eine Oberfläche.\n\nFlags: --workspace <id|ref|index> --surface <id|ref|index> --window <id|ref|index>"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso: cmux clear-notifications [--workspace <id|ref|index>] [--surface <id|ref|index>] [--window <id|ref|index>]\n\nLimpia las notificaciones en cola, opcionalmente limitadas a un espacio de trabajo y una superficie.\n\nOpciones: --workspace <id|ref|index> --surface <id|ref|index> --window <id|ref|index>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisation : cmux clear-notifications [--workspace <id|ref|index>] [--surface <id|ref|index>] [--window <id|ref|index>]\n\nEfface les notifications en attente, éventuellement limitées à un espace de travail et une surface d’affichage.\n\nOptions : --workspace <id|ref|index> --surface <id|ref|index> --window <id|ref|index>"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uso: cmux clear-notifications [--workspace <id|ref|index>] [--surface <id|ref|index>] [--window <id|ref|index>]\n\nCancella le notifiche in coda, opzionalmente limitate a un workspace e una surface.\n\nFlag: --workspace <id|ref|index> --surface <id|ref|index> --window <id|ref|index>"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការប្រើប្រាស់: cmux clear-notifications [--workspace <id|ref|index>] [--surface <id|ref|index>] [--window <id|ref|index>]\n\nលុបការជូនដំណឹងដែលតម្រៀប ដោយជ្រើសរើសសម្រាប់ workspace និង surface។\n\nទង់: --workspace <id|ref|index> --surface <id|ref|index> --window <id|ref|index>"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용법: cmux clear-notifications [--workspace <id|ref|index>] [--surface <id|ref|index>] [--window <id|ref|index>]\n\n대기 중인 알림을 지웁니다. 선택적으로 특정 작업 공간 및 화면으로 범위를 제한할 수 있습니다.\n\n플래그: --workspace <id|ref|index> --surface <id|ref|index> --window <id|ref|index>"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bruk: cmux clear-notifications [--workspace <id|ref|index>] [--surface <id|ref|index>] [--window <id|ref|index>]\n\nFjern varslinger i kø, eventuelt begrenset til et arbeidsområde og en overflate.\n\nFlagg: --workspace <id|ref|index> --surface <id|ref|index> --window <id|ref|index>"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usage: cmux clear-notifications [--workspace <id|ref|index>] [--surface <id|ref|index>] [--window <id|ref|index>]\n\nWyczyść kolejkę powiadomień, opcjonalnie ograniczoną do przestrzeni roboczej i powierzchni.\n\nFlagi: --workspace <id|ref|index> --surface <id|ref|index> --window <id|ref|index>"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uso: cmux clear-notifications [--workspace <id|ref|index>] [--surface <id|ref|index>] [--window <id|ref|index>]\n\nLimpa notificações enfileiradas, opcionalmente com escopo para um workspace e surface.\n\nFlags: --workspace <id|ref|index> --surface <id|ref|index> --window <id|ref|index>"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Использование: cmux clear-notifications [--workspace <id|ref|index>] [--surface <id|ref|index>] [--window <id|ref|index>]\n\nОчистить очередь уведомлений, опционально ограниченную рабочим пространством и поверхностью.\n\nФлаги: --workspace <id|ref|index> --surface <id|ref|index> --window <id|ref|index>"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usage: cmux clear-notifications [--workspace <id|ref|index>] [--surface <id|ref|index>] [--window <id|ref|index>]\n\nล้างการแจ้งเตือนที่รอดำเนินการ สามารถกำหนดขอบเขตให้กับ workspace และ surface ได้\n\nFlags: --workspace <id|ref|index> --surface <id|ref|index> --window <id|ref|index>"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kullanım: cmux clear-notifications [--workspace <id|ref|index>] [--surface <id|ref|index>] [--window <id|ref|index>]\n\nKuyruklanmış bildirimleri temizler; isteğe bağlı olarak çalışma alanı ve yüzeyle sınırlandırılabilir.\n\nBayraklar: --workspace <id|ref|index> --surface <id|ref|index> --window <id|ref|index>"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Використання: cmux clear-notifications [--workspace <id|ref|index>] [--surface <id|ref|index>] [--window <id|ref|index>]\n\nОчищення черги сповіщень, за потреби обмежене робочим простором і поверхнею.\n\nПрапорці: --workspace <id|ref|index> --surface <id|ref|index> --window <id|ref|index>"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用法: cmux clear-notifications [--workspace <id|ref|index>] [--surface <id|ref|index>] [--window <id|ref|index>]\n\n清除队列中的通知，可选择将作用域限制在工作区和表面。\n\n标志: --workspace <id|ref|index> --surface <id|ref|index> --window <id|ref|index>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用法：cmux clear-notifications [--workspace <id|ref|index>] [--surface <id|ref|index>] [--window <id|ref|index>]\n\n清除佇列中的通知，可選擇將範圍限制在特定的工作區 and 介面。\n\n旗標：--workspace <id|ref|index> --surface <id|ref|index> --window <id|ref|index>"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usage: cmux clear-notifications [--workspace <id|ref|index>] [--surface <id|ref|index>] [--window <id|ref|index>]\n\nXóa thông báo đang chờ, tùy chọn giới hạn theo workspace và surface.\n\nFlags: --workspace <id|ref|index> --surface <id|ref|index> --window <id|ref|index>"
          }
        }
      }
    },
    "cli.help.dismissNotification": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage: cmux dismiss-notification (--id <uuid> | --all-read)\n\nRemove one notification, or remove every already-read notification.\n\nFlags:\n  --id <uuid>           Notification id to remove\n  --all-read            Remove every already-read notification\n  --json                Print JSON\n  --id-format <mode>    refs, uuids, or both"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage: cmux dismiss-notification (--id <uuid> | --all-read)\n\n通知を1件削除するか、既読の通知をすべて削除します。\n\nFlags:\n  --id <uuid>           削除する通知 ID\n  --all-read            既読の通知をすべて削除\n  --json                JSON を出力\n  --id-format <mode>    refs、uuids、both のいずれか"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用法：cmux dismiss-notification (--id <uuid> | --all-read)\n\n移除一条通知，或移除所有已读通知。\n\n标志:\n  --id <uuid>           要移除的通知 id\n  --all-read            移除所有已读通知\n  --json                输出 JSON\n  --id-format <mode>    refs、uuids 或 both"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendung: cmux dismiss-notification (--id <uuid> | --all-read)\n\nEntfernt eine Benachrichtigung oder entfernt alle bereits gelesenen Benachrichtigungen.\n\nFlags:\n  --id <uuid>           Zu entfernende Benachrichtigungs-ID\n  --all-read            Alle bereits gelesenen Benachrichtigungen entfernen\n  --json                JSON ausgeben\n  --id-format <mode>    refs, uuids oder beides"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisation : cmux dismiss-notification (--id <uuid> | --all-read)\n\nSupprime une notification, ou supprime toutes les notifications déjà lues.\n\nOptions :\n  --id <uuid>           ID de la notification à supprimer\n  --all-read            Supprime toutes les notifications déjà lues\n  --json                Affiche le JSON\n  --id-format <mode>    refs, uuids ou both"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستخدام: cmux dismiss-notification (--id <uuid> | --all-read)\n\nإزالة إشعار واحد، أو إزالة كل الإشعارات المقروءة بالفعل.\n\nالخيارات:\n  --id <uuid>           معرف الإشعار المراد إزالته\n  --all-read            إزالة كل الإشعارات المقروءة بالفعل\n  --json                طباعة بتنسيق JSON\n  --id-format <mode>    refs، أو uuids، أو كلاهما"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso: cmux dismiss-notification (--id <uuid> | --all-read)\n\nElimina una notificación, o elimina todas las notificaciones ya leídas.\n\nOpciones:\n  --id <uuid>           Id de notificación a eliminar\n  --all-read            Elimina todas las notificaciones ya leídas\n  --json                Muestra JSON\n  --id-format <mode>    refs, uuids o ambos"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用法：cmux dismiss-notification (--id <uuid> | --all-read)\n\n移除單一通知，或移除所有已讀取的通知。\n\n旗標：\n  --id <uuid>           要移除的通知識別碼\n  --all-read            移除所有已讀取的通知\n  --json                列印 JSON\n  --id-format <mode>    refs、uuids 或兩者皆是"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용법: cmux dismiss-notification (--id <uuid> | --all-read)\n\n알림 하나를 제거하거나 이미 읽은 모든 알림을 제거합니다.\n\n플래그:\n  --id <uuid>           제거할 알림 ID\n  --all-read            이미 읽은 모든 알림 제거\n  --json                JSON 출력\n  --id-format <mode>    refs, uuids 또는 둘 다"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Upotreba: cmux dismiss-notification (--id <uuid> | --all-read)\n\nUkloni jednu obavijest ili ukloni sve već pročitane obavijesti.\n\nZastavice:\n  --id <uuid>           ID obavijesti za uklanjanje\n  --all-read            Ukloni sve već pročitane obavijesti\n  --json                Ispiši JSON\n  --id-format <mode>    refs, uuids ili both"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brug: cmux dismiss-notification (--id <uuid> | --all-read)\n\nFjern én notifikation, eller fjern alle allerede-læste notifikationer.\n\nFlag:\n  --id <uuid>           Notifikations-id, der skal fjernes\n  --all-read            Fjern alle allerede-læste notifikationer\n  --json                Udskriv JSON\n  --id-format <mode>    refs, uuids eller both"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uso: cmux dismiss-notification (--id <uuid> | --all-read)\n\nRimuovi una notifica o rimuovi tutte le notifiche già lette.\n\nFlag:\n  --id <uuid>           Id notifica da rimuovere\n  --all-read            Rimuovi tutte le notifiche già lette\n  --json                Stampa JSON\n  --id-format <mode>    refs, uuids o both"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការប្រើប្រាស់: cmux dismiss-notification (--id <uuid> | --all-read)\n\nលុបការជូនដំណឹងមួយ ឬលុបការជូនដំណឹងដែលបានអានទាំងអស់។\n\nទង់:\n  --id <uuid>           លេខសម្គាល់ការជូនដំណឹងដើម្បីលុប\n  --all-read            លុបការជូនដំណឹងដែលបានអានទាំងអស់\n  --json                បោះពុម្ព JSON\n  --id-format <mode>    refs, uuids, ឬទាំងពីរ"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bruk: cmux dismiss-notification (--id <uuid> | --all-read)\n\nFjern én varsling, eller fjern alle allerede leste varslinger.\n\nFlagg:\n  --id <uuid>           Varslings-id som skal fjernes\n  --all-read            Fjern alle allerede leste varslinger\n  --json                Skriv ut JSON\n  --id-format <mode>    refs, uuids eller both"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usage: cmux dismiss-notification (--id <uuid> | --all-read)\n\nUsuń jedno powiadomienie lub usuń wszystkie już przeczytane powiadomienia.\n\nFlagi:\n  --id <uuid>           ID powiadomienia do usunięcia\n  --all-read            Usuń wszystkie już przeczytane powiadomienia\n  --json                Wyświetl JSON\n  --id-format <mode>    refs, uuids lub both"
          }
        },
        "pt-BR": {
