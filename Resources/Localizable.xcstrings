    "cli.error.sshSessionAttachSessionNotFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: no persisted SSH PTY session with id '%@'. Run 'cmux ssh-session-list --all-workspaces' to see valid session ids."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: ID '%@' の永続 SSH PTY セッションが見つかりません。有効なセッション ID を確認するには 'cmux ssh-session-list --all-workspaces' を実行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: 没有 id 为 '%@' 的持久化 SSH PTY 会话。运行 'cmux ssh-session-list --all-workspaces' 查看有效的会话 id。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: Keine persistierte SSH-PTY-Sitzung mit der ID „%@“. Führe 'cmux ssh-session-list --all-workspaces' aus, um gültige Sitzungs-IDs anzuzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach : aucune session SSH PTY persistante avec l'id '%@'. Exécutez 'cmux ssh-session-list --all-workspaces' pour voir les identifiants de session valides."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: لا توجد جلسة SSH PTY محفوظة بالمعرف '%@'. قم بتشغيل 'cmux ssh-session-list --all-workspaces' لعرض معرفات الجلسات الصالحة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: no existe ninguna sesión SSH PTY persistida con el id '%@'. Ejecuta 'cmux ssh-session-list --all-workspaces' para ver los id de sesión válidos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach：沒有識別碼為 '%@' 的持續性 SSH PTY 工作階段。執行 'cmux ssh-session-list --all-workspaces' 以查看有效的工作階段識別碼。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: ID가 '%@'인 영구 SSH PTY 세션이 없습니다. 유효한 세션 ID 목록을 보려면 'cmux ssh-session-list --all-workspaces'를 실행하세요."
          }
        }
      }
    },
    "cli.error.sshSessionAttachStateUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: persisted SSH PTY session state is unavailable. Run 'cmux ssh-session-list --all-workspaces' and retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: 永続 SSH PTY セッションの状態を利用できません。'cmux ssh-session-list --all-workspaces' を実行してから再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: 持久化 SSH PTY 会话状态不可用。请运行 'cmux ssh-session-list --all-workspaces' 后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: Der Zustand der persistenten SSH-PTY-Sitzung ist nicht verfügbar. Führen Sie 'cmux ssh-session-list --all-workspaces' aus und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach : l'état de la session PTY SSH persistante est indisponible. Exécutez 'cmux ssh-session-list --all-workspaces' et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: حالة جلسة SSH PTY المحفوظة غير متوفرة. قم بتشغيل 'cmux ssh-session-list --all-workspaces' وأعد المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: el estado de la sesión SSH PTY persistida no está disponible. Ejecuta 'cmux ssh-session-list --all-workspaces' y vuelve a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach：持續性 SSH PTY 工作階段狀態不可用。請執行 'cmux ssh-session-list --all-workspaces' 後重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: 영구 SSH PTY 세션 상태를 사용할 수 없습니다. 'cmux ssh-session-list --all-workspaces'를 실행한 후 다시 시도하십시오."
          }
        }
      }
    },
    "cli.error.sshSessionAttachWorkspaceAmbiguous": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: session '%1$@' exists in multiple workspaces (%2$@). Pass --workspace <workspace> to choose one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: セッション '%1$@' は複数のワークスペース (%2$@) に存在します。--workspace <workspace> で指定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: 会话 '%1$@' 存在于多个工作区（%2$@）。请传入 --workspace <workspace> 指定其中一个。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: Sitzung „%1$@“ existiert in mehreren Arbeitsbereichen (%2$@). Übergib --workspace <workspace>, um einen auszuwählen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach : la session '%1$@' existe dans plusieurs espaces de travail (%2$@). Passez --workspace <workspace> pour en choisir un."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: الجلسة '%1$@' موجودة في مساحات عمل متعددة (%2$@). مرر --workspace <workspace> لاختيار واحدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: la sesión '%1$@' existe en múltiples espacios de trabajo (%2$@). Pasa --workspace <workspace> para elegir uno."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach：工作階段 '%1$@' 存在於多個工作區 (%2$@) 中。請傳遞 --workspace <workspace> 來選擇一個。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: 세션 '%1$@'이(가) 여러 작업 공간(%2$@)에 존재합니다. 하나를 선택하려면 --workspace <workspace>를 전달하세요."
          }
        }
      }
    },
    "cli.error.sshSessionAttachWorkspaceMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: session '%1$@' belongs to workspace %2$@, but --workspace requested a different workspace"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: セッション '%1$@' はワークスペース %2$@ に属していますが、--workspace では別のワークスペースが指定されました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: 会话 '%1$@' 属于工作区 %2$@，但 --workspace 请求的是另一个工作区"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: Sitzung „%1$@“ gehört zum Arbeitsbereich %2$@, aber --workspace hat einen anderen Arbeitsbereich angefordert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach : la session '%1$@' appartient à l'espace de travail %2$@, mais --workspace a demandé un espace de travail différent"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: الجلسة '%1$@' تنتمي إلى مساحة عمل %2$@، ولكن الخيار --workspace طلب مساحة عمل مختلفة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: la sesión '%1$@' pertenece al espacio de trabajo %2$@, pero --workspace solicitó un espacio de trabajo diferente"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach：工作階段 '%1$@' 屬於工作區 %2$@，但 --workspace 請求了不同的工作區"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh-session-attach: 세션 '%1$@'은(는) 작업 공간 %2$@에 속해 있으나, --workspace가 다른 작업 공간을 요청했습니다."
          }
        }
      }
    },
