    "surfaceResumeApproval.proposal.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A process wants cmux to keep this resume command for the current terminal:\n\nWorking directory: %@\n\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロセスが現在のターミナルにこの復元コマンドを保持しようとしています:\n\n作業ディレクトリ: %@\n\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有进程希望 cmux 为当前终端保留此恢复命令：\n\n工作目录：%@\n\n%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Prozess möchte, dass cmux diesen Fortsetzungsbefehl für das aktuelle Terminal behält:\n\nArbeitsverzeichnis: %@\n\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un processus souhaite que cmux conserve cette commande de reprise pour le terminal actuel :\n\nDossier de travail : %@\n\n%@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تريد إحدى العمليات من cmux الاحتفاظ بأمر الاستئناف هذا للطرفية الحالية:\n\nمجلد العمل: %@\n\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un proceso requiere que cmux conserve este comando de reanudación para la terminal actual:\n\nDirectorio de trabajo: %@\n\n%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有個程序希望 cmux 為目前的終端機保留此恢復指令：\n\n工作目錄：%@\n\n%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로세스가 cmux에서 현재 터미널에 대한 이 재개 명령을 유지하기를 요청합니다:\n\n작업 디렉터리: %@\n\n%@"
          }
        }
      }
    },
