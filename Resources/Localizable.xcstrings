    "simulator.camera.experimentalHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera injection uses private Simulator interfaces and may stop working after an Xcode update."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ注入は非公開のSimulatorインターフェイスを使用するため、Xcodeの更新後に動作しなくなる場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头注入使用模拟器的私有接口，Xcode 更新后可能失效。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera-Einspeisung verwendet private Simulator-Schnittstellen und funktioniert nach einem Xcode-Update möglicherweise nicht mehr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’injection d’appareil photo utilise des interfaces privées du Simulator et peut cesser de fonctionner après une mise à jour de Xcode."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم حقن الكاميرا واجهات Simulator الخاصة وقد يتوقف عن العمل بعد تحديث Xcode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La inyección de cámara utiliza interfaces privadas del simulador y puede dejar de funcionar después de una actualización de Xcode."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機插入功能使用的是私有的模擬器介面，在 Xcode 更新後可能會停止運作。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 주입은 비공개 Simulator 인터페이스를 사용하므로 Xcode 업데이트 후에 작동이 중단될 수 있습니다."
          }
        }
      }
    },
