      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser tabs, terminal link clicks, and intercepted open commands are disabled. Links open in your default browser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザタブ、ターミナルのリンククリック、インターセプトされたopenコマンドは無効です。リンクはデフォルトブラウザで開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器标签页、终端链接点击和拦截的 open 命令均已禁用。链接会在默认浏览器中打开。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser-Tabs, Klicks auf Terminal-Links und abgefangene Befehle zum Öffnen sind deaktiviert. Links werden in Ihrem Standard-Browser geöffnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets de navigateur, les clics sur les liens du terminal et les commandes open interceptées sont désactivés. Les liens s’ouvrent dans votre navigateur par défaut."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تعطيل علامات تبويب المتصفح، ونقرات روابط الطرفية، وأوامر الفتح التي تم اعتراضها. تُفتح الروابط في متصفحك الافتراضي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas del navegador, los clics en enlaces de la terminal y los comandos de apertura interceptados están desactivados. Los enlaces se abren en su navegador predeterminado."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽器標籤頁、終端機連結點擊以及攔截的開啟命令均已停用。連結將在您的預設瀏覽器中開啟。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 탭, 터미널 링크 클릭 및 가로채기된 open 명령이 비활성화됩니다. 링크는 기본 브라우저에서 열립니다."
          }
        }
      }
    },
    "settings.browser.enabled.subtitleOn": {
