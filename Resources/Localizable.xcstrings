    "cli.hooks.campfire.error.notCmuxExtension": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ موجود وليس امتداد cmux؛ سيتم تركه كما هو"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ postoji i nije cmux ekstenzija; ostavljam ga netaknutim"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ findes og er ikke en cmux-udvidelse; lader den være"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existiert und ist keine cmux-Erweiterung; wird unverändert belassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ exists and is not a cmux extension; leaving it alone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existe y no es una extensión de cmux; se dejará intacto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existe et n’est pas une extension cmux ; aucun changement n’y sera apporté"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ esiste e non è un'estensione cmux; verrà lasciato invariato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は存在しますが cmux 拡張ではありません。そのままにします"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ មានរួចហើយ ហើយមិនមែនជា​ផ្នែកបន្ថែម cmux ទេ; ទុកវាដូចដើម"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 존재하지만 cmux 확장이 아니므로 그대로 둡니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ finnes og er ikke en cmux-utvidelse; lar den være i fred"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ istnieje i nie jest rozszerzeniem cmux; pozostawiam bez zmian"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existe e não é uma extensão do cmux; será deixado como está"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ существует и не является расширением cmux; оставляем без изменений"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ มีอยู่แล้วและไม่ใช่ส่วนขยาย cmux; จะปล่อยไว้ตามเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mevcut ve bir cmux uzantısı değil; olduğu gibi bırakılıyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ існує і не є розширенням cmux; залишаємо без змін"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已存在且不是 cmux 扩展；将保持不变"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已存在且不是 cmux 擴充功能；將維持原樣"
          }
        }
      }
    },
