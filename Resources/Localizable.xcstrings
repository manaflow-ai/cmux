    "simulator.failure.permissionResetAllCapability": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset All needs the active Xcode worker's isolated extended-permissions adapter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてをリセットするには、有効なXcodeワーカーの分離された拡張権限アダプタが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「全部重置」需要当前 Xcode 工作进程的隔离扩展权限适配器。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Alles zurücksetzen“ benötigt den isolierten Adapter für erweiterte Berechtigungen des aktiven Xcode-Workers."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Réinitialiser tout » nécessite l’adaptateur de permissions étendues isolé du worker Xcode actif."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب 'إعادة تعيين الكل' محول الأذونات الممتدة المعزول لعامل Xcode النشط."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablecer todo necesita el adaptador aislado de permisos extendidos del worker activo de Xcode."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「重設全部」需要作用中的 Xcode 工作者其隔離的延伸權限轉接器。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 재설정하려면 활성화된 Xcode 워커의 분리된 확장 권한 어댑터가 필요합니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reset All zahtijeva izolirani adapter za proširene dozvole aktivnog Xcode radnika."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reset All kræver den aktive Xcode-arbejders isolerede extended-permissions-adapter."
          }
        },
