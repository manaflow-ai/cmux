    "cli.top.error.processDiagnosticsUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب cmux top إصدار cmux قيد التشغيل يدعم تشخيص العمليات"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
