          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "错误：终端会话已过期；请重启 shell 后重试"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FEHLER: Terminal-Sitzung ist veraltet; starten Sie die Shell neu und versuchen Sie es erneut"
