    },
    "cli.sshPtyAttach.reconciliationUnavailableReattach": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SSH terminal connection ended before the remote session state could be confirmed; preserving the remote session for reconnection."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートセッションの状態を確認できる前に SSH ターミナル接続が終了しました。再接続のためセッションを維持します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 终端连接在远程会话状态确认前就已结束；将保留该远程会话以便重连。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die SSH-Terminal-Verbindung endete, bevor der Status der Remote-Sitzung bestätigt werden konnte; die Remote-Sitzung wird für eine erneute Verbindung beibehalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion SSH du terminal s’est terminée avant que l’état de la session distante n’ait pu être confirmé ; conservation de la session distante pour reconnexion."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهى اتصال طرفية SSH قبل تأكيد حالة الجلسة البعيدة؛ سيتم الحفاظ على الجلسة البعيدة لإعادة الاتصال."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalizó la conexión de terminal SSH antes de que pudiera confirmarse el estado de la sesión remota; se conserva la sesión remota para la reconexión."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在確認遠端工作階段狀態前，SSH 終端機連線已結束；保留遠端工作階段以便重新連線。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 세션 상태를 확인하기 전에 SSH 터미널 연결이 종료되었습니다. 재연결을 위해 원격 세션을 보존합니다."
          }
        }
      }
    },
    "cli.sshPtyAttach.remoteSessionLostRespawn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] remote session was lost; starting a new shell."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] リモートセッションが失われました。新しいシェルを開始します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] 远程会话已丢失；正在启动新的 shell。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] Remote-Sitzung ging verloren; eine neue Shell wird gestartet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] la session distante a été perdue ; démarrage d’un nouveau shell."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] فُقدت الجلسة البعيدة؛ يجري بدء شل جديد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] se perdió la sesión remota; iniciando un nuevo shell."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] 遠端工作階段已遺失；正在啟動新的 Shell。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] 원격 세션이 유실되었습니다. 새로운 셸을 시작합니다."
          }
        }
      }
    },
    "cli.sshPtyAttach.terminalInputGuardFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH reattach stopped because queued terminal input could not be protected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューに入ったターミナル入力を保護できなかったため、SSH の再接続を停止しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 重新挂载已中止，因为无法保护已排队的终端输入。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das erneute SSH-Verbinden wurde gestoppt, da die in der Warteschlange befindliche Terminal-Eingabe nicht geschützt werden konnte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion de re-rattachement SSH a été arrêtée car les entrées de terminal en file d’attente n’ont pas pu être protégées."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقفت إعادة اتصال SSH لأنه تعذر حماية إدخال الطرفية الموضوع في قائمة الانتظار."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detuvo la reconexión SSH porque no se pudo proteger la entrada de terminal en cola."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於無法保護排隊中的終端機輸入，SSH 重新連接已停止。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 중인 터미널 입력을 보호할 수 없어 SSH 재연결을 중단했습니다."
          }
        }
      }
    },
    "cli.sshSessionList.remoteStateUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote PTY session state is unavailable for one or more workspaces."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 つ以上のワークスペースでリモート PTY セッションの状態を取得できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个或多个工作区的远程 PTY 会话状态不可用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Remote-PTY-Sitzungsstatus ist für einen oder mehrere Arbeitsbereiche nicht verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’état de la session PTY distante est indisponible pour un ou plusieurs espaces de travail."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حالة جلسة PTY البعيدة غير متاحة لمساحة عمل واحدة أو أكثر."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estado de la sesión remota de PTY no está disponible para uno o más espacios de trabajo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個或多個工作區無法使用遠端 PTY 工作階段狀態。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나 이상의 작업 공간에서 원격 PTY 세션 상태를 사용할 수 없습니다."
          }
        }
      }
    },
