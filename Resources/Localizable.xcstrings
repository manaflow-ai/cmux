    "automation.error.focusSuppressed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This automation action requires permission to focus or select a surface. Update the rule to allow focus, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この自動化アクションにはサーフェスをフォーカスまたは選択する権限が必要です。ルールでフォーカスを許可して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此自动化动作需要聚焦或选中表面的权限。请更新规则以允许聚焦，然后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Automatisierungsaktion erfordert die Berechtigung, eine Oberfläche zu fokussieren oder auszuwählen. Aktualisieren Sie die Regel, um Fokus zu erlauben, und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action d’automatisation requiert l’autorisation de focaliser ou de sélectionner une surface d’affichage. Mettez à jour la règle pour autoriser la focalisation, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب إجراء الأتمتة هذا إذناً للتركيز على سطح أو تحديده. حدّث القاعدة للسماح بالتركيز، ثم حاول مجدداً."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción de automatización requiere permiso para enfocar o seleccionar una superficie. Actualice la regla para permitir el enfoque e intente nuevamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此自動化動作需要取得聚焦或選取介面的權限。請更新規則以允許聚焦，然後重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 자동화 작업에는 화면을 포커스하거나 선택할 수 있는 권한이 필요합니다. 포커스를 허용하도록 규칙을 업데이트한 후 다시 시도하세요."
          }
        }
      }
    },
