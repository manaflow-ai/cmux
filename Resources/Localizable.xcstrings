    "settings.browser.customSearchEngineURLTemplate.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم {query} أو %s لعبارات البحث. بدون عنصر نائب، يضيف cmux q=."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristite {query} ili %s za pojmove pretrage. Bez rezerviranog mjesta cmux dodaje q=."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug {query} eller %s til søgeordene. Uden en pladsholder tilføjer cmux q=."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende {query} oder %s für die Suchbegriffe. Ohne Platzhalter fügt cmux q= hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use {query} or %s for the search terms. Without a placeholder, cmux appends q=."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa {query} o %s para los términos de búsqueda. Sin marcador de posición, cmux agrega q=."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez {query} ou %s pour les termes de recherche. Sans espace réservé, cmux ajoute q=."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa {query} o %s per i termini di ricerca. Senza segnaposto, cmux aggiunge q=."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索語には {query} または %s を使います。プレースホルダーがない場合、cmux は q= を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색어에는 {query} 또는 %s를 사용하세요. 자리표시자가 없으면 cmux가 q=를 추가합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk {query} eller %s for søkeordene. Uten plassholder legger cmux til q=."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj {query} lub %s dla wyszukiwanych terminów. Bez symbolu zastępczego cmux doda q=."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use {query} ou %s para os termos de busca. Sem marcador, o cmux adiciona q=."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте {query} или %s для поисковых запросов. Без заполнителя cmux добавляет q=."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ {query} หรือ %s สำหรับคำค้นหา หากไม่มีตัวยึดตำแหน่ง cmux จะเพิ่ม q="
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama terimleri için {query} veya %s kullanın. Yer tutucu yoksa cmux q= ekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте {query} або %s для пошукових запитів. Без заповнювача cmux додає q=."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 {query} 或 %s 作为搜索词。没有占位符时，cmux 会追加 q=。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 {query} 或 %s 作為搜尋詞。沒有佔位符時，cmux 會附加 q=。"
          }
        }
      }
    },
