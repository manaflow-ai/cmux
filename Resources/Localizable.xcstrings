    "settings.app.makeSidebarPullRequestClickable.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review items stay visible as plain text, and clicks in that area select the workspace row."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レビュー項目は通常のテキストとして表示され、その領域をクリックするとワークスペース行が選択されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "评审项仍以纯文本显示，点击该区域会选中对应的工作区行。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfungselemente bleiben als Nur-Text sichtbar, und Klicks in diesem Bereich wählen die Arbeitsbereichszeile aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments de révision restent visibles sous forme de texte brut, et les clics dans cette zone sélectionnent la ligne de l’espace de travail."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظل عناصر المراجعة مرئية كنص عادي، وتؤدي النقرات في تلك المنطقة إلى تحديد صف مساحة العمل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos de revisión permanecen visibles como texto sin formato, y hacer clic en esa área selecciona la fila del espacio de trabajo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "審查項目保持顯示為純文字，點擊該區域會選取該工作區資料列。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검토 항목이 일반 텍스트로 표시되며, 해당 영역을 클릭하면 작업 공간 행이 선택됩니다."
          }
        }
      }
    },
