    "sidebar.remote.help.suspended": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH host %@ is unreachable. Automatic reconnect is paused — use Reconnect to retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH ホスト %@ に到達できません。自動再接続は一時停止中です。「再接続」で再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 호스트 %@에 연결할 수 없습니다. 자동 재연결이 일시 중지되었습니다. 재연결로 다시 시도하세요."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH-хост %@ недоступний. Автоматичне перепідключення призупинено — скористайтеся «Перепідключити», щоб повторити спробу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问 SSH 主机 %@。自动重连已暂停 — 请使用「重新连接」重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH-Host %@ ist nicht erreichbar. Die automatische Wiederverbindung ist pausiert – verwenden Sie „Erneut verbinden“, um es noch einmal zu versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'hôte SSH %@ est inaccessible. La reconnexion automatique est suspendue — utilisez Se connecter à nouveau pour réessayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعذر الوصول إلى مضيف SSH ‏%@. تم إيقاف إعادة الاتصال التلقائي مؤقتًا — استخدم إعادة الاتصال للمحاولة مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El host SSH %@ es inaccesible. La reconexión automática está en pausa — usa Reconectar para reintentar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 主機 %@ 無法連線。已暫停自動重新連線 — 請使用「重新連線」重試。"
          }
        }
      }
    },
