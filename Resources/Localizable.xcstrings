            "value": "fork: o comando do agente salvo não está disponível. Certifique-se de que o agente esteja instalado e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: сохраненная команда агента недоступна. Убедитесь, что агент установлен, затем повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: คำสั่งเอเจนต์ที่บันทึกไว้ไม่พร้อมใช้งาน ตรวจสอบให้แน่ใจว่าติดตั้งเอเจนต์แล้ว จากนั้นลองอีกครั้ง"
          }
