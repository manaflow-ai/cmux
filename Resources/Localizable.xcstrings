    "debug.tabBarBackdropLab.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Bonsplit tab bars with overflow tabs under the split buttons. The window background is transparent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分割ボタンの下にあふれるタブを表示するライブ Bonsplit タブバーです。ウインドウ背景は透明です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时的 Bonsplit 标签栏，溢出标签页位于拆分按钮下方。窗口背景是透明的。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Bonsplit-Tab-Leisten mit Überlauf-Tabs unter den Aufteilungsschaltflächen. Der Fensterhintergrund ist transparent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Barres d'onglets Bonsplit en direct avec des onglets de débordement sous les boutons de division. L'arrière-plan de la fenêtre est transparent."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أشرطة علامات تبويب Bonsplit مباشرة مع علامات تبويب فائضة أسفل أزرار التقسيم. خلفية النافذة شفافة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Barras de pestañas de Bonsplit en vivo con pestañas desbordadas debajo de los botones de división. El fondo de la ventana es transparente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時預覽在分割按鈕下方具有溢出標籤頁的 Bonsplit 標籤頁列。視窗背景為透明。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분할 버튼 아래에 넘치는 탭이 있는 실시간 Bonsplit 탭 바입니다. 창 배경은 투명합니다."
          }
        }
      }
    },
