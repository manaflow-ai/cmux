    "settings.app.pathLastSegmentOnly.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Render full paths abbreviated with ~/."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全なパスを ~/ で省略して表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以 ~/ 缩写形式渲染完整路径。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollständige Pfade abgekürzt mit ~/ darstellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher les chemins complets abrégés avec ~/."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض المسارات الكاملة مختصرة بـ ~/."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra las rutas completas abreviadas con ~/."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉譯以 ~/ 縮寫的完整路徑。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "~/로 축약된 전체 경로를 렌더링합니다."
          }
        }
      }
    },
    "settings.app.pathLastSegmentOnly.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show as much of the trailing path as fits; shorter forms are prefixed with …/."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "末尾のパスを可能な限り表示し、短縮形には …/ を付けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尽可能多地显示路径末尾部分；被缩短的形式以 …/ 开头。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So viel des nachfolgenden Pfads anzeigen, wie hineinpasst; kürzere Formen erhalten das Präfix …/."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher autant de la fin du chemin que possible ; les formes plus courtes sont préfixées par …/."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار أكبر قدر ممكن من الجزء الأخير من المسار؛ الأشكال الأقصر تبدأ بـ …/."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la mayor parte posible de la ruta final que quepa; las formas más cortas llevan el prefijo …/."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示儘可能多的結尾路徑；較短的形式會加上 …/ 前綴。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길이에 맞춰 뒷부분 경로를 최대한 많이 표시하며, 더 짧은 형식에는 …/ 접두사가 붙습니다."
          }
        }
      }
    },
