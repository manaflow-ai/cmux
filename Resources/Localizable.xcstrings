    "cli.comments.usage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستخدام: cmux comments <subcommand> [options]\n\nتعليقات المراجعة المحفوظة من عارض الفروق، وتُخزَّن لكل مستودع git.\n\nالأوامر الفرعية:\n  list [--repo <path>] [--all] [--json]\n    يسرد تعليقات المراجعة لمستودع (الافتراضي: مستودع git الذي يحتوي\n    الدليل الحالي). يسرد التعليقات المعلَّقة فقط؛ ويضيف --all التعليقات\n    التي سُلِّمت بالفعل إلى وكيل عبر إرسال TextBox."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upotreba: cmux comments <subcommand> [options]\n\nKomentari pregleda sačuvani iz diff prikaza, čuvaju se po git repozitoriju.\n\nPotkomande:\n  list [--repo <path>] [--all] [--json]\n    Ispisuje komentare pregleda za repozitorij (podrazumijevano: git\n    repozitorij koji sadrži trenutni direktorij). Ispisuje samo komentare\n    na čekanju; --all uključuje i one već predane agentu putem TextBox\n    slanja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug: cmux comments <subcommand> [options]\n\nGennemgangskommentarer gemt fra diff-visningen, lagret pr. git-repository.\n\nUnderkommandoer:\n  list [--repo <path>] [--all] [--json]\n    Viser gennemgangskommentarerne for et repository (standard: det\n    git-repository der indeholder den aktuelle mappe). Viser kun\n    afventende kommentarer; --all medtager også dem der allerede er\n    leveret til en agent via en TextBox-indsendelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendung: cmux comments <subcommand> [options]\n\nIm Diff-Viewer gespeicherte Review-Kommentare, abgelegt pro Git-Repository.\n\nUnterbefehle:\n  list [--repo <path>] [--all] [--json]\n    Listet die Review-Kommentare eines Repositorys auf (Standard: das\n    Git-Repository des aktuellen Verzeichnisses). Zeigt nur offene\n    Kommentare; mit --all auch die, die per TextBox-Übermittlung schon an\n    einen Agenten übergeben wurden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage: cmux comments <subcommand> [options]\n\nReview comments saved from the diff viewer, stored per git repository.\n\nSubcommands:\n  list [--repo <path>] [--all] [--json]\n    List review comments for a repository (default: the git repository\n    containing the current directory). Lists pending comments only;\n    --all includes comments already delivered to an agent through a\n    TextBox submission."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso: cmux comments <subcommand> [options]\n\nComentarios de revisión guardados desde el visor de diferencias, almacenados por repositorio git.\n\nSubcomandos:\n  list [--repo <path>] [--all] [--json]\n    Lista los comentarios de revisión de un repositorio (por defecto: el\n    repositorio git que contiene el directorio actual). Muestra solo los\n    comentarios pendientes; --all incluye los ya entregados a un agente\n    mediante un envío de TextBox."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisation : cmux comments <subcommand> [options]\n\nCommentaires de revue enregistrés depuis la visionneuse de diff, stockés par dépôt git.\n\nSous-commandes :\n  list [--repo <path>] [--all] [--json]\n    Liste les commentaires de revue d'un dépôt (par défaut : le dépôt git\n    contenant le répertoire courant). N'affiche que les commentaires en\n    attente ; --all inclut aussi ceux déjà transmis à un agent via un\n    envoi TextBox."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso: cmux comments <subcommand> [options]\n\nCommenti di revisione salvati dal visualizzatore di diff, memorizzati per repository git.\n\nSottocomandi:\n  list [--repo <path>] [--all] [--json]\n    Elenca i commenti di revisione di un repository (predefinito: il\n    repository git che contiene la directory corrente). Elenca solo i\n    commenti in sospeso; --all include anche quelli già consegnati a un\n    agente tramite un invio TextBox."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使い方: cmux comments <subcommand> [options]\n\ndiff ビューアーで保存されたレビューコメントを、git リポジトリごとに一覧します。\n\nサブコマンド:\n  list [--repo <path>] [--all] [--json]\n    リポジトリのレビューコメントを一覧します (既定はカレントディレクトリを含む\n    git リポジトリ)。既定では未対応のコメントのみを表示し、--all を付けると\n    TextBox の送信でエージェントへ引き渡し済みのコメントも含めます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "របៀប​ប្រើ: cmux comments <subcommand> [options]\n\nមតិ​ត្រួតពិនិត្យ​ដែល​បាន​រក្សាទុក​ពី​កម្មវិធី​មើល diff ត្រូវ​បាន​ទុក​តាម​ឃ្លាំង git។\n\nអនុ​បញ្ជា:\n  list [--repo <path>] [--all] [--json]\n    បង្ហាញ​មតិ​ត្រួតពិនិត្យ​របស់​ឃ្លាំង (លំនាំដើម: ឃ្លាំង git ដែល​មាន\n    ថត​បច្ចុប្បន្ន)។ បង្ហាញ​តែ​មតិ​ដែល​រង់ចាំ; --all រួម​បញ្ចូល​មតិ​ដែល​បាន\n    ប្រគល់​ទៅ​ភ្នាក់ងារ​តាម​ការ​ផ្ញើ TextBox រួច​ហើយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용법: cmux comments <subcommand> [options]\n\ndiff 뷰어에서 저장한 리뷰 코멘트를 git 저장소 단위로 조회합니다.\n\n서브커맨드:\n  list [--repo <path>] [--all] [--json]\n    저장소의 리뷰 코멘트를 조회합니다 (기본값은 현재 디렉터리가 속한 git\n    저장소). 기본적으로 미해결 코멘트만 표시하고, --all 을 주면 TextBox\n    전송으로 에이전트에 이미 전달된 코멘트까지 포함합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk: cmux comments <subcommand> [options]\n\nGjennomgangskommentarer lagret fra diff-visningen, lagret per git-repository.\n\nUnderkommandoer:\n  list [--repo <path>] [--all] [--json]\n    Lister gjennomgangskommentarene for et repository (standard:\n    git-repositoryet som inneholder gjeldende katalog). Lister bare\n    ventende kommentarer; --all tar også med dem som alt er levert til en\n    agent via en TextBox-sending."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użycie: cmux comments <subcommand> [options]\n\nKomentarze przeglądu zapisane w podglądzie diff, przechowywane dla każdego repozytorium git.\n\nPodkomendy:\n  list [--repo <path>] [--all] [--json]\n    Wypisuje komentarze przeglądu repozytorium (domyślnie: repozytorium\n    git zawierające bieżący katalog). Pokazuje tylko oczekujące\n    komentarze; --all obejmuje także te już przekazane agentowi przez\n    wysłanie TextBox."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso: cmux comments <subcommand> [options]\n\nComentários de revisão salvos no visualizador de diff, armazenados por repositório git.\n\nSubcomandos:\n  list [--repo <path>] [--all] [--json]\n    Lista os comentários de revisão de um repositório (padrão: o\n    repositório git que contém o diretório atual). Lista apenas os\n    comentários pendentes; --all inclui os já entregues a um agente por\n    um envio do TextBox."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использование: cmux comments <subcommand> [options]\n\nКомментарии ревью, сохранённые в просмотрщике diff, хранятся по git-репозиториям.\n\nПодкоманды:\n  list [--repo <path>] [--all] [--json]\n    Выводит комментарии ревью репозитория (по умолчанию — git-репозиторий\n    текущего каталога). Показывает только ожидающие комментарии; с --all\n    также те, что уже переданы агенту через отправку TextBox."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิธีใช้: cmux comments <subcommand> [options]\n\nคอมเมนต์รีวิวที่บันทึกจากตัวดูส่วนต่าง จัดเก็บแยกตามที่เก็บโค้ด git\n\nคำสั่งย่อย:\n  list [--repo <path>] [--all] [--json]\n    แสดงคอมเมนต์รีวิวของที่เก็บโค้ด (ค่าเริ่มต้น: ที่เก็บโค้ด git\n    ที่มีไดเรกทอรีปัจจุบันอยู่) โดยแสดงเฉพาะคอมเมนต์ที่รอดำเนินการ\n    ส่วน --all จะรวมคอมเมนต์ที่ส่งให้เอเจนต์ผ่าน TextBox แล้วด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanım: cmux comments <subcommand> [options]\n\nDiff görüntüleyicide kaydedilen inceleme yorumları, git deposu başına saklanır.\n\nAlt komutlar:\n  list [--repo <path>] [--all] [--json]\n    Bir deponun inceleme yorumlarını listeler (varsayılan: geçerli\n    dizini içeren git deposu). Yalnızca bekleyen yorumları listeler;\n    --all bir TextBox gönderimiyle bir aracıya zaten teslim edilmiş\n    olanları da içerir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використання: cmux comments <subcommand> [options]\n\nКоментарі рецензування, збережені у переглядачі diff, зберігаються за git-репозиторіями.\n\nПідкоманди:\n  list [--repo <path>] [--all] [--json]\n    Виводить коментарі рецензування репозиторію (типово — git-репозиторій\n    поточного каталогу). Показує лише ті, що очікують; з --all також ті,\n    що вже передані агентові через надсилання TextBox."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用法：cmux comments <subcommand> [options]\n\n从差异查看器保存的评审评论，按 git 仓库分别存储。\n\n子命令：\n  list [--repo <path>] [--all] [--json]\n    列出仓库的评审评论（默认：包含当前目录的 git 仓库）。默认只列出待处理\n    的评论；加上 --all 还会列出已通过 TextBox 提交交付给代理的评论。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用法：cmux comments <subcommand> [options]\n\n從差異檢視器儲存的審查註解，依 git 儲存庫分別存放。\n\n子命令：\n  list [--repo <path>] [--all] [--json]\n    列出儲存庫的審查註解（預設：包含目前目錄的 git 儲存庫）。預設只列出待\n    處理的註解；加上 --all 也會列出已透過 TextBox 提交交付給代理的註解。"
          }
        }
      }
    },
