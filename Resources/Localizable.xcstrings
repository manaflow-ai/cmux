    "featureFlags.sidebarWorkspaceAgentSpinner.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows a spinner in workspace rows while coding agents are running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーディングエージェントの実行中にワークスペース行にスピナーを表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编码代理运行时在工作区行中显示旋转指示器。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt eine Ladeanzeige in Arbeitsbereichszeilen an, während Programmier-Agenten ausgeführt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche un indicateur d’activité dans les lignes d’espace de travail lorsque les agents de codage sont en cours d’exécution."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض مؤشراً دواراً في صفوف مساحة العمل أثناء تشغيل وكلاء البرمجة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un indicador giratorio en las filas del espacio de trabajo mientras se ejecutan los agentes de código."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當程式碼 Agent 正在執行時，在工作區資料列中顯示載入指示器 (Spinner)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코딩 에이전트가 실행되는 동안 작업 공간 행에 스피너를 표시합니다."
          }
        }
      }
    },
