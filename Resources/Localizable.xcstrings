    "settings.networking.diagnostics.report.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share a bounded, privacy-safe connection timeline with support."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲が限定されたプライバシー保護済みの接続タイムラインをサポートと共有します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与支持团队分享一份范围有限、隐私安全的连接时间线。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilen Sie eine begrenzte, datenschutzfreundliche Verbindungschronik mit dem Support."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partager une chronologie des connexions limitée et respectueuse de la vie privée avec le support."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شارك مخططًا زمنيًا للاتصال محدودًا وآمنًا للخصوصية مع الدعم."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte con soporte técnico una cronología de conexión acotada y segura para la privacidad."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與支援團隊分享受限且保護隱私安全的連線時間軸。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원 팀과 범위가 제한되고 개인정보가 보호되는 연결 타임라인을 공유합니다."
          }
        }
      }
    },
