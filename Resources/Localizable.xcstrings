          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "session move: 移動先の %1$@ にチェックアウトがなく、%2$@ にリポジトリもありません。先にそこでクローンしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "session move: 대상의 %1$@에 체크아웃이 없고 %2$@에 저장소도 없습니다. 먼저 그곳에 클론하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "session move：目标上 %1$@ 没有检出，%2$@ 也没有仓库；请先在那里克隆"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "session move：目的地的 %1$@ 沒有 checkout，%2$@ 也沒有儲存庫；請先在那裡 clone"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "session move: nema checkoutа na %@ i nema repozitorija na %@ na destinaciji; prvo ga kloniraj tamo"
          }
