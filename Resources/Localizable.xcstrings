    "cli.workspaceGroup.help.identitySafety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass --idempotency-key (or --external-id) to make retries and concurrent creates return one group."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行や同時作成で同じグループを返すには、--idempotency-key（または --external-id）を渡してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "传入 --idempotency-key（或 --external-id），可让重试与并发创建只返回同一个分组。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übergeben Sie --idempotency-key (oder --external-id), damit Wiederholungsversuche und gleichzeitiges Erstellen dieselbe Gruppe zurückgeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez --idempotency-key (ou --external-id) pour que les nouvelles tentatives et les créations simultanées renvoient un seul groupe."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرر --idempotency-key (أو --external-id) لجعل عمليات إعادة المحاولة والإنشاء المتزامنة تعيد مجموعة واحدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa --idempotency-key (o --external-id) para hacer que los reintentos y las creaciones concurrentes devuelvan un solo grupo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳遞 --idempotency-key（或 --external-id）以使重試和並行建立僅傳回同一個群組。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재시도 및 동시 생성이 동일한 그룹을 반환하도록 --idempotency-key (또는 --external-id)를 전달하십시오."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Angiv --idempotency-key (eller --external-id) for at få genforsøg og samtidige oprettelser til at returnere én gruppe."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ប្រើ --idempotency-key (ឬ --external-id) ដើម្បីឱ្យការ retry និងការបង្កើតដំណាលគ្នាត្រឡប់ group តែមួយ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Send --idempotency-key (eller --external-id) for å la nye forsøk og samtidige opprettelser returnere én gruppe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Передайте --idempotency-key (или --external-id), чтобы повторные и параллельные создания возвращали одну группу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Передайте --idempotency-key (або --external-id), щоб повторні та паралельні створення повертали одну групу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Truyền --idempotency-key (hoặc --external-id) để các lần thử lại và tạo đồng thời trả về một nhóm duy nhất."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ส่ง --idempotency-key (หรือ --external-id) เพื่อให้การลองซ้ำและการสร้างพร้อมกันคืนค่ากลุ่มเดียว"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Proslijedite --idempotency-key (ili --external-id) kako bi ponovni pokušaji i istovremena kreiranja vratili jednu grupu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Passare --idempotency-key (o --external-id) per fare in modo che i retry e le creazioni concorrenti restituiscano un solo gruppo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przekaż --idempotency-key (lub --external-id), aby ponowne próby i równoległe tworzenia zwracały jedną grupę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Passe --idempotency-key (ou --external-id) para que novas tentativas e criações simultâneas retornem um único grupo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yeniden denemelerin ve eşzamanlı oluşturmaların tek bir grup döndürmesi için --idempotency-key (veya --external-id) kullanın."
          }
        }
      }
    },
    "cli.workspaceGroup.help.overview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage collapsible workspace groups in the sidebar. Each group is owned by an \"anchor\" workspace; the group header IS the anchor's sidebar representation. Closing the anchor closes only that workspace and promotes the group's next member to be the new anchor, so the group and its other members stay intact. When the anchor is the group's only workspace, the group is removed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーで折りたたみ可能なワークスペースグループを管理します。各グループは「アンカー」ワークスペースが所有し、サイドバーのグループヘッダーがそのアンカーを表します。アンカーを閉じると、閉じられるのはそのワークスペースだけで、グループの次のメンバーが新しいアンカーに昇格するため、グループと他のメンバーはそのまま維持されます。アンカーがグループ唯一のワークスペースだった場合は、グループが削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理侧边栏中可折叠的工作区分组。每个分组由一个「锚点」工作区拥有；分组标题就是该锚点在侧边栏中的呈现。关闭锚点只会关闭这一个工作区，并把分组中的下一个成员提升为新锚点，因此分组及其他成员保持不变。当锚点是分组中唯一的工作区时，该分组会被移除。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwalte einklappbare Arbeitsbereichsgruppen in der Seitenleiste. Jede Gruppe gehört einem „Anker“-Arbeitsbereich; der Gruppenkopf IST die Repräsentation des Ankers in der Seitenleiste. Das Schließen des Ankers schließt nur diesen Arbeitsbereich und befördert das nächste Mitglied der Gruppe zum neuen Anker, sodass die Gruppe und ihre anderen Mitglieder intakt bleiben. Wenn der Anker der einzige Arbeitsbereich der Gruppe ist, wird die Gruppe entfernt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez les groupes d’espaces de travail réductibles dans la barre latérale. Chaque groupe appartient à un espace de travail « ancrage » ; l’en-tête du groupe EST la représentation de cet ancrage dans la barre latérale. Fermer l’ancrage ferme uniquement cet espace de travail et promeut le membre suivant du groupe comme nouvel ancrage, de sorte que le groupe et ses autres membres restent intacts. Lorsque l'ancrage est le seul espace de travail du groupe, le groupe est supprimé."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إدارة مجموعات مساحات العمل القابلة للطي في الشريط الجانبي. كل مجموعة مملوكة لمساحة عمل \"مرساة\"؛ ترويسة المجموعة هي تمثيل المرساة في الشريط الجانبي. يؤدي إغلاق المرساة إلى إغلاق مساحة العمل تلك فقط وترقية العضو التالي في المجموعة ليكون المرساة الجديدة، وبذلك تظل المجموعة وأعضاؤها الآخرون سليمين. عندما تكون المرساة هي مساحة العمل الوحيدة في المجموعة، يتم إزالة المجموعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona grupos de espacios de trabajo colapsables en la barra lateral. Cada grupo es propiedad de un espacio de trabajo de \"anclaje\"; el encabezado del grupo ES la representación del anclaje en la barra lateral. Al cerrar el anclaje solo se cierra ese espacio de trabajo y se promueve al siguiente miembro del grupo como nuevo anclaje, por lo que el grupo y sus demás miembros permanecen intactos. Cuando el anclaje es el único espacio de trabajo del grupo, el grupo se elimina."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在側邊欄中管理可摺疊的工作區群組。每個群組都由一個「錨點」工作區所擁有；群組標頭「即是」錨點在側邊欄上的呈現。關閉錨點僅會關閉該工作區，並將群組的下一個成員提升為新錨點，因此群組及其其他成員仍會保持原樣。當錨點是群組中唯一的工作區時，該群組將被移除。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이드바에서 접고 펼칠 수 있는 작업 공간 그룹을 관리합니다. 각 그룹은 \"앵커\" 작업 공간에 의해 소유되며, 그룹 헤더는 해당 앵커의 사이드바 표시 형태가 됩니다. 앵커를 닫으면 해당 작업 공간만 닫히고 그룹의 다음 멤버가 새 앵커로 승격되므로, 그룹 및 기타 멤버는 그대로 유지됩니다. 앵커가 그룹의 유일한 작업 공간인 경우 그룹이 제거됩니다."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Administrér kollapsible workspace-grupper i sidebjælken. Hver gruppe ejes af et \"anker\"-workspace; gruppehovedet ER ankerets repræsentation i sidebjælken. Lukning af ankeret lukker kun det pågældende workspace og forfremmer gruppens næste medlem til det nye anker, så gruppen og dens øvrige medlemmer bevares. Når ankeret er gruppens eneste workspace, fjernes gruppen."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្រប់គ្រង collapsible workspace groups នៅក្នុង sidebar។ Group នីមួយៗជាកម្មសិទ្ធិរបស់ workspace \"anchor\"; header របស់ group គឺជាការតំណាង sidebar របស់ anchor។ ការបិទ anchor បិទតែ workspace នោះ ហើយ promote សមាជិកបន្ទាប់របស់ group ឱ្យក្លាយជា anchor ថ្មី ដូច្នេះ group និងសមាជិកផ្សេងទៀតនៅដដែល។ នៅពេល anchor គឺជា workspace តែមួយគត់របស់ group group ត្រូវបានដកចេញ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Administrer sammenleggbare arbeidsflategrupper i sidefeltet. Hver gruppe eies av et «anker»-arbeidsflate; gruppeoverskriften ER ankerets sidefeltsrepresentasjon. Å lukke ankeret lukker kun den arbeidsflaten og forfremmer gruppens neste medlem til nytt anker, slik at gruppen og de andre medlemmene beholdes. Når ankeret er gruppens eneste arbeidsflate, fjernes gruppen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Управление сворачиваемыми группами рабочих пространств на боковой панели. Каждая группа принадлежит «якорному» рабочему пространству; заголовок группы является представлением якоря на боковой панели. Закрытие якоря закрывает только это рабочее пространство и повышает следующего участника группы до нового якоря, сохраняя группу и остальных участников. Когда якорь является единственным рабочим пространством группы, группа удаляется."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Керування згортуваними групами робочих просторів на бічній панелі. Кожна група належить робочому простору-«якорю»; заголовок групи є представленням якоря на бічній панелі. Закриття якоря закриває лише цей робочий простір і підвищує наступного учасника групи до ролі нового якоря, тому група та її інші учасники залишаються незмінними. Коли якір є єдиним робочим простором групи, група видаляється."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quản lý các nhóm workspace có thể thu gọn trong sidebar. Mỗi nhóm được sở hữu bởi một workspace \"anchor\"; tiêu đề nhóm CHÍNH LÀ đại diện sidebar của anchor. Đóng anchor chỉ đóng workspace đó và thăng thành viên tiếp theo của nhóm lên làm anchor mới, giữ nguyên nhóm và các thành viên khác. Khi anchor là workspace duy nhất trong nhóm, nhóm sẽ bị xóa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "จัดการกลุ่ม workspace แบบยุบได้ใน sidebar แต่ละกลุ่มเป็นของ workspace \"anchor\" โดยส่วนหัวกลุ่มคือการแสดงผลของ anchor ใน sidebar การปิด anchor จะปิดเฉพาะ workspace นั้น และเลื่อนสมาชิกถัดไปของกลุ่มขึ้นเป็น anchor ใหม่ ทำให้กลุ่มและสมาชิกอื่นยังคงอยู่ เมื่อ anchor เป็น workspace เดียวของกลุ่ม กลุ่มนั้นจะถูกลบออก"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Upravljajte skupivim grupama radnih prostora u bočnoj traci. Svaka grupa je u vlasništvu \"sidrenog\" radnog prostora; zaglavlje grupe JEST prikaz sidra u bočnoj traci. Zatvaranjem sidra zatvara se samo taj radni prostor i promoviše sljedeći član grupe kao novo sidro, tako da grupa i njeni ostali članovi ostaju netaknuti. Kada je sidro jedini radni prostor grupe, grupa se uklanja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gestisce i gruppi di workspace comprimibili nella barra laterale. Ogni gruppo appartiene a un workspace \"anchor\"; l'intestazione del gruppo È la rappresentazione dell'anchor nella barra laterale. Chiudere l'anchor chiude solo quel workspace e promuove il membro successivo del gruppo come nuovo anchor, lasciando intatti il gruppo e gli altri membri. Quando l'anchor è l'unico workspace del gruppo, il gruppo viene rimosso."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zarządzaj zwijanymi grupami obszarów roboczych na pasku bocznym. Każda grupa jest własnością obszaru roboczego \"kotwicy\"; nagłówek grupy JEST reprezentacją kotwicy na pasku bocznym. Zamknięcie kotwicy zamyka tylko ten obszar roboczy i awansuje następnego członka grupy na nową kotwicę, dzięki czemu grupa i jej pozostali członkowie pozostają nienaruszone. Gdy kotwica jest jedynym obszarem roboczym w grupie, grupa jest usuwana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gerencia grupos de workspaces recolhíveis na barra lateral. Cada grupo pertence a um workspace \"âncora\"; o cabeçalho do grupo É a representação da âncora na barra lateral. Fechar a âncora fecha apenas aquele workspace e promove o próximo membro do grupo como nova âncora, mantendo o grupo e seus demais membros intactos. Quando a âncora é o único workspace do grupo, o grupo é removido."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kenar çubuğundaki daraltılabilir çalışma alanı gruplarını yönetir. Her grup bir \"anchor\" çalışma alanına aittir; grup başlığı, anchor'ın kenar çubuğundaki temsilidir. Anchor kapatıldığında yalnızca o çalışma alanı kapanır ve grubun bir sonraki üyesi yeni anchor olarak yükseltilir; böylece grup ve diğer üyeler korunur. Anchor grubun tek çalışma alanıysa grup kaldırılır."
          }
        }
      }
    },
    "cli.workspaceGroup.response.closed.one": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "OK group deleted (closed %lld workspace)"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "OK group deleted (closed %lld workspaces)"
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "OK グループを削除しました（%lld個のワークスペースを閉じました）"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "OK グループを削除しました（%lld 件のワークスペースをクローズ）"
                }
              }
            }
          }
