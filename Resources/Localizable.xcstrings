          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الـ Simulator المحفوظ لم يعد متاحًا. اختر جهازًا آخر."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El simulador guardado ya no está disponible. Elige otro dispositivo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存的 Simulator 已無法使用。請選擇其他裝置。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 시뮬레이터를 더 이상 사용할 수 없습니다. 다른 기기를 선택해 주세요."
          }
        }
      }
    },
    "simulator.failure.subscriberQueueOverflow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Simulator event subscriber exceeded its bounded queue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulatorイベントの購読キューが上限を超えました。"
          }
        },
        "zh-Hans": {
