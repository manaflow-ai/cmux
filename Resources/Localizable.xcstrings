    "account.signIn.loading.waiting.instructions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete sign-in in the window that opened. This pane updates automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いたウインドウでサインインを完了してください。このペインは自動的に更新されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在打开的窗口中完成登录。此窗格会自动更新。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie die Anmeldung im geöffneten Fenster ab. Dieses Teilfenster wird automatisch aktualisiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez la connexion dans la fenêtre qui s'est ouverte. Ce volet se met à jour automatiquement."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكمل تسجيل الدخول في النافذة التي فتحت. يتم تحديث هذا الجزء تلقائيًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa el inicio de sesión en la ventana que se abrió. Este panel se actualiza automáticamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
