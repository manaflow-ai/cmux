    "cli.help.noSocket": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also works without a running cmux app or socket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert auch ohne laufende cmux-App oder Socket."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne aussi sans application cmux ni socket actif."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل أيضًا دون تشغيل تطبيق cmux أو المقبس."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También funciona sin una aplicación cmux ni un socket en ejecución."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使沒有執行中的 cmux 應用程式或 socket 也能使用。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使没有运行中的 cmux 应用或 socket 也能使用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중인 cmux 앱이나 소켓 없이도 작동합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中の cmux アプリやソケットがなくても動作します。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Radi i bez pokrenute cmux aplikacije ili socketa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Virker også uden en kørende cmux-app eller socket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Funziona anche senza un'app cmux o socket attivi."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ដំណើរការបានដោយគ្មានកម្មវិធី cmux ឬ socket កំពុងដំណើរការ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fungerer også uten en kjørende cmux-app eller socket."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Działa również bez uruchomionej aplikacji cmux lub gniazda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Funciona também sem o app cmux em execução ou socket."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Работает и без запущенного приложения cmux или сокета."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ใช้งานได้โดยไม่ต้องรัน cmux หรือ socket"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Çalışan bir cmux uygulaması veya soket olmadan da çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Працює також без запущеного застосунку cmux або сокета."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cũng hoạt động khi không có ứng dụng cmux đang chạy hoặc không có socket."
          }
        }
      }
    },
