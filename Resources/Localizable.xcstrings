    "settings.notifications.soundOverrides.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر صوتًا لكل وكيل ونوع تنبيه. تستخدم الخلايا الفارغة صوت الإشعارات العام."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite zvuk za svakog agenta i vrstu upozorenja. Prazne ćelije koriste globalni zvuk obavijesti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en lyd for hver agent og alarmtype. Tomme celler bruger den globale notifikationslyd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle für jeden Agenten und Alarmtyp einen Ton. Leere Felder verwenden den globalen Benachrichtigungston."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a sound for each agent and alert type. Empty cells use the global notification sound."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un sonido para cada agente y tipo de alerta. Las celdas vacías usan el sonido de notificación global."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un son pour chaque agent et type d’alerte. Les cellules vides utilisent le son de notification global."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un suono per ogni agente e tipo di avviso. Le celle vuote usano il suono di notifica globale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントとアラート種別ごとにサウンドを選択できます。空のセルはグローバル通知サウンドを使用します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ជ្រើសសំឡេងសម្រាប់ភ្នាក់ងារ និងប្រភេទការជូនដំណឹងនីមួយៗ។ ក្រឡាទទេប្រើសំឡេងជូនដំណឹងសកល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 에이전트와 알림 유형에 사용할 소리를 선택합니다. 빈 셀은 전역 알림 소리를 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en lyd for hver agent og varslingstype. Tomme celler bruker den globale varslingslyden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz dźwięk dla każdego agenta i typu alertu. Puste komórki używają globalnego dźwięku powiadomień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um som para cada agente e tipo de alerta. As células vazias usam o som de notificação global."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите звук для каждого агента и типа оповещения. Пустые ячейки используют глобальный звук уведомлений."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกเสียงสำหรับเอเจนต์และประเภทการแจ้งเตือนแต่ละรายการ เซลล์ว่างจะใช้เสียงแจ้งเตือนแบบทั่วโลก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ajan ve uyarı türü için bir ses seçin. Boş hücreler genel bildirim sesini kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть звук для кожного агента й типу сповіщення. Порожні клітинки використовують глобальний звук сповіщень."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为每个代理和提醒类型选择声音。空白单元格使用全局通知声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為每個代理程式和提醒類型選擇聲音。空白儲存格會使用全域通知聲音。"
          }
        }
      }
    },
    "settings.notifications.soundOverrides.invalidFile": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملف مفقود أو يتعذر فك ترميزه كصوت."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteka nedostaje ili se ne može dekodirati kao zvuk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen mangler eller kan ikke afkodes som lyd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei fehlt oder kann nicht als Audio decodiert werden."
          }
        },
        "en": {
          "stringUnit": {
