        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분리된 워커가 요청된 카메라 소스 및 대상을 구성하지 못했습니다."
          }
        }
      }
    },
    "simulator.failure.cameraMirrorFailed": {
