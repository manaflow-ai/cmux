          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "vm resize: CPU は 1〜32、メモリは 1〜64 GiB（1 GiB 単位）、ディスクは 4〜256 GiB（4 GiB 単位）で指定してください。"
          }
