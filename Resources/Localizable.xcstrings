    "settings.networking.relayPreference.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct peer-to-peer stays enabled. This controls which relays Iroh may use when a direct path is unavailable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピアツーピアの直接接続は有効なままです。直接経路が利用できない場合に Iroh が使用できるリレーを指定します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点对点直连始终启用。此项控制在没有直连路径时 Iroh 可以使用哪些中继。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direktes Peer-to-Peer bleibt aktiviert. Dies steuert, welche Relays Iroh verwenden darf, wenn kein direkter Pfad verfügbar ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le peer-to-peer direct reste activé. Cela contrôle les relais qu'Iroh peut utiliser lorsqu'un chemin direct n'est pas disponible."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظل الاتصال المباشر بين النظراء (peer-to-peer) ممكناً. يتحكم هذا في المرحلات التي قد يستخدمها Iroh عندما يكون المسار المباشر غير متاح."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión directa entre pares permanece activada. Esto controla qué retransmisiones puede usar Iroh cuando una ruta directa no está disponible."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接點對點（peer-to-peer）連線仍維持啟用。此選項控制當直接路徑不可用時，Iroh 可使用的中繼。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 피어 투 피어(P2P)는 활성화된 상태를 유지합니다. 이는 직접 경로를 사용할 수 없을 때 Iroh가 사용할 수 있는 릴레이를 제어합니다."
          }
        }
      }
    },
    "settings.networking.saveFailed": {
      "extractionState": "manual",
      "localizations": {
