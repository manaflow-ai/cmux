    "panel.cloudVM.loading.failed.localServer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local cmux web server is offline. Start it and retry Open Cloud VM."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルのcmux Webサーバーがオフラインです。起動してからCloud VMをもう一度開いてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地 cmux Web 服务器已离线。请启动它，然后重试「打开 Cloud VM」。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der lokale cmux-Webserver ist offline. Starten Sie ihn und versuchen Sie 'Cloud-VM öffnen' erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur web local cmux est hors ligne. Démarrez-le et réessayez d’ouvrir la VM Cloud."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خادم الويب المحلي لـ cmux غير متصل بالإنترنت. قم بتشغيله وأعد محاولة فتح الجهاز الافتراضي السحابي (Cloud VM)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor web local de cmux está desconectado. Inícialo y vuelve a intentar Abrir Cloud VM."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本地 cmux 網頁伺服器已離線。請啟動它並重試開啟 Cloud VM。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 cmux 웹 서버가 오프라인 상태입니다. 서버를 시작하고 Cloud VM 열기를 다시 시도하세요."
          }
        }
      }
    },
    "panel.cloudVM.loading.failed.missingCommand": {
      "extractionState": "manual",
