    "machines.sessionRejected.signInAgain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign Out & Sign In Again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインアウトして再サインイン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出登录并重新登录"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abmelden & erneut anmelden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
