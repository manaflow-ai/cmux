    "cli.localTmux.error.cleanupListFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "local-tmux cleanup could not list sessions; the registry was left unchanged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "local-tmux のクリーンアップでセッションを一覧表示できなかったため、レジストリは変更されませんでした。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "local-tmux cleanup konnte keine Sitzungen auflisten; die Registrierung blieb unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "local-tmux cleanup n'a pas pu lister les sessions ; le registre est resté inchangé."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على تنظيف local-tmux سرد الجلسات؛ ولم يتم تغيير السجل (registry)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "la limpieza de local-tmux no pudo listar las sesiones; el registro no se modificó."
