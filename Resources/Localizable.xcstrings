    "account.signIn.error.invalidLink.recovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again to create a fresh secure link. The old link cannot sign in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度試して新しい安全なリンクを作成してください。古いリンクではサインインできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重试以创建新的安全链接。旧链接无法用于登录。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie es erneut, um einen neuen sicheren Link zu erstellen. Der alte Link kann nicht zur Anmeldung verwendet werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez pour générer un nouveau lien sécurisé. L'ancien lien ne permet pas de se connecter."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد المحاولة لإنشاء رابط آمن جديد. لا يمكن استخدام الرابط القديم لتسجيل الدخول."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a intentarlo para crear un nuevo enlace seguro. El enlace anterior ya no sirve para iniciar sesión."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新嘗試以建立新的安全連結。舊的連結無法用於登入。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 보안 링크를 생성하려면 다시 시도하세요. 이전 링크로는 로그인할 수 없습니다."
          }
        }
      }
    },
    "account.signIn.error.invalidLink.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
