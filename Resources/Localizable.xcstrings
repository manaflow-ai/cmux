    "computerUse.onboarding.done.detailReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup is complete. You can now ask cmux to use apps on your Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定が完了しました。cmuxにこのMac上のアプリの操作を依頼できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置已完成。现在你可以让 cmux 使用这台 Mac 上的应用了。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einrichtung ist abgeschlossen. Sie können cmux nun bitten, Apps auf Ihrem Mac zu verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration est terminée. Vous pouvez maintenant demander à cmux d’utiliser des applications sur votre Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتمل الإعداد. يمكنك الآن مطالبة cmux باستخدام التطبيقات على جهاز Mac الخاص بك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración ha finalizado. Ahora puedes pedirle a cmux que use aplicaciones en tu Mac."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定已完成。您現在可以要求 cmux 操作您 Mac 上的應用程式。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
