    "machines.new.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cloud computer with devtools and coding agents preinstalled. Its home directory is reset when the machine is recreated."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発ツールとコーディングエージェントがプリインストールされたクラウドコンピュータ。マシンを再作成するとホームディレクトリはリセットされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一台预装了开发工具和编码代理的云端计算机。它会在多次会话之间保留主目录。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Cloud-Computer mit vorinstallierten Entwicklertools und Coding-Agents. Er behält sein Home-Verzeichnis zwischen Sitzungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ordinateur cloud avec outils de développement et agents de codage préinstallés. Il conserve son dossier personnel d’une session à l’autre."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كمبيوتر سحابي مزود بأدوات تطوير ووكلاء برمجة مثبتين مسبقًا. ويحتفظ بدليل المجلد الرئيسي (home directory) الخاص به بين الجلسات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una computadora en la nube con herramientas de desarrollo y agentes de programación preinstalados. Conserva su directorio de inicio entre sesiones."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預裝開發人員工具與編碼代理的雲端電腦。它會在不同工作階段之間保留其家目錄。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발 도구와 코딩 에이전트가 사전 설치된 클라우드 컴퓨터입니다. 세션 간에 홈 디렉토리가 유지됩니다."
          }
        }
      }
    },
    "machines.new.subtitle.base": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Base is your persistent cloud machine. Opening it later reuses this same machine; reset Base to start over."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Base は永続的なクラウドマシンです。次回以降も同じマシンが開きます。最初からやり直すには Base をリセットしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Base 是你的持久云端机器。以后打开时仍会复用同一台；重置 Base 可从头开始。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Base ist deine persistente Cloud-Maschine. Späteres Öffnen verwendet dieselbe Maschine wieder; setze Base zurück, um von vorn zu beginnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Base est votre machine cloud persistante. L’ouvrir plus tard réutilise cette même machine ; réinitialisez Base pour recommencer à zéro."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن Base هو جهازك السحابي المستمر. فتحه لاحقًا يعيد استخدام هذا الجهاز نفسه؛ قم بإعادة تعيين Base للبدء من جديد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Base es tu máquina persistente en la nube. Al abrirla más tarde se reutiliza esta misma máquina; restablece Base para empezar de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Base 是您的持久性雲端機器。稍後開啟將重複使用同一部機器；重設 Base 以重新開始。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Base는 지속적인 클라우드 머신입니다. 나중에 열면 동일한 머신을 재사용하며, 처음부터 다시 시작하려면 Base를 재설정하십시오."
          }
        }
      }
    },
