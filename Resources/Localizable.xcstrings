    "simulator.failure.webInspectorAttachFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The isolated worker could not attach the selected inspector target."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分離されたワーカーは選択したWeb Inspector対象に接続できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隔离工作进程无法连接所选的检查器目标。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der isolierte Worker konnte das ausgewählte Inspektor-Ziel nicht anhängen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le worker isolé n’a pas pu attacher la cible d’inspecteur sélectionnée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتمكن العامل المعزول من إرفاق هدف المفتش المحدد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El worker aislado no pudo vincular el objetivo del inspector seleccionado."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隔離的工作者無法附加選取的檢查器目標。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분리된 워커가 선택한 웹 검사기 대상에 연결하지 못했습니다."
          }
        }
      }
    },
    "simulator.failure.webInspectorCapability": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
