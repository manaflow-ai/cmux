    "cli.codexTeams.watcher.subagent.readinessFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux codex-teams watcher could not attach a Codex subagent because its resumed thread was not ready."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux codex-teams ウォッチャーは、再開されたスレッドの準備ができていないため Codex サブエージェントをアタッチできませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux codex-teams 监视器无法附加 Codex 子代理，因为其恢复的线程尚未就绪。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux codex-teams-Watcher konnte keinen Codex-Subagenten anhängen, da sein fortgesetzter Thread nicht bereit war."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’observateur cmux codex-teams n’a pas pu attacher un sous-agent Codex car son thread repris n’était pas prêt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على مراقب cmux codex-teams إرفاق وكيل Codex فرعي لأن تسلسله المستأنف (resumed thread) لم يكن جاهزًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El observador de cmux codex-teams no pudo acoplar un subagente de Codex porque su hilo reanudado no estaba listo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux codex-teams watcher 無法連接 Codex 子代理，因為其已恢復的執行緒尚未就緒。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재개된 스레드가 준비되지 않아 cmux codex-teams watcher가 Codex 서브에이전트를 첨부할 수 없습니다."
          }
        }
      }
    },
