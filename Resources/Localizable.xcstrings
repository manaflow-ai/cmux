    "cli.workflow.quick-agent-buttons.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put Codex and Claude launch actions on the tab bar and in Command Palette."
          }
        },
        "de": {
