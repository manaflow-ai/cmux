    "cli.error.notifyClearSurfaceRequiresTarget": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface requires workspace or window context; specify --workspace or --window"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "notify --clear --surface にはワークスペースまたはウィンドウのコンテキストが必要です。--workspace または --window を指定してください"
          }
        },
        "ar": {
