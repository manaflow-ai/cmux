    "cli.events.error.timeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timed out waiting for a matching event"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一致するイベントを待機中にタイムアウトしました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待匹配事件超时"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung beim Warten auf ein passendes Ereignis"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Délai d’attente dépassé lors de l’attente d’un événement correspondant"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت المهلة أثناء انتظار حدث مطابق"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el tiempo de espera buscando un evento coincidente"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等候相符事件逾時"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일치하는 이벤트를 기다리는 동안 시간 초과가 발생했습니다."
          }
        }
      }
    },
    "cli.events.help.snapshot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Print the subscription snapshot and exit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購読スナップショットを表示して終了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독 스냅샷을 출력하고 종료"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вивести знімок підписки та завершити роботу"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打印订阅快照后退出"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Abonnement-Snapshot ausgeben und beenden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche l’instantané d'abonnement et quitte"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طباعة لقطة الاشتراك والخروج"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la instantánea de la suscripción y sale"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "列印訂閱快照並結束"
          }
        }
      }
    },
    "cli.events.help.timeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exit unsuccessfully if no matching event arrives before the deadline"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限までに一致するイベントが届かない場合はエラーで終了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제한 시간 전에 일치하는 이벤트가 도착하지 않으면 오류로 종료"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершити з помилкою, якщо відповідна подія не надійде до кінцевого терміну"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若在截止前没有匹配事件到达，则以失败退出"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlgeschlagen beenden, wenn vor Ablauf der Frist kein passendes Ereignis eintrifft"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitte en échec si aucun événement correspondant n’arrive avant l’échéance"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخروج غير الناجح في حال عدم وصول أي حدث مطابق قبل الموعد النهائي"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale de forma incorrecta si no llega ningún evento coincidente antes del tiempo límite"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果在截止時間前沒有相符事件到達，則結束並顯示失敗"
          }
        }
      }
    },
