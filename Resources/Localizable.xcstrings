    "settings.networking.attention": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved relay choice needs attention. Direct Iroh remains available, but cmux will not substitute an unselected relay."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したリレーの選択を確認してください。Iroh の直接接続は利用できますが、cmux が未選択のリレーへ切り替えることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的中继选择需要处理。直连 Iroh 仍然可用，但 cmux 不会替换为未选择的中继。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre gespeicherte Relay-Auswahl erfordert Aufmerksamkeit. Direktes Iroh bleibt verfügbar, aber cmux wird kein nicht ausgewähltes Relay ersetzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre choix de relais enregistré requiert votre attention. Direct Iroh reste disponible, mais cmux ne substituera pas un relais non sélectionné."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خيار الترحيل المحفوظ الخاص بك يتطلب الاهتمام. يظل Direct Iroh متاحًا، ولكن لن يستبدل cmux مرحلاً غير محدد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu opción de retransmisión guardada requiere atención. El canal directo de Iroh sigue estando disponible, pero cmux no sustituirá una retransmisión no seleccionada."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您儲存的中繼選擇需要注意。直接 Iroh 連線仍可使用，但 cmux 不會自動替換為未選擇的中繼。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 릴레이 선택 사항에 주의가 필요합니다. 직접 Iroh는 계속 사용할 수 있지만, cmux는 선택되지 않은 릴레이로 대체하지 않습니다."
          }
        }
      }
    },
    "settings.networking.check.action.account": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm you are signed in, then reopen cmux and run the check again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインを確認し、cmux を開き直してからもう一度確認してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigen Sie, dass Sie angemeldet sind, öffnen Sie dann cmux erneut und führen Sie die Prüfung erneut durch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez que vous êtes connecté, puis rouvrez cmux et réexécutez la vérification."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد من تسجيل الدخول، ثم أعد فتح cmux وقم بتشغيل التحقق مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme que ha iniciado sesión, luego vuelva a abrir cmux y ejecute la verificación nuevamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認您已登錄，然後重新開啟 cmux 並再次執行檢查。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认你已登录，然后重新打开 cmux 并再次运行检查。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인되었는지 확인한 다음 cmux를 다시 열고 확인을 다시 실행하세요."
          }
        }
      }
    },
    "settings.networking.check.action.internet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect this Mac to the internet, then run the check again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac をインターネットに接続してから、もう一度確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请让这台 Mac 连上互联网，然后再次运行检查。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie diesen Mac mit dem Internet und führen Sie die Prüfung erneut durch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez ce Mac à Internet, puis relancez la vérification."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتوصيل جهاز Mac هذا بالإنترنت، ثم قم بإجراء الفحص مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta esta Mac a internet y luego vuelve a realizar la comprobación."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將此 Mac 連線至網際網路，然後重新執行檢查。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac을 인터넷에 연결한 후 검사를 다시 실행하세요."
          }
        }
      }
    },
    "settings.networking.check.action.mac": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep cmux open and confirm both apps use the same account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux を開いたままにし、両方のアプリが同じアカウントを使用していることを確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持 cmux 打开，并确认两个应用使用同一个账户。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie cmux geöffnet und bestätigen Sie, dass beide Apps dasselbe Konto verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez cmux ouvert et vérifiez que les deux applications utilisent le même compte."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ cmux مفتوحًا وتأكد من أن كلا التطبيقين يستخدمان الحساب نفسه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén cmux abierto y confirma que ambas aplicaciones usen la misma cuenta."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持 cmux 開啟，並確認兩個應用程式皆使用同一個帳戶。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux를 열어두고 두 앱이 동일한 계정을 사용하는지 확인하세요."
          }
        }
      }
    },
    "settings.networking.check.action.relay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your network may block relay traffic. Ask IT to allow HTTPS and WebSocket access to your configured cmux relay domains, or add an approved custom relay."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークがリレートラフィックを遮断している可能性があります。設定済みの cmux リレードメインへの HTTPS と WebSocket アクセスを許可するよう IT 部門に依頼するか、承認済みのカスタムリレーを追加してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Netzwerk blockiert möglicherweise den Relay-Verkehr. Bitten Sie die IT, HTTPS- und WebSocket-Zugriff auf Ihre konfigurierten cmux-Relay-Domänen zuzulassen, oder fügen Sie ein genehmigtes benutzerdefiniertes Relay hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre réseau peut bloquer le trafic de relais. Demandez au service informatique d'autoriser l'accès HTTPS et WebSocket à vos domaines de relais cmux configurés, ou ajoutez un relais personnalisé approuvé."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تقوم شبكتك بحظر حركة مرور الترحيل. اطلب من قسم تكنولوجيا المعلومات السماح بوصول HTTPS وWebSocket إلى مجالات ترحيل cmux التي تم تكوينها، أو إضافة ترحيل مخصص معتمد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su red puede bloquear el tráfico de retransmisión. Pídale a TI que permita el acceso HTTPS y WebSocket a sus dominios de retransmisión cmux configurados, o agregue una retransmisión personalizada aprobada."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的網路可能會阻止中繼流量。請求 IT 允許 HTTPS 和 WebSocket 存取您配置的 cmux 中繼域，或新增經批准的自訂中繼。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的网络可能拦截了中继流量。请让 IT 放行到你所配置的 cmux 中继域名的 HTTPS 与 WebSocket 访问，或添加一个已批准的自定义中继。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크에서 릴레이 트래픽을 차단할 수 있습니다. 구성된 cmux 릴레이 도메인에 대한 HTTPS 및 WebSocket 액세스를 허용하도록 IT에 요청하거나 승인된 사용자 지정 릴레이를 추가하세요."
          }
        }
      }
    },
    "settings.networking.check.action.repair": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update cmux on both devices. If needed, pair them again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方のデバイスで cmux を更新してください。必要に応じて再度ペアリングしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在两台设备上都更新 cmux。必要时重新配对。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren Sie cmux auf beiden Geräten. Koppeln Sie sie bei Bedarf erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour cmux sur les deux appareils. Si nécessaire, jumelez-les à nouveau."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتحديث cmux على كلا الجهازين. وإذا لزم الأمر، قم باقترانهما مجددًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza cmux en ambos dispositivos. Si es necesario, vuelve a vincularlos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新兩部裝置上的 cmux。如有需要，請重新配對。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "양쪽 기기 모두에서 cmux를 업데이트하세요. 필요한 경우 다시 페어링하세요."
          }
        }
      }
    },
    "settings.networking.check.action.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry. If this continues, share the safe report with cmux support."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行してください。問題が続く場合は、安全なレポートを cmux サポートと共有してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederholen. Wenn dies weiterhin der Fall ist, teilen Sie den sicheren Bericht mit dem cmux-Support."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez. Si cela continue, partagez le rapport sécurisé avec le support cmux."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد المحاولة. إذا استمر هذا الأمر، قم بمشاركة التقرير الآمن مع دعم cmux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rever. Si esto continúa, comparta el informe seguro con el soporte de cmux."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重試。如果這種情況持續存在，請與 cmux 支援人員共用安全性報告。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重试。若问题持续，请把安全报告发给 cmux 支持团队。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 해 보다. 이 문제가 계속되면 cmux 지원팀과 안전 보고서를 공유하세요."
          }
        }
      }
    },
    "settings.networking.check.action.settings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Automatic relay selection, or fix the selected custom relay and its device secret."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リレー選択を「自動」にするか、選択したカスタムリレーとデバイスシークレットを修正してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie „Automatische Relay-Auswahl“ oder korrigieren Sie das ausgewählte benutzerdefinierte Relay und sein Gerätegeheimnis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez Sélection automatique du relais ou corrigez le relais personnalisé sélectionné et son secret de périphérique."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر تحديد التتابع التلقائي، أو أصلح المرحل المخصص المحدد وسر الجهاز الخاص به."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija Selección automática de relé o corrija el relé personalizado seleccionado y su secreto de dispositivo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇自動繼電器選擇，或修復選定的自訂繼電器及其設備密碼。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择「自动选择中继」，或修正所选的自定义中继及其设备密钥。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 릴레이 선택을 선택하거나 선택한 사용자 지정 릴레이 및 해당 장치 비밀을 수정합니다."
          }
        }
      }
    },
    "settings.networking.check.allowlist.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow outbound HTTPS and WebSocket access to these cmux relay origins:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の cmux リレーオリジンへの送信 HTTPS および WebSocket アクセスを許可してください:"
          }
        },
        "de": {
          "stringUnit": {
