    "cli.ssh.autoReconnect.status": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] انتهى ssh بالحالة %s؛ جارٍ إعادة الاتصال (المحاولة %s/%s)."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh je završio sa statusom %s; ponovno povezivanje (pokušaj %s/%s)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh afsluttede med status %s; genopretter forbindelse (forsøg %s/%s)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh wurde mit Status %s beendet; erneuter Verbindungsaufbau (Versuch %s/%s)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh exited with status %s; reconnecting (attempt %s/%s)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh terminó con el estado %s; reconectando (intento %s/%s)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh s’est arrêté avec l’état %s ; reconnexion (tentative %s/%s)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh è terminato con stato %s; riconnessione in corso (tentativo %s/%s)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh はステータス %s で終了しました。再接続しています（試行 %s/%s）。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh បានបញ្ចប់ដោយស្ថានភាព %s; កំពុងភ្ជាប់ឡើងវិញ (ការព្យាយាម %s/%s)។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh가 상태 %s로 종료되었습니다. 다시 연결 중입니다(시도 %s/%s)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh avsluttet med status %s; kobler til på nytt (forsøk %s/%s)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh zakończył działanie ze statusem %s; ponowne łączenie (próba %s/%s)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh saiu com status %s; reconectando (tentativa %s/%s)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh завершился со статусом %s; переподключение (попытка %s/%s)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh ออกจากการทำงานด้วยสถานะ %s; กำลังเชื่อมต่อใหม่ (ครั้งที่ %s/%s)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh %s durumuyla çıktı; yeniden bağlanıyor (deneme %s/%s)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh завершився зі статусом %s; повторне підключення (спроба %s/%s)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh 已退出，状态为 %s；正在重新连接（第 %s/%s 次）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh 已結束，狀態為 %s；正在重新連線（第 %s/%s 次）。"
          }
        }
      }
    },
    "cli.ssh.autoReconnect.recovered": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] SSH reconnected (attempt %s/%s)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
