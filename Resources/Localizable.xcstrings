    "settings.networking.private.tailscale.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retained for released clients and networks where Iroh cannot connect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リリース済みクライアントと Iroh が接続できないネットワーク向けに維持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为已发布的客户端以及 Iroh 无法连接的网络保留。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beibehalten für freigegebene Clients und Netzwerke, bei denen Iroh keine Verbindung herstellen kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservé pour les clients privés et les réseaux où Iroh ne peut pas se connecter."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مخصص للعملاء الذين تم إصدارهم والشبكات التي لا يمكن لـ Iroh الاتصال بها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retenido para clientes publicados y redes donde Iroh no se puede conectar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為已發行的用戶端以及 Iroh 無法連線的網路所保留。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출시된 클라이언트 및 Iroh가 연결할 수 없는 네트워크를 위해 유지됩니다."
          }
        }
      }
    },
