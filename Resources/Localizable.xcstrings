    "shortcut.when.caption.browserFocus": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط أثناء تركيز لوحة المتصفح"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo dok okno preglednika ima fokus"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun mens et browserpanel har fokus"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur solange ein Browser-Pane fokussiert ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only while a browser pane is focused"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo mientras un panel del navegador tiene el foco"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement lorsqu'un panneau de navigateur a le focus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo mentre un riquadro del browser ha il focus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザペインにフォーカスがあるときのみ"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "តែពេលផ្ទាំង browser មាន focus ប៉ុណ្ណោះ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 패널에 포커스가 있는 동안에만"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare mens et nettleserpanel har fokus"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko gdy panel przeglądarki ma fokus"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente enquanto um painel do navegador está em foco"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только пока панель браузера в фокусе"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะเมื่อเพนเบราว์เซอร์อยู่ในโฟกัสเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bir tarayıcı bölmesi odaktayken"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише поки панель браузера у фокусі"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当浏览器窗格获得焦点时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在瀏覽器窗格取得焦點時"
          }
        }
      }
    },
    "shortcut.when.caption.browserOrFilePreviewTextEditorFocus": {
      "extractionState": "manual",
