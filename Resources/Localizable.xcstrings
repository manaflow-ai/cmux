          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法刪除 cmux 瀏覽器設定檔「%@」，因為仍有 %#@count2@"
          },
          "substitutions": {
            "count2": {
              "argNum": 2,
              "formatSpecifier": "d",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%d 個瀏覽器面板正在使用它"
                    }
                  }
                }
              }
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 브라우저 프로필 '%@'을(를) 삭제할 수 없습니다. 현재 %#@count2@ 사용 중입니다."
          },
          "substitutions": {
            "count2": {
              "argNum": 2,
              "formatSpecifier": "d",
              "variations": {
                "plural": {
