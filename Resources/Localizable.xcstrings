    "machines.empty.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A machine is a persistent cloud computer. It keeps your files forever and costs nothing while it sleeps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンは永続的なクラウドコンピュータです。ファイルはずっと保持され、スリープ中は料金がかかりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机器是一台持久的云端计算机。它会一直保存你的文件，休眠时不产生任何费用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Maschine ist ein dauerhafter Cloud-Computer. Er bewahrt deine Dateien für immer auf und kostet nichts, während er schläft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une machine est un ordinateur cloud persistant. Elle conserve vos fichiers indéfiniment et ne coûte rien lorsqu’elle est en veille."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجهاز هو كمبيوتر سحابي مستمر. يحتفظ بملفاتك إلى الأبد ولا يكلف شيئًا أثناء خموله."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una máquina es una computadora persistente en la nube. Conserva tus archivos para siempre y no cuesta nada mientras está inactiva."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "機器是持久的雲端電腦。它會永久保留您的檔案，且在睡眠時不收取任何費用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머신은 지속적인 클라우드 컴퓨터입니다. 파일을 영구적으로 보관하며, 절전 상태일 때는 비용이 전혀 들지 않습니다."
          }
        }
      }
    },
