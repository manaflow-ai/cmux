    "settings.shortcuts.showModifierHoldHints.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holding Cmd or Control does not show shortcut hint chips."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd または Control を押し続けてもショートカットヒントのチップを表示しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
