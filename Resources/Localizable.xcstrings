    },
    "simulator.failure.webInspectorRequestIDRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Web Inspector command must contain a string or numeric id."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Web Inspectorコマンドには文字列または数値のIDが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Web 检查器命令必须包含字符串或数字类型的 id。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Web-Inspektor-Befehl muss eine String- oder numerische ID enthalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
