    "featureFlags.cloudVM.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows Cloud VM entrypoints in the new-workspace dropdown and command palette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
