    "workspaceGroup.error.allChildrenAreAnchors": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All requested children are ineligible because they are already group anchors; ungroup them first"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要求された子ワークスペースはすべて既にグループのアンカーのため対象外です。先にグループ解除してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所请求的子项均不符合条件，因为它们已经是分组锚点；请先取消它们的分组"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle angeforderten untergeordneten Elemente sind ungeeignet, da sie bereits Gruppenanker sind; hebe zuerst deren Gruppierung auf"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les enfants demandés ne sont pas éligibles car ils sont déjà des ancres de groupe ; dissociez-les d’abord"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جميع العناصر التابعة المطلوبة غير مؤهلة لأنها بالفعل مرتكزات للمجموعة؛ قم بفك تجميعها أولاً"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los elementos secundarios solicitados no son válidos porque ya son anclajes de grupo; desagrópalos primero"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有要求的子項目皆不符合資格，因為它們已經是群組錨點；請先取消群組"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청한 모든 하위 항목이 이미 그룹 앵커이므로 대상이 될 수 없습니다. 먼저 그룹을 해제해 주세요."
          }
        }
      }
    },
