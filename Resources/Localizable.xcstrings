    "cli.fork.error.workingDirectoryFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: دليل العمل المحفوظ غير قابل للوصول. قم باستعادة الوصول إليه، ثم أعد المحاولة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: sačuvani radni direktorij je nedostupan. Vratite mu pristup, a zatim pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: den gemte arbejdsmappe er utilgængelig. Gendan adgangen til den, og prøv derefter igen."
          }
        },
        "de": {
          "stringUnit": {
