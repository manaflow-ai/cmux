    "cli.fork.error.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: هذا الوكيل لا يدعم التفرع. قم بتكوين أمر fork لهذا الوكيل، ثم أعد المحاولة."
