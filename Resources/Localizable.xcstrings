    "sidebar.help.feedback.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many feedback attempts. Please try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
