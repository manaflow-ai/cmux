    "dock.error.loadFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل إعدادات Dock. تحقق من dock.json وحاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Učitavanje Dock konfiguracije nije uspjelo. Provjerite dock.json i pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock-konfigurationen kunne ikke indlæses. Tjek dock.json, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dock-Konfiguration konnte nicht geladen werden. Überprüfe dock.json und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load the Dock config. Check dock.json and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar la configuración de Dock. Comprueba dock.json e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger la configuration du Dock. Vérifiez dock.json et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare la configurazione del Dock. Controlla dock.json e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock設定を読み込めませんでした。dock.jsonを確認してからもう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចផ្ទុកការកំណត់រចនាសម្ព័ន្ធ Dock បានទេ។ ពិនិត្យ dock.json រួចព្យាយាមម្ដងទៀត។"
