        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到 cmux-tui 客户端（已查找：%1$@）。用 `curl -fsSL https://cmux.com/tui/install-static.sh | sh` 安装一个，或把 CMUX_TUI_CLIENT 指向某个二进制文件。"
          }
