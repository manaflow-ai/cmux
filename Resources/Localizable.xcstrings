    "settings.app.canvasSnapping.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلتقط سحب الأجزاء وتغيير حجمها إلى الحواف المجاورة وتباعد الأجزاء. اضغط مع الاستمرار على Command لتعليق الالتقاط أثناء إيماءة واحدة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijanja prevlačenja i promjene veličine okana uz susjedne ivice i razmak. Držite Command da privremeno isključite prijanjanje za jedan potez."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastgør rudetræk og størrelsesændringer til nabokanter og rudeafstanden. Hold Kommando nede for at suspendere fastgørelse for én bevægelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel-Bewegungen und -Größenänderungen rasten an Nachbarkanten und am Panel-Abstand ein. Command halten, um das Einrasten für eine Geste auszusetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snap pane drags and resizes to neighbor edges and the pane gap. Hold Command to suspend snapping for one gesture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta los arrastres y cambios de tamaño de paneles a los bordes vecinos y a la separación. Mantén pulsada Comando para suspender el ajuste durante un gesto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aimante les déplacements et redimensionnements de panneaux aux bords voisins et à l'espacement. Maintenez Commande pour suspendre l'aimantation le temps d'un geste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggancia trascinamenti e ridimensionamenti dei riquadri ai bordi vicini e alla spaziatura. Tieni premuto Comando per sospendere l'aggancio per un gesto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペインのドラッグやリサイズを隣のペインの端や間隔にスナップします。Commandキーを押している間はスナップを一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창을 드래그하거나 크기를 조절할 때 인접한 가장자리와 간격에 스냅합니다. Command 키를 누르면 해당 제스처 동안 스냅이 일시 중지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fester rutedragninger og størrelsesendringer til nabokanter og ruteavstanden. Hold Kommando for å suspendere festing for én bevegelse."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyciąga przeciąganie i zmianę rozmiaru paneli do sąsiednich krawędzi i odstępu. Przytrzymaj Command, aby zawiesić przyciąganie na czas jednego gestu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaixa arrastos e redimensionamentos de painéis nas bordas vizinhas e no espaçamento. Segure Command para suspender o encaixe durante um gesto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привязывает перетаскивание и изменение размера панелей к соседним краям и отступу. Удерживайте Command, чтобы отключить привязку на время жеста."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแนปการลากและการปรับขนาดบานหน้าต่างเข้ากับขอบข้างเคียงและระยะห่าง กด Command ค้างเพื่อระงับการสแนปชั่วคราว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bölme sürükleme ve yeniden boyutlandırmayı komşu kenarlara ve bölme aralığına yapıştırır. Bir hareket boyunca yapışmayı askıya almak için Command tuşunu basılı tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прилипання перетягування та зміни розміру панелей до сусідніх країв і відступу. Утримуйте Command, щоб призупинити прилипання на час жесту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动或调整窗格大小时吸附到相邻边缘和窗格间距。按住 Command 可临时禁用吸附。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動或調整窗格大小時吸附到相鄰邊緣和窗格間距。按住 Command 可暫時停用吸附。"
          }
        }
      }
    },
    "settings.app.closeWorkspaceOnLastSurfaceShortcut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Workspace Open When Closing Last Surface"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後のサーフェスを閉じてもワークスペースを残す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 서피스를 닫을 때 워크스페이스 유지"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишати робочу область відкритою при закритті останньої поверхні"
          }
        }
      }
    },
    "settings.app.closeWorkspaceOnLastSurfaceShortcut.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the focused surface is the last one in its workspace, closing it with the close-surface shortcut, tab close button, or middle-click also closes the workspace."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス中のサーフェスがそのワークスペースの最後の1つなら、サーフェスを閉じるショートカット、タブの閉じるボタン、タブの中クリックはワークスペースも閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스된 서피스가 워크스페이스의 마지막일 때, 서피스 닫기 단축키, 탭 닫기 버튼, 탭 가운데 클릭으로 워크스페이스도 함께 닫힙니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли активна поверхня є останньою у робочій області, комбінація закриття поверхні, кнопка закриття вкладки та клацання середньою кнопкою по вкладці також закривають робочу область."
          }
        }
      }
    },
    "settings.app.closeWorkspaceOnLastSurfaceShortcut.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the focused surface is the last one in its workspace, closing it with the close-surface shortcut, tab close button, or middle-click closes only the surface and keeps the workspace open. Use the close-workspace shortcut to close the workspace explicitly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス中のサーフェスがそのワークスペースの最後の1つでも、サーフェスを閉じるショートカット、タブの閉じるボタン、タブの中クリックはサーフェスだけを閉じ、ワークスペースは残します。ワークスペースを閉じるショートカットを使うと明示的に閉じられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스된 서피스가 워크스페이스의 마지막일 때, 서피스 닫기 단축키, 탭 닫기 버튼, 탭 가운데 클릭으로 서피스만 닫고 워크스페이스는 유지됩니다. 워크스페이스를 닫으려면 워크스페이스 닫기 단축키를 사용하세요."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли активна поверхня є останньою у робочій області, комбінація закриття поверхні, кнопка закриття вкладки та клацання середньою кнопкою по вкладці закривають лише поверхню, залишаючи робочу область відкритою. Використовуйте комбінацію закриття робочої області для явного закриття."
          }
        }
      }
    },
