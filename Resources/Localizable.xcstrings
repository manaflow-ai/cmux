    "cli.vm.layoutEnv.thisMachineSCmuxShimPredatesValueSupportReconnectIt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "this machine's cmux shim predates %1$@ support — reconnect it (cmux vm tree %2$@ --refresh) to heal, then retry"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن cmux shim الخاص بهذا الجهاز يسبق دعم %1$@ — أعد توصيله (cmux vm tree %2$@ --refresh) للإصلاح، ثم أعد المحاولة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux shim na ovom uređaju je stariji od podrške za %1$@ — ponovo ga povežite (cmux vm tree %2$@ --refresh) kako biste to ispravili, pa pokušajte ponovo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "denne maskines cmux shim er ældre end %1$@-understøttelse — tilslut den igen (cmux vm tree %2$@ --refresh) for at udbedre fejlen, og prøv derefter igen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der cmux-Shim dieses Rechners ist älter als die Unterstützung für %1$@ — verbinden Sie ihn neu (cmux vm tree %2$@ --refresh), um dies zu beheben, und versuchen Sie es dann erneut"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "el shim cmux de esta máquina es anterior a la compatibilidad con %1$@ — vuelve a conectarlo (cmux vm tree %2$@ --refresh) para repararlo, luego vuelve a intentarlo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "le cmux shim de cette machine est antérieur à la prise en charge de %1$@ — reconnectez-le (cmux vm tree %2$@ --refresh) pour le réparer, puis réessayez"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "lo shim cmux di questa macchina è precedente al supporto di %1$@ — riconnettilo (cmux vm tree %2$@ --refresh) per correggere, poi riprova"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このマシンの cmux shim は %1$@ サポートより前のバージョンです — 再接続して修復し (cmux vm tree %2$@ --refresh)、再試行してください"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux shim នៃម៉ាស៊ីននេះចាស់ជាង %1$@ support — ភ្ជាប់វាឡើងវិញ (cmux vm tree %2$@ --refresh) ដើម្បីជួសជុល រួចព្យាយាមម្តងទៀត"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 머신의 cmux shim이 %1$@ 지원 이전의 구버전입니다 — 복구하려면 다시 연결(cmux vm tree %2$@ --refresh)한 후 다시 시도하십시오"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "denne maskinens cmux shim er eldre enn %1$@-støtte — koble den til på nytt (cmux vm tree %2$@ --refresh) for å rette opp, og prøv igjen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "shim cmux na tej maszynie nie obsługuje %1$@ — podłącz ponownie (cmux vm tree %2$@ --refresh), aby naprawić, i spróbuj ponownie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "o shim cmux desta máquina é anterior ao suporte a %1$@ — reconecte-o (cmux vm tree %2$@ --refresh) para corrigir e tente novamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "shim cmux на этой машине создан до появления поддержки %1$@ — переподключите его (cmux vm tree %2$@ --refresh) для исправления, затем повторите попытку"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux shim ของเครื่องนี้เก่ากว่าที่รองรับ %1$@ — เชื่อมต่อใหม่ (cmux vm tree %2$@ --refresh) เพื่อแก้ไข แล้วลองใหม่อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "bu makinenin cmux shim'i %1$@ desteğinden önce geliyor — iyileştirmek için yeniden bağlayın (cmux vm tree %2$@ --refresh), ardından tekrar deneyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "шим cmux на цій машині створено до підтримки %1$@ — перепідключіть його (cmux vm tree %2$@ --refresh) для виправлення, потім повторіть спробу"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此机器的 cmux shim 早于 %1$@ 支持 — 请重新连接（cmux vm tree %2$@ --refresh）以修复，然后重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此機器的 cmux shim 早於 %1$@ 支援 — 請重新連線 (cmux vm tree %2$@ --refresh) 以修復，然後重試"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux shim của máy này không hỗ trợ %1$@ — kết nối lại (cmux vm tree %2$@ --refresh) để khắc phục, rồi thử lại"
          }
        }
      }
    },
