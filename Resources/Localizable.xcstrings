            "value": "WebSocket"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WebSocket"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹소켓"
          }
        }
      }
    },
    "settings.mobile.routes.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No reachable addresses yet. Iroh routes need this Mac signed in to your cmux account; Tailscale routes need Tailscale running on this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "到達可能なアドレスがまだありません。Iroh 経路にはこの Mac が cmux アカウントにサインインしていることが、Tailscale 経路にはこの Mac で Tailscale が動作していることが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无可达地址。Iroh 路由需要这台 Mac 登录你的 cmux 账户；Tailscale 路由需要这台 Mac 上运行 Tailscale。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine erreichbaren Adressen. Iroh-Routen erfordern, dass dieser Mac bei Ihrem cmux-Konto angemeldet ist; Tailscale-Routen erfordern, dass Tailscale auf diesem Mac läuft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune adresse accessible pour le moment. Les routes Iroh nécessitent que ce Mac soit connecté à votre compte cmux ; les routes Tailscale nécessitent que Tailscale soit en cours d’exécution sur ce Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد عناوين يمكن الوصول إليها بعد. تحتاج مسارات Iroh إلى تسجيل دخول جهاز Mac هذا إلى حساب cmux الخاص بك؛ وتحتاج مسارات Tailscale إلى تشغيل Tailscale على جهاز Mac هذا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay direcciones accesibles. Las rutas de Iroh necesitan que esta Mac haya iniciado sesión en tu cuenta de cmux; las rutas de Tailscale necesitan que Tailscale esté ejecutándose en esta Mac."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前尚無可連線的地址。Iroh 路由需要此 Mac 登入您的 cmux 帳戶；Tailscale 路由則需要在此 Mac 上執行 Tailscale。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 도달 가능한 주소가 없습니다. Iroh 경로에는 이 Mac이 사용자의 cmux 계정에 로그인되어 있어야 하며, Tailscale 경로에는 이 Mac에서 Tailscale이 실행 중이어야 합니다."
          }
        }
      }
    },
    "settings.mobile.routes.title": {
      "extractionState": "manual",
      "localizations": {
