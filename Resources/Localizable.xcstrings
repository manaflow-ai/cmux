    "sleepyMode.settings.pets.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walks one cute pet for every Claude, Codex, and OpenCode agent you have running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中の Claude・Codex・OpenCode エージェントごとに、かわいいペットを歩かせます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为你正在运行的每个 Claude、Codex 和 OpenCode 代理放出一只可爱的宠物。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt für jeden deiner laufenden Claude-, Codex- und OpenCode-Agenten ein süßes Haustier Gassi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait promener un adorable compagnon pour chaque agent Claude, Codex et OpenCode en cours d’exécution."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم بتنزيه حيوان أليف لطيف واحد لكل وكيل Claude وCodex وOpenCode قيد التشغيل لديك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasea una adorable mascota por cada agente Claude, Codex y OpenCode que tengas en ejecución."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為您每個執行中的 Claude、Codex 和 OpenCode Agent 遛一隻可愛的寵物。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중인 Claude, Codex, OpenCode 에이전트당 한 마리의 귀여운 펫이 산책합니다."
          }
        }
      }
    },
