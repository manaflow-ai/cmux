    "socket.workspace.unsupportedWindowParam": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المعامل `window` غير مدعوم؛ استخدم `window_id` مع UUID للنافذة أو مرجع من `window.list`."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Parametar `window` nije podržan; koristite `window_id` s UUID-om prozora ili referencom iz `window.list`."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Parameteren `window` understøttes ikke; brug `window_id` med et vindues-UUID eller en reference fra `window.list`."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht unterstützter Parameter `window`; verwenden Sie `window_id` mit einer Fenster-UUID oder Referenz aus `window.list`."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsupported parameter `window`; use `window_id` with a window UUID or ref from `window.list`."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parámetro `window` no admitido; usa `window_id` con un UUID de ventana o una referencia de `window.list`."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paramètre `window` non pris en charge; utilisez `window_id` avec un UUID de fenêtre ou une référence de `window.list`."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parametro `window` non supportato; usa `window_id` con un UUID finestra o un riferimento da `window.list`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サポートされていないパラメータ `window` です。`window.list` のウィンドウ UUID または参照を指定して `window_id` を使用してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ប៉ារ៉ាម៉ែត្រ `window` មិនត្រូវបានគាំទ្រទេ; ប្រើ `window_id` ជាមួយ UUID របស់បង្អួច ឬការយោងពី `window.list`។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원되지 않는 매개변수 `window`입니다. `window.list`의 창 UUID 또는 참조와 함께 `window_id`를 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Parameteren `window` støttes ikke; bruk `window_id` med en vindus-UUID eller referanse fra `window.list`."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Parametr `window` nie jest obsługiwany; użyj `window_id` z UUID okna lub odwołaniem z `window.list`."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parâmetro `window` sem suporte; use `window_id` com um UUID de janela ou referência de `window.list`."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметр `window` не поддерживается; используйте `window_id` с UUID окна или ссылкой из `window.list`."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่รองรับพารามิเตอร์ `window`; ใช้ `window_id` พร้อม UUID ของหน้าต่างหรือการอ้างอิงจาก `window.list`"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "`window` parametresi desteklenmiyor; `window_id` değerini `window.list` içindeki bir pencere UUID'si veya başvuruyla kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметр `window` не підтримується; використовуйте `window_id` з UUID вікна або посиланням із `window.list`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持参数 `window`；请使用 `window_id`，并传入来自 `window.list` 的窗口 UUID 或引用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不支援參數 `window`；請使用 `window_id`，並傳入來自 `window.list` 的視窗 UUID 或參照。"
          }
        }
      }
    },
    "socketControl.allowAll.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح لأي عملية ومستخدم محلي بالاتصال بدون مصادقة. غير آمن."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvolite bilo kojem lokalnom procesu i korisniku da se poveže bez autentikacije. Nesigurno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad enhver lokal proces og bruger at forbinde uden autentifikation. Usikkert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden lokalen Prozess und Benutzer ohne Authentifizierung verbinden lassen. Unsicher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow any local process and user to connect with no auth. Unsafe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que cualquier proceso y usuario local se conecte sin autenticación. Inseguro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser tout processus et utilisateur local à se connecter sans authentification. Non sécurisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a qualsiasi processo e utente locale di connettersi senza autenticazione. Non sicuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証なしで任意のローカルプロセスおよびユーザーの接続を許可します。安全ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 없이 모든 로컬 프로세스 및 사용자의 연결을 허용합니다. 안전하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat enhver lokal prosess og bruker å koble til uten autentisering. Usikkert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól dowolnemu lokalnemu procesowi i użytkownikowi na połączenie bez uwierzytelniania. Niebezpieczne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que qualquer processo e usuário local se conecte sem autenticação. Inseguro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить подключение любому локальному процессу и пользователю без авторизации. Небезопасно."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้กระบวนการในเครื่องและผู้ใช้ทุกคนเชื่อมต่อโดยไม่ต้องยืนยันตัวตน ไม่ปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir yerel işlem ve kullanıcının kimlik doğrulama olmadan bağlanmasına izin ver. Güvensiz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволити будь-якому локальному процесу та користувачу підключатися без автентифікації. Небезпечно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
