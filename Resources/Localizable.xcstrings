    "settings.app.markdownFontSize.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default body font size, in points, for newly opened markdown viewers. Zoom a viewer live with Cmd-+ / Cmd-- / Cmd-0."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しく開く Markdown ビューアの本文フォントサイズ（ポイント単位）。Cmd-+ / Cmd-- / Cmd-0 でその場で拡大・縮小できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新打开的 Markdown 查看器的默认正文字号（磅）。可用 Cmd-+ / Cmd-- / Cmd-0 实时缩放查看器。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard-Schriftgröße für Fließtext in Punkten für neu geöffnete Markdown-Betrachter. Vergrößern/Verkleinern Sie die Ansicht live mit Cmd-+ / Cmd-- / Cmd-0."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille de police par défaut du corps de texte, en points, pour les lecteurs Markdown nouvellement ouverts. Ajustez le zoom d’un lecteur en direct avec Cmd-+ / Cmd-- / Cmd-0."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حجم الخط الافتراضي للنص، بالنقاط، لعارضي markdown المفتوحين حديثًا. كبّر العارض مباشرة باستخدام Cmd-+ / Cmd-- / Cmd-0."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño de fuente predeterminado del cuerpo, en puntos, para los visores de markdown recién abiertos. Amplía o reduce un visor en vivo con Cmd-+ / Cmd-- / Cmd-0."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新開啟的 Markdown 檢視器之預設內文字型大小（點數）。可使用 Cmd-+ / Cmd-- / Cmd-0 即時縮放檢視器。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로 열리는 마크다운 뷰어의 기본 본문 글꼴 크기(포인트 단위)입니다. Cmd-+ / Cmd-- / Cmd-0으로 뷰어를 실시간으로 확대/축소할 수 있습니다."
          }
        }
      }
    },
