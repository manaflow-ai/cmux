            "state": "translated",
            "value": "sudo: Tidsavbrudd må være et positivt heltall"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: limit czasu musi być dodatnią liczbą całkowitą"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: o tempo limite deve ser um número inteiro positivo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: время ожидания должно быть положительным целым числом."
