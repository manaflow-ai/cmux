          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "nota: los puntos de control de este agente son de solo lectura (la bifurcación aún no está soportada)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備註：此代理程式的檢查點為唯讀（目前尚不支援分支）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참고: 이 에이전트의 체크포인트는 보기 전용입니다 (포크는 아직 지원되지 않음)"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
