    "debug.sidebarFooterIconBalance.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tune each icon live, compare sharp and squint previews, then use the cards to explore Help weights."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各アイコンをライブ調整し、鮮明表示とスクイント表示を比較してから、カードでヘルプのウェイトを確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时调整每个图标，对比清晰预览和眯眼预览，然后用卡片探索「帮助」图标的字重。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passen Sie jedes Symbol live an, vergleichen Sie scharfe und zugekniffene Vorschauen, und verwenden Sie dann die Karten, um die Gewichte der Hilfe zu erkunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez chaque icône en direct, comparez les aperçus nets et flous (loucher), puis utilisez les cartes pour explorer les graisses de l'Aide."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط كل أيقونة مباشرة، وقارن بين المعاينات الحادة والمغشاة، ثم استخدم البطاقات لاستكشاف أوزان المساعدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste cada icono en vivo, compare las vistas previas nítidas y con ojos entrecerrados, luego use las tarjetas para explorar los pesos de Ayuda."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時微調每個圖示，比對清晰與瞇眼預覽，然後使用卡片探索「說明」權重。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 아이콘을 실시간으로 조정하고, 선명한 미리보기와 실눈 미리보기를 비교한 다음 카드를 사용하여 도움말 가중치를 탐색해 보세요."
          }
        }
      }
    },
