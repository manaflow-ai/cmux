    "cli.forwarding.error.execFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على cmux بدء أداة واجهة خط الأوامر من حزمة التطبيق (app bundle). أعد تثبيت cmux أو قم بتشغيل الأمر من تثبيت cmux CLI قياسي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux could not start the command-line tool from the app bundle. Reinstall cmux or run the command from a standard cmux CLI installation."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux could not start the command-line tool from the app bundle. Reinstall cmux or run the command from a standard cmux CLI installation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux konnte das Befehlszeilenwerkzeug nicht aus dem App-Bundle starten. Installieren Sie cmux neu oder führen Sie den Befehl aus einer Standard-cmux-CLI-Installation aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux could not start the command-line tool from the app bundle. Reinstall cmux or run the command from a standard cmux CLI installation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no pudo iniciar la herramienta de línea de comandos desde el paquete de la aplicación. Reinstala cmux o ejecuta el comando desde una instalación estándar de la CLI de cmux."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux n'a pas pu démarrer l'outil en ligne de commande à partir du bundle d'application. Réinstallez cmux ou exécutez la commande à partir d'une installation CLI cmux standard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux could not start the command-line tool from the app bundle. Reinstall cmux or run the command from a standard cmux CLI installation."
