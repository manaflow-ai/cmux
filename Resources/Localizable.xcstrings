    "cli.fork.error.unsupportedMode": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: بيانات الشوكة المحفوظة لهذه الجلسة غير متوافقة. قم بتشغيل الوكيل مرة أخرى في هذه المحطة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: sačuvani podaci račvanja ove sesije nisu kompatibilni. Ponovo pokrenite agenta u ovom terminalu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: denne sessions gemte gaffeldata er ikke kompatible. Start agenten igen i denne terminal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: Die gespeicherten Fork-Daten dieser Sitzung sind nicht kompatibel. Starten Sie den Agenten in diesem Terminal erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: this session's saved fork data is not compatible. Start the agent again in this terminal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: Los datos de bifurcación guardados de esta sesión no son compatibles. Inicie el agente nuevamente en esta terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: les données de fork enregistrées de cette session ne sont pas compatibles. Redémarrez l'agent dans ce terminal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: i dati fork salvati di questa sessione non sono compatibili. Avvia nuovamente l'agente in questo terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: このセッションの保存済みフォークデータには互換性がありません。このターミナルでエージェントをもう一度起動してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: ទិន្នន័យ fork ដែលបានរក្សាទុកនៃវគ្គនេះមិនត្រូវគ្នាទេ។ ចាប់ផ្តើមភ្នាក់ងារម្តងទៀតនៅក្នុងស្ថានីយនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: 이 세션의 저장된 포크 데이터는 호환되지 않습니다. 이 터미널에서 에이전트를 다시 시작하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: denne øktens lagrede gaffeldata er ikke kompatible. Start agenten på nytt i denne terminalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: dane rozwidlenia zapisane w tej sesji nie są kompatybilne. Uruchom agenta ponownie w tym terminalu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: os dados de bifurcação salvos desta sessão não são compatíveis. Inicie o agente novamente neste terminal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: сохраненные данные ветки этого сеанса несовместимы. Запустите агент еще раз в этом терминале."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: ข้อมูลส้อมที่บันทึกไว้ของเซสชันนี้เข้ากันไม่ได้ เริ่มต้นตัวแทนอีกครั้งในเทอร์มินัลนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: bu oturumun kayıtlı çatal verileri uyumlu değil. Aracıyı bu terminalde yeniden başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: збережені дані розгалуження цього сеансу несумісні. Знову запустіть агента в цьому терміналі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: 此会话保存的分叉数据不兼容。在此终端中再次启动代理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: 此會話保存的分叉資料不相容。在此終端中再次啟動代理程式。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "fork: dữ liệu fork đã lưu của phiên này không tương thích. Khởi động lại agent trong terminal này."
          }
        }
      }
    },
