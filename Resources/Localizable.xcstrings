    "dialog.saveWorkspaceLayout.commandTooLongMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "أمر أو أكثر من الأوامر الملتقطة أطول من %lld بايت بتنسيق UTF-8 ولا يمكن إعادة تشغيلها بشكل موثوق من مخطط محفوظ. قم بتقصيرها قبل الحفظ."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "أمر أو أكثر من الأوامر الملتقطة أطول من بايت واحد بتنسيق UTF-8 (%lld) ولا يمكن إعادة تشغيلها بشكل موثوق من مخطط محفوظ. قم بتقصيرها قبل الحفظ."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "أمر أو أكثر من الأوامر الملتقطة أطول من بايتين بتنسيق UTF-8 (%lld) ولا يمكن إعادة تشغيلها بشكل موثوق من مخطط محفوظ. قم بتقصيرها قبل الحفظ."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "أمر أو أكثر من الأوامر الملتقطة أطول من %lld بايتات بتنسيق UTF-8 ولا يمكن إعادة تشغيلها بشكل موثوق من مخطط محفوظ. قم بتقصيرها قبل الحفظ."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "أمر أو أكثر من الأوامر الملتقطة أطول من %lld بايتًا بتنسيق UTF-8 ولا يمكن إعادة تشغيلها بشكل موثوق من مخطط محفوظ. قم بتقصيرها قبل الحفظ."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "أمر أو أكثر من الأوامر الملتقطة أطول من %lld بايت بتنسيق UTF-8 ولا يمكن إعادة تشغيلها بشكل موثوق من مخطط محفوظ. قم بتقصيرها قبل الحفظ."
                }
              }
            }
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna ili više snimljenih komandi duže su od %lld UTF-8 bajtova i ne mogu se pouzdano ponovo pokrenuti iz spremljenog rasporeda. Skratite ih prije spremanja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En eller flere registrerede kommandoer er længere end %lld UTF-8-byte og kan ikke afspilles pålideligt fra et gemt layout. Gør dem kortere, før du gemmer."
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ein oder mehrere erfasste Befehle sind länger als %lld UTF-8-Byte und können nicht zuverlässig aus einem gespeicherten Layout wiedergegeben werden. Kürzen Sie sie vor dem Speichern."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ein oder mehrere erfasste Befehle sind länger als %lld UTF-8-Bytes und können nicht zuverlässig aus einem gespeicherten Layout wiedergegeben werden. Kürzen Sie sie vor dem Speichern."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "One or more captured commands are longer than %lld UTF-8 byte and cannot be replayed reliably from a saved layout. Shorten them before saving."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "One or more captured commands are longer than %lld UTF-8 bytes and cannot be replayed reliably from a saved layout. Shorten them before saving."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Uno o más comandos capturados superan el %lld byte UTF-8 y no se pueden reproducir de forma fiable desde un diseño guardado. Acórtalos antes de guardar."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Uno o más comandos capturados superan los %lld bytes UTF-8 y no se pueden reproducir de forma fiable desde un diseño guardado. Acórtalos antes de guardar."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Uno o más comandos capturados superan los %lld bytes UTF-8 y no se pueden reproducir de forma fiable desde un diseño guardado. Acórtalos antes de guardar."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Une ou plusieurs commandes capturées dépassent %lld octet UTF-8 et ne peuvent pas être rejouées de manière fiable à partir d'une disposition enregistrée. Raccourcissez-les avant de l'enregistrer."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Une ou plusieurs commandes capturées dépassent %lld d'octets UTF-8 et ne peuvent pas être rejouées de manière fiable à partir d'une disposition enregistrée. Raccourcissez-les avant de l'enregistrer."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Une ou plusieurs commandes capturées dépassent %lld octets UTF-8 et ne peuvent pas être rejouées de manière fiable à partir d'une disposition enregistrée. Raccourcissez-les avant de l'enregistrer."
                }
              }
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno o più comandi acquisiti superano %lld byte UTF-8 e non possono essere rieseguiti in modo affidabile da un layout salvato. Accorciali prima di salvare."
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "キャプチャされた1つ以上のコマンドが%lld UTF-8バイトを超えているため、保存されたレイアウトから確実に再実行することができません。保存する前に短縮してください。"
                }
              }
            }
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពាក្យបញ្ជាដែលបានចាប់យកមួយ ឬច្រើន វែងជាង %lld បៃ UTF-8 ហើយមិនអាចដំណើរការឡើងវិញពីប្លង់ដែលបានរក្សាទុកបានយ៉ាងទុកចិត្ត។ សូមបង្រួមវាមុនពេលរក្សាទុក។"
          }
        },
        "ko": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "캡처된 하나 이상의 명령어가 %lld UTF-8 바이트보다 길어서 저장된 레이아웃에서 안정적으로 다시 실행할 수 없습니다. 저장하기 전에 길이를 줄여 주세요."
                }
              }
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én eller flere fangede kommandoer er lengre enn %lld UTF-8-byte og kan ikke kjøres på nytt pålitelig fra et lagret oppsett. Forkort dem før du lagrer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno lub więcej przechwyconych poleceń ma więcej niż %lld bajtów UTF-8 i nie można ich niezawodnie odtworzyć z zapisanego układu. Skróć je przed zapisaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ou mais comandos capturados têm mais de %lld bytes UTF-8 e não podem ser reexecutados de forma confiável a partir de um layout salvo. Encurte-os antes de salvar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна или несколько захваченных команд длиннее %lld байт UTF-8 и не могут надежно запускаться из сохраненного макета. Сократите их перед сохранением."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำสั่งที่จับไว้หนึ่งรายการขึ้นไปยาวเกิน %lld ไบต์ UTF-8 และไม่สามารถเรียกใช้ซ้ำจากเลย์เอาต์ที่บันทึกไว้ได้อย่างน่าเชื่อถือ โปรดย่อให้สั้นลงก่อนบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakalanan komutlardan biri veya daha fazlası %lld UTF-8 bayttan uzun ve kaydedilmiş bir düzenden güvenilir şekilde yeniden çalıştırılamaz. Kaydetmeden önce kısaltın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна або кілька захоплених команд довші за %lld байтів UTF-8 і не можуть надійно запускатися зі збереженого макета. Скоротіть їх перед збереженням."
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "捕获的一个或多个命令长度超过了 %lld 个 UTF-8 字节，无法从保存的布局中可靠地重放。请在保存前将其缩短。"
                }
              }
            }
          }
        },
        "zh-Hant": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "一個或多個擷取到的指令長度超過 %lld 個 UTF-8 位元組，因此無法從儲存的版面配置中可靠地重新執行。請在儲存前將其縮短。"
                }
              }
            }
          }
        }
      }
    },
