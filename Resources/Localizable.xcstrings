    "dialog.closePinnedWorkspace.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This workspace is pinned. Closing it will close the workspace and all of its panels."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースはピン留めされています。閉じると、このワークスペースとその中のすべてのパネルが閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 워크스페이스는 고정되어 있습니다. 닫으면 워크스페이스와 모든 패널이 닫힙니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця робоча область закріплена. Закриття видалить робочу область та всі її панелі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此工作区已固定。关闭它会同时关闭该工作区及其所有面板。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Arbeitsbereich ist angepinnt. Das Schließen schließt den Arbeitsbereich und alle seine Panels."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet espace de travail est épinglé. Le fermer fermera l’espace de travail et tous ses panneaux."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساحة العمل هذه مثبتة. سيؤدي إغلاقها إلى إغلاق مساحة العمل وكل لوحاتها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este espacio de trabajo está fijado. Al cerrarlo, se cerrará el espacio de trabajo y todos sus paneles."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此工作區已釘選。關閉它將會關閉該工作區及其所有面板。"
          }
        }
      }
    },
