    "settings.terminal.adaptiveDefaultTheme": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapt Default Theme to Appearance"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトテーマを外観に合わせる"
          }
        }
      }
    },
    "settings.terminal.adaptiveDefaultTheme.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An untouched Ghostty config uses Ghostty's fixed built-in palette. Existing Ghostty settings, including light/dark theme pairs, are always preserved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghostty 設定が空の場合は、固定された組み込みパレットを使用します。ライト／ダークのテーマペアを含む既存の Ghostty 設定は常に保持します。"
          }
        }
      }
    },
    "settings.terminal.adaptiveDefaultTheme.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux's managed light and dark palettes follow the app appearance only when your Ghostty config has no settings. Existing Ghostty settings are never overlaid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghostty 設定が空の場合のみ、cmux の管理するライト／ダークパレットがアプリの外観に追従します。既存の Ghostty 設定には重ねて適用しません。"
          }
        }
      }
    },
    "settings.terminal.agentAutoResume": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume Agent Sessions on Reopen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再起動時にエージェントセッションを再開"
          }
        }
      }
    },
    "settings.terminal.agentAutoResume.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When cmux reopens after quit, restored agent terminals stay idle until you resume them manually."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux を終了後に再度開いたとき、復元されたエージェント端末は手動で再開するまで待機します。"
          }
        }
      }
    },
    "settings.terminal.agentAutoResume.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When cmux reopens after quit, restored agent terminals automatically run their resume command."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux を終了後に再度開いたとき、復元されたエージェント端末で再開コマンドを自動実行します。"
          }
        }
      }
    },
    "settings.terminal.agentHibernation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent Hibernation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェント休止"
          }
        }
      }
    },
    "settings.terminal.agentHibernation.idleSeconds": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hibernate After Idle Seconds"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "休止までのアイドル秒数"
          }
        }
      }
    },
    "settings.terminal.agentHibernation.idleSeconds.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A terminal must have no output and report an idle agent lifecycle for this long before it can be hibernated."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この時間だけ出力がなく、エージェントのライフサイクルがアイドルと報告された端末だけを休止できます。"
          }
        }
      }
    },
    "settings.terminal.agentHibernation.maxLiveTerminals": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Max Live Agent Terminals"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブエージェント端末の上限"
          }
        }
      }
    },
    "settings.terminal.agentHibernation.maxLiveTerminals.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visible terminals stay live. Extra idle background agent terminals hibernate oldest first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示中の端末はライブのままです。余分なアイドル中のバックグラウンドエージェント端末は古い順に休止します。"
          }
        }
      }
    },
    "settings.terminal.agentHibernation.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled hibernation is off. During critical memory pressure, cmux may still hibernate safe idle background agents."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常の休止はオフです。メモリ負荷が危険な状態では、安全なアイドル中のバックグラウンドエージェントを cmux が休止する場合があります。"
          }
        }
      }
    },
    "settings.terminal.agentHibernation.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Idle background agent terminals can be hibernated when the live-terminal limit is exceeded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ端末数の上限を超えると、アイドル状態のバックグラウンドエージェント端末を休止できます。"
          }
        }
      }
    },
