        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "--remove-generated-anchor는 cmux에 의해 생성된 앵커가 포함된 앵커 전용 그룹에만 사용하십시오."
          }
        }
      }
    },
    "cli.workspaceGroup.help.deleteSafety": {
