    },
    "cli.sshPtyAttach.noProgressRetryLimitReached.one": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] remote PTY bridge made no progress after %s attempt; stopping retries."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] リモート PTY ブリッジは %s 回試行しても進行しなかったため、再試行を停止します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] 远程 PTY 桥接在 %s 次尝试后仍无进展；停止重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] Die Remote-PTY-Brücke hat nach %s Versuch keine Fortschritte gemacht; Versuche werden gestoppt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] le pont PTY distant n'a pas progressé après %s tentative ; arrêt des tentatives."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] لم يحرز جسر PTY البعيد أي تقدم بعد محاولة واحدة (%s)؛ سيتم إيقاف محاولات إعادة الاتصال."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] el puente de PTY remoto no progresó después del intento %s; se detienen los reintentos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] 遠端 PTY 橋接器在嘗試 %s 次後仍無進展；停止重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] 원격 PTY 브릿지가 %s회 시도 후에도 전혀 응답하지 않아 재시도를 중단합니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "[cmux] udaljeni PTY most nije napravio napredak nakon %s pokušaja; zaustavljaju se ponovni pokušaji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "[cmux] fjern-PTY-broen gjorde ingen fremskridt efter %s forsøg; stopper genforsøg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "[cmux] il bridge PTY remoto non ha fatto progressi dopo %s tentativo; i nuovi tentativi sono stati interrotti."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "[cmux] PTY bridge ពីចម្ងាយមិនមានវឌ្ឍនភាពបន្ទាប់ពីការព្យាយាម %s ដង; ឈប់ព្យាយាមឡើងវិញ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "[cmux] ekstern PTY-bro gjorde ingen fremgang etter %s forsøk; stopper nye forsøk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "[cmux] most zdalnego PTY nie poczynił postępu po %s próbie; zatrzymuję ponawianie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "[cmux] bridge de PTY remoto sem progresso após %s tentativa; encerrando as tentativas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "[cmux] удалённый PTY-мост не продвинулся после %s попытки; повторные попытки остановлены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "[cmux] remote PTY bridge ไม่มีความคืบหน้าหลังจาก %s ครั้ง หยุดการลองใหม่แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "[cmux] uzak PTY köprüsü %s denemeden sonra ilerleme kaydedemedi; yeniden denemeler durduruluyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "[cmux] міст віддаленого PTY не досяг прогресу після %s спроби; повторні спроби зупинено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "[cmux] bridge PTY từ xa không có tiến triển sau %s lần thử; dừng thử lại."
          }
        }
      }
    },
