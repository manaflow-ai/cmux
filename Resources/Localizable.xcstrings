    "cloud.link.inputTooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The machine input chunk is too large. Split it into smaller chunks and retry."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Eingabe-Chunk der Maschine ist zu groß. Teilen Sie ihn in kleinere Chunks auf und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bloc d'entrée de la machine est trop volumineux. Divisez-le en blocs plus petits et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جزء إدخال الجهاز كبير جداً. قم بتقسيمه إلى أجزاء أصغر وأعد المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El fragmento de entrada de la máquina es demasiado grande. Divídelo en fragmentos más pequeños y vuelve a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "機器輸入區塊太大。請將其分割為較小的區塊並重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机器输入分块过大。请将其拆分为更小的分块并重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머신 입력 청크가 너무 큽니다. 더 작은 청크로 분할한 후 다시 시도하십시오."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンの入力チャンクが大きすぎます。より小さなチャンクに分割して再試行してください。"
          }
        }
      }
    },
    "cloud.workspace.ambiguousName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Several machine workspaces have that name. Use a workspace ID or choose a unique name."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrere Maschinen-Arbeitsbereiche haben diesen Namen. Verwenden Sie eine Arbeitsbereichs-ID oder wählen Sie einen eindeutigen Namen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs espaces de travail de machine portent ce nom. Utilisez un ID d'espace de travail ou choisissez un nom unique."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك عدة مساحات عمل للجهاز تحمل هذا الاسم. استخدم معرف مساحة عمل أو اختر اسماً فريداً."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Varios espacios de trabajo de la máquina tienen ese nombre. Usa un ID de espacio de trabajo o elige un nombre único."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有數個機器工作區使用該名稱。請使用工作區 ID 或選擇唯一的名稱。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有多个机器工作区使用该名称。请使用工作区 ID 或选择一个唯一的名称。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 이름을 가진 머신 작업 공간이 여러 개 있습니다. 작업 공간 ID를 사용하거나 고유한 이름을 선택하십시오."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その名前を持つマシンワークスペースが複数存在します。ワークスペースIDを使用するか、一意の名前を選択してください。"
          }
        }
      }
    },
