            "state": "translated",
            "value": "Touch ID for sudo is not configured. Run cmux sudo setup-touch-id."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo 用の Touch ID が設定されていません。cmux sudo setup-touch-id を実行してください。"
          }
        },
        "de": {
          "stringUnit": {
