    "textbox.submitAction.activeAgent.tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This terminal uses Text Entry until command launch is available. Shift-Tab is disabled while Text Entry is forced."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンド起動が利用可能になるまで、このターミナルではテキスト入力を使います。テキスト入力が強制されている間、Shift-Tab は無効です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在命令启动可用之前，此终端使用文本输入。强制使用文本输入时，Shift-Tab 会被禁用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Terminal verwendet die Texteingabe, bis der Befehlsstart verfügbar ist. Shift-Tab ist deaktiviert, solange die Texteingabe erzwungen wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce terminal utilise la saisie de texte jusqu’à ce que le lancement de commande soit disponible. Maj-Tab est désactivé lorsque la saisie de texte est forcée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم هذه الطرفية إدخال النص حتى يتوفر تشغيل الأمر. تم تعطيل Shift-Tab أثناء فرض إدخال النص."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta terminal utiliza la entrada de texto hasta que el lanzamiento de comandos esté disponible. Shift-Tab está desactivado mientras se fuerce la entrada de texto."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此終端機在可以啟動指令前將使用文字輸入。在強制使用文字輸入時，已停用 Shift-Tab。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 터미널은 명령 실행이 가능할 때까지 텍스트 입력을 사용합니다. 텍스트 입력이 강제되는 동안에는 Shift-Tab을 사용할 수 없습니다."
          }
        }
      }
    },
