          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no tiene ninguna ruta de ubicación activa para este dispositivo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 沒有此裝置的執行中位置路線。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux에 이 기기에 대해 실행 중인 위치 경로가 없습니다."
          }
        }
      }
    },
    "simulator.control.locationRouteOwnershipLost": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another client replaced this device's location route."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のクライアントがこのデバイスの位置情報ルートを置き換えました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个客户端已替换此设备的位置路线。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Client hat die Standortroute dieses Geräts ersetzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre client a remplacé l’itinéraire de localisation de cet appareil."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استبدل عميل آخر مسار الموقع الخاص بهذا الجهاز."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
