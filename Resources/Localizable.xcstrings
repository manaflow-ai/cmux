    "notification.agentChat.serverUnavailable.bodyDefault": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux couldn't reach %@. Start the server with cmux-chat or configure agentChat.startCommand in cmux.json."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux は %@ に接続できませんでした。cmux-chat でサーバーを起動するか、cmux.json で agentChat.startCommand を設定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 无法连接到 %@。请用 cmux-chat 启动服务器，或在 cmux.json 中配置 agentChat.startCommand。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux konnte %@ nicht erreichen. Starten Sie den Server mit cmux-chat oder konfigurieren Sie agentChat.startCommand in cmux.json."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux n'a pas pu contacter %@. Démarrez le serveur avec cmux-chat ou configurez agentChat.startCommand dans cmux.json."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على cmux الوصول إلى %@. شغّل الخادم باستخدام cmux-chat أو قم بتهيئة agentChat.startCommand في ملف cmux.json."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no pudo comunicarse con %@. Inicia el servidor con cmux-chat o configura agentChat.startCommand en cmux.json."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 無法連線至 %@。請使用 cmux-chat 啟動伺服器，或在 cmux.json 中設定 agentChat.startCommand。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 %@에 연결할 수 없습니다. cmux-chat으로 서버를 시작하거나 cmux.json에서 agentChat.startCommand를 설정하세요."
          }
        }
      }
    },
