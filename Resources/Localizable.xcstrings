    "settings.networking.private.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this for Tailscale alternatives, a company VPN, or a private network you operate. Authentication still happens before cmux accepts the route."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale の代替、会社の VPN、または自分で運用するプライベートネットワークに使用します。cmux がルートを受け入れる前に認証が行われます。"
          }
        }
      }
    },
    "settings.networking.private.note.short": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other Mac must run a current cmux build that advertises Iroh private-path support. Custom raw TCP routes are not accepted because they cannot prove the remote Mac. Iroh private paths stay encrypted and bound to its exact EndpointID."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続先のMacは、Irohのプライベート経路サポートを通知する最新のcmuxを実行している必要があります。カスタムの生 TCP ルートはリモート Mac を証明できないため受け付けません。Iroh のプライベート経路は暗号化され、正確な EndpointID に結び付けられます。"
          }
        }
      }
    },
    "settings.networking.private.port": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Port"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポート"
          }
        }
      }
