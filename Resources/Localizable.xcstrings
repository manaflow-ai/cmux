    "simulator.failure.workerCrashFuse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Simulator worker failed twice. Recover the pane before retrying."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulatorワーカーが2回失敗しました。再試行する前にペインを復旧してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟器工作进程已失败两次。请先恢复窗格再重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Simulator-Worker ist zweimal fehlgeschlagen. Stellen Sie das Teilfenster wieder her, bevor Sie es erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le worker du Simulateur a échoué deux fois. Restaurez le volet avant de réessayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل عامل الـ Simulator مرتين. قم باستعادة الجزء قبل إعادة المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El worker del simulador falló dos veces. Recupera el panel antes de volver a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator 工作者失敗了兩次。請在重試前復原窗格。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시뮬레이터 워커가 두 번 실패했습니다. 다시 시도하기 전에 분할 창을 복구해 주세요."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Simulator radnik je zakazao dva puta. Oporavite okno prije ponovnog pokušaja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Simulator-arbejderen fejlede to gange. Genopret ruden, inden du prøver igen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il worker del Simulator ha fallito due volte. Ripristina il pannello prima di riprovare."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កម្មករ Simulator បានបរាជ័យពីរដង។ សង្គ្រោះ pane មុនពេលព្យាយាមម្តងទៀត។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Simulator-arbeideren feilet to ganger. Gjenopprett ruten før du prøver igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
