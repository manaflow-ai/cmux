        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo ไม่สามารถตรวจสอบสิทธิ์ได้: Touch ID ถูกยกเลิกหรือไม่พร้อมใช้งาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo kimliği doğrulanamadı: Touch ID iptal edildi veya kullanılamıyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
