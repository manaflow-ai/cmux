    "settings.cloudMachines.panel.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persistent cloud computers. Files survive forever; sleeping machines cost nothing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "永続的なクラウドコンピュータです。ファイルはずっと保持され、スリープ中は料金がかかりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "持久的云端计算机。文件永久保留；休眠中的机器不产生费用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanente Cloud-Computer. Dateien bleiben dauerhaft erhalten; schlafende Maschinen kosten nichts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordinateurs cloud persistants. Les fichiers sont conservés indéfiniment ; les machines en veille ne coûtent rien."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حواسيب سحابية مستمرة. تبقى الملفات إلى الأبد؛ ولا تكلف الأجهزة النائمة شيئًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Equipos en la nube persistentes. Los archivos sobreviven para siempre; las máquinas inactivas no cuestan nada."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永續的雲端電腦。檔案將永遠保留；休眠中的機器不產生任何費用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지속적인 클라우드 컴퓨터입니다. 파일이 평생 보존되며, 휴면 상태의 머신은 비용이 발생하지 않습니다."
          }
        }
      }
    },
