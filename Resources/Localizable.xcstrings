    "settings.computerUse.showInMenuBar.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show live agent sessions and shortcuts to their terminal and driven app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中のエージェントセッションと、そのターミナルや操作対象アプリへのショートカットを表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示进行中的代理会话，以及通往其终端和被操作应用的快捷入口。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Agentensitzungen und Verknüpfungen zu deren Terminal und gesteuerter App anzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher les sessions d’agent en direct et les raccourcis vers leur terminal et l’application contrôlée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار جلسات الوكيل المباشرة واختصارات للطرفية الخاصة بها والتطبيق المُدار."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra sesiones de agentes en vivo y atajos a su terminal y aplicación controlada."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示執行中的代理程式工作階段以及前往其終端機與受控應用程式的捷徑。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 에이전트 세션과 해당 터미널 및 제어되는 앱의 바로가기를 표시합니다."
          }
        }
      }
    },
