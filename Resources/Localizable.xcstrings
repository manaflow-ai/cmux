        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieprawidłowy uchwyt powierzchni: %@ (oczekiwano UUID, odwołania jak surface:1 albo indeksu)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Identificador de superfície inválido: %@ (esperado UUID, referência como surface:1 ou índice)"
