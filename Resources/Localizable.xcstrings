    "cli.workflow.ci-watch.instantiate.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the CI Watch recipe, merge the controls into .cmux/dock.json, adapt commands for the repository, validate the JSON, then reload the Dock/config."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorlage CI Watch öffnen, Steuerelemente in .cmux/dock.json übernehmen, Befehle an das Repository anpassen, JSON validieren und Dock bzw. Konfiguration neu laden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la recette CI Watch, ajoutez les contrôles à .cmux/dock.json, adaptez les commandes au dépôt, validez le JSON, puis rechargez le Dock et la configuration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la receta CI Watch, incorpora los controles en .cmux/dock.json, adapta los comandos al repositorio, valida el JSON y recarga el Dock y la configuración."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح وصفة CI Watch، وأضف عناصر التحكم إلى .cmux/dock.json، وعدّل الأوامر للمستودع، وتحقق من صحة JSON، ثم أعد تحميل Dock والإعدادات."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 CI Watch 配方，将控件合并到 .cmux/dock.json，按仓库需要调整命令，验证 JSON，然后重新加载 Dock 和配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 CI Watch 配方，將控制項合併到 .cmux/dock.json，依儲存庫需求調整命令，驗證 JSON，然後重新載入 Dock 和設定。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CI Watch 설정 예제를 열고 컨트롤을 .cmux/dock.json에 병합한 뒤 저장소에 맞게 명령을 수정하고 JSON을 검증한 다음 Dock과 설정을 다시 불러오세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CI Watch レシピを開き、コントロールを .cmux/dock.json に追加し、コマンドをリポジトリに合わせ、JSON を検証して Dock と設定を再読み込みします。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otvorite recept CI Watch, spojite kontrole u .cmux/dock.json, prilagodite naredbe repozitoriju, validirajte JSON, zatim ponovo učitajte Dock/konfiguraciju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åbn CI Watch-opskriften, flet kontrolelementerne ind i .cmux/dock.json, tilpas kommandoer til repositoriet, valider JSON, og genindlæs derefter Dock/konfigurationen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apri la ricetta CI Watch, unisci i controlli in .cmux/dock.json, adatta i comandi al repository, valida il JSON, poi ricarica Dock/config."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បើក recipe CI Watch, បញ្ចូល controls ក្នុង .cmux/dock.json, កែសម្រួលពាក្យបញ្ជាសម្រាប់ repository, ផ្ទៀងផ្ទាត់ JSON, បន្ទាប់មកផ្ទុក Dock/config ឡើងវិញ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åpne CI Watch-oppskriften, slå kontrollene sammen med .cmux/dock.json, tilpass kommandoene for repositoriet, valider JSON-en, og last deretter inn Dock/config på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otwórz przepis CI Watch, scal kontrolki z .cmux/dock.json, dostosuj polecenia do repozytorium, zweryfikuj JSON, a następnie przeładuj Dock/konfigurację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra a receita CI Watch, mescle os controles em .cmux/dock.json, adapte os comandos para o repositório, valide o JSON e recarregue o Dock/config."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Откройте рецепт CI Watch, объедините элементы управления с .cmux/dock.json, адаптируйте команды под репозиторий, проверьте JSON, затем перезагрузите Dock/конфигурацию."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิด recipe CI Watch รวม control เข้า .cmux/dock.json ปรับคำสั่งสำหรับ repository ตรวจสอบ JSON แล้ว reload Dock/config"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CI Watch tarifini açın, denetimleri .cmux/dock.json ile birleştirin, depo için komutları uyarlayın, JSON'ı doğrulayın, ardından Dock/config'i yeniden yükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відкрийте рецепт CI Watch, об'єднайте елементи керування з .cmux/dock.json, адаптуйте команди для репозиторію, перевірте JSON, потім перезавантажте Dock/config."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mở recipe CI Watch, hợp nhất các điều khiển vào .cmux/dock.json, điều chỉnh lệnh cho repository, kiểm tra JSON, rồi tải lại Dock/config."
          }
        }
      }
    },
