        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: សម័យភ្នាក់ងារដែលបានរក្សាទុកគឺមិនមានទេ។ ស្ថានីយនៅតែមាននៅក្នុងថតដែលបានរក្សាទុករបស់វា; ព្យាយាមម្តងទៀតនៅពេលក្រោយ ឬចាប់ផ្តើមវគ្គភ្នាក់ងារថ្មី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: 저장된 에이전트 세션을 사용할 수 없습니다. 터미널은 저장된 디렉토리에 남아 있습니다. 나중에 다시 시도하거나 새 에이전트 세션을 시작하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: den lagrede agentøkten er utilgjengelig. Terminalen forblir i sin lagrede katalog; prøv på nytt senere eller start en ny agentøkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: zapisana sesja agenta jest niedostępna. Terminal pozostaje w zapisanym katalogu; spróbuj ponownie później lub rozpocznij nową sesję agenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: a sessão do agente salva não está disponível. O terminal permanece no diretório salvo; tente novamente mais tarde ou inicie uma nova sessão do agente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: сохраненный сеанс агента недоступен. Терминал остается в сохраненном каталоге; повторите попытку позже или начните новый сеанс агента."
          }
