          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порожні вкладки зараз використовують режим «Тільки налаштування» з вікна налагодження."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空白标签页当前使用调试窗口中的「仅设置」模式。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leere Tabs verwenden derzeit den Modus „Nur Einstellungen“ aus dem Debug-Fenster."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets vides utilisent actuellement le mode Réglages uniquement de la fenêtre de débogage."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم علامات التبويب الفارغة حاليًا وضع الإعدادات فقط من نافذة التصحيح."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas en blanco actualmente utilizan el modo Solo configuración desde la ventana de depuración."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空白標籤頁目前正在使用偵錯視窗中的「僅設定」模式。"
          }
        }
      }
    },
    "settings.browser.import.hint.note.visible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blank browser tabs can show this import suggestion. Hide or re-enable it here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空のブラウザータブにこのインポート案内を表示できます。ここで非表示や再表示を切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 브라우저 탭에 가져오기 제안을 표시할 수 있습니다. 여기서 숨기거나 다시 활성화하세요."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порожні вкладки браузера можуть показувати пропозицію імпорту. Сховайте або увімкніть її тут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空白浏览器标签页可以显示此导入建议。可在此处隐藏或重新启用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leere Browser-Tabs können diesen Importvorschlag anzeigen. Blenden Sie ihn hier aus oder aktivieren Sie ihn wieder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets vides du navigateur peuvent afficher cette suggestion d’importation. Masquez-la ou réactivez-la ici."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لعلامات تبويب المتصفح الفارغة إظهار اقتراح الاستيراد هذا. قم بإخفائه أو إعادة تمكينه هنا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas en blanco del navegador pueden mostrar esta sugerencia de importación. Ocúltela o vuelva a habilitarla aquí."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空白瀏覽器標籤頁可以顯示此匯入建議。在此處隱藏或重新啟用它。"
          }
        }
      }
    },
    "settings.browser.import.hint.settingsNote": {
      "extractionState": "manual",
      "localizations": {
