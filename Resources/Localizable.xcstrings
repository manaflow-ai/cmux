    "settings.sidebar.rightMaxWidth.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم الحد الديناميكي المضمن الذي يحافظ على مساحة إضافية للطرفية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristi ugrađeno dinamičko ograničenje koje zadržava dodatni prostor za terminal."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug den indbyggede dynamiske grænse, der reserverer ekstra plads til terminalen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die integrierte dynamische Begrenzung verwenden, die zusätzlichen Terminalplatz freihält."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the built-in dynamic cap that keeps extra terminal space reserved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el límite dinámico integrado que reserva espacio adicional para la terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser la limite dynamique intégrée qui réserve de l’espace supplémentaire au terminal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il limite dinamico integrato che riserva spazio extra al terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末用の余白を確保する組み込みの動的上限を使います。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ប្រើដែនកំណត់ថាមវន្តដែលមានស្រាប់ ដែលរក្សាទុកកន្លែងបន្ថែមសម្រាប់ terminal។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 공간을 추가로 남겨 두는 내장 동적 제한을 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk den innebygde dynamiske grensen som holder av ekstra plass til terminalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj wbudowanego limitu dynamicznego, który rezerwuje dodatkowe miejsce dla terminala."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o limite dinâmico integrado que reserva espaço extra para o terminal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать встроенное динамическое ограничение, которое оставляет дополнительное место для терминала."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ขีดจำกัดแบบไดนามิกในตัวที่กันพื้นที่เพิ่มเติมไว้สำหรับเทอร์มินัล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal için ek alan ayıran yerleşik dinamik sınırı kullan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовувати вбудоване динамічне обмеження, яке залишає додаткове місце для термінала."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用内置动态上限，为终端保留额外空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用內建動態上限，為終端保留額外空間。"
          }
        }
      }
    },
    "settings.sidebar.rightMaxWidth.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للـ Dock أن يتجاوز حد العرض المضمن مع الحفاظ على مساحة للطرفية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock se može proširiti preko ugrađenog ograničenja širine uz očuvanje prostora za terminal."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Docken kan vokse forbi den indbyggede breddegrænse, mens der stadig reserveres plads til terminalen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dock kann über die integrierte Breitenbegrenzung hinaus wachsen, während Platz für das Terminal erhalten bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Dock can grow past the built-in width cap while preserving terminal space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Dock puede superar el límite de ancho integrado sin dejar de reservar espacio para la terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Dock peut dépasser la limite de largeur intégrée tout en réservant de l’espace au terminal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Dock può superare il limite di larghezza integrato mantenendo spazio per il terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock は端末用の空間を確保したまま、組み込みの幅上限を超えて広げられます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock អាចពង្រីកលើសដែនកំណត់ទទឹងដែលមានស្រាប់ ខណៈរក្សាកន្លែងសម្រាប់ terminal។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock은 터미널 공간을 유지하면서 내장 너비 상한을 넘어 커질 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Docken kan vokse forbi den innebygde breddegrensen samtidig som terminalplass beholdes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock może przekroczyć wbudowany limit szerokości, zachowując miejsce dla terminala."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dock pode crescer além do limite de largura integrado enquanto preserva espaço para o terminal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock может превышать встроенное ограничение ширины, сохраняя место для терминала."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock สามารถขยายเกินขีดจำกัดความกว้างในตัว โดยยังคงเว้นพื้นที่ให้เทอร์มินัล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock, terminal alanını korurken yerleşik genişlik sınırını aşarak büyüyebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock може перевищувати вбудоване обмеження ширини, зберігаючи місце для термінала."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 可以在保留终端空间的同时超过内置宽度上限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 可以在保留終端空間的同時超過內建寬度上限。"
          }
        }
      }
    },
