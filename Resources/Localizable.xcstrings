    "cli.ios.usage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage: cmux ios <subcommand> [args] [--surface <ref>]\n\nEvery native `cmux simulator` subcommand is accepted unchanged.\n\nAdditional subcommands:\n  list [--workspace <ref>]            List Simulator panes and device identifiers\n  context [--udid]                    Print one selected Simulator identity\n  select <device-udid>                Bind a pane to an iPhone or iPad Simulator\n  screenshot [--out <path>]           Capture one or many selected Simulators\n\nExamples:\n  cmux ios list --json\n  cmux ios screenshot --surface surface:2 --out phone.png\n  cmux ios screenshot --all --out screenshots/\n  cmux ios rotate landscape-left"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用方法: cmux ios <subcommand> [args] [--surface <ref>]\n\nすべてのネイティブ `cmux simulator` サブコマンドをそのまま使用できます。\n\n追加サブコマンド:\n  list [--workspace <ref>]            Simulatorペインとデバイス識別子を表示\n  context [--udid]                    選択したSimulator識別情報を表示\n  select <device-udid>                ペインをiPhoneまたはiPad Simulatorに接続\n  screenshot [--out <path>]           選択したSimulatorをキャプチャ\n\n例:\n  cmux ios list --json\n  cmux ios screenshot --surface surface:2 --out phone.png\n  cmux ios screenshot --all --out screenshots/\n  cmux ios rotate landscape-left"
          }
        }
      }
    },
    "cli.memory.error.diagnosticsUnsupported": {
