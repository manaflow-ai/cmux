    "cli.workflow.full-stack-dev.instantiate.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Full-Stack Dev recipe, merge the workspace command and optional Dock controls, replace the sample bun commands and preview URL, then run cmux reload-config."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorlage Full-Stack Dev öffnen, Arbeitsbereichsbefehl und optionale Dock-Steuerelemente übernehmen, bun-Beispielbefehle und Vorschau-URL ersetzen und cmux reload-config ausführen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la recette Full-Stack Dev, ajoutez la commande d’espace de travail et les contrôles Dock facultatifs, remplacez les commandes bun et l’URL d’aperçu d’exemple, puis exécutez cmux reload-config."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la receta Full-Stack Dev, incorpora el comando del espacio de trabajo y los controles Dock opcionales, sustituye los comandos bun y la URL de ejemplo, y ejecuta cmux reload-config."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح وصفة Full-Stack Dev، وأضف أمر مساحة العمل وعناصر Dock الاختيارية، واستبدل أوامر bun وعنوان URL للمعاينة في المثال، ثم شغّل cmux reload-config."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Full-Stack Dev 配方，合并工作区命令和可选的 Dock 控件，替换示例 bun 命令和预览 URL，然后运行 cmux reload-config。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 Full-Stack Dev 配方，合併工作區命令和可選的 Dock 控制項，替換範例 bun 命令和預覽 URL，然後執行 cmux reload-config。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-Stack Dev 설정 예제를 열고 작업 공간 명령과 선택적 Dock 컨트롤을 병합한 뒤 예제 bun 명령과 미리보기 URL을 교체하고 cmux reload-config를 실행하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-Stack Dev レシピを開き、ワークスペースのコマンドと任意の Dock コントロールを追加し、サンプルの bun コマンドとプレビュー URL を変更して cmux reload-config を実行します。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otvorite Full-Stack Dev recept, spojite workspace naredbu i opcionalne Dock kontrole, zamijenite primjere bun naredbi i URL pregleda, zatim pokrenite cmux reload-config."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åbn Full-Stack Dev-opskriften, flet arbejdsområdekommandoen og valgfrie Dock-kontrolelementer ind, erstat eksempel-bun-kommandoer og forhåndsvisnings-URL, og kør derefter cmux reload-config."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apri la ricetta Full-Stack Dev, unisci il comando workspace e i controlli Dock opzionali, sostituisci i comandi bun di esempio e l'URL di anteprima, quindi esegui cmux reload-config."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បើក recipe Full-Stack Dev, បញ្ចូល command workspace និងការគ្រប់គ្រង Dock ជាជម្រើស, ជំនួស commands bun គំរូ និង URL preview, រួចដំណើរការ cmux reload-config."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åpne Full-Stack Dev-oppskriften, flett inn workspace-kommandoen og valgfrie Dock-kontroller, erstatt eksempel-bun-kommandoer og forhåndsvisnings-URL, og kjør deretter cmux reload-config."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otwórz przepis Full-Stack Dev, scal polecenie workspace i opcjonalne kontrolki Dock, zastąp przykładowe polecenia bun i adres URL podglądu, a następnie uruchom cmux reload-config."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra a receita Full-Stack Dev, mescle o comando do workspace e os controles opcionais de Dock, substitua os comandos bun de exemplo e a URL de pré-visualização e execute cmux reload-config."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Откройте рецепт Full-Stack Dev, объедините команду workspace и опциональные элементы управления Dock, замените примеры команд bun и URL предпросмотра, затем выполните cmux reload-config."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิด recipe Full-Stack Dev, รวมคำสั่ง workspace และตัวควบคุม Dock แบบเสริม, แทนที่คำสั่ง bun ตัวอย่างและ preview URL แล้วรัน cmux reload-config"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Full-Stack Dev tarifini açın, çalışma alanı komutunu ve isteğe bağlı Dock denetimlerini ekleyin, örnek bun komutlarını ve önizleme URL'sini değiştirin, ardından cmux reload-config komutunu çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відкрийте рецепт Full-Stack Dev, об'єднайте команду workspace і необов'язкові елементи керування Dock, замініть зразкові команди bun і URL попереднього перегляду, а потім виконайте cmux reload-config."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mở recipe Full-Stack Dev, gộp lệnh workspace và các điều khiển Dock tùy chọn, thay thế các lệnh bun mẫu và URL xem trước, sau đó chạy cmux reload-config."
          }
        }
      }
    },
