    "settings.browser.hiddenWebViewDiscard.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden browser tabs keep page memory until closed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示のブラウザタブは、閉じるまでページメモリを保持します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏的浏览器标签页在关闭前会一直保留页面内存。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeblendete Browser-Tabs behalten den Seitenspeicher, bis sie geschlossen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets de navigateur masqués conservent la mémoire de la page jusqu’à leur fermeture."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتفظ علامات تبويب المتصفح المخفية بذاكرة الصفحة حتى يتم إغلاقها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas ocultas del navegador conservan la memoria de la página hasta que se cierran."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏的瀏覽器標籤頁會保留網頁記憶體，直到關閉為止。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨겨진 브라우저 탭이 닫힐 때까지 페이지 메모리를 유지합니다."
          }
        }
      }
    },
    "settings.browser.hiddenWebViewDiscard.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden browser tabs release page memory after the delay below, then restore when shown again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示のブラウザタブは下の遅延後にページメモリを解放し、再表示時に復元します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏的浏览器标签页会在下方延迟时间后释放页面内存，再次显示时恢复。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeblendete Browser-Tabs geben den Seitenspeicher nach der unten angegebenen Verzögerung frei und stellen ihn wieder her, wenn sie erneut angezeigt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets de navigateur masqués libèrent la mémoire de la page après le délai ci-dessous, puis la restaurent lorsqu’ils sont de nouveau affichés."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقوم علامات تبويب المتصفح المخفية بتحرير ذاكرة الصفحة بعد التأخير الموضح أدناه، ثم استعادتها عند عرضها مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas ocultas del navegador liberan la memoria de la página después de la demora indicada a continuación y luego se restauran cuando se vuelven a mostrar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏的瀏覽器標籤頁會在經過下方延遲時間後釋放網頁記憶體，並在再次顯示時還原。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨겨진 브라우저 탭이 아래의 지연 시간 후에 페이지 메모리를 해제하고, 다시 표시될 때 복원합니다."
          }
        }
      }
    },
    "settings.browser.hiddenWebViewDiscardDelay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory Saver Delay"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリセーバーの遅延"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内存节省延迟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzögerung für Arbeitsspeicherschoner"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Délai de l’économiseur de mémoire"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأخير موفر الذاكرة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demora del ahorrador de memoria"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記憶體節省程式延遲"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모리 절약 지연 시간"
          }
        }
      }
    },
