    "cloudTree.error.renameTerminalResponse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote rename response was invalid. Refresh and retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモート名称変更の応答が無効です。更新して再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程重命名的响应无效。请刷新后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Remote-Antwort für das Umbenennen war ungültig. Aktualisieren Sie und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse de renommage distant était invalide. Actualisez et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استجابة إعادة التسمية عن بعد غير صالحة. يرجى التحديث وإعادة المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta de cambio de nombre remota no era válida. Actualiza e inténtalo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端重新命名的回應無效。請重新整理並重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 이름 바꾸기 응답이 올바르지 않습니다. 새로 고침 후 다시 시도하십시오."
          }
        }
      }
    },
    "cloudTree.error.renameTerminalGeneration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote rename came from a different VM session. Refresh and retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモート名称変更が別の VM セッションから返されました。更新して再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此次远程重命名来自另一个 VM 会话。请刷新后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Remote-Umbenennung stammte aus einer anderen VM-Sitzung. Aktualisieren Sie und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le renommage distant provient d’une session de VM différente. Actualisez et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة التسمية عن بعد جاءت من جلسة جهاز افتراضي مختلفة. يرجى التحديث وإعادة المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio de nombre remoto provino de una sesión de máquina virtual diferente. Actualiza e inténtalo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端重新命名來自不同的 VM 工作階段。請重新整理並重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 이름 바꾸기가 다른 가상 머신 세션에서 발생했습니다. 새로 고침 후 다시 시도하십시오."
          }
        }
      }
    },
    "cloudTree.error.renameTerminalRevision": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote rename returned revision %2$llu after revision %1$llu. Refresh and retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートの名前変更でリビジョン %2$llu が返されました（リビジョン %1$llu の後）。更新して再試行してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Remote-Umbenennung hat Revision %2$llu nach Revision %1$llu zurückgegeben. Aktualisieren Sie und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le renommage distant a renvoyé la révision %2$llu après la révision %1$llu. Actualisez et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعادت إعادة التسمية عن بعد المراجعة %2$llu بعد المراجعة %1$llu. يرجى التحديث وإعادة المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio de nombre remoto devolvió la revisión %2$llu después de la revisión %1$llu. Actualiza e inténtalo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端重新命名傳回修訂版本 %2$llu，其在修訂版本 %1$llu 之後。請重新整理並重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程重命名返回了修订号 %2$llu（在修订号 %1$llu 之后）。请刷新并重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 이름 바꾸기가 리비전 %2$llu을(를) 반환했습니다 (이전 리비전: %1$llu). 새로 고침 후 다시 시도하십시오."
          }
        }
      }
    },
    "cloudTree.error.renameWorkspaceEmptyName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A workspace name cannot be empty."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペース名を空にすることはできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作区名称不能为空。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Name für den Arbeitsbereich darf nicht leer sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom d’un espace de travail ne peut pas être vide."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن يكون اسم مساحة العمل فارغًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre de un espacio de trabajo no puede estar vacío."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作區名稱不能為空。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 공간 이름은 비워 둘 수 없습니다."
          }
        }
      }
    },
    "cloudTree.error.renameWorkspaceNotFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This remote workspace is no longer available."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリモートワークスペースは利用できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此远程工作区已不可用。"
          }
        },
