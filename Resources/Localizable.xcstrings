    "settings.app.iMessageMode.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move a workspace to the top and show the submitted message when you send an agent prompt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントのプロンプトを送信したときにワークスペースを一番上へ移動し、送信したメッセージを表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送代理提示时，将工作区移至顶部并显示已提交的消息。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Arbeitsbereich nach oben verschieben und die gesendete Nachricht anzeigen, wenn Sie einen Agenten-Prompt senden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer un espace de travail vers le haut et afficher le message soumis lorsque vous envoyez une invite à l’agent."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقل مساحة العمل إلى الأعلى وعرض الرسالة المرسلة عندما ترسل مطالبة الوكيل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve un espacio de trabajo al principio y muestra el mensaje enviado cuando mandas una instrucción al agente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當您傳送代理程式提示時，將工作區移至最上方並顯示已送出的訊息。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 프롬프트를 전송할 때 작업 공간을 맨 위로 이동하고 제출된 메시지를 표시합니다."
          }
        }
      }
    },
    "settings.app.imessageFloatGroups": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iMessage Mode: Float Groups by Latest Unread"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iMessage モード: 最新の未読でグループを並べ替え"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iMessage 模式：按最新未读上浮分组"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iMessage-Modus: Gruppen nach neuester ungelesener Nachricht nach oben verschieben"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode iMessage : faire flotter les groupes selon les derniers non lus"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وضع iMessage: تعويم المجموعات حسب آخر رسالة غير مقروءة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo iMessage: flotar grupos por último no leído"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iMessage 模式：依最新未讀項目將群組置頂"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iMessage 모드: 최근 읽지 않은 그룹 위로 띄우기"
          }
        }
      }
    },
    "settings.app.imessageFloatGroups.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reorder whole group sections by their most-recent unread member when iMessage mode is on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iMessage モードがオンのとき、最新の未読メンバーでグループセクション全体を並べ替えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iMessage 模式开启时，按各分组中最新的未读成员重排整个分组区块。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganze Gruppenabschnitte nach ihrem am kürzesten zurückliegenden ungelesenen Mitglied neu anordnen, wenn der iMessage-Modus aktiviert ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réordonner des sections entières de groupe par leur membre non lu le plus récent lorsque le mode iMessage est activé."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة ترتيب أقسام المجموعات بالكامل حسب العضو الأحدث غير المقروء عندما يكون وضع iMessage نشطًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reordena secciones completas de grupos por su miembro no leído más reciente cuando el modo iMessage está activo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用 iMessage 模式時，依據其最新未讀成員重新排列整個群組區段。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iMessage 모드가 켜져 있을 때 가장 최근에 읽지 않은 멤버에 따라 전체 그룹 섹션의 순서를 조정합니다."
          }
        }
      }
    },
    "settings.app.imessageSortInsideGroups": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iMessage Mode: Sort Workspaces Inside Groups"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iMessage モード: グループ内のワークスペースを並べ替え"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iMessage 模式：分组内排序工作区"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iMessage-Modus: Arbeitsbereiche innerhalb von Gruppen sortieren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode iMessage : trier les espaces de travail au sein des groupes"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وضع iMessage: فرز مساحات العمل داخل المجموعات"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo iMessage: ordenar espacios de trabajo dentro de los grupos"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iMessage 模式：在群組內排序工作區"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iMessage 모드: 그룹 내 작업 공간 정렬"
          }
        }
      }
    },
    "settings.app.imessageSortInsideGroups.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When iMessage mode floats unread workspaces to the top, sort members within each group while the group section stays put."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iMessage モードで未読ワークスペースを上に並べ替えるとき、グループのセクション位置は維持しつつ各グループ内のメンバーを並べ替えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 iMessage 模式把未读工作区上浮到顶部时，在每个分组内部排序成员，分组区块位置保持不变。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der iMessage-Modus ungelesene Arbeitsbereiche nach oben verschiebt, die Mitglieder innerhalb jeder Gruppe sortieren, während der Gruppenabschnitt an Ort und Stelle bleibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque le mode iMessage fait remonter les espaces de travail non lus en haut, trier les membres au sein de chaque groupe tandis que la section du groupe reste immobile."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يقوم وضع iMessage بتعويم مساحات العمل غير المقروءة إلى الأعلى، يتم فرز الأعضاء داخل كل مجموعة بينما يظل قسم المجموعة في مكانه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando el modo iMessage hace flotar los espacios de trabajo no leídos al principio, ordena los miembros dentro de cada grupo mientras la sección del grupo permanece en su lugar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 iMessage 模式將未讀工作區置頂時，在群組區段位置保持不變的情況下排序各群組內的成員。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iMessage 모드에서 읽지 않은 작업 공간을 맨 위로 띄울 때, 그룹 섹션은 고정된 상태에서 각 그룹 내 멤버들을 정렬합니다."
          }
        }
      }
    },
