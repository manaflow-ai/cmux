          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] SSH rozłączone (%s); ponowna próba %s za %s s; dane wejściowe zostaną odrzucone."
          }
        },
        "pt-BR": {
          "stringUnit": {
