    "settings.mobile.phonePush.mode.onlyWhenAway": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only When Away"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "離席中のみ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur wenn weg"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement en mon absence"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط عندما تكون بعيدا"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sólo cuando estás lejos"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅當離開時"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在离开时"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자리를 비울 때만"
          }
        }
      }
    },
    "settings.mobile.phonePush.mode.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always sends every local agent alert. Away mode waits until this Mac is locked, asleep, or idle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「常に」はすべてのローカルエージェント通知を送信します。「離席中」は、この Mac がロック中、スリープ中、またはアイドル状態になるまで待機します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「始终」会发送每一条本机代理提醒。「离开」模式会等到这台 Mac 锁定、睡眠或闲置时再发送。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet immer jede lokale Agenten-Warnung. Der Abwesenheitsmodus wartet, bis dieser Mac gesperrt ist, sich im Ruhezustand befindet oder inaktiv ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie toujours chaque alerte d’agent local. Le mode Absence attend que ce Mac soit verrouillé, en veille ou inactif."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل دائمًا كل تنبيه من الوكيل المحلي. ينتظر وضع \"الابتعاد\" (Away) حتى يتم قفل جهاز Mac هذا أو نومه أو خموله."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía siempre todas las alertas de agentes locales. El modo ausente espera hasta que esta Mac esté bloqueada, en reposo o inactiva."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「總是」會傳送每個本地代理程式警示。「離開」模式則會等到此 Mac 鎖定、睡眠或閒置時才傳送。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 모든 로컬 에이전트 경고를 보냅니다. 자리 비움 모드에서는 이 Mac이 잠기거나 잠자기 상태이거나 대기 상태가 될 때까지 대기합니다."
          }
        }
      }
    },
