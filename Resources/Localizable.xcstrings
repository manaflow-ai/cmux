          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це закриє останню вкладку та її робочу область."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将关闭最后一个标签页并关闭其工作区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將關閉最後一個標籤頁並關閉其工作區。"
          }
        }
      }
    },
