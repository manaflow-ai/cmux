    "settings.app.dockBadge.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض عدد غير المقروء على أيقونة التطبيق (Dock و Cmd+Tab)."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
