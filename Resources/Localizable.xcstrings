    },
    "taskManager.killProcess.message.one": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask %@ (PID %lld) to terminate gracefully. cmux will force-kill it if it is still running after a short grace period."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（PID %lld）に正常終了を要求します。短い猶予時間の後も実行中の場合、cmux が強制終了します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求 %@（PID %lld）正常退出。若短暂宽限期后仍在运行，cmux 会强制结束它。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufforderung an %@ (PID %lld), sich ordnungsgemäß zu beenden. cmux wird das Beenden erzwingen, wenn der Prozess nach einer kurzen Nachfrist noch läuft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander à %@ (PID %lld) de se terminer correctement. cmux le forcera à s’arrêter s’il est toujours en cours d’exécution après un court délai de grâce."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب من %@ (PID %lld) الإنهاء بشكل منظم. سيقوم cmux بإنهائه إجباريًا إذا ظل قيد التشغيل بعد فترة سماح قصيرة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitar a %@ (PID %lld) que finalice de forma ordenada. cmux lo forzará a finalizar si aún se está ejecutando después de un breve período de gracia."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要求 %@ (PID %lld) 正常結束。如果它在短暫的寬限期後仍在執行，cmux 將會強制結束它。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(PID %lld)의 정상 종료를 요청합니다. 짧은 유예 기간 후에도 계속 실행 중인 경우 cmux가 강제 종료합니다."
          }
        }
      }
    },
    "taskManager.killProcess.message.other": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ask %lld process to terminate gracefully. cmux will force-kill remaining processes after a short grace period. PID: %@."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ask %lld processes to terminate gracefully. cmux will force-kill remaining processes after a short grace period. PIDs: %@."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld 個のプロセスに正常終了を要求します。短い猶予期間の後、cmux は残りのプロセスを強制終了します。PID: %@。"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "请求 %lld 个进程正常终止。在短暂的宽限期后，cmux 将强制结束剩余进程。PID：%@。"
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Fordere %lld Prozess auf, sich ordnungsgemäß zu beenden. cmux wird verbleibende Prozesse nach einer kurzen Schonfrist zwangsweise beenden. PIDs: %@."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Fordere %lld Prozesse auf, sich ordnungsgemäß zu beenden. cmux wird verbleibende Prozesse nach einer kurzen Schonfrist zwangsweise beenden. PIDs: %@."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Demander à %lld processus de se terminer proprement. cmux arrêtera de force les processus restants après un court délai de grâce. PID : %@."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Demander à %lld processus de se terminer proprement. cmux arrêtera de force les processus restants après un court délai de grâce. PIDs : %@."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Demander à %lld processus de se terminer proprement. cmux arrêtera de force les processus restants après un court délai de grâce. PIDs : %@."
                }
              }
            }
          }
        },
        "ar": {
          "variations": {
            "plural": {
              "zero": {
                "stringUnit": {
