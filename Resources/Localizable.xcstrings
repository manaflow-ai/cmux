        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosh 터미널 전송 방식에는 SSH 관리 워크스페이스가 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
