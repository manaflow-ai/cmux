    "cloudTunnel.error.configurationNotInstalled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The VPN configuration was not saved before the tunnel was started."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トンネルの開始前に VPN 構成が保存されていませんでした。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die VPN-Konfiguration wurde nicht gespeichert, bevor der Tunnel gestartet wurde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration VPN n'a pas été enregistrée avant le démarrage du tunnel."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم حفظ تكوين VPN قبل بدء تشغيل النفق."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración de VPN no se guardó antes de que se iniciara el túnel."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在通道啟動前，VPN 設定未儲存。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动隧道前，VPN 配置未被保存。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터널이 시작되기 전에 VPN 구성이 저장되지 않았습니다."
          }
        }
      }
    },
