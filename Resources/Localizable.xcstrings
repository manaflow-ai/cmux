    "settings.notifications.agentTurnComplete.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When to notify that an agent finished. When idle waits until background tasks and scheduled wakeups drain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが完了したときに通知するタイミング。待機中はバックグラウンドタスクとスケジュール再開が片付くまで待ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 완료되었을 때 알릴 시점입니다. 유휴 시에는 백그라운드 작업과 예약된 재개가 끝날 때까지 기다립니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли сповіщати про завершення роботи агента. У режимі очікування чекає, доки завершаться фонові задачі та заплановані пробудження."
          }
        }
      }
    },
