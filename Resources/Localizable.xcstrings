    "browser.import.warning.safariCookiesUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari cookies are stored in Cookies.binarycookies and are not yet supported by this importer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari のCookieは Cookies.binarycookies に保存されており、このインポーターではまだ対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari 쿠키는 Cookies.binarycookies에 저장되어 있으며 아직 이 가져오기 도구에서 지원되지 않습니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookies Safari зберігаються у форматі Cookies.binarycookies і поки не підтримуються цим імпортером."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari 的 Cookie 存储在 Cookies.binarycookies 中，此导入工具尚不支持。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari-Cookies werden in Cookies.binarycookies gespeichert und von diesem Importer noch nicht unterstützt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cookies Safari sont stockés dans Cookies.binarycookies et ne sont pas encore pris en charge par cet importateur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تخزين ملفات تعريف ارتباط Safari في Cookies.binarycookies وهي غير مدعومة بعد بواسطة أداة الاستيراد هذه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cookies de Safari se almacenan en Cookies.binarycookies y este importador aún no las admite."
