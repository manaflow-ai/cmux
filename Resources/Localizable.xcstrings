    "simulator.failure.cameraSourceInactive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A synthetic-camera source can only be switched while a camera session is active."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合成カメラのソースは、カメラセッションが有効な場合にのみ切り替えられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在摄像头会话进行中才能切换合成摄像头来源。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine synthetische Kameraquelle kann nur gewechselt werden, während eine Kamerasitzung aktiv ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une source de caméra synthétique ne peut être commutée que lorsqu’une session de caméra est active."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تبديل مصدر الكاميرا الاصطناعية إلا أثناء نشاط جلسة الكاميرا."
