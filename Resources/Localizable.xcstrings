    "account.signIn.error.rejected.recovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the account details in the browser and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザでアカウント情報を確認して、もう一度試してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
