    "cli.workflow.ci-watch.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep long-running CI and Feed monitors in Dock instead of workspace panes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte lang laufende CI- und Feed-Monitore im Dock statt in Workspace-Panes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez les moniteurs CI et Feed de longue durée dans le Dock plutôt que dans des volets."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ مراقبات CI وFeed طويلة التشغيل في Dock بدلاً من ألواح مساحة العمل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén los monitores de CI y Feed de larga duración en el Dock en lugar de paneles del espacio de trabajo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將長時間執行的 CI 與 Feed 監看器放在 Dock，而非工作區窗格。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将长时间运行的 CI 和 Feed 监视器放在 Dock，而不是工作区窗格。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오래 실행되는 CI 및 Feed 모니터를 작업 공간 창 대신 Dock에 둡니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長時間実行する CI と Feed の監視をワークスペースのペインではなく Dock に置きます。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Držite dugotrajne CI i Feed monitore u Docku umjesto u okvirima radnog prostora."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Behold langvarige CI- og Feed-monitorer i Dock i stedet for workspace-ruder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mantieni i monitor CI e Feed a lunga durata nel Dock invece che nei pannelli del workspace."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "រក្សា CI យូរ និង Feed monitors ក្នុង Dock ជំនួស workspace panes។"
          }
        },
