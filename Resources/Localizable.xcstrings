    "agentRestore.admission.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux could not verify whether this agent session is already running. Retry 'cmux restore --surface'."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエージェントセッションがすでに実行中かどうかを cmux で確認できませんでした。「cmux restore --surface」を再試行してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux konnte nicht überprüfen, ob diese Agenten-Sitzung bereits läuft. Versuche 'cmux restore --surface' erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux n’a pas pu vérifier si cette session d’agent est déjà en cours d’exécution. Réessayez 'cmux restore --surface'."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على cmux التحقق مما إذا كانت جلسة الوكيل هذه قيد التشغيل بالفعل. أعد محاولة 'cmux restore --surface'."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no pudo verificar si esta sesión del agente ya se está ejecutando. Reintenta 'cmux restore --surface'."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 無法驗證此代理程式工作階段是否已在執行。請重試 'cmux restore --surface'。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 无法验证此智能体会话是否已在运行。请重试 'cmux restore --surface'。"
          }
        },
        "ko": {
