    "browser.import.progress.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can take a few seconds for large profiles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルが大きい場合は数秒かかることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필이 큰 경우 몇 초 걸릴 수 있습니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це може зайняти кілька секунд для великих профілів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置文件较大时，这可能需要几秒钟。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies kann bei großen Profilen einige Sekunden dauern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela peut prendre quelques secondes pour les profils volumineux."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يستغرق هذا بضع ثوانٍ لملفات التعريف الكبيرة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto puede tardar unos segundos para perfiles grandes."
          }
        },
