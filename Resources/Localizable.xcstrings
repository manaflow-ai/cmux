    "update.error.timedOut.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استغرق خادم التحديثات وقتًا طويلاً للاستجابة. حاول مجددًا بعد لحظة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server za ažuriranje je predugo čekao da odgovori. Pokušajte ponovo za trenutak."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdateringsserveren var for lang tid om at svare. Prøv igen om et øjeblik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Update-Server hat zu lange gebraucht, um zu antworten. Versuchen Sie es in einem Moment erneut."
