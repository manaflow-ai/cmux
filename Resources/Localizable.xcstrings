    "cloudTree.link.tunnelStarting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac's tunnel to your Cloud VM network is still starting; the machine reconnects on its own."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac からクラウド VM ネットワークへのトンネルはまだ開始中です。マシンは自動的に再接続します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tunnel dieses Macs zu Ihrem Cloud-VM-Netzwerk wird noch gestartet; die Maschine verbindet sich automatisch wieder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tunnel de ce Mac vers votre réseau de VM Cloud est toujours en cours de démarrage ; la machine se reconnectera d'elle-même."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نفق جهاز Mac هذا إلى شبكة أجهزة Cloud VM الخاصة بك لا يزال يبدأ؛ سيعيد الجهاز الاتصال تلقائيًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El túnel de esta Mac a su red de VM en la nube aún se está iniciando; la máquina se volverá a conectar por sí sola."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 連往您的 Cloud VM 網路的通道仍在啟動中；機器會自動重新連線。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 到您的云 VM 网络的隧道仍在启动中；该机器会自动重新连接。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 Cloud VM 네트워크로의 터널이 아직 시작 중입니다. 머신이 자동으로 다시 연결됩니다."
          }
        }
      }
    },
    "cloudTree.link.tunnelAwaitingApproval": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS is waiting for you to allow the cmux Cloud Tunnel extension in System Settings › General › Login Items & Extensions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS は「システム設定」›「一般」›「ログイン項目と機能拡張」で cmux クラウドトンネル機能拡張を許可するのを待っています。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS wartet darauf, dass Sie die cmux Cloud Tunnel-Extension unter Systemeinstellungen › Allgemein › Anmeldeobjekte & Erweiterungen erlauben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS attend que vous autorisiez l'extension Tunnel Cloud cmux dans Réglages Système › Général › Ouverture et extensions."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتظر نظام macOS منك السماح بامتداد cmux Cloud Tunnel في إعدادات النظام › عام › عناصر تسجيل الدخول والامتدادات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS está esperando que permita la extensión Túnel en la nube de cmux en Ajustes del Sistema › General › Ítems de inicio y extensiones."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 正在等待您在「系統設定」›「一般」›「登入項目與延伸功能」中允許 cmux Cloud Tunnel 延伸功能。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 正在等待您在“系统设置 › 通用 › 登录项与扩展”中允许 cmux 云隧道扩展。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 시스템 설정 › 일반 › 로그인 항목 및 확장 프로그램에서 cmux Cloud Tunnel 확장 프로그램을 허용하기를 대기하고 있습니다."
          }
        }
      }
    },
