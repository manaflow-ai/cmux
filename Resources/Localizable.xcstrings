    "cli.vpn.appManaged.bringingUp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bringing the tunnel up (app-managed, no sudo needed)…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トンネルを接続しています（アプリ管理、sudo 不要）…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnel wird aufgebaut (App-gesteuert, kein sudo erforderlich)…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activation du tunnel (géré par l'application, pas besoin de sudo)…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جاري تشغيل النفق (مُدار بواسطة التطبيق، لا يلزم sudo)…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activando el túnel (administrado por la aplicación, no se necesita sudo)…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在啟動通道 (應用程式管理，不需要 sudo)…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在启动隧道（应用托管，无需 sudo）…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터널을 연결하는 중 (앱 관리형, sudo 권한 불필요)…"
          }
        }
      }
    },
    "cli.vpn.appManaged.needsApproval": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS needs your approval to load the cmux Cloud Tunnel extension. Open System Settings › General › Login Items & Extensions › Network Extensions, allow cmux, then return here (waiting up to 10 minutes)…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux クラウドトンネル機能拡張を読み込むには macOS での承認が必要です。「システム設定」›「一般」›「ログイン項目と機能拡張」›「ネットワーク機能拡張」で cmux を許可してからここに戻ってください（最大 10 分待機します）…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS benötigt Ihre Zustimmung, um die cmux Cloud Tunnel-Extension zu laden. Öffnen Sie die Systemeinstellungen › Allgemein › Anmeldeobjekte & Erweiterungen › Netzwerk-Extensions, erlauben Sie cmux, und kehren Sie dann hierher zurück (Wartezeit bis zu 10 Minuten)…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a besoin de votre autorisation pour charger l'extension Tunnel Cloud cmux. Ouvrez Réglages Système › Général › Ouverture et extensions › Extensions réseau, autorisez cmux, puis revenez ici (attente jusqu'à 10 minutes)…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج نظام macOS إلى موافقتك لتحميل امتداد cmux Cloud Tunnel. افتح إعدادات النظام › عام › عناصر تسجيل الدخول والامتدادات › امتدادات الشبكة، واسمح لـ cmux، ثم عد إلى هنا (الانتظار لمدة تصل إلى 10 دقائق)…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS necesita su aprobación para cargar la extensión Túnel en la nube de cmux. Abra Ajustes del Sistema › General › Ítems de inicio y extensiones › Extensiones de red, permita cmux, luego regrese aquí (esperando hasta 10 minutos)…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 需要您的核准才能載入 cmux Cloud Tunnel 延伸功能。請開啟「系統設定」›「一般」›「登入項目與延伸功能」›「網路延伸功能」，允許 cmux，然後返回此處 (最多等待 10 分鐘)…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 需要您的批准才能加载 cmux 云隧道扩展。请打开“系统设置 › 通用 › 登录项与扩展 › 网络扩展”，允许 cmux，然后返回此处（最多等待 10 分钟）…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud Tunnel 확장 프로그램을 로드하려면 macOS의 승인이 필요합니다. 시스템 설정 › 일반 › 로그인 항목 및 확장 프로그램 › 네트워크 확장 프로그램에서 cmux를 허용한 다음 여기로 돌아오세요 (최대 10분 대기)…"
          }
        }
      }
    },
    "cli.vpn.appManaged.pinned": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned up until `cmux vpn down`. Otherwise cmux starts the tunnel when you open a Cloud machine and stops it when no Cloud sessions remain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`cmux vpn down` を実行するまで接続を維持します。通常は、クラウドマシンを開くと cmux がトンネルを開始し、クラウドセッションがなくなると停止します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angeheftet bis `cmux vpn down`. Andernfalls startet cmux den Tunnel, wenn Sie eine Cloud-Maschine öffnen, und stoppt ihn, wenn keine Cloud-Sitzungen mehr verbleiben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Épinglé jusqu'à l'exécution de `cmux vpn down`. Sinon, cmux démarre le tunnel lorsque vous ouvrez une machine Cloud et l'arrête lorsqu'il ne reste plus de sessions Cloud."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثبت حتى تنفيذ `cmux vpn down`. بخلاف ذلك، يبدأ cmux النفق عندما تفتح جهاز Cloud ويوقفه عندما لا تتبقى أي جلسات Cloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anclado activo hasta `cmux vpn down`. De lo contrario, cmux inicia el túnel cuando abre una máquina de la nube y lo detiene cuando no quedan sesiones en la nube."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "固定啟用，直到執行 `cmux vpn down`。否則，cmux 會在您開啟雲端機器時啟動通道，並在沒有殘留任何雲端工作階段時停止通道。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持开启状态，直到运行 `cmux vpn down`。否则，cmux 会在您打开云机器时启动隧道，并在没有云会话残留时停止隧道。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`cmux vpn down`을 실행할 때까지 연결 상태를 고정합니다. 그렇지 않은 경우, cmux는 Cloud 머신을 열 때 터널을 시작하고 남아 있는 Cloud 세션이 없을 때 터널을 중지합니다."
          }
        }
      }
    },
    "cli.vpn.appManaged.hostsHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Internal hostnames: run `cmux vpn hosts` to map <machine>.internal in /etc/hosts (needs sudo)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内部ホスト名: <machine>.internal を /etc/hosts に登録するには `cmux vpn hosts` を実行してください（sudo が必要）。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Interne Hostnamen: Führen Sie `cmux vpn hosts` aus, um <machine>.internal in /etc/hosts zuzuordnen (erfordert sudo)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noms d'hôtes internes : exécutez `cmux vpn hosts` pour mapper <machine>.internal dans /etc/hosts (nécessite sudo)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسماء المضيفين الداخلية: قم بتشغيل `cmux vpn hosts` لتعيين <machine>.internal في ملف /etc/hosts (يتطلب sudo)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombres de host internos: ejecute `cmux vpn hosts` para mapear <machine>.internal en /etc/hosts (requiere sudo)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內部主機名稱：執行 `cmux vpn hosts` 以在 /etc/hosts 中對應 <machine>.internal (需要 sudo)。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内部主机名：运行 `cmux vpn hosts` 以在 /etc/hosts 中映射 <machine>.internal（需要 sudo）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내부 호스트 이름: `cmux vpn hosts`를 실행하여 /etc/hosts에 <machine>.internal을 매핑할 수 있습니다 (sudo 권한 필요)."
          }
        }
      }
    },
