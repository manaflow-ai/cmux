    "auth.error.browser_sign_in_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إكمال تسجيل الدخول في المتصفح. حاول مرة أخرى أو افتح تسجيل الدخول في متصفحك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće dovršiti prijavu u pregledniku. Pokušajte ponovo ili otvorite prijavu u pregledniku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser-login kunne ikke fuldføres. Prøv igen, eller åbn login i din browser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Browser-Anmeldung konnte nicht abgeschlossen werden. Versuche es erneut oder öffne die Anmeldung in deinem Browser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not complete browser sign-in. Try again or open sign-in in your browser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar el inicio de sesión en el navegador. Inténtalo de nuevo o abre el inicio de sesión en tu navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de terminer la connexion dans le navigateur. Réessayez ou ouvrez la connexion dans votre navigateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile completare l'accesso nel browser. Riprova o apri l'accesso nel browser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザでのサインインを完了できませんでした。もう一度試すか、ブラウザでサインインを開いてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចបញ្ចប់ការចូលគណនីក្នុងកម្មវិធីរុករកបានទេ។ សូមព្យាយាមម្តងទៀត ឬបើកការចូលគណនីក្នុងកម្មវិធីរុករករបស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 로그인을 완료할 수 없습니다. 다시 시도하거나 브라우저에서 로그인을 여세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke fullføre pålogging i nettleseren. Prøv igjen, eller åpne påloggingen i nettleseren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można ukończyć logowania w przeglądarce. Spróbuj ponownie albo otwórz logowanie w przeglądarce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir o login no navegador. Tente novamente ou abra o login no navegador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось завершить вход в браузере. Попробуйте снова или откройте вход в браузере."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถลงชื่อเข้าใช้ในเบราว์เซอร์ได้ ลองอีกครั้งหรือเปิดการลงชื่อเข้าใช้ในเบราว์เซอร์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcıda oturum açma tamamlanamadı. Yeniden deneyin veya oturum açmayı tarayıcınızda açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завершити вхід у браузері. Спробуйте ще раз або відкрийте вхід у браузері."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成浏览器登录。请重试或在浏览器中打开登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完成瀏覽器登入。請重試或在瀏覽器中開啟登入。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thể hoàn tất đăng nhập qua trình duyệt. Thử lại hoặc mở đăng nhập trong trình duyệt của bạn."
          }
        }
      }
    },
    "auth.error.invalid_callback": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كانت معاودة الاتصال بتسجيل الدخول غير صالحة. جرّب تسجيل الدخول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povratni poziv za prijavu nije važeći. Pokušajte se ponovo prijaviti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Login-callbacket var ugyldigt. Prøv at logge ind igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anmelde-Callback war ungültig. Versuche, dich erneut anzumelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in callback was invalid. Try signing in again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La devolución de llamada de inicio de sesión no era válida. Intenta iniciar sesión de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rappel de connexion était invalide. Essayez de vous reconnecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il callback di accesso non era valido. Prova ad accedere di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインコールバックが無効です。もう一度サインインしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការហៅត្រឡប់ការចូលគណនីមិនត្រឹមត្រូវ។ សូមព្យាយាមចូលគណនីម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 콜백이 유효하지 않습니다. 다시 로그인해 보세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Påloggingskallet var ugyldig. Prøv å logge på igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wywołanie zwrotne logowania było nieprawidłowe. Spróbuj zalogować się ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O callback de login era inválido. Tente entrar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обратный вызов входа недействителен. Попробуйте войти снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คอลแบ็กการลงชื่อเข้าใช้ไม่ถูกต้อง ลองลงชื่อเข้าใช้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum açma geri çağrısı geçersizdi. Yeniden oturum açmayı deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зворотний виклик входу недійсний. Спробуйте ввійти ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录回调无效。请重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入回呼無效。請重新登入。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Callback đăng nhập không hợp lệ. Vui lòng thử đăng nhập lại."
          }
        }
      }
    },
