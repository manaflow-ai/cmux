    "browser.automation.error.documentReadinessTimedOut": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت مهلة انتظار جاهزية مستند المتصفح."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Isteklo je vrijeme čekanja da dokument preglednika bude spreman."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidsfristen for at vente på, at browserdokumentet blev klar, udløb."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung beim Warten auf die Bereitschaft des Browserdokuments."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timed out waiting for the browser document to become ready"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el tiempo de espera para que el documento del navegador estuviera listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le délai d’attente de la disponibilité du document du navigateur a expiré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo scaduto durante l'attesa che il documento del browser fosse pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザドキュメントの準備完了を待機中にタイムアウトしました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អស់ពេលរង់ចាំឱ្យឯកសារកម្មវិធីរុករករួចរាល់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 문서가 준비되기를 기다리는 동안 시간이 초과되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidsavbrudd under venting på at nettleserdokumentet skulle bli klart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekroczono limit czasu oczekiwania na gotowość dokumentu przeglądarki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo de espera para que o documento do navegador ficasse pronto expirou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Истекло время ожидания готовности документа браузера."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หมดเวลารอให้เอกสารเบราว์เซอร์พร้อม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcı belgesinin hazır olması beklenirken zaman aşımına uğradı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевищено час очікування готовності документа браузера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待浏览器文档就绪超时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待瀏覽器文件就緒逾時。"
          }
        }
      }
    },
