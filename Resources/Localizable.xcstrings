    "cli.workflow.guidance.recipe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the recipe and copy only the needed top-level keys into .cmux/cmux.json or ~/.config/cmux/cmux.json. Add .cmux/dock.json when the example uses Dock."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne das Rezept und kopiere nur die benötigten obersten Schlüssel nach .cmux/cmux.json oder ~/.config/cmux/cmux.json. Füge .cmux/dock.json hinzu, wenn das Beispiel Dock verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la recette et copiez uniquement les clés de premier niveau nécessaires dans .cmux/cmux.json ou ~/.config/cmux/cmux.json. Ajoutez .cmux/dock.json si l’exemple utilise le Dock."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الوصفة وانسخ المفاتيح العلوية المطلوبة فقط إلى .cmux/cmux.json أو ~/.config/cmux/cmux.json. أضف .cmux/dock.json عندما يستخدم المثال Dock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la receta y copia solo las claves de nivel superior necesarias en .cmux/cmux.json o ~/.config/cmux/cmux.json. Añade .cmux/dock.json si el ejemplo usa Dock."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟配方，只將需要的頂層鍵複製到 .cmux/cmux.json 或 ~/.config/cmux/cmux.json。範例使用 Dock 時再加入 .cmux/dock.json。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开配方，只将需要的顶层键复制到 .cmux/cmux.json 或 ~/.config/cmux/cmux.json。示例使用 Dock 时再添加 .cmux/dock.json。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레시피를 열고 필요한 최상위 키만 .cmux/cmux.json 또는 ~/.config/cmux/cmux.json에 복사합니다. 예시가 Dock을 사용하면 .cmux/dock.json도 추가합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシピを開き、必要なトップレベルキーだけを .cmux/cmux.json または ~/.config/cmux/cmux.json にコピーします。例で Dock を使う場合は .cmux/dock.json も追加します。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otvorite recept i kopirajte samo potrebne ključeve najviše razine u .cmux/cmux.json ili ~/.config/cmux/cmux.json. Dodajte .cmux/dock.json kada primjer koristi Dock."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åbn opskriften og kopiér kun de nødvendige nøgler på øverste niveau ind i .cmux/cmux.json eller ~/.config/cmux/cmux.json. Tilføj .cmux/dock.json, når eksemplet bruger Dock."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apri la ricetta e copia solo le chiavi di primo livello necessarie in .cmux/cmux.json o ~/.config/cmux/cmux.json. Aggiungi .cmux/dock.json se l'esempio usa il Dock."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បើក recipe ហើយចម្លងតែ keys កម្រិតខ្ពស់ដែលត្រូវការទៅ .cmux/cmux.json ឬ ~/.config/cmux/cmux.json។ បន្ថែម .cmux/dock.json នៅពេលឧទាហរណ៍ប្រើ Dock។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åpne oppskriften og kopier bare de nødvendige nøklene på toppnivå inn i .cmux/cmux.json eller ~/.config/cmux/cmux.json. Legg til .cmux/dock.json når eksempelet bruker Dock."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otwórz przepis i skopiuj tylko potrzebne klucze najwyższego poziomu do .cmux/cmux.json lub ~/.config/cmux/cmux.json. Dodaj .cmux/dock.json, gdy przykład używa Dock."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra a receita e copie apenas as chaves de nível superior necessárias para .cmux/cmux.json ou ~/.config/cmux/cmux.json. Adicione .cmux/dock.json quando o exemplo usar Dock."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Откройте рецепт и скопируйте только нужные ключи верхнего уровня в .cmux/cmux.json или ~/.config/cmux/cmux.json. Добавьте .cmux/dock.json, если пример использует Dock."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิด recipe และคัดลอกเฉพาะ key ระดับบนสุดที่ต้องการลงใน .cmux/cmux.json หรือ ~/.config/cmux/cmux.json เพิ่ม .cmux/dock.json เมื่อตัวอย่างใช้ Dock"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tarifi açın ve yalnızca gerekli üst düzey anahtarları .cmux/cmux.json veya ~/.config/cmux/cmux.json dosyasına kopyalayın. Örnek Dock kullanıyorsa .cmux/dock.json ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відкрийте рецепт і скопіюйте лише потрібні ключі верхнього рівня у .cmux/cmux.json або ~/.config/cmux/cmux.json. Додайте .cmux/dock.json, якщо приклад використовує Dock."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mở recipe và chỉ sao chép các key cấp cao nhất cần thiết vào .cmux/cmux.json hoặc ~/.config/cmux/cmux.json. Thêm .cmux/dock.json khi ví dụ sử dụng Dock."
          }
        }
      }
    },
    "cli.workflow.guidance.adapt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace sample paths, commands, URLs, tool names, and placements with values for this repository."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetze Beispielpfade, Befehle, URLs, Toolnamen und Platzierungen durch Werte dieses Repositorys."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacez les chemins, commandes, URL, noms d’outils et placements d’exemple par ceux de ce dépôt."
          }
