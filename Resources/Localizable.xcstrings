          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدى تغيير اسم الطرفية إلى تغيير %1$d من %#@count2@. ومنع تغيير آخر إجراء تراجع آمن. حدّث وأعد المحاولة."
          },
          "substitutions": {
            "count2": {
              "argNum": 2,
              "formatSpecifier": "d",
              "variations": {
                "plural": {
                  "zero": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%d علامة تبويب بعيدة"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%d علامة تبويب بعيدة"
                    }
                  },
                  "two": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%d علامتي تبويب بعيدتين"
