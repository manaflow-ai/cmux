          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Précédent et Suivant naviguent parmi les changements de focus entre les volets, les onglets et les espaces de travail."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التنقل للخلف وللأمام يتنقل بين تغييرات التركيز في الأجزاء وعلامات التبويب ومساحات العمل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
