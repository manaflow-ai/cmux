    "cli.workflow.review-pr.instantiate.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Review PR recipe, point its command and URL at the repository's review flow, merge it into cmux.json, then run cmux reload-config."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorlage Review PR öffnen, Befehl und URL an den Review-Ablauf des Repositorys anpassen, in cmux.json übernehmen und cmux reload-config ausführen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la recette Review PR, adaptez sa commande et son URL au processus de revue du dépôt, ajoutez-la à cmux.json, puis exécutez cmux reload-config."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la receta Review PR, adapta su comando y URL al proceso de revisión del repositorio, incorpórala en cmux.json y ejecuta cmux reload-config."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح وصفة Review PR، وعدّل الأمر وعنوان URL ليتوافقا مع سير المراجعة في المستودع، وأضفها إلى cmux.json، ثم شغّل cmux reload-config."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Review PR 配方，将命令和 URL 指向仓库的审查流程，合并到 cmux.json，然后运行 cmux reload-config。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 Review PR 配方，將命令和 URL 指向儲存庫的審查流程，合併到 cmux.json，然後執行 cmux reload-config。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Review PR 설정 예제를 열고 명령과 URL을 저장소의 검토 흐름에 맞춘 뒤 cmux.json에 병합하고 cmux reload-config를 실행하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Review PR レシピを開き、コマンドと URL をリポジトリのレビュー手順に合わせ、cmux.json に追加して cmux reload-config を実行します。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otvorite Review PR recept, usmjerite naredbu i URL na tok pregleda repozitorija, spojite ga u cmux.json, zatim pokrenite cmux reload-config."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åbn Review PR-opskriften, peg dens kommando og URL mod repositoryets gennemgangsflow, flet det ind i cmux.json, og kør derefter cmux reload-config."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apri la ricetta Review PR, punta il suo comando e URL al flusso di revisione del repository, uniscilo in cmux.json, quindi esegui cmux reload-config."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បើក recipe Review PR, ចង្អុល command និង URL របស់វាទៅ flow ពិនិត្យរបស់ repository, បញ្ចូលទៅ cmux.json, រួចដំណើរការ cmux reload-config."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åpne Review PR-oppskriften, pek kommandoen og URL mot repositoriets gjennomgangsflyt, flett det inn i cmux.json, og kjør deretter cmux reload-config."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otwórz przepis Review PR, skieruj jego polecenie i adres URL na przepływ recenzji repozytorium, scal go do cmux.json, a następnie uruchom cmux reload-config."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra a receita Review PR, aponte seu comando e URL para o fluxo de revisão do repositório, mescle no cmux.json e execute cmux reload-config."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Откройте рецепт Review PR, направьте его команду и URL на процесс проверки репозитория, объедините в cmux.json, затем выполните cmux reload-config."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิด recipe Review PR, ชี้คำสั่งและ URL ไปที่ขั้นตอน review ของ repository, รวมเข้ากับ cmux.json แล้วรัน cmux reload-config"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Review PR tarifini açın, komutunu ve URL'sini deponun inceleme akışına yönlendirin, cmux.json'a ekleyin, ardından cmux reload-config komutunu çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відкрийте рецепт Review PR, вкажіть команду та URL для процесу рецензування репозиторію, об'єднайте з cmux.json, потім виконайте cmux reload-config."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mở recipe Review PR, trỏ lệnh và URL vào luồng review của kho lưu trữ, gộp vào cmux.json, sau đó chạy cmux reload-config."
          }
        }
      }
    },
