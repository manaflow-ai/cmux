          }
        }
      }
    },
    "settings.networking.saveFailed.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your previous networking configuration is still active. Check your account connection and relay values, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のネットワーク設定が引き続き有効です。アカウント接続とリレーの値を確認して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此前的网络配置仍在生效。请检查账户连接和中继值，然后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre vorherige Netzwerkkonfiguration ist immer noch aktiv. Überprüfen Sie Ihre Kontoverbindung und Relay-Werte und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre configuration réseau précédente est toujours active. Vérifiez la connexion de votre compte et les valeurs des relais, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال تكوين الشبكة السابق نشطًا. تحقق من اتصال حسابك وقيم المرحلات، ثم حاول مجددًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu configuración de red anterior sigue activa. Comprueba la conexión de tu cuenta y los valores de retransmisión, y luego vuelve a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您先前的網路組態仍處於啟用狀態。請檢查您的帳戶連線與中繼值，然後再試一次。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 네트워크 구성이 여전히 활성화되어 있습니다. 계정 연결 및 릴레이 값을 확인한 다음 다시 시도하세요."
          }
        }
      }
    },
