    "cloudTunnel.error.backendUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cmux build does not include the signed Network Extension required for browser access."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この cmux ビルドには、ブラウザアクセスに必要な署名済み Network Extension が含まれていません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses cmux-Build enthält nicht die für den Browserzugriff erforderliche signierte Netzwerk-Extension."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version de cmux n'inclut pas l'extension réseau signée requise pour l'accès au navigateur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتضمن إصدار cmux هذا امتداد الشبكة المُوقع والمطلوب للوصول إلى المتصفح."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilación de cmux no incluye la extensión de red firmada requerida para el acceso del navegador."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 cmux 版本不包含瀏覽器存取所需的已簽署「網路延伸功能」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 cmux 构建版本不包含浏览器访问所需的签名网络扩展。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 cmux 빌드에는 브라우저 접근에 필요한 서명된 네트워크 확장 프로그램이 포함되어 있지 않습니다."
          }
        }
      }
    },
    "cloudTunnel.error.notSignedIn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to cmux Cloud first (`cmux auth login`), then retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず cmux Cloud にサインイン（`cmux auth login`）してから再試行してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich zuerst bei cmux Cloud an (`cmux auth login`) und versuchen Sie es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous d'abord à cmux Cloud (`cmux auth login`), puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجل الدخول إلى cmux Cloud أولاً (`cmux auth login`)، ثم حاول مجددًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sesión en cmux Cloud primero (`cmux auth login`), luego vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先登入 cmux Cloud (使用 `cmux auth login`)，然後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先登录 cmux Cloud（`cmux auth login`），然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 cmux Cloud에 로그인(`cmux auth login`)한 후 다시 시도하세요."
          }
        }
      }
    },
    "cloudTunnel.error.rebootRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS needs a restart to finish installing the cmux Cloud Tunnel extension."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux クラウドトンネル機能拡張のインストールを完了するには macOS の再起動が必要です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS erfordert einen Neustart, um die Installation der cmux Cloud Tunnel-Extension abzuschließen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS nécessite un redémarrage pour terminer l'installation de l'extension Tunnel Cloud cmux."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج نظام macOS إلى إعادة التشغيل لإنهاء تثبيت امتداد cmux Cloud Tunnel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS necesita reiniciarse para finalizar la instalación de la extensión Túnel en la nube de cmux."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 需要重新啟動以完成 cmux Cloud Tunnel 延伸功能的安裝。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 需要重新启动以完成 cmux 云隧道扩展的安装。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud Tunnel 확장 프로그램의 설치를 완료하려면 macOS를 재시동해야 합니다."
          }
        }
      }
    },
    "cloudTunnel.error.appNotInApplicationsFolder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS only loads the cmux Cloud Tunnel extension from the Applications folder. Move cmux.app to /Applications and retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS は「アプリケーション」フォルダにある cmux からのみクラウドトンネル機能拡張を読み込みます。cmux.app を /Applications に移動して再試行してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS lädt die cmux Cloud Tunnel-Extension nur aus dem Programme-Ordner. Verschieben Sie cmux.app nach /Applications und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS charge uniquement l'extension Tunnel Cloud cmux depuis le dossier Applications. Déplacez cmux.app vers /Applications et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم نظام macOS بتحميل امتداد cmux Cloud Tunnel من مجلد التطبيقات (Applications) فقط. انقل cmux.app إلى /Applications وحاول مجددًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS solo carga la extensión Túnel en la nube de cmux desde la carpeta Aplicaciones. Mueva cmux.app a /Applications y vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 僅從「應用程式」檔案夾載入 cmux Cloud Tunnel 延伸功能。請將 cmux.app 移動到 /Applications 後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 仅支持从“应用程序”文件夹加载 cmux 云隧道扩展。请将 cmux.app 移动到 /Applications，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS는 응용 프로그램(Applications) 폴더에서만 cmux Cloud Tunnel 확장 프로그램을 로드할 수 있습니다. cmux.app을 /Applications 폴더로 이동한 후 다시 시도하세요."
          }
        }
      }
    },
    "cloudTunnel.error.startFailed": {
      "extractionState": "manual",
