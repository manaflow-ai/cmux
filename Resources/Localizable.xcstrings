    "settings.config.banner.cmux": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the cmux Ghostty config selected for this build. Edit it here, then Save to reload cmux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはこのビルドで選択されている cmux Ghostty 設定です。ここで編集し、保存すると cmux が再読み込みされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是为此构建选择的 cmux Ghostty 配置。可在此处编辑，然后保存以重新加载 cmux。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist die für diesen Build ausgewählte cmux Ghostty-Konfiguration. Bearbeiten Sie sie hier und speichern Sie sie, um cmux neu zu laden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est la configuration Ghostty de cmux sélectionnée pour cette build. Modifiez-la ici, puis enregistrez pour recharger cmux."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا هو تكوين cmux Ghostty المحدد لهذا الإصدار. قم بتحريره هنا، ثم احفظ لإعادة تحميل cmux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es la configuración de Ghostty para cmux seleccionada para esta compilación. Edítela aquí y luego guarde para volver a cargar cmux."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是為此組建選擇的 cmux Ghostty 設定。在此處編輯，然後儲存以重新載入 cmux。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드용으로 선택된 cmux Ghostty 설정입니다. 여기에서 편집한 다음 저장하여 cmux를 다시 로드하십시오."
          }
        }
      }
    },
    "settings.config.banner.synced": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a generated preview of the effective config. Edit the cmux tab to change what cmux reads."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは実効設定の生成プレビューです。cmux が読み込む内容を変更するには cmux タブを編集してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是生效配置的生成预览。请编辑 cmux 标签页来改变 cmux 读取的内容。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist eine generierte Vorschau der effektiven Konfiguration. Bearbeiten Sie den cmux-Tab, um zu ändern, was cmux liest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est un aperçu généré de la configuration effective. Modifiez l’onglet cmux pour changer ce que cmux lit."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه معاينة تم إنشاؤها للتكوين الفعال. قم بتحرير علامة تبويب cmux لتغيير ما يقرأه cmux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es una vista previa generada de la configuración vigente. Edite la pestaña de cmux para cambiar lo que lee cmux."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是生效設定的產生的預覽。編輯 cmux 標籤頁以變更 cmux 讀取的內容。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적용된 설정의 자동 생성된 미리보기입니다. cmux가 읽는 내용을 변경하려면 cmux 탭을 편집하십시오."
          }
        }
      }
    },
    "settings.config.banner.syncedNoGhostty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a generated preview of the effective config. No base Ghostty config file was found, so only cmux overrides are shown."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは実効設定の生成プレビューです。ベースの Ghostty 設定ファイルが見つからなかったため、cmux の上書き設定のみを表示しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是生效配置的生成预览。未找到基础 Ghostty 配置文件，因此只显示 cmux 的覆盖项。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist eine generierte Vorschau der effektiven Konfiguration. Es wurde keine Ghostty-Basiskonfigurationsdatei gefunden, daher werden nur cmux-Überschreibungen angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est un aperçu généré de la configuration effective. Aucun fichier de configuration Ghostty de base n’a été trouvé, seules les surcharges cmux sont donc affichées."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه معاينة تم إنشاؤها للتكوين الفعال. لم يتم العثور على ملف تكوين Ghostty أساسي، لذا يتم عرض تجاوزات cmux فقط."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es una vista previa generada de la configuración vigente. No se encontró ningún archivo de configuración base de Ghostty, por lo que solo se muestran las anulaciones de cmux."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是生效設定的產生的預覽。找不到基礎 Ghostty 設定檔，因此僅顯示 cmux 覆寫。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적용된 설정의 자동 생성된 미리보기입니다. 기본 Ghostty 설정 파일을 찾을 수 없어 cmux 재정의 설정만 표시됩니다."
          }
        }
      }
    },
