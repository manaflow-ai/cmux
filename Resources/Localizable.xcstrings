    "shortcut.when.caption.sidebarFocus": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط أثناء تركيز الشريط الجانبي الأيمن"
          }
        },
        "bs": {
