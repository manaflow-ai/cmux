    "cli.cloud.domains.helpDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Publish VM ports on generated or custom domains."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成ドメインまたはカスタムドメインで VM ポートを公開します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在生成的域名或自定义域名上发布 VM 端口。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Veröffentlichen Sie VM-Ports auf generierten oder benutzerdefinierten Domains."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Publiez les ports de VM sur des domaines générés ou personnalisés."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انشر منافذ VM على نطاقات تم إنشاؤها أو مخصصة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Publica puertos de VM en dominios generados o personalizados."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在產生的或自訂的網域上發佈 VM 連接埠。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성된 도메인 또는 사용자 지정 도메인에 VM 포트를 게시합니다."
          }
        }
      }
    },
    "cli.cloud.domains.invalidAccess": {
      "extractionState": "manual",
      "localizations": {
