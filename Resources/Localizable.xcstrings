          }
        }
      }
    },
    "settings.terminal.resumeCommands.invalidSignature": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signature does not match. Delete this approval and approve the command again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名が一致しません。この承認を削除してから、コマンドを再度承認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "签名不匹配。请删除此授权并重新授权该命令。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Signatur stimmt nicht überein. Löschen Sie diese Freigabe und geben Sie den Befehl erneut frei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La signature ne correspond pas. Supprimez cette approbation et approuvez à nouveau la commande."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التوقيع غير متطابق. احذف هذه الموافقة ووافق على الأمر مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La firma no coincide. Elimina esta aprobación y vuelve a aprobar el comando."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簽章不符。請刪除此核准並重新核准該指令。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서명이 일치하지 않습니다. 이 승인을 삭제하고 명령을 다시 승인하십시오."
          }
        }
      }
    },
    "settings.terminal.resumeCommands.policy.auto": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
