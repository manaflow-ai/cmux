        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update server took too long to respond. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de actualizaciones tardó demasiado en responder. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur de mises à jour a mis trop de temps à répondre. Réessayez dans un instant."
