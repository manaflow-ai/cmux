          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: trenutna cmux površina nije mogla biti identifikovana. Pokušajte ponovo iz ovog terminala ili proslijedite --surface <id|ref>."
          }
        },
        "da": {
          "stringUnit": {
