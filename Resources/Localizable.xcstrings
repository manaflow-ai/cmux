    "workspaceGroup.placement.afterCurrent.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل مساحات عمل المجموعة الجديدة بعد مساحة العمل النشطة في تلك المجموعة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umetni nove grupne workspacee poslije aktivnog workspacea u toj grupi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsæt nye gruppe-workspaces efter det aktive workspace i den gruppe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt neue Gruppen-Workspaces nach dem aktiven Workspace in dieser Gruppe ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insert new group workspaces after the active workspace in that group."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserta nuevos workspaces de grupo después del workspace activo en ese grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Insère les nouveaux workspaces de groupe après le workspace actif dans ce groupe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisce i nuovi workspace di gruppo dopo il workspace attivo in quel gruppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループ内のアクティブなワークスペースの後に新しいワークスペースを挿入します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ចូល workspace ថ្មីក្នុងក្រុម បន្ទាប់ពី workspace សកម្មនៅក្នុងក្រុមនោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 그룹의 활성 workspace 뒤에 새 그룹 workspace를 삽입합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett inn nye gruppe-workspaces etter aktivt workspace i den gruppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstawia nowe workspace grupy po aktywnym workspace w tej grupie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insere novos workspaces de grupo após o workspace ativo nesse grupo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставляет новые workspace группы после активного workspace в этой группе."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แทรก workspace ใหม่ของกลุ่มหลัง workspace ที่ใช้งานอยู่ในกลุ่มนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni grup workspace’lerini o gruptaki aktif workspace’ten sonra ekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставляє нові workspace групи після активного workspace у цій групі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在该组的活动 workspace 后插入新的组 workspace。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在該群組的作用中 workspace 後插入新的群組 workspace。"
          }
        }
      }
    },
