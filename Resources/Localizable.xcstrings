    "cloudTree.error.terminalAttachTimedOut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not attach %@ in time (%@). The terminal may still be running on the machine; try opening it again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht rechtzeitig verbunden werden (%@). Das Terminal läuft möglicherweise noch auf dem Rechner. Versuche, es erneut zu öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de connecter %@ à temps (%@). Le terminal est peut-être encore actif sur la machine ; essayez de l’ouvrir à nouveau."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر توصيل %@ في الوقت المحدد (%@). قد تكون الطرفية لا تزال تعمل على الجهاز؛ حاول فتحها مجددًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar %@ a tiempo (%@). Es posible que el terminal siga ejecutándose en la máquina; intenta abrirlo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法及時連接 %@（%@）。終端機可能仍在機器上執行，請嘗試重新開啟。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法及时连接 %@（%@）。终端可能仍在机器上运行，请尝试重新打开。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 제시간에 연결하지 못했습니다(%@). 터미널이 컴퓨터에서 계속 실행 중일 수 있습니다. 다시 열어 보세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に時間内に接続できませんでした（%@）。ターミナルはマシン上で実行中の可能性があります。もう一度開いてみてください。"
          }
        }
      }
    },
    "cloudTree.error.terminalExited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
