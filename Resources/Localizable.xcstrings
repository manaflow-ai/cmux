    "cli.cloud.domains.dns.apexFallback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No ALIAS/ANAME/flattening record at your DNS provider? Publish www.%@ and redirect the apex to it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS プロバイダーに ALIAS/ANAME/フラット化レコードがない場合は、www.%@ を公開して apex からリダイレクトしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 DNS 服务商没有 ALIAS/ANAME/flattening 记录？请发布 www.%@ 并把裸域重定向到它。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein ALIAS-/ANAME- oder Flattening-Eintrag bei deinem DNS-Anbieter? Veröffentliche www.%@ und leite den Apex-Eintrag dorthin weiter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'enregistrement ALIAS/ANAME/flattening chez votre fournisseur DNS ? Publiez www.%@ et redirigez l'apex vers celui-ci."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد سجل ALIAS/ANAME/تسطيح لدى موفر خدمة DNS الخاص بك؟ انشر www.%@ وقم بتوجيه الأوج (apex) إليه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No tienes ningún registro ALIAS/ANAME/aplanamiento en tu proveedor de DNS? Publica www.%@ y redirige el apex a él."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 DNS 供應商沒有 ALIAS/ANAME/扁平化 (flattening) 紀錄？請發佈 www.%@並將 apex 重新導向至該處。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS 제공업체에 ALIAS/ANAME/flattening 레코드가 없습니까? www.%@ 레코드를 게시하고 apex를 이곳으로 리디렉션하세요."
          }
        }
      }
    },
