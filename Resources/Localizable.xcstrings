    "socket.cloudVM.authRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud VM access requires sign-in. Run `cmux auth login`, then retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud VMを利用するにはサインインが必要です。`cmux auth login`を実行してから再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访问 Cloud VM 需要登录。请运行 `cmux auth login` 后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf die Cloud-VM erfordert eine Anmeldung. Führe `cmux auth login` aus und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès aux VM Cloud nécessite une connexion. Exécutez `cmux auth login`, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب الوصول إلى الآلة الافتراضية السحابية تسجيل الدخول. قم بتشغيل `cmux auth login` ثم أعد المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la VM en la nube requiere iniciar sesión. Ejecute `cmux auth login` y vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存取雲端 VM 需要登入。請執行 `cmux auth login`，然後重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 VM에 액세스하려면 로그인이 필요합니다. `cmux auth login`을 실행한 다음 다시 시도하십시오."
          }
        }
      }
    },
