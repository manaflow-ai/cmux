        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនអាចផ្ទៀងផ្ទាត់ữ ហត្ថលេខារបស់ការអាប់ដេតបានទេ។ សូមព្យាយាមម្តងទៀតនៅពេលក្រោយ។"
