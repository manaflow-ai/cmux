    "cli.vm.desktop.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has no desktop to show. New machines boot a screen; this one was created shell-only (`--base`)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ には表示できるデスクトップがありません。新しいマシンには画面がありますが、このマシンはシェル専用（`--base`）で作成されました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有可显示的桌面。新机器会启动一个屏幕；这台是以仅 shell 方式创建的（`--base`）。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat keinen anzuzeigenden Desktop. Neue Maschinen starten einen Bildschirm; diese wurde rein für die Shell erstellt (`--base`)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'a pas de bureau à afficher. Les nouvelles machines démarrent avec un écran ; celle-ci a été créée en mode shell uniquement (`--base`)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي %@ على سطح مكتب لعرضه. تبدأ الأجهزة الجديدة شاشة؛ ولكن تم إنشاء هذا الجهاز ليقتصر على الشل فقط (`--base`)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no tiene escritorio que mostrar. Las máquinas nuevas inician una pantalla; esta se creó solo para shell (`--base`)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 沒有可顯示的桌面。新機器會啟動螢幕；此機器建立時被設定為僅限 Shell (`--base`)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 표시할 데스크톱이 없습니다. 새 가상 머신은 화면을 부팅하지만, 이 가상 머신은 셸 전용(`--base`)으로 생성되었습니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nema desktop za prikaz. Nove mašine pokreću ekran; ova je kreirana samo sa shellom (`--base`)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ har inget skrivebord at vise. Nye maskiner starter med en skærm; denne blev oprettet kun som shell (`--base`)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ non ha un desktop da mostrare. Le nuove macchine avviano una schermata; questa è stata creata solo con shell (`--base`)."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ មិនមី desktop សម្រាប់បង្ហាញ។ ម៉ាស៊ីនថ្មី boot screen; ម៉ាស៊ីននេះត្រូវបានបង្កើតជា shell-only (`--base`)។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ har ingen skrivebord å vise. Nye maskiner starter med en skjerm; denne ble opprettet kun med skall (`--base`)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nie ma pulpitu do wyświetlenia. Nowe maszyny uruchamiają ekran; ta została utworzona tylko z powłoką (`--base`)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ não tem desktop para exibir. Novas máquinas inicializam com uma tela; esta foi criada somente com shell (`--base`)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ не имеет рабочего стола для отображения. Новые машины загружают экран; эта была создана только с оболочкой (`--base`)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ไม่มี desktop ให้แสดง เครื่องใหม่จะบูตพร้อมหน้าจอ แต่เครื่องนี้ถูกสร้างแบบ shell-only (`--base`)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@'ın gösterilecek masaüstü yok. Yeni makineler bir ekranla başlar; bu makine yalnızca kabuk olarak oluşturuldu (`--base`)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ не має робочого столу для відображення. Нові машини завантажують екран; ця була створена лише з оболонкою (`--base`)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ không có desktop để hiển thị. Machine mới khởi động với một màn hình; machine này được tạo ở chế độ chỉ shell (`--base`)."
          }
        }
      }
    },
