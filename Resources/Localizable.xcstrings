    "settings.app.focusHistoryIncludesPanesAndTabs.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back and forward navigate between workspaces only."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "戻る／進むではワークスペース間のみを移動します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后退和前进仅在工作区之间导航。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurück und Vorwärts navigiert nur zwischen Arbeitsbereichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Précédent et Suivant naviguent uniquement entre les espaces de travail."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التنقل للخلف وللأمام بين مساحات العمل فقط."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
