    "settings.terminal.copyOnSelect.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يضيف cmux نسخًا إلى حافظة النظام عند التحديد. لا تزال إعدادات Ghostty تتحكم في «لصق التحديد»."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ne dodaje kopiranje u sistemski međuspremnik pri odabiru. Ghostty konfiguracija i dalje kontroliše Lijepljenje odabira."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux tilføjer ikke kopiering til systemets udklipsholder ved markering. Ghostty-konfiguration styrer stadig Indsæt markering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux fügt beim Auswählen kein Kopieren in die Systemzwischenablage hinzu. Die Ghostty-Konfiguration steuert weiterhin „Auswahl einfügen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux does not add system-clipboard copy on selection. Ghostty config still controls Paste Selection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no añade copia al portapapeles del sistema al seleccionar. La configuración de Ghostty sigue controlando Pegar selección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux n’ajoute pas de copie vers le presse-papiers système lors de la sélection. La configuration Ghostty contrôle toujours Coller la sélection."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux non aggiunge la copia negli appunti di sistema alla selezione. La configurazione di Ghostty controlla ancora Incolla selezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux は選択時のシステムクリップボードへのコピーを追加しません。Ghostty 設定が引き続き「選択をペースト」を制御します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux មិនបន្ថែមការចម្លងទៅ clipboard របស់ប្រព័ន្ធពេលជ្រើសទេ។ ការកំណត់ Ghostty នៅតែគ្រប់គ្រង Paste Selection។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux는 선택 시 시스템 클립보드 복사를 추가하지 않습니다. Ghostty 설정이 계속 Paste Selection을 제어합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux legger ikke til kopiering til systemutklippstavlen ved markering. Ghostty-konfigurasjonen styrer fortsatt Lim inn markering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nie dodaje kopiowania do schowka systemowego przy zaznaczaniu. Konfiguracja Ghostty nadal steruje funkcją Wklej zaznaczenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux não adiciona cópia para a área de transferência do sistema ao selecionar. A configuração do Ghostty ainda controla Colar seleção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux не добавляет копирование в системный буфер обмена при выделении. Конфигурация Ghostty по-прежнему управляет «Вставить выделение»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux จะไม่เพิ่มการคัดลอกไปยังคลิปบอร์ดของระบบเมื่อเลือก การกำหนดค่า Ghostty ยังคงควบคุม Paste Selection"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux seçim sırasında sistem panosuna kopyalamayı eklemez. Ghostty yapılandırması Paste Selection denetimini sürdürür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux не додає копіювання до системного буфера обміну під час виділення. Конфігурація Ghostty й надалі керує «Вставити виділення»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 不会在选择时额外复制到系统剪贴板。Ghostty 配置仍控制“粘贴选择”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 不會在選取時額外複製到系統剪貼簿。Ghostty 設定仍控制「貼上選取」。"
          }
        }
      }
    },
    "settings.terminal.copyOnSelect.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُنسخ نص الطرفية المحدد أيضًا إلى حافظة النظام عند تثبيت التحديد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odabrani tekst terminala također se kopira u sistemski međuspremnik kada se odabir potvrdi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeret terminaltekst kopieres også til systemets udklipsholder, når markeringen bekræftes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählter Terminaltext wird zusätzlich in die Systemzwischenablage kopiert, sobald die Auswahl bestätigt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected terminal text is also copied to the system clipboard when the selection is committed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto seleccionado del terminal también se copia al portapapeles del sistema cuando se confirma la selección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte sélectionné dans le terminal est aussi copié dans le presse-papiers système lorsque la sélection est validée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo selezionato nel terminale viene copiato anche negli appunti di sistema quando la selezione viene confermata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択が確定したとき、ターミナルで選択したテキストをシステムクリップボードにもコピーします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អត្ថបទ terminal ដែលបានជ្រើសនឹងត្រូវចម្លងទៅ clipboard របស់ប្រព័ន្ធផងដែរ ពេលការជ្រើសត្រូវបានបញ្ជាក់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택이 확정되면 선택한 터미널 텍스트도 시스템 클립보드에 복사됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Markert terminaltekst kopieres også til systemutklippstavlen når markeringen bekreftes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznaczony tekst terminala jest też kopiowany do schowka systemowego po zatwierdzeniu zaznaczenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto selecionado no terminal também é copiado para a área de transferência do sistema quando a seleção é confirmada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделенный текст терминала также копируется в системный буфер обмена после подтверждения выделения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความเทอร์มินัลที่เลือกจะถูกคัดลอกไปยังคลิปบอร์ดของระบบด้วยเมื่อยืนยันการเลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçim kesinleştiğinde seçilen terminal metni sistem panosuna da kopyalanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибраний текст термінала також копіюється до системного буфера обміну після підтвердження виділення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认选择后，所选终端文本也会复制到系统剪贴板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認選取後，所選終端機文字也會複製到系統剪貼簿。"
          }
        }
      }
    },
    "settings.terminal.memoryGuardrail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runaway Memory Guardrail"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暴走メモリガードレール"
          }
        }
      }
    },
    "settings.terminal.memoryGuardrail.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No warning is shown when a pane's process tree grows large. A leaking process can OOM-suspend the entire app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペインのプロセスツリーが大きくなっても警告は表示されません。リークしたプロセスがアプリ全体を OOM で停止させる可能性があります。"
          }
        }
      }
    },
    "settings.terminal.memoryGuardrail.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux warns you with a badge and a banner when one pane's process tree uses too much memory, so a single leak can't crash the whole app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つのペインのプロセスツリーが過剰なメモリを使用すると、バッジとバナーで警告します。1件のリークでアプリ全体がクラッシュするのを防ぎます。"
          }
        }
      }
    },
    "settings.terminal.memoryGuardrail.threshold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory Warning Threshold (GB)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリ警告のしきい値（GB）"
          }
        }
      }
    },
    "settings.terminal.memoryGuardrail.threshold.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pane is flagged once its combined process-tree memory crosses this many gigabytes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペインのプロセスツリーの合計メモリがこのギガバイト数を超えるとフラグが立てられます。"
          }
        }
      }
    },
    "settings.terminal.rendererRealization": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim Offscreen Terminal Memory"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフスクリーン端末のメモリを回収"
          }
        }
      }
    },
    "settings.terminal.rendererRealization.idleSeconds": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim After Idle Seconds"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイドル秒数経過後に回収"
          }
        }
      }
    },
    "settings.terminal.rendererRealization.idleSeconds.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An off-screen terminal must stay off-screen this long before its renderer memory is reclaimed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフスクリーンの端末は、レンダラーのメモリが回収されるまでこの時間オフスクリーンのままである必要があります。"
          }
        }
      }
    },
    "settings.terminal.rendererRealization.maxWarmRenderers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Max Warm Renderers"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォームレンダラーの最大数"
          }
        }
      }
    },
    "settings.terminal.rendererRealization.maxWarmRenderers.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most recently visible terminals keep their renderer ready so switching stays instant. Extra off-screen renderers are reclaimed oldest first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近表示した端末はレンダラーを準備状態に保ち、切り替えを高速に保ちます。余分なオフスクリーンのレンダラーは古いものから回収されます。"
          }
        }
      }
    },
    "settings.terminal.rendererRealization.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every visited terminal keeps its full GPU renderer allocated until you close it, even when off-screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訪問した端末は、オフスクリーンでも閉じるまでGPUレンダラーをすべて確保し続けます。"
          }
        }
      }
    },
    "settings.terminal.rendererRealization.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off-screen terminals release their GPU renderer memory while idle and rebuild it instantly when you switch back. The process keeps running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフスクリーンの端末はアイドル中にGPUレンダラーのメモリを解放し、切り替え時に即座に再構築します。プロセスは動作し続けます。"
          }
        }
      }
    },
