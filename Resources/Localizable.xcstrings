    "settings.browser.urlAllowlist.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restricts embedded-browser navigation to matching hosts or URL patterns. A suggested localhost list is shown; saving it opts into the restriction. Remove entries to block them, or, when no managed policy applies, clear the list to allow all web origins. Invalid-only values fail closed. Internal cmux documents remain available."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵ブラウザの移動を、一致するホストまたはURLパターンに制限します。localhostの候補リストが表示され、保存すると制限が有効になります。エントリを削除するとそのURLをブロックし、管理ポリシーがない場合にリストを空にするとすべてのWebオリジンを許可します。無効なルールだけの値は安全側でブロックされます。cmux内部ドキュメントは引き続き利用できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把内嵌浏览器的导航限制在匹配的主机或 URL 模式内。这里会显示一份建议的 localhost 列表；保存即表示启用该限制。移除条目即可拦截它们；在没有托管策略时，清空列表可放行所有 web 源。全部无效的取值会按拒绝处理。cmux 内部文档始终可用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schränkt die Navigation im eingebetteten Browser auf übereinstimmende Hosts oder URL-Muster ein. Eine vorgeschlagene localhost-Liste wird angezeigt; durch Speichern wird die Einschränkung aktiviert. Entfernen Sie Einträge, um sie zu blockieren, oder leeren Sie die Liste, um alle Web-Ursprünge zuzulassen, wenn keine verwaltete Richtlinie gilt. Nur ungültige Werte führen zu einer Sperrung (fail closed). Interne cmux-Dokumente bleiben verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restreint la navigation du navigateur intégré aux hôtes ou motifs d’URL correspondants. Une liste de localhost suggérée est affichée ; son enregistrement active la restriction. Supprimez des entrées pour les bloquer ou, si aucune politique gérée ne s’applique, effacez la liste pour autoriser toutes les origines web. Les valeurs uniquement non valides bloquent par défaut. Les documents cmux internes restent disponibles."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقيد التنقل في المتصفح المدمج على المضيفين المطابقين أو أنماط عناوين URL. يتم عرض قائمة localhost المقترحة؛ ويؤدي حفظها إلى تفعيل هذا التقييد. قم بإزالة المدخلات لحظرها، أو مسح القائمة للسماح بجميع مصادر الويب عند عدم تطبيق أي سياسة مدارة. تؤول القيم غير الصالحة فقط إلى الإغلاق (fail closed). تظل مستندات cmux الداخلية متاحة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restringe la navegación del navegador integrado a los hosts o patrones de URL coincidentes. Se muestra una lista sugerida de localhost; guardarla activa la restricción. Elimine entradas para bloquearlas o, cuando no se aplique ninguna política administrada, limpie la lista para permitir todos los orígenes web. Los valores que son únicamente no válidos no permiten el acceso en caso de fallo. Los documentos internos de cmux siguen estando disponibles."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "限制內嵌瀏覽器僅能瀏覽符合的主機或 URL 模式。系統會顯示建議的 localhost 清單；儲存該清單即表示接受此限制。移除項目即可封鎖它們，或者在未套用受控原則時，清除清單以允許所有網頁來源。僅包含無效值的設定將預設安全關閉（不允許瀏覽）。內部 cmux 文件仍可使用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내장 브라우저 탐색을 일치하는 호스트 또는 URL 패턴으로 제한합니다. 권장되는 localhost 목록이 표시되며, 이를 저장하면 제한 사항을 적용하도록 설정합니다. 이를 차단하려면 항목을 제거하고, 적용되는 관리 정책이 없는 경우 목록을 비워 모든 웹 원본을 허용하십시오. 잘못된 값만 있는 경우 안전하게 차단 모드로 자동 전환됩니다. cmux 내부 문서는 계속 사용할 수 있습니다."
          }
        }
      }
    },
    "settings.browser.urlAllowlist.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One rule per line: localhost, *.localhost, example.com, https://git.example.com, or http://localhost:3000. Remove entries to block them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1行に1ルール: localhost、*.localhost、example.com、https://git.example.com、または http://localhost:3000。エントリを削除するとそのURLをブロックします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一条规则：localhost、*.localhost、example.com、https://git.example.com 或 http://localhost:3000。移除条目即可拦截它们。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Regel pro Zeile: localhost, *.localhost, example.com, https://git.example.com oder http://localhost:3000. Entfernen Sie Einträge, um sie zu blockieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une règle par ligne : localhost, *.localhost, example.com, https://git.example.com ou http://localhost:3000. Supprimez des entrées pour les bloquer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قاعدة واحدة لكل سطر: localhost، أو *.localhost، أو example.com، أو https://git.example.com، أو http://localhost:3000. قم بإزالة المدخلات لحظرها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regla por línea: localhost, *.localhost, example.com, https://git.example.com o http://localhost:3000. Elimine entradas para bloquearlas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一條規則：localhost、*.localhost、example.com、https://git.example.com 或 http://localhost:3000。移除項目即可封鎖它們。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 줄에 한 규칙씩 입력하십시오: localhost, *.localhost, example.com, https://git.example.com 또는 http://localhost:3000. 차단하려면 항목을 제거하십시오."
          }
        }
      }
    },
    "settings.browser.urlAllowlist.invalidRule": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One or more rules are invalid. Invalid-only values fail closed; use a host or HTTP(S) URL pattern."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効なルールがあります。無効なルールだけの値は安全側でブロックされます。ホストまたはHTTP(S) URLパターンを使用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有一条或多条规则无效。全部无效的取值会按拒绝处理；请使用主机名或 HTTP(S) URL 模式。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine oder mehrere Regeln sind ungültig. Nur ungültige Werte führen zu einer Sperrung (fail closed); verwenden Sie einen Host oder ein HTTP(S)-URL-Muster."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une ou plusieurs règles sont non valides. Les valeurs uniquement non valides bloquent par défaut ; utilisez un hôte ou un motif d’URL HTTP(S)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قاعدة واحدة أو أكثر غير صالحة. تؤول القيم غير الصالحة فقط إلى الإغلاق (fail closed)؛ استخدم نمط مضيف أو عنوان URL من نوع HTTP(S)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una o más reglas no son válidas. Los valores que son únicamente no válidos no permiten el acceso en caso de fallo; use un host o un patrón de URL HTTP(S)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有一或多個規則無效。僅包含無效值的設定將預設安全關閉（不允許瀏覽）；請使用主機或 HTTP(S) URL 模式。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나 이상의 규칙이 잘못되었습니다. 잘못된 값만 입력될 경우 차단 모드로 작동하므로, 호스트 또는 HTTP(S) URL 패턴을 사용하십시오."
          }
        }
      }
    },
