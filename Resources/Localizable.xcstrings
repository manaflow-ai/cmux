    "dialog.textURL.error.multipleLinks": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن فتح رابط خارجي واحد من cmux فقط في كل مرة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Istovremeno se može otvoriti samo jedna vanjska cmux veza."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun ét eksternt cmux-link kan åbnes ad gangen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es kann jeweils nur ein externer cmux-Link geöffnet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only one cmux external link can be opened at a time."
          }
        },
        "es": {
