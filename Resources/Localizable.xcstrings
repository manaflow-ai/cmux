    "mobile.pairing.req.tailscale.missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale is not connected on this Mac. Install it on both devices and connect both to the same Tailscale network."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac で Tailscale が接続されていません。両方のデバイスに Tailscale をインストールし、同じ Tailscale ネットワークに接続してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上的 Tailscale 未连接。请在两台设备上都安装并连接到同一个 Tailscale 网络。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale ist auf diesem Mac nicht verbunden. Installieren Sie es auf beiden Geräten und verbinden Sie beide mit demselben Tailscale-Netzwerk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale n’est pas connecté sur ce Mac. Installez-le sur les deux appareils et connectez-les tous les deux au même réseau Tailscale."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامج Tailscale غير متصل على جهاز Mac هذا. قم بتثبيته على كلا الجهازين وتوصيلهما بنفس شبكة Tailscale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale no está conectado en este Mac. Instálalo en ambos dispositivos y conecta ambos a la misma red Tailscale."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 尚未連線 Tailscale。請在兩部裝置上安裝，並將兩者連線至同一個 Tailscale 網路。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에 Tailscale이 연결되어 있지 않습니다. 양쪽 기기에 모두 설치하고 동일한 Tailscale 네트워크에 연결해 주세요."
          }
        }
      }
    },
