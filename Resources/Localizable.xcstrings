    "socketControl.password.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلب مصادقة المقبس بكلمة مرور مخزنة في ملف محلي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahtijevaj autentikaciju utičnice lozinkom pohranjenom u lokalnoj datoteci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kræv socket-autentifikation med en adgangskode gemt i en lokal fil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
