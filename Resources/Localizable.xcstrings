        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Terminal-Umbenennung hat %1$d von %#@count2@ geändert. Eine andere Änderung hat ein sicheres Rollback verhindert. Aktualisieren und erneut versuchen."
          },
          "substitutions": {
            "count2": {
              "argNum": 2,
              "formatSpecifier": "d",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%d Remote-Tab"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%d Remote-Tabs"
