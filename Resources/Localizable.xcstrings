    "machines.new.error.launch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux could not start the create command. Sign in and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux は作成コマンドを開始できませんでした。サインインしてからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
