    "cloudTree.error.snapshotOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uses an older cmux-tui protocol. Refresh it to enable live sync and rename operations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は古い cmux-tui プロトコルを使用しています。更新してライブ同期と名前変更を有効にしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 使用的是较旧的 cmux-tui 协议。请刷新它以启用实时同步与重命名操作。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verwendet ein älteres cmux-tui-Protokoll. Aktualisieren Sie es, um die Live-Synchronisierung und Umbenennungsoperationen zu aktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ utilise un protocole cmux-tui plus ancien. Actualisez-le pour activer la synchronisation en direct et les opérations de renommage."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم %@ بروتوكول cmux-tui أقدم. يرجى تحديثه لتمكين المزامنة الحية وعمليات إعادة التسمية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ utiliza un protocolo cmux-tui más antiguo. Actualízalo para habilitar la sincronización en vivo y las operaciones de cambio de nombre."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 使用較舊的 cmux-tui 協定。請重新整理以啟用即時同步和重新命名作業。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 구버전 cmux-tui 프로토콜을 사용하고 있습니다. 실시간 동기화 및 이름 바꾸기 작업을 활성화하려면 새로 고치십시오."
          }
        }
      }
    },
