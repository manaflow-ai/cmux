        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 구성을 불러오지 못했습니다. dock.json을 확인한 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock-konfigurasjonen kunne ikke lastes inn. Sjekk dock.json, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można załadować konfiguracji Dock. Sprawdź dock.json i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar a configuração do Dock. Verifique o dock.json e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить конфигурацию Dock. Проверьте dock.json и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถโหลดการตั้งค่า Dock ได้ ตรวจสอบ dock.json แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock yapılandırması yüklenemedi. dock.json dosyasını kontrol edip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
