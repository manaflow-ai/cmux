        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: ថតការងារដែលបានរក្សាទុកមិនអាចចូលប្រើបានទេ។ ស្តារការចូលប្រើវាឡើងវិញ បន្ទាប់មកព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: 저장된 작업 디렉터리에 액세스할 수 없습니다. 액세스를 복원한 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: den lagrede arbeidskatalogen er utilgjengelig. Gjenopprett tilgangen til den, og prøv deretter på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: zapisany katalog roboczy jest niedostępny. Przywróć do niego dostęp i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: o diretório de trabalho salvo está inacessível. Restaure o acesso a ele e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
