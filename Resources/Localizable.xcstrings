    "settings.betaFeatures.workspaceTodoControls.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps workspace todo summaries read-only unless remote rollout enables the controls."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートのロールアウトによってコントロールが有効化されない限り、ワークスペースの todo サマリーを読み取り専用に維持します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非远程灰度启用这些控件，否则工作区待办摘要保持只读。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält Arbeitsbereich-To-Do-Zusammenfassungen schreibgeschützt, es sei denn, ein Remote-Rollout aktiviert die Steuerungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintient les résumés des tâches d’espace de travail en lecture seule à moins que le déploiement à distance n’active les commandes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقي ملخصات مهام مساحة العمل للقراءة فقط ما لم يقم النشر عن بعد بتمكين عناصر التحكم."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene los resúmenes de tareas del espacio de trabajo en modo de solo lectura a menos que el despliegue remoto habilite los controles."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使工作區待辦事項摘要保持唯讀，除非遠端部署啟用了這些控制項。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 출시로 제어 기능이 활성화되지 않는 한 작업 공간 할 일 요약을 읽기 전용으로 유지합니다."
          }
        }
      }
    },
    "settings.betaFeatures.workspaceTodoControls.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows Add Checklist Item and workspace status controls."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「チェックリスト項目を追加」とワークスペースのステータスコントロールを表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示「添加清单项」和工作区状态控件。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt „Checklisteneintrag hinzufügen“ und Arbeitsbereich-Statussteuerungen an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche Ajouter un élément à la liste de contrôle et les commandes d’état de l’espace de travail."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض عناصر التحكم في إضافة عنصر قائمة التحقق وحالة مساحة العمل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra Agregar elemento de lista de verificación y controles de estado del espacio de trabajo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示「新增檢查清單項目」和工作區狀態控制項。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체크리스트 항목 추가 및 작업 공간 상태 제어 기능을 표시합니다."
          }
        }
      }
    },
