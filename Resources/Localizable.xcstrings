    "featureFlags.override.remoteControlledNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlled remotely; local override inactive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートで制御中。ローカル上書きは無効です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由远程控制；本地覆盖项未生效。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferngesteuert; lokale Überschreibung inaktiv."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôlé à distance ; surcharge locale inactive."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم التحكم فيه عن بعد؛ التجاوز المحلي غير نشط."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlado de forma remota; la anulación local está inactiva."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端控制；本機覆蓋未啟用。"
          }
