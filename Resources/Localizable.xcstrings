        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh បានបញ្ចប់ដោយស្ថានភាព %s; កំពុងភ្ជាប់ឡើងវិញ (ការព្យាយាម %s/%s)។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh가 상태 %s로 종료되었습니다. 다시 연결 중입니다(시도 %s/%s)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh avsluttet med status %s; kobler til på nytt (forsøk %s/%s)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh zakończył działanie ze statusem %s; ponowne łączenie (próba %s/%s)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh saiu com status %s; reconectando (tentativa %s/%s)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh завершился со статусом %s; переподключение (попытка %s/%s)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh ออกจากการทำงานด้วยสถานะ %s; กำลังเชื่อมต่อใหม่ (ครั้งที่ %s/%s)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh %s durumuyla çıktı; yeniden bağlanıyor (deneme %s/%s)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh завершився зі статусом %s; повторне підключення (спроба %s/%s)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh 已退出，状态为 %s；正在重新连接（第 %s/%s 次）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] ssh 已結束，狀態為 %s；正在重新連線（第 %s/%s 次）。"
          }
        }
      }
    },
    "cli.ssh.autoReconnect.inputDiscard": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] input typed while disconnected is discarded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] 切断中に入力した内容は破棄されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] 断开期间输入的内容将被丢弃。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] Während der Trennung getätigte Eingaben werden verworfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] la saisie effectuée pendant la déconnexion est rejetée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] تم تجاهل الإدخال الذي تمت كتابته أثناء انقطاع الاتصال."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] la entrada escrita mientras se estaba desconectado se descarta."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] 連線中斷時輸入的內容已被捨棄。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[cmux] 연결이 끊어진 동안 입력된 내용은 무시됩니다."
          }
        }
      }
    },
    "cli.ssh.autoReconnect.recovered": {
      "extractionState": "manual",
      "localizations": {
