    "sudo.error.approval_timeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo request expired before approval"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo リクエストは承認前に期限切れになりました"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die sudo-Anfrage ist vor der Genehmigung abgelaufen"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية طلب sudo قبل الموافقة عليه"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo zahtjev je istekao prije odobrenja"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo-anmodning udløbet før godkendelse"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud sudo expiró antes de la aprobación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande sudo a expiré avant l'approbation"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La richiesta sudo è scaduta prima dell'approvazione"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សំណើ sudo បានផុតកំណត់មុនការអនុម័ត"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo-forespørsel utløp før godkjenning"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żądanie sudo wygasło przed zatwierdzeniem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A solicitação do sudo expirou antes da aprovação"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок действия запроса sudo истек до утверждения"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอ sudo หมดอายุก่อนการอนุมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo isteğinin süresi onaylanmadan önce doldu"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Термін дії запиту sudo закінчився до схвалення"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo 请求在批准前已过期"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo 請求在批准前已過期"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo 요청이 승인 전에 만료되었습니다."
          }
        }
      }
    },
    "sudo.error.requester_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo request cancelled because the requesting process exited"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要求元のプロセスが終了したため、sudo リクエストはキャンセルされました"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die sudo-Anfrage wurde abgebrochen, weil der anfordernde Prozess beendet wurde"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء طلب sudo بسبب إنهاء عملية الطلب"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo Zahtjev je otkazan jer je proces traženja izašao"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo-anmodning annulleret, fordi anmodningen blev afsluttet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitud sudo cancelada porque el proceso de solicitud salió"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande sudo annulée car le processus demandeur s'est terminé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo richiesta annullata perché il processo di richiesta è terminato"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សំណើ sudo ត្រូវបានលុបចោល ដោយសារដំណើរការស្នើសុំបានចាកចេញ"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo-forespørselen ble kansellert fordi forespørselsprosessen ble avsluttet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żądanie sudo zostało anulowane, ponieważ proces wysyłania żądania zakończył się"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A solicitação do sudo foi cancelada porque o processo solicitante foi encerrado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос sudo отменен, поскольку процесс запроса завершился"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอ sudo ถูกยกเลิกเนื่องจากกระบวนการร้องขอสิ้นสุดลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo istek, istek sürecinden çıkıldığı için iptal edildi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запит sudo скасовано, оскільки завершився процес запиту"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo 请求已取消，因为请求进程已退出"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo 請求已取消，因為請求程序已退出"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청 프로세스가 종료되어 sudo 요청이 취소되었습니다."
          }
        }
      }
    },
    "sudo.error.execution_interrupted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "approved sudo execution was interrupted before a result was written"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認された sudo の実行は、結果が書き込まれる前に中断されました"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "genehmigte Sudo-Ausführung wurde unterbrochen, bevor ein Ergebnis geschrieben wurde"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت مقاطعة تنفيذ sudo المعتمد قبل كتابة النتيجة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "odobreno sudo izvršenje je prekinuto prije nego što je rezultat upisan"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "godkendt sudo-udførelse blev afbrudt, før et resultat blev skrevet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ejecución aprobada de sudo se interrumpió antes de que se escribiera el resultado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "l'exécution approuvée de sudo a été interrompue avant qu'un résultat ne soit écrit"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "l'esecuzione approvata di sudo è stata interrotta prima della scrittura di un risultato"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការប្រតិបត្តិ sudo ដែលបានអនុម័តត្រូវបានរំខាន មុនពេលលទ្ធផលត្រូវបានសរសេរ"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "godkjent sudo utførelse ble avbrutt før et resultat ble skrevet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "zatwierdzone wykonanie sudo zostało przerwane przed zapisaniem wyniku"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A execução aprovada do sudo foi interrompida antes que um resultado fosse gravado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "одобренное выполнение sudo было прервано до записи результата"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการ sudo ที่ได้รับการอนุมัติถูกขัดจังหวะก่อนที่จะเขียนผลลัพธ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaylanan sudo yürütmesi, sonuç yazılmadan önce kesintiye uğradı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "затверджене виконання sudo було перервано до запису результату"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准的 sudo 执行在写入结果之前被中断"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已批准的 sudo 執行在寫入結果之前被中斷"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인된 sudo 실행은 결과가 기록되기 전에 중단되었습니다."
          }
        }
      }
    },
    "sudo.error.execution_timeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "approved sudo execution timed out; the process tree was terminated"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認された sudo の実行がタイムアウトしました。プロセスツリーは終了されました"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "genehmigte Sudo-Ausführung ist abgelaufen; der Prozessbaum wurde beendet"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت مهلة تنفيذ sudo المعتمدة؛ تم إنهاء شجرة العملية"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "odobreno sudo izvršenje je isteklo; stablo procesa je prekinuto"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "godkendt sudo-udførelse fik timeout; procestræet blev opsagt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "se agotó el tiempo de ejecución de sudo aprobado; el árbol de procesos fue terminado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'exécution approuvée de sudo a expiré ; l'arborescence des processus a été terminée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "esecuzione approvata di sudo scaduta; l'albero del processo è stato terminato"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បានអនុម័តការប្រតិបត្តិ sudo អស់ពេល; មែកធាងដំណើរការត្រូវបានបញ្ចប់"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "godkjent sudo utførelse ble tidsavbrutt; prosesstreet ble avsluttet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "zatwierdzony Upłynął limit czasu wykonania sudo; drzewo procesów zostało zakończone"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A execução aprovada do sudo atingiu o tempo limite; a árvore de processos foi encerrada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "время ожидания одобренного выполнения sudo истекло; дерево процессов было прекращено"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการ sudo ที่ได้รับการอนุมัติหมดเวลา; แผนผังกระบวนการถูกยกเลิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "onaylı sudo yürütme zaman aşımına uğradı; süreç ağacı sonlandırıldı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "час очікування схваленого виконання sudo минув; дерево процесів було припинено"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准的sudo执行超时；进程树被终止"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "經批准的sudo執行逾時；進程樹被終止"
          }
