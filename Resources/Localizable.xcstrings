          }
        }
      }
    },
    "featureFlags.mobileTerminalFilesChip.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the Files chip over iOS terminals and runs its visible-path count scan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSのターミナル上にファイルチップを表示し、表示中のパス数をスキャンします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iOS 终端上显示「文件」胶囊标签，并运行其可见路径计数扫描。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt den Dateien-Chip über iOS-Terminals an und führt dessen Scan zur Zählung sichtbarer Pfade aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche la puce Fichiers sur les terminaux iOS et exécute son analyse de comptage de chemins visibles."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض شريحة الملفات فوق طرفيات iOS ويشغل فحص عدد المسارات المرئية الخاص بها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la ficha de archivos sobre las terminales de iOS y ejecuta su análisis de recuento de rutas visibles."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iOS 終端機上方顯示「檔案」標籤，並執行其可見路徑數量掃描。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 터미널 위에 파일 칩을 표시하고 표시되는 경로 수 스캔을 실행합니다."
          }
        }
      }
    },
    "featureFlags.mobileTerminalFilesChip.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mobile terminal Files chip"
          }
        },
        "ja": {
