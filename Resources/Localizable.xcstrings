    "mobile.pairing.codeMode.tailscaleDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale pairing code. Keep Tailscale connected on both devices. Both devices must be connected to the same Tailscale network."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale ペアリングコードです。両方のデバイスで Tailscale の接続を維持してください。両方のデバイスを同じ Tailscale ネットワークに接続する必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 配对码。请保持两台设备上的 Tailscale 均已连接，且连接到同一个 Tailscale 网络。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale-Kopplungscode. Halten Sie Tailscale auf beiden Geräten verbunden. Beide Geräte müssen mit demselben Tailscale-Netzwerk verbunden sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Code de jumelage Tailscale. Gardez Tailscale connecté sur les deux appareils. Les deux appareils doivent être connectés au même réseau Tailscale."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز اقتران Tailscale. أبقِ Tailscale متصلاً على كلا الجهازين. يجب أن يكون كلا الجهازين متصلين بنفس شبكة Tailscale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código de vinculación de Tailscale. Mantén Tailscale conectado en ambos dispositivos. Ambos dispositivos deben estar conectados a la misma red Tailscale."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 配對碼。請在兩部裝置上保持 Tailscale 連線。兩部裝置必須連線至同一個 Tailscale 網路。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 페어링 코드입니다. 양쪽 기기 모두에서 Tailscale 연결을 유지하세요. 두 기기 모두 동일한 Tailscale 네트워크에 연결되어 있어야 합니다."
          }
        }
      }
    },
    "mobile.pairing.connected.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your terminal workspaces are now syncing to your iPhone. You can close this window."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルのワークスペースがiPhoneと同期されました。このウィンドウは閉じても大丈夫です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的终端工作区正在同步到 iPhone。可以关闭此窗口了。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Terminal-Arbeitsbereiche werden jetzt mit Ihrem iPhone synchronisiert. Sie können dieses Fenster schließen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos espaces de travail de terminal sont désormais synchronisés avec votre iPhone. Vous pouvez fermer cette fenêtre."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجري الآن مزامنة مساحات عمل الطرفية الخاصة بك مع هاتف iPhone الخاص بك. يمكنك إغلاق هذه النافذة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus espacios de trabajo de la terminal se están sincronizando con tu iPhone. Puedes cerrar esta ventana."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的終端機工作區現在正在同步至您的 iPhone。您可以關閉此視窗。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 터미널 작업 공간이 iPhone으로 동기화됩니다. 이 창을 닫으셔도 됩니다."
          }
        }
      }
    },
