          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O worker do Simulator falhou duas vezes. Recupere o painel antes de tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Рабочий процесс Simulator завершился сбоем дважды. Восстановите панель перед повторной попыткой."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Simulator worker ล้มเหลวสองครั้ง โปรดกู้คืน pane ก่อนลองอีกครั้ง"
