    "sudo.cli.timeout.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: timed out waiting for approval (request %@ was not approved)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: 承認待ちがタイムアウトしました（リクエスト %@ は承認されませんでした）"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: Zeitüberschreitung bei der Genehmigung (Anfrage %@ wurde nicht genehmigt)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: انتهت مهلة انتظار الموافقة (لم تتم الموافقة على طلب %@)"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: isteklo je vrijeme čekanja na odobrenje (zahtjev %@ nije odobren)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: tidsudløb venter på godkendelse (anmodning %@ blev ikke godkendt)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: se agotó el tiempo de espera de aprobación (la solicitud %@ no fue aprobada)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo : délai d'attente d'approbation expiré (la demande %@ n'a pas été approuvée)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
