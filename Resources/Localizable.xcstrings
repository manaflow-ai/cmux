    "socket.cloudVM.sessionRejected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cmux Cloud service rejected this session. Run `cmux auth logout`, then `cmux auth login`, and retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud サービスがこのセッションを拒否しました。`cmux auth logout` を実行してから `cmux auth login` を実行し、再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud 服务拒绝了此会话。请依次运行 `cmux auth logout` 和 `cmux auth login` 后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der cmux-Cloud-Dienst hat diese Sitzung abgelehnt. Führe `cmux auth logout`, dann `cmux auth login` aus und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service cmux Cloud a rejeté cette session. Exécutez `cmux auth logout`, puis `cmux auth login`, et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفضت خدمة cmux السحابية هذه الجلسة. قم بتشغيل `cmux auth logout` ثم `cmux auth login` وأعد المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio cmux Cloud rechazó esta sesión. Ejecute `cmux auth logout`, luego `cmux auth login` y vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 雲端服務拒絕了此工作階段。請執行 `cmux auth logout`，然後執行 `cmux auth login` 並重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 클라우드 서비스가 이 세션을 거부했습니다. `cmux auth logout`을 실행한 다음 `cmux auth login`을 실행하고 다시 시도하십시오."
          }
        }
      }
    },
    "socket.vm.renameFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote name could not be changed. Refresh and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモート名を変更できませんでした。更新して再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更改远程名称。请刷新后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Remote-Name konnte nicht geändert werden. Aktualisiere und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom distant n’a pas pu être modifié. Actualisez et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تغيير الاسم عن بُعد. أعد التحميل وحاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cambiar el nombre remoto. Actualice y vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法變更遠端名稱。請重新整理並重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 이름을 변경할 수 없습니다. 새로고침한 후 다시 시도하십시오."
          }
        }
      }
    },
    "socket.vm.renameTimedOut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote rename timed out after 120 seconds. Refresh and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモート名の変更が120秒でタイムアウトしました。更新して再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程重命名在 120 秒后超时。请刷新后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Remote-Umbenennung ist nach 120 Sekunden fehlgeschlagen (Zeitüberschreitung). Aktualisiere und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification du nom distant a expiré après 120 secondes. Actualisez et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت مهلة إعادة التسمية عن بُعد بعد 120 ثانية. أعد التحميل وحاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el tiempo de espera para el cambio de nombre remoto después de 120 segundos. Actualice y vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端重新命名在 120 秒後逾時。請重新整理並重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 이름 변경 요청이 120초 후 시간 초과되었습니다. 새로고침한 후 다시 시도하십시오."
          }
        }
      }
    },
    "socket.client.accessDenied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access denied - only processes started inside cmux can connect"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスが拒否されました。cmux 内で起動されたプロセスのみ接続できます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访问被拒绝 - 只有在 cmux 内启动的进程才能连接"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff verweigert – nur innerhalb von cmux gestartete Prozesse können eine Verbindung herstellen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès refusé - seuls les processus démarrés dans cmux peuvent se connecter"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رفض الوصول - يمكن فقط للعمليات التي بدأت داخل cmux الاتصال"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso denegado: solo los procesos iniciados dentro de cmux pueden conectarse"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存取被拒 - 僅限在 cmux 內部啟動的程序才能連線"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "액세스 거부됨 - cmux 내부에서 시작된 프로세스만 연결할 수 있습니다"
          }
        }
      }
    },
