            "state": "translated",
            "value": "L’action du simulateur a échoué"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل إجراء الـ Simulator"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error en la acción del simulador"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator 動作失敗"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시뮬레이터 동작 실패"
          }
        }
      }
    },
    "simulator.control.liveAccessibilityRequiresHelper": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This live accessibility setting requires the contained in-Simulator helper."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライブアクセシビリティ設定にはSimulator内の隔離ヘルパーが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此实时辅助功能设置需要模拟器内置的辅助程序。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Live-Einstellung für Bedienungshilfen erfordert das enthaltene Hilfsprogramm im Simulator."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce paramètre d’accessibilité en direct nécessite l’assistant intégré au Simulator."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب ميزة تسهيل الاستخدام المباشرة هذه المساعد المضمن داخل الـ Simulator."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ajuste de accesibilidad en vivo requiere el asistente integrado en el simulador."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此即時輔助功能設定需要內建的 Simulator 內建輔助程式。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 라이브 접근성 설정은 포함된 시뮬레이터 내 도우미가 필요합니다."
          }
        }
      }
    },
    "simulator.control.locationCoordinateInvalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latitude must be from -90 through 90 and longitude from -180 through 180."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緯度は-90から90、経度は-180から180の範囲で指定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纬度必须在 -90 到 90 之间，经度必须在 -180 到 180 之间。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Breitengrad muss zwischen -90 und 90 und der Längengrad zwischen -180 und 180 liegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La latitude doit être comprise entre -90 et 90, et la longitude entre -180 et 180."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون خط العرض من -90 إلى 90 وخط الطول من -180 إلى 180."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La latitud debe estar entre -90 y 90, y la longitud entre -180 y 180."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "緯度必須介於 -90 至 90 之間，經度必須介於 -180 至 180 之間。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위도는 -90에서 90 사이, 경도는 -180에서 180 사이여야 합니다."
          }
        }
      }
    },
    "simulator.control.locationDistanceInvalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location route update distance must be positive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報ルートの更新距離は正の値で指定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置路线的更新距离必须为正数。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktualisierungsdistanz der Standortroute muss positiv sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La distance de mise à jour de l’itinéraire de localisation doit être positive."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تكون مسافة تحديث مسار الموقع موجبة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La distancia de actualización de la ruta de ubicación debe ser positiva."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位置路線更新距離必須為正數。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 경로 업데이트 거리는 양수여야 합니다."
          }
        }
      }
    },
    "simulator.control.locationIntervalInvalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location route update interval must be positive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報ルートの更新間隔は正の値で指定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置路线的更新间隔必须为正数。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Aktualisierungsintervall der Standortroute muss positiv sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’intervalle de mise à jour de l’itinéraire de localisation doit être positif."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تكون الفترة الزمنية لتحديث مسار الموقع موجبة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El intervalo de actualización de la ruta de ubicación debe ser positivo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位置路線更新間隔必須為正數。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 경로 업데이트 간격은 양수여야 합니다."
          }
        }
      }
    },
    "simulator.control.locationRouteInvalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A location route needs at least two distinct waypoints and a positive speed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報ルートには異なる2つ以上のウェイポイントと正の速度が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置路线至少需要两个不同的途经点和一个为正的速度值。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Standortroute benötigt mindestens zwei verschiedene Wegpunkte und eine positive Geschwindigkeit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un itinéraire de localisation nécessite au moins deux points de passage distincts et une vitesse positive."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب مسار الموقع نقطتين مرجعيتين متميزتين على الأقل وسرعة موجبة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una ruta de ubicación necesita al menos dos puntos de referencia distintos y una velocidad positiva."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位置路線需要至少兩個不同的途經點以及正數的速度。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 경로는 최소 두 개의 고유한 경유지와 양수의 속도가 필요합니다."
          }
        }
      }
    },
    "simulator.control.locationRouteNotPaused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux has no paused location route for this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmuxはこのデバイスで一時停止中の位置情報ルートを管理していません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 没有此设备已暂停的位置路线。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux hat keine pausierte Standortroute für dieses Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux n’a pas d’itinéraire de localisation en pause pour cet appareil."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يملك cmux مسار موقع مؤقتًا لهذا الجهاز."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no tiene ninguna ruta de ubicación pausada para este dispositivo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 沒有此裝置的已暫停位置路線。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux에 이 기기에 대해 일시 정지된 위치 경로가 없습니다."
          }
        }
      }
    },
    "simulator.control.locationRouteNotRunning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux has no running location route for this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmuxはこのデバイスで実行中の位置情報ルートを管理していません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
