    "settings.globalHotkey.enable.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn this on to show or hide all cmux windows from any app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリからでも cmux のすべてのウィンドウを表示または非表示にするにはオンにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 옵션을 켜면 어떤 앱에서든 모든 cmux 윈도우를 표시하거나 숨길 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后可从任意应用显示或隐藏所有 cmux 窗口。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie dies, um alle cmux-Fenster aus jeder beliebigen App anzuzeigen oder auszublenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez cette option pour afficher ou masquer toutes les fenêtres cmux depuis n’importe quelle application."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتشغيل هذا لإظهار أو إخفاء جميع نوافذ cmux من أي تطبيق."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Active esto para mostrar u ocultar todas las ventanas de cmux desde cualquier aplicación."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟此功能即可從任何應用程式顯示或隱藏所有 cmux 視窗。"
          }
        }
      }
    },
    "settings.globalHotkey.enable.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press the shortcut from any app to show or hide all cmux windows."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリからでもこのショートカットで cmux のすべてのウィンドウを表示または非表示にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 앱에서든 단축키를 눌러 모든 cmux 윈도우를 표시하거나 숨깁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意应用中按下该快捷键，即可显示或隐藏所有 cmux 窗口。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken Sie das Tastaturkürzel in einer beliebigen App, um alle cmux-Fenster anzuzeigen oder auszublenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur le raccourci depuis n’importe quelle application pour afficher ou masquer toutes les fenêtres cmux."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الاختصار من أي تطبيق لإظهار أو إخفاء جميع نوافذ cmux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presione el acceso directo desde cualquier aplicación para mostrar u ocultar todas las ventanas de cmux."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何應用程式中按下此快速鍵即可顯示或隱藏所有 cmux 視窗。"
          }
        }
      }
    },
    "settings.globalHotkey.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Command, Option, or Control with another key. No extra macOS permission is required."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Command、Option、または Control と別のキーを組み合わせてください。追加の macOS 権限は不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Command, Option 또는 Control과 다른 키를 함께 사용하세요. 추가 macOS 권한이 필요하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请用 Command、Option 或 Control 搭配其他键。无需额外的 macOS 权限。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie die Befehls-, Wahl- oder Steuerungstaste zusammen mit einer anderen Taste. Es ist keine zusätzliche macOS-Berechtigung erforderlich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Commande, Option ou Contrôle avec une autre touche. Aucune autorisation macOS supplémentaire n’est requise."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم Command أو Option أو Control مع مفتاح آخر. لا يلزم إذن إضافي من نظام macOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Comando, Opción o Control con otra tecla. No se requiere ningún permiso adicional de macOS."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搭配使用 Command、Option 或 Control 與另一個按鍵。不需要額外的 macOS 權限。"
          }
        }
      }
    },
