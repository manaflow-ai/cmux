    "machines.new.error.createdOpenFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Machine %1$@ was created, but opening it failed. Open it from the Machines list.\n\n%2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシン %1$@ は作成されましたが、開けませんでした。マシン一覧から開いてください。\n\n%2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机器 %1$@ 已创建，但打开失败。请从机器列表中打开它。\n\n%2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maschine %1$@ wurde erstellt, aber das Öffnen ist fehlgeschlagen. Öffnen Sie sie aus der Liste der Maschinen.\n\n%2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La machine %1$@ a été créée, mais son ouverture a échoué. Ouvrez-la depuis la liste des machines.\n\n%2$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إنشاء الجهاز %1$@، ولكن تعذر فتحه. افتحه من قائمة الأجهزة.\n\n%2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se creó la máquina %1$@, pero falló al abrirse. Ábrela desde la lista de máquinas.\n\n%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已建立機器 %1$@，但開啟失敗。請從機器清單中開啟它。\n\n%2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머신 %1$@이(가) 생성되었지만 열지 못했습니다. 머신 목록에서 여십시오.\n\n%2$@"
          }
        }
      }
    },
