    "sleepyMode.settings.requireAuth.off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Casual screensaver. Any key or click wakes it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常のスクリーンセーバー。任意のキーまたはクリックで解除します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "普通屏保。按任意键或点击即可唤醒。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lockerer Bildschirmschoner. Jede Taste oder jeder Klick weckt ihn auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écran de veille simple. N’importe quelle touche ou clic le réveille."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاشة توقف عادية. أي مفتاح أو نقرة يوقظها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvapantallas informal. Cualquier tecla o clic lo activa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一般螢幕保護程式。按任意鍵或點擊即可喚醒。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 화면 보호기입니다. 아무 키나 누르거나 클릭하면 깨어납니다."
          }
        }
      }
    },
    "sleepyMode.settings.requireAuth.on": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locks the Mac. Blocks Cmd-Tab, Cmd-Q, and force-quit until you authenticate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac をロックします。認証するまで Cmd-Tab、Cmd-Q、強制終了をブロックします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定 Mac。在你完成验证前会拦截 Cmd-Tab、Cmd-Q 和强制退出。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperrt den Mac. Blockiert Cmd-Tab, Cmd-Q und „Sofort beenden“, bis du dich authentifizierst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouille le Mac. Bloque Cmd-Tab, Cmd-Q et la fermeture forcée jusqu’à ce que vous vous authentifiiez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقفل جهاز Mac. يحظر Cmd-Tab و Cmd-Q والإنهاء الإجباري حتى تقوم بالمصادقة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea el Mac. Impide usar Cmd-Tab, Cmd-Q y forzar salida hasta que te autentiques."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定 Mac。在您通過驗證之前，會封鎖 Cmd-Tab、Cmd-Q 和強制結束。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac을 잠급니다. 인증할 때까지 Cmd-Tab, Cmd-Q, 강제 종료를 차단합니다."
          }
        }
      }
    },
