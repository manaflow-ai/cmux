          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnel : en attente d'autorisation dans Réglages Système › Général › Ouverture et extensions"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النفق: في انتظار الموافقة في إعدادات النظام › عام › عناصر تسجيل الدخول والامتدادات"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Túnel: esperando aprobación en Ajustes del Sistema › General › Ítems de inicio y extensiones"
          }
