    "settings.notifications.agentTurnComplete.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When to notify that an agent finished. When idle waits until background tasks and scheduled wakeups drain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが完了したときに通知するタイミング。待機中はバックグラウンドタスクとスケジュール再開が片付くまで待ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 완료되었을 때 알릴 시점입니다. 유휴 시에는 백그라운드 작업과 예약된 재개가 끝날 때까지 기다립니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли сповіщати про завершення роботи агента. У режимі очікування чекає, доки завершаться фонові задачі та заплановані пробудження."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "何时通知代理已完成。「空闲时」会等到后台任务和计划唤醒都清空之后。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann benachrichtigt werden soll, dass ein Agent fertig ist. „Bei Inaktivität“ wartet, bis Hintergrundaufgaben und geplante Reaktivierungen abgeschlossen sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand notifier qu'un agent a terminé. « En cas d'inactivité » attend que les tâches en arrière-plan et les réveils programmés se terminent."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متى يتم الإخطار بانتهاء الوكيل. ينتظر خيار \"عند الخمول\" حتى تنتهي المهام في الخلفية وتنبيهات الاستيقاظ المجدولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuándo notificar que un agente ha terminado. La opción \"cuando esté inactivo\" espera hasta que finalicen las tareas en segundo plano y las reactivaciones programadas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "何時通知代理程式已結束。選擇「閒置時」會等待背景任務及排程喚醒全部清空。"
          }
        }
      }
    },
