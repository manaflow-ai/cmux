    "account.signIn.error.unauthorized.recovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm you’re using the intended cmux account, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用する cmux アカウントが正しいことを確認して、もう一度試してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认使用的是目标 cmux 账户，然后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigen Sie, dass Sie das beabsichtigte cmux-Konto verwenden, und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez que vous utilisez le bon compte cmux, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد من استخدام حساب cmux المطلوب، ثم أعد المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma que estás usando la cuenta de cmux correcta y vuelve a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認您使用的是正確的 cmux 帳戶，然後再試一次。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하려는 cmux 계정이 맞는지 확인한 후 다시 시도하세요."
          }
        }
      }
    },
    "account.signIn.error.unauthorized.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux couldn’t authorize this sign-in"
          }
        },
        "ja": {
