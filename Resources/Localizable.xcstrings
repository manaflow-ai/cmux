    "settings.sidebar.rightTabs.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which tabs the right sidebar shows and their order. The ⌃1–⌃9 shortcuts follow the visible order."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右サイドバーに表示するタブとその順序を選択します。⌃1〜⌃9 のショートカットは表示順に従います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择右侧边栏显示哪些标签页及其顺序。⌃1–⌃9 快捷键按可见顺序对应。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie aus, welche Tabs in der rechten Seitenleiste angezeigt werden und in welcher Reihenfolge. Die Tastaturkürzel ⌃1–⌃9 folgen der sichtbaren Reihenfolge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les onglets affichés par la barre latérale droite et leur ordre. Les raccourcis ⌃1–⌃9 suivent l’ordre visible."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر علامات التبويب التي يعرضها الشريط الجانبي الأيمن وترتيبها. تتبع اختصارات ⌃1–⌃9 الترتيب المرئي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué pestañas muestra la barra lateral derecha y su orden. Los atajos ⌃1–⌃9 siguen el orden visible."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇右側側邊欄顯示哪些標籤頁及其順序。⌃1–⌃9 快速鍵將依循顯示的順序。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 사이드바가 표시할 탭과 순서를 선택합니다. ⌃1–⌃9 단축키는 표시되는 순서를 따릅니다."
          }
        }
      }
    },
