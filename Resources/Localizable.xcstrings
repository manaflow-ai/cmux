    "cli.help.restore": {
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "restore [--surface <id|ref>] <kind> <checkpoint-id> | restore --surface [id|ref]" } },
        "bs": { "stringUnit": { "state": "translated", "value": "restore [--surface <id|ref>] <kind> <checkpoint-id> | restore --surface [id|ref]" } },
        "da": { "stringUnit": { "state": "translated", "value": "restore [--surface <id|ref>] <kind> <checkpoint-id> | restore --surface [id|ref]" } },
