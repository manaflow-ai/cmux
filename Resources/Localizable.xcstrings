    "settings.mobile.phonePush.hideContent.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends a generic message instead of agent and terminal text."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントやターミナルのテキストの代わりに一般的なメッセージを送信します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送一条通用消息，而不是代理与终端的文本内容。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet eine allgemeine Nachricht anstelle von Agenten- und Terminaltext."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie un message générique au lieu du texte de l’agent et du terminal."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل رسالة عامة بدلاً من نص الوكيل ونص الطرفية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía un mensaje genérico en lugar de texto del agente y de la terminal."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送一般訊息，而非代理程式和終端機文字。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 및 터미널 텍스트 대신 일반 메시지를 보냅니다."
          }
        }
      }
    },
