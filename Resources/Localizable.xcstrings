            "state": "translated",
            "value": "ระยะห่างบานหน้าต่างแคนวาส"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanvas Bölme Aralığı"
          }
        },
        "uk": {
          "stringUnit": {
