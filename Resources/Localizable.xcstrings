    "update.error.installRecovery.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move cmux into Applications and relaunch to enable updates. If it’s already in Applications, restart your Mac and try again, or download the latest version below."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートを有効にするには、cmux を「アプリケーション」に移動して再起動してください。すでに「アプリケーション」にある場合は、Mac を再起動してからもう一度お試しいただくか、下から最新バージョンをダウンロードしてください。"
          }
        }
      }
    },
