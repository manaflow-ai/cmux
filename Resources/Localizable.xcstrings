        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 터미널 전송 방식은 SSH 또는 Mosh여야 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjernterminalens transport må være SSH eller Mosh."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transport zdalnego terminala musi używać SSH albo Mosh."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O transporte do terminal remoto deve ser SSH ou Mosh."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транспорт удалённого терминала должен использовать SSH или Mosh."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การส่งเทอร์มินัลระยะไกลต้องใช้ SSH หรือ Mosh"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzak terminal aktarımı SSH veya Mosh olmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транспорт віддаленого термінала має використовувати SSH або Mosh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程终端传输必须使用 SSH 或 Mosh。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
