        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: this session has nothing to fork. Start the agent again in this terminal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: Esta sesión no tiene nada que bifurcar. Inicie el agente nuevamente en esta terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: cette session ne contient rien à forker. Relancez l’agent dans ce terminal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: questa sessione non ha nulla da biforcare. Avvia nuovamente l'agente in questo terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: このセッションにはフォークできるものがありません。このターミナルでエージェントをもう一度起動してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: វគ្គ​នេះ​មិន​មាន​អ្វី​ត្រូវ​បំបែក​ទេ។ ចាប់ផ្តើមភ្នាក់ងារម្តងទៀតនៅក្នុងស្ថានីយនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: 이 세션에는 분기할 항목이 없습니다. 이 터미널에서 에이전트를 다시 시작하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: denne økten har ingenting å forke. Start agenten på nytt i denne terminalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: ta sesja nie ma nic do rozwidlenia. Uruchom agenta ponownie w tym terminalu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: esta sessão não tem nada para bifurcar. Inicie o agente novamente neste terminal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: в этой сессии нечего разветвлять. Запустите агент еще раз в этом терминале."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: เซสชั่นนี้ไม่มีอะไรจะแยก เริ่มต้นตัวแทนอีกครั้งในเทอร์มินัลนี้"
