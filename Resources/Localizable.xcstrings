    "cli.vm.output.invalidPage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The machine returned an invalid output page. Reconnect and retry."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Maschine hat eine ungültige Ausgabeseite zurückgegeben. Verbinden Sie sich erneut und versuchen Sie es noch einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La machine a renvoyé une page de sortie invalide. Reconnectez-vous et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرجع الجهاز صفحة مخرجات غير صالحة. أعد الاتصال وأعد المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La máquina devolvió una página de salida no válida. Vuelva a conectarse y reintente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "機器傳回了無效的輸出頁面。請重新連接並重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机器返回了无效的输出页。请重新连接并重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머신이 유효하지 않은 출력 페이지를 반환했습니다. 다시 연결한 후 시도하십시오."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンが無効な出力ページを返しました。再接続して再試行してください。"
          }
        }
      }
    },
    "cli.vm.output.incomplete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The machine's output could not be read completely. Reconnect and retry."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ausgabe der Maschine konnte nicht vollständig gelesen werden. Verbinden Sie sich erneut und versuchen Sie es noch einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sortie de la machine n'a pas pu être lue complètement. Reconnectez-vous et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر قراءة مخرجات الجهاز بالكامل. أعد الاتصال وأعد المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La salida de la máquina no se pudo leer por completo. Vuelva a conectarse y reintente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完整讀取機器的輸出。請重新連接並重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完整读取机器的输出。请重新连接并重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머신의 출력을 완전히 읽을 수 없습니다. 다시 연결한 후 시도하십시오."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンの出力を完全に読み取ることができませんでした。再接続して再試行してください。"
          }
        }
      }
    },
