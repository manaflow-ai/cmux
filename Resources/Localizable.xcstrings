    "simulator.control.cameraRequiresWorker": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera injection must run inside the isolated Simulator worker."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ入力は分離されたSimulatorワーカー内で実行する必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头注入必须在隔离的模拟器工作进程中运行。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera-Einspeisung muss innerhalb des isolierten Simulator-Workers ausgeführt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’injection d’appareil photo doit s’exécuter dans le worker Simulator isolé."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب تشغيل حقن الكاميرا داخل عامل الـ Simulator المعزول."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La inyección de cámara debe ejecutarse dentro del worker aislado del simulador."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機插入功能必須在隔離的模擬器工作程式中執行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 주입은 격리된 시뮬레이터 워커 내부에서 실행되어야 합니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ubacivanje kamere mora se izvršiti unutar izoliranog Simulator radnog procesa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kameraindjektion skal køre i den isolerede Simulator-worker."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'iniezione della fotocamera deve essere eseguita nel worker isolato del Simulator."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការបញ្ចូល Camera ត្រូវតែដំណើរការនៅខាងក្នុង Simulator worker ដែលបានញែក។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kamerainjeksjon må kjøres inne i den isolerte Simulator-arbeidsprosessen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wstrzykiwanie kamery musi być uruchamiane wewnątrz izolowanego procesu roboczego Simulatora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
