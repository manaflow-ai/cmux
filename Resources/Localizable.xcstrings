    "settings.automation.ripgrep.customPath.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom path to the rg binary used by Find. Leave empty to use common install locations and PATH."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Findで使用するrgバイナリのカスタムパス。空欄の場合は一般的なインストール先とPATHを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Find에서 사용하는 rg 바이너리의 사용자 지정 경로입니다. 일반 설치 위치와 PATH를 사용하려면 비워두세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「查找」所用 rg 二进制文件的自定义路径。留空则使用常见安装位置和 PATH。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzerdefinierter Pfad zur rg-Binärdatei, die von „Suchen“ verwendet wird. Leer lassen, um gängige Installationsorte und den PATH zu verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chemin personnalisé vers le binaire rg utilisé par Find. Laisser vide pour utiliser les emplacements d’installation courants et le PATH."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسار مخصص لملف rg الثنائي المستخدم بواسطة البحث (Find). اتركه فارغًا لاستخدام مواقع التثبيت الشائعة و PATH."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruta personalizada al binario rg utilizado por Buscar. Déjela vacía para usar las ubicaciones de instalación comunes y PATH."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「尋找」功能所使用的 rg 二進位檔自訂路徑。留空則會使用常見的安裝位置與 PATH。"
          }
        }
      }
    },
