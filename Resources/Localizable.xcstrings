                    "stringUnit": {
                      "state": "translated",
                      "value": "%d لوحات متصفح تستخدمه"
                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%d لوحة متصفح تستخدمه"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%d لوحة متصفح تستخدمه"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede eliminar el perfil de navegador de cmux '%@' mientras %#@count2@"
          },
          "substitutions": {
            "count2": {
              "argNum": 2,
              "formatSpecifier": "d",
              "variations": {
                "plural": {
