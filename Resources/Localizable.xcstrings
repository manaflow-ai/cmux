    },
    "cli.browser.engine.error.navigateUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "--engine is only supported when browser open creates a new pane; omit the surface selector"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "--engine は browser open が新しいペインを作成する場合のみ使用できます。サーフェスセレクターを省略してください"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "--engine wird nur unterstützt, wenn durch das Öffnen des Browsers ein neuer Bereich erstellt wird; lassen Sie den Oberflächen-Selektor weg"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "--engine est uniquement pris en charge lorsque l'ouverture du navigateur crée un nouveau volet ; omettez le sélecteur de surface"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخيار --engine مدعوم فقط عندما يؤدي فتح المتصفح إلى إنشاء جزء جديد؛ احذف محدد السطح"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "--engine solo está admitido cuando la apertura del navegador crea un nuevo panel; omita el selector de superficie"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在瀏覽器開啟並建立新窗格時才支援 --engine；請省略介面選取器"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "--engine 仅在浏览器打开创建新窗格时受支持；请省略表面选择器"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "--engine은 브라우저 열기로 새 패인이 생성될 때만 지원됩니다. 서피스 선택기를 생략하세요."
          }
        }
      }
    },
