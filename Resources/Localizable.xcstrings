    "settings.automation.autoNamingAgent.requirement.auto": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each session is named by its own agent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各セッションはそのセッション自身のエージェントによって命名されます。"
          }
        }
      }
    },
    "settings.automation.autoNamingAgent.requirement.supported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ names every session. Requires its CLI on your PATH; if it can't produce a name, existing names are left unchanged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がすべてのセッションを命名します。PATH にその CLI が必要です。名前を生成できない場合、既存の名前はそのまま保持されます。"
          }
        }
      }
    },
    "settings.automation.autoNamingAgent.requirement.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can't generate names yet, so cmux uses each session's own agent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はまだ名前を生成できないため、cmux は各セッション自身のエージェントを使用します。"
          }
        }
      }
    },
    "settings.automation.autoNamingAgent.section.other": {
