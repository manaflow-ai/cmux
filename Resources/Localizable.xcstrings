          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: истекло время ожидания утверждения (запрос %@ не был одобрен)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo: หมดเวลารอการอนุมัติ (คำขอ %@ ไม่ได้รับการอนุมัติ)"
          }
        },
        "tr": {
