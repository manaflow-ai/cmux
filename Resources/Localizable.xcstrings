    "debug.sidebarFooterIconBalance.referenceNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cell guides show geometric alignment; the squint preview compares optical weight."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セルガイドは幾何学的な整列を示し、スクイント表示は視覚的なウェイトを比較します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单元格参考线显示几何对齐；眯眼预览用于比较视觉重量。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zellen-Hilfslinien zeigen die geometrische Ausrichtung; die zugekniffene Vorschau vergleicht das optische Gewicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les guides de cellules montrent l'alignement géométrique ; l'aperçu flou compare le poids optique."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توضح أدلة الخلايا المحاذاة الهندسية؛ وتقارن المعاينة المغشاة الوزن البصري."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las guías de celda muestran la alineación geométrica; la vista previa de ojos entrecerrados compara el peso óptico."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存格輔助線顯示幾何對齊；瞇眼預覽則用來比對視覺權重。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셀 가이드는 기하학적 정렬을 보여주며, 실눈 미리보기는 시각적 가중치를 비교합니다."
          }
        }
      }
    },
