          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les machines cloud sont désactivées. Activez-les dans Réglages › Fonctionnalités bêta, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأجهزة السحابية متوقفة. فعّلها من الإعدادات › ميزات تجريبية، ثم حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las máquinas en la nube están desactivadas. Actívalas en Ajustes › Características beta y vuelve a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲端機器已關閉。請在「設定 › Beta 功能」中開啟，再重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端机器已关闭。请在“设置 › 测试版功能”中启用，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 머신이 꺼져 있습니다. 설정 › 베타 기능에서 켠 후 다시 시도하세요."
          }
        }
      }
    },
    "cloudTunnel.error.noCloudMachine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a Cloud machine first. The cmux Cloud Tunnel runs only for an account with at least one machine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にクラウドマシンを作成してください。cmux Cloud Tunnelは、マシンを1台以上持つアカウントでのみ動作します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie zuerst eine Cloud-Maschine. cmux Cloud Tunnel wird nur für Konten mit mindestens einer Maschine ausgeführt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez d’abord une machine cloud. cmux Cloud Tunnel fonctionne uniquement pour les comptes disposant d’au moins une machine."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ جهازًا سحابيًا أولًا. يعمل cmux Cloud Tunnel فقط للحسابات التي لديها جهاز واحد على الأقل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero crea una máquina en la nube. cmux Cloud Tunnel solo funciona en cuentas con al menos una máquina."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先建立雲端機器。cmux Cloud Tunnel 僅適用於至少有一台機器的帳號。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先创建云端机器。cmux Cloud Tunnel 仅适用于至少拥有一台机器的账号。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 클라우드 머신을 만드세요. cmux Cloud Tunnel은 머신이 하나 이상 있는 계정에서만 작동합니다."
          }
        }
      }
    },
