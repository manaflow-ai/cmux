        }
      }
    },
    "settings.app.wrapWorkspaceTitles.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لعناوين مساحات العمل الطويلة استخدام أي عدد تحتاجه من الأسطر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dugi naslovi radnih prostora mogu koristiti onoliko redova koliko im treba."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lange arbejdsområdetitler kan bruge så mange linjer, som de har brug for."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lange Arbeitsbereichstitel können so viele Zeilen verwenden, wie sie brauchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long workspace titles can use as many lines as they need."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los títulos largos de espacios de trabajo pueden usar tantas líneas como necesiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les titres longs des espaces de travail peuvent utiliser autant de lignes que nécessaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I titoli lunghi degli spazi di lavoro possono usare tutte le righe necessarie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長いワークスペースタイトルは必要な行数で表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចំណងជើងកន្លែងធ្វើការដែលវែង អាចប្រើចំនួនបន្ទាត់ដែលត្រូវការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴 워크스페이스 제목은 필요한 만큼 여러 줄을 사용할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lange arbeidsområdetitler kan bruke så mange linjer de trenger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Długie tytuły obszarów roboczych mogą zajmować tyle wierszy, ile potrzebują."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos longos de espaços de trabalho podem usar quantas linhas forem necessárias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Длинные названия рабочих областей могут занимать столько строк, сколько нужно."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อเวิร์กสเปซที่ยาวสามารถใช้กี่บรรทัดก็ได้ตามต้องการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzun çalışma alanı başlıkları ihtiyaç duyduğu kadar satır kullanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Довгі назви робочих областей можуть займати стільки рядків, скільки потрібно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "较长的工作区标题可以按需要使用任意行数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "較長的工作區標題可依需要使用任意行數。"
          }
        }
      }
    },
    "settings.automation.amp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amp Integration"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Amp連携"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Amp 연동"
          }
        }
      }
    },
    "settings.automation.amp.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks must be installed with `cmux hooks amp install`. They no-op outside cmux terminals. When disabled, the installed Amp plugin stays inactive without needing to be removed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フックは`cmux hooks amp install`でインストールする必要があります。cmuxターミナル外では動作しません。無効にすると、インストール済みAmpプラグインは削除せずに停止状態に保たれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`cmux hooks amp install`로 훅을 설치해야 합니다. cmux 터미널 외부에서는 작동하지 않습니다. 비활성화하면 설치된 Amp 플러그인은 제거하지 않고도 비활성 상태로 유지됩니다."
          }
        }
      }
    },
    "settings.automation.amp.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amp runs without cmux integration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AmpはCmux連携なしで動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Amp가 cmux 연동 없이 실행됩니다."
          }
        }
      }
    },
    "settings.automation.amp.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidebar shows Amp agent status and notifications."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
