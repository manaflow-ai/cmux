    "cli.vm.help.legacyBaseKindFlags": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "accepted for older scripts; Base always has a screen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旧スクリプトとの互換性のため受け付けます。Baseには常に画面があります"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "akzeptiert für ältere Skripte; Base hat immer einen Bildschirm"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "accepté pour les anciens scripts ; Base a toujours un écran"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقبول للبرامج النصية القديمة؛ Base لديه شاشة دائمًا"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "aceptado para scripts más antiguos; Base siempre tiene una pantalla"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊版指令稿可接受；Base 一律配有螢幕"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于旧脚本；Base 始终具有屏幕"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오래된 스크립트에서 지원됨; Base는 항상 화면을 가집니다"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "prihvaćeno za starije skripte; Base uvijek ima ekran"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "accepteres til ældre scripts; Base har altid en skærm"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "accettati per script precedenti; Base ha sempre uno schermo"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ទទួលយកសម្រាប់ script ចាស់; Base តែងមានអេក្រង់"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "godtas for eldre skript; Base har alltid en skjerm"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "akceptowane dla starszych skryptów; Base zawsze ma ekran"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "aceito para scripts antigos; Base sempre tem tela"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "принимается для старых скриптов; Base всегда имеет экран"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "รับได้สำหรับสคริปต์เก่า; Base มีหน้าจอเสมอ"
          }
        },
        "tr": {
          "stringUnit": {
