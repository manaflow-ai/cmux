    },
    "settings.app.canvasPaneGap.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التباعد بين الأجزاء في تخطيط اللوحة بالنقاط. يستخدم الالتقاط والترتيب ووضع الأجزاء الجديدة هذا التباعد نفسه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Razmak između okana u rasporedu platna, u tačkama. Prijanjanje, uređivanje i postavljanje novih okana koriste ovaj razmak."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afstand mellem ruder i lærredslayoutet, i punkter. Fastgørelse, oprydning og placering af nye ruder bruger alle denne afstand."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abstand zwischen Panels im Canvas-Layout, in Punkten. Einrasten, Aufräumen und die Platzierung neuer Panels verwenden alle diesen einen Abstand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spacing between panes in the canvas layout, in points. Snapping, tidy, and new-pane placement all use this one gap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Separación entre paneles en el diseño de lienzo, en puntos. El ajuste, el orden y la colocación de paneles nuevos usan esta misma separación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espacement entre les panneaux dans la disposition en canevas, en points. L'aimantation, le rangement et le placement des nouveaux panneaux utilisent tous cet espacement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaziatura tra i riquadri nel layout canvas, in punti. Aggancio, riordino e posizionamento dei nuovi riquadri usano tutti questa spaziatura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバスレイアウトのペイン間の間隔（ポイント単位）。スナップ、整列、新規ペインの配置はすべてこの間隔を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캔버스 레이아웃에서 창 사이의 간격(포인트)입니다. 스냅, 정리, 새 창 배치 모두 이 간격을 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avstand mellom ruter i lerretoppsettet, i punkter. Festing, rydding og plassering av nye ruter bruker alle denne avstanden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstęp między panelami w układzie kanwy, w punktach. Przyciąganie, porządkowanie i rozmieszczanie nowych paneli używają tego samego odstępu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaçamento entre painéis no layout de canvas, em pontos. Encaixe, organização e posicionamento de novos painéis usam este mesmo espaçamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расстояние между панелями в режиме холста, в пунктах. Привязка, упорядочивание и размещение новых панелей используют этот отступ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระยะห่างระหว่างบานหน้าต่างในเลย์เอาต์แคนวาส (หน่วยเป็นพอยต์) การสแนป การจัดระเบียบ และการวางบานหน้าต่างใหม่ใช้ระยะห่างนี้ทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanvas düzeninde bölmeler arasındaki boşluk, punto cinsinden. Yapışma, düzenleme ve yeni bölme yerleşimi hep bu boşluğu kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відстань між панелями в режимі полотна, у пунктах. Прилипання, упорядкування та розміщення нових панелей використовують цей відступ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画布布局中窗格之间的间距（以点为单位）。吸附、整理和新窗格放置都使用这一间距。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫布佈局中窗格之間的間距（以點為單位）。吸附、整理與新窗格放置都使用這一間距。"
          }
        }
      }
    },
