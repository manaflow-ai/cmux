    "cli.vm.tree.detached": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(detached — no tab on the machine shows these)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（デタッチ済み — マシン上のどのタブにも表示されていません）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（已分离 —— 机器上没有标签页显示这些）"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "(abgetrennt – kein Tab auf der Maschine zeigt diese an)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "(détaché — aucun onglet sur la machine ne les affiche)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "(منفصل — لا توجد علامة تبويب على الجهاز تعرض هذه)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "(desacoplado — ninguna pestaña de la máquina muestra esto)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "(已分離 —— 機器上沒有顯示這些內容的標籤頁)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "(분리됨 — 가상 머신의 어떤 탭도 이를 표시하지 않음)"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "(odvojeno — nijedan tab na mašini ne prikazuje ovo)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "(løsrevet — ingen fane på maskinen viser disse)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "(detached — nessuna scheda sulla macchina mostra questi)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "(frakoblet — ingen fane på maskinen viser disse)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "(odłączony — żadna karta na maszynie tego nie pokazuje)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "(desanexado — nenhuma aba na máquina exibe estes)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "(detached — ни одна вкладка на машине не отображает их)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "(detached — ไม่มีแท็บบนเครื่องแสดงสิ่งเหล่านี้)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "(ayrılmış — makinedeki hiçbir sekme bunları göstermiyor)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "(відʼєднано — жодна вкладка на машині не показує це)"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
