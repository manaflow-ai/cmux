    "cli.vm.resize.invalidDisk": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "vm resize: use CPU 1–32, memory 4–64 GiB in whole GiB, and disk 4–256 GiB in 4 GiB steps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "vm resize: CPU 1–32, Arbeitsspeicher 1–64 GiB in ganzen GiB und Festplatte 4–256 GiB in 4-GiB-Schritten angeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "vm resize : indiquez 1–32 CPU, 1–64 Gio de mémoire en Gio entiers et 4–256 Gio de disque par pas de 4 Gio."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "vm resize: استخدم 1–32 وحدة معالجة، وذاكرة 1–64 GiB بأعداد صحيحة، وقرصًا 4–256 GiB بخطوات 4 GiB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "vm resize: usa CPU 1–32, memoria 1–64 GiB en GiB enteros y disco 4–256 GiB en pasos de 4 GiB."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "vm resize：CPU 為 1–32，記憶體為 1–64 GiB（整數 GiB），磁碟為 4–256 GiB（以 4 GiB 為增量）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "vm resize：CPU 为 1–32，内存为 1–64 GiB（整数 GiB），磁盘为 4–256 GiB（以 4 GiB 为增量）。"
          }
        },
        "ko": {
