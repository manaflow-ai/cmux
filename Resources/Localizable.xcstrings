    "settings.terminal.scrollBar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Terminal Scroll Bar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルのスクロールバーを表示"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示终端滚动条"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal-Bildlaufleiste anzeigen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher la barre de défilement du terminal"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض شريط تمرير الطرفية"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar barra de desplazamiento de la terminal"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示終端機捲動軸"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 스크롤 바 표시"
          }
        }
      }
    },
    "settings.terminal.scrollBar.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides the right-edge terminal scroll bar everywhere. Changes apply immediately and persist across relaunches."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右端のターミナルスクロールバーを全体で非表示にします。変更はすぐに反映され、再起動後も保持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在所有位置隐藏终端右边缘的滚动条。更改立即生效并在重启后保持。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet die Terminal-Bildlaufleiste am rechten Rand überall aus. Änderungen werden sofort wirksam und bleiben auch nach einem Neustart bestehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque la barre de défilement du terminal sur le bord droit partout. Les modifications s'appliquent immédiatement et persistent après redémarrage."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخفي شريط تمرير الطرفية في الحافة اليمنى في كل مكان. تطبق التغييرات على الفور وتستمر عبر عمليات إعادة التشغيل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta la barra de desplazamiento de la terminal del borde derecho en todas partes. Los cambios se aplican de inmediato y persisten entre reinicios."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在所有位置隱藏右側邊緣的終端機捲動軸。變更會立即套用並在重新啟動後持續生效。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 곳에서 오른쪽 터미널 스크롤 바를 숨깁니다. 변경 사항은 즉시 적용되며 다시 실행해도 유지됩니다."
          }
        }
      }
    },
    "settings.terminal.scrollBar.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the right-edge terminal scroll bar in shell scrollback. cmux hides it automatically for alternate-screen style TUI surfaces."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェルのスクロールバックでは右端のターミナルスクロールバーを表示します。cmux は代替画面系の TUI では自動的に隠します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 shell 回滚区中显示终端右边缘的滚动条。对备用屏风格的 TUI 表面，cmux 会自动隐藏它。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Terminal-Bildlaufleiste am rechten Rand beim Shell-Scrollback an. cmux blendet sie für TUI-Oberflächen mit alternativem Bildschirm automatisch aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche la barre de défilement du terminal sur le bord droit dans l’historique du shell. cmux la masque automatiquement pour les surfaces d’affichage TUI de style écran alternatif."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض شريط تمرير الطرفية في الحافة اليمنى في تراجع الـ shell. يخفيه cmux تلقائيًا لأسطح TUI بنمط الشاشة البديلة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la barra de desplazamiento de la terminal del borde derecho en el desplazamiento del historial de la shell. cmux la oculta automáticamente para superficies TUI de estilo pantalla alternativa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 shell 向上捲動時顯示右側邊緣的終端機捲動軸。對於備用畫面風格的 TUI 介面，cmux 會自動將其隱藏。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셸 스크롤백에서 오른쪽 터미널 스크롤 바를 표시합니다. 대체 화면 스타일의 TUI 화면에서는 cmux가 자동으로 숨깁니다."
          }
        }
      }
    },
