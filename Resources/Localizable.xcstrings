    "account.signIn.error.server.recovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again in a moment. Your account and existing cmux workspaces are unchanged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しばらくしてからもう一度試してください。アカウントと既存の cmux ワークスペースは変更されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请稍后重试。你的账户和现有 cmux 工作区未发生更改。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie es gleich noch einmal. Ihr Konto und Ihre bestehenden cmux-Arbeitsbereiche bleiben unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez dans un instant. Votre compte et vos espaces de travail cmux existants restent inchangés."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد المحاولة بعد قليل. حسابك ومساحات عمل cmux الحالية لم تتغير."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a intentarlo en un momento. Tu cuenta y tus espacios de trabajo de cmux existentes no han cambiado."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請稍後再試。您的帳戶和現有的 cmux 工作區未發生任何變更。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시 후 다시 시도하세요. 귀하의 계정과 기존 cmux 작업 공간에는 변동이 없습니다."
          }
        }
      }
    },
    "account.signIn.error.server.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux sign-in is temporarily unavailable"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
