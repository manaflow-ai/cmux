    "settings.automation.portBase.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المنفذ الابتدائي لمتغير البيئة CMUX_PORT."
          }
        },
        "bs": {
