    "cli.restore.codexCheckpointUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: the saved agent session is unavailable. The terminal remains in its saved directory; retry later or start a new agent session."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 保存されたエージェント セッションを利用できません。ターミナルは保存されたディレクトリに残っています。後でもう一度試すか、新しいエージェント セッションを開始してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 已保存的代理会话不可用。终端仍留在其保存目录中；请稍后重试，或新建一个代理会话。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: Die gespeicherte Agenten-Sitzung ist nicht verfügbar. Das Terminal verbleibt in seinem gespeicherten Verzeichnis; versuchen Sie es später erneut oder starten Sie eine neue Agenten-Sitzung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "restore : la session d'agent enregistrée n'est pas disponible. Le terminal reste dans son répertoire enregistré ; réessayez plus tard ou démarrez une nouvelle session d'agent."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: جلسة الوكيل المحفوظة غير متاحة. تظل الطرفية في دليلها المحفوظ؛ أعد المحاولة لاحقًا أو ابدأ جلسة وكيل جديدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: la sesión del agente guardada no está disponible. La terminal permanece en su directorio guardado; reinténtelo más tarde o inicie una nueva sesión del agente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "restore：儲存的代理程式工作階段無法使用。終端機仍保留在儲存的目錄中；請稍後重試或啟動新的代理程式工作階段。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 저장된 에이전트 세션을 사용할 수 없습니다. 터미널은 저장된 디렉터리에 그대로 유지됩니다. 나중에 다시 시도하거나 새 에이전트 세션을 시작하십시오."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: spremljena sesija agenta nije dostupna. Terminal ostaje u svom sačuvanom direktoriju; pokušajte ponovo kasnije ili pokrenite novu sesiju agenta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: den gemte agentsession er ikke tilgængelig. Terminalen forbliver i sin gemte mappe; prøv igen senere eller start en ny agentsession."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: la sessione agente salvata non è disponibile. Il terminale rimane nella directory salvata; riprova più tardi o avvia una nuova sessione agente."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: សម័យ agent ដែលបានរក្សា មិនអាចប្រើបាន។ terminal នៅតែស្ថិតក្នុង directory ដែលបានរក្សា; ព្យាយាមម្ដងទៀតនៅពេលក្រោយ ឬចាប់ផ្ដើមសម័យ agent ថ្មី។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: den lagrede agentsesjonen er utilgjengelig. Terminalen forblir i sin lagrede mappe; prøv igjen senere eller start en ny agentsesjon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: zapisana sesja agenta jest niedostępna. Terminal pozostaje w zapisanym katalogu; spróbuj ponownie później lub rozpocznij nową sesję agenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: a sessão do agente salva está indisponível. O terminal permanece no diretório salvo; tente novamente mais tarde ou inicie uma nova sessão de agente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: сохранённая сессия агента недоступна. Терминал остаётся в сохранённой директории; повторите попытку позже или начните новую сессию агента."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: agent session ที่บันทึกไว้ไม่พร้อมใช้งาน เทอร์มินัลยังอยู่ในไดเรกทอรีที่บันทึกไว้ ลองใหม่ภายหลังหรือเริ่ม agent session ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: kaydedilen ajan oturumu kullanılamıyor. Terminal kaydedilen dizinde kalır; daha sonra yeniden deneyin veya yeni bir ajan oturumu başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: збережена сесія агента недоступна. Термінал залишається у збереженій директорії; повторіть спробу пізніше або запустіть нову сесію агента."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: phiên agent đã lưu không khả dụng. Terminal vẫn ở thư mục đã lưu; thử lại sau hoặc bắt đầu phiên agent mới."
          }
        }
      }
    },
    "cli.restore.error.checkpointMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: this command no longer matches the session. Run 'cmux restore --surface' to use the current record."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: このコマンドは現在のセッションと一致しません。現在の状態を使用するには 'cmux restore --surface' を実行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "restore：此命令与该会话已不匹配。请运行 'cmux restore --surface' 以使用当前记录。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: Dieser Befehl stimmt nicht mehr mit der Sitzung überein. Führen Sie 'cmux restore --surface' aus, um den aktuellen Datensatz zu verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "restore : cette commande ne correspond plus à la session. Exécutez 'cmux restore --surface' pour utiliser l'enregistrement actuel."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: هذا الأمر لم يعد يطابق الجلسة. قم بتشغيل 'cmux restore --surface' لاستخدام السجل الحالي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: este comando ya no coincide con la sesión. Ejecute 'cmux restore --surface' para usar el registro actual."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "restore：此指令已不再與工作階段相符。執行 'cmux restore --surface' 以使用目前的紀錄。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 이 명령이 더 이상 세션과 일치하지 않습니다. 현재 기록을 사용하려면 'cmux restore --surface'를 실행하십시오."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: ova naredba više ne odgovara sesiji. Pokrenite 'cmux restore --surface' za korištenje trenutnog zapisa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: denne kommando svarer ikke længere til sessionen. Kør 'cmux restore --surface' for at bruge den aktuelle post."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: questo comando non corrisponde più alla sessione. Esegui 'cmux restore --surface' per usare il record corrente."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: ពាក្យបញ្ជានេះលែងត្រូវគ្នានឹង session ហើយ។ ដំណើរការ 'cmux restore --surface' ដើម្បីប្រើកំណត់ត្រាបច្ចុប្បន្ន។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: denne kommandoen samsvarer ikke lenger med sesjonen. Kjør 'cmux restore --surface' for å bruke gjeldende post."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: to polecenie nie pasuje już do sesji. Uruchom 'cmux restore --surface', aby użyć bieżącego rekordu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: este comando não corresponde mais à sessão. Execute 'cmux restore --surface' para usar o registro atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: эта команда больше не соответствует сессии. Выполните 'cmux restore --surface', чтобы использовать текущую запись."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: คำสั่งนี้ไม่ตรงกับเซสชันอีกต่อไป รัน 'cmux restore --surface' เพื่อใช้ระเบียนปัจจุบัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: bu komut artık oturumla eşleşmiyor. Geçerli kaydı kullanmak için 'cmux restore --surface' çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: ця команда більше не відповідає сесії. Виконайте 'cmux restore --surface', щоб використати поточний запис."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: lệnh này không còn khớp với session. Chạy 'cmux restore --surface' để dùng bản ghi hiện tại."
          }
        }
      }
    },
    "cli.restore.error.compatibilityShellFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: the saved process could not be started. Retry the visible restore command."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 保存されたプロセスを開始できませんでした。表示されている復元コマンドを再実行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "restore：无法启动已保存的进程。请重试屏幕上显示的 restore 命令。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: Der gespeicherte Prozess konnte nicht gestartet werden. Wiederholen Sie den sichtbaren restore-Befehl."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "restore : le processus enregistré n'a pas pu être démarré. Réessayez la commande de restauration visible."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: تعذر بدء العملية المحفوظة. أعد محاولة أمر الاستعادة المعروض."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: no se pudo iniciar el proceso guardado. Reintente el comando de restauración visible."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "restore：儲存的程序無法啟動。請重試可見的 restore 指令。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 저장된 프로세스를 시작할 수 없습니다. 표시된 restore 명령을 다시 시도하십시오."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: sačuvani proces nije mogao biti pokrenuti. Ponovite vidljivu naredbu za restore."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: den gemte proces kunne ikke startes. Prøv den synlige restore-kommando igen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: impossibile avviare il processo salvato. Riprovare con il comando restore visibile."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: មិនអាចចាប់ផ្ដើម process ដែលបានរក្សា។ ព្យាយាមពាក្យបញ្ជា restore ដែលបង្ហាញម្ដងទៀត។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: den lagrede prosessen kunne ikke startes. Prøv den synlige restore-kommandoen på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: nie można uruchomić zapisanego procesu. Ponów widoczne polecenie restore."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: o processo salvo não pôde ser iniciado. Repita o comando de restauração visível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: не удалось запустить сохранённый процесс. Повторите видимую команду restore."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
