    "settings.networking.debug.relayOnly.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug builds only. Keeps authenticated Iroh sessions on relays so the relay path can be verified."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバッグビルド専用です。認証済みの Iroh セッションをリレー経路に固定して、リレー接続を検証します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限调试构建。让已认证的 Iroh 会话保持走中继，以便验证中继路径。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für Debug-Builds. Hält authentifizierte Iroh-Sitzungen auf Relays, sodass der Relay-Pfad überprüft werden kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Builds de debug uniquement. Maintient les sessions Iroh authentifiées sur les relais afin de pouvoir vérifier le chemin du relais."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لبنيات تصحيح الأخطاء (Debug) فقط. يبقي جلسات Iroh المصادق عليها على المرحلات حتى يمكن التحقق من مسار الترحيل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo compilaciones de depuración. Mantiene las sesiones autenticadas de Iroh en retransmisiones para que se pueda verificar la ruta de retransmisión."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅限偵錯版本。將已驗證的 Iroh 工作階段保持在中繼上，以便驗證中繼路徑。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디버그 빌드 전용. 인증된 Iroh 세션을 릴레이로 유지하여 릴레이 경로를 검증할 수 있도록 합니다."
          }
        }
      }
    },
