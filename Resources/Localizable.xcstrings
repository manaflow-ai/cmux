    "cli.help.notify": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage: cmux notify [flags]\n\nSend or clear notifications.\n\nFlags: --title --subtitle --body --reply --clear --workspace --surface --window --json --id-format"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使い方: cmux notify [flags]\n\nワークスペース／サーフェスに通知を送り、--clear で対象を消去します。\n\nFlags: --title --subtitle --body --reply --clear --workspace --surface --window --json --id-format"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستخدام: cmux notify [flags]\n\nأرسل إشعارًا أو امسح الهدف باستخدام --clear.\n\nFlags: --title --subtitle --body --reply --clear --workspace --surface --window --json --id-format"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upotreba: cmux notify [flags]\n\nPošaljite obavijest ili obrišite cilj pomoću --clear.\n\nFlags: --title --subtitle --body --reply --clear --workspace --surface --window --json --id-format"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug: cmux notify [flags]\n\nSend en meddelelse eller ryd målet med --clear.\n\nFlags: --title --subtitle --body --reply --clear --workspace --surface --window --json --id-format"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendung: cmux notify [flags]\n\nBenachrichtigung senden oder das Ziel mit --clear leeren.\n\nFlags: --title --subtitle --body --reply --clear --workspace --surface --window --json --id-format"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso: cmux notify [flags]\n\nEnvía una notificación o limpia el destino con --clear.\n\nFlags: --title --subtitle --body --reply --clear --workspace --surface --window --json --id-format"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisation : cmux notify [flags]\n\nEnvoyer une notification ou effacer la cible avec --clear.\n\nFlags : --title --subtitle --body --reply --clear --workspace --surface --window --json --id-format"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso: cmux notify [flags]\n\nInvia una notifica o cancella la destinazione con --clear.\n\nFlags: --title --subtitle --body --reply --clear --workspace --surface --window --json --id-format"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការប្រើប្រាស់: cmux notify [flags]\n\nផ្ញើការជូនដំណឹង ឬសម្អាតគោលដៅដោយ --clear។\n\nFlags: --title --subtitle --body --reply --clear --workspace --surface --window --json --id-format"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용법: cmux notify [flags]\n\n알림을 보내거나 --clear로 대상을 지웁니다.\n\nFlags: --title --subtitle --body --reply --clear --workspace --surface --window --json --id-format"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk: cmux notify [flags]\n\nSend et varsel eller tøm målet med --clear.\n\nFlags: --title --subtitle --body --reply --clear --workspace --surface --window --json --id-format"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użycie: cmux notify [flags]\n\nWyślij powiadomienie albo wyczyść cel za pomocą --clear.\n\nFlags: --title --subtitle --body --reply --clear --workspace --surface --window --json --id-format"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso: cmux notify [flags]\n\nEnvie uma notificação ou limpe o destino com --clear.\n\nFlags: --title --subtitle --body --reply --clear --workspace --surface --window --json --id-format"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использование: cmux notify [flags]\n\nОтправьте уведомление или очистите цель с помощью --clear.\n\nFlags: --title --subtitle --body --reply --clear --workspace --surface --window --json --id-format"
