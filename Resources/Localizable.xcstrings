    },
    "cli.workspaceGroup.help.destructiveDelete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the group AND close every member workspace. Explicitly destructive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループを削除し、すべてのメンバーワークスペースを閉じます。明示的な破壊操作です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除分组并关闭其中每一个成员工作区。明确的破坏性操作。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gruppe löschen UND jeden Mitglieds-Arbeitsbereich schließen. Explizit destruktiv."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime le groupe ET ferme chaque espace de travail membre. Explicitement destructeur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف المجموعة وإغلاق كل مساحة عمل عضو فيها. إجراء تدميري صريح."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina el grupo Y cierra cada espacio de trabajo miembro. Explícitamente destructivo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除群組並關閉每個成員工作區。具有明確的破壞性。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹을 삭제하고 모든 멤버 작업 공간을 닫습니다. (명시적으로 파괴적인 작업입니다.)"
          }
        },
        "da": {
