            "state": "translated",
            "value": "--repo nécessite un chemin. Pour un chemin commençant par un tiret, écrivez ./-name"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "--repo richiede un percorso. Per un percorso che inizia con un trattino, usa ./-name"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "--repo にはパスが必要です。ダッシュで始まるパスは ./-name の形式で指定してください"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "--repo ត្រូវការ​ផ្លូវ។ ផ្លូវ​ដែល​ចាប់ផ្តើម​ដោយ​សញ្ញា​ដាច់ សូម​សរសេរ​ជា ./-name"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "--repo 에는 경로가 필요합니다. 대시로 시작하는 경로는 ./-name 형식으로 넘기세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "--repo krever en sti. En sti som starter med bindestrek, oppgis som ./-name"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "--repo wymaga ścieżki. Ścieżkę zaczynającą się od myślnika podaj jako ./-name"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "--repo requer um caminho. Para um caminho que começa com hífen, use ./-name"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "--repo требует путь. Путь, начинающийся с дефиса, укажите как ./-name"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "--repo ต้องระบุพาธ หากพาธเริ่มด้วยขีดกลาง ให้ระบุเป็น ./-name"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "--repo bir yol gerektirir. Kısa çizgiyle başlayan yolu ./-name olarak verin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "--repo потребує шлях. Шлях, що починається з дефіса, вкажіть як ./-name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "--repo 需要提供路径。以短横线开头的路径请写成 ./-name"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "--repo 需要提供路徑。以連字號開頭的路徑請寫成 ./-name"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "--repo yêu cầu một đường dẫn. Với đường dẫn bắt đầu bằng dấu gạch ngang, truyền dưới dạng ./-name"
          }
        }
      }
