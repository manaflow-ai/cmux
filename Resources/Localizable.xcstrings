    "settings.networking.custom.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay addresses sync with your account. Provider secrets stay only in each device's secure storage. Missing secrets never fall back to cmux relays."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リレーアドレスはアカウントと同期されます。プロバイダーのシークレットは各デバイスの安全なストレージにのみ保存されます。シークレットがない場合に cmux リレーへ切り替わることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中继地址会与账户同步。提供方密钥仅保存在各设备的安全存储中。缺少密钥时绝不会回退到 cmux 中继。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay-Adressen werden mit Ihrem Konto synchronisiert. Provider-Geheimnisse verbleiben ausschließlich im sicheren Speicher des jeweiligen Geräts. Fehlende Geheimnisse weichen niemals auf cmux-Relays aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les adresses de relais se synchronisent avec votre compte. Les secrets du fournisseur restent uniquement dans le stockage sécurisé de chaque appareil. Les secrets manquants ne se rabattent jamais sur les relais cmux."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتزامن عناوين المرحلات مع حسابك. تبقى أسرار المزود فقط في وحدة التخزين الآمنة لكل جهاز. لن تتراجع الأسرار المفقودة أبدًا إلى مرحلات cmux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las direcciones de retransmisión se sincronizan con tu cuenta. Los secretos del proveedor permanecen únicamente en el almacenamiento seguro de cada dispositivo. Los secretos que falten nunca recurrirán a las retransmisiones de cmux."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中繼地址會與您的帳戶同步。提供商金鑰僅會保留在每部裝置的安全儲存空間中。若缺少金鑰，絕不會改用 cmux 中繼。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "릴레이 주소는 계정과 동기화됩니다. 제공자 시크릿은 각 기기의 안전한 보관소에만 보관됩니다. 누락된 시크릿은 cmux 릴레이로 대체 적용되지 않습니다."
          }
        }
      }
    },
