    "cli.vm.route.wouldProvision": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No pool machine is free for %@ — `cmux vm run` would provision a fresh one (add --provision to create it now)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 用に空いているプールマシンがありません — `cmux vm run` は新しいマシンを作成します（今すぐ作成するには --provision を付けてください）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有空闲的池化机器可供 %@ 使用 —— `cmux vm run` 会新开一台（加 --provision 可立即创建）。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Pool-Maschine ist frei für %@ – `cmux vm run` würde eine neue bereitstellen (fügen Sie --provision hinzu, um sie jetzt zu erstellen)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune machine du pool n'est libre pour %@ — `cmux vm run` provisionnerait une nouvelle machine (ajoutez --provision pour la créer maintenant)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد جهاز متاح من التجمع لـ %@ — سيقوم `cmux vm run` بتهيئة جهاز جديد (أضف --provision لإنشائه الآن)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna máquina del grupo está libre para %@ — `cmux vm run` aprovisionaría una nueva (añade --provision para crearla ahora)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有空閒的集區機器可用於 %@ — `cmux vm run` 將會部署一台新的機器（加入 --provision 以立即建立）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 대해 사용할 수 있는 풀 가상 머신이 없습니다 — `cmux vm run` 실행 시 새 가상 머신이 프로비저닝됩니다 (지금 생성하려면 --provision을 추가하십시오)."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nijedna pool mašina nije slobodna za %@ — `cmux vm run` bi dodijelio novu (dodajte --provision da je kreirate sada)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen pool-maskine er ledig til %@ — `cmux vm run` ville klargøre en ny (tilføj --provision for at oprette den nu)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessuna macchina del pool è libera per %@ — `cmux vm run` ne provisionerebbe una nuova (aggiungi --provision per crearla ora)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen pool-maskin er ledig for %@ — `cmux vm run` vil klargjøre en ny (legg til --provision for å opprette den nå)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Żadna maszyna w puli nie jest wolna dla %@ — `cmux vm run` zainicjowałoby nową (dodaj --provision, aby utworzyć ją teraz)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhuma máquina do pool está livre para %@ — `cmux vm run` provisionaria uma nova (adicione --provision para criá-la agora)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Нет свободной машины в пуле для %@ — `cmux vm run` подготовит новую (добавьте --provision, чтобы создать её сейчас)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่มี pool machine ว่างสำหรับ %@ — `cmux vm run` จะจัดเตรียมเครื่องใหม่ (เพิ่ม --provision เพื่อสร้างทันที)"
