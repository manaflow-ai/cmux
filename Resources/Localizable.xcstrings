    "surfaceCatalog.error.ambiguousRemotePlacement": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This terminal has more than one remote placement. Specify the remote tab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このターミナルには複数のリモート配置があります。リモートタブを指定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此终端有多个远程位置。请指定远程标签页。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Terminal hat mehr als eine Remote-Platzierung. Geben Sie den Remote-Tab an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce terminal a plus d’un emplacement distant. Spécifiez l’onglet distant."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي هذه الطرفية على أكثر من موضع بعيد واحد. يرجى تحديد علامة التبويب البعيدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta terminal tiene más de una ubicación remota. Especifica la pestaña remota."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此終端機有多個遠端位置。請指定遠端標籤頁。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 터미널은 여러 개의 원격 배치를 가지고 있습니다. 원격 탭을 지정하십시오."
          }
        }
      }
    },
    "cloudTree.error.renameTerminalNoView": {
      "extractionState": "manual",
      "localizations": {
