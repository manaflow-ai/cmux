    },
    "account.signIn.error.network.recovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection, then try again. Your account was not changed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を確認してから、もう一度試してください。アカウントは変更されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查网络连接后重试。你的账户未发生更改。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie Ihre Verbindung und versuchen Sie es erneut. Ihr Konto wurde nicht geändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre connexion, puis réessayez. Votre compte n’a pas été modifié."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من اتصالك، ثم أعد المحاولة. لم يتغير حسابك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba tu conexión y vuelve a intentarlo. Tu cuenta no ha sufrido cambios."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查您的連線，然後再試一次。您的帳戶未發生任何變更。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 연결을 확인한 후 다시 시도하세요. 귀하의 계정 정보는 변경되지 않았습니다."
          }
        }
      }
    },
    "account.signIn.error.network.title": {
      "extractionState": "manual",
