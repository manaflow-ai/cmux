          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยุบกลุ่ม โดยคงสมาชิกทั้งหมดไว้"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Raspusti grupu, čuvajući sve članove"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scioglie un gruppo preservando tutti i membri"
