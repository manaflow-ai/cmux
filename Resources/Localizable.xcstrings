    "sudo.error.cleanup_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo could not finish process cleanup; one or more processes survived"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo のプロセスを完全にクリーンアップできませんでした。1 つ以上のプロセスが残っています"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo-Ausführung ist abgelaufen, aber ein oder mehrere Prozesse haben die Bereinigung überlebt"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت مهلة تنفيذ sudo، لكن عملية واحدة أو أكثر نجت من التنظيف"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo izvršenje je isteklo, ali jedan ili više procesa je preživio čišćenje"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo udførelse timeout, men en eller flere processer overlevede oprydning"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el tiempo de ejecución de sudo, pero uno o más procesos sobrevivieron a la limpieza"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'exécution de sudo a expiré, mais un ou plusieurs processus ont survécu au nettoyage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'esecuzione di sudo è scaduta, ma uno o più processi sono sopravvissuti alla pulizia"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការប្រតិបត្តិ sudo អស់ពេល ប៉ុន្តែដំណើរការមួយ ឬច្រើនបានរួចផុតពីការសម្អាត"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo-kjøringen ble tidsavbrutt, men én eller flere prosesser overlevde oppryddingen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upłynął limit czasu wykonania sudo, ale jeden lub więcej procesów przetrwało czyszczenie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A execução do sudo atingiu o tempo limite, mas um ou mais processos sobreviveram à limpeza"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время выполнения sudo истекло, но один или несколько процессов пережили очистку"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการ sudo หมดเวลา แต่มีกระบวนการอย่างน้อยหนึ่งกระบวนการที่รอดจากการล้างข้อมูล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo yürütme zaman aşımına uğradı ancak bir veya daha fazla işlem temizlemeden sağ çıktı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час очікування виконання sudo минув, але один або кілька процесів пережили очищення"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo 执行超时，但一个或多个进程在清理过程中幸存下来"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo 執行逾時，但一個或多個程序在清理過程中倖存下來"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "sudo 실행 시간이 초과되었지만 하나 이상의 프로세스가 정리 상태에서 살아 남았습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "sudo không thể hoàn tất dọn dẹp tiến trình; một hoặc nhiều tiến trình còn tồn tại"
          }
        }
      }
    },
