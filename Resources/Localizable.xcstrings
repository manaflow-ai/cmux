    "workspaceGroup.contextMenu.markAllRead": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعليم جميع مساحات العمل في المجموعة كمقروءة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Označi sve radne prostore u grupi kao pročitane"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Marker alle arbejdsområder i gruppen som læst"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Arbeitsbereiche der Gruppe als gelesen markieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark All Workspaces in Group as Read"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcar todos los espacios de trabajo del grupo como leídos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquer tous les espaces de travail du groupe comme lus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna tutte le aree di lavoro del gruppo come lette"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループ内のすべてのワークスペースを既読にする"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark All Workspaces in Group as Read"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹의 모든 작업 공간을 읽음으로 표시"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Merk alle arbeidsområder i gruppen som lest"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznacz wszystkie przestrzenie robocze w grupie jako przeczytane"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcar Todas as Áreas de Trabalho do Grupo como Lidas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметить все рабочие пространства в группе как прочитанные"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำเครื่องหมายเวิร์กสเปซทั้งหมดในกลุ่มว่าอ่านแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruptaki tüm çalışma alanlarını okundu olarak işaretle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначити всі робочі області групи як прочитані"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将分组内所有工作区标记为已读"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將群組內所有工作區標為已讀"
          }
        }
      }
    },
