    "settings.app.confirmQuit.subtitleDirtyOnly": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض تأكيدًا فقط عندما تحتاج مساحة عمل إلى تأكيد الإغلاق."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaži potvrdu samo kada workspace zahtijeva potvrdu zatvaranja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis kun en bekræftelse, når et workspace kræver bekræftelse ved lukning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeige nur dann eine Bestätigung, wenn ein Workspace eine Schließbestätigung benötigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a confirmation only when a workspace needs close confirmation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar una confirmación solo cuando un espacio de trabajo requiera confirmación al cerrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher une confirmation uniquement lorsqu’un workspace nécessite une confirmation de fermeture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra una conferma solo quando un workspace richiede conferma di chiusura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる確認が必要なワークスペースがある場合のみ確認を表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បង្ហាញការបញ្ជាក់តែនៅពេល workspace ត្រូវការការបញ្ជាក់ពេលបិទ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫기 확인이 필요한 워크스페이스가 있을 때만 확인을 표시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis bare en bekreftelse når et workspace krever bekreftelse ved lukking."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuj potwierdzenie tylko wtedy, gdy workspace wymaga potwierdzenia zamknięcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre uma confirmação apenas quando um workspace precisar de confirmação de fechamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать подтверждение только тогда, когда workspace требует подтверждения закрытия."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงการยืนยันเฉพาะเมื่อ workspace ต้องยืนยันก่อนปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bir workspace kapatma onayı gerektirdiğinde onay göster."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати підтвердження лише тоді, коли workspace потребує підтвердження закриття."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当工作区需要关闭确认时显示确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在工作區需要關閉確認時顯示確認。"
