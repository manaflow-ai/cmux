    "settings.app.loadingSpinnerPosition.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار المؤشر على يسار صف مساحة العمل (بمشاركة موضع شارة غير المقروء) أو على يمينه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje indikator lijevo (dijeli mjesto sa značkom nepročitanog) ili desno u redu radnog prostora."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser indikatoren til venstre (deler plads med ulæst-mærket) eller til højre i arbejdsområdets række."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt den Indikator links (teilt den Platz mit der Ungelesen-Plakette) oder rechts in der Arbeitsbereichszeile."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the spinner on the left (sharing the unread badge slot) or the right of the workspace row."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el indicador a la izquierda (compartiendo el espacio de la insignia de no leídos) o a la derecha de la fila del espacio de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche l’indicateur à gauche (partageant l’emplacement du badge non lu) ou à droite de la ligne de l’espace de travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra l’indicatore a sinistra (condividendo lo spazio del badge non letti) o a destra della riga dello spazio di lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スピナーをワークスペース行の左（未読バッジの位置を共有）または右に表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워크스페이스 행의 왼쪽(읽지 않음 배지 자리 공유) 또는 오른쪽에 스피너를 표시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser indikatoren til venstre (deler plass med ulest-merket) eller til høyre i arbeidsområderaden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje wskaźnik po lewej stronie (współdzieląc miejsce z plakietką nieprzeczytanych) lub po prawej stronie wiersza obszaru roboczego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o indicador à esquerda (compartilhando o espaço do selo de não lidos) ou à direita da linha do espaço de trabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает индикатор слева (совместно со значком непрочитанного) или справа в строке рабочего пространства."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงตัวบ่งชี้ทางซ้าย (ใช้ตำแหน่งเดียวกับป้ายยังไม่ได้อ่าน) หรือทางขวาของแถวเวิร์กสเปซ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Göstergeyi çalışma alanı satırının solunda (okunmamış rozetiyle aynı yeri paylaşır) veya sağında gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує індикатор ліворуч (спільно зі значком непрочитаного) або праворуч у рядку робочого простору."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在工作区行的左侧（与未读标记共用位置）或右侧显示指示器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在工作區列的左側（與未讀標記共用位置）或右側顯示指示器。"
          }
        }
      }
    },
