          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen internetforbindelse. Opret forbindelse til Wi-Fi eller mobildata, og prøv igen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
