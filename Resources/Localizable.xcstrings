    "commandPalette.rename.tabConfirmHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط Enter لتطبيق اسم اللسان، أو Escape للإلغاء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pritisnite Enter za primjenu naziva taba, ili Escape za otkazivanje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk Enter for at anvende dette fanenavn, eller Escape for at annullere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken Sie die Eingabetaste, um den Tab-Namen zu übernehmen, oder Escape zum Abbrechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Enter to apply this tab name, or Escape to cancel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa Intro para aplicar este nombre de pestaña, o Escape para cancelar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur Entrée pour appliquer ce nom d'onglet, ou sur Échap pour annuler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi Invio per applicare il nome della scheda, oppure Esc per annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Enterキーでタブ名を適用、Escapeキーでキャンセルします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter를 눌러 탭 이름을 적용하거나, Escape를 눌러 취소하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk Enter for å bruke dette fanenavnet, eller Escape for å avbryte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij Enter, aby zastosować nazwę karty, lub Escape, aby anulować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione Enter para aplicar este nome de aba ou Escape para cancelar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите Enter, чтобы применить имя вкладки, или Escape для отмены."
