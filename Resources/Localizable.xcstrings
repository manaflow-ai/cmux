    "settings.notifications.paneFlash.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Briefly flash an outline when cmux highlights a pane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux がペインを強調表示するときにアウトラインを一時的に点滅させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 패인을 강조할 때 테두리를 잠시 깜빡입니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткочасно підсвічувати рамкою панель, на яку cmux звертає увагу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 cmux 高亮某个窗格时，短暂闪烁一圈轮廓。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurz einen Umriss aufblinken lassen, wenn cmux ein Teilfenster hervorhebt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire clignoter brièvement une bordure lorsque cmux met en surbrillance un volet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وميض الحد الخارجي لفترة وجيزة عندما يقوم cmux بتمييز جزء."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Destella brevemente un contorno cuando cmux resalta un panel."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 cmux 醒目提示窗格時，短暫閃爍外框。"
          }
        }
      }
    },
