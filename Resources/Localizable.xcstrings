    "settings.app.markdownFontFamily.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default body font family for newly opened markdown viewers. Leave empty for the system markdown font stack."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しく開く Markdown ビューアの本文フォントファミリーです。空のままにするとシステムの Markdown フォントスタックを使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新打开的 Markdown 查看器的默认正文字体。留空则使用系统 Markdown 字体栈。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard-Schriftfamilie für Fließtext in neu geöffneten Markdown-Betrachtern. Leer lassen für die Standard-Schriftartenliste des Systems für Markdown."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Famille de polices par défaut du corps de texte pour les lecteurs Markdown nouvellement ouverts. Laisser vide pour utiliser la pile de polices Markdown du système."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عائلة الخطوط الافتراضية للنص لعارضي markdown المفتوحين حديثًا. اتركه فارغًا لاستخدام مجموعة خطوط markdown الخاصة بالنظام."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Familia de fuentes predeterminada para el cuerpo de los visores de markdown recién abiertos. Déjala vacía para usar la pila de fuentes de markdown del sistema."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新開啟的 Markdown 檢視器之預設內文字型家族。留空則使用系統 Markdown 字型堆疊。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로 열리는 마크다운 뷰어의 기본 본문 글꼴 패밀리입니다. 시스템 마크다운 글꼴 스택을 사용하려면 비워 두세요."
          }
        }
      }
    },
