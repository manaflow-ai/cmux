          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "fork: komanda sačuvanog agenta je nedostupna. Provjerite je li agent instaliran, a zatim pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
