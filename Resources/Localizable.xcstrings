    "cli.vpn.status.pinned": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned up by `cmux vpn up`; run `cmux vpn down` to release."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`cmux vpn up` により接続が固定されています。解除するには `cmux vpn down` を実行してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angeheftet durch `cmux vpn up`; führen Sie `cmux vpn down` aus, um freizugeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Épinglé par `cmux vpn up` ; exécutez `cmux vpn down` pour le libérer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثبت بواسطة `cmux vpn up`؛ قم بتشغيل `cmux vpn down` للإلغاء."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anclado activo por `cmux vpn up`; ejecute `cmux vpn down` para liberarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已由 `cmux vpn up` 固定啟用；執行 `cmux vpn down` 以釋放。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 `cmux vpn up` 保持开启；运行 `cmux vpn down` 释放。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`cmux vpn up`에 의해 연결 상태가 고정됨; 해제하려면 `cmux vpn down`을 실행하세요."
          }
        }
      }
    },
    "cli.vpn.status.autoManaged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tunnel starts automatically when you open a Cloud machine and stops when no Cloud sessions remain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トンネルはクラウドマシンを開くと自動的に開始し、クラウドセッションがなくなると停止します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tunnel startet automatisch, wenn Sie eine Cloud-Maschine öffnen, und stoppt, wenn keine Cloud-Sitzungen mehr verbleiben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tunnel démarre automatiquement lorsque vous ouvrez une machine Cloud et s'arrête lorsqu'il ne reste plus de sessions Cloud."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ النفق تلقائيًا عندما تفتح جهاز Cloud ويتوقف عندما لا تتبقى أي جلسات Cloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El túnel se inicia automáticamente al abrir una máquina de la nube y se detiene cuando no quedan sesiones en la nube."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通道會在您開啟雲端機器時自動啟動，並在沒有殘留任何雲端工作階段時停止。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该隧道会在您打开云机器时自动启动，并在没有云会话残留时停止。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud 머신을 열면 터널이 자동으로 시작되고, 남아 있는 Cloud 세션이 없을 때 중지됩니다."
          }
        }
      }
    },
