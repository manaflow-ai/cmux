    "detectedSSH.fileDrop.error.notFileURL": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر رفع العنصر الذي تم إفلاته لأنه ليس ملفًا محليًا. أفلت ملفًا من Finder، ثم حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće otpremiti ispuštenu stavku jer nije lokalna datoteka. Ispustite datoteku iz Findera, pa pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det emne, du slap, kunne ikke uploades, fordi det ikke er en lokal fil. Træk en fil fra Finder, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das abgelegte Objekt konnte nicht hochgeladen werden, weil es keine lokale Datei ist. Ziehe eine Datei aus dem Finder hinein und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't upload the dropped item because it isn't a local file. Drop a file from Finder, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo subir el elemento soltado porque no es un archivo local. Suelta un archivo desde Finder e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de téléverser l’élément déposé, car ce n’est pas un fichier local. Déposez un fichier depuis le Finder, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare l’elemento rilasciato perché non è un file locale. Rilascia un file dal Finder e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドロップされた項目はローカルファイルではないためアップロードできません。Finder からファイルをドロップして、もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចផ្ទុកឡើងធាតុដែលបានទម្លាក់បានទេ ព្រោះវាមិនមែនជាឯកសារមូលដ្ឋាន។ សូមទម្លាក់ឯកសារពី Finder ហើយព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드롭한 항목이 로컬 파일이 아니어서 업로드할 수 없습니다. Finder에서 파일을 드롭한 다음 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke laste opp elementet som ble sluppet, fordi det ikke er en lokal fil. Slipp en fil fra Finder, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można przesłać upuszczonego elementu, ponieważ nie jest plikiem lokalnym. Upuść plik z Findera i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível enviar o item solto porque ele não é um arquivo local. Solte um arquivo do Finder e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить перетащенный объект, потому что это не локальный файл. Перетащите файл из Finder и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถอัปโหลดรายการที่วางได้เพราะไม่ใช่ไฟล์ในเครื่อง ให้วางไฟล์จาก Finder แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bırakılan öğe yerel bir dosya olmadığı için yüklenemedi. Finder’dan bir dosya bırakıp yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити скинутий елемент, бо це не локальний файл. Перетягніть файл із Finder і повторіть спробу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法上传拖放的项目，因为它不是本地文件。请从 Finder 拖放一个文件，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法上傳拖放的項目，因為它不是本機檔案。請從 Finder 拖放檔案，然後再試一次。"
          }
        }
      }
    },
    "detectedSSH.fileDrop.error.scpTimedOut": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت مهلة نقل الملف. تحقق من المضيف البعيد واتصال الشبكة، ثم حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijenos datoteke je istekao. Provjerite udaljeni host i mrežnu vezu, pa pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filoverførslen fik timeout. Kontrollér fjernværten og netværksforbindelsen, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateiübertragung hat das Zeitlimit überschritten. Prüfe den Remote-Host und die Netzwerkverbindung und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File transfer timed out. Check the remote host and network connection, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia del archivo agotó el tiempo de espera. Comprueba el host remoto y la conexión de red e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transfert du fichier a expiré. Vérifiez l’hôte distant et la connexion réseau, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il trasferimento del file è scaduto. Verifica l’host remoto e la connessione di rete, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル転送がタイムアウトしました。リモートホストとネットワーク接続を確認して、もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការផ្ទេរឯកសារអស់ពេលកំណត់។ សូមពិនិត្យម៉ាស៊ីនពីចម្ងាយ និងការតភ្ជាប់បណ្តាញ ហើយព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 전송 시간이 초과되었습니다. 원격 호스트와 네트워크 연결을 확인한 다음 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filoverføringen tidsavbrøt. Kontroller den eksterne verten og nettverkstilkoblingen, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upłynął limit czasu transferu pliku. Sprawdź host zdalny i połączenie sieciowe, a następnie spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência do arquivo expirou. Verifique o host remoto e a conexão de rede e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время передачи файла истекло. Проверьте удалённый хост и сетевое подключение, затем повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การถ่ายโอนไฟล์หมดเวลา ตรวจสอบโฮสต์ระยะไกลและการเชื่อมต่อเครือข่าย แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya aktarımı zaman aşımına uğradı. Uzak ana makineyi ve ağ bağlantısını kontrol edip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час передавання файлу минув. Перевірте віддалений хост і мережеве з’єднання, а потім повторіть спробу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件传输超时。请检查远程主机和网络连接，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案傳輸逾時。請檢查遠端主機和網路連線，然後再試一次。"
          }
        }
      }
    },
    "detectedSSH.fileDrop.error.uploadFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر رفع الملف إلى الجلسة البعيدة. تحقق من أن المضيف البعيد قابل للوصول، ثم حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteku nije moguće otpremiti u udaljenu sesiju. Provjerite da li je udaljeni host dostupan, pa pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen kunne ikke uploades til den eksterne session. Kontrollér, at fjernværten kan nås, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei konnte nicht in die Remote-Sitzung hochgeladen werden. Prüfe, ob der Remote-Host erreichbar ist, und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't upload the file to the remote session. Check that the remote host is reachable, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo subir el archivo a la sesión remota. Comprueba que el host remoto esté accesible e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de téléverser le fichier vers la session distante. Vérifiez que l’hôte distant est joignable, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare il file nella sessione remota. Verifica che l’host remoto sia raggiungibile e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートセッションへファイルをアップロードできませんでした。リモートホストに到達できることを確認して、もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចផ្ទុកឡើងឯកសារទៅសម័យពីចម្ងាយបានទេ។ សូមពិនិត្យថាម៉ាស៊ីនពីចម្ងាយអាចចូលដំណើរការបាន ហើយព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 세션에 파일을 업로드할 수 없습니다. 원격 호스트에 연결할 수 있는지 확인한 다음 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke laste opp filen til den eksterne økten. Kontroller at den eksterne verten er tilgjengelig, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można przesłać pliku do sesji zdalnej. Sprawdź, czy host zdalny jest osiągalny, i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível enviar o arquivo para a sessão remota. Verifique se o host remoto está acessível e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить файл в удалённый сеанс. Проверьте доступность удалённого хоста и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถอัปโหลดไฟล์ไปยังเซสชันระยะไกลได้ ตรวจสอบว่าโฮสต์ระยะไกลเข้าถึงได้ แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya uzak oturuma yüklenemedi. Uzak ana makinenin erişilebilir olduğunu kontrol edip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити файл у віддалений сеанс. Перевірте доступність віддаленого хоста й повторіть спробу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将文件上传到远程会话。请检查远程主机是否可访问，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法將檔案上傳到遠端工作階段。請確認遠端主機可連線，然後再試一次。"
          }
        }
      }
    },
    "dialog.closeAnchor.message.lone": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إغلاق مساحة العمل هذه سيحذف المجموعة «%@»."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatvaranje ovog radnog prostora ukloniti će grupu „%@“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du lukker dette arbejdsområde, fjernes gruppen “%@”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du diesen Arbeitsbereich schließt, wird die Gruppe „%@“ entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing this workspace will remove the group “%@”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar este espacio de trabajo eliminará el grupo «%@»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer cet espace de travail supprimera le groupe « %@ »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudere quest’area di lavoro rimuoverà il gruppo «%@»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースを閉じるとグループ「%@」が削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업 공간을 닫으면 그룹 “%@”이(가) 삭제됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du lukker dette arbeidsområdet, fjernes gruppen «%@»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknięcie tej przestrzeni usunie grupę „%@”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar esta área de trabalho removerá o grupo “%@”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрытие этого рабочего пространства удалит группу «%@»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การปิดเวิร์กสเปซนี้จะลบกลุ่ม “%@”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çalışma alanını kapatmak “%@” grubunu kaldıracak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закриття цієї робочої області видалить групу «%@»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭此工作区将删除分组「%@」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉此工作區將移除群組「%@」。"
          }
        }
      }
    },
