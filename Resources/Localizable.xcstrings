        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DEV 빌드에서는 종료 확인이 비활성화됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I DEV-bygg er avslutningsbekreftelser deaktivert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W buildach DEV potwierdzenia zamknięcia są wyłączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em builds DEV, as confirmações de saída ficam desativadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В сборках DEV подтверждения выхода отключены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในบิลด์ DEV การยืนยันก่อนออกจะถูกปิดใช้งาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DEV derlemelerinde çıkış onayları devre dışıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У збірках DEV підтвердження виходу вимкнені."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DEV 构建中已禁用退出确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DEV 建置中已停用結束確認。"
