    "settings.terminal.sessionContentAlignment.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Places width-capped content within the pane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "幅を制限したコンテンツをペイン内に配置します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "决定限宽内容在窗格中的位置。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Platziert in der Breite begrenzten Inhalt innerhalb des Teilfensters."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Positionne le contenu limité en largeur à l’intérieur du volet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضع المحتوى محدود العرض داخل الجزء."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca el contenido con límite de ancho dentro del panel."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將限制寬度的內容置於窗格內。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너비가 제한된 콘텐츠를 분할 창 내에 배치합니다."
          }
        }
      }
    },
    "settings.terminal.sessionContentWidth": {
