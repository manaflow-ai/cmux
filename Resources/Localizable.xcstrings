        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドマシンはまだリモートアクセスを準備中です。しばらくしてからもう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Cloud-Maschine bereitet den Remote-Zugriff noch vor. Versuchen Sie es in Kürze noch einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La machine Cloud prépare toujours l’accès distant. Réessayez dans quelques instants."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال الجهاز السحابي يجهز الوصول عن بعد. حاول مجددًا بعد قليل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La máquina en la nube aún está preparando el acceso remoto. Inténtalo de nuevo en breve."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲端機器仍在準備遠端存取。請稍後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端机器仍在准备远程访问。请稍后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 가상 머신이 아직 원격 액세스를 준비 중입니다. 잠시 후 다시 시도하십시오."
          }
        }
      }
    },
