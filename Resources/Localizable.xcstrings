    "cli.vm.agent.waiting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for %1$@ to finish (Ctrl-C stops waiting; the agent keeps running — %2$@).\n"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ の終了を待っています（Ctrl-C は待機だけを止め、エージェントは実行を続けます — %2$@）。\n"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في انتظار انتهاء %1$@ (يؤدي Ctrl-C إلى إيقاف الانتظار؛ ويستمر الوكيل في التشغيل — %2$@).\n"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needsReview",
            "value": "Waiting for %1$@ to finish (Ctrl-C stops waiting; the agent keeps running — %2$@).\n"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needsReview",
            "value": "Waiting for %1$@ to finish (Ctrl-C stops waiting; the agent keeps running — %2$@).\n"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf das Beenden von %1$@ (Ctrl-C bricht das Warten ab; der Agent läuft weiter — %2$@).\n"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando a que %1$@ finalice (Ctrl-C detiene la espera; el agente sigue ejecutándose — %2$@).\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de la fin de %1$@ (Ctrl-C arrête l'attente ; l'agent continue de s'exécuter — %2$@).\n"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needsReview",
            "value": "Waiting for %1$@ to finish (Ctrl-C stops waiting; the agent keeps running — %2$@).\n"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needsReview",
            "value": "Waiting for %1$@ to finish (Ctrl-C stops waiting; the agent keeps running — %2$@).\n"
          }
        },
        "ko": {
