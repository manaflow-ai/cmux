    "cli.moshTmux.arguments.invalid": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقبل mosh-tmux وجهة و --session، وليس أمرًا بعيدًا منفصلًا"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-tmux prihvata odredište i --session, a ne zasebnu udaljenu naredbu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-tmux accepterer en destination og --session, ikke en separat fjernkommando"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-tmux akzeptiert ein Ziel und --session, aber keinen separaten Remote-Befehl"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-tmux accepts a destination and --session, not a separate remote command"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-tmux acepta un destino y --session, no un comando remoto separado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-tmux accepte une destination et --session, pas une commande distante distincte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-tmux accetta una destinazione e --session, non un comando remoto separato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-tmux は接続先と --session を受け付けます。別のリモートコマンドは指定できません"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-tmux ទទួល destination និង --session មិនទទួល remote command ដាច់ដោយឡែកទេ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-tmux는 대상과 --session을 받으며 별도의 원격 명령은 받지 않습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-tmux godtar et mål og --session, ikke en separat ekstern kommando"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-tmux przyjmuje cel i --session, a nie osobne zdalne polecenie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-tmux aceita um destino e --session, não um comando remoto separado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-tmux принимает адрес и --session, но не отдельную удалённую команду"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-tmux รับ destination และ --session ไม่รับ remote command แยกต่างหาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-tmux bir hedef ve --session kabul eder, ayrı bir uzak komut kabul etmez"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-tmux приймає адресу та --session, а не окрему віддалену команду"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-tmux 接受目标和 --session，不接受单独的远程命令"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-tmux 接受目的地與 --session，不接受獨立的遠端命令"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "mosh-tmux nhận đích đến và --session, không nhận lệnh từ xa riêng biệt"
          }
        }
      }
    },
    "cli.moshTmux.session.invalid": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-tmux: يتطلب --session اسم جلسة غير فارغ من دون محارف مخفية"
          }
