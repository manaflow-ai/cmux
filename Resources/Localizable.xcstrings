    "cli.automation.output.enableRequested": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable request queued for %@. Run cmux automation logs to verify completion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の有効化要求をキューに追加しました。完了を確認するには cmux automation logs を実行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已排队 %@ 的启用请求。运行 cmux automation logs 确认是否完成。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivierungsanforderung für %@ in Warteschlange eingereiht. Führe cmux automation logs aus, um den Abschluss zu überprüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande d'activation mise en file d'attente pour %@. Exécutez cmux automation logs pour vérifier la finalisation."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم وضع طلب التمكين في قائمة الانتظار لـ %@. شغّل cmux automation logs للتحقق من الاكتمال."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitud de habilitación en cola para %@. Ejecute cmux automation logs para verificar la finalización."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已將啟用請求排入 %@ 的佇列。請執行 cmux automation logs 以驗證是否完成。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화 요청이 대기열에 추가됨: %@. 완료 여부를 확인하려면 cmux automation logs를 실행하세요."
          }
        }
      }
    },
