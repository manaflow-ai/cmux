    "cloudVM.publication.error.invalidDNS": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud VM publication response contained an invalid DNS instruction."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud VM 公開レスポンスに無効な DNS 指示が含まれています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud VM 发布响应中包含无效的 DNS 指令。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Veröffentlichungsantwort der Cloud-VM enthielt eine ungültige DNS-Anweisung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse de publication de la VM cloud contenait une instruction DNS non valide."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتوت استجابة نشر Cloud VM على تعليمات DNS غير صالحة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta de publicación de la VM en la nube contenía una instrucción DNS no válida."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲端 VM 發佈回應包含無效的 DNS 指令。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 VM 게시 응답에 유효하지 않은 DNS 지침이 포함되어 있습니다."
          }
        }
      }
    },
