    "cli.error.workspaceLoadingInvalidId": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid --id '%@'. Use letters, digits, '.', '_', or '-' (no spaces)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効な --id '%@' です。英数字、'.'、'_'、'-' のみ使用できます（空白不可）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘못된 --id '%@'입니다. 영문자, 숫자, '.', '_', '-'만 사용할 수 있습니다(공백 불가)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неприпустимий --id '%@'. Використовуйте літери, цифри, '.', '_' або '-' (без пробілів)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无效的 --id '%@'。请使用字母、数字、'.'、'_' 或 '-'（不能有空格）。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültige --id „%@“. Verwende Buchstaben, Ziffern, „.“, „_“ oder „-“ (keine Leerzeichen)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "--id '%@' non valide. Utilisez des lettres, des chiffres, '.', '_', ou '-' (sans espaces)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المعرف --id غير صالح '%@'. استخدم الحروف، أو الأرقام، أو '.'، أو '_'، أو '-' (بدون مسافات)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "--id '%@' no válido. Usa letras, dígitos, '.', '_' o '-' (sin espacios)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無效的 --id '%@'。請使用字母、數字、'.'、'_' 或 '-' (不能有空格)。"
          }
        }
      }
    },
    "cli.error.workspaceLoadingInvalidState": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid state '%@'. Expected on or off. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効な状態 '%@' です。on または off を指定してください。%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘못된 상태 '%@'입니다. on 또는 off를 지정하세요. %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неприпустимий стан '%@'. Очікується on або off. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无效的状态 '%@'。应为 on 或 off。%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültiger Zustand „%@“. Erwartet wurde „on“ oder „off“. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "État '%@' non valide. Valeur attendue : on ou off. %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حالة غير صالحة '%@'. المتوقع on أو off. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado '%@' no válido. Se esperaba on u off. %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無效的狀態 '%@'。預期為 on 或 off。%@"
          }
        }
      }
    },
    "cli.error.workspaceLoadingNoWorkspace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No workspace resolved. Run inside a cmux workspace or pass --workspace <id>."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースを特定できませんでした。cmux のワークスペース内で実行するか、--workspace <id> を指定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워크스페이스를 확인할 수 없습니다. cmux 워크스페이스 안에서 실행하거나 --workspace <id>를 지정하세요."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося визначити робочий простір. Запустіть у робочому просторі cmux або передайте --workspace <id>."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未解析到工作区。请在 cmux 工作区内运行，或传入 --workspace <id>。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Arbeitsbereich aufgelöst. Führen Sie den Befehl in einem cmux-Arbeitsbereich aus oder übergeben Sie --workspace <id>."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun espace de travail résolu. Exécutez la commande à l’intérieur d’un espace de travail cmux ou passez --workspace <id>."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم حل أي مساحة عمل. قم بالتشغيل داخل مساحة عمل cmux أو مرر --workspace <id>."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se resolvió ningún espacio de trabajo. Ejecútalo dentro de un espacio de trabajo de cmux o pasa --workspace <id>."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未解析工作區。請在 cmux 工作區內執行，或傳遞 --workspace <id>。"
          }
        }
      }
    },
    "cli.error.workspaceSubcommandRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "workspace requires a subcommand. Try: list, create, env, close, rename, select, status, reconnect, disconnect, loading, group"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "workspace にはサブコマンドが必要です。利用可能: list, create, env, close, rename, select, status, reconnect, disconnect, loading, group"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "workspace에는 하위 명령이 필요합니다. 사용 가능: list, create, env, close, rename, select, status, reconnect, disconnect, loading, group"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "workspace потребує підкоманди. Доступні: list, create, env, close, rename, select, status, reconnect, disconnect, loading, group"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "workspace 需要一个子命令。可尝试：list、create、env、close、rename、select、status、reconnect、disconnect、loading、group"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
