    "settings.mobile.port.apply.saved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved. The pairing listener will use port %lld when iOS Pairing is on."
          }
        },
        "ja": {
