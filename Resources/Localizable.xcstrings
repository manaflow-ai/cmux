    "cli.vpn.status.pinned": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned up by `cmux vpn up`; run `cmux vpn down` to release."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`cmux vpn up` により接続が固定されています。解除するには `cmux vpn down` を実行してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angeheftet durch `cmux vpn up`; führen Sie `cmux vpn down` aus, um freizugeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Épinglé par `cmux vpn up` ; exécutez `cmux vpn down` pour le libérer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثبت بواسطة `cmux vpn up`؛ قم بتشغيل `cmux vpn down` للإلغاء."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anclado activo por `cmux vpn up`; ejecute `cmux vpn down` para liberarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已由 `cmux vpn up` 固定啟用；執行 `cmux vpn down` 以釋放。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 `cmux vpn up` 保持开启；运行 `cmux vpn down` 释放。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`cmux vpn up`에 의해 연결 상태가 고정됨; 해제하려면 `cmux vpn down`을 실행하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pinnet opp av `cmux vpn up`; kjør `cmux vpn down` for å frigjøre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Закреплён командой `cmux vpn up`; выполните `cmux vpn down` для отключения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`cmux vpn up` tarafından sabitlendi; serbest bırakmak için `cmux vpn down` çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Закріплено командою `cmux vpn up`; виконайте `cmux vpn down` для звільнення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã ghim bởi `cmux vpn up`; chạy `cmux vpn down` để giải phóng."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pinned ឡើងដោយ `cmux vpn up`; run `cmux vpn down` ដើម្បីបញ្ចេញ។"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ค้างไว้โดย `cmux vpn up`; รัน `cmux vpn down` เพื่อยกเลิก"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fastgjort af `cmux vpn up`; kør `cmux vpn down` for at frigive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Attivato da `cmux vpn up`; esegui `cmux vpn down` per rilasciare."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przypięty przez `cmux vpn up`; uruchom `cmux vpn down`, aby zwolnić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fixado por `cmux vpn up`; execute `cmux vpn down` para liberar."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prikvačeno pomoću `cmux vpn up`; pokrenite `cmux vpn down` za otpuštanje."
          }
        }
      }
    },
