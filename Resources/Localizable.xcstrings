    "settings.automation.cursor.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks must be installed with `cmux hooks cursor install`. They no-op outside cmux terminals."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フックは`cmux hooks cursor install`でインストールする必要があります。cmuxターミナル外では動作しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`cmux hooks cursor install`로 훅을 설치해야 합니다. cmux 터미널 외부에서는 작동하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须用 `cmux hooks cursor install` 安装钩子。它们在 cmux 终端之外不生效。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks müssen mit `cmux hooks cursor install` installiert werden. Sie haben außerhalb von cmux-Terminals keine Funktion (no-op)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les hooks doivent être installés avec `cmux hooks cursor install`. Ils n’ont aucun effet en dehors des terminaux cmux."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب تثبيت الخطافات باستخدام `cmux hooks cursor install`. وهي لا تؤدي أي وظيفة خارج طرفيات cmux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ganchos se deben instalar con `cmux hooks cursor install`. No realizan ninguna operación fuera de las terminales de cmux."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必須透過 `cmux hooks cursor install` 安裝 Hook。它們在 cmux 終端機外不會執行任何操作。"
          }
        }
      }
    },
