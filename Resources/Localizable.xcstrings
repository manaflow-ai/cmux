          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Valider JSON- eller JSONC-filen, kjør cmux reload-config, og kontroller det resulterende inngangspunktet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zwaliduj JSON lub JSONC, uruchom cmux reload-config i sprawdź wynikowy punkt wejścia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Valide o JSON ou JSONC, execute cmux reload-config e verifique o ponto de entrada resultante."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Проверьте JSON или JSONC, выполните cmux reload-config и проверьте результирующую точку входа."
