          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los títulos largos de espacios de trabajo pueden usar tantas líneas como necesiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les titres longs des espaces de travail peuvent utiliser autant de lignes que nécessaire."
