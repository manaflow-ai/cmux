    "account.signIn.loading.waitingSlow.instructions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in window is taking longer than expected. You can reopen or copy the same secure link without restarting."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインウインドウに時間がかかっています。最初からやり直さずに、同じ安全なリンクをもう一度開くかコピーできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录窗口耗时超出预期。你可以重新打开或复制同一个安全链接，无需重新开始。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Anmeldefenster benötigt länger als erwartet. Sie können denselben sicheren Link erneut öffnen oder kopieren, ohne neu zu starten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fenêtre de connexion prend plus de temps que prévu. Vous pouvez rouvrir ou copier le même lien sécurisé sans recommencer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستغرق نافذة تسجيل الدخول وقتًا أطول من المتوقع. يمكنك إعادة فتح الرابط الآمن نفسه أو نسخه دون إعادة التشغيل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ventana de inicio de sesión está tardando más de lo esperado. Puedes volver a abrir o copiar el mismo enlace seguro sin reiniciar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入視窗的回應時間比預期長。您可以重新開啟或複製相同的安全連結，而無須重新開始。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 창을 여는 데 예상보다 오랜 시간이 걸리고 있습니다. 재시작하지 않고 동일한 보안 링크를 다시 열거나 복사할 수 있습니다."
          }
        }
      }
    },
