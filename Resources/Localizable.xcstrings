          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie można bezpiecznie odrzucić danych wejściowych terminalu SSH."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A entrada do terminal SSH não pôde ser descartada com segurança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось безопасно сбросить ввод SSH-терминала."
          }
        },
        "th": {
