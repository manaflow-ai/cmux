    "cli.vm.run.poolRecordFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "vm run: provisioned %1$@ but could not record it in the pool store, so later runs will not reuse it. Use `cmux vm run --machine %1$@` to keep using it or `cmux vm rm %1$@` to remove it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "vm run: %1$@ を作成しましたが、プールに記録できなかったため、今後の実行では再利用されません。引き続き使用するには `cmux vm run --machine %1$@`、削除するには `cmux vm rm %1$@` を実行してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "vm run: %1$@ bereitgestellt, konnte jedoch nicht im Pool-Speicher erfasst werden, sodass spätere Durchläufe es nicht wiederverwenden. Verwenden Sie `cmux vm run --machine %1$@`, um es weiter zu verwenden, oder `cmux vm rm %1$@`, um es zu entfernen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "vm run : %1$@ a été provisionné mais n'a pas pu être enregistré dans le magasin du pool, de sorte que les exécutions ultérieures ne le réutiliseront pas. Utilisez `cmux vm run --machine %1$@` pour continuer à l'utiliser ou `cmux vm rm %1$@` pour le supprimer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "vm run: تم تخصيص %1$@ ولكن تعذر تسجيله في مخزن المجموعة، لذا لن تعيد عمليات التشغيل اللاحقة استخدامه. استخدم `cmux vm run --machine %1$@` للاستمرار في استخدامه أو `cmux vm rm %1$@` لإزالته."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "vm run: se aprovisionó %1$@ pero no se pudo registrar en el almacén de pool, por lo que las ejecuciones posteriores no lo reutilizarán. Use `cmux vm run --machine %1$@` para seguir usándolo o `cmux vm rm %1$@` para eliminarlo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "vm run: 已预配 %1$@，但无法将其记录在池存储中，因此后续的运行将无法复用它。请使用 `cmux vm run --machine %1$@` 继续使用它，或者使用 `cmux vm rm %1$@` 将其删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "vm run：已配置 %1$@ 但無法將其記錄在池儲存庫中，因此後續的執行將無法重複使用。使用 `cmux vm run --machine %1$@` 以繼續使用，或使用 `cmux vm rm %1$@` 將其移除。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "vm run: %1$@을(를) 프로비저닝했으나 풀 저장소에 기록하지 못했습니다. 따라서 향후 실행 시 이를 재사용하지 않습니다. 계속 사용하려면 `cmux vm run --machine %1$@`을(를) 사용하고, 제거하려면 `cmux vm rm %1$@`을(를) 사용하십시오."
          }
        }
      }
    },
