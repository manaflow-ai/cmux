    "browser.automation.error.recovered": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف سطح المتصفح عن الاستجابة وتمت استعادته. أعد محاولة الأمر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Površina preglednika prestala je odgovarati i oporavljena je. Pokušajte naredbu ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Browserfladen holdt op med at svare og blev gendannet. Prøv kommandoen igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Browseroberfläche reagierte nicht mehr und wurde wiederhergestellt. Versuche den Befehl erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The browser surface stopped responding and was recovered. Retry the command."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La superficie del navegador dejó de responder y se recuperó. Vuelve a intentar el comando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La surface du navigateur ne répondait plus et a été restaurée. Réessayez la commande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La superficie del browser ha smesso di rispondere ed è stata ripristinata. Riprova il comando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザサーフェスが応答しなくなったため復旧しました。コマンドを再試行してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្ទៃកម្មវិធីរុករកបានឈប់ឆ្លើយតប ហើយត្រូវបានស្ដារឡើងវិញ។ សូមសាកល្បងពាក្យបញ្ជាម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 화면이 응답하지 않아 복구되었습니다. 명령을 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettleserflaten sluttet å svare og ble gjenopprettet. Prøv kommandoen på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powierzchnia przeglądarki przestała odpowiadać i została odzyskana. Ponów polecenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A superfície do navegador parou de responder e foi recuperada. Tente o comando novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поверхность браузера перестала отвечать и была восстановлена. Повторите команду."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นผิวเบราว์เซอร์หยุดตอบสนองและได้รับการกู้คืนแล้ว โปรดลองใช้คำสั่งอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcı yüzeyi yanıt vermeyi durdurdu ve kurtarıldı. Komutu yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поверхня браузера перестала відповідати та була відновлена. Повторіть команду."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器表面停止响应，现已恢复。请重试该命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽器介面停止回應，現已復原。請重試該命令。"
          }
        }
      }
    },
