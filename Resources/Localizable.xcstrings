    "settings.networking.custom.secret.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The secret stays in this device's secure storage and never syncs with your account."
          }
        },
        "ja": {
          "stringUnit": {
