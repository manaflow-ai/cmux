    "simulator.failure.cameraAuthorizationIdentifier": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera authorization readback rejected an invalid device or bundle identifier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ権限の読み取りで、無効なデバイスまたはバンドル識別子が拒否されました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头授权回读拒绝了无效的设备或包标识符。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zurücklesen der Kameraberechtigung hat einen ungültigen Geräte- oder Bundle-Identifier zurückgewiesen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La relecture de l’autorisation de l’appareil photo a rejeté un identifiant d’appareil ou de bundle invalide."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفضت قراءة ترخيص الكاميرا معرف جهاز أو معرف حزمة غير صالح."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lectura de la autorización de la cámara rechazó un identificador de dispositivo o de bundle no válido."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機授權讀回拒絕了無效的裝置或 Bundle Identifier。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 권한 되읽기에서 유효하지 않은 기기 또는 번들 식별자를 거부했습니다."
          }
        }
      }
    },
