    "cloudTunnel.error.cloudMachinesOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud Machines is turned off. Turn it on in Settings › Beta Features, then retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドマシンはオフになっています。設定 › ベータ機能でオンにしてから、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
