    "cli.vm.tui.protocolMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-tui protocol mismatch: client %1$@ speaks protocol %2$d, the machine daemon %3$@ speaks protocol %4$d. %5$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-tui のプロトコルが一致しません: クライアント %1$@ はプロトコル %2$d、マシンのデーモン %3$@ はプロトコル %4$d です。%5$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-tui 协议不匹配：客户端 %1$@ 使用协议 %2$d，机器守护进程 %3$@ 使用协议 %4$d。%5$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-tui-Protokollkonflikt: Client %1$@ spricht Protokoll %2$d, der Maschinen-Daemon %3$@ spricht Protokoll %4$d. %5$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Incompatibilité de protocole cmux-tui : le client %1$@ utilise le protocole %2$d, le démon de la machine %3$@ utilise le protocole %4$d. %5$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدم تطابق بروتوكول cmux-tui: العميل %1$@ يتحدث بروتوكول %2$d، بينما برنامج الخلفية للجهاز %3$@ يتحدث بروتوكول %4$d. %5$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incompatibilidad de protocolo cmux-tui: el cliente %1$@ habla el protocolo %2$d, el demonio de la máquina %3$@ habla el protocolo %4$d. %5$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-tui 協定不符：用戶端 %1$@ 使用協定 %2$d，而機器精靈程序 %3$@ 使用協定 %4$d。%5$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-tui 프로토콜 불일치: 클라이언트 %1$@은(는) 프로토콜 %2$d을(를) 사용하지만 가상 머신 데몬 %3$@은(는) 프로토콜 %4$d을(를) 사용합니다. %5$@"
          }
        }
      }
    },
    "cli.vm.tui.staleClient": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update cmux (its bundled cmux-tui client is older than the machine's daemon)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux を更新してください（同梱の cmux-tui クライアントがマシンのデーモンより古いです）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请更新 cmux（它内置的 cmux-tui 客户端比机器上的守护进程旧）。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren Sie cmux (der mitgelieferte cmux-tui-Client ist älter als der Daemon der Maschine)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour cmux (son client cmux-tui intégré est plus ancien que le démon de la machine)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتحديث cmux (عميل cmux-tui المدمج فيه أقدم من برنامج الخلفية للجهاز)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza cmux (su cliente cmux-tui integrado es más antiguo que el demonio de la máquina)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請更新 cmux（其隨附的 cmux-tui 用戶端版本比機器的精靈程序舊）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux를 업데이트하십시오 (기본 내장된 cmux-tui 클라이언트가 가상 머신의 데몬보다 오래되었습니다)."
          }
        }
      }
    },
    "cli.vm.tui.staleDaemon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The machine's cmux-tui daemon is older than this client; reconnect once the machine has updated."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンの cmux-tui デーモンがこのクライアントより古いです。マシンが更新されてから再接続してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机器上的 cmux-tui 守护进程比此客户端旧；请等机器更新后再连接。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der cmux-tui-Daemon der Maschine ist älter als dieser Client; verbinden Sie sich erneut, sobald die Maschine aktualisiert wurde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le démon cmux-tui de la machine est plus ancien que ce client ; reconnectez-vous une fois la machine mise à jour."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامج الخلفية cmux-tui للجهاز أقدم من هذا العميل؛ أعد الاتصال بمجرد تحديث الجهاز."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El demonio cmux-tui de la máquina es más antiguo que este cliente; reconéctate una vez que la máquina se haya actualizado."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "機器的 cmux-tui 精靈程序版本比此用戶端舊；請在機器更新後重新連線。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가상 머신의 cmux-tui 데몬이 이 클라이언트보다 오래되었습니다. 가상 머신이 업데이트된 후 다시 연결하십시오."
          }
        }
      }
    },
