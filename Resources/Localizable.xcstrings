    "settings.mobile.phonePush.forwarding.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops this Mac from sending local agent alerts to mobile devices."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac からモバイルデバイスへのローカルエージェント通知の送信を停止します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让这台 Mac 不再把本机的代理提醒发送到移动设备。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert, dass dieser Mac lokale Agenten-Warnungen an Mobilgeräte sendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche ce Mac d’envoyer des alertes d’agent local aux appareils mobiles."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمنع جهاز Mac هذا من إرسال تنبيهات الوكيل المحلي إلى الأجهزة المحمولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita que esta Mac envíe alertas de agentes locales a dispositivos móviles."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止由此 Mac 傳送本地代理程式警示至行動裝置。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 모바일 기기로 로컬 에이전트 경고를 보내지 않도록 설정합니다."
          }
        }
      }
    },
    "settings.mobile.phonePush.forwarding.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends local agent alerts from this Mac to cmux on your iPhone and iPad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac のローカルエージェント通知を iPhone や iPad の cmux に送信します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把这台 Mac 上的本机代理提醒发送到你 iPhone 和 iPad 上的 cmux。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet lokale Agenten-Warnungen von diesem Mac an cmux auf Ihrem iPhone und iPad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie les alertes d’agent local de ce Mac vers cmux sur votre iPhone et iPad."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل تنبيهات الوكيل المحلي من جهاز Mac هذا إلى cmux على جهاز iPhone وiPad الخاص بك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía alertas de agentes locales desde esta Mac a cmux en tu iPhone y iPad."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自此 Mac 傳送本地代理程式警示至您 iPhone 和 iPad 上的 cmux。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 로컬 에이전트 경고를 iPhone 및 iPad의 cmux로 보냅니다."
          }
        }
      }
    },
