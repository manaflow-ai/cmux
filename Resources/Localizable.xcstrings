          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向後與向前瀏覽會在窗格、標籤頁和工作區之間巡覽聚焦變更。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분할 창, 탭 및 작업 공간 간에 포커스 변경 사항을 뒤로 및 앞으로 탐색합니다."
          }
        }
      }
    },
