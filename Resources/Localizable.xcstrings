    "cli.socket.error.conflictingEnvironment": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refusing to choose socket: CMUX_SOCKET_PATH and CMUX_SOCKET differ. Use CMUX_SOCKET_PATH or unset CMUX_SOCKET."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソケットを選択できません。CMUX_SOCKET_PATH と CMUX_SOCKET が異なります。CMUX_SOCKET_PATH を使うか、CMUX_SOCKET を解除してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝选择套接字：CMUX_SOCKET_PATH 与 CMUX_SOCKET 不一致。请使用 CMUX_SOCKET_PATH，或取消设置 CMUX_SOCKET。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auswahl des Sockets abgelehnt: CMUX_SOCKET_PATH und CMUX_SOCKET unterscheiden sich. Verwenden Sie CMUX_SOCKET_PATH oder heben Sie die Definition von CMUX_SOCKET auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Refus de choisir le socket : CMUX_SOCKET_PATH et CMUX_SOCKET diffèrent. Utilisez CMUX_SOCKET_PATH ou désactivez CMUX_SOCKET."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض اختيار المقبس: CMUX_SOCKET_PATH وCMUX_SOCKET مختلفان. استخدم CMUX_SOCKET_PATH أو قم بإلغاء تعيين CMUX_SOCKET."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se rechazó la elección de socket: CMUX_SOCKET_PATH y CMUX_SOCKET difieren. Usa CMUX_SOCKET_PATH o desactiva CMUX_SOCKET."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拒絕選擇 Socket：CMUX_SOCKET_PATH 與 CMUX_SOCKET 不同。請使用 CMUX_SOCKET_PATH 或取消設定 CMUX_SOCKET。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소켓 선택 거부: CMUX_SOCKET_PATH와 CMUX_SOCKET이 다릅니다. CMUX_SOCKET_PATH를 사용하거나 CMUX_SOCKET 설정을 해제하세요."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odbijam odabir socketa: CMUX_SOCKET_PATH i CMUX_SOCKET se razlikuju. Koristite CMUX_SOCKET_PATH ili uklonite CMUX_SOCKET."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Afviser at vælge socket: CMUX_SOCKET_PATH og CMUX_SOCKET er forskellige. Brug CMUX_SOCKET_PATH eller fjern CMUX_SOCKET."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile scegliere il socket: CMUX_SOCKET_PATH e CMUX_SOCKET sono in conflitto. Usa CMUX_SOCKET_PATH oppure rimuovi CMUX_SOCKET."
          }
        },
        "km": {
          "stringUnit": {
