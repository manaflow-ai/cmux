          }
        }
      }
    },
    "customSidebarRenderer.inProcess.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renders as native SwiftUI inside cmux with hover, focus, and typing. A faulty sidebar shares the app process."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 内でネイティブ SwiftUI として描画し、ホバー・フォーカス・入力に対応します。サイドバーに問題があるとアプリプロセスに影響します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 cmux 内以原生 SwiftUI 渲染，支持悬停、聚焦和输入。有问题的侧边栏会与应用共用同一进程。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird als natives SwiftUI in cmux mit Hover, Fokus und Eingabe gerendert. Eine fehlerhafte Seitenleiste teilt sich den App-Prozess."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’affiche sous forme de SwiftUI native dans cmux avec survol, ciblage et saisie. Une barre latérale défectueuse partage le processus de l’application."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تقديمه كـ SwiftUI أصلي داخل cmux مع ميزات التحويم والتركيز والكتابة. الشريط الجانبي المعيب يشارك نفس عملية التطبيق."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se procesa como SwiftUI nativo dentro de cmux con soporte para pasar el cursor, enfocar y escribir. Una barra lateral defectuosa comparte el proceso de la aplicación."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 cmux 內轉譯為原生 SwiftUI，支援懸停、聚焦與輸入。有問題的側邊欄會共用應用程式程序。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스 호버, 포커스, 타이핑을 지원하며 cmux 내부에서 네이티브 SwiftUI로 렌더링됩니다. 결함이 있는 사이드바는 앱 프로세스를 공유합니다."
          }
        }
      }
    },
    "customSidebarRenderer.inProcess.name": {
      "extractionState": "manual",
      "localizations": {
