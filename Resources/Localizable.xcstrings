    "settings.browser.defaultZoomLevel.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom applied to newly opened browser pages. Zoom In, Zoom Out, and Actual Size still adjust each page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しく開いたブラウザページに適用されるズームです。ズームイン・ズームアウト・実際のサイズは引き続き各ページごとに調整できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新打开的浏览器页面所用的缩放比例。放大、缩小和实际大小仍可单独调整每个页面。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom, der auf neu geöffnete Browserseiten angewendet wird. Vergrößern, Verkleinern und tatsächliche Größe passen weiterhin jede Seite einzeln an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom appliqué aux pages de navigateur nouvellement ouvertes. Zoom avant, Zoom arrière et Taille réelle ajustent toujours chaque page."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تطبيق التكبير على صفحات المتصفح المفتوحة حديثًا. لا يزال تكبير الصفحة وتصغيرها والحجم الفعلي يضبط كل صفحة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom aplicado a las páginas del navegador recién abiertas. Acercar, Alejar y Tamaño real todavía ajustan cada página."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "套用至新開啟瀏覽器網頁的縮放比例。「放大」、「縮小」與「實際大小」仍可調整各個網頁。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로 열린 브라우저 페이지에 적용되는 확대/축소 비율입니다. 확대, 축소 및 실제 크기 메뉴를 사용하여 각 페이지를 수동으로 조정할 수도 있습니다."
          }
        }
      }
    },
