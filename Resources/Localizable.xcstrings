    "cli.restore.notice.routedLauncherUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: this session was started through the routed launcher '%@', which is not on PATH. Resuming the agent directly instead."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: このセッションはルーティングされたランチャー「%@」経由で開始されましたが、PATH にありません。代わりにエージェントを直接再開します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "restore：此会话是通过路由启动器“%@”启动的，但它不在 PATH 中。将改为直接恢复该代理。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: Diese Sitzung wurde über den weitergeleiteten Launcher „%@“ gestartet, der nicht im PATH liegt. Der Agent wird stattdessen direkt fortgesetzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "restore : cette session a été lancée via le lanceur routé « %@ », qui est introuvable dans le PATH. Reprise directe de l'agent à la place."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: بدأت هذه الجلسة عبر المشغّل الموجَّه '%@'، وهو غير موجود في PATH. سيتم استئناف الوكيل مباشرةً بدلاً من ذلك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: esta sesión se inició mediante el lanzador enrutado '%@', que no está en el PATH. Se reanudará el agente directamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "restore：此工作階段是透過路由啟動器「%@」啟動的，但它不在 PATH 中。將改為直接繼續該代理程式。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 이 세션은 라우팅된 런처 '%@'를 통해 시작되었지만 PATH에 없습니다. 대신 에이전트를 직접 재개합니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: ova sesija je pokrenuta kroz usmjereni pokretač '%@', koji nije na PATH. Umjesto toga, agent se nastavlja direktno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: denne session blev startet via den rutede launcher '%@', som ikke er på PATH. Genoptager agenten direkte i stedet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: questa sessione è stata avviata tramite il launcher instradato '%@', che non è nel PATH. Ripresa dell'agente direttamente."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: session នេះត្រូវបានចាប់ផ្តើមតាម routed launcher '%@' ដែលមិននៅ PATH។ កំពុង resume agent ដោយផ្ទាល់ជំនួសវិញ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: denne økten ble startet via den rutede launcheren '%@', som ikke er på PATH. Gjenopptar agenten direkte i stedet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: ta sesja została uruchomiona przez routed launcher '%@', który nie jest w PATH. Wznawianie agenta bezpośrednio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: esta sessão foi iniciada pelo launcher roteado '%@', que não está no PATH. Retomando o agente diretamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: эта сессия была запущена через routed launcher '%@', которого нет в PATH. Агент будет возобновлён напрямую."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: session นี้เริ่มต้นผ่าน routed launcher '%@' ซึ่งไม่อยู่ใน PATH กำลังกู้คืน agent โดยตรงแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: bu oturum PATH'te bulunmayan yönlendirilmiş başlatıcı '%@' aracılığıyla başlatıldı. Bunun yerine ajan doğrudan devam ettiriliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: цю сесію було запущено через маршрутизований лаунчер '%@', якого немає в PATH. Замість цього агент запускається безпосередньо."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "restore: phiên này được khởi động qua routed launcher '%@', launcher đó không có trên PATH. Đang tiếp tục agent trực tiếp thay thế."
          }
        }
      }
    },
    "cli.focus.defaultHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default: focus when run interactively, stay in the background when run by an agent or script."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定: 対話的に実行した場合はフォーカスし、エージェントやスクリプトから実行した場合はバックグラウンドのままにします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard: bei interaktiver Ausführung fokussieren, bei Ausführung durch einen Agenten oder ein Skript im Hintergrund bleiben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut : prend le focus en exécution interactive, reste en arrière-plan quand un agent ou un script l’exécute."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الافتراضي: التركيز عند التشغيل التفاعلي، والبقاء في الخلفية عند التشغيل بواسطة وكيل أو برنامج نصي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Predeterminado: enfoca al ejecutarse de forma interactiva y se queda en segundo plano cuando lo ejecuta un agente o un script."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設：互動執行時取得焦點；由代理程式或指令稿執行時保持在背景。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认：交互式运行时获得焦点；由代理或脚本运行时保持在后台。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값: 대화형으로 실행하면 포커스를 가져오고, 에이전트나 스크립트가 실행하면 백그라운드에 머뭅니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Podrazumijevano: fokusira se pri interaktivnom pokretanju, ostaje u pozadini kada ga pokrene agent ili skripta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Standard: fokusér ved interaktiv kørsel, bliv i baggrunden ved kørsel af en agent eller et script."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Predefinito: porta in primo piano se eseguito in modo interattivo, rimane in background se eseguito da un agente o script."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "លំនាំដើម: focus នៅពេលដំណើរការ interactively, ស្នាក់ background នៅពេលដំណើរការដោយ agent ឬ script។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Standard: ta fokus ved interaktiv kjøring, hold seg i bakgrunnen ved kjøring av agent eller skript."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Domyślnie: fokus przy uruchomieniu interaktywnym, działanie w tle gdy uruchomiony przez agenta lub skrypt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Padrão: trazer para frente ao executar interativamente, permanecer em segundo plano ao executar por agente ou script."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "По умолчанию: фокус при интерактивном запуске, фоновый режим при запуске агентом или скриптом."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ค่าเริ่มต้น: focus เมื่อรันแบบโต้ตอบ อยู่ใน background เมื่อรันโดย agent หรือ script"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Varsayılan: etkileşimli çalıştırıldığında odaklanır, bir ajan veya betik tarafından çalıştırıldığında arka planda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "За замовчуванням: фокусується при інтерактивному запуску, залишається у фоні при запуску агентом або скриптом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mặc định: lấy focus khi chạy tương tác, chạy nền khi được gọi bởi agent hoặc script."
          }
        }
      }
    },
    "cli.help.openFocusFlags": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus:\n  --focus                 Switch to the new workspace\n  --no-focus              Open it in the background"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス:\n  --focus                 新しいワークスペースに切り替えます\n  --no-focus              バックグラウンドで開きます"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus:\n  --focus                 Zum neuen Workspace wechseln\n  --no-focus              Im Hintergrund öffnen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus :\n  --focus                 Bascule vers le nouvel espace de travail\n  --no-focus              L’ouvre en arrière-plan"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التركيز:\n  --focus                 ينتقل إلى مساحة العمل الجديدة\n  --no-focus              يفتحها في الخلفية"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Foco:\n  --focus                 Cambia al nuevo espacio de trabajo\n  --no-focus              Lo abre en segundo plano"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "焦點：\n  --focus                 切換到新的工作區\n  --no-focus              在背景開啟"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "焦点：\n  --focus                 切换到新的工作区\n  --no-focus              在后台打开"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스:\n  --focus                 새 워크스페이스로 전환합니다\n  --no-focus              백그라운드에서 엽니다"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fokus:\n  --focus                 Prebaci na novi radni prostor\n  --no-focus              Otvori ga u pozadini"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fokus:\n  --focus                 Skift til det nye arbejdsområde\n  --no-focus              Åbn det i baggrunden"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Focus:\n  --focus                 Passa al nuovo workspace\n  --no-focus              Aprilo in background"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Focus:\n  --focus                 ប្តូរទៅ workspace ថ្មី\n  --no-focus              បើកនៅ background"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fokus:\n  --focus                 Bytt til det nye arbeidsområdet\n  --no-focus              Åpne det i bakgrunnen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fokus:\n  --focus                 Przełącz na nowy obszar roboczy\n  --no-focus              Otwórz go w tle"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Foco:\n  --focus                 Mudar para o novo workspace\n  --no-focus              Abrir em segundo plano"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Фокус:\n  --focus                 Переключиться на новое рабочее пространство\n  --no-focus              Открыть в фоне"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Focus:\n  --focus                 เปลี่ยนไปยัง workspace ใหม่\n  --no-focus              เปิดใน background"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odak:\n  --focus                 Yeni çalışma alanına geçer\n  --no-focus              Arka planda açar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Фокус:\n  --focus                 Переключитися на новий робочий простір\n  --no-focus              Відкрити у фоні"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Focus:\n  --focus                 Chuyển sang workspace mới\n  --no-focus              Mở trong nền"
          }
        }
      }
    },
    "agent.codex.fork.notice.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux could not identify the new fork session. Start the fork again from the parent pane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux は新しいフォーク セッションを特定できませんでした。親ペインからもう一度フォークしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux konnte die neue Fork-Sitzung nicht erkennen. Starten Sie den Fork erneut im übergeordneten Pane."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux n’a pas pu identifier la nouvelle session forkée. Relancez le fork depuis le volet parent."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على cmux تحديد جلسة التفريع الجديدة. ابدأ التفريع مرة أخرى من الجزء الأصلي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no pudo identificar la nueva sesión bifurcada. Inicia el fork de nuevo desde el panel principal."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 無法識別新的分支工作階段。請從父窗格重新開始分支。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 无法识别新的分支会话。请从父窗格重新开始分支。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 새 포크 세션을 식별하지 못했습니다. 부모 패널에서 포크를 다시 시작하세요."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nije mogao prepoznati novu sesiju račvanja. Ponovo pokrenite račvanje iz nadređenog okna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux kunne ikke identificere den nye forgreningssession. Start forgreningen igen fra forældreruden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux non ha potuto identificare la nuova sessione fork. Avvia di nuovo il fork dal riquadro principale."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux មិនអាចកំណត់អត្តសញ្ញាណសម័យ fork ថ្មីបានទេ។ ចាប់ផ្ដើម fork ម្ដងទៀតពីផ្ទាំងមេ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux kunne ikke identifisere den nye forgreningsøkten. Start forgreningen på nytt fra den overordnede ruten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nie mógł zidentyfikować nowej sesji forka. Uruchom fork ponownie z panelu nadrzędnego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux não conseguiu identificar a nova sessão bifurcada. Inicie o fork novamente no painel principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux не удалось определить новый сеанс форка. Запустите форк снова из родительской панели."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ไม่สามารถระบุเซสชันที่แยกใหม่ได้ เริ่มการแยกอีกครั้งจากบานหน้าต่างหลัก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux yeni fork oturumunu belirleyemedi. Fork'u üst panelden yeniden başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux не вдалося визначити новий сеанс форка. Запустіть форк ще раз із батьківської панелі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux không thể xác định phiên fork mới. Hãy bắt đầu fork lại từ pane cha."
          }
        }
      }
    },
    "agent.codex.fork.notice.parentClearFailed.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux could not safely bind the new fork session. Retry the fork from the parent pane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux は新しいフォーク セッションを安全にバインドできませんでした。親ペインからもう一度フォークしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux konnte die neue Fork-Sitzung nicht sicher binden. Starten Sie den Fork erneut im übergeordneten Pane."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux n’a pas pu lier la nouvelle session forkée en toute sécurité. Relancez le fork depuis le volet parent."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على cmux ربط جلسة التفريع الجديدة بأمان. أعد بدء التفريع من الجزء الأصلي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no pudo vincular de forma segura la nueva sesión bifurcada. Inicia el fork de nuevo desde el panel principal."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 無法安全繫結新的分支工作階段。請從父窗格重新開始分支。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 无法安全绑定新的分支会话。请从父窗格重新开始分支。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 새 포크 세션을 안전하게 연결하지 못했습니다. 부모 패널에서 포크를 다시 시작하세요."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nije mogao sigurno povezati novu sesiju račvanja. Ponovo pokrenite račvanje iz nadređenog okna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux kunne ikke binde den nye forgreningssession sikkert. Start forgreningen igen fra forældreruden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux non ha potuto associare in sicurezza la nuova sessione fork. Avvia di nuovo il fork dal riquadro principale."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux មិនអាចភ្ជាប់សម័យ fork ថ្មីដោយសុវត្ថិភាពបានទេ។ ចាប់ផ្ដើម fork ម្ដងទៀតពីផ្ទាំងមេ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux kunne ikke binde den nye forgreningsøkten på en trygg måte. Start forgreningen på nytt fra den overordnede ruten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nie mógł bezpiecznie powiązać nowej sesji forka. Uruchom fork ponownie z panelu nadrzędnego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux não conseguiu vincular com segurança a nova sessão bifurcada. Inicie o fork novamente no painel principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux не удалось безопасно привязать новый сеанс форка. Запустите форк снова из родительской панели."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ไม่สามารถผูกเซสชันที่แยกใหม่ได้อย่างปลอดภัย เริ่มการแยกอีกครั้งจากบานหน้าต่างหลัก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux yeni fork oturumunu güvenli bir şekilde bağlayamadı. Fork'u üst panelden yeniden başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux не вдалося безпечно прив’язати новий сеанс форка. Запустіть форк ще раз із батьківської панелі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux không thể gắn kết an toàn phiên fork mới. Hãy thử lại fork từ pane cha."
          }
        }
      }
    },
