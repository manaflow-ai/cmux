    "settings.app.hideAllSidebarDetails.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show secondary workspace details as controlled by the toggles below."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下のトグル設定に従って、ワークスペースの補助情報を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 토글에 따라 보조 워크스페이스 세부 정보를 표시합니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати додаткові деталі робочої області відповідно до перемикачів нижче."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下方开关的设置显示工作区次要详细信息。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekundäre Arbeitsbereichsdetails anzeigen, wie durch die folgenden Schalter gesteuert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher les détails secondaires de l’espace de travail comme contrôlé par les options ci-dessous."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض تفاصيل مساحة العمل الثانوية كما هو محدد بواسطة مفاتيح التبديل أدناه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los detalles secundarios del espacio de trabajo según lo controlen los interruptores de abajo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示由下方切換開關控制的次要工作區詳細資訊。"
          }
        }
      }
    },
    "settings.app.hideAllSidebarDetails.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show only the workspace title row. Overrides the detail toggles below."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースのタイトル行だけを表示します。下の詳細トグルより優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워크스페이스 제목 행만 표시합니다. 아래 세부 정보 토글보다 우선합니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати лише рядок заголовка робочої області. Замінює перемикачі деталей нижче."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示工作区标题行。会覆盖下方的详细信息开关。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die Titelleiste des Arbeitsbereichs anzeigen. Setzt die unten stehenden Detail-Schalter außer Kraft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher uniquement la ligne de titre de l’espace de travail. Remplace les options de détail ci-dessous."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار صف عنوان مساحة العمل فقط. يتجاوز مفاتيح تبديل التفاصيل أدناه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra solo la fila de título del espacio de trabajo. Invalida los interruptores de detalle de abajo."
