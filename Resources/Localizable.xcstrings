        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートフィードを読み取れませんでした。後でもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트 피드를 읽을 수 없습니다. 나중에 다시 시도하세요."
