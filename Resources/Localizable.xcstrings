          "stringUnit": {
            "state": "translated",
            "value": "Cookie import into Chromium is not available yet. Open a WebKit browser pane or set WebKit as the default engine and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chromium への Cookie インポートにはまだ対応していません。WebKit ブラウザペインを開くか、既定のエンジンに WebKit を設定して再試行してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Cookie-Import in Chromium ist noch nicht verfügbar. Öffnen Sie einen WebKit-Browser-Bereich oder legen Sie WebKit als Standard-Engine fest und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'importation de cookies dans Chromium n'est pas encore disponible. Ouvrez un volet de navigateur WebKit ou définissez WebKit comme moteur par défaut et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استيراد ملفات تعريف الارتباط إلى Chromium غير متاح بعد. افتح جزء متصفح WebKit أو اضبط WebKit كمحرك افتراضي وحاول مجددًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La importación de cookies en Chromium aún no está disponible. Abra un panel de navegador WebKit o establezca WebKit como motor predeterminado e inténtelo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前尚不支援將 Cookie 匯入 Chromium。請開啟 WebKit 瀏覽器窗格，或將 WebKit 設為預設引擎，然後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚不支持将 Cookie 导入 Chromium。请打开 WebKit 浏览器窗格或将 WebKit 设置为默认引擎，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Chromium으로의 쿠키 가져오기는 아직 지원되지 않습니다. WebKit 브라우저 패인을 열거나 WebKit을 기본 엔진으로 설정한 후 다시 시도하세요."
          }
        }
      }
    },
    "browser.import.warning.chromiumCookiesUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookies were not imported because Chromium uses an isolated cookie store. Select WebKit as the destination engine and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chromium は Cookie ストアを分離しているため、Cookie をインポートしませんでした。宛先エンジンに WebKit を選択して再試行してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookies wurden nicht importiert, da Chromium einen isolierten Cookie-Speicher verwendet. Wählen Sie WebKit als Ziel-Engine und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cookies n'ont pas été importés car Chromium utilise un stockage de cookies isolé. Sélectionnez WebKit comme moteur de destination et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم استيراد ملفات تعريف الارتباط لأن Chromium يستخدم مخزن ملفات تعريف ارتباط معزولاً. حدد WebKit كمحرك وجهة وحاول مجددًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se importaron las cookies porque Chromium utiliza un almacén de cookies aislado. Seleccione WebKit como motor de destino e inténtelo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於 Chromium 使用隔離的 Cookie 儲存庫，因此未匯入 Cookie。請選擇 WebKit 作為目標引擎，然後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于 Chromium 使用隔离的 cookie 存储，Cookie 未被导入。请选择 WebKit 作为目标引擎，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Chromium이 격리된 쿠키 저장소를 사용하므로 쿠키를 가져오지 못했습니다. 대상 엔진으로 WebKit을 선택하고 다시 시도하세요."
          }
        }
      }
    },
