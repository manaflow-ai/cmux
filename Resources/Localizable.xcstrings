    "cli.browser.engine.error.browserOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A browser engine can only be selected when creating a browser pane or surface."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザエンジンを選択できるのはブラウザペインまたはサーフェスの作成時だけです"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Browser-Engine kann nur ausgewählt werden, wenn ein Browser-Bereich oder eine Browser-Oberfläche erstellt wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un moteur de navigateur ne peut être sélectionné que lors de la création d'un volet ou d'une surface de navigateur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن فقط تحديد محرك المتصفح عند إنشاء جزء أو سطح متصفح."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se puede seleccionar un motor de navegador al crear un panel o superficie de navegador."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在建立瀏覽器窗格或介面時，才能選擇瀏覽器引擎。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能在创建浏览器窗格或表面时选择浏览器引擎。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 패인 또는 서피스를 생성할 때만 브라우저 엔진을 선택할 수 있습니다."
          }
        }
      }
    },
    "cli.browser.engine.error.invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
