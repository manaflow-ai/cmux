    "simulator.control.privacyServiceUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The active Xcode does not expose %@ through simctl; cmux will not mutate private TCC or BulletinBoard stores in the host process."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なXcodeはsimctl経由の%@に対応していません。cmuxはホストプロセスから非公開のTCCまたはBulletinBoardストアを変更しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 Xcode 未通过 simctl 暴露 %@；cmux 不会在宿主进程中修改私有的 TCC 或 BulletinBoard 存储。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das aktive Xcode gibt %@ nicht über simctl frei; cmux wird keine privaten TCC- oder BulletinBoard-Speicher im Host-Prozess ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version active de Xcode n'expose pas %@ via simctl ; cmux ne modifiera pas les bases de données privées TCC ou BulletinBoard du processus hôte."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يعرض Xcode النشط %@ عبر simctl؛ لن يقوم cmux بتعديل مخازن TCC أو BulletinBoard الخاصة في العملية المضيفة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Xcode activo no expone %@ a través de simctl; cmux no modificará los almacenes privados de TCC o BulletinBoard en el proceso host."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "作用中的 Xcode 未透過 simctl 揭露 %@；cmux 將不會修改主機程序中的私有 TCC 或 BulletinBoard 儲存庫。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화된 Xcode가 simctl을 통해 %@을(를) 노출하지 않습니다. cmux는 호스트 프로세스의 비공개 TCC 또는 BulletinBoard 저장소를 수정하지 않습니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktivni Xcode ne izlaže %@ putem simctl; cmux neće mijenjati privatne TCC ili BulletinBoard pohrane u host procesu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den aktive Xcode eksponerer ikke %@ via simctl; cmux ændrer ikke private TCC- eller BulletinBoard-lagre i hostprocessen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il Xcode attivo non espone %@ tramite simctl; cmux non modificherà gli archivi privati TCC o BulletinBoard nel processo host."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode ដែលកំពុងប្រើប្រាស់មិនបង្ហាញ %@ តាម simctl ទេ; cmux នឹងមិនកែប្រែ TCC ឯកជន ឬ BulletinBoard store នៅក្នុង host process។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den aktive Xcode eksponerer ikke %@ via simctl; cmux vil ikke endre private TCC- eller BulletinBoard-lagre i vertsprosessen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktywny Xcode nie udostępnia %@ przez simctl; cmux nie zmodyfikuje prywatnych magazynów TCC ani BulletinBoard w procesie hosta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Xcode ativo não expõe %@ via simctl; o cmux não modificará os armazenamentos privados de TCC ou BulletinBoard no processo host."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Активная версия Xcode не предоставляет %@ через simctl; cmux не будет изменять приватные хранилища TCC или BulletinBoard в хост-процессе."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode ที่ใช้งานอยู่ไม่เปิดเผย %@ ผ่าน simctl; cmux จะไม่แก้ไข TCC หรือ BulletinBoard store ส่วนตัวใน host process"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Etkin Xcode, %@ öğesini simctl aracılığıyla sunmuyor; cmux, ana süreçteki özel TCC veya BulletinBoard depolarını değiştirmeyecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Активний Xcode не надає доступ до %@ через simctl; cmux не змінюватиме приватні сховища TCC або BulletinBoard у хост-процесі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode đang hoạt động không cung cấp %@ qua simctl; cmux sẽ không thay đổi kho TCC hoặc BulletinBoard riêng tư trong tiến trình host."
          }
        }
      }
    },
    "simulator.control.statusBarValueOutOfRange": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %1$@ value must be from %2$lld through %3$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の値は%2$lldから%3$lldまでで指定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的值必须在 %2$lld 到 %3$lld 之间。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wert für %1$@ muss zwischen %2$lld und %3$lld liegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La valeur de %1$@ doit être comprise entre %2$lld et %3$lld."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تكون قيمة %1$@ من %2$lld إلى %3$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor de %1$@ debe estar entre %2$lld y %3$lld."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的值必須介於 %2$lld 至 %3$lld 之間。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 값은 %2$lld에서 %3$lld 사이여야 합니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vrijednost %1$@ mora biti od %2$lld do %3$lld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Værdien for %1$@ skal være fra %2$lld til %3$lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il valore %1$@ deve essere compreso tra %2$lld e %3$lld."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "តម្លៃ %1$@ ត្រូវតែចាប់ពី %2$lld ដល់ %3$lld។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@-verdien må være fra %2$lld til %3$lld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wartość %1$@ musi być z zakresu od %2$lld do %3$lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O valor de %1$@ deve ser de %2$lld a %3$lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Значение %1$@ должно быть от %2$lld до %3$lld."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ค่า %1$@ ต้องอยู่ระหว่าง %2$lld ถึง %3$lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ değeri %2$lld ile %3$lld arasında olmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Значення %1$@ має бути від %2$lld до %3$lld."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Giá trị %1$@ phải từ %2$lld đến %3$lld."
          }
        }
      }
    },
    "simulator.control.statusBarValueRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A status bar override needs at least one value."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステータスバーの上書きには1つ以上の値が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态栏覆盖至少需要一个值。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Statusleisten-Überschreibung benötigt mindestens einen Wert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une modification de la barre d’état nécessite au moins une valeur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب تجاوز شريط الحالة قيمة واحدة على الأقل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una anulación de la barra de estado necesita al menos un valor."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "狀態列覆蓋需要至少一個值。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상태 표시줄 재정의에는 최소 하나의 값이 필요합니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nadjačavanje statusne trake zahtijeva najmanje jednu vrijednost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En statuslinjeoverride kræver mindst én værdi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un override della barra di stato richiede almeno un valore."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការជំនួសរបារស្ថានភាពត្រូវការតម្លៃយ៉ាងហោចណាស់មួយ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En statuslinje-overstyring krever minst én verdi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nadpisanie paska stanu wymaga co najmniej jednej wartości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma substituição da barra de status requer pelo menos um valor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для переопределения строки состояния требуется хотя бы одно значение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การแทนที่ status bar ต้องมีอย่างน้อยหนึ่งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Durum çubuğu geçersiz kılması en az bir değer gerektirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для перевизначення рядка стану потрібне принаймні одне значення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ghi đè thanh trạng thái cần ít nhất một giá trị."
          }
        }
      }
    },
