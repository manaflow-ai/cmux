    "simulator.failure.outgoingQueueOverflow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator input exceeded its bounded host queue; held input was released and the worker stopped."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator入力がホストの制限付きキューを超えたため、保持中の入力を解放してワーカーを停止しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟器输入超出了宿主队列上限；已释放暂存的输入，工作进程已停止。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Simulator-Eingabe hat ihre begrenzte Host-Warteschlange überschritten; die gehaltene Eingabe wurde freigegeben und der Worker wurde gestoppt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’entrée du Simulateur a dépassé sa file d’attente d’hôte délimitée ; l’entrée retenue a été libérée et le worker s’est arrêté."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجاوزت مدخلات الـ Simulator قائمة انتظار المضيف المحدودة الخاصة بها؛ وتم تحرير المدخلات المحتجزة وتوقف العامل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La entrada del simulador excedió su cola de host limitada; se liberó la entrada retenida y el worker se detuvo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator 輸入已超過其主機佇列上限；保留的輸入已被釋放，且工作者已停止。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시뮬레이터 입력이 제한된 호스트 대기열을 초과했습니다. 보관된 입력이 해제되고 워커가 중지되었습니다."
          }
        }
      }
    },
    "simulator.failure.permissionBundleIdentifierRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private permission changes require an installed application bundle identifier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非公開の権限を変更するには、インストール済みアプリのバンドル識別子が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改私有权限需要提供已安装应用的包标识符。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Private Berechtigungsänderungen erfordern einen Bundle-Identifier einer installierten Anwendung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications de permissions privées nécessitent un identifiant de bundle d’application installée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب تغييرات الأذونات الخاصة معرف حزمة تطبيق مثبت."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios de permisos privados requieren un identificador de bundle de aplicación instalada."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變更私有權限需要已安裝應用程式的 Bundle Identifier。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 권한 변경에는 설치된 애플리케이션 번들 식별자가 필요합니다."
          }
        }
      }
    },
    "simulator.failure.permissionMutationCapability": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The active Xcode worker did not negotiate a safe adapter for %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なXcodeワーカーは%@用の安全なアダプタに対応していません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 Xcode 工作进程未为 %@ 协商安全适配器。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktive Xcode-Worker hat keinen sicheren Adapter für %@ ausgehandelt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'exécuteur Xcode actif n'a pas négocié d'adaptateur sécurisé pour %@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتفاوض عامل Xcode النشط على محول آمن لـ %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El worker activo de Xcode no negoció un adaptador seguro para %@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "作用中的 Xcode 工作者未針對 %@ 協調安全轉接器。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화된 Xcode 워커가 %@을(를) 위한 안전한 어댑터를 협상하지 못했습니다."
          }
        }
      }
    },
    "simulator.failure.permissionReadbackCapability": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The active Xcode worker did not negotiate permission readback."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なXcodeワーカーは権限状態の読み取りに対応していません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 Xcode 工作进程未协商权限回读能力。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktive Xcode-Worker hat kein Zurücklesen der Berechtigungen ausgehandelt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le worker Xcode actif n’a pas négocié la relecture des permissions."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتفاوض عامل Xcode النشط على قراءة الأذونات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El worker activo de Xcode no negoció la lectura de permisos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "作用中的 Xcode 工作者未協調權限讀回。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화된 Xcode 워커가 권한 되읽기를 협상하지 못했습니다."
          }
        }
      }
    },
    "simulator.failure.permissionResetAllCapability": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset All needs the active Xcode worker's isolated extended-permissions adapter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてをリセットするには、有効なXcodeワーカーの分離された拡張権限アダプタが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「全部重置」需要当前 Xcode 工作进程的隔离扩展权限适配器。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Alles zurücksetzen“ benötigt den isolierten Adapter für erweiterte Berechtigungen des aktiven Xcode-Workers."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Réinitialiser tout » nécessite l’adaptateur de permissions étendues isolé du worker Xcode actif."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب 'إعادة تعيين الكل' محول الأذونات الممتدة المعزول لعامل Xcode النشط."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablecer todo necesita el adaptador aislado de permisos extendidos del worker activo de Xcode."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「重設全部」需要作用中的 Xcode 工作者其隔離的延伸權限轉接器。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 재설정하려면 활성화된 Xcode 워커의 분리된 확장 권한 어댑터가 필요합니다."
          }
        }
      }
    },
    "simulator.failure.permissionUnavailable": {
