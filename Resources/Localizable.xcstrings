    "cloudTree.terminal.badge.detached": {
      "comment": "Terminal has no viewing tab. It may still be running and connected; this does not mean a network disconnection.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "detached"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブなし"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无标签页"
          }
        },
        "de": {
