    "settings.mobile.artifactFolderAccess.subtitleOneLevel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limits iOS to immediate children of referenced or visible folders."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS からのアクセスを、参照された、または表示中のフォルダの直下の項目に制限します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 iOS 限制在被引用或可见文件夹的直接子项范围内。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschränkt iOS auf direkte Unterelemente von referenzierten oder sichtbaren Ordnern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite iOS aux enfants immédiats des dossiers référencés ou visibles."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقيد نظام iOS بالمجلدات الفرعية المباشرة للمجلدات المشار إليها أو المرئية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita iOS a los elementos secundarios inmediatos de las carpetas a las que se hace referencia o que son visibles."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "限制 iOS 僅能存取被參照或可見資料夾的直接子項目。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS를 참조되거나 표시된 폴더의 바로 하위 항목으로만 제한합니다."
          }
        }
      }
    },
    "settings.mobile.artifactFolderAccess.subtitleSubtree": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets iOS browse any item inside a folder referenced by chat or visible in a terminal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットで参照された、またはターミナルに表示されたフォルダ内のすべての項目を iOS から参照できるようにします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 iOS 浏览对话中引用或终端中可见的文件夹内的任意项目。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermöglicht iOS das Durchsuchen aller Elemente in einem Ordner, auf den im Chat verwiesen wird oder der in einem Terminal sichtbar ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à iOS de parcourir n’importe quel élément d’un dossier référencé par chat ou visible dans un terminal."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح لنظام iOS تصفح أي عنصر داخل مجلد تمت الإشارة إليه بواسطة الدردشة أو يظهر في طرفية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite a iOS examinar cualquier elemento dentro de una carpeta a la que se haga referencia en el chat o que sea visible en una terminal."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 iOS 瀏覽由聊天參照或在終端機中可見之資料夾內的所有項目。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 채팅에서 참조되거나 터미널에 표시된 폴더 내부의 모든 항목을 탐색할 수 있도록 허용합니다."
          }
        }
      }
    },
