{
  "sourceLanguage": "en",
  "strings": {
    "cloudTree.attachmentFailure.transportUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the connection is unavailable"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "die Verbindung ist nicht verfügbar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "la connexion est indisponible"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاتصال غير متاح"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "la conexión no está disponible"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線無法使用"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接不可用"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결을 사용할 수 없습니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を利用できません"
          }
        }
      }
    },
    "cloudTree.attachmentFailure.invalidResponse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the machine returned an unusable response"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "der Rechner hat eine unbrauchbare Antwort zurückgegeben"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "la machine a renvoyé une réponse inutilisable"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعاد الجهاز استجابة غير قابلة للاستخدام"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "la máquina devolvió una respuesta que no se puede utilizar"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "機器傳回了無法使用的回應"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机器返回了无法使用的响应"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터가 사용할 수 없는 응답을 반환했습니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンが使用できない応答を返しました"
          }
        }
      }
    },
    "cloudTree.attachmentFailure.rejected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the machine could not attach the terminal"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "der Rechner konnte das Terminal nicht verbinden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "la machine n’a pas pu connecter le terminal"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على الجهاز توصيل الطرفية"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "la máquina no pudo conectar el terminal"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "機器無法連接終端機"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机器无法连接终端"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터가 터미널에 연결하지 못했습니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンがターミナルに接続できませんでした"
          }
        }
      }
    },
    "cloudTree.attachmentFailure.notReady": {
      "extractionState": "manual",
      "localizations": {
