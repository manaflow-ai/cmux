            "value": "ความเข้มของสีโทนที่แสดงบนวัสดุแถบด้านข้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renk tonunun kenar çubuğu materyali üzerinde ne kadar güçlü göründüğü."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наскільки сильно колір відтінку проявляється поверх матеріалу бічної панелі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色调颜色在侧边栏材质上的显示强度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "色調顏色在側邊欄材質上的顯示強度。"
          }
        }
      }
    },
