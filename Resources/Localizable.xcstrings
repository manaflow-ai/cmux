    "browser.dialog.auth.basic.incorrectCredentials": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم المستخدم أو كلمة المرور التي أدخلتها غير صحيحة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Korisničko ime ili lozinka koju ste unijeli nije tačna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det brugernavn eller den adgangskode, du indtastede, er forkert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der eingegebene Benutzername oder das Passwort ist falsch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The username or password you entered is incorrect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre de usuario o la contraseña que ingresaste son incorrectos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom d'utilisateur ou le mot de passe saisi est incorrect."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome utente o la password inseriti non sono corretti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力したユーザー名またはパスワードが正しくありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឈ្មោះអ្នកប្រើ ឬពាក្យសម្ងាត់ដែលអ្នកបានបញ្ចូលមិនត្រឹមត្រូវទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력한 사용자 이름 또는 암호가 올바르지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brukernavnet eller passordet du skrev inn, er feil."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadzona nazwa użytkownika lub hasło są nieprawidłowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome de usuário ou a senha inseridos estão incorretos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введенное имя пользователя или пароль неверны."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อผู้ใช้หรือรหัสผ่านที่คุณป้อนไม่ถูกต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girdiğiniz kullanıcı adı veya parola yanlış."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введене ім’я користувача або пароль неправильні."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你输入的用户名或密码不正确。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你輸入的使用者名稱或密碼不正確。"
          }
        }
      }
    },
    "browser.dialog.auth.basic.messageHost": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب %@ اسم مستخدم وكلمة مرور."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zahtijeva korisničko ime i lozinku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kræver et brugernavn og en adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erfordert einen Benutzernamen und ein Passwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ requires a username and password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ requiere un nombre de usuario y una contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nécessite un nom d'utilisateur et un mot de passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ richiede un nome utente e una password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にアクセスするにはユーザー名とパスワードが必要です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ត្រូវការឈ្មោះអ្នកប្រើ និងពាក្យសម្ងាត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 접근하려면 사용자 이름과 암호가 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ krever et brukernavn og passord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wymaga nazwy użytkownika i hasła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ requer um nome de usuário e uma senha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для %@ требуется имя пользователя и пароль."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ต้องใช้ชื่อผู้ใช้และรหัสผ่าน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kullanıcı adı ve parola gerektiriyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для %@ потрібні ім’я користувача та пароль."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要用户名和密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要使用者名稱和密碼。"
          }
        }
      }
    },
