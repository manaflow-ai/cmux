    "settings.networking.private.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh discovers usable LAN and VPN paths after authenticating the other device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh は相手デバイスを認証した後、利用可能な LAN および VPN 経路を検出します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh 会在认证对方设备后发现可用的局域网和 VPN 路径。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh erkennt nutzbare LAN- und VPN-Pfade nach der Authentifizierung des anderen Geräts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh découvre les chemins LAN et VPN utilisables après avoir authentifié l’autre appareil."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكتشف Iroh مسارات LAN وVPN القابلة للاستخدام بعد مصادقة الجهاز الآخر."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh descubre rutas LAN y VPN utilizables después de autenticar el otro dispositivo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh 會在驗證另一部裝置後，尋找可用的區域網路 (LAN) 與 VPN 路徑。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Iroh는 상대 기기를 인증한 후 사용 가능한 LAN 및 VPN 경로를 발견합니다."
          }
        }
      }
    },
