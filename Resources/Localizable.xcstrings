    "settings.networking.relayOnly.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps Iroh connections to this Mac on cmux relays instead of direct or local-network paths. Applies on the next reconnect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac への Iroh 接続を、直接経路やローカルネットワーク経路ではなく cmux リレー経由に固定します。次回の再接続時に適用されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让到此 Mac 的 Iroh 连接走 cmux 中继，而不是直连或局域网路径。在下次重连时生效。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält Iroh-Verbindungen zu diesem Mac auf cmux-Relays anstatt auf direkten oder lokalen Netzwerkpfaden. Wird beim nächsten Wiederverbinden angewendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintient les connexions Iroh à ce Mac sur les relais cmux au lieu de chemins directs ou de réseau local. S'applique lors de la prochaine reconnexion."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقي اتصالات Iroh بجهاز Mac هذا على مرحلات cmux بدلاً من المسارات المباشرة أو شبكة الاتصال المحلية. يتم تطبيقه عند إعادة الاتصال التالية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene las conexiones de Iroh a esta Mac en retransmisiones de cmux en lugar de rutas directas o de red local. Se aplica en la siguiente reconexión."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將連線至此 Mac 的 Iroh 連線保持在 cmux 中繼上，而非使用直接或本機網路路徑。於下一次重新連線時套用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에 대한 Iroh 연결을 직접 또는 로컬 네트워크 경로 대신 cmux 릴레이로 유지합니다. 다음 재연결 시 적용됩니다."
          }
        }
      }
    },
    "settings.networking.relayPolicy.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux downloads a signed relay catalog. Fleet additions, removals, and regional changes do not require an app update."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux は署名済みリレーカタログを取得します。フリートの追加、削除、リージョン変更にアプリ更新は不要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 会下载经过签名的中继目录。中继集群的增删和区域变更无需更新应用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux lädt einen signierten Relay-Katalog herunter. Flottenhinzufügungen, -entfernungen und regionale Änderungen erfordern kein App-Update."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux télécharge un catalogue de relais signé. Les ajouts, suppressions et modifications régionales de la flotte ne nécessitent pas de mise à jour de l'application."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم cmux بتنزيل كتالوج مرحلات موقع. لا تتطلب إضافات الأسطول وإزالته والتغييرات الإقليمية تحديث التطبيق."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux descarga un catálogo de retransmisión firmado. Las adiciones, eliminaciones y cambios regionales de la flota no requieren una actualización de la aplicación."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 會下載已簽署的中繼型錄。群組新增、移除和區域變更皆不需要更新應用程式。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux는 서명된 릴레이 카탈로그를 다운로드합니다. 플릿 추가, 제거 및 지역 변경 시 앱 업데이트가 필요하지 않습니다."
          }
        }
      }
    },
    "settings.networking.relayPreference": {
      "extractionState": "manual",
      "localizations": {
        "en": {
