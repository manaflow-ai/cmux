    "machines.requiresPro.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account’s plan doesn’t include Cloud machine access. Upgrade to create and reconnect machines."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントのプランでは Cloud マシンを利用できません。アップグレードするとマシンの作成と再接続ができます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户的套餐不含云端机器访问权限。升级后即可创建并重新连接机器。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tarif dieses Accounts enthält keinen Zugriff auf Cloud-Maschinen. Upgrade, um Maschinen zu erstellen und wiederzuverbinden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le forfait de ce compte n’inclut pas l’accès aux machines Cloud. Passez au forfait supérieur pour créer et reconnecter des machines."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتضمن خطة هذا الحساب ميزة الوصول إلى الأجهزة السحابية. قم بالترقية لإنشاء الأجهزة وإعادة الاتصال بها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan de esta cuenta no incluye el acceso a máquinas en la nube. Actualiza para crear y volver a conectar máquinas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳戶的方案不包含雲端機器存取權限。請升級以建立並重新連線機器。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정의 요금제에는 클라우드 머신 액세스가 포함되어 있지 않습니다. 머신을 생성하고 다시 연결하려면 업그레이드하세요."
          }
        }
      }
    },
