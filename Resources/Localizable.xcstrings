          }
        }
      }
    },
    "mobile.chat.error.terminalMoved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent's terminal moved. Open it once on your Mac (or send the agent any prompt there), then retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントのターミナルが移動しました。Macで一度開く（またはそのターミナルでエージェントにプロンプトを送る）してから、再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该代理的终端已移动。请先在你的 Mac 上打开它一次（或在那里给代理发送任意提示），然后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Terminal des Agenten wurde verschoben. Öffnen Sie es einmal auf Ihrem Mac (oder senden Sie dem Agenten dort eine beliebige Eingabeaufforderung) und versuchen Sie es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le terminal de l’agent a été déplacé. Ouvrez-le une fois sur votre Mac (ou envoyez-y une invite à l’agent), puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقلت طرفية الوكيل. افتحها مرة واحدة على جهاز Mac الخاص بك (أو أرسل أي أمر للوكيل هناك)، ثم أعد المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La terminal del agente se movió. Ábrela una vez en tu Mac (o envía cualquier indicación al agente allí), luego vuelve a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理人的終端機已移動。請在 Mac 上開啟它一次（或在該處傳送任何提示詞給代理人），然後重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트의 터미널이 이동했습니다. Mac에서 터미널을 한 번 열거나 해당 터미널에서 에이전트에게 프롬프트를 전송한 후 다시 시도하세요."
          }
        }
      }
    },
    "mobile.chat.error.transcriptNotReadable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac can't find a transcript file for this conversation. If the agent just started in a project folder, send it a prompt and tap Retry. If it's running in your home directory, it doesn't keep a transcript, so use the Terminal tab to interact."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話のトランスクリプトファイルがMacで見つかりません。エージェントをプロジェクトフォルダで起動したばかりなら、プロンプトを送って「再試行」をタップしてください。ホームディレクトリで実行している場合はトランスクリプトが保存されないため、ターミナルタブで操作してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 找不到此对话的记录文件。如果代理刚在某个项目文件夹中启动，请给它发送一条提示，然后点按「重试」。如果它运行在你的主目录中，它不会保留记录，请使用「终端」标签页与它交互。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac kann keine Transkriptdatei für diese Unterhaltung finden. Wenn der Agent gerade erst in einem Projektordner gestartet wurde, senden Sie ihm eine Eingabeaufforderung und tippen Sie auf Erneut versuchen. Wenn er in Ihrem Benutzerverzeichnis ausgeführt wird, führt er kein Transkript. Verwenden Sie daher das Terminal-Tab, um zu interagieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac ne trouve pas de fichier de transcription pour cette conversation. Si l’agent vient de démarrer dans un dossier de projet, envoyez-lui une invite et appuyez sur Réessayer. S’il s’exécute dans votre dossier personnel, il ne conserve pas de transcription, utilisez donc l’onglet Terminal pour interagir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على جهاز Mac العثور على ملف السجل لهذه المحادثة. إذا كان الوكيل قد بدأ للتو في مجلد المشروع، فأرسل له أمرًا واضغط على إعادة المحاولة. وإذا كان يعمل في المجلد الرئيسي الخاص بك، فهو لا يحتفظ بسجل، لذا استخدم علامة تبويب الطرفية للتفاعل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac no puede encontrar un archivo de transcripción para esta conversación. Si el agente acaba de iniciarse en una carpeta de proyecto, envíale una indicación y toca Reintentar. Si se ejecuta en tu directorio de inicio, no guarda transcripciones, así que usa la pestaña Terminal para interactuar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 找不到此對話的紀錄檔案。如果代理人剛在專案資料夾中啟動，請傳送提示詞給它並點擊重試。如果它是在您的家目錄中執行，則不會保留紀錄，請使用「終端機」標籤頁進行互動。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 이 대화의 녹취록 파일을 찾을 수 없습니다. 에이전트가 프로젝트 폴더에서 방금 시작되었다면, 프롬프트를 전송한 후 재시도를 누르세요. 홈 디렉터리에서 실행 중인 경우에는 녹취록을 보관하지 않으므로 '터미널' 탭을 사용하여 상호 작용하세요."
          }
        }
      }
    },
    "mobile.panel.artifact.error.forbidden": {
      "extractionState": "manual",
