    "settings.app.wrapWorkspaceTitles.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى عناوين مساحات العمل في سطر واحد وتُختصر في النهاية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naslovi radnih prostora ostaju u jednom redu i skraćuju se na kraju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbejdsområdetitler vises på én linje og afkortes i slutningen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeitsbereichstitel bleiben in einer Zeile und werden am Ende gekürzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workspace titles stay on one line and truncate at the end."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los títulos de los espacios de trabajo permanecen en una línea y se truncan al final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les titres des espaces de travail restent sur une seule ligne et sont tronqués à la fin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I titoli degli spazi di lavoro restano su una riga e vengono troncati alla fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースタイトルは1行で表示され、末尾で省略されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចំណងជើងកន្លែងធ្វើការនឹងនៅលើបន្ទាត់តែមួយ ហើយត្រូវកាត់ឱ្យខ្លីនៅចុង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워크스페이스 제목은 한 줄로 유지되고 끝에서 잘립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeidsområdetitler vises på én linje og avkortes på slutten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tytuły obszarów roboczych pozostają w jednym wierszu i są ucinane na końcu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os títulos dos espaços de trabalho ficam em uma linha e são truncados no final."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Названия рабочих областей остаются в одной строке и обрезаются в конце."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อเวิร์กสเปซจะแสดงในบรรทัดเดียวและถูกตัดท้าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışma alanı başlıkları tek satırda kalır ve sonunda kısaltılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назви робочих областей залишаються в одному рядку й обрізаються в кінці."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作区标题保持一行显示，并在末尾截断。"
