        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はマシン上ですでに終了しています。"
          }
        }
      }
    },
    "cloudPane.layoutSyncFailed.ambiguous": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pane does not identify a unique machine tab. Reopen it from the machine workspace."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このペインに対応するマシンのタブを一意に特定できません。マシンのワークスペースから開き直してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Pane identifiziert keinen eindeutigen Maschinen-Tab. Öffnen Sie es erneut aus dem Maschinen-Workspace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le volet n'identifie pas un onglet de machine unique. Rouvrez-le depuis l'espace de travail de la machine."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحدد الجزء علامة تبويب فريدة للجهاز. أعد فتحه من مساحة عمل الجهاز."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El panel no identifica una pestaña única de la máquina. Vuélvalo a abrir desde el espacio de trabajo de la máquina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此窗格未标识唯一的机器标签页。请从机器工作区中重新打开它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此窗格無法識別唯一的機器頁籤。請從機器工作區重新開啟。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 창이 고유한 머신 탭을 식별하지 못합니다. 머신 작업 공간에서 다시 열어 주십시오."
          }
        }
      }
    },
    "cloudPane.layoutSyncFailed.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your local pane change was kept, but the machine layout could not be synchronized. Reopen the machine workspace to see its current layout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルのペインへの変更は保持されましたが、マシンのレイアウトを同期できませんでした。マシンのワークスペースを開き直して、現在のレイアウトを確認してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre lokale Pane-Änderung wurde beibehalten, aber das Maschinen-Layout konnte nicht synchronisiert werden. Öffnen Sie den Maschinen-Workspace erneut, um dessen aktuelles Layout anzuzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification locale de votre volet a été conservée, mais la disposition de la machine n'a pas pu être synchronisée. Rouvrez l'espace de travail de la machine pour voir sa disposition actuelle."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الاحتفاظ بتغيير الجزء المحلي الخاص بك، ولكن تعذر مزامنة مخطط الجهاز. أعد فتح مساحة عمل الجهاز لرؤية مخططه الحالي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservó el cambio de su panel local, pero no se pudo sincronizar el diseño de la máquina. Vuelva a abrir el espacio de trabajo de la máquina para ver su diseño actual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保留您的本地窗格更改，但无法同步机器布局。请重新打开机器工作区以查看其当前布局。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已保留您的本機窗格變更，但無法同步機器版面配置。請重新開啟機器工作區以查看其目前的版面配置。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 창 변경 사항은 유지되었으나 머신 레이아웃을 동기화할 수 없습니다. 현재 레이아웃을 보려면 머신 작업 공간을 다시 열어 주십시오."
          }
        }
      }
    },
