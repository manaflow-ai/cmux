    "sourceControl.empty.noWorkspace.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a workspace in a Git repository to see changes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を表示するには、Git リポジトリのワークスペースを開いてください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح مساحة عمل في مستودع Git لرؤية التغييرات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite radni prostor u Git spremištu da biste vidjeli promjene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn et arbejdsområde i et Git-lager for at se ændringer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie einen Arbeitsbereich in einem Git-Repository, um Änderungen anzuzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un espacio de trabajo en un repositorio Git para ver los cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez un espace de travail dans un dépôt Git pour voir les modifications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri un workspace in un repository Git per visualizzare le modifiche."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បើក workspace ក្នុងឃ្លាំង Git ដើម្បីមើលការផ្លាស់ប្តូរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 보려면 Git 저장소의 작업 공간을 여세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne et arbeidsområde i et Git-repositorium for å se endringer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz obszar roboczy w repozytorium Git, aby zobaczyć zmiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um workspace em um repositório Git para ver as alterações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте рабочую область в репозитории Git, чтобы увидеть изменения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดเวิร์กสเปซในที่เก็บ Git เพื่อดูการเปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikleri görmek için bir Git deposunda çalışma alanı açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте робочу область у Git-репозиторії, щоб переглянути зміни."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Git 仓库中打开工作区即可查看更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Git 儲存庫中開啟工作區即可查看變更。"
          }
        }
      }
    },
