    "settings.terminal.resumeCommands.invalidPrefix": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid shell-style command prefix."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なシェル形式のコマンドプレフィックスを入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效的 shell 风格命令前缀。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie ein gültiges Befehlspräfix im Shell-Stil ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un préfixe de commande de type shell valide."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل بادئة أمر صالحة بنمط shell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un prefijo de comando válido estilo shell."
          }
        },
        "zh-Hant": {
