        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 없거나 오디오로 디코딩할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen mangler eller kan ikke dekodes som lyd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brakuje pliku lub nie można go zdekodować jako dźwięku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo está ausente ou não pode ser decodificado como áudio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл отсутствует или не может быть декодирован как аудио."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบไฟล์หรือไม่สามารถถอดรหัสเป็นเสียงได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya eksik veya ses olarak çözümlenemiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл відсутній або його не можна декодувати як аудіо."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件缺失或无法解码为音频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
