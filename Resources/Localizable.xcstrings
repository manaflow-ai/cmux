    "commandPalette.description.workspaceInputHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Enter to save. Press Shift-Enter for a new line, or Escape to cancel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter で保存します。Shift-Enter で改行、Escape でキャンセルします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter를 눌러 저장하세요. Shift-Enter로 줄바꿈, Escape로 취소합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 Enter 保存。按 Shift-Enter 换行，或按 Escape 取消。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingabetaste zum Speichern drücken. Umschalt-Eingabetaste für eine neue Zeile oder Esc-Taste zum Abbrechen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur Entrée pour enregistrer. Appuyez sur Maj-Entrée pour une nouvelle ligne, ou Échap pour annuler."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على Enter للحفظ. واضغط على Shift-Enter لسطر جديد، أو Escape للإلغاء."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presiona Enter para guardar. Presiona Shift-Enter para una nueva línea o Escape para cancelar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按 Enter 儲存。按 Shift-Enter 換行，或按 Escape 取消。"
          }
        }
      }
    },
