        "en": { "stringUnit": { "state": "translated", "value": "restore [--surface <id|ref>] <kind> <checkpoint-id> | restore --surface [id|ref]" } },
        "es": { "stringUnit": { "state": "translated", "value": "restore [--surface <id|ref>] <kind> <checkpoint-id> | restore --surface [id|ref]" } },
        "fr": { "stringUnit": { "state": "translated", "value": "restore [--surface <id|ref>] <kind> <checkpoint-id> | restore --surface [id|ref]" } },
        "it": { "stringUnit": { "state": "translated", "value": "restore [--surface <id|ref>] <kind> <checkpoint-id> | restore --surface [id|ref]" } },
        "ja": { "stringUnit": { "state": "translated", "value": "restore [--surface <id|ref>] <kind> <checkpoint-id> | restore --surface [id|ref]" } },
        "km": { "stringUnit": { "state": "translated", "value": "restore [--surface <id|ref>] <kind> <checkpoint-id> | restore --surface [id|ref]" } },
        "ko": { "stringUnit": { "state": "translated", "value": "restore [--surface <id|ref>] <kind> <checkpoint-id> | restore --surface [id|ref]" } },
        "nb": { "stringUnit": { "state": "translated", "value": "restore [--surface <id|ref>] <kind> <checkpoint-id> | restore --surface [id|ref]" } },
        "pl": { "stringUnit": { "state": "translated", "value": "restore [--surface <id|ref>] <kind> <checkpoint-id> | restore --surface [id|ref]" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "restore [--surface <id|ref>] <kind> <checkpoint-id> | restore --surface [id|ref]" } },
        "ru": { "stringUnit": { "state": "translated", "value": "restore [--surface <id|ref>] <kind> <checkpoint-id> | restore --surface [id|ref]" } },
        "th": { "stringUnit": { "state": "translated", "value": "restore [--surface <id|ref>] <kind> <checkpoint-id> | restore --surface [id|ref]" } },
        "tr": { "stringUnit": { "state": "translated", "value": "restore [--surface <id|ref>] <kind> <checkpoint-id> | restore --surface [id|ref]" } },
