            "value": "在產生的或自訂的網域上發佈 VM 連接埠。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성된 도메인 또는 사용자 지정 도메인에 VM 포트를 게시합니다."
          }
        },
        "bs": {
