          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Exibe o uso geral da CLI ou um grupo de comandos focado em tarefa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Показать справку верхнего уровня CLI или одну группу команд по задаче."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
