        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa --remove-generated-anchor solo para un grupo solo de anclaje cuyo anclaje fue creado por cmux."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在僅有錨點的群組且其錨點是由 cmux 建立時，才使用 --remove-generated-anchor。"
