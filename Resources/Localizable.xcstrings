    "cli.vm.tui.protocolMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-tui protocol mismatch: client %1$@ speaks protocol %2$d, the machine daemon %3$@ speaks protocol %4$d. %5$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-tui のプロトコルが一致しません: クライアント %1$@ はプロトコル %2$d、マシンのデーモン %3$@ はプロトコル %4$d です。%5$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-tui 协议不匹配：客户端 %1$@ 使用协议 %2$d，机器守护进程 %3$@ 使用协议 %4$d。%5$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-tui-Protokollkonflikt: Client %1$@ spricht Protokoll %2$d, der Maschinen-Daemon %3$@ spricht Protokoll %4$d. %5$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Incompatibilité de protocole cmux-tui : le client %1$@ utilise le protocole %2$d, le démon de la machine %3$@ utilise le protocole %4$d. %5$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدم تطابق بروتوكول cmux-tui: العميل %1$@ يتحدث بروتوكول %2$d، بينما برنامج الخلفية للجهاز %3$@ يتحدث بروتوكول %4$d. %5$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incompatibilidad de protocolo cmux-tui: el cliente %1$@ habla el protocolo %2$d, el demonio de la máquina %3$@ habla el protocolo %4$d. %5$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-tui 協定不符：用戶端 %1$@ 使用協定 %2$d，而機器精靈程序 %3$@ 使用協定 %4$d。%5$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-tui 프로토콜 불일치: 클라이언트 %1$@은(는) 프로토콜 %2$d을(를) 사용하지만 가상 머신 데몬 %3$@은(는) 프로토콜 %4$d을(를) 사용합니다. %5$@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux-tui protokoluoverensstemmelse: klient %1$@ taler protokol %2$d, maskindæmonen %3$@ taler protokol %4$d. %5$@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux-tui protokollkonflikt: klient %1$@ bruker protokoll %2$d, maskindaemonen %3$@ bruker protokoll %4$d. %5$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Несовместимость протокола cmux-tui: клиент %1$@ использует протокол %2$d, демон машины %3$@ использует протокол %4$d. %5$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Невідповідність протоколу cmux-tui: клієнт %1$@ використовує протокол %2$d, демон машини %3$@ — протокол %4$d. %5$@"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux-tui protocol មិនត្រូវគ្នា: client %1$@ ប្រើ protocol %2$d, daemon ម៉ាស៊ីន %3$@ ប្រើ protocol %4$d។ %5$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux-tui protocol ไม่ตรงกัน: client %1$@ ใช้ protocol %2$d, machine daemon %3$@ ใช้ protocol %4$d %5$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không tương thích giao thức cmux-tui: client %1$@ dùng giao thức %2$d, daemon máy %3$@ dùng giao thức %4$d. %5$@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux-tui neusklađenost protokola: klijent %1$@ koristi protokol %2$d, daemon mašine %3$@ koristi protokol %4$d. %5$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux-tui protokol uyuşmazlığı: istemci %1$@, %2$d protokolünü; makine daemon'ı %3$@, %4$d protokolünü kullanıyor. %5$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mancata corrispondenza del protocollo cmux-tui: il client %1$@ utilizza il protocollo %2$d, il daemon della macchina %3$@ utilizza il protocollo %4$d. %5$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niezgodność protokołu cmux-tui: klient %1$@ używa protokołu %2$d, demon maszyny %3$@ używa protokołu %4$d. %5$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "incompatibilidade de protocolo no cmux-tui: o cliente %1$@ usa o protocolo %2$d, o daemon da máquina %3$@ usa o protocolo %4$d. %5$@"
          }
        }
      }
    },
    "cli.vm.tui.staleClient": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update cmux (its bundled cmux-tui client is older than the machine's daemon)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux を更新してください（同梱の cmux-tui クライアントがマシンのデーモンより古いです）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请更新 cmux（它内置的 cmux-tui 客户端比机器上的守护进程旧）。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
