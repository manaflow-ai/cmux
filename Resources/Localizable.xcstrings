    "account.signIn.browserOpenFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t open your browser. Copy the link and paste it into any browser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザを開けませんでした。リンクをコピーして任意のブラウザに貼り付けてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开浏览器。请复制链接并粘贴到任意浏览器中。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Browser konnte nicht geöffnet werden. Kopieren Sie den Link und fügen Sie ihn in einen beliebigen Browser ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir votre navigateur. Copiez le lien et collez-le dans n’importe quel navigateur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر فتح متصفحك. انسخ الرابط والصقه في أي متصفح."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir su navegador. Copie el enlace y péguelo en cualquier navegador."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟瀏覽器。請複製此連結並貼到任何瀏覽器中。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저를 열 수 없습니다. 링크를 복사하여 아무 브라우저에나 붙여넣으세요."
          }
        }
      }
    },
