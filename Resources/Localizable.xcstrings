          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「新工作區」下拉式功能表和命令面板中顯示 Cloud VM 進入點。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
