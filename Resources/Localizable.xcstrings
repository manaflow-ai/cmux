            "state": "translated",
            "value": "Dieser Arbeitsbereich kann derzeit nicht geschlossen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet espace de travail ne peut pas être fermé pour le moment."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إغلاق مساحة العمل هذه في الوقت الحالي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
