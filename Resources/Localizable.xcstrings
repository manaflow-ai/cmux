    "machines.sessionRejected.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Cloud service no longer accepts this Mac’s saved session. Sign out and sign back in to reconnect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud サービスがこの Mac に保存されたセッションを受け付けなくなりました。サインアウトして再度サインインすると再接続できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端服务不再接受这台 Mac 上保存的会话。请退出登录后重新登录以恢复连接。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Cloud-Dienst akzeptiert die gespeicherte Sitzung dieses Macs nicht mehr. Melde dich ab und wieder an, um die Verbindung wiederherzustellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service Cloud n’accepte plus la session enregistrée de ce Mac. Déconnectez-vous et reconnectez-vous pour rétablir la connexion."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تعد الخدمة السحابية تقبل الجلسة المحفوظة لجهاز Mac هذا. يرجى تسجيل الخروج ثم تسجيل الدخول مرة أخرى لإعادة الاتصال."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio en la nube ya no acepta la sesión guardada de este Mac. Cierra la sesión e inicia sesión de nuevo para volver a conectarte."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲端服務不再接受此 Mac 儲存的工作階段。請登出並重新登入以重新連線。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 서비스에서 더 이상 이 Mac에 저장된 세션을 허용하지 않습니다. 다시 연결하려면 로그아웃한 후 다시 로그인하세요."
          }
        }
      }
    },
    "machines.sessionRejected.title": {
      "extractionState": "manual",
