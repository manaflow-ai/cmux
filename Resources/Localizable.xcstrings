    "settings.mobile.pairDevice.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices signed in to the same account connect automatically. Use this QR only to pair through Tailscale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じアカウントでサインインしているデバイスは自動的に接続されます。このQRはTailscale経由のペアリングにのみ使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录同一账户的设备会自动连接。此二维码仅用于通过 Tailscale 配对。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit demselben Konto angemeldete Geräte verbinden sich automatisch. Verwenden Sie diesen QR-Code nur, um die Kopplung über Tailscale durchzuführen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appareils connectés au même compte se connectent automatiquement. Utilisez ce code QR uniquement pour un jumelage via Tailscale."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتصل الأجهزة التي سجلت الدخول إلى الحساب نفسه تلقائيًا. استخدم رمز QR هذا فقط للاقتران عبر Tailscale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dispositivos con la sesión iniciada en la misma cuenta se conectan automáticamente. Use este QR solo para emparejar a través de Tailscale."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入相同帳戶的裝置會自動連線。僅在使用 Tailscale 配對時才使用此 QR 碼。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동일한 계정에 로그인한 기기는 자동으로 연결됩니다. Tailscale을 통해 페어링하는 경우에만 이 QR을 사용하세요."
          }
        }
      }
    },
