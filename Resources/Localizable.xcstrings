          }
        }
      }
    },
    "featureFlags.proUpgrade.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows Pro upgrade entrypoints in the sidebar, Settings, command palette, and Help menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバー、設定、コマンドパレット、ヘルプメニューにProアップグレードの入口を表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在侧边栏、设置、命令面板和帮助菜单中显示 Pro 升级入口。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Pro-Upgrade-Einstiegspunkte in der Seitenleiste, den Einstellungen, der Befehlspalette und dem Hilfe-Menü."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les points d’entrée de la mise à niveau Pro dans la barre latérale, les Réglages, la palette de commandes et le menu Aide."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض نقاط دخول الترقية إلى Pro في الشريط الجانبي، والإعدادات، ولوحة الأوامر، وقائمة المساعدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los puntos de entrada de actualización a Pro en la barra lateral, Configuración, la paleta de comandos y el menú de Ayuda."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在側邊欄、設定、命令面板及說明功能表中顯示升級 Pro 版的入口。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이드바, 설정, 명령 팔레트 및 도움말 메뉴에 Pro 업그레이드 진입점을 표시합니다."
          }
        }
      }
    },
