          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OK 計畫 工作區=%@ 視窗=%@ 索引=%@"
          }
        }
      }
    },
    "cli.restore.admission.waiting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: waiting for cmux to verify that this agent session is not already running…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: このエージェントセッションがすでに実行中でないことを cmux が確認するのを待っています…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: Warten auf cmux, um zu überprüfen, ob diese Agent-Sitzung nicht bereits ausgeführt wird…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "restore : en attente de cmux pour vérifier que cette session d'agent n'est pas déjà en cours d'exécution…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: في انتظار التحقق من قِبل cmux بأن جلسة الوكيل هذه لا تعمل بالفعل…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: esperando a que cmux verifique que esta sesión de agente no se esté ejecutando ya…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "restore：正在等待 cmux 驗證此代理程式工作階段是否尚未執行…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "restore：正在等待 cmux 验证此代理会话是否尚未运行…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 이 에이전트 세션이 이미 실행 중이 아닌지 cmux가 확인할 때까지 대기 중…"
          }
        }
      }
    },
    "cli.restore.codexCheckpointUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: the saved agent session is unavailable. The terminal remains in its saved directory; retry later or start a new agent session."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 保存されたエージェント セッションを利用できません。ターミナルは保存されたディレクトリに残っています。後でもう一度試すか、新しいエージェント セッションを開始してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 已保存的代理会话不可用。终端仍留在其保存目录中；请稍后重试，或新建一个代理会话。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: Die gespeicherte Agenten-Sitzung ist nicht verfügbar. Das Terminal verbleibt in seinem gespeicherten Verzeichnis; versuchen Sie es später erneut oder starten Sie eine neue Agenten-Sitzung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "restore : la session d'agent enregistrée n'est pas disponible. Le terminal reste dans son répertoire enregistré ; réessayez plus tard ou démarrez une nouvelle session d'agent."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: جلسة الوكيل المحفوظة غير متاحة. تظل الطرفية في دليلها المحفوظ؛ أعد المحاولة لاحقًا أو ابدأ جلسة وكيل جديدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: la sesión del agente guardada no está disponible. La terminal permanece en su directorio guardado; reinténtelo más tarde o inicie una nueva sesión del agente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "restore：儲存的代理程式工作階段無法使用。終端機仍保留在儲存的目錄中；請稍後重試或啟動新的代理程式工作階段。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 저장된 에이전트 세션을 사용할 수 없습니다. 터미널은 저장된 디렉터리에 그대로 유지됩니다. 나중에 다시 시도하거나 새 에이전트 세션을 시작하십시오."
          }
        }
      }
    },
    "cli.restore.error.checkpointMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: this command no longer matches the session. Run 'cmux restore --surface' to use the current record."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: このコマンドは現在のセッションと一致しません。現在の状態を使用するには 'cmux restore --surface' を実行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "restore：此命令与该会话已不匹配。请运行 'cmux restore --surface' 以使用当前记录。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: Dieser Befehl stimmt nicht mehr mit der Sitzung überein. Führen Sie 'cmux restore --surface' aus, um den aktuellen Datensatz zu verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "restore : cette commande ne correspond plus à la session. Exécutez 'cmux restore --surface' pour utiliser l'enregistrement actuel."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: هذا الأمر لم يعد يطابق الجلسة. قم بتشغيل 'cmux restore --surface' لاستخدام السجل الحالي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: este comando ya no coincide con la sesión. Ejecute 'cmux restore --surface' para usar el registro actual."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "restore：此指令已不再與工作階段相符。執行 'cmux restore --surface' 以使用目前的紀錄。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 이 명령이 더 이상 세션과 일치하지 않습니다. 현재 기록을 사용하려면 'cmux restore --surface'를 실행하십시오."
          }
        }
      }
    },
    "cli.restore.error.compatibilityShellFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: the saved process could not be started. Retry the visible restore command."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 保存されたプロセスを開始できませんでした。表示されている復元コマンドを再実行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "restore：无法启动已保存的进程。请重试屏幕上显示的 restore 命令。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: Der gespeicherte Prozess konnte nicht gestartet werden. Wiederholen Sie den sichtbaren restore-Befehl."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "restore : le processus enregistré n'a pas pu être démarré. Réessayez la commande de restauration visible."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: تعذر بدء العملية المحفوظة. أعد محاولة أمر الاستعادة المعروض."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: no se pudo iniciar el proceso guardado. Reintente el comando de restauración visible."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "restore：儲存的程序無法啟動。請重試可見的 restore 指令。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 저장된 프로세스를 시작할 수 없습니다. 표시된 restore 명령을 다시 시도하십시오."
          }
        }
      }
    },
    "cli.restore.error.currentSurfaceUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: the current cmux surface could not be identified. Retry from this terminal or pass --surface <id|ref>."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 現在の cmux サーフェスを特定できませんでした。このターミナルから再試行するか、--surface <id|ref> を指定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "restore：无法识别当前的 cmux 表面。请从此终端重试，或传入 --surface <id|ref>。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: Die aktuelle cmux-Oberfläche konnte nicht identifiziert werden. Versuchen Sie es von diesem Terminal aus erneut oder übergeben Sie --surface <id|ref>."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "restore : la surface d’affichage cmux actuelle n'a pas pu être identifiée. Réessayez depuis ce terminal ou passez --surface <id|ref>."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: تعذر تحديد سطح cmux الحالي. أعد المحاولة من هذه الطرفية أو مرر --surface <id|ref>."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: no se pudo identificar la superficie actual de cmux. Reinténtelo desde esta terminal o pase --surface <id|ref>."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "restore：無法識別目前的 cmux 介面。請在此終端機重試或傳遞 --surface <id|ref>。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 현재 cmux 화면을 식별할 수 없습니다. 이 터미널에서 다시 시도하거나 --surface <id|ref>를 전달하십시오."
          }
        }
      }
    },
    "cli.restore.error.executableNotFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: the saved agent command is unavailable. Make sure the agent is installed, then retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 保存されたエージェントコマンドを利用できません。エージェントがインストールされていることを確認してから、再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "restore：已保存的代理命令不可用。请确认该代理已安装，然后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: Der gespeicherte Agenten-Befehl ist nicht verfügbar. Stellen Sie sicher, dass der Agent installiert ist, und versuchen Sie es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "restore : la commande d'agent enregistrée n'est pas disponible. Assurez-vous que l'agent est installé, puis réessayez."
          }
        },
        "ar": {
