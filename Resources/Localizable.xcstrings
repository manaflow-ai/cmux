    "cli.coderouter.bootstrap.downloadFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not download the CodeRouter installer (curl exited with status %1$d). Retry, or install it with:\n  %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter インストーラーをダウンロードできませんでした (curl の終了ステータス: %1$d)。もう一度お試しいただくか、次のコマンドでインストールしてください:\n  %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der CodeRouter-Installer konnte nicht heruntergeladen werden (curl wurde mit Status %1$d beendet). Versuche es erneut oder installiere es mit:\n  %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de télécharger l'installateur de CodeRouter (curl a quitté avec le statut %1$d). Réessayez, ou installez-le avec :\n  %2$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تنزيل برنامج تثبيت CodeRouter (خرج curl بالحالة %1$d). أعد المحاولة، أو ثبته باستخدام:\n  %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo descargar el instalador de CodeRouter (curl finalizó con el estado %1$d). Reinténtalo o instálalo con:\n  %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法下載 CodeRouter 安裝程式 (curl 結束，狀態碼為 %1$d)。請重試，或使用以下命令安裝：\n  %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法下载 CodeRouter 安装程序 (curl 以状态码 %1$d 退出)。请重试，或使用以下命令安装：\n  %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter 설치 프로그램을 다운로드할 수 없습니다 (curl이 상태 코드 %1$d(으)로 종료됨). 다시 시도하거나 다음 명령어로 설치하십시오:\n  %2$@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nije moguće preuzeti CodeRouter instalacijski program (curl završio sa statusom %1$d). Pokušajte ponovo ili ga instalirajte s:\n  %2$@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kunne ikke downloade CodeRouter-installationsprogrammet (curl afsluttede med statuskode %1$d). Prøv igen, eller installér det med:\n  %2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile scaricare il programma di installazione di CodeRouter (curl è uscito con stato %1$d). Riprova, oppure installalo con:\n  %2$@"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនអាចទាញយក CodeRouter installer បាន (curl បញ្ចប់ដោយ status %1$d)។ ព្យាយាមម្តងទៀត, ឬติดตั้งด้วย:\n  %2$@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kunne ikke laste ned CodeRouter-installasjonsprogrammet (curl avsluttet med status %1$d). Prøv igjen, eller installer det med:\n  %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie można pobrać instalatora CodeRouter (curl zakończył się ze statusem %1$d). Spróbuj ponownie lub zainstaluj za pomocą:\n  %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível baixar o instalador do CodeRouter (curl encerrou com status %1$d). Tente novamente ou instale com:\n  %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось загрузить установщик CodeRouter (curl завершился со статусом %1$d). Повторите попытку или установите вручную:\n  %2$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่สามารถดาวน์โหลดตัวติดตั้ง CodeRouter ได้ (curl ออกด้วยสถานะ %1$d) ลองใหม่ หรือติดตั้งด้วย:\n  %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CodeRouter yükleyicisi indirilemedi (curl %1$d durum koduyla çıktı). Yeniden deneyin veya şununla yükleyin:\n  %2$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
