    "cli.localTmux.error.existingSessionCommand": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "local-tmux session already exists; use attach or close it before supplying a new command"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "local-tmux セッションは既に存在します。新しいコマンドを指定する前に attach または close を使用してください"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "local-tmux-Sitzung existiert bereits; verwenden Sie attach oder schließen Sie sie, bevor Sie einen neuen Befehl angeben"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "la session local-tmux existe déjà ; utilisez attach ou fermez-la avant de fournir une nouvelle commande"
          }
        },
        "ar": {
