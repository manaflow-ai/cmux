      }
    },
    "socket.cloudVM.publication.teamOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ accepts `teamId` only when `accessMode` is team."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で `teamId` を指定できるのは、`accessMode` が team の場合のみです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有当 `accessMode` 为 team 时，%@ 才接受 `teamId`。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ akzeptiert `teamId` nur, wenn `accessMode` „team“ ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'accepte `teamId` que lorsque `accessMode` est team."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقبل %@ المعرّف `teamId` فقط عندما يكون `accessMode` هو team."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ acepta `teamId` solo cuando `accessMode` es team."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅當 `accessMode` 為 team 時，%@ 才接受 `teamId`。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은 `accessMode`가 team인 경우에만 `teamId`를 허용합니다."
          }
        }
      }
    },
