    "statusMenu.profiling.submitTimedOut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail did not finish in time. Stopping the send helper so you can retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mailが時間内に完了しませんでした。再試行できるよう送信ヘルパーを停止しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「邮件」未及时完成。正在停止发送辅助程序，以便你重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail wurde nicht rechtzeitig beendet. Der Sende-Helfer wird gestoppt, damit Sie es erneut versuchen können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application Mail n'a pas terminé à temps. Arrêt de l'assistant d'envoi pour que vous puissiez réessayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم ينتهِ تطبيق البريد (Mail) في الوقت المناسب. يجري إيقاف مساعد الإرسال لتتمكن من إعادة المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail no finalizó a tiempo. Deteniendo el asistente de envío para que pueda volver a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「郵件」未及時完成。正在停止傳送小幫手，以便您重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail 앱이 제시간에 완료되지 않았습니다. 다시 시도할 수 있도록 전송 도우미를 중단합니다."
          }
        }
      }
    },
