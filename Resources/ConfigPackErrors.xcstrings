    "config.pack.error.nestingTooDeep": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pack nesting is too deep."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パックのネストが深すぎます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包嵌套层级过深。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "套件巢狀層級太深。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팩 중첩이 너무 깊습니다."
