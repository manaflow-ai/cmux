    "New $(PRODUCT_NAME) Window Here": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New $(PRODUCT_NAME) Window Here"
          }
        },
        "ja": {
