{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "NSAppBundlesUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running within cmux would like to access the contents of other apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 内で実行中のプログラムがほかのアプリのバンドル内容へのアクセスを求めています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 cmux 中运行的程序想要访问其他应用的内容。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein in cmux ausgeführtes Programm möchte auf die Inhalte anderer Apps zugreifen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programme s’exécutant dans cmux souhaite accéder au contenu d’autres applications."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرغب برنامج يعمل داخل cmux في الوصول إلى محتويات تطبيقات أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programa que se ejecuta dentro de cmux desea acceder al contenido de otras aplicaciones."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 cmux 中執行的程式想要存取其他應用程式的內容。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 내에서 실행 중인 프로그램이 다른 앱의 콘텐츠에 접근하려고 합니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Program pokrenut u cmux-u želi pristupiti sadržaju drugih aplikacija."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et program, der kører i cmux, vil gerne have adgang til indholdet af andre apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un programma in esecuzione in cmux vorrebbe accedere al contenuto di altre app."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កម្មវិធីដែលកំពុងដំណើរការក្នុង cmux ចង់ចូលប្រើមាតិការបស់កម្មវិធីផ្សេងទៀត។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et program som kjører i cmux, vil ha tilgang til innholdet i andre apper."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Program działający w cmux chce uzyskać dostęp do zawartości innych aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um programa em execução no cmux gostaria de acessar o conteúdo de outros apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Программа, запущенная в cmux, запрашивает доступ к содержимому других приложений."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โปรแกรมที่ทำงานภายใน cmux ต้องการเข้าถึงเนื้อหาของแอปอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux içinde çalışan bir program diğer uygulamaların içeriğine erişmek istiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Програма, запущена в cmux, хоче отримати доступ до вмісту інших програм."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Một chương trình đang chạy trong cmux muốn truy cập nội dung của các ứng dụng khác."
          }
        }
      }
    },
