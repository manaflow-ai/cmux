    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running within cmux would like to use Bluetooth to discover passkeys and security keys."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 内で実行中のプログラムが、パスキーとセキュリティキーを検出するために Bluetooth の使用を求めています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 cmux 中运行的程序想要使用蓝牙来发现通行密钥和安全密钥。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein in cmux ausgeführtes Programm möchte Bluetooth verwenden, um Passkeys und Sicherheitsschlüssel zu finden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programme s’exécutant dans cmux souhaite utiliser le Bluetooth pour découvrir des clés d’accès et des clés de sécurité."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرغب برنامج يعمل داخل cmux في استخدام بلوتوث لاكتشاف مفاتيح المرور ومفاتيح الأمان."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programa que se ejecuta dentro de cmux desea utilizar Bluetooth para detectar llaves de acceso y llaves de seguridad."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 cmux 中執行的程式想要使用藍牙來偵測通行金鑰與安全性金鑰。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 내에서 실행 중인 프로그램이 패스키 및 보안 키를 탐색하기 위해 Bluetooth를 사용하려고 합니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Program pokrenut u cmux-u želi koristiti Bluetooth za otkrivanje pristupnih ključeva i sigurnosnih ključeva."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et program, der kører i cmux, vil gerne bruge Bluetooth til at finde adgangsnøgler og sikkerhedsnøgler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un programma in esecuzione in cmux vorrebbe usare il Bluetooth per rilevare passkey e chiavi di sicurezza."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កម្មវិធីដែលកំពុងដំណើរការក្នុង cmux ចង់ប្រើ Bluetooth ដើម្បីរកមើល passkey និងកូនសោសុវត្ថិភាព។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et program som kjører i cmux, vil bruke Bluetooth til å finne tilgangsnøkler og sikkerhetsnøkler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Program działający w cmux chce używać Bluetooth do wykrywania kluczy dostępu i kluczy bezpieczeństwa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um programa em execução no cmux gostaria de usar o Bluetooth para descobrir chaves-senha e chaves de segurança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Программа, запущенная в cmux, запрашивает доступ к Bluetooth для поиска ключей входа и ключей безопасности."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โปรแกรมที่ทำงานภายใน cmux ต้องการใช้บลูทูธเพื่อค้นหาพาสคีย์และกุญแจความปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux içinde çalışan bir program geçiş anahtarlarını ve güvenlik anahtarlarını bulmak için Bluetooth kullanmak istiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Програма, запущена в cmux, хоче використовувати Bluetooth для пошуку ключів доступу та ключів безпеки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Một chương trình đang chạy trong cmux muốn sử dụng Bluetooth để tìm mã khóa và khóa bảo mật."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
