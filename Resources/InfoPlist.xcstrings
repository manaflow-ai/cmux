    "NSSystemExtensionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux installs a network extension so this Mac can reach your Cloud machines on their private network. It runs only while you use cmux Cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux はこの Mac からプライベートネットワーク上のクラウドマシンに到達できるように、ネットワーク機能拡張をインストールします。機能拡張は cmux Cloud を使用している間だけ動作します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 会安装一个网络扩展，让这台 Mac 能够通过专用网络访问您的云端机器。它仅在您使用 cmux Cloud 期间运行。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux installiert eine Netzwerkerweiterung, damit dieser Mac Ihre Cloud-Maschinen in deren privatem Netzwerk erreichen kann. Sie wird nur ausgeführt, während Sie cmux Cloud verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux installe une extension réseau afin que ce Mac puisse accéder à vos machines Cloud sur leur réseau privé. Elle ne s’exécute que lorsque vous utilisez cmux Cloud."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم cmux بتثبيت امتداد شبكة ليتمكن جهاز Mac هذا من الوصول إلى أجهزة السحابة الخاصة بك على شبكتها الخاصة. يعمل هذا الامتداد فقط أثناء استخدامك لـ cmux Cloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux instala una extensión de red para que este Mac pueda conectarse a tus máquinas Cloud en su red privada. Solo se ejecuta mientras usas cmux Cloud."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 會安裝網路延伸功能，以便此 Mac 可透過私人網路連線至您的 Cloud 虛擬主機。此功能僅在您使用 cmux Cloud 時執行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux는 이 Mac이 사설 네트워크의 Cloud 머신에 연결할 수 있도록 네트워크 확장을 설치합니다. 이 확장은 cmux Cloud를 사용하는 동안에만 실행됩니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux instalira mrežnu ekstenziju kako bi ovaj Mac mogao dosegnuti vaše Cloud mašine na njihovoj privatnoj mreži. Radi samo dok koristite cmux Cloud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux installerer en netværksudvidelse, så denne Mac kan nå dine Cloud-maskiner på deres private netværk. Den kører kun, mens du bruger cmux Cloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux installa un’estensione di rete per permettere a questo Mac di raggiungere le tue macchine Cloud sulla loro rete privata. È attiva solo mentre usi cmux Cloud."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux ដំឡើងផ្នែកបន្ថែមបណ្ដាញ ដើម្បីឲ្យ Mac នេះអាចភ្ជាប់ទៅម៉ាស៊ីន Cloud របស់អ្នកនៅលើបណ្ដាញឯកជនរបស់វា។ វាដំណើរការតែពេលអ្នកប្រើ cmux Cloud ប៉ុណ្ណោះ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux installerer en nettverksutvidelse slik at denne Macen kan nå Cloud-maskinene dine på deres private nettverk. Den kjører bare mens du bruker cmux Cloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux instaluje rozszerzenie sieciowe, aby ten Mac mógł łączyć się z Twoimi maszynami Cloud w ich sieci prywatnej. Działa tylko podczas korzystania z cmux Cloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cmux instala uma extensão de rede para que este Mac alcance suas máquinas Cloud na rede privada delas. Ela só é executada enquanto você usa o cmux Cloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux устанавливает сетевое расширение, чтобы этот Mac мог подключаться к вашим машинам Cloud в их частной сети. Оно работает, только пока вы используете cmux Cloud."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux ติดตั้งส่วนขยายเครือข่ายเพื่อให้ Mac เครื่องนี้เข้าถึงเครื่อง Cloud ของคุณบนเครือข่ายส่วนตัวได้ ส่วนขยายนี้ทำงานเฉพาะขณะที่คุณใช้ cmux Cloud"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux, bu Mac’in Cloud makinelerinize özel ağları üzerinden ulaşabilmesi için bir ağ uzantısı yükler. Yalnızca cmux Cloud’u kullanırken çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux встановлює мережеве розширення, щоб цей Mac міг звертатися до ваших машин Cloud у їхній приватній мережі. Воно працює лише під час використання cmux Cloud."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux cài đặt một tiện ích mở rộng mạng để máy Mac này có thể truy cập các máy Cloud trên mạng riêng của chúng. Tiện ích chỉ chạy khi bạn dùng cmux Cloud."
          }
        }
      }
    },
