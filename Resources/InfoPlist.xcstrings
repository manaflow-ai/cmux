{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "NSAppBundlesUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running within cmux would like to access the contents of other apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 内で実行中のプログラムがほかのアプリのバンドル内容へのアクセスを求めています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 cmux 中运行的程序想要访问其他应用的内容。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein in cmux ausgeführtes Programm möchte auf die Inhalte anderer Apps zugreifen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programme s’exécutant dans cmux souhaite accéder au contenu d’autres applications."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرغب برنامج يعمل داخل cmux في الوصول إلى محتويات تطبيقات أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programa que se ejecuta dentro de cmux desea acceder al contenido de otras aplicaciones."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 cmux 中執行的程式想要存取其他應用程式的內容。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 내에서 실행 중인 프로그램이 다른 앱의 콘텐츠에 접근하려고 합니다."
          }
        }
      }
    },
    "NSAppDataUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running within cmux would like to access data from other apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 内で実行中のプログラムがほかのアプリのデータへのアクセスを求めています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 cmux 中运行的程序想要访问其他应用的数据。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein in cmux ausgeführtes Programm möchte auf Daten von anderen Apps zugreifen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programme s’exécutant dans cmux souhaite accéder aux données d’autres applications."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرغب برنامج يعمل داخل cmux في الوصول إلى بيانات من تطبيقات أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programa que se ejecuta dentro de cmux desea acceder a datos de otras aplicaciones."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 cmux 中執行的程式想要存取其他應用程式的資料。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 내에서 실행 중인 프로그램이 다른 앱의 데이터에 접근하려고 합니다."
          }
        }
      }
    },
    "NSAppleEventsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
