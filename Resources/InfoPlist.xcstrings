        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 내에서 실행 중인 프로그램이 AppleScript를 사용하려고 합니다."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running within cmux would like to use Bluetooth to discover passkeys and security keys."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 内で実行中のプログラムが、パスキーとセキュリティキーを検出するために Bluetooth の使用を求めています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 cmux 中运行的程序想要使用蓝牙来发现通行密钥和安全密钥。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein in cmux ausgeführtes Programm möchte Bluetooth verwenden, um Passkeys und Sicherheitsschlüssel zu finden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programme s’exécutant dans cmux souhaite utiliser le Bluetooth pour découvrir des clés d’accès et des clés de sécurité."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرغب برنامج يعمل داخل cmux في استخدام بلوتوث لاكتشاف مفاتيح المرور ومفاتيح الأمان."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programa que se ejecuta dentro de cmux desea utilizar Bluetooth para detectar llaves de acceso y llaves de seguridad."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 cmux 中執行的程式想要使用藍牙來偵測通行金鑰與安全性金鑰。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 내에서 실행 중인 프로그램이 패스키 및 보안 키를 탐색하기 위해 Bluetooth를 사용하려고 합니다."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running within cmux would like to read and write your calendars."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 内で実行中のプログラムがカレンダーの読み書きへのアクセスを求めています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 cmux 中运行的程序想要读取和写入您的日历。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein in cmux ausgeführtes Programm möchte Ihre Kalender lesen und beschreiben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programme s’exécutant dans cmux souhaite lire et écrire dans vos calendriers."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرغب برنامج يعمل داخل cmux في قراءة التقاويم الخاصة بك والكتابة فيها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programa que se ejecuta dentro de cmux desea leer y escribir en tus calendarios."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 cmux 中執行的程式想要讀取和寫入您的行事曆。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 내에서 실행 중인 프로그램이 캘린더를 읽고 쓰려고 합니다."
          }
        }
      }
    },
    "NSCalendarsWriteOnlyAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
