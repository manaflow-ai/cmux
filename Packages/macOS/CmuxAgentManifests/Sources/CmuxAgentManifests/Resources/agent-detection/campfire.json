{
  "schemaVersion": 1,
  "id": "campfire",
  "displayName": "Campfire",
  "process": {
    "matchers": [
      { "id": "native", "processNames": ["campfire"] },
      { "id": "javascript-entrypoint", "processNames": ["bun", "node", "deno", "tsx", "ts-node"], "argvContainsAny": ["packages/session/bin/campfire.ts", "packages/session/dist/campfire"] }
    ]
  },
  "states": [
    { "id": "permission-prompt", "state": "permission-prompt", "screenRegex": ["(?i)\\b(?:allow|approve|approval|confirm)\\b[^\\n]{0,120}(?:\\?|\\b(?:yes|no|y/n|request|permission|command|tool|action)\\b)|\\bpermission\\b[^\\n]{0,120}(?:\\?|\\b(?:needed|required|request|prompt|grant|run|execute|tool|command|action)\\b)"] },
    { "id": "blocked", "state": "blocked", "screenRegex": ["\\b(?:wait(?:ing)?|awaiting)\\s+(?:for\\s+)?(?:input|answer|response|reply)\\b|\\bneeds?\\s+(?:input|answer|response|reply)\\b|\\b(?:error|failed|failure|exception)\\b|\\b(?:question|choose|select|confirm)\\b[^\\n]*\\?"] },
    { "id": "done", "state": "done", "screenRegex": ["\\b(done|complete(?:d)?|finish(?:ed)?|succeed(?:ed)?|success)\\b"] },
    { "id": "working", "state": "working", "screenRegex": ["[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏]", "\\b(working|running|thinking)\\b"] },
    { "id": "idle", "state": "idle", "screenRegex": ["\\b(?:idle|ready|prompt)\\b"] }
  ],
  "session": {
    "sessionIdSource": "--session",
    "resumeCommand": "{{executable}} --session {{sessionId}}",
    "cwd": "preserve",
    "sessionDirectory": "~/.campfire/agent/sessions"
  },
  "restorableWhen": {
    "environmentEquals": { "CAMPFIRE_SESSION_ROLE": "host" }
  }
}
