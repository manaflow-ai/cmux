{
  "schemaVersion": 1,
  "id": "grok",
  "displayName": "Grok",
  "process": {
    "matchers": [
      { "id": "primary", "processNames": ["grok", "grok-macos-aarch64", "grok-macos-aarch"] },
      { "id": "legacy-agent-alias", "processNames": ["agent"], "processPathContains": ["/.grok/"] }
    ]
  },
  "states": [
    {
      "id": "permission-prompt",
      "state": "permission-prompt",
      "screenContains": ["Browser authorization"],
      "screenRegex": [
        "(?im)^[ \\t]*+(?:waiting|awaiting)[ \\t]++for[ \\t]++(?:approval|authorization|authorisation)\\b[^\\n]{0,240}$",
        "(?im)^[ \\t]*(?:allow|approve|confirm|deny)[^\\n]{0,120}\\?$",
        "(?im)^[ \\t]*(?:do you|would you|should we)[^\\n]{0,120}\\b(?:allow|approve|authorize|authorise|confirm)\\b[^\\n]{0,120}\\?$"
      ]
    },
    {
      "id": "blocked",
      "state": "blocked",
      "screenRegex": [
        "(?im)^[ \\t]*+(?:waiting|wait|awaiting)[ \\t]++for[ \\t]++(?:input|answer|response|reply)\\b[ \\t]*+$",
        "(?im)^[ \\t]*+(?:waiting|wait|awaiting)[ \\t]++(?:input|answer|response|reply)\\b[ \\t]*+$",
        "(?im)^[ \\t]*+(?:need|needs|needed|require|requires|required)[ \\t]++(?:your[ \\t]++)?(?:input|answer|response|reply)\\b[ \\t]*+$",
        "(?im)^[ \\t]*+(?:error|failed|failure|exception)\\b[^\\n]{0,240}$"
      ]
    },
    {
      "id": "done",
      "state": "done",
      "screenRegex": [
        "(?im)^[ \\t]*+(?:done|complete|completed|finish|finished|succeed|succeeded|success)\\b[.!]?[ \\t]*+$",
        "(?im)^[ \\t]*+[✓✔☑][ \\t]++(?:done|complete|completed|finish|finished|succeed|succeeded|success)\\b[.!]?[ \\t]*+$",
        "(?im)^[ \\t]*+(?:task|turn|request)[ \\t]++(?:complete|completed|finish|finished|succeed|succeeded)\\b[.!]?[ \\t]*+$",
        "(?im)^[ \\t]*+[✓✔☑][ \\t]++(?:task|turn|request)[ \\t]++(?:complete|completed|finish|finished|succeed|succeeded)\\b[.!]?[ \\t]*+$"
      ]
    },
    { "id": "working", "state": "working", "screenRegex": ["[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏]"] },
    {
      "id": "idle",
      "state": "idle",
      "screenRegex": [
        "(?m)^[ \\t]*+>[ \\t]*+$",
        "(?m)^[ \\t]*+[│┃|][ \\t]*+❯[^\\n]{0,240}[│┃|][ \\t]*+\\r?$"
      ]
    }
  ],
  "session": {
    "sessionIdSource": "grokSessionDirectory",
    "resumeCommand": "{{executable}} -r {{sessionId}}",
    "cwd": "preserve",
    "sessionDirectory": "~/.grok/sessions"
  }
}
