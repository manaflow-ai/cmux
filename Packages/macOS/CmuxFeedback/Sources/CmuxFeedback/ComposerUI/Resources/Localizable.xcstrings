    "sidebar.help.feedback.totalImagesTooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These images are too large to send together. Remove a few and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの画像はまとめて送信するには大きすぎます。いくつか削除してもう一度お試しください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці зображення занадто великі для надсилання разом. Видаліть кілька та спробуйте ще раз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지가 너무 커서 함께 보낼 수 없습니다. 몇 개를 제거하고 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Bilder sind zu groß, um sie zusammen zu senden. Entfernen Sie einige und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces images sont trop volumineuses pour être envoyées ensemble. Supprimez-en quelques-unes et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الصور كبيرة جداً ليتم إرسالها معاً. يرجى إزالة بعضها والمحاولة مجدداً."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas imágenes son demasiado grandes para enviarse juntas. Elimina algunas e inténtalo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些圖片過大，無法同時傳送。請移除幾張圖片後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些图片过大，无法一同发送。请移除部分图片后重试。"
          }
        }
      }
    },
