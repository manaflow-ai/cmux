    "sidebar.help.feedback.attachmentsHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to 10 images."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像は最大10枚まで添付できます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До 10 зображень."
          }
        },
