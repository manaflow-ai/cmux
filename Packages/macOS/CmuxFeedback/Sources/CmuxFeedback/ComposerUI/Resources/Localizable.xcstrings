    "sidebar.help.feedback.connectionError": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't send feedback. Check your connection and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードバックを送信できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося надіслати відгук. Перевірте підключення та спробуйте ще раз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피드백을 보내지 못했습니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback konnte nicht gesendet werden. Überprüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’envoyer les commentaires. Vérifiez votre connexion et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إرسال الملاحظات. تحقق من اتصالك وحاول مجدداً."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron enviar los comentarios. Comprueba la conexión e inténtalo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法傳送意見反應。請檢查您的連線並重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法发送反馈。请检查您的网络连接并重试。"
          }
        }
      }
    },
