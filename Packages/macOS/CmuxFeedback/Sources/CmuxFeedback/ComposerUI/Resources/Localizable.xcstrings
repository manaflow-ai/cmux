          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Feedback-Versuche. Bitte versuchen Sie es später noch einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de tentatives d’envoi de commentaires. Veuillez réessayer plus tard."
