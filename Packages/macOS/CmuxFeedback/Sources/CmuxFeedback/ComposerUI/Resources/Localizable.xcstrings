        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاولات إرسال ملاحظات كثيرة جداً. يرجى المحاولة مرة أخرى لاحقاً."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos de envío. Inténtalo de nuevo más tarde."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嘗試傳送意見反應的次數過多。請稍後重試。"
