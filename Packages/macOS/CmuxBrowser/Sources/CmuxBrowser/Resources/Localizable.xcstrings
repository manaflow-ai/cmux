    "browser.chromium.pageGone.outOfMemoryMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try closing other tabs or programs to free up memory."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie andere Tabs oder Programme, um Arbeitsspeicher freizugeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez de fermer d’autres onglets ou programmes pour libérer de la mémoire."
          }
