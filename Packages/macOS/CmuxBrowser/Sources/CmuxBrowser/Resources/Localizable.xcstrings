    },
    "browser.chromium.cdp.invalidEndpoint": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Invalid CDP endpoint" } },
        "ja": { "stringUnit": { "state": "translated", "value": "CDPエンドポイントが無効です" } }
