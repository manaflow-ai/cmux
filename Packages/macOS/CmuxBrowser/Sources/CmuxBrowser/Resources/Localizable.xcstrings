{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "diffViewer.error.allowlistTooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diff viewer allowlist is too large"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "差分ビューアの許可リストが大きすぎます"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diff-Viewer-Erlaubnisliste ist zu groß"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste d’autorisation du visualiseur de diff est trop grande"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قائمة عارض الفروق المسموحة كبيرة جداً"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de permitidos del visor de diferencias es demasiado grande"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Diff 檢視器允許清單過大"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diff 查看器白名单过大"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Diff 뷰어 허용 목록이 너무 큽니다"
          }
        }
      }
    },
    "diffViewer.error.duplicateEntry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicate diff viewer allowlist entry"
