    "browser.chromium.cdp.protocolError": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Browser communication failed" } },
        "ja": { "stringUnit": { "state": "translated", "value": "ブラウザ通信に失敗しました" } }
      }
