{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "settings.browser.engine.webkit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WebKit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WebKit"
          }
        }
      }
    },
    "settings.browser.engine.chromium": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chromium"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chromium"
          }
        }
      }
    },
    "browser.chromium.cdp.invalidEndpoint": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Invalid CDP endpoint" } },
        "ja": { "stringUnit": { "state": "translated", "value": "CDPエンドポイントが無効です" } }
      }
    },
    "browser.chromium.cdp.portUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "CDP port %lld is unavailable on loopback" } },
        "ja": { "stringUnit": { "state": "translated", "value": "CDPポート%lldはループバックで使用できません" } }
      }
    },
    "browser.chromium.cdp.notConnected": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "CDP is not connected" } },
        "ja": { "stringUnit": { "state": "translated", "value": "CDPに接続されていません" } }
      }
    },
    "browser.chromium.cdp.disconnected": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "CDP disconnected: %@" } },
        "ja": { "stringUnit": { "state": "translated", "value": "CDP接続が切断されました: %@" } }
      }
    },
    "browser.chromium.cdp.protocolError": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "CDP protocol error: %@" } },
        "ja": { "stringUnit": { "state": "translated", "value": "CDPプロトコルエラー: %@" } }
      }
    },
    "browser.chromium.cdp.malformedMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Malformed CDP message" } },
        "ja": { "stringUnit": { "state": "translated", "value": "CDPメッセージが不正です" } }
      }
    },
    "browser.chromium.runtime.executableNotFound": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The managed Chromium runtime is not installed" } },
        "ja": { "stringUnit": { "state": "translated", "value": "管理対象のChromiumランタイムがインストールされていません" } }
      }
    },
    "browser.chromium.runtime.unsupportedPlatform": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The managed Chromium runtime is unavailable for this Mac" } },
        "ja": { "stringUnit": { "state": "translated", "value": "このMacでは管理対象のChromiumランタイムを利用できません" } }
      }
    },
    "browser.chromium.runtime.invalidArchive": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The Chromium runtime archive is invalid" } },
        "ja": { "stringUnit": { "state": "translated", "value": "Chromiumランタイムのアーカイブが無効です" } }
      }
    },
    "browser.chromium.runtime.downloadFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Chromium runtime download failed: %@" } },
        "ja": { "stringUnit": { "state": "translated", "value": "Chromiumランタイムのダウンロードに失敗しました: %@" } }
      }
    },
    "browser.chromium.runtime.checksumMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Chromium runtime checksum mismatch (expected %@, got %@)" } },
        "ja": { "stringUnit": { "state": "translated", "value": "Chromiumランタイムのチェックサムが一致しません（期待値 %@、実際 %@）" } }
      }
    },
    "browser.chromium.runtime.extractionFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Chromium runtime extraction failed: %@" } },
        "ja": { "stringUnit": { "state": "translated", "value": "Chromiumランタイムの展開に失敗しました: %@" } }
      }
    },
    "browser.chromium.storage.applicationSupportUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Chromium storage is unavailable in Application Support" } },
        "ja": { "stringUnit": { "state": "translated", "value": "Application SupportでChromiumストレージを利用できません" } }
      }
    },
    "browser.engine.error.invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "--engine requires webkit or chromium" } },
        "ja": { "stringUnit": { "state": "translated", "value": "--engineにはwebkitまたはchromiumを指定してください" } }
      }
    },
    "browser.engine.error.browserOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "--engine is only supported when creating a browser pane or surface" } },
        "ja": { "stringUnit": { "state": "translated", "value": "--engineはブラウザペインまたはサーフェスの作成時のみ指定できます" } }
      }
    },
    "browser.chromium.automation.noJavaScriptValue": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Chromium returned no JavaScript value" } },
        "ja": { "stringUnit": { "state": "translated", "value": "ChromiumからJavaScriptの値が返されませんでした" } }
      }
    },
    "browser.chromium.automation.javascriptTimedOut": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Timed out waiting for JavaScript result" } },
        "ja": { "stringUnit": { "state": "translated", "value": "JavaScriptの結果を待機中にタイムアウトしました" } }
      }
    },
    "browser.chromium.automation.noScreenshot": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Chromium returned no screenshot" } },
        "ja": { "stringUnit": { "state": "translated", "value": "Chromiumからスクリーンショットが返されませんでした" } }
