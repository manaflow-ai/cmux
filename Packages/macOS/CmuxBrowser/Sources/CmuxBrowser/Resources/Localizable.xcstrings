    "browser.chromium.automation.documentScriptTimedOut": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Timed out registering Chromium document script" } },
        "ja": { "stringUnit": { "state": "translated", "value": "Chromiumのドキュメントスクリプト登録中にタイムアウトしました" } }
