          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Diff 檢視器信任的目錄不安全"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diff 查看器受信任目录不安全"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Diff 뷰어 신뢰할 수 있는 디렉토리가 안전하지 않습니다"
          }
        }
      }
    },
