      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cmux CLI command wants to open this extension's options page, where its settings and access can be changed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein cmux-CLI-Befehl möchte die Optionsseite dieser Erweiterung öffnen, auf der ihre Einstellungen und ihr Zugriff geändert werden können."
          }
        },
        "fr": {
          "stringUnit": {
