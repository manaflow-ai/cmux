{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "diffViewer.error.allowlistTooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diff viewer allowlist is too large"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "差分ビューアの許可リストが大きすぎます"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diff-Viewer-Erlaubnisliste ist zu groß"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste d’autorisation du visualiseur de diff est trop grande"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قائمة عارض الفروق المسموحة كبيرة جداً"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de permitidos del visor de diferencias es demasiado grande"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Diff 檢視器允許清單過大"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diff 查看器白名单过大"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Diff 뷰어 허용 목록이 너무 큽니다"
          }
        }
      }
    },
    "diffViewer.error.duplicateEntry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicate diff viewer allowlist entry"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "差分ビューアの許可リスト項目が重複しています"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelter Eintrag in der Diff-Viewer-Erlaubnisliste"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrée en double dans la liste d’autorisation du visualiseur de diff"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إدخال مكرر في قائمة عارض الفروق المسموحة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrada duplicada en la lista de permitidos del visor de diferencias"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重複的 Diff 檢視器允許清單項目"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重复的 Diff 查看器白名单条目"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중복된 Diff 뷰어 허용 목록 항목"
          }
        }
      }
    },
    "diffViewer.error.emptyAllowlist": {
      "extractionState": "manual",
      "localizations": {
