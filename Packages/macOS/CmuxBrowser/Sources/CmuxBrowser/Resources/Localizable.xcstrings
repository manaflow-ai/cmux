    "diffViewer.error.invalidEntry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid diff viewer allowlist entry"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "差分ビューアの許可リスト項目が無効です"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültiger Eintrag in der Diff-Viewer-Erlaubnisliste"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrée non valide dans la liste d’autorisation du visualiseur de diff"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إدخال غير صالح في قائمة عارض الفروق المسموحة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrada no válida en la lista de permitidos del visor de diferencias"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
