        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "差分ビューアの許可リスト項目が重複しています"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelter Eintrag in der Diff-Viewer-Erlaubnisliste"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrée en double dans la liste d’autorisation du visualiseur de diff"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إدخال مكرر في قائمة عارض الفروق المسموحة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrada duplicada en la lista de permitidos del visor de diferencias"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重複的 Diff 檢視器允許清單項目"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重复的 Diff 查看器白名单条目"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중복된 Diff 뷰어 허용 목록 항목"
          }
        }
      }
    },
    "diffViewer.error.emptyAllowlist": {
