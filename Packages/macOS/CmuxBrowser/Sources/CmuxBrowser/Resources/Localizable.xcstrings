    "browser.extension.consent.enableRequester": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cmux CLI command wants to turn on this extension."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يريد أمر من واجهة سطر أوامر cmux تشغيل هذه الإضافة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein cmux-CLI-Befehl möchte diese Erweiterung einschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un comando de la CLI de cmux quiere activar esta extensión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une commande de la CLI cmux veut activer cette extension."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux CLI のコマンドがこの拡張機能をオンにしようとしています。"
          }
        },
        "ko": {
