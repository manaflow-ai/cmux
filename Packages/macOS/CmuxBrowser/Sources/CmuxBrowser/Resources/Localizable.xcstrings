          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diff 查看器文件不可读"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Diff 뷰어 파일을 읽을 수 없습니다"
          }
        }
      }
