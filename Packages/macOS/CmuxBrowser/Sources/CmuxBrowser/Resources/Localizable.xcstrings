    "browser.chromium.automation.malformedDocumentScriptRegistration": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Chromium returned a malformed document-script registration" } },
        "ja": { "stringUnit": { "state": "translated", "value": "Chromiumから不正なドキュメントスクリプト登録が返されました" } }
