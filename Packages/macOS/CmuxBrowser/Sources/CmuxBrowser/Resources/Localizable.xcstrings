          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف عارض الفروق غير قابل للقراءة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo del visor de diferencias no es legible"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Diff 檢視器檔案無法讀取"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diff 查看器文件不可读"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Diff 뷰어 파일을 읽을 수 없습니다"
          }
        }
      }
