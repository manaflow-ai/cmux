          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertrauenswürdiges Diff-Viewer-Verzeichnis ist unsicher"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le répertoire de confiance du visualiseur de diff n’est pas sécurisé"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدليل الموثوق لعارض الفروق غير آمن"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
