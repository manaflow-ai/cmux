    "browser.chromium.cdp.disconnected": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Browser connection closed" } },
        "ja": { "stringUnit": { "state": "translated", "value": "ブラウザ接続が閉じられました" } }
