            "state": "translated",
            "value": "حدث خطأ أثناء عرض صفحة الويب هذه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Anzeigen dieser Webseite ist ein Fehler aufgetreten."
          }
        },
