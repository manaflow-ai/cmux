    },
    "browser.chromium.automation.noCommandResult": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Chromium returned no CDP command result" } },
        "ja": { "stringUnit": { "state": "translated", "value": "ChromiumからCDPコマンドの結果が返されませんでした" } }
