    "chief.brain.codex.noThread": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex started a thread without an id."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex hat einen Thread ohne ID gestartet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex a démarré un fil sans identifiant."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدأ Codex سلسلة بدون معرّف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex inició un hilo sin id."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 啟動了一個沒有 ID 的執行緒。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 启动了一个没有 ID 的线程。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex가 ID 없이 스레드를 시작했습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex が ID のないスレッドを開始しました。"
          }
        }
      }
    },
