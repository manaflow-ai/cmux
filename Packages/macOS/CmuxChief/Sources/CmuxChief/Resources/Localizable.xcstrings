    "chief.brain.claude.stoppedBeforeReading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code stopped before it read the message."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code wurde beendet, bevor es die Nachricht gelesen hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code s’est arrêté avant d’avoir lu le message."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف Claude Code قبل أن يقرأ الرسالة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code se detuvo antes de leer el mensaje."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code 在讀取訊息前就停止了。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code 在读取消息前就停止了。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code가 메시지를 읽기 전에 중지되었습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code はメッセージを読み取る前に停止しました。"
          }
        }
      }
    },
