    "chief.turn.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief could not finish this reply: %@\nSend your message again to retry."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief konnte diese Antwort nicht abschließen: %@\nSende deine Nachricht erneut, um es noch einmal zu versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief n’a pas pu terminer cette réponse : %@\nEnvoyez à nouveau votre message pour réessayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Chief إكمال هذا الرد: %@\nأرسل رسالتك مرة أخرى لإعادة المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief no pudo terminar esta respuesta: %@\nEnvía tu mensaje de nuevo para reintentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief 無法完成此回覆：%@\n請再次傳送你的訊息以重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief 无法完成此回复：%@\n请再次发送你的消息以重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief가 이 답장을 완료하지 못했습니다: %@\n다시 시도하려면 메시지를 다시 보내세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief はこの返信を完了できませんでした: %@\n再試行するには、メッセージをもう一度送信してください。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
