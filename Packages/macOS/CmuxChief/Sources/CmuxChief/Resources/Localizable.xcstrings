{
  "sourceLanguage": "en",
  "strings": {
    "chief.brain.claude.exited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code exited unexpectedly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code wurde unerwartet beendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code s’est arrêté de façon inattendue."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خرج Claude Code بشكل غير متوقع."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code se cerró inesperadamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code 意外結束。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code 意外退出。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code가 예기치 않게 종료되었습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code が予期せず終了しました。"
          }
        }
      }
    },
