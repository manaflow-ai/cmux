            "value": "Codex se detuvo antes de %@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 在 %@ 之前停止了。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 在 %@ 之前停止了。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex가 %@ 전에 중지되었습니다."
          }
        },
