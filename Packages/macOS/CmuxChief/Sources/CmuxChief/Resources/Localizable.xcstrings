    "chief.brain.missingExecutable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not find `%@` on PATH. Install it or set its path in Chief settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "`%@` wurde im PATH nicht gefunden. Installiere es oder lege seinen Pfad in den Chief-Einstellungen fest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "`%@` est introuvable dans le PATH. Installez-le ou définissez son chemin dans les réglages de Chief."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر العثور على `%@` في PATH. ثبّته أو عيّن مساره في إعدادات Chief."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró `%@` en el PATH. Instálalo o establece su ruta en los ajustes de Chief."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 PATH 中找不到 `%@`。請安裝它，或在 Chief 設定中設定其路徑。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 PATH 中找不到 `%@`。请安装它，或在 Chief 设置中设置其路径。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PATH에서 `%@`을(를) 찾을 수 없습니다. 설치하거나 Chief 설정에서 경로를 지정하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PATH に `%@` が見つかりません。インストールするか、Chief の設定でパスを指定してください。"
          }
        }
      }
    },
    "chief.brain.unknownModel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cannot use the model “%2$@”. Pick another model in Chief Settings (click the model name above the conversation)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kann das Modell „%2$@“ nicht verwenden. Wähle in den Chief-Einstellungen ein anderes Modell (klicke auf den Modellnamen über der Unterhaltung)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ne peut pas utiliser le modèle « %2$@ ». Choisissez un autre modèle dans les réglages de Chief (cliquez sur le nom du modèle au-dessus de la conversation)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no puede usar el modelo «%2$@». Elige otro modelo en los ajustes de Chief (haz clic en el nombre del modelo sobre la conversación)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لـ %1$@ استخدام النموذج \"%2$@\". اختر نموذجًا آخر في إعدادات Chief (انقر على اسم النموذج أعلى المحادثة)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ はモデル「%2$@」を使用できません。Chief の設定で別のモデルを選んでください（会話の上にあるモデル名をクリック）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에서 “%2$@” 모델을 사용할 수 없습니다. Chief 설정에서 다른 모델을 선택하세요(대화 위의 모델 이름 클릭)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 无法使用模型“%2$@”。请在 Chief 设置中选择其他模型（点击对话上方的模型名称）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 無法使用模型「%2$@」。請在 Chief 設定中選擇其他模型（按一下對話上方的模型名稱）。"
          }
        }
      }
    },
