          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code 已退出：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code가 종료되었습니다: %@"
          }
        },
        "ja": {
