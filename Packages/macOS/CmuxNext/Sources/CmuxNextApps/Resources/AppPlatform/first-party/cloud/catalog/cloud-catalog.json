          "disconnected"
        ]
      },
      "cli": {
        "path": "machine disconnect",
        "visible": true
      },
      "mcp": {
        "expose": "opt_in",
        "group": "cloud"
      },
      "palette": {
        "title": {
          "en": "Disconnect from Cloud Machine",
          "ja": "クラウドマシンから切断"
        }
      },
      "docs": "End the link to a machine and forget it, also after a revocation. Every terminal of that machine on this Mac shows the disconnected state. The machine keeps running.",
      "since": "cloud/1"
    },
    {
