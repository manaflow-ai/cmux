    {
      "name": "cloud.file.push",
      "owner": "app:cmux/cloud",
      "class": "mutation",
      "risk": "mutate-shared",
      "idempotency": "required",
      "focuses": false,
      "queue_offline": false,
      "remote_relay": "deny",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "machine": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
            "description": "The machine id (vm-…) from cloud.machine.list."
          },
          "localPath": {
            "type": "string",
            "minLength": 2,
            "maxLength": 4096,
            "pattern": "^/",
            "description": "An absolute file path on this Mac, without . or .. segments."
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^/",
            "description": "An absolute path on the machine: no .. segment, no NUL or control characters, at most 4096 bytes."
          }
        },
        "required": [
          "machine",
          "localPath",
          "path"
        ]
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "transfer",
          "state",
          "machine",
          "path",
          "localPath"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "transfer": {
            "type": "string",
            "description": "The transfer id; its cloud.file.transfer.changed event carries it."
          },
          "state": {
            "const": "running"
          },
          "machine": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "localPath": {
            "type": "string"
          }
        }
      },
      "cli": {
        "path": "file push",
        "visible": false,
        "positional": [
          "machine",
          "localPath",
          "path"
        ]
      },
      "mcp": {
        "expose": "never",
        "group": "cloud"
      },
      "gesture": "required",
      "docs": "Copy a local file to a machine over SSH through the machine's link. The server makes a new key in memory for each transfer and sends only its public half to the Cloud API; the guest host key is pinned from the Cloud API answer. Needs fs:write. Only a person may transfer: the local path reaches any file this Mac's user can read or write, so the host stamps origin user only after a native file panel; every other origin gets cmux.cloud.origin_refused. Hidden on the CLI and never on MCP. The op answers at once with a transfer id (state running) while the copy runs off the op loop; its end is the event cloud.file.transfer.changed {transfer, machine, direction, path, localPath, state: done with bytes, failed with a typed error, or cancelled}. At most 4 transfers run at once; more get cmux.cloud.transfer_busy (retryable). cloud.file.transfer.cancel stops it.",
      "since": "cloud/1"
    },
