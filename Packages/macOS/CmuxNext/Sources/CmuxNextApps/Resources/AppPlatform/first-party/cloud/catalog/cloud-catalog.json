    {
      "name": "cloud.fs.write",
      "owner": "app:cmux/cloud",
      "class": "mutation",
      "risk": "mutate-shared",
      "idempotency": "required",
      "focuses": false,
      "queue_offline": false,
      "remote_relay": "deny",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "machine": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
            "description": "The machine id (vm-…) from cloud.machine.list."
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^/",
            "description": "An absolute path on the machine: no .. segment, no NUL or control characters, at most 4096 bytes."
          },
          "dataBase64": {
            "type": "string",
            "contentEncoding": "base64",
            "description": "The new file content, at most 16 MiB."
          },
          "mode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4095
          },
          "baseRevision": {
            "type": [
              "string",
              "null"
