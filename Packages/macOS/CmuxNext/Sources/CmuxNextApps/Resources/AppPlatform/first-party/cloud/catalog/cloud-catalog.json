        "required": [
          "machine",
          "path",
          "dataBase64"
        ]
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "path",
          "size"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "path": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "cli": {
        "path": "fs write",
        "visible": true,
        "positional": [
          "machine",
          "path"
        ]
      },
      "mcp": {
        "expose": "opt_in",
        "group": "cloud"
      },
      "docs": "Write a whole file (at most 16 MiB, atomic on the machine). Needs an idempotency key: a retry with the same key writes once. Writes files on the machine, so it needs fs:write. There is no conflict check (no revision on the route).",
      "since": "cloud/1"
    },
