        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопки видны, только пока указатель над боковой панелью или панелью вкладок."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปุ่มจะแสดงเฉพาะเมื่อตัวชี้อยู่เหนือแถบด้านข้างหรือแถบแท็บ"
