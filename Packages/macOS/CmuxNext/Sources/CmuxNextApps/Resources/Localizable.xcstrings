    "store.feature.newTabWeather.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طقس اليوم ودرجتا الحرارة العظمى والصغرى بجانب محرر الرسائل في علامة التبويب الجديدة البسيطة."
