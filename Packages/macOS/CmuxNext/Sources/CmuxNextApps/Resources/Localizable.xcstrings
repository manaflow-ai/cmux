    "store.feature.hoverCards.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ المؤشر على مساحة عمل لترى وكلاءها وفرعها ومنافذها."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadržite pokazivač na radnom prostoru da vidite njegove agente, granu i portove."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold markøren over et arbejdsområde for at se dets agenter, gren og porte."
