    "store.feature.chromeGroups.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تنضم شارة المجموعة الملونة إلى شريط أسمك بزاوية مقصوصة وطرف مستدير، مثل مجموعات علامات التبويب في Chrome."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Obojena oznaka grupe spaja se s debljom šinom s isječenim uglom i zaobljenim krajem, kao grupe kartica u Chromeu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En gruppes farvede mærke går sammen med en tykkere skinne med et afskåret hjørne og en afrundet ende, som Chromes fanegrupper."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das farbige Schild einer Gruppe geht in eine dickere Leiste mit abgeschnittener Ecke und rundem Ende über, wie bei den Tab-Gruppen in Chrome."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A group's colored chip joins a thicker rail with a clipped corner and a rounded end, like Chrome's tab groups."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La etiqueta de color de un grupo se une a un riel más grueso con una esquina recortada y un extremo redondeado, como los grupos de pestañas de Chrome."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La pastille colorée d’un groupe rejoint un rail plus épais à coin coupé et à bout arrondi, comme les groupes d’onglets de Chrome."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’etichetta colorata di un gruppo si unisce a una barra più spessa con un angolo tagliato e un’estremità arrotondata, come i gruppi di schede di Chrome."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "グループの色付きチップが、角を切り落とした太めのレールにつながり、端が丸くなります。Chromeのタブグループと同じ見た目です。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ស្លាកពណ៌របស់ក្រុមភ្ជាប់ទៅផ្លូវក្រាស់ជាងដែលមានជ្រុងកាត់ និងចុងមូល ដូចក្រុមផ្ទាំងរបស់ Chrome។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "그룹의 색상 칩이 모서리가 잘린 더 두꺼운 레일과 이어지고 끝이 둥글게 마무리됩니다. Chrome의 탭 그룹과 같은 모양입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En gruppes fargede brikke går over i en tykkere skinne med et avkuttet hjørne og en avrundet ende, som fanegruppene i Chrome."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kolorowa plakietka grupy łączy się z grubszą szyną ze ściętym rogiem i zaokrąglonym końcem, jak w grupach kart w Chrome."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A etiqueta colorida de um grupo se junta a um trilho mais grosso com um canto cortado e uma ponta arredondada, como os grupos de abas do Chrome."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Цветной ярлык группы соединяется с более толстой направляющей со срезанным углом и скруглённым концом, как у групп вкладок в Chrome."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ป้ายสีของกลุ่มเชื่อมกับแถบที่หนากว่าซึ่งมีมุมตัดและปลายมน เหมือนกลุ่มแท็บของ Chrome"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Grubun renkli etiketi, köşesi kesik daha kalın bir rayla ve yuvarlak bir uçla birleşir; tıpkı Chrome’un sekme grupları gibi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Кольоровий ярлик групи з’єднується з товщою напрямною зі зрізаним кутом і заокругленим кінцем, як у групах вкладок Chrome."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nhãn màu của nhóm nối với một thanh dày hơn có góc bị cắt và đầu bo tròn, giống nhóm thẻ của Chrome."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "分组的彩色标签与带切角的较粗导轨相连，末端为圆角，就像 Chrome 的标签页分组。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "群組的彩色標籤與帶切角的較粗導軌相連，末端為圓角，就像 Chrome 的標籤頁群組。"
          }
        }
      }
    },
