    "store.feature.shufflePaintings.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لوحة من الملك العام خلف الطرفيات تتغير من تلقاء نفسها."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slika iz javnog domena iza vaših terminala koja se sama mijenja."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et maleri i det offentlige domæne bag dine terminaler, som skifter af sig selv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein gemeinfreies Gemälde hinter deinen Terminals, das von selbst wechselt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A public-domain painting behind your terminals that changes on its own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una pintura de dominio público detrás de tus terminales que cambia sola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tableau du domaine public derrière vos terminaux, qui change tout seul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dipinto di pubblico dominio dietro i tuoi terminali che cambia da solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルの背後に、自動で切り替わるパブリックドメインの絵画を表示します。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "គំនូរសាធារណៈនៅពីក្រោយទែមីណាល់របស់អ្នក ដែលផ្លាស់ប្ដូរដោយខ្លួនឯង។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널 뒤에 퍼블릭 도메인 명화가 표시되고 저절로 바뀝니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et maleri i det fri bak terminalene dine som skifter av seg selv."
          }
        },
        "pl" : {
          "stringUnit" : {
