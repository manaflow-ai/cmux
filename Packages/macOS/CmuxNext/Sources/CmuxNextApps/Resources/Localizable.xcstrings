    "store.feature.ultraCompact.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صفوف وهوامش ونصوص أضيق في كل مكان، ليتسع المزيد في شاشة واحدة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uži redovi, razmaci i tekst svuda, pa više stane na jedan ekran."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tættere rækker, margener og tekst overalt, så der er plads til mere på én skærm."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engere Zeilen, Abstände und Texte überall, damit mehr auf einen Bildschirm passt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tighter rows, padding and text everywhere, so more fits on one screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filas, márgenes y texto más ajustados en todas partes, para que quepa más en una pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lignes, marges et texte plus serrés partout, pour en voir davantage sur un écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Righe, margini e testo più compatti ovunque, così entra di più in uno schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行、余白、文字をすべて詰めて、1画面により多く表示します。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ជួរ គម្លាត និងអក្សរតូចជាងគ្រប់កន្លែង ដើម្បីបង្ហាញបានច្រើនលើអេក្រង់តែមួយ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "행, 여백, 글자를 모두 촘촘하게 해 한 화면에 더 많이 담습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tettere rader, marger og tekst overalt, så mer får plass på én skjerm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciaśniejsze wiersze, odstępy i tekst wszędzie, by więcej zmieściło się na ekranie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linhas, margens e texto mais justos em todo lugar, para caber mais em uma tela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более плотные строки, отступы и текст везде, чтобы на экране помещалось больше."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แถว ระยะขอบ และข้อความแน่นขึ้นทุกที่ เพื่อให้เห็นได้มากขึ้นในหน้าจอเดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her yerde daha sıkı satırlar, boşluklar ve metin; tek ekrana daha fazlası sığar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щільніші рядки, відступи й текст усюди, щоб на екрані вміщалося більше."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hàng, khoảng cách và chữ gọn hơn ở mọi nơi để một màn hình chứa được nhiều hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有行、边距和文字都更紧凑，一屏能放下更多内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有列、邊距和文字都更緊湊，一個畫面能放下更多內容。"
          }
        }
      }
    },
