    "store.feature.customizeItem.summary" : {
      "comment" : "App Store Features card: what the Customize sidebar item does.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح الإعدادات › المظهر من الشريط الجانبي لتغيير السمات والخلفيات."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
