          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinduet bliver til glas og viser, hvad der er bag det, sløret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fenster wird zu Glas und zeigt verschwommen, was dahinter liegt."
