    "store.feature.sidebarTimestamps.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض كل صف لمساحة عمل وقت آخر تغيير له، مثل 10:42 أو 3d."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaki red radnog prostora prikazuje kada se zadnji put promijenio, npr. 10:42 ili 3d."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver arbejdsområderække viser, hvornår den sidst ændrede sig, fx 10:42 eller 3d."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Arbeitsbereichszeile zeigt, wann sie sich zuletzt geändert hat, etwa 10:42 oder 3d."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each workspace row shows when it last changed, such as 10:42 or 3d."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada fila de espacio de trabajo muestra cuándo cambió por última vez, como 10:42 o 3d."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque ligne d’espace de travail indique sa dernière modification, comme 10:42 ou 3d."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni riga di spazio di lavoro mostra quando è cambiata l’ultima volta, come 10:42 o 3d."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ワークスペースの行に最終変更時刻(10:42 や 3d など)を表示します。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ជួរកន្លែងធ្វើការនីមួយៗបង្ហាញពេលដែលវាប្ដូរចុងក្រោយ ដូចជា 10:42 ឬ 3d។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 작업 공간 행에 마지막으로 바뀐 때(10:42, 3d 등)를 표시합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
