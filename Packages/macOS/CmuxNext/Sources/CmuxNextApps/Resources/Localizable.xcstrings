          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et app-overlegg åpnes bare når du åpner det i cmux"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
