        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャットのヘッダーのバッジに、エージェントが待っている確認をすべて表示し、ワンクリックで答えられます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ស្លាកមួយនៅក្បាលការជជែក បង្ហាញរាល់សំណើដែលភ្នាក់ងាររបស់អ្នកកំពុងរង់ចាំ ជាមួយចម្លើយដោយចុចតែម្ដង។"
