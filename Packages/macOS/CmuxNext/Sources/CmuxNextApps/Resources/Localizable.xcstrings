    "store.feature.comfortableDensity.summary" : {
      "comment": "App Store Features card: what comfortable appearance density does.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صفوف وعناصر تحكم أوسع تجعل الجلسات الطويلة أسهل للقراءة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prostraniji redovi i kontrole olakšavaju čitanje tokom dugih sesija."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mere rummelige rækker og kontroller gør lange sessioner lettere at læse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräumigere Zeilen und Steuerelemente erleichtern lange Sitzungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roomier rows and controls make longer sessions easier to read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las filas y controles más espaciosos facilitan las sesiones largas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des lignes et contrôles plus aérés facilitent les longues sessions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Righe e controlli più spaziosi rendono più leggibili le sessioni lunghe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行とコントロールに余裕を持たせ、長時間の作業を読みやすくします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ជួរ និងវត្ថុបញ្ជាធំទូលាយធ្វើឱ្យវគ្គវែងៗងាយអាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "넉넉한 행과 컨트롤로 긴 세션도 읽기 쉽습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Romsligere rader og kontroller gjør lange økter enklere å lese."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przestronniejsze wiersze i kontrolki ułatwiają czytanie podczas długich sesji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Linhas e controles mais espaçosos facilitam a leitura em sessões longas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Более просторные строки и элементы управления облегчают чтение долгих сессий."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถวและตัวควบคุมที่โปร่งขึ้นทำให้อ่านเซสชันยาวได้ง่าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha geniş satır ve denetimler uzun oturumları okumayı kolaylaştırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Просторіші рядки й елементи керування полегшують читання довгих сеансів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hàng và điều khiển rộng rãi giúp đọc các phiên dài dễ hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更宽裕的行和控件让长时间工作更易阅读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更寬裕的列與控制項讓長時間工作更易閱讀。"
          }
        }
      }
    },
