        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널 뒤에 퍼블릭 도메인 명화가 표시되고 저절로 바뀝니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
