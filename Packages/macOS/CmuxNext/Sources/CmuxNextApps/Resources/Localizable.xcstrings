        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pulsanti si vedono solo mentre il puntatore è sopra la barra laterale o una barra delle schede."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボタンは、ポインタがサイドバーまたはタブバーの上にある間だけ表示されます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ប៊ូតុងបង្ហាញតែពេលទស្សន៍ទ្រនិចនៅលើរបារចំហៀង ឬរបារផ្ទាំងប៉ុណ្ណោះ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "버튼은 포인터가 사이드바나 탭 막대 위에 있을 때만 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knapper vises bare mens pekeren er over sidefeltet eller en fanelinje."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyciski są widoczne tylko, gdy wskaźnik jest nad paskiem bocznym lub paskiem kart."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os botões aparecem só enquanto o ponteiro está sobre a barra lateral ou uma barra de abas."
