          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイドバーから設定 › 外観を開き、テーマや背景を変更できます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
