    "store.feature.needsYou.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شارة في رأس المحادثة تعرض كل طلب ينتظرك فيه وكلاؤك، مع إجابات بنقرة واحدة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Značka u zaglavlju razgovora prikazuje svaki upit na koji vaši agenti čekaju, s odgovorima jednim klikom."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et mærke i chattens top viser alt, dine agenter venter på, med svar med ét klik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
