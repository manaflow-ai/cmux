    "store.feature.comfortableSidebar.summary" : {
      "comment" : "App Store Features card: what the Comfortable sidebar density does.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صفوف أطول في الشريط الجانبي مع مساحة أكبر حولها، ولا تزال بسطر واحد لكل صف."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viši redovi bočnog panela s više prostora oko njih, i dalje po jedan red."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højere rækker i sidebjælken med mere luft omkring dem, stadig én linje hver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höhere Zeilen in der Seitenleiste mit mehr Raum darum, weiterhin einzeilig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taller sidebar rows with more room around them, still one line each."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filas más altas en la barra lateral con más espacio alrededor, aún de una línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des lignes plus hautes dans la barre latérale, plus aérées, toujours sur une ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Righe della barra laterale più alte e più spaziate, sempre su una riga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイドバーの行を高くし、周りに余白を取ります。各行は1行のままです。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ជួររបារចំហៀងខ្ពស់ជាង មានចន្លោះច្រើនជុំវិញ ហើយនៅតែមួយបន្ទាត់។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사이드바 행이 더 높아지고 주변 여백이 넓어지며, 여전히 한 줄입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyere rader i sidepanelet med mer luft rundt, fortsatt én linje hver."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyższe wiersze paska bocznego z większym odstępem, nadal po jednej linii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linhas mais altas na barra lateral, com mais espaço ao redor, ainda em uma linha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более высокие строки боковой панели с бо́льшими отступами, по-прежнему в одну строку."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แถวในแถบข้างสูงขึ้นและมีระยะรอบมากขึ้น แต่ยังคงเป็นบรรทัดเดียว"
