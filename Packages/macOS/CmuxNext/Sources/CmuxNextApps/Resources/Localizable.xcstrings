    "store.settings.body" : {
      "comment" : "Discover card body: cmux's own features are turned on and off in Settings, sidebar items with Edit Sidebar",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الخلفيات وطرق عرض الشريط الجانبي وأدوات علامة التبويب الجديدة وبقية ميزات cmux موجودة في الإعدادات. تضيف ميزة تعديل الشريط الجانبي عناصر الشريط الجانبي وتزيلها."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pozadine, prikazi bočne trake, widgeti nove kartice i ostale cmux funkcije nalaze se u Postavkama. Uredi bočnu traku dodaje i uklanja stavke bočne trake."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Baggrunde, sidebjælkevisninger, widgets på Ny fane og resten af cmux' egne funktioner findes i Indstillinger. Rediger sidebjælke tilføjer og fjerner elementer i sidebjælken."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hintergründe, Seitenleistenansichten, Widgets im neuen Tab und die übrigen Funktionen von cmux findest du in den Einstellungen. Mit „Seitenleiste bearbeiten“ fügst du Elemente hinzu oder entfernst sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backgrounds, sidebar views, New Tab widgets and the rest of cmux's own features are in Settings. Edit Sidebar adds and removes sidebar items."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los fondos, las vistas de la barra lateral, los widgets de Nueva pestaña y el resto de funciones de cmux están en Ajustes. Editar barra lateral añade y quita elementos de la barra lateral."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les arrière-plans, les vues de la barre latérale, les widgets du nouvel onglet et les autres fonctions de cmux se trouvent dans les Réglages. Modifier la barre latérale ajoute et retire ses éléments."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sfondi, viste della barra laterale, widget della nuova scheda e le altre funzioni di cmux sono nelle Impostazioni. Modifica barra laterale aggiunge e rimuove gli elementi della barra laterale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "背景、サイドバーの表示、新規タブのウィジェットなど、cmux 自体の機能は設定にあります。サイドバー項目の追加と削除は「サイドバーを編集」で行えます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ផ្ទៃខាងក្រោយ ទិដ្ឋភាពរបារចំហៀង វិដជិតផ្ទាំងថ្មី និងមុខងារផ្សេងទៀតរបស់ cmux មាននៅក្នុងការកំណត់។ កែរបារចំហៀង បន្ថែម និងដកធាតុរបារចំហៀង។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "배경, 사이드바 보기, 새 탭 위젯 등 cmux 자체 기능은 설정에 있습니다. 사이드바 편집으로 사이드바 항목을 추가하고 제거할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bakgrunner, sidefeltvisninger, widgets på Ny fane og resten av cmux sine egne funksjoner finner du i Innstillinger. Rediger sidefelt legger til og fjerner elementer i sidefeltet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tła, widoki paska bocznego, widżety nowej karty i pozostałe funkcje cmux są w Ustawieniach. Edycja paska bocznego dodaje i usuwa jego elementy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fundos, visualizações da barra lateral, widgets da Nova aba e os demais recursos do cmux ficam em Ajustes. Editar barra lateral adiciona e remove itens da barra lateral."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Фоны, виды боковой панели, виджеты новой вкладки и остальные функции cmux находятся в Настройках. «Изменить боковую панель» добавляет и убирает её элементы."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "พื้นหลัง มุมมองแถบด้านข้าง วิดเจ็ตแท็บใหม่ และฟีเจอร์อื่นๆ ของ cmux อยู่ในการตั้งค่า แก้ไขแถบด้านข้างใช้เพิ่มและลบรายการในแถบด้านข้าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arka planlar, kenar çubuğu görünümleri, Yeni Sekme araçları ve cmux'un diğer özellikleri Ayarlar'dadır. Kenar Çubuğunu Düzenle, kenar çubuğu öğelerini ekler ve kaldırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Фони, вигляди бічної панелі, віджети нової вкладки та інші функції cmux є в Налаштуваннях. «Редагувати бічну панель» додає та прибирає її елементи."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hình nền, chế độ xem thanh bên, tiện ích Thẻ mới và các tính năng khác của cmux nằm trong Cài đặt. Sửa thanh bên giúp thêm và xóa các mục trên thanh bên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "背景、侧边栏视图、新标签页小组件以及 cmux 自带的其他功能都在设置中。用“编辑侧边栏”添加和移除侧边栏项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "背景、側邊欄檢視、新分頁小工具以及 cmux 內建的其他功能都在設定中。用「編輯側邊欄」加入和移除側邊欄項目。"
          }
        }
      }
    },
