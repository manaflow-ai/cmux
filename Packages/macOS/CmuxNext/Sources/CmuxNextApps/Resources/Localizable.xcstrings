    "store.feature.sideBySide.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اضغط مع الاستمرار على صف مساحة العمل واسحبه إلى حافة جزء لعرضها بجانب الحالية؛ والنقر يبدّل عند التحرير."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Držite red radnog prostora i povucite ga na rub okna da se prikaže pored trenutnog; klik mijenja pri otpuštanju."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hold en arbejdsområderække og træk den hen på kanten af et panel for at vise den ved siden af det aktuelle; et klik skifter, når du slipper."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halte eine Arbeitsbereich-Zeile und ziehe sie an den Rand eines Bereichs, um sie neben dem aktuellen anzuzeigen; ein Klick wechselt beim Loslassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold a workspace row and drag it onto a pane's edge to show it beside the current one; a click switches on release."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantén pulsada una fila de espacio de trabajo y arrástrala al borde de un panel para mostrarla junto al actual; un clic cambia al soltar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Maintenez une ligne d’espace de travail et faites-la glisser sur le bord d’un volet pour l’afficher à côté de l’actuel ; un clic change au relâchement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tieni premuta una riga di workspace e trascinala sul bordo di un riquadro per mostrarla accanto a quello attuale; un clic cambia al rilascio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ワークスペースの行を押したままペインの端にドラッグすると、現在のものの横に表示します。クリックすると離したときに切り替わります。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "សង្កត់ជួរកន្លែងធ្វើការហើយអូសទៅគែមផ្ទាំង ដើម្បីបង្ហាញក្បែរកន្លែងបច្ចុប្បន្ន ការចុចប្តូរពេលលែង។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "워크스페이스 행을 누른 채 패널 가장자리로 드래그하면 현재 워크스페이스 옆에 표시합니다. 클릭하면 손을 뗄 때 전환됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hold en arbeidsområderad og dra den til kanten av et panel for å vise den ved siden av det gjeldende; et klikk bytter når du slipper."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przytrzymaj wiersz obszaru roboczego i przeciągnij go na krawędź panelu, aby pokazać go obok bieżącego; kliknięcie przełącza po zwolnieniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Segure uma linha de espaço de trabalho e arraste até a borda de um painel para mostrá-la ao lado do atual; um clique troca ao soltar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Зажмите строку рабочего пространства и перетащите её к краю панели, чтобы показать рядом с текущим; щелчок переключает при отпускании."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "กดแถวเวิร์กสเปซค้างแล้วลากไปที่ขอบบานหน้าต่างเพื่อแสดงข้างเวิร์กสเปซปัจจุบัน การคลิกจะสลับเมื่อปล่อย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bir çalışma alanı satırını basılı tutup bir bölmenin kenarına sürükleyin; mevcut olanın yanında görünür. Tıklama bırakınca geçiş yapar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Утримуйте рядок робочого простору й перетягніть його до краю панелі, щоб показати поруч із поточним; клацання перемикає після відпускання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Giữ một dòng không gian làm việc và kéo đến cạnh của một ngăn để hiện bên cạnh không gian hiện tại; nhấp chuột sẽ chuyển khi nhả."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "按住工作区行并拖到窗格边缘，即可在当前工作区旁边显示；单击则在松开时切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "按住工作區列並拖到窗格邊緣，即可在目前工作區旁邊顯示；按一下則在放開時切換。"
          }
        }
      }
    },
