    "store.feature.spaciousDensity.summary" : {
      "comment": "App Store Features card: what spacious appearance density does.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساحة إضافية تمنح كل جزء وعناصر التحكم تخطيطًا واسعًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatni prostor daje svakoj ploči i kontroli prostran raspored."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekstra luft giver alle ruder og kontroller et generøst layout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusätzlicher Freiraum gibt jedem Bereich und Steuerelement ein großzügiges Layout."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extra breathing room gives every pane and control a generous layout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio adicional ofrece un diseño generoso para cada panel y control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus d’espace donne à chaque volet et contrôle une disposition généreuse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio extra offre a ogni pannello e controllo un layout generoso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "余白を増やし、各ペインとコントロールをゆったり配置します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចន្លោះបន្ថែមផ្តល់ប្លង់ធំទូលាយដល់ផ្ទាំង និងវត្ថុបញ្ជាទាំងអស់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여유 공간을 늘려 모든 창과 컨트롤을 넉넉하게 배치합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekstra luft gir hvert panel og hver kontroll en romslig layout."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatkowe miejsce zapewnia panelom i kontrolkom przestronny układ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaço extra dá a cada painel e controle um layout generoso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дополнительное пространство создаёт свободную компоновку панелей и элементов управления."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่เพิ่มขึ้นทำให้ทุกบานและตัวควบคุมมีเลย์เอาต์ที่โปร่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ek alan her bölme ve denetime ferah bir düzen sağlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додатковий простір створює вільне розташування панелей і елементів керування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoảng trống thêm tạo bố cục rộng rãi cho mọi khung và điều khiển."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "额外留白让每个窗格和控件都有宽松布局。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "額外留白讓每個窗格與控制項都有寬鬆配置。"
          }
        }
      }
    },
