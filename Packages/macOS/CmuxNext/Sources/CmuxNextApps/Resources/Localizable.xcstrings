        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A badge in the chat header lists every ask your agents wait on, with one-click answers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una insignia en la cabecera del chat muestra todo lo que esperan tus agentes, con respuestas en un clic."
