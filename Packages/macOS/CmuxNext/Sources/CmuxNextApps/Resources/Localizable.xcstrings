    "apps.overlay.gesture" : {
      "comment" : "Why an app's overlay did not open: only the person's own click or palette pick in cmux opens one.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An app overlay opens only when you open it in cmux"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُفتح الطبقة العائمة للتطبيق إلا عندما تفتحها بنفسك في cmux"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prekrivač aplikacije otvara se samo kada ga otvoriš u cmuxu"
