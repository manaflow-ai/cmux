    "store.features.intro" : {
      "comment" : "App Store Features tab: one line above the switches. Each switch is the same setting Settings shows.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "شغّل الميزات المدمجة أو أوقفها. كل مفتاح هو نفس الإعداد الموجود في الإعدادات."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uključite ili isključite ugrađene funkcije. Svaki prekidač je ista postavka kao u Postavkama."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Slå indbyggede funktioner til eller fra. Hver kontakt er den samme indstilling som i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Integrierte Funktionen ein- oder ausschalten. Jeder Schalter ist dieselbe Einstellung wie in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn built-in features on or off. Each switch is the same setting you'll find in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Activa o desactiva funciones integradas. Cada interruptor es el mismo ajuste que en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Activez ou désactivez les fonctionnalités intégrées. Chaque interrupteur est le même réglage que dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Attiva o disattiva le funzioni integrate. Ogni interruttore è la stessa impostazione presente in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "内蔵機能をオン・オフします。各スイッチは設定と同じ項目です。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "បើក ឬបិទមុខងារភ្ជាប់មកជាមួយ។ កុងតាក់នីមួយៗគឺជាការកំណត់ដូចគ្នានឹងក្នុងការកំណត់។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "기본 제공 기능을 켜거나 끕니다. 각 스위치는 설정에 있는 것과 같은 항목입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Slå innebygde funksjoner av eller på. Hver bryter er den samme innstillingen som i Innstillinger."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Włączaj i wyłączaj wbudowane funkcje. Każdy przełącznik to to samo ustawienie co w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ative ou desative recursos integrados. Cada chave é o mesmo ajuste que está em Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Включайте и выключайте встроенные функции. Каждый переключатель — та же настройка, что и в Настройках."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "เปิดหรือปิดฟีเจอร์ในตัว สวิตช์แต่ละตัวคือการตั้งค่าเดียวกับในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yerleşik özellikleri açın veya kapatın. Her anahtar Ayarlar'daki ayarın aynısıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вмикайте й вимикайте вбудовані функції. Кожен перемикач — те саме налаштування, що й у Налаштуваннях."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bật hoặc tắt các tính năng có sẵn. Mỗi công tắc là cùng một cài đặt trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "开启或关闭内置功能。每个开关都与设置中的同一项相同。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "開啟或關閉內建功能。每個開關都與設定中的同一項相同。"
          }
        }
      }
    },
