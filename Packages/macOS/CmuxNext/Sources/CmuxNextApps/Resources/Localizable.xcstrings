          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagine, chat e schede chiuse, pronte da riaprire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閉じたページ、チャット、タブを、すぐにまた開けます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ទំព័រ ការជជែក និងផ្ទាំងដែលអ្នកបានបិទ រួចរាល់សម្រាប់បើកម្ដងទៀត។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "닫은 페이지, 채팅, 탭을 다시 열 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sider, chatter og faner du har lukket, klare til å åpnes igjen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamknięte strony, czaty i karty, gotowe do ponownego otwarcia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
