    "store.feature.compactDensity.summary" : {
      "comment": "App Store Features card: what compact appearance density does.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحافظ الصفوف والمسافات المضغوطة على ظهور المزيد من عملك دفعة واحدة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompaktni redovi i razmaci drže više posla vidljivim odjednom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompakte rækker og mellemrum holder mere af dit arbejde synligt på én gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompakte Zeilen und Abstände zeigen mehr deiner Arbeit gleichzeitig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compact rows and spacing keep more of your work visible at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las filas y el espaciado compactos muestran más trabajo a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des lignes et espacements compacts affichent davantage de travail à la fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Righe e spaziatura compatte mostrano più lavoro contemporaneamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行と間隔を詰めて、一度に多くの作業を表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ជួរ និងចន្លោះតូចបង្ហាញការងាររបស់អ្នកបានច្រើនក្នុងពេលតែមួយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴팩트한 행과 간격으로 한 번에 더 많은 작업을 표시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompakte rader og avstand viser mer av arbeidet ditt samtidig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompaktowe wiersze i odstępy pokazują więcej pracy naraz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Linhas e espaçamento compactos mantêm mais trabalho visível de uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компактные строки и интервалы позволяют видеть больше работы сразу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถวและระยะห่างที่กะทัดรัดทำให้เห็นงานได้มากขึ้นพร้อมกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompakt satırlar ve aralıklar aynı anda daha fazla iş gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Компактні рядки й інтервали показують більше роботи одночасно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hàng và khoảng cách gọn giúp hiển thị nhiều công việc hơn cùng lúc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紧凑的行和间距让你一次看到更多工作内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "緊湊的列與間距讓你一次看見更多工作內容。"
          }
        }
      }
    },
