            "state" : "translated",
            "value" : "Bez interneta, bez povezanih računa i ništa izvan dozvola uključenih ispod."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet internet, ingen forbundne konti og intet ud over de tilladelser, der er slået til nedenfor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Internet, keine verbundenen Konten und nichts über die unten aktivierten Berechtigungen hinaus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No internet, no connected accounts, and nothing beyond the permissions turned on below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin internet, sin cuentas conectadas y nada fuera de los permisos activados abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas d'internet, pas de comptes connectés, et rien au-delà des autorisations activées ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente internet, nessun account collegato e nulla oltre le autorizzazioni attivate qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターネットなし、接続済みアカウントなし。下でオンにした権限以外は使えません。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "គ្មានអ៊ីនធឺណិត គ្មានគណនីដែលបានភ្ជាប់ ហើយគ្មានអ្វីលើសពីការអនុញ្ញាតដែលបានបើកខាងក្រោម។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인터넷 없음, 연결된 계정 없음, 아래에서 켠 권한 외에는 아무것도 없음."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen internett, ingen tilkoblede kontoer og ingenting utover tillatelsene som er slått på nedenfor."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez internetu, bez połączonych kont i nic poza uprawnieniami włączonymi poniżej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem internet, sem contas conectadas e nada além das permissões ativadas abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без интернета, без подключённых аккаунтов и ничего сверх включённых ниже разрешений."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีอินเทอร์เน็ต ไม่มีบัญชีที่เชื่อมต่อ และไม่มีสิ่งใดนอกเหนือสิทธิ์ที่เปิดไว้ด้านล่าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İnternet yok, bağlı hesap yok ve aşağıda açılan izinlerin ötesinde hiçbir şey yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без інтернету, без підключених облікових записів і нічого понад увімкнені нижче дозволи."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không internet, không tài khoản đã kết nối và không gì ngoài các quyền được bật bên dưới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无网络、无关联账户，仅限下方开启的权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無網路、無連結帳號，僅限下方開啟的權限。"
          }
        }
      }
