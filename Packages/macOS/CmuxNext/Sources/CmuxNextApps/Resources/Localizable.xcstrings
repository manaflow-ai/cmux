        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each workspace row shows when it last changed, such as 10:42 or 3d."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada fila de espacio de trabajo muestra cuándo cambió por última vez, como 10:42 o 3d."
