        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bell atop the sidebar ranks your agent chats on every machine by what needs you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una campana en la barra lateral ordena tus chats de agentes de cada equipo según lo que te necesita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une cloche en haut de la barre latérale classe vos chats d'agents de chaque machine selon ce qui vous attend."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una campanella in cima alla barra laterale ordina le chat degli agenti di ogni macchina per urgenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイドバー上部のベルで、全マシンのエージェントチャットを対応が必要な順に並べます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "កណ្ដឹងលើរបារចំហៀងតម្រៀបការជជែកភ្នាក់ងាររបស់អ្នកលើគ្រប់ម៉ាស៊ីន តាមអ្វីដែលត្រូវការអ្នក។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사이드바 상단의 벨이 모든 기기의 에이전트 채팅을 확인이 필요한 순서로 정렬합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En bjelle øverst i sidepanelet rangerer agentchattene dine på alle maskiner etter hva som trenger deg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzwonek u góry paska bocznego porządkuje Twoje czaty z agentami na każdym komputerze według pilności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um sino no topo da barra lateral ordena seus chats de agentes em cada máquina pelo que precisa de você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Колокольчик вверху боковой панели упорядочивает чаты агентов на всех компьютерах по срочности."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กระดิ่งบนแถบด้านข้างจัดลำดับแชทเอเจนต์ของคุณทุกเครื่องตามสิ่งที่ต้องการคุณ"
