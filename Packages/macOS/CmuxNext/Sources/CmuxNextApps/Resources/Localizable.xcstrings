    "apps.store.badge.defaultHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux installs this app for everyone. You can disable or hide it and revoke its scopes."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يثبّت cmux هذا التطبيق للجميع. يمكنك تعطيله أو إخفاؤه وإلغاء صلاحياته."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux instalira ovu aplikaciju za sve. Možete je onemogućiti ili sakriti i opozvati njena ovlaštenja."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux installerer denne app for alle. Du kan deaktivere eller skjule den og tilbagekalde dens tilladelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux installiert diese App für alle. Du kannst sie deaktivieren oder ausblenden und ihre Berechtigungen widerrufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux instala esta app para todos. Puedes desactivarla u ocultarla y revocar sus permisos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux installe cette app pour tous. Vous pouvez la désactiver ou la masquer et révoquer ses autorisations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux installa questa app per tutti. Puoi disattivarla o nasconderla e revocarne i permessi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux はこのアプリを全員にインストールします。無効化や非表示、権限の取り消しができます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
