        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "បើកការមើលជាមុន Cloud ក្នុងផ្ទាំងកម្មវិធីរុករក ដើម្បីបោះពុម្ពផ្សាយវា។"
