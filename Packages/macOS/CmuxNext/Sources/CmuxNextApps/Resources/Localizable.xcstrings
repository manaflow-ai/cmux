    "apps.failure.scriptAt": {"comment":"A custom section's script error, where it is: %1$@ the line, %2$@ the column, %3$@ the engine's message (expecting ';').","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"needs_review","value":"السطر %1$@، العمود %2$@: %3$@"}},"bs":{"stringUnit":{"state":"needs_review","value":"Red %1$@, kolona %2$@: %3$@"}},"da":{"stringUnit":{"state":"needs_review","value":"Linje %1$@, kolonne %2$@: %3$@"}},"de":{"stringUnit":{"state":"needs_review","value":"Zeile %1$@, Spalte %2$@: %3$@"}},"en":{"stringUnit":{"state":"translated","value":"Line %1$@, column %2$@: %3$@"}},"es":{"stringUnit":{"state":"needs_review","value":"Línea %1$@, columna %2$@: %3$@"}},"fr":{"stringUnit":{"state":"needs_review","value":"Ligne %1$@, colonne %2$@ : %3$@"}},"it":{"stringUnit":{"state":"needs_review","value":"Riga %1$@, colonna %2$@: %3$@"}},"ja":{"stringUnit":{"state":"translated","value":"%1$@ 行 %2$@ 列: %3$@"}},"km":{"stringUnit":{"state":"needs_review","value":"បន្ទាត់ %1$@ ជួរឈរ %2$@៖ %3$@"}},"ko":{"stringUnit":{"state":"needs_review","value":"%1$@행 %2$@열: %3$@"}},"nb":{"stringUnit":{"state":"needs_review","value":"Linje %1$@, kolonne %2$@: %3$@"}},"pl":{"stringUnit":{"state":"needs_review","value":"Wiersz %1$@, kolumna %2$@: %3$@"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Linha %1$@, coluna %2$@: %3$@"}},"ru":{"stringUnit":{"state":"needs_review","value":"Строка %1$@, столбец %2$@: %3$@"}},"th":{"stringUnit":{"state":"needs_review","value":"บรรทัด %1$@ คอลัมน์ %2$@: %3$@"}},"tr":{"stringUnit":{"state":"needs_review","value":"Satır %1$@, sütun %2$@: %3$@"}},"uk":{"stringUnit":{"state":"needs_review","value":"Рядок %1$@, стовпець %2$@: %3$@"}},"vi":{"stringUnit":{"state":"needs_review","value":"Dòng %1$@, cột %2$@: %3$@"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"第 %1$@ 行，第 %2$@ 列：%3$@"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"第 %1$@ 行，第 %2$@ 欄：%3$@"}}}},
    "apps.failure.tooLarge": {"comment":"A custom section drew more rows or deeper nesting than cmux shows.","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"needs_review","value":"هذا القسم أكبر من أن يُعرض"}},"bs":{"stringUnit":{"state":"needs_review","value":"Ova sekcija je prevelika za prikaz"}},"da":{"stringUnit":{"state":"needs_review","value":"Denne sektion er for stor til at blive vist"}},"de":{"stringUnit":{"state":"needs_review","value":"Dieser Abschnitt ist zu groß für die Anzeige"}},"en":{"stringUnit":{"state":"translated","value":"This section is too large to show"}},"es":{"stringUnit":{"state":"needs_review","value":"Esta sección es demasiado grande para mostrarse"}},"fr":{"stringUnit":{"state":"needs_review","value":"Cette section est trop grande pour être affichée"}},"it":{"stringUnit":{"state":"needs_review","value":"Questa sezione è troppo grande per essere mostrata"}},"ja":{"stringUnit":{"state":"translated","value":"このセクションは大きすぎて表示できません"}},"km":{"stringUnit":{"state":"needs_review","value":"ផ្នែកនេះធំពេកមិនអាចបង្ហាញបាន"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 섹션은 너무 커서 표시할 수 없습니다"}},"nb":{"stringUnit":{"state":"needs_review","value":"Denne delen er for stor til å vises"}},"pl":{"stringUnit":{"state":"needs_review","value":"Ta sekcja jest zbyt duża, aby ją wyświetlić"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Esta seção é grande demais para ser exibida"}},"ru":{"stringUnit":{"state":"needs_review","value":"Этот раздел слишком большой для показа"}},"th":{"stringUnit":{"state":"needs_review","value":"ส่วนนี้ใหญ่เกินกว่าจะแสดงได้"}},"tr":{"stringUnit":{"state":"needs_review","value":"Bu bölüm gösterilemeyecek kadar büyük"}},"uk":{"stringUnit":{"state":"needs_review","value":"Цей розділ завеликий для показу"}},"vi":{"stringUnit":{"state":"needs_review","value":"Mục này quá lớn để hiển thị"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"此部分太大，无法显示"}},"zh-Hant":{"stringUnit":{"state":"ne