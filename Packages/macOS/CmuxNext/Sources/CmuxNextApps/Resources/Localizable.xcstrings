        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채팅 헤더의 배지에 에이전트가 기다리는 요청을 모두 표시하고, 한 번의 클릭으로 답할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et merke i chattens topp viser alt agentene dine venter på, med svar med ett klikk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plakietka w nagłówku czatu pokazuje wszystko, na co czekają twoi agenci, z odpowiedziami jednym kliknięciem."
