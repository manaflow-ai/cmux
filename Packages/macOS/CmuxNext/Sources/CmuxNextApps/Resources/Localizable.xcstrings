    "store.feature.calmMotion.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا شيء ينزلق أو يرتد أو يدور، وتبقى بطاقات التمرير مغلقة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ništa ne klizi, ne odskače i ne vrti se, a kartice pri prelasku ostaju zatvorene."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet glider, fjedrer eller drejer, og svævekort forbliver lukkede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts gleitet, federt oder dreht sich, und Hover-Karten bleiben geschlossen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing slides, springs or spins, and hover cards stay closed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada se desliza, rebota ni gira, y las tarjetas al pasar el puntero no se abren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien ne glisse, ne rebondit ni ne tourne, et les cartes au survol restent fermées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente scorre, rimbalza o ruota, e le schede al passaggio restano chiuse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スライド、バウンド、回転をせず、ホバーカードも開きません。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "គ្មានអ្វីរអិល លោត ឬវិលទេ ហើយកាតពេលដាក់ទស្សន៍ទ្រនិចនៅតែបិទ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미끄러지거나 튀거나 회전하지 않고, 호버 카드도 열리지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingenting glir, spretter eller snurrer, og svevekort forblir lukket."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic nie przesuwa się, nie odbija ani nie obraca, a karty po najechaniu się nie otwierają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada desliza, quica ou gira, e os cartões ao passar o cursor ficam fechados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не скользит, не пружинит и не вращается, а карточки при наведении не открываются."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีอะไรเลื่อน เด้ง หรือหมุน และการ์ดเมื่อชี้จะไม่เปิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiçbir şey kaymaz, sekmez ya da dönmez; üzerine gelince açılan kartlar kapalı kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ніщо не ковзає, не пружинить і не обертається, а картки під курсором не відкриваються."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không gì trượt, nảy hay xoay, và thẻ khi di chuột vẫn đóng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不再滑动、弹跳或旋转，悬停卡片也不会打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不再滑動、彈跳或旋轉，懸停卡片也不會打開。"
          }
        }
      }
    },
