        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold the pointer on a workspace to see its agents, branch and ports."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén el puntero sobre un espacio de trabajo para ver sus agentes, su rama y sus puertos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez le pointeur sur un espace de travail pour voir ses agents, sa branche et ses ports."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni il puntatore su uno spazio di lavoro per vederne agenti, branch e porte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークスペースにポインタを置くと、エージェント、ブランチ、ポートが表示されます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ដាក់ទស្សន៍ទ្រនិចលើកន្លែងធ្វើការ ដើម្បីមើលភ្នាក់ងារ សាខា និងច្រករបស់វា។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업 공간 위에 포인터를 두면 에이전트, 브랜치, 포트가 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold pekeren over et arbeidsområde for å se agentene, grenen og portene."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj wskaźnik nad obszarem roboczym, aby zobaczyć jego agentów, gałąź i porty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o cursor sobre um espaço de trabalho para ver seus agentes, branch e portas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задержите указатель на рабочем пространстве, чтобы увидеть его агентов, ветку и порты."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วางตัวชี้ค้างไว้บนเวิร์กสเปซเพื่อดูเอเจนต์ สาขา และพอร์ตของมัน"
