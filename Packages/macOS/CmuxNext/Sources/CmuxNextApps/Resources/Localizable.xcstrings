          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abra uma prévia do Cloud em um painel do navegador para publicá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
