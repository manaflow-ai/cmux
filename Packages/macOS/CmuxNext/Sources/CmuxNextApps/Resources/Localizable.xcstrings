    "store.feature.minimalSidebar.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر الأزرار فقط أثناء وجود المؤشر فوق الشريط الجانبي أو شريط علامات تبويب."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dugmad se prikazuju samo dok je pokazivač iznad bočne trake ili trake kartica."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knapper vises kun, mens markøren er over sidepanelet eller en fanelinje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasten erscheinen nur, solange der Zeiger über der Seitenleiste oder einer Tableiste ist."
