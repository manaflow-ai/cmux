    "store.feature.expandedSidebar.summary" : {
      "comment" : "App Store Features card: what the Expanded sidebar density does.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعرض كل مساحة عمل حالتها أو مجلدها وعمرها وطلب السحب الخاص بها تحت اسمها."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaki radni prostor ispod imena prikazuje status ili mapu, starost i pull request."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert arbejdsområde viser sin status eller mappe, sin alder og sin pull request under navnet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Arbeitsbereich zeigt unter seinem Namen Status oder Ordner, Alter und Pull-Request."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each workspace shows its status or folder, its age and its pull request under its name."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada espacio de trabajo muestra su estado o carpeta, su antigüedad y su pull request bajo su nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque espace de travail affiche sous son nom son statut ou son dossier, son âge et sa pull request."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni workspace mostra sotto il nome lo stato o la cartella, l'età e la pull request."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ワークスペースの名前の下に、ステータスまたはフォルダ、経過時間、プルリクエストを表示します。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "កន្លែងធ្វើការនីមួយៗបង្ហាញស្ថានភាព ឬថត អាយុ និង pull request នៅក្រោមឈ្មោះ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 워크스페이스 이름 아래에 상태나 폴더, 경과 시간, 풀 리퀘스트를 표시합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert arbeidsområde viser status eller mappe, alder og pull request under navnet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy obszar roboczy pokazuje pod nazwą status lub folder, wiek i pull request."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada espaço de trabalho mostra o status ou a pasta, a idade e o pull request abaixo do nome."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Под названием каждого рабочего пространства — статус или папка, давность и pull request."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แต่ละเวิร์กสเปซแสดงสถานะหรือโฟลเดอร์ อายุ และพูลรีเควสต์ใต้ชื่อ"
