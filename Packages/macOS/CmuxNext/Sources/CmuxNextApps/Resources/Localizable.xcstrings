    "store.feature.channels.summary" : {
      "comment" : "App Store Features card: what Channels adds.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القنوات أسفل الصفحة الرئيسية في الشريط الجانبي، لسلاسل المحادثات مع وكلائك وفريقك."
          }
        },
