    "store.feature.globalHotKey.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُظهر ⌃⌥⌘. كل نوافذ cmux أو يخفيها من أي تطبيق."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌃⌥⌘. prikazuje ili skriva sve cmux prozore iz bilo koje aplikacije."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌃⌥⌘. viser eller skjuler alle cmux-vinduer fra enhver app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌃⌥⌘. zeigt oder verbirgt alle cmux-Fenster aus jeder App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌃⌥⌘. shows or hides every cmux window from any app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌃⌥⌘. muestra u oculta todas las ventanas de cmux desde cualquier app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌃⌥⌘. affiche ou masque toutes les fenêtres cmux depuis n'importe quelle app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌃⌥⌘. mostra o nasconde tutte le finestre di cmux da qualsiasi app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのアプリからでも ⌃⌥⌘. で cmux のすべてのウインドウを表示・非表示にします。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌃⌥⌘. បង្ហាញ ឬលាក់បង្អួច cmux ទាំងអស់ពីកម្មវិធីណាមួយ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 앱에서든 ⌃⌥⌘.로 모든 cmux 창을 보이거나 숨깁니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌃⌥⌘. viser eller skjuler alle cmux-vinduer fra hvilken som helst app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌃⌥⌘. pokazuje lub ukrywa wszystkie okna cmux z dowolnej aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌃⌥⌘. mostra ou oculta todas as janelas do cmux a partir de qualquer app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌃⌥⌘. показывает или скрывает все окна cmux из любого приложения."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌃⌥⌘. แสดงหรือซ่อนหน้าต่าง cmux ทั้งหมดจากแอปใดก็ได้"
