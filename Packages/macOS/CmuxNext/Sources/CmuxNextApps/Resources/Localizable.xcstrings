    "store.feature.sessionTree.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر مساحات العمل التي بدأها وكيل تحت مساحة العمل التي بدأتها."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radni prostori koje je pokrenuo agent stoje ispod radnog prostora koji ih je pokrenuo."
