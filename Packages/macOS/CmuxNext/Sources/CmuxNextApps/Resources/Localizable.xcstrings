    "store.feature.workspacesAsTabs.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "سطر واحد لكل مساحة عمل، مثل الشريط الجانبي في Claude، ويبدّل ⌘⇧[ و ⌘⇧] بين مساحات العمل كما يبدّلان بين علامات التبويب."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jedan red po radnom prostoru, kao Claudeov bočni panel, a ⌘⇧[ i ⌘⇧] mijenjaju radne prostore kao što mijenjaju kartice."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Én linje pr. arbejdsområde, som Claudes sidebjælke, og ⌘⇧[ og ⌘⇧] skifter arbejdsområde, som de skifter fane."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine Zeile pro Arbeitsbereich, wie die Seitenleiste von Claude, und ⌘⇧[ und ⌘⇧] wechseln Arbeitsbereiche so, wie sie Tabs wechseln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One line per workspace, like Claude's sidebar, and ⌘⇧[ and ⌘⇧] switch workspaces the way they switch tabs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una línea por espacio de trabajo, como la barra lateral de Claude, y ⌘⇧[ y ⌘⇧] cambian de espacio de trabajo igual que cambian de pestaña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une ligne par espace de travail, comme la barre latérale de Claude, et ⌘⇧[ et ⌘⇧] changent d’espace de travail comme ils changent d’onglet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una riga per workspace, come la barra laterale di Claude, e ⌘⇧[ e ⌘⇧] cambiano workspace come cambiano scheda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Claudeのサイドバーのようにワークスペースを1行ずつ表示し、⌘⇧[ と ⌘⇧] でタブと同じようにワークスペースを切り替えます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "មួយបន្ទាត់ក្នុងមួយកន្លែងធ្វើការ ដូចរបារចំហៀងរបស់ Claude ហើយ ⌘⇧[ និង ⌘⇧] ប្តូរកន្លែងធ្វើការដូចប្តូរផ្ទាំង។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Claude의 사이드바처럼 워크스페이스마다 한 줄로 표시하며, ⌘⇧[ 와 ⌘⇧]로 탭처럼 워크스페이스를 전환합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Én linje per arbeidsområde, som sidepanelet i Claude, og ⌘⇧[ og ⌘⇧] bytter arbeidsområde slik de bytter fane."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jeden wiersz na obszar roboczy, jak na pasku bocznym Claude, a ⌘⇧[ i ⌘⇧] przełączają obszary robocze tak, jak karty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uma linha por espaço de trabalho, como a barra lateral do Claude, e ⌘⇧[ e ⌘⇧] alternam espaços de trabalho como alternam abas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Одна строка на рабочее пространство, как на боковой панели Claude, а ⌘⇧[ и ⌘⇧] переключают рабочие пространства так же, как вкладки."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "หนึ่งบรรทัดต่อเวิร์กสเปซ เหมือนแถบข้างของ Claude และ ⌘⇧[ กับ ⌘⇧] สลับเวิร์กสเปซเหมือนสลับแท็บ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Çalışma alanı başına tek satır, Claude’un kenar çubuğundaki gibi; ⌘⇧[ ve ⌘⇧] sekmeler gibi çalışma alanları arasında geçiş yapar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Один рядок на робочий простір, як на бічній панелі Claude, а ⌘⇧[ і ⌘⇧] перемикають робочі простори так само, як вкладки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Một dòng cho mỗi không gian làm việc, như thanh bên của Claude, và ⌘⇧[ và ⌘⇧] chuyển không gian làm việc giống như chuyển thẻ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每个工作区一行，就像 Claude 的侧边栏；⌘⇧[ 和 ⌘⇧] 切换工作区的方式与切换标签页相同。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每個工作區一行，就像 Claude 的側邊欄；⌘⇧[ 和 ⌘⇧] 切換工作區的方式與切換標籤頁相同。"
          }
        }
      }
    },
