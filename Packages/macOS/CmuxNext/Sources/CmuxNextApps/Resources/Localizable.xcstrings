    "store.feature.glass.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصبح النافذة زجاجية وتُظهر ما خلفها بشكل ضبابي."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
