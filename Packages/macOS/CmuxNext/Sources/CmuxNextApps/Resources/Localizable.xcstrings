    "appsTier.sidebar.publishHint" : {
      "comment" : "Shown when the publish row was clicked with no Cloud preview to publish.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "افتح معاينة Cloud في جزء متصفح لنشرها."
