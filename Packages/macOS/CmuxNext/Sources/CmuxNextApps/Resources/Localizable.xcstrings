    "store.feature.priorityView.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جرس أعلى الشريط الجانبي يرتّب محادثات وكلائك على كل جهاز حسب ما يحتاج إليك."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvono na vrhu bočne trake rangira razgovore s agentima na svim računarima po hitnosti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En klokke øverst i sidebjælken rangerer dine agentchats på alle maskiner efter, hvad der kræver dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
