    "store.feature.sidebarTimestamps.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض كل صف لمساحة عمل وقت آخر تغيير له، مثل 10:42 أو 3d."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaki red radnog prostora prikazuje kada se zadnji put promijenio, npr. 10:42 ili 3d."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver arbejdsområderække viser, hvornår den sidst ændrede sig, fx 10:42 eller 3d."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Arbeitsbereichszeile zeigt, wann sie sich zuletzt geändert hat, etwa 10:42 oder 3d."
