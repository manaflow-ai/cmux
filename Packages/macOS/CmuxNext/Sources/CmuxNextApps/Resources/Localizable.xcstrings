    "store.feature.homeItem.summary" : {
      "comment" : "App Store Features card summary: the Home item in the sidebar.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وكلاؤك ومحادثاتك وقنواتك، بنقرة واحدة من أعلى الشريط الجانبي."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaši agenti, razgovori i kanali, jedan klik s vrha bočne trake."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine agenter, chats og kanaler, ét klik fra toppen af sidepanelet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Agenten, Chats und Kanäle, einen Klick oben in der Seitenleiste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your agents, chats and channels, one click from the top of the sidebar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus agentes, chats y canales, a un clic desde la parte superior de la barra lateral."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos agents, discussions et canaux, à un clic en haut de la barre latérale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi agenti, chat e canali, a un clic dalla parte alta della barra laterale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェント、チャット、チャンネルに、サイドバーの上からワンクリックで。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ភ្នាក់ងារ ការជជែក និងឆានែលរបស់អ្នក ចុចតែម្ដងពីខាងលើរបារចំហៀង។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트, 채팅, 채널을 사이드바 맨 위에서 한 번에 엽니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agentene, chattene og kanalene dine, ett klikk fra toppen av sidefeltet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoi agenci, czaty i kanały jednym kliknięciem z góry paska bocznego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus agentes, chats e canais, a um clique do topo da barra lateral."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши агенты, чаты и каналы — в один клик сверху боковой панели."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เอเจนต์ แชท และช่องของคุณ คลิกเดียวจากด้านบนของแถบด้านข้าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajanlarınız, sohbetleriniz ve kanallarınız, kenar çubuğunun üstünden tek tıkla."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваші агенти, чати й канали — в один клік зверху бічної панелі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tác tử, cuộc trò chuyện và kênh của bạn, một cú nhấp từ đầu thanh bên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的智能体、聊天和频道，在边栏顶部一键即达。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的代理、聊天和頻道，在側邊欄頂端一鍵即達。"
          }
        }
      }
    },
