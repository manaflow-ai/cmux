          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не усыплять по 1 соседних вкладки с каждой стороны"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ให้แท็บข้างเคียงข้างละ 1 แท็บทำงานอยู่"
          }
        },
        "tr": {
