    "action.neighborTabs.off": {
      "comment": "Command palette action that sets browser.keepNeighborTabsAwake.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عدم إبقاء علامات التبويب المجاورة نشطة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ne drži susjedne kartice budnim"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hold ikke nabofaner vågne"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Benachbarte Tabs nicht wach halten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't Keep Neighbor Tabs Awake"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No mantener activas las pestañas vecinas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ne pas garder les onglets voisins actifs"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non mantenere attive le schede vicine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "隣のタブを起こしたままにしない"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កុំរក្សាផ្ទាំងជិតខាងឱ្យភ្ញាក់"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "인접한 탭 깨어 있게 유지 안 함"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ikke hold nabofaner våkne"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie utrzymuj sąsiednich kart w gotowości"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não manter abas vizinhas ativas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Усыплять соседние вкладки"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่ต้องให้แท็บข้างเคียงทำงานอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Komşu sekmeleri uyanık tutma"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Присипляти сусідні вкладки"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không giữ các tab lân cận hoạt động"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
