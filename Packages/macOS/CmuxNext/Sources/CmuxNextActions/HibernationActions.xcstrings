{
  "sourceLanguage": "en",
  "strings": {
    "workspaceHibernation.allowHibernation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "السماح لمساحة العمل بالإسبات"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dozvoli hibernaciju radnog prostora"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lad arbejdsområdet gå i dvale"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ruhezustand für Arbeitsbereich erlauben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Workspace to Hibernate"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permitir que el espacio de trabajo hiberne"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autoriser la mise en veille de l’espace de travail"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consenti l’ibernazione dello spazio di lavoro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースのハイバネートを許可"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អនុញ្ញាតឱ្យកន្លែងធ្វើការផ្អាក"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "워크스페이스 최대 절전 허용"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La arbeidsområdet gå i dvale"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zezwól na hibernację obszaru roboczego"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permitir que o espaço de trabalho hiberne"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Разрешить гибернацию пространства"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อนุญาตให้พื้นที่ทำงานพัก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Çalışma alanının hazırda beklemesine izin ver"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дозволити гібернацію простору"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cho phép không gian làm việc ngủ đông"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "允许工作区休眠"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "允許工作區休眠"
          }
        }
      }
    },
    "workspaceHibernation.refusal.shown": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يمكن إسبات مساحة عمل معروضة على الشاشة. انتقل إلى مساحة عمل أخرى أولًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Radni prostor na ekranu ne može hibernirati. Prvo pređite na drugi radni prostor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et arbejdsområde på skærmen kan ikke gå i dvale. Skift først til et andet arbejdsområde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein angezeigter Arbeitsbereich kann nicht ruhen. Wechseln Sie zuerst zu einem anderen Arbeitsbereich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A workspace on screen cannot hibernate. Switch to another workspace first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un espacio de trabajo en pantalla no puede hibernar. Cambia primero a otro espacio de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un espace de travail affiché ne peut pas se mettre en veille. Passez d’abord à un autre espace de travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uno spazio di lavoro sullo schermo non può andare in ibernazione. Passa prima a un altro spazio di lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示中のワークスペースはハイバネートできません。先に別のワークスペースに切り替えてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កន្លែងធ្វើការលើអេក្រង់មិនអាចផ្អាកបានទេ។ សូមប្តូរទៅកន្លែងធ្វើការផ្សេងសិន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "화면에 표시된 워크스페이스는 최대 절전 상태로 만들 수 없습니다. 먼저 다른 워크스페이스로 전환하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et arbeidsområde på skjermen kan ikke gå i dvale. Bytt til et annet arbeidsområde først."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obszar roboczy widoczny na ekranie nie może hibernować. Najpierw przełącz się na inny obszar roboczy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um espaço de trabalho na tela não pode hibernar. Mude para outro espaço de trabalho primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пространство на экране не может перейти в гибернацию. Сначала переключитесь на другое пространство."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "พื้นที่ทำงานที่แสดงอยู่บนหน้าจอพักไม่ได้ โปรดสลับไปพื้นที่ทำงานอื่นก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ekrandaki bir çalışma alanı hazırda bekleyemez. Önce başka bir çalışma alanına geçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Простір на екрані не може перейти в гібернацію. Спершу перейдіть до іншого простору."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không gian làm việc đang hiển thị không thể ngủ đông. Hãy chuyển sang không gian làm việc khác trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "屏幕上显示的工作区无法休眠。请先切换到其他工作区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "螢幕上顯示的工作區無法休眠。請先切換到其他工作區。"
          }
        }
      }
    },
