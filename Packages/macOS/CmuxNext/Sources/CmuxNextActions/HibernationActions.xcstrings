{
  "sourceLanguage": "en",
  "strings": {
    "action.neighborTabs.off": {
      "comment": "Command palette action that sets browser.keepNeighborTabsAwake.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عدم إبقاء علامات التبويب المجاورة نشطة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ne drži susjedne kartice budnim"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hold ikke nabofaner vågne"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Benachbarte Tabs nicht wach halten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't Keep Neighbor Tabs Awake"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No mantener activas las pestañas vecinas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ne pas garder les onglets voisins actifs"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non mantenere attive le schede vicine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "隣のタブを起こしたままにしない"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កុំរក្សាផ្ទាំងជិតខាងឱ្យភ្ញាក់"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "인접한 탭 깨어 있게 유지 안 함"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ikke hold nabofaner våkne"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie utrzymuj sąsiednich kart w gotowości"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não manter abas vizinhas ativas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Усыплять соседние вкладки"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่ต้องให้แท็บข้างเคียงทำงานอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Komşu sekmeleri uyanık tutma"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Присипляти сусідні вкладки"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không giữ các tab lân cận hoạt động"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "不保持相邻标签页唤醒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "不保持相鄰分頁喚醒"
          }
        }
      }
    },
    "action.neighborTabs.one": {
      "comment": "Command palette action that sets browser.keepNeighborTabsAwake.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إبقاء 1 من علامات التبويب المجاورة نشطة على كل جانب"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Drži 1 susjedne kartice budnim sa svake strane"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hold 1 nabofane vågne på hver side"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 benachbarte Tabs auf jeder Seite wach halten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep 1 Neighbor Tab Awake on Each Side"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mantener activas 1 pestañas vecinas a cada lado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Garder 1 onglets voisins actifs de chaque côté"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mantieni attive 1 schede vicine per lato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "両側の隣のタブを1つずつ起こしたままにする"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "រក្សាផ្ទាំងជិតខាង 1 នៅសងខាងឱ្យភ្ញាក់"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "양쪽 인접한 탭 1개씩 깨어 있게 유지"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hold 1 nabofaner våkne på hver side"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utrzymuj 1 sąsiednie karty z każdej strony w gotowości"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Manter 1 abas vizinhas ativas de cada lado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не усыплять по 1 соседних вкладки с каждой стороны"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ให้แท็บข้างเคียงข้างละ 1 แท็บทำงานอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her iki yanda 1 komşu sekmeyi uyanık tut"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не присипляти по 1 сусідні вкладки з кожного боку"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Giữ 1 tab lân cận mỗi bên luôn hoạt động"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每侧保持 1 个相邻标签页唤醒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每側保持 1 個相鄰分頁喚醒"
          }
        }
      }
    },
