    "action.neighborTabs.one": {
      "comment": "Command palette action that sets browser.keepNeighborTabsAwake.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إبقاء 1 من علامات التبويب المجاورة نشطة على كل جانب"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Drži 1 susjedne kartice budnim sa svake strane"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hold 1 nabofane vågne på hver side"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 benachbarte Tabs auf jeder Seite wach halten"
