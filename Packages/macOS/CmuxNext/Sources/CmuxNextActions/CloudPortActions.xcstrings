        "fr": {"stringUnit": {"state": "needs_review", "value": "Fermer un port redirigé de la machine…"}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Cerrar puerto reenviado de la máquina…"}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "إغلاق منفذ الجهاز المُعاد توجيهه…"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "전달된 머신 포트 닫기…"}},
