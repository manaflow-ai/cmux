{
  "sourceLanguage": "en",
  "strings": {
    "action.cloudOpenBrowser": {
      "comment": "Command title: opens a port of a Cloud machine in a cmux browser tab.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Open Machine Port in Browser…"}},
        "ja": {"stringUnit": {"state": "translated", "value": "マシンのポートをブラウザで開く…"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Maschinenport im Browser öffnen…"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Ouvrir le port de la machine dans le navigateur…"}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Abrir puerto de la máquina en el navegador…"}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "فتح منفذ الجهاز في المتصفح…"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "머신 포트를 브라우저에서 열기…"}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "在浏览器中打开机器端口…"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "在瀏覽器中開啟機器連接埠…"}}
      }
    },
    "action.cloudPortList": {
      "comment": "Command title: lists the ports of a Cloud machine forwarded to this Mac.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "List Forwarded Machine Ports"}},
        "ja": {"stringUnit": {"state": "translated", "value": "転送中のマシンポートを一覧表示"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Weitergeleitete Maschinenports auflisten"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Lister les ports de la machine redirigés"}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Ver puertos reenviados de la máquina"}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "عرض منافذ الجهاز المُعاد توجيهها"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "전달된 머신 포트 목록"}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "列出已转发的机器端口"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "列出已轉送的機器連接埠"}}
      }
    },
    "action.cloudPortForward": {
      "comment": "Command title: forwards a port of a Cloud machine to a port on this Mac.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Forward Machine Port…"}},
        "ja": {"stringUnit": {"state": "translated", "value": "マシンのポートを転送…"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Maschinenport weiterleiten…"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Rediriger un port de la machine…"}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Reenviar puerto de la máquina…"}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "إعادة توجيه منفذ الجهاز…"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "머신 포트 전달…"}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "转发机器端口…"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "轉送機器連接埠…"}}
      }
    },
    "action.cloudPortClose": {
      "comment": "Command title: stops forwarding a port of a Cloud machine to this Mac.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Close Forwarded Machine Port…"}},
        "ja": {"stringUnit": {"state": "translated", "value": "転送中のマシンポートを閉じる…"}},
