  "strings": {
    "action.autoArchive.debugAge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Age Workspaces for Auto-Archive"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تقديم عمر مساحات العمل للأرشفة التلقائية"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Postari radne prostore za automatsko arhiviranje"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ældr arbejdsområder til automatisk arkivering"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arbeitsbereiche für automatisches Archivieren altern lassen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envejecer espacios para el archivado automático"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vieillir les espaces pour l’archivage automatique"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Invecchia gli spazi per l’archiviazione automatica"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "自動アーカイブ用にワークスペースを古くする"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បង្កើនអាយុកន្លែងធ្វើការសម្រាប់ការទុកក្នុងប័ណ្ណសារដោយស្វ័យប្រវត្តិ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "자동 보관용으로 워크스페이스를 오래된 것으로 만들기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eldre arbeidsområder for automatisk arkivering"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Postarz obszary robocze dla automatycznej archiwizacji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envelhecer espaços para arquivamento automático"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Состарить рабочие пространства для автоархивации"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ทำให้เวิร์กสเปซเก่าเพื่อทดสอบการเก็บถาวรอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otomatik arşivleme için çalışma alanlarını eskit"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Зістарити робочі простори для автоархівування"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Làm cũ không gian làm việc cho tự động lưu trữ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "为自动归档使工作区变旧"
