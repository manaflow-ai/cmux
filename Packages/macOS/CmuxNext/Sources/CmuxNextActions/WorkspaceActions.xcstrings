    "action.pane.moveToNewWorkspace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Pane to New Workspace"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "نقل الجزء إلى مساحة عمل جديدة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Premjesti okno u novi radni prostor"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Flyt rude til nyt arbejdsområde"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bereich in neuen Arbeitsbereich verschieben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mover panel a un espacio de trabajo nuevo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Déplacer le volet vers un nouvel espace de travail"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sposta riquadro in un nuovo spazio di lavoro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ペインを新規ワークスペースへ移動"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្លាស់ទីផ្ទាំងទៅកន្លែងធ្វើការថ្មី"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "창을 새 작업 공간으로 이동"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Flytt rute til nytt arbeidsområde"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przenieś panel do nowego obszaru roboczego"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mover painel para novo espaço de trabalho"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Переместить панель в новое рабочее пространство"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ย้ายแผงไปยังพื้นที่ทำงานใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bölmeyi yeni çalışma alanına taşı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перемістити панель у новий робочий простір"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chuyển ngăn sang không gian làm việc mới"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将窗格移到新工作区"
