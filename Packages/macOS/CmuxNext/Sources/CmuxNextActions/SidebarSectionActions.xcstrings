        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznacz czat jako przeczytany…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcar conversa como lida…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметить чат как прочитанный…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำเครื่องหมายแชทว่าอ่านแล้ว…"
          }
