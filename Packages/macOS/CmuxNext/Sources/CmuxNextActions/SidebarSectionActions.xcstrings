        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbeti okundu olarak işaretle…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначити чат як прочитаний…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh dấu cuộc trò chuyện đã đọc…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将聊天标记为已读…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將聊天標示為已讀…"
          }
        }
      }
