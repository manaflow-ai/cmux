    "action.sidebar.section.closeWorkspaces": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close All Workspaces in Section"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セクション内のすべてのワークスペースを閉じる"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إغلاق كل مساحات العمل في القسم"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zatvori sve radne prostore u odjeljku"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Luk alle arbejdsområder i sektionen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle Arbeitsbereiche im Abschnitt schließen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cerrar todos los espacios de trabajo de la sección"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fermer tous les espaces de travail de la section"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chiudi tutte le aree di lavoro nella sezione"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បិទកន្លែងធ្វើការទាំងអស់ក្នុងផ្នែក"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "섹션의 모든 작업 공간 닫기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lukk alle arbeidsområder i seksjonen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zamknij wszystkie przestrzenie robocze w sekcji"
          }
