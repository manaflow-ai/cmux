        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Закрыть все рабочие пространства в разделе"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ปิดเวิร์กสเปซทั้งหมดในส่วน"
          }
