    "action.sidebar.priority.markRead": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وضع علامة على الدردشة كمقروءة…"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Označi chat kao pročitan…"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Markér chat som læst…"
          }
        },
        "de": {
          "stringUnit": {
