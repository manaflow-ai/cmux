{
  "sourceLanguage": "en",
  "strings": {
    "action.certificateWarning.goBack": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الرجوع من تحذير الشهادة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nazad sa upozorenja o certifikatu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gå tilbage fra certifikatadvarsel"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Von der Zertifikatswarnung zurückgehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go Back from Certificate Warning"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volver desde la advertencia de certificado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Revenir depuis l’avertissement de certificat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Torna indietro dall’avviso sul certificato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "証明書の警告から戻る"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ថយក្រោយពីការព្រមានអំពីវិញ្ញាបនបត្រ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "인증서 경고에서 뒤로 가기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gå tilbake fra sertifikatadvarsel"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wróć z ostrzeżenia o certyfikacie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voltar do aviso de certificado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вернуться со страницы предупреждения о сертификате"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ย้อนกลับจากคำเตือนใบรับรอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sertifika uyarısından geri dön"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Повернутися зі сторінки попередження про сертифікат"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quay lại từ cảnh báo chứng chỉ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "从证书警告返回"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "從憑證警告返回"
          }
        }
      }
    },
    "action.certificateWarning.proceed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "المتابعة رغم تحذير الشهادة (غير آمن)"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nastavi uprkos upozorenju o certifikatu (nesigurno)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fortsæt trods certifikatadvarsel (usikkert)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trotz Zertifikatswarnung fortfahren (unsicher)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proceed Past Certificate Warning (Unsafe)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Continuar pese a la advertencia de certificado (no seguro)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Continuer malgré l’avertissement de certificat (dangereux)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Procedi nonostante l’avviso sul certificato (non sicuro)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "証明書の警告を無視して続行（安全ではありません）"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បន្តទោះមានការព្រមានអំពីវិញ្ញាបនបត្រ (មិនមានសុវត្ថិភាព)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "인증서 경고를 무시하고 계속 (안전하지 않음)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fortsett tross sertifikatadvarsel (usikkert)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kontynuuj mimo ostrzeżenia o certyfikacie (niebezpieczne)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Continuar apesar do aviso de certificado (não seguro)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Продолжить, несмотря на предупреждение о сертификате (небезопасно)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ดำเนินการต่อแม้มีคำเตือนใบรับรอง (ไม่ปลอดภัย)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sertifika uyarısına rağmen devam et (güvenli değil)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Продовжити попри попередження про сертифікат (небезпечно)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiếp tục bất chấp cảnh báo chứng chỉ (không an toàn)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "忽略证书警告并继续（不安全）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "忽略憑證警告並繼續（不安全）"
          }
        }
      }
    },
