    "action.cloudStartSession": {
      "comment": "Command title: starts an agent session (Claude, Codex, ...) on a Cloud machine.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Start Agent Session on Cloud Machine…"}},
        "ja": {"stringUnit": {"state": "translated", "value": "Cloud マシンでエージェントセッションを開始…"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Agent-Sitzung auf Cloud-Maschine starten…"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Démarrer une session d'agent sur une machine Cloud…"}},
