    "action.cloudRelayChat": {
      "comment": "Command title: sends a prompt to an agent on a Cloud machine over the machine's relay, without a link to the machine.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Chat on Cloud Machine over the Relay…"}},
        "ja": {"stringUnit": {"state": "translated", "value": "リレー経由で Cloud マシンとチャット…"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Über das Relay mit der Cloud-Maschine chatten…"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Discuter sur la machine Cloud via le relais…"}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Chatear en la máquina Cloud mediante el relé…"}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "الدردشة على جهاز Cloud عبر المرحّل…"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "릴레이를 통해 Cloud 머신에서 채팅…"}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "通过中继在 Cloud 机器上聊天…"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "透過中繼在 Cloud 機器上聊天…"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Chat na Cloud mašini preko releja…"}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Chat på Cloud-maskinen via relæet…"}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Chatta sulla macchina Cloud tramite il relay…"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ជជែកលើម៉ាស៊ីន Cloud តាមរយៈ relay…"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Chat på Cloud-maskinen via reléet…"}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Czat na maszynie Cloud przez przekaźnik…"}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Conversar na Máquina Cloud pelo Relay…"}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Чат на машине Cloud через ретранслятор…"}},
        "th": {"stringUnit": {"state": "needs_review", "value": "แชทบนเครื่อง Cloud ผ่านรีเลย์…"}},
