    "action.cloud.chiefComputer": {
      "comment": "Command title: a Chief that runs on this Mac uses its own Cloud computer (screenshot, click, type).",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Use Chief’s Own Computer…"}},
        "ar": {"stringUnit": {"state": "translated", "value": "استخدام كمبيوتر Chief الخاص…"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Koristi vlastiti računar Chiefa…"}},
        "da": {"stringUnit": {"state": "translated", "value": "Brug Chiefs egen computer…"}},
        "de": {"stringUnit": {"state": "translated", "value": "Eigenen Computer des Chiefs verwenden…"}},
        "es": {"stringUnit": {"state": "translated", "value": "Usar el ordenador propio del Chief…"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Utiliser l’ordinateur dédié du Chief…"}},
        "it": {"stringUnit": {"state": "translated", "value": "Usa il computer dedicato del Chief…"}},
        "ja": {"stringUnit": {"state": "translated", "value": "Chief 専用のコンピュータを使用…"}},
        "km": {"stringUnit": {"state": "translated", "value": "ប្រើកុំព្យូទ័រផ្ទាល់ខ្លួនរបស់ Chief…"}},
        "ko": {"stringUnit": {"state": "translated", "value": "Chief 전용 컴퓨터 사용…"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Bruk Chiefs egen datamaskin…"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Użyj własnego komputera Chiefa…"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Usar o computador próprio do Chief…"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Использовать собственный компьютер Chief…"}},
        "th": {"stringUnit": {"state": "translated", "value": "ใช้คอมพิวเตอร์ของ Chief เอง…"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Chief’in kendi bilgisayarını kullan…"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Використати власний комп’ютер Chief…"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Dùng máy tính riêng của Chief…"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "使用 Chief 的专属电脑…"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "使用 Chief 的專屬電腦…"}}
      }
    },
