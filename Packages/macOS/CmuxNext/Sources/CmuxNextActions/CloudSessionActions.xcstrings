{
  "sourceLanguage": "en",
  "strings": {
    "action.cloudStartSession": {
      "comment": "Command title: starts an agent session (Claude, Codex, ...) on a Cloud machine.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Start Agent Session on Cloud Machine…"}},
        "ja": {"stringUnit": {"state": "translated", "value": "Cloud マシンでエージェントセッションを開始…"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Agent-Sitzung auf Cloud-Maschine starten…"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Démarrer une session d'agent sur une machine Cloud…"}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Iniciar sesión de agente en una máquina de Cloud…"}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "بدء جلسة وكيل على جهاز Cloud…"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "Cloud 머신에서 에이전트 세션 시작…"}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "在 Cloud 机器上启动代理会话…"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "在 Cloud 機器上啟動代理工作階段…"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Pokreni sesiju agenta na Cloud mašini…"}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Start agentsession på Cloud-maskine…"}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Avvia sessione agente sulla macchina Cloud…"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ចាប់ផ្ដើមវគ្គភ្នាក់ងារនៅលើម៉ាស៊ីន Cloud…"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Start agentøkt på Cloud-maskin…"}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Uruchom sesję agenta na maszynie Cloud…"}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Iniciar Sessão de Agente na Máquina do Cloud…"}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Запустить сеанс агента на машине Cloud…"}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เริ่มเซสชันเอเจนต์บนเครื่อง Cloud…"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Cloud Makinesinde Ajan Oturumu Başlat…"}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Запустити сеанс агента на машині Cloud…"}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Bắt đầu phiên tác tử trên máy Cloud…"}}
      }
    },
