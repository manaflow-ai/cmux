{
  "sourceLanguage": "en",
  "strings": {
    "refusal.agentChat.noChat": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل %@ في دردشات الوكيل. ركّز على إحداها أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ funktioniert in Agent-Chats. Fokussiere zuerst einen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ works in agent chats. Focus one first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ funciona en chats de agente. Enfoca uno primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fonctionne dans les chats d’agent. Mettez-en un au premier plan d’abord."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はエージェントチャットで使えます。先にチャットにフォーカスしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 기능은 에이전트 채팅에서 작동합니다. 먼저 채팅에 포커스하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 可在智能体聊天中使用。请先聚焦一个聊天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 可在代理聊天中使用。請先聚焦一個聊天。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ radi u agent četovima. Prvo fokusirajte jedan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ virker i agentchats. Fokuser på en først."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ funziona nelle chat dell’agente. Seleziona prima una chat."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ដំណើរការក្នុងការជជែកភ្នាក់ងារ។ សូមផ្ដោតលើការជជែកមួយជាមុនសិន។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fungerer i agentchatter. Fokuser på en først."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ działa w czatach agenta. Najpierw ustaw fokus na czacie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ funciona em chats de agente. Foque um primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ работает в чатах агента. Сначала перейдите в чат."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ใช้ได้ในแชตเอเจนต์ โปรดโฟกัสแชตก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ajan sohbetlerinde çalışır. Önce bir sohbete odaklanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ працює в чатах агента. Спершу перейдіть у чат."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hoạt động trong các cuộc trò chuyện với tác tử. Hãy chọn một cuộc trò chuyện trước."
          }
        }
      }
    },
    "refusal.agentChat.notStarted": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل %@ بعد بدء الدردشة."
          }
        },
