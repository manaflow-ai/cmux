            "value": "%@ はチャットが始まってから使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 기능은 채팅이 시작된 후에 작동합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需在聊天开始后使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需在聊天開始後使用。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ radi kada čet počne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ virker, når chatten er startet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ funziona dopo che la chat è iniziata."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ដំណើរការបន្ទាប់ពីការជជែកបានចាប់ផ្ដើម។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fungerer når chatten har startet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ działa po rozpoczęciu czatu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ funciona depois que o chat começa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ работает после начала чата."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ใช้ได้เมื่อแชตเริ่มแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sohbet başladıktan sonra çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ працює після початку чату."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hoạt động sau khi cuộc trò chuyện đã bắt đầu."
          }
        }
      }
    },
