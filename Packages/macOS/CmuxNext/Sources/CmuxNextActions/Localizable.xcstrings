          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ n’a pas été appliqué : %2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ non è stato applicato: %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ を適用できませんでした: %2$@"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ មិនបានអនុវត្ត៖ %2$@"
