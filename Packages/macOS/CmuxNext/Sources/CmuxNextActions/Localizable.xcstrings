{
  "sourceLanguage": "en",
  "strings": {
    "action.effect.failed": {
      "comment": "Shown when an action's change was undone because the daemon refused it. %1$@ is the action title, %2$@ the reason.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ did not apply: %2$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يُطبَّق %1$@: %2$@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ nije primijenjeno: %2$@"
          }
        },
