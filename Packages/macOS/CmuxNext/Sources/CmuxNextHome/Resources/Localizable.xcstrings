    "home.composer.attach.folder": {
      "comment": "Home composer notice when a folder or package is dropped or picked; only files attach; %@ is the folder name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is a folder. Attach the files in it, or a ZIP of the folder."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» مجلد. أرفق الملفات الموجودة فيه، أو ملف ZIP للمجلد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%@“ je mapa. Priložite datoteke iz nje ili ZIP arhivu mape."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” er en mappe. Vedhæft filerne i den eller en ZIP-fil af mappen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist ein Ordner. Hänge die Dateien darin oder ein ZIP-Archiv des Ordners an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» es una carpeta. Adjunta los archivos que contiene o un ZIP de la carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est un dossier. Joignez les fichiers qu’il contient ou une archive ZIP du dossier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” è una cartella. Allega i file che contiene o un archivio ZIP della cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はフォルダです。中のファイルか、フォルダのZIPを添付してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” គឺជាថត។ ភ្ជាប់ឯកសារនៅក្នុងវា ឬឯកសារ ZIP នៃថតនោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”은(는) 폴더입니다. 폴더 안의 파일이나 폴더의 ZIP 파일을 첨부하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%@» er en mappe. Legg ved filene i den, eller en ZIP-fil av mappen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%@” to folder. Załącz pliki z folderu lub jego archiwum ZIP."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” é uma pasta. Anexe os arquivos dela ou um ZIP da pasta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%@» — это папка. Прикрепите файлы из неё или ZIP-архив папки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” เป็นโฟลเดอร์ แนบไฟล์ในโฟลเดอร์ หรือไฟล์ ZIP ของโฟลเดอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” bir klasör. İçindeki dosyaları veya klasörün ZIP arşivini ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%@» — це папка. Прикріпіть файли з неї або ZIP-архів папки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” là một thư mục. Hãy đính kèm các tệp trong đó hoặc tệp ZIP của thư mục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是文件夹。请附加其中的文件，或该文件夹的 ZIP 压缩包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」是檔案夾。請附加其中的檔案，或該檔案夾的 ZIP 壓縮檔。"
          }
        }
      }
    },
    "home.voice.microphoneDenied": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج الإملاء إلى الوصول إلى الميكروفون. فعّله لـ cmux في إعدادات النظام."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktiranje treba pristup mikrofonu. Uključite ga za cmux u Postavkama sistema."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering kræver adgang til mikrofonen. Slå den til for cmux i Systemindstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktieren braucht Zugriff auf das Mikrofon. Aktiviere ihn für cmux in den Systemeinstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictation needs microphone access. Turn it on for cmux in System Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dictado necesita acceso al micrófono. Actívalo para cmux en Ajustes del Sistema."
          }
        },
        "fr": {
