    "homeDock.switch.channelsOff": {
      "comment": "Refusal of Switch Home View (channels) while the Channels entry is off.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Channels is off. Turn it on with Enable Channels in the command palette."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القنوات متوقفة. شغّلها باستخدام «تفعيل القنوات» في لوحة الأوامر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kanali su isključeni. Uključite ih naredbom „Uključi kanale” u paleti naredbi."
