        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지를 보낼 수 있는 사람은 모두 이미 참여하고 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle du kan sende melding til, er allerede med."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie osoby, do których możesz pisać, już tu są."
