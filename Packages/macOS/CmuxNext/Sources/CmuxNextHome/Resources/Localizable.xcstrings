          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanäle sind aus. Schalte sie in der Befehlspalette mit „Kanäle aktivieren“ ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los canales están desactivados. Actívalos con Activar canales en la paleta de comandos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les canaux sont désactivés. Activez-les avec Activer les canaux dans la palette de commandes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I canali sono disattivati. Attivali con Attiva canali nella palette dei comandi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャンネルはオフです。コマンドパレットの「チャンネルを有効にする」でオンにしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ឆានែលត្រូវបានបិទ។ បើកវាដោយ «បើកឆានែល» ក្នុងផ្ទាំងពាក្យបញ្ជា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채널이 꺼져 있습니다. 명령 팔레트에서 채널 켜기로 켜세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kanaler er slått av. Slå dem på med Slå på kanaler i kommandopaletten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kanały są wyłączone. Włącz je poleceniem Włącz kanały w palecie poleceń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os canais estão desativados. Ative-os com Ativar canais na paleta de comandos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Каналы отключены. Включите их командой «Включить каналы» в палитре команд."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ช่องปิดอยู่ เปิดได้ด้วยคำสั่ง เปิดใช้ช่อง ในชุดคำสั่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kanallar kapalı. Komut paletinde Kanalları Etkinleştir ile açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Канали вимкнено. Увімкніть їх командою «Увімкнути канали» в палітрі команд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kênh đang tắt. Hãy bật bằng lệnh Bật kênh trong bảng lệnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频道已关闭。请在命令面板中使用“启用频道”打开。"
