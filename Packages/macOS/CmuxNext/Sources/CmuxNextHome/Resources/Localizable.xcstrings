          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief отвечает, только когда вы @упоминаете его или отвечаете ему."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief จะตอบเฉพาะเมื่อคุณ @กล่าวถึงหรือตอบกลับเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Chief yalnızca onu @andığınızda veya ona yanıt verdiğinizde yanıtlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief відповідає лише тоді, коли ви @згадуєте його або відповідаєте йому."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief chỉ trả lời khi bạn @nhắc đến hoặc trả lời nó."
