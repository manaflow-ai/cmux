    "home.chief.backend.uniiHint": {
      "comment": "One line under the New Chief backend popup and the Chief Settings harness picker when UniiChat is chosen. `unii login` is a command; do not translate it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs on your UniiChat account. Sign in first with `unii login`."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل على حساب UniiChat الخاص بك. سجّل الدخول أولًا باستخدام `unii login`."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Radi na vašem UniiChat računu. Prvo se prijavite pomoću `unii login`."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kører på din UniiChat-konto. Log først ind med `unii login`."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft mit deinem UniiChat-Konto. Melde dich zuerst mit `unii login` an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona con tu cuenta de UniiChat. Inicia sesión primero con `unii login`."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne avec votre compte UniiChat. Connectez-vous d’abord avec `unii login`."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Funziona con il tuo account UniiChat. Accedi prima con `unii login`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniiChat アカウントで動作します。先に `unii login` でサインインしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ដំណើរការលើគណនី UniiChat របស់អ្នក។ ចូលជាមុនសិនដោយប្រើ `unii login`។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniiChat 계정으로 실행됩니다. 먼저 `unii login`으로 로그인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kjører på UniiChat-kontoen din. Logg på først med `unii login`."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Działa na Twoim koncie UniiChat. Najpierw zaloguj się za pomocą `unii login`."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Funciona com sua conta do UniiChat. Entre primeiro com `unii login`."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Работает с вашей учётной записью UniiChat. Сначала войдите с помощью `unii login`."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ทำงานด้วยบัญชี UniiChat ของคุณ ลงชื่อเข้าใช้ก่อนด้วย `unii login`"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "UniiChat hesabınızla çalışır. Önce `unii login` ile oturum açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Працює з вашим обліковим записом UniiChat. Спершу увійдіть за допомогою `unii login`."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chạy trên tài khoản UniiChat của bạn. Hãy đăng nhập trước bằng `unii login`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你的 UniiChat 账户运行。请先用 `unii login` 登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你的 UniiChat 帳號執行。請先使用 `unii login` 登入。"
          }
        }
      }
    },
