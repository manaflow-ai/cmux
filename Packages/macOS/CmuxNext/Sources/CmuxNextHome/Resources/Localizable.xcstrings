    "home.groupInfo.chiefReplies.auto.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Chief answers when you @mention it or reply to it. With only you and one Chief, it answers every message."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرد Chief عندما تشير إليه بـ @ أو ترد على رسالته. إذا كنت أنت و Chief واحد فقط، فإنه يرد على كل رسالة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief odgovara kad ga @spomenete ili odgovorite na njegovu poruku. Kad ste samo vi i jedan Chief, odgovara na svaku poruku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En Chief svarer, når du @omtaler den eller svarer på den. Når der kun er dig og én Chief, svarer den på hver besked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Chief antwortet, wenn du ihn @erwähnst oder auf ihn antwortest. Bist nur du mit einem Chief im Chat, antwortet er auf jede Nachricht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Chief responde cuando lo @mencionas o le respondes. Si solo estáis tú y un Chief, responde a cada mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Chief répond quand vous le @mentionnez ou lui répondez. S’il n’y a que vous et un Chief, il répond à chaque message."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Chief risponde quando lo @menzioni o gli rispondi. Se ci siete solo tu e un Chief, risponde a ogni messaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief は @メンションまたは返信されたときに答えます。あなたと Chief 1 人だけのときは、すべてのメッセージに答えます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief ឆ្លើយតបនៅពេលអ្នក @លើកឡើង ឬឆ្លើយតបវា។ ពេលមានតែអ្នក និង Chief មួយ វាឆ្លើយតបគ្រប់សារ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief는 @멘션하거나 답장할 때 응답합니다. 나와 Chief 하나만 있으면 모든 메시지에 응답합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En Chief svarer når du @omtaler den eller svarer på den. Når det bare er deg og én Chief, svarer den på hver melding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief odpowiada, gdy go @wspomnisz lub odpowiesz na jego wiadomość. Gdy jesteś tylko ty i jeden Chief, odpowiada na każdą wiadomość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Chief responde quando você o @menciona ou responde a ele. Se forem só você e um Chief, ele responde a cada mensagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief отвечает, когда вы @упоминаете его или отвечаете ему. Если в чате только вы и один Chief, он отвечает на каждое сообщение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief จะตอบเมื่อคุณ @กล่าวถึงหรือตอบกลับ ถ้ามีแค่คุณกับ Chief หนึ่งตัว จะตอบทุกข้อความ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Chief, onu @andığınızda veya ona yanıt verdiğinizde yanıtlar. Yalnızca siz ve bir Chief varsa her mesaja yanıt verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief відповідає, коли ви @згадуєте його або відповідаєте йому. Якщо в чаті лише ви й один Chief, він відповідає на кожне повідомлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief trả lời khi bạn @nhắc đến hoặc trả lời nó. Khi chỉ có bạn và một Chief, nó trả lời mọi tin nhắn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你 @ 或回复 Chief 时，它会回答。只有你和一个 Chief 时，它会回答每条消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當你 @ 或回覆 Chief 時，它會回答。只有你和一個 Chief 時，它會回答每則訊息。"
          }
        }
      }
    },
    "home.groupInfo.chiefReplies.mentions.detail": {
      "extractionState": "manual",
      "localizations": {
