    "home.outcome.notReachable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can’t message %@ yet. Invite them by email instead."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكنك مراسلة %@ بعد. ادعهم عبر البريد الإلكتروني بدلاً من ذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Još ne možete pisati %@. Umjesto toga ih pozovite e-poštom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du kan ikke skrive til %@ endnu. Inviter dem via e-mail i stedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst %@ noch nicht schreiben. Lade die Person stattdessen per E-Mail ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no puedes escribir a %@. Envíale una invitación por correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez pas encore écrire à %@. Invitez cette personne par e-mail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non puoi ancora scrivere a %@. Invitalo via email."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にはまだメッセージを送れません。代わりにメールで招待してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អ្នកមិនទាន់អាចផ្ញើសារទៅ %@ បានទេ។ សូមអញ្ជើញតាមអ៊ីមែលជំនួសវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 %@님에게 메시지를 보낼 수 없습니다. 대신 이메일로 초대하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du kan ikke sende melding til %@ ennå. Inviter dem via e-post i stedet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie możesz jeszcze pisać do %@. Zaproś tę osobę e-mailem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você ainda não pode enviar mensagens para %@. Convide por e-mail."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пока нельзя написать %@. Пригласите по эл. почте."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คุณยังส่งข้อความหา %@ ไม่ได้ เชิญทางอีเมลแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ kişisine henüz mesaj gönderemezsiniz. Bunun yerine e-postayla davet edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Поки не можна написати %@. Запросіть електронною поштою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bạn chưa thể nhắn tin cho %@. Hãy mời họ qua email."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你还不能给 %@ 发消息。请改为通过邮件邀请。"
