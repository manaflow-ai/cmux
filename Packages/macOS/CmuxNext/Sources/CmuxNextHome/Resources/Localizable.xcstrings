    "homeDock.switch.invalidView": {
      "comment": "Refusal of the Switch Home View action when the view argument is not messages or channels.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home has two views: messages and channels."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للصفحة الرئيسية عرضان: الرسائل والقنوات."
          }
        },
        "bs": {
