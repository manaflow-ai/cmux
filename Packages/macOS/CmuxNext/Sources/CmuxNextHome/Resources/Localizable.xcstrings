            "value": "只有當你 @ 或回覆 Chief 時，它才會回答。"
          }
        }
      }
    },
    "home.groupInfo.chiefReplies.all.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every Chief answers every message that a person sends."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرد كل Chief على كل رسالة يرسلها شخص."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki Chief odgovara na svaku poruku koju pošalje osoba."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver Chief svarer på hver besked, som en person sender."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Chief antwortet auf jede Nachricht, die eine Person sendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada Chief responde a cada mensaje que envía una persona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque Chief répond à chaque message envoyé par une personne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni Chief risponde a ogni messaggio inviato da una persona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての Chief が、人が送るすべてのメッセージに答えます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief នីមួយៗឆ្លើយតបគ្រប់សារដែលមនុស្សផ្ញើ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 Chief가 사람이 보내는 모든 메시지에 응답합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver Chief svarer på hver melding som en person sender."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy Chief odpowiada na każdą wiadomość wysłaną przez osobę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada Chief responde a cada mensagem que uma pessoa envia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый Chief отвечает на каждое сообщение, которое отправляет человек."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief ทุกตัวจะตอบทุกข้อความที่คนส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her Chief, bir kişinin gönderdiği her mesaja yanıt verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен Chief відповідає на кожне повідомлення, яке надсилає людина."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi Chief trả lời mọi tin nhắn mà một người gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个 Chief 都会回答人发送的每条消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個 Chief 都會回答人傳送的每則訊息。"
          }
        }
      }
    },
    "home.composer.attach.refused": {
