          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido eliminar los datos de ubicación de “%@”, así que no se ha adjuntado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de supprimer les données de localisation de « %@ » : le fichier n’a pas été joint."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile rimuovere i dati sulla posizione da “%@”, quindi non è stato allegato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」から位置情報を削除できなかったため、添付されませんでした。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនអាចដកទិន្នន័យទីតាំងចេញពី “%@” បានទេ ដូច្នេះវាមិនត្រូវបានភ្ជាប់ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”에서 위치 데이터를 제거할 수 없어 첨부하지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stedsdata kunne ikke fjernes fra «%@», så den ble ikke lagt ved."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie można usunąć danych o lokalizacji z „%@”, więc nie załączono pliku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível remover os dados de localização de “%@”, então ele não foi anexado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
