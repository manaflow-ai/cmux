    "home.composer.attach.locationNotRemoved": {
      "comment": "Home composer notice: GPS could not be stripped from a photo; %@ is the file name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location data couldn’t be removed from “%@”, so it was not attached."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذرت إزالة بيانات الموقع من «%@»، لذا لم يُرفق."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Podaci o lokaciji nisu se mogli ukloniti iz „%@“, pa nije priložena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lokationsdata kunne ikke fjernes fra “%@”, så den blev ikke vedhæftet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
