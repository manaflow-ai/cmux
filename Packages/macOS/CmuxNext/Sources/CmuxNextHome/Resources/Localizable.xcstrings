    "home.composer.attach.unsupported": {
      "comment": "Home composer notice for a file type outside the allow list; %@ is the file name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” can’t be attached. You can attach photos, videos, audio, PDFs, text files and ZIP archives."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يمكن إرفاق ”%@“. يمكنك إرفاق الصور ومقاطع الفيديو والصوت وملفات PDF والملفات النصية وأرشيفات ZIP."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%@“ nije moguće priložiti. Možete priložiti fotografije, videozapise, audiozapise, PDF-ove, tekstualne datoteke i ZIP arhive."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” kan ikke vedhæftes. Du kan vedhæfte fotos, videoer, lyd, PDF'er, tekstfiler og ZIP-arkiver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%@“ kann nicht angehängt werden. Du kannst Fotos, Videos, Audio, PDFs, Textdateien und ZIP-Archive anhängen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se puede adjuntar “%@”. Puedes adjuntar fotos, vídeos, audio, PDF, archivos de texto y archivos ZIP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de joindre « %@ ». Vous pouvez joindre des photos, des vidéos, de l’audio, des PDF, des fichiers texte et des archives ZIP."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile allegare “%@”. Puoi allegare foto, video, audio, PDF, file di testo e archivi ZIP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「%@」は添付できません。写真、ビデオ、オーディオ、PDF、テキストファイル、ZIPアーカイブを添付できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនអាចភ្ជាប់ “%@” បានទេ។ អ្នកអាចភ្ជាប់រូបថត វីដេអូ សំឡេង PDF ឯកសារអត្ថបទ និងបណ្ណសារ ZIP។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”을(를) 첨부할 수 없습니다. 사진, 비디오, 오디오, PDF, 텍스트 파일 및 ZIP 압축 파일을 첨부할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%@» kan ikke legges ved. Du kan legge ved bilder, videoer, lyd, PDF-er, tekstfiler og ZIP-arkiver."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie można załączyć „%@”. Możesz załączać zdjęcia, wideo, audio, pliki PDF, pliki tekstowe i archiwa ZIP."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não é possível anexar “%@”. Você pode anexar fotos, vídeos, áudio, PDFs, arquivos de texto e arquivos ZIP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Невозможно прикрепить «%@». Можно прикреплять фото, видео, аудио, PDF, текстовые файлы и архивы ZIP."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่สามารถแนบ “%@” ได้ คุณสามารถแนบรูปภาพ วิดีโอ เสียง PDF ไฟล์ข้อความ และไฟล์ ZIP ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” eklenemez. Fotoğraf, video, ses, PDF, metin dosyası ve ZIP arşivi ekleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Неможливо прикріпити «%@». Можна прикріплювати фото, відео, аудіо, PDF, текстові файли й архіви ZIP."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thể đính kèm “%@”. Bạn có thể đính kèm ảnh, video, âm thanh, PDF, tệp văn bản và tệp ZIP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法附加“%@”。你可以附加照片、视频、音频、PDF、文本文件和 ZIP 归档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "無法附加「%@」。你可以附加照片、影片、音訊、PDF、文字檔和 ZIP 封存檔。"
          }
        }
      }
    },
