    "home.info.noOneToAdd": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone you can message is already here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل من يمكنك مراسلته موجود هنا بالفعل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi kojima možete pisati već su ovdje."
