    "home.outcome.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You started too many conversations in the last hour. Try again later."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدأت محادثات كثيرة جدًا خلال الساعة الماضية. حاول مرة أخرى لاحقًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Započeli ste previše razgovora u posljednjih sat vremena. Pokušajte kasnije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du har startet for mange samtaler inden for den seneste time. Prøv igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast in der letzten Stunde zu viele Unterhaltungen begonnen. Versuche es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has empezado demasiadas conversaciones en la última hora. Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez commencé trop de conversations au cours de la dernière heure. Réessayez plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hai iniziato troppe conversazioni nell’ultima ora. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近1時間に開始した会話が多すぎます。しばらくしてからもう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អ្នកបានចាប់ផ្ដើមការសន្ទនាច្រើនពេកក្នុងរយៈពេលមួយម៉ោងចុងក្រោយ។ សូមព្យាយាមម្ដងទៀតពេលក្រោយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 1시간 동안 너무 많은 대화를 시작했습니다. 나중에 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du har startet for mange samtaler den siste timen. Prøv igjen senere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rozpocząłeś zbyt wiele rozmów w ciągu ostatniej godziny. Spróbuj później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você iniciou conversas demais na última hora. Tente novamente mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "За последний час вы начали слишком много разговоров. Повторите попытку позже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คุณเริ่มการสนทนามากเกินไปในชั่วโมงที่ผ่านมา โปรดลองอีกครั้งในภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Son bir saatte çok fazla sohbet başlattınız. Daha sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "За останню годину ви почали забагато розмов. Спробуйте пізніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bạn đã bắt đầu quá nhiều cuộc trò chuyện trong giờ qua. Hãy thử lại sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去一小时内你发起的对话太多。请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過去一小時內你發起的對話太多。請稍後再試。"
          }
        }
      }
    },
    "home.outcome.mixed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A group can include people or email addresses, not both. Invite the email addresses first."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن أن تضم المجموعة أشخاصًا أو عناوين بريد إلكتروني، وليس كليهما. ادعُ عناوين البريد الإلكتروني أولاً."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Grupa može sadržavati osobe ili adrese e-pošte, ne oboje. Prvo pozovite adrese e-pošte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En gruppe kan indeholde personer eller e-mailadresser, ikke begge dele. Inviter e-mailadresserne først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Gruppe kann Personen oder E-Mail-Adressen enthalten, nicht beides. Lade zuerst die E-Mail-Adressen ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un grupo puede incluir personas o direcciones de correo, no ambas. Invita primero a las direcciones de correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un groupe peut contenir des personnes ou des adresses e-mail, pas les deux. Invitez d’abord les adresses e-mail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un gruppo può includere persone o indirizzi email, non entrambi. Invita prima gli indirizzi email."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループにはユーザーかメールアドレスのどちらか一方だけを含められます。先にメールアドレスを招待してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ក្រុមអាចមានមនុស្ស ឬអាសយដ្ឋានអ៊ីមែល មិនមែនទាំងពីរទេ។ សូមអញ្ជើញអាសយដ្ឋានអ៊ីមែលជាមុនសិន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹에는 사람 또는 이메일 주소 중 하나만 포함할 수 있습니다. 먼저 이메일 주소를 초대하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En gruppe kan inneholde personer eller e-postadresser, ikke begge. Inviter e-postadressene først."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Grupa może zawierać osoby albo adresy e-mail, nie jedno i drugie. Najpierw zaproś adresy e-mail."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um grupo pode incluir pessoas ou e-mails, não os dois. Convide os e-mails primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Группа может включать людей или адреса эл. почты, но не то и другое. Сначала пригласите адреса."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "กลุ่มมีได้ทั้งคนหรืออีเมล แต่ไม่ใช่ทั้งสองอย่าง เชิญอีเมลก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir grup kişileri veya e-posta adreslerini içerebilir, ikisini birden değil. Önce e-posta adreslerini davet edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Група може містити людей або адреси ел. пошти, але не обидва. Спершу запросіть адреси."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Một nhóm có thể gồm người hoặc địa chỉ email, không phải cả hai. Hãy mời các địa chỉ email trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "群组只能包含联系人或邮箱地址之一。请先邀请邮箱地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "群組只能包含聯絡人或電子郵件地址其中之一。請先邀請電子郵件地址。"
          }
        }
      }
    },
