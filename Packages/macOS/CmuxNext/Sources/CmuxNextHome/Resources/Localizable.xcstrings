    "home.info.leave.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You stop getting its messages. Someone in the group can add you again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتوقف عن تلقي رسائلها. يمكن لأي شخص في المجموعة إضافتك مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Više nećete primati njene poruke. Neko iz grupe vas može ponovo dodati."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du får ikke længere dens beskeder. En i gruppen kan tilføje dig igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du erhältst keine Nachrichten mehr aus der Gruppe. Jemand aus der Gruppe kann dich wieder hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejarás de recibir sus mensajes. Alguien del grupo puede volver a añadirte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne recevrez plus ses messages. Un membre du groupe pourra vous ajouter à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non riceverai più i suoi messaggi. Qualcuno del gruppo può aggiungerti di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループのメッセージは届かなくなります。グループのメンバーがもう一度追加できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកនឹងឈប់ទទួលសាររបស់ក្រុមនេះ។ នរណាម្នាក់ក្នុងក្រុមអាចបន្ថែមអ្នកម្តងទៀតបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 그룹의 메시지를 더 이상 받지 않습니다. 그룹 구성원이 다시 추가할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du slutter å få meldingene derfra. Noen i gruppen kan legge deg til igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przestaniesz otrzymywać jej wiadomości. Ktoś z grupy może dodać cię ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você deixará de receber as mensagens dele. Alguém do grupo pode adicionar você de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы перестанете получать её сообщения. Кто-нибудь из группы сможет снова добавить вас."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะไม่ได้รับข้อความของกลุ่มนี้อีก คนในกลุ่มสามารถเพิ่มคุณกลับเข้ามาได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grubun mesajlarını artık almazsınız. Gruptan biri sizi yeniden ekleyebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви більше не отримуватимете її повідомлень. Хтось із групи може знову вас додати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ không nhận tin nhắn của nhóm nữa. Người trong nhóm có thể thêm lại bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你将不再收到该群组的消息。群组中的成员可以再次添加你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你將不再收到這個群組的訊息。群組中的成員可以再次加入你。"
          }
        }
      }
    },
