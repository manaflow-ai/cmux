        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief は @メンションまたは返信されたときだけ答えます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief ឆ្លើយតបតែពេលអ្នក @លើកឡើង ឬឆ្លើយតបវាប៉ុណ្ណោះ។"
