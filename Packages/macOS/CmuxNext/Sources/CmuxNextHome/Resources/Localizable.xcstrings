            "state": "translated",
            "value": "Runs on this Mac with your Muse sign-in (`muse login`) through the muse-acp adapter."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل على جهاز Mac هذا باستخدام تسجيل دخولك إلى Muse (`muse login`) عبر محوّل muse-acp."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Radi na ovom Macu s vašom Muse prijavom (`muse login`) preko muse-acp adaptera."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kører på denne Mac med dit Muse-login (`muse login`) via muse-acp-adapteren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft auf diesem Mac mit deiner Muse-Anmeldung (`muse login`) über den muse-acp-Adapter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona en este Mac con tu sesión de Muse (`muse login`) a través del adaptador muse-acp."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne sur ce Mac avec votre connexion Muse (`muse login`) via l’adaptateur muse-acp."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Funziona su questo Mac con il tuo accesso a Muse (`muse login`) tramite l’adattatore muse-acp."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac 上で、muse-acp アダプター経由であなたの Muse のサインイン（`muse login`）を使って動作します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ដំណើរការលើ Mac នេះ ដោយប្រើការចូល Muse របស់អ្នក (`muse login`) តាមរយៈ adapter muse-acp។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 muse-acp 어댑터를 통해 Muse 로그인(`muse login`)으로 실행됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kjører på denne Macen med Muse-påloggingen din (`muse login`) via muse-acp-adapteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Działa na tym Macu z Twoim logowaniem do Muse (`muse login`) przez adapter muse-acp."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Funciona neste Mac com seu login do Muse (`muse login`) pelo adaptador muse-acp."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Работает на этом Mac с вашим входом в Muse (`muse login`) через адаптер muse-acp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ทำงานบน Mac เครื่องนี้ด้วยการลงชื่อเข้าใช้ Muse ของคุณ (`muse login`) ผ่านอะแดปเตอร์ muse-acp"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu Mac’te muse-acp bağdaştırıcısı üzerinden Muse oturumunuzla (`muse login`) çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Працює на цьому Mac з вашим входом у Muse (`muse login`) через адаптер muse-acp."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chạy trên máy Mac này bằng phiên đăng nhập Muse của bạn (`muse login`) qua bộ chuyển đổi muse-acp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 muse-acp 适配器，使用你的 Muse 登录（`muse login`）在这台 Mac 上运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 muse-acp 轉接器，使用你的 Muse 登入（`muse login`）在這台 Mac 上執行。"
          }
        }
      }
    },
    "home.invite.waitingFor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for %@ to accept"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في انتظار قبول %@"
          }
        },
        "bs": {
          "stringUnit": {
