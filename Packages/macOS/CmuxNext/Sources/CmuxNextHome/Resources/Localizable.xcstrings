    "home.chief.new.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Chief is an agent with its own conversation and memory. Chiefs are optional."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief هو وكيل له محادثته وذاكرته الخاصة. استخدام Chiefs اختياري."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief je agent s vlastitim razgovorom i memorijom. Chiefovi nisu obavezni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En Chief er en agent med sin egen samtale og hukommelse. Chiefs er valgfrie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Chief ist ein Agent mit eigener Unterhaltung und eigenem Gedächtnis. Chiefs sind optional."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un Chief es un agente con su propia conversación y memoria. Los Chiefs son opcionales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un Chief est un agent avec sa propre conversation et sa propre mémoire. Les Chiefs sont facultatifs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un Chief è un agente con una propria conversazione e memoria. I Chief sono facoltativi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chiefは、専用の会話とメモリを持つエージェントです。Chiefの利用は任意です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief គឺជាភ្នាក់ងារដែលមានការសន្ទនា និងការចងចាំផ្ទាល់ខ្លួន។ Chief ជាជម្រើស។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief는 자체 대화와 메모리를 가진 에이전트입니다. Chief는 선택 사항입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En Chief er en agent med egen samtale og eget minne. Chiefs er valgfrie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief to agent z własną rozmową i pamięcią. Chiefy są opcjonalne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um Chief é um agente com sua própria conversa e memória. Chiefs são opcionais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief — это агент со своим разговором и памятью. Chiefs необязательны."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief คือเอเจนต์ที่มีการสนทนาและหน่วยความจำของตัวเอง จะใช้ Chief หรือไม่ก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief, kendi sohbeti ve belleği olan bir ajandır. Chief kullanmak isteğe bağlıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief — це агент із власною розмовою та пам’яттю. Chiefs необов’язкові."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief là một tác tử có cuộc trò chuyện và bộ nhớ riêng. Chief là tùy chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief 是拥有自己对话和记忆的智能体。Chief 是可选的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief 是擁有自己對話與記憶的代理程式。Chief 是選用的。"
          }
        }
      }
    },
