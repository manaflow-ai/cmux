        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」という名前の人はいません。招待するにはメールアドレスを入力してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្មាននរណាម្នាក់ឈ្មោះ “%@” ទេ។ វាយអាសយដ្ឋានអ៊ីមែលរបស់គេ ដើម្បីអញ្ជើញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”(이)라는 사람이 없습니다. 초대하려면 이메일 주소를 입력하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen heter «%@». Skriv inn e-postadressen for å invitere personen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nikt nie nazywa się „%@”. Wpisz adres e-mail, aby zaprosić tę osobę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ninguém se chama “%@”. Digite o e-mail da pessoa para convidá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Нет никого с именем «%@». Введите адрес эл. почты, чтобы пригласить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่มีใครชื่อ “%@” พิมพ์อีเมลของผู้นั้นเพื่อเชิญ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” adında kimse yok. Davet etmek için e-posta adresini yazın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Немає нікого з іменем «%@». Введіть адресу ел. пошти, щоб запросити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không có ai tên “%@”. Nhập địa chỉ email của họ để mời."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有名为“%@”的人。输入对方的电子邮件地址即可邀请。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有名為「%@」的人。輸入對方的電子郵件地址即可邀請。"
          }
        }
      }
    },
