    "home.firstRun.introFocus": {
      "comment": "Empty Chief conversation of a Chief made while the person has other Chiefs: its first-open message. It asks what the new Chief should focus on so it does not overlap with the others.",
      "extractionState": "manual",
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "مرحبًا، أنا Chief جديد. على ماذا يجب أن أركّز؟\nأخبرني بمشروع أو مستودع أو نوع من العمل، وسألتزم به حتى لا أتداخل مع Chiefs الآخرين لديك."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Zdravo, ja sam novi Chief. Na šta da se fokusiram?\nRecite mi projekat, repozitorij ili vrstu posla i držat ću se toga da se ne preklapam s vašim drugim Chiefovima."}},
        "da": {"stringUnit": {"state": "translated", "value": "Hej, jeg er en ny Chief. Hvad skal jeg fokusere på?\nFortæl mig et projekt, et repo eller en slags arbejde, så holder jeg mig til det og overlapper ikke med dine andre Chiefs."}},
        "de": {"stringUnit": {"state": "translated", "value": "Hallo, ich bin ein neuer Chief. Worauf soll ich mich konzentrieren?\nNenn mir ein Projekt, ein Repo oder eine Art von Arbeit, und ich bleibe dabei, damit ich mich nicht mit deinen anderen Chiefs überschneide."}},
        "en": {"stringUnit": {"state": "translated", "value": "Hi, I'm a new Chief. What should I focus on?\nTell me a project, a repo or a kind of work, and I'll stick to it so I don't overlap with your other Chiefs."}},
        "es": {"stringUnit": {"state": "translated", "value": "Hola, soy un Chief nuevo. ¿En qué debo centrarme?\nDime un proyecto, un repositorio o un tipo de trabajo y me ceñiré a ello para no solaparme con tus otros Chiefs."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Bonjour, je suis un nouveau Chief. Sur quoi dois-je me concentrer ?\nIndiquez-moi un projet, un dépôt ou un type de travail, et je m’y tiendrai pour ne pas empiéter sur vos autres Chiefs."}},
        "it": {"stringUnit": {"state": "translated", "value": "Ciao, sono un nuovo Chief. Su cosa devo concentrarmi?\nDimmi un progetto, un repository o un tipo di lavoro e mi atterrò a quello per non sovrappormi agli altri tuoi Chief."}},
        "ja": {"stringUnit": {"state": "translated", "value": "こんにちは、新しい Chief です。何に集中すればよいですか？\nプロジェクト、リポジトリ、作業の種類を教えてください。ほかの Chief と重ならないよう、それに専念します。"}},
        "km": {"stringUnit": {"state": "translated", "value": "សួស្តី ខ្ញុំជា Chief ថ្មី។ តើខ្ញុំគួរផ្តោតលើអ្វី?\nប្រាប់ខ្ញុំពីគម្រោង repo ឬប្រភេទការងារ ហើយខ្ញុំនឹងប្រកាន់ខ្ជាប់វា ដើម្បីកុំឱ្យជាន់គ្នាជាមួយ Chief ផ្សេងទៀតរបស់អ្នក។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "안녕하세요, 새 Chief입니다. 무엇에 집중할까요?\n프로젝트, 저장소 또는 작업 종류를 알려 주세요. 다른 Chief와 겹치지 않도록 그 일에만 집중하겠습니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Hei, jeg er en ny Chief. Hva skal jeg fokusere på?\nSi et prosjekt, et repo eller en type arbeid, så holder jeg meg til det og overlapper ikke med de andre Chiefene dine."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Cześć, jestem nowy Chief. Na czym mam się skupić?\nPodaj projekt, repozytorium lub rodzaj pracy, a będę się tego trzymać, żeby nie dublować twoich innych Chiefów."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Oi, eu sou um Chief novo. No que devo me concentrar?\nDiga um projeto, um repositório ou um tipo de trabalho, e vou me manter nele para não me sobrepor aos seus outros Chiefs."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Здравствуйте, я новый Chief. На чём мне сосредоточиться?\nНазовите проект, репозиторий или вид работы, и я буду заниматься только этим, чтобы не пересекаться с вашими другими Chief."}},
        "th": {"stringUnit": {"state": "translated", "value": "สวัสดี ฉันคือ Chief ตัวใหม่ ควรโฟกัสที่อะไรดี?\nบอกโปรเจกต์ รีโป หรือประเภทงาน แล้วฉันจะทำแค่นั้นเพื่อไม่ให้ซ้ำกับ Chief ตัวอื่นของคุณ"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Merhaba, ben yeni bir Chief. Neye odaklanmalıyım?\nBana bir proje, depo ya da iş türü söyleyin; diğer Chief’lerinizle çakışmamak için ona bağlı kalırım."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Привіт, я новий Chief. На чому мені зосередитися?\nНазвіть проєкт, репозиторій або вид роботи, і я триматимуся цього, щоб не перетинатися з вашими іншими Chief."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Xin chào, tôi là một Chief mới. Tôi nên tập trung vào việc gì?\nHãy cho tôi biết một dự án, một repo hoặc một loại công việc, tôi sẽ chỉ làm việc đó để không trùng với các Chief khác của bạn."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "你好，我是新的 Chief。我应该专注于什么？\n告诉我一个项目、一个仓库或一类工作，我会专注于它，避免和你的其他 Chief 重叠。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "你好，我是新的 Chief。我應該專注於什麼？\n告訴我一個專案、一個儲存庫或一類工作，我會專注於它，避免和你的其他 Chief 重疊。"}}
      }
    },
    "home.outcome.cloudUnreachable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud didn’t answer. Check your connection and try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تستجب cmux Cloud. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux Cloud nije odgovorio. Provjerite vezu i pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux Cloud svarede ikke. Tjek din forbindelse, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud hat nicht geantwortet. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud no respondió. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud n’a pas répondu. Vérifiez votre connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux Cloud non ha risposto. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud から応答がありません。接続を確認して、もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux Cloud មិនបានឆ្លើយតបទេ។ សូមពិនិត្យការតភ្ជាប់របស់អ្នក ហើយព្យាយាមម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud가 응답하지 않았습니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux Cloud svarte ikke. Sjekk tilkoblingen og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux Cloud nie odpowiedział. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cmux Cloud não respondeu. Verifique sua conexão e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux Cloud не ответил. Проверьте подключение и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux Cloud ไม่ตอบสนอง ตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux Cloud yanıt vermedi. Bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux Cloud не відповів. Перевірте з’єднання й спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux Cloud không phản hồi. Hãy kiểm tra kết nối và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud 没有响应。请检查网络连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud 沒有回應。請檢查網路連線後再試一次。"
          }
        }
      }
    },
