          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen samtaler ennå. Start en med Ny melding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brak rozmów. Rozpocznij nową przez Nowa wiadomość."
          }
        },
