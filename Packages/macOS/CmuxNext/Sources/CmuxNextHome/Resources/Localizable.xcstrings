    "home.firstRun.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief runs your agents on this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief はこの Mac であなたのエージェントを動かします。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يدير Chief وكلاءك على هذا الـ Mac."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief pokreće vaše agente na ovom Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief kører dine agenter på denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief steuert deine Agenten auf diesem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief ejecuta tus agentes en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief pilote vos agents sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief gestisce i tuoi agenti su questo Mac."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief ដំណើរការភ្នាក់ងាររបស់អ្នកនៅលើ Mac នេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief가 이 Mac에서 에이전트를 실행합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief kjører agentene dine på denne Macen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief uruchamia Twoich agentów na tym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Chief executa seus agentes neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief управляет вашими агентами на этом Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief เรียกใช้เอเจนต์ของคุณบน Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief, ajanlarınızı bu Mac’te çalıştırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief керує вашими агентами на цьому Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief chạy các tác tử của bạn trên máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief 在这台 Mac 上运行你的代理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief 在這台 Mac 上執行你的代理程式。"
          }
        }
      }
    },
    "home.firstRun.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask it to start work, check on your agents, or answer what they need."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業の開始、エージェントの確認、エージェントが必要とする回答を頼めます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اطلب منه بدء العمل أو متابعة وكلائك أو الرد على ما يحتاجونه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zamolite ga da započne posao, provjeri vaše agente ili odgovori na ono što im treba."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bed den om at starte arbejde, tjekke dine agenter eller svare på det, de har brug for."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bitte ihn, Arbeit zu starten, nach deinen Agenten zu sehen oder zu beantworten, was sie brauchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pídele que empiece un trabajo, revise tus agentes o responda lo que necesitan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Demandez-lui de lancer un travail, de suivre vos agents ou de répondre à ce dont ils ont besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chiedigli di avviare un lavoro, controllare i tuoi agenti o rispondere a ciò che serve loro."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សុំឱ្យវាចាប់ផ្ដើមការងារ ពិនិត្យភ្នាក់ងាររបស់អ្នក ឬឆ្លើយអ្វីដែលពួកគេត្រូវការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "작업 시작, 에이전트 확인, 에이전트에게 필요한 답변을 요청하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Be den starte arbeid, sjekke agentene dine eller svare på det de trenger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poproś go o rozpoczęcie pracy, sprawdzenie agentów lub odpowiedź na to, czego potrzebują."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Peça para ele iniciar um trabalho, verificar seus agentes ou responder ao que eles precisam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Попросите его начать работу, проверить агентов или ответить на их вопросы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ขอให้เริ่มงาน ตรวจสอบเอเจนต์ หรือตอบสิ่งที่เอเจนต์ต้องการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ondan iş başlatmasını, ajanlarınızı kontrol etmesini veya ihtiyaç duyduklarını yanıtlamasını isteyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Попросіть його почати роботу, перевірити агентів або відповісти на те, що їм потрібно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hãy nhờ nó bắt đầu công việc, kiểm tra các tác tử hoặc trả lời những gì chúng cần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "让它开始工作、查看你的代理，或回答代理需要的问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請它開始工作、查看你的代理程式，或回答代理程式需要的問題。"
          }
        }
      }
    },
    "home.chief.memoryScope.deviceOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Chief remembers on this device only."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Chief はこのデバイスでのみ記憶します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتذكر Chief هذا على هذا الجهاز فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovaj Chief pamti samo na ovom uređaju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne Chief husker kun på denne enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Chief merkt sich Dinge nur auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este Chief solo recuerda en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce Chief ne mémorise que sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo Chief ricorda solo su questo dispositivo."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief នេះចងចាំតែនៅលើឧបករណ៍នេះប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 Chief는 이 기기에서만 기억합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne Chief husker bare på denne enheten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten Chief zapamiętuje tylko na tym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este Chief lembra apenas neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот Chief запоминает только на этом устройстве."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief นี้จดจำได้เฉพาะบนอุปกรณ์นี้เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu Chief yalnızca bu cihazda hatırlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цей Chief запам’ятовує лише на цьому пристрої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief này chỉ ghi nhớ trên thiết bị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此 Chief 仅在这台设备上记忆。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此 Chief 僅在這台裝置上記憶。"
          }
        }
      }
    },
    "home.firstRun.suggestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What are my agents doing right now?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントはいま何をしていますか？"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ماذا يفعل وكلائي الآن؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Šta moji agenti trenutno rade?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvad laver mine agenter lige nu?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Was machen meine Agenten gerade?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Qué están haciendo mis agentes ahora?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Que font mes agents en ce moment ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cosa stanno facendo i miei agenti adesso?"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "តើភ្នាក់ងាររបស់ខ្ញុំកំពុងធ្វើអ្វីឥឡូវនេះ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "지금 내 에이전트는 무엇을 하고 있나요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hva gjør agentene mine akkurat nå?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Co teraz robią moi agenci?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O que meus agentes estão fazendo agora?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Чем сейчас заняты мои агенты?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ตอนนี้เอเจนต์ของฉันกำลังทำอะไรอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajanlarım şu anda ne yapıyor?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Що зараз роблять мої агенти?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các tác tử của tôi đang làm gì?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "我的代理现在在做什么？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "我的代理程式現在在做什麼？"
          }
        }
      }
    },
