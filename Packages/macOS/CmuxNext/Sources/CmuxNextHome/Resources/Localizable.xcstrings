          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기에는 마이크 접근 권한이 필요합니다. 시스템 설정에서 cmux에 허용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering trenger tilgang til mikrofonen. Slå den på for cmux i Systeminnstillinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyktowanie wymaga dostępu do mikrofonu. Włącz go dla cmux w Ustawieniach systemowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado precisa de acesso ao microfone. Ative-o para o cmux nos Ajustes do Sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для диктовки нужен доступ к микрофону. Включите его для cmux в Системных настройках."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การป้อนตามคำบอกต้องเข้าถึงไมโครโฟน เปิดให้ cmux ในการตั้งค่าระบบ"
