    "home.invite.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They get an email with a link to join. You can message them here as soon as they accept."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتلقون رسالة بريد إلكتروني تحتوي على رابط للانضمام. يمكنك مراسلتهم هنا بمجرد قبولهم."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dobit će e-poruku s vezom za pridruživanje. Možete im pisati ovdje čim prihvate."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De får en e-mail med et link til at deltage. Du kan skrive til dem her, så snart de accepterer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie erhalten eine E-Mail mit einem Link zum Beitreten. Sobald sie annehmen, kannst du ihnen hier schreiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibirán un correo con un enlace para unirse. Podrás escribirles aquí en cuanto acepten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils reçoivent un e-mail avec un lien pour rejoindre. Vous pourrez leur écrire ici dès qu’ils acceptent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Riceveranno un’email con un link per unirsi. Potrai scrivergli qui appena accettano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加用のリンクが記載されたメールが届きます。相手が承諾すると、ここでメッセージを送れます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ពួកគេនឹងទទួលបានអ៊ីមែលដែលមានតំណដើម្បីចូលរួម។ អ្នកអាចផ្ញើសារទៅពួកគេនៅទីនេះ ពេលពួកគេទទួលយក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대방에게 참여 링크가 담긴 이메일이 전송됩니다. 상대방이 수락하면 바로 여기에서 메시지를 보낼 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De får en e-post med en lenke for å bli med. Du kan sende meldinger til dem her så snart de godtar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otrzymają e-mail z linkiem do dołączenia. Możesz do nich pisać tutaj, gdy tylko zaakceptują."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A pessoa recebe um e-mail com um link para entrar. Você pode enviar mensagens aqui assim que ela aceitar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Они получат письмо со ссылкой для присоединения. Вы сможете писать им здесь, как только они примут приглашение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "พวกเขาจะได้รับอีเมลพร้อมลิงก์เพื่อเข้าร่วม คุณส่งข้อความหาพวกเขาที่นี่ได้ทันทีที่พวกเขายอมรับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Katılma bağlantısı içeren bir e-posta alırlar. Kabul ettiklerinde onlara buradan mesaj gönderebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вони отримають лист із посиланням для приєднання. Ви зможете писати їм тут, щойно вони приймуть запрошення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Họ sẽ nhận được email có liên kết để tham gia. Bạn có thể nhắn tin cho họ ở đây ngay khi họ chấp nhận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方会收到一封含加入链接的邮件。对方接受后，你就能在这里给他们发消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方會收到含加入連結的電子郵件。對方接受後，你就能在這裡傳訊息給他們。"
          }
        }
      }
    },
