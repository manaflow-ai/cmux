    "home.requests.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People you have not talked to yet. They do not get notified, and they do not know if you read their message."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أشخاص لم تتحدث معهم بعد. لا يتلقون أي إشعار، ولا يعرفون إن كنت قد قرأت رسالتهم."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Osobe s kojima još niste razgovarali. Ne dobijaju obavještenje i ne znaju jeste li pročitali njihovu poruku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Personer, du ikke har talt med endnu. De får ingen besked og ved ikke, om du har læst deres besked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Personen, mit denen du noch nicht geschrieben hast. Sie werden nicht benachrichtigt und erfahren nicht, ob du ihre Nachricht gelesen hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Personas con las que aún no has hablado. No reciben ninguna notificación ni saben si leíste su mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des personnes avec qui vous n’avez pas encore échangé. Elles ne sont pas averties et ne savent pas si vous avez lu leur message."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Persone con cui non hai ancora parlato. Non ricevono notifiche e non sanno se hai letto il loro messaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ話したことのない人です。相手に通知は届かず、メッセージを読んだかどうかも相手にはわかりません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មនុស្សដែលអ្នកមិនទាន់បាននិយាយជាមួយ។ ពួកគេមិនទទួលបានការជូនដំណឹង ហើយមិនដឹងថាអ្នកបានអានសាររបស់ពួកគេឬអត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 대화한 적 없는 사람입니다. 상대방에게 알림이 가지 않으며, 메시지를 읽었는지도 알 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Personer du ikke har snakket med ennå. De blir ikke varslet og vet ikke om du har lest meldingen deres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Osoby, z którymi jeszcze nie rozmawiałeś. Nie dostają powiadomienia i nie wiedzą, czy przeczytałeś ich wiadomość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pessoas com quem você ainda não conversou. Elas não são notificadas e não sabem se você leu a mensagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Люди, с которыми вы ещё не общались. Они не получают уведомлений и не знают, прочитали ли вы их сообщение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คนที่คุณยังไม่เคยคุยด้วย พวกเขาจะไม่ได้รับการแจ้งเตือน และจะไม่รู้ว่าคุณอ่านข้อความแล้วหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Henüz konuşmadığınız kişiler. Bildirim almazlar ve mesajlarını okuyup okumadığınızı bilmezler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Люди, з якими ви ще не спілкувалися. Вони не отримують сповіщень і не знають, чи ви прочитали їхнє повідомлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Những người bạn chưa từng trò chuyện. Họ không nhận được thông báo và không biết bạn đã đọc tin nhắn hay chưa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你还没有交谈过的人。他们不会收到通知，也不知道你是否已读他们的消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你還沒有交談過的人。他們不會收到通知，也不知道你是否已讀他們的訊息。"
          }
        }
      }
    },
