    "terminalComments.noChat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This workspace has no agent chat to send the comment to."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースにはコメントを送るエージェントチャットがありません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا توجد في مساحة العمل هذه دردشة وكيل لإرسال التعليق إليها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovaj radni prostor nema chat s agentom kojem bi se poslao komentar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dette arbejdsområde har ingen agentchat at sende kommentaren til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Arbeitsbereich hat keinen Agenten-Chat, an den der Kommentar gehen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este espacio de trabajo no tiene un chat de agente al que enviar el comentario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cet espace de travail n'a pas de chat d'agent auquel envoyer le commentaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo spazio di lavoro non ha una chat con un agente a cui inviare il commento."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កន្លែងធ្វើការនេះមិនមានការជជែកភ្នាក់ងារដើម្បីផ្ញើមតិយោបល់ទៅទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 작업 공간에는 댓글을 보낼 에이전트 채팅이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dette arbeidsområdet har ingen agentchat å sende kommentaren til."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "W tym obszarze roboczym nie ma czatu z agentem, do którego można wysłać komentarz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este espaço de trabalho não tem um chat de agente para receber o comentário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В этом рабочем пространстве нет чата с агентом, куда можно отправить комментарий."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "พื้นที่ทำงานนี้ไม่มีแชทเอเจนต์ที่จะส่งความคิดเห็นไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu çalışma alanında yorumun gönderileceği bir ajan sohbeti yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У цьому робочому просторі немає чату з агентом, куди можна надіслати коментар."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không gian làm việc này không có cuộc trò chuyện với tác nhân để gửi bình luận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此工作区没有可接收评论的代理聊天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此工作區沒有可接收留言的代理聊天。"
          }
        }
      }
    },
    "terminalComments.gesture": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A comment on a terminal selection needs a click or a key in cmux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルの選択範囲へのコメントには cmux でのクリックまたはキー操作が必要です。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحتاج التعليق على تحديد في الطرفية إلى نقرة أو مفتاح في cmux."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Komentar na odabir u terminalu traži klik ili tipku u cmux-u."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En kommentar til en markering i terminalen kræver et klik eller en tast i cmux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Kommentar zu einer Terminal-Auswahl braucht einen Klick oder eine Taste in cmux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un comentario sobre una selección de la terminal necesita un clic o una tecla en cmux."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un commentaire sur une sélection du terminal nécessite un clic ou une touche dans cmux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un commento su una selezione del terminale richiede un clic o un tasto in cmux."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មតិយោបល់លើការជ្រើសក្នុងស្ថានីយត្រូវការការចុច ឬគ្រាប់ចុចក្នុង cmux។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "터미널 선택 영역에 대한 댓글은 cmux에서 클릭이나 키 입력이 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En kommentar til et utvalg i terminalen krever et klikk eller en tast i cmux."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Komentarz do zaznaczenia w terminalu wymaga kliknięcia lub klawisza w cmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um comentário sobre uma seleção do terminal precisa de um clique ou tecla no cmux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для комментария к выделению в терминале нужен щелчок или клавиша в cmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การแสดงความคิดเห็นต่อส่วนที่เลือกในเทอร์มินัลต้องคลิกหรือกดแป้นใน cmux"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminal seçimine yorum için cmux'ta bir tıklama ya da tuş gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для коментаря до виділення в терміналі потрібне клацання або клавіша в cmux."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bình luận về vùng chọn trong terminal cần một cú nhấp hoặc phím trong cmux."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "对终端选区发表评论需要在 cmux 中点击或按键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "對終端機選取範圍留言需要在 cmux 中點按或按鍵。"
          }
        }
      }
    },
