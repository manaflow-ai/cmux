    "chief.openSubagent.noSubagent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a subagent from the Subagents menu or the sidebar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブエージェントメニューまたはサイドバーからサブエージェントを選んでください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اختر وكيلًا فرعيًا من قائمة الوكلاء الفرعيين أو من الشريط الجانبي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odaberite podagenta iz menija Podagenti ili s bočne trake."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vælg en underagent i menuen Underagenter eller i sidepanelet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wähle einen Subagenten im Menü „Subagenten“ oder in der Seitenleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elige un subagente en el menú Subagentes o en la barra lateral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisissez un sous-agent dans le menu Sous-agents ou dans la barre latérale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scegli un subagente dal menu Subagenti o dalla barra laterale."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ជ្រើសរើសភ្នាក់ងាររងពីម៉ឺនុយ ភ្នាក់ងាររង ឬពីរបារចំហៀង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "하위 에이전트 메뉴나 사이드바에서 하위 에이전트를 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Velg en underagent fra Underagenter-menyen eller sidefeltet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybierz podagenta z menu Podagenci lub z paska bocznego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolha um subagente no menu Subagentes ou na barra lateral."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выберите субагента в меню «Субагенты» или на боковой панели."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เลือกเอเจนต์ย่อยจากเมนูเอเจนต์ย่อยหรือแถบด้านข้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alt ajanlar menüsünden veya kenar çubuğundan bir alt ajan seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Виберіть субагента в меню «Субагенти» або на бічній панелі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chọn một tác tử phụ từ menu Tác tử phụ hoặc thanh bên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请从“子代理”菜单或侧边栏中选择一个子代理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請從「子代理」選單或側邊欄中選擇一個子代理。"
          }
        }
      }
    },
