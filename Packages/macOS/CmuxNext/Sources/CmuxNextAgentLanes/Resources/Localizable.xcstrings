        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一致する %2$lld 件のチャットのうち上位 %1$lld 件です。絞り込むには入力を続けてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld ល្អបំផុតក្នុងចំណោមការជជែកដែលត្រូវគ្នា %2$lld។ វាយបន្ថែមដើម្បីបង្រួម។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일치하는 채팅 %2$lld개 중 상위 %1$lld개입니다. 더 입력해 범위를 좁히세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De beste %1$lld av %2$lld samsvarende chatter. Skriv mer for å snevre inn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Najlepsze %1$lld z %2$lld pasujących czatów. Wpisz więcej, aby zawęzić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os %1$lld melhores de %2$lld chats correspondentes. Digite mais para refinar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Лучшие %1$lld из %2$lld подходящих чатов. Введите больше, чтобы сузить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld รายการที่ดีที่สุดจากแชตที่ตรงกัน %2$lld รายการ พิมพ์เพิ่มเพื่อจำกัดผลลัพธ์"
