      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "No live previews are available yet. Try again when the machine's web server is ready."}},
        "ar": {"stringUnit": {"state": "translated", "value": "لا تتوفر معاينات مباشرة بعد. حاول مرة أخرى عندما يصبح خادم الويب على الجهاز جاهزًا."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Pregledi uživo još nisu dostupni. Pokušajte ponovo kada web server mašine bude spreman."}},
        "da": {"stringUnit": {"state": "translated", "value": "Der er endnu ingen liveforhåndsvisninger. Prøv igen, når maskinens webserver er klar."}},
        "de": {"stringUnit": {"state": "translated", "value": "Es sind noch keine Live-Vorschauen verfügbar. Versuche es erneut, wenn der Webserver der Maschine bereit ist."}},
        "es": {"stringUnit": {"state": "translated", "value": "Aún no hay vistas previas en vivo. Inténtalo de nuevo cuando el servidor web de la máquina esté listo."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Aucun aperçu en direct n’est encore disponible. Réessayez lorsque le serveur web de la machine sera prêt."}},
        "it": {"stringUnit": {"state": "translated", "value": "Non sono ancora disponibili anteprime dal vivo. Riprova quando il server web della macchina sarà pronto."}},
        "ja": {"stringUnit": {"state": "translated", "value": "ライブプレビューはまだ利用できません。マシンのWebサーバーの準備ができたら、もう一度お試しください。"}},
        "km": {"stringUnit": {"state": "translated", "value": "មិនទាន់មានការមើលជាមុនផ្ទាល់ទេ។ សូមព្យាយាមម្ដងទៀត នៅពេលម៉ាស៊ីនបម្រើគេហទំព័ររបស់ម៉ាស៊ីនរួចរាល់។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "아직 실시간 미리보기를 사용할 수 없습니다. 머신의 웹 서버가 준비되면 다시 시도하세요."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Ingen direkteforhåndsvisninger er tilgjengelige ennå. Prøv igjen når maskinens webserver er klar."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Podglądy na żywo nie są jeszcze dostępne. Spróbuj ponownie, gdy serwer WWW maszyny będzie gotowy."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ainda não há prévias ao vivo disponíveis. Tente novamente quando o servidor web da máquina estiver pronto."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Предпросмотр в реальном времени пока недоступен. Повторите попытку, когда веб-сервер машины будет готов."}},
        "th": {"stringUnit": {"state": "translated", "value": "ยังไม่มีตัวอย่างแบบสด ลองอีกครั้งเมื่อเว็บเซิร์ฟเวอร์ของเครื่องพร้อมใช้งาน"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Henüz canlı önizleme yok. Makinenin web sunucusu hazır olduğunda tekrar deneyin."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Попередній перегляд наживо ще недоступний. Спробуйте знову, коли вебсервер машини буде готовий."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Chưa có bản xem trước trực tiếp. Hãy thử lại khi máy chủ web trên máy đã sẵn sàng."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "暂时没有可用的实时预览。请在机器的 Web 服务器准备就绪后重试。"}},
