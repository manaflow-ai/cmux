    "cloud.ports.pathInvalid": {
      "comment": "cmux cloud open-browser with a bad --path. %1$@ machine name, %2$@ id, %3$@ port. Keep the command as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Machine `%1$@` can't open that path on port %3$@: pass one that starts with / and has no spaces, for example `cmux cloud open-browser --target machine:%2$@ --port %3$@ --path /docs`."}},
        "ja": {"stringUnit": {"state": "translated", "value": "マシン `%1$@` のポート %3$@ でそのパスは開けません。/ で始まり空白を含まないパスを指定してください (例: `cmux cloud open-browser --target machine:%2$@ --port %3$@ --path /docs`)。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Maschine `%1$@` kann diesen Pfad auf Port %3$@ nicht öffnen: Gib einen an, der mit / beginnt und keine Leerzeichen enthält, zum Beispiel `cmux cloud open-browser --target machine:%2$@ --port %3$@ --path /docs`."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "La machine `%1$@` ne peut pas ouvrir ce chemin sur le port %3$@ : indiquez-en un qui commence par / et sans espaces, par exemple `cmux cloud open-browser --target machine:%2$@ --port %3$@ --path /docs`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "La máquina `%1$@` no puede abrir esa ruta en el puerto %3$@: pasa una que empiece por / y sin espacios, por ejemplo `cmux cloud open-browser --target machine:%2$@ --port %3$@ --path /docs`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "لا يستطيع الجهاز `%1$@` فتح ذلك المسار على المنفذ %3$@: مرّر مسارًا يبدأ بـ / ولا يحتوي على مسافات، مثل `cmux cloud open-browser --target machine:%2$@ --port %3$@ --path /docs`."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "머신 `%1$@`의 포트 %3$@에서 그 경로를 열 수 없습니다. /로 시작하고 공백이 없는 경로를 지정하세요(예: `cmux cloud open-browser --target machine:%2$@ --port %3$@ --path /docs`)."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "机器 `%1$@` 无法在端口 %3$@ 上打开该路径：请传入以 / 开头且不含空格的路径，例如 `cmux cloud open-browser --target machine:%2$@ --port %3$@ --path /docs`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "機器 `%1$@` 無法在連接埠 %3$@ 上開啟該路徑：請傳入以 / 開頭且不含空白的路徑，例如 `cmux cloud open-browser --target machine:%2$@ --port %3$@ --path /docs`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Mašina `%1$@` ne može otvoriti tu putanju na portu %3$@: navedite putanju koja počinje sa / i nema razmaka, na primjer `cmux cloud open-browser --target machine:%2$@ --port %3$@ --path /docs`."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Maskinen `%1$@` kan ikke åbne den sti på port %3$@: angiv en, der starter med / og ikke har mellemrum, for eksempel `cmux cloud open-browser --target machine:%2$@ --port %3$@ --path /docs`."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "La macchina `%1$@` non può aprire quel percorso sulla porta %3$@: passane uno che inizi con / e senza spazi, per esempio `cmux cloud open-browser --target machine:%2$@ --port %3$@ --path /docs`."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ម៉ាស៊ីន `%1$@` មិនអាចបើកផ្លូវនោះនៅលើច្រក %3$@ បានទេ៖ សូមផ្ដល់ផ្លូវដែលចាប់ផ្ដើមដោយ / ហើយគ្មានដកឃ្លា ឧទាហរណ៍ `cmux cloud open-browser --target machine:%2$@ --port %3$@ --path /docs`។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Maskinen `%1$@` kan ikke åpne den banen på port %3$@: oppgi en som starter med / og ikke har mellomrom, for eksempel `cmux cloud open-browser --target machine:%2$@ --port %3$@ --path /docs`."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Maszyna `%1$@` nie może otworzyć tej ścieżki na porcie %3$@: podaj ścieżkę zaczynającą się od / i bez spacji, na przykład `cmux cloud open-browser --target machine:%2$@ --port %3$@ --path /docs`."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "A máquina `%1$@` não pode abrir esse caminho na porta %3$@: passe um que comece com / e não tenha espaços, por exemplo `cmux cloud open-browser --target machine:%2$@ --port %3$@ --path /docs`."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Машина `%1$@` не может открыть этот путь на порту %3$@: укажите путь, который начинается с / и не содержит пробелов, например `cmux cloud open-browser --target machine:%2$@ --port %3$@ --path /docs`."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เครื่อง `%1$@` เปิดพาธนั้นบนพอร์ต %3$@ ไม่ได้: ระบุพาธที่ขึ้นต้นด้วย / และไม่มีช่องว่าง เช่น `cmux cloud open-browser --target machine:%2$@ --port %3$@ --path /docs`"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "`%1$@` makinesi %3$@ portunda bu yolu açamıyor: / ile başlayan ve boşluk içermeyen bir yol verin, örneğin `cmux cloud open-browser --target machine:%2$@ --port %3$@ --path /docs`."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Машина `%1$@` не може відкрити цей шлях на порту %3$@: укажіть шлях, що починається з / і не містить пробілів, наприклад `cmux cloud open-browser --target machine:%2$@ --port %3$@ --path /docs`."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Máy `%1$@` không thể mở đường dẫn đó trên cổng %3$@: hãy truyền một đường dẫn bắt đầu bằng / và không có dấu cách, ví dụ `cmux cloud open-browser --target machine:%2$@ --port %3$@ --path /docs`."}}
      }
    },
    "cloud.ports.invalidPort": {
      "comment": "A port outside 1 to 65535. %1$@ machine name, %2$@ id, %3$@ the command (open-browser, port-forward, ...). Keep the command as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Pass a port from 1 to 65535 for machine `%1$@`, for example `cmux cloud %3$@ --target machine:%2$@ --port 3000`."}},
        "ja": {"stringUnit": {"state": "translated", "value": "マシン `%1$@` には 1〜65535 のポートを指定してください (例: `cmux cloud %3$@ --target machine:%2$@ --port 3000`)。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Gib für Maschine `%1$@` einen Port von 1 bis 65535 an, zum Beispiel `cmux cloud %3$@ --target machine:%2$@ --port 3000`."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Indiquez un port de 1 à 65535 pour la machine `%1$@`, par exemple `cmux cloud %3$@ --target machine:%2$@ --port 3000`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Indica un puerto de 1 a 65535 para la máquina `%1$@`, por ejemplo `cmux cloud %3$@ --target machine:%2$@ --port 3000`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "مرّر منفذًا من 1 إلى 65535 للجهاز `%1$@`، مثل `cmux cloud %3$@ --target machine:%2$@ --port 3000`."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "머신 `%1$@`에는 1~65535 범위의 포트를 지정하세요(예: `cmux cloud %3$@ --target machine:%2$@ --port 3000`)."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "请为机器 `%1$@` 传入 1 到 65535 之间的端口，例如 `cmux cloud %3$@ --target machine:%2$@ --port 3000`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "請為機器 `%1$@` 傳入 1 到 65535 之間的連接埠，例如 `cmux cloud %3$@ --target machine:%2$@ --port 3000`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Navedite port od 1 do 65535 za mašinu `%1$@`, na primjer `cmux cloud %3$@ --target machine:%2$@ --port 3000`."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Angiv en port fra 1 til 65535 for maskinen `%1$@`, for eksempel `cmux cloud %3$@ --target machine:%2$@ --port 3000`."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Passa una porta da 1 a 65535 per la macchina `%1$@`, per esempio `cmux cloud %3$@ --target machine:%2$@ --port 3000`."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "សូមផ្ដល់ច្រកពី 1 ដល់ 65535 សម្រាប់ម៉ាស៊ីន `%1$@` ឧទាហរណ៍ `cmux cloud %3$@ --target machine:%2$@ --port 3000`។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Oppgi en port fra 1 til 65535 for maskinen `%1$@`, for eksempel `cmux cloud %3$@ --target machine:%2$@ --port 3000`."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Podaj port od 1 do 65535 dla maszyny `%1$@`, na przykład `cmux cloud %3$@ --target machine:%2$@ --port 3000`."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Passe uma porta de 1 a 65535 para a máquina `%1$@`, por exemplo `cmux cloud %3$@ --target machine:%2$@ --port 3000`."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Укажите порт от 1 до 65535 для машины `%1$@`, например `cmux cloud %3$@ --target machine:%2$@ --port 3000`."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ระบุพอร์ตตั้งแต่ 1 ถึง 65535 สำหรับเครื่อง `%1$@` เช่น `cmux cloud %3$@ --target machine:%2$@ --port 3000`"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "`%1$@` makinesi için 1 ile 65535 arasında bir port verin, örneğin `cmux cloud %3$@ --target machine:%2$@ --port 3000`."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Укажіть порт від 1 до 65535 для машини `%1$@`, наприклад `cmux cloud %3$@ --target machine:%2$@ --port 3000`."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Hãy truyền một cổng từ 1 đến 65535 cho máy `%1$@`, ví dụ `cmux cloud %3$@ --target machine:%2$@ --port 3000`."}}
      }
    },
