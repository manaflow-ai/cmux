{
  "sourceLanguage": "en",
  "strings": {
    "cloud.start.environmentMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chosen machine cannot serve the selected Cloud environment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したマシンでは指定の Cloud 環境を使用できません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gewählte Maschine kann die ausgewählte Cloud-Umgebung nicht verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La machine choisie ne peut pas utiliser cet environnement Cloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La máquina elegida no puede usar el entorno de Cloud seleccionado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن للجهاز المختار استخدام بيئة Cloud المحددة."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 머신에서 지정된 Cloud 환경을 사용할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选机器无法使用指定的 Cloud 环境。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選機器無法使用指定的 Cloud 環境。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odabrana mašina ne može koristiti izabrano Cloud okruženje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den valgte maskine kan ikke bruge det valgte Cloud-miljø."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La macchina scelta non può usare l’ambiente Cloud selezionato."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម៉ាស៊ីនដែលបានជ្រើសមិនអាចប្រើបរិស្ថាន Cloud ដែលបានកំណត់ទេ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den valgte maskinen kan ikke bruke det valgte Cloud-miljøet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrana maszyna nie może użyć wskazanego środowiska Cloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A máquina escolhida não pode usar o ambiente Cloud selecionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранная машина не поддерживает указанную среду Cloud."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องที่เลือกไม่สามารถใช้สภาพแวดล้อม Cloud ที่ระบุได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen makine belirtilen Cloud ortamını kullanamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрана машина не може використовувати вказане середовище Cloud."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy đã chọn không thể sử dụng môi trường Cloud được chỉ định."
          }
        }
      }
    },
    "cloud.startSession.start": {
      "comment": "Button on the card: start the agent session.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Start"}},
        "ja": {"stringUnit": {"state": "translated", "value": "開始"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Starten"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Démarrer"}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Iniciar"}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "بدء"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "시작"}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "启动"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "啟動"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Pokreni"}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Kør"}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Avvia"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ចាប់ផ្ដើម"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Kjør"}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Uruchom"}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Iniciar"}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Запустить"}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เริ่ม"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Başlat"}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Запустити"}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Bắt đầu"}}
      }
    },
    "cloud.startSession.noPage": {
      "comment": "The card couldn't show in the chat. %1$@ machine, %2$@ agent, %3$@ the command (keep it in backticks).",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Couldn't show the question in the chat, so %2$@ didn't start on %1$@. Run `%3$@` again once the chat is open."}},
        "ja": {"stringUnit": {"state": "translated", "value": "チャットに確認を表示できなかったため、%1$@ で %2$@ は開始されませんでした。チャットを開いてから `%3$@` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Die Frage konnte im Chat nicht angezeigt werden, daher wurde %2$@ auf %1$@ nicht gestartet. Führe `%3$@` erneut aus, sobald der Chat geöffnet ist."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Impossible d'afficher la question dans la discussion : %2$@ n'a pas démarré sur %1$@. Relancez `%3$@` une fois la discussion ouverte."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "No se pudo mostrar la pregunta en el chat, así que %2$@ no se inició en %1$@. Vuelve a ejecutar `%3$@` cuando el chat esté abierto."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تعذّر عرض السؤال في الدردشة، لذا لم يبدأ %2$@ على %1$@. شغّل `%3$@` مرة أخرى بعد فتح الدردشة."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "채팅에 질문을 표시하지 못해 %1$@에서 %2$@이(가) 시작되지 않았습니다. 채팅이 열리면 `%3$@`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "无法在聊天中显示问题，因此 %2$@ 没有在 %1$@ 上启动。聊天打开后请再次运行 `%3$@`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "無法在聊天中顯示問題，因此 %2$@ 沒有在 %1$@ 上啟動。聊天開啟後請再次執行 `%3$@`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Nije moguće prikazati pitanje u razgovoru, pa se %2$@ nije pokrenuo na %1$@. Ponovo pokrenite `%3$@` kada razgovor bude otvoren."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Kunne ikke vise spørgsmålet i chatten, så %2$@ startede ikke på %1$@. Kør `%3$@` igen, når chatten er åben."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Impossibile mostrare la domanda nella chat, quindi %2$@ non è stato avviato su %1$@. Esegui di nuovo `%3$@` quando la chat è aperta."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "មិនអាចបង្ហាញសំណួរក្នុងការជជែកបានទេ ដូច្នេះ %2$@ មិនបានចាប់ផ្ដើមនៅលើ %1$@ ទេ។ ដំណើរការ `%3$@` ម្ដងទៀតនៅពេលការជជែកបើក។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Kunne ikke vise spørsmålet i chatten, så %2$@ startet ikke på %1$@. Kjør `%3$@` på nytt når chatten er åpen."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Nie można pokazać pytania w czacie, więc %2$@ nie uruchomił się na %1$@. Uruchom ponownie `%3$@`, gdy czat będzie otwarty."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Não foi possível mostrar a pergunta no chat, então %2$@ não iniciou em %1$@. Execute `%3$@` novamente quando o chat estiver aberto."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Не удалось показать вопрос в чате, поэтому %2$@ не запущен на %1$@. Снова выполните `%3$@`, когда чат будет открыт."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "แสดงคำถามในแชทไม่ได้ %2$@ จึงไม่ได้เริ่มบน %1$@ เรียกใช้ `%3$@` อีกครั้งเมื่อแชทเปิดอยู่"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Soru sohbette gösterilemedi, bu yüzden %2$@ %1$@ üzerinde başlamadı. Sohbet açıkken `%3$@` komutunu yeniden çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Не вдалося показати запитання в чаті, тому %2$@ не запущено на %1$@. Знову виконайте `%3$@`, коли чат буде відкрито."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Không thể hiển thị câu hỏi trong cuộc trò chuyện nên %2$@ chưa khởi động trên %1$@. Chạy lại `%3$@` khi cuộc trò chuyện đang mở."}}
      }
    },
    "cloud.startSession.askOpen": {
      "comment": "A second ask while the chat's card is still open. %1$@ machine, %2$@ agent, %3$@ the command (keep it in backticks).",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This chat already asks the person to start a Cloud session. Wait for their answer, then run `%3$@` again if %2$@ still isn't running on %1$@."}},
        "ja": {"stringUnit": {"state": "translated", "value": "このチャットではすでに Cloud セッションの開始を確認しています。回答を待ち、%1$@ で %2$@ がまだ動いていなければ `%3$@` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Dieser Chat fragt die Person schon, ob eine Cloud-Sitzung starten soll. Warte auf ihre Antwort und führe `%3$@` erneut aus, falls %2$@ auf %1$@ dann noch nicht läuft."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Cette discussion demande déjà à la personne de démarrer une session Cloud. Attendez sa réponse, puis relancez `%3$@` si %2$@ ne tourne toujours pas sur %1$@."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Este chat ya pide a la persona iniciar una sesión de Cloud. Espera su respuesta y vuelve a ejecutar `%3$@` si %2$@ sigue sin ejecutarse en %1$@."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تطلب هذه الدردشة بالفعل من الشخص بدء جلسة Cloud. انتظر إجابته، ثم شغّل `%3$@` مرة أخرى إذا كان %2$@ لا يزال لا يعمل على %1$@."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "이 채팅은 이미 사용자에게 Cloud 세션 시작을 묻고 있습니다. 답을 기다린 뒤 %1$@에서 %2$@이(가) 아직 실행 중이 아니면 `%3$@`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "此聊天已在询问对方是否启动 Cloud 会话。请等待回答；如果 %2$@ 仍未在 %1$@ 上运行，再次运行 `%3$@`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "此聊天已在詢問對方是否啟動 Cloud 工作階段。請等待回答；如果 %2$@ 仍未在 %1$@ 上執行，再次執行 `%3$@`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Ovaj razgovor već traži od osobe da pokrene Cloud sesiju. Sačekajte odgovor, a zatim ponovo pokrenite `%3$@` ako %2$@ još ne radi na %1$@."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Denne chat spørger allerede personen om at starte en Cloud-session. Vent på svaret, og kør derefter `%3$@` igen, hvis %2$@ stadig ikke kører på %1$@."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Questa chat chiede già alla persona di avviare una sessione Cloud. Attendi la risposta, poi esegui di nuovo `%3$@` se %2$@ non è ancora in esecuzione su %1$@."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ការជជែកនេះកំពុងសុំឱ្យមនុស្សនោះចាប់ផ្ដើមវគ្គ Cloud រួចហើយ។ រង់ចាំចម្លើយរបស់គេ រួចដំណើរការ `%3$@` ម្ដងទៀត ប្រសិនបើ %2$@ នៅតែមិនដំណើរការនៅលើ %1$@។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Denne chatten spør allerede personen om å starte en Cloud-økt. Vent på svaret, og kjør deretter `%3$@` på nytt hvis %2$@ fortsatt ikke kjører på %1$@."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Ten czat już prosi użytkownika o uruchomienie sesji Cloud. Poczekaj na odpowiedź, a następnie uruchom ponownie `%3$@`, jeśli %2$@ nadal nie działa na %1$@."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Este chat já está pedindo à pessoa para iniciar uma sessão do Cloud. Aguarde a resposta e execute `%3$@` novamente se %2$@ ainda não estiver rodando em %1$@."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Этот чат уже просит пользователя запустить сеанс Cloud. Дождитесь ответа, затем снова выполните `%3$@`, если %2$@ всё ещё не работает на %1$@."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "แชทนี้กำลังขอให้ผู้ใช้เริ่มเซสชัน Cloud อยู่แล้ว รอคำตอบ แล้วเรียกใช้ `%3$@` อีกครั้งหาก %2$@ ยังไม่ทำงานบน %1$@"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Bu sohbet kişiden zaten bir Cloud oturumu başlatmasını istiyor. Yanıtını bekleyin, %2$@ hâlâ %1$@ üzerinde çalışmıyorsa `%3$@` komutunu yeniden çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Цей чат уже просить користувача запустити сеанс Cloud. Дочекайтеся відповіді, потім знову виконайте `%3$@`, якщо %2$@ досі не працює на %1$@."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Cuộc trò chuyện này đã đang hỏi người dùng để bắt đầu một phiên Cloud. Hãy chờ câu trả lời, rồi chạy lại `%3$@` nếu %2$@ vẫn chưa chạy trên %1$@."}}
      }
    },
    "cloud.startSession.declined": {
      "comment": "The person chose Not now on the card. %1$@ machine, %2$@ agent, %3$@ the command (keep it in backticks).",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The person chose Not now, so %2$@ didn't start on %1$@. Ask them in the chat before you run `%3$@` again."}},
        "ja": {"stringUnit": {"state": "translated", "value": "「後で」が選ばれたため、%1$@ で %2$@ は開始されませんでした。`%3$@` をもう一度実行する前に、チャットで確認してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Die Person hat „Nicht jetzt“ gewählt, daher wurde %2$@ auf %1$@ nicht gestartet. Frag sie im Chat, bevor du `%3$@` erneut ausführst."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "La personne a choisi Pas maintenant : %2$@ n'a pas démarré sur %1$@. Demandez-lui dans la discussion avant de relancer `%3$@`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "La persona eligió Ahora no, así que %2$@ no se inició en %1$@. Pregúntale en el chat antes de volver a ejecutar `%3$@`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "اختار الشخص «ليس الآن»، لذا لم يبدأ %2$@ على %1$@. اسأله في الدردشة قبل تشغيل `%3$@` مرة أخرى."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "사용자가 나중에를 선택해 %1$@에서 %2$@이(가) 시작되지 않았습니다. `%3$@`을(를) 다시 실행하기 전에 채팅에서 물어보세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "对方选择了“以后再说”，因此 %2$@ 没有在 %1$@ 上启动。再次运行 `%3$@` 前请先在聊天中询问。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "對方選擇了「以後再說」，因此 %2$@ 沒有在 %1$@ 上啟動。再次執行 `%3$@` 前請先在聊天中詢問。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Osoba je odabrala „Ne sada“, pa se %2$@ nije pokrenuo na %1$@. Pitajte je u razgovoru prije nego što ponovo pokrenete `%3$@`."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Personen valgte »Ikke nu«, så %2$@ startede ikke på %1$@. Spørg vedkommende i chatten, før du kører `%3$@` igen."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "La persona ha scelto «Non ora», quindi %2$@ non è stato avviato su %1$@. Chiedile nella chat prima di eseguire di nuovo `%3$@`."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "មនុស្សនោះបានជ្រើស «មិនមែនឥឡូវនេះ» ដូច្នេះ %2$@ មិនបានចាប់ផ្ដើមនៅលើ %1$@ ទេ។ សួរគេក្នុងការជជែក មុនពេលអ្នកដំណើរការ `%3$@` ម្ដងទៀត។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Personen valgte «Ikke nå», så %2$@ startet ikke på %1$@. Spør vedkommende i chatten før du kjører `%3$@` på nytt."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Użytkownik wybrał „Nie teraz”, więc %2$@ nie uruchomił się na %1$@. Zapytaj go w czacie, zanim ponownie uruchomisz `%3$@`."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "A pessoa escolheu “Agora não”, então %2$@ não iniciou em %1$@. Pergunte a ela no chat antes de executar `%3$@` novamente."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Пользователь выбрал «Не сейчас», поэтому %2$@ не запущен на %1$@. Спросите его в чате, прежде чем снова выполнять `%3$@`."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ผู้ใช้เลือก “ไม่ใช่ตอนนี้” %2$@ จึงไม่ได้เริ่มบน %1$@ ถามผู้ใช้ในแชทก่อนเรียกใช้ `%3$@` อีกครั้ง"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Kişi “Şimdi değil” seçeneğini seçti, bu yüzden %2$@ %1$@ üzerinde başlamadı. `%3$@` komutunu yeniden çalıştırmadan önce sohbette ona sorun."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Користувач вибрав «Не зараз», тому %2$@ не запущено на %1$@. Запитайте його в чаті, перш ніж знову виконувати `%3$@`."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Người dùng đã chọn “Để sau” nên %2$@ chưa khởi động trên %1$@. Hãy hỏi họ trong cuộc trò chuyện trước khi chạy lại `%3$@`."}}
      }
    },
    "cloud.startSession.expired": {
      "comment": "Nobody answered the card in time. %1$@ machine, %2$@ agent, %3$@ the command (keep it in backticks).",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Nobody answered the question in the chat within 2 minutes, so %2$@ didn't start on %1$@. Run `%3$@` again when the person is there."}},
        "ja": {"stringUnit": {"state": "translated", "value": "2 分以内にチャットの確認に回答がなかったため、%1$@ で %2$@ は開始されませんでした。本人がいるときに `%3$@` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Niemand hat die Frage im Chat innerhalb von 2 Minuten beantwortet, daher wurde %2$@ auf %1$@ nicht gestartet. Führe `%3$@` erneut aus, wenn die Person da ist."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Personne n'a répondu à la question dans la discussion en 2 minutes : %2$@ n'a pas démarré sur %1$@. Relancez `%3$@` quand la personne est là."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Nadie respondió a la pregunta del chat en 2 minutos, así que %2$@ no se inició en %1$@. Vuelve a ejecutar `%3$@` cuando la persona esté."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "لم يُجب أحد عن السؤال في الدردشة خلال دقيقتين، لذا لم يبدأ %2$@ على %1$@. شغّل `%3$@` مرة أخرى عندما يكون الشخص موجودًا."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "2분 안에 채팅의 질문에 답한 사람이 없어 %1$@에서 %2$@이(가) 시작되지 않았습니다. 사용자가 있을 때 `%3$@`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "2 分钟内没有人回答聊天中的问题，因此 %2$@ 没有在 %1$@ 上启动。对方在时请再次运行 `%3$@`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "2 分鐘內沒有人回答聊天中的問題，因此 %2$@ 沒有在 %1$@ 上啟動。對方在時請再次執行 `%3$@`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Niko nije odgovorio na pitanje u razgovoru u roku od 2 minute, pa se %2$@ nije pokrenuo na %1$@. Ponovo pokrenite `%3$@` kada osoba bude tu."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Ingen svarede på spørgsmålet i chatten inden for 2 minutter, så %2$@ startede ikke på %1$@. Kør `%3$@` igen, når personen er der."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Nessuno ha risposto alla domanda nella chat entro 2 minuti, quindi %2$@ non è stato avviato su %1$@. Esegui di nuovo `%3$@` quando la persona è presente."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "គ្មាននរណាឆ្លើយសំណួរក្នុងការជជែកក្នុងរយៈពេល 2 នាទីទេ ដូច្នេះ %2$@ មិនបានចាប់ផ្ដើមនៅលើ %1$@ ទេ។ ដំណើរការ `%3$@` ម្ដងទៀតនៅពេលមនុស្សនោះនៅទីនោះ។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Ingen svarte på spørsmålet i chatten innen 2 minutter, så %2$@ startet ikke på %1$@. Kjør `%3$@` på nytt når personen er til stede."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Nikt nie odpowiedział na pytanie w czacie w ciągu 2 minut, więc %2$@ nie uruchomił się na %1$@. Uruchom ponownie `%3$@`, gdy użytkownik będzie dostępny."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Ninguém respondeu à pergunta no chat em 2 minutos, então %2$@ não iniciou em %1$@. Execute `%3$@` novamente quando a pessoa estiver presente."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Никто не ответил на вопрос в чате за 2 минуты, поэтому %2$@ не запущен на %1$@. Снова выполните `%3$@`, когда пользователь будет на месте."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ไม่มีใครตอบคำถามในแชทภายใน 2 นาที %2$@ จึงไม่ได้เริ่มบน %1$@ เรียกใช้ `%3$@` อีกครั้งเมื่อผู้ใช้อยู่"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Sohbetteki soruyu 2 dakika içinde kimse yanıtlamadı, bu yüzden %2$@ %1$@ üzerinde başlamadı. Kişi oradayken `%3$@` komutunu yeniden çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Ніхто не відповів на запитання в чаті протягом 2 хвилин, тому %2$@ не запущено на %1$@. Знову виконайте `%3$@`, коли користувач буде на місці."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Không ai trả lời câu hỏi trong cuộc trò chuyện trong vòng 2 phút nên %2$@ chưa khởi động trên %1$@. Chạy lại `%3$@` khi người dùng có mặt."}}
      }
    },
    "cloud.startSession.accountChanged": {
      "comment": "The signed-in Cloud account or team changed while the run waited. %1$@ machine, %2$@ agent, %3$@ the command (keep it in backticks).",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Your Cloud account or team changed after this was asked, so %2$@ didn't start on %1$@. Run `%3$@` again in the account you want it in."}},
        "ja": {"stringUnit": {"state": "translated", "value": "確認の後に Cloud のアカウントまたはチームが変わったため、%1$@ で %2$@ は開始されませんでした。使いたいアカウントで `%3$@` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Dein Cloud-Konto oder Team hat sich nach der Anfrage geändert, daher wurde %2$@ auf %1$@ nicht gestartet. Führe `%3$@` im gewünschten Konto erneut aus."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Votre compte ou équipe Cloud a changé après la demande : %2$@ n'a pas démarré sur %1$@. Relancez `%3$@` dans le compte voulu."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Tu cuenta o equipo de Cloud cambió después de la solicitud, así que %2$@ no se inició en %1$@. Vuelve a ejecutar `%3$@` en la cuenta que quieras."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تغيّر حساب Cloud أو الفريق بعد الطلب، لذا لم يبدأ %2$@ على %1$@. شغّل `%3$@` مرة أخرى في الحساب الذي تريده."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "요청 후 Cloud 계정 또는 팀이 바뀌어 %1$@에서 %2$@이(가) 시작되지 않았습니다. 원하는 계정에서 `%3$@`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "提出请求后你的 Cloud 帐户或团队已更改，因此 %2$@ 没有在 %1$@ 上启动。请在你想要的帐户中再次运行 `%3$@`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "提出請求後你的 Cloud 帳號或團隊已變更，因此 %2$@ 沒有在 %1$@ 上啟動。請在你想要的帳號中再次執行 `%3$@`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Vaš Cloud račun ili tim se promijenio nakon zahtjeva, pa %2$@ nije pokrenut na %1$@. Ponovo pokrenite `%3$@` u računu u kojem ga želite."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Din Cloud-konto eller dit team ændrede sig efter anmodningen, så %2$@ startede ikke på %1$@. Kør `%3$@` igen i den konto, du vil bruge."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Il tuo account o team Cloud è cambiato dopo la richiesta, quindi %2$@ non è stato avviato su %1$@. Esegui di nuovo `%3$@` nell'account che vuoi usare."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "គណនី ឬក្រុម Cloud របស់អ្នកបានប្តូរបន្ទាប់ពីសំណើនេះ ដូច្នេះ %2$@ មិនបានចាប់ផ្តើមលើ %1$@ ទេ។ ដំណើរការ `%3$@` ម្តងទៀតក្នុងគណនីដែលអ្នកចង់ប្រើ។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Cloud-kontoen eller teamet ditt endret seg etter forespørselen, så %2$@ startet ikke på %1$@. Kjør `%3$@` igjen i kontoen du vil bruke."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Twoje konto lub zespół Cloud zmieniły się po prośbie, więc %2$@ nie uruchomiono na %1$@. Uruchom `%3$@` ponownie na koncie, którego chcesz użyć."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Sua conta ou equipe do Cloud mudou depois do pedido, então %2$@ não foi iniciado em %1$@. Execute `%3$@` de novo na conta que você quer usar."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Аккаунт или команда Cloud изменились после запроса, поэтому %2$@ не запущен на %1$@. Снова выполните `%3$@` в нужном аккаунте."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "บัญชีหรือทีม Cloud ของคุณเปลี่ยนไปหลังจากคำขอนี้ %2$@ จึงไม่ได้เริ่มบน %1$@ เรียกใช้ `%3$@` อีกครั้งในบัญชีที่คุณต้องการ"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "İstekten sonra Cloud hesabınız veya ekibiniz değişti, bu yüzden %2$@ %1$@ üzerinde başlamadı. `%3$@` komutunu istediğiniz hesapta yeniden çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Обліковий запис або команда Cloud змінилися після запиту, тому %2$@ не запущено на %1$@. Знову виконайте `%3$@` у потрібному обліковому записі."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Tài khoản hoặc nhóm Cloud của bạn đã thay đổi sau yêu cầu này, nên %2$@ chưa khởi động trên %1$@. Hãy chạy lại `%3$@` trong tài khoản bạn muốn dùng."}}
      }
    },
    "cloud.startSession.accountChangedWhileStarting": {
      "comment": "The signed-in Cloud account or team changed after the person clicked Start, while the run went on, so it stopped. %1$@ machine, %2$@ agent, %3$@ the command (keep it in backticks).",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Your Cloud account or team changed while %2$@ was starting on %1$@, so the start stopped. Run `%3$@` again in the account you want it in."}},
        "ja": {"stringUnit": {"state": "translated", "value": "%1$@ で %2$@ を開始している間に Cloud のアカウントまたはチームが変わったため、開始は中止されました。使いたいアカウントで `%3$@` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Dein Cloud-Konto oder Team hat sich geändert, während %2$@ auf %1$@ startete, daher wurde der Start abgebrochen. Führe `%3$@` im gewünschten Konto erneut aus."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Votre compte ou équipe Cloud a changé pendant le démarrage de %2$@ sur %1$@ : le démarrage s'est arrêté. Relancez `%3$@` dans le compte voulu."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Tu cuenta o equipo de Cloud cambió mientras %2$@ se iniciaba en %1$@, así que el inicio se detuvo. Vuelve a ejecutar `%3$@` en la cuenta que quieras."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تغيّر حساب Cloud أو الفريق أثناء بدء %2$@ على %1$@، لذا توقّف البدء. شغّل `%3$@` مرة أخرى في الحساب الذي تريده."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "%1$@에서 %2$@을(를) 시작하는 동안 Cloud 계정 또는 팀이 바뀌어 시작이 중단되었습니다. 원하는 계정에서 `%3$@`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "在 %1$@ 上启动 %2$@ 期间你的 Cloud 帐户或团队已更改，因此启动已停止。请在你想要的帐户中再次运行 `%3$@`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "在 %1$@ 上啟動 %2$@ 期間你的 Cloud 帳號或團隊已變更，因此啟動已停止。請在你想要的帳號中再次執行 `%3$@`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Vaš Cloud račun ili tim promijenio se dok se %2$@ pokretao na %1$@, pa je pokretanje zaustavljeno. Ponovo pokrenite `%3$@` u računu u kojem ga želite."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Din Cloud-konto eller dit team ændrede sig, mens %2$@ startede på %1$@, så starten stoppede. Kør `%3$@` igen i den konto, du vil bruge."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Il tuo account o team Cloud è cambiato mentre %2$@ si avviava su %1$@, quindi l'avvio si è fermato. Esegui di nuovo `%3$@` nell'account che vuoi."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "គណនី ឬក្រុម Cloud របស់អ្នកបានផ្លាស់ប្ដូរ ខណៈពេល %2$@ កំពុងចាប់ផ្ដើមនៅលើ %1$@ ដូច្នេះការចាប់ផ្ដើមបានឈប់។ ដំណើរការ `%3$@` ម្ដងទៀតក្នុងគណនីដែលអ្នកចង់បាន។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Cloud-kontoen eller teamet ditt endret seg mens %2$@ startet på %1$@, så oppstarten stoppet. Kjør `%3$@` på nytt i kontoen du vil bruke."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Twoje konto lub zespół Cloud zmieniły się podczas uruchamiania %2$@ na %1$@, więc uruchamianie zostało zatrzymane. Uruchom ponownie `%3$@` na wybranym koncie."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Sua conta ou equipe do Cloud mudou enquanto %2$@ iniciava em %1$@, então a inicialização parou. Execute `%3$@` novamente na conta que você quer."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Ваш аккаунт или команда Cloud изменились, пока %2$@ запускался на %1$@, поэтому запуск остановлен. Снова выполните `%3$@` в нужном аккаунте."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "บัญชีหรือทีม Cloud ของคุณเปลี่ยนไประหว่างที่ %2$@ กำลังเริ่มบน %1$@ การเริ่มจึงหยุดลง เรียกใช้ `%3$@` อีกครั้งในบัญชีที่คุณต้องการ"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "%2$@ %1$@ üzerinde başlatılırken Cloud hesabınız veya ekibiniz değişti, bu yüzden başlatma durduruldu. `%3$@` komutunu istediğiniz hesapta yeniden çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Ваш обліковий запис або команда Cloud змінилися, поки %2$@ запускався на %1$@, тому запуск зупинено. Знову виконайте `%3$@` у потрібному обліковому записі."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Tài khoản hoặc nhóm Cloud của bạn đã thay đổi trong khi %2$@ đang khởi động trên %1$@, nên việc khởi động đã dừng. Chạy lại `%3$@` trong tài khoản bạn muốn."}}
      }
    },
    "cloud.startSession.setupRequired": {
      "comment": "cmux cloud start-session refused because no connection serves the agent in Cloud (the composer shows Set up Cloud). %1$@ is the agent (codex). %2$@ is the command to run again. Keep the command and the Settings button names as the app shows them.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "No Cloud connection serves %1$@ yet. Add one in Settings > Cloud (ChatGPT, Claude or an API key), then run `%2$@` again."}},
        "ja": {"stringUnit": {"state": "translated", "value": "Cloud で %1$@ を使える接続がまだありません。「設定 > Cloud」で接続(ChatGPT、Claude、または API キー)を追加してから、`%2$@` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Noch keine Cloud-Verbindung stellt %1$@ bereit. Füge eine in Einstellungen > Cloud hinzu (ChatGPT, Claude oder ein API-Schlüssel) und führe dann `%2$@` erneut aus."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Aucune connexion Cloud ne fournit encore %1$@. Ajoutez-en une dans Réglages > Cloud (ChatGPT, Claude ou une clé API), puis relancez `%2$@`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Ninguna conexión de Cloud ofrece %1$@ todavía. Añade una en Ajustes > Cloud (ChatGPT, Claude o una clave de API) y vuelve a ejecutar `%2$@`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "لا يوجد اتصال Cloud يوفّر %1$@ بعد. أضف اتصالًا في الإعدادات > Cloud (ChatGPT أو Claude أو مفتاح API)، ثم شغّل `%2$@` مرة أخرى."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "Cloud에서 %1$@을(를) 제공하는 연결이 아직 없습니다. 설정 > Cloud에서 연결(ChatGPT, Claude 또는 API 키)을 추가한 다음 `%2$@`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "还没有可在 Cloud 中提供 %1$@ 的连接。请在“设置 > Cloud”中添加一个（ChatGPT、Claude 或 API 密钥），然后再次运行 `%2$@`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "還沒有可在 Cloud 中提供 %1$@ 的連線。請在「設定 > Cloud」中新增一個（ChatGPT、Claude 或 API 金鑰），然後再次執行 `%2$@`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Još nijedna Cloud veza ne pruža %1$@. Dodaj jednu u Postavke > Cloud (ChatGPT, Claude ili API ključ), pa ponovo pokreni `%2$@`."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Ingen Cloud-forbindelse leverer %1$@ endnu. Tilføj en i Indstillinger > Cloud (ChatGPT, Claude eller en API-nøgle), og kør derefter `%2$@` igen."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Nessuna connessione Cloud fornisce ancora %1$@. Aggiungine una in Impostazioni > Cloud (ChatGPT, Claude o una chiave API), poi esegui di nuovo `%2$@`."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "មិនទាន់មានការតភ្ជាប់ Cloud ណាផ្តល់ %1$@ នៅឡើយទេ។ សូមបន្ថែមមួយនៅក្នុង ការកំណត់ > Cloud (ChatGPT, Claude ឬសោ API) រួចដំណើរការ `%2$@` ម្តងទៀត។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Ingen Cloud-tilkobling leverer %1$@ ennå. Legg til én i Innstillinger > Cloud (ChatGPT, Claude eller en API-nøkkel), og kjør deretter `%2$@` på nytt."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Żadne połączenie Cloud nie udostępnia jeszcze %1$@. Dodaj je w Ustawienia > Cloud (ChatGPT, Claude lub klucz API), a potem ponownie uruchom `%2$@`."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Nenhuma conexão do Cloud oferece %1$@ ainda. Adicione uma em Ajustes > Cloud (ChatGPT, Claude ou uma chave de API) e execute `%2$@` novamente."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Пока нет подключения Cloud, которое предоставляет %1$@. Добавьте его в «Настройки > Cloud» (ChatGPT, Claude или ключ API) и снова выполните `%2$@`."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ยังไม่มีการเชื่อมต่อ Cloud ที่ให้บริการ %1$@ เพิ่มการเชื่อมต่อใน การตั้งค่า > Cloud (ChatGPT, Claude หรือคีย์ API) แล้วเรียกใช้ `%2$@` อีกครั้ง"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Henüz %1$@ sunan bir Cloud bağlantısı yok. Ayarlar > Cloud'dan bir bağlantı ekleyin (ChatGPT, Claude veya bir API anahtarı), ardından `%2$@` komutunu yeniden çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Поки немає підключення Cloud, яке надає %1$@. Додайте його в «Налаштування > Cloud» (ChatGPT, Claude або ключ API) і знову виконайте `%2$@`."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Chưa có kết nối Cloud nào cung cấp %1$@. Hãy thêm một kết nối trong Cài đặt > Cloud (ChatGPT, Claude hoặc khóa API), rồi chạy lại `%2$@`."}}
      }
    },
    "cloud.startSession.setupRequired.open": {
      "comment": "After cloud.startSession.setupRequired: the command that opens the Settings > Cloud row that sets the agent up. %@ is the cmux:// link. Keep the command as is.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "`cmux link open --url %@` opens it there."}},
        "ja": {"stringUnit": {"state": "translated", "value": "`cmux link open --url %@` でその設定を開けます。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "`cmux link open --url %@` öffnet sie dort."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "`cmux link open --url %@` l’ouvre à cet endroit."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "`cmux link open --url %@` lo abre allí."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "يفتحه `cmux link open --url %@` هناك."}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "`cmux link open --url %@` ga otvara tamo."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "`cmux link open --url %@` åbner den der."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "`cmux link open --url %@` lo apre lì."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "`cmux link open --url %@` បើកវានៅទីនោះ។"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "`cmux link open --url %@`로 그 설정을 엽니다."}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "`cmux link open --url %@` åpner den der."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "`cmux link open --url %@` otwiera to ustawienie."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "`cmux link open --url %@` abre esse ajuste."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "`cmux link open --url %@` открывает этот параметр."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "`cmux link open --url %@` จะเปิดการตั้งค่านั้น"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "`cmux link open --url %@` onu orada açar."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "`cmux link open --url %@` відкриває це налаштування."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "`cmux link open --url %@` mở mục đó."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "`cmux link open --url %@` 可在那里打开它。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "`cmux link open --url %@` 可在那裡開啟它。"}}
      }
    },
    "cloud.startSession.setupRequired.claudeLogin": {
      "comment": "Before cloud.startSession.setupRequired: this Mac is signed in to Claude Code, whose login serves only this Mac, not Cloud. Keep Claude Code and setup token as the app names them.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Your Claude Code login on this Mac works only on this Mac; Cloud needs a Claude setup token (or an API key)."}},
        "ja": {"stringUnit": {"state": "translated", "value": "この Mac の Claude Code のログインはこの Mac でしか使えません。Cloud には Claude のセットアップトークン(または API キー)が必要です。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Deine Claude Code-Anmeldung auf diesem Mac gilt nur auf diesem Mac; Cloud braucht ein Claude-Setup-Token (oder einen API-Schlüssel)."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Votre connexion Claude Code sur ce Mac ne fonctionne que sur ce Mac ; Cloud a besoin d’un jeton de configuration Claude (ou d’une clé API)."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Tu inicio de sesión de Claude Code en este Mac solo funciona en este Mac; Cloud necesita un token de configuración de Claude (o una clave de API)."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تسجيل دخولك إلى Claude Code على جهاز Mac هذا يعمل عليه فقط؛ يحتاج Cloud إلى رمز إعداد Claude (أو مفتاح API)."}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Vaša Claude Code prijava na ovom Macu radi samo na ovom Macu; Cloud treba Claude token za postavljanje (ili API ključ)."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Dit Claude Code-login på denne Mac virker kun på denne Mac; Cloud skal bruge et Claude-opsætningstoken (eller en API-nøgle)."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Il tuo accesso a Claude Code su questo Mac funziona solo su questo Mac; Cloud richiede un token di configurazione di Claude (o una chiave API)."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ការចូល Claude Code របស់អ្នកលើ Mac នេះដំណើរការតែលើ Mac នេះប៉ុណ្ណោះ; Cloud ត្រូវការតូខឹនរៀបចំ Claude (ឬកូនសោ API)។"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "이 Mac의 Claude Code 로그인은 이 Mac에서만 작동합니다. Cloud에는 Claude 설정 토큰(또는 API 키)이 필요합니다."}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Claude Code-påloggingen din på denne Macen virker bare på denne Macen; Cloud trenger et Claude-oppsettstoken (eller en API-nøkkel)."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Twoje logowanie do Claude Code na tym Macu działa tylko na tym Macu; Cloud potrzebuje tokenu konfiguracji Claude (lub klucza API)."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Seu login do Claude Code neste Mac funciona só neste Mac; o Cloud precisa de um token de configuração do Claude (ou de uma chave de API)."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Вход в Claude Code на этом Mac работает только на этом Mac; Cloud нужен токен настройки Claude (или ключ API)."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "การเข้าสู่ระบบ Claude Code บน Mac เครื่องนี้ใช้ได้เฉพาะบน Mac เครื่องนี้ Cloud ต้องใช้โทเค็นตั้งค่า Claude (หรือคีย์ API)"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Bu Mac’teki Claude Code girişiniz yalnızca bu Mac’te çalışır; Cloud bir Claude kurulum belirteci (veya bir API anahtarı) gerektirir."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Ваш вхід у Claude Code на цьому Mac працює лише на цьому Mac; Cloud потрібен токен налаштування Claude (або ключ API)."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Đăng nhập Claude Code trên máy Mac này chỉ dùng được trên máy Mac này; Cloud cần mã thiết lập Claude (hoặc khóa API)."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "你在这台 Mac 上的 Claude Code 登录只能在这台 Mac 上使用；Cloud 需要 Claude 设置令牌（或 API 密钥）。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "你在這台 Mac 上的 Claude Code 登入只能在這台 Mac 上使用；Cloud 需要 Claude 設定權杖（或 API 金鑰）。"}}
      }
    },
    "cloud.startSession.setupRequired.codexLogin": {
      "comment": "Before cloud.startSession.setupRequired: this Mac is signed in to Codex, whose login serves only this Mac, not Cloud. Keep Codex and ChatGPT as the app names them.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Your Codex login on this Mac works only on this Mac; Cloud needs a ChatGPT connection (or an API key)."}},
        "ja": {"stringUnit": {"state": "translated", "value": "この Mac の Codex のログインはこの Mac でしか使えません。Cloud には ChatGPT の接続(または API キー)が必要です。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Deine Codex-Anmeldung auf diesem Mac gilt nur auf diesem Mac; Cloud braucht eine ChatGPT-Verbindung (oder einen API-Schlüssel)."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Votre connexion Codex sur ce Mac ne fonctionne que sur ce Mac ; Cloud a besoin d’une connexion ChatGPT (ou d’une clé API)."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Tu inicio de sesión de Codex en este Mac solo funciona en este Mac; Cloud necesita una conexión de ChatGPT (o una clave de API)."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تسجيل دخولك إلى Codex على جهاز Mac هذا يعمل عليه فقط؛ يحتاج Cloud إلى اتصال ChatGPT (أو مفتاح API)."}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Vaša Codex prijava na ovom Macu radi samo na ovom Macu; Cloud treba ChatGPT vezu (ili API ključ)."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Dit Codex-login på denne Mac virker kun på denne Mac; Cloud skal bruge en ChatGPT-forbindelse (eller en API-nøgle)."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Il tuo accesso a Codex su questo Mac funziona solo su questo Mac; Cloud richiede una connessione ChatGPT (o una chiave API)."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ការចូល Codex របស់អ្នកលើ Mac នេះដំណើរការតែលើ Mac នេះប៉ុណ្ណោះ; Cloud ត្រូវការការតភ្ជាប់ ChatGPT (ឬកូនសោ API)។"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "이 Mac의 Codex 로그인은 이 Mac에서만 작동합니다. Cloud에는 ChatGPT 연결(또는 API 키)이 필요합니다."}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Codex-påloggingen din på denne Macen virker bare på denne Macen; Cloud trenger en ChatGPT-tilkobling (eller en API-nøkkel)."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Twoje logowanie do Codex na tym Macu działa tylko na tym Macu; Cloud potrzebuje połączenia z ChatGPT (lub klucza API)."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Seu login do Codex neste Mac funciona só neste Mac; o Cloud precisa de uma conexão com o ChatGPT (ou de uma chave de API)."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Вход в Codex на этом Mac работает только на этом Mac; Cloud нужно подключение ChatGPT (или ключ API)."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "การเข้าสู่ระบบ Codex บน Mac เครื่องนี้ใช้ได้เฉพาะบน Mac เครื่องนี้ Cloud ต้องใช้การเชื่อมต่อ ChatGPT (หรือคีย์ API)"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Bu Mac’teki Codex girişiniz yalnızca bu Mac’te çalışır; Cloud bir ChatGPT bağlantısı (veya bir API anahtarı) gerektirir."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Ваш вхід у Codex на цьому Mac працює лише на цьому Mac; Cloud потрібне підключення ChatGPT (або ключ API)."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Đăng nhập Codex trên máy Mac này chỉ dùng được trên máy Mac này; Cloud cần kết nối ChatGPT (hoặc khóa API)."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "你在这台 Mac 上的 Codex 登录只能在这台 Mac 上使用；Cloud 需要 ChatGPT 连接（或 API 密钥）。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "你在這台 Mac 上的 Codex 登入只能在這台 Mac 上使用；Cloud 需要 ChatGPT 連線（或 API 金鑰）。"}}
      }
    },
    "cloud.startSession.needsMachine": {
      "comment": "cmux cloud start-session run by a script or agent without a machine. %1$@ is the agent (claude). Keep the commands as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Say which Cloud machine to start %1$@ on: `cmux cloud start-session --target machine:<id> --agent %1$@`, or `--name <name>` to take that machine or create it. `cmux cloud list-machines` lists your machines."}},
        "ja": {"stringUnit": {"state": "translated", "value": "%1$@ を開始する Cloud マシンを指定してください: `cmux cloud start-session --target machine:<id> --agent %1$@`、または `--name <name>` でその名前のマシンを使うか作成します。`cmux cloud list-machines` でマシンを一覧表示できます。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Gib an, auf welcher Cloud-Maschine %1$@ starten soll: `cmux cloud start-session --target machine:<id> --agent %1$@`, oder `--name <name>`, um diese Maschine zu nehmen oder zu erstellen. `cmux cloud list-machines` listet deine Maschinen."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Indiquez sur quelle machine Cloud démarrer %1$@ : `cmux cloud start-session --target machine:<id> --agent %1$@`, ou `--name <name>` pour prendre cette machine ou la créer. `cmux cloud list-machines` liste vos machines."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Indica en qué máquina de Cloud iniciar %1$@: `cmux cloud start-session --target machine:<id> --agent %1$@`, o `--name <name>` para usar esa máquina o crearla. `cmux cloud list-machines` muestra tus máquinas."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "حدّد جهاز Cloud الذي يبدأ عليه %1$@: `cmux cloud start-session --target machine:<id> --agent %1$@`، أو `--name <name>` لاستخدام ذلك الجهاز أو إنشائه. يعرض `cmux cloud list-machines` أجهزتك."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "%1$@을(를) 시작할 Cloud 머신을 지정하세요: `cmux cloud start-session --target machine:<id> --agent %1$@`, 또는 `--name <name>`으로 그 머신을 사용하거나 만듭니다. `cmux cloud list-machines`로 머신 목록을 볼 수 있습니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "请指定在哪台 Cloud 机器上启动 %1$@：`cmux cloud start-session --target machine:<id> --agent %1$@`，或用 `--name <name>` 使用或创建该机器。`cmux cloud list-machines` 会列出你的机器。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "請指定在哪台 Cloud 機器上啟動 %1$@：`cmux cloud start-session --target machine:<id> --agent %1$@`，或用 `--name <name>` 使用或建立該機器。`cmux cloud list-machines` 會列出你的機器。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Navedite na kojoj Cloud mašini treba pokrenuti %1$@: `cmux cloud start-session --target machine:<id> --agent %1$@` ili `--name <name>` da uzmete tu mašinu ili je kreirate. `cmux cloud list-machines` prikazuje vaše mašine."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Angiv, hvilken Cloud-maskine %1$@ skal startes på: `cmux cloud start-session --target machine:<id> --agent %1$@`, eller `--name <name>` for at bruge den maskine eller oprette den. `cmux cloud list-machines` viser dine maskiner."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Indica su quale macchina Cloud avviare %1$@: `cmux cloud start-session --target machine:<id> --agent %1$@`, oppure `--name <name>` per usare quella macchina o crearla. `cmux cloud list-machines` elenca le tue macchine."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "បញ្ជាក់ម៉ាស៊ីន Cloud ដែលត្រូវចាប់ផ្ដើម %1$@៖ `cmux cloud start-session --target machine:<id> --agent %1$@` ឬ `--name <name>` ដើម្បីយកម៉ាស៊ីននោះ ឬបង្កើតវា។ `cmux cloud list-machines` បង្ហាញម៉ាស៊ីនរបស់អ្នក។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Angi hvilken Cloud-maskin %1$@ skal startes på: `cmux cloud start-session --target machine:<id> --agent %1$@`, eller `--name <name>` for å bruke den maskinen eller opprette den. `cmux cloud list-machines` viser maskinene dine."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Wskaż, na której maszynie Cloud uruchomić %1$@: `cmux cloud start-session --target machine:<id> --agent %1$@` lub `--name <name>`, aby użyć tej maszyny albo ją utworzyć. `cmux cloud list-machines` wyświetla Twoje maszyny."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Diga em qual máquina do Cloud iniciar %1$@: `cmux cloud start-session --target machine:<id> --agent %1$@`, ou `--name <name>` para usar essa máquina ou criá-la. `cmux cloud list-machines` lista suas máquinas."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Укажите, на какой машине Cloud запустить %1$@: `cmux cloud start-session --target machine:<id> --agent %1$@` или `--name <name>`, чтобы взять эту машину или создать её. `cmux cloud list-machines` показывает ваши машины."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ระบุเครื่อง Cloud ที่จะเริ่ม %1$@: `cmux cloud start-session --target machine:<id> --agent %1$@` หรือ `--name <name>` เพื่อใช้เครื่องนั้นหรือสร้างขึ้นใหม่ `cmux cloud list-machines` แสดงรายการเครื่องของคุณ"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "%1$@ ajanının hangi Cloud makinesinde başlatılacağını belirtin: `cmux cloud start-session --target machine:<id> --agent %1$@` veya o makineyi kullanmak ya da oluşturmak için `--name <name>`. `cmux cloud list-machines` makinelerinizi listeler."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Вкажіть, на якій машині Cloud запустити %1$@: `cmux cloud start-session --target machine:<id> --agent %1$@` або `--name <name>`, щоб узяти цю машину чи створити її. `cmux cloud list-machines` показує ваші машини."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Hãy cho biết máy Cloud nào để khởi động %1$@: `cmux cloud start-session --target machine:<id> --agent %1$@`, hoặc `--name <name>` để dùng máy đó hoặc tạo máy mới. `cmux cloud list-machines` liệt kê các máy của bạn."}}
      }
    },
    "cloud.startSession.noSuchMachine": {
      "comment": "cmux cloud start-session --target names no listed machine. %1$@ is the machine id, %2$@ the agent.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "No Cloud machine `%1$@` is listed on this Mac. `cmux cloud list-machines` lists them, and `cmux cloud start-session --name <name> --agent %2$@` creates one."}},
        "ja": {"stringUnit": {"state": "translated", "value": "Cloud マシン `%1$@` はこの Mac に表示されていません。`cmux cloud list-machines` で一覧を表示し、`cmux cloud start-session --name <name> --agent %2$@` で作成できます。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Keine Cloud-Maschine `%1$@` ist auf diesem Mac aufgeführt. `cmux cloud list-machines` listet sie, und `cmux cloud start-session --name <name> --agent %2$@` erstellt eine."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Aucune machine Cloud `%1$@` n'est listée sur ce Mac. `cmux cloud list-machines` les liste, et `cmux cloud start-session --name <name> --agent %2$@` en crée une."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "No hay ninguna máquina de Cloud `%1$@` en este Mac. `cmux cloud list-machines` las muestra y `cmux cloud start-session --name <name> --agent %2$@` crea una."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "لا يوجد جهاز Cloud باسم `%1$@` في قائمة هذا الـ Mac. يعرضها `cmux cloud list-machines`، وينشئ `cmux cloud start-session --name <name> --agent %2$@` جهازًا جديدًا."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "이 Mac에 Cloud 머신 `%1$@`이(가) 없습니다. `cmux cloud list-machines`로 목록을 보고 `cmux cloud start-session --name <name> --agent %2$@`로 만들 수 있습니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "这台 Mac 上没有 Cloud 机器 `%1$@`。`cmux cloud list-machines` 会列出机器，`cmux cloud start-session --name <name> --agent %2$@` 会创建一台。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "這台 Mac 上沒有 Cloud 機器 `%1$@`。`cmux cloud list-machines` 會列出機器，`cmux cloud start-session --name <name> --agent %2$@` 會建立一台。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Nijedna Cloud mašina `%1$@` nije navedena na ovom Mac računaru. `cmux cloud list-machines` ih prikazuje, a `cmux cloud start-session --name <name> --agent %2$@` kreira novu."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Ingen Cloud-maskine `%1$@` er på listen på denne Mac. `cmux cloud list-machines` viser dem, og `cmux cloud start-session --name <name> --agent %2$@` opretter en."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Nessuna macchina Cloud `%1$@` è elencata su questo Mac. `cmux cloud list-machines` le elenca e `cmux cloud start-session --name <name> --agent %2$@` ne crea una."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "គ្មានម៉ាស៊ីន Cloud `%1$@` ក្នុងបញ្ជីនៅលើ Mac នេះទេ។ `cmux cloud list-machines` បង្ហាញបញ្ជីម៉ាស៊ីន ហើយ `cmux cloud start-session --name <name> --agent %2$@` បង្កើតម៉ាស៊ីនថ្មី។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Ingen Cloud-maskin `%1$@` er oppført på denne Mac-en. `cmux cloud list-machines` viser dem, og `cmux cloud start-session --name <name> --agent %2$@` oppretter en."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Na tym komputerze Mac nie ma na liście maszyny Cloud `%1$@`. `cmux cloud list-machines` wyświetla listę maszyn, a `cmux cloud start-session --name <name> --agent %2$@` tworzy nową."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Nenhuma máquina do Cloud `%1$@` está listada neste Mac. `cmux cloud list-machines` lista as máquinas, e `cmux cloud start-session --name <name> --agent %2$@` cria uma."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "На этом Mac в списке нет машины Cloud `%1$@`. `cmux cloud list-machines` показывает их, а `cmux cloud start-session --name <name> --agent %2$@` создаёт новую."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ไม่มีเครื่อง Cloud `%1$@` ในรายการบน Mac เครื่องนี้ `cmux cloud list-machines` แสดงรายการเครื่อง และ `cmux cloud start-session --name <name> --agent %2$@` จะสร้างเครื่องใหม่"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Bu Mac'te listelenen `%1$@` adında bir Cloud makinesi yok. `cmux cloud list-machines` makineleri listeler, `cmux cloud start-session --name <name> --agent %2$@` ise yeni bir makine oluşturur."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "На цьому Mac у списку немає машини Cloud `%1$@`. `cmux cloud list-machines` показує їх, а `cmux cloud start-session --name <name> --agent %2$@` створює нову."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Không có máy Cloud `%1$@` nào trong danh sách trên máy Mac này. `cmux cloud list-machines` liệt kê các máy, còn `cmux cloud start-session --name <name> --agent %2$@` sẽ tạo một máy."}}
      }
    },
    "cloud.startSession.agentInvalid": {
      "comment": "cmux cloud start-session without a valid --agent. Keep the command as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Pass the agent to start with --agent, for example `cmux cloud start-session --name dev --agent claude`."}},
        "ja": {"stringUnit": {"state": "translated", "value": "開始するエージェントを --agent で指定してください (例: `cmux cloud start-session --name dev --agent claude`)。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Gib den zu startenden Agent mit --agent an, zum Beispiel `cmux cloud start-session --name dev --agent claude`."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Indiquez l'agent à démarrer avec --agent, par exemple `cmux cloud start-session --name dev --agent claude`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Indica el agente que se iniciará con --agent, por ejemplo `cmux cloud start-session --name dev --agent claude`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "مرّر الوكيل المراد بدؤه باستخدام ‎--agent، مثل `cmux cloud start-session --name dev --agent claude`."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "--agent로 시작할 에이전트를 지정하세요(예: `cmux cloud start-session --name dev --agent claude`)."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "请用 --agent 指定要启动的代理，例如 `cmux cloud start-session --name dev --agent claude`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "請用 --agent 指定要啟動的代理，例如 `cmux cloud start-session --name dev --agent claude`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Navedite agenta za pokretanje pomoću --agent, na primjer `cmux cloud start-session --name dev --agent claude`."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Angiv den agent, der skal startes, med --agent, for eksempel `cmux cloud start-session --name dev --agent claude`."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Indica l'agente da avviare con --agent, per esempio `cmux cloud start-session --name dev --agent claude`."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "បញ្ជាក់ភ្នាក់ងារដែលត្រូវចាប់ផ្ដើមដោយប្រើ --agent ឧទាហរណ៍ `cmux cloud start-session --name dev --agent claude`។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Angi agenten som skal startes med --agent, for eksempel `cmux cloud start-session --name dev --agent claude`."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Podaj agenta do uruchomienia za pomocą --agent, na przykład `cmux cloud start-session --name dev --agent claude`."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Informe o agente a iniciar com --agent, por exemplo `cmux cloud start-session --name dev --agent claude`."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Укажите агента для запуска через --agent, например `cmux cloud start-session --name dev --agent claude`."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ระบุเอเจนต์ที่จะเริ่มด้วย --agent เช่น `cmux cloud start-session --name dev --agent claude`"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Başlatılacak ajanı --agent ile belirtin, örneğin `cmux cloud start-session --name dev --agent claude`."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Вкажіть агента для запуску через --agent, наприклад `cmux cloud start-session --name dev --agent claude`."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Truyền tác tử cần khởi động bằng --agent, ví dụ `cmux cloud start-session --name dev --agent claude`."}}
      }
    },
    "cloud.startSession.cwdInvalid": {
      "comment": "cmux cloud start-session with a relative or bad --cwd. Keep the command as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Pass --cwd as an absolute folder on the machine, for example `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/FOLDER`."}},
        "ja": {"stringUnit": {"state": "translated", "value": "--cwd にはマシン上の絶対パスのフォルダを指定してください (例: `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/FOLDER`)。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Gib --cwd als absoluten Ordner auf der Maschine an, zum Beispiel `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/FOLDER`."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Indiquez --cwd sous forme de dossier absolu sur la machine, par exemple `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/FOLDER`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Indica --cwd como una carpeta absoluta en la máquina, por ejemplo `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/FOLDER`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "مرّر ‎--cwd كمجلد بمسار مطلق على الجهاز، مثل `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/FOLDER`."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "--cwd에는 머신의 절대 경로 폴더를 지정하세요(예: `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/FOLDER`)."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "请将 --cwd 设为机器上的绝对路径文件夹，例如 `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/FOLDER`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "請將 --cwd 設為機器上的絕對路徑資料夾，例如 `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/FOLDER`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Navedite --cwd kao apsolutnu putanju foldera na mašini, na primjer `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/FOLDER`."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Angiv --cwd som en absolut mappe på maskinen, for eksempel `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/FOLDER`."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Indica --cwd come cartella assoluta sulla macchina, per esempio `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/FOLDER`."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "បញ្ជាក់ --cwd ជាផ្លូវថតពេញលេញនៅលើម៉ាស៊ីន ឧទាហរណ៍ `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/FOLDER`។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Angi --cwd som en absolutt mappe på maskinen, for eksempel `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/FOLDER`."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Podaj --cwd jako bezwzględną ścieżkę folderu na maszynie, na przykład `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/FOLDER`."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Informe --cwd como uma pasta absoluta na máquina, por exemplo `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/FOLDER`."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Укажите в --cwd абсолютный путь к папке на машине, например `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/FOLDER`."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ระบุ --cwd เป็นพาธแบบเต็มของโฟลเดอร์บนเครื่อง เช่น `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/FOLDER`"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "--cwd değerini makinedeki mutlak bir klasör yolu olarak verin, örneğin `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/FOLDER`."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Вкажіть у --cwd абсолютний шлях до папки на машині, наприклад `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/FOLDER`."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Truyền --cwd là đường dẫn tuyệt đối tới thư mục trên máy, ví dụ `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/FOLDER`."}}
      }
    },
    "cloud.startSession.fromFolderNotOwned": {
      "comment": "cmux cloud start-session --from-folder on a machine this account does not own (a teammate's). %@ is the machine name.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "%@ isn't your own machine, so no folder from this Mac was copied to it. Copy a folder only to a Cloud machine you own."}},
        "ja": {"stringUnit": {"state": "translated", "value": "%@ はあなた自身のマシンではないため、この Mac のフォルダはコピーされませんでした。フォルダは自分が所有する Cloud マシンにだけコピーしてください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "%@ ist nicht deine eigene Maschine, daher wurde kein Ordner von diesem Mac dorthin kopiert. Kopiere Ordner nur auf eine Cloud-Maschine, die dir gehört."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "%@ n'est pas votre propre machine : aucun dossier de ce Mac n'y a été copié. Copiez un dossier uniquement vers une machine Cloud qui vous appartient."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "%@ no es tu propia máquina, así que no se copió ninguna carpeta de este Mac. Copia carpetas solo a una máquina Cloud que sea tuya."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "%@ ليس جهازك الخاص، لذلك لم يُنسخ إليه أي مجلد من هذا الـ Mac. انسخ المجلدات فقط إلى جهاز Cloud تملكه."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "%@은(는) 내 머신이 아니어서 이 Mac의 폴더를 복사하지 않았습니다. 폴더는 내가 소유한 Cloud 머신에만 복사하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "%@ 不是你自己的机器，因此没有把此 Mac 上的文件夹复制过去。请只把文件夹复制到你自己拥有的 Cloud 机器。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "%@ 不是你自己的機器，因此沒有把這台 Mac 上的資料夾複製過去。請只把資料夾複製到你自己擁有的 Cloud 機器。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "%@ nije tvoja mašina, pa nijedan folder s ovog Maca nije kopiran na nju. Kopiraj foldere samo na Cloud mašinu koja je tvoja."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "%@ er ikke din egen maskine, så ingen mappe fra denne Mac blev kopieret dertil. Kopiér kun mapper til en Cloud-maskine, du ejer."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "%@ non è una tua macchina, quindi nessuna cartella di questo Mac vi è stata copiata. Copia le cartelle solo su una macchina Cloud di tua proprietà."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "%@ មិនមែនជាម៉ាស៊ីនផ្ទាល់ខ្លួនរបស់អ្នកទេ ដូច្នេះគ្មានថតពី Mac នេះត្រូវបានចម្លងទៅវាទេ។ ចម្លងថតតែទៅម៉ាស៊ីន Cloud ដែលអ្នកជាម្ចាស់ប៉ុណ្ណោះ។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "%@ er ikke din egen maskin, så ingen mappe fra denne Macen ble kopiert dit. Kopier mapper bare til en Cloud-maskin du eier."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "%@ nie jest Twoją maszyną, więc żaden folder z tego Maca nie został na nią skopiowany. Kopiuj foldery tylko na maszynę Cloud, której jesteś właścicielem."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "%@ não é sua própria máquina, então nenhuma pasta deste Mac foi copiada para ela. Copie pastas só para uma máquina Cloud que seja sua."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "%@ — не ваша машина, поэтому папка с этого Mac на неё не копировалась. Копируйте папки только на свою машину Cloud."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "%@ ไม่ใช่เครื่องของคุณเอง จึงไม่ได้คัดลอกโฟลเดอร์จาก Mac นี้ไป คัดลอกโฟลเดอร์ไปยังเครื่อง Cloud ที่คุณเป็นเจ้าของเท่านั้น"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "%@ sizin makineniz değil, bu yüzden bu Mac'ten oraya klasör kopyalanmadı. Klasörleri yalnızca size ait bir Cloud makinesine kopyalayın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "%@ — не ваша машина, тому папку з цього Mac на неї не скопійовано. Копіюйте папки лише на власну машину Cloud."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "%@ không phải máy của bạn nên không có thư mục nào từ máy Mac này được sao chép sang. Chỉ sao chép thư mục lên máy Cloud do bạn sở hữu."}}
      }
    },
    "cloud.startSession.fromFolderWithCwd": {
      "comment": "cmux cloud start-session with both --from-folder and --cwd. Keep the flags as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Pass --from-folder or --cwd, not both: with --from-folder the session starts in the folder's copy on the machine."}},
        "ja": {"stringUnit": {"state": "translated", "value": "--from-folder と --cwd はどちらか一方だけを指定してください。--from-folder を指定すると、セッションはマシン上のフォルダのコピーで開始します。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Gib --from-folder oder --cwd an, nicht beides: Mit --from-folder startet die Sitzung in der Kopie des Ordners auf der Maschine."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Indiquez --from-folder ou --cwd, pas les deux : avec --from-folder, la session démarre dans la copie du dossier sur la machine."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Indica --from-folder o --cwd, no ambos: con --from-folder la sesión empieza en la copia de la carpeta en la máquina."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "مرّر ‎--from-folder أو ‎--cwd، لا كليهما: مع ‎--from-folder تبدأ الجلسة في نسخة المجلد على الجهاز."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "--from-folder와 --cwd 중 하나만 지정하세요. --from-folder를 쓰면 세션이 머신에 있는 폴더 사본에서 시작됩니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "请只指定 --from-folder 或 --cwd 其中之一：使用 --from-folder 时，会话在机器上该文件夹的副本中启动。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "請只指定 --from-folder 或 --cwd 其中之一：使用 --from-folder 時，工作階段會在機器上該資料夾的副本中啟動。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Navedite --from-folder ili --cwd, ne oba: uz --from-folder sesija počinje u kopiji foldera na mašini."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Angiv --from-folder eller --cwd, ikke begge: med --from-folder starter sessionen i mappens kopi på maskinen."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Indica --from-folder o --cwd, non entrambi: con --from-folder la sessione parte nella copia della cartella sulla macchina."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "បញ្ជាក់ --from-folder ឬ --cwd មិនមែនទាំងពីរទេ៖ ជាមួយ --from-folder វគ្គចាប់ផ្តើមក្នុងច្បាប់ចម្លងនៃថតនៅលើម៉ាស៊ីន។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Angi --from-folder eller --cwd, ikke begge: med --from-folder starter økten i mappens kopi på maskinen."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Podaj --from-folder albo --cwd, nie oba: z --from-folder sesja startuje w kopii folderu na maszynie."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Informe --from-folder ou --cwd, não ambos: com --from-folder a sessão começa na cópia da pasta na máquina."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Укажите --from-folder или --cwd, но не оба: с --from-folder сеанс запускается в копии папки на машине."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ระบุ --from-folder หรือ --cwd อย่างใดอย่างหนึ่ง ไม่ใช่ทั้งสอง: เมื่อใช้ --from-folder เซสชันจะเริ่มในสำเนาของโฟลเดอร์บนเครื่อง"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "--from-folder veya --cwd verin, ikisini birden değil: --from-folder ile oturum, klasörün makinedeki kopyasında başlar."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Вкажіть --from-folder або --cwd, але не обидва: з --from-folder сеанс починається в копії папки на машині."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Truyền --from-folder hoặc --cwd, không phải cả hai: với --from-folder, phiên bắt đầu trong bản sao của thư mục trên máy."}}
      }
    },
    "cloud.startSession.fromFolderInvalid": {
      "comment": "cmux cloud start-session with a relative or bad --from-folder. Keep the command as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Pass --from-folder as an absolute folder on this Mac, for example `cmux cloud start-chat --from-folder /Users/me/code/app --prompt 'Run the tests'`."}},
        "ja": {"stringUnit": {"state": "translated", "value": "--from-folder にはこの Mac 上の絶対パスのフォルダを指定してください (例: `cmux cloud start-chat --from-folder /Users/me/code/app --prompt 'Run the tests'`)。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Gib --from-folder als absoluten Ordner auf diesem Mac an, zum Beispiel `cmux cloud start-chat --from-folder /Users/me/code/app --prompt 'Run the tests'`."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Indiquez --from-folder sous forme de dossier absolu sur ce Mac, par exemple `cmux cloud start-chat --from-folder /Users/me/code/app --prompt 'Run the tests'`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Indica --from-folder como una carpeta absoluta en este Mac, por ejemplo `cmux cloud start-chat --from-folder /Users/me/code/app --prompt 'Run the tests'`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "مرّر ‎--from-folder كمجلد بمسار مطلق على جهاز Mac هذا، مثل `cmux cloud start-chat --from-folder /Users/me/code/app --prompt 'Run the tests'`."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "--from-folder에는 이 Mac의 절대 경로 폴더를 지정하세요(예: `cmux cloud start-chat --from-folder /Users/me/code/app --prompt 'Run the tests'`)."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "请将 --from-folder 设为这台 Mac 上的绝对路径文件夹，例如 `cmux cloud start-chat --from-folder /Users/me/code/app --prompt 'Run the tests'`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "請將 --from-folder 設為這台 Mac 上的絕對路徑資料夾，例如 `cmux cloud start-chat --from-folder /Users/me/code/app --prompt 'Run the tests'`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Navedite --from-folder kao apsolutnu putanju foldera na ovom Macu, na primjer `cmux cloud start-chat --from-folder /Users/me/code/app --prompt 'Run the tests'`."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Angiv --from-folder som en absolut mappe på denne Mac, for eksempel `cmux cloud start-chat --from-folder /Users/me/code/app --prompt 'Run the tests'`."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Indica --from-folder come cartella assoluta su questo Mac, per esempio `cmux cloud start-chat --from-folder /Users/me/code/app --prompt 'Run the tests'`."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "បញ្ជាក់ --from-folder ជាផ្លូវថតពេញលេញនៅលើ Mac នេះ ឧទាហរណ៍ `cmux cloud start-chat --from-folder /Users/me/code/app --prompt 'Run the tests'`។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Angi --from-folder som en absolutt mappe på denne Macen, for eksempel `cmux cloud start-chat --from-folder /Users/me/code/app --prompt 'Run the tests'`."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Podaj --from-folder jako bezwzględną ścieżkę folderu na tym Macu, na przykład `cmux cloud start-chat --from-folder /Users/me/code/app --prompt 'Run the tests'`."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Informe --from-folder como uma pasta absoluta neste Mac, por exemplo `cmux cloud start-chat --from-folder /Users/me/code/app --prompt 'Run the tests'`."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Укажите в --from-folder абсолютный путь к папке на этом Mac, например `cmux cloud start-chat --from-folder /Users/me/code/app --prompt 'Run the tests'`."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ระบุ --from-folder เป็นโฟลเดอร์แบบพาธเต็มบน Mac เครื่องนี้ เช่น `cmux cloud start-chat --from-folder /Users/me/code/app --prompt 'Run the tests'`"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "--from-folder değerini bu Mac'teki mutlak bir klasör yolu olarak verin, örneğin `cmux cloud start-chat --from-folder /Users/me/code/app --prompt 'Run the tests'`."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Вкажіть у --from-folder абсолютний шлях до папки на цьому Mac, наприклад `cmux cloud start-chat --from-folder /Users/me/code/app --prompt 'Run the tests'`."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Truyền --from-folder là đường dẫn tuyệt đối tới thư mục trên máy Mac này, ví dụ `cmux cloud start-chat --from-folder /Users/me/code/app --prompt 'Run the tests'`."}}
      }
    },
    "cloud.startSession.fromFolderMissing": {
      "comment": "cmux cloud start-session --from-folder names no folder on this Mac. %@ is the path as given.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "%@ isn't a folder on this Mac, so nothing was copied. Pass an existing folder with --from-folder."}},
        "ja": {"stringUnit": {"state": "translated", "value": "%@ はこの Mac 上のフォルダではないため、何もコピーされませんでした。--from-folder には既存のフォルダを指定してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "%@ ist kein Ordner auf diesem Mac, daher wurde nichts kopiert. Gib mit --from-folder einen vorhandenen Ordner an."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "%@ n'est pas un dossier sur ce Mac, rien n'a donc été copié. Indiquez un dossier existant avec --from-folder."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "%@ no es una carpeta de este Mac, así que no se copió nada. Indica una carpeta existente con --from-folder."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "‏%@ ليس مجلدًا على جهاز Mac هذا، لذا لم يُنسخ شيء. مرّر مجلدًا موجودًا عبر ‎--from-folder."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "%@은(는) 이 Mac의 폴더가 아니어서 아무것도 복사하지 않았습니다. --from-folder에 있는 폴더를 지정하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "%@ 不是这台 Mac 上的文件夹，因此没有复制任何内容。请用 --from-folder 指定一个已存在的文件夹。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "%@ 不是這台 Mac 上的資料夾，因此沒有複製任何內容。請用 --from-folder 指定一個已存在的資料夾。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "%@ nije folder na ovom Macu, pa ništa nije kopirano. Navedite postojeći folder uz --from-folder."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "%@ er ikke en mappe på denne Mac, så intet blev kopieret. Angiv en eksisterende mappe med --from-folder."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "%@ non è una cartella su questo Mac, quindi non è stato copiato nulla. Indica una cartella esistente con --from-folder."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "%@ មិនមែនជាថតនៅលើ Mac នេះទេ ដូច្នេះគ្មានអ្វីត្រូវបានចម្លងទេ។ បញ្ជាក់ថតដែលមានស្រាប់ជាមួយ --from-folder។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "%@ er ikke en mappe på denne Macen, så ingenting ble kopiert. Angi en eksisterende mappe med --from-folder."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "%@ nie jest folderem na tym Macu, więc nic nie skopiowano. Podaj istniejący folder w --from-folder."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "%@ não é uma pasta deste Mac, então nada foi copiado. Informe uma pasta existente com --from-folder."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "%@ — не папка на этом Mac, поэтому ничего не скопировано. Укажите существующую папку в --from-folder."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "%@ ไม่ใช่โฟลเดอร์บน Mac เครื่องนี้ จึงไม่มีการคัดลอกสิ่งใด ระบุโฟลเดอร์ที่มีอยู่ด้วย --from-folder"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "%@ bu Mac'te bir klasör değil, bu yüzden hiçbir şey kopyalanmadı. --from-folder ile var olan bir klasör verin."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "%@ — не папка на цьому Mac, тому нічого не скопійовано. Вкажіть наявну папку в --from-folder."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "%@ không phải là thư mục trên máy Mac này nên chưa sao chép gì. Truyền một thư mục có sẵn bằng --from-folder."}}
      }
    },
    "cloud.startSession.fromFolderTooBroad": {
      "comment": "cmux cloud start-session --from-folder names the home folder, a folder above it or the disk's root. %@ is the folder.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "%@ is your home folder, a folder above it or the disk's root, which is never copied to a Cloud machine. Pass a project folder with --from-folder."}},
        "ja": {"stringUnit": {"state": "translated", "value": "%@ はホームフォルダ、その上位のフォルダ、またはディスクのルートであり、Cloud マシンにはコピーされません。--from-folder にはプロジェクトフォルダを指定してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "%@ ist dein Home-Ordner, ein Ordner darüber oder das Stammverzeichnis des Laufwerks und wird nie auf eine Cloud-Maschine kopiert. Gib mit --from-folder einen Projektordner an."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "%@ est votre dossier personnel, un dossier au-dessus ou la racine du disque, qui n'est jamais copié sur une machine Cloud. Indiquez un dossier de projet avec --from-folder."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "%@ es tu carpeta de inicio, una carpeta superior o la raíz del disco, que nunca se copia a una máquina Cloud. Indica una carpeta de proyecto con --from-folder."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "‏%@ هو مجلد المنزل أو مجلد فوقه أو جذر القرص، ولا يُنسخ أبدًا إلى جهاز Cloud. مرّر مجلد مشروع عبر ‎--from-folder."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "%@은(는) 홈 폴더, 그 상위 폴더 또는 디스크 루트이므로 Cloud 머신에 복사하지 않습니다. --from-folder에 프로젝트 폴더를 지정하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "%@ 是你的主文件夹、其上级文件夹或磁盘根目录，永远不会复制到 Cloud 机器。请用 --from-folder 指定一个项目文件夹。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "%@ 是你的主資料夾、其上層資料夾或磁碟根目錄，永遠不會複製到 Cloud 機器。請用 --from-folder 指定一個專案資料夾。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "%@ je vaš početni folder, folder iznad njega ili korijen diska i nikad se ne kopira na Cloud mašinu. Navedite folder projekta uz --from-folder."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "%@ er din hjemmemappe, en mappe over den eller diskens rod, som aldrig kopieres til en Cloud-maskine. Angiv en projektmappe med --from-folder."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "%@ è la tua cartella Inizio, una cartella sopra di essa o la radice del disco, che non viene mai copiata su una macchina Cloud. Indica una cartella di progetto con --from-folder."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "%@ គឺជាថតផ្ទះរបស់អ្នក ថតខាងលើវា ឬឫសនៃថាស ដែលមិនដែលត្រូវបានចម្លងទៅម៉ាស៊ីន Cloud ទេ។ បញ្ជាក់ថតគម្រោងជាមួយ --from-folder។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "%@ er hjemmemappen din, en mappe over den eller diskens rot, som aldri kopieres til en Cloud-maskin. Angi en prosjektmappe med --from-folder."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "%@ to folder domowy, folder nad nim lub katalog główny dysku, który nigdy nie jest kopiowany na maszynę Cloud. Podaj folder projektu w --from-folder."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "%@ é sua pasta de início, uma pasta acima dela ou a raiz do disco, que nunca é copiada para uma máquina Cloud. Informe uma pasta de projeto com --from-folder."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "%@ — домашняя папка, папка выше неё или корень диска; такое никогда не копируется на машину Cloud. Укажите папку проекта в --from-folder."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "%@ คือโฟลเดอร์หลักของคุณ โฟลเดอร์ที่อยู่เหนือขึ้นไป หรือรากของดิสก์ ซึ่งจะไม่ถูกคัดลอกไปยังเครื่อง Cloud ระบุโฟลเดอร์โปรเจกต์ด้วย --from-folder"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "%@ ana klasörünüz, onun üstündeki bir klasör veya diskin köküdür ve hiçbir zaman bir Cloud makinesine kopyalanmaz. --from-folder ile bir proje klasörü verin."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "%@ — домашня папка, папка над нею або корінь диска; таке ніколи не копіюється на машину Cloud. Вкажіть папку проєкту в --from-folder."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "%@ là thư mục chính của bạn, một thư mục phía trên nó hoặc gốc ổ đĩa, không bao giờ được sao chép lên máy Cloud. Truyền một thư mục dự án bằng --from-folder."}}
      }
    },
    "cloud.startSession.fromFolderSecret": {
      "comment": "cmux cloud start-session --from-folder names a credential folder or one that holds it. %1$@ is the folder, %2$@ the credential folder as ~/.ssh and the like.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "%1$@ is or holds %2$@, a folder of keys and credentials that is never copied to a Cloud machine. Pass a project folder with --from-folder."}},
        "ja": {"stringUnit": {"state": "translated", "value": "%1$@ は鍵や認証情報のフォルダ %2$@ であるか、それを含んでいるため、Cloud マシンにはコピーされません。--from-folder にはプロジェクトフォルダを指定してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "%1$@ ist oder enthält %2$@, einen Ordner mit Schlüsseln und Zugangsdaten, der nie auf eine Cloud-Maschine kopiert wird. Gib mit --from-folder einen Projektordner an."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "%1$@ est ou contient %2$@, un dossier de clés et d'identifiants qui n'est jamais copié sur une machine Cloud. Indiquez un dossier de projet avec --from-folder."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "%1$@ es o contiene %2$@, una carpeta de claves y credenciales que nunca se copia a una máquina Cloud. Indica una carpeta de proyecto con --from-folder."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "‏%1$@ هو %2$@ أو يحتويه، وهو مجلد مفاتيح وبيانات اعتماد لا يُنسخ أبدًا إلى جهاز Cloud. مرّر مجلد مشروع عبر ‎--from-folder."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "%1$@은(는) 키와 자격 증명 폴더인 %2$@이거나 이를 포함하므로 Cloud 머신에 복사하지 않습니다. --from-folder에 프로젝트 폴더를 지정하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "%1$@ 是或包含 %2$@，这是存放密钥和凭据的文件夹，永远不会复制到 Cloud 机器。请用 --from-folder 指定一个项目文件夹。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "%1$@ 是或包含 %2$@，這是存放金鑰和憑證的資料夾，永遠不會複製到 Cloud 機器。請用 --from-folder 指定一個專案資料夾。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "%1$@ jest ili sadrži %2$@, folder s ključevima i akreditivima koji se nikad ne kopira na Cloud mašinu. Navedite folder projekta uz --from-folder."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "%1$@ er eller indeholder %2$@, en mappe med nøgler og loginoplysninger, som aldrig kopieres til en Cloud-maskine. Angiv en projektmappe med --from-folder."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "%1$@ è o contiene %2$@, una cartella di chiavi e credenziali che non viene mai copiata su una macchina Cloud. Indica una cartella di progetto con --from-folder."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "%1$@ គឺជា ឬផ្ទុក %2$@ ដែលជាថតនៃកូនសោ និងព័ត៌មានសម្ងាត់ ដែលមិនដែលត្រូវបានចម្លងទៅម៉ាស៊ីន Cloud ទេ។ បញ្ជាក់ថតគម្រោងជាមួយ --from-folder។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "%1$@ er eller inneholder %2$@, en mappe med nøkler og påloggingsdata som aldri kopieres til en Cloud-maskin. Angi en prosjektmappe med --from-folder."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "%1$@ jest lub zawiera %2$@, folder kluczy i danych logowania, który nigdy nie jest kopiowany na maszynę Cloud. Podaj folder projektu w --from-folder."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "%1$@ é ou contém %2$@, uma pasta de chaves e credenciais que nunca é copiada para uma máquina Cloud. Informe uma pasta de projeto com --from-folder."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "%1$@ — это %2$@ или папка, которая его содержит; папки с ключами и учётными данными никогда не копируются на машину Cloud. Укажите папку проекта в --from-folder."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "%1$@ คือหรือมี %2$@ ซึ่งเป็นโฟลเดอร์ของคีย์และข้อมูลรับรองที่จะไม่ถูกคัดลอกไปยังเครื่อง Cloud ระบุโฟลเดอร์โปรเจกต์ด้วย --from-folder"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "%1$@, anahtar ve kimlik bilgisi klasörü olan %2$@ klasörüdür ya da onu içerir; bu klasör hiçbir zaman bir Cloud makinesine kopyalanmaz. --from-folder ile bir proje klasörü verin."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "%1$@ — це %2$@ або папка, що його містить; папки з ключами й обліковими даними ніколи не копіюються на машину Cloud. Вкажіть папку проєкту в --from-folder."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "%1$@ là hoặc chứa %2$@, một thư mục khóa và thông tin xác thực không bao giờ được sao chép lên máy Cloud. Truyền một thư mục dự án bằng --from-folder."}}
      }
    },
    "cloud.startSession.createFailed": {
      "comment": "The named machine could not be created. %1$@ is its name, %2$@ the name as a shell word, %3$@ the agent, %4$@ the reason. Keep the commands as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Couldn't create Cloud machine `%1$@` (%4$@), so no agent started. Run `cmux cloud start-session --name %2$@ --agent %3$@` again, or pick a machine from `cmux cloud list-machines`."}},
        "ja": {"stringUnit": {"state": "translated", "value": "Cloud マシン `%1$@` を作成できなかったため (%4$@)、エージェントは開始されませんでした。`cmux cloud start-session --name %2$@ --agent %3$@` をもう一度実行するか、`cmux cloud list-machines` からマシンを選んでください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Cloud-Maschine `%1$@` konnte nicht erstellt werden (%4$@), daher wurde kein Agent gestartet. Führe `cmux cloud start-session --name %2$@ --agent %3$@` erneut aus oder wähle eine Maschine aus `cmux cloud list-machines`."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Impossible de créer la machine Cloud `%1$@` (%4$@) : aucun agent n'a démarré. Relancez `cmux cloud start-session --name %2$@ --agent %3$@`, ou choisissez une machine dans `cmux cloud list-machines`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "No se pudo crear la máquina de Cloud `%1$@` (%4$@), así que no se inició ningún agente. Vuelve a ejecutar `cmux cloud start-session --name %2$@ --agent %3$@` o elige una máquina de `cmux cloud list-machines`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تعذّر إنشاء جهاز Cloud ‏`%1$@` (%4$@)، لذا لم يبدأ أي وكيل. شغّل `cmux cloud start-session --name %2$@ --agent %3$@` مرة أخرى، أو اختر جهازًا من `cmux cloud list-machines`."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "Cloud 머신 `%1$@`을(를) 만들지 못해(%4$@) 에이전트가 시작되지 않았습니다. `cmux cloud start-session --name %2$@ --agent %3$@`을(를) 다시 실행하거나 `cmux cloud list-machines`에서 머신을 고르세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "无法创建 Cloud 机器 `%1$@`（%4$@），因此没有启动代理。请再次运行 `cmux cloud start-session --name %2$@ --agent %3$@`，或从 `cmux cloud list-machines` 中选一台机器。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "無法建立 Cloud 機器 `%1$@`（%4$@），因此沒有啟動代理。請再次執行 `cmux cloud start-session --name %2$@ --agent %3$@`，或從 `cmux cloud list-machines` 中選一台機器。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Nije moguće kreirati Cloud mašinu `%1$@` (%4$@), pa nijedan agent nije pokrenut. Ponovo pokrenite `cmux cloud start-session --name %2$@ --agent %3$@` ili odaberite mašinu iz `cmux cloud list-machines`."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Kunne ikke oprette Cloud-maskinen `%1$@` (%4$@), så ingen agent startede. Kør `cmux cloud start-session --name %2$@ --agent %3$@` igen, eller vælg en maskine fra `cmux cloud list-machines`."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Impossibile creare la macchina Cloud `%1$@` (%4$@), quindi nessun agente è stato avviato. Esegui di nuovo `cmux cloud start-session --name %2$@ --agent %3$@` oppure scegli una macchina da `cmux cloud list-machines`."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "មិនអាចបង្កើតម៉ាស៊ីន Cloud `%1$@` បានទេ (%4$@) ដូច្នេះគ្មានភ្នាក់ងារណាបានចាប់ផ្ដើមទេ។ ដំណើរការ `cmux cloud start-session --name %2$@ --agent %3$@` ម្ដងទៀត ឬជ្រើសម៉ាស៊ីនពី `cmux cloud list-machines`។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Kunne ikke opprette Cloud-maskinen `%1$@` (%4$@), så ingen agent startet. Kjør `cmux cloud start-session --name %2$@ --agent %3$@` på nytt, eller velg en maskin fra `cmux cloud list-machines`."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Nie można utworzyć maszyny Cloud `%1$@` (%4$@), więc żaden agent nie został uruchomiony. Uruchom ponownie `cmux cloud start-session --name %2$@ --agent %3$@` lub wybierz maszynę z `cmux cloud list-machines`."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Não foi possível criar a máquina do Cloud `%1$@` (%4$@), então nenhum agente foi iniciado. Execute `cmux cloud start-session --name %2$@ --agent %3$@` novamente ou escolha uma máquina em `cmux cloud list-machines`."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Не удалось создать машину Cloud `%1$@` (%4$@), поэтому агент не запущен. Снова выполните `cmux cloud start-session --name %2$@ --agent %3$@` или выберите машину из `cmux cloud list-machines`."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "สร้างเครื่อง Cloud `%1$@` ไม่ได้ (%4$@) จึงไม่มีเอเจนต์เริ่มทำงาน เรียกใช้ `cmux cloud start-session --name %2$@ --agent %3$@` อีกครั้ง หรือเลือกเครื่องจาก `cmux cloud list-machines`"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "`%1$@` Cloud makinesi oluşturulamadı (%4$@), bu yüzden hiçbir ajan başlatılmadı. `cmux cloud start-session --name %2$@ --agent %3$@` komutunu yeniden çalıştırın veya `cmux cloud list-machines` listesinden bir makine seçin."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Не вдалося створити машину Cloud `%1$@` (%4$@), тому агент не запущено. Знову виконайте `cmux cloud start-session --name %2$@ --agent %3$@` або виберіть машину з `cmux cloud list-machines`."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Không thể tạo máy Cloud `%1$@` (%4$@) nên không có tác tử nào được khởi động. Chạy lại `cmux cloud start-session --name %2$@ --agent %3$@`, hoặc chọn một máy từ `cmux cloud list-machines`."}}
      }
    },
    "cloud.startSession.notConnected": {
      "comment": "The machine never connected. %1$@ is its name, %2$@ its id, %3$@ the agent.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Machine `%1$@` didn't connect, so no agent started there. Check it with `cmux cloud machine-status --target machine:%2$@`, then run `cmux cloud start-session --target machine:%2$@ --agent %3$@` again."}},
        "ja": {"stringUnit": {"state": "translated", "value": "マシン `%1$@` に接続できなかったため、エージェントは開始されませんでした。`cmux cloud machine-status --target machine:%2$@` で確認してから、`cmux cloud start-session --target machine:%2$@ --agent %3$@` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Maschine `%1$@` hat sich nicht verbunden, daher wurde dort kein Agent gestartet. Prüfe sie mit `cmux cloud machine-status --target machine:%2$@` und führe dann `cmux cloud start-session --target machine:%2$@ --agent %3$@` erneut aus."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "La machine `%1$@` ne s'est pas connectée, aucun agent n'y a donc démarré. Vérifiez-la avec `cmux cloud machine-status --target machine:%2$@`, puis relancez `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "La máquina `%1$@` no se conectó, así que no se inició ningún agente. Revísala con `cmux cloud machine-status --target machine:%2$@` y vuelve a ejecutar `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "لم يتصل الجهاز `%1$@`، لذا لم يبدأ أي وكيل عليه. افحصه باستخدام `cmux cloud machine-status --target machine:%2$@`، ثم شغّل `cmux cloud start-session --target machine:%2$@ --agent %3$@` مرة أخرى."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "머신 `%1$@`이(가) 연결되지 않아 에이전트가 시작되지 않았습니다. `cmux cloud machine-status --target machine:%2$@`로 확인한 다음 `cmux cloud start-session --target machine:%2$@ --agent %3$@`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "机器 `%1$@` 未连接，因此没有启动代理。请用 `cmux cloud machine-status --target machine:%2$@` 检查，然后再次运行 `cmux cloud start-session --target machine:%2$@ --agent %3$@`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "機器 `%1$@` 未連線，因此沒有啟動代理。請用 `cmux cloud machine-status --target machine:%2$@` 檢查，然後再次執行 `cmux cloud start-session --target machine:%2$@ --agent %3$@`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Mašina `%1$@` se nije povezala, pa na njoj nije pokrenut nijedan agent. Provjerite je pomoću `cmux cloud machine-status --target machine:%2$@`, a zatim ponovo pokrenite `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Maskinen `%1$@` oprettede ikke forbindelse, så ingen agent startede der. Tjek den med `cmux cloud machine-status --target machine:%2$@`, og kør derefter `cmux cloud start-session --target machine:%2$@ --agent %3$@` igen."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "La macchina `%1$@` non si è connessa, quindi nessun agente è stato avviato lì. Controllala con `cmux cloud machine-status --target machine:%2$@`, poi esegui di nuovo `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ម៉ាស៊ីន `%1$@` មិនបានភ្ជាប់ទេ ដូច្នេះគ្មានភ្នាក់ងារណាបានចាប់ផ្ដើមនៅទីនោះទេ។ ពិនិត្យវាដោយប្រើ `cmux cloud machine-status --target machine:%2$@` រួចដំណើរការ `cmux cloud start-session --target machine:%2$@ --agent %3$@` ម្ដងទៀត។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Maskinen `%1$@` koblet seg ikke til, så ingen agent startet der. Sjekk den med `cmux cloud machine-status --target machine:%2$@`, og kjør deretter `cmux cloud start-session --target machine:%2$@ --agent %3$@` på nytt."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Maszyna `%1$@` nie połączyła się, więc żaden agent nie został na niej uruchomiony. Sprawdź ją poleceniem `cmux cloud machine-status --target machine:%2$@`, a następnie uruchom ponownie `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "A máquina `%1$@` não se conectou, então nenhum agente foi iniciado nela. Verifique-a com `cmux cloud machine-status --target machine:%2$@` e execute `cmux cloud start-session --target machine:%2$@ --agent %3$@` novamente."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Машина `%1$@` не подключилась, поэтому агент на ней не запущен. Проверьте её командой `cmux cloud machine-status --target machine:%2$@`, затем снова выполните `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เครื่อง `%1$@` ไม่ได้เชื่อมต่อ จึงไม่มีเอเจนต์เริ่มทำงานบนเครื่องนั้น ตรวจสอบด้วย `cmux cloud machine-status --target machine:%2$@` แล้วเรียกใช้ `cmux cloud start-session --target machine:%2$@ --agent %3$@` อีกครั้ง"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "`%1$@` makinesi bağlanmadı, bu yüzden orada hiçbir ajan başlatılmadı. Makineyi `cmux cloud machine-status --target machine:%2$@` ile kontrol edin, ardından `cmux cloud start-session --target machine:%2$@ --agent %3$@` komutunu yeniden çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Машина `%1$@` не під'єдналася, тому агент на ній не запущено. Перевірте її командою `cmux cloud machine-status --target machine:%2$@`, потім знову виконайте `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Máy `%1$@` không kết nối được nên không có tác tử nào được khởi động trên đó. Kiểm tra máy bằng `cmux cloud machine-status --target machine:%2$@`, rồi chạy lại `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}}
      }
    },
    "cloud.startSession.newMachineKept": {
      "comment": "A failed start could not delete the machine it made; it still runs. %1$@ machine name, %2$@ machine id.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Its new machine `%1$@` still runs. Delete it with `cmux cloud kill-machine --target machine:%2$@ --confirm true`."}},
        "ja": {"stringUnit": {"state": "translated", "value": "新しいマシン `%1$@` はまだ動いています。`cmux cloud kill-machine --target machine:%2$@ --confirm true` で削除してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Die neue Maschine `%1$@` läuft noch. Lösche sie mit `cmux cloud kill-machine --target machine:%2$@ --confirm true`."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Sa nouvelle machine `%1$@` tourne encore. Supprimez-la avec `cmux cloud kill-machine --target machine:%2$@ --confirm true`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Su nueva máquina `%1$@` sigue en marcha. Elimínala con `cmux cloud kill-machine --target machine:%2$@ --confirm true`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "لا يزال الجهاز الجديد `%1$@` يعمل. احذفه باستخدام `cmux cloud kill-machine --target machine:%2$@ --confirm true`."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "새 머신 `%1$@`이(가) 아직 실행 중입니다. `cmux cloud kill-machine --target machine:%2$@ --confirm true`(으)로 삭제하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "新机器 `%1$@` 仍在运行。请用 `cmux cloud kill-machine --target machine:%2$@ --confirm true` 删除它。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "新機器 `%1$@` 仍在執行。請用 `cmux cloud kill-machine --target machine:%2$@ --confirm true` 刪除它。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Nova mašina `%1$@` još radi. Obriši je pomoću `cmux cloud kill-machine --target machine:%2$@ --confirm true`."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Den nye maskine `%1$@` kører stadig. Slet den med `cmux cloud kill-machine --target machine:%2$@ --confirm true`."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "La nuova macchina `%1$@` è ancora in esecuzione. Eliminala con `cmux cloud kill-machine --target machine:%2$@ --confirm true`."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ម៉ាស៊ីនថ្មី `%1$@` នៅតែដំណើរការ។ លុបវាដោយ `cmux cloud kill-machine --target machine:%2$@ --confirm true`។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Den nye maskinen `%1$@` kjører fortsatt. Slett den med `cmux cloud kill-machine --target machine:%2$@ --confirm true`."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Nowa maszyna `%1$@` nadal działa. Usuń ją poleceniem `cmux cloud kill-machine --target machine:%2$@ --confirm true`."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "A nova máquina `%1$@` ainda está em execução. Exclua-a com `cmux cloud kill-machine --target machine:%2$@ --confirm true`."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Новая машина `%1$@` всё ещё работает. Удалите её командой `cmux cloud kill-machine --target machine:%2$@ --confirm true`."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เครื่องใหม่ `%1$@` ยังทำงานอยู่ ลบด้วย `cmux cloud kill-machine --target machine:%2$@ --confirm true`"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Yeni makine `%1$@` hâlâ çalışıyor. `cmux cloud kill-machine --target machine:%2$@ --confirm true` ile silin."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Нова машина `%1$@` досі працює. Видаліть її командою `cmux cloud kill-machine --target machine:%2$@ --confirm true`."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Máy mới `%1$@` vẫn đang chạy. Xóa nó bằng `cmux cloud kill-machine --target machine:%2$@ --confirm true`."}}
      }
    },
    "cloud.startSession.tabClosed": {
      "comment": "The person closed the new chat's tab before its agent started. %1$@ machine name, %2$@ machine id, %3$@ agent.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The new chat's tab on machine `%1$@` was closed before its agent started, so %3$@ didn't start there. Run `cmux cloud start-session --target machine:%2$@ --agent %3$@` again."}},
        "ja": {"stringUnit": {"state": "translated", "value": "マシン `%1$@` の新しいチャットのタブがエージェントの開始前に閉じられたため、%3$@ はそこで開始されませんでした。`cmux cloud start-session --target machine:%2$@ --agent %3$@` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Der Tab des neuen Chats auf Maschine `%1$@` wurde geschlossen, bevor sein Agent startete, daher wurde %3$@ dort nicht gestartet. Führe `cmux cloud start-session --target machine:%2$@ --agent %3$@` erneut aus."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "L'onglet de la nouvelle discussion sur la machine `%1$@` a été fermé avant le démarrage de son agent : %3$@ n'y a pas démarré. Relancez `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "La pestaña del nuevo chat en la máquina `%1$@` se cerró antes de que se iniciara su agente, así que %3$@ no se inició allí. Vuelve a ejecutar `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "أُغلق تبويب الدردشة الجديدة على الجهاز `%1$@` قبل أن يبدأ وكيلها، لذا لم يبدأ %3$@ هناك. شغّل `cmux cloud start-session --target machine:%2$@ --agent %3$@` مرة أخرى."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "머신 `%1$@`의 새 채팅 탭이 에이전트가 시작되기 전에 닫혀 %3$@이(가) 시작되지 않았습니다. `cmux cloud start-session --target machine:%2$@ --agent %3$@`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "机器 `%1$@` 上新聊天的标签页在其代理启动前被关闭，因此 %3$@ 没有在那里启动。请再次运行 `cmux cloud start-session --target machine:%2$@ --agent %3$@`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "機器 `%1$@` 上新聊天的分頁在其代理啟動前被關閉，因此 %3$@ 沒有在那裡啟動。請再次執行 `cmux cloud start-session --target machine:%2$@ --agent %3$@`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Kartica novog chata na mašini `%1$@` zatvorena je prije nego što se njen agent pokrenuo, pa %3$@ tamo nije pokrenut. Ponovo pokrenite `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Fanen med den nye chat på maskinen `%1$@` blev lukket, før dens agent startede, så %3$@ startede ikke der. Kør `cmux cloud start-session --target machine:%2$@ --agent %3$@` igen."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "La scheda della nuova chat sulla macchina `%1$@` è stata chiusa prima che il suo agente si avviasse, quindi %3$@ non è stato avviato lì. Esegui di nuovo `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ផ្ទាំងជជែកថ្មីនៅលើម៉ាស៊ីន `%1$@` ត្រូវបានបិទមុនពេលភ្នាក់ងាររបស់វាចាប់ផ្ដើម ដូច្នេះ %3$@ មិនបានចាប់ផ្ដើមនៅទីនោះទេ។ ដំណើរការ `cmux cloud start-session --target machine:%2$@ --agent %3$@` ម្ដងទៀត។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Fanen for den nye chatten på maskinen `%1$@` ble lukket før agenten startet, så %3$@ startet ikke der. Kjør `cmux cloud start-session --target machine:%2$@ --agent %3$@` på nytt."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Karta nowego czatu na maszynie `%1$@` została zamknięta, zanim uruchomił się jej agent, więc %3$@ nie został tam uruchomiony. Uruchom ponownie `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "A aba do novo chat na máquina `%1$@` foi fechada antes de o agente iniciar, então %3$@ não foi iniciado lá. Execute `cmux cloud start-session --target machine:%2$@ --agent %3$@` novamente."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Вкладку нового чата на машине `%1$@` закрыли до запуска её агента, поэтому %3$@ там не запущен. Снова выполните `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "แท็บแชตใหม่บนเครื่อง `%1$@` ถูกปิดก่อนที่เอเจนต์จะเริ่มทำงาน %3$@ จึงไม่ได้เริ่มบนเครื่องนั้น เรียกใช้ `cmux cloud start-session --target machine:%2$@ --agent %3$@` อีกครั้ง"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "`%1$@` makinesindeki yeni sohbetin sekmesi ajanı başlamadan kapatıldı, bu yüzden %3$@ orada başlatılmadı. `cmux cloud start-session --target machine:%2$@ --agent %3$@` komutunu yeniden çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Вкладку нового чату на машині `%1$@` закрили до запуску її агента, тому %3$@ там не запущено. Знову виконайте `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Thẻ của cuộc trò chuyện mới trên máy `%1$@` đã bị đóng trước khi tác tử khởi động, nên %3$@ chưa khởi động trên đó. Chạy lại `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}}
      }
    },
    "cloud.startSession.agentFailed": {
      "comment": "The machine is up but the agent session didn't start. %1$@ name, %2$@ id, %3$@ agent, %4$@ the reason in plain words.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Machine `%1$@` started but its agent didn't (%4$@). Run `cmux cloud start-session --target machine:%2$@ --agent %3$@` again."}},
        "ja": {"stringUnit": {"state": "translated", "value": "マシン `%1$@` は起動しましたが、エージェントは開始されませんでした (%4$@)。`cmux cloud start-session --target machine:%2$@ --agent %3$@` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Maschine `%1$@` ist gestartet, ihr Agent aber nicht (%4$@). Führe `cmux cloud start-session --target machine:%2$@ --agent %3$@` erneut aus."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "La machine `%1$@` a démarré, mais pas son agent (%4$@). Relancez `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "La máquina `%1$@` se inició, pero su agente no (%4$@). Vuelve a ejecutar `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "بدأ الجهاز `%1$@` لكن وكيله لم يبدأ (%4$@). شغّل `cmux cloud start-session --target machine:%2$@ --agent %3$@` مرة أخرى."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "머신 `%1$@`은(는) 시작됐지만 에이전트는 시작되지 않았습니다(%4$@). `cmux cloud start-session --target machine:%2$@ --agent %3$@`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "机器 `%1$@` 已启动，但其代理未启动（%4$@）。请再次运行 `cmux cloud start-session --target machine:%2$@ --agent %3$@`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "機器 `%1$@` 已啟動，但其代理未啟動（%4$@）。請再次執行 `cmux cloud start-session --target machine:%2$@ --agent %3$@`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Mašina `%1$@` se pokrenula, ali njen agent nije (%4$@). Ponovo pokrenite `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Maskinen `%1$@` startede, men dens agent gjorde ikke (%4$@). Kør `cmux cloud start-session --target machine:%2$@ --agent %3$@` igen."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "La macchina `%1$@` si è avviata, ma il suo agente no (%4$@). Esegui di nuovo `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ម៉ាស៊ីន `%1$@` បានចាប់ផ្ដើម ប៉ុន្តែភ្នាក់ងាររបស់វាមិនបានចាប់ផ្ដើមទេ (%4$@)។ ដំណើរការ `cmux cloud start-session --target machine:%2$@ --agent %3$@` ម្ដងទៀត។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Maskinen `%1$@` startet, men agenten på den gjorde ikke det (%4$@). Kjør `cmux cloud start-session --target machine:%2$@ --agent %3$@` på nytt."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Maszyna `%1$@` uruchomiła się, ale jej agent nie (%4$@). Uruchom ponownie `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "A máquina `%1$@` iniciou, mas o agente dela não (%4$@). Execute `cmux cloud start-session --target machine:%2$@ --agent %3$@` novamente."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Машина `%1$@` запустилась, а её агент нет (%4$@). Снова выполните `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เครื่อง `%1$@` เริ่มทำงานแล้ว แต่เอเจนต์ของเครื่องไม่เริ่ม (%4$@) เรียกใช้ `cmux cloud start-session --target machine:%2$@ --agent %3$@` อีกครั้ง"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "`%1$@` makinesi başladı ama ajanı başlamadı (%4$@). `cmux cloud start-session --target machine:%2$@ --agent %3$@` komutunu yeniden çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Машина `%1$@` запустилася, а її агент ні (%4$@). Знову виконайте `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Máy `%1$@` đã khởi động nhưng tác tử của máy thì không (%4$@). Chạy lại `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}}
      }
    },
    "cloud.startSession.agentSignedOut": {
      "comment": "The machine is up but the agent isn't signed in there. %1$@ name, %2$@ id, %3$@ agent id, %4$@ the agent's name (Cursor). Keep the command as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Machine `%1$@` started, but %4$@ isn't signed in on that machine. Sign it in there, then run `cmux cloud start-session --target machine:%2$@ --agent %3$@` again."}},
        "ja": {"stringUnit": {"state": "translated", "value": "マシン `%1$@` は起動しましたが、そのマシンでは %4$@ にサインインしていません。そこでサインインしてから、`cmux cloud start-session --target machine:%2$@ --agent %3$@` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Maschine `%1$@` ist gestartet, aber %4$@ ist dort nicht angemeldet. Melde ihn dort an und führe dann `cmux cloud start-session --target machine:%2$@ --agent %3$@` erneut aus."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "La machine `%1$@` a démarré, mais %4$@ n'y est pas connecté. Connectez-le là-bas, puis relancez `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "La máquina `%1$@` se inició, pero %4$@ no tiene la sesión iniciada allí. Inicia su sesión allí y vuelve a ejecutar `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "بدأ الجهاز `%1$@`، لكن %4$@ غير مسجّل الدخول عليه. سجّل دخوله هناك، ثم شغّل `cmux cloud start-session --target machine:%2$@ --agent %3$@` مرة أخرى."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "머신 `%1$@`은(는) 시작됐지만 그 머신에서 %4$@에 로그인되어 있지 않습니다. 그곳에서 로그인한 다음 `cmux cloud start-session --target machine:%2$@ --agent %3$@`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "机器 `%1$@` 已启动，但 %4$@ 尚未在该机器上登录。请在那里登录，然后再次运行 `cmux cloud start-session --target machine:%2$@ --agent %3$@`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "機器 `%1$@` 已啟動，但 %4$@ 尚未在該機器上登入。請在那裡登入，然後再次執行 `cmux cloud start-session --target machine:%2$@ --agent %3$@`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Mašina `%1$@` se pokrenula, ali %4$@ nije prijavljen na njoj. Prijavite ga tamo, pa ponovo pokrenite `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Maskinen `%1$@` startede, men %4$@ er ikke logget ind på den. Log den ind der, og kør `cmux cloud start-session --target machine:%2$@ --agent %3$@` igen."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "La macchina `%1$@` si è avviata, ma %4$@ non ha eseguito l'accesso lì. Esegui l'accesso lì, poi esegui di nuovo `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ម៉ាស៊ីន `%1$@` បានចាប់ផ្ដើម ប៉ុន្តែ %4$@ មិនទាន់បានចូលគណនីនៅលើវាទេ។ ចូលគណនីនៅទីនោះ រួចដំណើរការ `cmux cloud start-session --target machine:%2$@ --agent %3$@` ម្ដងទៀត។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Maskinen `%1$@` startet, men %4$@ er ikke logget på den. Logg den på der, og kjør `cmux cloud start-session --target machine:%2$@ --agent %3$@` på nytt."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Maszyna `%1$@` uruchomiła się, ale %4$@ nie jest na niej zalogowany. Zaloguj go tam, a potem uruchom ponownie `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "A máquina `%1$@` iniciou, mas o %4$@ não está conectado nela. Conecte-o lá e execute `cmux cloud start-session --target machine:%2$@ --agent %3$@` novamente."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Машина `%1$@` запустилась, но %4$@ на ней не выполнил вход. Выполните вход там, затем снова выполните `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เครื่อง `%1$@` เริ่มทำงานแล้ว แต่ %4$@ ยังไม่ได้ลงชื่อเข้าใช้ในเครื่องนั้น ลงชื่อเข้าใช้ที่นั่น แล้วเรียกใช้ `cmux cloud start-session --target machine:%2$@ --agent %3$@` อีกครั้ง"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "`%1$@` makinesi başladı ama %4$@ orada oturum açmamış. Orada oturum açın, ardından `cmux cloud start-session --target machine:%2$@ --agent %3$@` komutunu yeniden çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Машина `%1$@` запустилася, але %4$@ на ній не ввійшов. Увійдіть там, потім знову виконайте `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Máy `%1$@` đã khởi động nhưng %4$@ chưa đăng nhập trên máy đó. Đăng nhập ở đó, rồi chạy lại `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}}
      }
    },
    "cloud.startSession.agentSignInExpired": {
      "comment": "The machine is up but the agent's sign-in there expired. %1$@ name, %2$@ id, %3$@ agent id, %4$@ the agent's name (Grok). Keep the command as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Machine `%1$@` started, but %4$@'s sign-in expired on that machine. Sign it in again there, then run `cmux cloud start-session --target machine:%2$@ --agent %3$@` again."}},
        "ja": {"stringUnit": {"state": "translated", "value": "マシン `%1$@` は起動しましたが、そのマシンでの %4$@ のサインインが期限切れです。そこでもう一度サインインしてから、`cmux cloud start-session --target machine:%2$@ --agent %3$@` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Maschine `%1$@` ist gestartet, aber die Anmeldung von %4$@ ist dort abgelaufen. Melde ihn dort erneut an und führe dann `cmux cloud start-session --target machine:%2$@ --agent %3$@` erneut aus."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "La machine `%1$@` a démarré, mais la connexion de %4$@ y a expiré. Reconnectez-le là-bas, puis relancez `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "La máquina `%1$@` se inició, pero la sesión de %4$@ caducó allí. Vuelve a iniciarla allí y vuelve a ejecutar `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "بدأ الجهاز `%1$@`، لكن انتهت صلاحية تسجيل دخول %4$@ عليه. سجّل دخوله مرة أخرى هناك، ثم شغّل `cmux cloud start-session --target machine:%2$@ --agent %3$@` مرة أخرى."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "머신 `%1$@`은(는) 시작됐지만 그 머신에서 %4$@ 로그인이 만료되었습니다. 그곳에서 다시 로그인한 다음 `cmux cloud start-session --target machine:%2$@ --agent %3$@`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "机器 `%1$@` 已启动，但 %4$@ 在该机器上的登录已过期。请在那里重新登录，然后再次运行 `cmux cloud start-session --target machine:%2$@ --agent %3$@`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "機器 `%1$@` 已啟動，但 %4$@ 在該機器上的登入已過期。請在那裡重新登入，然後再次執行 `cmux cloud start-session --target machine:%2$@ --agent %3$@`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Mašina `%1$@` se pokrenula, ali je prijava za %4$@ na njoj istekla. Ponovo ga prijavite tamo, pa ponovo pokrenite `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Maskinen `%1$@` startede, men login for %4$@ er udløbet på den. Log den ind igen der, og kør `cmux cloud start-session --target machine:%2$@ --agent %3$@` igen."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "La macchina `%1$@` si è avviata, ma l'accesso di %4$@ lì è scaduto. Esegui di nuovo l'accesso lì, poi esegui di nuovo `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ម៉ាស៊ីន `%1$@` បានចាប់ផ្ដើម ប៉ុន្តែការចូលគណនី %4$@ នៅលើវាបានផុតកំណត់។ ចូលគណនីម្ដងទៀតនៅទីនោះ រួចដំណើរការ `cmux cloud start-session --target machine:%2$@ --agent %3$@` ម្ដងទៀត។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Maskinen `%1$@` startet, men påloggingen for %4$@ er utløpt på den. Logg den på igjen der, og kjør `cmux cloud start-session --target machine:%2$@ --agent %3$@` på nytt."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Maszyna `%1$@` uruchomiła się, ale logowanie %4$@ na niej wygasło. Zaloguj go tam ponownie, a potem uruchom ponownie `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "A máquina `%1$@` iniciou, mas o login do %4$@ expirou nela. Conecte-o novamente lá e execute `cmux cloud start-session --target machine:%2$@ --agent %3$@` novamente."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Машина `%1$@` запустилась, но срок входа %4$@ на ней истёк. Снова выполните вход там, затем снова выполните `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เครื่อง `%1$@` เริ่มทำงานแล้ว แต่การลงชื่อเข้าใช้ %4$@ ในเครื่องนั้นหมดอายุแล้ว ลงชื่อเข้าใช้อีกครั้งที่นั่น แล้วเรียกใช้ `cmux cloud start-session --target machine:%2$@ --agent %3$@` อีกครั้ง"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "`%1$@` makinesi başladı ama %4$@ oturumunun oradaki süresi doldu. Orada yeniden oturum açın, ardından `cmux cloud start-session --target machine:%2$@ --agent %3$@` komutunu yeniden çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Машина `%1$@` запустилася, але термін входу %4$@ на ній сплив. Увійдіть там знову, потім знову виконайте `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Máy `%1$@` đã khởi động nhưng phiên đăng nhập %4$@ trên máy đó đã hết hạn. Đăng nhập lại ở đó, rồi chạy lại `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}}
      }
    },
    "cloud.startSession.agentMissing": {
      "comment": "The machine is up but the agent isn't installed there. %1$@ name, %2$@ id, %3$@ agent id, %4$@ the agent's name (Cursor). Keep the command and AGENT as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Machine `%1$@` started, but %4$@ (`%3$@`) isn't installed on that machine. Install it there, or run `cmux cloud start-session --target machine:%2$@ --agent AGENT` with another agent."}},
        "ja": {"stringUnit": {"state": "translated", "value": "マシン `%1$@` は起動しましたが、そのマシンには %4$@ (`%3$@`) がインストールされていません。そこでインストールするか、別のエージェントで `cmux cloud start-session --target machine:%2$@ --agent AGENT` を実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Maschine `%1$@` ist gestartet, aber %4$@ (`%3$@`) ist dort nicht installiert. Installiere ihn dort oder führe `cmux cloud start-session --target machine:%2$@ --agent AGENT` mit einem anderen Agenten aus."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "La machine `%1$@` a démarré, mais %4$@ (`%3$@`) n'y est pas installé. Installez-le là-bas, ou lancez `cmux cloud start-session --target machine:%2$@ --agent AGENT` avec un autre agent."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "La máquina `%1$@` se inició, pero %4$@ (`%3$@`) no está instalado allí. Instálalo allí o ejecuta `cmux cloud start-session --target machine:%2$@ --agent AGENT` con otro agente."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "بدأ الجهاز `%1$@`، لكن %4$@ (`%3$@`) غير مثبّت عليه. ثبّته هناك، أو شغّل `cmux cloud start-session --target machine:%2$@ --agent AGENT` بوكيل آخر."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "머신 `%1$@`은(는) 시작됐지만 그 머신에 %4$@ (`%3$@`)이(가) 설치되어 있지 않습니다. 그곳에 설치하거나 다른 에이전트로 `cmux cloud start-session --target machine:%2$@ --agent AGENT`을(를) 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "机器 `%1$@` 已启动，但该机器上没有安装 %4$@ (`%3$@`)。请在那里安装，或使用其他代理运行 `cmux cloud start-session --target machine:%2$@ --agent AGENT`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "機器 `%1$@` 已啟動，但該機器上沒有安裝 %4$@ (`%3$@`)。請在那裡安裝，或使用其他代理執行 `cmux cloud start-session --target machine:%2$@ --agent AGENT`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Mašina `%1$@` se pokrenula, ali %4$@ (`%3$@`) nije instaliran na njoj. Instalirajte ga tamo ili pokrenite `cmux cloud start-session --target machine:%2$@ --agent AGENT` s drugim agentom."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Maskinen `%1$@` startede, men %4$@ (`%3$@`) er ikke installeret på den. Installér den der, eller kør `cmux cloud start-session --target machine:%2$@ --agent AGENT` med en anden agent."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "La macchina `%1$@` si è avviata, ma %4$@ (`%3$@`) non è installato lì. Installalo lì o esegui `cmux cloud start-session --target machine:%2$@ --agent AGENT` con un altro agente."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ម៉ាស៊ីន `%1$@` បានចាប់ផ្ដើម ប៉ុន្តែ %4$@ (`%3$@`) មិនទាន់បានដំឡើងនៅលើវាទេ។ ដំឡើងវានៅទីនោះ ឬដំណើរការ `cmux cloud start-session --target machine:%2$@ --agent AGENT` ជាមួយភ្នាក់ងារផ្សេង។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Maskinen `%1$@` startet, men %4$@ (`%3$@`) er ikke installert på den. Installer den der, eller kjør `cmux cloud start-session --target machine:%2$@ --agent AGENT` med en annen agent."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Maszyna `%1$@` uruchomiła się, ale %4$@ (`%3$@`) nie jest na niej zainstalowany. Zainstaluj go tam lub uruchom `cmux cloud start-session --target machine:%2$@ --agent AGENT` z innym agentem."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "A máquina `%1$@` iniciou, mas o %4$@ (`%3$@`) não está instalado nela. Instale-o lá ou execute `cmux cloud start-session --target machine:%2$@ --agent AGENT` com outro agente."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Машина `%1$@` запустилась, но %4$@ (`%3$@`) на ней не установлен. Установите его там или выполните `cmux cloud start-session --target machine:%2$@ --agent AGENT` с другим агентом."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เครื่อง `%1$@` เริ่มทำงานแล้ว แต่ยังไม่ได้ติดตั้ง %4$@ (`%3$@`) ในเครื่องนั้น ติดตั้งที่นั่น หรือเรียกใช้ `cmux cloud start-session --target machine:%2$@ --agent AGENT` กับเอเจนต์อื่น"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "`%1$@` makinesi başladı ama %4$@ (`%3$@`) orada yüklü değil. Orada yükleyin veya `cmux cloud start-session --target machine:%2$@ --agent AGENT` komutunu başka bir ajanla çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Машина `%1$@` запустилася, але %4$@ (`%3$@`) на ній не встановлено. Встановіть його там або виконайте `cmux cloud start-session --target machine:%2$@ --agent AGENT` з іншим агентом."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Máy `%1$@` đã khởi động nhưng %4$@ (`%3$@`) chưa được cài trên máy đó. Cài nó ở đó, hoặc chạy `cmux cloud start-session --target machine:%2$@ --agent AGENT` với tác tử khác."}}
      }
    },
    "cloud.startSession.claudeSettingsSecret": {
      "comment": "Claude team route refusal when the machine's settings file contains a credential that would be exposed by the launch.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Claude could not start on the team route because its settings file contains a credential that would be copied into the launch. Remove the credential from the settings file and try again."}},
        "ja": {"stringUnit": {"state": "translated", "value": "Claude の設定ファイルに起動時にコピーされる認証情報が含まれているため、チームのルートで起動できませんでした。設定ファイルから認証情報を削除して、もう一度お試しください。"}},
        "de": {"stringUnit": {"state": "translated", "value": "Claude konnte die Teamroute nicht nutzen, weil seine Einstellungsdatei Zugangsdaten enthält, die beim Start kopiert würden. Entferne die Zugangsdaten aus der Einstellungsdatei und versuche es erneut."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Claude n’a pas pu démarrer via la route de l’équipe, car son fichier de paramètres contient un identifiant d’accès qui serait copié au démarrage. Retirez-le du fichier, puis réessayez."}},
        "es": {"stringUnit": {"state": "translated", "value": "Claude no pudo iniciarse con la ruta del equipo porque su archivo de configuración contiene una credencial que se copiaría al iniciar. Quita la credencial del archivo de configuración y vuelve a intentarlo."}},
        "ar": {"stringUnit": {"state": "translated", "value": "تعذّر تشغيل Claude عبر مسار الفريق لأن ملف إعداداته يحتوي على بيانات اعتماد سيجري نسخها عند التشغيل. أزل بيانات الاعتماد من ملف الإعدادات وحاول مجددًا."}},
        "ko": {"stringUnit": {"state": "translated", "value": "Claude 설정 파일에 시작 시 복사될 자격 증명이 있어 팀 경로로 시작할 수 없었습니다. 설정 파일에서 자격 증명을 제거한 후 다시 시도하세요."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "Claude 的设置文件包含启动时会被复制的凭据，因此无法通过团队路由启动。请从设置文件中移除该凭据，然后重试。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "Claude 的設定檔含有會在啟動時被複製的憑證，因此無法透過團隊路由啟動。請從設定檔移除該憑證，然後再試一次。"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Claude se nije mogao pokrenuti putem rute tima jer datoteka postavki sadrži podatke za pristup koji bi se kopirali pri pokretanju. Uklonite te podatke iz datoteke postavki i pokušajte ponovo."}},
        "da": {"stringUnit": {"state": "translated", "value": "Claude kunne ikke starte via teamets rute, fordi indstillingsfilen indeholder adgangsoplysninger, der ville blive kopieret ved start. Fjern adgangsoplysningerne fra indstillingsfilen, og prøv igen."}},
        "it": {"stringUnit": {"state": "translated", "value": "Claude non ha potuto avviarsi sul percorso del team perché il suo file di impostazioni contiene una credenziale che verrebbe copiata all’avvio. Rimuovi la credenziale dal file di impostazioni e riprova."}},
        "km": {"stringUnit": {"state": "translated", "value": "Claude មិនអាចចាប់ផ្ដើមតាមផ្លូវរបស់ក្រុមបានទេ ព្រោះឯកសារការកំណត់របស់វាមានព័ត៌មានសម្គាល់អត្តសញ្ញាណដែលនឹងត្រូវបានចម្លងពេលចាប់ផ្ដើម។ ដកព័ត៌មានសម្គាល់អត្តសញ្ញាណនោះចេញពីឯកសារការកំណត់ ហើយព្យាយាមម្ដងទៀត។"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Claude kunne ikke starte via teamets rute fordi innstillingsfilen inneholder påloggingsopplysninger som ville blitt kopiert ved oppstart. Fjern påloggingsopplysningene fra innstillingsfilen og prøv igjen."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Nie udało się uruchomić Claude przez trasę zespołu, ponieważ plik ustawień zawiera dane uwierzytelniające, które zostałyby skopiowane przy uruchamianiu. Usuń te dane z pliku ustawień i spróbuj ponownie."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Claude não pôde iniciar pela rota da equipe porque o arquivo de configurações contém uma credencial que seria copiada na inicialização. Remova a credencial do arquivo de configurações e tente novamente."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Не удалось запустить Claude через маршрут команды: в файле настроек есть учётные данные, которые были бы скопированы при запуске. Удалите их из файла настроек и повторите попытку."}},
        "th": {"stringUnit": {"state": "translated", "value": "Claude เริ่มทำงานผ่านเส้นทางของทีมไม่ได้ เนื่องจากไฟล์การตั้งค่ามีข้อมูลรับรองที่จะถูกคัดลอกเมื่อเริ่มทำงาน ให้นำข้อมูลรับรองออกจากไฟล์การตั้งค่าแล้วลองอีกครั้ง"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Claude, ayar dosyasında başlatma sırasında kopyalanacak bir kimlik bilgisi bulunduğu için ekip rotasıyla başlatılamadı. Kimlik bilgisini ayar dosyasından kaldırıp tekrar deneyin."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Не вдалося запустити Claude через маршрут команди, оскільки файл налаштувань містить облікові дані, які було б скопійовано під час запуску. Видаліть їх із файлу налаштувань і спробуйте ще раз."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Không thể khởi động Claude qua tuyến của nhóm vì tệp cài đặt chứa thông tin xác thực sẽ bị sao chép khi khởi động. Hãy xóa thông tin xác thực khỏi tệp cài đặt rồi thử lại."}}
      }
    },
    "cloud.startSession.routeUnavailable": {
      "comment": "The machine is up but the model route the agent uses can't serve it there. %1$@ name, %2$@ id, %3$@ agent id, %4$@ the agent's name (Cursor). Keep the command as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Machine `%1$@` started, but %4$@'s model route isn't available on that machine. Run `cmux cloud start-session --target machine:%2$@ --agent %3$@` again later, or pick another agent."}},
        "ja": {"stringUnit": {"state": "translated", "value": "マシン `%1$@` は起動しましたが、そのマシンでは %4$@ のモデルルートを利用できません。後で `cmux cloud start-session --target machine:%2$@ --agent %3$@` をもう一度実行するか、別のエージェントを選んでください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Maschine `%1$@` ist gestartet, aber die Modellroute von %4$@ ist dort nicht verfügbar. Führe `cmux cloud start-session --target machine:%2$@ --agent %3$@` später erneut aus oder wähle einen anderen Agenten."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "La machine `%1$@` a démarré, mais la route de modèle de %4$@ n'y est pas disponible. Relancez `cmux cloud start-session --target machine:%2$@ --agent %3$@` plus tard, ou choisissez un autre agent."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "La máquina `%1$@` se inició, pero la ruta de modelo de %4$@ no está disponible allí. Vuelve a ejecutar `cmux cloud start-session --target machine:%2$@ --agent %3$@` más tarde o elige otro agente."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "بدأ الجهاز `%1$@`، لكن مسار النموذج الخاص بـ %4$@ غير متاح عليه. شغّل `cmux cloud start-session --target machine:%2$@ --agent %3$@` مرة أخرى لاحقًا، أو اختر وكيلًا آخر."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "머신 `%1$@`은(는) 시작됐지만 그 머신에서는 %4$@의 모델 경로를 사용할 수 없습니다. 나중에 `cmux cloud start-session --target machine:%2$@ --agent %3$@`을(를) 다시 실행하거나 다른 에이전트를 선택하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "机器 `%1$@` 已启动，但 %4$@ 的模型路由在该机器上不可用。请稍后再次运行 `cmux cloud start-session --target machine:%2$@ --agent %3$@`，或选择其他代理。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "機器 `%1$@` 已啟動，但 %4$@ 的模型路由在該機器上無法使用。請稍後再次執行 `cmux cloud start-session --target machine:%2$@ --agent %3$@`，或選擇其他代理。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Mašina `%1$@` se pokrenula, ali ruta modela za %4$@ nije dostupna na njoj. Kasnije ponovo pokrenite `cmux cloud start-session --target machine:%2$@ --agent %3$@` ili odaberite drugog agenta."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Maskinen `%1$@` startede, men modelruten for %4$@ er ikke tilgængelig på den. Kør `cmux cloud start-session --target machine:%2$@ --agent %3$@` igen senere, eller vælg en anden agent."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "La macchina `%1$@` si è avviata, ma il percorso del modello di %4$@ non è disponibile lì. Esegui di nuovo `cmux cloud start-session --target machine:%2$@ --agent %3$@` più tardi o scegli un altro agente."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ម៉ាស៊ីន `%1$@` បានចាប់ផ្ដើម ប៉ុន្តែផ្លូវម៉ូដែលរបស់ %4$@ មិនអាចប្រើបាននៅលើវាទេ។ ដំណើរការ `cmux cloud start-session --target machine:%2$@ --agent %3$@` ម្ដងទៀតនៅពេលក្រោយ ឬជ្រើសភ្នាក់ងារផ្សេង។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Maskinen `%1$@` startet, men modellruten for %4$@ er ikke tilgjengelig på den. Kjør `cmux cloud start-session --target machine:%2$@ --agent %3$@` på nytt senere, eller velg en annen agent."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Maszyna `%1$@` uruchomiła się, ale trasa modelu %4$@ nie jest na niej dostępna. Uruchom ponownie `cmux cloud start-session --target machine:%2$@ --agent %3$@` później lub wybierz innego agenta."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "A máquina `%1$@` iniciou, mas a rota de modelo do %4$@ não está disponível nela. Execute `cmux cloud start-session --target machine:%2$@ --agent %3$@` novamente mais tarde ou escolha outro agente."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Машина `%1$@` запустилась, но маршрут модели %4$@ на ней недоступен. Выполните `cmux cloud start-session --target machine:%2$@ --agent %3$@` позже или выберите другого агента."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เครื่อง `%1$@` เริ่มทำงานแล้ว แต่เส้นทางโมเดลของ %4$@ ใช้ไม่ได้ในเครื่องนั้น เรียกใช้ `cmux cloud start-session --target machine:%2$@ --agent %3$@` อีกครั้งภายหลัง หรือเลือกเอเจนต์อื่น"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "`%1$@` makinesi başladı ama %4$@ model rotası orada kullanılamıyor. `cmux cloud start-session --target machine:%2$@ --agent %3$@` komutunu daha sonra yeniden çalıştırın veya başka bir ajan seçin."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Машина `%1$@` запустилася, але маршрут моделі %4$@ на ній недоступний. Виконайте `cmux cloud start-session --target machine:%2$@ --agent %3$@` пізніше або виберіть іншого агента."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Máy `%1$@` đã khởi động nhưng tuyến mô hình của %4$@ không khả dụng trên máy đó. Chạy lại `cmux cloud start-session --target machine:%2$@ --agent %3$@` sau, hoặc chọn tác tử khác."}}
      }
    },
    "cloud.startSession.routerUnavailable": {
      "comment": "The machine is up but the cmux router can't serve the chat there (a Cloud machine has no local router). %1$@ name, %2$@ id, %3$@ agent id. Keep 'cmux' and the command as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Machine `%1$@` started, but the cmux router isn't available on that machine. Run `cmux cloud start-session --target machine:%2$@ --agent %3$@` again later, or pick another agent."}},
        "ja": {"stringUnit": {"state": "translated", "value": "マシン `%1$@` は起動しましたが、そのマシンでは cmux ルーターを利用できません。後で `cmux cloud start-session --target machine:%2$@ --agent %3$@` をもう一度実行するか、別のエージェントを選んでください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Maschine `%1$@` ist gestartet, aber der cmux-Router ist dort nicht verfügbar. Führe `cmux cloud start-session --target machine:%2$@ --agent %3$@` später erneut aus oder wähle einen anderen Agenten."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "La machine `%1$@` a démarré, mais le routeur cmux n'y est pas disponible. Relancez `cmux cloud start-session --target machine:%2$@ --agent %3$@` plus tard, ou choisissez un autre agent."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "La máquina `%1$@` se inició, pero el enrutador de cmux no está disponible allí. Vuelve a ejecutar `cmux cloud start-session --target machine:%2$@ --agent %3$@` más tarde o elige otro agente."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "بدأ الجهاز `%1$@`، لكن موجّه cmux غير متاح عليه. شغّل `cmux cloud start-session --target machine:%2$@ --agent %3$@` مرة أخرى لاحقًا، أو اختر وكيلًا آخر."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "머신 `%1$@`은(는) 시작됐지만 그 머신에서는 cmux 라우터를 사용할 수 없습니다. 나중에 `cmux cloud start-session --target machine:%2$@ --agent %3$@`을(를) 다시 실행하거나 다른 에이전트를 선택하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "机器 `%1$@` 已启动，但 cmux 路由器在该机器上不可用。请稍后再次运行 `cmux cloud start-session --target machine:%2$@ --agent %3$@`，或选择其他代理。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "機器 `%1$@` 已啟動，但 cmux 路由器在該機器上無法使用。請稍後再次執行 `cmux cloud start-session --target machine:%2$@ --agent %3$@`，或選擇其他代理。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Mašina `%1$@` se pokrenula, ali cmux ruter nije dostupan na njoj. Kasnije ponovo pokrenite `cmux cloud start-session --target machine:%2$@ --agent %3$@` ili odaberite drugog agenta."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Maskinen `%1$@` startede, men cmux-routeren er ikke tilgængelig på den. Kør `cmux cloud start-session --target machine:%2$@ --agent %3$@` igen senere, eller vælg en anden agent."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "La macchina `%1$@` si è avviata, ma il router di cmux non è disponibile lì. Esegui di nuovo `cmux cloud start-session --target machine:%2$@ --agent %3$@` più tardi o scegli un altro agente."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ម៉ាស៊ីន `%1$@` បានចាប់ផ្ដើម ប៉ុន្តែរ៉ោតទ័រ cmux មិនអាចប្រើបាននៅលើវាទេ។ ដំណើរការ `cmux cloud start-session --target machine:%2$@ --agent %3$@` ម្ដងទៀតនៅពេលក្រោយ ឬជ្រើសភ្នាក់ងារផ្សេង។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Maskinen `%1$@` startet, men cmux-ruteren er ikke tilgjengelig på den. Kjør `cmux cloud start-session --target machine:%2$@ --agent %3$@` på nytt senere, eller velg en annen agent."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Maszyna `%1$@` uruchomiła się, ale router cmux nie jest na niej dostępny. Uruchom ponownie `cmux cloud start-session --target machine:%2$@ --agent %3$@` później lub wybierz innego agenta."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "A máquina `%1$@` iniciou, mas o roteador do cmux não está disponível nela. Execute `cmux cloud start-session --target machine:%2$@ --agent %3$@` novamente mais tarde ou escolha outro agente."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Машина `%1$@` запустилась, но маршрутизатор cmux на ней недоступен. Выполните `cmux cloud start-session --target machine:%2$@ --agent %3$@` позже или выберите другого агента."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เครื่อง `%1$@` เริ่มทำงานแล้ว แต่เราเตอร์ของ cmux ใช้ไม่ได้ในเครื่องนั้น เรียกใช้ `cmux cloud start-session --target machine:%2$@ --agent %3$@` อีกครั้งภายหลัง หรือเลือกเอเจนต์อื่น"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "`%1$@` makinesi başladı ama cmux yönlendiricisi orada kullanılamıyor. `cmux cloud start-session --target machine:%2$@ --agent %3$@` komutunu daha sonra yeniden çalıştırın veya başka bir ajan seçin."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Машина `%1$@` запустилася, але маршрутизатор cmux на ній недоступний. Виконайте `cmux cloud start-session --target machine:%2$@ --agent %3$@` пізніше або виберіть іншого агента."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Máy `%1$@` đã khởi động nhưng bộ định tuyến cmux không khả dụng trên máy đó. Chạy lại `cmux cloud start-session --target machine:%2$@ --agent %3$@` sau, hoặc chọn tác tử khác."}}
      }
    },
    "cloud.startSession.needsFolder": {
      "comment": "The agent session needs a folder on the machine. %1$@ name, %2$@ id, %3$@ agent. Keep the command as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Machine `%1$@` started but its agent didn't: it needs a folder on that machine to start in. Run `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd FOLDER` again with a folder that exists there."}},
        "ja": {"stringUnit": {"state": "translated", "value": "マシン `%1$@` は起動しましたが、エージェントは開始されませんでした: そのマシン上の開始フォルダが必要です。そのマシンのフォルダを指定して `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd FOLDER` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Maschine `%1$@` ist gestartet, ihr Agent aber nicht: Er braucht einen Ordner auf dieser Maschine zum Starten. Führe `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd FOLDER` erneut mit einem Ordner dort aus."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "La machine `%1$@` a démarré, mais pas son agent : il lui faut un dossier sur cette machine où démarrer. Relancez `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd FOLDER` avec un dossier de cette machine."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "La máquina `%1$@` se inició, pero su agente no: necesita una carpeta en esa máquina donde iniciarse. Vuelve a ejecutar `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd FOLDER` con una carpeta de allí."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "بدأ الجهاز `%1$@` لكن وكيله لم يبدأ: يحتاج إلى مجلد على ذلك الجهاز ليبدأ فيه. شغّل `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd FOLDER` مرة أخرى مع مجلد هناك."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "머신 `%1$@`은(는) 시작됐지만 에이전트는 시작되지 않았습니다. 그 머신에서 시작할 폴더가 필요합니다. 그 머신의 폴더로 `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd FOLDER`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "机器 `%1$@` 已启动，但其代理未启动：它需要在该机器上的一个文件夹中启动。请用该机器上的文件夹再次运行 `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd FOLDER`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "機器 `%1$@` 已啟動，但其代理未啟動：它需要在該機器上的一個資料夾中啟動。請用該機器上的資料夾再次執行 `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd FOLDER`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Mašina `%1$@` se pokrenula, ali njen agent nije: treba mu folder na toj mašini u kojem će se pokrenuti. Ponovo pokrenite `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd FOLDER` s folderom koji postoji tamo."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Maskinen `%1$@` startede, men dens agent gjorde ikke: den skal have en mappe på maskinen at starte i. Kør `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd FOLDER` igen med en mappe, der findes der."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "La macchina `%1$@` si è avviata, ma il suo agente no: gli serve una cartella su quella macchina in cui avviarsi. Esegui di nuovo `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd FOLDER` con una cartella presente lì."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ម៉ាស៊ីន `%1$@` បានចាប់ផ្ដើម ប៉ុន្តែភ្នាក់ងាររបស់វាមិនបានចាប់ផ្ដើមទេ៖ វាត្រូវការថតមួយនៅលើម៉ាស៊ីននោះដើម្បីចាប់ផ្ដើម។ ដំណើរការ `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd FOLDER` ម្ដងទៀតជាមួយថតដែលមាននៅទីនោះ។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Maskinen `%1$@` startet, men agenten på den gjorde ikke det: den trenger en mappe på maskinen å starte i. Kjør `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd FOLDER` på nytt med en mappe som finnes der."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Maszyna `%1$@` uruchomiła się, ale jej agent nie: potrzebuje folderu na tej maszynie, w którym się uruchomi. Uruchom ponownie `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd FOLDER` z folderem, który tam istnieje."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "A máquina `%1$@` iniciou, mas o agente dela não: ele precisa de uma pasta nessa máquina para iniciar. Execute `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd FOLDER` novamente com uma pasta que exista lá."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Машина `%1$@` запустилась, а её агент нет: ему нужна папка на этой машине, в которой он запустится. Снова выполните `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd FOLDER`, указав папку на ней."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เครื่อง `%1$@` เริ่มทำงานแล้ว แต่เอเจนต์ของเครื่องไม่เริ่ม: เอเจนต์ต้องมีโฟลเดอร์บนเครื่องนั้นเพื่อเริ่มทำงาน เรียกใช้ `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd FOLDER` อีกครั้งโดยระบุโฟลเดอร์ที่อยู่บนเครื่องนั้น"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "`%1$@` makinesi başladı ama ajanı başlamadı: başlamak için o makinede bir klasöre ihtiyacı var. `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd FOLDER` komutunu oradaki bir klasörle yeniden çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Машина `%1$@` запустилася, а її агент ні: йому потрібна папка на цій машині, у якій він запуститься. Знову виконайте `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd FOLDER`, указавши папку на ній."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Máy `%1$@` đã khởi động nhưng tác tử của máy thì không: tác tử cần một thư mục trên máy đó để khởi động. Chạy lại `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd FOLDER` với một thư mục có trên máy đó."}}
      }
    },
    "cloud.startSession.ask": {
      "comment": "Card in an agent's chat. %1$@ is the agent (claude), %2$@ the Cloud machine's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The agent asks to start a %1$@ session on Cloud machine %2$@."}},
        "ja": {"stringUnit": {"state": "translated", "value": "エージェントが Cloud マシン %2$@ で %1$@ セッションの開始を求めています。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Der Agent möchte eine %1$@-Sitzung auf der Cloud-Maschine %2$@ starten."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "L'agent demande à démarrer une session %1$@ sur la machine Cloud %2$@."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "El agente pide iniciar una sesión de %1$@ en la máquina de Cloud %2$@."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "يطلب الوكيل بدء جلسة %1$@ على جهاز Cloud ‏%2$@."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "에이전트가 Cloud 머신 %2$@에서 %1$@ 세션을 시작하려고 합니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "代理请求在 Cloud 机器 %2$@ 上启动 %1$@ 会话。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "代理請求在 Cloud 機器 %2$@ 上啟動 %1$@ 工作階段。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Agent traži da se pokrene %1$@ sesija na Cloud mašini %2$@."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Agenten beder om at starte en %1$@-session på Cloud-maskinen %2$@."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "L’agente chiede di avviare una sessione %1$@ sulla macchina Cloud %2$@."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ភ្នាក់ងារសុំចាប់ផ្ដើមវគ្គ %1$@ នៅលើម៉ាស៊ីន Cloud %2$@។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Agenten ber om å starte en %1$@-økt på Cloud-maskinen %2$@."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Agent prosi o uruchomienie sesji %1$@ na maszynie Cloud %2$@."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "O agente pede para iniciar uma sessão de %1$@ na máquina do Cloud %2$@."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Агент просит запустить сеанс %1$@ на машине Cloud %2$@."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เอเจนต์ขอเริ่มเซสชัน %1$@ บนเครื่อง Cloud %2$@"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Ajan, %2$@ Cloud makinesinde bir %1$@ oturumu başlatmak istiyor."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Агент просить запустити сеанс %1$@ на машині Cloud %2$@."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Tác tử muốn bắt đầu một phiên %1$@ trên máy Cloud %2$@."}}
      }
    },
    "cloud.startSession.askNew": {
      "comment": "Card in an agent's chat when the machine doesn't exist yet. %1$@ is the agent, %2$@ the new machine's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The agent asks to create Cloud machine %2$@ and start a %1$@ session there."}},
        "ja": {"stringUnit": {"state": "translated", "value": "エージェントが Cloud マシン %2$@ を作成し、そこで %1$@ セッションを開始することを求めています。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Der Agent möchte die Cloud-Maschine %2$@ erstellen und dort eine %1$@-Sitzung starten."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "L'agent demande à créer la machine Cloud %2$@ et à y démarrer une session %1$@."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "El agente pide crear la máquina de Cloud %2$@ e iniciar allí una sesión de %1$@."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "يطلب الوكيل إنشاء جهاز Cloud ‏%2$@ وبدء جلسة %1$@ عليه."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "에이전트가 Cloud 머신 %2$@을(를) 만들고 그곳에서 %1$@ 세션을 시작하려고 합니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "代理请求创建 Cloud 机器 %2$@ 并在其上启动 %1$@ 会话。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "代理請求建立 Cloud 機器 %2$@ 並在其上啟動 %1$@ 工作階段。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Agent traži da se kreira Cloud mašina %2$@ i na njoj pokrene %1$@ sesija."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Agenten beder om at oprette Cloud-maskinen %2$@ og starte en %1$@-session der."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "L’agente chiede di creare la macchina Cloud %2$@ e di avviarvi una sessione %1$@."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ភ្នាក់ងារសុំបង្កើតម៉ាស៊ីន Cloud %2$@ ហើយចាប់ផ្ដើមវគ្គ %1$@ នៅទីនោះ។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Agenten ber om å opprette Cloud-maskinen %2$@ og starte en %1$@-økt der."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Agent prosi o utworzenie maszyny Cloud %2$@ i uruchomienie na niej sesji %1$@."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "O agente pede para criar a máquina do Cloud %2$@ e iniciar uma sessão de %1$@ nela."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Агент просит создать машину Cloud %2$@ и запустить на ней сеанс %1$@."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เอเจนต์ขอสร้างเครื่อง Cloud %2$@ และเริ่มเซสชัน %1$@ บนเครื่องนั้น"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Ajan, %2$@ Cloud makinesini oluşturmak ve orada bir %1$@ oturumu başlatmak istiyor."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Агент просить створити машину Cloud %2$@ і запустити на ній сеанс %1$@."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Tác tử muốn tạo máy Cloud %2$@ và bắt đầu một phiên %1$@ trên đó."}}
      }
    },
