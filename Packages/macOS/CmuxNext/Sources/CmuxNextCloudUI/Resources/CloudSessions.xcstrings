    "cloud.startSession.started": {
      "comment": "Card once the session runs. %1$@ is the agent, %2$@ the machine.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "%1$@ runs on Cloud machine %2$@. Its chat is in that machine's workspace in the sidebar."}},
        "ja": {"stringUnit": {"state": "translated", "value": "%1$@ は Cloud マシン %2$@ で実行中です。チャットはサイドバーのそのマシンのワークスペースにあります。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "%1$@ läuft auf der Cloud-Maschine %2$@. Der Chat ist im Arbeitsbereich dieser Maschine in der Seitenleiste."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "%1$@ tourne sur la machine Cloud %2$@. Sa discussion se trouve dans l'espace de travail de cette machine, dans la barre latérale."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "%1$@ se ejecuta en la máquina Cloud %2$@. Su chat está en el espacio de trabajo de esa máquina, en la barra lateral."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "يعمل %1$@ على جهاز Cloud ‏%2$@. دردشته في مساحة عمل ذلك الجهاز في الشريط الجانبي."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "%1$@이(가) Cloud 머신 %2$@에서 실행 중입니다. 채팅은 사이드바의 해당 머신 워크스페이스에 있습니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "%1$@ 正在 Cloud 机器 %2$@ 上运行。它的聊天在侧边栏中该机器的工作区里。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "%1$@ 正在 Cloud 機器 %2$@ 上執行。它的聊天在側邊欄中該機器的工作區裡。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "%1$@ radi na Cloud mašini %2$@. Njegov chat je u radnom prostoru te mašine na bočnoj traci."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "%1$@ kører på Cloud-maskinen %2$@. Chatten ligger i maskinens arbejdsområde i sidepanelet."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "%1$@ è in esecuzione sulla macchina Cloud %2$@. La sua chat è nello spazio di lavoro di quella macchina, nella barra laterale."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "%1$@ កំពុងដំណើរការលើម៉ាស៊ីន Cloud %2$@។ ការជជែករបស់វានៅក្នុងកន្លែងធ្វើការរបស់ម៉ាស៊ីននោះ ក្នុងរបារចំហៀង។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "%1$@ kjører på Cloud-maskinen %2$@. Chatten ligger i maskinens arbeidsområde i sidepanelet."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "%1$@ działa na maszynie Cloud %2$@. Jego czat jest w obszarze roboczym tej maszyny na pasku bocznym."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "%1$@ está rodando na máquina Cloud %2$@. O chat está no espaço de trabalho dessa máquina, na barra lateral."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "%1$@ работает на Cloud-машине %2$@. Его чат — в рабочем пространстве этой машины на боковой панели."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "%1$@ กำลังทำงานบนเครื่อง Cloud %2$@ แชตของมันอยู่ในพื้นที่ทำงานของเครื่องนั้นในแถบด้านข้าง"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "%1$@, Cloud makinesi %2$@ üzerinde çalışıyor. Sohbeti kenar çubuğunda o makinenin çalışma alanında."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "%1$@ працює на Cloud-машині %2$@. Його чат — у робочому просторі цієї машини на бічній панелі."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "%1$@ đang chạy trên máy Cloud %2$@. Trò chuyện của nó nằm trong không gian làm việc của máy đó ở thanh bên."}}
      }
    },
    "cloud.startSession.chatGone": {
      "comment": "Open Chat found no new chat. %1$@ is the agent, %2$@ the machine.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Couldn't open the %1$@ chat on %2$@: its tab was closed or the machine isn't connected."}},
        "ja": {"stringUnit": {"state": "translated", "value": "%2$@ の %1$@ チャットを開けませんでした。タブが閉じられたか、マシンが接続されていません。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Der %1$@-Chat auf %2$@ konnte nicht geöffnet werden: Sein Tab wurde geschlossen oder die Maschine ist nicht verbunden."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Impossible d'ouvrir la discussion %1$@ sur %2$@ : son onglet a été fermé ou la machine n'est pas connectée."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "No se pudo abrir el chat de %1$@ en %2$@: se cerró su pestaña o la máquina no está conectada."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تعذّر فتح دردشة %1$@ على %2$@: أُغلق تبويبها أو أن الجهاز غير متصل."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "%2$@의 %1$@ 채팅을 열 수 없습니다. 탭이 닫혔거나 머신이 연결되어 있지 않습니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "无法打开 %2$@ 上的 %1$@ 聊天：其标签页已关闭，或机器未连接。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "無法打開 %2$@ 上的 %1$@ 聊天：其分頁已關閉，或機器未連線。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Nije moguće otvoriti %1$@ chat na %2$@: njegova kartica je zatvorena ili mašina nije povezana."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Kunne ikke åbne %1$@-chatten på %2$@: fanen blev lukket, eller maskinen er ikke forbundet."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Impossibile aprire la chat di %1$@ su %2$@: la scheda è stata chiusa o la macchina non è connessa."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "មិនអាចបើកការជជែក %1$@ នៅលើ %2$@ បានទេ៖ ផ្ទាំងរបស់វាត្រូវបានបិទ ឬម៉ាស៊ីនមិនបានភ្ជាប់។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Kunne ikke åpne %1$@-chatten på %2$@: fanen ble lukket, eller maskinen er ikke tilkoblet."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Nie udało się otworzyć czatu %1$@ na %2$@: jego karta została zamknięta lub maszyna nie jest połączona."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Não foi possível abrir o chat de %1$@ em %2$@: a aba foi fechada ou a máquina não está conectada."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Не удалось открыть чат %1$@ на %2$@: его вкладка закрыта или машина не подключена."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เปิดแชต %1$@ บน %2$@ ไม่ได้: แท็บถูกปิดหรือเครื่องไม่ได้เชื่อมต่อ"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "%2$@ üzerindeki %1$@ sohbeti açılamadı: sekmesi kapatıldı veya makine bağlı değil."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Не вдалося відкрити чат %1$@ на %2$@: його вкладку закрито або машина не підключена."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Không thể mở trò chuyện %1$@ trên %2$@: thẻ của nó đã bị đóng hoặc máy không được kết nối."}}
      }
    },
    "cloud.startSession.stillStarting": {
      "comment": "The run answered pending while the session still starts. %1$@ machine, %2$@ agent, %3$@ the command (keep it in backticks). Keep machine_id and session_id in English.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "%2$@ is still starting on %1$@. Run `%3$@` again to get its machine_id and session_id."}},
        "ja": {"stringUnit": {"state": "translated", "value": "%1$@ で %2$@ はまだ開始中です。`%3$@` をもう一度実行すると、machine_id と session_id を取得できます。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "%2$@ startet noch auf %1$@. Führe `%3$@` erneut aus, um machine_id und session_id zu erhalten."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "%2$@ démarre encore sur %1$@. Relancez `%3$@` pour obtenir son machine_id et son session_id."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "%2$@ todavía se está iniciando en %1$@. Vuelve a ejecutar `%3$@` para obtener su machine_id y session_id."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "لا يزال %2$@ قيد البدء على %1$@. شغّل `%3$@` مرة أخرى للحصول على machine_id وsession_id."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "%1$@에서 %2$@이(가) 아직 시작 중입니다. `%3$@`을(를) 다시 실행하면 machine_id와 session_id를 받을 수 있습니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "%2$@ 仍在 %1$@ 上启动。请再次运行 `%3$@` 以获取其 machine_id 和 session_id。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "%2$@ 仍在 %1$@ 上啟動。請再次執行 `%3$@` 以取得其 machine_id 和 session_id。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "%2$@ se još pokreće na %1$@. Ponovo pokrenite `%3$@` da dobijete njegove machine_id i session_id."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "%2$@ starter stadig på %1$@. Kør `%3$@` igen for at få dens machine_id og session_id."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "%2$@ si sta ancora avviando su %1$@. Esegui di nuovo `%3$@` per ottenere machine_id e session_id."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "%2$@ នៅតែកំពុងចាប់ផ្ដើមនៅលើ %1$@។ ដំណើរការ `%3$@` ម្ដងទៀត ដើម្បីទទួលបាន machine_id និង session_id របស់វា។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "%2$@ starter fortsatt på %1$@. Kjør `%3$@` på nytt for å få machine_id og session_id."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "%2$@ wciąż się uruchamia na %1$@. Uruchom ponownie `%3$@`, aby uzyskać machine_id i session_id."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "%2$@ ainda está iniciando em %1$@. Execute `%3$@` novamente para obter o machine_id e o session_id."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "%2$@ ещё запускается на %1$@. Снова выполните `%3$@`, чтобы получить machine_id и session_id."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "%2$@ ยังกำลังเริ่มทำงานบน %1$@ เรียกใช้ `%3$@` อีกครั้งเพื่อรับ machine_id และ session_id"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "%2$@ hâlâ %1$@ üzerinde başlatılıyor. machine_id ve session_id değerlerini almak için `%3$@` komutunu yeniden çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "%2$@ ще запускається на %1$@. Знову виконайте `%3$@`, щоб отримати machine_id і session_id."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "%2$@ vẫn đang khởi động trên %1$@. Chạy lại `%3$@` để lấy machine_id và session_id."}}
      }
    },
    "cloud.startSession.notInChat": {
      "comment": "An agent's run whose chat cmux can't find. %1$@ machine, %2$@ agent, %3$@ the command to run (keep it in backticks).",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Couldn't find the chat this agent runs in, so nobody can be asked to start %2$@ on Cloud machine %1$@. Run `%3$@` from an agent's shell in a cmux chat, or ask the person to run it."}},
        "ja": {"stringUnit": {"state": "translated", "value": "このエージェントが動いているチャットが見つからないため、Cloud マシン %1$@ で %2$@ を開始してよいか誰にも確認できません。cmux チャット内のエージェントのシェルから `%3$@` を実行するか、本人に実行を依頼してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Der Chat dieses Agents wurde nicht gefunden, daher kann niemand gefragt werden, ob %2$@ auf der Cloud-Maschine %1$@ starten soll. Führe `%3$@` aus der Shell eines Agents in einem cmux-Chat aus oder bitte die Person, es auszuführen."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Impossible de trouver la discussion de cet agent : personne ne peut être sollicité pour démarrer %2$@ sur la machine Cloud %1$@. Lancez `%3$@` depuis le shell d'un agent dans une discussion cmux, ou demandez à la personne de le lancer."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "No se encontró el chat de este agente, así que no se puede preguntar a nadie si iniciar %2$@ en la máquina de Cloud %1$@. Ejecuta `%3$@` desde la shell de un agente en un chat de cmux, o pide a la persona que lo ejecute."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تعذّر العثور على الدردشة التي يعمل فيها هذا الوكيل، لذا لا يمكن سؤال أحد عن بدء %2$@ على جهاز Cloud ‏%1$@. شغّل `%3$@` من صدفة وكيل في دردشة cmux، أو اطلب من الشخص تشغيله."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "이 에이전트가 실행 중인 채팅을 찾지 못해 Cloud 머신 %1$@에서 %2$@을(를) 시작할지 물어볼 수 없습니다. cmux 채팅 속 에이전트의 셸에서 `%3$@`을(를) 실행하거나 사용자에게 실행을 요청하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "找不到此代理所在的聊天，因此无法询问是否在 Cloud 机器 %1$@ 上启动 %2$@。请从 cmux 聊天中代理的 shell 运行 `%3$@`，或请对方运行。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "找不到此代理所在的聊天，因此無法詢問是否在 Cloud 機器 %1$@ 上啟動 %2$@。請從 cmux 聊天中代理的 shell 執行 `%3$@`，或請對方執行。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Nije moguće pronaći razgovor u kojem ovaj agent radi, pa se nikoga ne može pitati da pokrene %2$@ na Cloud mašini %1$@. Pokrenite `%3$@` iz ljuske agenta u cmux razgovoru ili zamolite osobu da ga pokrene."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Kunne ikke finde den chat, som denne agent kører i, så ingen kan blive spurgt om at starte %2$@ på Cloud-maskinen %1$@. Kør `%3$@` fra en agents shell i en cmux-chat, eller bed personen om at køre den."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Impossibile trovare la chat in cui viene eseguito questo agente, quindi non si può chiedere a nessuno di avviare %2$@ sulla macchina Cloud %1$@. Esegui `%3$@` dalla shell di un agente in una chat di cmux, oppure chiedi alla persona di eseguirlo."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "រកមិនឃើញការជជែកដែលភ្នាក់ងារនេះដំណើរការនៅក្នុងទេ ដូច្នេះមិនអាចសុំឱ្យនរណាម្នាក់ចាប់ផ្ដើម %2$@ នៅលើម៉ាស៊ីន Cloud %1$@ បានទេ។ ដំណើរការ `%3$@` ពីសែលរបស់ភ្នាក់ងារក្នុងការជជែក cmux ឬសុំឱ្យមនុស្សនោះដំណើរការវា។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Fant ikke chatten denne agenten kjører i, så ingen kan bli spurt om å starte %2$@ på Cloud-maskinen %1$@. Kjør `%3$@` fra en agents skall i en cmux-chat, eller be personen kjøre den."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Nie można znaleźć czatu, w którym działa ten agent, więc nikogo nie można poprosić o uruchomienie %2$@ na maszynie Cloud %1$@. Uruchom `%3$@` z powłoki agenta w czacie cmux lub poproś użytkownika, aby to uruchomił."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Não foi possível encontrar o chat em que este agente roda, então não há a quem pedir para iniciar %2$@ na máquina do Cloud %1$@. Execute `%3$@` no shell de um agente em um chat do cmux ou peça à pessoa para executá-lo."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Не удалось найти чат, в котором работает этот агент, поэтому некого попросить запустить %2$@ на машине Cloud %1$@. Выполните `%3$@` из оболочки агента в чате cmux или попросите пользователя выполнить эту команду."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ไม่พบแชทที่เอเจนต์นี้ทำงานอยู่ จึงไม่มีใครให้ขอเริ่ม %2$@ บนเครื่อง Cloud %1$@ ได้ เรียกใช้ `%3$@` จากเชลล์ของเอเจนต์ในแชท cmux หรือขอให้ผู้ใช้เรียกใช้คำสั่งนี้"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Bu ajanın çalıştığı sohbet bulunamadı, bu yüzden kimseden %2$@ ajanını %1$@ Cloud makinesinde başlatması istenemiyor. `%3$@` komutunu bir cmux sohbetindeki ajan kabuğundan çalıştırın veya kişiden çalıştırmasını isteyin."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Не вдалося знайти чат, у якому працює цей агент, тому немає кого попросити запустити %2$@ на машині Cloud %1$@. Виконайте `%3$@` з оболонки агента в чаті cmux або попросіть користувача виконати цю команду."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Không tìm thấy cuộc trò chuyện mà tác tử này đang chạy, nên không thể hỏi ai để khởi động %2$@ trên máy Cloud %1$@. Chạy `%3$@` từ shell của một tác tử trong cuộc trò chuyện cmux, hoặc nhờ người dùng chạy lệnh đó."}}
      }
    },
    "cloud.startSession.targetUnread": {
      "comment": "The machine list of the account signed in now could not be read, so the target is not known to be theirs. %1$@ machine id, %2$@ agent, %3$@ the command (keep it in backticks).",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Couldn't read the Cloud machines of the account signed in now, so %2$@ didn't start on %1$@. Check `cmux cloud list-machines`, then run `%3$@` again."}},
        "ja": {"stringUnit": {"state": "translated", "value": "現在サインインしているアカウントの Cloud マシンを読み込めなかったため、%1$@ で %2$@ は開始されませんでした。`cmux cloud list-machines` で確認してから、`%3$@` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Die Cloud-Maschinen des jetzt angemeldeten Kontos konnten nicht gelesen werden, daher wurde %2$@ auf %1$@ nicht gestartet. Prüfe `cmux cloud list-machines` und führe dann `%3$@` erneut aus."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Impossible de lire les machines Cloud du compte connecté : %2$@ n'a pas démarré sur %1$@. Vérifiez `cmux cloud list-machines`, puis relancez `%3$@`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "No se pudieron leer las máquinas de Cloud de la cuenta con la sesión iniciada, así que %2$@ no se inició en %1$@. Revisa `cmux cloud list-machines` y vuelve a ejecutar `%3$@`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تعذّرت قراءة أجهزة Cloud للحساب المسجّل الآن، لذا لم يبدأ %2$@ على %1$@. افحص `cmux cloud list-machines`، ثم شغّل `%3$@` مرة أخرى."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "지금 로그인한 계정의 Cloud 머신을 읽지 못해 %1$@에서 %2$@이(가) 시작되지 않았습니다. `cmux cloud list-machines`로 확인한 다음 `%3$@`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "无法读取当前登录帐户的 Cloud 机器，因此 %2$@ 没有在 %1$@ 上启动。请检查 `cmux cloud list-machines`，然后再次运行 `%3$@`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "無法讀取目前登入帳號的 Cloud 機器，因此 %2$@ 沒有在 %1$@ 上啟動。請檢查 `cmux cloud list-machines`，然後再次執行 `%3$@`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Nije moguće pročitati Cloud mašine trenutno prijavljenog računa, pa %2$@ nije pokrenut na %1$@. Provjerite `cmux cloud list-machines`, pa ponovo pokrenite `%3$@`."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Kunne ikke læse Cloud-maskinerne for den konto, der er logget ind nu, så %2$@ startede ikke på %1$@. Tjek `cmux cloud list-machines`, og kør derefter `%3$@` igen."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Impossibile leggere le macchine Cloud dell'account con cui hai effettuato l'accesso, quindi %2$@ non è stato avviato su %1$@. Controlla `cmux cloud list-machines`, poi esegui di nuovo `%3$@`."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "មិនអាចអានម៉ាស៊ីន Cloud របស់គណនីដែលបានចូលឥឡូវនេះបានទេ ដូច្នេះ %2$@ មិនបានចាប់ផ្តើមលើ %1$@ ទេ។ ពិនិត្យ `cmux cloud list-machines` រួចដំណើរការ `%3$@` ម្តងទៀត។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Kunne ikke lese Cloud-maskinene til kontoen som er logget inn nå, så %2$@ startet ikke på %1$@. Sjekk `cmux cloud list-machines`, og kjør deretter `%3$@` igjen."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Nie udało się odczytać maszyn Cloud konta, na które jesteś teraz zalogowany, więc %2$@ nie uruchomiono na %1$@. Sprawdź `cmux cloud list-machines`, a potem uruchom `%3$@` ponownie."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Não foi possível ler as máquinas do Cloud da conta conectada agora, então %2$@ não foi iniciado em %1$@. Confira `cmux cloud list-machines` e execute `%3$@` de novo."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Не удалось прочитать машины Cloud аккаунта, в который выполнен вход, поэтому %2$@ не запущен на %1$@. Проверьте `cmux cloud list-machines`, затем снова выполните `%3$@`."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "อ่านเครื่อง Cloud ของบัญชีที่ลงชื่อเข้าใช้อยู่ไม่ได้ %2$@ จึงไม่ได้เริ่มบน %1$@ ตรวจสอบ `cmux cloud list-machines` แล้วเรียกใช้ `%3$@` อีกครั้ง"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Şu anda oturum açık olan hesabın Cloud makineleri okunamadı, bu yüzden %2$@ %1$@ üzerinde başlamadı. `cmux cloud list-machines` ile kontrol edin, ardından `%3$@` komutunu yeniden çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Не вдалося прочитати машини Cloud облікового запису, у який виконано вхід, тому %2$@ не запущено на %1$@. Перевірте `cmux cloud list-machines`, потім знову виконайте `%3$@`."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Không đọc được các máy Cloud của tài khoản đang đăng nhập, nên %2$@ chưa khởi động trên %1$@. Hãy kiểm tra `cmux cloud list-machines`, rồi chạy lại `%3$@`."}}
      }
    },
    "cloud.startSession.listUnread": {
      "comment": "The machine list couldn't be read, so a machine by that name may exist. %1$@ machine name, %2$@ agent, %3$@ the command (keep it in backticks).",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Couldn't read your Cloud machines, so %2$@ didn't start: a machine named %1$@ may already exist. Check `cmux cloud list-machines`, then run `%3$@` again."}},
        "ja": {"stringUnit": {"state": "translated", "value": "Cloud マシンの一覧を読み込めなかったため、%2$@ は開始されませんでした。%1$@ という名前のマシンがすでにある可能性があります。`cmux cloud list-machines` で確認してから、`%3$@` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Deine Cloud-Maschinen konnten nicht gelesen werden, daher wurde %2$@ nicht gestartet: Eine Maschine namens %1$@ gibt es vielleicht schon. Prüfe `cmux cloud list-machines` und führe dann `%3$@` erneut aus."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Impossible de lire vos machines Cloud : %2$@ n'a pas démarré, car une machine nommée %1$@ existe peut-être déjà. Vérifiez `cmux cloud list-machines`, puis relancez `%3$@`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "No se pudieron leer tus máquinas de Cloud, así que %2$@ no se inició: puede que ya exista una máquina llamada %1$@. Revisa `cmux cloud list-machines` y vuelve a ejecutar `%3$@`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تعذّرت قراءة أجهزة Cloud الخاصة بك، لذا لم يبدأ %2$@: قد يكون هناك جهاز باسم %1$@ بالفعل. افحص `cmux cloud list-machines`، ثم شغّل `%3$@` مرة أخرى."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "Cloud 머신 목록을 읽지 못해 %2$@이(가) 시작되지 않았습니다. %1$@이라는 머신이 이미 있을 수 있습니다. `cmux cloud list-machines`로 확인한 다음 `%3$@`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "无法读取你的 Cloud 机器，因此 %2$@ 没有启动：可能已有名为 %1$@ 的机器。请检查 `cmux cloud list-machines`，然后再次运行 `%3$@`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "無法讀取你的 Cloud 機器，因此 %2$@ 沒有啟動：可能已有名為 %1$@ 的機器。請檢查 `cmux cloud list-machines`，然後再次執行 `%3$@`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Nije moguće pročitati vaše Cloud mašine, pa se %2$@ nije pokrenuo: mašina s nazivom %1$@ možda već postoji. Provjerite `cmux cloud list-machines`, a zatim ponovo pokrenite `%3$@`."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Kunne ikke læse dine Cloud-maskiner, så %2$@ startede ikke: en maskine med navnet %1$@ findes måske allerede. Tjek `cmux cloud list-machines`, og kør derefter `%3$@` igen."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Impossibile leggere le tue macchine Cloud, quindi %2$@ non è stato avviato: una macchina chiamata %1$@ potrebbe già esistere. Controlla `cmux cloud list-machines`, poi esegui di nuovo `%3$@`."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "មិនអាចអានម៉ាស៊ីន Cloud របស់អ្នកបានទេ ដូច្នេះ %2$@ មិនបានចាប់ផ្ដើមទេ៖ ម៉ាស៊ីនឈ្មោះ %1$@ ប្រហែលជាមានរួចហើយ។ ពិនិត្យ `cmux cloud list-machines` រួចដំណើរការ `%3$@` ម្ដងទៀត។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Kunne ikke lese Cloud-maskinene dine, så %2$@ startet ikke: en maskin med navnet %1$@ finnes kanskje allerede. Sjekk `cmux cloud list-machines`, og kjør deretter `%3$@` på nytt."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Nie można odczytać Twoich maszyn Cloud, więc %2$@ nie uruchomił się: maszyna o nazwie %1$@ może już istnieć. Sprawdź `cmux cloud list-machines`, a następnie uruchom ponownie `%3$@`."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Não foi possível ler suas máquinas do Cloud, então %2$@ não iniciou: uma máquina chamada %1$@ pode já existir. Verifique `cmux cloud list-machines` e execute `%3$@` novamente."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Не удалось прочитать ваши машины Cloud, поэтому %2$@ не запущен: машина с именем %1$@ может уже существовать. Проверьте `cmux cloud list-machines`, затем снова выполните `%3$@`."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "อ่านรายการเครื่อง Cloud ของคุณไม่ได้ %2$@ จึงไม่ได้เริ่ม: อาจมีเครื่องชื่อ %1$@ อยู่แล้ว ตรวจสอบ `cmux cloud list-machines` แล้วเรียกใช้ `%3$@` อีกครั้ง"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Cloud makineleriniz okunamadı, bu yüzden %2$@ başlamadı: %1$@ adında bir makine zaten var olabilir. `cmux cloud list-machines` ile kontrol edin, ardından `%3$@` komutunu yeniden çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Не вдалося прочитати ваші машини Cloud, тому %2$@ не запущено: машина з назвою %1$@ може вже існувати. Перевірте `cmux cloud list-machines`, потім знову виконайте `%3$@`."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Không thể đọc danh sách máy Cloud của bạn nên %2$@ chưa khởi động: có thể đã có một máy tên %1$@. Kiểm tra `cmux cloud list-machines`, rồi chạy lại `%3$@`."}}
      }
    },
    "cloud.startSession.askPending": {
      "comment": "An agent's start-session run once its card asks the person. %1$@ machine, %2$@ agent, %3$@ the command (keep it in backticks), %4$@ the dialog id (keep the command in backticks).",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Asked the person in this chat to start %2$@ on %1$@ (Start or Not now, for 2 minutes). Run `%3$@` again to wait for their answer and get machine_id and session_id. They can also answer from their own terminal: `cmux agents dialog answer %4$@ --selection start`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "طُلب من الشخص في هذه المحادثة بدء %2$@ على %1$@ (بدء أو ليس الآن، لمدة دقيقتين). شغّل `%3$@` مجددًا لانتظار رده والحصول على machine_id وsession_id. يمكنه أيضًا الرد من الطرفية الخاصة به: `cmux agents dialog answer %4$@ --selection start`."}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Osoba u ovom četu je upitana da pokrene %2$@ na %1$@ (Pokreni ili Ne sada, 2 minute). Ponovo pokreni `%3$@` da sačekaš odgovor i dobiješ machine_id i session_id. Može odgovoriti i iz svog terminala: `cmux agents dialog answer %4$@ --selection start`."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Personen i denne chat er blevet spurgt, om %2$@ skal startes på %1$@ (Start eller Ikke nu, i 2 minutter). Kør `%3$@` igen for at vente på svaret og få machine_id og session_id. Personen kan også svare fra sin egen terminal: `cmux agents dialog answer %4$@ --selection start`."}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Die Person in diesem Chat wurde gefragt, %2$@ auf %1$@ zu starten (Starten oder Nicht jetzt, 2 Minuten lang). Führe `%3$@` erneut aus, um auf die Antwort zu warten und machine_id und session_id zu erhalten. Sie kann auch im eigenen Terminal antworten: `cmux agents dialog answer %4$@ --selection start`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Se pidió a la persona en este chat que inicie %2$@ en %1$@ (Iniciar o Ahora no, durante 2 minutos). Ejecuta `%3$@` de nuevo para esperar su respuesta y obtener machine_id y session_id. También puede responder desde su propia terminal: `cmux agents dialog answer %4$@ --selection start`."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "La personne a été invitée dans ce chat à démarrer %2$@ sur %1$@ (Démarrer ou Pas maintenant, pendant 2 minutes). Relancez `%3$@` pour attendre sa réponse et obtenir machine_id et session_id. Elle peut aussi répondre depuis son propre terminal : `cmux agents dialog answer %4$@ --selection start`."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "È stato chiesto alla persona in questa chat di avviare %2$@ su %1$@ (Avvia o Non ora, per 2 minuti). Esegui di nuovo `%3$@` per attendere la risposta e ottenere machine_id e session_id. Può anche rispondere dal proprio terminale: `cmux agents dialog answer %4$@ --selection start`."}},
        "ja": {"stringUnit": {"state": "translated", "value": "このチャットで %1$@ に %2$@ を開始するよう本人に確認しました（開始 または 後で、2 分間）。回答を待って machine_id と session_id を受け取るには `%3$@` をもう一度実行してください。本人は自分のターミナルからも回答できます: `cmux agents dialog answer %4$@ --selection start`。"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "បានសួរមនុស្សនៅក្នុងការជជែកនេះឱ្យចាប់ផ្ដើម %2$@ នៅលើ %1$@ (ចាប់ផ្ដើម ឬ មិនមែនឥឡូវ រយៈពេល 2 នាទី)។ ដំណើរការ `%3$@` ម្ដងទៀត ដើម្បីរង់ចាំចម្លើយ ហើយទទួលបាន machine_id និង session_id។ គេក៏អាចឆ្លើយពីទែមីណាល់ផ្ទាល់ខ្លួនបានដែរ៖ `cmux agents dialog answer %4$@ --selection start`។"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "이 채팅에서 %1$@에서 %2$@을(를) 시작할지 사용자에게 물었습니다(시작 또는 나중에, 2분 동안). 답을 기다렸다가 machine_id와 session_id를 받으려면 `%3$@`을(를) 다시 실행하세요. 사용자는 자신의 터미널에서도 답할 수 있습니다: `cmux agents dialog answer %4$@ --selection start`."}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Personen i denne chatten er spurt om å starte %2$@ på %1$@ (Start eller Ikke nå, i 2 minutter). Kjør `%3$@` igjen for å vente på svaret og få machine_id og session_id. Personen kan også svare fra sin egen terminal: `cmux agents dialog answer %4$@ --selection start`."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Poproszono osobę w tym czacie o uruchomienie %2$@ na %1$@ (Uruchom lub Nie teraz, przez 2 minuty). Uruchom ponownie `%3$@`, aby poczekać na odpowiedź i otrzymać machine_id oraz session_id. Może też odpowiedzieć z własnego terminala: `cmux agents dialog answer %4$@ --selection start`."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "A pessoa neste chat foi solicitada a iniciar %2$@ em %1$@ (Iniciar ou Agora não, por 2 minutos). Execute `%3$@` de novo para aguardar a resposta e obter machine_id e session_id. Ela também pode responder pelo próprio terminal: `cmux agents dialog answer %4$@ --selection start`."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Человека в этом чате попросили запустить %2$@ на %1$@ («Запустить» или «Не сейчас», 2 минуты). Снова выполните `%3$@`, чтобы дождаться ответа и получить machine_id и session_id. Он также может ответить из своего терминала: `cmux agents dialog answer %4$@ --selection start`."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ได้ถามผู้ใช้ในแชทนี้ให้เริ่ม %2$@ บน %1$@ แล้ว (เริ่ม หรือ ไม่ใช่ตอนนี้ ภายใน 2 นาที) เรียก `%3$@` อีกครั้งเพื่อรอคำตอบและรับ machine_id กับ session_id ผู้ใช้ตอบจากเทอร์มินัลของตัวเองได้ด้วย: `cmux agents dialog answer %4$@ --selection start`"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Bu sohbetteki kişiye %2$@ uygulamasını %1$@ üzerinde başlatması soruldu (Başlat veya Şimdi değil, 2 dakika boyunca). Yanıtını beklemek ve machine_id ile session_id almak için `%3$@` komutunu yeniden çalıştırın. Kendi terminalinden de yanıt verebilir: `cmux agents dialog answer %4$@ --selection start`."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Людину в цьому чаті попросили запустити %2$@ на %1$@ («Запустити» або «Не зараз», 2 хвилини). Знову виконайте `%3$@`, щоб дочекатися відповіді й отримати machine_id і session_id. Вона також може відповісти зі свого терміналу: `cmux agents dialog answer %4$@ --selection start`."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Đã hỏi người dùng trong cuộc trò chuyện này có khởi động %2$@ trên %1$@ không (Bắt đầu hoặc Để sau, trong 2 phút). Chạy lại `%3$@` để chờ câu trả lời và nhận machine_id và session_id. Họ cũng có thể trả lời từ terminal của mình: `cmux agents dialog answer %4$@ --selection start`."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "已在此聊天中请对方在 %1$@ 上启动 %2$@（开始 或 暂不，限时 2 分钟）。再次运行 `%3$@` 以等待其回答并获取 machine_id 和 session_id。对方也可以在自己的终端中回答：`cmux agents dialog answer %4$@ --selection start`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "已在此聊天中請對方在 %1$@ 上啟動 %2$@（開始 或 暫不，限時 2 分鐘）。再次執行 `%3$@` 以等待其回答並取得 machine_id 和 session_id。對方也可以在自己的終端機中回答：`cmux agents dialog answer %4$@ --selection start`。"}}
      }
    },
    "cloud.startSession.personRequired": {
      "comment": "An agent tried to choose Start on a Cloud start ask from the CLI. %1$@ the dialog id (keep the commands in backticks; the setting's name and Settings > Machines as the app shows them).",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Only the person can choose Start: on the card in the chat, or with `cmux agents dialog answer %1$@ --selection start` in their own terminal. To let agents start Cloud sessions without asking, they can turn on Let Agents Use Cloud Without Asking in Settings > Machines. `--selection notNow` declines."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "لا يمكن إلا للشخص نفسه اختيار بدء: من البطاقة في المحادثة، أو بالأمر `cmux agents dialog answer %1$@ --selection start` في طرفيته الخاصة. للسماح للوكلاء ببدء جلسات سحابية دون سؤال، يمكنه تفعيل «السماح للوكلاء باستخدام السحابة دون سؤال» في الإعدادات > الأجهزة. يرفض `--selection notNow`."}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Samo osoba može izabrati Pokreni: na kartici u četu ili s `cmux agents dialog answer %1$@ --selection start` u svom terminalu. Da agenti pokreću Cloud sesije bez pitanja, može uključiti „Dozvoli agentima da koriste Cloud bez pitanja“ u Postavke > Mašine. `--selection notNow` odbija."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Kun personen kan vælge Start: på kortet i chatten eller med `cmux agents dialog answer %1$@ --selection start` i sin egen terminal. For at lade agenter starte Cloud-sessioner uden at spørge kan personen slå „Lad agenter bruge Cloud uden at spørge“ til under Indstillinger > Maskiner. `--selection notNow` afviser."}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Nur die Person kann Starten wählen: auf der Karte im Chat oder mit `cmux agents dialog answer %1$@ --selection start` im eigenen Terminal. Damit Agents Cloud-Sitzungen ohne Nachfrage starten, kann sie in Einstellungen > Maschinen „Agents die Cloud ohne Nachfrage nutzen lassen“ einschalten. `--selection notNow` lehnt ab."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Solo la persona puede elegir Iniciar: en la tarjeta del chat o con `cmux agents dialog answer %1$@ --selection start` en su propia terminal. Para que los agentes inicien sesiones en la nube sin preguntar, puede activar «Permitir que los agentes usen la nube sin preguntar» en Ajustes > Máquinas. `--selection notNow` rechaza."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Seule la personne peut choisir Démarrer : sur la carte du chat, ou avec `cmux agents dialog answer %1$@ --selection start` dans son propre terminal. Pour laisser les agents démarrer des sessions Cloud sans demander, elle peut activer « Laisser les agents utiliser le Cloud sans demander » dans Réglages > Machines. `--selection notNow` refuse."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Solo la persona può scegliere Avvia: sulla scheda nella chat o con `cmux agents dialog answer %1$@ --selection start` nel proprio terminale. Per consentire agli agenti di avviare sessioni Cloud senza chiedere, può attivare «Consenti agli agenti di usare il Cloud senza chiedere» in Impostazioni > Macchine. `--selection notNow` rifiuta."}},
        "ja": {"stringUnit": {"state": "translated", "value": "開始 を選べるのは本人だけです: チャットのカードで、または本人のターミナルで `cmux agents dialog answer %1$@ --selection start` を実行します。確認なしでエージェントにクラウドを使わせるには、設定 > マシン の「確認なしでエージェントにクラウドを使わせる」をオンにします。`--selection notNow` で断ります。"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "មានតែមនុស្សនោះទេដែលអាចជ្រើស ចាប់ផ្ដើម៖ នៅលើកាតក្នុងការជជែក ឬដោយ `cmux agents dialog answer %1$@ --selection start` នៅក្នុងទែមីណាល់ផ្ទាល់ខ្លួន។ ដើម្បីឱ្យភ្នាក់ងារចាប់ផ្ដើមវគ្គ Cloud ដោយមិនសួរ គេអាចបើក «អនុញ្ញាតឱ្យភ្នាក់ងារប្រើ Cloud ដោយមិនសួរ» នៅក្នុង ការកំណត់ > ម៉ាស៊ីន។ `--selection notNow` បដិសេធ។"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "시작은 사용자 본인만 선택할 수 있습니다: 채팅의 카드에서, 또는 자신의 터미널에서 `cmux agents dialog answer %1$@ --selection start`로. 묻지 않고 에이전트가 클라우드 세션을 시작하게 하려면 설정 > 머신에서 '묻지 않고 에이전트가 클라우드 사용'을 켤 수 있습니다. `--selection notNow`는 거절합니다."}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Bare personen kan velge Start: på kortet i chatten eller med `cmux agents dialog answer %1$@ --selection start` i sin egen terminal. For å la agenter starte Cloud-økter uten å spørre kan personen slå på «La agenter bruke Cloud uten å spørre» i Innstillinger > Maskiner. `--selection notNow` avslår."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Tylko ta osoba może wybrać Uruchom: na karcie w czacie lub poleceniem `cmux agents dialog answer %1$@ --selection start` we własnym terminalu. Aby agenci uruchamiali sesje w chmurze bez pytania, może włączyć „Pozwól agentom korzystać z chmury bez pytania” w Ustawienia > Maszyny. `--selection notNow` odmawia."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Só a pessoa pode escolher Iniciar: no cartão do chat ou com `cmux agents dialog answer %1$@ --selection start` no próprio terminal. Para deixar agentes iniciarem sessões na nuvem sem perguntar, ela pode ativar “Permitir que agentes usem a nuvem sem perguntar” em Ajustes > Máquinas. `--selection notNow` recusa."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Выбрать «Запустить» может только сам человек: на карточке в чате или командой `cmux agents dialog answer %1$@ --selection start` в своём терминале. Чтобы агенты запускали облачные сеансы без вопроса, он может включить «Разрешить агентам использовать облако без вопроса» в Настройки > Машины. `--selection notNow` отклоняет."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "มีเพียงผู้ใช้เท่านั้นที่เลือก เริ่ม ได้: บนการ์ดในแชท หรือด้วย `cmux agents dialog answer %1$@ --selection start` ในเทอร์มินัลของตัวเอง หากต้องการให้เอเจนต์ใช้คลาวด์โดยไม่ต้องถาม ผู้ใช้เปิด \"ให้เอเจนต์ใช้คลาวด์โดยไม่ต้องถาม\" ได้ใน การตั้งค่า > เครื่อง `--selection notNow` คือปฏิเสธ"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Başlat'ı yalnızca kişinin kendisi seçebilir: sohbetteki kartta veya kendi terminalinde `cmux agents dialog answer %1$@ --selection start` ile. Ajanların sormadan bulutu kullanmasına izin vermek için Ayarlar > Makineler'de \"Ajanların sormadan bulutu kullanmasına izin ver\" seçeneğini açabilir. `--selection notNow` reddeder."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Вибрати «Запустити» може лише сама людина: на картці в чаті або командою `cmux agents dialog answer %1$@ --selection start` у власному терміналі. Щоб агенти запускали хмарні сеанси без запиту, вона може ввімкнути «Дозволити агентам користуватися хмарою без запиту» в Налаштування > Машини. `--selection notNow` відхиляє."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Chỉ người dùng mới có thể chọn Bắt đầu: trên thẻ trong cuộc trò chuyện, hoặc bằng `cmux agents dialog answer %1$@ --selection start` trong terminal của họ. Để tác tử khởi động phiên đám mây mà không cần hỏi, họ có thể bật \"Cho phép tác tử dùng đám mây mà không cần hỏi\" trong Cài đặt > Máy. `--selection notNow` để từ chối."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "只有本人可以选择“开始”：在聊天中的卡片上，或在自己的终端中运行 `cmux agents dialog answer %1$@ --selection start`。要让智能体无需询问即可启动云端会话，可以在“设置 > 机器”中打开“允许智能体无需询问即使用云端”。`--selection notNow` 表示拒绝。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "只有本人可以選擇「開始」：在聊天中的卡片上，或在自己的終端機中執行 `cmux agents dialog answer %1$@ --selection start`。若要讓代理程式不經詢問即可啟動雲端工作階段，可以在「設定 > 機器」中開啟「允許代理程式不經詢問即使用雲端」。`--selection notNow` 表示拒絕。"}}
      }
    },
    "cloud.startSession.unknownChoice": {
      "comment": "A CLI answer to a Cloud start ask named neither choice. %1$@ the dialog id (keep the flags in backticks).",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Answer %1$@ with `--selection start` or `--selection notNow`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "أجب على %1$@ باستخدام `--selection start` أو `--selection notNow`."}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Odgovori na %1$@ s `--selection start` ili `--selection notNow`."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Besvar %1$@ med `--selection start` eller `--selection notNow`."}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Beantworte %1$@ mit `--selection start` oder `--selection notNow`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Responde a %1$@ con `--selection start` o `--selection notNow`."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Répondez à %1$@ avec `--selection start` ou `--selection notNow`."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Rispondi a %1$@ con `--selection start` o `--selection notNow`."}},
        "ja": {"stringUnit": {"state": "translated", "value": "%1$@ には `--selection start` または `--selection notNow` で回答してください。"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ឆ្លើយ %1$@ ដោយ `--selection start` ឬ `--selection notNow`។"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "%1$@에는 `--selection start` 또는 `--selection notNow`로 답하세요."}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Svar på %1$@ med `--selection start` eller `--selection notNow`."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Odpowiedz na %1$@ za pomocą `--selection start` lub `--selection notNow`."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Responda a %1$@ com `--selection start` ou `--selection notNow`."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Ответьте на %1$@ с помощью `--selection start` или `--selection notNow`."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ตอบ %1$@ ด้วย `--selection start` หรือ `--selection notNow`"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "%1$@ için `--selection start` veya `--selection notNow` ile yanıt verin."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Дайте відповідь на %1$@ за допомогою `--selection start` або `--selection notNow`."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Trả lời %1$@ bằng `--selection start` hoặc `--selection notNow`."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "请用 `--selection start` 或 `--selection notNow` 回答 %1$@。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "請用 `--selection start` 或 `--selection notNow` 回答 %1$@。"}}
      }
    },
    "cloud.startSession.dialogGone": {
      "comment": "A CLI answer named a Cloud start ask that no longer waits. %1$@ the dialog id (keep the command in backticks).",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "No Cloud start %1$@ waits for an answer: it was answered, timed out or ended. `cmux agents dialog list` shows what still waits."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "لا يوجد بدء سحابي %1$@ ينتظر ردًا: تمت الإجابة عليه أو انتهت مهلته أو انتهى. يعرض `cmux agents dialog list` ما لا يزال ينتظر."}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Nijedno Cloud pokretanje %1$@ ne čeka odgovor: odgovoreno je, isteklo je ili je završeno. `cmux agents dialog list` pokazuje šta još čeka."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Ingen Cloud-start %1$@ venter på svar: den er besvaret, udløbet eller afsluttet. `cmux agents dialog list` viser, hvad der stadig venter."}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Kein Cloud-Start %1$@ wartet auf eine Antwort: Er wurde beantwortet, ist abgelaufen oder beendet. `cmux agents dialog list` zeigt, was noch wartet."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Ningún inicio en la nube %1$@ espera respuesta: se respondió, caducó o terminó. `cmux agents dialog list` muestra lo que aún espera."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Aucun démarrage Cloud %1$@ n'attend de réponse : il a été répondu, a expiré ou s'est terminé. `cmux agents dialog list` montre ce qui attend encore."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Nessun avvio Cloud %1$@ attende una risposta: ha già ricevuto risposta, è scaduto o è terminato. `cmux agents dialog list` mostra cosa è ancora in attesa."}},
        "ja": {"stringUnit": {"state": "translated", "value": "回答を待っているクラウド開始 %1$@ はありません: 回答済み、時間切れ、または終了しています。まだ待っているものは `cmux agents dialog list` で確認できます。"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "គ្មានការចាប់ផ្ដើម Cloud %1$@ ដែលកំពុងរង់ចាំចម្លើយទេ៖ វាត្រូវបានឆ្លើយ អស់ពេល ឬបានបញ្ចប់។ `cmux agents dialog list` បង្ហាញអ្វីដែលនៅរង់ចាំ។"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "답을 기다리는 클라우드 시작 %1$@이(가) 없습니다: 이미 답했거나, 시간이 지났거나, 끝났습니다. 아직 기다리는 항목은 `cmux agents dialog list`에 표시됩니다."}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Ingen Cloud-start %1$@ venter på svar: den er besvart, tidsavbrutt eller avsluttet. `cmux agents dialog list` viser hva som fortsatt venter."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Żadne uruchomienie w chmurze %1$@ nie czeka na odpowiedź: zostało już odpowiedziane, wygasło lub się zakończyło. `cmux agents dialog list` pokazuje, co nadal czeka."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Nenhum início na nuvem %1$@ aguarda resposta: já foi respondido, expirou ou terminou. `cmux agents dialog list` mostra o que ainda aguarda."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Нет облачного запуска %1$@, ожидающего ответа: на него уже ответили, время истекло или он завершён. `cmux agents dialog list` показывает, что ещё ждёт."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ไม่มีการเริ่มคลาวด์ %1$@ ที่รอคำตอบ: ถูกตอบแล้ว หมดเวลา หรือสิ้นสุดแล้ว `cmux agents dialog list` แสดงรายการที่ยังรออยู่"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Yanıt bekleyen bir bulut başlatma %1$@ yok: yanıtlandı, zaman aşımına uğradı veya sona erdi. `cmux agents dialog list` hâlâ bekleyenleri gösterir."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Немає хмарного запуску %1$@, що чекає відповіді: на нього вже відповіли, час минув або його завершено. `cmux agents dialog list` показує, що ще чекає."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Không có lần khởi động đám mây %1$@ nào đang chờ trả lời: nó đã được trả lời, hết thời gian hoặc đã kết thúc. `cmux agents dialog list` hiển thị những gì vẫn đang chờ."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "没有等待回答的云端启动 %1$@：它已被回答、已超时或已结束。`cmux agents dialog list` 会显示仍在等待的项目。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "沒有等待回答的雲端啟動 %1$@：它已被回答、已逾時或已結束。`cmux agents dialog list` 會顯示仍在等待的項目。"}}
      }
    },
    "cloud.startSession.loginInvalid": {
      "comment": "A `cmux cloud start-session --login` value that is none of the three words. Keep --login, pass, machine and none in English.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Pass --login as pass (your own login), machine (the machine's own) or none."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "مرّر --login بالقيمة pass (تسجيل دخولك أنت) أو machine (تسجيل دخول الجهاز) أو none."}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Proslijedi --login kao pass (tvoja prijava), machine (prijava mašine) ili none."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Angiv --login som pass (dit eget login), machine (maskinens eget) eller none."}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Gib --login als pass (deine eigene Anmeldung), machine (die der Maschine) oder none an."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Pasa --login como pass (tu propio inicio de sesión), machine (el de la máquina) o none."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Indiquez --login avec pass (votre propre connexion), machine (celle de la machine) ou none."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Passa --login come pass (il tuo accesso), machine (quello della macchina) o none."}},
        "ja": {"stringUnit": {"state": "translated", "value": "--login には pass（自分のログイン）、machine（マシン自身のログイン）、none のいずれかを指定してください。"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ផ្ដល់ --login ជា pass (ការចូលរបស់អ្នក) machine (របស់ម៉ាស៊ីន) ឬ none។"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "--login에는 pass(내 로그인), machine(머신 자체 로그인) 또는 none을 지정하세요."}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Angi --login som pass (din egen pålogging), machine (maskinens egen) eller none."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Podaj --login jako pass (twoje logowanie), machine (logowanie maszyny) lub none."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Passe --login como pass (seu próprio login), machine (o da máquina) ou none."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Укажите --login как pass (ваш вход), machine (вход самой машины) или none."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ส่ง --login เป็น pass (การเข้าสู่ระบบของคุณเอง), machine (ของเครื่องเอง) หรือ none"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "--login değerini pass (kendi girişiniz), machine (makinenin kendi girişi) veya none olarak verin."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Укажіть --login як pass (ваш вхід), machine (вхід самої машини) або none."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Truyền --login là pass (đăng nhập của bạn), machine (của máy) hoặc none."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "请将 --login 设为 pass（你自己的登录）、machine（机器自己的登录）或 none。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "請將 --login 設為 pass（你自己的登入）、machine（機器自己的登入）或 none。"}}
      }
    },
    "cloud.startSession.loginNeeded": {
      "comment": "A CLI or agent Cloud start that would have to ask about the harness login. %1$@ machine, %2$@ agent (keep the --login flags in English).",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "%2$@ on %1$@ has no login, and no login choice is kept for your Cloud machines. To give it your own login, start a session on a Cloud machine from cmux once and choose Yes (kept for every later machine). Or run it again with --login machine to use only a login the machine already has, or with --login none."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "لا يوجد تسجيل دخول لـ %2$@ على %1$@، ولا يوجد اختيار محفوظ لتسجيل الدخول لأجهزة Cloud الخاصة بك. لتمنحه تسجيل دخولك، ابدأ جلسة على جهاز Cloud من cmux مرة واحدة واختر نعم (يُحفظ لكل جهاز لاحق). أو شغّله مجددًا مع --login machine لاستخدام تسجيل دخول موجود على الجهاز فقط، أو مع --login none."}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "%2$@ na %1$@ nema prijavu, a za tvoje Cloud mašine nije sačuvan izbor prijave. Da mu daš svoju prijavu, jednom pokreni sesiju na Cloud mašini iz cmuxa i izaberi Da (vrijedi za svaku kasniju mašinu). Ili ga ponovo pokreni s --login machine da koristiš samo prijavu koju mašina već ima, ili s --login none."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "%2$@ på %1$@ har intet login, og der er ikke gemt noget loginvalg for dine Cloud-maskiner. For at give det dit eget login skal du starte en session på en Cloud-maskine fra cmux én gang og vælge Ja (gemmes for alle senere maskiner). Eller kør det igen med --login machine for kun at bruge et login, maskinen allerede har, eller med --login none."}},
        "de": {"stringUnit": {"state": "needs_review", "value": "%2$@ auf %1$@ hat keine Anmeldung, und für deine Cloud-Maschinen ist keine Anmeldewahl gespeichert. Um deine eigene Anmeldung zu geben, starte einmal in cmux eine Sitzung auf einer Cloud-Maschine und wähle Ja (gilt für jede spätere Maschine). Oder führe es erneut mit --login machine aus, um nur eine Anmeldung zu nutzen, die die Maschine schon hat, oder mit --login none."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "%2$@ en %1$@ no tiene inicio de sesión y no hay ninguna elección de inicio de sesión guardada para tus máquinas Cloud. Para darle tu propio inicio de sesión, inicia una vez una sesión en una máquina Cloud desde cmux y elige Sí (se guarda para cada máquina posterior). O vuelve a ejecutarlo con --login machine para usar solo un inicio de sesión que la máquina ya tenga, o con --login none."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "%2$@ sur %1$@ n'a pas de connexion, et aucun choix de connexion n'est enregistré pour vos machines Cloud. Pour lui donner votre propre connexion, démarrez une fois une session sur une machine Cloud depuis cmux et choisissez Oui (conservé pour chaque machine suivante). Ou relancez avec --login machine pour n'utiliser qu'une connexion que la machine a déjà, ou avec --login none."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "%2$@ su %1$@ non ha un accesso e per le tue macchine Cloud non è salvata alcuna scelta di accesso. Per dargli il tuo accesso, avvia una volta una sessione su una macchina Cloud da cmux e scegli Sì (vale per ogni macchina successiva). Oppure eseguilo di nuovo con --login machine per usare solo un accesso che la macchina ha già, o con --login none."}},
        "ja": {"stringUnit": {"state": "translated", "value": "%1$@ の %2$@ にはログインがなく、クラウドマシンのログイン方法も保存されていません。自分のログインを渡すには、cmux からクラウドマシンでセッションを一度開始して「はい」を選んでください（以降のすべてのマシンに適用）。マシンに既にあるログインだけを使うには --login machine、何も渡さないなら --login none を付けて再実行してください。"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "%2$@ នៅលើ %1$@ មិនមានការចូលទេ ហើយមិនមានជម្រើសការចូលដែលបានរក្សាទុកសម្រាប់ម៉ាស៊ីន Cloud របស់អ្នកទេ។ ដើម្បីផ្ដល់ការចូលផ្ទាល់ខ្លួនរបស់អ្នក ចាប់ផ្ដើមវគ្គមួយលើម៉ាស៊ីន Cloud ពី cmux ម្ដង ហើយជ្រើស បាទ/ចាស (រក្សាទុកសម្រាប់ម៉ាស៊ីនបន្ទាប់ៗ)។ ឬដំណើរការម្ដងទៀតជាមួយ --login machine ដើម្បីប្រើតែការចូលដែលម៉ាស៊ីនមានរួច ឬជាមួយ --login none។"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "%1$@의 %2$@에는 로그인이 없고, Cloud 머신에 저장된 로그인 선택도 없습니다. 내 로그인을 주려면 cmux에서 Cloud 머신 세션을 한 번 시작하고 '예'를 선택하세요(이후 모든 머신에 적용). 또는 머신에 이미 있는 로그인만 쓰려면 --login machine, 아무것도 주지 않으려면 --login none을 붙여 다시 실행하세요."}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "%2$@ på %1$@ har ingen pålogging, og det er ikke lagret noe påloggingsvalg for Cloud-maskinene dine. For å gi den din egen pålogging, start en økt på en Cloud-maskin fra cmux én gang og velg Ja (gjelder for alle senere maskiner). Eller kjør den på nytt med --login machine for bare å bruke en pålogging maskinen allerede har, eller med --login none."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "%2$@ na %1$@ nie ma logowania, a dla twoich maszyn Cloud nie zapisano wyboru logowania. Aby dać mu swoje logowanie, uruchom raz sesję na maszynie Cloud z cmux i wybierz Tak (zostaje dla każdej kolejnej maszyny). Albo uruchom ponownie z --login machine, by użyć tylko logowania, które maszyna już ma, albo z --login none."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "%2$@ em %1$@ não tem login, e nenhuma escolha de login está salva para suas máquinas Cloud. Para dar a ele seu próprio login, inicie uma vez uma sessão em uma máquina Cloud pelo cmux e escolha Sim (vale para cada máquina seguinte). Ou execute de novo com --login machine para usar apenas um login que a máquina já tem, ou com --login none."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "У %2$@ на %1$@ нет входа, и для ваших облачных машин не сохранён выбор входа. Чтобы передать ему свой вход, один раз запустите сеанс на облачной машине из cmux и выберите «Да» (сохранится для всех следующих машин). Или запустите снова с --login machine, чтобы использовать только вход, который уже есть на машине, или с --login none."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "%2$@ บน %1$@ ไม่มีการลงชื่อเข้าใช้ และไม่มีตัวเลือกการลงชื่อเข้าใช้ที่บันทึกไว้สำหรับเครื่อง Cloud ของคุณ หากต้องการให้การลงชื่อเข้าใช้ของคุณเอง ให้เริ่มเซสชันบนเครื่อง Cloud จาก cmux หนึ่งครั้งแล้วเลือก ใช่ (ใช้กับทุกเครื่องหลังจากนี้) หรือเรียกอีกครั้งด้วย --login machine เพื่อใช้เฉพาะการลงชื่อเข้าใช้ที่เครื่องมีอยู่แล้ว หรือด้วย --login none"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "%1$@ üzerindeki %2$@ için oturum yok ve Cloud makineleriniz için kayıtlı bir oturum seçimi yok. Kendi oturumunuzu vermek için cmux'tan bir Cloud makinesinde bir kez oturum başlatıp Evet'i seçin (sonraki her makine için geçerli). Ya da yalnızca makinede zaten olan oturumu kullanmak için --login machine ile veya --login none ile yeniden çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "У %2$@ на %1$@ немає входу, і для ваших хмарних машин не збережено вибору входу. Щоб передати йому свій вхід, один раз запустіть сеанс на хмарній машині з cmux і виберіть «Так» (збережеться для всіх наступних машин). Або запустіть знову з --login machine, щоб використовувати лише вхід, який уже є на машині, або з --login none."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "%2$@ trên %1$@ không có đăng nhập, và chưa có lựa chọn đăng nhập nào được lưu cho các máy Cloud của bạn. Để cho nó đăng nhập của bạn, hãy bắt đầu một phiên trên máy Cloud từ cmux một lần và chọn Có (áp dụng cho mọi máy sau này). Hoặc chạy lại với --login machine để chỉ dùng đăng nhập mà máy đã có, hoặc với --login none."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "%1$@ 上的 %2$@ 没有登录，也没有为你的 Cloud 机器保存登录选择。要给它你自己的登录，请在 cmux 中在一台 Cloud 机器上启动一次会话并选择“是”（之后的每台机器都适用）。或者加上 --login machine 重新运行，只使用机器已有的登录；或加上 --login none。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "%1$@ 上的 %2$@ 沒有登入，也沒有為你的 Cloud 機器儲存登入選擇。要給它你自己的登入，請在 cmux 中於一台 Cloud 機器上啟動一次工作階段並選擇「是」（之後的每台機器都適用）。或者加上 --login machine 重新執行，只使用機器已有的登入；或加上 --login none。"}}
      }
    },
    "cloud.startSession.machineLoginMissing": {
      "comment": "--login machine on a Cloud machine with no harness login of its own. %1$@ machine, %2$@ agent (keep --login in English).",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "%2$@ on %1$@ has no login of its own, and the login choice is machine. Sign in on the machine, or run it again with --login none."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "لا يملك %2$@ على %1$@ تسجيل دخول خاصًا به، واختيار تسجيل الدخول هو machine. سجّل الدخول على الجهاز، أو شغّله مجددًا مع --login none."}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "%2$@ na %1$@ nema vlastitu prijavu, a izbor prijave je machine. Prijavi se na mašini ili ga ponovo pokreni s --login none."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "%2$@ på %1$@ har intet eget login, og loginvalget er machine. Log ind på maskinen, eller kør det igen med --login none."}},
        "de": {"stringUnit": {"state": "needs_review", "value": "%2$@ auf %1$@ hat keine eigene Anmeldung, und die Anmeldewahl ist machine. Melde dich auf der Maschine an oder führe es erneut mit --login none aus."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "%2$@ en %1$@ no tiene inicio de sesión propio y la elección de inicio de sesión es machine. Inicia sesión en la máquina o vuelve a ejecutarlo con --login none."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "%2$@ sur %1$@ n'a pas de connexion propre, et le choix de connexion est machine. Connectez-vous sur la machine, ou relancez avec --login none."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "%2$@ su %1$@ non ha un accesso proprio e la scelta di accesso è machine. Accedi sulla macchina oppure eseguilo di nuovo con --login none."}},
        "ja": {"stringUnit": {"state": "translated", "value": "%1$@ の %2$@ には独自のログインがなく、ログインの選択は machine です。マシンでサインインするか、--login none を付けて再実行してください。"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "%2$@ នៅលើ %1$@ មិនមានការចូលផ្ទាល់ខ្លួនទេ ហើយជម្រើសការចូលគឺ machine។ ចូលនៅលើម៉ាស៊ីន ឬដំណើរការម្ដងទៀតជាមួយ --login none។"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "%1$@의 %2$@에는 자체 로그인이 없고, 로그인 선택은 machine입니다. 머신에서 로그인하거나 --login none을 붙여 다시 실행하세요."}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "%2$@ på %1$@ har ingen egen pålogging, og påloggingsvalget er machine. Logg på maskinen, eller kjør den på nytt med --login none."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "%2$@ na %1$@ nie ma własnego logowania, a wybór logowania to machine. Zaloguj się na maszynie albo uruchom ponownie z --login none."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "%2$@ em %1$@ não tem login próprio, e a escolha de login é machine. Entre na máquina ou execute de novo com --login none."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "У %2$@ на %1$@ нет собственного входа, а выбор входа — machine. Войдите на машине или запустите снова с --login none."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "%2$@ บน %1$@ ไม่มีการลงชื่อเข้าใช้ของตัวเอง และตัวเลือกการลงชื่อเข้าใช้คือ machine ลงชื่อเข้าใช้บนเครื่อง หรือเรียกอีกครั้งด้วย --login none"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "%1$@ üzerindeki %2$@ için kendi oturumu yok ve oturum seçimi machine. Makinede oturum açın ya da --login none ile yeniden çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "У %2$@ на %1$@ немає власного входу, а вибір входу — machine. Увійдіть на машині або запустіть знову з --login none."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "%2$@ trên %1$@ không có đăng nhập riêng, và lựa chọn đăng nhập là machine. Hãy đăng nhập trên máy, hoặc chạy lại với --login none."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "%1$@ 上的 %2$@ 没有自己的登录，登录选择为 machine。请在机器上登录，或加上 --login none 重新运行。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "%1$@ 上的 %2$@ 沒有自己的登入，登入選擇為 machine。請在機器上登入，或加上 --login none 重新執行。"}}
      }
    },
    "cloud.startSession.consentNeeded": {
      "comment": "A CLI or agent Cloud start in a Release build that waits for the person's one-time consent to copy their Claude login. %1$@ machine, %2$@ agent, %3$@ the command (keep it in backticks). The setting and section names are as the Settings window shows them.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "%2$@ on %1$@ waits for your one-time OK to copy your Claude login to your own Cloud machines, which only you can give. Turn on Use My Claude Login on My Own Cloud Machines in Settings > Machines, then run `%3$@` again."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "ينتظر %2$@ على %1$@ موافقتك لمرة واحدة على نسخ تسجيل دخول Claude إلى أجهزة Cloud التي تملكها، ولا يمنحها غيرك. فعّل «استخدام تسجيل دخول Claude الخاص بي على أجهزة Cloud التي أملكها» في الإعدادات > الأجهزة، ثم شغّل `%3$@` مجددًا."}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "%2$@ na %1$@ čeka tvoju jednokratnu saglasnost da se tvoja Claude prijava kopira na tvoje Cloud mašine; samo je ti možeš dati. Uključi „Koristi moju Claude prijavu na mojim Cloud mašinama“ u Postavke > Računari, pa ponovo pokreni `%3$@`."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "%2$@ på %1$@ venter på dit engangssamtykke til at kopiere dit Claude-login til dine egne Cloud-maskiner; kun du kan give det. Slå „Brug mit Claude-login på mine egne Cloud-maskiner“ til under Indstillinger > Maskiner, og kør så `%3$@` igen."}},
        "de": {"stringUnit": {"state": "needs_review", "value": "%2$@ auf %1$@ wartet auf deine einmalige Zustimmung, deine Claude-Anmeldung auf deine eigenen Cloud-Maschinen zu kopieren; nur du kannst sie geben. Schalte „Meine Claude-Anmeldung auf meinen eigenen Cloud-Maschinen verwenden“ in Einstellungen > Rechner ein und führe dann `%3$@` erneut aus."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "%2$@ en %1$@ espera tu permiso único para copiar tu inicio de sesión de Claude a tus propias máquinas Cloud; solo tú puedes darlo. Activa «Usar mi inicio de sesión de Claude en mis propias máquinas Cloud» en Ajustes > Máquinas y vuelve a ejecutar `%3$@`."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "%2$@ sur %1$@ attend votre accord unique pour copier votre connexion Claude sur vos propres machines Cloud ; vous seul pouvez le donner. Activez « Utiliser ma connexion Claude sur mes propres machines Cloud » dans Réglages > Machines, puis relancez `%3$@`."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "%2$@ su %1$@ attende il tuo consenso una tantum per copiare il tuo accesso a Claude sulle tue macchine Cloud; solo tu puoi darlo. Attiva «Usa il mio accesso a Claude sulle mie macchine Cloud» in Impostazioni > Macchine, poi esegui di nuovo `%3$@`."}},
        "ja": {"stringUnit": {"state": "translated", "value": "%1$@ の %2$@ は、自分の Claude ログインを自分の Cloud マシンにコピーする一度だけの許可を待っています。これは本人だけが与えられます。設定 > マシン で「自分の Claude ログインを自分の Cloud マシンで使う」をオンにしてから、`%3$@` をもう一度実行してください。"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "%2$@ នៅលើ %1$@ កំពុងរង់ចាំការយល់ព្រមម្ដងរបស់អ្នក ដើម្បីចម្លងការចូល Claude ទៅម៉ាស៊ីន Cloud ផ្ទាល់ខ្លួន ដែលមានតែអ្នកទេអាចផ្ដល់បាន។ បើក «ប្រើការចូល Claude របស់ខ្ញុំលើម៉ាស៊ីន Cloud ផ្ទាល់ខ្លួនរបស់ខ្ញុំ» នៅក្នុង ការកំណត់ > ម៉ាស៊ីន រួចដំណើរការ `%3$@` ម្ដងទៀត។"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "%1$@의 %2$@은(는) 내 Claude 로그인을 내 Cloud 머신에 복사하는 1회 동의를 기다립니다. 이 동의는 본인만 할 수 있습니다. 설정 > 머신에서 '내 Claude 로그인을 내 Cloud 머신에서 사용'을(를) 켠 다음 `%3$@`을(를) 다시 실행하세요."}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "%2$@ på %1$@ venter på ditt engangssamtykke til å kopiere Claude-påloggingen din til dine egne Cloud-maskiner; bare du kan gi det. Slå på «Bruk min Claude-pålogging på mine egne Cloud-maskiner» i Innstillinger > Maskiner, og kjør så `%3$@` igjen."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "%2$@ na %1$@ czeka na twoją jednorazową zgodę na skopiowanie logowania do Claude na twoje maszyny Cloud; tylko ty możesz jej udzielić. Włącz „Używaj mojego logowania do Claude na moich maszynach Cloud” w Ustawienia > Maszyny, a potem ponownie uruchom `%3$@`."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "%2$@ em %1$@ aguarda sua permissão única para copiar seu login do Claude para suas próprias máquinas Cloud; só você pode dá-la. Ative “Usar meu login do Claude nas minhas próprias máquinas Cloud” em Ajustes > Máquinas e execute `%3$@` de novo."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "%2$@ на %1$@ ждёт вашего однократного согласия скопировать ваш вход в Claude на ваши облачные машины; дать его можете только вы. Включите «Использовать мой вход в Claude на моих облачных машинах» в Настройки > Компьютеры, затем снова выполните `%3$@`."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "%2$@ บน %1$@ กำลังรอความยินยอมครั้งเดียวของคุณในการคัดลอกการลงชื่อเข้าใช้ Claude ไปยังเครื่อง Cloud ของคุณเอง ซึ่งมีเพียงคุณเท่านั้นที่ให้ได้ เปิด \"ใช้การลงชื่อเข้าใช้ Claude ของฉันบนเครื่อง Cloud ของฉันเอง\" ใน การตั้งค่า > เครื่อง แล้วเรียก `%3$@` อีกครั้ง"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "%1$@ üzerindeki %2$@, Claude oturumunuzu kendi Cloud makinelerinize kopyalamak için tek seferlik onayınızı bekliyor; bunu yalnızca siz verebilirsiniz. Ayarlar > Makineler bölümünde \"Claude oturumumu kendi Cloud makinelerimde kullan\" seçeneğini açın, ardından `%3$@` komutunu yeniden çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "%2$@ на %1$@ чекає на вашу одноразову згоду скопіювати ваш вхід у Claude на ваші хмарні машини; дати її можете лише ви. Увімкніть «Використовувати мій вхід у Claude на моїх хмарних машинах» у Налаштування > Комп’ютери, потім знову виконайте `%3$@`."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "%2$@ trên %1$@ đang chờ bạn đồng ý một lần để sao chép đăng nhập Claude sang các máy Cloud của bạn; chỉ bạn mới có thể đồng ý. Bật \"Dùng đăng nhập Claude của tôi trên các máy Cloud của tôi\" trong Cài đặt > Máy, rồi chạy lại `%3$@`."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "%1$@ 上的 %2$@ 正在等待你一次性同意将你的 Claude 登录复制到你自己的 Cloud 机器，只有你本人可以同意。请在“设置 > 机器”中打开“在我自己的 Cloud 机器上使用我的 Claude 登录”，然后再次运行 `%3$@`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "%1$@ 上的 %2$@ 正在等待你一次性同意將你的 Claude 登入複製到你自己的 Cloud 機器，只有你本人可以同意。請在「設定 > 機器」中開啟「在我自己的 Cloud 機器上使用我的 Claude 登入」，然後再次執行 `%3$@`。"}}
      }
    },
    "cloud.relayChat.promptRequired": {
      "comment": "Refusal: cmux cloud relay-chat was run without a prompt.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Give the chat a prompt with --prompt."}},
        "ja": {"stringUnit": {"state": "translated", "value": "--prompt でチャットにプロンプトを指定してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Gib dem Chat mit --prompt einen Prompt."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Donnez une invite au chat avec --prompt."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Indica un prompt para el chat con --prompt."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "أعطِ الدردشة موجّهًا باستخدام ‎--prompt."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "--prompt로 채팅에 프롬프트를 지정하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "请用 --prompt 为聊天提供提示词。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "請用 --prompt 為聊天提供提示詞。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Dajte chatu upit sa --prompt."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Giv chatten en prompt med --prompt."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Dai un prompt alla chat con --prompt."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ផ្តល់ប្រអប់បញ្ចូលឱ្យការជជែកដោយប្រើ --prompt។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Gi chatten en ledetekst med --prompt."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Podaj polecenie dla czatu za pomocą --prompt."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Dê um prompt ao chat com --prompt."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Укажите запрос для чата через --prompt."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ระบุพรอมต์ให้แชทด้วย --prompt"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Sohbete --prompt ile bir istem verin."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Вкажіть запит для чату через --prompt."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Hãy cung cấp lời nhắc cho cuộc trò chuyện bằng --prompt."}}
      }
    },
    "cloud.relayChat.agentRun": {
      "comment": "Refusal: an agent ran cmux cloud relay-chat; agents start Cloud chats with cloud start-session, which asks the person.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "An agent starts a Cloud chat with `cmux cloud start-session`, which asks the person first."}},
        "ja": {"stringUnit": {"state": "translated", "value": "エージェントは `cmux cloud start-session` で Cloud チャットを開始します。この操作は先に本人に確認します。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Ein Agent startet einen Cloud-Chat mit `cmux cloud start-session`, das zuerst die Person fragt."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Un agent démarre un chat Cloud avec `cmux cloud start-session`, qui demande d'abord à la personne."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Un agente inicia un chat de Cloud con `cmux cloud start-session`, que primero pregunta a la persona."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "يبدأ الوكيل دردشة Cloud باستخدام `cmux cloud start-session`، الذي يسأل الشخص أولًا."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "에이전트는 먼저 사용자에게 묻는 `cmux cloud start-session`으로 Cloud 채팅을 시작합니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "代理使用 `cmux cloud start-session` 启动 Cloud 聊天，它会先询问本人。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "代理使用 `cmux cloud start-session` 啟動 Cloud 聊天，它會先詢問本人。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Agent pokreće Cloud chat sa `cmux cloud start-session`, koji prvo pita osobu."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "En agent starter en Cloud-chat med `cmux cloud start-session`, som spørger personen først."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Un agente avvia una chat Cloud con `cmux cloud start-session`, che prima chiede alla persona."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ភ្នាក់ងារចាប់ផ្តើមការជជែក Cloud ដោយប្រើ `cmux cloud start-session` ដែលសួរមនុស្សជាមុន។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "En agent starter en Cloud-chat med `cmux cloud start-session`, som spør personen først."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Agent rozpoczyna czat Cloud za pomocą `cmux cloud start-session`, które najpierw pyta osobę."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Um agente inicia um chat do Cloud com `cmux cloud start-session`, que pergunta à pessoa primeiro."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Агент начинает чат Cloud через `cmux cloud start-session`, который сначала спрашивает человека."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เอเจนต์เริ่มแชท Cloud ด้วย `cmux cloud start-session` ซึ่งจะถามบุคคลก่อน"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Bir ajan Cloud sohbetini önce kişiye soran `cmux cloud start-session` ile başlatır."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Агент починає чат Cloud через `cmux cloud start-session`, який спершу питає людину."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Tác tử bắt đầu trò chuyện Cloud bằng `cmux cloud start-session`, lệnh này sẽ hỏi người dùng trước."}}
      }
    },
    "cloud.relayChat.replyTitle": {
      "comment": "Title of the sheet that shows a relay chat's reply to the person who ran it.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Cloud Chat Reply"}},
        "ja": {"stringUnit": {"state": "translated", "value": "Cloud チャットの返信"}},
