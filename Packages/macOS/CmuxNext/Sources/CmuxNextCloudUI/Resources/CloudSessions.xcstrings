        "km": {"stringUnit": {"state": "needs_review", "value": "ការឆ្លើយតបជជែក Cloud"}}
      }
    },
    "cloud.relayChat.unavailable": {
      "comment": "Refusal: this sign-in has no relay chat (the legacy Cloud link).",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This Cloud sign-in has no relay chat. Use `cmux cloud start-session` instead."}},
        "ja": {"stringUnit": {"state": "translated", "value": "この Cloud サインインではリレーチャットを使えません。代わりに `cmux cloud start-session` を使ってください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Diese Cloud-Anmeldung hat keinen Relay-Chat. Verwende stattdessen `cmux cloud start-session`."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Cette connexion Cloud n'a pas de chat par relais. Utilisez plutôt `cmux cloud start-session`."}},
