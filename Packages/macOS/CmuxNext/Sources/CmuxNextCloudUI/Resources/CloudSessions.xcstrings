        "vi": {"stringUnit": {"state": "needs_review", "value": "Phản hồi trò chuyện Cloud"}},
        "th": {"stringUnit": {"state": "needs_review", "value": "คำตอบแชต Cloud"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Svar i Cloud-chat"}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Svar i Cloud-chat"}},
