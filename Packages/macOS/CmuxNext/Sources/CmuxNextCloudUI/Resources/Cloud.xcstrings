    "cloud.atCap.title": {"localizations": {
      "ar": {"stringUnit": {"state": "translated","value": "كل أجهزتك السحابية مشغولة"}},
      "bs": {"stringUnit": {"state": "translated","value": "Sve vaše Cloud mašine su zauzete"}},
      "da": {"stringUnit": {"state": "translated","value": "Alle dine Cloud-maskiner er optaget"}},
      "de": {"stringUnit": {"state": "translated","value": "Alle deine Cloud-Maschinen sind belegt"}},
      "en": {"stringUnit": {"state": "translated","value": "All your Cloud machines are busy"}},
      "es": {"stringUnit": {"state": "translated","value": "Todas tus máquinas en la nube están ocupadas"}},
      "fr": {"stringUnit": {"state": "translated","value": "Toutes vos machines Cloud sont occupées"}},
      "it": {"stringUnit": {"state": "translated","value": "Tutte le tue macchine Cloud sono occupate"}},
      "ja": {"stringUnit": {"state": "translated","value": "すべての Cloud マシンが使用中です"}},
      "km": {"stringUnit": {"state": "translated","value": "ម៉ាស៊ីន Cloud របស់អ្នកទាំងអស់កំពុងរវល់"}},
      "ko": {"stringUnit": {"state": "translated","value": "모든 Cloud 머신이 사용 중입니다"}},
      "nb": {"stringUnit": {"state": "translated","value": "Alle Cloud-maskinene dine er opptatt"}},
      "pl": {"stringUnit": {"state": "translated","value": "Wszystkie Twoje maszyny Cloud są zajęte"}},
      "pt-BR": {"stringUnit": {"state": "translated","value": "Todas as suas máquinas na nuvem estão ocupadas"}},
      "ru": {"stringUnit": {"state": "translated","value": "Все ваши облачные машины заняты"}},
      "th": {"stringUnit": {"state": "translated","value": "เครื่อง Cloud ของคุณไม่ว่างทั้งหมด"}},
      "tr": {"stringUnit": {"state": "translated","value": "Tüm Cloud makineleriniz meşgul"}},
      "uk": {"stringUnit": {"state": "translated","value": "Усі ваші хмарні машини зайняті"}},
      "vi": {"stringUnit": {"state": "translated","value": "Tất cả máy Cloud của bạn đang bận"}},
