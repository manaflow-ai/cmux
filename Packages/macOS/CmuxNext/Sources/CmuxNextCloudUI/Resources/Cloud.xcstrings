      "th": {"stringUnit": {"state": "translated","value": "สร้าง %@ หรือไม่"}},
      "tr": {"stringUnit": {"state": "translated","value": "%@ derlensin mi?"}},
      "uk": {"stringUnit": {"state": "translated","value": "Зібрати %@?"}},
      "vi": {"stringUnit": {"state": "translated","value": "Dựng %@?"}},
      "zh-Hans": {"stringUnit": {"state": "translated","value": "构建 %@？"}},
      "zh-Hant": {"stringUnit": {"state": "translated","value": "建置 %@？"}}
    }},
    "cloud.environments.deleteBody": {"localizations": {
      "ar": {"stringUnit": {"state": "translated","value": "يؤدي هذا إلى حذف البيئة ولقطتها. تستمر الأجهزة التي بدأت منها في العمل."}},
      "bs": {"stringUnit": {"state": "translated","value": "Ovo briše okruženje i njegov snimak. Mašine pokrenute iz njega nastavljaju raditi."}},
      "da": {"stringUnit": {"state": "translated","value": "Dette sletter miljøet og dets snapshot. Maskiner, der er startet fra det, kører videre."}},
      "de": {"stringUnit": {"state": "translated","value": "Dies löscht die Umgebung und ihren Snapshot. Daraus gestartete Maschinen laufen weiter."}},
      "en": {"stringUnit": {"state": "translated","value": "This deletes the environment and its snapshot. Machines started from it keep running."}},
      "es": {"stringUnit": {"state": "translated","value": "Esto elimina el entorno y su instantánea. Las máquinas iniciadas desde él siguen funcionando."}},
      "fr": {"stringUnit": {"state": "translated","value": "Cela supprime l'environnement et son instantané. Les machines démarrées depuis lui continuent de tourner."}},
      "it": {"stringUnit": {"state": "translated","value": "Questo elimina l'ambiente e il suo snapshot. Le macchine avviate da esso continuano a funzionare."}},
      "ja": {"stringUnit": {"state": "translated","value": "環境とそのスナップショットを削除します。そこから起動したマシンは動作し続けます。"}},
      "km": {"stringUnit": {"state": "translated","value": "វានឹងលុបបរិស្ថាន និងរូបថតរបស់វា។ ម៉ាស៊ីនដែលបានចាប់ផ្តើមពីវានៅតែដំណើរការ។"}},
      "ko": {"stringUnit": {"state": "translated","value": "환경과 스냅샷을 삭제합니다. 여기서 시작한 머신은 계속 실행됩니다."}},
      "nb": {"stringUnit": {"state": "translated","value": "Dette sletter miljøet og øyeblikksbildet. Maskiner startet fra det fortsetter å kjøre."}},
      "pl": {"stringUnit": {"state": "translated","value": "To usuwa środowisko i jego migawkę. Maszyny uruchomione z niego działają dalej."}},
      "pt-BR": {"stringUnit": {"state": "translated","value": "Isso exclui o ambiente e seu snapshot. As máquinas iniciadas a partir dele continuam em execução."}},
      "ru": {"stringUnit": {"state": "translated","value": "Окружение и его снимок будут удалены. Запущенные из него машины продолжат работать."}},
      "th": {"stringUnit": {"state": "translated","value": "การดำเนินการนี้จะลบสภาพแวดล้อมและสแนปช็อต เครื่องที่เริ่มจากสภาพแวดล้อมนี้จะยังทำงานต่อ"}},
      "tr": {"stringUnit": {"state": "translated","value": "Bu, ortamı ve anlık görüntüsünü siler. Ondan başlatılan makineler çalışmaya devam eder."}},
      "uk": {"stringUnit": {"state": "translated","value": "Це видалить середовище та його знімок. Машини, запущені з нього, продовжать працювати."}},
      "vi": {"stringUnit": {"state": "translated","value": "Thao tác này xóa môi trường và ảnh chụp của nó. Các máy đã khởi động từ đó vẫn tiếp tục chạy."}},
      "zh-Hans": {"stringUnit": {"state": "translated","value": "这会删除该环境及其快照。从中启动的机器会继续运行。"}},
      "zh-Hant": {"stringUnit": {"state": "translated","value": "這會刪除該環境及其快照。從中啟動的機器會繼續執行。"}}
    }},
