          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne chat blev flyttet til Cloud, men dens fane der blev ikke åbnet. Prøv igen for at åbne den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Chat wurde in die Cloud verschoben, aber sein Tab dort wurde nicht geöffnet. Versuche es erneut, um ihn zu öffnen."
