          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộc trò chuyện đã được chuyển lên %1$@, nhưng tab của nó không mở: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话已移至 %1$@，但其标签页未打开：%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對話已移至 %1$@，但其分頁未開啟：%2$@"
          }
        }
      }
    },
    "cloud.move.teamMachine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is a team machine. Chats move only to a machine you own."
          }
