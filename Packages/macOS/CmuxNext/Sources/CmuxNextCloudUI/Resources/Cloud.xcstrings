    "automations.problem.cloud": {"localizations": {
      "ar": {"stringUnit": {"state": "translated","value": "تعذّر الوصول إلى cmux Cloud؛ لا تظهر أتمتة السحابة."}},
      "bs": {"stringUnit": {"state": "translated","value": "Nije moguće doći do cmux Clouda; Cloud automatizacije se ne prikazuju."}},
      "da": {"stringUnit": {"state": "translated","value": "Kunne ikke nå cmux Cloud; Cloud-automatiseringer vises ikke."}},
      "de": {"stringUnit": {"state": "translated","value": "cmux Cloud ist nicht erreichbar; Cloud-Automatisierungen werden nicht angezeigt."}},
      "en": {"stringUnit": {"state": "translated","value": "Could not reach cmux Cloud; Cloud automations are not shown."}},
      "es": {"stringUnit": {"state": "translated","value": "No se pudo conectar con cmux Cloud; no se muestran las automatizaciones en la nube."}},
      "fr": {"stringUnit": {"state": "translated","value": "Impossible de joindre cmux Cloud ; les automatisations Cloud ne sont pas affichées."}},
      "it": {"stringUnit": {"state": "translated","value": "Impossibile raggiungere cmux Cloud; le automazioni Cloud non vengono mostrate."}},
      "ja": {"stringUnit": {"state": "translated","value": "cmux Cloud に接続できないため、Cloud の自動化は表示されません。"}},
      "km": {"stringUnit": {"state": "translated","value": "មិនអាចភ្ជាប់ cmux Cloud បានទេ ស្វ័យប្រវត្តិកម្ម Cloud មិនត្រូវបានបង្ហាញ។"}},
      "ko": {"stringUnit": {"state": "translated","value": "cmux Cloud에 연결할 수 없어 Cloud 자동화가 표시되지 않습니다."}},
      "nb": {"stringUnit": {"state": "translated","value": "Får ikke kontakt med cmux Cloud; Cloud-automatiseringer vises ikke."}},
      "pl": {"stringUnit": {"state": "translated","value": "Nie można połączyć się z cmux Cloud; automatyzacje w chmurze nie są widoczne."}},
      "pt-BR": {"stringUnit": {"state": "translated","value": "Não foi possível acessar o cmux Cloud; as automações na nuvem não aparecem."}},
      "ru": {"stringUnit": {"state": "translated","value": "Не удалось связаться с cmux Cloud; облачные автоматизации не показаны."}},
      "th": {"stringUnit": {"state": "translated","value": "ติดต่อ cmux Cloud ไม่ได้ จึงไม่แสดงระบบอัตโนมัติบนคลาวด์"}},
      "tr": {"stringUnit": {"state": "translated","value": "cmux Cloud'a ulaşılamadı; Cloud otomasyonları gösterilmiyor."}},
      "uk": {"stringUnit": {"state": "translated","value": "Не вдалося зв'язатися з cmux Cloud; хмарні автоматизації не показано."}},
      "vi": {"stringUnit": {"state": "translated","value": "Không kết nối được cmux Cloud; không hiển thị tự động hóa trên đám mây."}},
      "zh-Hans": {"stringUnit": {"state": "translated","value": "无法连接 cmux Cloud，云端自动化未显示。"}},
      "zh-Hant": {"stringUnit": {"state": "translated","value": "無法連線 cmux Cloud，雲端自動化未顯示。"}}
    }},
    "automations.problem.cloudOff": {"localizations": {
      "ar": {"stringUnit": {"state": "translated","value": "أوقف المسؤول cmux Cloud، لذلك لا تظهر أتمتة السحابة."}},
      "bs": {"stringUnit": {"state": "translated","value": "Administrator je isključio cmux Cloud, pa se Cloud automatizacije ne prikazuju."}},
      "da": {"stringUnit": {"state": "translated","value": "Din administrator har slået cmux Cloud fra, så Cloud-automatiseringer vises ikke."}},
      "de": {"stringUnit": {"state": "translated","value": "Dein Administrator hat cmux Cloud deaktiviert, daher werden Cloud-Automatisierungen nicht angezeigt."}},
      "en": {"stringUnit": {"state": "translated","value": "Your administrator turned off cmux Cloud, so Cloud automations are not shown."}},
      "es": {"stringUnit": {"state": "translated","value": "Tu administrador desactivó cmux Cloud, así que no se muestran las automatizaciones en la nube."}},
      "fr": {"stringUnit": {"state": "translated","value": "Votre administrateur a désactivé cmux Cloud ; les automatisations Cloud ne sont pas affichées."}},
      "it": {"stringUnit": {"state": "translated","value": "L'amministratore ha disattivato cmux Cloud, quindi le automazioni Cloud non vengono mostrate."}},
      "ja": {"stringUnit": {"state": "translated","value": "管理者が cmux Cloud をオフにしているため、Cloud の自動化は表示されません。"}},
      "km": {"stringUnit": {"state": "translated","value": "អ្នកគ្រប់គ្រងបានបិទ cmux Cloud ដូច្នេះស្វ័យប្រវត្តិកម្ម Cloud មិនត្រូវបានបង្ហាញទេ។"}},
      "ko": {"stringUnit": {"state": "translated","value": "관리자가 cmux Cloud를 꺼서 Cloud 자동화가 표시되지 않습니다."}},
      "nb": {"stringUnit": {"state": "translated","value": "Administratoren har slått av cmux Cloud, så Cloud-automatiseringer vises ikke."}},
      "pl": {"stringUnit": {"state": "translated","value": "Administrator wyłączył cmux Cloud, więc automatyzacje w chmurze nie są widoczne."}},
      "pt-BR": {"stringUnit": {"state": "translated","value": "Seu administrador desativou o cmux Cloud, então as automações na nuvem não aparecem."}},
      "ru": {"stringUnit": {"state": "translated","value": "Администратор отключил cmux Cloud, поэтому облачные автоматизации не показаны."}},
      "th": {"stringUnit": {"state": "translated","value": "ผู้ดูแลระบบปิด cmux Cloud ไว้ จึงไม่แสดงระบบอัตโนมัติบนคลาวด์"}},
      "tr": {"stringUnit": {"state": "translated","value": "Yöneticiniz cmux Cloud'u kapattı; Cloud otomasyonları gösterilmiyor."}},
      "uk": {"stringUnit": {"state": "translated","value": "Адміністратор вимкнув cmux Cloud, тому хмарні автоматизації не показано."}},
      "vi": {"stringUnit": {"state": "translated","value": "Quản trị viên đã tắt cmux Cloud nên không hiển thị tự động hóa trên đám mây."}},
      "zh-Hans": {"stringUnit": {"state": "translated","value": "管理员已关闭 cmux Cloud，因此不显示云端自动化。"}},
      "zh-Hant": {"stringUnit": {"state": "translated","value": "管理員已關閉 cmux Cloud，因此不顯示雲端自動化。"}}
    }},
    "automations.problem.signedOut": {"localizations": {
      "ar": {"stringUnit": {"state": "translated","value": "سجّل الدخول إلى cmux لرؤية أتمتة السحابة."}},
      "bs": {"stringUnit": {"state": "translated","value": "Prijavite se u cmux da vidite svoje Cloud automatizacije."}},
      "da": {"stringUnit": {"state": "translated","value": "Log ind på cmux for at se dine Cloud-automatiseringer."}},
      "de": {"stringUnit": {"state": "translated","value": "Melde dich bei cmux an, um deine Cloud-Automatisierungen zu sehen."}},
      "en": {"stringUnit": {"state": "translated","value": "Sign in to cmux to see your Cloud automations."}},
      "es": {"stringUnit": {"state": "translated","value": "Inicia sesión en cmux para ver tus automatizaciones en la nube."}},
      "fr": {"stringUnit": {"state": "translated","value": "Connectez-vous à cmux pour voir vos automatisations Cloud."}},
      "it": {"stringUnit": {"state": "translated","value": "Accedi a cmux per vedere le tue automazioni Cloud."}},
      "ja": {"stringUnit": {"state": "translated","value": "Cloud の自動化を表示するには cmux にサインインしてください。"}},
      "km": {"stringUnit": {"state": "translated","value": "ចូលគណនី cmux ដើម្បីមើលស្វ័យប្រវត្តិកម្ម Cloud របស់អ្នក។"}},
      "ko": {"stringUnit": {"state": "translated","value": "Cloud 자동화를 보려면 cmux에 로그인하세요."}},
      "nb": {"stringUnit": {"state": "translated","value": "Logg på cmux for å se Cloud-automatiseringene dine."}},
      "pl": {"stringUnit": {"state": "translated","value": "Zaloguj się do cmux, aby zobaczyć automatyzacje w chmurze."}},
      "pt-BR": {"stringUnit": {"state": "translated","value": "Entre no cmux para ver suas automações na nuvem."}},
      "ru": {"stringUnit": {"state": "translated","value": "Войдите в cmux, чтобы увидеть облачные автоматизации."}},
      "th": {"stringUnit": {"state": "translated","value": "ลงชื่อเข้าใช้ cmux เพื่อดูระบบอัตโนมัติบนคลาวด์ของคุณ"}},
      "tr": {"stringUnit": {"state": "translated","value": "Cloud otomasyonlarınızı görmek için cmux'a giriş yapın."}},
      "uk": {"stringUnit": {"state": "translated","value": "Увійдіть у cmux, щоб побачити хмарні автоматизації."}},
      "vi": {"stringUnit": {"state": "translated","value": "Đăng nhập cmux để xem các tự động hóa trên đám mây."}},
      "zh-Hans": {"stringUnit": {"state": "translated","value": "登录 cmux 以查看你的云端自动化。"}},
      "zh-Hant": {"stringUnit": {"state": "translated","value": "登入 cmux 以查看你的雲端自動化。"}}
    }},
    "automations.problem.thisMac": {"localizations": {
      "ar": {"stringUnit": {"state": "translated","value": "تعذّرت قراءة أتمتة هذا الـ Mac (فشل cmux automation list)."}},
      "bs": {"stringUnit": {"state": "translated","value": "Nije moguće pročitati automatizacije ovog Maca (cmux automation list nije uspio)."}},
      "da": {"stringUnit": {"state": "translated","value": "Kunne ikke læse denne Macs automatiseringer (cmux automation list mislykkedes)."}},
      "de": {"stringUnit": {"state": "translated","value": "Die Automatisierungen dieses Macs konnten nicht gelesen werden (cmux automation list ist fehlgeschlagen)."}},
      "en": {"stringUnit": {"state": "translated","value": "Could not read this Mac's automations (cmux automation list failed)."}},
      "es": {"stringUnit": {"state": "translated","value": "No se pudieron leer las automatizaciones de este Mac (falló cmux automation list)."}},
      "fr": {"stringUnit": {"state": "translated","value": "Impossible de lire les automatisations de ce Mac (échec de cmux automation list)."}},
      "it": {"stringUnit": {"state": "translated","value": "Impossibile leggere le automazioni di questo Mac (cmux automation list non riuscito)."}},
      "ja": {"stringUnit": {"state": "translated","value": "この Mac の自動化を読み込めませんでした (cmux automation list が失敗しました)。"}},
      "km": {"stringUnit": {"state": "translated","value": "មិនអាចអានស្វ័យប្រវត្តិកម្មរបស់ Mac នេះបានទេ (cmux automation list បរាជ័យ)។"}},
      "ko": {"stringUnit": {"state": "translated","value": "이 Mac의 자동화를 읽을 수 없습니다(cmux automation list 실패)."}},
      "nb": {"stringUnit": {"state": "translated","value": "Kunne ikke lese automatiseringene på denne Macen (cmux automation list mislyktes)."}},
      "pl": {"stringUnit": {"state": "translated","value": "Nie można odczytać automatyzacji tego Maca (cmux automation list nie powiodło się)."}},
      "pt-BR": {"stringUnit": {"state": "translated","value": "Não foi possível ler as automações deste Mac (cmux automation list falhou)."}},
      "ru": {"stringUnit": {"state": "translated","value": "Не удалось прочитать автоматизации этого Mac (ошибка cmux automation list)."}},
      "th": {"stringUnit": {"state": "translated","value": "อ่านระบบอัตโนมัติของ Mac เครื่องนี้ไม่ได้ (cmux automation list ล้มเหลว)"}},
      "tr": {"stringUnit": {"state": "translated","value": "Bu Mac'in otomasyonları okunamadı (cmux automation list başarısız oldu)."}},
      "uk": {"stringUnit": {"state": "translated","value": "Не вдалося прочитати автоматизації цього Mac (помилка cmux automation list)."}},
      "vi": {"stringUnit": {"state": "translated","value": "Không đọc được tự động hóa của máy Mac này (cmux automation list thất bại)."}},
      "zh-Hans": {"stringUnit": {"state": "translated","value": "无法读取此 Mac 的自动化（cmux automation list 失败）。"}},
      "zh-Hant": {"stringUnit": {"state": "translated","value": "無法讀取此 Mac 的自動化（cmux automation list 失敗）。"}}
    }},
