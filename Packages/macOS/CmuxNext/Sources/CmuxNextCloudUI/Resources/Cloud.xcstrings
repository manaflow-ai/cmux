    "cloud.workspaceSetup.repositoryCredentials": {"localizations": {
      "ar": {"stringUnit": {"state": "translated","value": "أزل اسم المستخدم أو كلمة المرور من عنوان URL للمستودع. لا يحفظ cmux بيانات اعتماد عنوان URL على الآلة الافتراضية مطلقًا."}},
      "bs": {"stringUnit": {"state": "translated","value": "Uklonite korisničko ime ili lozinku iz URL-a repozitorija. cmux nikada ne čuva vjerodajnice URL-a na virtuelnoj mašini."}},
      "da": {"stringUnit": {"state": "translated","value": "Fjern brugernavnet eller adgangskoden fra repository-URL'en. cmux gemmer aldrig URL-legitimationsoplysninger på VM'en."}},
      "de": {"stringUnit": {"state": "translated","value": "Entferne den Benutzernamen oder das Passwort aus der Repository-URL. cmux speichert keine URL-Anmeldedaten auf der VM."}},
      "en": {"stringUnit": {"state": "translated","value": "Remove the username or password from the repository URL. cmux never saves URL credentials on the VM."}},
      "es": {"stringUnit": {"state": "translated","value": "Elimina el nombre de usuario o la contraseña de la URL del repositorio. cmux nunca guarda credenciales de URL en la VM."}},
      "fr": {"stringUnit": {"state": "translated","value": "Supprimez le nom d’utilisateur ou le mot de passe de l’URL du dépôt. cmux n’enregistre jamais les identifiants d’URL sur la VM."}},
      "it": {"stringUnit": {"state": "translated","value": "Rimuovi il nome utente o la password dall’URL del repository. cmux non salva mai le credenziali URL sulla VM."}},
      "ja": {"stringUnit": {"state": "translated","value": "リポジトリの URL からユーザー名またはパスワードを削除してください。cmux が URL 内の認証情報を VM に保存することはありません。"}},
      "km": {"stringUnit": {"state": "translated","value": "លុបឈ្មោះអ្នកប្រើ ឬពាក្យសម្ងាត់ចេញពី URL របស់ឃ្លាំងកូដ។ cmux មិនដែលរក្សាទុកព័ត៌មានសម្គាល់អត្តសញ្ញាណក្នុង URL នៅលើ VM ទេ។"}},
      "ko": {"stringUnit": {"state": "translated","value": "저장소 URL에서 사용자 이름 또는 비밀번호를 제거하세요. cmux는 URL의 인증 정보를 VM에 저장하지 않습니다."}},
      "nb": {"stringUnit": {"state": "translated","value": "Fjern brukernavnet eller passordet fra URL-en til repositoriet. cmux lagrer aldri URL-legitimasjon på VM-en."}},
      "pl": {"stringUnit": {"state": "translated","value": "Usuń nazwę użytkownika lub hasło z adresu URL repozytorium. cmux nigdy nie zapisuje danych logowania z adresu URL na maszynie wirtualnej."}},
      "pt-BR": {"stringUnit": {"state": "translated","value": "Remova o nome de usuário ou a senha da URL do repositório. O cmux nunca salva credenciais de URL na VM."}},
      "ru": {"stringUnit": {"state": "translated","value": "Удалите имя пользователя или пароль из URL репозитория. cmux никогда не сохраняет учётные данные из URL на виртуальной машине."}},
      "th": {"stringUnit": {"state": "translated","value": "นำชื่อผู้ใช้หรือรหัสผ่านออกจาก URL ของที่เก็บโค้ด cmux จะไม่บันทึกข้อมูลรับรองจาก URL ไว้บน VM"}},
      "tr": {"stringUnit": {"state": "translated","value": "Depo URL'sinden kullanıcı adını veya parolayı kaldırın. cmux, URL kimlik bilgilerini VM'de asla kaydetmez."}},
      "uk": {"stringUnit": {"state": "translated","value": "Видаліть ім’я користувача або пароль з URL репозиторію. cmux ніколи не зберігає облікові дані URL на віртуальній машині."}},
      "vi": {"stringUnit": {"state": "translated","value": "Xóa tên người dùng hoặc mật khẩu khỏi URL kho mã. cmux không bao giờ lưu thông tin xác thực trong URL trên máy ảo."}},
      "zh-Hans": {"stringUnit": {"state": "translated","value": "请从仓库 URL 中移除用户名或密码。cmux 绝不会将 URL 中的凭据保存到虚拟机上。"}},
      "zh-Hant": {"stringUnit": {"state": "translated","value": "請從儲存庫 URL 中移除使用者名稱或密碼。cmux 絕不會將 URL 中的憑證儲存到虛擬機器上。"}}
    }},
    "cloud.workspaceSetup.repositoryInvalid": {"localizations": {
      "ar": {"stringUnit": {"state": "translated","value": "أدخل مستودع GitHub بصيغة owner/name أو عنوان URL لـ GitHub."}},
