    "cloud.codexDevice.scope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only short-lived access moves to the VM; the refresh token stays on this Mac. Keep cmux running on this Mac to renew Codex access."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُنقل إلى الآلة الافتراضية إذن وصول قصير الأجل فقط؛ ويبقى رمز التجديد على جهاز Mac هذا. أبقِ cmux قيد التشغيل على جهاز Mac هذا لتجديد الوصول إلى Codex."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der kurzlebige Zugang wird auf die VM übertragen; das Aktualisierungstoken bleibt auf diesem Mac. Lass cmux auf diesem Mac laufen, um den Codex-Zugang zu erneuern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se transfiere a la máquina virtual el acceso de corta duración; el token de renovación permanece en este Mac. Mantén cmux en ejecución en este Mac para renovar el acceso a Codex."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul un accès de courte durée est transféré à la machine virtuelle ; le jeton de renouvellement reste sur ce Mac. Laissez cmux en cours d’exécution sur ce Mac pour renouveler l’accès à Codex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VMには短期間のアクセス権限のみが転送され、更新トークンはこのMacに残ります。Codexのアクセス権限を更新するには、このMacでcmuxを実行したままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단기 액세스 권한만 VM으로 전송되며 갱신 토큰은 이 Mac에 남습니다. Codex 액세스 권한을 갱신하려면 이 Mac에서 cmux를 계속 실행해 두세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有短期访问权限会传送至虚拟机；刷新令牌会保留在这台 Mac 上。请保持 cmux 在这台 Mac 上运行，以续期 Codex 访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有短期存取權限會傳送至虛擬機器；更新權杖會留在這部 Mac 上。請保持 cmux 在這部 Mac 上執行，以更新 Codex 存取權限。"
          }
        }
      }
    },
