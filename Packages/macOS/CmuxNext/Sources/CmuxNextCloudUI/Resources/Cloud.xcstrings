      "en": {"stringUnit": {"state": "translated","value": "Create workspace"}},
      "es": {"stringUnit": {"state": "translated","value": "Crear espacio de trabajo"}},
      "fr": {"stringUnit": {"state": "translated","value": "Créer l’espace de travail"}},
      "it": {"stringUnit": {"state": "translated","value": "Crea spazio di lavoro"}},
      "ja": {"stringUnit": {"state": "translated","value": "ワークスペースを作成"}},
