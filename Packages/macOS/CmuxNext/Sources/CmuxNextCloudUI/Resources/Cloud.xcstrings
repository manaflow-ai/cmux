    "cloud.move.notConnected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn't connect. Retry once it's online."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتصل %@. أعد المحاولة عندما يصبح متصلًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se nije povezala. Pokušaj ponovo kad bude na mreži."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ oprettede ikke forbindelse. Prøv igen, når den er online."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat sich nicht verbunden. Versuche es erneut, sobald der Rechner online ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no se conectó. Vuelve a intentarlo cuando esté en línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne s’est pas connectée. Réessayez dès qu’elle est en ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non si è connessa. Riprova quando è online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に接続できませんでした。オンラインになったら再試行してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ មិនបានតភ្ជាប់ទេ។ ព្យាយាមម្តងទៀតពេលវានៅលើបណ្តាញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 연결되지 않았습니다. 온라인 상태가 되면 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ koblet ikke til. Prøv igjen når den er på nett."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie połączyła się. Ponów, gdy będzie online."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não se conectou. Tente novamente quando estiver on-line."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не подключилась. Повторите, когда она будет в сети."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ไม่ได้เชื่อมต่อ ลองอีกครั้งเมื่อออนไลน์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bağlanmadı. Çevrimiçi olduğunda yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не під'єдналася. Повторіть, коли вона буде в мережі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không kết nối được. Hãy thử lại khi máy trực tuyến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未连接。上线后请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未連線。上線後請重試。"
          }
        }
