          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le déplacement n’est pas terminé, la discussion est donc en pause. Réessayez pour le terminer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spostamento non è terminato, quindi la chat è in pausa. Riprova per completarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動が完了しなかったため、チャットは一時停止しています。再試行して完了してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការផ្លាស់ទីមិនទាន់បញ្ចប់ ដូច្នេះការជជែកត្រូវបានផ្អាក។ ព្យាយាមម្តងទៀតដើម្បីបញ្ចប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이동이 끝나지 않아 채팅이 일시 중지되었습니다. 다시 시도하여 완료하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyttingen ble ikke fullført, så chatten er satt på pause. Prøv igjen for å fullføre den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenoszenie się nie zakończyło, więc czat jest wstrzymany. Ponów, aby je dokończyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência não terminou, então o chat está pausado. Tente novamente para concluí-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенос не завершился, поэтому чат приостановлен. Повторите, чтобы завершить его."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การย้ายยังไม่เสร็จ แชทจึงถูกหยุดชั่วคราว ลองอีกครั้งเพื่อให้เสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşıma bitmedi, bu yüzden sohbet duraklatıldı. Tamamlamak için yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенесення не завершилося, тому чат призупинено. Повторіть, щоб завершити його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc chuyển chưa hoàn tất nên cuộc trò chuyện đang tạm dừng. Hãy thử lại để hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动尚未完成，因此对话已暂停。请重试以完成移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移動尚未完成，因此對話已暫停。請重試以完成移動。"
          }
        }
      }
    },
    "cloud.move.relativePath": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to Cloud needs a full folder path, not %@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج النقل إلى Cloud إلى مسار مجلد كامل، وليس %@."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Premještanje u Cloud traži punu putanju mape, a ne %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyt til Cloud kræver en fuld mappesti, ikke %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In die Cloud verschieben braucht einen vollständigen Ordnerpfad, nicht %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover a Cloud necesita la ruta completa de una carpeta, no %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer vers le Cloud a besoin d’un chemin de dossier complet, pas de %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta su Cloud richiede il percorso completo di una cartella, non %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud に移動するには、%@ ではなくフォルダのフルパスが必要です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការផ្លាស់ទីទៅ Cloud ត្រូវការផ្លូវថតពេញលេញ មិនមែន %@ ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud로 이동하려면 %@이(가) 아닌 전체 폴더 경로가 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytt til Cloud trenger en fullstendig mappebane, ikke %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeniesienie do Cloud wymaga pełnej ścieżki folderu, a nie %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover para o Cloud precisa do caminho completo de uma pasta, não %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для переноса в Cloud нужен полный путь к папке, а не %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การย้ายไปยัง Cloud ต้องใช้พาธโฟลเดอร์แบบเต็ม ไม่ใช่ %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud'a taşımak için %@ değil, tam klasör yolu gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для перенесення в Cloud потрібен повний шлях до теки, а не %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển lên Cloud cần đường dẫn thư mục đầy đủ, không phải %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移至 Cloud 需要完整的文件夹路径，而不是 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移至 Cloud 需要完整的資料夾路徑，而不是 %@。"
          }
        }
      }
    },
    "cloud.move.unfinishedMove": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving this chat to Cloud didn't finish. Retry to finish it, or dismiss to keep it here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكتمل نقل هذه المحادثة إلى Cloud. أعد المحاولة لإكماله، أو تجاهل لإبقائها هنا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Premještanje ovog razgovora u Cloud nije završeno. Pokušaj ponovo da ga završiš ili odbaci da ga zadržiš ovdje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytningen af denne chat til Cloud blev ikke fuldført. Prøv igen for at fuldføre den, eller afvis for at beholde den her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Verschieben dieses Chats in die Cloud wurde nicht abgeschlossen. Versuche es erneut, um es abzuschließen, oder verwirf es, um den Chat hier zu behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se terminó de mover este chat a Cloud. Vuelve a intentarlo para terminar, o descártalo para mantenerlo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le déplacement de cette conversation vers Cloud n'est pas terminé. Réessayez pour le terminer, ou ignorez pour la garder ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spostamento di questa chat in Cloud non è stato completato. Riprova per completarlo oppure ignora per tenerla qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットの Cloud への移動は完了しませんでした。再試行して完了するか、閉じてここに残してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការផ្លាស់ទីការជជែកនេះទៅ Cloud មិនបានបញ្ចប់ទេ។ ព្យាយាមម្ដងទៀតដើម្បីបញ្ចប់ ឬបោះបង់ដើម្បីទុកវានៅទីនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 채팅을 Cloud로 옮기는 작업이 완료되지 않았습니다. 다시 시도하여 완료하거나, 닫아서 여기에 유지하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyttingen av denne chatten til Cloud ble ikke fullført. Prøv på nytt for å fullføre, eller avvis for å beholde den her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenoszenie tego czatu do Cloud nie zostało ukończone. Spróbuj ponownie, aby je dokończyć, lub odrzuć, aby zostawić czat tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência deste chat para o Cloud não terminou. Tente novamente para concluí-la ou descarte para mantê-lo aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенос этого чата в Cloud не завершён. Повторите, чтобы завершить, или отклоните, чтобы оставить чат здесь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การย้ายแชทนี้ไปยัง Cloud ยังไม่เสร็จ ลองอีกครั้งเพื่อให้เสร็จ หรือปิดเพื่อเก็บไว้ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sohbetin Cloud'a taşınması tamamlanmadı. Tamamlamak için yeniden deneyin veya burada tutmak için kapatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенесення цього чату в Cloud не завершено. Повторіть, щоб завершити, або відхиліть, щоб залишити чат тут."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc chuyển cuộc trò chuyện này lên Cloud chưa hoàn tất. Thử lại để hoàn tất, hoặc bỏ qua để giữ nó ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此对话移至 Cloud 的操作未完成。请重试以完成，或关闭以将其保留在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此對話移至 Cloud 的操作未完成。請重試以完成，或關閉以將其保留在這裡。"
          }
        }
      }
    },
    "cloud.move.unfinishedShow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This chat moved to Cloud, but its tab there didn't open. Retry to open it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نُقلت هذه المحادثة إلى Cloud، لكن علامة تبويبها هناك لم تُفتح. أعد المحاولة لفتحها."
