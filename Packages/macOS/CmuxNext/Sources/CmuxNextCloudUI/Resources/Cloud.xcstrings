    "cloud.environments.unavailable": {"localizations": {
      "ar": {"stringUnit": {"state": "translated","value": "تتطلب بيئات السحابة اتصال cmux-next السحابي. أنشئ الجهاز دون بيئة، أو بدّل اتصال السحابة إلى cmux-next."}},
      "bs": {"stringUnit": {"state": "translated","value": "Cloud okruženja zahtijevaju cmux-next Cloud vezu. Kreirajte mašinu bez okruženja ili prebacite Cloud vezu na cmux-next."}},
      "da": {"stringUnit": {"state": "translated","value": "Cloud-miljøer kræver cmux-next Cloud-forbindelsen. Opret maskinen uden et miljø, eller skift Cloud-forbindelsen til cmux-next."}},
      "de": {"stringUnit": {"state": "translated","value": "Cloud-Umgebungen brauchen die cmux-next-Cloud-Verbindung. Erstelle die Maschine ohne Umgebung oder stelle die Cloud-Verbindung auf cmux-next um."}},
      "en": {"stringUnit": {"state": "translated","value": "Cloud environments need the cmux-next Cloud connection. Create the machine without an environment, or switch the Cloud connection to cmux-next."}},
      "es": {"stringUnit": {"state": "translated","value": "Los entornos de Cloud necesitan la conexión de Cloud de cmux-next. Crea la máquina sin entorno o cambia la conexión de Cloud a cmux-next."}},
      "fr": {"stringUnit": {"state": "translated","value": "Les environnements Cloud nécessitent la connexion Cloud cmux-next. Créez la machine sans environnement, ou passez la connexion Cloud à cmux-next."}},
      "it": {"stringUnit": {"state": "translated","value": "Gli ambienti Cloud richiedono la connessione Cloud cmux-next. Crea la macchina senza ambiente oppure passa la connessione Cloud a cmux-next."}},
      "ja": {"stringUnit": {"state": "translated","value": "Cloud 環境には cmux-next の Cloud 接続が必要です。環境なしでマシンを作成するか、Cloud 接続を cmux-next に切り替えてください。"}},
      "km": {"stringUnit": {"state": "translated","value": "បរិស្ថាន Cloud ត្រូវការការតភ្ជាប់ Cloud របស់ cmux-next។ បង្កើតម៉ាស៊ីនដោយគ្មានបរិស្ថាន ឬប្តូរការតភ្ជាប់ Cloud ទៅ cmux-next។"}},
      "ko": {"stringUnit": {"state": "translated","value": "Cloud 환경에는 cmux-next Cloud 연결이 필요합니다. 환경 없이 머신을 만들거나 Cloud 연결을 cmux-next로 전환하세요."}},
      "nb": {"stringUnit": {"state": "translated","value": "Cloud-miljøer krever cmux-next Cloud-tilkoblingen. Opprett maskinen uten et miljø, eller bytt Cloud-tilkoblingen til cmux-next."}},
      "pl": {"stringUnit": {"state": "translated","value": "Środowiska Cloud wymagają połączenia Cloud cmux-next. Utwórz maszynę bez środowiska albo przełącz połączenie Cloud na cmux-next."}},
      "pt-BR": {"stringUnit": {"state": "translated","value": "Os ambientes do Cloud precisam da conexão do Cloud do cmux-next. Crie a máquina sem um ambiente ou mude a conexão do Cloud para o cmux-next."}},
      "ru": {"stringUnit": {"state": "translated","value": "Для окружений Cloud нужно подключение Cloud cmux-next. Создайте машину без окружения или переключите подключение Cloud на cmux-next."}},
      "th": {"stringUnit": {"state": "translated","value": "สภาพแวดล้อม Cloud ต้องใช้การเชื่อมต่อ Cloud ของ cmux-next สร้างเครื่องโดยไม่มีสภาพแวดล้อม หรือเปลี่ยนการเชื่อมต่อ Cloud เป็น cmux-next"}},
      "tr": {"stringUnit": {"state": "translated","value": "Cloud ortamları cmux-next Cloud bağlantısını gerektirir. Makineyi ortam olmadan oluşturun veya Cloud bağlantısını cmux-next'e geçirin."}},
      "uk": {"stringUnit": {"state": "translated","value": "Для середовищ Cloud потрібне з'єднання Cloud cmux-next. Створіть машину без середовища або перемкніть з'єднання Cloud на cmux-next."}},
      "vi": {"stringUnit": {"state": "translated","value": "Môi trường Cloud cần kết nối Cloud của cmux-next. Hãy tạo máy không có môi trường, hoặc chuyển kết nối Cloud sang cmux-next."}},
      "zh-Hans": {"stringUnit": {"state": "translated","value": "Cloud 环境需要 cmux-next 的 Cloud 连接。请在不使用环境的情况下创建机器，或将 Cloud 连接切换到 cmux-next。"}},
      "zh-Hant": {"stringUnit": {"state": "translated","value": "Cloud 環境需要 cmux-next 的 Cloud 連線。請在不使用環境的情況下建立機器，或將 Cloud 連線切換到 cmux-next。"}}
    }},
    "cloud.environments.unknown": {"localizations": {
      "ar": {"stringUnit": {"state": "translated","value": "لم تعد هذه البيئة موجودة. حدّث القائمة."}},
      "bs": {"stringUnit": {"state": "translated","value": "To okruženje više ne postoji. Osvježite listu."}},
      "da": {"stringUnit": {"state": "translated","value": "Det miljø findes ikke længere. Opdater listen."}},
      "de": {"stringUnit": {"state": "translated","value": "Diese Umgebung gibt es nicht mehr. Aktualisiere die Liste."}},
      "en": {"stringUnit": {"state": "translated","value": "That environment no longer exists. Refresh the list."}},
      "es": {"stringUnit": {"state": "translated","value": "Ese entorno ya no existe. Actualiza la lista."}},
      "fr": {"stringUnit": {"state": "translated","value": "Cet environnement n'existe plus. Actualisez la liste."}},
      "it": {"stringUnit": {"state": "translated","value": "Quell'ambiente non esiste più. Aggiorna l'elenco."}},
      "ja": {"stringUnit": {"state": "translated","value": "その環境はもう存在しません。一覧を更新してください。"}},
      "km": {"stringUnit": {"state": "translated","value": "បរិស្ថាននោះលែងមានទៀតហើយ។ ផ្ទុកបញ្ជីឡើងវិញ។"}},
      "ko": {"stringUnit": {"state": "translated","value": "해당 환경이 더 이상 없습니다. 목록을 새로 고치세요."}},
      "nb": {"stringUnit": {"state": "translated","value": "Det miljøet finnes ikke lenger. Oppdater listen."}},
      "pl": {"stringUnit": {"state": "translated","value": "To środowisko już nie istnieje. Odśwież listę."}},
      "pt-BR": {"stringUnit": {"state": "translated","value": "Esse ambiente não existe mais. Atualize a lista."}},
      "ru": {"stringUnit": {"state": "translated","value": "Этого окружения больше нет. Обновите список."}},
      "th": {"stringUnit": {"state": "translated","value": "สภาพแวดล้อมนั้นไม่มีอยู่แล้ว รีเฟรชรายการ"}},
      "tr": {"stringUnit": {"state": "translated","value": "Bu ortam artık yok. Listeyi yenileyin."}},
      "uk": {"stringUnit": {"state": "translated","value": "Цього середовища більше немає. Оновіть список."}},
      "vi": {"stringUnit": {"state": "translated","value": "Môi trường đó không còn nữa. Hãy làm mới danh sách."}},
      "zh-Hans": {"stringUnit": {"state": "translated","value": "该环境已不存在。请刷新列表。"}},
      "zh-Hant": {"stringUnit": {"state": "translated","value": "該環境已不存在。請重新整理清單。"}}
    }},
