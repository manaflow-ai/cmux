    "cloud.workspaceSetup.summary": {"localizations": {
      "ar": {"stringUnit": {"state": "translated","value": "ابدأ مشروعًا جديدًا على آلة افتراضية فارغة، أو استنسخ مستودع GitHub إلى ~/work."}},
      "bs": {"stringUnit": {"state": "translated","value": "Pokrenite novi projekat na praznoj virtuelnoj mašini ili klonirajte GitHub repozitorij u ~/work."}},
      "da": {"stringUnit": {"state": "translated","value": "Start et nyt projekt på en tom VM, eller klon et GitHub-repository til ~/work."}},
      "de": {"stringUnit": {"state": "translated","value": "Starte ein neues Projekt auf einer leeren VM oder klone ein GitHub-Repository nach ~/work."}},
      "en": {"stringUnit": {"state": "translated","value": "Start a new project on an empty VM, or clone a GitHub repository into ~/work."}},
      "es": {"stringUnit": {"state": "translated","value": "Inicia un proyecto nuevo en una VM vacía o clona un repositorio de GitHub en ~/work."}},
      "fr": {"stringUnit": {"state": "translated","value": "Démarrer un nouveau projet sur une VM vide ou cloner un dépôt GitHub dans ~/work."}},
      "it": {"stringUnit": {"state": "translated","value": "Avvia un nuovo progetto su una VM vuota oppure clona un repository GitHub in ~/work."}},
      "ja": {"stringUnit": {"state": "translated","value": "空の VM で新しいプロジェクトを始めるか、GitHub リポジトリを ~/work にクローンします。"}},
      "km": {"stringUnit": {"state": "translated","value": "ចាប់ផ្តើមគម្រោងថ្មីលើ VM ទទេ ឬក្លូនឃ្លាំងកូដ GitHub ទៅក្នុង ~/work។"}},
      "ko": {"stringUnit": {"state": "translated","value": "빈 VM에서 새 프로젝트를 시작하거나 GitHub 저장소를 ~/work에 복제합니다."}},
      "nb": {"stringUnit": {"state": "translated","value": "Start et nytt prosjekt på en tom VM, eller klon et GitHub-repositorium til ~/work."}},
      "pl": {"stringUnit": {"state": "translated","value": "Uruchom nowy projekt na pustej maszynie wirtualnej albo sklonuj repozytorium GitHub do ~/work."}},
      "pt-BR": {"stringUnit": {"state": "translated","value": "Comece um novo projeto em uma VM vazia ou clone um repositório do GitHub em ~/work."}},
      "ru": {"stringUnit": {"state": "translated","value": "Начните новый проект на пустой виртуальной машине или клонируйте репозиторий GitHub в ~/work."}},
      "th": {"stringUnit": {"state": "translated","value": "เริ่มโปรเจกต์ใหม่บน VM ว่าง หรือโคลนที่เก็บโค้ด GitHub ไปยัง ~/work"}},
      "tr": {"stringUnit": {"state": "translated","value": "Boş bir VM'de yeni bir proje başlatın veya bir GitHub deposunu ~/work içine klonlayın."}},
      "uk": {"stringUnit": {"state": "translated","value": "Почніть новий проєкт на порожній віртуальній машині або клонуйте репозиторій GitHub у ~/work."}},
      "vi": {"stringUnit": {"state": "translated","value": "Bắt đầu dự án mới trên máy ảo trống hoặc sao chép kho mã GitHub vào ~/work."}},
      "zh-Hans": {"stringUnit": {"state": "translated","value": "在空白虚拟机上开始新项目，或将 GitHub 仓库克隆到 ~/work。"}},
      "zh-Hant": {"stringUnit": {"state": "translated","value": "在空白虛擬機器上開始新專案，或將 GitHub 儲存庫複製到 ~/work。"}}
    }},
