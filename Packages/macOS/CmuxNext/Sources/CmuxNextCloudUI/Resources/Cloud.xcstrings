    "cloud.atCap.detail": {"localizations": {
      "ar": {"stringUnit": {"state": "translated","value": "كل الأجهزة العاملة التي تسمح بها خطتك قيد الاستخدام. أوقف أحدها مؤقتًا لإفساح المجال، أو قم بالترقية للمزيد، أو شغّل هذا على جهاز Mac."}},
      "bs": {"stringUnit": {"state": "translated","value": "Sve pokrenute mašine koje vaš plan dozvoljava su u upotrebi. Pauzirajte jednu da napravite mjesta, nadogradite za više ili ovo pokrenite na svom Macu."}},
      "da": {"stringUnit": {"state": "translated","value": "Alle de kørende maskiner, din plan tillader, er i brug. Sæt en på pause for at gøre plads, opgrader for flere, eller kør dette på din Mac."}},
      "de": {"stringUnit": {"state": "translated","value": "Alle laufenden Maschinen deines Tarifs sind belegt. Pausiere eine, um Platz zu schaffen, führe ein Upgrade durch oder führe dies auf deinem Mac aus."}},
      "en": {"stringUnit": {"state": "translated","value": "Your plan's running machines are all in use. Pause one to make room, upgrade for more, or run this on your Mac."}},
      "es": {"stringUnit": {"state": "translated","value": "Todas las máquinas en ejecución de tu plan están en uso. Pausa una para hacer espacio, mejora tu plan para tener más o ejecuta esto en tu Mac."}},
      "fr": {"stringUnit": {"state": "translated","value": "Toutes les machines actives de votre forfait sont utilisées. Mettez-en une en pause pour faire de la place, passez à un forfait supérieur ou exécutez ceci sur votre Mac."}},
      "it": {"stringUnit": {"state": "translated","value": "Tutte le macchine attive del tuo piano sono in uso. Mettine in pausa una per fare spazio, passa a un piano superiore o esegui questo sul tuo Mac."}},
      "ja": {"stringUnit": {"state": "translated","value": "プランで使える実行中のマシンはすべて使用中です。1台を一時停止して空きを作るか、アップグレードするか、この Mac で実行してください。"}},
      "km": {"stringUnit": {"state": "translated","value": "ម៉ាស៊ីនដែលកំពុងដំណើរការទាំងអស់ក្នុងគម្រោងរបស់អ្នកកំពុងប្រើ។ ផ្អាកមួយដើម្បីបង្កើតកន្លែង ដំឡើងកម្រិតដើម្បីបានច្រើនទៀត ឬដំណើរការនេះនៅលើ Mac របស់អ្នក។"}},
      "ko": {"stringUnit": {"state": "translated","value": "플랜에서 허용하는 실행 중인 머신이 모두 사용 중입니다. 하나를 일시 정지해 자리를 만들거나, 업그레이드하거나, 이 Mac에서 실행하세요."}},
      "nb": {"stringUnit": {"state": "translated","value": "Alle kjørende maskiner planen din tillater, er i bruk. Sett én på pause for å gjøre plass, oppgrader for flere, eller kjør dette på Macen din."}},
      "pl": {"stringUnit": {"state": "translated","value": "Wszystkie działające maszyny z Twojego planu są w użyciu. Wstrzymaj jedną, aby zrobić miejsce, przejdź na wyższy plan lub uruchom to na swoim Macu."}},
      "pt-BR": {"stringUnit": {"state": "translated","value": "Todas as máquinas em execução do seu plano estão em uso. Pause uma para liberar espaço, faça upgrade para ter mais ou execute isto no seu Mac."}},
      "ru": {"stringUnit": {"state": "translated","value": "Все работающие машины вашего тарифа заняты. Приостановите одну, чтобы освободить место, перейдите на тариф выше или запустите это на своём Mac."}},
      "th": {"stringUnit": {"state": "translated","value": "เครื่องที่ทำงานอยู่ตามแผนของคุณถูกใช้งานทั้งหมด หยุดชั่วคราวหนึ่งเครื่องเพื่อเปิดที่ว่าง อัปเกรดเพื่อเพิ่ม หรือเรียกใช้สิ่งนี้บน Mac ของคุณ"}},
      "tr": {"stringUnit": {"state": "translated","value": "Planınızın çalışan makinelerinin hepsi kullanımda. Yer açmak için birini duraklatın, daha fazlası için yükseltin veya bunu Mac'inizde çalıştırın."}},
      "uk": {"stringUnit": {"state": "translated","value": "Усі запущені машини вашого тарифу зайняті. Призупиніть одну, щоб звільнити місце, перейдіть на вищий тариф або запустіть це на своєму Mac."}},
      "vi": {"stringUnit": {"state": "translated","value": "Tất cả máy đang chạy trong gói của bạn đều đang được dùng. Tạm dừng một máy để có chỗ, nâng cấp để có thêm, hoặc chạy việc này trên máy Mac của bạn."}},
      "zh-Hans": {"stringUnit": {"state": "translated","value": "你的套餐允许运行的机器都在使用中。暂停一台腾出位置、升级获取更多，或在这台 Mac 上运行。"}},
      "zh-Hant": {"stringUnit": {"state": "translated","value": "你的方案允許執行的機器都在使用中。暫停一台騰出位置、升級取得更多，或在這台 Mac 上執行。"}}
    }},
    "cloud.atCap.detailNoneYours": {"localizations": {
      "ar": {"stringUnit": {"state": "translated","value": "كل الأجهزة العاملة لفريقك قيد الاستخدام. قم بالترقية للمزيد، أو شغّل هذا على جهاز Mac."}},
      "bs": {"stringUnit": {"state": "translated","value": "Sve pokrenute mašine vašeg tima su u upotrebi. Nadogradite za više ili ovo pokrenite na svom Macu."}},
      "da": {"stringUnit": {"state": "translated","value": "Alle dit teams kørende maskiner er i brug. Opgrader for flere, eller kør dette på din Mac."}},
      "de": {"stringUnit": {"state": "translated","value": "Alle laufenden Maschinen deines Teams sind belegt. Führe ein Upgrade durch oder führe dies auf deinem Mac aus."}},
      "en": {"stringUnit": {"state": "translated","value": "Your team's running machines are all in use. Upgrade for more, or run this on your Mac."}},
      "es": {"stringUnit": {"state": "translated","value": "Todas las máquinas en ejecución de tu equipo están en uso. Mejora tu plan para tener más o ejecuta esto en tu Mac."}},
      "fr": {"stringUnit": {"state": "translated","value": "Toutes les machines actives de votre équipe sont utilisées. Passez à un forfait supérieur ou exécutez ceci sur votre Mac."}},
      "it": {"stringUnit": {"state": "translated","value": "Tutte le macchine attive del tuo team sono in uso. Passa a un piano superiore o esegui questo sul tuo Mac."}},
      "ja": {"stringUnit": {"state": "translated","value": "チームの実行中のマシンはすべて使用中です。アップグレードするか、この Mac で実行してください。"}},
      "km": {"stringUnit": {"state": "translated","value": "ម៉ាស៊ីនដែលកំពុងដំណើរការរបស់ក្រុមអ្នកទាំងអស់កំពុងប្រើ។ ដំឡើងកម្រិតដើម្បីបានច្រើនទៀត ឬដំណើរការនេះនៅលើ Mac របស់អ្នក។"}},
      "ko": {"stringUnit": {"state": "translated","value": "팀의 실행 중인 머신이 모두 사용 중입니다. 업그레이드하거나 이 Mac에서 실행하세요."}},
      "nb": {"stringUnit": {"state": "translated","value": "Alle teamets kjørende maskiner er i bruk. Oppgrader for flere, eller kjør dette på Macen din."}},
      "pl": {"stringUnit": {"state": "translated","value": "Wszystkie działające maszyny Twojego zespołu są w użyciu. Przejdź na wyższy plan lub uruchom to na swoim Macu."}},
      "pt-BR": {"stringUnit": {"state": "translated","value": "Todas as máquinas em execução da sua equipe estão em uso. Faça upgrade para ter mais ou execute isto no seu Mac."}},
      "ru": {"stringUnit": {"state": "translated","value": "Все работающие машины вашей команды заняты. Перейдите на тариф выше или запустите это на своём Mac."}},
      "th": {"stringUnit": {"state": "translated","value": "เครื่องที่ทำงานอยู่ของทีมคุณถูกใช้งานทั้งหมด อัปเกรดเพื่อเพิ่ม หรือเรียกใช้สิ่งนี้บน Mac ของคุณ"}},
      "tr": {"stringUnit": {"state": "translated","value": "Ekibinizin çalışan makinelerinin hepsi kullanımda. Daha fazlası için yükseltin veya bunu Mac'inizde çalıştırın."}},
      "uk": {"stringUnit": {"state": "translated","value": "Усі запущені машини вашої команди зайняті. Перейдіть на вищий тариф або запустіть це на своєму Mac."}},
      "vi": {"stringUnit": {"state": "translated","value": "Tất cả máy đang chạy của nhóm bạn đều đang được dùng. Nâng cấp để có thêm, hoặc chạy việc này trên máy Mac của bạn."}},
      "zh-Hans": {"stringUnit": {"state": "translated","value": "你的团队运行中的机器都在使用中。升级获取更多，或在这台 Mac 上运行。"}},
      "zh-Hant": {"stringUnit": {"state": "translated","value": "你的團隊執行中的機器都在使用中。升級取得更多，或在這台 Mac 上執行。"}}
    }},
    "cloud.atCap.freeDetail": {"localizations": {
      "ar": {"stringUnit": {"state": "translated","value": "لا تتضمن خطتك أجهزة سحابية. قم بالترقية، أو شغّل هذا على جهاز Mac."}},
      "bs": {"stringUnit": {"state": "translated","value": "Vaš plan nema Cloud mašina. Nadogradite ili ovo pokrenite na svom Macu."}},
      "da": {"stringUnit": {"state": "translated","value": "Din plan har ingen Cloud-maskiner. Opgrader, eller kør dette på din Mac."}},
      "de": {"stringUnit": {"state": "translated","value": "Dein Tarif enthält keine Cloud-Maschinen. Führe ein Upgrade durch oder führe dies auf deinem Mac aus."}},
      "en": {"stringUnit": {"state": "translated","value": "Your plan has no Cloud machines. Upgrade, or run this on your Mac."}},
      "es": {"stringUnit": {"state": "translated","value": "Tu plan no incluye máquinas en la nube. Mejora tu plan o ejecuta esto en tu Mac."}},
      "fr": {"stringUnit": {"state": "translated","value": "Votre forfait n'inclut aucune machine Cloud. Passez à un forfait supérieur ou exécutez ceci sur votre Mac."}},
      "it": {"stringUnit": {"state": "translated","value": "Il tuo piano non include macchine Cloud. Passa a un piano superiore o esegui questo sul tuo Mac."}},
      "ja": {"stringUnit": {"state": "translated","value": "お使いのプランには Cloud マシンがありません。アップグレードするか、この Mac で実行してください。"}},
      "km": {"stringUnit": {"state": "translated","value": "គម្រោងរបស់អ្នកមិនមានម៉ាស៊ីន Cloud ទេ។ ដំឡើងកម្រិត ឬដំណើរការនេះនៅលើ Mac របស់អ្នក។"}},
      "ko": {"stringUnit": {"state": "translated","value": "플랜에 Cloud 머신이 없습니다. 업그레이드하거나 이 Mac에서 실행하세요."}},
      "nb": {"stringUnit": {"state": "translated","value": "Planen din har ingen Cloud-maskiner. Oppgrader, eller kjør dette på Macen din."}},
      "pl": {"stringUnit": {"state": "translated","value": "Twój plan nie obejmuje maszyn Cloud. Przejdź na wyższy plan lub uruchom to na swoim Macu."}},
      "pt-BR": {"stringUnit": {"state": "translated","value": "Seu plano não tem máquinas na nuvem. Faça upgrade ou execute isto no seu Mac."}},
      "ru": {"stringUnit": {"state": "translated","value": "В вашем тарифе нет облачных машин. Перейдите на тариф выше или запустите это на своём Mac."}},
      "th": {"stringUnit": {"state": "translated","value": "แผนของคุณไม่มีเครื่อง Cloud อัปเกรด หรือเรียกใช้สิ่งนี้บน Mac ของคุณ"}},
      "tr": {"stringUnit": {"state": "translated","value": "Planınızda Cloud makinesi yok. Yükseltin veya bunu Mac'inizde çalıştırın."}},
      "uk": {"stringUnit": {"state": "translated","value": "У вашому тарифі немає хмарних машин. Перейдіть на вищий тариф або запустіть це на своєму Mac."}},
      "vi": {"stringUnit": {"state": "translated","value": "Gói của bạn không có máy Cloud. Nâng cấp, hoặc chạy việc này trên máy Mac của bạn."}},
      "zh-Hans": {"stringUnit": {"state": "translated","value": "你的套餐不含 Cloud 机器。请升级，或在这台 Mac 上运行。"}},
      "zh-Hant": {"stringUnit": {"state": "translated","value": "你的方案不含 Cloud 機器。請升級，或在這台 Mac 上執行。"}}
    }},
    "cloud.atCap.freeTitle": {"localizations": {
      "ar": {"stringUnit": {"state": "translated","value": "تحتاج الأجهزة السحابية إلى خطة مدفوعة"}},
      "bs": {"stringUnit": {"state": "translated","value": "Cloud mašine zahtijevaju plaćeni plan"}},
      "da": {"stringUnit": {"state": "translated","value": "Cloud-maskiner kræver en betalt plan"}},
      "de": {"stringUnit": {"state": "translated","value": "Cloud-Maschinen brauchen einen kostenpflichtigen Tarif"}},
      "en": {"stringUnit": {"state": "translated","value": "Cloud machines need a paid plan"}},
      "es": {"stringUnit": {"state": "translated","value": "Las máquinas en la nube requieren un plan de pago"}},
      "fr": {"stringUnit": {"state": "translated","value": "Les machines Cloud nécessitent un forfait payant"}},
      "it": {"stringUnit": {"state": "translated","value": "Le macchine Cloud richiedono un piano a pagamento"}},
      "ja": {"stringUnit": {"state": "translated","value": "Cloud マシンには有料プランが必要です"}},
      "km": {"stringUnit": {"state": "translated","value": "ម៉ាស៊ីន Cloud ត្រូវការគម្រោងបង់ប្រាក់"}},
      "ko": {"stringUnit": {"state": "translated","value": "Cloud 머신에는 유료 플랜이 필요합니다"}},
      "nb": {"stringUnit": {"state": "translated","value": "Cloud-maskiner krever en betalt plan"}},
      "pl": {"stringUnit": {"state": "translated","value": "Maszyny Cloud wymagają płatnego planu"}},
      "pt-BR": {"stringUnit": {"state": "translated","value": "Máquinas na nuvem exigem um plano pago"}},
      "ru": {"stringUnit": {"state": "translated","value": "Для облачных машин нужен платный тариф"}},
      "th": {"stringUnit": {"state": "translated","value": "เครื่อง Cloud ต้องใช้แผนแบบชำระเงิน"}},
      "tr": {"stringUnit": {"state": "translated","value": "Cloud makineleri ücretli bir plan gerektirir"}},
      "uk": {"stringUnit": {"state": "translated","value": "Для хмарних машин потрібен платний тариф"}},
      "vi": {"stringUnit": {"state": "translated","value": "Máy Cloud cần gói trả phí"}},
      "zh-Hans": {"stringUnit": {"state": "translated","value": "Cloud 机器需要付费套餐"}},
      "zh-Hant": {"stringUnit": {"state": "translated","value": "Cloud 機器需要付費方案"}}
    }},
    "cloud.atCap.madeRoom": {"localizations": {
      "ar": {"stringUnit": {"state": "translated","value": "تم إيقاف جهاز %@ مؤقتًا لإفساح المجال"}},
      "bs": {"stringUnit": {"state": "translated","value": "Mašina za %@ je pauzirana da se napravi mjesta"}},
      "da": {"stringUnit": {"state": "translated","value": "Satte maskinen for %@ på pause for at gøre plads"}},
      "de": {"stringUnit": {"state": "translated","value": "Maschine von %@ pausiert, um Platz zu schaffen"}},
      "en": {"stringUnit": {"state": "translated","value": "Paused %@'s machine to make room"}},
      "es": {"stringUnit": {"state": "translated","value": "Se pausó la máquina de %@ para hacer espacio"}},
      "fr": {"stringUnit": {"state": "translated","value": "Machine de %@ mise en pause pour faire de la place"}},
      "it": {"stringUnit": {"state": "translated","value": "Messa in pausa la macchina di %@ per fare spazio"}},
      "ja": {"stringUnit": {"state": "translated","value": "空きを作るため %@ のマシンを一時停止しました"}},
      "km": {"stringUnit": {"state": "translated","value": "បានផ្អាកម៉ាស៊ីនរបស់ %@ ដើម្បីបង្កើតកន្លែង"}},
      "ko": {"stringUnit": {"state": "translated","value": "자리를 만들기 위해 %@의 머신을 일시 정지했습니다"}},
      "nb": {"stringUnit": {"state": "translated","value": "Satte maskinen til %@ på pause for å gjøre plass"}},
      "pl": {"stringUnit": {"state": "translated","value": "Wstrzymano maszynę %@, aby zrobić miejsce"}},
      "pt-BR": {"stringUnit": {"state": "translated","value": "A máquina de %@ foi pausada para liberar espaço"}},
      "ru": {"stringUnit": {"state": "translated","value": "Машина %@ приостановлена, чтобы освободить место"}},
      "th": {"stringUnit": {"state": "translated","value": "หยุดเครื่องของ %@ ชั่วคราวเพื่อเปิดที่ว่าง"}},
      "tr": {"stringUnit": {"state": "translated","value": "Yer açmak için %@ makinesi duraklatıldı"}},
      "uk": {"stringUnit": {"state": "translated","value": "Машину %@ призупинено, щоб звільнити місце"}},
      "vi": {"stringUnit": {"state": "translated","value": "Đã tạm dừng máy của %@ để có chỗ"}},
      "zh-Hans": {"stringUnit": {"state": "translated","value": "已暂停 %@ 的机器以腾出位置"}},
      "zh-Hant": {"stringUnit": {"state": "translated","value": "已暫停 %@ 的機器以騰出位置"}}
    }},
