      "es": {"stringUnit": {"state": "translated","value": "Comando de configuración (opcional, solo para un entorno nuevo)"}},
      "fr": {"stringUnit": {"state": "translated","value": "Commande de configuration (facultative, uniquement pour un nouvel environnement)"}},
