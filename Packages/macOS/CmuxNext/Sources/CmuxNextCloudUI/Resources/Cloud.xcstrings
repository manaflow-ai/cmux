    "automations.title": {"localizations": {
      "ar": {"stringUnit": {"state": "translated","value": "الأتمتة"}},
      "bs": {"stringUnit": {"state": "translated","value": "Automatizacije"}},
      "da": {"stringUnit": {"state": "translated","value": "Automatiseringer"}},
      "de": {"stringUnit": {"state": "translated","value": "Automatisierungen"}},
      "en": {"stringUnit": {"state": "translated","value": "Automations"}},
      "es": {"stringUnit": {"state": "translated","value": "Automatizaciones"}},
      "fr": {"stringUnit": {"state": "translated","value": "Automatisations"}},
      "it": {"stringUnit": {"state": "translated","value": "Automazioni"}},
      "ja": {"stringUnit": {"state": "translated","value": "自動化"}},
      "km": {"stringUnit": {"state": "translated","value": "ស្វ័យប្រវត្តិកម្ម"}},
      "ko": {"stringUnit": {"state": "translated","value": "자동화"}},
