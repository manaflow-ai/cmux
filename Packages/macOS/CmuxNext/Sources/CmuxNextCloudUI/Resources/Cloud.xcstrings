    "cloud.move.unknownMachine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux can't confirm who owns %@, so the chat stays on this Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع cmux التأكد من مالك %@، لذا تبقى المحادثة على جهاز Mac هذا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ne može potvrditi ko posjeduje %@, pa chat ostaje na ovom Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux kan ikke bekræfte, hvem der ejer %@, så chatten bliver på denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux kann nicht bestätigen, wem %@ gehört, daher bleibt der Chat auf diesem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no puede confirmar a quién pertenece %@, así que el chat se queda en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ne peut pas confirmer à qui appartient %@, la discussion reste donc sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux non può confermare a chi appartiene %@, quindi la chat resta su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux は %@ の所有者を確認できないため、チャットはこの Mac に残ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux មិនអាចបញ្ជាក់ថាអ្នកណាជាម្ចាស់ %@ ទេ ដូច្នេះការជជែកនៅលើ Mac នេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 %@의 소유자를 확인할 수 없어 채팅이 이 Mac에 남아 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux kan ikke bekrefte hvem som eier %@, så chatten blir på denne Macen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nie może potwierdzić, kto jest właścicielem %@, więc czat zostaje na tym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux não consegue confirmar quem é o dono de %@, então o chat fica neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux не может подтвердить, кому принадлежит %@, поэтому чат остаётся на этом Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ยืนยันไม่ได้ว่าใครเป็นเจ้าของ %@ แชทจึงยังอยู่บน Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux, %@ makinesinin sahibini doğrulayamıyor, bu yüzden sohbet bu Mac'te kalıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux не може підтвердити, кому належить %@, тому чат залишається на цьому Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux không xác nhận được ai sở hữu %@, nên cuộc trò chuyện vẫn ở trên máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 无法确认 %@ 的所有者，因此对话会留在这台 Mac 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 無法確認 %@ 的擁有者，因此對話會留在這台 Mac 上。"
          }
        }
      }
    },
    "cloud.move.outdatedMachine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ runs an older cmux that can't take this chat yet. Update the machine to move it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشغّل %@ إصدارًا أقدم من cmux لا يمكنه استقبال هذه المحادثة بعد. حدّث الجهاز لنقلها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ koristi stariji cmux koji još ne može preuzeti ovaj chat. Ažuriraj mašinu da ga premjestiš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kører en ældre cmux, der endnu ikke kan modtage denne chat. Opdater maskinen for at flytte den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf %@ läuft ein älteres cmux, das diesen Chat noch nicht übernehmen kann. Aktualisiere die Maschine, um ihn zu verschieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ejecuta una versión anterior de cmux que aún no puede recibir este chat. Actualiza la máquina para moverlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ exécute une ancienne version de cmux qui ne peut pas encore recevoir cette discussion. Mettez la machine à jour pour la déplacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ esegue una versione precedente di cmux che non può ancora ricevere questa chat. Aggiorna la macchina per spostarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の cmux は古いため、まだこのチャットを受け取れません。移動するにはマシンを更新してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ កំពុងដំណើរការ cmux ចាស់ ដែលមិនទាន់អាចទទួលការជជែកនេះបានទេ។ សូមធ្វើបច្ចុប្បន្នភាពម៉ាស៊ីន ដើម្បីផ្លាស់ទីវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 실행 중인 cmux가 오래되어 아직 이 채팅을 받을 수 없습니다. 채팅을 옮기려면 머신을 업데이트하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kjører en eldre cmux som ennå ikke kan ta imot denne chatten. Oppdater maskinen for å flytte den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ma starszą wersję cmux, która nie może jeszcze przejąć tego czatu. Zaktualizuj maszynę, aby go przenieść."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ executa uma versão mais antiga do cmux que ainda não pode receber este chat. Atualize a máquina para movê-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На %@ работает старая версия cmux, которая пока не может принять этот чат. Обновите машину, чтобы перенести его."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ใช้ cmux รุ่นเก่าที่ยังรับแชทนี้ไม่ได้ อัปเดตเครื่องเพื่อย้ายแชท"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bu sohbeti henüz alamayan eski bir cmux sürümü çalıştırıyor. Taşımak için makineyi güncelleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На %@ працює старіша версія cmux, яка ще не може прийняти цей чат. Оновіть машину, щоб перенести його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đang chạy cmux phiên bản cũ nên chưa thể nhận cuộc trò chuyện này. Hãy cập nhật máy để chuyển nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 运行的 cmux 版本较旧，暂时无法接收此对话。请更新该机器以移动对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 執行的 cmux 版本較舊，暫時無法接收此對話。請更新該機器以移動對話。"
          }
        }
      }
    },
    "cloud.move.unreachable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lost the connection to %@ during the move. Retry to finish it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع الاتصال بـ %@ أثناء النقل. أعد المحاولة لإكماله."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Veza sa %@ je prekinuta tokom premještanja. Pokušaj ponovo da ga završiš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbindelsen til %@ blev afbrudt under flytningen. Prøv igen for at gøre den færdig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung zu %@ ist beim Verschieben abgebrochen. Versuche es erneut, um es abzuschließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perdió la conexión con %@ durante el traslado. Vuelve a intentarlo para terminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion à %@ a été perdue pendant le déplacement. Réessayez pour le terminer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connessione a %@ persa durante lo spostamento. Riprova per completarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動中に %@ との接続が切れました。再試行して完了してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បាត់ការតភ្ជាប់ទៅ %@ ពេលកំពុងផ្លាស់ទី។ ព្យាយាមម្តងទៀតដើម្បីបញ្ចប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이동 중에 %@과(와)의 연결이 끊어졌습니다. 다시 시도하여 완료하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistet tilkoblingen til %@ under flyttingen. Prøv igjen for å fullføre den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utracono połączenie z %@ podczas przenoszenia. Ponów, aby je dokończyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão com %@ caiu durante a transferência. Tente novamente para concluí-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связь с %@ прервалась во время переноса. Повторите, чтобы завершить его."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อกับ %@ ขาดระหว่างการย้าย ลองอีกครั้งเพื่อให้เสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşıma sırasında %@ bağlantısı koptu. Tamamlamak için yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зв'язок із %@ обірвався під час перенесення. Повторіть, щоб завершити його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mất kết nối với %@ trong khi chuyển. Hãy thử lại để hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动期间与 %@ 的连接中断。请重试以完成移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移動期間與 %@ 的連線中斷。請重試以完成移動。"
          }
        }
      }
    },
    "cloud.move.unresolved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The move didn't finish, so the chat is paused. Retry to finish it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكتمل النقل، لذا المحادثة متوقفة مؤقتًا. أعد المحاولة لإكماله."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Premještanje nije završeno, pa je chat pauziran. Pokušaj ponovo da ga završiš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytningen blev ikke færdig, så chatten er sat på pause. Prøv igen for at gøre den færdig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Verschieben wurde nicht abgeschlossen, daher ist der Chat pausiert. Versuche es erneut, um es abzuschließen."
          }
        },
        "es": {
