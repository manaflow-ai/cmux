    "cloud.startChat.accountChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Cloud account or team changed while this chat was starting, so nothing was copied. Send it again in the account you want it in."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر حسابك أو فريقك في Cloud أثناء بدء هذه المحادثة، لذا لم يُنسخ شيء. أرسلها مرة أخرى من الحساب الذي تريده."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj Cloud račun ili tim se promijenio dok se ovaj chat pokretao, pa ništa nije kopirano. Pošalji ga ponovo s računom koji želiš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Cloud-konto eller dit team blev ændret, mens denne chat startede, så intet blev kopieret. Send den igen fra den konto, du vil bruge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Cloud-Konto oder Team hat sich geändert, während dieser Chat gestartet wurde, daher wurde nichts kopiert. Sende ihn erneut in dem Konto, das du willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta o equipo de Cloud cambió mientras se iniciaba este chat, así que no se copió nada. Envíalo de nuevo desde la cuenta que quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte ou équipe Cloud a changé pendant le démarrage de cette discussion, donc rien n'a été copié. Renvoyez-la depuis le compte voulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account o team Cloud è cambiato mentre questa chat si avviava, quindi non è stato copiato nulla. Inviala di nuovo dall'account che vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットの開始中に Cloud のアカウントまたはチームが変わったため、何もコピーされませんでした。使いたいアカウントでもう一度送信してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គណនី ឬក្រុម Cloud របស់អ្នកបានផ្លាស់ប្តូរ ពេលការជជែកនេះកំពុងចាប់ផ្តើម ដូច្នេះគ្មានអ្វីត្រូវបានចម្លងទេ។ ផ្ញើវាម្តងទៀតក្នុងគណនីដែលអ្នកចង់បាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 채팅이 시작되는 동안 Cloud 계정 또는 팀이 바뀌어 아무것도 복사되지 않았습니다. 원하는 계정에서 다시 보내세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-kontoen eller teamet ditt endret seg mens denne chatten startet, så ingenting ble kopiert. Send den på nytt fra kontoen du vil bruke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje konto lub zespół Cloud zmieniły się podczas uruchamiania tego czatu, więc nic nie zostało skopiowane. Wyślij go ponownie z wybranego konta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta ou equipe do Cloud mudou enquanto este chat iniciava, então nada foi copiado. Envie de novo na conta que você quer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш аккаунт или команда Cloud изменились во время запуска этого чата, поэтому ничего не скопировано. Отправьте его снова из нужного аккаунта."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีหรือทีม Cloud ของคุณเปลี่ยนไประหว่างที่แชทนี้กำลังเริ่ม จึงไม่มีการคัดลอกอะไร ส่งอีกครั้งในบัญชีที่คุณต้องการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sohbet başlarken Cloud hesabın veya ekibin değişti, bu yüzden hiçbir şey kopyalanmadı. İstediğin hesapta yeniden gönder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш обліковий запис або команда Cloud змінилися під час запуску цього чату, тому нічого не скопійовано. Надішліть його знову з потрібного облікового запису."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản hoặc nhóm Cloud của bạn đã thay đổi khi cuộc trò chuyện này đang bắt đầu, nên không có gì được sao chép. Hãy gửi lại trong tài khoản bạn muốn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此对话启动时你的 Cloud 账户或团队发生了变化，因此未复制任何内容。请在你想用的账户中重新发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此對話啟動時你的 Cloud 帳號或團隊有所變更，因此未複製任何內容。請在你想用的帳號中重新傳送。"
          }
        }
      }
    },
    "cloud.startChat.listUnread": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read the Cloud machines of the account signed in now, so this chat stays on this Mac. Try again in a moment."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة أجهزة Cloud للحساب المسجّل حاليًا، لذا تبقى هذه المحادثة على هذا الـ Mac. حاول مرة أخرى بعد قليل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće pročitati Cloud mašine trenutno prijavljenog računa, pa ovaj chat ostaje na ovom Macu. Pokušaj ponovo za trenutak."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke læse Cloud-maskinerne for den konto, der er logget ind nu, så denne chat bliver på denne Mac. Prøv igen om et øjeblik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Cloud-Maschinen des jetzt angemeldeten Kontos konnten nicht gelesen werden, daher bleibt dieser Chat auf diesem Mac. Versuche es gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer las máquinas de Cloud de la cuenta con sesión iniciada, así que este chat se queda en este Mac. Vuelve a intentarlo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire les machines Cloud du compte connecté, donc cette discussion reste sur ce Mac. Réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere le macchine Cloud dell'account connesso ora, quindi questa chat resta su questo Mac. Riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在サインインしているアカウントの Cloud マシンを読み込めなかったため、このチャットはこの Mac に残ります。しばらくしてからもう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចអានម៉ាស៊ីន Cloud របស់គណនីដែលបានចូលឥឡូវនេះបានទេ ដូច្នេះការជជែកនេះនៅលើ Mac នេះ។ ព្យាយាមម្តងទៀតបន្តិចទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 로그인한 계정의 Cloud 머신을 읽지 못해 이 채팅은 이 Mac에 남습니다. 잠시 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke lese Cloud-maskinene til kontoen som er logget inn nå, så denne chatten blir på denne Macen. Prøv igjen om et øyeblikk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać maszyn Cloud obecnie zalogowanego konta, więc ten czat zostaje na tym Macu. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler as máquinas do Cloud da conta conectada agora, então este chat fica neste Mac. Tente de novo em instantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать машины Cloud аккаунта, в который выполнен вход, поэтому чат остаётся на этом Mac. Повторите чуть позже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านเครื่อง Cloud ของบัญชีที่ลงชื่อเข้าใช้อยู่ไม่ได้ แชทนี้จึงยังอยู่บน Mac เครื่องนี้ ลองอีกครั้งในอีกสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu an oturum açık hesabın Cloud makineleri okunamadı, bu yüzden sohbet bu Mac'te kalıyor. Birazdan yeniden dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати машини Cloud облікового запису, у який виконано вхід, тому чат залишається на цьому Mac. Спробуйте трохи згодом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đọc được các máy Cloud của tài khoản đang đăng nhập, nên cuộc trò chuyện này vẫn ở trên máy Mac này. Hãy thử lại sau giây lát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取当前登录账户的 Cloud 机器，因此此对话留在这台 Mac 上。请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取目前登入帳號的 Cloud 機器，因此此對話留在這台 Mac 上。請稍後再試。"
          }
        }
      }
    },
    "cloud.move.alreadyRemote": {
      "extractionState": "manual",
      "localizations": {
