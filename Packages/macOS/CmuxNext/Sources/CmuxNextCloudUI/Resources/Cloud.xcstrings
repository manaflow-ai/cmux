    "automations.empty": {"localizations": {
      "ar": {"stringUnit": {"state": "translated","value": "لا توجد أتمتة بعد. اطلب من Chief (\"كل يوم عمل في 9، لخّص طلبات الدمج\") أو اضغط جديد."}},
      "bs": {"stringUnit": {"state": "translated","value": "Još nema automatizacija. Zamolite Chiefa (\"svaki radni dan u 9, sažmi moje PR-ove\") ili pritisnite Novo."}},
      "da": {"stringUnit": {"state": "translated","value": "Ingen automatiseringer endnu. Spørg din Chief (\"hver hverdag kl. 9, opsummer mine PR'er\") eller tryk på Ny."}},
      "de": {"stringUnit": {"state": "translated","value": "Noch keine Automatisierungen. Frag deinen Chief („jeden Werktag um 9 meine PRs zusammenfassen“) oder klicke auf Neu."}},
      "en": {"stringUnit": {"state": "translated","value": "No automations yet. Ask your Chief (\"every weekday at 9, summarize my PRs\") or press New."}},
      "es": {"stringUnit": {"state": "translated","value": "Aún no hay automatizaciones. Pídeselo a tu Chief (\"cada día laborable a las 9, resume mis PR\") o pulsa Nueva."}},
      "fr": {"stringUnit": {"state": "translated","value": "Aucune automatisation pour l’instant. Demandez à votre Chief (« chaque jour ouvré à 9 h, résume mes PR ») ou cliquez sur Nouvelle."}},
      "it": {"stringUnit": {"state": "translated","value": "Ancora nessuna automazione. Chiedi al tuo Chief (\"ogni giorno feriale alle 9, riassumi le mie PR\") o premi Nuova."}},
      "ja": {"stringUnit": {"state": "translated","value": "まだ自動化はありません。Chief に頼む (「平日の 9 時に PR を要約して」) か、「新規」を押してください。"}},
      "km": {"stringUnit": {"state": "translated","value": "មិនទាន់មានស្វ័យប្រវត្តិកម្មទេ។ សុំ Chief (\"រៀងរាល់ថ្ងៃធ្វើការម៉ោង 9 សង្ខេប PR របស់ខ្ញុំ\") ឬចុច ថ្មី។"}},
      "ko": {"stringUnit": {"state": "translated","value": "아직 자동화가 없습니다. Chief에게 요청하거나(\"평일 9시에 내 PR 요약해 줘\") 새로 만들기를 누르세요."}},
      "nb": {"stringUnit": {"state": "translated","value": "Ingen automatiseringer ennå. Spør Chief (\"hver ukedag kl. 9, oppsummer PR-ene mine\") eller trykk Ny."}},
      "pl": {"stringUnit": {"state": "translated","value": "Brak automatyzacji. Poproś Chiefa („w każdy dzień roboczy o 9 podsumuj moje PR-y”) lub kliknij Nowa."}},
      "pt-BR": {"stringUnit": {"state": "translated","value": "Nenhuma automação ainda. Peça ao seu Chief (\"todo dia útil às 9, resuma meus PRs\") ou clique em Nova."}},
      "ru": {"stringUnit": {"state": "translated","value": "Автоматизаций пока нет. Попросите Chief («каждый будний день в 9 подводи итог моих PR») или нажмите «Новая»."}},
      "th": {"stringUnit": {"state": "translated","value": "ยังไม่มีระบบอัตโนมัติ ขอให้ Chief (\"ทุกวันทำงานเวลา 9 โมง สรุป PR ของฉัน\") หรือกด ใหม่"}},
      "tr": {"stringUnit": {"state": "translated","value": "Henüz otomasyon yok. Chief'inize sorun (\"her iş günü saat 9'da PR'larımı özetle\") veya Yeni'ye basın."}},
      "uk": {"stringUnit": {"state": "translated","value": "Автоматизацій поки немає. Попросіть Chief («щобудня о 9 підсумовуй мої PR») або натисніть «Нова»."}},
      "vi": {"stringUnit": {"state": "translated","value": "Chưa có tự động hóa nào. Hãy nhờ Chief (\"mỗi ngày làm việc lúc 9 giờ, tóm tắt PR của tôi\") hoặc nhấn Mới."}},
      "zh-Hans": {"stringUnit": {"state": "translated","value": "还没有自动化。让 Chief 来做（“每个工作日 9 点总结我的 PR”）或点按新建。"}},
      "zh-Hant": {"stringUnit": {"state": "translated","value": "還沒有自動化。請 Chief 幫忙（「每個工作日 9 點摘要我的 PR」）或按新增。"}}
    }},
