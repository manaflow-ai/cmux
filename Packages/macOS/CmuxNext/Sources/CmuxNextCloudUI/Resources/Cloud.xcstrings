      "ja": {"stringUnit": {"state": "translated","value": "セットアップコマンド（任意、新しい環境のみ）"}},
      "km": {"stringUnit": {"state": "translated","value": "ពាក្យបញ្ជារៀបចំ (ស្រេចចិត្ត សម្រាប់តែបរិស្ថានថ្មី)"}},
