      "es": {"stringUnit": {"state": "translated","value": "%1$@: última actividad %2$@"}},
      "fr": {"stringUnit": {"state": "translated","value": "%1$@ : dernière activité %2$@"}},
      "it": {"stringUnit": {"state": "translated","value": "%1$@: ultima attività %2$@"}},
      "ja": {"stringUnit": {"state": "translated","value": "%1$@: 最終アクティビティ %2$@"}},
