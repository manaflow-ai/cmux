        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل هذه المحادثة بالفعل على جهاز آخر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj chat već radi na drugoj mašini."
          }
        },
        "da": {
