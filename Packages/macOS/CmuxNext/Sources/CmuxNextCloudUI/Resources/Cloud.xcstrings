    "cloud.workspaceSetup.repositoryChoice": {"localizations": {
      "ar": {"stringUnit": {"state": "translated","value": "من مستودع"}},
      "bs": {"stringUnit": {"state": "translated","value": "Iz repozitorija"}},
      "da": {"stringUnit": {"state": "translated","value": "Fra repository"}},
      "de": {"stringUnit": {"state": "translated","value": "Aus Repository"}},
