    "cloudTeam.error.signedOut": {
      "comment": "error",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Sign in to cmux to see your team's Cloud sessions."}},
        "ar": {"stringUnit": {"state": "translated", "value": "سجّل الدخول إلى cmux لرؤية جلسات Cloud الخاصة بفريقك."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Prijavite se u cmux da vidite Cloud sesije svog tima."}},
        "da": {"stringUnit": {"state": "translated", "value": "Log ind på cmux for at se dit teams Cloud-sessioner."}},
        "de": {"stringUnit": {"state": "translated", "value": "Melde dich bei cmux an, um die Cloud-Sitzungen deines Teams zu sehen."}},
        "es": {"stringUnit": {"state": "translated", "value": "Inicia sesión en cmux para ver las sesiones de Cloud de tu equipo."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Connectez-vous à cmux pour voir les sessions Cloud de votre équipe."}},
        "it": {"stringUnit": {"state": "translated", "value": "Accedi a cmux per vedere le sessioni Cloud del tuo team."}},
        "ja": {"stringUnit": {"state": "translated", "value": "チームの Cloud セッションを見るには cmux にサインインしてください。"}},
        "km": {"stringUnit": {"state": "translated", "value": "ចូលទៅ cmux ដើម្បីមើលវគ្គ Cloud របស់ក្រុមអ្នក។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "팀의 Cloud 세션을 보려면 cmux에 로그인하세요."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Logg på cmux for å se teamets Cloud-økter."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Zaloguj się do cmux, aby zobaczyć sesje Cloud swojego zespołu."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Entre no cmux para ver as sessões do Cloud da sua equipe."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Войдите в cmux, чтобы видеть сеансы Cloud вашей команды."}},
        "th": {"stringUnit": {"state": "translated", "value": "ลงชื่อเข้าใช้ cmux เพื่อดูเซสชัน Cloud ของทีม"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Ekibinizin Cloud oturumlarını görmek için cmux'a giriş yapın."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Увійдіть у cmux, щоб бачити сеанси Cloud вашої команди."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Đăng nhập cmux để xem các phiên Cloud của nhóm bạn."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "登录 cmux 以查看团队的 Cloud 会话。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "登入 cmux 以查看團隊的 Cloud 工作階段。"}}
      }
    },
    "cloudTeam.error.unreachable": {
      "comment": "error",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The Cloud service did not answer. Try again."}},
        "ar": {"stringUnit": {"state": "translated", "value": "لم تستجب خدمة Cloud. حاول مرة أخرى."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Cloud usluga nije odgovorila. Pokušajte ponovo."}},
        "da": {"stringUnit": {"state": "translated", "value": "Cloud-tjenesten svarede ikke. Prøv igen."}},
        "de": {"stringUnit": {"state": "translated", "value": "Der Cloud-Dienst hat nicht geantwortet. Versuche es erneut."}},
        "es": {"stringUnit": {"state": "translated", "value": "El servicio de Cloud no respondió. Inténtalo de nuevo."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le service Cloud n'a pas répondu. Réessayez."}},
        "it": {"stringUnit": {"state": "translated", "value": "Il servizio Cloud non ha risposto. Riprova."}},
        "ja": {"stringUnit": {"state": "translated", "value": "Cloud サービスから応答がありません。もう一度お試しください。"}},
        "km": {"stringUnit": {"state": "translated", "value": "សេវា Cloud មិនបានឆ្លើយតប។ សូមព្យាយាមម្ដងទៀត។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "Cloud 서비스가 응답하지 않았습니다. 다시 시도하세요."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Cloud-tjenesten svarte ikke. Prøv igjen."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Usługa Cloud nie odpowiedziała. Spróbuj ponownie."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O serviço do Cloud não respondeu. Tente novamente."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Сервис Cloud не ответил. Повторите попытку."}},
        "th": {"stringUnit": {"state": "translated", "value": "บริการ Cloud ไม่ตอบสนอง โปรดลองอีกครั้ง"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Cloud hizmeti yanıt vermedi. Yeniden deneyin."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Сервіс Cloud не відповів. Спробуйте ще раз."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Dịch vụ Cloud không phản hồi. Hãy thử lại."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "Cloud 服务没有响应，请重试。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "Cloud 服務沒有回應，請再試一次。"}}
      }
    },
    "cloudTeam.error.notCloud": {
      "comment": "error; keep --session as written",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Name a team Cloud session with --session, or run this from a Cloud workspace or chat."}},
        "ar": {"stringUnit": {"state": "translated", "value": "حدّد جلسة Cloud للفريق باستخدام --session، أو شغّل هذا من مساحة عمل أو دردشة Cloud."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Navedite Cloud sesiju tima pomoću --session ili ovo pokrenite iz Cloud radnog prostora ili chata."}},
        "da": {"stringUnit": {"state": "translated", "value": "Angiv en Cloud-session for teamet med --session, eller kør dette fra et Cloud-arbejdsområde eller en Cloud-chat."}},
        "de": {"stringUnit": {"state": "translated", "value": "Gib mit --session eine Cloud-Sitzung des Teams an oder führe dies in einem Cloud-Arbeitsbereich oder -Chat aus."}},
        "es": {"stringUnit": {"state": "translated", "value": "Indica una sesión de Cloud del equipo con --session o ejecuta esto desde un espacio de trabajo o chat de Cloud."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Indiquez une session Cloud de l'équipe avec --session, ou lancez ceci depuis un espace de travail ou un chat Cloud."}},
        "it": {"stringUnit": {"state": "translated", "value": "Indica una sessione Cloud del team con --session oppure esegui questo da uno spazio di lavoro o una chat Cloud."}},
        "ja": {"stringUnit": {"state": "translated", "value": "--session でチームの Cloud セッションを指定するか、Cloud のワークスペースまたはチャットから実行してください。"}},
        "km": {"stringUnit": {"state": "translated", "value": "កំណត់វគ្គ Cloud របស់ក្រុមដោយ --session ឬដំណើរការវាពីកន្លែងធ្វើការ ឬការជជែក Cloud។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "--session으로 팀 Cloud 세션을 지정하거나 Cloud 작업 공간 또는 채팅에서 실행하세요."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Angi en Cloud-økt for teamet med --session, eller kjør dette fra et Cloud-arbeidsområde eller en Cloud-chat."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Wskaż sesję Cloud zespołu za pomocą --session albo uruchom to z obszaru roboczego lub czatu Cloud."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Indique uma sessão do Cloud da equipe com --session ou execute isto em um espaço de trabalho ou chat do Cloud."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Укажите сеанс Cloud команды через --session или запустите это из рабочей области или чата Cloud."}},
        "th": {"stringUnit": {"state": "translated", "value": "ระบุเซสชัน Cloud ของทีมด้วย --session หรือเรียกใช้จากพื้นที่ทำงานหรือแชต Cloud"}},
        "tr": {"stringUnit": {"state": "translated", "value": "--session ile bir ekip Cloud oturumu belirtin veya bunu bir Cloud çalışma alanından ya da sohbetinden çalıştırın."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Вкажіть сеанс Cloud команди через --session або запустіть це з робочої області чи чату Cloud."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Chỉ định một phiên Cloud của nhóm bằng --session, hoặc chạy lệnh này từ không gian làm việc hay cuộc trò chuyện Cloud."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "用 --session 指定团队的 Cloud 会话，或在 Cloud 工作区或聊天中运行。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "用 --session 指定團隊的 Cloud 工作階段，或在 Cloud 工作區或聊天中執行。"}}
      }
    },
    "cloudTeam.error.invalidSession": {
      "comment": "error",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "That is not a team Cloud session key or link."}},
        "ar": {"stringUnit": {"state": "translated", "value": "هذا ليس مفتاح جلسة Cloud للفريق ولا رابطها."}},
        "bs": {"stringUnit": {"state": "translated", "value": "To nije ključ ili veza Cloud sesije tima."}},
        "da": {"stringUnit": {"state": "translated", "value": "Det er ikke en nøgle eller et link til en Cloud-session for teamet."}},
        "de": {"stringUnit": {"state": "translated", "value": "Das ist weder Schlüssel noch Link einer Cloud-Sitzung des Teams."}},
        "es": {"stringUnit": {"state": "translated", "value": "No es una clave ni un enlace de una sesión de Cloud del equipo."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Ce n'est ni une clé ni un lien de session Cloud d'équipe."}},
        "it": {"stringUnit": {"state": "translated", "value": "Non è una chiave né un link di una sessione Cloud del team."}},
        "ja": {"stringUnit": {"state": "translated", "value": "チームの Cloud セッションのキーまたはリンクではありません。"}},
        "km": {"stringUnit": {"state": "translated", "value": "នោះមិនមែនជាសោ ឬតំណវគ្គ Cloud របស់ក្រុមទេ។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "팀 Cloud 세션 키나 링크가 아닙니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Det er ikke en nøkkel eller lenke til en Cloud-økt for teamet."}},
        "pl": {"stringUnit": {"state": "translated", "value": "To nie jest klucz ani link sesji Cloud zespołu."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Isso não é uma chave nem um link de sessão do Cloud da equipe."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Это не ключ и не ссылка сеанса Cloud команды."}},
        "th": {"stringUnit": {"state": "translated", "value": "นี่ไม่ใช่คีย์หรือลิงก์ของเซสชัน Cloud ของทีม"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Bu bir ekip Cloud oturumu anahtarı veya bağlantısı değil."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Це не ключ і не посилання сеансу Cloud команди."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Đây không phải khóa hay liên kết của phiên Cloud trong nhóm."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "这不是团队 Cloud 会话的键或链接。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "這不是團隊 Cloud 工作階段的金鑰或連結。"}}
      }
    },
    "cloudTeam.error.attachUnavailable": {
      "comment": "error",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Opening a teammate's Cloud session here is not available yet. Ask its owner to share the chat with you."}},
        "ar": {"stringUnit": {"state": "translated", "value": "فتح جلسة Cloud لزميل هنا غير متاح بعد. اطلب من مالكها مشاركة الدردشة معك."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Otvaranje Cloud sesije člana tima ovdje još nije dostupno. Zamolite vlasnika da podijeli chat s vama."}},
        "da": {"stringUnit": {"state": "translated", "value": "Det er endnu ikke muligt at åbne en holdkammerats Cloud-session her. Bed ejeren om at dele chatten med dig."}},
        "de": {"stringUnit": {"state": "translated", "value": "Die Cloud-Sitzung eines Teammitglieds lässt sich hier noch nicht öffnen. Bitte den Eigentümer, den Chat mit dir zu teilen."}},
        "es": {"stringUnit": {"state": "translated", "value": "Aún no se puede abrir aquí la sesión de Cloud de un compañero. Pide a su propietario que comparta el chat contigo."}},
        "fr": {"stringUnit": {"state": "translated", "value": "L'ouverture ici de la session Cloud d'un coéquipier n'est pas encore disponible. Demandez à son propriétaire de partager le chat avec vous."}},
        "it": {"stringUnit": {"state": "translated", "value": "Aprire qui la sessione Cloud di un collega non è ancora disponibile. Chiedi al proprietario di condividere la chat con te."}},
        "ja": {"stringUnit": {"state": "translated", "value": "チームメイトの Cloud セッションをここで開く機能はまだありません。所有者にチャットを共有してもらってください。"}},
        "km": {"stringUnit": {"state": "translated", "value": "ការបើកវគ្គ Cloud របស់សមាជិកក្រុមនៅទីនេះមិនទាន់មានទេ។ សូមស្នើម្ចាស់ឱ្យចែករំលែកការជជែកជាមួយអ្នក។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "팀원의 Cloud 세션을 여기서 여는 기능은 아직 지원되지 않습니다. 소유자에게 채팅 공유를 요청하세요."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Det er ennå ikke mulig å åpne en lagkamerats Cloud-økt her. Be eieren dele chatten med deg."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Otwieranie tutaj sesji Cloud członka zespołu nie jest jeszcze dostępne. Poproś właściciela o udostępnienie czatu."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ainda não é possível abrir aqui a sessão do Cloud de um colega. Peça ao proprietário para compartilhar o chat com você."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Открывать здесь сеанс Cloud коллеги пока нельзя. Попросите владельца поделиться с вами чатом."}},
        "th": {"stringUnit": {"state": "translated", "value": "ยังเปิดเซสชัน Cloud ของเพื่อนร่วมทีมที่นี่ไม่ได้ โปรดขอให้เจ้าของแชร์แชตกับคุณ"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Bir ekip arkadaşının Cloud oturumunu burada açmak henüz mümkün değil. Sahibinden sohbeti sizinle paylaşmasını isteyin."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Відкривати тут сеанс Cloud колеги поки не можна. Попросіть власника поділитися з вами чатом."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Chưa thể mở phiên Cloud của đồng đội ở đây. Hãy nhờ chủ sở hữu chia sẻ cuộc trò chuyện với bạn."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "暂时还不能在这里打开队友的 Cloud 会话。请让其所有者与你共享聊天。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "暫時還無法在這裡開啟隊友的 Cloud 工作階段。請擁有者與你分享聊天。"}}
      }
    },
    "cloudTeam.error.notMember": {
      "comment": "error",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "You are not a member of this session's team."}},
        "ar": {"stringUnit": {"state": "translated", "value": "لست عضوًا في فريق هذه الجلسة."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Niste član tima ove sesije."}},
        "da": {"stringUnit": {"state": "translated", "value": "Du er ikke medlem af denne sessions team."}},
        "de": {"stringUnit": {"state": "translated", "value": "Du bist kein Mitglied des Teams dieser Sitzung."}},
        "es": {"stringUnit": {"state": "translated", "value": "No eres miembro del equipo de esta sesión."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vous n'êtes pas membre de l'équipe de cette session."}},
        "it": {"stringUnit": {"state": "translated", "value": "Non sei membro del team di questa sessione."}},
        "ja": {"stringUnit": {"state": "translated", "value": "このセッションのチームのメンバーではありません。"}},
        "km": {"stringUnit": {"state": "translated", "value": "អ្នកមិនមែនជាសមាជិកក្រុមរបស់វគ្គនេះទេ។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 세션 팀의 멤버가 아닙니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Du er ikke medlem av teamet til denne økten."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Nie jesteś członkiem zespołu tej sesji."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Você não é membro da equipe desta sessão."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Вы не состоите в команде этого сеанса."}},
        "th": {"stringUnit": {"state": "translated", "value": "คุณไม่ได้เป็นสมาชิกของทีมในเซสชันนี้"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Bu oturumun ekibinin üyesi değilsiniz."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Ви не є учасником команди цього сеансу."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Bạn không phải thành viên nhóm của phiên này."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "你不是此会话所属团队的成员。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "你不是此工作階段所屬團隊的成員。"}}
      }
    },
    "cloudTeam.error.gone": {
      "comment": "error",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This Cloud session was closed or removed."}},
        "ar": {"stringUnit": {"state": "translated", "value": "أُغلقت جلسة Cloud هذه أو أزيلت."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Ova Cloud sesija je zatvorena ili uklonjena."}},
        "da": {"stringUnit": {"state": "translated", "value": "Denne Cloud-session er lukket eller fjernet."}},
        "de": {"stringUnit": {"state": "translated", "value": "Diese Cloud-Sitzung wurde geschlossen oder entfernt."}},
        "es": {"stringUnit": {"state": "translated", "value": "Esta sesión de Cloud se cerró o se quitó."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Cette session Cloud a été fermée ou retirée."}},
        "it": {"stringUnit": {"state": "translated", "value": "Questa sessione Cloud è stata chiusa o rimossa."}},
        "ja": {"stringUnit": {"state": "translated", "value": "この Cloud セッションは閉じられたか削除されました。"}},
        "km": {"stringUnit": {"state": "translated", "value": "វគ្គ Cloud នេះត្រូវបានបិទ ឬដកចេញ។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 Cloud 세션은 닫혔거나 제거되었습니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Denne Cloud-økten er lukket eller fjernet."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Ta sesja Cloud została zamknięta lub usunięta."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Esta sessão do Cloud foi fechada ou removida."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Этот сеанс Cloud закрыт или удалён."}},
        "th": {"stringUnit": {"state": "translated", "value": "เซสชัน Cloud นี้ถูกปิดหรือนำออกแล้ว"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Bu Cloud oturumu kapatıldı veya kaldırıldı."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Цей сеанс Cloud закрито або вилучено."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Phiên Cloud này đã bị đóng hoặc gỡ bỏ."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "此 Cloud 会话已关闭或移除。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "此 Cloud 工作階段已關閉或移除。"}}
      }
    },
    "cloudTeam.error.notOpenHere": {
      "comment": "error",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This session's machine is not connected on this Mac. Connect to the machine, then open the link again."}},
        "ar": {"stringUnit": {"state": "translated", "value": "جهاز هذه الجلسة غير متصل على هذا الـ Mac. اتصل بالجهاز ثم افتح الرابط مرة أخرى."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Mašina ove sesije nije povezana na ovom Macu. Povežite se s mašinom pa ponovo otvorite vezu."}},
        "da": {"stringUnit": {"state": "translated", "value": "Denne sessions maskine er ikke forbundet på denne Mac. Opret forbindelse til maskinen, og åbn linket igen."}},
        "de": {"stringUnit": {"state": "translated", "value": "Die Maschine dieser Sitzung ist auf diesem Mac nicht verbunden. Verbinde dich mit der Maschine und öffne den Link erneut."}},
        "es": {"stringUnit": {"state": "translated", "value": "La máquina de esta sesión no está conectada en este Mac. Conéctate a la máquina y vuelve a abrir el enlace."}},
        "fr": {"stringUnit": {"state": "translated", "value": "La machine de cette session n'est pas connectée sur ce Mac. Connectez-vous à la machine, puis rouvrez le lien."}},
        "it": {"stringUnit": {"state": "translated", "value": "La macchina di questa sessione non è connessa su questo Mac. Connettiti alla macchina, poi riapri il link."}},
        "ja": {"stringUnit": {"state": "translated", "value": "このセッションのマシンはこの Mac に接続されていません。マシンに接続してから、もう一度リンクを開いてください。"}},
        "km": {"stringUnit": {"state": "translated", "value": "ម៉ាស៊ីនរបស់វគ្គនេះមិនបានភ្ជាប់នៅលើ Mac នេះទេ។ ភ្ជាប់ទៅម៉ាស៊ីន រួចបើកតំណម្ដងទៀត។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 세션의 머신이 이 Mac에 연결되어 있지 않습니다. 머신에 연결한 다음 링크를 다시 여세요."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Maskinen til denne økten er ikke tilkoblet på denne Macen. Koble til maskinen, og åpne lenken på nytt."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Maszyna tej sesji nie jest połączona na tym Macu. Połącz się z maszyną i otwórz link ponownie."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A máquina desta sessão não está conectada neste Mac. Conecte-se à máquina e abra o link novamente."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Машина этого сеанса не подключена на этом Mac. Подключитесь к машине и снова откройте ссылку."}},
        "th": {"stringUnit": {"state": "translated", "value": "เครื่องของเซสชันนี้ไม่ได้เชื่อมต่อบน Mac เครื่องนี้ เชื่อมต่อกับเครื่องแล้วเปิดลิงก์อีกครั้ง"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Bu oturumun makinesi bu Mac'te bağlı değil. Makineye bağlanın, ardından bağlantıyı yeniden açın."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Машина цього сеансу не підключена на цьому Mac. Підключіться до машини й знову відкрийте посилання."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Máy của phiên này chưa kết nối trên máy Mac này. Hãy kết nối với máy rồi mở lại liên kết."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "此会话的机器未在这台 Mac 上连接。请先连接该机器，再重新打开链接。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "此工作階段的機器未在這台 Mac 上連線。請先連線到該機器，再重新開啟連結。"}}
      }
    },
    "cloudTeam.error.memberRequired": {
      "comment": "error; keep --to and the command as written",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Name the member with --to (a user id from cmux cloud team-members)."}},
        "ar": {"stringUnit": {"state": "translated", "value": "حدّد العضو باستخدام --to (معرّف مستخدم من cmux cloud team-members)."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Navedite člana pomoću --to (ID korisnika iz cmux cloud team-members)."}},
        "da": {"stringUnit": {"state": "translated", "value": "Angiv medlemmet med --to (et bruger-id fra cmux cloud team-members)."}},
        "de": {"stringUnit": {"state": "translated", "value": "Gib das Mitglied mit --to an (eine Benutzer-ID aus cmux cloud team-members)."}},
        "es": {"stringUnit": {"state": "translated", "value": "Indica el miembro con --to (un ID de usuario de cmux cloud team-members)."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Indiquez le membre avec --to (un identifiant utilisateur de cmux cloud team-members)."}},
        "it": {"stringUnit": {"state": "translated", "value": "Indica il membro con --to (un ID utente da cmux cloud team-members)."}},
        "ja": {"stringUnit": {"state": "translated", "value": "--to でメンバーを指定してください（cmux cloud team-members のユーザー ID）。"}},
        "km": {"stringUnit": {"state": "translated", "value": "កំណត់សមាជិកដោយ --to (លេខសម្គាល់អ្នកប្រើពី cmux cloud team-members)។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "--to로 멤버를 지정하세요(cmux cloud team-members의 사용자 ID)."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Angi medlemmet med --to (en bruker-ID fra cmux cloud team-members)."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Wskaż członka za pomocą --to (identyfikator użytkownika z cmux cloud team-members)."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Indique o membro com --to (um ID de usuário de cmux cloud team-members)."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Укажите участника через --to (ID пользователя из cmux cloud team-members)."}},
        "th": {"stringUnit": {"state": "translated", "value": "ระบุสมาชิกด้วย --to (รหัสผู้ใช้จาก cmux cloud team-members)"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Üyeyi --to ile belirtin (cmux cloud team-members içindeki bir kullanıcı kimliği)."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Вкажіть учасника через --to (ID користувача з cmux cloud team-members)."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Chỉ định thành viên bằng --to (một ID người dùng từ cmux cloud team-members)."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "用 --to 指定成员（cmux cloud team-members 中的用户 ID）。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "用 --to 指定成員（cmux cloud team-members 中的使用者 ID）。"}}
      }
    },
    "cloudTeam.error.groupRequired": {
      "comment": "error; keep the flags as written",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Name the cloud group with --group and the member with --user."}},
        "ar": {"stringUnit": {"state": "translated", "value": "حدّد مجموعة السحابة باستخدام --group والعضو باستخدام --user."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Navedite cloud grupu pomoću --group i člana pomoću --user."}},
        "da": {"stringUnit": {"state": "translated", "value": "Angiv cloud-gruppen med --group og medlemmet med --user."}},
        "de": {"stringUnit": {"state": "translated", "value": "Gib die Cloud-Gruppe mit --group und das Mitglied mit --user an."}},
        "es": {"stringUnit": {"state": "translated", "value": "Indica el grupo de Cloud con --group y el miembro con --user."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Indiquez le groupe Cloud avec --group et le membre avec --user."}},
        "it": {"stringUnit": {"state": "translated", "value": "Indica il gruppo Cloud con --group e il membro con --user."}},
        "ja": {"stringUnit": {"state": "translated", "value": "--group でクラウドグループを、--user でメンバーを指定してください。"}},
        "km": {"stringUnit": {"state": "translated", "value": "កំណត់ក្រុម cloud ដោយ --group និងសមាជិកដោយ --user។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "--group으로 클라우드 그룹을, --user로 멤버를 지정하세요."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Angi skygruppen med --group og medlemmet med --user."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Wskaż grupę Cloud za pomocą --group, a członka za pomocą --user."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Indique o grupo do Cloud com --group e o membro com --user."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Укажите облачную группу через --group, а участника через --user."}},
        "th": {"stringUnit": {"state": "translated", "value": "ระบุกลุ่มคลาวด์ด้วย --group และสมาชิกด้วย --user"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Bulut grubunu --group, üyeyi --user ile belirtin."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Вкажіть хмарну групу через --group, а учасника через --user."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Chỉ định nhóm đám mây bằng --group và thành viên bằng --user."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "用 --group 指定云组，用 --user 指定成员。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "用 --group 指定雲端群組，用 --user 指定成員。"}}
      }
    },
    "cloudTeam.error.refused": {
      "comment": "%@ is the error code",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The Cloud service refused this (%@)."}},
        "ar": {"stringUnit": {"state": "translated", "value": "رفضت خدمة Cloud هذا الطلب (%@)."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Cloud usluga je ovo odbila (%@)."}},
        "da": {"stringUnit": {"state": "translated", "value": "Cloud-tjenesten afviste dette (%@)."}},
        "de": {"stringUnit": {"state": "translated", "value": "Der Cloud-Dienst hat dies abgelehnt (%@)."}},
        "es": {"stringUnit": {"state": "translated", "value": "El servicio de Cloud lo rechazó (%@)."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le service Cloud a refusé (%@)."}},
        "it": {"stringUnit": {"state": "translated", "value": "Il servizio Cloud ha rifiutato (%@)."}},
        "ja": {"stringUnit": {"state": "translated", "value": "Cloud サービスに拒否されました（%@）。"}},
        "km": {"stringUnit": {"state": "translated", "value": "សេវា Cloud បានបដិសេធការនេះ (%@)។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "Cloud 서비스가 거부했습니다(%@)."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Cloud-tjenesten avviste dette (%@)."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Usługa Cloud odrzuciła to (%@)."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O serviço do Cloud recusou isto (%@)."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Сервис Cloud отклонил запрос (%@)."}},
        "th": {"stringUnit": {"state": "translated", "value": "บริการ Cloud ปฏิเสธคำขอนี้ (%@)"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Cloud hizmeti bunu reddetti (%@)."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Сервіс Cloud відхилив запит (%@)."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Dịch vụ Cloud đã từ chối (%@)."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "Cloud 服务拒绝了此操作（%@）。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "Cloud 服務拒絕了此操作（%@）。"}}
      }
    }
  },
  "version": "1.0"
}
