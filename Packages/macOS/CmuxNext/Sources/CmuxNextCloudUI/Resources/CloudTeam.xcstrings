    "cloudTeam.empty.mine": {
      "comment": "empty filter",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Nothing is assigned to you."}},
        "ar": {"stringUnit": {"state": "translated", "value": "لا شيء مسند إليك."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Ništa vam nije dodijeljeno."}},
        "da": {"stringUnit": {"state": "translated", "value": "Intet er tildelt dig."}},
        "de": {"stringUnit": {"state": "translated", "value": "Dir ist nichts zugewiesen."}},
        "es": {"stringUnit": {"state": "translated", "value": "No tienes nada asignado."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Rien ne vous est attribué."}},
        "it": {"stringUnit": {"state": "translated", "value": "Non hai nulla di assegnato."}},
        "ja": {"stringUnit": {"state": "translated", "value": "担当はありません。"}},
        "km": {"stringUnit": {"state": "translated", "value": "មិនមានអ្វីបានចាត់ឱ្យអ្នកទេ។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "할당된 항목이 없습니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Ingenting er tildelt deg."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Nic nie jest do Ciebie przypisane."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Nada foi atribuído a você."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Вам ничего не назначено."}},
        "th": {"stringUnit": {"state": "translated", "value": "ไม่มีงานที่มอบหมายให้คุณ"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Size atanmış bir şey yok."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Вам нічого не призначено."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Không có gì được giao cho bạn."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "没有分配给你的内容。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "沒有指派給你的項目。"}}
      }
    },
    "cloudTeam.empty.team": {
      "comment": "empty filter",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Your team has no Cloud sessions yet."}},
        "ar": {"stringUnit": {"state": "translated", "value": "لا توجد لدى فريقك جلسات Cloud بعد."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Vaš tim još nema Cloud sesija."}},
        "da": {"stringUnit": {"state": "translated", "value": "Dit team har ingen Cloud-sessioner endnu."}},
        "de": {"stringUnit": {"state": "translated", "value": "Dein Team hat noch keine Cloud-Sitzungen."}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu equipo aún no tiene sesiones de Cloud."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre équipe n'a pas encore de sessions Cloud."}},
        "it": {"stringUnit": {"state": "translated", "value": "Il tuo team non ha ancora sessioni Cloud."}},
        "ja": {"stringUnit": {"state": "translated", "value": "チームの Cloud セッションはまだありません。"}},
        "km": {"stringUnit": {"state": "translated", "value": "ក្រុមរបស់អ្នកមិនទាន់មានវគ្គ Cloud នៅឡើយទេ។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "팀에 아직 Cloud 세션이 없습니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Teamet ditt har ingen Cloud-økter ennå."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Twój zespół nie ma jeszcze sesji Cloud."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sua equipe ainda não tem sessões do Cloud."}},
        "ru": {"stringUnit": {"state": "translated", "value": "У вашей команды пока нет сеансов Cloud."}},
        "th": {"stringUnit": {"state": "translated", "value": "ทีมของคุณยังไม่มีเซสชัน Cloud"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Ekibinizin henüz Cloud oturumu yok."}},
        "uk": {"stringUnit": {"state": "translated", "value": "У вашої команди ще немає сеансів Cloud."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Nhóm của bạn chưa có phiên Cloud nào."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "你的团队还没有 Cloud 会话。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "你的團隊還沒有 Cloud 工作階段。"}}
      }
    },
