        "da": {"stringUnit": {"state": "translated", "value": "Inaktiv"}},
        "de": {"stringUnit": {"state": "translated", "value": "Untätig"}},
        "es": {"stringUnit": {"state": "translated", "value": "Inactiva"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Inactive"}},
        "it": {"stringUnit": {"state": "translated", "value": "Inattiva"}},
        "ja": {"stringUnit": {"state": "translated", "value": "待機中"}},
        "km": {"stringUnit": {"state": "translated", "value": "ទំនេរ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "대기 중"}},
