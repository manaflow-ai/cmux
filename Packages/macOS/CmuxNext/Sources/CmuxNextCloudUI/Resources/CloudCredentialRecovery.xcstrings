{
  "sourceLanguage": "en",
  "strings": {
    "cloud.codexSignInConsent.title": {
      "comment": "One-time consent dialog title before cmux uses this Mac's Codex sign-in for the person's own Cloud machines.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Use my Codex login on my own Cloud machines?"}},
        "ar": {"stringUnit": {"state": "translated", "value": "هل تريد استخدام تسجيل دخول Codex الخاص بي على أجهزة Cloud الخاصة بي؟"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Koristiti moju Codex prijavu na mojim Cloud mašinama?"}},
        "da": {"stringUnit": {"state": "translated", "value": "Brug mit Codex-login på mine egne Cloud-maskiner?"}},
        "de": {"stringUnit": {"state": "translated", "value": "Mein Codex-Login auf meinen eigenen Cloud-Maschinen verwenden?"}},
        "es": {"stringUnit": {"state": "translated", "value": "¿Usar mi inicio de sesión de Codex en mis propias máquinas Cloud?"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Utiliser ma connexion Codex sur mes propres machines Cloud ?"}},
        "it": {"stringUnit": {"state": "translated", "value": "Usare il mio accesso Codex sulle mie macchine Cloud?"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分の Cloud マシンで自分の Codex ログインを使用しますか？"}},
        "km": {"stringUnit": {"state": "translated", "value": "ប្រើការចូល Codex របស់ខ្ញុំលើម៉ាស៊ីន Cloud ផ្ទាល់ខ្លួនរបស់ខ្ញុំឬ?"}},
        "ko": {"stringUnit": {"state": "translated", "value": "내 Cloud 머신에서 내 Codex 로그인을 사용할까요?"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Bruke Codex-påloggingen min på mine egne Cloud-maskiner?"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Używać mojego logowania Codex na moich maszynach Cloud?"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Usar meu login do Codex nas minhas próprias máquinas Cloud?"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Использовать мой вход в Codex на моих машинах Cloud?"}},
        "th": {"stringUnit": {"state": "translated", "value": "ใช้การเข้าสู่ระบบ Codex ของฉันบนเครื่อง Cloud ของฉันเองไหม"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Kendi Cloud makinelerimde Codex oturumum kullanılsın mı?"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Використовувати мій вхід у Codex на моїх машинах Cloud?"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Dùng đăng nhập Codex của tôi trên máy Cloud của riêng tôi?"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "在我自己的 Cloud 机器上使用我的 Codex 登录？"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "在我自己的 Cloud 機器上使用我的 Codex 登入？"}}
      }
    },
    "cloud.codexSignInConsent.body": {
      "comment": "Body of the one-time Codex sign-in consent: what moves to the Cloud machine and what stays on the Mac.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "cmux gives Cloud machines you own short-lived access from the Codex sign-in on this Mac. This Mac keeps the refresh token, so you stay signed in here, and cmux never stores it."}},
        "ar": {"stringUnit": {"state": "translated", "value": "يمنح cmux أجهزة Cloud التي تملكها وصولاً قصير الأمد من تسجيل دخول Codex على هذا الـ Mac. يحتفظ هذا الـ Mac برمز التحديث، فتبقى مسجّل الدخول هنا، ولا يخزّنه cmux أبداً."}},
        "bs": {"stringUnit": {"state": "translated", "value": "cmux daje Cloud mašinama koje posjeduješ kratkotrajan pristup iz Codex prijave na ovom Macu. Ovaj Mac zadržava refresh token, pa ovdje ostaješ prijavljen, a cmux ga nikad ne čuva."}},
        "da": {"stringUnit": {"state": "translated", "value": "cmux giver Cloud-maskiner, du ejer, kortvarig adgang fra Codex-loginet på denne Mac. Denne Mac beholder refresh-tokenet, så du forbliver logget ind her, og cmux gemmer det aldrig."}},
        "de": {"stringUnit": {"state": "translated", "value": "cmux gibt Cloud-Maschinen, die dir gehören, kurzlebigen Zugriff aus dem Codex-Login dieses Macs. Dieser Mac behält das Refresh-Token, sodass du hier angemeldet bleibst, und cmux speichert es nie."}},
        "es": {"stringUnit": {"state": "translated", "value": "cmux da a las máquinas Cloud que te pertenecen acceso de corta duración desde el inicio de sesión de Codex de este Mac. Este Mac conserva el token de actualización, así que sigues con la sesión iniciada aquí, y cmux nunca lo guarda."}},
        "fr": {"stringUnit": {"state": "translated", "value": "cmux donne aux machines Cloud qui vous appartiennent un accès de courte durée depuis la connexion Codex de ce Mac. Ce Mac garde le jeton d’actualisation, vous restez donc connecté ici, et cmux ne le stocke jamais."}},
        "it": {"stringUnit": {"state": "translated", "value": "cmux dà alle macchine Cloud di tua proprietà un accesso di breve durata dall’accesso Codex di questo Mac. Questo Mac conserva il refresh token, così resti connesso qui, e cmux non lo salva mai."}},
        "ja": {"stringUnit": {"state": "translated", "value": "cmux は、この Mac の Codex サインインから自分の Cloud マシンに短期間のアクセスを渡します。リフレッシュトークンはこの Mac に残るので、ここでのサインインは保たれ、cmux が保存することもありません。"}},
        "km": {"stringUnit": {"state": "translated", "value": "cmux ផ្តល់ការចូលប្រើរយៈពេលខ្លីពីការចូល Codex លើ Mac នេះ ទៅម៉ាស៊ីន Cloud ដែលអ្នកជាម្ចាស់។ Mac នេះរក្សា refresh token ដូច្នេះអ្នកនៅតែបានចូលនៅទីនេះ ហើយ cmux មិនដែលរក្សាទុកវាទេ។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "cmux는 이 Mac의 Codex 로그인으로 내가 소유한 Cloud 머신에 단기 액세스를 제공합니다. 새로 고침 토큰은 이 Mac에 남아 있어 여기서 로그인 상태가 유지되며, cmux는 이를 저장하지 않습니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "cmux gir Cloud-maskiner du eier kortvarig tilgang fra Codex-påloggingen på denne Macen. Denne Macen beholder refresh-tokenet, så du forblir pålogget her, og cmux lagrer det aldri."}},
        "pl": {"stringUnit": {"state": "translated", "value": "cmux daje maszynom Cloud, których jesteś właścicielem, krótkotrwały dostęp z logowania Codex na tym Macu. Ten Mac zachowuje token odświeżania, więc tu pozostajesz zalogowany, a cmux nigdy go nie przechowuje."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O cmux dá às máquinas Cloud que você possui acesso de curta duração a partir do login do Codex neste Mac. Este Mac mantém o token de atualização, então você continua conectado aqui, e o cmux nunca o armazena."}},
        "ru": {"stringUnit": {"state": "translated", "value": "cmux даёт вашим машинам Cloud краткосрочный доступ из входа в Codex на этом Mac. Refresh-токен остаётся на этом Mac, поэтому здесь вы остаётесь в системе, а cmux никогда его не хранит."}},
        "th": {"stringUnit": {"state": "translated", "value": "cmux ให้เครื่อง Cloud ที่คุณเป็นเจ้าของได้รับสิทธิ์เข้าถึงระยะสั้นจากการเข้าสู่ระบบ Codex บน Mac เครื่องนี้ Mac เครื่องนี้เก็บโทเค็นรีเฟรชไว้ คุณจึงยังเข้าสู่ระบบอยู่ที่นี่ และ cmux ไม่เคยจัดเก็บโทเค็นนี้"}},
        "tr": {"stringUnit": {"state": "translated", "value": "cmux, sahibi olduğun Cloud makinelerine bu Mac'teki Codex oturumundan kısa süreli erişim verir. Yenileme token'ı bu Mac'te kalır, böylece burada oturumun açık kalır ve cmux onu asla saklamaz."}},
        "uk": {"stringUnit": {"state": "translated", "value": "cmux надає вашим машинам Cloud короткочасний доступ із входу в Codex на цьому Mac. Refresh-токен лишається на цьому Mac, тож тут ви залишаєтеся в системі, а cmux ніколи його не зберігає."}},
        "vi": {"stringUnit": {"state": "translated", "value": "cmux cấp cho máy Cloud bạn sở hữu quyền truy cập ngắn hạn từ đăng nhập Codex trên máy Mac này. Máy Mac này giữ refresh token nên bạn vẫn đăng nhập ở đây, và cmux không bao giờ lưu nó."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "cmux 用这台 Mac 上的 Codex 登录，为你拥有的 Cloud 机器提供短期访问权限。刷新令牌留在这台 Mac 上，所以你在这里保持登录，cmux 也从不存储它。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "cmux 用這台 Mac 上的 Codex 登入，為你擁有的 Cloud 機器提供短期存取權。重新整理權杖留在這台 Mac 上，所以你在這裡保持登入，cmux 也從不儲存它。"}}
      }
    },
    "cloud.codexSignInConsent.settings": {
      "comment": "Second line of the one-time Codex sign-in consent: where to turn it off.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "You can turn this off in Settings > Machines."}},
        "ar": {"stringUnit": {"state": "translated", "value": "يمكنك إيقاف هذا في الإعدادات > الأجهزة."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Ovo možeš isključiti u Postavke > Mašine."}},
        "da": {"stringUnit": {"state": "translated", "value": "Du kan slå dette fra under Indstillinger > Maskiner."}},
        "de": {"stringUnit": {"state": "translated", "value": "Du kannst das unter Einstellungen > Maschinen ausschalten."}},
        "es": {"stringUnit": {"state": "translated", "value": "Puedes desactivarlo en Ajustes > Máquinas."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vous pouvez le désactiver dans Réglages > Machines."}},
        "it": {"stringUnit": {"state": "translated", "value": "Puoi disattivarlo in Impostazioni > Macchine."}},
        "ja": {"stringUnit": {"state": "translated", "value": "これは「設定」>「マシン」でオフにできます。"}},
        "km": {"stringUnit": {"state": "translated", "value": "អ្នកអាចបិទវានៅក្នុង ការកំណត់ > ម៉ាស៊ីន។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "설정 > 머신에서 끌 수 있습니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Du kan slå dette av i Innstillinger > Maskiner."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Możesz to wyłączyć w Ustawienia > Maszyny."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Você pode desativar isso em Ajustes > Máquinas."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Это можно отключить в «Настройки» > «Машины»."}},
        "th": {"stringUnit": {"state": "translated", "value": "คุณปิดได้ที่ การตั้งค่า > เครื่อง"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Bunu Ayarlar > Makineler'den kapatabilirsin."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Це можна вимкнути в «Налаштування» > «Машини»."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Bạn có thể tắt trong Cài đặt > Máy."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "你可以在“设置”>“机器”中关闭此功能。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "你可以在「設定」>「機器」中關閉此功能。"}}
      }
    },
    "cloud.loginCopyConsent.accept": {
      "comment": "One-time consent dialog: button that agrees to copy the person's own Claude login to their own Cloud machines.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Use My Login"}},
        "ar": {"stringUnit": {"state": "translated", "value": "استخدام تسجيل دخولي"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Koristi moju prijavu"}},
        "da": {"stringUnit": {"state": "translated", "value": "Brug mit login"}},
        "de": {"stringUnit": {"state": "translated", "value": "Meine Anmeldung verwenden"}},
        "es": {"stringUnit": {"state": "translated", "value": "Usar mi inicio de sesión"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Utiliser ma connexion"}},
        "it": {"stringUnit": {"state": "translated", "value": "Usa il mio accesso"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分のログインを使う"}},
        "km": {"stringUnit": {"state": "translated", "value": "ប្រើការចូលរបស់ខ្ញុំ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "내 로그인 사용"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Bruk min pålogging"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Użyj mojego logowania"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Usar meu login"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Использовать мой вход"}},
        "th": {"stringUnit": {"state": "translated", "value": "ใช้การลงชื่อเข้าใช้ของฉัน"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Oturumumu kullan"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Використати мій вхід"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Dùng đăng nhập của tôi"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "使用我的登录"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "使用我的登入"}}
      }
    },
    "cloud.loginCopyConsent.body": {
      "comment": "One-time consent dialog: what happens and the limits.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "cmux copies your own Claude login from this Mac to Cloud machines you own, so their chats start signed in. It never goes to team or shared machines, and cmux never stores it."}},
        "ar": {"stringUnit": {"state": "translated", "value": "ينسخ cmux تسجيل دخول Claude الخاص بك من هذا الـ Mac إلى أجهزة Cloud التي تملكها، فتبدأ محادثاتها وأنت مسجّل الدخول. لا يُرسل أبدًا إلى أجهزة الفريق أو المشتركة، ولا يخزّنه cmux أبدًا."}},
        "bs": {"stringUnit": {"state": "translated", "value": "cmux kopira vašu Claude prijavu s ovog Maca na Cloud mašine koje posjedujete, pa njihovi razgovori počinju prijavljeni. Nikad ne ide na timske ili dijeljene mašine, a cmux je nikad ne pohranjuje."}},
        "da": {"stringUnit": {"state": "translated", "value": "cmux kopierer dit eget Claude-login fra denne Mac til Cloud-maskiner, du ejer, så deres chats starter logget ind. Det går aldrig til team- eller delte maskiner, og cmux gemmer det aldrig."}},
        "de": {"stringUnit": {"state": "translated", "value": "cmux kopiert deine eigene Claude-Anmeldung von diesem Mac auf Cloud-Maschinen, die dir gehören, damit ihre Chats angemeldet starten. Sie geht nie an Team- oder geteilte Maschinen, und cmux speichert sie nie."}},
        "es": {"stringUnit": {"state": "translated", "value": "cmux copia tu propio inicio de sesión de Claude de este Mac a las máquinas Cloud que tienes, para que sus chats empiecen con la sesión iniciada. Nunca va a máquinas de equipo o compartidas, y cmux nunca lo guarda."}},
        "fr": {"stringUnit": {"state": "translated", "value": "cmux copie votre propre connexion Claude de ce Mac vers les machines Cloud que vous possédez, afin que leurs conversations démarrent connectées. Elle ne va jamais vers des machines d’équipe ou partagées, et cmux ne la stocke jamais."}},
        "it": {"stringUnit": {"state": "translated", "value": "cmux copia il tuo accesso a Claude da questo Mac alle macchine Cloud che possiedi, così le loro chat partono già connesse. Non va mai su macchine del team o condivise, e cmux non lo salva mai."}},
        "ja": {"stringUnit": {"state": "translated", "value": "cmux は、あなた自身の Claude ログインをこの Mac からあなたが所有する Cloud マシンにコピーし、チャットがログイン済みで始まるようにします。チームや共有マシンには送られず、cmux が保存することもありません。"}},
        "km": {"stringUnit": {"state": "translated", "value": "cmux ចម្លងការចូល Claude ផ្ទាល់ខ្លួនរបស់អ្នកពី Mac នេះទៅម៉ាស៊ីន Cloud ដែលអ្នកមាន ដើម្បីឱ្យការជជែករបស់វាចាប់ផ្តើមដោយបានចូលរួចហើយ។ វាមិនដែលទៅម៉ាស៊ីនក្រុម ឬម៉ាស៊ីនចែករំលែកទេ ហើយ cmux មិនដែលរក្សាទុកវាទេ។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "cmux는 이 Mac의 내 Claude 로그인을 내가 소유한 Cloud 머신에 복사해 채팅이 로그인된 상태로 시작되게 합니다. 팀 또는 공유 머신에는 절대 전달되지 않으며 cmux는 이를 저장하지 않습니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "cmux kopierer din egen Claude-pålogging fra denne Macen til Cloud-maskiner du eier, slik at chattene starter pålogget. Den går aldri til team- eller delte maskiner, og cmux lagrer den aldri."}},
        "pl": {"stringUnit": {"state": "translated", "value": "cmux kopiuje Twoje logowanie do Claude z tego Maca na należące do Ciebie maszyny Cloud, aby ich czaty startowały zalogowane. Nigdy nie trafia na maszyny zespołu ani współdzielone, a cmux nigdy go nie przechowuje."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O cmux copia seu próprio login do Claude deste Mac para as máquinas Cloud que você possui, para que os chats delas comecem conectados. Ele nunca vai para máquinas de equipe ou compartilhadas, e o cmux nunca o armazena."}},
        "ru": {"stringUnit": {"state": "translated", "value": "cmux копирует ваш собственный вход в Claude с этого Mac на принадлежащие вам облачные машины, чтобы их чаты начинались с выполненным входом. Он никогда не попадает на командные или общие машины, и cmux его не хранит."}},
        "th": {"stringUnit": {"state": "translated", "value": "cmux คัดลอกการลงชื่อเข้าใช้ Claude ของคุณเองจาก Mac เครื่องนี้ไปยังเครื่อง Cloud ที่คุณเป็นเจ้าของ เพื่อให้แชตเริ่มต้นโดยลงชื่อเข้าใช้แล้ว จะไม่ส่งไปยังเครื่องของทีมหรือเครื่องที่ใช้ร่วมกัน และ cmux ไม่เก็บไว้"}},
        "tr": {"stringUnit": {"state": "translated", "value": "cmux, kendi Claude oturumunuzu bu Mac’ten sahip olduğunuz Cloud makinelerine kopyalar, böylece sohbetleri oturum açık başlar. Ekip veya paylaşılan makinelere asla gitmez ve cmux onu asla saklamaz."}},
        "uk": {"stringUnit": {"state": "translated", "value": "cmux копіює ваш власний вхід у Claude з цього Mac на хмарні машини, якими ви володієте, щоб їхні чати починалися з виконаним входом. Він ніколи не потрапляє на командні чи спільні машини, і cmux його не зберігає."}},
        "vi": {"stringUnit": {"state": "translated", "value": "cmux sao chép đăng nhập Claude của chính bạn từ Mac này sang các máy Cloud bạn sở hữu, để các cuộc trò chuyện bắt đầu khi đã đăng nhập. Nó không bao giờ được gửi sang máy của nhóm hoặc máy dùng chung, và cmux không bao giờ lưu nó."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "cmux 会将你自己的 Claude 登录从这台 Mac 复制到你拥有的 Cloud 机器，使其聊天启动时已登录。它绝不会发送到团队或共享机器，cmux 也从不存储它。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "cmux 會將你自己的 Claude 登入從這台 Mac 複製到你擁有的 Cloud 機器，讓其聊天啟動時已登入。它絕不會傳送到團隊或共享機器，cmux 也從不儲存它。"}}
      }
    },
    "cloud.loginCopyConsent.decline": {
      "comment": "One-time consent dialog: button that declines copying the Claude login.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Don't Use"}},
        "ar": {"stringUnit": {"state": "translated", "value": "لا تستخدم"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Ne koristi"}},
        "da": {"stringUnit": {"state": "translated", "value": "Brug ikke"}},
        "de": {"stringUnit": {"state": "translated", "value": "Nicht verwenden"}},
        "es": {"stringUnit": {"state": "translated", "value": "No usar"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Ne pas utiliser"}},
        "it": {"stringUnit": {"state": "translated", "value": "Non usare"}},
        "ja": {"stringUnit": {"state": "translated", "value": "使用しない"}},
        "km": {"stringUnit": {"state": "translated", "value": "កុំប្រើ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "사용 안 함"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Ikke bruk"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Nie używaj"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não usar"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Не использовать"}},
        "th": {"stringUnit": {"state": "translated", "value": "ไม่ใช้"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Kullanma"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Не використовувати"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Không dùng"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "不使用"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "不使用"}}
      }
    },
    "cloud.loginCopyConsent.settings": {
      "comment": "One-time consent dialog: where to take it back, and the fallback.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "You can turn this off in Settings > Machines. Without it, each machine offers Sign in to Claude."}},
        "ar": {"stringUnit": {"state": "translated", "value": "يمكنك إيقاف هذا في الإعدادات > الأجهزة. وبدونه، يعرض كل جهاز تسجيل الدخول إلى Claude."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Ovo možete isključiti u Postavke > Računari. Bez toga svaka mašina nudi Prijava na Claude."}},
        "da": {"stringUnit": {"state": "translated", "value": "Du kan slå dette fra i Indstillinger > Maskiner. Uden det tilbyder hver maskine Log ind på Claude."}},
        "de": {"stringUnit": {"state": "translated", "value": "Du kannst das unter Einstellungen > Rechner ausschalten. Ohne sie bietet jede Maschine Bei Claude anmelden an."}},
        "es": {"stringUnit": {"state": "translated", "value": "Puedes desactivarlo en Ajustes > Máquinas. Sin él, cada máquina ofrece Iniciar sesión en Claude."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vous pouvez le désactiver dans Réglages > Machines. Sans cela, chaque machine propose Se connecter à Claude."}},
        "it": {"stringUnit": {"state": "translated", "value": "Puoi disattivarlo in Impostazioni > Macchine. Senza, ogni macchina offre Accedi a Claude."}},
        "ja": {"stringUnit": {"state": "translated", "value": "設定 > マシンでオフにできます。オフの場合、各マシンに「Claude にサインイン」が表示されます。"}},
        "km": {"stringUnit": {"state": "translated", "value": "អ្នកអាចបិទវាបាននៅក្នុងការកំណត់ > ម៉ាស៊ីន។ បើគ្មានវាទេ ម៉ាស៊ីននីមួយៗផ្តល់ជូនចូលទៅ Claude។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "설정 > 머신에서 끌 수 있습니다. 끄면 각 머신에서 Claude에 로그인 옵션이 표시됩니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Du kan slå dette av i Innstillinger > Maskiner. Uten det tilbyr hver maskin Logg på Claude."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Możesz to wyłączyć w Ustawienia > Maszyny. Bez tego każda maszyna oferuje Zaloguj się do Claude."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Você pode desativar isso em Ajustes > Máquinas. Sem isso, cada máquina oferece Entrar no Claude."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Это можно отключить в Настройки > Компьютеры. Без этого каждая машина предлагает Войти в Claude."}},
        "th": {"stringUnit": {"state": "translated", "value": "คุณสามารถปิดได้ที่การตั้งค่า > เครื่อง หากไม่ใช้ แต่ละเครื่องจะแสดงลงชื่อเข้าใช้ Claude"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Bunu Ayarlar > Makineler bölümünden kapatabilirsiniz. Kapalıyken her makine Claude’da oturum aç seçeneğini sunar."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Це можна вимкнути в Налаштування > Комп’ютери. Без цього кожна машина пропонує Увійти в Claude."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Bạn có thể tắt trong Cài đặt > Máy. Nếu tắt, mỗi máy sẽ đưa ra Đăng nhập Claude."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "你可以在“设置 > 机器”中关闭。关闭后，每台机器会提供“登录 Claude”。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "你可以在「設定 > 機器」中關閉。關閉後，每台機器會提供「登入 Claude」。"}}
      }
    },
    "cloud.loginCopyConsent.title": {
      "comment": "One-time consent dialog title before cmux copies the person's own Claude login to Cloud machines they own.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Use my Claude login on my own Cloud machines?"}},
        "ar": {"stringUnit": {"state": "translated", "value": "هل تريد استخدام تسجيل دخول Claude الخاص بي على أجهزة Cloud التي أملكها؟"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Koristiti moju Claude prijavu na mojim Cloud mašinama?"}},
        "da": {"stringUnit": {"state": "translated", "value": "Bruge mit Claude-login på mine egne Cloud-maskiner?"}},
        "de": {"stringUnit": {"state": "translated", "value": "Meine Claude-Anmeldung auf meinen eigenen Cloud-Maschinen verwenden?"}},
        "es": {"stringUnit": {"state": "translated", "value": "¿Usar mi inicio de sesión de Claude en mis propias máquinas Cloud?"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Utiliser ma connexion Claude sur mes propres machines Cloud ?"}},
        "it": {"stringUnit": {"state": "translated", "value": "Usare il mio accesso a Claude sulle mie macchine Cloud?"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分の Claude ログインを自分の Cloud マシンで使いますか？"}},
        "km": {"stringUnit": {"state": "translated", "value": "ប្រើការចូល Claude របស់ខ្ញុំលើម៉ាស៊ីន Cloud ផ្ទាល់ខ្លួនរបស់ខ្ញុំឬ?"}},
        "ko": {"stringUnit": {"state": "translated", "value": "내 Claude 로그인을 내 Cloud 머신에서 사용할까요?"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Bruke min Claude-pålogging på mine egne Cloud-maskiner?"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Używać mojego logowania do Claude na moich maszynach Cloud?"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Usar meu login do Claude nas minhas próprias máquinas Cloud?"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Использовать мой вход в Claude на моих облачных машинах?"}},
        "th": {"stringUnit": {"state": "translated", "value": "ใช้การลงชื่อเข้าใช้ Claude ของฉันบนเครื่อง Cloud ของฉันเองไหม"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Claude oturumum kendi Cloud makinelerimde kullanılsın mı?"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Використовувати мій вхід у Claude на моїх хмарних машинах?"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Dùng đăng nhập Claude của tôi trên các máy Cloud của tôi?"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "在我自己的 Cloud 机器上使用我的 Claude 登录？"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "在我自己的 Cloud 機器上使用我的 Claude 登入？"}}
      }
    }
  },
  "version": "1.0"
}
