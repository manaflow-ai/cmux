    "autoArchive.refusal.badRule": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "auto-archive takes default, never or a number of hours"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تأخذ الأرشفة التلقائية default أو never أو عددًا من الساعات"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "automatsko arhiviranje prima default, never ili broj sati"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "automatisk arkivering tager default, never eller et antal timer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "automatisches Archivieren nimmt default, never oder eine Stundenzahl"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "el archivado automático acepta default, never o un número de horas"
