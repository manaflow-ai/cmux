          "stringUnit": {
            "state": "needs_review",
            "value": "l’archivage automatique accepte default, never ou un nombre d’heures"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "l’archiviazione automatica accetta default, never o un numero di ore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "自動アーカイブには default、never、または時間数を指定します"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការទុកក្នុងប័ណ្ណសារដោយស្វ័យប្រវត្តិទទួល default, never ឬចំនួនម៉ោង"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "자동 보관에는 default, never 또는 시간 수를 지정합니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "automatisk arkivering tar default, never eller et antall timer"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "automatyczna archiwizacja przyjmuje default, never lub liczbę godzin"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "o arquivamento automático aceita default, never ou um número de horas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "автоархивация принимает default, never или число часов"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การเก็บถาวรอัตโนมัติรับ default, never หรือจำนวนชั่วโมง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "otomatik arşivleme default, never veya saat sayısı alır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "автоархівування приймає default, never або кількість годин"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "tự động lưu trữ nhận default, never hoặc số giờ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "自动归档接受 default、never 或小时数"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "自動封存接受 default、never 或小時數"
          }
        }
      }
    },
