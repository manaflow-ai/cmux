            "state": "needs_review",
            "value": "Imposta l’archiviazione automatica del gruppo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "グループの自動アーカイブを設定"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កំណត់ការទុកក្នុងប័ណ្ណសារដោយស្វ័យប្រវត្តិរបស់ក្រុម"
