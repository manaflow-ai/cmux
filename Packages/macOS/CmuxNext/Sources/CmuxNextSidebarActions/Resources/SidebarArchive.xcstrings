        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Definir arquivamento automático do grupo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Задать автоархивацию группы"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ตั้งค่าเก็บถาวรอัตโนมัติของกลุ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Grup otomatik arşivlemesini ayarla"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Налаштувати автоархівування групи"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đặt tự động lưu trữ cho nhóm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "设置组自动归档"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "設定群組自動封存"
          }
