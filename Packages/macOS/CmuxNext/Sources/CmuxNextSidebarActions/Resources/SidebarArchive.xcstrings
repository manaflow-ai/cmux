    "archive.refusal.noOtherWorkspaces": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا توجد مساحات عمل أخرى لأرشفتها. تبقى مساحات العمل المثبتة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nema drugih radnih prostora za arhiviranje. Zakačeni radni prostori ostaju."
