        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "그룹 자동 보관 설정"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Angi automatisk arkivering for gruppen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ustaw automatyczną archiwizację grupy"
