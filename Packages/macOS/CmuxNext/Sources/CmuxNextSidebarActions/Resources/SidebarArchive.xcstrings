        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no other workspaces to archive. Pinned workspaces stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No hay otros espacios de trabajo para archivar. Los fijados se quedan."
