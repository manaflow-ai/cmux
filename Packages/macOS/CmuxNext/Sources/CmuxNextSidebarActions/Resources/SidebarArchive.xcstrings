        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アーカイブする他のワークスペースはありません。ピン留めしたワークスペースは残ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្មានកន្លែងធ្វើការផ្សេងទៀតដើម្បីទុកក្នុងបណ្ណសារទេ។ កន្លែងធ្វើការដែលបានខ្ទាស់នៅដដែល។"
          }
