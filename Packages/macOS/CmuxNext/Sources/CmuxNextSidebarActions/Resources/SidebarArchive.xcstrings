        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der er ingen andre arbejdsområder at arkivere. Fastgjorte arbejdsområder bliver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es gibt keine anderen Arbeitsbereiche zum Archivieren. Angeheftete Arbeitsbereiche bleiben."
