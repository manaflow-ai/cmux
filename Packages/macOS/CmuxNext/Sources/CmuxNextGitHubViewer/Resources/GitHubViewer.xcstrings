    "github.diff.unavailable": {
      "comment": "The GitHub page's message when the pull request's diff could not be read",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The diff could not be read. Check that the GitHub CLI (gh) is signed in, then try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة الفروقات. تحقّق من تسجيل الدخول في GitHub CLI ‏(gh)، ثم حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Razlike nije moguće pročitati. Provjerite je li GitHub CLI (gh) prijavljen, pa pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Diffen kunne ikke læses. Kontrollér, at GitHub CLI (gh) er logget ind, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Diff konnte nicht gelesen werden. Prüfe, ob die GitHub CLI (gh) angemeldet ist, und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el diff. Comprueba que GitHub CLI (gh) tenga la sesión iniciada e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire le diff. Vérifiez que GitHub CLI (gh) est connecté, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il diff. Verifica di aver effettuato l’accesso con GitHub CLI (gh), poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "差分を読み込めませんでした。GitHub CLI (gh) にサインインしていることを確認して、もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចអានភាពខុសគ្នាបានទេ។ សូមពិនិត្យថា GitHub CLI (gh) បានចូលគណនីហើយ រួចព្យាយាមម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "diff를 읽을 수 없습니다. GitHub CLI(gh)에 로그인되어 있는지 확인한 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Diffen kunne ikke leses. Kontroller at GitHub CLI (gh) er logget på, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać różnic. Sprawdź, czy GitHub CLI (gh) jest zalogowane, i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o diff. Verifique se o GitHub CLI (gh) está conectado e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать diff. Убедитесь, что вы вошли в GitHub CLI (gh), и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านความแตกต่างไม่ได้ ตรวจสอบว่าได้ลงชื่อเข้าใช้ GitHub CLI (gh) แล้ว จากนั้นลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fark okunamadı. GitHub CLI (gh) oturumunun açık olduğunu denetleyip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати diff. Переконайтеся, що ви ввійшли в GitHub CLI (gh), і спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đọc được diff. Hãy kiểm tra GitHub CLI (gh) đã đăng nhập, rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取差异。请确认 GitHub CLI (gh) 已登录，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取差異。請確認 GitHub CLI (gh) 已登入，然後再試一次。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
