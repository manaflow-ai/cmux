        "handlers.attention.nothing": {
            "extractionState": "manual",
            "localizations": {
                "ar": {
                    "stringUnit": {
                        "state": "needs_review",
                        "value": "لا يحتاجك أي وكيل في علامة تبويب الآن."
                    }
                },
                "bs": {
                    "stringUnit": {
                        "state": "needs_review",
                        "value": "Trenutno te nijedan agent ne treba u kartici."
                    }
                },
                "da": {
                    "stringUnit": {
                        "state": "needs_review",
                        "value": "Ingen agent har brug for dig i en fane lige nu."
                    }
                },
                "de": {
                    "stringUnit": {
                        "state": "needs_review",
                        "value": "Gerade braucht dich kein Agent in einem Tab."
                    }
                },
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "No agent needs you in a tab right now."
                    }
                },
                "es": {
                    "stringUnit": {
                        "state": "needs_review",
                        "value": "Ningún agente te necesita en una pestaña ahora."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "needs_review",
                        "value": "Aucun agent n’a besoin de vous dans un onglet pour le moment."
                    }
                },
                "it": {
                    "stringUnit": {
                        "state": "needs_review",
                        "value": "Al momento nessun agente ha bisogno di te in una scheda."
                    }
                },
                "ja": {
                    "stringUnit": {
                        "state": "needs_review",
                        "value": "今タブで対応が必要なエージェントはありません。"
                    }
                },
                "km": {
                    "stringUnit": {
                        "state": "needs_review",
                        "value": "ឥឡូវនេះគ្មានភ្នាក់ងារណាត្រូវការអ្នកក្នុងផ្ទាំងទេ។"
                    }
                },
                "ko": {
                    "stringUnit": {
                        "state": "needs_review",
                        "value": "지금 탭에서 나를 필요로 하는 에이전트가 없습니다."
                    }
                },
                "nb": {
                    "stringUnit": {
                        "state": "needs_review",
                        "value": "Ingen agent trenger deg i en fane akkurat nå."
                    }
                },
                "pl": {
                    "stringUnit": {
                        "state": "needs_review",
                        "value": "Żaden agent nie potrzebuje Cię teraz w karcie."
                    }
                },
                "pt-BR": {
                    "stringUnit": {
                        "state": "needs_review",
                        "value": "Nenhum agente precisa de você em uma aba agora."
                    }
                },
                "ru": {
                    "stringUnit": {
                        "state": "needs_review",
                        "value": "Сейчас ни одному агенту вы не нужны во вкладке."
                    }
                },
                "th": {
                    "stringUnit": {
                        "state": "needs_review",
                        "value": "ตอนนี้ไม่มีเอเจนต์ใดต้องการคุณในแท็บ"
                    }
                },
                "tr": {
                    "stringUnit": {
                        "state": "needs_review",
                        "value": "Şu anda hiçbir ajanın bir sekmede sana ihtiyacı yok."
                    }
                },
                "uk": {
                    "stringUnit": {
                        "state": "needs_review",
                        "value": "Зараз жоден агент не чекає на вас у вкладці."
                    }
                },
                "vi": {
                    "stringUnit": {
                        "state": "needs_review",
                        "value": "Hiện không có tác tử nào cần bạn trong một thẻ."
                    }
                },
                "zh-Hans": {
                    "stringUnit": {
                        "state": "needs_review",
                        "value": "目前没有代理需要你在标签页中处理。"
                    }
                },
                "zh-Hant": {
                    "stringUnit": {
                        "state": "needs_review",
                        "value": "目前沒有代理需要你在分頁中處理。"
                    }
                }
            }
        }
