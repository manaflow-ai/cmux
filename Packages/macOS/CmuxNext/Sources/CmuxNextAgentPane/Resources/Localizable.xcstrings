    "agentPane.error.gitDiscardWholeFile": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This change adds or removes the whole file. Revert the file instead."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يضيف هذا التغيير الملف كله أو يزيله. تراجع عن الملف بدلًا من ذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ova izmjena dodaje ili uklanja cijelu datoteku. Umjesto toga vrati datoteku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne ændring tilføjer eller fjerner hele filen. Fortryd filen i stedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Änderung fügt die ganze Datei hinzu oder entfernt sie. Setze stattdessen die Datei zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este cambio agrega o quita el archivo entero. Revierte el archivo en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette modification ajoute ou supprime tout le fichier. Annulez plutôt le fichier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questa modifica aggiunge o rimuove l’intero file. Ripristina invece il file."
