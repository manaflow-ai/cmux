{
  "sourceLanguage": "en",
  "strings": {
    "agentPane.crashed.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعطلت لوحة الوكيل بشكل متكرر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel agenta se više puta srušio."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentpanelet gik ned gentagne gange."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agentenbereich ist wiederholt abgestürzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent pane crashed repeatedly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El panel del agente se bloqueó repetidamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le panneau de l’agent a planté à plusieurs reprises."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pannello dell’agente si è arrestato ripetutamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントペインが繰り返しクラッシュしました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្ទាំងភ្នាក់ងារបានគាំងម្តងហើយម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 패널이 반복해서 충돌했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentpanelet krasjet gjentatte ganger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel agenta wielokrotnie uległ awarii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O painel do agente travou repetidamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель агента несколько раз аварийно завершилась."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บานหน้าต่างเอเจนต์ขัดข้องซ้ำหลายครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajan bölmesi art arda çöktü."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель агента кілька разів аварійно завершилася."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngăn tác tử đã gặp sự cố nhiều lần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理窗格反复崩溃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理窗格反覆當機。"
          }
        }
      }
    },
    "agentPane.crashed.reload": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة التحميل"
