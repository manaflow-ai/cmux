    "agentPane.error.gitPushFirst": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ادفع هذا الفرع أولًا؛ يُفتح طلب السحب مما هو موجود على المستودع البعيد."
          }
        },
        "bs": {
          "stringUnit": {
