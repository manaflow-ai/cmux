    "agentPane.dictation.microphoneDenied": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج الإملاء إلى الوصول إلى الميكروفون. فعّله لـ cmux في إعدادات النظام."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktiranje treba pristup mikrofonu. Uključite ga za cmux u Postavkama sistema."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering kræver adgang til mikrofonen. Slå den til for cmux i Systemindstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktieren braucht Zugriff auf das Mikrofon. Aktiviere ihn für cmux in den Systemeinstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictation needs microphone access. Turn it on for cmux in System Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dictado necesita acceso al micrófono. Actívalo para cmux en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dictée a besoin d’accéder au micro. Activez-le pour cmux dans Réglages Système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dettatura richiede l’accesso al microfono. Attivalo per cmux in Impostazioni di Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力にはマイクへのアクセスが必要です。システム設定で cmux に許可してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការសរសេរតាមសំឡេងត្រូវការសិទ្ធិចូលប្រើមីក្រូហ្វូន។ សូមបើកវាសម្រាប់ cmux ក្នុងការកំណត់ប្រព័ន្ធ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기에는 마이크 접근 권한이 필요합니다. 시스템 설정에서 cmux에 허용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering trenger tilgang til mikrofonen. Slå den på for cmux i Systeminnstillinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyktowanie wymaga dostępu do mikrofonu. Włącz go dla cmux w Ustawieniach systemowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado precisa de acesso ao microfone. Ative-o para o cmux nos Ajustes do Sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для диктовки нужен доступ к микрофону. Включите его для cmux в Системных настройках."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การป้อนตามคำบอกต้องเข้าถึงไมโครโฟน เปิดให้ cmux ในการตั้งค่าระบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte için mikrofon erişimi gerekir. Sistem Ayarları’nda cmux için açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для диктування потрібен доступ до мікрофона. Увімкніть його для cmux у Системних параметрах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc chính tả cần quyền truy cập micrô. Hãy bật cho cmux trong Cài đặt hệ thống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "听写需要麦克风权限。请在系统设置中为 cmux 开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聽寫需要麥克風權限。請在系統設定中為 cmux 開啟。"
          }
        }
      }
    },
    "agentPane.dictation.modelDownloadFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تنزيل نموذج الكلام. حاول مرة أخرى عند الاتصال بالإنترنت."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Model govora nije moguće preuzeti. Pokušajte ponovo kada budete na mreži."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Talemodellen kunne ikke hentes. Prøv igen, når du er online."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Sprachmodell konnte nicht geladen werden. Versuche es erneut, wenn du online bist."
