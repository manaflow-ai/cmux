        "stringUnit": {
          "state": "translated",
          "value": "Reconnectez-vous avant de créer un point de contrôle."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Riconnettiti prima di creare un punto di controllo."
        }
      },
      "km": {
        "stringUnit": {
          "state": "translated",
          "value": "ភ្ជាប់ឡើងវិញមុនពេលបង្កើតចំណុចត្រួតពិនិត្យ ។"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "체크포인트를 생성하기 전에 다시 연결하세요."
        }
      },
      "nb": {
        "stringUnit": {
          "state": "translated",
          "value": "Koble til igjen før du oppretter et kontrollpunkt."
        }
      },
      "pl": {
        "stringUnit": {
          "state": "translated",
          "value": "Połącz się ponownie przed utworzeniem punktu kontrolnego."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Reconecte-se antes de criar um ponto de verificação."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Повторно подключитесь перед созданием контрольной точки."
        }
      },
      "th": {
        "stringUnit": {
          "state": "translated",
          "value": "เชื่อมต่ออีกครั้งก่อนสร้างจุดตรวจสอบ"
        }
      },
      "tr": {
        "stringUnit": {
          "state": "translated",
