        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចទាញយកម៉ូដែលសំឡេងបានទេ។ សូមព្យាយាមម្ដងទៀតនៅពេលអ្នកភ្ជាប់អ៊ីនធឺណិត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 모델을 다운로드할 수 없습니다. 온라인 상태에서 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Talemodellen kunne ikke lastes ned. Prøv igjen når du er tilkoblet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się pobrać modelu mowy. Spróbuj ponownie, gdy będziesz online."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível baixar o modelo de fala. Tente novamente quando estiver online."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить речевую модель. Повторите попытку, когда будете в сети."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถดาวน์โหลดโมเดลเสียงพูดได้ ลองอีกครั้งเมื่อออนไลน์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşma modeli indirilemedi. Çevrimiçi olduğunuzda tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
