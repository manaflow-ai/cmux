{
  "sourceLanguage": "en",
  "strings": {
    "agentPane.error.daemonFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يبدأ acpmux. سجله موجود في %@."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux se nije pokrenuo. Njegov zapisnik je na %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux startede ikke. Loggen findes på %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux wurde nicht gestartet. Das Protokoll liegt unter %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux did not start. Its log is at %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux no se inició. Su registro está en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux n’a pas démarré. Son journal se trouve dans %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux non si è avviato. Il suo log si trova in %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux を起動できませんでした。ログは %@ にあります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux មិនបានចាប់ផ្ដើមទេ។ កំណត់ហេតុរបស់វានៅ %@។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux를 시작하지 못했습니다. 로그 위치: %@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux startet ikke. Loggen ligger i %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie udało się uruchomić acpmux. Jego dziennik znajduje się w %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O acpmux não iniciou. O log está em %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux не запустился. Его журнал: %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux ไม่เริ่มทำงาน ดูบันทึกได้ที่ %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux başlatılamadı. Günlüğü %@ konumunda."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux не запустився. Його журнал: %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux không khởi động được. Nhật ký nằm tại %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux 未能启动。日志位于 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux 無法啟動。記錄檔位於 %@。"
          }
        }
      }
    },
    "agentPane.error.notFound": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يتم العثور على acpmux. ثبّت acpmux أو استخدم إصدارًا يتضمنه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux nije pronađen. Instalirajte acpmux ili koristite verziju koja ga uključuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux blev ikke fundet. Installer acpmux, eller brug en version, der indeholder det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux wurde nicht gefunden. Installiere acpmux oder verwende einen Build, der es enthält."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux was not found. Install acpmux or use a build that bundles it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se encontró acpmux. Instala acpmux o usa una compilación que lo incluya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux est introuvable. Installez acpmux ou utilisez une version qui l’inclut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux non trovato. Installa acpmux o usa una build che lo include."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux が見つかりません。acpmux をインストールするか、同梱されたビルドを使用してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "រកមិនឃើញ acpmux ទេ។ ដំឡើង acpmux ឬប្រើកំណែដែលមានវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux를 찾을 수 없습니다. acpmux를 설치하거나 포함된 빌드를 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fant ikke acpmux. Installer acpmux, eller bruk en versjon som inkluderer det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie znaleziono acpmux. Zainstaluj acpmux lub użyj wersji, która go zawiera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O acpmux não foi encontrado. Instale o acpmux ou use uma versão que o inclua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux не найден. Установите acpmux или используйте сборку, в которую он входит."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่พบ acpmux ติดตั้ง acpmux หรือใช้บิลด์ที่มี acpmux รวมอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux bulunamadı. acpmux'u yükleyin veya onu içeren bir sürüm kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux не знайдено. Установіть acpmux або використайте збірку, що його містить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không tìm thấy acpmux. Hãy cài đặt acpmux hoặc dùng bản dựng có kèm nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未找到 acpmux。请安装 acpmux 或使用内置它的版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "找不到 acpmux。請安裝 acpmux 或使用內建它的版本。"
          }
        }
      }
    },
