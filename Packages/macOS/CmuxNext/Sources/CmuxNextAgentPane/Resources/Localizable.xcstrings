    "agentPane.error.gitDiscardSubmodule": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submodules aren't reverted here. Revert them in their own folder."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
