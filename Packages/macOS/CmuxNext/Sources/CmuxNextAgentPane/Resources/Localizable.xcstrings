            "value": "إضافة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj"
          }
        },
        "de": {
          "stringUnit": {
