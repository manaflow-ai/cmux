    "agentPane.error.gitHomeRepository": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي هذا المستودع على مجلد المنزل، لذا لن يغيّره عرض التغييرات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj repozitorij sadrži vašu početnu mapu, pa ga prikaz izmjena neće mijenjati."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette repository indeholder din hjemmemappe, så visningen Ændringer ændrer det ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Repository enthält deinen Benutzerordner, daher ändert die Ansicht „Änderungen“ es nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This repository holds your home folder, so the Changes view won't change it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este repositorio contiene tu carpeta de inicio, así que la vista Cambios no lo modificará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dépôt contient votre dossier personnel : la vue Modifications ne le modifiera pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo repository contiene la tua cartella Inizio, quindi la vista Modifiche non lo cambierà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリポジトリにはホームフォルダが含まれるため、変更ビューからは変更しません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឃ្លាំងនេះផ្ទុកថតដើមរបស់អ្នក ដូច្នេះទិដ្ឋភាពការផ្លាស់ប្ដូរនឹងមិនកែប្រែវាទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 저장소에는 홈 폴더가 포함되어 있어 변경 사항 보기에서 변경하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette depotet inneholder hjemmemappen din, så Endringer-visningen endrer det ikke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To repozytorium zawiera folder domowy, więc widok Zmiany go nie zmieni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este repositório contém sua pasta pessoal, então a visualização Alterações não vai modificá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот репозиторий содержит вашу домашнюю папку, поэтому представление «Изменения» не будет его менять."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่เก็บนี้มีโฟลเดอร์บ้านของคุณ มุมมองการเปลี่ยนแปลงจึงจะไม่แก้ไข"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu depo ana klasörünüzü içeriyor, bu yüzden Değişiklikler görünümü onu değiştirmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей репозиторій містить вашу домашню папку, тому подання «Зміни» не змінюватиме його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kho này chứa thư mục nhà của bạn nên chế độ xem Thay đổi sẽ không sửa nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此仓库包含你的个人文件夹，因此“更改”视图不会修改它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此儲存庫包含你的個人資料夾，因此「變更」檢視不會修改它。"
          }
        }
      }
    },
    "agentPane.error.gitRemote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
