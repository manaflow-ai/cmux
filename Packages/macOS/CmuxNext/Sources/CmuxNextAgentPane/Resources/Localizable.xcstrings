    "agentPane.checkpoint.offline": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Reconnect before creating a checkpoint."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "チェックポイントを作成する前に再接続してください。"
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "أعد الاتصال قبل إنشاء نقطة تفتيش."
        }
      },
      "bs": {
        "stringUnit": {
          "state": "translated",
          "value": "Ponovo se povežite prije kreiranja kontrolnog punkta."
        }
      },
      "da": {
        "stringUnit": {
