    "agentPane.addRoot.message": {
    "extractionState": "manual",
    "localizations": {
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "طلب الوكيل العمل في %@، وهو خارج مجلدات مساحة العمل هذه."
        }
      },
      "bs": {
        "stringUnit": {
          "state": "translated",
          "value": "Agent je tražio da radi u %@, koji je izvan foldera ovog radnog prostora."
        }
      },
      "da": {
        "stringUnit": {
          "state": "translated",
          "value": "Agenten bad om at arbejde i %@, som ligger uden for dette arbejdsområdes mapper."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Der Agent möchte in %@ arbeiten, das außerhalb der Ordner dieses Arbeitsbereichs liegt."
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The agent asked to work in %@, which is outside this workspace's folders."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "El agente pidió trabajar en %@, que está fuera de las carpetas de este espacio de trabajo."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "L’agent a demandé à travailler dans %@, qui se trouve hors des dossiers de cet espace de travail."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "L’agente ha chiesto di lavorare in %@, che è fuori dalle cartelle di questo spazio di lavoro."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "エージェントが %@ での作業を求めています。このフォルダはワークスペースのフォルダの外にあります。"
        }
      },
      "km": {
        "stringUnit": {
          "state": "translated",
          "value": "ភ្នាក់ងារបានស្នើធ្វើការក្នុង %@ ដែលនៅក្រៅថតនៃកន្លែងធ្វើការនេះ។"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "에이전트가 이 워크스페이스의 폴더 밖에 있는 %@에서 작업하려고 합니다."
        }
      },
      "nb": {
        "stringUnit": {
          "state": "translated",
          "value": "Agenten ba om å jobbe i %@, som ligger utenfor mappene i dette arbeidsområdet."
        }
      },
      "pl": {
        "stringUnit": {
          "state": "translated",
          "value": "Agent poprosił o pracę w %@, który jest poza folderami tego obszaru roboczego."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "O agente pediu para trabalhar em %@, que está fora das pastas deste espaço de trabalho."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Агент запросил работу в %@, а эта папка находится вне папок рабочего пространства."
        }
