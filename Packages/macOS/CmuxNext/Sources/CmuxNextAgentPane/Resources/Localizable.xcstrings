            "value": "تغيّر الملف بعد التراجع، لذا لا يمكن إعادة التغيير."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Datoteka se promijenila nakon vraćanja, pa Poništi ne može vratiti izmjenu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Filen ændrede sig efter fortrydelsen, så Fortryd kan ikke sætte ændringen tilbage."
