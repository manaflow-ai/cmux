    "agentPane.confirmMode.title": {
    "extractionState": "manual",
    "localizations": {
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "هل تسمح للوكيل بالتصرف دون أن يسأل؟"
        }
      },
      "bs": {
        "stringUnit": {
          "state": "translated",
          "value": "Dozvoliti agentu da radi bez pitanja?"
        }
      },
      "da": {
        "stringUnit": {
          "state": "translated",
          "value": "Lad agenten handle uden at spørge?"
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Den Agenten ohne Nachfrage handeln lassen?"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Let the agent act without asking?"
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "¿Dejar que el agente actúe sin preguntar?"
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Laisser l’agent agir sans demander ?"
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Lasciare che l’agente agisca senza chiedere?"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "エージェントに確認なしで実行させますか？"
        }
      },
      "km": {
        "stringUnit": {
          "state": "translated",
          "value": "អនុញ្ញាតឱ្យភ្នាក់ងារធ្វើសកម្មភាពដោយមិនសួរ?"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "에이전트가 묻지 않고 작업하게 할까요?"
        }
      },
      "nb": {
        "stringUnit": {
          "state": "translated",
          "value": "La agenten handle uten å spørre?"
        }
      },
      "pl": {
        "stringUnit": {
          "state": "translated",
          "value": "Pozwolić agentowi działać bez pytania?"
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Deixar o agente agir sem perguntar?"
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Разрешить агенту действовать без вопросов?"
        }
      },
      "th": {
        "stringUnit": {
          "state": "translated",
          "value": "ให้เอเจนต์ทำงานโดยไม่ถามก่อนหรือไม่"
        }
      },
      "tr": {
        "stringUnit": {
          "state": "translated",
          "value": "Aracı sormadan işlem yapsın mı?"
        }
      },
      "uk": {
        "stringUnit": {
          "state": "translated",
          "value": "Дозволити агенту діяти без запитань?"
        }
      },
      "vi": {
        "stringUnit": {
          "state": "translated",
          "value": "Cho tác tử hành động mà không hỏi?"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "要让代理不经询问就执行操作吗？"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "要讓代理不經詢問就執行操作嗎？"
        }
      }
    }
  },
