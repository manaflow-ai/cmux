    "agentPane.error.daemonFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يبدأ acpmux. سجله موجود في %@."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux se nije pokrenuo. Njegov zapisnik je na %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux startede ikke. Loggen findes på %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux wurde nicht gestartet. Das Protokoll liegt unter %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux did not start. Its log is at %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux no se inició. Su registro está en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux n’a pas démarré. Son journal se trouve dans %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux non si è avviato. Il suo log si trova in %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux を起動できませんでした。ログは %@ にあります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux មិនបានចាប់ផ្ដើមទេ។ កំណត់ហេតុរបស់វានៅ %@។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux를 시작하지 못했습니다. 로그 위치: %@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux startet ikke. Loggen ligger i %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie udało się uruchomić acpmux. Jego dziennik znajduje się w %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O acpmux não iniciou. O log está em %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux не запустился. Его журнал: %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux ไม่เริ่มทำงาน ดูบันทึกได้ที่ %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux başlatılamadı. Günlüğü %@ konumunda."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux не запустився. Його журнал: %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux không khởi động được. Nhật ký nằm tại %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux 未能启动。日志位于 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux 無法啟動。記錄檔位於 %@。"
          }
        }
      }
    },
    "agentPane.error.daemonStopped": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux لا يعمل. افتح محادثة وكيل جديدة لتشغيله."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux nije pokrenut. Otvorite novi chat s agentom da ga pokrenete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux kører ikke. Åbn en ny agentchat for at starte den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux läuft nicht. Öffne einen neuen Agenten-Chat, um es zu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux is not running. Open a new agent chat to start it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux no se está ejecutando. Abre un nuevo chat con el agente para iniciarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux n’est pas en cours d’exécution. Ouvrez une nouvelle discussion avec l’agent pour le démarrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux non è in esecuzione. Apri una nuova chat con l’agente per avviarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux が実行されていません。新しいエージェントチャットを開くと起動します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux មិនកំពុងដំណើរការទេ។ បើកការជជែកភ្នាក់ងារថ្មី ដើម្បីចាប់ផ្តើមវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux가 실행 중이 아닙니다. 새 에이전트 채팅을 열면 시작됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux kjører ikke. Åpne en ny agentchat for å starte den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux nie działa. Otwórz nowy czat z agentem, aby go uruchomić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acpmux não está em execução. Abra um novo chat com o agente para iniciá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux не запущен. Откройте новый чат с агентом, чтобы запустить его."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux ไม่ได้ทำงานอยู่ เปิดแชตเอเจนต์ใหม่เพื่อเริ่มการทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux çalışmıyor. Başlatmak için yeni bir ajan sohbeti açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux не запущено. Відкрийте новий чат з агентом, щоб запустити його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux không chạy. Mở một cuộc trò chuyện tác tử mới để khởi động nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux 未运行。打开新的代理聊天即可启动它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux 未執行。開啟新的代理聊天即可啟動它。"
          }
        }
      }
    },
    "agentPane.error.notFound": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
