        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một dịch vụ acpmux khác đang sử dụng socket này. Kết nối sẽ tự khôi phục khi dịch vụ sẵn sàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
