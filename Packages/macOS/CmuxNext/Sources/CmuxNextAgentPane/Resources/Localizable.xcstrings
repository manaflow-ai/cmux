    "agentPane.dictation.speechDenied": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج الإملاء بهذه اللغة إلى التعرّف على الكلام. فعّله لـ cmux في إعدادات النظام."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktiranje na ovom jeziku treba prepoznavanje govora. Uključite ga za cmux u Postavkama sistema."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering på dette sprog kræver talegenkendelse. Slå den til for cmux i Systemindstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktieren in dieser Sprache braucht Spracherkennung. Aktiviere sie für cmux in den Systemeinstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictation in this language needs speech recognition. Turn it on for cmux in System Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dictado en este idioma necesita reconocimiento de voz. Actívalo para cmux en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dictée dans cette langue a besoin de la reconnaissance vocale. Activez-la pour cmux dans Réglages Système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dettatura in questa lingua richiede il riconoscimento vocale. Attivalo per cmux in Impostazioni di Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この言語の音声入力には音声認識が必要です。システム設定で cmux に許可してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការសរសេរតាមសំឡេងជាភាសានេះត្រូវការការស្គាល់សំឡេង។ សូមបើកវាសម្រាប់ cmux ក្នុងការកំណត់ប្រព័ន្ធ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 언어로 받아쓰려면 음성 인식이 필요합니다. 시스템 설정에서 cmux에 허용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering på dette språket trenger talegjenkjenning. Slå den på for cmux i Systeminnstillinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyktowanie w tym języku wymaga rozpoznawania mowy. Włącz je dla cmux w Ustawieniach systemowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado neste idioma precisa de reconhecimento de fala. Ative-o para o cmux nos Ajustes do Sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для диктовки на этом языке нужно распознавание речи. Включите его для cmux в Системных настройках."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การป้อนตามคำบอกในภาษานี้ต้องใช้การรู้จำเสียงพูด เปิดให้ cmux ในการตั้งค่าระบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dilde dikte için konuşma tanıma gerekir. Sistem Ayarları’nda cmux için açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для диктування цією мовою потрібне розпізнавання мовлення. Увімкніть його для cmux у Системних параметрах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc chính tả bằng ngôn ngữ này cần nhận dạng giọng nói. Hãy bật cho cmux trong Cài đặt hệ thống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此语言的听写需要语音识别。请在系统设置中为 cmux 开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此語言的聽寫需要語音辨識。請在系統設定中為 cmux 開啟。"
          }
        }
      }
    },
