    "agentPane.confirmMode.title": {
    "extractionState": "manual",
    "localizations": {
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "هل تسمح للوكيل بالتصرف دون أن يسأل؟"
        }
      },
      "bs": {
        "stringUnit": {
          "state": "translated",
          "value": "Dozvoliti agentu da radi bez pitanja?"
        }
      },
      "da": {
        "stringUnit": {
          "state": "translated",
          "value": "Lad agenten handle uden at spørge?"
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Den Agenten ohne Nachfrage handeln lassen?"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Let the agent act without asking?"
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "¿Dejar que el agente actúe sin preguntar?"
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Laisser l’agent agir sans demander ?"
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Lasciare che l’agente agisca senza chiedere?"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "エージェントに確認なしで実行させますか？"
        }
      },
      "km": {
        "stringUnit": {
          "state": "translated",
          "value": "អនុញ្ញាតឱ្យភ្នាក់ងារធ្វើសកម្មភាពដោយមិនសួរ?"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "에이전트가 묻지 않고 작업하게 할까요?"
        }
      },
      "nb": {
        "stringUnit": {
          "state": "translated",
          "value": "La agenten handle uten å spørre?"
        }
      },
      "pl": {
        "stringUnit": {
          "state": "translated",
          "value": "Pozwolić agentowi działać bez pytania?"
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Deixar o agente agir sem perguntar?"
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Разрешить агенту действовать без вопросов?"
        }
      },
      "th": {
        "stringUnit": {
          "state": "translated",
          "value": "ให้เอเจนต์ทำงานโดยไม่ถามก่อนหรือไม่"
        }
      },
      "tr": {
        "stringUnit": {
          "state": "translated",
          "value": "Aracı sormadan işlem yapsın mı?"
        }
      },
      "uk": {
        "stringUnit": {
          "state": "translated",
          "value": "Дозволити агенту діяти без запитань?"
        }
      },
      "vi": {
        "stringUnit": {
          "state": "translated",
          "value": "Cho tác tử hành động mà không hỏi?"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "要让代理不经询问就执行操作吗？"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "要讓代理不經詢問就執行操作嗎？"
        }
      }
    }
  },
    "agentPane.confirmMode.message": {
    "extractionState": "manual",
    "localizations": {
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "ستنتقل هذه المحادثة إلى %@، وهو وضع لا يسأل فيه الوكيل قبل أن يتصرف."
        }
      },
      "bs": {
        "stringUnit": {
          "state": "translated",
          "value": "Ovaj razgovor bi prešao na %@, način u kojem agent ne pita prije nego što djeluje."
        }
      },
      "da": {
        "stringUnit": {
          "state": "translated",
          "value": "Denne chat skifter til %@, en tilstand hvor agenten ikke spørger, før den handler."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Dieser Chat würde zu %@ wechseln, einem Modus, in dem der Agent nicht fragt, bevor er handelt."
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "This chat would switch to %@, a mode in which the agent does not ask before it acts."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Este chat pasaría a %@, un modo en el que el agente no pregunta antes de actuar."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Ce chat passerait en %@, un mode dans lequel l’agent ne demande pas avant d’agir."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Questa chat passerebbe a %@, una modalità in cui l’agente non chiede prima di agire."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "このチャットは %@ に切り替わります。このモードでは、エージェントは実行前に確認しません。"
        }
      },
      "km": {
        "stringUnit": {
          "state": "translated",
          "value": "ការជជែកនេះនឹងប្ដូរទៅ %@ ដែលជារបៀបដែលភ្នាក់ងារមិនសួរមុនធ្វើសកម្មភាព។"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "이 채팅은 에이전트가 작업 전에 묻지 않는 모드인 %@(으)로 전환됩니다."
        }
      },
      "nb": {
        "stringUnit": {
          "state": "translated",
          "value": "Denne chatten bytter til %@, en modus der agenten ikke spør før den handler."
        }
      },
      "pl": {
        "stringUnit": {
          "state": "translated",
          "value": "Ten czat przełączy się na %@, tryb, w którym agent nie pyta przed działaniem."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Este chat mudaria para %@, um modo em que o agente não pergunta antes de agir."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Этот чат перейдёт в режим %@, в котором агент не спрашивает перед действием."
        }
      },
      "th": {
        "stringUnit": {
          "state": "translated",
          "value": "แชทนี้จะเปลี่ยนเป็น %@ ซึ่งเป็นโหมดที่เอเจนต์ไม่ถามก่อนทำงาน"
        }
      },
      "tr": {
        "stringUnit": {
          "state": "translated",
          "value": "Bu sohbet, aracının işlem yapmadan önce sormadığı %@ moduna geçer."
        }
      },
      "uk": {
        "stringUnit": {
          "state": "translated",
          "value": "Цей чат перейде в режим %@, у якому агент не питає перед дією."
        }
      },
      "vi": {
        "stringUnit": {
          "state": "translated",
          "value": "Cuộc trò chuyện này sẽ chuyển sang %@, chế độ mà tác tử không hỏi trước khi hành động."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "此聊天将切换到 %@，在该模式下代理执行操作前不会询问。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "此聊天將切換到 %@，在該模式下代理執行操作前不會詢問。"
        }
      }
    }
  },
