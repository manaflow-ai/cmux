    "agentPane.addRoot.title": {
    "extractionState": "manual",
    "localizations": {
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "هل تريد إضافة هذا المجلد إلى مساحة العمل؟"
        }
      },
      "bs": {
        "stringUnit": {
          "state": "translated",
          "value": "Dodati ovaj folder u radni prostor?"
        }
      },
      "da": {
        "stringUnit": {
          "state": "translated",
          "value": "Vil du føje denne mappe til arbejdsområdet?"
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Diesen Ordner zum Arbeitsbereich hinzufügen?"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Add this folder to the workspace?"
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "¿Añadir esta carpeta al espacio de trabajo?"
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Ajouter ce dossier à l’espace de travail ?"
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Aggiungere questa cartella allo spazio di lavoro?"
