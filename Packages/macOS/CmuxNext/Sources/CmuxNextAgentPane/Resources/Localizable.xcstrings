            "value": "Recarregar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезагрузить"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden yükle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезавантажити"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải lại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新载入"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新載入"
          }
        }
      }
    },
    "agentPane.dictation.failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقفت الإملاء بشكل غير متوقع."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktiranje se neočekivano zaustavilo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteringen stoppede uventet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Diktieren wurde unerwartet beendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictation stopped unexpectedly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dictado se detuvo inesperadamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dictée s’est arrêtée de façon inattendue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dettatura si è interrotta inaspettatamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力が予期せず停止しました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការសរសេរតាមសំឡេងបានឈប់ដោយមិនបានរំពឹងទុក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기가 예기치 않게 중지되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteringen stoppet uventet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyktowanie nieoczekiwanie się zatrzymało."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado parou inesperadamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовка неожиданно остановилась."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การป้อนตามคำบอกหยุดโดยไม่คาดคิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte beklenmedik şekilde durdu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктування неочікувано зупинилося."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc chính tả đã dừng đột ngột."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "听写意外停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聽寫意外停止。"
          }
        }
      }
    },
    "agentPane.dictation.languageUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإملاء على الجهاز غير متاح لهذه اللغة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktiranje na uređaju nije dostupno za ovaj jezik."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering på enheden er ikke tilgængelig for dette sprog."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktieren auf dem Gerät ist für diese Sprache nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device dictation is not available for this language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dictado en el dispositivo no está disponible para este idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dictée sur l’appareil n’est pas disponible pour cette langue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dettatura sul dispositivo non è disponibile per questa lingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この言語ではデバイス上の音声入力を利用できません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការសរសេរតាមសំឡេងលើឧបករណ៍មិនមានសម្រាប់ភាសានេះទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 언어에서는 기기 내 받아쓰기를 사용할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering på enheten er ikke tilgjengelig for dette språket."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyktowanie na urządzeniu nie jest dostępne dla tego języka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado no dispositivo não está disponível para este idioma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовка на устройстве недоступна для этого языка."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การป้อนตามคำบอกบนอุปกรณ์ไม่พร้อมใช้งานสำหรับภาษานี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz üzerinde dikte bu dil için kullanılamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктування на пристрої недоступне для цієї мови."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc chính tả trên thiết bị không khả dụng cho ngôn ngữ này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此语言不支持设备端听写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此語言不支援裝置端聽寫。"
          }
        }
      }
    },
    "agentPane.dictation.microphoneDenied": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج الإملاء إلى الوصول إلى الميكروفون. فعّله لـ cmux في إعدادات النظام."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktiranje treba pristup mikrofonu. Uključite ga za cmux u Postavkama sistema."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering kræver adgang til mikrofonen. Slå den til for cmux i Systemindstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktieren braucht Zugriff auf das Mikrofon. Aktiviere ihn für cmux in den Systemeinstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictation needs microphone access. Turn it on for cmux in System Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dictado necesita acceso al micrófono. Actívalo para cmux en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dictée a besoin d’accéder au micro. Activez-le pour cmux dans Réglages Système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dettatura richiede l’accesso al microfono. Attivalo per cmux in Impostazioni di Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力にはマイクへのアクセスが必要です。システム設定で cmux に許可してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការសរសេរតាមសំឡេងត្រូវការសិទ្ធិចូលប្រើមីក្រូហ្វូន។ សូមបើកវាសម្រាប់ cmux ក្នុងការកំណត់ប្រព័ន្ធ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기에는 마이크 접근 권한이 필요합니다. 시스템 설정에서 cmux에 허용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering trenger tilgang til mikrofonen. Slå den på for cmux i Systeminnstillinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyktowanie wymaga dostępu do mikrofonu. Włącz go dla cmux w Ustawieniach systemowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado precisa de acesso ao microfone. Ative-o para o cmux nos Ajustes do Sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для диктовки нужен доступ к микрофону. Включите его для cmux в Системных настройках."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การป้อนตามคำบอกต้องเข้าถึงไมโครโฟน เปิดให้ cmux ในการตั้งค่าระบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte için mikrofon erişimi gerekir. Sistem Ayarları’nda cmux için açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для диктування потрібен доступ до мікрофона. Увімкніть його для cmux у Системних параметрах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc chính tả cần quyền truy cập micrô. Hãy bật cho cmux trong Cài đặt hệ thống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "听写需要麦克风权限。请在系统设置中为 cmux 开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聽寫需要麥克風權限。請在系統設定中為 cmux 開啟。"
          }
        }
      }
    },
    "agentPane.dictation.modelDownloadFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تنزيل نموذج الكلام. حاول مرة أخرى عند الاتصال بالإنترنت."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Model govora nije moguće preuzeti. Pokušajte ponovo kada budete na mreži."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Talemodellen kunne ikke hentes. Prøv igen, når du er online."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Sprachmodell konnte nicht geladen werden. Versuche es erneut, wenn du online bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The speech model could not be downloaded. Try again when you are online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo descargar el modelo de voz. Inténtalo de nuevo cuando tengas conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle vocal n’a pas pu être téléchargé. Réessayez une fois en ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile scaricare il modello vocale. Riprova quando sei online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声モデルをダウンロードできませんでした。オンラインのときにもう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចទាញយកម៉ូដែលសំឡេងបានទេ។ សូមព្យាយាមម្ដងទៀតនៅពេលអ្នកភ្ជាប់អ៊ីនធឺណិត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 모델을 다운로드할 수 없습니다. 온라인 상태에서 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Talemodellen kunne ikke lastes ned. Prøv igjen når du er tilkoblet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się pobrać modelu mowy. Spróbuj ponownie, gdy będziesz online."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível baixar o modelo de fala. Tente novamente quando estiver online."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить речевую модель. Повторите попытку, когда будете в сети."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
