        "stringUnit": {
          "state": "translated",
          "value": "មិនអាចអានការផ្លាស់ប្ដូរបានទេ។"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "변경 사항을 읽을 수 없습니다."
