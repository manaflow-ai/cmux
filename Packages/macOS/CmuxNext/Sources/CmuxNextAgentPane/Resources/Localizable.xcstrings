          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 로드"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Last inn på nytt"
          }
        },
        "pl": {
          "stringUnit": {
