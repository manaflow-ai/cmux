    "agentPane.error.gitDiscardUndoChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file changed after the revert, so Undo can't put the change back."
          }
        },
        "ar": {
          "stringUnit": {
