        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この変更はファイル全体を追加または削除します。代わりにファイルを元に戻してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការផ្លាស់ប្តូរនេះបន្ថែម ឬដកឯកសារទាំងមូល។ ត្រឡប់ឯកសារវិញជំនួសវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 변경은 파일 전체를 추가하거나 제거합니다. 대신 파일을 되돌리세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne endringen legger til eller fjerner hele filen. Tilbakestill filen i stedet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ta zmiana dodaje lub usuwa cały plik. Zamiast tego cofnij plik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta alteração adiciona ou remove o arquivo inteiro. Reverta o arquivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Это изменение добавляет или удаляет весь файл. Откатите файл целиком."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การเปลี่ยนแปลงนี้เพิ่มหรือลบทั้งไฟล์ ให้ย้อนกลับไฟล์แทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu değişiklik dosyanın tamamını ekler veya kaldırır. Bunun yerine dosyayı geri alın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ця зміна додає або вилучає весь файл. Натомість відкотіть файл."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thay đổi này thêm hoặc xóa toàn bộ tệp. Hãy hoàn tác cả tệp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此更改会添加或移除整个文件。请改为还原该文件。"
          }
