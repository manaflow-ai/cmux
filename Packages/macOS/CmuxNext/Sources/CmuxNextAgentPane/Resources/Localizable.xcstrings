          "stringUnit": {
            "state": "translated",
            "value": "acpmux が見つかりません。PATH 上か、次のいずれかのフォルダにインストールしてください: %@。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រកមិនឃើញ acpmux ទេ។ ដំឡើងវានៅក្នុង PATH របស់អ្នក ឬក្នុងថតមួយក្នុងចំណោមថតទាំងនេះ៖ %@។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux를 찾을 수 없습니다. PATH 또는 다음 폴더 중 하나에 설치하세요: %@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ikke acpmux. Installer det i PATH eller i en av disse mappene: %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono acpmux. Zainstaluj go w PATH lub w jednym z tych folderów: %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acpmux não foi encontrado. Instale-o no seu PATH ou em uma destas pastas: %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux не найден. Установите его в PATH или в одну из этих папок: %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบ acpmux ติดตั้งไว้ใน PATH หรือในโฟลเดอร์ใดโฟลเดอร์หนึ่งต่อไปนี้: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux bulunamadı. PATH'inize veya şu klasörlerden birine yükleyin: %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux не знайдено. Установіть його в PATH або в одну з цих папок: %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy acpmux. Hãy cài đặt vào PATH hoặc vào một trong các thư mục sau: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
