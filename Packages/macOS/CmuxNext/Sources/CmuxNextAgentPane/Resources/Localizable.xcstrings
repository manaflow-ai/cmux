        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 acpmux 서비스가 이 소켓을 사용 중입니다. 해당 서비스가 준비되면 다시 연결합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En annen acpmux-tjeneste bruker denne socketen. Tilkoblingen gjenopptas når tjenesten er klar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inna usługa acpmux używa tego gniazda. Po jej uruchomieniu połączenie zostanie wznowione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro serviço acpmux está usando este socket. A conexão será retomada quando ele estiver pronto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другой сервис acpmux использует этот сокет. Подключение восстановится, когда сервис будет готов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บริการ acpmux อื่นกำลังใช้ซ็อกเก็ตนี้ ระบบจะเชื่อมต่อใหม่เมื่อบริการนั้นพร้อม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
