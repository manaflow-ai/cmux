      },
      "km": {
        "stringUnit": {
          "state": "translated",
          "value": "បន្ថែមថតនេះទៅកន្លែងធ្វើការ?"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "이 폴더를 워크스페이스에 추가할까요?"
        }
      },
      "nb": {
        "stringUnit": {
          "state": "translated",
          "value": "Vil du legge til denne mappen i arbeidsområdet?"
        }
      },
      "pl": {
        "stringUnit": {
          "state": "translated",
          "value": "Dodać ten folder do obszaru roboczego?"
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Adicionar esta pasta ao espaço de trabalho?"
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Добавить эту папку в рабочее пространство?"
        }
      },
      "th": {
        "stringUnit": {
          "state": "translated",
          "value": "เพิ่มโฟลเดอร์นี้ลงในพื้นที่ทำงานหรือไม่"
        }
      },
      "tr": {
        "stringUnit": {
          "state": "translated",
          "value": "Bu klasör çalışma alanına eklensin mi?"
        }
      },
      "uk": {
        "stringUnit": {
          "state": "translated",
          "value": "Додати цю папку до робочого простору?"
        }
      },
      "vi": {
        "stringUnit": {
          "state": "translated",
          "value": "Thêm thư mục này vào không gian làm việc?"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "要将此文件夹添加到工作区吗？"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "要將此檔案夾加入工作區嗎？"
