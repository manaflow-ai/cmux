    "hands.presence.unavailable": {
      "comment": "Shown when a hand level raise is refused because this Mac has no Secure Enclave for the Touch ID / password presence key.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي جهاز Mac هذا على Secure Enclave، لذا لا يمكنه التأكد من وجودك. يمكن خفض مستوى اليد فقط من جهاز Mac هذا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj Mac nema Secure Enclave, pa ne može potvrditi da ste prisutni. Nivo ruke se s ovog Maca može samo sniziti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac har ingen Secure Enclave, så den kan ikke bekræfte, at du er til stede. En hånds niveau kan kun sænkes fra denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac hat keine Secure Enclave und kann daher nicht bestätigen, dass du anwesend bist. Die Stufe einer Hand kann auf diesem Mac nur gesenkt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac has no Secure Enclave, so it cannot confirm that you are present. A hand's level can only be lowered from this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no tiene Secure Enclave, así que no puede confirmar que estás presente. Desde este Mac solo se puede bajar el nivel de una mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac n’a pas de Secure Enclave et ne peut donc pas confirmer votre présence. Depuis ce Mac, le niveau d’une main peut seulement être abaissé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non ha la Secure Enclave, quindi non può confermare che sei presente. Da questo Mac il livello di una mano può solo essere abbassato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac には Secure Enclave がないため、本人の在席を確認できません。この Mac からは Hand のレベルを下げることしかできません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac នេះគ្មាន Secure Enclave ទេ ដូច្នេះវាមិនអាចបញ្ជាក់ថាអ្នកមានវត្តមានបានទេ។ កម្រិតរបស់ដៃអាចបន្ថយបានតែពី Mac នេះប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에는 Secure Enclave가 없어 사용자가 있는지 확인할 수 없습니다. 이 Mac에서는 Hand의 수준을 낮추기만 할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Macen har ingen Secure Enclave, så den kan ikke bekrefte at du er til stede. Nivået til en hånd kan bare senkes fra denne Macen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac nie ma Secure Enclave, więc nie może potwierdzić, że jesteś obecny. Z tego Maca poziom ręki można tylko obniżyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac não tem Secure Enclave, então não pode confirmar que você está presente. Neste Mac, o nível de uma mão só pode ser reduzido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом Mac нет Secure Enclave, поэтому он не может подтвердить ваше присутствие. С этого Mac уровень руки можно только понизить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac เครื่องนี้ไม่มี Secure Enclave จึงยืนยันไม่ได้ว่าคุณอยู่ตรงนั้น จาก Mac เครื่องนี้ลดระดับของแฮนด์ได้เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'te Secure Enclave yok, bu yüzden orada olduğunuzu doğrulayamaz. Bu Mac'ten bir elin düzeyi yalnızca düşürülebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому Mac немає Secure Enclave, тому він не може підтвердити вашу присутність. З цього Mac рівень руки можна лише знизити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac này không có Secure Enclave nên không thể xác nhận bạn đang có mặt. Từ máy Mac này chỉ có thể hạ mức của tay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 没有 Secure Enclave，因此无法确认你本人在场。在这台 Mac 上只能降低 Hand 的级别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 沒有 Secure Enclave，因此無法確認你本人在場。在這台 Mac 上只能降低 Hand 的等級。"
          }
        }
      }
    },
    "hands.install.notLinked": {
      "comment": "Shown in a Chief hand banner, and as the reason a level raise fails, when this Mac has no registered Cloud install, so Allow or a raise cannot be signed. Uses the localized name of the Sign In to cmux command.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جهاز Mac هذا غير مُعد للسحابة، لذا لا يمكنه تأكيد ذلك. اختر \"تسجيل الدخول إلى cmux\"، ثم حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj Mac nije postavljen za Cloud, pa ovo ne može potvrditi. Odaberite „Prijava u cmux”, pa pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac er ikke sat op til Cloud, så den kan ikke bekræfte dette. Vælg “Log ind på cmux”, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac ist nicht für Cloud eingerichtet und kann das daher nicht bestätigen. Wähle „Bei cmux anmelden“ und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac is not set up for Cloud, so it cannot confirm this. Choose Sign In to cmux, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no está configurado para Cloud, así que no puede confirmarlo. Elige «Iniciar sesión en cmux» y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac n’est pas configuré pour Cloud et ne peut donc pas confirmer cela. Choisissez « Se connecter à cmux », puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non è configurato per Cloud, quindi non può confermarlo. Scegli “Accedi a cmux”, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac は Cloud 用に設定されていないため、確認できません。「cmux にサインイン」を選んでから、もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac នេះមិនទាន់បានរៀបចំសម្រាប់ Cloud ទេ ដូច្នេះវាមិនអាចបញ្ជាក់រឿងនេះបានទេ។ ជ្រើស “ចូល cmux” រួចព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac은 Cloud용으로 설정되지 않아 확인할 수 없습니다. 'cmux에 로그인'을 선택한 다음 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Macen er ikke satt opp for Cloud, så den kan ikke bekrefte dette. Velg «Logg inn på cmux», og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac nie jest skonfigurowany dla Cloud, więc nie może tego potwierdzić. Wybierz „Zaloguj się do cmux”, a potem spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac não está configurado para o Cloud, então não pode confirmar isso. Escolha “Entrar no cmux” e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac не настроен для Cloud, поэтому не может это подтвердить. Выберите «Войти в cmux» и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac เครื่องนี้ยังไม่ได้ตั้งค่าสำหรับ Cloud จึงยืนยันรายการนี้ไม่ได้ เลือก “ลงชื่อเข้าใช้ cmux” แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac Cloud için ayarlanmamış, bu yüzden bunu onaylayamaz. “cmux'a giriş yap”ı seçin, sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей Mac не налаштовано для Cloud, тому він не може це підтвердити. Виберіть «Увійти в cmux» і спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac này chưa được thiết lập cho Cloud nên không thể xác nhận việc này. Hãy chọn “Đăng nhập cmux” rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 尚未设置 Cloud，因此无法确认此操作。请选择“登录 cmux”，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 尚未設定 Cloud，因此無法確認此操作。請選擇「登入 cmux」，然後再試一次。"
          }
        }
      }
    },
    "agentPane.addFiles.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
