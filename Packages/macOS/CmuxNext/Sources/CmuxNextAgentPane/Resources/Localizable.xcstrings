    "agentPane.error.gitDiscardStagedHunk": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file has staged changes. Revert the change in Unstaged, or revert the whole file."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحتوي هذا الملف على تغييرات مرحلية. تراجع عن التغيير في غير المرحلية، أو تراجع عن الملف كله."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ova datoteka ima pripremljene izmjene. Vrati izmjenu u Nepripremljeno ili vrati cijelu datoteku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne fil har ændringer i indekset. Fortryd ændringen i Ikke-indekseret, eller fortryd hele filen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Datei hat vorgemerkte Änderungen. Setze die Änderung unter „Nicht vorgemerkt“ zurück oder setze die ganze Datei zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este archivo tiene cambios preparados. Revierte el cambio en Sin preparar o revierte el archivo entero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce fichier a des modifications indexées. Annulez la modification dans Non indexé, ou annulez tout le fichier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo file ha modifiche nell’area di stage. Ripristina la modifica in Non in stage o ripristina l’intero file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このファイルにはステージ済みの変更があります。未ステージで変更を元に戻すか、ファイル全体を元に戻してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ឯកសារនេះមានការផ្លាស់ប្តូរដែលបានដាក់ជាដំណាក់កាល។ ត្រឡប់ការផ្លាស់ប្តូរនៅក្នុង មិនទាន់ដាក់ ឬត្រឡប់ឯកសារទាំងមូល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 파일에 스테이징된 변경 사항이 있습니다. 스테이징 안 됨에서 변경을 되돌리거나 파일 전체를 되돌리세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne filen har endringer i indeksen. Tilbakestill endringen i Ikke indeksert, eller tilbakestill hele filen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten plik ma zmiany w poczekalni. Cofnij zmianę w widoku Poza poczekalnią albo cofnij cały plik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este arquivo tem alterações preparadas. Reverta a alteração em Não preparadas ou reverta o arquivo inteiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В этом файле есть проиндексированные изменения. Откатите изменение во вкладке «Не проиндексировано» или откатите весь файл."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไฟล์นี้มีการเปลี่ยนแปลงที่ staged แล้ว ย้อนกลับการเปลี่ยนแปลงใน Unstaged หรือย้อนกลับทั้งไฟล์"
          }
