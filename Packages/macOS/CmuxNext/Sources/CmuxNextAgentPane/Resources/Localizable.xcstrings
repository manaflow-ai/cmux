          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มระดับของแฮนด์ “%1$@” เป็น %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” elinin düzeyini %2$@ olarak yükseltmek"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "підвищити рівень руки «%1$@» до %2$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "nâng mức của tay “%1$@” lên %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Hand “%1$@” 的级别提升为 %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 Hand “%1$@” 的等級提升為 %2$@"
          }
        }
      }
    },
    "hands.raise.default.sandbox": {
      "comment": "Reason in the Touch ID / password prompt (macOS shows it after “cmux is trying to”); %@ is the new level name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفع المستوى الافتراضي لأيدي البيئات المعزولة الجديدة إلى %@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "podići zadani nivo novih ruku u sandboxu na %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "hæve standardniveauet for nye sandbox-hænder til %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "die Standardstufe neuer Sandbox-Hände auf %@ anheben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "raise the default level of new sandbox hands to %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "subir el nivel predeterminado de las nuevas manos de sandbox a %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "élever le niveau par défaut des nouvelles mains sandbox à %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "alzare il livello predefinito delle nuove mani sandbox a %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいサンドボックス Hand の既定レベルを %@ に上げる"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បង្កើនកម្រិតលំនាំដើមនៃដៃ sandbox ថ្មីទៅ %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 샌드박스 Hand의 기본 수준을 %@(으)로 올리기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "heve standardnivået for nye sandkassehender til %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "podnieść domyślny poziom nowych rąk w piaskownicy do %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "elevar o nível padrão das novas mãos de sandbox para %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "повысить уровень по умолчанию для новых рук в песочнице до %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มระดับเริ่มต้นของแฮนด์แซนด์บ็อกซ์ใหม่เป็น %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "yeni sandbox ellerinin varsayılan düzeyini %@ olarak yükseltmek"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "підвищити типовий рівень нових рук у пісочниці до %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "nâng mức mặc định của các tay sandbox mới lên %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将新沙盒 Hand 的默认级别提升为 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將新沙盒 Hand 的預設等級提升為 %@"
          }
        }
      }
    },
