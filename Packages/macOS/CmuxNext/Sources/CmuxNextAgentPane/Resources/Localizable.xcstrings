    "agentPane.enableHarness.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A file in %@ asks to run this program with your rights in chats inside that folder. Enable it only if you trust every line below."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 内のファイルが、このフォルダ内のチャットであなたの権限でこのプログラムを実行しようとしています。以下のすべての行を信頼できる場合にのみ有効にしてください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يطلب ملف في %@ تشغيل هذا البرنامج بصلاحياتك في المحادثات داخل هذا المجلد. فعّله فقط إذا كنت تثق بكل سطر أدناه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Datoteka u %@ traži da pokreće ovaj program s vašim pravima u razgovorima unutar te mape. Omogućite ga samo ako vjerujete svakom redu ispod."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En fil i %@ beder om at køre dette program med dine rettigheder i chats i den mappe. Aktivér den kun, hvis du stoler på hver linje nedenfor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Datei in %@ möchte dieses Programm mit deinen Rechten in Chats in diesem Ordner ausführen. Aktiviere es nur, wenn du jeder Zeile unten vertraust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un archivo en %@ pide ejecutar este programa con tus permisos en los chats dentro de esa carpeta. Actívalo solo si confías en cada línea de abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un fichier dans %@ demande à exécuter ce programme avec vos droits dans les discussions de ce dossier. Activez-le seulement si vous faites confiance à chaque ligne ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un file in %@ chiede di eseguire questo programma con i tuoi permessi nelle chat dentro quella cartella. Abilitalo solo se ti fidi di ogni riga qui sotto."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ឯកសារមួយនៅក្នុង %@ ស្នើដំណើរការកម្មវិធីនេះដោយសិទ្ធិរបស់អ្នក ក្នុងការជជែកនៅក្នុងថតនោះ។ បើកវាតែពេលអ្នកទុកចិត្តគ្រប់បន្ទាត់ខាងក្រោម។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@의 파일이 이 폴더 안의 채팅에서 사용자의 권한으로 이 프로그램을 실행하려고 합니다. 아래의 모든 줄을 신뢰할 때만 활성화하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En fil i %@ ber om å kjøre dette programmet med dine rettigheter i chatter i den mappen. Aktiver den bare hvis du stoler på hver linje nedenfor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plik w %@ prosi o uruchamianie tego programu z Twoimi uprawnieniami w czatach w tym folderze. Włącz go tylko, jeśli ufasz każdemu wierszowi poniżej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um arquivo em %@ pede para executar este programa com suas permissões nos chats dentro dessa pasta. Ative-o somente se confiar em cada linha abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Файл в %@ просит запускать эту программу с вашими правами в чатах внутри этой папки. Включайте, только если доверяете каждой строке ниже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไฟล์ใน %@ ขอเรียกใช้โปรแกรมนี้ด้วยสิทธิ์ของคุณในแชตภายในโฟลเดอร์นั้น เปิดใช้เฉพาะเมื่อคุณเชื่อถือทุกบรรทัดด้านล่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ içindeki bir dosya, o klasördeki sohbetlerde bu programı sizin haklarınızla çalıştırmak istiyor. Yalnızca aşağıdaki her satıra güveniyorsanız etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Файл у %@ просить запускати цю програму з вашими правами в чатах усередині цієї теки. Вмикайте, лише якщо довіряєте кожному рядку нижче."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Một tệp trong %@ yêu cầu chạy chương trình này bằng quyền của bạn trong các cuộc trò chuyện bên trong thư mục đó. Chỉ bật nếu bạn tin mọi dòng bên dưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 中的一个文件要求在该文件夹内的聊天中以你的权限运行此程序。只有在你信任下面每一行时才启用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 中的一個檔案要求在該資料夾內的聊天中以你的權限執行此程式。只有在你信任下面每一行時才啟用。"
