    "agentPane.error.gitMergeBehind": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الفرع متأخر عن فرعه الأساسي. حدّثه، ثم ادمج."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova grana zaostaje za svojom osnovom. Ažurirajte je, pa spojite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne gren er bagud i forhold til sin base. Opdater den, og flet derefter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Branch liegt hinter seiner Basis. Aktualisiere ihn, dann führe zusammen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This branch is behind its base. Update it, then merge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta rama está por detrás de su base. Actualízala y luego fusiona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette branche est en retard sur sa base. Mettez-la à jour, puis fusionnez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo branch è indietro rispetto alla base. Aggiornalo, poi unisci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このブランチはベースより遅れています。更新してからマージしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សាខានេះនៅពីក្រោយមូលដ្ឋានរបស់វា។ សូមធ្វើបច្ចុប្បន្នភាព រួចបញ្ចូល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 브랜치가 기본 브랜치보다 뒤처져 있습니다. 업데이트한 다음 병합하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne grenen ligger bak grunnen sin. Oppdater den, og flett deretter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta gałąź jest za swoją bazą. Zaktualizuj ją, potem scal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este branch está atrás da base. Atualize-o e depois mescle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта ветка отстаёт от базовой. Обновите её, затем выполните слияние."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สาขานี้ตามหลังสาขาหลัก อัปเดตก่อน แล้วจึงผสาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dal temelinin gerisinde. Güncelleyin, sonra birleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця гілка відстає від базової. Оновіть її, потім виконайте злиття."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhánh này đang chậm hơn nhánh gốc. Hãy cập nhật rồi hợp nhất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此分支落后于其基础分支。请先更新，再合并。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此分支落後於其基礎分支。請先更新，再合併。"
          }
        }
      }
    },
    "agentPane.error.gitMergeUnknown": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال GitHub يتحقق مما إذا كان يمكن دمج طلب السحب هذا. حاول مرة أخرى بعد قليل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub još provjerava može li se ovaj zahtjev za povlačenje spojiti. Pokušajte ponovo za trenutak."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub tjekker stadig, om denne pull request kan flettes. Prøv igen om lidt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub prüft noch, ob dieser Pull Request zusammengeführt werden kann. Versuche es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub is still checking whether this pull request can merge. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub aún está comprobando si esta solicitud de incorporación se puede fusionar. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub vérifie encore si cette pull request peut être fusionnée. Réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub sta ancora verificando se questa pull request può essere unita. Riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub はこのプルリクエストをマージできるかまだ確認中です。少し待ってからもう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub នៅតែពិនិត្យថាតើសំណើទាញនេះអាចបញ្ចូលបានឬអត់។ សូមព្យាយាមម្ដងទៀតបន្តិចទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub가 아직 이 풀 리퀘스트의 병합 가능 여부를 확인하고 있습니다. 잠시 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub sjekker fortsatt om denne pull requesten kan flettes. Prøv igjen om litt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub wciąż sprawdza, czy ten pull request można scalić. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GitHub ainda está verificando se este pull request pode ser mesclado. Tente de novo em instantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ещё проверяет, можно ли слить этот пул-реквест. Повторите попытку чуть позже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ยังตรวจสอบอยู่ว่าพูลรีเควสต์นี้ผสานได้หรือไม่ ลองอีกครั้งในอีกสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub bu çekme isteğinin birleştirilip birleştirilemeyeceğini hâlâ denetliyor. Biraz sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ще перевіряє, чи можна злити цей пул-реквест. Спробуйте ще раз за мить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub vẫn đang kiểm tra xem pull request này có hợp nhất được không. Hãy thử lại sau giây lát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 仍在检查此拉取请求能否合并。请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 仍在檢查此提取要求能否合併。請稍後再試。"
          }
        }
      }
    },
    "agentPane.error.gitMergeChanged": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر طلب السحب لهذا الفرع. راجعه مرة أخرى قبل الدمج."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahtjev za povlačenje ove grane se promijenio. Pogledajte ga ponovo prije spajanja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne grens pull request er ændret. Se på den igen, før du fletter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Pull Request dieses Branches hat sich geändert. Sieh ihn dir vor dem Zusammenführen noch einmal an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This branch's pull request changed. Look at it again before merging."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud de incorporación de esta rama cambió. Revísala de nuevo antes de fusionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pull request de cette branche a changé. Consultez-la à nouveau avant de fusionner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pull request di questo branch è cambiata. Controllala di nuovo prima di unire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このブランチのプルリクエストが変更されました。マージする前にもう一度確認してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សំណើទាញរបស់សាខានេះបានផ្លាស់ប្ដូរ។ សូមពិនិត្យម្ដងទៀតមុនពេលបញ្ចូល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 브랜치의 풀 리퀘스트가 변경되었습니다. 병합하기 전에 다시 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne grenens pull request er endret. Se på den igjen før du fletter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull request tej gałęzi się zmienił. Sprawdź go ponownie przed scaleniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pull request deste branch mudou. Confira-o de novo antes de mesclar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пул-реквест этой ветки изменился. Посмотрите его ещё раз перед слиянием."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พูลรีเควสต์ของสาขานี้เปลี่ยนไป ตรวจดูอีกครั้งก่อนผสาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dalın çekme isteği değişti. Birleştirmeden önce yeniden bakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пул-реквест цієї гілки змінився. Перегляньте його ще раз перед злиттям."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull request của nhánh này đã thay đổi. Hãy xem lại trước khi hợp nhất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此分支的拉取请求已更改。合并前请再看一遍。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此分支的提取要求已變更。合併前請再看一次。"
          }
        }
      }
    },
    "agentPane.error.gitMergeHead": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الفرع هنا ليس رأس طلب السحب. ادفع أو اسحب أولاً، ثم ادمج."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova grana ovdje nije vrh zahtjeva za povlačenje. Prvo pošaljite ili povucite, pa spojite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Grenen her er ikke pull requestens head. Push eller pull først, og flet derefter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Branch hier ist nicht der Head des Pull Requests. Erst pushen oder pullen, dann zusammenführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This branch here isn't the pull request's head. Push or pull first, then merge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta rama aquí no es la cabeza de la solicitud de incorporación. Envía o trae cambios primero y luego fusiona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette branche ici n’est pas la tête de la pull request. Poussez ou tirez d’abord, puis fusionnez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo branch qui non è la head della pull request. Esegui prima push o pull, poi unisci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここのブランチはプルリクエストの先頭ではありません。先にプッシュまたはプルしてからマージしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សាខានៅទីនេះមិនមែនជាក្បាលនៃសំណើទាញទេ។ សូមរុញ ឬទាញជាមុនសិន រួចបញ្ចូល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기 브랜치가 풀 리퀘스트의 헤드가 아닙니다. 먼저 푸시하거나 풀한 다음 병합하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Grenen her er ikke pull requestens head. Push eller pull først, og flett deretter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta gałąź tutaj nie jest głową pull requesta. Najpierw wypchnij lub pobierz, potem scal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este branch aqui não é o head do pull request. Envie ou puxe primeiro e depois mescle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта ветка здесь не совпадает с головой пул-реквеста. Сначала отправьте или подтяните изменения, затем выполните слияние."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สาขานี้ที่นี่ไม่ใช่ส่วนหัวของพูลรีเควสต์ พุชหรือพูลก่อน แล้วจึงผสาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buradaki dal, çekme isteğinin başı değil. Önce gönderin veya çekin, sonra birleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця гілка тут не є головою пул-реквесту. Спершу надішліть або підтягніть зміни, потім виконайте злиття."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhánh ở đây không phải đầu của pull request. Hãy đẩy hoặc kéo trước, rồi hợp nhất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里的分支不是拉取请求的头部。请先推送或拉取，然后再合并。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡的分支不是提取要求的前端。請先推送或拉取，再合併。"
          }
        }
      }
    },
    "agentPane.error.gitMergeNotOpen": {
