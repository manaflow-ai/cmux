    "agentPane.error.gitMergeNotReady": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقول GitHub إن طلب السحب هذا غير جاهز للدمج: لا يزال هناك فحص أو مراجعة أو تعارض مفتوح."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub kaže da ovaj zahtjev za povlačenje nije spreman za spajanje: provjera, pregled ili konflikt je još otvoren."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub siger, at denne pull request ikke er klar til at blive flettet: en kontrol, en gennemgang eller en konflikt er stadig åben."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laut GitHub ist dieser Pull Request noch nicht bereit zum Zusammenführen: Eine Prüfung, ein Review oder ein Konflikt ist noch offen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub says this pull request isn't ready to merge: a check, a review or a conflict is still open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub indica que esta solicitud de incorporación no está lista para fusionarse: aún hay una comprobación, una revisión o un conflicto pendiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Selon GitHub, cette pull request n’est pas prête à être fusionnée : une vérification, une revue ou un conflit reste ouvert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Secondo GitHub questa pull request non è pronta per l’unione: un controllo, una revisione o un conflitto è ancora aperto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub によると、このプルリクエストはまだマージできません。チェック、レビュー、またはコンフリクトが残っています。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub និយាយថាសំណើទាញនេះមិនទាន់រួចរាល់សម្រាប់បញ្ចូលទេ៖ ការត្រួតពិនិត្យ ការពិនិត្យ ឬការប៉ះទង្គិចនៅតែបើក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub에 따르면 이 풀 리퀘스트는 아직 병합할 수 없습니다. 검사, 리뷰 또는 충돌이 남아 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub sier at denne pull requesten ikke er klar til fletting: en kontroll, en gjennomgang eller en konflikt er fortsatt åpen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub podaje, że ten pull request nie jest gotowy do scalenia: kontrola, recenzja lub konflikt są nadal otwarte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GitHub diz que este pull request não está pronto para mesclar: uma verificação, uma revisão ou um conflito ainda está aberto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По данным GitHub, этот пул-реквест ещё не готов к слиянию: проверка, ревью или конфликт ещё не завершены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub แจ้งว่าพูลรีเควสต์นี้ยังไม่พร้อมผสาน: ยังมีการตรวจสอบ การรีวิว หรือความขัดแย้งค้างอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub'a göre bu çekme isteği birleştirmeye hazır değil: bir denetim, inceleme veya çakışma hâlâ açık."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За даними GitHub, цей пул-реквест ще не готовий до злиття: перевірка, рецензія або конфлікт ще відкриті."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub cho biết pull request này chưa sẵn sàng hợp nhất: vẫn còn một kiểm tra, đánh giá hoặc xung đột đang mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 显示此拉取请求尚不能合并：仍有检查、审查或冲突未完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 顯示此提取要求尚無法合併：仍有檢查、審查或衝突未完成。"
          }
        }
      }
    },
