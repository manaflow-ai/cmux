            "value": "No se encontró acpmux. Instálalo en tu PATH o en una de estas carpetas: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux est introuvable. Installez-le dans votre PATH ou dans l’un de ces dossiers : %@."
