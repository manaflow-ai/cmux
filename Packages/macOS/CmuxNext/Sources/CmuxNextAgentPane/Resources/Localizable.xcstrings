          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "元に戻した後にファイルが変更されたため、取り消しで変更を戻せません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ឯកសារបានផ្លាស់ប្តូរបន្ទាប់ពីការត្រឡប់វិញ ដូច្នេះមិនអាចដាក់ការផ្លាស់ប្តូរវិញបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "되돌린 뒤 파일이 바뀌어 실행 취소로 변경 사항을 되살릴 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Filen endret seg etter tilbakestillingen, så Angre kan ikke sette endringen tilbake."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plik zmienił się po cofnięciu, więc nie można przywrócić zmiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O arquivo mudou depois de reverter, então Desfazer não pode restaurar a alteração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Файл изменился после отката, поэтому отменить откат нельзя."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไฟล์เปลี่ยนไปหลังการย้อนกลับ จึงเลิกทำเพื่อนำการเปลี่ยนแปลงกลับมาไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dosya geri almadan sonra değişti, bu yüzden değişiklik geri getirilemez."
          }
        },
        "uk": {
          "stringUnit": {
