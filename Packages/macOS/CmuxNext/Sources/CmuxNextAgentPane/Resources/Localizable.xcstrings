        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم خدمة acpmux أخرى هذا المقبس. ستُعاد محاولة الاتصال عندما تصبح تلك الخدمة جاهزة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Drugi acpmux servis koristi ovaj socket. Veza će se ponovo uspostaviti kada servis bude spreman."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En anden acpmux-tjeneste bruger denne socket. Der oprettes forbindelse igen, når tjenesten er klar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
