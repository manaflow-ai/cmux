    "agentPane.daemonUpdate.machines.updateRefused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This machine can't be updated now. Try again once it's connected."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تحديث هذا الجهاز الآن. حاول مرة أخرى بعد اتصاله."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova mašina se trenutno ne može ažurirati. Pokušajte ponovo kada se poveže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne maskine kan ikke opdateres nu. Prøv igen, når den er forbundet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Maschine kann gerade nicht aktualisiert werden. Versuche es erneut, sobald sie verbunden ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta máquina no se puede actualizar ahora. Vuelve a intentarlo cuando esté conectada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de mettre à jour cette machine pour l'instant. Réessayez une fois qu'elle est connectée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento non è possibile aggiornare questa macchina. Riprova quando è connessa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このマシンは今はアップデートできません。接続されてからもう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចធ្វើបច្ចុប្បន្នភាពម៉ាស៊ីននេះឥឡូវនេះបានទេ។ សូមព្យាយាមម្តងទៀតនៅពេលវាបានភ្ជាប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 이 머신을 업데이트할 수 없습니다. 연결된 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne maskinen kan ikke oppdateres nå. Prøv igjen når den er tilkoblet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można teraz zaktualizować tej maszyny. Spróbuj ponownie, gdy będzie połączona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível atualizar esta máquina agora. Tente novamente quando ela estiver conectada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас эту машину нельзя обновить. Попробуйте снова, когда она подключится."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังอัปเดตเครื่องนี้ไม่ได้ในตอนนี้ ลองอีกครั้งเมื่อเชื่อมต่อแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu makine şu anda güncellenemiyor. Bağlandığında yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз цю машину не можна оновити. Спробуйте ще раз, коли вона підключиться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể cập nhật máy này lúc này. Hãy thử lại khi máy đã kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无法更新这台机器。连接后请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法更新這台機器。連線後請再試一次。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
