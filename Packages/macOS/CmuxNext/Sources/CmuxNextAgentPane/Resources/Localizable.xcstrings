          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro servizio acpmux sta usando questo socket. La connessione verrà ripristinata quando sarà pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
