    "agentPane.checkpoint.changed": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The repository changed. Refresh the checkpoint options."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "リポジトリが変更されました。チェックポイントオプションを更新します。"
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "تم تغيير المستودع. قم بتحديث خيارات نقطة التفتيش."
        }
      },
      "bs": {
        "stringUnit": {
          "state": "translated",
          "value": "Repozitorij je promijenjen. Osvježite opcije kontrolnih tačaka."
        }
      },
      "da": {
        "stringUnit": {
          "state": "translated",
          "value": "Lageret blev ændret. Opdater kontrolpunktindstillingerne."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Das Repository hat sich geändert. Aktualisieren Sie die Checkpoint-Optionen."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "El repositorio ha cambiado. Actualice las opciones del punto de control."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Le référentiel a changé. Actualisez les options du point de contrôle."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Il repository è cambiato. Aggiorna le opzioni del checkpoint."
        }
      },
      "km": {
        "stringUnit": {
          "state": "translated",
          "value": "បាន ផ្លាស់ប្ដូរ ឃ្លាំង & # 160; ។ ធ្វើ ឲ្យ ជម្រើស ចំណុច ត្រួត ពិនិត្យ ស្រស់ & # 160; ។"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "저장소가 변경되었습니다. 체크포인트 옵션을 새로 고치십시오."
        }
      },
      "nb": {
        "stringUnit": {
          "state": "translated",
          "value": "Repositoriet ble endret. Oppdater kontrollpunktalternativene."
        }
      },
      "pl": {
        "stringUnit": {
          "state": "translated",
          "value": "Zmieniło się repozytorium. Odśwież opcje punktu kontrolnego."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "O repositório foi alterado. Atualize as opções do ponto de verificação."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Репозиторий изменился. Обновите параметры контрольной точки."
        }
      },
      "th": {
        "stringUnit": {
          "state": "translated",
          "value": "เปลี่ยนที่เก็บแล้วรีเฟรชตัวเลือกจุดตรวจสอบ"
        }
      },
      "tr": {
        "stringUnit": {
          "state": "translated",
          "value": "Depo değişti. Kontrol noktası seçeneklerini yenileyin."
        }
      },
      "uk": {
        "stringUnit": {
          "state": "translated",
          "value": "Репозиторій змінився. Оновіть параметри контрольної точки."
        }
      },
      "vi": {
        "stringUnit": {
          "state": "translated",
          "value": "Kho lưu trữ đã thay đổi. Làm mới các tùy chọn điểm kiểm tra."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "存储库已更改。刷新检查点选项。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "儲存庫已變更。重新整理檢查點選項。"
        }
      }
    }
  },
    "agentPane.checkpoint.unsupported": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Repository checkpoints are unavailable for this session."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "リポジトリチェックポイントはこのセッションでは使用できません。"
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "نقاط تفتيش المستودع غير متاحة لهذه الجلسة."
        }
      },
      "bs": {
        "stringUnit": {
          "state": "translated",
          "value": "Kontrolne tačke spremišta nisu dostupne za ovu sesiju."
        }
      },
      "da": {
        "stringUnit": {
          "state": "translated",
          "value": "Lagerkontrolpunkter er ikke tilgængelige for denne session."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Repository-Prüfpunkte sind für diese Sitzung nicht verfügbar."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Los puntos de control del repositorio no están disponibles para esta sesión."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Les points de contrôle du référentiel ne sont pas disponibles pour cette session."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "I punti di controllo del repository non sono disponibili per questa sessione."
        }
      },
      "km": {
        "stringUnit": {
          "state": "translated",
          "value": "ចំណុចត្រួតពិនិត្យឃ្លាំងមិនមានសម្រាប់វគ្គនេះទេ ។"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "이 세션에서는 저장소 체크포인트를 사용할 수 없습니다."
        }
      },
      "nb": {
        "stringUnit": {
          "state": "translated",
          "value": "Kontrollpunkter for depotet er ikke tilgjengelige for denne økten."
        }
      },
      "pl": {
        "stringUnit": {
          "state": "translated",
          "value": "Punkty kontrolne repozytorium są niedostępne dla tej sesji."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Os pontos de verificação do repositório não estão disponíveis para esta sessão."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Контрольные точки репозитория недоступны для этого сеанса."
        }
      },
      "th": {
        "stringUnit": {
          "state": "translated",
          "value": "จุดตรวจสอบที่เก็บไม่พร้อมใช้งานสำหรับเซสชั่นนี้"
        }
      },
      "tr": {
        "stringUnit": {
          "state": "translated",
          "value": "Bu oturum için depo kontrol noktaları kullanılamıyor."
        }
      },
      "uk": {
        "stringUnit": {
          "state": "translated",
          "value": "Контрольні точки репозиторію недоступні для цього сеансу."
        }
      },
      "vi": {
        "stringUnit": {
          "state": "translated",
          "value": "Các điểm kiểm tra kho lưu trữ không khả dụng cho phiên này."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "存储库检查点对此会话不可用。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "此工作階段無法使用儲存庫檢查點。"
        }
      }
    }
  },
