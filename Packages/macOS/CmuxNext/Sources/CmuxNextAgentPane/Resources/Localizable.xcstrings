    "agentPane.error.gitPullFirst": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الفرع متأخر عن نسخته البعيدة. اسحب التغييرات أولاً، ثم افتح طلب السحب."
