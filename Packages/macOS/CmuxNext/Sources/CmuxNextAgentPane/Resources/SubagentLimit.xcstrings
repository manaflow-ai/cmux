        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중 %1$lld개, 대기 중 %2$lld개."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中 %1$lld、待機中 %2$lld。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokrenuto: %1$lld, čeka: %2$lld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld kører, %2$lld venter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld in esecuzione, %2$lld in attesa."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កំពុងដំណើរការ %1$lld, កំពុងរង់ចាំ %2$lld។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld kjører, %2$lld venter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa: %1$lld, czeka: %2$lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld em execução, %2$lld aguardando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает: %1$lld, ожидает: %2$lld."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำงานอยู่ %1$lld รออยู่ %2$lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld çalışıyor, %2$lld bekliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запущено: %1$lld, чекає: %2$lld."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld đang chạy, %2$lld đang chờ."
          }
        }
      }
    },
