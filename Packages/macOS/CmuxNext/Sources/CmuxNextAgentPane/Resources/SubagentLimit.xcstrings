    "subagentLimit.invalid": {
      "comment": "Subagent Limit dialog: the field is not a whole number; %1$lld and %2$lld are the lowest and highest allowed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a whole number from %1$lld to %2$lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine ganze Zahl von %1$lld bis %2$lld ein."
          }
        },
        "fr": {
