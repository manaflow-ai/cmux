    "cookieBackups.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لن يتمكن الوكيل بعد ذلك من التراجع عن مسح ملفات تعريف الارتباط هذه. لا يمكنك التراجع عن هذا الإجراء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agent više neće moći poništiti ova brisanja kolačića. Ovo ne možete poništiti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En agent kan ikke længere fortryde disse cookie-rydninger. Du kan ikke fortryde dette."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Agent kann diese Cookie-Löschungen dann nicht mehr rückgängig machen. Du kannst das nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An agent can no longer undo these cookie clears. You cannot undo this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un agente ya no podrá deshacer estos borrados de cookies. No puedes deshacer esta acción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un agent ne pourra plus annuler ces effacements de cookies. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un agente non potrà più annullare queste cancellazioni dei cookie. Non puoi annullare questa azione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "エージェントはこれらの Cookie の消去を取り消せなくなります。この操作は取り消せません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ភ្នាក់ងារមិនអាចមិនធ្វើការសម្អាតខូគីទាំងនេះវិញបានទៀតទេ។ អ្នកមិនអាចមិនធ្វើវិញបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트가 더 이상 이 쿠키 지우기를 취소할 수 없습니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En agent kan ikke lenger angre disse slettingene av informasjonskapsler. Du kan ikke angre dette."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agent nie będzie już mógł cofnąć tych czyszczeń plików cookie. Tej czynności nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um agente não poderá mais desfazer essas limpezas de cookies. Não é possível desfazer esta ação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Агент больше не сможет отменить эти очистки cookie. Это действие нельзя отменить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เอเจนต์จะเลิกทำการล้างคุกกี้เหล่านี้ไม่ได้อีก คุณเลิกทำการนี้ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir ajan artık bu çerez temizlemelerini geri alamaz. Bu işlemi geri alamazsınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Агент більше не зможе скасувати ці очищення cookie. Цю дію не можна скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tác nhân sẽ không thể hoàn tác các lần xóa cookie này nữa. Bạn không thể hoàn tác thao tác này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "代理将无法再撤销这些 Cookie 清除。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "代理程式將無法再復原這些 Cookie 清除。此操作無法復原。"
          }
        }
      }
    },
    "cookieBackups.confirm.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هل تريد حذف هذه النسخ الاحتياطية لملفات تعريف الارتباط؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obrisati ove sigurnosne kopije kolačića?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slet disse cookie-sikkerhedskopier?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Cookie-Sicherungen löschen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete these cookie backups?"
          }
