          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Supprimer ces sauvegardes de cookies ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eliminare questi backup dei cookie?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "これらの Cookie のバックアップを削除しますか？"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "លុបការបម្រុងទុកខូគីទាំងនេះ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 쿠키 백업을 삭제하겠습니까?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slette disse sikkerhetskopiene av informasjonskapsler?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usunąć te kopie zapasowe plików cookie?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apagar estes backups de cookies?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Удалить эти резервные копии cookie?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลบข้อมูลสำรองคุกกี้เหล่านี้หรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu çerez yedekleri silinsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Видалити ці резервні копії cookie?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xóa các bản sao lưu cookie này?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "要删除这些 Cookie 备份吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "要刪除這些 Cookie 備份嗎？"
          }
        }
      }
    },
