    "import.lead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring what Claude Code, Codex, ChatGPT or claude.ai already know about you into your Chief. It runs in the background and your Chief keeps answering."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "انقل ما يعرفه Claude Code وCodex وChatGPT وclaude.ai عنك إلى Chief. يعمل في الخلفية ويواصل Chief الرد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prenesite ono što Claude Code, Codex, ChatGPT ili claude.ai već znaju o vama u svog Chiefa. Radi u pozadini, a Chief nastavlja odgovarati."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Før det, som Claude Code, Codex, ChatGPT eller claude.ai allerede ved om dig, ind i din Chief. Det kører i baggrunden, og din Chief svarer stadig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bring das, was Claude Code, Codex, ChatGPT oder claude.ai schon über dich wissen, in deinen Chief. Es läuft im Hintergrund, und dein Chief antwortet weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lleva a tu Chief lo que Claude Code, Codex, ChatGPT o claude.ai ya saben de ti. Se hace en segundo plano y tu Chief sigue respondiendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apportez à votre Chief ce que Claude Code, Codex, ChatGPT ou claude.ai savent déjà de vous. Cela se fait en arrière-plan et votre Chief continue de répondre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Porta nel tuo Chief ciò che Claude Code, Codex, ChatGPT o claude.ai sanno già di te. Va in background e il tuo Chief continua a rispondere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Claude Code、Codex、ChatGPT、claude.ai がすでに知っているあなたの情報を Chief に取り込みます。バックグラウンドで実行され、Chief は応答を続けます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "នាំយកអ្វីដែល Claude Code, Codex, ChatGPT ឬ claude.ai ស្គាល់អំពីអ្នករួចហើយ មកក្នុង Chief របស់អ្នក។ វាដំណើរការនៅផ្ទៃខាងក្រោយ ហើយ Chief នៅតែឆ្លើយតប។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Claude Code, Codex, ChatGPT, claude.ai가 이미 알고 있는 내용을 Chief로 가져옵니다. 백그라운드에서 실행되며 Chief는 계속 응답합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ta med det Claude Code, Codex, ChatGPT eller claude.ai allerede vet om deg inn i Chief. Det kjører i bakgrunnen, og Chief svarer fortsatt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przenieś do swojego Chiefa to, co Claude Code, Codex, ChatGPT lub claude.ai już o Tobie wiedzą. Działa w tle, a Chief nadal odpowiada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Traga para o seu Chief o que o Claude Code, o Codex, o ChatGPT ou o claude.ai já sabem sobre você. Roda em segundo plano e o Chief continua respondendo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перенесите в своего Chief то, что Claude Code, Codex, ChatGPT или claude.ai уже знают о вас. Работает в фоне, Chief продолжает отвечать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "นำสิ่งที่ Claude Code, Codex, ChatGPT หรือ claude.ai รู้เกี่ยวกับคุณมาไว้ใน Chief ทำงานเบื้องหลัง และ Chief ยังตอบได้ตามปกติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Claude Code, Codex, ChatGPT veya claude.ai’ın sizin hakkınızda bildiklerini Chief’inize taşıyın. Arka planda çalışır, Chief yanıt vermeye devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перенесіть у свого Chief те, що Claude Code, Codex, ChatGPT або claude.ai уже знають про вас. Працює у фоні, Chief і далі відповідає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đưa những gì Claude Code, Codex, ChatGPT hoặc claude.ai đã biết về bạn vào Chief của bạn. Việc này chạy nền và Chief vẫn tiếp tục trả lời."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "把 Claude Code、Codex、ChatGPT 或 claude.ai 已经了解的你的信息带入你的 Chief。它在后台运行，Chief 会继续回答。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "把 Claude Code、Codex、ChatGPT 或 claude.ai 已經了解的你的資訊帶入你的 Chief。它在背景執行，Chief 會繼續回答。"
          }
        }
      }
    },
    "import.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwords and API keys are never copied. A backup is made first, and you can undo the import."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يتم نسخ كلمات المرور ومفاتيح API أبدًا. تُنشأ نسخة احتياطية أولًا ويمكنك التراجع عن الاستيراد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lozinke i API ključevi se nikada ne kopiraju. Prvo se pravi sigurnosna kopija, a uvoz možete poništiti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adgangskoder og API-nøgler kopieres aldrig. Der laves først en sikkerhedskopi, og du kan fortryde importen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Passwörter und API-Schlüssel werden nie kopiert. Zuerst wird ein Backup angelegt, und du kannst den Import rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nunca se copian contraseñas ni claves de API. Antes se hace una copia de seguridad y puedes deshacer la importación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les mots de passe et clés d’API ne sont jamais copiés. Une sauvegarde est faite d’abord et vous pouvez annuler l’import."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Password e chiavi API non vengono mai copiate. Prima si crea un backup e puoi annullare l’importazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "パスワードや API キーはコピーされません。先にバックアップを作成し、読み込みは取り消せます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ពាក្យសម្ងាត់ និងសោ API មិនត្រូវបានចម្លងឡើយ។ ការបម្រុងទុកត្រូវបានធ្វើមុន ហើយអ្នកអាចត្រឡប់ការនាំចូលវិញបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "비밀번호와 API 키는 복사되지 않습니다. 먼저 백업을 만들고, 가져오기를 취소할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Passord og API-nøkler kopieres aldri. Det tas først en sikkerhetskopi, og du kan angre importen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hasła i klucze API nigdy nie są kopiowane. Najpierw powstaje kopia zapasowa, a import można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Senhas e chaves de API nunca são copiadas. Um backup é feito antes e você pode desfazer a importação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пароли и ключи API никогда не копируются. Сначала создаётся резервная копия, импорт можно отменить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่มีการคัดลอกรหัสผ่านและคีย์ API จะสำรองข้อมูลก่อน และคุณยกเลิกการนำเข้าได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Parolalar ve API anahtarları asla kopyalanmaz. Önce yedek alınır ve içe aktarmayı geri alabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Паролі й ключі API ніколи не копіюються. Спершу створюється резервна копія, імпорт можна скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mật khẩu và khóa API không bao giờ được sao chép. Bản sao lưu được tạo trước và bạn có thể hoàn tác việc nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "绝不会复制密码和 API 密钥。会先创建备份，你可以撤销导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "絕不會複製密碼和 API 金鑰。會先建立備份，你可以復原匯入。"
          }
        }
      }
    },
    "import.restartNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Chief restarts for a moment while the memory is written."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يُعاد تشغيل Chief لحظة أثناء كتابة الذاكرة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief se nakratko ponovo pokreće dok se memorija upisuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Din Chief genstarter et øjeblik, mens hukommelsen skrives."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Chief startet kurz neu, während das Gedächtnis geschrieben wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu Chief se reinicia un momento mientras se escribe la memoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre Chief redémarre un instant pendant l’écriture de la mémoire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il tuo Chief si riavvia per un momento mentre la memoria viene scritta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "メモリの書き込み中、Chief は一瞬再起動します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief ចាប់ផ្តើមឡើងវិញមួយភ្លែត ខណៈពេលសរសេរការចងចាំ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "메모리를 쓰는 동안 Chief가 잠시 다시 시작됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief starter på nytt et øyeblikk mens minnet skrives."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief na chwilę uruchomi się ponownie podczas zapisu pamięci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Chief reinicia por um instante enquanto a memória é gravada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief ненадолго перезапустится, пока записывается память."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief จะรีสตาร์ตชั่วครู่ระหว่างที่เขียนความจำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bellek yazılırken Chief kısa süreliğine yeniden başlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief ненадовго перезапуститься, поки записується пам’ять."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief khởi động lại trong giây lát khi ghi bộ nhớ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "写入记忆时，Chief 会短暂重启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "寫入記憶時，Chief 會短暫重新啟動。"
          }
        }
      }
    },
    "import.nothingFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing found on this Mac. Export your data from ChatGPT or claude.ai, save the zip in Downloads, or choose the file."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يُعثر على شيء على هذا الـ Mac. صدّر بياناتك من ChatGPT أو claude.ai واحفظ ملف zip في التنزيلات، أو اختر الملف."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ništa nije pronađeno na ovom Macu. Izvezite podatke iz ChatGPT-a ili claude.ai, sačuvajte zip u Preuzimanja ili odaberite datoteku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Intet fundet på denne Mac. Eksportér dine data fra ChatGPT eller claude.ai, gem zip-filen i Downloads, eller vælg filen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auf diesem Mac wurde nichts gefunden. Exportiere deine Daten aus ChatGPT oder claude.ai, lege die Zip-Datei in Downloads ab oder wähle die Datei aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se encontró nada en este Mac. Exporta tus datos de ChatGPT o claude.ai, guarda el zip en Descargas o elige el archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rien trouvé sur ce Mac. Exportez vos données depuis ChatGPT ou claude.ai, enregistrez le zip dans Téléchargements, ou choisissez le fichier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non è stato trovato nulla su questo Mac. Esporta i tuoi dati da ChatGPT o claude.ai, salva lo zip in Download o scegli il file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この Mac には見つかりませんでした。ChatGPT または claude.ai からデータをエクスポートし、zip を「ダウンロード」に保存するか、ファイルを選択してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "រកមិនឃើញអ្វីនៅលើ Mac នេះទេ។ នាំចេញទិន្នន័យពី ChatGPT ឬ claude.ai រក្សាទុក zip ក្នុង Downloads ឬជ្រើសរើសឯកសារ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 Mac에서 아무것도 찾지 못했습니다. ChatGPT 또는 claude.ai에서 데이터를 내보내 zip을 다운로드 폴더에 저장하거나 파일을 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fant ingenting på denne Macen. Eksporter dataene dine fra ChatGPT eller claude.ai, lagre zip-filen i Nedlastinger, eller velg filen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nic nie znaleziono na tym Macu. Wyeksportuj dane z ChatGPT lub claude.ai, zapisz plik zip w Pobranych albo wybierz plik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nada encontrado neste Mac. Exporte seus dados do ChatGPT ou do claude.ai, salve o zip em Downloads ou escolha o arquivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На этом Mac ничего не найдено. Экспортируйте данные из ChatGPT или claude.ai, сохраните zip в «Загрузки» или выберите файл."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่พบสิ่งใดบน Mac เครื่องนี้ ส่งออกข้อมูลจาก ChatGPT หรือ claude.ai บันทึกไฟล์ zip ไว้ใน Downloads หรือเลือกไฟล์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu Mac’te hiçbir şey bulunamadı. Verilerinizi ChatGPT veya claude.ai’dan dışa aktarın, zip dosyasını İndirilenler’e kaydedin ya da dosyayı seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На цьому Mac нічого не знайдено. Експортуйте дані з ChatGPT або claude.ai, збережіть zip у «Завантаження» або виберіть файл."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không tìm thấy gì trên máy Mac này. Hãy xuất dữ liệu từ ChatGPT hoặc claude.ai, lưu tệp zip vào Tải về, hoặc chọn tệp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在这台 Mac 上没有找到任何内容。请从 ChatGPT 或 claude.ai 导出数据，把 zip 存到“下载”，或选择该文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在這台 Mac 上找不到任何內容。請從 ChatGPT 或 claude.ai 匯出資料，把 zip 存到「下載項目」，或選擇該檔案。"
          }
        }
      }
    },
