    "chiefMemory.malformed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أجاب Chief بطريقة لا يفهمها هذا الإصدار من cmux."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief je odgovorio na način koji ova verzija cmuxa ne razumije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief svarede på en måde, som denne version af cmux ikke forstår."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Chief hat so geantwortet, wie diese Version von cmux es nicht versteht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Chief answered in a way this version of cmux does not understand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El Chief respondió de una forma que esta versión de cmux no entiende."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le Chief a répondu d’une manière que cette version de cmux ne comprend pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il Chief ha risposto in un modo che questa versione di cmux non capisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief の応答を、このバージョンの cmux は理解できません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief បានឆ្លើយតបតាមរបៀបដែលកំណែ cmux នេះមិនយល់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief가 이 버전의 cmux가 이해할 수 없는 방식으로 응답했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief svarte på en måte denne versjonen av cmux ikke forstår."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief odpowiedział w sposób, którego ta wersja cmux nie rozumie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Chief respondeu de um jeito que esta versão do cmux não entende."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief ответил так, что эта версия cmux не понимает ответ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief ตอบกลับในแบบที่ cmux เวอร์ชันนี้ไม่เข้าใจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief, cmux’un bu sürümünün anlamadığı bir şekilde yanıt verdi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief відповів так, що ця версія cmux не розуміє відповіді."
          }
        },
        "vi": {
          "stringUnit": {
