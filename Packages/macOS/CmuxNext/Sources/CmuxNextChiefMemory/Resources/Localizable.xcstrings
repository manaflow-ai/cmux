    "import.tooCostly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Summarizing this would cost about $%@, so it was not started. Pick fewer sources."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تلخيص هذا سيكلّف نحو $%@، لذا لم يبدأ. اختر مصادر أقل."
