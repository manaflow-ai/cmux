    "chiefMemory.pick": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اختر سطرًا لترى ما يغطيه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odaberite red da vidite šta obuhvata."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vælg en linje for at se, hvad den dækker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wähle eine Zeile, um zu sehen, was sie umfasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a line to see what it covers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Selecciona una línea para ver qué abarca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sélectionnez une ligne pour voir ce qu’elle couvre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seleziona una riga per vedere cosa copre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行を選ぶと、その行が含む内容が表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ជ្រើសបន្ទាត់មួយដើម្បីមើលអ្វីដែលវាគ្របដណ្ដប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "줄을 선택하면 그 줄이 다루는 내용이 보입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Velg en linje for å se hva den dekker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybierz wiersz, aby zobaczyć, co obejmuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Selecione uma linha para ver o que ela abrange."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выберите строку, чтобы увидеть, что она охватывает."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เลือกบรรทัดเพื่อดูว่าครอบคลุมอะไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neyi kapsadığını görmek için bir satır seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Виберіть рядок, щоб побачити, що він охоплює."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chọn một dòng để xem nó bao gồm gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "选择一行以查看其涵盖的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選擇一行以查看其涵蓋的內容。"
          }
        }
      }
    },
    "chiefMemory.readOnly": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكن قراءة ذاكرة Chief هذا هنا دون تغييرها. حدّث cmux لتغييرها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Memorija ovog Chiefa se ovdje može čitati, ali ne i mijenjati. Ažurirajte cmux da biste je mijenjali."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne Chiefs hukommelse kan læses her, men ikke ændres. Opdater cmux for at ændre den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Gedächtnis dieses Chiefs kann hier gelesen, aber nicht geändert werden. Aktualisiere cmux, um es zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Chief’s memory can be read here but not changed. Update cmux to change it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La memoria de este Chief se puede leer aquí, pero no cambiar. Actualiza cmux para cambiarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La mémoire de ce Chief peut être lue ici mais pas modifiée. Mettez cmux à jour pour la modifier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La memoria di questo Chief si può leggere qui ma non modificare. Aggiorna cmux per modificarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Chief のメモリはここで読めますが、変更はできません。変更するには cmux をアップデートしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អង្គចងចាំរបស់ Chief នេះអាចអាននៅទីនេះ ប៉ុន្តែមិនអាចផ្លាស់ប្តូរបានទេ។ ធ្វើបច្ចុប្បន្នភាព cmux ដើម្បីផ្លាស់ប្តូរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 Chief의 메모리는 여기서 읽을 수 있지만 변경할 수는 없습니다. 변경하려면 cmux를 업데이트하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne Chiefens minne kan leses her, men ikke endres. Oppdater cmux for å endre det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pamięć tego Chiefa można tu czytać, ale nie zmieniać. Zaktualizuj cmux, aby ją zmieniać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A memória deste Chief pode ser lida aqui, mas não alterada. Atualize o cmux para alterá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Память этого Chief можно читать здесь, но не изменять. Обновите cmux, чтобы изменять её."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อ่านหน่วยความจำของ Chief นี้ได้ที่นี่แต่เปลี่ยนไม่ได้ อัปเดต cmux เพื่อเปลี่ยน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu Chief’in belleği burada okunabilir ama değiştirilemez. Değiştirmek için cmux’u güncelleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пам’ять цього Chief можна читати тут, але не змінювати. Оновіть cmux, щоб змінювати її."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bộ nhớ của Chief này đọc được ở đây nhưng không thay đổi được. Hãy cập nhật cmux để thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此 Chief 的记忆可以在这里读取，但不能更改。请更新 cmux 以进行更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此 Chief 的記憶可以在這裡讀取，但不能變更。請更新 cmux 以進行變更。"
          }
        }
      }
    },
