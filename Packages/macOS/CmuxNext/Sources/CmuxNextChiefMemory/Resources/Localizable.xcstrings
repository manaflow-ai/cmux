    "chiefMemory.changes.none": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا توجد تغييرات بعد. تُكتب نسخة احتياطية قبل أول تغيير."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Još nema promjena. Rezervna kopija se piše prije prve."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen ændringer endnu. Der skrives en sikkerhedskopi før den første."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noch keine Änderungen. Vor der ersten wird eine Sicherung geschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No changes yet. A backup is written before the first one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aún no hay cambios. Se crea una copia de seguridad antes del primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucune modification pour l’instant. Une sauvegarde est écrite avant la première."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessuna modifica per ora. Prima della prima viene scritto un backup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ変更はありません。最初の変更の前にバックアップが作成されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនទាន់មានការផ្លាស់ប្តូរទេ។ ច្បាប់បម្រុងទុកត្រូវបានសរសេរមុនការផ្លាស់ប្តូរដំបូង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "아직 변경 사항이 없습니다. 첫 변경 전에 백업이 작성됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen endringer ennå. En sikkerhetskopi skrives før den første."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brak zmian. Przed pierwszą zapisywana jest kopia zapasowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhuma alteração ainda. Um backup é gravado antes da primeira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Изменений пока нет. Перед первым записывается резервная копия."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังไม่มีการเปลี่ยนแปลง จะมีการเขียนสำรองก่อนการเปลี่ยนแปลงแรก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Henüz değişiklik yok. İlkinden önce bir yedek yazılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Змін поки немає. Перед першою записується резервна копія."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chưa có thay đổi. Một bản sao lưu được ghi trước thay đổi đầu tiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "尚无更改。第一次更改前会写入备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "尚無變更。第一次變更前會寫入備份。"
          }
        }
      }
    },
