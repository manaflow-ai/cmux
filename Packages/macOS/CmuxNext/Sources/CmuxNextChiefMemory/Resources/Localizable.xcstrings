    "chiefMemory.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يصبح نصه «(deleted by the user)» وتُعاد كتابة الملخصات التي فوقه. يُحتفظ بنسخة احتياطية، ويمكنك التراجع عن ذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Njegov tekst postaje „(deleted by the user)”, a sažeci iznad se ponovo grade. Rezervna kopija se čuva i ovo možete poništiti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teksten bliver “(deleted by the user)”, og resuméerne over den genopbygges. Der gemmes en sikkerhedskopi, og du kan fortryde dette."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Text wird zu „(deleted by the user)“ und die Zusammenfassungen darüber werden neu erstellt. Eine Sicherung bleibt erhalten, und du kannst dies widerrufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its text becomes “(deleted by the user)” and the summaries above it are rebuilt. A backup is kept, and you can undo this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Su texto pasa a ser «(deleted by the user)» y se reconstruyen los resúmenes superiores. Se guarda una copia de seguridad y puedes deshacerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Son texte devient « (deleted by the user) » et les résumés au-dessus sont reconstruits. Une sauvegarde est conservée et vous pouvez annuler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il testo diventa “(deleted by the user)” e i riepiloghi sopra vengono ricostruiti. Viene conservato un backup e puoi annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストは「(deleted by the user)」に置き換わり、その上の要約は再構築されます。バックアップが残り、取り消すこともできます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អត្ថបទរបស់វាក្លាយជា “(deleted by the user)” ហើយសេចក្តីសង្ខេបខាងលើត្រូវបានសាងសង់ឡើងវិញ។ ច្បាប់បម្រុងទុកត្រូវបានរក្សា ហើយអ្នកអាចមិនធ្វើវិញបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "텍스트가 “(deleted by the user)”로 바뀌고 그 위의 요약이 다시 만들어집니다. 백업이 남으며 실행을 취소할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teksten blir «(deleted by the user)», og sammendragene over bygges på nytt. En sikkerhetskopi beholdes, og du kan angre dette."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jego tekst zmieni się na „(deleted by the user)”, a podsumowania nad nim zostaną odbudowane. Kopia zapasowa zostaje zachowana i możesz to cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O texto passa a ser “(deleted by the user)” e os resumos acima são reconstruídos. Um backup é mantido e você pode desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Текст станет «(deleted by the user)», а сводки над ним будут перестроены. Резервная копия сохраняется, и это можно отменить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ข้อความจะกลายเป็น “(deleted by the user)” และสรุปที่อยู่ด้านบนจะถูกสร้างใหม่ มีการเก็บสำรองไว้และคุณสามารถเลิกทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metni “(deleted by the user)” olur ve üstündeki özetler yeniden oluşturulur. Bir yedek tutulur ve bunu geri alabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Текст стане «(deleted by the user)», а зведення над ним буде перебудовано. Резервна копія зберігається, і це можна скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Văn bản sẽ thành “(deleted by the user)” và các bản tóm tắt phía trên được dựng lại. Bản sao lưu được giữ lại và bạn có thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "其文本将变为“(deleted by the user)”，其上的摘要会重建。会保留备份，你也可以撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "其文字會變成「(deleted by the user)」，其上的摘要會重建。會保留備份，你也可以還原。"
          }
        }
      }
    },
    "chiefMemory.delete.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هل تريد حذف هذا من ذاكرة Chief؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Izbrisati ovo iz Chiefove memorije?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vil du slette dette fra Chiefs hukommelse?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dies aus dem Gedächtnis des Chiefs löschen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this from the Chief’s memory?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Eliminar esto de la memoria del Chief?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Supprimer ceci de la mémoire du Chief ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eliminare questo dalla memoria del Chief?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これを Chief のメモリから削除しますか？"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "លុបវាចេញពីអង្គចងចាំរបស់ Chief?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief의 메모리에서 이 항목을 삭제할까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vil du slette dette fra Chiefs minne?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usunąć to z pamięci Chiefa?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apagar isto da memória do Chief?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Удалить это из памяти Chief?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลบสิ่งนี้ออกจากหน่วยความจำของ Chief หรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu, Chief’in belleğinden silinsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Видалити це з пам’яті Chief?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xóa mục này khỏi bộ nhớ của Chief?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "要从 Chief 的记忆中删除此内容吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "要從 Chief 的記憶中刪除此內容嗎？"
          }
        }
      }
    },
