        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Riassumerlo costerebbe circa $%@, quindi non è stato avviato. Scegli meno fonti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "要約に約 $%@ かかるため開始しませんでした。ソースを減らしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការសង្ខេបនេះនឹងចំណាយប្រហែល $%@ ដូច្នេះមិនបានចាប់ផ្តើមទេ។ ជ្រើសរើសប្រភពតិចជាង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "요약에 약 $%@가 들어 시작하지 않았습니다. 소스를 줄여 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oppsummering ville kostet omtrent $%@, så den ble ikke startet. Velg færre kilder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Podsumowanie kosztowałoby około $%@, więc nie zostało uruchomione. Wybierz mniej źródeł."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Resumir isso custaria cerca de $%@, então não foi iniciado. Escolha menos fontes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Суммаризация обошлась бы примерно в $%@, поэтому она не запущена. Выберите меньше источников."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การสรุปนี้จะมีค่าใช้จ่ายประมาณ $%@ จึงไม่ได้เริ่ม โปรดเลือกแหล่งที่มาน้อยลง"
