          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Falta la herramienta de Chief en esta compilación, así que no se pueden importar recuerdos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’outil Chief est absent de cette version, les souvenirs ne peuvent donc pas être importés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo strumento Chief manca in questa build, quindi non si possono importare ricordi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このビルドには Chief ツールがないため、メモリを読み込めません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ឧបករណ៍ Chief បាត់ពីកំណែនេះ ដូច្នេះមិនអាចនាំចូលការចងចាំបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 빌드에는 Chief 도구가 없어 기억을 가져올 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief-verktøyet mangler i denne versjonen, så minner kan ikke importeres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "W tej wersji brakuje narzędzia Chief, więc nie można importować wspomnień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A ferramenta do Chief não está nesta versão, então não é possível importar memórias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В этой сборке нет инструмента Chief, поэтому память импортировать нельзя."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
