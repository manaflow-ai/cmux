    "import.noTool": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Chief tool is missing from this build, so memories cannot be imported."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
