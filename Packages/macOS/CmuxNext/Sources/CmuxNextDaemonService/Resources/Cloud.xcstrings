    "cloud.failed.tunnelKeyRequired": {
      "comment": "Rotate Cloud Tunnel Key without a key. --public-key is the flag; keep it as is. WireGuard is a product name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass this Mac's new WireGuard public key for the tunnel with --public-key <key>."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トンネル用のこの Mac の新しい WireGuard 公開鍵を --public-key <key> で指定してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرّر مفتاح WireGuard العام الجديد لهذا الـ Mac الخاص بالنفق باستخدام --public-key <key>."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Proslijedite novi WireGuard javni ključ ovog Maca za tunel pomoću --public-key <key>."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv denne Macs nye offentlige WireGuard-nøgle til tunnelen med --public-key <key>."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übergib den neuen öffentlichen WireGuard-Schlüssel dieses Macs für den Tunnel mit --public-key <key>."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica la nueva clave pública de WireGuard de este Mac para el túnel con --public-key <key>."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez la nouvelle clé publique WireGuard de ce Mac pour le tunnel avec --public-key <key>."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa la nuova chiave pubblica WireGuard di questo Mac per il tunnel con --public-key <key>."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ជូនសោសាធារណៈ WireGuard ថ្មីរបស់ Mac នេះសម្រាប់ផ្លូវរូងដោយប្រើ --public-key <key>។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터널에 사용할 이 Mac의 새 WireGuard 공개 키를 --public-key <key>로 지정하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppgi denne Macens nye offentlige WireGuard-nøkkel for tunnelen med --public-key <key>."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj nowy publiczny klucz WireGuard tego Maca dla tunelu za pomocą --public-key <key>."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe a nova chave pública WireGuard deste Mac para o túnel com --public-key <key>."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите новый открытый ключ WireGuard этого Mac для туннеля через --public-key <key>."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบุคีย์สาธารณะ WireGuard ใหม่ของ Mac เครื่องนี้สำหรับทันเนลด้วย --public-key <key>"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'in tünel için yeni WireGuard ortak anahtarını --public-key <key> ile iletin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Передайте новий відкритий ключ WireGuard цього Mac для тунелю через --public-key <key>."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Truyền khóa công khai WireGuard mới của máy Mac này cho đường hầm bằng --public-key <key>."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请用 --public-key <key> 传入这台 Mac 用于隧道的新 WireGuard 公钥。"
