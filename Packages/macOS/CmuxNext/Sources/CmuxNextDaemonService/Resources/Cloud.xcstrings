    "cloud.cli.machineWorkspaceRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass the workspace id after --workspace: the workspace_id `cmux cloud new-terminal-on-machine --target machine:%1$@` answered. Leave --workspace out to make a new workspace."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "--workspace の後にワークスペース ID を指定してください（`cmux cloud new-terminal-on-machine --target machine:%1$@` が返した workspace_id）。新しいワークスペースを作るには --workspace を省略してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرّر معرّف مساحة العمل بعد ‎--workspace‎: قيمة workspace_id التي أعادها ‎`cmux cloud new-terminal-on-machine --target machine:%1$@`‎. احذف ‎--workspace‎ لإنشاء مساحة عمل جديدة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Navedite ID radnog prostora nakon --workspace: workspace_id koji je vratio `cmux cloud new-terminal-on-machine --target machine:%1$@`. Izostavite --workspace da napravite novi radni prostor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv arbejdsområdets id efter --workspace: det workspace_id, `cmux cloud new-terminal-on-machine --target machine:%1$@` svarede. Udelad --workspace for at oprette et nyt arbejdsområde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die Arbeitsbereich-ID nach --workspace an: die workspace_id, die `cmux cloud new-terminal-on-machine --target machine:%1$@` geantwortet hat. Lass --workspace weg, um einen neuen Arbeitsbereich zu erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica el id del espacio de trabajo después de --workspace: el workspace_id que respondió `cmux cloud new-terminal-on-machine --target machine:%1$@`. Omite --workspace para crear un espacio de trabajo nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez l’id de l’espace de travail après --workspace : le workspace_id renvoyé par `cmux cloud new-terminal-on-machine --target machine:%1$@`. Omettez --workspace pour créer un nouvel espace de travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa l’id dello spazio di lavoro dopo --workspace: il workspace_id restituito da `cmux cloud new-terminal-on-machine --target machine:%1$@`. Ometti --workspace per creare un nuovo spazio di lavoro."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ជូន id កន្លែងធ្វើការបន្ទាប់ពី --workspace៖ workspace_id ដែល `cmux cloud new-terminal-on-machine --target machine:%1$@` បានឆ្លើយ។ លុប --workspace ចេញ ដើម្បីបង្កើតកន្លែងធ្វើការថ្មី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "--workspace 뒤에 워크스페이스 ID를 전달하세요: `cmux cloud new-terminal-on-machine --target machine:%1$@`이 응답한 workspace_id입니다. 새 워크스페이스를 만들려면 --workspace를 빼세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppgi arbeidsområdets id etter --workspace: workspace_id som `cmux cloud new-terminal-on-machine --target machine:%1$@` svarte. Utelat --workspace for å lage et nytt arbeidsområde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj id obszaru roboczego po --workspace: workspace_id zwrócone przez `cmux cloud new-terminal-on-machine --target machine:%1$@`. Pomiń --workspace, aby utworzyć nowy obszar roboczy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe o id do espaço de trabalho depois de --workspace: o workspace_id que `cmux cloud new-terminal-on-machine --target machine:%1$@` retornou. Omita --workspace para criar um novo espaço de trabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите id рабочего пространства после --workspace: workspace_id, который вернула `cmux cloud new-terminal-on-machine --target machine:%1$@`. Чтобы создать новое рабочее пространство, не указывайте --workspace."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่ง id ของเวิร์กสเปซหลัง --workspace คือ workspace_id ที่ `cmux cloud new-terminal-on-machine --target machine:%1$@` ตอบกลับ ละ --workspace ไว้เพื่อสร้างเวิร์กสเปซใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "--workspace ardından çalışma alanı kimliğini verin: `cmux cloud new-terminal-on-machine --target machine:%1$@` komutunun döndürdüğü workspace_id. Yeni bir çalışma alanı oluşturmak için --workspace'i kullanmayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкажіть id робочого простору після --workspace: workspace_id, який повернула `cmux cloud new-terminal-on-machine --target machine:%1$@`. Щоб створити новий робочий простір, не вказуйте --workspace."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Truyền id không gian làm việc sau --workspace: workspace_id mà `cmux cloud new-terminal-on-machine --target machine:%1$@` đã trả về. Bỏ --workspace để tạo không gian làm việc mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 --workspace 后传入工作区 id：即 `cmux cloud new-terminal-on-machine --target machine:%1$@` 返回的 workspace_id。省略 --workspace 则新建工作区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 --workspace 後傳入工作區 id：即 `cmux cloud new-terminal-on-machine --target machine:%1$@` 傳回的 workspace_id。省略 --workspace 則新增工作區。"
          }
        }
      }
    },
    "cloud.cli.secretNamesOnCloudMachine": {
      "comment": "cmux cloud deliver-secrets --names on a Cloud machine. Keep .cmux/machine.toml and --names as is.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "A Cloud machine gets the secret names its .cmux/machine.toml declares. Leave out --names."}},
        "ja": {"stringUnit": {"state": "translated", "value": "Cloud マシンには .cmux/machine.toml で宣言されたシークレット名が渡されます。--names は省いてください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Eine Cloud-Maschine bekommt die Geheimnisnamen, die ihre .cmux/machine.toml angibt. Lass --names weg."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Une machine Cloud reçoit les noms de secrets que déclare son .cmux/machine.toml. Omettez --names."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Una máquina Cloud recibe los nombres de secretos que declara su .cmux/machine.toml. Omite --names."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تتلقى آلة Cloud أسماء الأسرار التي يعلنها ملف .cmux/machine.toml الخاص بها. احذف --names."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "Cloud 머신은 .cmux/machine.toml에 선언된 비밀 이름을 받습니다. --names를 빼세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "Cloud 机器获得其 .cmux/machine.toml 声明的机密名称。请去掉 --names。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "Cloud 機器取得其 .cmux/machine.toml 宣告的機密名稱。請去掉 --names。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Cloud mašina dobija imena tajni koja navodi njen .cmux/machine.toml. Izostavi --names."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "En Cloud-maskine får de hemmelighedsnavne, dens .cmux/machine.toml angiver. Udelad --names."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Una macchina Cloud riceve i nomi dei segreti dichiarati dal suo .cmux/machine.toml. Ometti --names."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ម៉ាស៊ីន Cloud ទទួលបានឈ្មោះអាថ៌កំបាំងដែល .cmux/machine.toml របស់វាប្រកាស។ សូមលុប --names ចេញ។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "En Cloud-maskin får hemmelighetsnavnene dens .cmux/machine.toml angir. Utelat --names."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Maszyna Cloud dostaje nazwy sekretów zadeklarowane w jej .cmux/machine.toml. Pomiń --names."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Uma máquina Cloud recebe os nomes de segredos que o .cmux/machine.toml dela declara. Omita --names."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Машина Cloud получает имена секретов, объявленные в её .cmux/machine.toml. Уберите --names."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เครื่อง Cloud จะได้รับชื่อความลับที่ .cmux/machine.toml ของเครื่องประกาศไว้ ให้ละ --names ออก"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Bir Cloud makinesi, .cmux/machine.toml dosyasının bildirdiği sır adlarını alır. --names'i çıkarın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Машина Cloud отримує імена секретів, оголошені в її .cmux/machine.toml. Приберіть --names."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Máy Cloud nhận các tên bí mật mà .cmux/machine.toml của nó khai báo. Hãy bỏ --names."}}
      }
    },
    "cloud.cli.createDeclined": {
      "extractionState": "manual",
      "localizations": {
