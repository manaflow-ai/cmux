    "cloud.create.stillPending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The machine still waits for approval. Try again in a minute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンはまだ承認待ちです。1 分後にもう一度お試しください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يزال الجهاز في انتظار الموافقة. حاول مرة أخرى بعد دقيقة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mašina još čeka odobrenje. Pokušajte ponovo za minutu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maskinen venter stadig på godkendelse. Prøv igen om et minut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Maschine wartet noch auf die Genehmigung. Versuche es in einer Minute erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La máquina sigue esperando la aprobación. Vuelve a intentarlo en un minuto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La machine attend encore l’approbation. Réessayez dans une minute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La macchina attende ancora l’approvazione. Riprova tra un minuto."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ម៉ាស៊ីននៅតែរង់ចាំការអនុម័ត។ សូមព្យាយាមម្តងទៀតក្នុងមួយនាទី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "머신이 아직 승인을 기다리고 있습니다. 1분 후에 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maskinen venter fortsatt på godkjenning. Prøv igjen om et minutt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maszyna nadal czeka na zatwierdzenie. Spróbuj ponownie za minutę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A máquina ainda aguarda aprovação. Tente de novo em um minuto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Машина всё ещё ждёт подтверждения. Повторите попытку через минуту."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เครื่องยังรอการอนุมัติ ลองอีกครั้งในอีกหนึ่งนาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Makine hâlâ onay bekliyor. Bir dakika sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Машина ще чекає на схвалення. Спробуйте ще раз за хвилину."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Máy vẫn đang chờ phê duyệt. Hãy thử lại sau một phút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "该机器仍在等待批准。请一分钟后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此機器仍在等待核准。請一分鐘後再試。"
          }
        }
      }
    },
