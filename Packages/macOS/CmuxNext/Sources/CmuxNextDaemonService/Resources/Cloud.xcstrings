    "cloud.result.snapshotBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapshot %@ is ready. Restore it with Restore Cloud Machine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スナップショット %@ の準備ができました。「Cloud マシンを復元」で復元できます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
