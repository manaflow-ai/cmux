    "cloud.unavailable.noClient": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bundled cmux-tui client is missing, so Cloud machines cannot connect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同梱の cmux-tui クライアントがないため、Cloud マシンに接続できません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عميل cmux-tui المضمّن مفقود، لذا لا يمكن لأجهزة Cloud الاتصال."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nedostaje ugrađeni cmux-tui klijent, pa se Cloud mašine ne mogu povezati."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den medfølgende cmux-tui-klient mangler, så Cloud-maskiner kan ikke oprette forbindelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der mitgelieferte cmux-tui-Client fehlt, daher können sich Cloud-Maschinen nicht verbinden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Falta el cliente cmux-tui incluido, por lo que las máquinas de Cloud no pueden conectarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le client cmux-tui intégré est manquant : les machines Cloud ne peuvent pas se connecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il client cmux-tui incluso manca, quindi le macchine Cloud non possono connettersi."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កម្មវិធីភ្ញៀវ cmux-tui ដែលភ្ជាប់មកជាមួយបាត់ ដូច្នេះម៉ាស៊ីន Cloud មិនអាចភ្ជាប់បានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "번들된 cmux-tui 클라이언트가 없어 Cloud 기기에 연결할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den medfølgende cmux-tui-klienten mangler, så Cloud-maskiner kan ikke koble til."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brakuje dołączonego klienta cmux-tui, więc maszyny Cloud nie mogą się połączyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cliente cmux-tui incluído está ausente, então as máquinas Cloud não podem se conectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Встроенный клиент cmux-tui отсутствует, поэтому машины Cloud не могут подключиться."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่พบไคลเอนต์ cmux-tui ที่มาพร้อมแอป เครื่อง Cloud จึงเชื่อมต่อไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Paketle gelen cmux-tui istemcisi eksik, bu nedenle Cloud makineleri bağlanamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Бракує вбудованого клієнта cmux-tui, тому машини Cloud не можуть підключитися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thiếu ứng dụng khách cmux-tui đi kèm nên máy Cloud không thể kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "缺少内置的 cmux-tui 客户端，因此无法连接 Cloud 机器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "缺少內建的 cmux-tui 用戶端，因此無法連線至 Cloud 機器。"
          }
        }
      }
