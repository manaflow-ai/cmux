        "ja": {"stringUnit": {"state": "translated", "value": "シークレットは配信されませんでした: %@"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Die Geheimnisse wurden nicht übermittelt: %@"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Les secrets n’ont pas été transmis : %@"}},
