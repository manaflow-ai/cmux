    "cloud.cli.secretsDeliveryRunning": {
      "comment": "cmux cloud deliver-secrets while another delivery to the same machine is running.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Secrets are already being delivered to this machine. Try again when that delivery finishes."}},
        "ja": {"stringUnit": {"state": "translated", "value": "このマシンにはすでにシークレットを配信中です。その配信が終わってから再試行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "An diese Maschine werden bereits Geheimnisse übermittelt. Versuche es erneut, wenn diese Übermittlung fertig ist."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Des secrets sont déjà en cours de transmission à cette machine. Réessayez une fois cette transmission terminée."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Ya se están entregando secretos a esta máquina. Vuelve a intentarlo cuando termine esa entrega."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "يجري بالفعل تسليم أسرار إلى هذا الجهاز. أعد المحاولة عند انتهاء ذلك التسليم."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "이 머신에 이미 비밀을 전달하는 중입니다. 그 전달이 끝나면 다시 시도하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "正在向这台机器送达机密。请在该次送达完成后重试。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "正在向這台機器送達機密。請在該次送達完成後重試。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Tajne se već isporučuju ovoj mašini. Pokušajte ponovo kada ta isporuka završi."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Der leveres allerede hemmeligheder til denne maskine. Prøv igen, når den levering er færdig."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Sono già in consegna dei segreti a questa macchina. Riprova al termine di quella consegna."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "កំពុងបញ្ជូនអាថ៌កំបាំងទៅម៉ាស៊ីននេះរួចហើយ។ សូមព្យាយាមម្ដងទៀតនៅពេលការបញ្ជូននោះបញ្ចប់។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Hemmeligheter leveres allerede til denne maskinen. Prøv igjen når den leveringen er ferdig."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Sekrety są już dostarczane do tej maszyny. Spróbuj ponownie, gdy to dostarczanie się zakończy."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Já há segredos sendo entregues a esta máquina. Tente de novo quando essa entrega terminar."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "На эту машину уже доставляются секреты. Повторите попытку, когда эта доставка завершится."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "กำลังส่งความลับไปยังเครื่องนี้อยู่แล้ว ลองอีกครั้งเมื่อการส่งนั้นเสร็จ"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Bu makineye zaten sır teslim ediliyor. O teslim bittiğinde yeniden deneyin."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "На цю машину вже доставляються секрети. Спробуйте ще раз, коли ця доставка завершиться."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Bí mật đang được gửi tới máy này. Hãy thử lại khi lần gửi đó hoàn tất."}}
      }
    },
    "cloud.cli.execUnavailable": {
      "comment": "A CLI or agent asked a Cloud machine to run a command, but its provider runs none through the API. %1$@ is the machine id. The backticked commands stay as they are.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Cloud machine can't run a command for the CLI and return its output. Open a terminal on it with `cmux cloud new-terminal-on-machine --target machine:%1$@`, or connect with `cmux cloud ssh --target machine:%1$@`."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لجهاز Cloud هذا تشغيل أمر لواجهة سطر الأوامر وإرجاع مخرجاته. افتح طرفية عليه باستخدام `cmux cloud new-terminal-on-machine --target machine:%1$@`، أو اتصل باستخدام `cmux cloud ssh --target machine:%1$@`."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova Cloud mašina ne može pokrenuti komandu za CLI i vratiti njen izlaz. Otvorite terminal na njoj pomoću `cmux cloud new-terminal-on-machine --target machine:%1$@` ili se povežite pomoću `cmux cloud ssh --target machine:%1$@`."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Cloud-maskine kan ikke køre en kommando for CLI'en og returnere outputtet. Åbn en terminal på den med `cmux cloud new-terminal-on-machine --target machine:%1$@`, eller opret forbindelse med `cmux cloud ssh --target machine:%1$@`."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Cloud-Maschine kann keinen Befehl für die CLI ausführen und seine Ausgabe zurückgeben. Öffne ein Terminal darauf mit `cmux cloud new-terminal-on-machine --target machine:%1$@` oder verbinde dich mit `cmux cloud ssh --target machine:%1$@`."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta máquina Cloud no puede ejecutar un comando para la CLI y devolver su salida. Abre una terminal en ella con `cmux cloud new-terminal-on-machine --target machine:%1$@` o conéctate con `cmux cloud ssh --target machine:%1$@`."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette machine Cloud ne peut pas exécuter une commande pour la CLI et renvoyer sa sortie. Ouvrez-y un terminal avec `cmux cloud new-terminal-on-machine --target machine:%1$@`, ou connectez-vous avec `cmux cloud ssh --target machine:%1$@`."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa macchina Cloud non può eseguire un comando per la CLI e restituirne l'output. Apri un terminale su di essa con `cmux cloud new-terminal-on-machine --target machine:%1$@` oppure connettiti con `cmux cloud ssh --target machine:%1$@`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Cloud マシンでは、CLI のためにコマンドを実行して出力を返すことができません。`cmux cloud new-terminal-on-machine --target machine:%1$@` でターミナルを開くか、`cmux cloud ssh --target machine:%1$@` で接続してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម៉ាស៊ីន Cloud នេះមិនអាចដំណើរការពាក្យបញ្ជាសម្រាប់ CLI ហើយបញ្ជូនលទ្ធផលត្រឡប់វិញបានទេ។ បើកស្ថានីយលើវាដោយប្រើ `cmux cloud new-terminal-on-machine --target machine:%1$@` ឬភ្ជាប់ដោយប្រើ `cmux cloud ssh --target machine:%1$@`។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Cloud 머신은 CLI를 위해 명령을 실행하고 출력을 돌려줄 수 없습니다. `cmux cloud new-terminal-on-machine --target machine:%1$@`로 터미널을 열거나 `cmux cloud ssh --target machine:%1$@`로 연결하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Cloud-maskinen kan ikke kjøre en kommando for CLI-en og returnere utdataene. Åpne en terminal på den med `cmux cloud new-terminal-on-machine --target machine:%1$@`, eller koble til med `cmux cloud ssh --target machine:%1$@`."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta maszyna Cloud nie może uruchomić polecenia dla CLI i zwrócić jego wyniku. Otwórz na niej terminal poleceniem `cmux cloud new-terminal-on-machine --target machine:%1$@` albo połącz się przez `cmux cloud ssh --target machine:%1$@`."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta máquina Cloud não consegue executar um comando para a CLI e devolver a saída. Abra um terminal nela com `cmux cloud new-terminal-on-machine --target machine:%1$@` ou conecte-se com `cmux cloud ssh --target machine:%1$@`."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта машина Cloud не может выполнить команду для CLI и вернуть её вывод. Откройте на ней терминал командой `cmux cloud new-terminal-on-machine --target machine:%1$@` или подключитесь через `cmux cloud ssh --target machine:%1$@`."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่อง Cloud นี้รันคำสั่งให้ CLI แล้วส่งผลลัพธ์กลับไม่ได้ เปิดเทอร์มินัลบนเครื่องด้วย `cmux cloud new-terminal-on-machine --target machine:%1$@` หรือเชื่อมต่อด้วย `cmux cloud ssh --target machine:%1$@`"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Cloud makinesi CLI için bir komut çalıştırıp çıktısını döndüremez. `cmux cloud new-terminal-on-machine --target machine:%1$@` ile üzerinde bir terminal açın veya `cmux cloud ssh --target machine:%1$@` ile bağlanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця машина Cloud не може виконати команду для CLI й повернути її вивід. Відкрийте на ній термінал командою `cmux cloud new-terminal-on-machine --target machine:%1$@` або підключіться через `cmux cloud ssh --target machine:%1$@`."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Cloud này không thể chạy lệnh cho CLI và trả về kết quả. Mở một terminal trên máy bằng `cmux cloud new-terminal-on-machine --target machine:%1$@`, hoặc kết nối bằng `cmux cloud ssh --target machine:%1$@`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Cloud 机器无法为 CLI 运行命令并返回输出。用 `cmux cloud new-terminal-on-machine --target machine:%1$@` 在它上面打开终端，或用 `cmux cloud ssh --target machine:%1$@` 连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Cloud 機器無法為 CLI 執行命令並傳回輸出。用 `cmux cloud new-terminal-on-machine --target machine:%1$@` 在它上面開啟終端機，或用 `cmux cloud ssh --target machine:%1$@` 連線。"
          }
        }
      }
    },
    "cloud.cli.machineNameInvalid": {
      "comment": "cmux cloud new-machine: the --name value is not a plain name. Keep lane-vm-1 as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The machine's name must be 1 to 64 letters, digits, dots, dashes or underscores, such as lane-vm-1."}},
        "ja": {"stringUnit": {"state": "translated", "value": "マシン名は英数字、ドット、ハイフン、アンダースコアの 1〜64 文字にしてください（例: lane-vm-1）。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Der Name der Maschine muss aus 1 bis 64 Buchstaben, Ziffern, Punkten, Bindestrichen oder Unterstrichen bestehen, etwa lane-vm-1."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Le nom de la machine doit comporter de 1 à 64 lettres, chiffres, points, tirets ou traits de soulignement, par exemple lane-vm-1."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "El nombre de la máquina debe tener de 1 a 64 letras, dígitos, puntos, guiones o guiones bajos, por ejemplo lane-vm-1."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "يجب أن يتكوّن اسم الجهاز من 1 إلى 64 حرفًا أو رقمًا أو نقطة أو شرطة أو شرطة سفلية، مثل lane-vm-1."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "머신 이름은 영문자, 숫자, 점, 하이픈, 밑줄로 된 1~64자여야 합니다(예: lane-vm-1)."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "机器名称必须是 1 到 64 个字母、数字、点、连字符或下划线，例如 lane-vm-1。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "機器名稱必須是 1 到 64 個字母、數字、點、連字號或底線，例如 lane-vm-1。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Ime mašine mora imati od 1 do 64 slova, cifara, tačaka, crtica ili donjih crta, na primjer lane-vm-1."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Maskinens navn skal være 1 til 64 bogstaver, cifre, punktummer, bindestreger eller understreger, f.eks. lane-vm-1."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Il nome della macchina deve avere da 1 a 64 lettere, cifre, punti, trattini o trattini bassi, ad esempio lane-vm-1."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ឈ្មោះម៉ាស៊ីនត្រូវមានពី 1 ដល់ 64 តួ ដែលជាអក្សរ លេខ ចំណុច សញ្ញាដក ឬសញ្ញាគូសក្រោម ឧទាហរណ៍ lane-vm-1។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Maskinens navn må være 1 til 64 bokstaver, sifre, punktum, bindestreker eller understreker, for eksempel lane-vm-1."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Nazwa maszyny musi mieć od 1 do 64 liter, cyfr, kropek, myślników lub podkreśleń, np. lane-vm-1."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "O nome da máquina precisa ter de 1 a 64 letras, dígitos, pontos, hífens ou sublinhados, como lane-vm-1."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Имя машины должно содержать от 1 до 64 букв, цифр, точек, дефисов или подчёркиваний, например lane-vm-1."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ชื่อเครื่องต้องมี 1 ถึง 64 อักขระที่เป็นตัวอักษร ตัวเลข จุด ขีดกลาง หรือขีดล่าง เช่น lane-vm-1"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Makinenin adı 1 ile 64 arasında harf, rakam, nokta, tire veya alt çizgiden oluşmalı, örneğin lane-vm-1."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Ім'я машини має містити від 1 до 64 літер, цифр, крапок, дефісів або підкреслень, наприклад lane-vm-1."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Tên máy phải gồm 1 đến 64 chữ cái, chữ số, dấu chấm, dấu gạch ngang hoặc dấu gạch dưới, ví dụ lane-vm-1."}}
      }
    },
    "cloud.cli.secretsNoneStored": {
      "comment": "cmux cloud deliver-secrets --names where none of the names has a value on this Mac. %@ is the names, comma-separated. Keep cmux cloud secret set NAME as is.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "None of %@ has a value on this Mac, so nothing was delivered. Store each with cmux cloud secret set NAME."}},
        "ja": {"stringUnit": {"state": "translated", "value": "%@ のいずれもこの Mac に値がないため、何も配信されませんでした。それぞれ cmux cloud secret set NAME で保存してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Keiner von %@ hat einen Wert auf diesem Mac, daher wurde nichts übermittelt. Speichere jeden mit cmux cloud secret set NAME."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Aucun de %@ n’a de valeur sur ce Mac : rien n’a été transmis. Enregistrez chacun avec cmux cloud secret set NAME."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Ninguno de %@ tiene un valor en este Mac, así que no se entregó nada. Guarda cada uno con cmux cloud secret set NAME."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "لا يوجد لأي من %@ قيمة على هذا الـ Mac، لذا لم يُسلَّم شيء. خزّن كلًا منها باستخدام cmux cloud secret set NAME."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "%@ 중 어느 것도 이 Mac에 값이 없어 아무것도 전달하지 않았습니다. 각각 cmux cloud secret set NAME으로 저장하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "%@ 在这台 Mac 上都没有值，因此未传送任何内容。请用 cmux cloud secret set NAME 逐个保存。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "%@ 在這台 Mac 上都沒有值，因此未傳送任何內容。請用 cmux cloud secret set NAME 逐一儲存。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Nijedno od %@ nema vrijednost na ovom Macu, pa ništa nije isporučeno. Sačuvaj svako pomoću cmux cloud secret set NAME."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Ingen af %@ har en værdi på denne Mac, så intet blev leveret. Gem hver med cmux cloud secret set NAME."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Nessuno di %@ ha un valore su questo Mac, quindi non è stato consegnato nulla. Salva ciascuno con cmux cloud secret set NAME."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "គ្មានណាមួយក្នុង %@ មានតម្លៃនៅលើ Mac នេះទេ ដូច្នេះគ្មានអ្វីត្រូវបានបញ្ជូនទេ។ សូមរក្សាទុកនីមួយៗដោយប្រើ cmux cloud secret set NAME។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Ingen av %@ har en verdi på denne Macen, så ingenting ble levert. Lagre hver med cmux cloud secret set NAME."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Żaden z %@ nie ma wartości na tym Macu, więc nic nie dostarczono. Zapisz każdy przez cmux cloud secret set NAME."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Nenhum de %@ tem valor neste Mac, então nada foi entregue. Salve cada um com cmux cloud secret set NAME."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Ни у одного из %@ нет значения на этом Mac, поэтому ничего не доставлено. Сохраните каждый через cmux cloud secret set NAME."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ไม่มีรายการใดใน %@ ที่มีค่าบน Mac เครื่องนี้ จึงไม่ได้ส่งอะไร บันทึกแต่ละรายการด้วย cmux cloud secret set NAME"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "%@ içindekilerin hiçbirinin bu Mac'te değeri yok, bu yüzden hiçbir şey teslim edilmedi. Her birini cmux cloud secret set NAME ile kaydedin."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Жоден із %@ не має значення на цьому Mac, тож нічого не доставлено. Збережіть кожен через cmux cloud secret set NAME."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Không tên nào trong %@ có giá trị trên máy Mac này nên không gửi gì. Hãy lưu từng cái bằng cmux cloud secret set NAME."}}
      }
    },
