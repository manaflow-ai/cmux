    "cloud.failed.alreadySignedIn": {
      "comment": "Sign In while already signed in. `cmux cloud sign-out` is a command; keep it as is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already signed in. To switch accounts, run `cmux cloud sign-out`, then sign in again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでにサインインしています。アカウントを切り替えるには、`cmux cloud sign-out` を実行してから、もう一度サインインしてください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تم تسجيل الدخول بالفعل. لتبديل الحسابات، شغّل `cmux cloud sign-out`، ثم سجّل الدخول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Već ste prijavljeni. Da promijenite račun, pokrenite `cmux cloud sign-out`, pa se ponovo prijavite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du er allerede logget ind. Kør `cmux cloud sign-out` for at skifte konto, og log derefter ind igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bereits angemeldet. Um das Konto zu wechseln, führe `cmux cloud sign-out` aus und melde dich dann erneut an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ya has iniciado sesión. Para cambiar de cuenta, ejecuta `cmux cloud sign-out` y vuelve a iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous êtes déjà connecté. Pour changer de compte, exécutez `cmux cloud sign-out`, puis reconnectez-vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Accesso già effettuato. Per cambiare account, esegui `cmux cloud sign-out`, poi accedi di nuovo."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បានចូលរួចហើយ។ ដើម្បីប្តូរគណនី សូមដំណើរការ `cmux cloud sign-out` រួចចូលម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이미 로그인되어 있습니다. 계정을 전환하려면 `cmux cloud sign-out`을 실행한 뒤 다시 로그인하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Allerede pålogget. For å bytte konto, kjør `cmux cloud sign-out`, og logg deretter på igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Już zalogowano. Aby zmienić konto, uruchom `cmux cloud sign-out`, a potem zaloguj się ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você já iniciou sessão. Para trocar de conta, execute `cmux cloud sign-out` e entre de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вход уже выполнен. Чтобы сменить аккаунт, выполните `cmux cloud sign-out` и войдите снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลงชื่อเข้าใช้อยู่แล้ว หากต้องการสลับบัญชี ให้เรียกใช้ `cmux cloud sign-out` แล้วลงชื่อเข้าใช้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zaten oturum açılmış. Hesap değiştirmek için `cmux cloud sign-out` komutunu çalıştırın, sonra yeniden oturum açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ви вже ввійшли. Щоб змінити обліковий запис, виконайте `cmux cloud sign-out`, а потім увійдіть знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã đăng nhập. Để đổi tài khoản, hãy chạy `cmux cloud sign-out` rồi đăng nhập lại."
