    "cloud.create.approvalMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The approval request does not match the machine you confirmed, so cmux did not approve it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認リクエストが確認したマシンと一致しないため、cmux は承認しませんでした。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "طلب الموافقة لا يطابق الجهاز الذي أكدته، لذلك لم يوافق cmux عليه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zahtjev za odobrenje ne odgovara mašini koju ste potvrdili, pa ga cmux nije odobrio."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Godkendelsesanmodningen passer ikke til den maskine, du bekræftede, så cmux godkendte den ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Genehmigungsanfrage passt nicht zu der bestätigten Maschine, daher hat cmux sie nicht genehmigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La solicitud de aprobación no coincide con la máquina que confirmaste, así que cmux no la aprobó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La demande d’approbation ne correspond pas à la machine que vous avez confirmée, donc cmux ne l’a pas approuvée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La richiesta di approvazione non corrisponde alla macchina che hai confermato, quindi cmux non l’ha approvata."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សំណើអនុម័តមិនត្រូវនឹងម៉ាស៊ីនដែលអ្នកបានបញ្ជាក់ទេ ដូច្នេះ cmux មិនបានអនុម័តវាទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "승인 요청이 확인한 머신과 일치하지 않아 cmux가 승인하지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Godkjenningsforespørselen samsvarer ikke med maskinen du bekreftet, så cmux godkjente den ikke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prośba o zatwierdzenie nie pasuje do potwierdzonej maszyny, więc cmux jej nie zatwierdził."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A solicitação de aprovação não corresponde à máquina que você confirmou, então o cmux não a aprovou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запрос на подтверждение не совпадает с подтверждённой вами машиной, поэтому cmux его не подтвердил."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คำขออนุมัติไม่ตรงกับเครื่องที่คุณยืนยัน cmux จึงไม่ได้อนุมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Onay isteği onayladığınız makineyle eşleşmiyor, bu yüzden cmux onaylamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запит на схвалення не збігається з машиною, яку ви підтвердили, тому cmux його не схвалив."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yêu cầu phê duyệt không khớp với máy bạn đã xác nhận, nên cmux không phê duyệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "批准请求与你确认的机器不一致,因此 cmux 没有批准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "核准請求與你確認的機器不一致,因此 cmux 沒有核准。"
          }
        }
      }
    },
