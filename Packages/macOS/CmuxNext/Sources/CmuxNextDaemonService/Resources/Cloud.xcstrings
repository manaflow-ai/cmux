    "cloud.unavailable.localBackend": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build has no Cloud backend. Rebuild it with ./scripts/reload.sh --tag <tag> --direct-backend."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドには Cloud バックエンドがありません。./scripts/reload.sh --tag <tag> --direct-backend で再ビルドしてください。"
