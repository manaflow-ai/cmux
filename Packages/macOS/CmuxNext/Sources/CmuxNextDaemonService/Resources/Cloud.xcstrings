          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không gian làm việc này đã mở trên máy Mac này, không phải trong Cloud. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此工作区已在这台 Mac 上打开，而不是在 Cloud 中。%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
