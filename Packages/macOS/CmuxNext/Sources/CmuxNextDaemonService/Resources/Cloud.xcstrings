        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Os segredos não foram entregues: %@"}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Секреты не доставлены: %@"}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ไม่ได้ส่งความลับ: %@"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Sırlar teslim edilmedi: %@"}},
