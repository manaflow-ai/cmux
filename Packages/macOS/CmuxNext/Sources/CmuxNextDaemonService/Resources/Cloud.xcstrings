    "cloud.upgrade.required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Cloud machine was created: your plan needs an upgrade. See cmux.com/pricing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudマシンは作成されませんでした。プランのアップグレードが必要です。cmux.com/pricing をご覧ください。"
