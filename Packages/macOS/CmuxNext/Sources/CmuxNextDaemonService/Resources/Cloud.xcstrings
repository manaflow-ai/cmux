    "cloud.prompt.deleteFirewallRuleBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes the selected firewall rule."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يؤدي هذا إلى إزالة قاعدة جدار الحماية المحددة نهائيًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovo trajno uklanja odabrano pravilo vatrozida."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dette fjerner den valgte firewallregel permanent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die ausgewählte Firewallregel wird dauerhaft entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esto elimina de forma permanente la regla del cortafuegos seleccionada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La règle de pare-feu sélectionnée est supprimée définitivement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La regola del firewall selezionata viene rimossa definitivamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したファイアウォールルールを完全に削除します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "វានឹងលុបច្បាប់ជញ្ជាំងភ្លើងដែលបានជ្រើសរើសជាអចិន្ត្រៃយ៍។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "선택한 방화벽 규칙이 영구적으로 삭제됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dette fjerner den valgte brannmurregelen permanent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybrana reguła zapory zostanie trwale usunięta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isso remove permanentemente a regra de firewall selecionada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выбранное правило брандмауэра будет удалено навсегда."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การดำเนินการนี้จะลบกฎไฟร์วอลล์ที่เลือกอย่างถาวร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seçili güvenlik duvarı kuralı kalıcı olarak kaldırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вибране правило брандмауера буде видалено назавжди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thao tác này xóa vĩnh viễn quy tắc tường lửa đã chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
