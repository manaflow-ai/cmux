        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ta kompilacja nie ma backendu Cloud. Skompiluj ją ponownie poleceniem ./scripts/reload.sh --tag <tag> --direct-backend."
          }
        },
        "pt-BR": {
