{
  "sourceLanguage": "en",
  "strings": {
    "cloud.failed.noSuchTeam": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No team named “%@” in this account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントに「%@」というチームはありません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد فريق باسم “%@” في هذا الحساب."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "U ovom računu nema tima “%@”."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er intet team med navnet “%@” på denne konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Konto gibt es kein Team „%@“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún equipo llamado “%@” en esta cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune équipe nommée « %@ » dans ce compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun team chiamato “%@” in questo account."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានក្រុមឈ្មោះ “%@” ក្នុងគណនីនេះទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정에 “%@” 팀이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finnes ikke noe team med navnet “%@” på denne kontoen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tym koncie nie ma zespołu „%@”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há nenhuma equipe chamada “%@” nesta conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой учётной записи нет команды «%@»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีทีมชื่อ “%@” ในบัญชีนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesapta “%@” adlı ekip yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цьому обліковому записі немає команди «%@»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có nhóm nào tên “%@” trong tài khoản này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户中没有名为“%@”的团队。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳號中沒有名為「%@」的團隊。"
          }
        }
      }
    },
