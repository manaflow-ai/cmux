    "cloud.api.keyRequired": {
      "comment": "Revoke Cloud API Key ran without a key id. --key <key-id>, --path <publication> and `cmux cloud api-key-list` are CLI text; keep them as they are.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass the API key id with --key <key-id>; `cmux cloud api-key-list --path <publication>` lists ids."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرّر معرّف مفتاح API باستخدام --key <key-id>؛ يعرض `cmux cloud api-key-list --path <publication>` المعرّفات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Proslijedite id API ključa pomoću --key <key-id>; `cmux cloud api-key-list --path <publication>` prikazuje id-ove."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv API-nøglens id med --key <key-id>; `cmux cloud api-key-list --path <publication>` viser id'erne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die ID des API-Schlüssels mit --key <key-id> an; `cmux cloud api-key-list --path <publication>` listet die IDs auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa el id de la clave de API con --key <key-id>; `cmux cloud api-key-list --path <publication>` muestra los ids."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez l'identifiant de la clé API avec --key <key-id> ; `cmux cloud api-key-list --path <publication>` affiche les identifiants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa l'id della chiave API con --key <key-id>; `cmux cloud api-key-list --path <publication>` elenca gli id."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API キーの ID を --key <key-id> で指定してください。`cmux cloud api-key-list --path <publication>` で ID を確認できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ជូន id សោ API ជាមួយ --key <key-id>; `cmux cloud api-key-list --path <publication>` បង្ហាញ id។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "--key <key-id>로 API 키 ID를 전달하세요. `cmux cloud api-key-list --path <publication>`에서 ID 목록을 볼 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angi API-nøkkelens id med --key <key-id>; `cmux cloud api-key-list --path <publication>` viser id-ene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj id klucza API za pomocą --key <key-id>; `cmux cloud api-key-list --path <publication>` wyświetla id."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe o id da chave de API com --key <key-id>; `cmux cloud api-key-list --path <publication>` lista os ids."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите id ключа API через --key <key-id>; `cmux cloud api-key-list --path <publication>` выводит id."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบุ id ของคีย์ API ด้วย --key <key-id>; `cmux cloud api-key-list --path <publication>` จะแสดง id"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API anahtarı kimliğini --key <key-id> ile verin; `cmux cloud api-key-list --path <publication>` kimlikleri listeler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажіть id ключа API через --key <key-id>; `cmux cloud api-key-list --path <publication>` показує id."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Truyền id khóa API bằng --key <key-id>; `cmux cloud api-key-list --path <publication>` liệt kê các id."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请用 --key <key-id> 传入 API 密钥 id；`cmux cloud api-key-list --path <publication>` 会列出 id。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請用 --key <key-id> 傳入 API 金鑰 id；`cmux cloud api-key-list --path <publication>` 會列出 id。"
          }
        }
      }
    },
    "cloud.api.keyRevoked": {
      "comment": "Revoke Cloud API Key's answer; %@ is the key id.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoked API key %@. Requests with it are refused from now on."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء مفتاح API %@. تُرفض الطلبات التي تستخدمه من الآن فصاعدًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "API ključ %@ je opozvan. Zahtjevi s njim se od sada odbijaju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "API-nøglen %@ er tilbagekaldt. Anmodninger med den afvises fra nu af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel %@ wurde widerrufen. Anfragen damit werden ab jetzt abgelehnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se revocó la clave de API %@. A partir de ahora se rechazan las solicitudes que la usen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé API %@ révoquée. Les requêtes qui l'utilisent sont désormais refusées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiave API %@ revocata. Da ora le richieste che la usano vengono rifiutate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API キー %@ を取り消しました。今後このキーを使うリクエストは拒否されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បានដកហូតសោ API %@។ សំណើដែលប្រើវានឹងត្រូវបដិសេធចាប់ពីពេលនេះតទៅ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키 %@을(를) 취소했습니다. 이제부터 이 키를 사용한 요청은 거부됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "API-nøkkelen %@ er tilbakekalt. Forespørsler med den avvises fra nå av."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Unieważniono klucz API %@. Żądania z nim są od teraz odrzucane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de API %@ foi revogada. A partir de agora, as solicitações com ela são recusadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ API %@ отозван. Запросы с ним теперь отклоняются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิกถอนคีย์ API %@ แล้ว คำขอที่ใช้คีย์นี้จะถูกปฏิเสธนับจากนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ API anahtarı iptal edildi. Bundan sonra bu anahtarla gelen istekler reddedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ API %@ відкликано. Відтепер запити з ним відхиляються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã thu hồi khóa API %@. Từ giờ các yêu cầu dùng khóa này sẽ bị từ chối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已撤销 API 密钥 %@。从现在起使用它的请求都会被拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已撤銷 API 金鑰 %@。從現在起使用它的請求都會被拒絕。"
          }
        }
      }
    },
    "cloud.api.provisioned": {
      "comment": "Provision API's answer. %1$@ is the https URL, %2$@ the API key, %3$@ the cookie (__Host-cmux-api-key=<key>). Keep the curl command, 'Cookie:' and the placeholders as they are.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nAPI key (shown once, keep it secret): %2$@\nClients send the key as a cookie, for example: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العنوان: %1$@\nمفتاح API (يظهر مرة واحدة، احتفظ به سرًا): %2$@\nترسل العملاء المفتاح كملف تعريف ارتباط، مثلًا: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nAPI ključ (prikazuje se jednom, čuvajte ga u tajnosti): %2$@\nKlijenti šalju ključ kao kolačić, na primjer: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nAPI-nøgle (vises én gang, hold den hemmelig): %2$@\nKlienter sender nøglen som en cookie, for eksempel: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nAPI-Schlüssel (wird nur einmal angezeigt, geheim halten): %2$@\nClients senden den Schlüssel als Cookie, zum Beispiel: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nClave de API (se muestra una vez, mantenla en secreto): %2$@\nLos clientes envían la clave como cookie, por ejemplo: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "URL : %1$@\nClé API (affichée une seule fois, gardez-la secrète) : %2$@\nLes clients envoient la clé dans un cookie, par exemple : curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nChiave API (mostrata una sola volta, tienila segreta): %2$@\nI client inviano la chiave come cookie, ad esempio: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nAPI キー（一度だけ表示されます。秘密にしてください）: %2$@\nクライアントはキーを Cookie として送信します。例: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "URL៖ %1$@\nសោ API (បង្ហាញតែម្ដង សូមរក្សាជាការសម្ងាត់)៖ %2$@\nកម្មវិធីភ្ញៀវផ្ញើសោជា cookie ឧទាហរណ៍៖ curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nAPI 키(한 번만 표시되니 비밀로 유지하세요): %2$@\n클라이언트는 키를 쿠키로 보냅니다. 예: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nAPI-nøkkel (vises én gang, hold den hemmelig): %2$@\nKlienter sender nøkkelen som en informasjonskapsel, for eksempel: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nKlucz API (wyświetlany raz, zachowaj go w tajemnicy): %2$@\nKlienci wysyłają klucz jako plik cookie, na przykład: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nChave de API (exibida uma vez, mantenha em segredo): %2$@\nOs clientes enviam a chave como cookie, por exemplo: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nКлюч API (показывается один раз, храните его в секрете): %2$@\nКлиенты передают ключ в cookie, например: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nคีย์ API (แสดงเพียงครั้งเดียว โปรดเก็บเป็นความลับ): %2$@\nไคลเอนต์ส่งคีย์เป็นคุกกี้ เช่น: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nAPI anahtarı (yalnızca bir kez gösterilir, gizli tutun): %2$@\nİstemciler anahtarı çerez olarak gönderir, örneğin: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nКлюч API (показується один раз, тримайте його в таємниці): %2$@\nКлієнти передають ключ у cookie, наприклад: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nKhóa API (chỉ hiển thị một lần, hãy giữ bí mật): %2$@\nỨng dụng khách gửi khóa dưới dạng cookie, ví dụ: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "URL：%1$@\nAPI 密钥（仅显示一次，请妥善保密）：%2$@\n客户端以 Cookie 发送密钥，例如：curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "URL：%1$@\nAPI 金鑰（只顯示一次，請妥善保密）：%2$@\n用戶端以 Cookie 傳送金鑰，例如：curl -H 'Cookie: %3$@' %1$@"
          }
        }
      }
    },
    "cloud.api.publicationRequired": {
      "comment": "An API key action ran without a publication. --path <publication> is the CLI flag and `cmux cloud publication-list` a command; keep both as they are.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass the publication id or hostname with --path <publication>; `cmux cloud publication-list` lists them."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرّر معرّف النشر أو اسم المضيف باستخدام --path <publication>؛ يعرضها `cmux cloud publication-list`."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Proslijedite id objave ili ime hosta pomoću --path <publication>; `cmux cloud publication-list` ih prikazuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv publiceringens id eller værtsnavn med --path <publication>; `cmux cloud publication-list` viser dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die ID oder den Hostnamen der Veröffentlichung mit --path <publication> an; `cmux cloud publication-list` listet sie auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa el id o el nombre de host de la publicación con --path <publication>; `cmux cloud publication-list` los muestra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez l'identifiant ou le nom d'hôte de la publication avec --path <publication> ; `cmux cloud publication-list` les affiche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa l'id o il nome host della pubblicazione con --path <publication>; `cmux cloud publication-list` li elenca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開の ID またはホスト名を --path <publication> で指定してください。`cmux cloud publication-list` で一覧を確認できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ជូន id ឬឈ្មោះម៉ាស៊ីនរបស់ការបោះពុម្ពផ្សាយ ជាមួយ --path <publication>; `cmux cloud publication-list` បង្ហាញពួកវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "--path <publication>으로 게시 ID나 호스트 이름을 전달하세요. `cmux cloud publication-list`에서 목록을 볼 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angi publiseringens id eller vertsnavn med --path <publication>; `cmux cloud publication-list` viser dem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj id lub nazwę hosta publikacji za pomocą --path <publication>; `cmux cloud publication-list` je wyświetla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe o id ou o nome do host da publicação com --path <publication>; `cmux cloud publication-list` lista esses valores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите id или имя хоста публикации через --path <publication>; `cmux cloud publication-list` выводит их список."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบุ id หรือชื่อโฮสต์ของการเผยแพร่ด้วย --path <publication>; `cmux cloud publication-list` จะแสดงรายการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayın kimliğini veya ana bilgisayar adını --path <publication> ile verin; `cmux cloud publication-list` bunları listeler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажіть id або ім'я хоста публікації через --path <publication>; `cmux cloud publication-list` показує їх список."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Truyền id hoặc tên máy chủ của bản xuất bản bằng --path <publication>; `cmux cloud publication-list` liệt kê chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请用 --path <publication> 传入发布的 id 或主机名；`cmux cloud publication-list` 会列出它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請用 --path <publication> 傳入發布的 id 或主機名稱；`cmux cloud publication-list` 會列出它們。"
          }
        }
      }
    },
