          }
        }
      }
    },
    "cloud.newWorkspace.noWindow": {
      "comment": "Why a New Workspace opened on this Mac although “Run New Workspaces in Cloud” is on: no window was open to show the new Cloud machine's progress.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New workspaces start in Cloud from an open window, where the new machine's progress shows."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいワークスペースは、新しいマシンの進行状況が表示される開いたウインドウから Cloud で開始されます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تبدأ مساحات العمل الجديدة في Cloud من نافذة مفتوحة، حيث يظهر تقدّم الجهاز الجديد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Novi radni prostori pokreću se u Cloudu iz otvorenog prozora, gdje se prikazuje napredak nove mašine."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nye arbejdsområder starter i Cloud fra et åbent vindue, hvor den nye maskines fremskridt vises."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neue Arbeitsbereiche starten in Cloud aus einem geöffneten Fenster, in dem der Fortschritt der neuen Maschine angezeigt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los nuevos espacios de trabajo se inician en Cloud desde una ventana abierta, donde se muestra el progreso de la nueva máquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les nouveaux espaces de travail démarrent dans Cloud depuis une fenêtre ouverte, où s’affiche la progression de la nouvelle machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I nuovi spazi di lavoro partono in Cloud da una finestra aperta, dove si vede l’avanzamento della nuova macchina."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កន្លែងធ្វើការថ្មីចាប់ផ្តើមក្នុង Cloud ពីបង្អួចដែលបើក ដែលបង្ហាញវឌ្ឍនភាពរបស់ម៉ាស៊ីនថ្មី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "새 작업 공간은 새 기기의 진행 상황이 표시되는 열린 창에서 Cloud로 시작됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nye arbeidsområder starter i Cloud fra et åpent vindu, der fremdriften til den nye maskinen vises."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nowe obszary robocze uruchamiają się w Cloud z otwartego okna, w którym widać postęp nowej maszyny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Novos espaços de trabalho começam no Cloud a partir de uma janela aberta, onde o progresso da nova máquina aparece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Новые рабочие пространства запускаются в Cloud из открытого окна, где виден ход создания новой машины."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "พื้นที่ทำงานใหม่จะเริ่มใน Cloud จากหน้าต่างที่เปิดอยู่ ซึ่งแสดงความคืบหน้าของเครื่องใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yeni çalışma alanları, yeni makinenin ilerlemesinin gösterildiği açık bir pencereden Cloud'da başlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Нові робочі простори запускаються в Cloud з відкритого вікна, де видно поступ нової машини."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không gian làm việc mới bắt đầu trong Cloud từ một cửa sổ đang mở, nơi hiển thị tiến trình của máy mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "新工作区会从打开的窗口在 Cloud 中启动，并在该窗口显示新机器的进度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "新工作區會從開啟的視窗在 Cloud 中啟動，並在該視窗顯示新機器的進度。"
          }
        }
      }
    },
