        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 작업 공간은 Cloud가 아닌 이 Mac에서 열렸습니다. %@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dette arbeidsområdet ble åpnet på denne Macen, ikke i Cloud. %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten obszar roboczy otworzył się na tym Macu, a nie w Cloud. %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este espaço de trabalho foi aberto neste Mac, não no Cloud. %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Это рабочее пространство открылось на этом Mac, а не в Cloud. %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "พื้นที่ทำงานนี้เปิดบน Mac เครื่องนี้ ไม่ใช่ใน Cloud %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu çalışma alanı Cloud'da değil, bu Mac'te açıldı. %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
