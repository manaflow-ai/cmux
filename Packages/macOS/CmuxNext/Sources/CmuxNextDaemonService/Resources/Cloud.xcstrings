            "value": "A porta deve estar entre 1 e 65535."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Порт должен быть от 1 до 65535."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "พอร์ตต้องอยู่ระหว่าง 1 ถึง 65535"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
