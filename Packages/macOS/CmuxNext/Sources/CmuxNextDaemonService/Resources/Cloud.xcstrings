    "cloud.cli.secretsNoSSHRoute": {
      "comment": "cmux cloud deliver-secrets to an acpmux peer that this Mac reaches without ssh. %@ is the machine's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This Mac reaches %@ without ssh, so its secrets can't be delivered. Add it with Add Machine, then try again."}},
        "ja": {"stringUnit": {"state": "translated", "value": "この Mac は ssh を使わずに %@ に接続しているため、シークレットを配信できません。「マシンを追加」で追加してから、もう一度お試しください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Dieser Mac erreicht %@ ohne ssh, daher können die Geheimnisse nicht übermittelt werden. Füge sie mit „Maschine hinzufügen“ hinzu und versuche es erneut."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Ce Mac atteint %@ sans ssh : ses secrets ne peuvent donc pas être transmis. Ajoutez-la avec Ajouter une machine, puis réessayez."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Este Mac llega a %@ sin ssh, así que no se pueden entregar sus secretos. Añádela con Añadir máquina y vuelve a intentarlo."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "يصل هذا الـ Mac إلى %@ دون ssh، لذا لا يمكن تسليم أسرارها. أضفها باستخدام «إضافة آلة»، ثم حاول مرة أخرى."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "이 Mac은 ssh 없이 %@에 연결되므로 비밀을 전달할 수 없습니다. 머신 추가로 추가한 뒤 다시 시도하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "这台 Mac 不经 ssh 连接 %@，因此无法传送其机密。请用“添加机器”添加它，然后重试。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "這台 Mac 不經 ssh 連線 %@，因此無法傳送其機密。請用「新增機器」新增它，然後重試。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Ovaj Mac dolazi do %@ bez ssh-a, pa se njene tajne ne mogu isporučiti. Dodaj je pomoću Dodaj mašinu, pa pokušaj ponovo."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Denne Mac når %@ uden ssh, så dens hemmeligheder kan ikke leveres. Tilføj den med Tilføj maskine, og prøv igen."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Questo Mac raggiunge %@ senza ssh, quindi i suoi segreti non possono essere consegnati. Aggiungila con Aggiungi macchina, poi riprova."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "Mac នេះភ្ជាប់ទៅ %@ ដោយគ្មាន ssh ដូច្នេះមិនអាចបញ្ជូនអាថ៌កំបាំងរបស់វាបានទេ។ សូមបន្ថែមវាដោយប្រើ បន្ថែមម៉ាស៊ីន រួចព្យាយាមម្ដងទៀត។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Denne Macen når %@ uten ssh, så hemmelighetene kan ikke leveres. Legg den til med Legg til maskin, og prøv igjen."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Ten Mac łączy się z %@ bez ssh, więc nie można dostarczyć jej sekretów. Dodaj ją przez Dodaj maszynę i spróbuj ponownie."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Este Mac alcança %@ sem ssh, então os segredos dela não podem ser entregues. Adicione-a com Adicionar máquina e tente de novo."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Этот Mac подключается к %@ без ssh, поэтому её секреты нельзя доставить. Добавьте её через «Добавить машину» и повторите."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "Mac เครื่องนี้เชื่อมต่อ %@ โดยไม่ใช้ ssh จึงส่งความลับไม่ได้ เพิ่มเครื่องด้วย เพิ่มเครื่อง แล้วลองอีกครั้ง"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Bu Mac %@ makinesine ssh olmadan ulaşıyor, bu yüzden sırları teslim edilemiyor. Makine Ekle ile ekleyip yeniden deneyin."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Цей Mac під’єднується до %@ без ssh, тож її секрети не можна доставити. Додайте її через «Додати машину» і спробуйте знову."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Máy Mac này kết nối %@ không qua ssh nên không gửi được bí mật. Hãy thêm máy bằng Thêm máy rồi thử lại."}}
      }
    },
    "cloud.cli.unknownMachine": {
      "comment": "A CLI or agent run named a machine (--target machine:<id>) this app does not know. %@ is the id it passed. `cmux cloud list-machines` is a command; keep it as is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Cloud machine has the id %@. `cmux cloud list-machines` lists ids."
          }
        },
