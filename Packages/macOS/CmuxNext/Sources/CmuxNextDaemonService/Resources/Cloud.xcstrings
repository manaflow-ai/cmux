          "stringUnit": {
            "state": "translated",
            "value": "Nie utworzono maszyny Cloud: Twój plan wymaga zmiany. Zobacz cmux.com/pricing."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud makinesi oluşturulmadı: planınızın yükseltilmesi gerekiyor. Bkz. cmux.com/pricing."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Машину Cloud не створено: потрібно покращити тариф. Див. cmux.com/pricing."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa tạo máy Cloud nào: gói của bạn cần được nâng cấp. Xem cmux.com/pricing."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้สร้างเครื่อง Cloud: แผนของคุณต้องอัปเกรด ดู cmux.com/pricing"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke oprettet nogen Cloud-maskine: din plan skal opgraderes. Se cmux.com/pricing."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen Cloud-maskin ble opprettet: planen din må oppgraderes. Se cmux.com/pricing."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud mašina nije kreirana: vaš plan treba nadogradnju. Pogledajte cmux.com/pricing."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនបានបង្កើតម៉ាស៊ីន Cloud ទេ៖ គម្រោងរបស់អ្នកត្រូវដំឡើងកំរិត។ មើល cmux.com/pricing។"
          }
        }
      }
    },
    "cloud.newWorkspace.openedHere": {
      "comment": "A toast after New Workspace when “Run New Workspaces in Cloud” is on but the workspace opened on this Mac. %@ is the reason, a full sentence.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This workspace opened on this Mac, not in Cloud. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースは Cloud ではなくこの Mac で開きました。%@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
