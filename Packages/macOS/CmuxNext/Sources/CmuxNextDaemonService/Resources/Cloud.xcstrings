    "cloud.failed.tunnelDaemonUnavailable": {
      "comment": "A Cloud tunnel attach, detach or key rotation that this Mac's acpmux agent daemon did not take (it is not running, or did not accept the app's proof). Cloud is a product name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac's agent daemon did not take the Cloud tunnel change. Open an agent chat to start it, then try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يقبل برنامج الوكيل الخفي على جهاز Mac هذا تغيير نفق Cloud. افتح محادثة وكيل لتشغيله، ثم حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent daemon na ovom Macu nije prihvatio promjenu Cloud tunela. Otvorite chat s agentom da ga pokrenete, pa pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent-daemonen på denne Mac tog ikke imod ændringen af Cloud-tunnelen. Åbn en agentchat for at starte den, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent-Daemon auf diesem Mac hat die Änderung am Cloud-Tunnel nicht angenommen. Öffne einen Agent-Chat, um ihn zu starten, und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El daemon de agentes de este Mac no aceptó el cambio del túnel de Cloud. Abre un chat de agente para iniciarlo y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le daemon d'agents de ce Mac n'a pas accepté la modification du tunnel Cloud. Ouvrez une discussion d'agent pour le démarrer, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il daemon degli agenti su questo Mac non ha accettato la modifica al tunnel Cloud. Apri una chat con un agente per avviarlo, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac のエージェントデーモンが Cloud トンネルの変更を受け付けませんでした。エージェントチャットを開いて起動してから、もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដេមិនភ្នាក់ងារនៅលើ Mac នេះមិនបានទទួលការផ្លាស់ប្ដូរផ្លូវរូងក្រោមដី Cloud ទេ។ បើកការជជែកភ្នាក់ងារដើម្បីចាប់ផ្ដើមវា រួចព្យាយាមម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 에이전트 데몬이 Cloud 터널 변경을 받지 않았습니다. 에이전트 채팅을 열어 시작한 다음 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent-daemonen på denne Macen tok ikke imot endringen av Cloud-tunnelen. Åpne en agentchat for å starte den, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Demon agentów na tym Macu nie przyjął zmiany tunelu Cloud. Otwórz czat z agentem, aby go uruchomić, i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O daemon de agentes deste Mac não aceitou a alteração do túnel do Cloud. Abra um chat de agente para iniciá-lo e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Демон агентов на этом Mac не принял изменение туннеля Cloud. Откройте чат с агентом, чтобы запустить его, и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เดมอนเอเจนต์บน Mac เครื่องนี้ไม่รับการเปลี่ยนแปลงทันเนล Cloud เปิดแชทเอเจนต์เพื่อเริ่มเดมอน แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'teki ajan arka plan hizmeti Cloud tüneli değişikliğini kabul etmedi. Başlatmak için bir ajan sohbeti açın, sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Демон агентів на цьому Mac не прийняв зміну тунелю Cloud. Відкрийте чат з агентом, щоб запустити його, і спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình nền tác nhân trên máy Mac này không nhận thay đổi đường hầm Cloud. Mở một cuộc trò chuyện với tác nhân để khởi động nó, rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上的智能体守护进程未接受 Cloud 隧道的更改。打开一个智能体聊天以启动它，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 上的代理程式常駐程式未接受 Cloud 通道的變更。開啟一個代理程式聊天以啟動它，然後再試一次。"
          }
        }
      }
    },
