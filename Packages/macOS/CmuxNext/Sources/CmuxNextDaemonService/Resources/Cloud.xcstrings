    "cloud.unavailable.noClient": {
      "comment": "This cmux has no bundled cmux-tui client, so Cloud machines cannot connect.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bundled cmux-tui client is missing, so Cloud machines cannot connect. Reinstall cmux from cmux.com/download, or rebuild a local build with cmux-tui bundled."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同梱の cmux-tui クライアントがないため、Cloud マシンに接続できません。cmux.com/download から cmux を再インストールするか、ローカルビルドを cmux-tui 同梱で再ビルドしてください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عميل cmux-tui المضمّن مفقود، لذا لا يمكن لأجهزة Cloud الاتصال. أعد تثبيت cmux من cmux.com/download، أو أعد بناء النسخة المحلية مع تضمين cmux-tui."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nedostaje ugrađeni cmux-tui klijent, pa se Cloud mašine ne mogu povezati. Ponovo instalirajte cmux sa cmux.com/download ili ponovo izgradite lokalnu verziju s ugrađenim cmux-tui."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den medfølgende cmux-tui-klient mangler, så Cloud-maskiner kan ikke oprette forbindelse. Geninstaller cmux fra cmux.com/download, eller byg en lokal version igen med cmux-tui inkluderet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der mitgelieferte cmux-tui-Client fehlt, daher können sich Cloud-Maschinen nicht verbinden. Installiere cmux neu von cmux.com/download oder baue einen lokalen Build mit mitgeliefertem cmux-tui neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Falta el cliente cmux-tui incluido, por lo que las máquinas de Cloud no pueden conectarse. Reinstala cmux desde cmux.com/download, o vuelve a compilar una versión local con cmux-tui incluido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le client cmux-tui intégré est manquant : les machines Cloud ne peuvent pas se connecter. Réinstallez cmux depuis cmux.com/download, ou recompilez une version locale avec cmux-tui intégré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il client cmux-tui incluso manca, quindi le macchine Cloud non possono connettersi. Reinstalla cmux da cmux.com/download, o ricompila una build locale con cmux-tui incluso."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កម្មវិធីភ្ញៀវ cmux-tui ដែលភ្ជាប់មកជាមួយបាត់ ដូច្នេះម៉ាស៊ីន Cloud មិនអាចភ្ជាប់បានទេ។ ដំឡើង cmux ឡើងវិញពី cmux.com/download ឬបង្កើតកំណែក្នុងម៉ាស៊ីនឡើងវិញដោយភ្ជាប់ cmux-tui មកជាមួយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "번들된 cmux-tui 클라이언트가 없어 Cloud 기기에 연결할 수 없습니다. cmux.com/download에서 cmux를 다시 설치하거나, 로컬 빌드를 cmux-tui를 포함해 다시 빌드하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den medfølgende cmux-tui-klienten mangler, så Cloud-maskiner kan ikke koble til. Installer cmux på nytt fra cmux.com/download, eller bygg en lokal versjon på nytt med cmux-tui inkludert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brakuje dołączonego klienta cmux-tui, więc maszyny Cloud nie mogą się połączyć. Zainstaluj ponownie cmux ze strony cmux.com/download albo przebuduj lokalną wersję z dołączonym cmux-tui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cliente cmux-tui incluído está ausente, então as máquinas Cloud não podem se conectar. Reinstale o cmux em cmux.com/download, ou recompile uma build local com o cmux-tui incluído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Встроенный клиент cmux-tui отсутствует, поэтому машины Cloud не могут подключиться. Переустановите cmux с cmux.com/download или пересоберите локальную сборку со встроенным cmux-tui."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่พบไคลเอนต์ cmux-tui ที่มาพร้อมแอป เครื่อง Cloud จึงเชื่อมต่อไม่ได้ ติดตั้ง cmux ใหม่จาก cmux.com/download หรือบิลด์เวอร์ชันในเครื่องใหม่โดยรวม cmux-tui มาด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Paketle gelen cmux-tui istemcisi eksik, bu nedenle Cloud makineleri bağlanamıyor. cmux'ı cmux.com/download adresinden yeniden yükleyin veya yerel derlemeyi cmux-tui ile birlikte yeniden derleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Бракує вбудованого клієнта cmux-tui, тому машини Cloud не можуть підключитися. Перевстановіть cmux із cmux.com/download або перезберіть локальну збірку з вбудованим cmux-tui."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thiếu ứng dụng khách cmux-tui đi kèm nên máy Cloud không thể kết nối. Hãy cài lại cmux từ cmux.com/download, hoặc build lại bản cục bộ có kèm cmux-tui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "缺少内置的 cmux-tui 客户端，因此无法连接 Cloud 机器。请从 cmux.com/download 重新安装 cmux，或重新构建包含 cmux-tui 的本地版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "缺少內建的 cmux-tui 用戶端，因此無法連線至 Cloud 機器。請從 cmux.com/download 重新安裝 cmux，或重新建置包含 cmux-tui 的本機版本。"
          }
        }
      }
    },
