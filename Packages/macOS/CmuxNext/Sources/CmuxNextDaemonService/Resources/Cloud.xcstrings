          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Порт має бути в межах від 1 до 65535."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cổng phải nằm trong khoảng từ 1 đến 65535."
          }
        },
