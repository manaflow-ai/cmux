    "cloud.failed.commandRequired": {
      "comment": "`cloud exec` without a command. --command is the flag; keep it as is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass the command to run on the Cloud machine with --command \"<command>\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud マシンで実行するコマンドを --command \"<command>\" で指定してください。"
          }
        },
        "ar": {
          "stringUnit": {
