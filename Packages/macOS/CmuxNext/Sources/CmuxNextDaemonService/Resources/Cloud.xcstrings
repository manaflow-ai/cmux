    "cloud.cli.secretRepoInvalid": {
      "comment": "cmux cloud deliver-secrets --repo with a value that is not OWNER/NAME. %@ is what was passed. Keep --repo and OWNER/NAME as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "--repo %@ is not OWNER/NAME."}},
        "ja": {"stringUnit": {"state": "translated", "value": "--repo %@ は OWNER/NAME の形式ではありません。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "--repo %@ hat nicht die Form OWNER/NAME."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "--repo %@ n’est pas de la forme OWNER/NAME."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "--repo %@ no tiene la forma OWNER/NAME."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "‎--repo %@ ليس بالصيغة OWNER/NAME."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "--repo %@은(는) OWNER/NAME 형식이 아닙니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "--repo %@ 不是 OWNER/NAME 格式。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "--repo %@ 不是 OWNER/NAME 格式。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "--repo %@ nije u obliku OWNER/NAME."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "--repo %@ har ikke formen OWNER/NAME."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "--repo %@ non è nel formato OWNER/NAME."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "--repo %@ មិនមែនជាទម្រង់ OWNER/NAME ទេ។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "--repo %@ har ikke formen OWNER/NAME."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "--repo %@ nie ma postaci OWNER/NAME."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "--repo %@ não está no formato OWNER/NAME."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "--repo %@ не имеет вида OWNER/NAME."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "--repo %@ ไม่ใช่รูปแบบ OWNER/NAME"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "--repo %@ OWNER/NAME biçiminde değil."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "--repo %@ не має вигляду OWNER/NAME."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "--repo %@ không có dạng OWNER/NAME."}}
      }
    },
    "cloud.cli.repoCredentialsInURL": {
      "comment": "cmux cloud new-machine --repo: the URL holds a token or password. Keep the flag as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "--repo carries credentials. Remove them: the machine uses the GitHub access it already has, and no token is written to it."}},
        "ja": {"stringUnit": {"state": "translated", "value": "--repo に認証情報が含まれています。削除してください。マシンは既存の GitHub アクセスを使い、トークンは書き込まれません。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "--repo enthält Zugangsdaten. Entferne sie: Die Maschine nutzt ihren vorhandenen GitHub-Zugang, und es wird kein Token auf sie geschrieben."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "--repo contient des identifiants. Retirez-les : la machine utilise l’accès GitHub qu’elle a déjà, et aucun jeton n’y est écrit."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "--repo lleva credenciales. Quítalas: la máquina usa el acceso a GitHub que ya tiene y no se escribe ningún token en ella."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "يحتوي ‎--repo على بيانات اعتماد. أزلها: يستخدم الجهاز وصول GitHub المتاح له، ولا يُكتب أي رمز عليه."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "--repo에 자격 증명이 들어 있습니다. 제거하세요. 머신은 이미 가진 GitHub 접근을 사용하며 토큰은 기록되지 않습니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "--repo 中带有凭据。请移除：机器使用它已有的 GitHub 访问权限，不会写入任何令牌。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "--repo 中帶有憑證。請移除：機器使用它已有的 GitHub 存取權限，不會寫入任何權杖。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "--repo sadrži akreditive. Uklonite ih: mašina koristi GitHub pristup koji već ima i na nju se ne upisuje nijedan token."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "--repo indeholder legitimationsoplysninger. Fjern dem: maskinen bruger den GitHub-adgang, den allerede har, og der skrives intet token til den."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "--repo contiene credenziali. Rimuovile: la macchina usa l’accesso GitHub che ha già e non vi viene scritto alcun token."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "--repo មានព័ត៌មានផ្ទៀងផ្ទាត់។ សូមដកវាចេញ៖ ម៉ាស៊ីនប្រើការចូលដំណើរការ GitHub ដែលវាមានរួចហើយ ហើយគ្មាន token ត្រូវបានសរសេរទៅវាទេ។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "--repo inneholder påloggingsinformasjon. Fjern den: maskinen bruker GitHub-tilgangen den allerede har, og ingen token skrives til den."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "--repo zawiera dane logowania. Usuń je: maszyna używa dostępu do GitHuba, który już ma, i nie zapisuje się na niej żaden token."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "--repo contém credenciais. Remova-as: a máquina usa o acesso ao GitHub que já tem, e nenhum token é gravado nela."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "--repo содержит учётные данные. Удалите их: машина использует уже имеющийся доступ к GitHub, и токен на неё не записывается."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "--repo มีข้อมูลรับรอง โปรดลบออก เครื่องจะใช้สิทธิ์เข้าถึง GitHub ที่มีอยู่แล้ว และไม่มีการเขียนโทเค็นลงในเครื่อง"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "--repo kimlik bilgisi içeriyor. Bunları kaldırın: makine zaten sahip olduğu GitHub erişimini kullanır ve ona hiçbir belirteç yazılmaz."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "--repo містить облікові дані. Видаліть їх: машина використовує наявний доступ до GitHub, і токен на неї не записується."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "--repo chứa thông tin xác thực. Hãy xóa chúng: máy dùng quyền truy cập GitHub sẵn có và không có token nào được ghi lên máy."}}
      }
    },
    "cloud.pro.required.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plan doesn't include Cloud machines. Upgrade to cmux Pro to create them, for you and for Chief."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتضمن خطتك أجهزة سحابية. قم بالترقية إلى cmux Pro لإنشائها لك ولـ Chief."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Tarif enthält keine Cloud-Maschinen. Upgrade auf cmux Pro, um sie für dich und für Chief zu erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu plan no incluye máquinas en la nube. Mejora a cmux Pro para crearlas, para ti y para Chief."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre forfait n'inclut pas de machines Cloud. Passez à cmux Pro pour en créer, pour vous et pour Chief."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のプランには Cloud マシンが含まれていません。cmux Pro にアップグレードすると、あなたと Chief のために作成できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 요금제에는 Cloud 머신이 포함되어 있지 않습니다. cmux Pro로 업그레이드하면 나와 Chief를 위해 만들 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的方案不包含 Cloud 机器。升级到 cmux Pro，即可为你和 Chief 创建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的方案不包含 Cloud 機器。升級到 cmux Pro，即可為你和 Chief 建立。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš plan ne uključuje Cloud mašine. Nadogradite na cmux Pro da ih kreirate, za sebe i za Chief."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din plan omfatter ikke Cloud-maskiner. Opgrader til cmux Pro for at oprette dem til dig og til Chief."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo piano non include macchine Cloud. Passa a cmux Pro per crearle, per te e per Chief."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គម្រោងរបស់អ្នកមិនរួមបញ្ចូលម៉ាស៊ីន Cloud ទេ។ ដំឡើងទៅ cmux Pro ដើម្បីបង្កើតវាសម្រាប់អ្នក និងសម្រាប់ Chief។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Planen din inkluderer ikke Cloud-maskiner. Oppgrader til cmux Pro for å opprette dem for deg og for Chief."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój plan nie obejmuje maszyn Cloud. Przejdź na cmux Pro, aby je tworzyć dla siebie i dla Chiefa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu plano não inclui máquinas na nuvem. Faça upgrade para o cmux Pro para criá-las para você e para o Chief."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш тариф не включает облачные машины. Перейдите на cmux Pro, чтобы создавать их для себя и для Chief."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แพ็กเกจของคุณไม่รวมเครื่อง Cloud อัปเกรดเป็น cmux Pro เพื่อสร้างเครื่องให้คุณและ Chief"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planınız Cloud makinelerini içermiyor. Kendiniz ve Chief için oluşturmak üzere cmux Pro'ya yükseltin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш план не містить хмарних машин. Перейдіть на cmux Pro, щоб створювати їх для себе та для Chief."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói của bạn không bao gồm máy Cloud. Nâng cấp lên cmux Pro để tạo máy cho bạn và cho Chief."
          }
        }
      }
    },
    "cloud.cli.repoInvalidRef": {
      "comment": "cmux cloud new-machine --repo OWNER/NAME@REF: REF is not usable. Keep the flag as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The @REF of --repo must be a branch, tag or commit of letters, digits, dots, dashes, underscores and slashes."}},
        "ja": {"stringUnit": {"state": "translated", "value": "--repo の @REF は、英数字、ドット、ハイフン、アンダースコア、スラッシュからなるブランチ、タグ、またはコミットである必要があります。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Das @REF von --repo muss ein Branch, Tag oder Commit aus Buchstaben, Ziffern, Punkten, Bindestrichen, Unterstrichen und Schrägstrichen sein."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Le @REF de --repo doit être une branche, une étiquette ou un commit fait de lettres, chiffres, points, tirets, traits de soulignement et barres obliques."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "El @REF de --repo debe ser una rama, etiqueta o commit de letras, dígitos, puntos, guiones, guiones bajos y barras."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "يجب أن يكون ‎@REF في ‎--repo فرعًا أو وسمًا أو إيداعًا من حروف وأرقام ونقاط وشرطات وشرطات سفلية وشرطات مائلة."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "--repo의 @REF는 영문자, 숫자, 점, 하이픈, 밑줄, 슬래시로 된 브랜치, 태그 또는 커밋이어야 합니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "--repo 的 @REF 必须是由字母、数字、点、连字符、下划线和斜杠组成的分支、标签或提交。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "--repo 的 @REF 必須是由字母、數字、點、連字號、底線和斜線組成的分支、標籤或提交。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "@REF za --repo mora biti grana, oznaka ili commit od slova, cifara, tačaka, crtica, donjih crta i kosih crta."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "@REF i --repo skal være en gren, et tag eller et commit af bogstaver, cifre, punktummer, bindestreger, understreger og skråstreger."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Il @REF di --repo deve essere un branch, un tag o un commit fatto di lettere, cifre, punti, trattini, trattini bassi e barre."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "@REF របស់ --repo ត្រូវតែជា branch, tag ឬ commit ដែលមានអក្សរ លេខ ចំណុច សញ្ញាដក សញ្ញាគូសក្រោម និងសញ្ញាទ្រេត។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "@REF i --repo må være en gren, en tagg eller en commit av bokstaver, sifre, punktum, bindestreker, understreker og skråstreker."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "@REF w --repo musi być gałęzią, tagiem lub commitem z liter, cyfr, kropek, łączników, podkreśleń i ukośników."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "O @REF de --repo deve ser um branch, tag ou commit de letras, dígitos, pontos, hífens, sublinhados e barras."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "@REF в --repo должен быть веткой, тегом или коммитом из букв, цифр, точек, дефисов, подчёркиваний и косых черт."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "@REF ของ --repo ต้องเป็น branch, tag หรือ commit ที่ประกอบด้วยตัวอักษร ตัวเลข จุด ขีด ขีดล่าง และเครื่องหมายทับ"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "--repo'nun @REF'i harf, rakam, nokta, tire, alt çizgi ve eğik çizgiden oluşan bir dal, etiket veya commit olmalıdır."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "@REF у --repo має бути гілкою, тегом або комітом із літер, цифр, крапок, дефісів, підкреслень і скісних рисок."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "@REF của --repo phải là một nhánh, thẻ hoặc commit gồm chữ cái, chữ số, dấu chấm, gạch ngang, gạch dưới và dấu gạch chéo."}}
      }
    },
    "cloud.cli.secretRepoNeeded": {
      "comment": "cmux cloud deliver-secrets without --repo, on a machine set up from a repository that has its own secret values. Both %@ are the repository (OWNER/NAME). Keep --repo as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This machine was set up from %1$@, which has its own secret values on this Mac. Pass --repo %2$@ to deliver them."}},
        "ja": {"stringUnit": {"state": "translated", "value": "このマシンは %1$@ からセットアップされており、この Mac にはそのリポジトリ用のシークレット値があります。配信するには --repo %2$@ を指定してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Diese Maschine wurde aus %1$@ eingerichtet, für das es auf diesem Mac eigene Geheimniswerte gibt. Gib --repo %2$@ an, um sie zu übermitteln."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Cette machine a été configurée à partir de %1$@, qui a ses propres valeurs secrètes sur ce Mac. Passez --repo %2$@ pour les transmettre."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Esta máquina se configuró a partir de %1$@, que tiene sus propios valores secretos en este Mac. Pasa --repo %2$@ para entregarlos."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "أُعدّ هذا الجهاز من %1$@، وله قيم أسرار خاصة به على جهاز Mac هذا. مرّر ‎--repo %2$@ لتسليمها."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "이 머신은 %1$@에서 설정되었으며, 이 Mac에 해당 저장소 전용 비밀 값이 있습니다. 전달하려면 --repo %2$@을(를) 지정하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "这台机器是从 %1$@ 设置的，这台 Mac 上有它专属的机密值。请传入 --repo %2$@ 来送达它们。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "這台機器是從 %1$@ 設定的，這台 Mac 上有它專屬的機密值。請傳入 --repo %2$@ 來送達它們。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Ova mašina je postavljena iz %1$@, koji ima vlastite tajne vrijednosti na ovom Macu. Proslijedite --repo %2$@ da ih isporučite."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Denne maskine blev sat op fra %1$@, som har sine egne hemmelige værdier på denne Mac. Angiv --repo %2$@ for at levere dem."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Questa macchina è stata configurata da %1$@, che ha valori segreti propri su questo Mac. Passa --repo %2$@ per consegnarli."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ម៉ាស៊ីននេះត្រូវបានរៀបចំពី %1$@ ដែលមានតម្លៃអាថ៌កំបាំងផ្ទាល់ខ្លួននៅលើ Mac នេះ។ ផ្ដល់ --repo %2$@ ដើម្បីបញ្ជូនវា។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Denne maskinen ble satt opp fra %1$@, som har egne hemmelige verdier på denne Macen. Angi --repo %2$@ for å levere dem."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Ta maszyna została skonfigurowana z %1$@, które ma własne wartości sekretów na tym Macu. Podaj --repo %2$@, aby je dostarczyć."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Esta máquina foi configurada a partir de %1$@, que tem valores secretos próprios neste Mac. Passe --repo %2$@ para entregá-los."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Эта машина настроена из %1$@, у которого на этом Mac есть свои значения секретов. Укажите --repo %2$@, чтобы доставить их."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เครื่องนี้ตั้งค่าจาก %1$@ ซึ่งมีค่าความลับของตัวเองบน Mac เครื่องนี้ ระบุ --repo %2$@ เพื่อส่งค่าเหล่านั้น"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Bu makine, bu Mac'te kendi sır değerleri olan %1$@ deposundan kuruldu. Bunları teslim etmek için --repo %2$@ verin."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Цю машину налаштовано з %1$@, для якого на цьому Mac є власні значення секретів. Укажіть --repo %2$@, щоб доставити їх."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Máy này được thiết lập từ %1$@, kho có giá trị bí mật riêng trên máy Mac này. Hãy truyền --repo %2$@ để gửi chúng."}}
      }
    },
    "cloud.cli.idlePauseMustBeOneOf": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutes must be one of: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分には次のいずれかを指定してください: %@。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تكون الدقائق واحدة من: %@."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Minute moraju biti jedno od: %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutter skal være en af: %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Minuten müssen einer dieser Werte sein: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los minutos deben ser uno de: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les minutes doivent être l’une des valeurs suivantes : %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I minuti devono essere uno tra: %@."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នាទីត្រូវតែជាមួយក្នុងចំណោម៖ %@។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분은 다음 중 하나여야 합니다: %@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutter må være én av: %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minuty muszą mieć jedną z wartości: %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os minutos devem ser um destes: %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Минуты должны быть одним из значений: %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาทีต้องเป็นค่าใดค่าหนึ่งต่อไปนี้: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dakika şunlardan biri olmalıdır: %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хвилини мають бути одним зі значень: %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số phút phải là một trong: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分钟数必须是以下之一：%@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分鐘數必須是下列其中之一：%@。"
          }
        }
      }
    },
    "cloud.cli.machineConfigUnreadable": {
      "comment": "cmux cloud new-machine / apply-machine-config: the --machine-config file can't be used. %@ is its path.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Can't use the machine config %@: it must be a readable file of at most 64 KB."}},
        "ja": {"stringUnit": {"state": "translated", "value": "マシン構成 %@ を使用できません。64 KB 以下の読み取り可能なファイルである必要があります。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Die Maschinenkonfiguration %@ kann nicht verwendet werden: Sie muss eine lesbare Datei von höchstens 64 KB sein."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Impossible d’utiliser la configuration de machine %@ : il doit s’agir d’un fichier lisible de 64 Ko au plus."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "No se puede usar la configuración de máquina %@: debe ser un archivo legible de 64 KB como máximo."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تعذّر استخدام إعداد الجهاز %@: يجب أن يكون ملفًا قابلًا للقراءة لا يزيد حجمه على 64 كيلوبايت."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "머신 구성 %@을(를) 사용할 수 없습니다. 64KB 이하의 읽을 수 있는 파일이어야 합니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "无法使用机器配置 %@：它必须是不超过 64 KB 的可读文件。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "無法使用機器設定 %@：它必須是不超過 64 KB 的可讀檔案。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Konfiguracija mašine %@ se ne može koristiti: mora biti čitljiva datoteka od najviše 64 KB."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Maskinkonfigurationen %@ kan ikke bruges: den skal være en læsbar fil på højst 64 KB."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Impossibile usare la configurazione della macchina %@: deve essere un file leggibile di al massimo 64 KB."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "មិនអាចប្រើការកំណត់រចនាសម្ព័ន្ធម៉ាស៊ីន %@ បានទេ៖ វាត្រូវតែជាឯកសារដែលអាចអានបាន ទំហំមិនលើស 64 KB។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Kan ikke bruke maskinkonfigurasjonen %@: den må være en lesbar fil på høyst 64 KB."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Nie można użyć konfiguracji maszyny %@: musi to być czytelny plik o rozmiarze co najwyżej 64 KB."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Não é possível usar a configuração da máquina %@: ela deve ser um arquivo legível de no máximo 64 KB."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Не удаётся использовать конфигурацию машины %@: это должен быть читаемый файл размером не более 64 КБ."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ใช้การกำหนดค่าเครื่อง %@ ไม่ได้: ต้องเป็นไฟล์ที่อ่านได้ ขนาดไม่เกิน 64 KB"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "%@ makine yapılandırması kullanılamıyor: en fazla 64 KB boyutunda okunabilir bir dosya olmalıdır."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Не вдається використати конфігурацію машини %@: це має бути файл для читання розміром не більше 64 КБ."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Không thể dùng cấu hình máy %@: tệp phải đọc được và không quá 64 KB."}}
      }
    },
    "cloud.cli.machineWorkspaceHasNoPane": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workspace `%2$@` on machine `%1$@` has no pane to open a terminal in yet. Run the command again, or `cmux cloud new-terminal-on-machine --target machine:%1$@` makes a new workspace."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシン `%1$@` のワークスペース `%2$@` には、ターミナルを開けるペインがまだありません。もう一度実行するか、`cmux cloud new-terminal-on-machine --target machine:%1$@` で新しいワークスペースを作成してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تحتوي مساحة العمل `%2$@` على الجهاز `%1$@` على جزء لفتح طرفية فيه بعد. شغّل الأمر مرة أخرى، أو ينشئ ‎`cmux cloud new-terminal-on-machine --target machine:%1$@`‎ مساحة عمل جديدة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Radni prostor `%2$@` na mašini `%1$@` još nema okno za otvaranje terminala. Pokrenite naredbu ponovo ili `cmux cloud new-terminal-on-machine --target machine:%1$@` pravi novi radni prostor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbejdsområdet `%2$@` på maskinen `%1$@` har endnu ingen rude at åbne en terminal i. Kør kommandoen igen, eller `cmux cloud new-terminal-on-machine --target machine:%1$@` opretter et nyt arbejdsområde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Arbeitsbereich `%2$@` auf der Maschine `%1$@` hat noch keinen Bereich für ein Terminal. Führe den Befehl erneut aus, oder `cmux cloud new-terminal-on-machine --target machine:%1$@` erstellt einen neuen Arbeitsbereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio de trabajo `%2$@` de la máquina `%1$@` aún no tiene un panel donde abrir una terminal. Vuelve a ejecutar el comando, o `cmux cloud new-terminal-on-machine --target machine:%1$@` crea un espacio de trabajo nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’espace de travail `%2$@` de la machine `%1$@` n’a pas encore de volet où ouvrir un terminal. Relancez la commande, ou `cmux cloud new-terminal-on-machine --target machine:%1$@` crée un nouvel espace de travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio di lavoro `%2$@` sulla macchina `%1$@` non ha ancora un riquadro in cui aprire un terminale. Esegui di nuovo il comando, oppure `cmux cloud new-terminal-on-machine --target machine:%1$@` crea un nuovo spazio di lavoro."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កន្លែងធ្វើការ `%2$@` លើម៉ាស៊ីន `%1$@` មិនទាន់មានផ្ទាំងសម្រាប់បើក terminal ទេ។ ដំណើរការពាក្យបញ្ជាម្តងទៀត ឬ `cmux cloud new-terminal-on-machine --target machine:%1$@` បង្កើតកន្លែងធ្វើការថ្មី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머신 `%1$@`의 워크스페이스 `%2$@`에 아직 터미널을 열 패널이 없습니다. 명령을 다시 실행하거나 `cmux cloud new-terminal-on-machine --target machine:%1$@`로 새 워크스페이스를 만드세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeidsområdet `%2$@` på maskinen `%1$@` har ennå ingen rute å åpne en terminal i. Kjør kommandoen igjen, eller `cmux cloud new-terminal-on-machine --target machine:%1$@` lager et nytt arbeidsområde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obszar roboczy `%2$@` na maszynie `%1$@` nie ma jeszcze panelu, w którym można otworzyć terminal. Uruchom polecenie ponownie albo `cmux cloud new-terminal-on-machine --target machine:%1$@` utworzy nowy obszar roboczy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O espaço de trabalho `%2$@` na máquina `%1$@` ainda não tem um painel para abrir um terminal. Execute o comando de novo, ou `cmux cloud new-terminal-on-machine --target machine:%1$@` cria um novo espaço de trabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В рабочем пространстве `%2$@` на машине `%1$@` ещё нет панели для терминала. Запустите команду снова или создайте новое рабочее пространство: `cmux cloud new-terminal-on-machine --target machine:%1$@`."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวิร์กสเปซ `%2$@` บนเครื่อง `%1$@` ยังไม่มีแผงสำหรับเปิดเทอร์มินัล รันคำสั่งอีกครั้ง หรือใช้ `cmux cloud new-terminal-on-machine --target machine:%1$@` เพื่อสร้างเวิร์กสเปซใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` makinesindeki `%2$@` çalışma alanında henüz terminal açılacak bir bölme yok. Komutu yeniden çalıştırın veya `cmux cloud new-terminal-on-machine --target machine:%1$@` yeni bir çalışma alanı oluşturur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У робочому просторі `%2$@` на машині `%1$@` ще немає панелі для термінала. Запустіть команду знову або створіть новий робочий простір: `cmux cloud new-terminal-on-machine --target machine:%1$@`."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không gian làm việc `%2$@` trên máy `%1$@` chưa có ô để mở terminal. Hãy chạy lại lệnh, hoặc `cmux cloud new-terminal-on-machine --target machine:%1$@` sẽ tạo không gian làm việc mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机器 `%1$@` 上的工作区 `%2$@` 还没有可打开终端的窗格。请再次运行该命令，或运行 `cmux cloud new-terminal-on-machine --target machine:%1$@` 新建工作区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "機器 `%1$@` 上的工作區 `%2$@` 還沒有可開啟終端機的窗格。請再次執行該指令，或執行 `cmux cloud new-terminal-on-machine --target machine:%1$@` 新增工作區。"
          }
        }
      }
    },
    "cloud.cli.machineWorkspacesNotLoaded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Machine `%1$@` did not report its workspaces in time, so workspace `%2$@` can't be found yet. Run the command again, or `cmux cloud new-terminal-on-machine --target machine:%1$@` makes a new workspace."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシン `%1$@` がワークスペースを時間内に報告しなかったため、ワークスペース `%2$@` をまだ確認できません。もう一度実行するか、`cmux cloud new-terminal-on-machine --target machine:%1$@` で新しいワークスペースを作成してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُبلغ الجهاز `%1$@` عن مساحات عمله في الوقت المحدد، لذا لا يمكن العثور على مساحة العمل `%2$@` بعد. شغّل الأمر مرة أخرى، أو ينشئ ‎`cmux cloud new-terminal-on-machine --target machine:%1$@`‎ مساحة عمل جديدة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mašina `%1$@` nije na vrijeme prijavila svoje radne prostore, pa radni prostor `%2$@` još nije moguće pronaći. Pokrenite naredbu ponovo ili `cmux cloud new-terminal-on-machine --target machine:%1$@` pravi novi radni prostor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Maskinen `%1$@` rapporterede ikke sine arbejdsområder i tide, så arbejdsområdet `%2$@` kan ikke findes endnu. Kør kommandoen igen, eller `cmux cloud new-terminal-on-machine --target machine:%1$@` opretter et nyt arbejdsområde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Maschine `%1$@` hat ihre Arbeitsbereiche nicht rechtzeitig gemeldet, daher ist der Arbeitsbereich `%2$@` noch nicht auffindbar. Führe den Befehl erneut aus, oder `cmux cloud new-terminal-on-machine --target machine:%1$@` erstellt einen neuen Arbeitsbereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La máquina `%1$@` no informó de sus espacios de trabajo a tiempo, así que aún no se encuentra el espacio de trabajo `%2$@`. Vuelve a ejecutar el comando, o `cmux cloud new-terminal-on-machine --target machine:%1$@` crea un espacio de trabajo nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La machine `%1$@` n’a pas signalé ses espaces de travail à temps, l’espace de travail `%2$@` est donc introuvable pour l’instant. Relancez la commande, ou `cmux cloud new-terminal-on-machine --target machine:%1$@` crée un nouvel espace de travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La macchina `%1$@` non ha segnalato i suoi spazi di lavoro in tempo, quindi lo spazio di lavoro `%2$@` non si trova ancora. Esegui di nuovo il comando, oppure `cmux cloud new-terminal-on-machine --target machine:%1$@` crea un nuovo spazio di lavoro."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម៉ាស៊ីន `%1$@` មិនបានរាយការណ៍កន្លែងធ្វើការរបស់វាទាន់ពេលទេ ដូច្នេះមិនទាន់រកឃើញកន្លែងធ្វើការ `%2$@` នៅឡើយ។ ដំណើរការពាក្យបញ្ជាម្តងទៀត ឬ `cmux cloud new-terminal-on-machine --target machine:%1$@` បង្កើតកន្លែងធ្វើការថ្មី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머신 `%1$@`이(가) 워크스페이스를 제때 보고하지 않아 워크스페이스 `%2$@`을(를) 아직 찾을 수 없습니다. 명령을 다시 실행하거나 `cmux cloud new-terminal-on-machine --target machine:%1$@`로 새 워크스페이스를 만드세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Maskinen `%1$@` rapporterte ikke arbeidsområdene sine i tide, så arbeidsområdet `%2$@` kan ikke finnes ennå. Kjør kommandoen igjen, eller `cmux cloud new-terminal-on-machine --target machine:%1$@` lager et nytt arbeidsområde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maszyna `%1$@` nie zgłosiła na czas swoich obszarów roboczych, więc obszaru roboczego `%2$@` nie da się jeszcze znaleźć. Uruchom polecenie ponownie albo `cmux cloud new-terminal-on-machine --target machine:%1$@` utworzy nowy obszar roboczy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A máquina `%1$@` não informou seus espaços de trabalho a tempo, então o espaço de trabalho `%2$@` ainda não pode ser encontrado. Execute o comando de novo, ou `cmux cloud new-terminal-on-machine --target machine:%1$@` cria um novo espaço de trabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Машина `%1$@` не сообщила о своих рабочих пространствах вовремя, поэтому рабочее пространство `%2$@` пока не найти. Запустите команду снова или создайте новое рабочее пространство: `cmux cloud new-terminal-on-machine --target machine:%1$@`."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่อง `%1$@` ไม่ได้รายงานเวิร์กสเปซทันเวลา จึงยังหาเวิร์กสเปซ `%2$@` ไม่ได้ รันคำสั่งอีกครั้ง หรือใช้ `cmux cloud new-terminal-on-machine --target machine:%1$@` เพื่อสร้างเวิร์กสเปซใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` makinesi çalışma alanlarını zamanında bildirmedi, bu yüzden `%2$@` çalışma alanı henüz bulunamıyor. Komutu yeniden çalıştırın veya `cmux cloud new-terminal-on-machine --target machine:%1$@` yeni bir çalışma alanı oluşturur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Машина `%1$@` не повідомила про свої робочі простори вчасно, тож робочий простір `%2$@` поки не знайти. Запустіть команду знову або створіть новий робочий простір: `cmux cloud new-terminal-on-machine --target machine:%1$@`."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy `%1$@` chưa báo các không gian làm việc kịp lúc, nên chưa tìm được không gian làm việc `%2$@`. Hãy chạy lại lệnh, hoặc `cmux cloud new-terminal-on-machine --target machine:%1$@` sẽ tạo không gian làm việc mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机器 `%1$@` 未及时报告其工作区，因此暂时找不到工作区 `%2$@`。请再次运行该命令，或运行 `cmux cloud new-terminal-on-machine --target machine:%1$@` 新建工作区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "機器 `%1$@` 未及時回報其工作區，因此暫時找不到工作區 `%2$@`。請再次執行該指令，或執行 `cmux cloud new-terminal-on-machine --target machine:%1$@` 新增工作區。"
          }
        }
      }
    },
    "cloud.cli.secretsNotDelivered": {
      "comment": "cmux cloud deliver-secrets: the machine did not take the values. %@ is its short answer (never a value).",
