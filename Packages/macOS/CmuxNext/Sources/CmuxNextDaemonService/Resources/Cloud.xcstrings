        "km": {"stringUnit": {"state": "needs_review", "value": "អាថ៌កំបាំងមិនត្រូវបានបញ្ជូនទេ៖ %@"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Hemmelighetene ble ikke levert: %@"}},
