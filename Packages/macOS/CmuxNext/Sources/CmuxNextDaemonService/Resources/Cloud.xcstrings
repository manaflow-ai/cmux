    "cloud.failed.createRetryOtherTeam": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This machine was requested in another team. Switch back to that team to retry it, or dismiss it and create a new one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このマシンは別のチームでリクエストされました。再試行するにはそのチームに戻るか、閉じて新しく作成してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "طُلبت هذه الآلة في فريق آخر. ارجع إلى ذلك الفريق لإعادة المحاولة، أو تجاهلها وأنشئ آلة جديدة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ova mašina je zatražena u drugom timu. Vratite se na taj tim da pokušate ponovo ili je odbacite i kreirajte novu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne maskine blev bestilt i et andet team. Skift tilbage til det team for at prøve igen, eller afvis den og opret en ny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Maschine wurde in einem anderen Team angefordert. Wechsle zurück zu diesem Team, um es erneut zu versuchen, oder verwirf sie und erstelle eine neue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta máquina se solicitó en otro equipo. Vuelve a ese equipo para reintentarlo, o descártala y crea una nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette machine a été demandée dans une autre équipe. Revenez à cette équipe pour réessayer, ou ignorez-la et créez-en une nouvelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questa macchina è stata richiesta in un altro team. Torna a quel team per riprovare, oppure ignorala e creane una nuova."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ម៉ាស៊ីននេះត្រូវបានស្នើសុំនៅក្នុងក្រុមផ្សេង។ ប្ដូរទៅក្រុមនោះវិញដើម្បីព្យាយាមម្ដងទៀត ឬបោះបង់វា ហើយបង្កើតថ្មី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 머신은 다른 팀에서 요청되었습니다. 다시 시도하려면 그 팀으로 돌아가거나, 닫고 새로 만드세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne maskinen ble bestilt i et annet team. Bytt tilbake til det teamet for å prøve igjen, eller avvis den og opprett en ny."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ta maszyna została zamówiona w innym zespole. Wróć do tego zespołu, aby spróbować ponownie, albo odrzuć ją i utwórz nową."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta máquina foi solicitada em outra equipe. Volte para essa equipe para tentar novamente, ou dispense-a e crie uma nova."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Эта машина была запрошена в другой команде. Вернитесь в эту команду, чтобы повторить попытку, или закройте её и создайте новую."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เครื่องนี้ถูกขอในทีมอื่น สลับกลับไปที่ทีมนั้นเพื่อลองอีกครั้ง หรือปิดแล้วสร้างเครื่องใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu makine başka bir ekipte istendi. Yeniden denemek için o ekibe geri dönün veya kapatıp yeni bir tane oluşturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цю машину було запитано в іншій команді. Поверніться до цієї команди, щоб повторити спробу, або закрийте її та створіть нову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Máy này được yêu cầu trong một nhóm khác. Chuyển lại nhóm đó để thử lại, hoặc bỏ qua và tạo máy mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这台机器是在另一个团队中请求的。切换回该团队以重试，或关闭它并新建一台。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這台機器是在另一個團隊中請求的。切換回該團隊以重試，或關閉它並新建一台。"
          }
        }
      }
    },
    "cloud.failed.alreadySignedIn": {
      "comment": "Sign In while already signed in. `cmux cloud sign-out` is a command; keep it as is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already signed in. To switch accounts, run `cmux cloud sign-out`, then sign in again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでにサインインしています。アカウントを切り替えるには、`cmux cloud sign-out` を実行してから、もう一度サインインしてください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تم تسجيل الدخول بالفعل. لتبديل الحسابات، شغّل `cmux cloud sign-out`، ثم سجّل الدخول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Već ste prijavljeni. Da promijenite račun, pokrenite `cmux cloud sign-out`, pa se ponovo prijavite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du er allerede logget ind. Kør `cmux cloud sign-out` for at skifte konto, og log derefter ind igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bereits angemeldet. Um das Konto zu wechseln, führe `cmux cloud sign-out` aus und melde dich dann erneut an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ya has iniciado sesión. Para cambiar de cuenta, ejecuta `cmux cloud sign-out` y vuelve a iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous êtes déjà connecté. Pour changer de compte, exécutez `cmux cloud sign-out`, puis reconnectez-vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Accesso già effettuato. Per cambiare account, esegui `cmux cloud sign-out`, poi accedi di nuovo."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បានចូលរួចហើយ។ ដើម្បីប្តូរគណនី សូមដំណើរការ `cmux cloud sign-out` រួចចូលម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이미 로그인되어 있습니다. 계정을 전환하려면 `cmux cloud sign-out`을 실행한 뒤 다시 로그인하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Allerede pålogget. For å bytte konto, kjør `cmux cloud sign-out`, og logg deretter på igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Już zalogowano. Aby zmienić konto, uruchom `cmux cloud sign-out`, a potem zaloguj się ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você já iniciou sessão. Para trocar de conta, execute `cmux cloud sign-out` e entre de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вход уже выполнен. Чтобы сменить аккаунт, выполните `cmux cloud sign-out` и войдите снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลงชื่อเข้าใช้อยู่แล้ว หากต้องการสลับบัญชี ให้เรียกใช้ `cmux cloud sign-out` แล้วลงชื่อเข้าใช้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zaten oturum açılmış. Hesap değiştirmek için `cmux cloud sign-out` komutunu çalıştırın, sonra yeniden oturum açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ви вже ввійшли. Щоб змінити обліковий запис, виконайте `cmux cloud sign-out`, а потім увійдіть знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã đăng nhập. Để đổi tài khoản, hãy chạy `cmux cloud sign-out` rồi đăng nhập lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已登录。要切换账户，请运行 `cmux cloud sign-out`，然后重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已登入。若要切換帳號，請執行 `cmux cloud sign-out`，然後重新登入。"
          }
        }
      }
    },
    "cloud.failed.invalidPort": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Port must be between 1 and 65535."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポートは 1 から 65535 の範囲で指定してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون المنفذ بين 1 و65535."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Port mora biti između 1 i 65535."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Porten skal være mellem 1 og 65535."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Port muss zwischen 1 und 65535 liegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El puerto debe estar entre 1 y 65535."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le port doit être compris entre 1 et 65535."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La porta deve essere compresa tra 1 e 65535."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ច្រកត្រូវតែនៅចន្លោះ 1 និង 65535។"
          }
        },
        "ko": {
