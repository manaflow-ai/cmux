    "cloud.cli.bootstrapScriptRequired": {
      "comment": "cmux cloud new-machine: a bootstrap was asked for without its script file. Keep the flags as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "A bootstrap needs its script: pass --bootstrap-script FILE with --bootstrap lane or none."}},
        "ja": {"stringUnit": {"state": "translated", "value": "ブートストラップにはスクリプトが必要です。--bootstrap lane または none と一緒に --bootstrap-script FILE を指定してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Ein Bootstrap braucht sein Skript: Gib --bootstrap-script FILE zusammen mit --bootstrap lane oder none an."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Un bootstrap a besoin de son script : passez --bootstrap-script FILE avec --bootstrap lane ou none."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Un bootstrap necesita su script: pasa --bootstrap-script FILE con --bootstrap lane o none."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "يحتاج التمهيد إلى نصه البرمجي: مرّر ‎--bootstrap-script FILE مع ‎--bootstrap lane أو none."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "부트스트랩에는 스크립트가 필요합니다. --bootstrap lane 또는 none과 함께 --bootstrap-script FILE을 지정하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "引导需要脚本：请将 --bootstrap-script FILE 与 --bootstrap lane 或 none 一起传入。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "引導需要腳本：請將 --bootstrap-script FILE 與 --bootstrap lane 或 none 一起傳入。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Početnom podešavanju treba skripta: proslijedi --bootstrap-script FILE uz --bootstrap lane ili none."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Et opstart kræver sit script: angiv --bootstrap-script FILE sammen med --bootstrap lane eller none."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Un avvio iniziale richiede il suo script: passa --bootstrap-script FILE con --bootstrap lane o none."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ការរៀបចំដំបូងត្រូវការស្គ្រីបរបស់វា៖ បញ្ជូន --bootstrap-script FILE ជាមួយ --bootstrap lane ឬ none។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "En oppstart trenger skriptet sitt: oppgi --bootstrap-script FILE sammen med --bootstrap lane eller none."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Konfiguracja startowa wymaga skryptu: podaj --bootstrap-script FILE razem z --bootstrap lane lub none."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "A inicialização precisa do seu script: passe --bootstrap-script FILE com --bootstrap lane ou none."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Для начальной настройки нужен скрипт: укажите --bootstrap-script FILE вместе с --bootstrap lane или none."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "การตั้งค่าเริ่มต้นต้องมีสคริปต์: ส่ง --bootstrap-script FILE พร้อมกับ --bootstrap lane หรือ none"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "İlk kurulum için betiği gerekir: --bootstrap lane veya none ile birlikte --bootstrap-script FILE verin."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Для початкового налаштування потрібен скрипт: вкажіть --bootstrap-script FILE разом із --bootstrap lane або none."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Khởi tạo ban đầu cần tập lệnh của nó: truyền --bootstrap-script FILE cùng với --bootstrap lane hoặc none."}}
      }
    },
    "cloud.cli.secretNamesRequired": {
      "comment": "cmux cloud deliver-secrets to an own machine (SSH or an acpmux peer) without --names. Keep --names NAME[,NAME…] as is.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Name the secrets this machine gets with --names NAME[,NAME…]. Its secrets file then holds exactly those."}},
        "ja": {"stringUnit": {"state": "translated", "value": "このマシンに渡すシークレットを --names NAME[,NAME…] で指定してください。シークレットファイルにはそれだけが入ります。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Nenne die Geheimnisse für diese Maschine mit --names NAME[,NAME…]. Ihre Geheimnisdatei enthält dann genau diese."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Indiquez les secrets que reçoit cette machine avec --names NAME[,NAME…]. Son fichier de secrets contiendra exactement ceux-là."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Indica los secretos que recibe esta máquina con --names NAME[,NAME…]. Su archivo de secretos contendrá exactamente esos."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "حدّد الأسرار التي تتلقاها هذه الآلة باستخدام --names NAME[,NAME…]. سيحتوي ملف أسرارها عليها فقط."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "--names NAME[,NAME…]로 이 머신이 받을 비밀을 지정하세요. 비밀 파일에는 정확히 그것들만 들어갑니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "用 --names NAME[,NAME…] 指定这台机器获得的机密。它的机密文件将只包含这些。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "用 --names NAME[,NAME…] 指定這台機器取得的機密。它的機密檔案將只包含這些。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Navedi tajne koje ova mašina dobija pomoću --names NAME[,NAME…]. Njena datoteka tajni tada sadrži tačno njih."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Angiv de hemmeligheder, maskinen får, med --names NAME[,NAME…]. Dens hemmelighedsfil indeholder så præcis dem."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Indica i segreti che riceve questa macchina con --names NAME[,NAME…]. Il suo file dei segreti conterrà esattamente quelli."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ដាក់ឈ្មោះអាថ៌កំបាំងដែលម៉ាស៊ីននេះទទួលបាន ដោយប្រើ --names NAME[,NAME…]។ ឯកសារអាថ៌កំបាំងរបស់វានឹងមានតែអាថ៌កំបាំងទាំងនោះ។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Angi hemmelighetene maskinen får med --names NAME[,NAME…]. Hemmelighetsfilen dens inneholder da nøyaktig disse."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Podaj sekrety dla tej maszyny przez --names NAME[,NAME…]. Jej plik sekretów będzie zawierał dokładnie je."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Informe os segredos que esta máquina recebe com --names NAME[,NAME…]. O arquivo de segredos dela terá exatamente esses."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Укажите секреты для этой машины через --names NAME[,NAME…]. Её файл секретов будет содержать ровно их."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ระบุความลับที่เครื่องนี้จะได้รับด้วย --names NAME[,NAME…] ไฟล์ความลับของเครื่องจะมีเฉพาะรายการเหล่านั้น"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Bu makinenin alacağı sırları --names NAME[,NAME…] ile belirtin. Sır dosyası tam olarak bunları içerir."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Вкажіть секрети для цієї машини через --names NAME[,NAME…]. Її файл секретів міститиме саме їх."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Đặt tên các bí mật máy này nhận bằng --names NAME[,NAME…]. Tệp bí mật của máy sẽ chỉ chứa đúng những bí mật đó."}}
      }
    },
