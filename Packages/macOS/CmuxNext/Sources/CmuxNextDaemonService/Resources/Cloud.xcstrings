    "cloud.result.templateBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Template %@ is being saved. Once it is ready, start a machine from it with Restore Cloud Machine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンプレート %@ を保存しています。準備ができたら「Cloud マシンを復元」でこのテンプレートからマシンを起動できます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "جارٍ حفظ القالب %@. عندما يصبح جاهزًا، شغّل جهازًا منه باستخدام «استعادة جهاز Cloud»."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Šablon %@ se sprema. Kada bude spreman, pokrenite mašinu iz njega pomoću Vrati Cloud mašinu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skabelonen %@ bliver gemt. Når den er klar, kan du starte en maskine fra den med Gendan Cloud-maskine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vorlage %@ wird gespeichert. Sobald sie bereit ist, starte mit „Cloud-Maschine wiederherstellen“ eine Maschine daraus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se está guardando la plantilla %@. Cuando esté lista, inicia una máquina a partir de ella con Restaurar máquina de Cloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le modèle %@ est en cours d’enregistrement. Une fois prêt, démarrez une machine à partir de celui-ci avec Restaurer la machine Cloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il modello %@ è in corso di salvataggio. Quando è pronto, avvia una macchina da esso con Ripristina macchina Cloud."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កំពុងរក្សាទុកគំរូ %@។ ពេលវារួចរាល់ ចាប់ផ្ដើមម៉ាស៊ីនពីវាដោយប្រើ ស្ដារម៉ាស៊ីន Cloud។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "템플릿 %@을(를) 저장하는 중입니다. 준비되면 Cloud 머신 복원으로 이 템플릿에서 머신을 시작하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Malen %@ lagres nå. Når den er klar, starter du en maskin fra den med Gjenopprett Cloud-maskin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trwa zapisywanie szablonu %@. Gdy będzie gotowy, uruchom z niego maszynę za pomocą Przywróć maszynę Cloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O modelo %@ está sendo salvo. Quando estiver pronto, inicie uma máquina a partir dele com Restaurar máquina do Cloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Шаблон %@ сохраняется. Когда он будет готов, запустите из него машину командой «Восстановить машину Cloud»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "กำลังบันทึกเทมเพลต %@ เมื่อพร้อมแล้ว เริ่มเครื่องจากเทมเพลตนี้ด้วย กู้คืนเครื่อง Cloud"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ şablonu kaydediliyor. Hazır olduğunda, ondan bir makine başlatmak için Cloud Makinesini Geri Yükle komutunu kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Шаблон %@ зберігається. Коли він буде готовий, запустіть із нього машину командою «Відновити машину Cloud»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đang lưu mẫu %@. Khi sẵn sàng, hãy khởi động máy từ mẫu này bằng Khôi phục máy Cloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "正在保存模板 %@。就绪后，使用“恢复 Cloud 机器”从它启动机器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "正在儲存範本 %@。就緒後，使用「還原 Cloud 機器」從它啟動機器。"
          }
        }
      }
    },
