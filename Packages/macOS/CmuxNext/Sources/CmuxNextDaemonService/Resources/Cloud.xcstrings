    "cloud.cli.repoUnrecognized": {
      "comment": "cmux cloud new-machine --repo: not a GitHub repository or an https git URL. Keep the flag and the example forms as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "--repo takes a GitHub repository (OWNER/NAME, https://github.com/OWNER/NAME or git@github.com:OWNER/NAME.git) or another host's https URL (https://gitlab.com/GROUP/NAME), with an optional @REF."}},
        "ja": {"stringUnit": {"state": "translated", "value": "--repo には GitHub リポジトリ（OWNER/NAME、https://github.com/OWNER/NAME、または git@github.com:OWNER/NAME.git）か、ほかのホストの https URL（https://gitlab.com/GROUP/NAME）を指定します（末尾に @REF を付けられます）。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "--repo nimmt ein GitHub-Repository: OWNER/NAME, https://github.com/OWNER/NAME oder git@github.com:OWNER/NAME.git, optional mit @REF."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "--repo attend un dépôt GitHub : OWNER/NAME, https://github.com/OWNER/NAME ou git@github.com:OWNER/NAME.git, avec un @REF facultatif."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "--repo acepta un repositorio de GitHub: OWNER/NAME, https://github.com/OWNER/NAME o git@github.com:OWNER/NAME.git, con un @REF opcional."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "يقبل ‎--repo مستودع GitHub: ‏OWNER/NAME أو https://github.com/OWNER/NAME أو git@github.com:OWNER/NAME.git، مع ‎@REF اختياري."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "--repo에는 GitHub 저장소를 지정합니다: OWNER/NAME, https://github.com/OWNER/NAME 또는 git@github.com:OWNER/NAME.git(끝에 @REF를 붙일 수 있음)."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "--repo 需要一个 GitHub 仓库：OWNER/NAME、https://github.com/OWNER/NAME 或 git@github.com:OWNER/NAME.git，可在末尾加 @REF。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "--repo 需要一個 GitHub 儲存庫：OWNER/NAME、https://github.com/OWNER/NAME 或 git@github.com:OWNER/NAME.git，可在結尾加 @REF。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "--repo prima GitHub repozitorij: OWNER/NAME, https://github.com/OWNER/NAME ili git@github.com:OWNER/NAME.git, uz opcionalni @REF."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "--repo tager et GitHub-lager: OWNER/NAME, https://github.com/OWNER/NAME eller git@github.com:OWNER/NAME.git, med et valgfrit @REF."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "--repo accetta un repository GitHub: OWNER/NAME, https://github.com/OWNER/NAME o git@github.com:OWNER/NAME.git, con un @REF facoltativo."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "--repo ទទួលយកឃ្លាំង GitHub៖ OWNER/NAME, https://github.com/OWNER/NAME ឬ git@github.com:OWNER/NAME.git ដោយមាន @REF ជាជម្រើស។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "--repo tar et GitHub-lager: OWNER/NAME, https://github.com/OWNER/NAME eller git@github.com:OWNER/NAME.git, med valgfri @REF."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "--repo przyjmuje repozytorium GitHub: OWNER/NAME, https://github.com/OWNER/NAME lub git@github.com:OWNER/NAME.git, z opcjonalnym @REF."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "--repo aceita um repositório do GitHub: OWNER/NAME, https://github.com/OWNER/NAME ou git@github.com:OWNER/NAME.git, com um @REF opcional."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "--repo принимает репозиторий GitHub: OWNER/NAME, https://github.com/OWNER/NAME или git@github.com:OWNER/NAME.git, с необязательным @REF."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "--repo รับที่เก็บ GitHub: OWNER/NAME, https://github.com/OWNER/NAME หรือ git@github.com:OWNER/NAME.git โดยมี @REF หรือไม่ก็ได้"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "--repo bir GitHub deposu alır: OWNER/NAME, https://github.com/OWNER/NAME veya git@github.com:OWNER/NAME.git, isteğe bağlı @REF ile."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "--repo приймає репозиторій GitHub: OWNER/NAME, https://github.com/OWNER/NAME або git@github.com:OWNER/NAME.git, з необов’язковим @REF."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "--repo nhận một kho GitHub: OWNER/NAME, https://github.com/OWNER/NAME hoặc git@github.com:OWNER/NAME.git, có thể kèm @REF."}}
      }
    },
    "cloud.cli.secretIndexUnreadable": {
      "comment": "cmux cloud deliver-secrets: the local secrets index exists but cannot be read. %@ is its path. Keep the command as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Can't read %@, so nothing was delivered. Fix or remove it, then store the secrets again with cmux cloud secret set."}},
        "ja": {"stringUnit": {"state": "translated", "value": "%@ を読み取れないため、何も配信しませんでした。修正するか削除してから、cmux cloud secret set でシークレットをもう一度保存してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "%@ kann nicht gelesen werden, daher wurde nichts übermittelt. Repariere oder entferne die Datei und speichere die Geheimnisse dann mit cmux cloud secret set erneut."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Impossible de lire %@, rien n’a donc été transmis. Réparez-le ou supprimez-le, puis enregistrez à nouveau les secrets avec cmux cloud secret set."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "No se puede leer %@, así que no se entregó nada. Corrígelo o elimínalo y vuelve a guardar los secretos con cmux cloud secret set."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تعذّرت قراءة %@، لذا لم يُسلَّم شيء. أصلحه أو احذفه، ثم خزّن الأسرار مرة أخرى باستخدام cmux cloud secret set."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "%@을(를) 읽을 수 없어 아무것도 전달하지 않았습니다. 고치거나 삭제한 다음 cmux cloud secret set으로 비밀을 다시 저장하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "无法读取 %@，因此未送达任何内容。请修复或删除它，然后用 cmux cloud secret set 重新保存机密。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "無法讀取 %@，因此未送達任何內容。請修復或刪除它，然後用 cmux cloud secret set 重新儲存機密。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "%@ se ne može pročitati, pa ništa nije isporučeno. Popravite ga ili uklonite, a zatim ponovo sačuvajte tajne pomoću cmux cloud secret set."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "%@ kan ikke læses, så intet blev leveret. Ret eller fjern den, og gem derefter hemmelighederne igen med cmux cloud secret set."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Impossibile leggere %@, quindi non è stato consegnato nulla. Correggilo o rimuovilo, poi salva di nuovo i segreti con cmux cloud secret set."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "មិនអាចអាន %@ បានទេ ដូច្នេះគ្មានអ្វីត្រូវបានបញ្ជូនទេ។ ជួសជុល ឬលុបវា រួចរក្សាទុកអាថ៌កំបាំងម្ដងទៀតដោយ cmux cloud secret set។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Kan ikke lese %@, så ingenting ble levert. Reparer eller fjern den, og lagre deretter hemmelighetene på nytt med cmux cloud secret set."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Nie można odczytać %@, więc nic nie dostarczono. Napraw lub usuń plik, a potem zapisz sekrety ponownie poleceniem cmux cloud secret set."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Não é possível ler %@, então nada foi entregue. Corrija ou remova o arquivo e armazene os segredos de novo com cmux cloud secret set."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Не удаётся прочитать %@, поэтому ничего не доставлено. Исправьте или удалите файл, затем снова сохраните секреты командой cmux cloud secret set."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "อ่าน %@ ไม่ได้ จึงไม่ได้ส่งอะไรเลย แก้ไขหรือลบไฟล์นี้ แล้วจัดเก็บความลับอีกครั้งด้วย cmux cloud secret set"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "%@ okunamıyor, bu yüzden hiçbir şey teslim edilmedi. Düzeltin veya kaldırın, ardından sırları cmux cloud secret set ile yeniden saklayın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Не вдається прочитати %@, тому нічого не доставлено. Виправте або видаліть файл, потім знову збережіть секрети командою cmux cloud secret set."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Không thể đọc %@ nên chưa gửi gì. Hãy sửa hoặc xóa tệp, rồi lưu lại bí mật bằng cmux cloud secret set."}}
      }
    },
    "cloud.cli.laneNeedsName": {
      "comment": "cmux cloud new-machine --bootstrap lane without --name. Keep the flag as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The lane bootstrap needs the machine's name: pass --name lane-vm-N."}},
        "ja": {"stringUnit": {"state": "translated", "value": "lane ブートストラップにはマシン名が必要です。--name lane-vm-N を指定してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Der Lane-Bootstrap braucht den Namen der Maschine: Gib --name lane-vm-N an."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Le bootstrap lane a besoin du nom de la machine : passez --name lane-vm-N."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "El bootstrap lane necesita el nombre de la máquina: pasa --name lane-vm-N."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "يحتاج تمهيد lane إلى اسم الجهاز: مرّر ‎--name lane-vm-N."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "lane 부트스트랩에는 머신 이름이 필요합니다. --name lane-vm-N을 지정하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "lane 引导需要机器名称：请传入 --name lane-vm-N。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "lane 引導需要機器名稱：請傳入 --name lane-vm-N。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Početnom podešavanju lane treba ime mašine: proslijedi --name lane-vm-N."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Lane-opstarten skal bruge maskinens navn: angiv --name lane-vm-N."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "L'avvio iniziale lane richiede il nome della macchina: passa --name lane-vm-N."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ការរៀបចំដំបូង lane ត្រូវការឈ្មោះម៉ាស៊ីន៖ បញ្ជូន --name lane-vm-N។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Lane-oppstarten trenger maskinens navn: oppgi --name lane-vm-N."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Konfiguracja startowa lane wymaga nazwy maszyny: podaj --name lane-vm-N."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "A inicialização lane precisa do nome da máquina: passe --name lane-vm-N."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Для начальной настройки lane нужно имя машины: укажите --name lane-vm-N."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "การตั้งค่าเริ่มต้นแบบ lane ต้องมีชื่อเครื่อง: ส่ง --name lane-vm-N"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "lane ilk kurulumu makinenin adına ihtiyaç duyar: --name lane-vm-N verin."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Для початкового налаштування lane потрібне ім'я машини: вкажіть --name lane-vm-N."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Khởi tạo lane cần tên của máy: truyền --name lane-vm-N."}}
      }
    },
    "cloud.cli.secretUnreadable": {
      "comment": "cmux cloud deliver-secrets: the Keychain did not give a stored secret's value. %@ is the secret's name. Keep the command as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Can't read the secret %@ from this Mac's Keychain. Unlock it, or store it again with cmux cloud secret set."}},
        "ja": {"stringUnit": {"state": "translated", "value": "この Mac のキーチェーンからシークレット %@ を読み取れません。キーチェーンのロックを解除するか、cmux cloud secret set でもう一度保存してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Das Geheimnis %@ kann nicht aus dem Schlüsselbund dieses Mac gelesen werden. Entsperre ihn oder speichere es mit cmux cloud secret set erneut."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Impossible de lire le secret %@ dans le trousseau de ce Mac. Déverrouillez-le, ou enregistrez-le à nouveau avec cmux cloud secret set."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "No se puede leer el secreto %@ del llavero de este Mac. Desbloquéalo o guárdalo de nuevo con cmux cloud secret set."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تعذّرت قراءة السر %@ من سلسلة مفاتيح جهاز Mac هذا. افتح قفلها، أو خزّنه مرة أخرى باستخدام cmux cloud secret set."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "이 Mac의 키체인에서 비밀 %@을(를) 읽을 수 없습니다. 키체인 잠금을 해제하거나 cmux cloud secret set으로 다시 저장하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "无法从这台 Mac 的钥匙串读取机密 %@。请解锁钥匙串，或用 cmux cloud secret set 重新保存。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "無法從這台 Mac 的鑰匙圈讀取機密 %@。請解鎖鑰匙圈，或用 cmux cloud secret set 重新儲存。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Tajna %@ se ne može pročitati iz privjeska ključeva ovog Maca. Otključajte ga ili je ponovo sačuvajte pomoću cmux cloud secret set."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Hemmeligheden %@ kan ikke læses fra denne Macs nøglering. Lås den op, eller gem den igen med cmux cloud secret set."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Impossibile leggere il segreto %@ dal portachiavi di questo Mac. Sbloccalo o salvalo di nuovo con cmux cloud secret set."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "មិនអាចអានអាថ៌កំបាំង %@ ពី Keychain របស់ Mac នេះបានទេ។ ដោះសោវា ឬរក្សាទុកវាម្ដងទៀតដោយ cmux cloud secret set។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Kan ikke lese hemmeligheten %@ fra nøkkelringen på denne Macen. Lås den opp, eller lagre den på nytt med cmux cloud secret set."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Nie można odczytać sekretu %@ z pęku kluczy tego Maca. Odblokuj go albo zapisz sekret ponownie poleceniem cmux cloud secret set."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Não é possível ler o segredo %@ das Chaves deste Mac. Desbloqueie-as ou armazene-o de novo com cmux cloud secret set."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Не удаётся прочитать секрет %@ из связки ключей этого Mac. Разблокируйте её или сохраните секрет снова командой cmux cloud secret set."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "อ่านความลับ %@ จากพวงกุญแจของ Mac เครื่องนี้ไม่ได้ ปลดล็อกพวงกุญแจ หรือจัดเก็บใหม่ด้วย cmux cloud secret set"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "%@ sırrı bu Mac'in anahtar zincirinden okunamıyor. Kilidini açın veya cmux cloud secret set ile yeniden saklayın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Не вдається прочитати секрет %@ зі зв'язки ключів цього Mac. Розблокуйте її або збережіть секрет знову командою cmux cloud secret set."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Không thể đọc bí mật %@ từ Chuỗi khóa của máy Mac này. Hãy mở khóa, hoặc lưu lại bằng cmux cloud secret set."}}
      }
    },
    "cloud.cli.bootstrapScriptUnreadable": {
      "comment": "cmux cloud new-machine: the bootstrap script file can't be used. %@ is its path.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Can't use the bootstrap script %@: it must be a readable file of at most 1 MB."}},
        "ja": {"stringUnit": {"state": "translated", "value": "ブートストラップスクリプト %@ を使用できません。1 MB 以下の読み取り可能なファイルである必要があります。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Das Bootstrap-Skript %@ kann nicht verwendet werden: Es muss eine lesbare Datei von höchstens 1 MB sein."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Impossible d’utiliser le script de bootstrap %@ : il doit s’agir d’un fichier lisible de 1 Mo au plus."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "No se puede usar el script de bootstrap %@: debe ser un archivo legible de 1 MB como máximo."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تعذّر استخدام نص التمهيد %@: يجب أن يكون ملفًا قابلًا للقراءة لا يزيد حجمه على 1 ميغابايت."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "부트스트랩 스크립트 %@을(를) 사용할 수 없습니다. 1MB 이하의 읽을 수 있는 파일이어야 합니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "无法使用引导脚本 %@：它必须是不超过 1 MB 的可读文件。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "無法使用引導腳本 %@：它必須是不超過 1 MB 的可讀檔案。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Nije moguće koristiti skriptu početnog podešavanja %@: mora biti čitljiva datoteka od najviše 1 MB."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Kan ikke bruge opstartsscriptet %@: det skal være en læsbar fil på højst 1 MB."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Impossibile usare lo script di avvio iniziale %@: deve essere un file leggibile di al massimo 1 MB."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "មិនអាចប្រើស្គ្រីបរៀបចំដំបូង %@ បានទេ៖ វាត្រូវតែជាឯកសារដែលអាចអានបាន និងមិនលើសពី 1 MB។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Kan ikke bruke oppstartsskriptet %@: det må være en lesbar fil på høyst 1 MB."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Nie można użyć skryptu konfiguracji startowej %@: musi to być czytelny plik o rozmiarze najwyżej 1 MB."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Não é possível usar o script de inicialização %@: ele precisa ser um arquivo legível de no máximo 1 MB."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Невозможно использовать скрипт начальной настройки %@: это должен быть читаемый файл размером не более 1 МБ."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ใช้สคริปต์ตั้งค่าเริ่มต้น %@ ไม่ได้: ต้องเป็นไฟล์ที่อ่านได้และมีขนาดไม่เกิน 1 MB"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "%@ ilk kurulum betiği kullanılamıyor: en fazla 1 MB boyutunda okunabilir bir dosya olmalı."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Неможливо використати скрипт початкового налаштування %@: це має бути файл, доступний для читання, розміром не більше 1 МБ."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Không thể dùng tập lệnh khởi tạo %@: tập lệnh phải là tệp đọc được, tối đa 1 MB."}}
      }
    },
