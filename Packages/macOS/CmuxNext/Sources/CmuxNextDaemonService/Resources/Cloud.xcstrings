    "cloud.failed.notConnected": {
      "comment": "A Cloud action needs the machine's connection. `cmux cloud resume-machine --target machine:<id>` is a command; keep it as is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Cloud machine is not connected yet. Wait for it to connect; if it is paused, run `cmux cloud resume-machine --target machine:<id>`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud マシンはまだ接続されていません。接続されるまでお待ちください。一時停止中の場合は `cmux cloud resume-machine --target machine:<id>` を実行してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "جهاز Cloud غير متصل بعد. انتظر حتى يتصل؛ وإذا كان متوقفًا مؤقتًا، فشغّل `cmux cloud resume-machine --target machine:<id>`."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cloud mašina još nije povezana. Sačekajte da se poveže; ako je pauzirana, pokrenite `cmux cloud resume-machine --target machine:<id>`."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cloud-maskinen er ikke forbundet endnu. Vent på, at den opretter forbindelse. Hvis den er sat på pause, så kør `cmux cloud resume-machine --target machine:<id>`."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Cloud-Maschine ist noch nicht verbunden. Warte, bis sie sich verbindet; ist sie pausiert, führe `cmux cloud resume-machine --target machine:<id>` aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La máquina de Cloud aún no está conectada. Espera a que se conecte; si está en pausa, ejecuta `cmux cloud resume-machine --target machine:<id>`."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La machine Cloud n’est pas encore connectée. Attendez qu’elle se connecte ; si elle est en pause, exécutez `cmux cloud resume-machine --target machine:<id>`."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La macchina Cloud non è ancora connessa. Attendi che si connetta; se è in pausa, esegui `cmux cloud resume-machine --target machine:<id>`."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ម៉ាស៊ីន Cloud មិនទាន់បានភ្ជាប់នៅឡើយទេ។ រង់ចាំឱ្យវាភ្ជាប់។ ប្រសិនបើវាត្រូវបានផ្អាក សូមដំណើរការ `cmux cloud resume-machine --target machine:<id>`។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cloud 기기가 아직 연결되지 않았습니다. 연결될 때까지 기다리십시오. 일시 정지된 경우 `cmux cloud resume-machine --target machine:<id>`를 실행하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cloud-maskinen er ikke tilkoblet ennå. Vent til den kobler til. Hvis den er satt på pause, kjør `cmux cloud resume-machine --target machine:<id>`."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maszyna Cloud nie jest jeszcze połączona. Poczekaj, aż się połączy; jeśli jest wstrzymana, uruchom `cmux cloud resume-machine --target machine:<id>`."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A máquina Cloud ainda não está conectada. Aguarde a conexão; se ela estiver pausada, execute `cmux cloud resume-machine --target machine:<id>`."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Машина Cloud еще не подключена. Дождитесь подключения; если она приостановлена, выполните `cmux cloud resume-machine --target machine:<id>`."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เครื่อง Cloud ยังไม่ได้เชื่อมต่อ รอให้เชื่อมต่อ หากเครื่องหยุดชั่วคราวอยู่ ให้เรียกใช้ `cmux cloud resume-machine --target machine:<id>`"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cloud makinesi henüz bağlı değil. Bağlanmasını bekleyin; duraklatılmışsa `cmux cloud resume-machine --target machine:<id>` komutunu çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Машина Cloud ще не підключена. Зачекайте, доки вона підключиться; якщо її призупинено, виконайте `cmux cloud resume-machine --target machine:<id>`."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Máy Cloud chưa được kết nối. Hãy đợi máy kết nối; nếu máy đang tạm dừng, hãy chạy `cmux cloud resume-machine --target machine:<id>`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cloud 机器尚未连接。请等待其连接；如果它已暂停，请运行 `cmux cloud resume-machine --target machine:<id>`。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cloud 機器尚未連線。請等待其連線；如果它已暫停，請執行 `cmux cloud resume-machine --target machine:<id>`。"
          }
        }
      }
    },
    "cloud.failed.signInFirst": {
