        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនបានបង្កើតម៉ាស៊ីន Cloud ទេ៖ បុគ្គលនោះបានបដិសេធ ឬបិទវានៅក្នុង cmux។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen Cloud-maskin ble opprettet: personen avslo eller lukket den i cmux."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
