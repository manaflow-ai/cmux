          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនមានម៉ាស៊ីន Cloud ត្រូវបានជ្រើសទេ។ ចុចស្ដាំលើម៉ាស៊ីន ឬបញ្ជូន --target machine:<id>; `cmux cloud list-machines` បង្ហាញបញ្ជី ID។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "선택된 Cloud 기기가 없습니다. 기기를 오른쪽 클릭하거나 --target machine:<id>를 지정하십시오. ID 목록은 `cmux cloud list-machines`로 볼 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen Cloud-maskin er valgt. Høyreklikk på en maskin eller bruk --target machine:<id>; `cmux cloud list-machines` viser ID-ene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie wybrano maszyny Cloud. Kliknij maszynę prawym przyciskiem lub podaj --target machine:<id>; `cmux cloud list-machines` wyświetla ID."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhuma máquina Cloud selecionada. Clique com o botão direito em uma máquina ou passe --target machine:<id>; `cmux cloud list-machines` lista os IDs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Машина Cloud не выбрана. Нажмите на машину правой кнопкой или укажите --target machine:<id>; `cmux cloud list-machines` выводит список ID."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่ได้เลือกเครื่อง Cloud คลิกขวาที่เครื่องหรือส่ง --target machine:<id> โดย `cmux cloud list-machines` จะแสดงรายการ ID"
