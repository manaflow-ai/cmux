    "cloud.failed.resizeNeedsSizeOrDisk": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass --size (%@), --disk with a whole number of GiB (4 GiB steps, up to 256, grow-only), or both."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "--size (%@)、--disk (GiB 単位の整数。4 GiB 刻み、最大 256、拡張のみ)、またはその両方を指定してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرّر ‎--size‎ ‏(%@)‏ أو ‎--disk‎ بعدد صحيح من GiB (بخطوات 4 GiB، حتى 256، للزيادة فقط)، أو كليهما."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Proslijedite --size (%@), --disk s cijelim brojem GiB (koraci od 4 GiB, do 256, samo povećanje) ili oboje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv --size (%@), --disk med et helt antal GiB (trin på 4 GiB, op til 256, kun forøgelse) eller begge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib --size (%@), --disk mit einer ganzen Zahl GiB (in 4-GiB-Schritten, bis 256, nur vergrößern) oder beides an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica --size (%@), --disk con un número entero de GiB (pasos de 4 GiB, hasta 256, solo para aumentar) o ambos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez --size (%@), --disk avec un nombre entier de Gio (par pas de 4 Gio, jusqu’à 256, agrandissement uniquement), ou les deux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Specifica --size (%@), --disk con un numero intero di GiB (passi di 4 GiB, fino a 256, solo in aumento) o entrambi."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ជូន --size (%@), --disk ជាចំនួនគត់នៃ GiB (ជំហាន 4 GiB រហូតដល់ 256 បង្កើនតែប៉ុណ្ណោះ) ឬទាំងពីរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "--size (%@), --disk(GiB 단위 정수, 4 GiB 단위, 최대 256, 늘리기만 가능) 또는 둘 다 지정하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppgi --size (%@), --disk med et helt antall GiB (trinn på 4 GiB, opptil 256, kun økning) eller begge."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj --size (%@), --disk z całkowitą liczbą GiB (co 4 GiB, do 256, tylko zwiększanie) lub oba."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe --size (%@), --disk com um número inteiro de GiB (passos de 4 GiB, até 256, só aumenta) ou ambos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите --size (%@), --disk с целым числом ГиБ (шаг 4 ГиБ, до 256, только увеличение) или оба."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบุ --size (%@), --disk เป็นจำนวนเต็มของ GiB (ทีละ 4 GiB สูงสุด 256 ขยายได้อย่างเดียว) หรือทั้งสองอย่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "--size (%@), tam sayı GiB değeriyle --disk (4 GiB adımlarla, en fazla 256, yalnızca büyütme) ya da ikisini birden verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкажіть --size (%@), --disk із цілим числом ГіБ (крок 4 ГіБ, до 256, лише збільшення) або обидва."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Truyền --size (%@), --disk với số GiB nguyên (bước 4 GiB, tối đa 256, chỉ tăng), hoặc cả hai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请传入 --size（%@）、--disk（GiB 整数，以 4 GiB 为步长，最大 256，只能增大），或两者都传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請傳入 --size（%@）、--disk（GiB 整數，以 4 GiB 為級距，最大 256，只能增加），或兩者都傳。"
          }
        }
      }
    },
    "cloud.workspace.closeKeepsMachine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Cloud machine is kept. It pauses when idle, and you can resume it from the sidebar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم الاحتفاظ بجهاز Cloud. يتوقف مؤقتًا عند الخمول، ويمكنك استئنافه من الشريط الجانبي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud mašina se zadržava. Pauzira se kada je neaktivna, a možete je nastaviti iz bočne trake."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-maskinen beholdes. Den sættes på pause, når den er inaktiv, og du kan genoptage den fra sidepanelet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Cloud-Maschine bleibt erhalten. Sie pausiert bei Inaktivität, und du kannst sie in der Seitenleiste fortsetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La máquina de Cloud se conserva. Se pausa cuando está inactiva y puedes reanudarla desde la barra lateral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La machine Cloud est conservée. Elle se met en pause lorsqu’elle est inactive, et vous pouvez la reprendre depuis la barre latérale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La macchina Cloud viene mantenuta. Va in pausa quando è inattiva e puoi riprenderla dalla barra laterale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud マシンは保持されます。アイドル状態になると一時停止し、サイドバーから再開できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម៉ាស៊ីន Cloud ត្រូវបានរក្សាទុក។ វាផ្អាកនៅពេលទំនេរ ហើយអ្នកអាចបន្តវាពីរបារចំហៀង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud 머신은 유지됩니다. 유휴 상태가 되면 일시 정지되며 사이드바에서 다시 시작할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-maskinen beholdes. Den settes på pause når den er inaktiv, og du kan gjenoppta den fra sidepanelet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maszyna Cloud zostaje zachowana. Wstrzymuje się, gdy jest bezczynna, a możesz ją wznowić z paska bocznego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A máquina do Cloud é mantida. Ela pausa quando fica ociosa, e você pode retomá-la pela barra lateral."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Машина Cloud сохраняется. Она приостанавливается при бездействии, и её можно возобновить на боковой панели."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบบจะเก็บเครื่อง Cloud ไว้ เครื่องจะหยุดชั่วคราวเมื่อไม่มีการใช้งาน และคุณสามารถใช้งานต่อได้จากแถบด้านข้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud makinesi korunur. Boşta kaldığında duraklar ve kenar çubuğundan devam ettirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Машину Cloud збережено. Вона призупиняється під час бездіяльності, і її можна відновити на бічній панелі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Cloud được giữ lại. Máy sẽ tạm dừng khi không hoạt động và bạn có thể tiếp tục nó từ thanh bên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud 机器会保留。它在空闲时暂停，你可以从侧边栏恢复它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud 機器會保留。它在閒置時暫停，你可以從側邊欄恢復它。"
          }
        }
      }
    },
    "cloud.workspace.closeKeepsMachineUntil": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Cloud machine is kept. It pauses when idle, and you can resume it from the sidebar. If it stays paused, it is deleted on %@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم الاحتفاظ بجهاز Cloud. يتوقف مؤقتًا عند الخمول، ويمكنك استئنافه من الشريط الجانبي. إذا بقي متوقفًا مؤقتًا، فسيتم حذفه في %@."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud mašina se zadržava. Pauzira se kada je neaktivna, a možete je nastaviti iz bočne trake. Ako ostane pauzirana, briše se %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-maskinen beholdes. Den sættes på pause, når den er inaktiv, og du kan genoptage den fra sidepanelet. Hvis den forbliver på pause, slettes den den %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Cloud-Maschine bleibt erhalten. Sie pausiert bei Inaktivität, und du kannst sie in der Seitenleiste fortsetzen. Bleibt sie pausiert, wird sie am %@ gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La máquina de Cloud se conserva. Se pausa cuando está inactiva y puedes reanudarla desde la barra lateral. Si sigue en pausa, se eliminará el %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La machine Cloud est conservée. Elle se met en pause lorsqu’elle est inactive, et vous pouvez la reprendre depuis la barre latérale. Si elle reste en pause, elle sera supprimée le %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La macchina Cloud viene mantenuta. Va in pausa quando è inattiva e puoi riprenderla dalla barra laterale. Se resta in pausa, verrà eliminata il %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud マシンは保持されます。アイドル状態になると一時停止し、サイドバーから再開できます。一時停止のままの場合、%@ に削除されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម៉ាស៊ីន Cloud ត្រូវបានរក្សាទុក។ វាផ្អាកនៅពេលទំនេរ ហើយអ្នកអាចបន្តវាពីរបារចំហៀង។ ប្រសិនបើវានៅតែផ្អាក វានឹងត្រូវលុបនៅ %@។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud 머신은 유지됩니다. 유휴 상태가 되면 일시 정지되며 사이드바에서 다시 시작할 수 있습니다. 일시 정지 상태로 남아 있으면 %@에 삭제됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-maskinen beholdes. Den settes på pause når den er inaktiv, og du kan gjenoppta den fra sidepanelet. Hvis den forblir på pause, slettes den %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maszyna Cloud zostaje zachowana. Wstrzymuje się, gdy jest bezczynna, a możesz ją wznowić z paska bocznego. Jeśli pozostanie wstrzymana, zostanie usunięta %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A máquina do Cloud é mantida. Ela pausa quando fica ociosa, e você pode retomá-la pela barra lateral. Se continuar pausada, ela será excluída em %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Машина Cloud сохраняется. Она приостанавливается при бездействии, и её можно возобновить на боковой панели. Если она останется приостановленной, она будет удалена %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบบจะเก็บเครื่อง Cloud ไว้ เครื่องจะหยุดชั่วคราวเมื่อไม่มีการใช้งาน และคุณสามารถใช้งานต่อได้จากแถบด้านข้าง หากยังหยุดชั่วคราวอยู่ จะถูกลบในวันที่ %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud makinesi korunur. Boşta kaldığında duraklar ve kenar çubuğundan devam ettirebilirsiniz. Duraklatılmış kalırsa %@ tarihinde silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Машину Cloud збережено. Вона призупиняється під час бездіяльності, і її можна відновити на бічній панелі. Якщо вона залишиться призупиненою, її буде видалено %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Cloud được giữ lại. Máy sẽ tạm dừng khi không hoạt động và bạn có thể tiếp tục nó từ thanh bên. Nếu vẫn tạm dừng, máy sẽ bị xóa vào %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud 机器会保留。它在空闲时暂停，你可以从侧边栏恢复它。如果它一直处于暂停状态，将于 %@ 删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud 機器會保留。它在閒置時暫停，你可以從側邊欄恢復它。如果它一直處於暫停狀態，將於 %@ 刪除。"
          }
        }
      }
    },
    "cloud.network.firewallNotOnThisCloudYet": {
      "comment": "A Cloud firewall action: cmux-platform serves no firewall rules yet, so the action is unavailable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Firewall rules aren't available on this Cloud yet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قواعد جدار الحماية غير متاحة على هذه السحابة بعد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravila zaštitnog zida još nisu dostupna na ovom Cloudu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Firewallregler er ikke tilgængelige på denne Cloud endnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Firewall-Regeln sind in dieser Cloud noch nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas de firewall aún no están disponibles en esta nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles de pare-feu ne sont pas encore disponibles sur ce Cloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regole firewall non sono ancora disponibili su questo Cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイアウォールルールはこの Cloud ではまだ利用できません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ច្បាប់ជញ្ជាំងភ្លើង មិនទាន់មាននៅលើ Cloud នេះនៅឡើយទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방화벽 규칙은 아직 이 Cloud에서 사용할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brannmurregler er ikke tilgjengelige på denne Cloud ennå."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reguły zapory nie są jeszcze dostępne w tej chmurze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Regras de firewall ainda não estão disponíveis nesta nuvem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила брандмауэра пока недоступны в этом облаке."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กฎไฟร์วอลล์ยังไม่พร้อมใช้งานบน Cloud นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik duvarı kuralları bu Cloud'da henüz kullanılamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила брандмауера поки що недоступні в цій хмарі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quy tắc tường lửa chưa có trên Cloud này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Cloud 尚不支持防火墙规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Cloud 尚不支援防火牆規則。"
          }
        }
      }
    },
    "cloud.cli.noSuchMachineWorkspace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Machine `%1$@` has no workspace `%2$@`. `cmux cloud new-terminal-on-machine --target machine:%1$@` makes one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシン `%1$@` にワークスペース `%2$@` はありません。`cmux cloud new-terminal-on-machine --target machine:%1$@` で作成できます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي الجهاز `%1$@` على مساحة العمل `%2$@`. ينشئ ‎`cmux cloud new-terminal-on-machine --target machine:%1$@`‎ واحدة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mašina `%1$@` nema radni prostor `%2$@`. `cmux cloud new-terminal-on-machine --target machine:%1$@` pravi jedan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Maskinen `%1$@` har intet arbejdsområde `%2$@`. `cmux cloud new-terminal-on-machine --target machine:%1$@` opretter et."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Maschine `%1$@` hat keinen Arbeitsbereich `%2$@`. `cmux cloud new-terminal-on-machine --target machine:%1$@` erstellt einen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La máquina `%1$@` no tiene el espacio de trabajo `%2$@`. `cmux cloud new-terminal-on-machine --target machine:%1$@` crea uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La machine `%1$@` n’a pas d’espace de travail `%2$@`. `cmux cloud new-terminal-on-machine --target machine:%1$@` en crée un."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La macchina `%1$@` non ha lo spazio di lavoro `%2$@`. `cmux cloud new-terminal-on-machine --target machine:%1$@` ne crea uno."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម៉ាស៊ីន `%1$@` គ្មានកន្លែងធ្វើការ `%2$@` ទេ។ `cmux cloud new-terminal-on-machine --target machine:%1$@` បង្កើតមួយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머신 `%1$@`에 워크스페이스 `%2$@`이(가) 없습니다. `cmux cloud new-terminal-on-machine --target machine:%1$@`로 만드세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Maskinen `%1$@` har ikke arbeidsområdet `%2$@`. `cmux cloud new-terminal-on-machine --target machine:%1$@` lager et."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maszyna `%1$@` nie ma obszaru roboczego `%2$@`. `cmux cloud new-terminal-on-machine --target machine:%1$@` tworzy nowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A máquina `%1$@` não tem o espaço de trabalho `%2$@`. `cmux cloud new-terminal-on-machine --target machine:%1$@` cria um."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На машине `%1$@` нет рабочего пространства `%2$@`. `cmux cloud new-terminal-on-machine --target machine:%1$@` создаёт его."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่อง `%1$@` ไม่มีเวิร์กสเปซ `%2$@` ใช้ `cmux cloud new-terminal-on-machine --target machine:%1$@` เพื่อสร้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "`%1$@` makinesinde `%2$@` çalışma alanı yok. `cmux cloud new-terminal-on-machine --target machine:%1$@` bir tane oluşturur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На машині `%1$@` немає робочого простору `%2$@`. `cmux cloud new-terminal-on-machine --target machine:%1$@` створює його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy `%1$@` không có không gian làm việc `%2$@`. `cmux cloud new-terminal-on-machine --target machine:%1$@` sẽ tạo một cái."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机器 `%1$@` 没有工作区 `%2$@`。运行 `cmux cloud new-terminal-on-machine --target machine:%1$@` 新建一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "機器 `%1$@` 沒有工作區 `%2$@`。執行 `cmux cloud new-terminal-on-machine --target machine:%1$@` 新增一個。"
          }
        }
      }
    },
    "cloud.cli.secretNamesInvalid": {
      "comment": "cmux cloud deliver-secrets --names that is not a list of secret names. %@ is what was passed. Keep --names as is.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "--names %@ is not a comma-separated list of secret names (letters, digits and _)."}},
        "ja": {"stringUnit": {"state": "translated", "value": "--names %@ はシークレット名（英字、数字、_）のカンマ区切りリストではありません。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "--names %@ ist keine kommagetrennte Liste von Geheimnisnamen (Buchstaben, Ziffern und _)."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "--names %@ n’est pas une liste de noms de secrets séparés par des virgules (lettres, chiffres et _)."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "--names %@ no es una lista de nombres de secretos separados por comas (letras, dígitos y _)."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "--names %@ ليست قائمة بأسماء أسرار مفصولة بفواصل (أحرف وأرقام و_)."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "--names %@는 쉼표로 구분된 비밀 이름 목록(문자, 숫자, _)이 아닙니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "--names %@ 不是以逗号分隔的机密名称列表（字母、数字和 _）。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "--names %@ 不是以逗號分隔的機密名稱清單（字母、數字和 _）。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "--names %@ nije lista imena tajni odvojenih zarezom (slova, cifre i _)."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "--names %@ er ikke en kommasepareret liste over hemmelighedsnavne (bogstaver, cifre og _)."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "--names %@ non è un elenco di nomi di segreti separati da virgole (lettere, cifre e _)."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "--names %@ មិនមែនជាបញ្ជីឈ្មោះអាថ៌កំបាំងដែលបំបែកដោយក្បៀស (អក្សរ លេខ និង _) ទេ។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "--names %@ er ikke en kommaseparert liste over hemmelighetsnavn (bokstaver, sifre og _)."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "--names %@ nie jest listą nazw sekretów oddzielonych przecinkami (litery, cyfry i _)."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "--names %@ não é uma lista de nomes de segredos separados por vírgula (letras, dígitos e _)."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "--names %@ — не список имён секретов через запятую (буквы, цифры и _)."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "--names %@ ไม่ใช่รายการชื่อความลับที่คั่นด้วยจุลภาค (ตัวอักษร ตัวเลข และ _)"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "--names %@ virgülle ayrılmış bir sır adları listesi değil (harfler, rakamlar ve _)."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "--names %@ — не список імен секретів через кому (літери, цифри та _)."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "--names %@ không phải danh sách tên bí mật phân cách bằng dấu phẩy (chữ cái, chữ số và _)."}}
      }
    },
    "cloud.cli.machineConfigNotApplied": {
      "comment": "cmux cloud deliver-secrets before the machine finished any machine config apply. Keep the command names as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This machine has no finished machine config yet. Run cmux cloud apply-machine-config first, then deliver the secrets."}},
        "ja": {"stringUnit": {"state": "translated", "value": "このマシンにはまだ完了したマシン構成がありません。先に cmux cloud apply-machine-config を実行してから、シークレットを配信してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Diese Maschine hat noch keine abgeschlossene Maschinenkonfiguration. Führe zuerst cmux cloud apply-machine-config aus und übermittle dann die Geheimnisse."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Cette machine n’a pas encore de configuration de machine terminée. Lancez d’abord cmux cloud apply-machine-config, puis transmettez les secrets."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Esta máquina aún no tiene una configuración de máquina terminada. Ejecuta primero cmux cloud apply-machine-config y luego entrega los secretos."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "ليس لهذا الجهاز إعداد جهاز مكتمل بعد. شغّل cmux cloud apply-machine-config أولًا، ثم سلّم الأسرار."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "이 머신에는 아직 완료된 머신 구성이 없습니다. 먼저 cmux cloud apply-machine-config를 실행한 다음 비밀을 전달하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "这台机器还没有完成的机器配置。请先运行 cmux cloud apply-machine-config，再送达机密。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "這台機器還沒有完成的機器設定。請先執行 cmux cloud apply-machine-config，再送達機密。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Ova mašina još nema završenu konfiguraciju. Prvo pokrenite cmux cloud apply-machine-config, a zatim isporučite tajne."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Denne maskine har endnu ingen færdig maskinkonfiguration. Kør først cmux cloud apply-machine-config, og lever derefter hemmelighederne."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Questa macchina non ha ancora una configurazione completata. Esegui prima cmux cloud apply-machine-config, poi consegna i segreti."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ម៉ាស៊ីននេះមិនទាន់មានការកំណត់ម៉ាស៊ីនដែលបានបញ្ចប់ទេ។ ដំណើរការ cmux cloud apply-machine-config ជាមុនសិន រួចបញ្ជូនអាថ៌កំបាំង។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Denne maskinen har ingen ferdig maskinkonfigurasjon ennå. Kjør cmux cloud apply-machine-config først, og lever deretter hemmelighetene."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Ta maszyna nie ma jeszcze zakończonej konfiguracji. Najpierw uruchom cmux cloud apply-machine-config, a potem dostarcz sekrety."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Esta máquina ainda não tem uma configuração concluída. Execute primeiro cmux cloud apply-machine-config e depois entregue os segredos."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "У этой машины ещё нет завершённой конфигурации. Сначала выполните cmux cloud apply-machine-config, затем доставьте секреты."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เครื่องนี้ยังไม่มีการกำหนดค่าเครื่องที่เสร็จสมบูรณ์ เรียกใช้ cmux cloud apply-machine-config ก่อน แล้วจึงส่งความลับ"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Bu makinenin henüz tamamlanmış bir makine yapılandırması yok. Önce cmux cloud apply-machine-config çalıştırın, ardından sırları teslim edin."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Ця машина ще не має завершеної конфігурації. Спочатку виконайте cmux cloud apply-machine-config, а потім доставте секрети."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Máy này chưa có cấu hình máy hoàn tất. Hãy chạy cmux cloud apply-machine-config trước, rồi gửi bí mật."}}
      }
    },
    "cloud.desktop.unavailable": {
