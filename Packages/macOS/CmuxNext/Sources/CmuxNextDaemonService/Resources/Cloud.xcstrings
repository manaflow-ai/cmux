    "cloud.failed.publicKeyRequired": {
      "comment": "Prepare Cloud File Transfer or Rotate Tunnel Key without a key. --public-key and the $(cat …) shell text are literal; keep them as is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass an Ed25519 SSH public key with --public-key \"$(cat ~/.ssh/id_ed25519.pub)\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ed25519 SSH 公開鍵を --public-key \"$(cat ~/.ssh/id_ed25519.pub)\" で指定してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مرّر مفتاح SSH عامًا من نوع Ed25519 باستخدام --public-key \"$(cat ~/.ssh/id_ed25519.pub)\"."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Proslijedite Ed25519 SSH javni ključ pomoću --public-key \"$(cat ~/.ssh/id_ed25519.pub)\"."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Angiv en offentlig Ed25519-SSH-nøgle med --public-key \"$(cat ~/.ssh/id_ed25519.pub)\"."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Übergib einen öffentlichen Ed25519-SSH-Schlüssel mit --public-key \"$(cat ~/.ssh/id_ed25519.pub)\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Indica una clave pública SSH Ed25519 con --public-key \"$(cat ~/.ssh/id_ed25519.pub)\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Indiquez une clé publique SSH Ed25519 avec --public-key \"$(cat ~/.ssh/id_ed25519.pub)\"."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Passa una chiave pubblica SSH Ed25519 con --public-key \"$(cat ~/.ssh/id_ed25519.pub)\"."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បញ្ជូនសោសាធារណៈ SSH ប្រភេទ Ed25519 ដោយប្រើ --public-key \"$(cat ~/.ssh/id_ed25519.pub)\"។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ed25519 SSH 공개 키를 --public-key \"$(cat ~/.ssh/id_ed25519.pub)\"로 지정하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oppgi en offentlig Ed25519-SSH-nøkkel med --public-key \"$(cat ~/.ssh/id_ed25519.pub)\"."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Podaj publiczny klucz SSH Ed25519 za pomocą --public-key \"$(cat ~/.ssh/id_ed25519.pub)\"."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Passe uma chave pública SSH Ed25519 com --public-key \"$(cat ~/.ssh/id_ed25519.pub)\"."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Укажите открытый SSH-ключ Ed25519 через --public-key \"$(cat ~/.ssh/id_ed25519.pub)\"."
          }
        },
        "th": {
          "stringUnit": {
