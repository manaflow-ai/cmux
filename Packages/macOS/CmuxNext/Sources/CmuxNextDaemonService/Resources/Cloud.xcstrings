          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ця збірка не має бекенду Cloud. Перезберіть її командою ./scripts/reload.sh --tag <tag> --direct-backend."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
