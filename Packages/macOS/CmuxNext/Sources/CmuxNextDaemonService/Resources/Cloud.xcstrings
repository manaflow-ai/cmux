        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este espacio de trabajo se abrió en este Mac, no en Cloud. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cet espace de travail s’est ouvert sur ce Mac, pas dans Cloud. %@"
