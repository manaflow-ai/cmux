        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 기록을 거부했습니다 (자세한 내용은 로그에 있습니다)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux avviste oppføringen (detaljer står i loggen)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux odrzucił jego wpis (szczegóły są w dzienniku)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "o cmux recusou o registro (detalhes no log)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux отклонил его запись (подробности в журнале)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ปฏิเสธข้อมูลของเครื่องนี้ (รายละเอียดอยู่ในล็อก)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux kaydını reddetti (ayrıntılar günlükte)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux відхилив його запис (подробиці в журналі)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux đã từ chối bản ghi của nó (chi tiết có trong nhật ký)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 拒绝了它的记录（详情见日志）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 拒絕了它的記錄（詳情見記錄檔）"
          }
        }
