    "sessionRegistration.notSaved": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم حفظ %1$@ للاستعادة: %2$@"
          }
        },
