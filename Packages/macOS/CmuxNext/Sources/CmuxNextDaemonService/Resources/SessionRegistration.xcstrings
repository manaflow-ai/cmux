            "value": "%1$@ blev ikke gemt til gendannelse: %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wurde nicht zur Wiederherstellung gespeichert: %2$@"
          }
        },
        "en": {
          "stringUnit": {
