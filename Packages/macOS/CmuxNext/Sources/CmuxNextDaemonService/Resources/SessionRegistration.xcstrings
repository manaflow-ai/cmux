    "sessionRegistration.reason.noAnswer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يستجب cmux (التفاصيل في السجل)"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nije odgovorio (detalji su u dnevniku)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux svarede ikke (detaljer står i loggen)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux hat nicht geantwortet (Details im Protokoll)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux did not answer (details are in the log)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no respondió (los detalles están en el log)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux n’a pas répondu (détails dans le journal)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux non ha risposto (dettagli nel log)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux が応答しませんでした (詳細はログにあります)"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux មិនបានឆ្លើយតបទេ (ព័ត៌មានលម្អិតមាននៅក្នុងកំណត់ហេតុ)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 응답하지 않았습니다 (자세한 내용은 로그에 있습니다)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux svarte ikke (detaljer står i loggen)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nie odpowiedział (szczegóły są w dzienniku)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "o cmux não respondeu (detalhes no log)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux не ответил (подробности в журнале)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ไม่ตอบสนอง (รายละเอียดอยู่ในล็อก)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux yanıt vermedi (ayrıntılar günlükte)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux не відповів (подробиці в журналі)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux không phản hồi (chi tiết có trong nhật ký)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 没有响应（详情见日志）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 沒有回應（詳情見記錄檔）"
          }
        }
      }
    },
    "sessionRegistration.reason.refused": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض cmux بياناته (التفاصيل في السجل)"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux je odbio njegov zapis (detalji su u dnevniku)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux afviste dens post (detaljer står i loggen)"
          }
