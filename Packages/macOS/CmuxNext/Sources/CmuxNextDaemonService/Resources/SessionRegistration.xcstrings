        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux a refusé son enregistrement (détails dans le journal)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ha rifiutato il suo record (dettagli nel log)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux がその記録を拒否しました (詳細はログにあります)"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux បានបដិសេធកំណត់ត្រារបស់វា (ព័ត៌មានលម្អិតមាននៅក្នុងកំណត់ហេតុ)"
