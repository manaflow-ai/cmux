{
  "sourceLanguage": "en",
  "strings": {
    "agentShare.notThisMac": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a chat on this Mac can be shared."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ein Chat auf diesem Mac kann geteilt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule une conversation sur ce Mac peut être partagée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن مشاركة سوى دردشة على هذا الـ Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se puede compartir un chat de este Mac."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只能分享這台 Mac 上的聊天。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能共享这台 Mac 上的聊天。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 채팅만 공유할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有できるのはこの Mac 上のチャットだけです。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Može se podijeliti samo chat na ovom Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun en chat på denne Mac kan deles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si può condividere solo una chat su questo Mac."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អាចចែករំលែកបានតែការជជែកនៅលើ Mac នេះ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare en chat på denne Macen kan deles."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnić można tylko czat na tym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só é possível compartilhar um chat deste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поделиться можно только чатом на этом Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชร์ได้เฉพาะแชตบน Mac เครื่องนี้เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu Mac'teki bir sohbet paylaşılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поділитися можна лише чатом на цьому Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ có thể chia sẻ cuộc trò chuyện trên máy Mac này."
          }
        }
      }
    },
    "agentShare.badSurface": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "--surface takes a surface number."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "--surface erwartet eine Surface-Nummer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "--surface attend un numéro de surface."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب ‎--surface رقم سطح."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "--surface espera un número de superficie."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "--surface 需要一個表面編號。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "--surface 需要一个表面编号。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "--surface에는 서피스 번호가 필요합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "--surface にはサーフェス番号を指定します。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "--surface prima broj površine."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "--surface skal have et overfladenummer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "--surface richiede un numero di superficie."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "--surface ត្រូវការលេខផ្ទៃ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "--surface tar et overflatenummer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "--surface przyjmuje numer powierzchni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "--surface recebe um número de superfície."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "--surface принимает номер поверхности."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "--surface ต้องใช้หมายเลขพื้นผิว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "--surface bir yüzey numarası alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "--surface приймає номер поверхні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "--surface cần một số bề mặt."
          }
        }
      }
    },
    "agentShare.surfaceAndTarget": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name the chat with --surface or with a tab target, not both."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den Chat mit --surface oder mit einem Tab-Ziel an, nicht mit beidem."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désignez la conversation avec --surface ou avec une cible d’onglet, pas les deux."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّد الدردشة باستخدام ‎--surface أو بهدف علامة تبويب، وليس كليهما."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica el chat con --surface o con un destino de pestaña, no con ambos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請用 --surface 或分頁目標指定聊天，不要同時使用。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请用 --surface 或标签页目标指定聊天，不要同时使用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "--surface 또는 탭 대상 중 하나로만 채팅을 지정하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットは --surface かタブのターゲットのどちらか一方で指定してください。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Navedi chat pomoću --surface ili cilja kartice, ne oboje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv chatten med --surface eller med et fanemål, ikke begge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica la chat con --surface o con una scheda di destinazione, non con entrambi."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កំណត់ការជជែកដោយ --surface ឬដោយគោលដៅផ្ទាំង មិនមែនទាំងពីរទេ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angi chatten med --surface eller med et fanemål, ikke begge."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskaż czat przez --surface albo przez kartę docelową, nie oba naraz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique o chat com --surface ou com uma aba de destino, não com os dois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите чат через --surface или через вкладку, но не оба сразу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบุแชตด้วย --surface หรือด้วยแท็บเป้าหมาย อย่างใดอย่างหนึ่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbeti --surface ile ya da bir sekme hedefiyle belirtin, ikisiyle birden değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкажіть чат через --surface або через вкладку, але не обидва."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ định cuộc trò chuyện bằng --surface hoặc bằng thẻ đích, không dùng cả hai."
          }
        }
      }
    },
    "agentShare.badUses": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "--uses takes a number from 1 to 8."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "--uses erwartet eine Zahl von 1 bis 8."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "--uses attend un nombre de 1 à 8."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب ‎--uses رقمًا من 1 إلى 8."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "--uses espera un número del 1 al 8."
          }
        },
        "zh-Hant": {
