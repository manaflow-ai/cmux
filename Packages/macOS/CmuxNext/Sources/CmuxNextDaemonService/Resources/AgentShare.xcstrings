{
  "sourceLanguage": "en",
  "strings": {
    "agentShare.notAChat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a started agent chat can be shared."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ein gestarteter Agent-Chat kann geteilt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule une conversation d’agent démarrée peut être partagée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن مشاركة سوى دردشة وكيل بدأت."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se puede compartir un chat de agente iniciado."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只能分享已開始的代理聊天。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能共享已开始的智能体聊天。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작된 에이전트 채팅만 공유할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有できるのは開始済みのエージェントチャットだけです。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Može se podijeliti samo pokrenuti chat s agentom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun en startet agentchat kan deles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si può condividere solo una chat con l’agente già avviata."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អាចចែករំលែកបានតែការជជែកភ្នាក់ងារដែលបានចាប់ផ្តើម។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare en startet agentchat kan deles."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnić można tylko rozpoczęty czat z agentem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só é possível compartilhar um chat de agente iniciado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поделиться можно только начатым чатом с агентом."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชร์ได้เฉพาะแชตเอเจนต์ที่เริ่มแล้วเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca başlatılmış bir ajan sohbeti paylaşılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поділитися можна лише розпочатим чатом з агентом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ có thể chia sẻ cuộc trò chuyện với tác tử đã bắt đầu."
          }
        }
      }
    },
    "agentShare.noSurface": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No agent chat is on surface %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Oberfläche %lld ist kein Agent-Chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune conversation d’agent sur la surface %lld."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد دردشة وكيل على السطح %lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún chat de agente en la superficie %lld."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "表面 %lld 上沒有代理聊天。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "界面 %lld 上没有智能体聊天。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서피스 %lld에 에이전트 채팅이 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーフェス %lld にエージェントチャットはありません。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na površini %lld nema chata s agentom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ingen agentchat på overflade %lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna chat con l’agente sulla superficie %lld."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានការជជែកភ្នាក់ងារនៅលើផ្ទៃ %lld ទេ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen agentchat på overflate %lld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na powierzchni %lld nie ma czatu z agentem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há chat de agente na superfície %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На поверхности %lld нет чата с агентом."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีแชตเอเจนต์บนพื้นผิว %lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld yüzeyinde ajan sohbeti yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На поверхні %lld немає чату з агентом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có cuộc trò chuyện với tác tử trên bề mặt %lld."
          }
        }
      }
    },
    "agentShare.badTTL": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A link lasts from 1 minute to 7 days: give seconds, or a number with m, h or d (24h)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Link gilt 1 Minute bis 7 Tage: Sekunden angeben oder eine Zahl mit m, h oder d (24h)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lien dure de 1 minute à 7 jours : indiquez des secondes, ou un nombre suivi de m, h ou d (24h)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدوم الرابط من دقيقة واحدة إلى 7 أيام: أدخل ثوانيَ، أو رقمًا متبوعًا بـ m أو h أو d (24h)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enlace dura de 1 minuto a 7 días: indica segundos, o un número con m, h o d (24h)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結有效期為 1 分鐘至 7 天：請輸入秒數，或數字加上 m、h 或 d（24h）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接有效期为 1 分钟至 7 天：请输入秒数，或数字加 m、h 或 d（24h）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크는 1분에서 7일까지 유지됩니다. 초 단위로 입력하거나 숫자 뒤에 m, h 또는 d를 붙이세요(24h)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクの有効期間は 1 分から 7 日です。秒数、または m・h・d を付けた数値で指定してください（24h）。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Link traje od 1 minute do 7 dana: unesite sekunde ili broj s m, h ili d (24h)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et link varer fra 1 minut til 7 dage: angiv sekunder eller et tal med m, h eller d (24h)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un link dura da 1 minuto a 7 giorni: indica i secondi, o un numero con m, h o d (24h)."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "តំណមានសុពលភាពពី 1 នាទីដល់ 7 ថ្ងៃ៖ បញ្ចូលវិនាទី ឬលេខជាមួយ m, h ឬ d (24h)។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En lenke varer fra 1 minutt til 7 dager: oppgi sekunder, eller et tall med m, h eller d (24h)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Link działa od 1 minuty do 7 dni: podaj sekundy albo liczbę z m, h lub d (24h)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um link dura de 1 minuto a 7 dias: informe segundos, ou um número com m, h ou d (24h)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка действует от 1 минуты до 7 дней: укажите секунды или число с m, h или d (24h)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์มีอายุ 1 นาทีถึง 7 วัน: ใส่เป็นวินาที หรือตัวเลขตามด้วย m, h หรือ d (24h)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bağlantı 1 dakika ile 7 gün arası geçerlidir: saniye ya da m, h veya d ile bir sayı girin (24h)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посилання діє від 1 хвилини до 7 днів: вкажіть секунди або число з m, h чи d (24h)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết có hiệu lực từ 1 phút đến 7 ngày: nhập số giây, hoặc một số kèm m, h hoặc d (24h)."
          }
        }
      }
    },
