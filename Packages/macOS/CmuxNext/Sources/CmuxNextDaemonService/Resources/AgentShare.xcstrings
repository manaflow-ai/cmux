          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj ID udostępnienia linku (pokazuje je cmux share list)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe o ID do compartilhamento do link (cmux share list mostra)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите ID ссылки (его показывает cmux share list)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบุรหัสการแชร์ของลิงก์ (cmux share list จะแสดงให้)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantının paylaşım kimliğini belirtin (cmux share list gösterir)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкажіть ID посилання (його показує cmux share list)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy nêu ID chia sẻ của liên kết (cmux share list hiển thị ID này)."
          }
        }
      }
    },
