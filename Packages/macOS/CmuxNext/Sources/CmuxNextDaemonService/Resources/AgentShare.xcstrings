    "agentShare.copied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guest link copied. It works once and expires in 24 hours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastlink kopiert. Er funktioniert einmal und läuft in 24 Stunden ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lien d’invité copié. Il fonctionne une fois et expire dans 24 heures."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم نسخ رابط الضيف. يعمل مرة واحدة وتنتهي صلاحيته خلال 24 ساعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enlace de invitado copiado. Funciona una vez y caduca en 24 horas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已拷貝訪客連結。此連結只能使用一次，並於 24 小時後失效。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已复制访客链接。此链接只能使用一次，24 小时后失效。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게스트 링크를 복사했습니다. 한 번만 사용할 수 있으며 24시간 후 만료됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲストリンクをコピーしました。1 回だけ使え、24 時間で期限切れになります。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
