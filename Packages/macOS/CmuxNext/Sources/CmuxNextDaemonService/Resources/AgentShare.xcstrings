    "agentShare.consent.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share “%@” with a guest?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ mit einem Gast teilen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partager « %@ » avec un invité ?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد مشاركة “%@” مع ضيف؟"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Compartir «%@» con un invitado?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要與訪客分享「%@」嗎？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要与访客共享“%@”吗？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’을(를) 게스트와 공유할까요?"
          }
        },
