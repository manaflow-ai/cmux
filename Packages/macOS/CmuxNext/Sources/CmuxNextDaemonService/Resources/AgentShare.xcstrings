          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "--uses 1 ile 8 arasında bir sayı alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "--uses приймає число від 1 до 8."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "--uses cần một số từ 1 đến 8."
          }
        }
      }
    },
    "agentShare.chatMoved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That surface shows another chat now. Name the chat again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Surface zeigt jetzt einen anderen Chat. Gib den Chat erneut an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette surface affiche maintenant une autre conversation. Désignez-la à nouveau."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض هذا السطح دردشة أخرى الآن. حدّد الدردشة مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa superficie muestra ahora otro chat. Vuelve a indicar el chat."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該表面現在顯示另一個聊天。請重新指定聊天。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该表面现在显示另一个聊天。请重新指定聊天。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 서피스에 이제 다른 채팅이 표시됩니다. 채팅을 다시 지정하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのサーフェスには別のチャットが表示されています。チャットをもう一度指定してください。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta površina sada prikazuje drugi chat. Ponovo navedi chat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den overflade viser nu en anden chat. Angiv chatten igen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quella superficie ora mostra un’altra chat. Indica di nuovo la chat."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្ទៃនោះកំពុងបង្ហាញការជជែកផ្សេងឥឡូវនេះ។ កំណត់ការជជែកម្តងទៀត។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den overflaten viser en annen chat nå. Angi chatten på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta powierzchnia pokazuje teraz inny czat. Wskaż czat ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa superfície agora mostra outro chat. Indique o chat de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта поверхность теперь показывает другой чат. Укажите чат снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นผิวนั้นแสดงแชตอื่นอยู่ตอนนี้ ระบุแชตอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yüzey artık başka bir sohbet gösteriyor. Sohbeti yeniden belirtin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця поверхня тепер показує інший чат. Вкажіть чат знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bề mặt đó hiện đang hiển thị một cuộc trò chuyện khác. Hãy chỉ định lại cuộc trò chuyện."
          }
        }
      }
    },
    "agentShare.timedOut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The share service didn’t answer in time, so no link was made. Try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Freigabedienst hat nicht rechtzeitig geantwortet, daher wurde kein Link erstellt. Versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service de partage n’a pas répondu à temps, aucun lien n’a donc été créé. Réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تستجب خدمة المشاركة في الوقت المناسب، لذا لم يُنشأ أي رابط. حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de uso compartido no respondió a tiempo, así que no se creó ningún enlace. Vuelve a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享服務未及時回應，因此未建立連結。請再試一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享服务未及时响应，因此未创建链接。请重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 서비스가 제때 응답하지 않아 링크가 만들어지지 않았습니다. 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有サービスが時間内に応答しなかったため、リンクは作成されませんでした。もう一度お試しください。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Usluga dijeljenja nije odgovorila na vrijeme, pa link nije napravljen. Pokušaj ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Delingstjenesten svarede ikke i tide, så der blev ikke oprettet et link. Prøv igen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio di condivisione non ha risposto in tempo, quindi non è stato creato alcun link. Riprova."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សេវាចែករំលែកមិនបានឆ្លើយតបទាន់ពេល ដូច្នេះមិនបានបង្កើតតំណទេ។ សូមព្យាយាមម្តងទៀត។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Delingstjenesten svarte ikke i tide, så ingen lenke ble laget. Prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usługa udostępniania nie odpowiedziała na czas, więc link nie został utworzony. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de compartilhamento não respondeu a tempo, então nenhum link foi criado. Tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервис общего доступа не ответил вовремя, поэтому ссылка не создана. Попробуйте ещё раз."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บริการแชร์ไม่ตอบกลับทันเวลา จึงไม่ได้สร้างลิงก์ ลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşım hizmeti zamanında yanıt vermedi, bu yüzden bağlantı oluşturulmadı. Yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервіс спільного доступу не відповів вчасно, тож посилання не створено. Спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch vụ chia sẻ không phản hồi kịp, nên chưa có liên kết nào được tạo. Hãy thử lại."
          }
        }
      }
    },
    "agentShare.notAChat": {
