{
  "sourceLanguage": "en",
  "strings": {
    "git.noFolder": {
      "comment": "Palette git worktree and checkpoint results and refusals; keep paths and commands exactly",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يحتوي علامة التبويب هذه على مجلد على هذا الجهاز. ركّز على طرفية داخل المستودع، ثم حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ova kartica nema mapu na ovom računaru. Fokusirajte terminal u repozitoriju, pa pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne fane har ingen mappe på denne maskine. Fokusér en terminal i repositoriet, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Tab hat keinen Ordner auf diesem Gerät. Fokussiere ein Terminal im Repository und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tab has no folder on this machine. Focus a terminal in the repository, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta pestaña no tiene carpeta en esta máquina. Enfoca una terminal del repositorio y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cet onglet n’a aucun dossier sur cette machine. Activez un terminal dans le dépôt, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questa scheda non ha una cartella su questa macchina. Metti a fuoco un terminale nel repository, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このタブにはこのマシン上のフォルダがありません。リポジトリ内のターミナルにフォーカスしてから、もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទាំងនេះគ្មានថតនៅលើម៉ាស៊ីននេះទេ។ ផ្តោតលើ terminal មួយក្នុង repository រួចសាកល្បងម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 탭에는 이 기기의 폴더가 없습니다. 저장소 안의 터미널에 포커스를 둔 다음 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne fanen har ingen mappe på denne maskinen. Fokuser en terminal i repositoriet, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ta karta nie ma folderu na tym komputerze. Ustaw fokus na terminalu w repozytorium i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta aba não tem pasta nesta máquina. Foque um terminal no repositório e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У этой вкладки нет папки на этом компьютере. Перейдите в терминал внутри репозитория и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แท็บนี้ไม่มีโฟลเดอร์บนเครื่องนี้ โฟกัสเทอร์มินัลในรีโพสิทอรี แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu sekmenin bu makinede klasörü yok. Depodaki bir terminale odaklanın ve yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ця вкладка не має теки на цьому комп’ютері. Перейдіть у термінал у репозиторії й спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thẻ này không có thư mục trên máy này. Hãy chọn một terminal trong kho mã rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此标签页在这台机器上没有文件夹。请聚焦仓库中的终端，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此分頁在這台機器上沒有資料夾。請聚焦儲存庫中的終端機，然後再試一次。"
          }
        }
      }
    },
    "git.thisMacOnly": {
      "comment": "Palette git worktree and checkpoint results and refusals; keep paths and commands exactly",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُنشأ أشجار عمل Git وتُزال على هذا الـ Mac فقط، وهذه العلامة على جهاز آخر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Git radna stabla se prave i uklanjaju samo na ovom Macu, a ova kartica je na drugom računaru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Git-arbejdstræer oprettes og fjernes kun på denne Mac, og denne fane er på en anden maskine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Git-Worktrees werden nur auf diesem Mac erstellt und entfernt, und dieser Tab ist auf einem anderen Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Git worktrees are made and removed only on this Mac, and this tab is on another machine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los worktrees de Git solo se crean y quitan en este Mac, y esta pestaña está en otra máquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les worktrees Git ne sont créés et supprimés que sur ce Mac, et cet onglet est sur une autre machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I worktree Git si creano e rimuovono solo su questo Mac, e questa scheda è su un’altra macchina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Git ワークツリーはこの Mac でのみ作成・削除できますが、このタブは別のマシンにあります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Git worktree ត្រូវបានបង្កើត និងលុបតែនៅលើ Mac នេះប៉ុណ្ណោះ ហើយផ្ទាំងនេះនៅលើម៉ាស៊ីនផ្សេង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Git 워크트리는 이 Mac에서만 만들고 제거할 수 있는데, 이 탭은 다른 기기에 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Git-arbeidstrær opprettes og fjernes bare på denne Macen, og denne fanen er på en annen maskin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Drzewa robocze Git są tworzone i usuwane tylko na tym Macu, a ta karta jest na innym komputerze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Worktrees do Git são criadas e removidas só neste Mac, e esta aba está em outra máquina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Рабочие деревья Git создаются и удаляются только на этом Mac, а эта вкладка на другом компьютере."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Git worktree สร้างและลบได้เฉพาะบน Mac เครื่องนี้ และแท็บนี้อยู่บนเครื่องอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Git çalışma ağaçları yalnızca bu Mac’te oluşturulup kaldırılır ve bu sekme başka bir makinede."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Робочі дерева Git створюються й видаляються лише на цьому Mac, а ця вкладка на іншому комп’ютері."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Worktree Git chỉ được tạo và xóa trên máy Mac này, còn thẻ này nằm trên máy khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Git 工作树只能在这台 Mac 上创建和移除，而此标签页位于另一台机器上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Git 工作樹只能在這台 Mac 上建立和移除，而此分頁位於另一台機器上。"
          }
        }
      }
    },
    "git.folderChanged": {
      "comment": "Palette git worktree and checkpoint results and refusals; keep paths and commands exactly",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "انتقلت علامة التبويب هذه إلى مجلد آخر أثناء سؤالك. لم تتم إزالة أي شيء؛ شغّله مرة أخرى من شجرة العمل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ova kartica je prešla u drugu mapu dok ste bili pitani. Ništa nije uklonjeno; pokrenite ponovo iz radnog stabla."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne fane skiftede til en anden mappe, mens du blev spurgt. Intet blev fjernet; kør det igen fra worktree'en."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Tab ist in einen anderen Ordner gewechselt, während du gefragt wurdest. Es wurde nichts entfernt; führe es erneut im Worktree aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tab moved to another folder while you were asked. Nothing was removed; run it again from the worktree."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta pestaña cambió a otra carpeta mientras se te preguntaba. No se eliminó nada; vuelve a ejecutarlo desde el worktree."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cet onglet est passé dans un autre dossier pendant la question. Rien n’a été supprimé ; relancez depuis le worktree."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questa scheda è passata a un’altra cartella mentre ti veniva chiesto. Non è stato rimosso nulla; eseguilo di nuovo dal worktree."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "確認中にこのタブが別のフォルダに移動しました。何も削除されていません。worktree からもう一度実行してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទាំងនេះបានផ្លាស់ទៅថតផ្សេងខណៈពេលដែលអ្នកត្រូវបានសួរ។ គ្មានអ្វីត្រូវបានលុបទេ; សូមដំណើរការម្តងទៀតពី worktree។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "확인하는 동안 이 탭이 다른 폴더로 이동했습니다. 아무것도 제거되지 않았습니다. worktree에서 다시 실행하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne fanen byttet til en annen mappe mens du ble spurt. Ingenting ble fjernet; kjør det igjen fra worktreeen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ta karta przeszła do innego folderu, gdy pojawiło się pytanie. Nic nie zostało usunięte; uruchom ponownie z worktree."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta aba mudou para outra pasta enquanto você era perguntado. Nada foi removido; execute de novo a partir do worktree."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пока вы отвечали, эта вкладка перешла в другую папку. Ничего не удалено; запустите снова из рабочего дерева."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แท็บนี้ย้ายไปยังโฟลเดอร์อื่นระหว่างที่ระบบถามคุณ ไม่มีสิ่งใดถูกลบ เรียกใช้อีกครั้งจาก worktree"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Size sorulurken bu sekme başka bir klasöre geçti. Hiçbir şey kaldırılmadı; worktree içinden yeniden çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Поки вас питали, ця вкладка перейшла до іншої папки. Нічого не видалено; запустіть знову з робочого дерева."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thẻ này đã chuyển sang thư mục khác trong lúc bạn được hỏi. Không có gì bị xóa; hãy chạy lại từ worktree."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在询问期间此标签页切换到了另一个文件夹。未删除任何内容；请在该 worktree 中重新运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在詢問期間此分頁切換到了另一個資料夾。未移除任何內容；請在該 worktree 中重新執行。"
          }
        }
      }
    },
