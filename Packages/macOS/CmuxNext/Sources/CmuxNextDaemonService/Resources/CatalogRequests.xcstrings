{
  "sourceLanguage": "en",
  "strings": {
    "catalogRequest.remote": {
      "comment": "Refusal: a catalog request action run from another device (a phone, another Mac).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يعمل هذا الإجراء من جهاز آخر"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ova radnja se ne pokreće s drugog uređaja"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "denne handling kan ikke køres fra en anden enhed"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "diese Aktion läuft nicht von einem anderen Gerät aus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "this action does not run from another device"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "esta acción no se ejecuta desde otro dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cette action ne s’exécute pas depuis un autre appareil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "questa azione non viene eseguita da un altro dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は別のデバイスからは実行できません"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សកម្មភាពនេះមិនដំណើរការពីឧបករណ៍ផ្សេងទេ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 작업은 다른 기기에서 실행할 수 없습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "denne handlingen kan ikke kjøres fra en annen enhet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "tej czynności nie można uruchomić z innego urządzenia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "esta ação não é executada a partir de outro dispositivo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "это действие нельзя запустить с другого устройства"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การทำงานนี้ไม่สามารถเรียกใช้จากอุปกรณ์อื่นได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "bu eylem başka bir cihazdan çalıştırılamaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "цю дію не можна запустити з іншого пристрою"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "không thể chạy thao tác này từ thiết bị khác"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此操作无法从其他设备运行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此操作無法從其他裝置執行"
          }
        }
      }
    },
    "catalogRequest.notConnected": {
      "comment": "Refusal: a catalog request action whose daemon, app control or acpmux connection is not there.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الخدمة التي يحتاجها هذا الإجراء غير متصلة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "usluga koja je potrebna ovoj radnji nije povezana"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "tjenesten, som denne handling kræver, er ikke forbundet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "der Dienst, den diese Aktion braucht, ist nicht verbunden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the service this action needs is not connected"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "el servicio que necesita esta acción no está conectado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "le service requis par cette action n’est pas connecté"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "il servizio richiesto da questa azione non è connesso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作に必要なサービスに接続されていません"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សេវាដែលសកម្មភាពនេះត្រូវការមិនបានភ្ជាប់ទេ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 작업에 필요한 서비스가 연결되어 있지 않습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "tjenesten denne handlingen trenger, er ikke tilkoblet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "usługa potrzebna tej czynności nie jest połączona"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "o serviço de que esta ação precisa não está conectado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "сервис, нужный для этого действия, не подключён"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "บริการที่การทำงานนี้ต้องใช้ยังไม่ได้เชื่อมต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "bu eylemin ihtiyaç duyduğu hizmet bağlı değil"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "сервіс, потрібний для цієї дії, не під’єднано"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "dịch vụ mà thao tác này cần chưa được kết nối"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此操作所需的服务未连接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此操作所需的服務未連線"
          }
        }
      }
    },
    "catalogRequest.noPane": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click a tab first, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にタブをクリックしてから、もう一度お試しください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "انقر على علامة تبويب أولًا، ثم حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prvo kliknite karticu, pa pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klik først på en fane, og prøv så igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klicke zuerst auf einen Tab und versuche es dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Haz clic primero en una pestaña y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cliquez d’abord sur un onglet, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fai prima clic su una scheda, poi riprova."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ចុចផ្ទាំងមួយជាមុនសិន រួចសាកល្បងម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "먼저 탭을 클릭한 다음 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klikk på en fane først, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Najpierw kliknij kartę, a potem spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clique em uma aba primeiro e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сначала щёлкните вкладку, затем повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คลิกแท็บก่อน แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Önce bir sekmeye tıklayın, sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Спершу клацніть вкладку, потім спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hãy bấm vào một thẻ trước, rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请先点按一个标签页，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請先點按一個分頁，然後再試一次。"
          }
        }
      },
      "comment": "Refusal: a catalog request action that acts on a pane ran with no pane focused or named."
    },
    "catalogRequest.destructiveBody": {
      "comment": "Body of the question a destructive palette action that sends one daemon request asks before it runs; the title is the action's own name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovo se ne može poništiti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dette kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questa operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この操作は取り消せません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សកម្មភាពនេះមិនអាចត្រឡប់វិញបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 작업은 되돌릴 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dette kan ikke angres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tej operacji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta ação não pode ser desfeita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Это действие нельзя отменить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การดำเนินการนี้ไม่สามารถเลิกทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цю дію не можна скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thể hoàn tác thao tác này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此操作無法復原。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
