    "paletteVerb.removeSecretBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُحذف قيمته من سلسلة مفاتيح هذا الـ Mac، ولن تحصل عليه أجهزة Cloud بعد الآن."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Njena vrijednost se briše iz Keychaina ovog Maca i Cloud mašine je više ne dobijaju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Værdien slettes fra denne Macs nøglering, og Cloud-maskiner får den ikke længere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sein Wert wird aus dem Schlüsselbund dieses Macs gelöscht, und Cloud-Maschinen erhalten ihn nicht mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its value is deleted from this Mac's Keychain, and Cloud machines no longer get it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Su valor se elimina del Llavero de este Mac y las máquinas de Cloud dejan de recibirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sa valeur est supprimée du trousseau de ce Mac et les machines Cloud ne la reçoivent plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il suo valore viene eliminato dal Portachiavi di questo Mac e le macchine Cloud non lo ricevono più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "値はこの Mac のキーチェーンから削除され、Cloud マシンには渡されなくなります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "តម្លៃរបស់វាត្រូវបានលុបចេញពី Keychain របស់ Mac នេះ ហើយម៉ាស៊ីន Cloud លែងទទួលបានវាទៀតហើយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "값이 이 Mac의 키체인에서 삭제되며 Cloud 머신은 더 이상 이 값을 받지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verdien slettes fra nøkkelringen på denne Macen, og Cloud-maskiner får den ikke lenger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jego wartość zostanie usunięta z pęku kluczy tego Maca, a maszyny Cloud przestaną ją otrzymywać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O valor é apagado das Chaves deste Mac e as máquinas do Cloud deixam de recebê-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Его значение удаляется из связки ключей этого Mac, и машины Cloud больше его не получают."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ค่าของความลับนี้จะถูกลบออกจากพวงกุญแจของ Mac เครื่องนี้ และเครื่อง Cloud จะไม่ได้รับอีกต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Değeri bu Mac'in Anahtar Zinciri'nden silinir ve Cloud makineleri artık onu almaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Його значення видаляється зі зв’язки ключів цього Mac, і машини Cloud більше його не отримують."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Giá trị của nó bị xóa khỏi Chuỗi khóa của máy Mac này và các máy Cloud sẽ không nhận được nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "其值将从这台 Mac 的钥匙串中删除，Cloud 机器将不再获得它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "其值將從這台 Mac 的鑰匙圈中刪除，Cloud 機器將不再取得它。"
          }
        }
      }
    },
