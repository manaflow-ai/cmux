        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 패널은 아직 다른 터미널을 표시할 수 없습니다. cmux를 업데이트한 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne ruten kan ikke vise en annen terminal ennå. Oppdater cmux, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
