          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odaklanan bölmede karşılaştırılacak klasör yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В активній панелі немає папки для порівняння."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ngăn đang chọn không có thư mục để so sánh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "当前窗格没有可比较的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "目前窗格沒有可比較的資料夾。"
          }
