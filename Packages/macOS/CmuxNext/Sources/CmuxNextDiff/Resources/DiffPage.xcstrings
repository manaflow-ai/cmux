    "diff.page.machineOffline": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏„%@“ غير متصل. ستظهر الفروقات مجددًا عند إعادة الاتصال."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ nije povezan. Razlike će se ponovo prikazati kada se ponovo poveže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” er ikke forbundet. Diff’en vises igen, når forbindelsen er genoprettet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist nicht verbunden. Der Diff wird wieder angezeigt, sobald die Verbindung besteht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not connected. Its diff shows again when it reconnects."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no está conectado. Su diff volverá a mostrarse cuando se reconecte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n’est pas connecté. Son diff s’affichera de nouveau à la reconnexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non è connesso. Il diff verrà mostrato di nuovo alla riconnessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は接続されていません。再接続すると差分が再び表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” មិនបានភ្ជាប់ទេ។ ភាពខុសគ្នានឹងបង្ហាញម្ដងទៀតនៅពេលភ្ជាប់ឡើងវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’에 연결되어 있지 않습니다. 다시 연결되면 diff가 다시 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» er ikke tilkoblet. Diffen vises igjen når den kobler til på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nie jest połączony. Różnice pojawią się ponownie po ponownym połączeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não está conectado. O diff aparecerá de novo quando reconectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» не подключён. Изменения снова появятся после переподключения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ไม่ได้เชื่อมต่อ diff จะแสดงอีกครั้งเมื่อเชื่อมต่อใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” bağlı değil. Yeniden bağlandığında diff tekrar gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» не під’єднано. Зміни знову з’являться після повторного під’єднання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” chưa được kết nối. Diff sẽ hiển thị lại khi kết nối lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”未连接。重新连接后会再次显示差异。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」未連線。重新連線後會再次顯示差異。"
          }
        }
      }
    },
    "diff.page.machineUnsupported": {
