    "diff.page.revert.unstagedLine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unstaged changes are lost. Staged changes stay."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُفقد التغييرات غير المرحلية. تبقى التغييرات المرحلية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nepripremljene izmjene se gube. Pripremljene izmjene ostaju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ændringer uden for indekset går tabt. Ændringer i indekset bliver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nicht vorgemerkte Änderungen gehen verloren. Vorgemerkte Änderungen bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los cambios sin preparar se pierden. Los cambios preparados se mantienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les modifications non indexées sont perdues. Les modifications indexées restent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le modifiche non in stage vanno perse. Quelle in stage restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未ステージの変更は失われます。ステージ済みの変更は残ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការផ្លាស់ប្តូរដែលមិនទាន់ដាក់នឹងបាត់។ ការផ្លាស់ប្តូរដែលបានដាក់នៅដដែល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "스테이징되지 않은 변경 사항은 사라집니다. 스테이징된 변경 사항은 남습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Endringer utenfor indeksen går tapt. Endringer i indeksen blir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmiany poza poczekalnią zostaną utracone. Zmiany w poczekalni zostają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As alterações não preparadas são perdidas. As preparadas ficam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Непроиндексированные изменения будут потеряны. Проиндексированные останутся."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การเปลี่ยนแปลงที่ยังไม่ staged จะหายไป การเปลี่ยนแปลงที่ staged แล้วยังอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hazırlanmamış değişiklikler kaybolur. Hazırlanmış değişiklikler kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Непроіндексовані зміни буде втрачено. Проіндексовані залишаться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thay đổi chưa stage sẽ mất. Thay đổi đã stage vẫn giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未暂存的更改将丢失。已暂存的更改会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未暫存的變更將遺失。已暫存的變更會保留。"
          }
        }
      }
    },
