    "diff.page.chooseFolder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder to diff"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "差分を表示するフォルダを選択"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اختر مجلدًا لعرض فروقاته"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odaberite mapu za poređenje"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vælg en mappe at sammenligne"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ordner zum Vergleichen wählen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elige una carpeta para comparar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisissez un dossier à comparer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scegli una cartella da confrontare"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ជ្រើសរើសថតសម្រាប់ប្រៀបធៀប"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "비교할 폴더 선택"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Velg en mappe å sammenligne"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybierz folder do porównania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolha uma pasta para comparar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выберите папку для сравнения"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เลือกโฟลเดอร์ที่จะเปรียบเทียบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Karşılaştırılacak klasörü seçin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Виберіть папку для порівняння"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chọn thư mục để so sánh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "选择要比较的文件夹"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選擇要比較的資料夾"
          }
        }
      }
    },
    "diff.page.noDiffTab": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No diff viewer has the keyboard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードフォーカスのある差分ビューアがありません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يوجد عارض فروقات يستقبل لوحة المفاتيح."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nijedan preglednik razlika nema tastaturu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen diff-fremviser har tastaturet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keine Diff-Ansicht hat den Tastaturfokus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ningún visor de diferencias tiene el teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucune visionneuse de diff n’a le clavier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessun visualizzatore diff ha la tastiera."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្មានកម្មវិធីមើលភាពខុសគ្នាណាមួយមានក្ដារចុចទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "키보드 포커스가 있는 차이 보기가 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen diff-visning har tastaturet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Żaden podgląd różnic nie ma fokusu klawiatury."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhum visualizador de diff tem o teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ни один просмотр различий не получает ввод с клавиатуры."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่มีตัวแสดงความแตกต่างใดได้รับแป้นพิมพ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klavye odağı olan bir fark görüntüleyici yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Жоден переглядач відмінностей не має фокусу клавіатури."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không có trình xem khác biệt nào đang nhận bàn phím."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "没有差异查看器获得键盘焦点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "沒有差異檢視器取得鍵盤焦點。"
          }
        }
      }
    },
    "diff.page.noFolder": {
      "extractionState": "manual",
      "localizations": {
