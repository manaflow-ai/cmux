{
  "sourceLanguage": "en",
  "strings": {
    "home.chatColors.refusal.badColor": {
      "comment": "Refusal of Chat Colors (cmux chat colors): %1$@ is the value given, %2$@ the option name (sent, sentText, received, receivedText). Keep #RRGGBB and default as they are.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is not a color for --%2$@: use #RRGGBB, or default."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏%1$@ ليس لونًا لـ ‎--%2$@‏: استخدم ‎#RRGGBB‏ أو default."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ nije boja za --%2$@: koristite #RRGGBB ili default."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ er ikke en farve til --%2$@: brug #RRGGBB eller default."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ist keine Farbe für --%2$@: verwende #RRGGBB oder default."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ no es un color para --%2$@: usa #RRGGBB o default."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ n’est pas une couleur pour --%2$@ : utilisez #RRGGBB ou default."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ non è un colore per --%2$@: usa #RRGGBB oppure default."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ は --%2$@ の色ではありません。#RRGGBB または default を使ってください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ មិនមែនជាពណ៌សម្រាប់ --%2$@ ទេ៖ ប្រើ #RRGGBB ឬ default។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@은(는) --%2$@의 색상이 아닙니다. #RRGGBB 또는 default를 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ er ikke en farge for --%2$@: bruk #RRGGBB eller default."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ nie jest kolorem dla --%2$@: użyj #RRGGBB lub default."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ não é uma cor para --%2$@: use #RRGGBB ou default."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ — не цвет для --%2$@: используйте #RRGGBB или default."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ไม่ใช่สีสำหรับ --%2$@: ใช้ #RRGGBB หรือ default"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@, --%2$@ için bir renk değil: #RRGGBB veya default kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ — не колір для --%2$@: використовуйте #RRGGBB або default."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ không phải là màu cho --%2$@: dùng #RRGGBB hoặc default."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ 不是 --%2$@ 的颜色：请使用 #RRGGBB 或 default。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ 不是 --%2$@ 的顏色：請使用 #RRGGBB 或 default。"
          }
        }
      }
    },
    "home.outcome.cloudUnreachable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud didn’t answer. Check your connection and try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تستجب cmux Cloud. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux Cloud nije odgovorio. Provjerite vezu i pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux Cloud svarede ikke. Tjek din forbindelse, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud hat nicht geantwortet. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud no respondió. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud n’a pas répondu. Vérifiez votre connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux Cloud non ha risposto. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud から応答がありません。接続を確認して、もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux Cloud មិនបានឆ្លើយតបទេ។ សូមពិនិត្យការតភ្ជាប់របស់អ្នក ហើយព្យាយាមម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud가 응답하지 않았습니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux Cloud svarte ikke. Sjekk tilkoblingen og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux Cloud nie odpowiedział. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cmux Cloud não respondeu. Verifique sua conexão e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux Cloud не ответил. Проверьте подключение и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux Cloud ไม่ตอบสนอง ตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux Cloud yanıt vermedi. Bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux Cloud не відповів. Перевірте з’єднання й спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux Cloud không phản hồi. Hãy kiểm tra kết nối và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud 没有响应。请检查网络连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud 沒有回應。請檢查網路連線後再試一次。"
          }
        }
      }
    },
