    "home.outcome.notReachable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can’t message %@ yet. Invite them by email instead."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكنك مراسلة %@ بعد. ادعهم عبر البريد الإلكتروني بدلاً من ذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Još ne možete pisati %@. Umjesto toga ih pozovite e-poštom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du kan ikke skrive til %@ endnu. Inviter dem via e-mail i stedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst %@ noch nicht schreiben. Lade die Person stattdessen per E-Mail ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no puedes escribir a %@. Envíale una invitación por correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez pas encore écrire à %@. Invitez cette personne par e-mail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non puoi ancora scrivere a %@. Invitalo via email."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にはまだメッセージを送れません。代わりにメールで招待してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អ្នកមិនទាន់អាចផ្ញើសារទៅ %@ បានទេ។ សូមអញ្ជើញតាមអ៊ីមែលជំនួសវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 %@님에게 메시지를 보낼 수 없습니다. 대신 이메일로 초대하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du kan ikke sende melding til %@ ennå. Inviter dem via e-post i stedet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie możesz jeszcze pisać do %@. Zaproś tę osobę e-mailem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você ainda não pode enviar mensagens para %@. Convide por e-mail."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пока нельзя написать %@. Пригласите по эл. почте."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คุณยังส่งข้อความหา %@ ไม่ได้ เชิญทางอีเมลแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ kişisine henüz mesaj gönderemezsiniz. Bunun yerine e-postayla davet edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Поки не можна написати %@. Запросіть електронною поштою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bạn chưa thể nhắn tin cho %@. Hãy mời họ qua email."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你还不能给 %@ 发消息。请改为通过邮件邀请。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你還不能傳訊息給 %@。請改以電子郵件邀請。"
          }
        }
      }
    },
    "home.outcome.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You started too many conversations in the last hour. Try again later."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدأت محادثات كثيرة جدًا خلال الساعة الماضية. حاول مرة أخرى لاحقًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Započeli ste previše razgovora u posljednjih sat vremena. Pokušajte kasnije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du har startet for mange samtaler inden for den seneste time. Prøv igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast in der letzten Stunde zu viele Unterhaltungen begonnen. Versuche es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has empezado demasiadas conversaciones en la última hora. Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez commencé trop de conversations au cours de la dernière heure. Réessayez plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hai iniziato troppe conversazioni nell’ultima ora. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近1時間に開始した会話が多すぎます。しばらくしてからもう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អ្នកបានចាប់ផ្ដើមការសន្ទនាច្រើនពេកក្នុងរយៈពេលមួយម៉ោងចុងក្រោយ។ សូមព្យាយាមម្ដងទៀតពេលក្រោយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 1시간 동안 너무 많은 대화를 시작했습니다. 나중에 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du har startet for mange samtaler den siste timen. Prøv igjen senere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rozpocząłeś zbyt wiele rozmów w ciągu ostatniej godziny. Spróbuj później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você iniciou conversas demais na última hora. Tente novamente mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "За последний час вы начали слишком много разговоров. Повторите попытку позже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คุณเริ่มการสนทนามากเกินไปในชั่วโมงที่ผ่านมา โปรดลองอีกครั้งในภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Son bir saatte çok fazla sohbet başlattınız. Daha sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "За останню годину ви почали забагато розмов. Спробуйте пізніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bạn đã bắt đầu quá nhiều cuộc trò chuyện trong giờ qua. Hãy thử lại sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去一小时内你发起的对话太多。请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過去一小時內你發起的對話太多。請稍後再試。"
          }
        }
      }
    },
