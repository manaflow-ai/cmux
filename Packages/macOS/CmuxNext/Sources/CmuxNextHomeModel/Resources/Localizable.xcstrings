          "stringUnit": {
            "state": "translated",
            "value": "Trop de modifications à la fois. Réessayez plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppe modifiche in una volta. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度に変更が多すぎます。しばらくしてからもう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការផ្លាស់ប្តូរច្រើនពេកក្នុងពេលតែមួយ។ សូមព្យាយាមម្តងទៀតពេលក្រោយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번에 변경이 너무 많습니다. 나중에 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange endringer på én gang. Prøv igjen senere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt wiele zmian naraz. Spróbuj ponownie później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas alterações de uma vez. Tente novamente mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много изменений сразу. Повторите попытку позже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนแปลงมากเกินไปในครั้งเดียว ลองอีกครั้งภายหลัง"
