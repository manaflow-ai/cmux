    "home.group.outcome.notReachable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can’t add %@ yet. Invite them by email instead."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكنك إضافة %@ بعد. ادعهم عبر البريد الإلكتروني بدلاً من ذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Još ne možete dodati %@. Umjesto toga ih pozovite e-poštom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ikke tilføje %@ endnu. Inviter dem via e-mail i stedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst %@ noch nicht hinzufügen. Lade die Person stattdessen per E-Mail ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no puedes añadir a %@. Invítale por correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez pas encore ajouter %@. Invitez cette personne par e-mail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non puoi ancora aggiungere %@. Invitalo via email."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はまだ追加できません。代わりにメールで招待してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកមិនទាន់អាចបន្ថែម %@ បានទេ។ សូមអញ្ជើញតាមអ៊ីមែលជំនួសវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 %@님을 추가할 수 없습니다. 대신 이메일로 초대하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ikke legge til %@ ennå. Inviter dem via e-post i stedet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie możesz jeszcze dodać %@. Zamiast tego zaproś tę osobę e-mailem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ainda não pode adicionar %@. Convide por e-mail."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нельзя добавить %@. Пригласите по электронной почте."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยังเพิ่ม %@ ไม่ได้ เชิญทางอีเมลแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
