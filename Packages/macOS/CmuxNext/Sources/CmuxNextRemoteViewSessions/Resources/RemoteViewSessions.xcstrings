    "remote.vnc.signIn.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل اسم المستخدم وكلمة المرور لمشاركة الشاشة على هذا الكمبيوتر. بالنسبة إلى Mac، استخدم حسابًا على ذلك الـ Mac. يحفظهما cmux في سلسلة المفاتيح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib Benutzername und Passwort der Bildschirmfreigabe dieses Computers ein. Verwende bei einem Mac einen Account auf diesem Mac. cmux speichert sie in deinem Schlüsselbund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the user name and password of this computer's screen sharing. For a Mac, use an account on that Mac. cmux keeps them in your keychain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el nombre de usuario y la contraseña de la pantalla compartida de este ordenador. En un Mac, usa una cuenta de ese Mac. cmux los guarda en tu llavero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le nom d’utilisateur et le mot de passe du partage d’écran de cet ordinateur. Pour un Mac, utilisez un compte de ce Mac. cmux les conserve dans votre trousseau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンピュータの画面共有のユーザ名とパスワードを入力してください。Mac の場合はその Mac のアカウントを使用します。cmux はキーチェーンに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 컴퓨터 화면 공유의 사용자 이름과 암호를 입력하십시오. Mac의 경우 해당 Mac의 계정을 사용하십시오. cmux는 이를 키체인에 보관합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入这台电脑屏幕共享的用户名和密码。如果是 Mac，请使用该 Mac 上的账户。cmux 会将它们保存在你的钥匙串中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入這部電腦螢幕共享的使用者名稱和密碼。若是 Mac，請使用該 Mac 上的帳號。cmux 會將它們存放在你的鑰匙圈中。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite korisničko ime i lozinku za dijeljenje ekrana ovog računara. Za Mac koristite račun na tom Macu. cmux ih čuva u vašem privjesku za ključeve."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast brugernavn og adgangskode til denne computers skærmdeling. For en Mac skal du bruge en konto på den Mac. cmux gemmer dem i din nøglering."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il nome utente e la password della condivisione schermo di questo computer. Per un Mac, usa un account su quel Mac. cmux li conserva nel tuo portachiavi."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ចូលឈ្មោះអ្នកប្រើ និងពាក្យសម្ងាត់នៃការចែករំលែកអេក្រង់របស់កុំព្យូទ័រនេះ។ សម្រាប់ Mac ប្រើគណនីនៅលើ Mac នោះ។ cmux រក្សាទុកពួកវានៅក្នុង keychain របស់អ្នក។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn brukernavnet og passordet for skjermdelingen på denne datamaskinen. For en Mac bruker du en konto på den Macen. cmux lagrer dem i nøkkelringen din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz nazwę użytkownika i hasło udostępniania ekranu tego komputera. W przypadku Maca użyj konta na tym Macu. cmux przechowuje je w Twoim pęku kluczy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o nome de usuário e a senha do compartilhamento de tela deste computador. Para um Mac, use uma conta nesse Mac. O cmux os guarda nas suas chaves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите имя пользователя и пароль общего экрана этого компьютера. Для Mac используйте учётную запись на этом Mac. cmux хранит их в вашей связке ключей."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนชื่อผู้ใช้และรหัสผ่านของการแชร์หน้าจอของคอมพิวเตอร์เครื่องนี้ สำหรับ Mac ให้ใช้บัญชีบน Mac เครื่องนั้น cmux จะเก็บไว้ในพวงกุญแจของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bilgisayarın ekran paylaşımı için kullanıcı adını ve parolayı girin. Mac için o Mac'teki bir hesabı kullanın. cmux bunları anahtar zincirinizde saklar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть ім’я користувача й пароль спільного доступу до екрана цього комп’ютера. Для Mac використайте обліковий запис на тому Mac. cmux зберігає їх у вашій в’язці ключів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập tên người dùng và mật khẩu chia sẻ màn hình của máy tính này. Với máy Mac, hãy dùng một tài khoản trên máy Mac đó. cmux lưu chúng trong chuỗi khóa của bạn."
          }
        }
      }
    },
