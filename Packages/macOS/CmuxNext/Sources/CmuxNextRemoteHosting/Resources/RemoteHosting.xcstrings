    "remoteHost.dial.notAllowed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هذا المضيف لا يسمح لحسابك بالدخول."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovaj host ne pušta vaš račun."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne vært lukker ikke din konto ind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Host lässt dein Konto nicht zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This host does not let your account in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este host no permite el acceso a tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cet hôte n’autorise pas votre compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo host non consente l’accesso al tuo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このホストはあなたのアカウントを受け入れていません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ម៉ាស៊ីននេះមិនអនុញ្ញាតឱ្យគណនីរបស់អ្នកចូលទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 호스트는 계정의 접속을 허용하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne verten slipper ikke inn kontoen din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten host nie wpuszcza Twojego konta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este host não permite a entrada da sua conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот хост не пускает вашу учётную запись."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โฮสต์นี้ไม่อนุญาตให้บัญชีของคุณเข้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu ana bilgisayar hesabınızın girişine izin vermiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цей хост не пускає ваш обліковий запис."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Máy chủ này không cho tài khoản của bạn truy cập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此主机不允许你的账户进入。"
