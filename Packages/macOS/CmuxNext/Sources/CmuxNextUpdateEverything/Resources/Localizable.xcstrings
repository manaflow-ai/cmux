            "value": "cmux は最後に再起動して自身のアップデートを完了します。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux se ponovo pokreće posljednji da završi vlastito ažuriranje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux genstarter til sidst for at færdiggøre sin egen opdatering."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux si riavvia per ultimo per completare il proprio aggiornamento."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ចាប់ផ្ដើមឡើងវិញចុងក្រោយគេ ដើម្បីបញ្ចប់ការធ្វើបច្ចុប្បន្នភាពរបស់ខ្លួន។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux starter på nytt til slutt for å fullføre sin egen oppdatering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux uruchamia się ponownie na końcu, aby dokończyć własną aktualizację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux reinicia por último para concluir a própria atualização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux перезапускается последним, чтобы завершить собственное обновление."
