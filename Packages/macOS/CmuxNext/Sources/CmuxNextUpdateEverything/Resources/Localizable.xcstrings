    "updateEverything.relaunches": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux restarts last to finish its own update."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux startet zuletzt neu, um das eigene Update abzuschließen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux redémarre en dernier pour terminer sa propre mise à jour."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُعاد تشغيل cmux أخيرًا لإكمال تحديثه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux se reinicia al final para completar su propia actualización."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 最後重新啟動以完成自身更新。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 最后重启以完成自身更新。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux는 자체 업데이트를 마치기 위해 마지막에 재시작합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux は最後に再起動して自身のアップデートを完了します。"
          }
        }
      }
    },
