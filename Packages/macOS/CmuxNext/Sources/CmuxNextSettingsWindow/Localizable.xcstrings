          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son denetim başarısız oldu. cmux bir sonraki denetimde yeniden dener."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Остання перевірка не вдалася. cmux спробує знову під час наступної перевірки."
