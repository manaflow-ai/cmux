    "settingsWindow.chief.voiceInput.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate into the message box with its mic, on this Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أملِ النص في مربع الرسالة بالميكروفون على هذا الـ Mac."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktirajte u polje za poruku mikrofonom, na ovom Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktér i beskedfeltet med mikrofonen på denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Per Mikrofon ins Nachrichtenfeld diktieren, auf diesem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicta en el cuadro de mensaje con el micrófono, en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictez dans le champ de message avec le micro, sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta nel campo messaggio con il microfono, su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージ欄にマイクで音声入力します（この Mac 上で）。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សរសេរតាមសំឡេងចូលប្រអប់សារដោយមីក្រូហ្វូន នៅលើ Mac នេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 마이크로 메시지 상자에 받아쓰기합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikter inn i meldingsfeltet med mikrofonen, på denne Macen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyktuj do pola wiadomości mikrofonem, na tym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dite na caixa de mensagem com o microfone, neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктуйте в поле сообщения с микрофона на этом Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนข้อความด้วยเสียงผ่านไมโครโฟนบน Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesaj kutusuna mikrofonla dikte edin, bu Mac'te."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктуйте в поле повідомлення мікрофоном на цьому Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc chính tả vào ô tin nhắn bằng micrô, trên máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 Mac 上用麦克风向消息框听写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這台 Mac 上用麥克風向訊息框聽寫。"
          }
        }
      }
    },
