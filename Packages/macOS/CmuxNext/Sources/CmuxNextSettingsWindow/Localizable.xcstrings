        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النتيجة غير معروفة؛ لا تبدأ تحديثًا آخر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ishod je nepoznat; nemojte pokretati drugo ažuriranje."
          }
        },
