            "value": "เวอร์ชันของตัวช่วยไม่ตรงกับบิลด์นี้ อัปเดต cmux NIGHTLY และบิลด์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yardımcının sürümü bu yapıyla eşleşmiyor. cmux NIGHTLY’yi ve bu yapıyı güncelleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Версія помічника не відповідає цій збірці. Оновіть cmux NIGHTLY і цю збірку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Phiên bản trình trợ giúp không khớp với bản dựng này. Hãy cập nhật cmux NIGHTLY và bản dựng này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "辅助程序版本与此构建不匹配。请更新 cmux NIGHTLY 和此构建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "輔助程式版本與此建置不符。請更新 cmux NIGHTLY 與此建置。"
          }
        }
      }
    },
