    "settingsWindow.browserProfilesHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each profile has its own cookies, logins, history, extensions and site permissions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "各プロファイルに固有の Cookie、ログイン、履歴、拡張機能、サイトの権限があります。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لكل ملف تعريف ملفات تعريف الارتباط وتسجيلات الدخول والسجل والإضافات وأذونات المواقع الخاصة به."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svaki profil ima vlastite kolačiće, prijave, historiju, proširenja i dozvole stranica."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hver profil har sine egne cookies, logins, historik, udvidelser og webstedstilladelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jedes Profil hat eigene Cookies, Anmeldungen, Verläufe, Erweiterungen und Website-Berechtigungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada perfil tiene sus propias cookies, inicios de sesión, historial, extensiones y permisos de sitios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque profil a ses propres cookies, identifiants, historique, extensions et autorisations de sites."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ogni profilo ha i propri cookie, accessi, cronologia, estensioni e autorizzazioni dei siti."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ប្រវត្តិរូបនីមួយៗមានខូគី ការចូល ប្រវត្តិ កម្មវិធីបន្ថែម និងការអនុញ្ញាតគេហទំព័រផ្ទាល់ខ្លួន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "각 프로필에는 고유한 쿠키, 로그인, 기록, 확장 프로그램, 사이트 권한이 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hver profil har egne informasjonskapsler, pålogginger, logg, utvidelser og nettstedstillatelser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Każdy profil ma własne pliki cookie, logowania, historię, rozszerzenia i uprawnienia witryn."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada perfil tem seus próprios cookies, logins, histórico, extensões e permissões de sites."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У каждого профиля свои файлы cookie, входы, история, расширения и разрешения сайтов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แต่ละโปรไฟล์มีคุกกี้ การเข้าสู่ระบบ ประวัติ ส่วนขยาย และสิทธิ์ของไซต์เป็นของตัวเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her profilin kendi çerezleri, oturumları, geçmişi, uzantıları ve site izinleri vardır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кожен профіль має власні файли cookie, входи, історію, розширення та дозволи сайтів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mỗi hồ sơ có cookie, thông tin đăng nhập, lịch sử, tiện ích mở rộng và quyền trang web riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每个配置文件都有自己的 Cookie、登录信息、历史记录、扩展程序和网站权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每個設定檔都有自己的 Cookie、登入資料、瀏覽記錄、擴充功能和網站權限。"
          }
        }
      }
    },
