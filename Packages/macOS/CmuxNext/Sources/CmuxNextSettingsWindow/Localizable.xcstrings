    "settingsWindow.chief.notices.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Chief's notices follow your notification settings."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبع تنبيهات Chief إعدادات الإشعارات لديك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavijesti Chiefa prate vaše postavke obavještenja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiefs meddelelser følger dine notifikationsindstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief-Hinweise folgen deinen Mitteilungseinstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los avisos del Chief siguen tus ajustes de notificaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les avis du Chief suivent vos réglages de notifications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli avvisi del Chief seguono le impostazioni notifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief のお知らせは通知の設定に従います。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សេចក្ដីជូនដំណឹងរបស់ Chief ធ្វើតាមការកំណត់ការជូនដំណឹង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief의 알림 메시지는 알림 설정을 따릅니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiefs meldinger følger varslingsinnstillingene dine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komunikaty Chiefa działają według ustawień powiadomień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os avisos do Chief seguem seus ajustes de notificações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оповещения Chief следуют вашим настройкам уведомлений."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประกาศของ Chief เป็นไปตามการตั้งค่าการแจ้งเตือนของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief'in uyarıları bildirim ayarlarınıza uyar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оповіщення Chief відповідають вашим налаштуванням сповіщень."
          }
        },
        "vi": {
