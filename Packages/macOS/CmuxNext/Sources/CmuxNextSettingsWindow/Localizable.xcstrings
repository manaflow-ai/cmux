          "stringUnit": {
            "state": "needs_review",
            "value": "Los ajustes son de solo lectura hasta que cmux se vuelva a conectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les réglages sont en lecture seule jusqu'à ce que cmux se reconnecte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le impostazioni sono di sola lettura finché cmux non si riconnette."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការកំណត់អាចអានបានតែប៉ុណ្ណោះ រហូតដល់ cmux ភ្ជាប់ឡើងវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux가 다시 연결될 때까지 설정은 읽기 전용입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Innstillingene er skrivebeskyttet til cmux kobler til igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ustawienia są tylko do odczytu, dopóki cmux nie połączy się ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os ajustes ficam somente leitura até o cmux se reconectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Настройки доступны только для чтения, пока cmux не переподключится."
