    "settingsWindow.agentIntegrations.conflict.not_a_directory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something other than a folder is here. Move it first."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد هنا شيء غير مجلد. انقله أولًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje je nešto što nije mapa. Prvo to premjestite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ligger noget, der ikke er en mappe. Flyt det først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier liegt etwas, das kein Ordner ist. Verschiebe es zuerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí hay algo que no es una carpeta. Muévelo antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci n’est pas un dossier. Déplacez-le d’abord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui c’è qualcosa che non è una cartella. Spostalo prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダ以外のものがあります。先に移動してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នៅទីនេះមិនមែនជាថតទេ។ ផ្លាស់ទីវាជាមុនសិន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더가 아닌 항목이 있습니다. 먼저 옮기세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ligger noe som ikke er en mappe. Flytt det først."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu jest coś, co nie jest folderem. Najpierw to przenieś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há algo que não é uma pasta aqui. Mova-o antes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь не папка. Сначала переместите её."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรงนี้ไม่ใช่โฟลเดอร์ ให้ย้ายออกก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada klasör olmayan bir şey var. Önce onu taşıyın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут не папка. Спершу перемістіть її."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ở đây không phải là thư mục. Hãy di chuyển nó trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里不是文件夹。请先将其移走。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡不是資料夾。請先將它移走。"
          }
        }
      }
    },
