    "settingsWindow.computerUse.accessibility.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets agents click, type and scroll in other apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントがほかのアプリでクリック、入力、スクロールできるようにします。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتيح للوكلاء النقر والكتابة والتمرير في التطبيقات الأخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Omogućava agentima da klikću, kucaju i listaju u drugim aplikacijama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lader agenter klikke, skrive og rulle i andre apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erlaubt Agenten, in anderen Apps zu klicken, zu tippen und zu scrollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite a los agentes hacer clic, escribir y desplazarse en otras apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permet aux agents de cliquer, saisir et faire défiler dans d’autres apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consente agli agenti di fare clic, digitare e scorrere in altre app."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អនុញ្ញាតឱ្យភ្នាក់ងារចុច វាយ និងរំកិលក្នុងកម្មវិធីផ្សេងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트가 다른 앱에서 클릭, 입력, 스크롤할 수 있게 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lar agenter klikke, skrive og rulle i andre apper."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pozwala agentom klikać, pisać i przewijać w innych aplikacjach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite que agentes cliquem, digitem e rolem em outros apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Позволяет агентам нажимать, печатать и прокручивать в других приложениях."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ให้เอเจนต์คลิก พิมพ์ และเลื่อนในแอปอื่นได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajanların diğer uygulamalarda tıklamasına, yazmasına ve kaydırmasına izin verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дає агентам змогу натискати, вводити й прокручувати в інших програмах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cho phép tác nhân nhấp, gõ và cuộn trong các ứng dụng khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "让代理可以在其他应用中点按、输入和滚动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "讓代理程式可在其他 App 中點按、輸入和捲動。"
          }
        }
      }
    },
