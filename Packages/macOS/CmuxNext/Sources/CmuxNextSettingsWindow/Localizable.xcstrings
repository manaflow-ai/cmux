    "settingsWindow.harnesses.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The coding agents cmux can start in a chat. Sign In opens a terminal tab with the agent's own sign-in."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "وكلاء البرمجة الذين يمكن لـ cmux تشغيلهم في محادثة. يفتح تسجيل الدخول علامة تبويب طرفية بتسجيل دخول الوكيل نفسه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agenti za kodiranje koje cmux može pokrenuti u razgovoru. Prijava otvara karticu terminala s prijavom samog agenta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De kodeagenter, cmux kan starte i en chat. Log ind åbner en terminalfane med agentens egen login."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Coding-Agenten, die cmux in einem Chat starten kann. Anmelden öffnet einen Terminal-Tab mit der Anmeldung des Agenten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los agentes de código que cmux puede iniciar en un chat. Iniciar sesión abre una pestaña de terminal con el inicio de sesión del propio agente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les agents de code que cmux peut lancer dans une discussion. Se connecter ouvre un onglet de terminal avec la connexion propre à l'agent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli agenti di programmazione che cmux può avviare in una chat. Accedi apre una scheda del terminale con l'accesso dell'agente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux がチャットで起動できるコーディングエージェントです。「サインイン」を押すと、エージェント自身のサインインを実行するターミナルタブが開きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ភ្នាក់ងារសរសេរកូដដែល cmux អាចចាប់ផ្ដើមក្នុងការជជែក។ ចូល បើកផ្ទាំងស្ថានីយជាមួយការចូលរបស់ភ្នាក់ងារផ្ទាល់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux가 채팅에서 시작할 수 있는 코딩 에이전트입니다. 로그인을 누르면 에이전트 자체 로그인이 실행되는 터미널 탭이 열립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kodeagentene cmux kan starte i en chat. Logg på åpner en terminalfane med agentens egen pålogging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agenci kodujący, których cmux może uruchomić w czacie. Zaloguj otwiera kartę terminala z logowaniem samego agenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os agentes de código que o cmux pode iniciar em um chat. Entrar abre uma aba de terminal com o login do próprio agente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Агенты для кода, которых cmux может запустить в чате. «Войти» открывает вкладку терминала со входом самого агента."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เอเจนต์เขียนโค้ดที่ cmux เริ่มในแชตได้ ลงชื่อเข้าใช้จะเปิดแท็บเทอร์มินัลพร้อมการลงชื่อเข้าใช้ของเอเจนต์เอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux'un bir sohbette başlatabildiği kodlama ajanları. Oturum Aç, ajanın kendi girişiyle bir terminal sekmesi açar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Агенти для коду, яких cmux може запустити в чаті. «Увійти» відкриває вкладку термінала із входом самого агента."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các tác nhân lập trình mà cmux có thể khởi chạy trong cuộc trò chuyện. Đăng nhập mở một thẻ terminal với bước đăng nhập của chính tác nhân."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 可以在聊天中启动的编程代理。“登录”会打开一个终端标签页，运行代理自己的登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 可以在聊天中啟動的程式代理。「登入」會開啟一個終端機分頁，執行代理自己的登入。"
          }
        }
      }
    },
