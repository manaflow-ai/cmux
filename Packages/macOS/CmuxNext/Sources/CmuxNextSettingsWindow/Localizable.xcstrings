    "settingsPage.chiefPet.about.orb": {
      "comment": "Chief pet character Orb (a round dark creature): one-line description in its card.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A round little shadow that keeps watch from the corner."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ظل صغير مستدير يراقب من الزاوية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mala okrugla sjena koja pazi iz ugla."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En lille rund skygge, der holder øje fra hjørnet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein kleiner runder Schatten, der aus der Ecke Wache hält."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una pequeña sombra redonda que vigila desde la esquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une petite ombre ronde qui veille depuis le coin."
          }
        },
