    "settingsPage.readOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings are read only until cmux reconnects."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux が再接続するまで、設定は読み取り専用です。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الإعدادات للقراءة فقط حتى يعيد cmux الاتصال."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Postavke su samo za čitanje dok se cmux ponovo ne poveže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Indstillingerne er skrivebeskyttede, indtil cmux genopretter forbindelsen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Einstellungen sind schreibgeschützt, bis cmux wieder verbunden ist."
          }
        },
