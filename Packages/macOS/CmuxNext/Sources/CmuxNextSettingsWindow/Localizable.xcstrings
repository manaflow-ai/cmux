    "settingsWindow.themeBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colors come from your Ghostty theme and follow it live."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "色は Ghostty のテーマから取得され、変更にすぐ追従します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تأتي الألوان من سمة Ghostty وتتبعها مباشرة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Boje dolaze iz vaše Ghostty teme i prate je uživo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Farver kommer fra dit Ghostty-tema og følger det live."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Farben stammen aus deinem Ghostty-Theme und folgen ihm live."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los colores vienen de tu tema de Ghostty y lo siguen en directo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les couleurs viennent de votre thème Ghostty et le suivent en direct."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I colori vengono dal tuo tema Ghostty e lo seguono in tempo reale."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ពណ៌មកពីស្បែក Ghostty របស់អ្នក ហើយធ្វើតាមវាភ្លាមៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "색상은 Ghostty 테마에서 가져오며 실시간으로 반영됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Farger kommer fra Ghostty-temaet ditt og følger det direkte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kolory pochodzą z motywu Ghostty i zmieniają się razem z nim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As cores vêm do seu tema do Ghostty e o acompanham ao vivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цвета берутся из темы Ghostty и сразу следуют её изменениям."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สีมาจากธีม Ghostty ของคุณและเปลี่ยนตามทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Renkler Ghostty temanızdan gelir ve onu anında izler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кольори беруться з теми Ghostty і одразу стежать за її змінами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Màu lấy từ chủ đề Ghostty của bạn và cập nhật theo trực tiếp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "颜色来自你的 Ghostty 主题，并实时跟随变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "顏色來自你的 Ghostty 主題，並即時跟隨變化。"
          }
        }
      }
    },
