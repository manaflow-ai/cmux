    "settingsPage.agents.secretsHelp": {
      "comment": "Settings > Agents (BRING-YOUR-OWN-HARNESS); keep commands, ACP, cmux.json and ~/.acpx exactly",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الأسماء فقط مفصولة بفواصل. اضبط كل قيمة باستخدام cmux harness secret set؛ لا ترى الإعدادات القيمة أبدًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Samo nazivi, odvojeni zarezima. Svaku vrijednost postavi s cmux harness secret set; Postavke je nikad ne vide."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kun navne, adskilt af kommaer. Angiv hver værdi med cmux harness secret set; Indstillinger ser den aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nur Namen, durch Kommas getrennt. Setze jeden Wert mit cmux harness secret set; die Einstellungen sehen ihn nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names only, separated by commas. Set each value with cmux harness secret set; Settings never sees it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo nombres, separados por comas. Define cada valor con cmux harness secret set; Ajustes nunca lo ve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noms seulement, séparés par des virgules. Définissez chaque valeur avec cmux harness secret set ; les Réglages ne la voient jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo nomi, separati da virgole. Imposta ogni valore con cmux harness secret set; le Impostazioni non lo vedono mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前のみをカンマ区切りで入力します。値はcmux harness secret setで設定します。設定画面が値を見ることはありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "តែឈ្មោះ បំបែកដោយក្បៀស។ កំណត់តម្លៃនីមួយៗដោយ cmux harness secret set; ការកំណត់មិនដែលឃើញវាទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이름만 쉼표로 구분해 입력하세요. 각 값은 cmux harness secret set으로 설정하며, 설정에서는 값을 볼 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bare navn, skilt med komma. Angi hver verdi med cmux harness secret set; Innstillinger ser den aldri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tylko nazwy, oddzielone przecinkami. Każdą wartość ustaw przez cmux harness secret set; Ustawienia nigdy jej nie widzą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Somente nomes, separados por vírgulas. Defina cada valor com cmux harness secret set; os Ajustes nunca o veem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Только имена через запятую. Значения задаются командой cmux harness secret set; настройки их не видят."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ชื่อเท่านั้น คั่นด้วยจุลภาค ตั้งค่าแต่ละค่าด้วย cmux harness secret set การตั้งค่าไม่เห็นค่าเลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yalnızca adlar, virgülle ayrılmış. Her değeri cmux harness secret set ile ayarlayın; Ayarlar değeri hiç görmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Лише імена через кому. Значення задаються командою cmux harness secret set; налаштування їх не бачать."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chỉ tên, cách nhau bằng dấu phẩy. Đặt từng giá trị bằng cmux harness secret set; Cài đặt không bao giờ thấy giá trị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅填写名称，用逗号分隔。用 cmux harness secret set 设置各个值；设置永远看不到值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "僅填寫名稱，以逗號分隔。用 cmux harness secret set 設定各個值；設定永遠看不到值。"
          }
        }
      }
    },
