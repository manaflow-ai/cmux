    "settingsWindow.agentIntegrations.conflict.not_owned": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A file cmux didn’t create is here. Move it first."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد هنا ملف لم ينشئه cmux. انقله أولًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovu datoteku nije napravio cmux. Prvo je premjestite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ligger en fil, cmux ikke har oprettet. Flyt den først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei stammt nicht von cmux. Verschiebe sie zuerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí hay un archivo que cmux no creó. Muévelo antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier non créé par cmux est ici. Déplacez-le d’abord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui c’è un file non creato da cmux. Spostalo prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux が作成していないファイルがあります。先に移動してください。"
