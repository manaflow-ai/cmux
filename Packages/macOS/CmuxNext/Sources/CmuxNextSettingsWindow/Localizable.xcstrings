    "settingsWindow.computerUse.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS gives these permissions to the cmux Computer Use helper, not to cmux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS はこれらの権限を cmux ではなく cmux Computer Use ヘルパーに与えます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمنح macOS هذه الأذونات لمساعد cmux Computer Use، وليس لـ cmux."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS daje ove dozvole pomoćniku cmux Computer Use, a ne cmuxu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS giver disse tilladelser til hjælpeprogrammet cmux Computer Use, ikke til cmux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS erteilt diese Berechtigungen dem Hilfsprogramm cmux Computer Use, nicht cmux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS concede estos permisos al asistente cmux Computer Use, no a cmux."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS accorde ces autorisations à l’assistant cmux Computer Use, pas à cmux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS concede questi permessi all’helper cmux Computer Use, non a cmux."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS ផ្តល់សិទ្ធិទាំងនេះទៅកម្មវិធីជំនួយ cmux Computer Use មិនមែនទៅ cmux ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS는 이 권한을 cmux가 아니라 cmux Computer Use 도우미에 부여합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS gir disse tillatelsene til hjelpeprogrammet cmux Computer Use, ikke til cmux."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS nadaje te uprawnienia pomocnikowi cmux Computer Use, a nie cmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O macOS concede essas permissões ao auxiliar cmux Computer Use, não ao cmux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS выдаёт эти разрешения помощнику cmux Computer Use, а не cmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS ให้สิทธิ์เหล่านี้แก่ตัวช่วย cmux Computer Use ไม่ใช่ cmux"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS bu izinleri cmux’a değil, cmux Computer Use yardımcısına verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS надає ці дозволи помічнику cmux Computer Use, а не cmux."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS cấp các quyền này cho trình trợ giúp cmux Computer Use, không phải cho cmux."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS 将这些权限授予 cmux Computer Use 辅助程序，而不是 cmux。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS 將這些權限授予 cmux Computer Use 輔助程式，而非 cmux。"
          }
        }
      }
    },
