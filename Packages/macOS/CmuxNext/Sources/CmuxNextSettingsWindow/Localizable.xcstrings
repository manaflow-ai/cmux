    "debugSettings.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes apply live and persist for this build. Defaults stay in code: copy the changed values for an agent to bake in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "変更はすぐに反映され、このビルドで保持されます。既定値はコードにあります。変更をコピーしてエージェントに組み込んでもらってください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُطبَّق التغييرات فورًا وتبقى لهذا الإصدار. القيم الافتراضية في الشيفرة: انسخ القيم المعدّلة ليدمجها وكيل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Promjene se primjenjuju odmah i ostaju za ovu verziju. Zadane vrijednosti su u kodu: kopirajte promjene da ih agent ugradi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ændringer gælder med det samme og gemmes for denne build. Standarder ligger i koden: kopiér ændringerne, så en agent kan bage dem ind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Änderungen wirken sofort und bleiben für diesen Build erhalten. Standardwerte stehen im Code: Kopiere die Änderungen, damit ein Agent sie übernimmt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los cambios se aplican al instante y se guardan para esta compilación. Los valores predeterminados están en el código: copia los cambios para que un agente los incorpore."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les modifications s’appliquent en direct et restent pour cette version. Les valeurs par défaut sont dans le code : copiez les modifications pour qu’un agent les intègre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le modifiche si applicano subito e restano per questa build. I valori predefiniti sono nel codice: copia le modifiche perché un agente le integri."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការផ្លាស់ប្ដូរអនុវត្តភ្លាមៗ និងរក្សាសម្រាប់កំណែនេះ។ តម្លៃលំនាំដើមនៅក្នុងកូដ៖ ចម្លងការផ្លាស់ប្ដូរឱ្យភ្នាក់ងារបញ្ចូល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "변경 사항은 바로 적용되고 이 빌드에 유지됩니다. 기본값은 코드에 있으니 변경 값을 복사해 에이전트가 반영하게 하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Endringer gjelder med en gang og lagres for denne builden. Standardverdier ligger i koden: kopier endringene så en agent kan bake dem inn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmiany działają od razu i zostają dla tej kompilacji. Wartości domyślne są w kodzie: skopiuj zmiany, aby agent je wprowadził."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As alterações valem na hora e ficam salvas nesta build. Os padrões ficam no código: copie as alterações para um agente incorporá-las."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Изменения применяются сразу и сохраняются для этой сборки. Значения по умолчанию в коде: скопируйте изменения, чтобы агент внёс их."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การเปลี่ยนแปลงมีผลทันทีและคงอยู่สำหรับบิลด์นี้ ค่าเริ่มต้นอยู่ในโค้ด: คัดลอกค่าที่เปลี่ยนให้เอเจนต์นำไปใส่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Değişiklikler anında uygulanır ve bu derlemede kalır. Varsayılanlar koddadır: bir ajanın işlemesi için değişiklikleri kopyalayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Зміни діють одразу й зберігаються для цієї збірки. Типові значення в коді: скопіюйте зміни, щоб агент їх вніс."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thay đổi áp dụng ngay và lưu cho bản dựng này. Mặc định nằm trong mã: sao chép thay đổi để agent đưa vào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "更改即时生效，并为此构建保留。默认值在代码中：复制更改的值交给代理写入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "變更即時生效，並為此建置保留。預設值在程式碼中：拷貝變更的值交給代理寫入。"
          }
        }
      }
    },
