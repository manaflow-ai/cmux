    "settingsWindow.terminalBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonts, colors, cursor and keybinds are Ghostty settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "フォント、カラー、カーソル、キーバインドは Ghostty の設定です。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الخطوط والألوان والمؤشر وروابط المفاتيح هي إعدادات Ghostty."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fontovi, boje, kursor i prečice su Ghostty postavke."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skrifter, farver, markør og tastebindinger er Ghostty-indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schriften, Farben, Cursor und Tastenbelegungen sind Ghostty-Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las fuentes, los colores, el cursor y los atajos son ajustes de Ghostty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les polices, couleurs, curseur et raccourcis sont des réglages Ghostty."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Font, colori, cursore e scorciatoie sono impostazioni di Ghostty."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ពុម្ពអក្សរ ពណ៌ ទស្សន៍ទ្រនិច និងការភ្ជាប់គ្រាប់ចុចគឺជាការកំណត់ Ghostty។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "서체, 색상, 커서, 키 바인딩은 Ghostty 설정입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skrifter, farger, markør og tastebindinger er Ghostty-innstillinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Czcionki, kolory, kursor i skróty to ustawienia Ghostty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fontes, cores, cursor e atalhos são ajustes do Ghostty."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Шрифты, цвета, курсор и привязки клавиш настраиваются в Ghostty."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แบบอักษร สี เคอร์เซอร์ และการผูกปุ่มเป็นการตั้งค่าของ Ghostty"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yazı tipleri, renkler, imleç ve tuş atamaları Ghostty ayarlarıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Шрифти, кольори, курсор і прив’язки клавіш налаштовуються в Ghostty."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Phông chữ, màu, con trỏ và phím tắt là cài đặt của Ghostty."
          }
        },
        "zh-Hans": {
          "stringUnit": {
