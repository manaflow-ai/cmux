    "settingsPage.theme.terminalHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bundled Ghostty themes. Each one also works as the app theme."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ سمة Ghostty مضمّنة. تصلح كلٌّ منها أيضًا سمةً للتطبيق."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ugrađenih Ghostty tema. Svaka radi i kao tema aplikacije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ medfølgende Ghostty-temaer. Hvert tema virker også som apptema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ mitgelieferte Ghostty-Designs. Jedes funktioniert auch als App-Design."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ temas de Ghostty incluidos. Cada uno sirve también como tema de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ thèmes Ghostty fournis. Chacun fonctionne aussi comme thème de l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ temi Ghostty inclusi. Ognuno funziona anche come tema dell’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "同梱のGhosttyテーマ%@個。どれもアプリのテーマとして使えます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "រូបរាង Ghostty ភ្ជាប់មកជាមួយ %@។ នីមួយៗក៏ប្រើជារូបរាងកម្មវិធីបានដែរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기본 제공 Ghostty 테마 %@개. 모두 앱 테마로도 쓸 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ medfølgende Ghostty-temaer. Hvert tema fungerer også som apptema."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ wbudowanych motywów Ghostty. Każdy działa też jako motyw aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ temas do Ghostty incluídos. Cada um também funciona como tema do app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Встроенных тем Ghostty: %@. Каждая подходит и как тема приложения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ธีม Ghostty ในตัว %@ ธีม แต่ละธีมใช้เป็นธีมของแอปได้ด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ yerleşik Ghostty teması. Her biri uygulama teması olarak da çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вбудованих тем Ghostty: %@. Кожна підходить і як тема застосунку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ chủ đề Ghostty có sẵn. Mỗi chủ đề cũng dùng được làm chủ đề ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "内置 %@ 个 Ghostty 主题,每个都可用作应用主题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "內建 %@ 個 Ghostty 主題,每個都可用作 App 主題。"
          }
        }
      }
    },
