    "settingsWindow.harnesses.problem.unreachable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux did not answer. Open an agent chat to start it, then click Refresh."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يستجب acpmux. افتح محادثة وكيل لتشغيله، ثم انقر تحديث."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux nije odgovorio. Otvorite razgovor s agentom da ga pokrenete, pa kliknite Osvježi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux svarede ikke. Åbn en agentchat for at starte den, og klik så Opdater."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux hat nicht geantwortet. Öffnen Sie einen Agenten-Chat, um es zu starten, und klicken Sie dann auf Aktualisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux no respondió. Abre un chat de agente para iniciarlo y luego haz clic en Actualizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux n'a pas répondu. Ouvrez une discussion d'agent pour le lancer, puis cliquez sur Actualiser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux non ha risposto. Apri una chat con un agente per avviarlo, poi fai clic su Aggiorna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux が応答しませんでした。エージェントチャットを開いて起動してから、「更新」をクリックしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux មិនបានឆ្លើយទេ។ បើកការជជែកភ្នាក់ងារដើម្បីចាប់ផ្ដើម បន្ទាប់មកចុច ផ្ទុកឡើងវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux가 응답하지 않았습니다. 에이전트 채팅을 열어 시작한 다음 새로 고침을 클릭하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux svarte ikke. Åpne en agentchat for å starte den, og klikk deretter Oppdater."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux nie odpowiedział. Otwórz czat z agentem, aby go uruchomić, a potem kliknij Odśwież."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O acpmux não respondeu. Abra um chat de agente para iniciá-lo e clique em Atualizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux не ответил. Откройте чат с агентом, чтобы запустить его, затем нажмите «Обновить»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux ไม่ตอบสนอง เปิดแชตเอเจนต์เพื่อเริ่ม แล้วคลิกรีเฟรช"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux yanıt vermedi. Başlatmak için bir ajan sohbeti açın, sonra Yenile'ye tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux не відповів. Відкрийте чат з агентом, щоб запустити його, потім натисніть «Оновити»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux không phản hồi. Mở một cuộc trò chuyện với tác nhân để khởi động, rồi bấm Làm mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux 没有响应。打开一个代理聊天来启动它，然后点击“刷新”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux 沒有回應。開啟一個代理聊天來啟動它，然後點按「重新整理」。"
          }
        }
      }
    },
    "settingsWindow.harnesses.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No harness found. Install a coding agent such as Claude Code or Codex, or add one from the ACP Registry."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يُعثر على أي أداة. ثبّت وكيل برمجة مثل Claude Code أو Codex، أو أضف واحدًا من سجل ACP."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nije pronađeno okruženje. Instalirajte agenta za kodiranje poput Claude Code ili Codex, ili dodajte jednog iz ACP registra."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Intet agentmiljø fundet. Installér en kodeagent som Claude Code eller Codex, eller tilføj en fra ACP-registret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kein Harness gefunden. Installieren Sie einen Coding-Agenten wie Claude Code oder Codex oder fügen Sie einen aus der ACP-Registry hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se encontró ningún entorno. Instala un agente de código como Claude Code o Codex, o añade uno del registro ACP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun environnement trouvé. Installez un agent de code comme Claude Code ou Codex, ou ajoutez-en un depuis le registre ACP."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessun ambiente trovato. Installa un agente di programmazione come Claude Code o Codex, oppure aggiungine uno dal registro ACP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハーネスが見つかりません。Claude Code や Codex などのコーディングエージェントをインストールするか、ACP Registry から追加してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "រកមិនឃើញទេ។ ដំឡើងភ្នាក់ងារសរសេរកូដដូចជា Claude Code ឬ Codex ឬបន្ថែមពីបញ្ជី ACP។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "하네스를 찾지 못했습니다. Claude Code나 Codex 같은 코딩 에이전트를 설치하거나 ACP 레지스트리에서 추가하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fant ingen agentmiljøer. Installer en kodeagent som Claude Code eller Codex, eller legg til en fra ACP-registeret."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie znaleziono środowiska. Zainstaluj agenta kodującego, np. Claude Code lub Codex, albo dodaj go z rejestru ACP."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhum ambiente encontrado. Instale um agente de código como Claude Code ou Codex, ou adicione um do registro ACP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Среды не найдены. Установите агента для кода, например Claude Code или Codex, или добавьте его из реестра ACP."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่พบสภาพแวดล้อม ติดตั้งเอเจนต์เขียนโค้ด เช่น Claude Code หรือ Codex หรือเพิ่มจาก ACP Registry"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ortam bulunamadı. Claude Code veya Codex gibi bir kodlama ajanı yükleyin ya da ACP Kayıt Defterinden ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Середовищ не знайдено. Установіть агента для коду, наприклад Claude Code чи Codex, або додайте його з реєстру ACP."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không tìm thấy. Hãy cài một tác nhân lập trình như Claude Code hoặc Codex, hoặc thêm từ ACP Registry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未找到代理环境。请安装 Claude Code 或 Codex 等编程代理，或从 ACP 注册表添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "找不到代理環境。請安裝 Claude Code 或 Codex 等程式代理，或從 ACP 登錄新增。"
          }
        }
      }
    },
