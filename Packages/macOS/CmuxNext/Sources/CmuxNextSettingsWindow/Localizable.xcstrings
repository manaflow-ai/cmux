    "settingsPage.theme.appHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surfaces, text and the accent come from the theme’s palette, and every color meets WCAG AA contrast."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تأتي الأسطح والنص ولون التمييز من لوحة السمة، وكل لون يستوفي تباين WCAG AA."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Površine, tekst i akcent dolaze iz palete teme, a svaka boja ispunjava WCAG AA kontrast."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Flader, tekst og accent kommer fra temaets palet, og alle farver opfylder WCAG AA-kontrast."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Flächen, Text und Akzent stammen aus der Palette des Designs; jede Farbe erfüllt den WCAG-AA-Kontrast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Superficies, texto y acento salen de la paleta del tema, y cada color cumple el contraste WCAG AA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Surfaces, texte et accent viennent de la palette du thème, et chaque couleur respecte le contraste WCAG AA."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Superfici, testo e accento vengono dalla palette del tema e ogni colore rispetta il contrasto WCAG AA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "背景、テキスト、アクセントはテーマのパレットから作られ、どの色もWCAG AAのコントラストを満たします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទៃ អត្ថបទ និងពណ៌សង្កត់បានមកពីក្ដារលាយពណ៌របស់រូបរាង ហើយពណ៌នីមួយៗបំពេញកម្រិតកម្រិតពណ៌ WCAG AA។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "배경, 텍스트, 강조 색상은 테마 팔레트에서 오며 모든 색상이 WCAG AA 대비를 충족합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Flater, tekst og aksent kommer fra temaets palett, og alle farger oppfyller WCAG AA-kontrast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Powierzchnie, tekst i akcent pochodzą z palety motywu, a każdy kolor spełnia kontrast WCAG AA."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Superfícies, texto e destaque vêm da paleta do tema, e toda cor atende ao contraste WCAG AA."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Фон, текст и акцент берутся из палитры темы; каждый цвет соответствует контрасту WCAG AA."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "พื้นผิว ข้อความ และสีเน้นมาจากชุดสีของธีม และทุกสีผ่านค่าความต่างสี WCAG AA"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yüzeyler, metin ve vurgu temanın paletinden gelir; her renk WCAG AA kontrastını karşılar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Фон, текст і акцент беруться з палітри теми; кожен колір відповідає контрасту WCAG AA."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nền, chữ và màu nhấn lấy từ bảng màu của chủ đề, mọi màu đều đạt độ tương phản WCAG AA."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "背景、文本和强调色来自主题的调色板,每种颜色都达到 WCAG AA 对比度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "背景、文字和強調色來自主題的調色盤,每種顏色都達到 WCAG AA 對比度。"
          }
        }
      }
    },
