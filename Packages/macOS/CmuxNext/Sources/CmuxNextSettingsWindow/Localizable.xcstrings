    "settingsPage.theme.overrides.releaseHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns these lines into comments. The old values stay in the file."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحوّل هذه الأسطر إلى تعليقات. تبقى القيم القديمة في الملف."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretvara ove redove u komentare. Stare vrijednosti ostaju u datoteci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gør disse linjer til kommentarer. De gamle værdier bliver i filen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Macht diese Zeilen zu Kommentaren. Die alten Werte bleiben in der Datei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte estas líneas en comentarios. Los valores anteriores se quedan en el archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme ces lignes en commentaires. Les anciennes valeurs restent dans le fichier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma queste righe in commenti. I vecchi valori restano nel file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの行をコメントにします。元の値はファイルに残ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ប្ដូរបន្ទាត់ទាំងនេះទៅជាមតិយោបល់។ តម្លៃចាស់នៅតែមានក្នុងឯកសារ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 줄을 주석으로 바꿉니다. 이전 값은 파일에 남습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør disse linjene om til kommentarer. De gamle verdiene blir værende i filen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamienia te wiersze w komentarze. Stare wartości zostają w pliku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforma essas linhas em comentários. Os valores antigos ficam no arquivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Превращает эти строки в комментарии. Старые значения остаются в файле."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนบรรทัดเหล่านี้เป็นความคิดเห็น ค่าเดิมยังอยู่ในไฟล์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu satırları yorum satırına çevirir. Eski değerler dosyada kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетворює ці рядки на коментарі. Старі значення залишаються у файлі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển các dòng này thành chú thích. Giá trị cũ vẫn nằm trong tệp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将这些行改为注释。旧值仍保留在文件中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將這些行改為註解。舊值仍保留在檔案中。"
          }
        }
      }
    },
