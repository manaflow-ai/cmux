    "settingsPage.theme.overrides.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Ghostty config sets %@, so terminal themes cannot change these colors. The App Theme does not use them."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضبط ملف إعدادات Ghostty لديك %@، لذا لا يمكن لسمات الطرفية تغيير هذه الألوان. سمة التطبيق لا تتأثر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša Ghostty konfiguracija postavlja %@, pa teme terminala ne mogu promijeniti ove boje. Tema aplikacije ih ne koristi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Ghostty-konfiguration angiver %@, så terminaltemaer kan ikke ændre disse farver. Apptemaet bruger dem ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Ghostty-Konfiguration legt %@ fest, daher können Terminal-Themes diese Farben nicht ändern. Das App-Theme verwendet sie nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu configuración de Ghostty define %@, así que los temas del terminal no pueden cambiar estos colores. El tema de la app no los usa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre configuration Ghostty définit %@ : les thèmes du terminal ne peuvent donc pas modifier ces couleurs. Le thème de l’app ne les utilise pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua configurazione di Ghostty imposta %@, quindi i temi del terminale non possono cambiare questi colori. Il tema dell’app non li usa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghostty の設定で %@ が指定されているため、ターミナルテーマではこれらの色を変更できません。アプリテーマには使われません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការកំណត់ Ghostty របស់អ្នកកំណត់ %@ ដូច្នេះរចនាប័ទ្មទែមីណាល់មិនអាចប្ដូរពណ៌ទាំងនេះបានទេ។ ស្បែកកម្មវិធីមិនប្រើពួកវាទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghostty 설정에서 %@을(를) 지정하고 있어 터미널 테마로 이 색상을 바꿀 수 없습니다. 앱 테마는 이 색상을 쓰지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghostty-konfigurasjonen din angir %@, så terminaltemaer kan ikke endre disse fargene. Apptemaet bruker dem ikke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja konfiguracja Ghostty ustawia %@, więc motywy terminala nie mogą zmienić tych kolorów. Motyw aplikacji ich nie używa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua configuração do Ghostty define %@, então os temas do terminal não podem mudar essas cores. O tema do app não as usa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша конфигурация Ghostty задаёт %@, поэтому темы терминала не могут изменить эти цвета. Тема приложения их не использует."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่า Ghostty ของคุณกำหนด %@ ไว้ ธีมเทอร์มินัลจึงเปลี่ยนสีเหล่านี้ไม่ได้ ธีมแอปไม่ใช้สีเหล่านี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghostty yapılandırmanız %@ ayarlıyor, bu nedenle terminal temaları bu renkleri değiştiremez. Uygulama teması bunları kullanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша конфігурація Ghostty задає %@, тому теми термінала не можуть змінити ці кольори. Тема застосунку їх не використовує."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấu hình Ghostty của bạn đặt %@, nên chủ đề terminal không thể thay đổi các màu này. Chủ đề ứng dụng không dùng chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Ghostty 配置设置了 %@，因此终端主题无法更改这些颜色。应用主题不使用它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Ghostty 設定指定了 %@，因此終端機主題無法變更這些顏色。App 主題不使用它們。"
          }
        }
      }
    },
