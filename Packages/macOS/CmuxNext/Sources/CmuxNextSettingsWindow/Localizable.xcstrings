    "settingsPage.resetAllBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resets everything in %@. Custom actions stay."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ をすべてリセット。カスタムアクションは残ります。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعيد ضبط كل ما في %@. تبقى الإجراءات المخصصة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vraća sve u %@ na zadano. Vaše radnje ostaju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nulstiller alt i %@. Egne handlinger bevares."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Setzt alles in %@ zurück. Aktionen bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Restablece todo en %@. Tus acciones se quedan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Réinitialise tout dans %@. Vos actions restent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ripristina tutto in %@. Le tue azioni restano."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កំណត់អ្វីៗក្នុង %@ ឡើងវិញ។ សកម្មភាពផ្ទាល់ខ្លួននៅដដែល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@의 모든 항목을 재설정합니다. 사용자 동작은 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tilbakestiller alt i %@. Handlinger beholdes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Resetuje wszystko w %@. Własne akcje zostają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Redefine tudo em %@. Suas ações ficam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сбрасывает всё в %@. Свои действия остаются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "รีเซ็ตทุกอย่างใน %@ การทำงานที่กำหนดเองยังอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ içinde her şeyi sıfırlar. Eylemler kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Скидає все в %@. Власні дії залишаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đặt lại mọi thứ trong %@. Giữ hành động riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "重置 %@ 中的所有内容，自定义操作保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "重設 %@ 中的所有內容，自訂動作保留。"
          }
        }
      }
    },
