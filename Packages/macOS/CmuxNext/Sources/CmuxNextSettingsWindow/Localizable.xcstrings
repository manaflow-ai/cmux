        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境には cmux-next の Cloud 接続とサインイン済みのアカウントが必要です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បរិស្ថានត្រូវការការតភ្ជាប់ Cloud របស់ cmux-next និងគណនីដែលបានចូល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환경에는 cmux-next Cloud 연결과 로그인된 계정이 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Miljøer krever cmux-next Cloud-tilkoblingen og en pålogget konto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Środowiska wymagają połączenia Cloud cmux-next i zalogowanego konta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ambientes precisam da conexão do Cloud do cmux-next e de uma conta conectada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для окружений нужно подключение Cloud cmux-next и вход в аккаунт."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สภาพแวดล้อมต้องใช้การเชื่อมต่อ Cloud ของ cmux-next และบัญชีที่ลงชื่อเข้าใช้แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortamlar cmux-next Cloud bağlantısı ve oturum açılmış bir hesap gerektirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для середовищ потрібні з'єднання Cloud cmux-next і обліковий запис, у який виконано вхід."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Môi trường cần kết nối Cloud của cmux-next và một tài khoản đã đăng nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "环境需要 cmux-next 的 Cloud 连接和已登录的账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "環境需要 cmux-next 的 Cloud 連線和已登入的帳號。"
          }
        }
      }
