    "settingsWindow.agentIntegrations.conflict.symlink": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A symlink is here; cmux won’t edit through it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد هنا رابط رمزي؛ لن يعدّل cmux عبره."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje je simbolička veza; cmux ne uređuje kroz nju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Her er et symlink; cmux redigerer ikke gennem det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier liegt ein Symlink; cmux bearbeitet nicht darüber."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí hay un enlace simbólico; cmux no edita a través de él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est un lien symbolique ; cmux ne passe pas par lui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui c’è un link simbolico; cmux non lo attraversa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シンボリックリンクです。cmux はリンク経由で編集しません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នេះជា symlink; cmux នឹងមិនកែតាមរយៈវាទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심볼릭 링크입니다. cmux는 링크를 통해 편집하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Her er en symbolsk lenke; cmux redigerer ikke gjennom den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To dowiązanie symboliczne; cmux nie edytuje przez nie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui há um link simbólico; o cmux não edita por ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь символическая ссылка; cmux не правит через неё."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรงนี้เป็นลิงก์สัญลักษณ์ cmux จะไม่แก้ไขผ่านลิงก์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir sembolik bağlantı; cmux bunun üzerinden düzenlemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут символічне посилання; cmux не редагує через нього."
          }
