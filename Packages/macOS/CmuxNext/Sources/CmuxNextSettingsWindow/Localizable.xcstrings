    "settingsPage.chiefPet.lede": {
      "comment": "Settings > Chief Pet: line under the page title. Chief is a product name; keep it untranslated. A session is an agent or terminal session.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Floats over every app. Drag it anywhere; click it to message the Chief or reply to a session."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يطفو فوق كل التطبيقات. اسحبه إلى أي مكان؛ انقر عليه لمراسلة Chief أو الرد على جلسة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lebdi iznad svih aplikacija. Prevucite ga bilo gdje; kliknite da pošaljete poruku Chiefu ili odgovorite sesiji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svæver over alle apps. Træk den hvorhen du vil; klik for at skrive til Chief eller svare en session."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schwebt über allen Apps. Zieh ihn an eine beliebige Stelle; klick ihn an, um Chief zu schreiben oder einer Sitzung zu antworten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Flota sobre todas las apps. Arrástralo a cualquier sitio; haz clic para escribir a Chief o responder a una sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Flotte au-dessus de toutes les apps. Faites-le glisser où vous voulez ; cliquez pour écrire à Chief ou répondre à une session."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fluttua sopra tutte le app. Trascinalo ovunque; fai clic per scrivere a Chief o rispondere a una sessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "すべてのアプリの上に浮かびます。好きな場所にドラッグでき、クリックすると Chief にメッセージを送ったりセッションに返信したりできます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អណ្ដែតលើកម្មវិធីទាំងអស់។ អូសវាទៅកន្លែងណាក៏បាន ចុចដើម្បីផ្ញើសារទៅ Chief ឬឆ្លើយតបវគ្គមួយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "모든 앱 위에 떠 있습니다. 원하는 곳으로 드래그하고, 클릭하면 Chief에게 메시지를 보내거나 세션에 답장할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svever over alle apper. Dra den hvor du vil; klikk for å skrive til Chief eller svare en økt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unosi się nad wszystkimi aplikacjami. Przeciągnij go w dowolne miejsce; kliknij, aby napisać do Chief lub odpowiedzieć sesji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Flutua sobre todos os apps. Arraste para qualquer lugar; clique para escrever ao Chief ou responder a uma sessão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Парит над всеми приложениями. Перетащите куда угодно; нажмите, чтобы написать Chief или ответить сеансу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลอยอยู่เหนือทุกแอป ลากไปวางที่ใดก็ได้ คลิกเพื่อส่งข้อความถึง Chief หรือตอบกลับเซสชัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tüm uygulamaların üzerinde süzülür. İstediğiniz yere sürükleyin; Chief'e yazmak ya da bir oturuma yanıt vermek için tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ширяє над усіма застосунками. Перетягніть куди завгодно; натисніть, щоб написати Chief або відповісти сеансу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nổi trên mọi ứng dụng. Kéo đến bất cứ đâu; bấm để nhắn cho Chief hoặc trả lời một phiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "浮在所有应用上方。可拖到任意位置；点按即可给 Chief 发消息或回复某个会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "浮在所有 App 上方。可拖到任何位置；點按即可傳訊息給 Chief 或回覆某個工作階段。"
          }
        }
      }
    },
