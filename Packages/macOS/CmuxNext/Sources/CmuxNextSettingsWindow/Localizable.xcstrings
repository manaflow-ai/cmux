            "value": "Goes back to %@. cmux does not take this update again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعود إلى %@. لن يأخذ cmux هذا التحديث مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraća verziju %@. cmux ovo ažuriranje više ne preuzima."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Går tilbage til %@. cmux tager ikke denne opdatering igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehrt zu %@ zurück. cmux übernimmt dieses Update nicht erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a %@. cmux no volverá a aplicar esta actualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revient à %@. cmux ne reprendra pas cette mise à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna a %@. cmux non riprenderà questo aggiornamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に戻します。cmux はこのアップデートを再び取り込みません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ត្រឡប់ទៅ %@។ cmux នឹងមិនយកបច្ចុប្បន្នភាពនេះម្ដងទៀតទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(으)로 돌아갑니다. cmux는 이 업데이트를 다시 받지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Går tilbake til %@. cmux tar ikke denne oppdateringen igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wraca do %@. cmux nie przyjmie ponownie tej aktualizacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta para %@. O cmux não aplicará esta atualização de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращает %@. cmux больше не примет это обновление."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กลับไปใช้ %@ cmux จะไม่รับอัปเดตนี้อีก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sürümüne döner. cmux bu güncellemeyi yeniden almaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повертає %@. cmux більше не прийме це оновлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quay về %@. cmux sẽ không nhận lại bản cập nhật này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到 %@。cmux 不会再采用此更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回到 %@。cmux 不會再採用此更新。"
          }
        }
      }
    },
    "settingsWindow.webUpdates.checkFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux could not check for a web UI update."
