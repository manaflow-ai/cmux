    "settingsPage.agents.icon.help": {
      "comment": "Settings > Agents: a custom harness's icon (user 12922); keep SF Symbol, PNG, SVG and the examples exactly",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type one emoji (🦊), an SF Symbol name (hammer.fill) or an agent (claude, goose), or choose or drop a PNG or SVG. Automatic shows the agent its command runs, else its initials."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絵文字 1 つ (🦊)、SF Symbol 名 (hammer.fill)、エージェント名 (claude、goose) を入力するか、PNG か SVG を選択またはドロップします。自動では、コマンドが実行するエージェント、なければ頭文字を表示します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اكتب رمزًا تعبيريًا واحدًا (🦊) أو اسم SF Symbol (hammer.fill) أو وكيلًا (claude، goose)، أو اختر ملف PNG أو SVG أو أفلته. التلقائي يعرض الوكيل الذي يشغّله الأمر، وإلا الأحرف الأولى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Upišite jedan emoji (🦊), naziv SF Symbola (hammer.fill) ili agenta (claude, goose), ili odaberite ili ispustite PNG ili SVG. Automatski prikazuje agenta kojeg naredba pokreće, inače inicijale."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skriv én emoji (🦊), et SF Symbol-navn (hammer.fill) eller en agent (claude, goose), eller vælg eller slip en PNG eller SVG. Automatisk viser den agent, kommandoen kører, ellers initialerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gib ein Emoji (🦊), einen SF-Symbol-Namen (hammer.fill) oder einen Agenten (claude, goose) ein, oder wähle oder ziehe eine PNG- oder SVG-Datei hierher. Automatisch zeigt den Agenten, den der Befehl startet, sonst die Initialen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escribe un emoji (🦊), un nombre de SF Symbol (hammer.fill) o un agente (claude, goose), o elige o suelta un PNG o SVG. Automático muestra el agente que ejecuta su comando o, si no, sus iniciales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saisissez un emoji (🦊), un nom de SF Symbol (hammer.fill) ou un agent (claude, goose), ou choisissez ou déposez un PNG ou un SVG. Automatique affiche l’agent que lance sa commande, sinon ses initiales."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Digita un’emoji (🦊), un nome SF Symbol (hammer.fill) o un agente (claude, goose), oppure scegli o trascina un PNG o SVG. Automatica mostra l’agente eseguito dal comando, altrimenti le iniziali."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "វាយ emoji មួយ (🦊) ឈ្មោះ SF Symbol (hammer.fill) ឬភ្នាក់ងារ (claude, goose) ឬជ្រើស ឬទម្លាក់ PNG ឬ SVG។ ស្វ័យប្រវត្តិបង្ហាញភ្នាក់ងារដែលពាក្យបញ្ជារត់ បើមិនដូច្នោះទេ អក្សរកាត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이모지 하나(🦊), SF Symbol 이름(hammer.fill) 또는 에이전트(claude, goose)를 입력하거나 PNG 또는 SVG를 선택하거나 끌어다 놓으세요. 자동은 명령이 실행하는 에이전트를, 없으면 머리글자를 표시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skriv én emoji (🦊), et SF Symbol-navn (hammer.fill) eller en agent (claude, goose), eller velg eller slipp en PNG eller SVG. Automatisk viser agenten kommandoen kjører, ellers initialene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wpisz jedno emoji (🦊), nazwę SF Symbol (hammer.fill) lub agenta (claude, goose) albo wybierz lub upuść plik PNG lub SVG. Automatycznie pokazuje agenta uruchamianego przez polecenie, a w innym razie inicjały."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Digite um emoji (🦊), um nome de SF Symbol (hammer.fill) ou um agente (claude, goose), ou escolha ou solte um PNG ou SVG. Automático mostra o agente que o comando executa ou, se não houver, as iniciais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Введите один эмодзи (🦊), имя SF Symbol (hammer.fill) или агента (claude, goose) либо выберите или перетащите PNG или SVG. «Автоматически» показывает агента, которого запускает команда, иначе инициалы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "พิมพ์อีโมจิหนึ่งตัว (🦊) ชื่อ SF Symbol (hammer.fill) หรือเอเจนต์ (claude, goose) หรือเลือกหรือวางไฟล์ PNG หรือ SVG อัตโนมัติจะแสดงเอเจนต์ที่คำสั่งเรียกใช้ หากไม่มีจะแสดงอักษรย่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir emoji (🦊), bir SF Symbol adı (hammer.fill) veya bir ajan (claude, goose) yazın ya da bir PNG veya SVG seçin veya bırakın. Otomatik, komutun çalıştırdığı ajanı, yoksa baş harfleri gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Введіть один емодзі (🦊), назву SF Symbol (hammer.fill) або агента (claude, goose) чи виберіть або перетягніть PNG чи SVG. «Автоматично» показує агента, якого запускає команда, інакше ініціали."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhập một emoji (🦊), tên SF Symbol (hammer.fill) hoặc một tác nhân (claude, goose), hoặc chọn hay thả tệp PNG hoặc SVG. Tự động hiển thị tác nhân mà lệnh chạy, nếu không thì chữ viết tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "输入一个表情 (🦊)、SF Symbol 名称 (hammer.fill) 或代理 (claude、goose)，或选择或拖入 PNG 或 SVG。自动显示其命令运行的代理，否则显示首字母。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "輸入一個表情符號 (🦊)、SF Symbol 名稱 (hammer.fill) 或代理 (claude、goose)，或選擇或拖入 PNG 或 SVG。自動會顯示其命令執行的代理，否則顯示首字母。"
          }
        }
      }
    },
    "settingsWindow.computerUse.phase.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cmux Computer Use helper did not respond. Restart the helper to try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يستجب مساعد cmux Computer Use. أعد تشغيل المساعد للمحاولة مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomoćni program cmux Computer Use nije odgovorio. Ponovo ga pokrenite da pokušate ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjælperen til cmux Computer Use svarede ikke. Genstart hjælperen for at prøve igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der cmux Computer Use-Helfer hat nicht geantwortet. Starten Sie den Helfer neu, um es erneut zu versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El asistente de cmux Computer Use no respondió. Reinícielo para volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’assistant cmux Computer Use n’a pas répondu. Redémarrez-le pour réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’assistente cmux Computer Use non ha risposto. Riavvialo per riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Computer Use ヘルパーから応答がありませんでした。再試行するにはヘルパーを再起動してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កម្មវិធីជំនួយ cmux Computer Use មិនបានឆ្លើយតបទេ។ ចាប់ផ្ដើមកម្មវិធីជំនួយឡើងវិញ ដើម្បីព្យាយាមម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Computer Use 도우미가 응답하지 않았습니다. 다시 시도하려면 도우미를 재시작하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjelperen for cmux Computer Use svarte ikke. Start hjelperen på nytt for å prøve igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomocnik cmux Computer Use nie odpowiedział. Uruchom go ponownie, aby spróbować jeszcze raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O auxiliar do cmux Computer Use não respondeu. Reinicie o auxiliar para tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помощник cmux Computer Use не ответил. Перезапустите помощник, чтобы повторить попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวช่วย cmux Computer Use ไม่ตอบสนอง เริ่มตัวช่วยใหม่เพื่อลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Computer Use yardımcısı yanıt vermedi. Yeniden denemek için yardımcıyı yeniden başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Помічник cmux Computer Use не відповів. Перезапустіть помічник, щоб спробувати ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình trợ giúp cmux Computer Use không phản hồi. Khởi động lại trình trợ giúp để thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Computer Use 助手未响应。请重启助手以重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Computer Use 輔助程式沒有回應。請重新啟動輔助程式以重試。"
          }
        }
      }
    },
    "settingsWindow.computerUse.upstreamFallback": {
      "comment": "Settings > Computer Use status line, before the helper status: driver Upstream was chosen, but this build has no upstream helper, so the legacy helper runs.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upstream helper isn't in this build; using Legacy."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مساعد Upstream غير موجود في هذا الإصدار؛ يُستخدم Legacy."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Upstream pomoćnik nije u ovoj verziji; koristi se Legacy."
          }
        },
        "da": {
