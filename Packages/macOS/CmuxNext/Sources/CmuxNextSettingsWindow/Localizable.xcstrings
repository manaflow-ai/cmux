    "settingsWindow.computerUse.setUpHelp": {
      "comment": "Settings > Agents > Computer Use: help under Guided Setup while Computer Use is off",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يشغّل Computer Use ويرشدك خلال أذونات macOS التي يحتاجها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uključuje Computer Use i vodi kroz potrebne macOS dozvole."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slår Computer Use til og guider dig gennem tilladelserne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schaltet Computer Use ein, führt durch die Berechtigungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns on Computer Use and walks you through its permissions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activa Computer Use y te guía por los permisos de macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Active Computer Use et vous guide dans les autorisations."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Attiva Computer Use e ti guida tra i permessi di macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use をオンにし、必要な macOS の許可を順に案内します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បើក Computer Use ហើយណែនាំអ្នកតាមការអនុញ្ញាត macOS ដែលវាត្រូវការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Computer Use를 켜고 필요한 macOS 권한을 차례로 안내합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slår på Computer Use og leder deg gjennom tillatelsene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Włącza Computer Use i prowadzi przez uprawnienia macOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ativa o Computer Use e guia você pelas permissões do macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Включает Computer Use и проводит через разрешения macOS."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิด Computer Use และพาคุณผ่านสิทธิ์ของ macOS ที่จำเป็น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Computer Use'u açar ve macOS izinlerinde yol gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вмикає Computer Use і проводить через дозволи macOS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bật Computer Use và hướng dẫn qua các quyền macOS cần thiết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "开启 Computer Use，并引导你完成所需的 macOS 权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "開啟 Computer Use，並引導你完成所需的 macOS 權限。"
          }
        }
      }
    },
