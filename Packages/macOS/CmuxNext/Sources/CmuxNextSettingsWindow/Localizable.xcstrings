    "settingsWindow.ghosttyDiagnostics.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux reads your Ghostty config. These lines have no effect in cmux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux は Ghostty の設定を読み込みます。次の行は cmux では効果がありません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يقرأ cmux إعدادات Ghostty. لا تأثير لهذه الأسطر في cmux."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux čita vašu Ghostty konfiguraciju. Ovi redovi nemaju učinka u cmuxu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux læser din Ghostty-konfiguration. Disse linjer har ingen virkning i cmux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux liest deine Ghostty-Konfiguration. Diese Zeilen wirken in cmux nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux lee tu configuración de Ghostty. Estas líneas no tienen efecto en cmux."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux lit votre configuration Ghostty. Ces lignes n’ont aucun effet dans cmux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux legge la tua configurazione di Ghostty. Queste righe non hanno effetto in cmux."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux អានការកំណត់ Ghostty របស់អ្នក។ បន្ទាត់ទាំងនេះគ្មានឥទ្ធិពលនៅក្នុង cmux ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux는 Ghostty 설정을 읽습니다. 다음 줄은 cmux에서 효과가 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux leser Ghostty-konfigurasjonen din. Disse linjene har ingen virkning i cmux."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux odczytuje konfigurację Ghostty. Te wiersze nie działają w cmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cmux lê sua configuração do Ghostty. Estas linhas não têm efeito no cmux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux читает вашу конфигурацию Ghostty. Эти строки не действуют в cmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux อ่านการตั้งค่า Ghostty ของคุณ บรรทัดเหล่านี้ไม่มีผลใน cmux"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux Ghostty yapılandırmanızı okur. Bu satırların cmux’ta etkisi yoktur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux читає вашу конфігурацію Ghostty. Ці рядки не діють у cmux."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux đọc cấu hình Ghostty của bạn. Các dòng này không có tác dụng trong cmux."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 会读取你的 Ghostty 配置。以下各行在 cmux 中不起作用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 會讀取你的 Ghostty 設定。以下各行在 cmux 中不會生效。"
          }
        }
      }
    },
