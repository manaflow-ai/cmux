    "settingsWindow.webUpdates.refusal.untrusted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The newest update is not signed by cmux, so cmux did not take it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحدث تحديث غير موقّع من cmux، لذا لم يأخذه cmux."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najnovije ažuriranje nije potpisao cmux, pa ga cmux nije preuzeo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den nyeste opdatering er ikke signeret af cmux, så cmux tog den ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das neueste Update ist nicht von cmux signiert, daher hat cmux es nicht übernommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización más reciente no está firmada por cmux, así que cmux no la aplicó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour la plus récente n’est pas signée par cmux : cmux ne l’a pas prise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aggiornamento più recente non è firmato da cmux, quindi cmux non l’ha preso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新のアップデートは cmux の署名がないため、cmux は取り込みませんでした。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បច្ចុប្បន្នភាពថ្មីបំផុតមិនបានចុះហត្ថលេខាដោយ cmux ទេ ដូច្នេះ cmux មិនបានយកវាទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신 업데이트에 cmux 서명이 없어 cmux가 받지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den nyeste oppdateringen er ikke signert av cmux, så cmux tok den ikke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najnowsza aktualizacja nie jest podpisana przez cmux, więc cmux jej nie przyjął."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualização mais recente não é assinada pelo cmux, então o cmux não a aplicou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новейшее обновление не подписано cmux, поэтому cmux его не принял."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเดตล่าสุดไม่ได้ลงนามโดย cmux cmux จึงไม่รับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En yeni güncelleme cmux tarafından imzalanmamış, bu yüzden cmux onu almadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найновіше оновлення не підписане cmux, тому cmux його не прийняв."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản cập nhật mới nhất không được cmux ký nên cmux không nhận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最新更新没有 cmux 的签名,因此 cmux 未采用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最新更新沒有 cmux 的簽章,因此 cmux 未採用。"
          }
        }
      }
    },
