          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’helper Upstream non è in questa build; viene usato Legacy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドには Upstream ヘルパーがないため、Legacy を使っています。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កម្មវិធីជំនួយ Upstream មិនមាននៅក្នុងកំណែនេះទេ; កំពុងប្រើ Legacy។"
