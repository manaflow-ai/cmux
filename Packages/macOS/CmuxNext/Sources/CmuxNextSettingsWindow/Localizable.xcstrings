            "value": "Los entornos necesitan la conexión de Cloud de cmux-next y una cuenta con sesión iniciada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les environnements nécessitent la connexion Cloud cmux-next et un compte connecté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli ambienti richiedono la connessione Cloud cmux-next e un account con accesso effettuato."
