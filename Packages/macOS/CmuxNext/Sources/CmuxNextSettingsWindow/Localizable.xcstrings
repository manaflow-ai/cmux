    "settingsPage.loadFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings could not be read from cmux. Values shown are defaults and cannot be changed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux から設定を読み込めませんでした。表示されている値は既定値で、変更できません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذرت قراءة الإعدادات من cmux. القيم المعروضة افتراضية ولا يمكن تغييرها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Postavke se nisu mogle pročitati iz cmux-a. Prikazane vrijednosti su zadane i ne mogu se mijenjati."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Indstillingerne kunne ikke læses fra cmux. De viste værdier er standardværdier og kan ikke ændres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Einstellungen konnten nicht aus cmux gelesen werden. Die angezeigten Werte sind Standardwerte und können nicht geändert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudieron leer los ajustes de cmux. Los valores mostrados son predeterminados y no se pueden cambiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de lire les réglages depuis cmux. Les valeurs affichées sont celles par défaut et ne peuvent pas être modifiées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile leggere le impostazioni da cmux. I valori mostrati sono predefiniti e non possono essere modificati."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនអាចអានការកំណត់ពី cmux បានទេ។ តម្លៃដែលបង្ហាញជាតម្លៃលំនាំដើម ហើយមិនអាចផ្លាស់ប្ដូរបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux에서 설정을 읽을 수 없습니다. 표시된 값은 기본값이며 변경할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Innstillingene kunne ikke leses fra cmux. Verdiene som vises er standardverdier og kan ikke endres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie można odczytać ustawień z cmux. Wyświetlane wartości są domyślne i nie można ich zmienić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível ler os ajustes do cmux. Os valores mostrados são padrões e não podem ser alterados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось прочитать настройки из cmux. Показаны значения по умолчанию, их нельзя изменить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่สามารถอ่านการตั้งค่าจาก cmux ได้ ค่าที่แสดงเป็นค่าเริ่มต้นและเปลี่ยนไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ayarlar cmux'tan okunamadı. Gösterilen değerler varsayılandır ve değiştirilemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не вдалося прочитати налаштування з cmux. Показано типові значення, їх не можна змінити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thể đọc cài đặt từ cmux. Các giá trị hiển thị là mặc định và không thể thay đổi."
