    "settingsWindow.computerUse.screenRecording.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets agents see the windows they work in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが作業中のウインドウを見られるようにします。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتيح للوكلاء رؤية النوافذ التي يعملون فيها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Omogućava agentima da vide prozore u kojima rade."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lader agenter se de vinduer, de arbejder i."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erlaubt Agenten, die Fenster zu sehen, in denen sie arbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite a los agentes ver las ventanas en las que trabajan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permet aux agents de voir les fenêtres dans lesquelles ils travaillent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consente agli agenti di vedere le finestre in cui lavorano."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អនុញ្ញាតឱ្យភ្នាក់ងារមើលឃើញបង្អួចដែលពួកវាធ្វើការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트가 작업 중인 윈도우를 볼 수 있게 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lar agenter se vinduene de jobber i."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pozwala agentom widzieć okna, w których pracują."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite que agentes vejam as janelas em que trabalham."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Позволяет агентам видеть окна, в которых они работают."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ให้เอเจนต์เห็นหน้าต่างที่กำลังทำงานอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
