    "settingsWindow.agentIntegrations.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets cmux show when an agent is working or waiting."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح لـ cmux أن يعرض متى يعمل الوكيل أو ينتظر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux tako prikazuje kada agent radi ili čeka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lader cmux vise, når en agent arbejder eller venter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit zeigt cmux, ob ein Agent arbeitet oder wartet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite a cmux mostrar si un agente trabaja o espera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à cmux d’indiquer si un agent travaille ou attend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Permette a cmux di mostrare se un agente lavora o attende."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが作業中か待機中かを cmux に表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អនុញ្ញាតឱ្យ cmux បង្ហាញពេលភ្នាក់ងារកំពុងធ្វើការ ឬរង់ចាំ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 작업 중인지 대기 중인지 cmux에 표시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lar cmux vise når en agent jobber eller venter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala cmux pokazać, czy agent pracuje, czy czeka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite ao cmux mostrar se um agente trabalha ou espera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux будет показывать, работает агент или ждёт."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้ cmux แสดงว่าเอเจนต์กำลังทำงานหรือรออยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux, ajanın çalıştığını veya beklediğini gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux показуватиме, чи агент працює, чи чекає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho cmux hiển thị khi tác tử đang làm việc hoặc chờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 cmux 显示智能体正在工作还是在等待。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓 cmux 顯示代理正在工作還是在等待。"
          }
        }
      }
    },
