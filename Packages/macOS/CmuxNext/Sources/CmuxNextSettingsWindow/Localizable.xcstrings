    "settingsWindow.menus.customizeItem.help": {
      "comment": "Settings > Menus: line under the Show Customize Menu… switch; 'it' is the Customize Menu… row. At most 60 characters.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds it to the end of every right-click menu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيفه إلى نهاية كل قائمة للنقر بزر الماوس الأيمن."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje ga na kraj svakog menija desnog klika."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføjer den nederst i hver højrekliksmenu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt den Eintrag am Ende jedes Kontextmenüs hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo añade al final de cada menú contextual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ajoute à la fin de chaque menu contextuel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo aggiunge alla fine di ogni menu contestuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての右クリックメニューの末尾に追加します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បន្ថែមវាទៅចុងម៉ឺនុយចុចខាងស្តាំនីមួយៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 오른쪽 클릭 메뉴의 끝에 추가합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legger den til nederst i hver høyreklikkmeny."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje go na końcu każdego menu kontekstowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona ao final de cada menu de contexto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет его в конец каждого контекстного меню."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มไว้ท้ายเมนูคลิกขวาทุกเมนู"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sağ tık menüsünün sonuna ekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додає його в кінець кожного контекстного меню."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm vào cuối mọi menu chuột phải."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将其添加到每个右键菜单的末尾。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將其加入每個右鍵選單的末尾。"
          }
        }
      }
    },
