        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនស្គាល់លទ្ធផលទេ។ កុំចាប់ផ្តើមធ្វើបច្ចុប្បន្នភាពផ្សេងទៀត។"
