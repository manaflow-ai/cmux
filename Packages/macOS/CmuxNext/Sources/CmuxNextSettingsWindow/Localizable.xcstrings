            "value": "Bản cập nhật mới nhất không khớp với chữ ký nên cmux không nhận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最新更新与其签名不符,因此 cmux 未采用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最新更新與其簽章不符,因此 cmux 未採用。"
          }
        }
      }
    },
    "settingsWindow.webUpdates.refusal.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux could not reach the update server. It tries again at the next check."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على cmux الوصول إلى خادم التحديثات. سيحاول مجددًا في الفحص التالي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nije mogao doći do servera za ažuriranja. Pokušava ponovo pri sljedećoj provjeri."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux kunne ikke nå opdateringsserveren. Den prøver igen ved næste søgning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux konnte den Update-Server nicht erreichen. Bei der nächsten Prüfung versucht es cmux erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no pudo conectar con el servidor de actualizaciones. Lo intentará de nuevo en la próxima comprobación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux n’a pas pu joindre le serveur de mises à jour. Il réessaiera à la prochaine vérification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux non è riuscito a raggiungere il server degli aggiornamenti. Riproverà al prossimo controllo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux がアップデートサーバーに接続できませんでした。次回の確認でもう一度試します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux មិនអាចភ្ជាប់ទៅម៉ាស៊ីនមេបច្ចុប្បន្នភាពបានទេ។ វានឹងព្យាយាមម្ដងទៀតនៅការពិនិត្យបន្ទាប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 업데이트 서버에 연결하지 못했습니다. 다음 확인 때 다시 시도합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nådde ikke oppdateringsserveren. Den prøver igjen ved neste sjekk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nie mógł połączyć się z serwerem aktualizacji. Spróbuje ponownie przy następnym sprawdzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux não conseguiu acessar o servidor de atualizações. Ele tentará de novo na próxima verificação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux не смог связаться с сервером обновлений. Он попробует снова при следующей проверке."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux เข้าถึงเซิร์ฟเวอร์อัปเดตไม่ได้ จะลองอีกครั้งในการตรวจครั้งถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux güncelleme sunucusuna ulaşamadı. Bir sonraki denetimde yeniden dener."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux не зміг з’єднатися із сервером оновлень. Він спробує знову під час наступної перевірки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux không kết nối được máy chủ cập nhật. Nó sẽ thử lại ở lần kiểm tra sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 无法连接更新服务器,会在下次检查时重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 無法連線到更新伺服器,會在下次檢查時重試。"
          }
        }
      }
    },
    "settingsWindow.webUpdates.refusal.app_too_old": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The newest web UI needs a newer cmux app. It arrives with the next app update."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج أحدث واجهة ويب إلى إصدار أحدث من تطبيق cmux. ستصل مع تحديث التطبيق التالي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najnovije web sučelje treba noviju cmux aplikaciju. Stiže sa sljedećim ažuriranjem aplikacije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den nyeste webbrugerflade kræver en nyere cmux-app. Den kommer med næste appopdatering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neueste Web-Oberfläche braucht eine neuere cmux-App. Sie kommt mit dem nächsten App-Update."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La interfaz web más reciente necesita una app de cmux más nueva. Llegará con la próxima actualización de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière interface web demande une app cmux plus récente. Elle arrivera avec la prochaine mise à jour de l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’interfaccia web più recente richiede un’app cmux più nuova. Arriverà con il prossimo aggiornamento dell’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新の Web UI には新しい cmux アプリが必要です。次回のアプリアップデートで届きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចំណុចប្រទាក់វេបថ្មីបំផុតត្រូវការកម្មវិធី cmux ថ្មីជាងនេះ។ វានឹងមកជាមួយបច្ចុប្បន្នភាពកម្មវិធីបន្ទាប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신 웹 UI는 더 새로운 cmux 앱이 필요합니다. 다음 앱 업데이트와 함께 제공됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det nyeste nettgrensesnittet krever en nyere cmux-app. Det kommer med neste appoppdatering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najnowszy interfejs webowy wymaga nowszej aplikacji cmux. Pojawi się z następną aktualizacją aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A interface web mais recente precisa de um app cmux mais novo. Ela chega com a próxima atualização do app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новейшему веб-интерфейсу нужно более новое приложение cmux. Он придёт со следующим обновлением приложения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "UI เว็บล่าสุดต้องใช้แอป cmux ที่ใหม่กว่า จะมาพร้อมอัปเดตแอปครั้งถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En yeni web arayüzü daha yeni bir cmux uygulaması gerektirir. Bir sonraki uygulama güncellemesiyle gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найновішому вебінтерфейсу потрібна новіша програма cmux. Він прийде з наступним оновленням програми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao diện web mới nhất cần ứng dụng cmux mới hơn. Nó sẽ đến cùng bản cập nhật ứng dụng tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最新网页界面需要更新版本的 cmux 应用,会随下次应用更新一起到来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最新網頁介面需要更新版本的 cmux 應用程式,會隨下次應用程式更新一起到來。"
          }
        }
      }
    },
