            "state": "translated",
            "value": "Use one theme in Light mode and another in Dark mode."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "استخدم سمة في الوضع الفاتح وأخرى في الوضع الداكن."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jedna tema u svijetlom, druga u tamnom načinu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brug ét tema i lys tilstand og et andet i mørk tilstand."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Design im hellen und ein anderes im dunklen Modus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un tema en modo claro y otro en modo oscuro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un thème en mode clair, un autre en mode sombre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un tema in modalità chiara e uno in modalità scura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ライトモードとダークモードで別のテーマを使います。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ប្រើរូបរាងមួយក្នុងរបៀបភ្លឺ និងមួយទៀតក្នុងរបៀបងងឹត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "라이트 모드와 다크 모드에 각각 다른 테마를 씁니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ett tema i lys modus og et annet i mørk modus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeden motyw w trybie jasnym, inny w ciemnym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um tema no modo Claro e outro no modo Escuro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Одна тема для светлого режима, другая для тёмного."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ใช้ธีมหนึ่งในโหมดสว่างและอีกธีมในโหมดมืด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Açık modda bir tema, koyu modda başka bir tema kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Одна тема для світлого режиму, інша для темного."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Một chủ đề cho chế độ sáng, một chủ đề cho chế độ tối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "浅色模式和深色模式各用一个主题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "淺色模式與深色模式各用一個主題。"
          }
        }
      }
    },
