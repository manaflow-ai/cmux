    "settingsWindow.backdropPicker.notMedia": {
      "comment": "Shown when a background link or file is not an image or a video the Mac can play.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is not an image or a video this Mac can play."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا ليس صورة أو فيديو يمكن لهذا الـ Mac تشغيله."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "To nije slika ni video koji ovaj Mac može reproducirati."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ikke et billede eller en video, som denne Mac kan afspille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein Bild und kein Video, das dieser Mac abspielen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es una imagen ni un vídeo que este Mac pueda reproducir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est ni une image ni une vidéo que ce Mac peut lire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è un’immagine né un video che questo Mac può riprodurre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac で再生できる画像または動画ではありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នេះមិនមែនជារូបភាព ឬវីដេអូដែល Mac នេះអាចចាក់បានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 재생할 수 있는 이미지나 동영상이 아닙니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er ikke et bilde eller en video denne Macen kan spille av."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie jest obraz ani wideo, które ten Mac może odtworzyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não é uma imagem nem um vídeo que este Mac possa reproduzir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не изображение и не видео, которое этот Mac может воспроизвести."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่ไม่ใช่รูปภาพหรือวิดีโอที่ Mac เครื่องนี้เล่นได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, bu Mac’in oynatabileceği bir görsel veya video değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це не зображення і не відео, яке цей Mac може відтворити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây không phải hình ảnh hay video mà máy Mac này phát được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是此 Mac 能播放的图片或视频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不是此 Mac 能播放的圖片或影片。"
          }
        }
      }
    },
    "settingsWindow.backdropPicker.tooLarge": {
      "comment": "Shown when a linked background file is over the size limit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That file is too big: up to 50 MB for an image, 500 MB for a video."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الملف كبير جدًا: حتى 50 ميغابايت للصورة و500 ميغابايت للفيديو."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteka je prevelika: do 50 MB za sliku, 500 MB za video."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen er for stor: op til 50 MB for et billede, 500 MB for en video."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist zu groß: bis zu 50 MB für ein Bild, 500 MB für ein Video."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo es demasiado grande: hasta 50 MB para una imagen y 500 MB para un vídeo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier est trop volumineux : 50 Mo maximum pour une image, 500 Mo pour une vidéo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file è troppo grande: fino a 50 MB per un’immagine, 500 MB per un video."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが大きすぎます。画像は 50 MB、動画は 500 MB までです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឯកសារនេះធំពេក៖ រហូតដល់ 50 MB សម្រាប់រូបភាព និង 500 MB សម្រាប់វីដេអូ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 너무 큽니다. 이미지는 50MB, 동영상은 500MB까지입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen er for stor: opptil 50 MB for et bilde, 500 MB for en video."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik jest za duży: do 50 MB dla obrazu, 500 MB dla wideo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo é grande demais: até 50 MB para imagem e 500 MB para vídeo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл слишком большой: до 50 МБ для изображения и до 500 МБ для видео."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ใหญ่เกินไป: รูปภาพได้ถึง 50 MB และวิดีโอได้ถึง 500 MB"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya çok büyük: görsel için en fazla 50 MB, video için 500 MB."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл завеликий: до 50 МБ для зображення, 500 МБ для відео."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp quá lớn: tối đa 50 MB cho hình ảnh, 500 MB cho video."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件太大：图片最多 50 MB，视频最多 500 MB。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案太大：圖片最多 50 MB，影片最多 500 MB。"
          }
        }
      }
    },
