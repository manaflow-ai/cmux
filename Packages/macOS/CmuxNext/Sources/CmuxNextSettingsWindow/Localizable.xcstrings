    "settingsWindow.webUpdates.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last check failed. cmux tries again at the next check."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل الفحص الأخير. سيحاول cmux مجددًا في الفحص التالي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posljednja provjera nije uspjela. cmux pokušava ponovo pri sljedećoj provjeri."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den seneste søgning mislykkedes. cmux prøver igen ved næste søgning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzte Prüfung ist fehlgeschlagen. cmux versucht es bei der nächsten Prüfung erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La última comprobación falló. cmux lo intentará de nuevo en la próxima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière vérification a échoué. cmux réessaiera à la prochaine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ultimo controllo non è riuscito. cmux riproverà al prossimo controllo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の確認に失敗しました。次回の確認で cmux がもう一度試します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការពិនិត្យចុងក្រោយបានបរាជ័យ។ cmux នឹងព្យាយាមម្ដងទៀតនៅការពិនិត្យបន្ទាប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 확인에 실패했습니다. 다음 확인 때 cmux가 다시 시도합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den siste sjekken mislyktes. cmux prøver igjen ved neste sjekk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnie sprawdzenie nie powiodło się. cmux spróbuje ponownie przy następnym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A última verificação falhou. O cmux tentará de novo na próxima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последняя проверка не удалась. cmux попробует снова при следующей проверке."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
