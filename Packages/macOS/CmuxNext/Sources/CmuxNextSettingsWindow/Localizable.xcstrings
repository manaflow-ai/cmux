        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há um arquivo que o cmux não criou aqui. Mova-o antes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь файл, созданный не cmux. Сначала переместите его."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีไฟล์ที่ cmux ไม่ได้สร้างอยู่ตรงนี้ ให้ย้ายออกก่อน"
