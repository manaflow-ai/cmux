        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmuxはゲートウェイ経由でリクエストを送り、Cloudflareクレジットを使用します。AI Gateway Run権限を持つトークンを貼り付けてください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
