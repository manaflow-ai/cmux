          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux는 게이트웨이를 통해 요청을 보내고 Cloudflare 크레딧을 사용합니다. AI Gateway Run 권한이 있는 토큰을 붙여넣으세요."
          }
        },
        "nb" : {
          "stringUnit" : {
