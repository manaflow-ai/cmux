{
  "sourceLanguage" : "en",
  "strings" : {
    "settingsWindow.models.dialog.cloudflare.description" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيرسل cmux الطلبات عبر بوابتك باستخدام رصيد Cloudflare. الصق رمزًا بصلاحية AI Gateway Run."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux će slati zahtjeve preko tvog pristupnika koristeći Cloudflare kredit. Zalijepi token s dozvolom AI Gateway Run."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux sender forespørgsler via din gateway og bruger dine Cloudflare-kreditter. Indsæt et token med tilladelsen AI Gateway Run."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux sendet Anfragen über dein Gateway und verwendet dein Cloudflare-Guthaben. Füge ein Token mit der Berechtigung AI Gateway Run ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux will send requests through your gateway and use your Cloudflare credits. Paste a token with AI Gateway Run permission."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux enviará solicitudes a través de tu puerta de enlace con tus créditos de Cloudflare. Pega un token con el permiso AI Gateway Run."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux enverra les requêtes via votre passerelle avec vos crédits Cloudflare. Collez un jeton avec l’autorisation AI Gateway Run."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux invierà le richieste tramite il gateway usando i tuoi crediti Cloudflare. Incolla un token con l’autorizzazione AI Gateway Run."
          }
