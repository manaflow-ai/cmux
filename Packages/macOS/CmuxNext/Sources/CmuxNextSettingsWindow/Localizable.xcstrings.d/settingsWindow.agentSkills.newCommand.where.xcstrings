{
  "sourceLanguage" : "en",
  "strings" : {
    "settingsWindow.agentSkills.newCommand.where" : {
      "comment" : "Settings > Skills > New Command: under the form. %@ is what the person types in the composer to run it (/standup, or /prompts:standup for Codex).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type %@ in the composer to use it."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اكتب %@ في محرر الرسائل لاستخدامه."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Upišite %@ u polje za poruku da ga koristite."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skriv %@ i beskedfeltet for at bruge den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gib %@ im Eingabefeld ein, um ihn zu verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Escribe %@ en el editor para usarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tapez %@ dans le champ de saisie pour l'utiliser."
