{
  "sourceLanguage" : "en",
  "strings" : {
    "settingsPage.chiefContact.privacy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Follow the confirmation instructions to connect. Text STOP to disconnect."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتبع تعليمات التأكيد للاتصال. أرسل STOP لإلغاء الربط."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slijedite upute za potvrdu da se povežete. Pošaljite STOP za prekid veze."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følg bekræftelsesvejledningen for at oprette forbindelse. Skriv STOP for at afbryde forbindelsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folge den Bestätigungsanweisungen, um die Verbindung herzustellen. Sende STOP, um sie zu trennen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue las instrucciones de confirmación para conectar. Envía STOP para desconectar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez les instructions de confirmation pour vous connecter. Envoyez STOP pour vous déconnecter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segui le istruzioni di conferma per collegarti. Invia STOP per scollegarti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認手順に従って接続してください。切断するにはSTOPと送信してください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អនុវត្តតាមការណែនាំបញ្ជាក់ដើម្បីភ្ជាប់។ ផ្ញើ STOP ដើម្បីផ្តាច់។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확인 안내에 따라 연결하세요. 연결을 끊으려면 STOP을 보내세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følg bekreftelsesinstruksjonene for å koble til. Send STOP for å koble fra."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postępuj zgodnie z instrukcjami potwierdzenia, aby się połączyć. Wyślij STOP, aby się rozłączyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siga as instruções de confirmação para conectar. Envie STOP para desconectar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следуйте инструкциям подтверждения для подключения. Отправьте STOP для отключения."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำตามคำแนะนำการยืนยันเพื่อเชื่อมต่อ ส่ง STOP เพื่อตัดการเชื่อมต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlanmak için onay talimatlarını izleyin. Bağlantıyı kesmek için STOP gönderin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дотримуйтеся інструкцій підтвердження для підключення. Надішліть STOP для відключення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Làm theo hướng dẫn xác nhận để kết nối. Nhắn STOP để ngắt kết nối."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按照确认说明完成连接。发送 STOP 即可断开连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按照確認指示完成連接。傳送 STOP 即可中斷連線。"
          }
        }
