      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes apply live unless a row says it needs a relaunch, and persist for this build. Copy changed values for an agent to bake in."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更は、再起動が必要と書かれた行を除いてすぐに反映され、このビルドで保持されます。変更した値をコピーしてエージェントに組み込んでもらってください。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُطبَّق التغييرات فورًا ما لم يذكر صف أنه يحتاج إلى إعادة تشغيل، وتبقى لهذا الإصدار. انسخ القيم المتغيرة ليثبّتها وكيل."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promjene važe odmah osim ako red kaže da treba ponovno pokretanje, i ostaju za ovaj build. Kopiraj promijenjene vrijednosti da ih agent ugradi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ændringer gælder med det samme, medmindre en række kræver genstart, og bevares for denne build. Kopiér ændrede værdier, så en agent kan bage dem ind."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen wirken sofort, außer eine Zeile verlangt einen Neustart, und bleiben für diesen Build. Kopiere geänderte Werte, damit ein Agent sie einbaut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios se aplican al momento salvo que una fila pida reiniciar, y se mantienen en esta compilación. Copia los valores cambiados para que un agente los integre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modifications s’appliquent en direct sauf si une ligne demande un redémarrage, et restent pour cette version. Copiez les valeurs modifiées pour qu’un agent les intègre."
