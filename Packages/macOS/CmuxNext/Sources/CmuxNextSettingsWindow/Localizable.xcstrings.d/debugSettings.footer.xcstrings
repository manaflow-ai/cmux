        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការផ្លាស់ប្ដូរមានប្រសិទ្ធភាពភ្លាមៗ លុះត្រាតែជួរដេកប្រាប់ថាត្រូវចាប់ផ្ដើមឡើងវិញ ហើយរក្សាទុកសម្រាប់កំណែនេះ។ ចម្លងតម្លៃដែលបានប្ដូរឱ្យភ្នាក់ងារដាក់បញ្ចូល។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변경 사항은 재시작이 필요하다고 표시된 행을 제외하고 바로 적용되며 이 빌드에서 유지됩니다. 바뀐 값을 복사해 에이전트가 반영하게 하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
