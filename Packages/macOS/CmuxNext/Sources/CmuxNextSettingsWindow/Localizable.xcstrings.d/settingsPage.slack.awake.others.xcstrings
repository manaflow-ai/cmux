{
  "sourceLanguage" : "en",
  "strings" : {
    "settingsPage.slack.awake.others" : {
      "comment" : "Settings > Accounts > Slack awake time (RFD 0123): the non-owner daily allowance and who spent it",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Others can keep your Chief awake %@ a day. Your own messages are never capped."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن للآخرين إبقاء Chief نشطًا لمدة %@ يوميًا. رسائلك أنت بلا حد."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drugi mogu držati vašeg Chiefa budnim %@ dnevno. Vaše poruke nikad nisu ograničene."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andre kan holde din Chief vågen %@ om dagen. Dine egne beskeder har ingen grænse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere können deinen Chief %@ pro Tag wach halten. Deine eigenen Nachrichten sind nie begrenzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otros pueden mantener activo a tu Chief %@ al día. Tus propios mensajes no tienen límite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les autres peuvent garder votre Chief éveillé %@ par jour. Vos propres messages ne sont jamais limités."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli altri possono tenere attivo il tuo Chief per %@ al giorno. I tuoi messaggi non hanno mai limiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他のメンバーは 1 日 %@ まで Chief を稼働させられます。あなた自身のメッセージに上限はありません。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកផ្សេងអាចរក្សា Chief របស់អ្នកឲ្យភ្ញាក់បាន %@ ក្នុងមួយថ្ងៃ។ សាររបស់អ្នកផ្ទាល់មិនមានកំណត់ទេ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 사람은 하루 %@ 동안 Chief를 깨워 둘 수 있습니다. 내 메시지에는 한도가 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andre kan holde din Chief våken %@ om dagen. Dine egne meldinger har ingen grense."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inni mogą utrzymywać Twojego Chiefa aktywnym przez %@ dziennie. Twoje wiadomości nie mają limitu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outras pessoas podem manter seu Chief ativo por %@ por dia. Suas próprias mensagens não têm limite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другие могут держать вашего Chief активным %@ в день. Ваши сообщения не ограничены."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คนอื่นทำให้ Chief ของคุณทำงานได้ %@ ต่อวัน ข้อความของคุณเองไม่มีขีดจำกัด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başkaları Chief’inizi günde %@ uyanık tutabilir. Kendi mesajlarınız asla sınırlanmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Інші можуть тримати вашого Chief активним %@ на день. Ваші власні повідомлення не обмежені."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Người khác có thể giữ Chief hoạt động %@ mỗi ngày. Tin nhắn của bạn không bao giờ bị giới hạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其他人每天最多可让你的 Chief 保持唤醒 %@。你自己的消息不受限制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其他人每天最多可讓你的 Chief 保持喚醒 %@。你自己的訊息不受限制。"
          }
        }
      }
