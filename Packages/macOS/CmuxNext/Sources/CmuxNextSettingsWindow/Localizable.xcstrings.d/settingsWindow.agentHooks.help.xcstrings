    "settingsWindow.agentHooks.help" : {
      "comment" : "Settings > Agents > Claude Code & Codex > Hooks card: card subtitle. cmux's own hooks are read-only here.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commands Claude Code and Codex run on their events, from ~/.claude and ~/.codex. cmux's own hooks are shown and can't be changed here."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أوامر يشغّلها Claude Code وCodex عند أحداثهما، من ~/.claude و~/.codex. تُعرض خطّافات cmux نفسها ولا يمكن تغييرها هنا."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Naredbe koje Claude Code i Codex pokreću na svoje događaje, iz ~/.claude i ~/.codex. cmux-ovi vlastiti hookovi se prikazuju, ali se ovdje ne mogu mijenjati."
          }
        },
        "da" : {
          "stringUnit" : {
