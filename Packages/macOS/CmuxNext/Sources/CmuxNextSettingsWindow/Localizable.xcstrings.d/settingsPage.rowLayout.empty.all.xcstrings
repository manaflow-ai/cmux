        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rækkerne viser de elementer, der er slået til ovenfor. Tilpas for at vælge, hvad hver linje viser."
          }
        },
        "de" : {
          "stringUnit" : {
