    "settingsWindow.models.dialog.meta.description" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيستخدم cmux حساب المطوّر لدى Meta للوصول إلى نماذج Muse. الصق مفتاح API من Model API للاتصال."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux će koristiti tvoj razvojni nalog za Meta za pristup opciji modeli Muse. Zalijepi API ključ za Model API da se povežeš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux bruger din udviklerkonto hos Meta til at tilgå Muse-modeller. Indsæt en API-nøgle til Model API for at oprette forbindelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux verwendet dein Entwicklerkonto bei Meta für den Zugriff auf Modelle von Muse. Füge einen API-Schlüssel für Model API ein, um dich zu verbinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux will use your Meta developer account to access Muse models. Paste a key from the Model API dashboard."
