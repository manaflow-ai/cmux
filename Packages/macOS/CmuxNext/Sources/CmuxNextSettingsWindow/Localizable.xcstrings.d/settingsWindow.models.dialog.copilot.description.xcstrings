        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux će koristiti tvoju pretplatu na Copilot za pristup opciji modeli Copilot. Prijavi se putem GitHub i unesi kod uređaja za povezivanje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux bruger dit abonnement på Copilot til at tilgå Copilot-modeller. Log ind med GitHub, og indtast enhedskoden for at oprette forbindelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux verwendet dein Abo für Copilot für den Zugriff auf Modelle von Copilot. Mit GitHub anmelden und den Gerätecode eingeben, um dich zu verbinden."
