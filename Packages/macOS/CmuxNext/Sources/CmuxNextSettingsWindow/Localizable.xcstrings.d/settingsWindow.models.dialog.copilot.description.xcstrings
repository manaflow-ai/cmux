        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيستخدم cmux اشتراكك في Copilot للوصول إلى نماذج Copilot. تسجيل الدخول باستخدام GitHub وأدخل رمز الجهاز للاتصال."
          }
