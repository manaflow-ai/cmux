        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux će koristiti tvoj nalog za Baseten za pristup opciji Model APIs. Zalijepi API ključ za Baseten da se povežeš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux bruger din konto hos Baseten til at tilgå Model APIs. Indsæt en API-nøgle til Baseten for at oprette forbindelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux verwendet dein Konto bei Baseten für den Zugriff auf Model APIs. Füge einen API-Schlüssel für Baseten ein, um dich zu verbinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux will use your Baseten account to run Model APIs. Paste a Baseten API key."
