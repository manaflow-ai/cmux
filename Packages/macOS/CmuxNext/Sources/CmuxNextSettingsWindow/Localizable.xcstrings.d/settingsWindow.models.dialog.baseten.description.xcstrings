    "settingsWindow.models.dialog.baseten.description" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيستخدم cmux حسابك لدى Baseten للوصول إلى Model APIs. الصق مفتاح API من Baseten للاتصال."
          }
