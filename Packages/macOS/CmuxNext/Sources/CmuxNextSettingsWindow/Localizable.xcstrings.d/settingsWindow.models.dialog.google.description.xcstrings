{
  "sourceLanguage" : "en",
  "strings" : {
    "settingsWindow.models.dialog.google.description" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيستخدم cmux مفتاح API الخاص بك لدى Google AI Studio للوصول إلى نماذج Gemini. تُطبق حدود الفئة المجانية حتى تفعيل الفوترة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux će koristiti tvoj API ključ za Google AI Studio za pristup opciji modeli Gemini. Ograničenja besplatnog paketa važe dok ne uključiš naplatu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux bruger din API-nøgle til Google AI Studio til at tilgå Gemini-modeller. Grænserne for det gratis niveau gælder, indtil fakturering er slået til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux verwendet deinen API-Schlüssel für Google AI Studio für den Zugriff auf Modelle von Gemini. Bis zur Aktivierung der Abrechnung gelten die kostenlosen Nutzungslimits."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux will use your Google AI Studio key to access Gemini models. Free tier limits apply until billing is on."
