        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux bruker API-nøkkelen din for Google AI Studio for å få tilgang til modeller fra Gemini. Grensene for gratisnivået gjelder til fakturering er aktivert."
