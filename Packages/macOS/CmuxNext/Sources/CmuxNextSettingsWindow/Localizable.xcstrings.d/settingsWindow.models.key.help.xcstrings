{
  "sourceLanguage" : "en",
  "strings" : {
    "settingsWindow.models.key.help" : {
      "comment" : "Settings > Models (ModelsCard.tsx): Cloud threads' subscriptions and keys. ChatGPT, Claude, Claude Code, OpenAI, Anthropic and the provider names are product names.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste your %@ API key. It stays in this Mac's Keychain; Cloud machines get it only to run your chat."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصق مفتاح API الخاص بـ %@. يبقى في سلسلة مفاتيح هذا الـ Mac، ولا تحصل عليه أجهزة Cloud إلا لتشغيل محادثتك."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zalijepi svoj %@ API ključ. Ostaje u privjesku ključeva ovog Maca; Cloud mašine ga dobijaju samo da pokrenu tvoj chat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indsæt din %@-API-nøgle. Den bliver i denne Macs nøglering; Cloud-maskiner får den kun for at køre din chat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge deinen %@-API-Schlüssel ein. Er bleibt im Schlüsselbund dieses Macs; Cloud-Maschinen erhalten ihn nur, um deinen Chat auszuführen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega tu clave de API de %@. Se queda en el llavero de este Mac; las máquinas de Cloud solo la reciben para ejecutar tu chat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collez votre clé API %@. Elle reste dans le trousseau de ce Mac ; les machines Cloud ne la reçoivent que pour exécuter votre conversation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incolla la tua chiave API %@. Resta nel portachiavi di questo Mac; le macchine Cloud la ricevono solo per eseguire la tua chat."
