    "settingsWindow.agentHooks.codexFeatureOff" : {
      "comment" : "Settings > Agents > Claude Code & Codex > Hooks card: warning banner shown when Codex's hooks feature flag is off. Keep the path and the [features] hooks setting name untranslated.",
