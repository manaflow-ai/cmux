{
  "sourceLanguage" : "en",
  "strings" : {
    "settingsWindow.models.device.differentAccount" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You signed in to a different account. Try again with the connected account."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّلت الدخول إلى حساب آخر. حاول مجددًا باستخدام الحساب المتصل."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijavili ste se na drugi račun. Pokušajte ponovo s povezanim računom."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du loggede ind på en anden konto. Prøv igen med den tilsluttede konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast dich bei einem anderen Konto angemeldet. Versuche es erneut mit dem verbundenen Konto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has iniciado sesión con otra cuenta. Inténtalo de nuevo con la cuenta conectada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous vous êtes connecté à un autre compte. Réessayez avec le compte associé."
