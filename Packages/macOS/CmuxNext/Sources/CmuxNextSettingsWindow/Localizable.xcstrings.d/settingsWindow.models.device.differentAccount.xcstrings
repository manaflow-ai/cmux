        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы вошли в другой аккаунт. Повторите попытку с подключённым аккаунтом."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณลงชื่อเข้าใช้ด้วยบัญชีอื่น ลองอีกครั้งด้วยบัญชีที่เชื่อมต่ออยู่"
