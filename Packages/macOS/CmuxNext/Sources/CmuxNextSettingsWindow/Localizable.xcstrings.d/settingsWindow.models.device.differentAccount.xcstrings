        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai effettuato l'accesso a un altro account. Riprova con quello collegato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のアカウントでサインインしました。接続済みのアカウントでやり直してください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកបានចូលគណនីផ្សេង។ សូមសាកល្បងម្តងទៀតដោយប្រើគណនីដែលបានភ្ជាប់។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 계정으로 로그인했습니다. 연결된 계정으로 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du logget på en annen konto. Prøv igjen med den tilkoblede kontoen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zalogowano się na inne konto. Spróbuj ponownie, używając połączonego konta."
