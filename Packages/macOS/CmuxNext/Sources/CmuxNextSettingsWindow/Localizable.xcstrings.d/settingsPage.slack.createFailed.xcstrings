    "settingsPage.slack.createFailed" : {
      "comment" : "Settings > Accounts > Slack connection card",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack could not create the app. You may have five bot apps already, or your workspace blocks new apps."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Slack إنشاء التطبيق. ربما لديك خمسة تطبيقات بوت بالفعل، أو أن مساحة العمل تمنع التطبيقات الجديدة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack nije mogao kreirati aplikaciju. Možda već imate pet bot aplikacija ili vaš radni prostor blokira nove aplikacije."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack kunne ikke oprette appen. Du har måske allerede fem bot-apps, eller dit workspace blokerer nye apps."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack konnte die App nicht erstellen. Du hast vielleicht schon fünf Bot-Apps, oder dein Workspace blockiert neue Apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack no pudo crear la app. Puede que ya tengas cinco apps de bot o que tu espacio de trabajo bloquee apps nuevas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack n'a pas pu créer l'app. Vous avez peut-être déjà cinq apps bot, ou votre espace de travail bloque les nouvelles apps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack non ha potuto creare l'app. Forse hai già cinque app bot, oppure il tuo workspace blocca le nuove app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack はアプリを作成できませんでした。ボットアプリがすでに 5 つあるか、ワークスペースが新しいアプリをブロックしている可能性があります。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack មិនអាចបង្កើតកម្មវិធីបានទេ។ អ្នកប្រហែលមានកម្មវិធីបូតប្រាំរួចហើយ ឬកន្លែងធ្វើការរបស់អ្នករារាំងកម្មវិធីថ្មី។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack에서 앱을 만들지 못했습니다. 이미 봇 앱이 5개 있거나 워크스페이스에서 새 앱을 막고 있을 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack kunne ikke opprette appen. Du har kanskje allerede fem bot-apper, eller arbeidsområdet ditt blokkerer nye apper."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack nie mógł utworzyć aplikacji. Możesz mieć już pięć aplikacji botów albo Twój obszar roboczy blokuje nowe aplikacje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Slack não conseguiu criar o app. Você pode já ter cinco apps de bot, ou seu workspace bloqueia apps novos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack не смог создать приложение. Возможно, у вас уже пять бот-приложений или ваше рабочее пространство блокирует новые приложения."
