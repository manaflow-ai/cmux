        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Slack não conseguiu criar o app. Você pode já ter cinco apps de bot, ou seu workspace pode não permitir novos apps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
