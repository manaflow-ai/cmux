{
  "sourceLanguage" : "en",
  "strings" : {
    "settingsPage.rowLayout.chipHint" : {
      "comment" : "Row Layout: how to move or remove an item with the keyboard (read by VoiceOver).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اسحبه، أو اضغط Option ومفتاح سهم، لنقله. يزيله Delete."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prevucite ga ili pritisnite Option i strelicu da ga pomjerite. Delete ga uklanja."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Træk det, eller tryk på Option og en piletast, for at flytte det. Delete fjerner det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zum Verschieben ziehen oder Wahltaste und eine Pfeiltaste drücken. Entfernen löscht es."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag it, or press Option and an arrow key, to move it. Delete removes it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arrástralo, o pulsa Opción y una flecha, para moverlo. Suprimir lo quita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faites-le glisser, ou appuyez sur Option et une flèche, pour le déplacer. Supprimer le retire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trascinalo, o premi Opzione e una freccia, per spostarlo. Elimina lo rimuove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ドラッグするか、Option と矢印キーで移動します。Delete で削除します。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "អូស ឬចុច Option និងព្រួញ ដើម្បីផ្លាស់ទី។ Delete ដើម្បីលុប។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "드래그하거나 Option과 화살표 키를 눌러 옮깁니다. Delete로 제거합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dra det, eller trykk Option og en piltast, for å flytte det. Delete fjerner det."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przeciągnij lub naciśnij Option i strzałkę, aby przenieść. Delete usuwa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arraste, ou pressione Option e uma seta, para mover. Delete remove."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Перетащите или нажмите Option и стрелку, чтобы переместить. Delete удаляет."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ลาก หรือกด Option กับปุ่มลูกศร เพื่อย้าย กด Delete เพื่อลบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Taşımak için sürükleyin ya da Option ile bir ok tuşuna basın. Delete kaldırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Перетягніть або натисніть Option і стрілку, щоб перемістити. Delete вилучає."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kéo, hoặc nhấn Option và phím mũi tên, để di chuyển. Delete để xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "拖移，或按 Option 和方向键来移动。按 Delete 移除。"
          }
