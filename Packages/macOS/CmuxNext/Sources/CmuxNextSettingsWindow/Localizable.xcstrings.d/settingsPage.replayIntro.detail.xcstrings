    "settingsPage.replayIntro.detail" : {
      "comment" : "Settings > General: one line under Replay the Intro saying what it opens and that Skip undoes it.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walk through Make cmux Yours again: how you work, density and background. Skip puts back what you have now."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "امرّ على «اجعل cmux خاصًا بك» مجددًا: طريقة عملك والكثافة والخلفية. «تخطٍّ» يعيد ما لديك الآن."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ponovo prođite kroz Prilagodite cmux: kako radite, gustoću i pozadinu. Preskoči vraća ono što sada imate."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gå Gør cmux til dit eget igennem igen: hvordan du arbejder, tæthed og baggrund. Spring over sætter det tilbage, du har nu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geh „Mach cmux zu deinem“ noch einmal durch: wie du arbeitest, Dichte und Hintergrund. Überspringen stellt wieder her, was du jetzt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vuelve a recorrer Haz cmux a tu medida: cómo trabajas, la densidad y el fondo. Omitir restaura lo que tienes ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reparcourez Personnalisez cmux : votre façon de travailler, la densité et l’arrière-plan. Passer remet ce que vous avez maintenant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ripercorri Rendi cmux tuo: come lavori, densità e sfondo. Salta ripristina ciò che hai ora."
