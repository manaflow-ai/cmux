        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ឆ្លងកាត់ ធ្វើឲ្យ cmux ជារបស់អ្នក ម្តងទៀត៖ របៀបធ្វើការ ដង់ស៊ីតេ និងផ្ទៃខាងក្រោយ។ រំលង ដាក់អ្វីដែលអ្នកមានឥឡូវវិញ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux를 내 스타일로를 다시 진행합니다: 작업 방식, 밀도, 배경. 건너뛰기를 누르면 지금 설정으로 돌아갑니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gå gjennom Gjør cmux til ditt eget igjen: hvordan du jobber, tetthet og bakgrunn. Hopp over setter tilbake det du har nå."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przejdź ponownie przez Dostosuj cmux do siebie: sposób pracy, gęstość i tło. Pomiń przywraca to, co masz teraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Percorra de novo Deixe o cmux do seu jeito: como você trabalha, densidade e fundo. Pular restaura o que você tem agora."
