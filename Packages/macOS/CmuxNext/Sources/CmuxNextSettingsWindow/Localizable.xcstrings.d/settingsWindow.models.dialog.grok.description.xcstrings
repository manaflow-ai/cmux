  "strings" : {
    "settingsWindow.models.dialog.grok.description" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيستخدم cmux اشتراكك في SuperGrok أو X Premium للوصول إلى نماذج Grok. تسجيل الدخول باستخدام xAI وأدخل رمز الجهاز للاتصال."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux će koristiti tvoju pretplatu na SuperGrok ili X Premium za pristup opciji modeli Grok. Prijavi se putem xAI i unesi kod uređaja za povezivanje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux bruger dit abonnement på SuperGrok eller X Premium til at tilgå Grok-modeller. Log ind med xAI, og indtast enhedskoden for at oprette forbindelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux verwendet dein Abo für SuperGrok oder X Premium für den Zugriff auf Modelle von Grok. Mit xAI anmelden und den Gerätecode eingeben, um dich zu verbinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux will use your SuperGrok or X Premium subscription to access Grok models. Sign in with xAI and enter the device code to connect."
