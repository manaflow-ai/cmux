    "settingsWindow.agentSkills.help" : {
      "comment" : "Settings > Agents > Claude Code & Codex > Skills: what the list is.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The skills and slash commands Claude Code and Codex load. Edit opens a file in cmux; the switch changes the agent's setting."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "المهارات وأوامر الشرطة المائلة التي يحمّلها Claude Code وCodex من مجلداتهما. يفتح «تحرير» الملف في cmux، ويغيّر المفتاح إعداد الوكيل نفسه."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vještine i slash komande koje Claude Code i Codex učitavaju iz svojih foldera. Uredi otvara datoteku u cmuxu; prekidač mijenja postavku samog agenta."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De færdigheder og skråstregskommandoer, Claude Code og Codex indlæser fra deres egne mapper. Rediger åbner en fil i cmux; kontakten ændrer agentens egen indstilling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Skills und Slash-Befehle, die Claude Code und Codex aus ihren eigenen Ordnern laden. Bearbeiten öffnet eine Datei in cmux; der Schalter ändert die Einstellung des Agenten selbst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las habilidades y los comandos de barra que Claude Code y Codex cargan desde sus propias carpetas. Editar abre un archivo en cmux; el interruptor cambia el ajuste del propio agente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les compétences et commandes slash que Claude Code et Codex chargent depuis leurs propres dossiers. Modifier ouvre un fichier dans cmux ; l’interrupteur change le réglage de l’agent lui-même."
