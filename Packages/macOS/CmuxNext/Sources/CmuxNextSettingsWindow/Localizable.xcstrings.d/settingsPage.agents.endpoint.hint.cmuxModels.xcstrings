    "settingsPage.agents.endpoint.hint.cmuxModels" : {
      "comment" : "Settings > Agents > Add > Endpoint (your own model endpoint); cmux models are open-weight models cmux hosts; keep cmux lowercase, and Claude Code and Fetch Models as the app names them",
