        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux će koristiti tvoj nalog za AWS za pristup opciji modeli Bedrock. Zalijepi API ključ za Bedrock da se povežeš i odaberi njegovu regiju."
          }
        },
