        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيستخدم cmux حسابك لدى AWS للوصول إلى نماذج Bedrock. الصق مفتاح API من Bedrock للاتصال. واختر منطقته."
          }
