      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its value is deleted from this Mac, so agents can’t use it again. Copies already written elsewhere keep working until you remove them."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُحذف قيمته من هذا الـ Mac، فلا يمكن للوكلاء استخدامه مجددًا. النسخ المكتوبة في أماكن أخرى تبقى صالحة حتى تحذفها."
          }
        },
        "bs" : {
          "stringUnit" : {
