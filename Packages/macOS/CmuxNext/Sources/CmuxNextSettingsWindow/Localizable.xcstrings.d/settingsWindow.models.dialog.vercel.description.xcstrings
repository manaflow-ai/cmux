        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux će koristiti kredit tvog tima za AI Gateway za pristup opciji modeli AI Gateway. Zalijepi API ključ za AI Gateway da se povežeš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux bruger dit teams kreditter hos AI Gateway til at tilgå AI Gateway-modeller. Indsæt en API-nøgle til AI Gateway for at oprette forbindelse."
