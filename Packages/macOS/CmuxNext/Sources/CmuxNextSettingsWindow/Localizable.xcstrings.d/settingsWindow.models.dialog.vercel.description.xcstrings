        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيستخدم cmux رصيد فريقك لدى AI Gateway للوصول إلى نماذج AI Gateway. الصق مفتاح API من AI Gateway للاتصال."
          }
