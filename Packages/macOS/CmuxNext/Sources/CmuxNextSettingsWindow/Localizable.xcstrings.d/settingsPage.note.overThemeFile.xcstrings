{
  "sourceLanguage" : "en",
  "strings" : {
    "settingsPage.note.overThemeFile" : {
      "comment" : "Settings row note: the person's value applies over the active theme file's (the file name, %@); Reset returns to the file's value.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قيمتك تُطبَّق فوق %@. إعادة التعيين تعيد قيمة الملف."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vaša vrijednost važi preko %@. Vraćanje vraća vrijednost datoteke."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Din værdi gælder over %@. Nulstil vender tilbage til filens."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dein Wert gilt über %@. Zurücksetzen stellt den der Datei wieder her."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your value applies over %@. Reset returns to the file's."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu valor se aplica sobre %@. Restablecer vuelve al del archivo."
