{
  "sourceLanguage" : "en",
  "strings" : {
    "settingsWindow.models.claude.help" : {
      "comment" : "Settings > Models (ModelsCard.tsx): Cloud threads' subscriptions and keys. ChatGPT, Claude, Claude Code, OpenAI, Anthropic and the provider names are product names.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code makes a token for your Claude plan. It stays in this Mac's Keychain; Cloud machines get it only to run your chat."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُنشئ Claude Code رمزًا لخطة Claude الخاصة بك. يبقى الرمز في سلسلة مفاتيح هذا الـ Mac، ولا تحصل عليه أجهزة Cloud إلا لتشغيل محادثتك."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code pravi token za tvoj Claude plan. Token ostaje u privjesku ključeva ovog Maca; Cloud mašine ga dobijaju samo da pokrenu tvoj chat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code laver et token til dit Claude-abonnement. Tokenet bliver i denne Macs nøglering; Cloud-maskiner får det kun for at køre din chat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code erstellt ein Token für dein Claude-Abo. Das Token bleibt im Schlüsselbund dieses Macs; Cloud-Maschinen erhalten es nur, um deinen Chat auszuführen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code crea un token para tu plan de Claude. El token se queda en el llavero de este Mac; las máquinas de Cloud solo lo reciben para ejecutar tu chat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code crée un jeton pour votre forfait Claude. Le jeton reste dans le trousseau de ce Mac ; les machines Cloud ne le reçoivent que pour exécuter votre conversation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code crea un token per il tuo piano Claude. Il token resta nel portachiavi di questo Mac; le macchine Cloud lo ricevono solo per eseguire la tua chat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code があなたの Claude プラン用のトークンを作成します。トークンはこの Mac のキーチェーンに保存され、Cloud マシンにはチャットを実行するときだけ渡されます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code បង្កើតថូខឹនមួយសម្រាប់គម្រោង Claude របស់អ្នក។ ថូខឹននៅក្នុង Keychain នៃ Mac នេះ ហើយម៉ាស៊ីន Cloud ទទួលបានវាតែដើម្បីដំណើរការការជជែករបស់អ្នកប៉ុណ្ណោះ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code가 Claude 요금제용 토큰을 만듭니다. 토큰은 이 Mac의 키체인에 보관되며, Cloud 머신은 채팅을 실행할 때만 받습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code lager et token for Claude-abonnementet ditt. Tokenet blir i nøkkelringen på denne Macen; Cloud-maskiner får det bare for å kjøre chatten din."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code tworzy token dla Twojego planu Claude. Token zostaje w pęku kluczy tego Maca; maszyny Cloud dostają go tylko po to, by uruchomić Twój czat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Claude Code cria um token para o seu plano do Claude. O token fica nas Chaves deste Mac; as máquinas do Cloud só o recebem para executar seu chat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code создаёт токен для вашего плана Claude. Токен остаётся в связке ключей этого Mac; машины Cloud получают его только для запуска вашего чата."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code จะสร้างโทเค็นสำหรับแพ็กเกจ Claude ของคุณ โทเค็นจะอยู่ในพวงกุญแจของ Mac เครื่องนี้ และเครื่อง Cloud จะได้รับเฉพาะตอนเรียกใช้แชทของคุณเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code, Claude planınız için bir token oluşturur. Token bu Mac'in Anahtar Zinciri'nde kalır; Cloud makineleri onu yalnızca sohbetinizi çalıştırmak için alır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code створює токен для вашого плану Claude. Токен залишається у в’язці ключів цього Mac; машини Cloud отримують його лише для запуску вашого чату."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code tạo một token cho gói Claude của bạn. Token nằm trong Chuỗi khóa của máy Mac này; máy Cloud chỉ nhận nó để chạy cuộc trò chuyện của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code 会为你的 Claude 套餐生成一个令牌。令牌保存在这台 Mac 的钥匙串中；Cloud 机器只在运行你的聊天时才会拿到它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code 會為你的 Claude 方案產生一個權杖。權杖保存在這台 Mac 的鑰匙圈中；Cloud 機器只在執行你的聊天時才會取得它。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
