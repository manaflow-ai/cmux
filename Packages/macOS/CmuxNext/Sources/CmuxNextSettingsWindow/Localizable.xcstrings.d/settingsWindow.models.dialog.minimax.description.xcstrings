        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux verwendet deinen API-Schlüssel für MiniMax für den Zugriff auf Modelle von MiniMax. Die Nutzung wird deinem MiniMax-Konto berechnet."
