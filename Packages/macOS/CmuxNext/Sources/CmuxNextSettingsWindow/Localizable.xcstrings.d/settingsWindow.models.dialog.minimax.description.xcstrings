        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux će koristiti tvoj API ključ za MiniMax za pristup opciji modeli MiniMax. Upotreba se naplaćuje na tvom nalogu za MiniMax."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux bruger din API-nøgle til MiniMax til at tilgå MiniMax-modeller. Forbrug faktureres på din MiniMax-konto."
