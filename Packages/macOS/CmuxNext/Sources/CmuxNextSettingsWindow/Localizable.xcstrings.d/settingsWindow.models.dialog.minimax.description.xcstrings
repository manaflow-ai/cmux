    "settingsWindow.models.dialog.minimax.description" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيستخدم cmux مفتاح API الخاص بك لدى MiniMax للوصول إلى نماذج MiniMax. تُحتسب تكلفة الاستخدام على حسابك لدى MiniMax."
