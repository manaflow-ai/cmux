    "settingsPage.note.plainBackgrounds" : {
      "comment" : "Settings row note on the window Opacity, Material and picture rows: Plain Backgrounds is on, so they do not draw.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الخلفيات البسيطة مفعّلة، لذا تُرسم النوافذ بلون السمة العادي."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Obične pozadine su uključene, pa prozori koriste običnu boju teme."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Enkle baggrunde er slået til, så vinduer tegnes i temaets enkle farve."
