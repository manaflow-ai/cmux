{
  "sourceLanguage" : "en",
  "strings" : {
    "settingsWindow.tokens.form.neverWarning" : {
      "comment" : "Settings > Developer: warning under the No expiration choice",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A token that never expires works until you revoke it. Pick an expiration unless you rotate it yourself."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يعمل الرمز الذي لا تنتهي صلاحيته حتى تُبطله. اختر مدة صلاحية ما لم تكن تستبدله بنفسك."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Token koji nikad ne ističe radi dok ga ne opozovete. Odaberite istek osim ako ga sami ne mijenjate."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Et token, der aldrig udløber, virker, indtil du tilbagekalder det. Vælg et udløb, medmindre du selv udskifter det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein Token ohne Ablauf funktioniert, bis du es widerrufst. Wähle einen Ablauf, außer du tauschst es selbst regelmäßig aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un token que nunca caduca funciona hasta que lo revoques. Elige una caducidad, salvo que lo rotes tú mismo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un jeton sans expiration fonctionne jusqu’à ce que vous le révoquiez. Choisissez une expiration, sauf si vous le renouvelez vous-même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un token senza scadenza funziona finché non lo revochi. Scegli una scadenza, a meno che tu non lo sostituisca da solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "有効期限のないトークンは、取り消すまで使用できます。自分でローテーションしない場合は有効期限を選んでください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ថូខឹនដែលមិនផុតកំណត់ដំណើរការរហូតដល់អ្នកដកហូតវា។ សូមជ្រើសរើសការផុតកំណត់ លុះត្រាតែអ្នកប្ដូរវាដោយខ្លួនឯង។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "만료되지 않는 토큰은 폐기할 때까지 작동합니다. 직접 교체하지 않는다면 만료 기간을 선택하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Et token som aldri utløper, virker til du tilbakekaller det. Velg et utløp med mindre du bytter det ut selv."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Token bez wygaśnięcia działa, dopóki go nie unieważnisz. Wybierz termin wygaśnięcia, chyba że sam go wymieniasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um token sem expiração funciona até você revogá-lo. Escolha uma expiração, a menos que você mesmo faça a rotação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Бессрочный токен работает, пока вы его не отзовете. Выберите срок действия, если не меняете токен сами."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "โทเค็นที่ไม่มีวันหมดอายุจะใช้งานได้จนกว่าคุณจะเพิกถอน เลือกวันหมดอายุ เว้นแต่คุณจะหมุนเวียนโทเค็นเอง"
