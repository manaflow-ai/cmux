        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Süresi dolmayan bir belirteç siz iptal edene kadar çalışır. Kendiniz yenilemiyorsanız bir son kullanma süresi seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Безстроковий токен працює, доки ви його не відкличете. Виберіть термін дії, якщо не замінюєте токен самі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Token không hết hạn sẽ hoạt động cho đến khi bạn thu hồi. Hãy chọn thời hạn trừ khi bạn tự thay token."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "永不过期的令牌在你撤销前一直有效。除非你自己轮换，否则请选择过期时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "永不過期的權杖在你撤銷前一直有效。除非你自行輪替，否則請選擇到期時間。"
          }
