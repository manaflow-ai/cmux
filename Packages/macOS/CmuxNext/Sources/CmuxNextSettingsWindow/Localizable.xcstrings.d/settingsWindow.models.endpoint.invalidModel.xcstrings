{
  "sourceLanguage" : "en",
  "strings" : {
    "settingsWindow.models.endpoint.invalidModel" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل اسمًا من كلمة واحدة لا يتجاوز 200 بايت، دون فواصل أو علامات اقتباس أو أقواس معقوفة أو شرطة مائلة عكسية أو $ أو *."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unesite naziv od jedne riječi do 200 bajtova, bez zareza, navodnika, vitičastih zagrada, obrnute kose crte, $ ili *."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtast et navn på ét ord og højst 200 byte uden kommaer, anførselstegn, krøllede parenteser, omvendt skråstreg, $ eller *."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib einen Namen aus einem Wort mit maximal 200 Byte ein. Kommas, Anführungszeichen, geschweifte Klammern, Rückwärtsschrägstriche, $ und * sind unzulässig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter one name up to 200 bytes, without spaces, commas, quotes, braces, backslashes, $ or *."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce un nombre de hasta 200 bytes sin espacios, comas, comillas, llaves, barras invertidas, $ ni *."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez un nom de 200 octets maximum, sans espaces, virgules, guillemets, accolades, barres obliques inverses, $ ni *."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci un nome di massimo 200 byte senza spazi, virgole, virgolette, parentesi graffe, barre rovesciate, $ o *."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前は200バイト以内で入力してください。空白、カンマ、引用符、波括弧、バックスラッシュ、$、* は使用できません。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "បញ្ចូលឈ្មោះមួយដែលមានរហូតដល់ 200 បៃ ដោយគ្មានដកឃ្លា សញ្ញាក្បៀស សញ្ញាសម្រង់ សញ្ញាដង្កៀបអង្កាញ់ សញ្ញាទ្រេតបញ្ច្រាស $ ឬ *។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공백, 쉼표, 따옴표, 중괄호, 역슬래시, $, * 없이 이름 하나를 200바이트 이내로 입력하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv inn ett navn på opptil 200 byte uten mellomrom, komma, anførselstegn, krøllparenteser, omvendt skråstrek, $ eller *."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz jedną nazwę o długości do 200 bajtów bez spacji, przecinków, cudzysłowów, nawiasów klamrowych, ukośników odwrotnych, $ ani *."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite um nome de até 200 bytes, sem espaços, vírgulas, aspas, chaves, barras invertidas, $ ou *."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите одно имя длиной до 200 байт без пробелов, запятых, кавычек, фигурных скобок, обратных косых черт, $ или *."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ป้อนชื่อหนึ่งชื่อไม่เกิน 200 ไบต์ โดยไม่มีช่องว่าง จุลภาค อัญประกาศ วงเล็บปีกกา แบ็กสแลช $ หรือ *"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boşluk, virgül, tırnak, süslü parantez, ters eğik çizgi, $ veya * içermeyen, en fazla 200 bayt uzunluğunda bir ad girin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введіть одну назву довжиною до 200 байтів без пробілів, ком, лапок, фігурних дужок, зворотних скісних рисок, $ або *."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập một tên tối đa 200 byte, không chứa dấu cách, dấu phẩy, dấu ngoặc kép, dấu ngoặc nhọn, dấu gạch chéo ngược, $ hoặc *."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入一个不超过 200 字节的名称，请勿使用空格、逗号、引号、花括号、反斜杠、$ 或 *。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請輸入一個不超過 200 位元組的名稱，且不得含有空格、逗號、引號、大括號、反斜線、$ 或 *。"
          }
        }
      }
    }
  },
  "version" : "1.0"
