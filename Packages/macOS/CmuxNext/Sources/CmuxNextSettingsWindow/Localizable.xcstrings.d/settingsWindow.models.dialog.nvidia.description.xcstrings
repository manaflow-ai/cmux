{
  "sourceLanguage" : "en",
  "strings" : {
    "settingsWindow.models.dialog.nvidia.description" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيستخدم cmux حساب المطوّر لدى NVIDIA للوصول إلى نماذج NVIDIA Build. الصق مفتاح API من NVIDIA Build للاتصال."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux će koristiti tvoj razvojni nalog za NVIDIA za pristup opciji modeli NVIDIA Build. Zalijepi API ključ za NVIDIA Build da se povežeš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux bruger din udviklerkonto hos NVIDIA til at tilgå NVIDIA Build-modeller. Indsæt en API-nøgle til NVIDIA Build for at oprette forbindelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux verwendet dein Entwicklerkonto bei NVIDIA für den Zugriff auf Modelle von NVIDIA Build. Füge einen API-Schlüssel für NVIDIA Build ein, um dich zu verbinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux will use your NVIDIA developer account to access models on NVIDIA Build. Paste an API key from NVIDIA Build."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux usará tu cuenta de desarrollador de NVIDIA para acceder a los modelos de NVIDIA Build. Pega una clave de API de NVIDIA Build para conectarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux utilisera votre compte développeur NVIDIA pour accéder à des modèles NVIDIA Build. Collez une clé API NVIDIA Build pour vous connecter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux userà il tuo account sviluppatore NVIDIA per accedere a modelli NVIDIA Build. Incolla una chiave API di NVIDIA Build per connetterti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmuxはお使いのNVIDIA開発者アカウントを使用してNVIDIA Buildモデルにアクセスします。接続するにはNVIDIA BuildのAPIキーを貼り付けてください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux នឹងប្រើ គណនីអ្នកអភិវឌ្ឍន៍ NVIDIA របស់អ្នក ដើម្បីចូលប្រើ ម៉ូដែល NVIDIA Build។ បិទភ្ជាប់សោ API សម្រាប់ NVIDIA Build ដើម្បីភ្ជាប់។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux에서 NVIDIA 개발자 계정로 NVIDIA Build 모델에 액세스합니다. 연결하려면 NVIDIA Build API 키를 붙여넣으세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux bruker utviklerkontoen din hos NVIDIA for å få tilgang til modeller fra NVIDIA Build. Lim inn en API-nøkkel for NVIDIA Build for å koble til."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux użyje Twojego konta deweloperskiego NVIDIA, aby uzyskać dostęp do modeli NVIDIA Build. Wklej klucz API usługi NVIDIA Build, aby się połączyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
