    "settingsWindow.agentMcp.removeBody" : {
      "comment" : "Settings > MCP Servers, Claude Code and Codex: the confirmation before removing a server; %@ is the agent's config file",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux removes it from %@ and keeps a copy of the file beside it."
          }
