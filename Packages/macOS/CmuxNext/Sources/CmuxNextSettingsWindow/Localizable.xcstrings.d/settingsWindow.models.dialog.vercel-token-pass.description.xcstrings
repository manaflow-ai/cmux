{
  "sourceLanguage" : "en",
  "strings" : {
    "settingsWindow.models.dialog.vercel-token-pass.description" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم النماذج المضمنة في Token Pass دون استخدام AI Gateway المدفوع. الصق مفتاح Token Pass."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi modele iz pretplate Token Pass bez prelaska na plaćeni AI Gateway. Zalijepi ključ za Token Pass."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug de modeller, der følger med Token Pass, uden at skifte til betalt AI Gateway. Indsæt en Token Pass-nøgle."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze die in Token Pass enthaltenen Modelle ohne kostenpflichtigen Rückgriff auf AI Gateway. Füge einen Token-Pass-Schlüssel ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the models included with your Token Pass, with no paid AI Gateway fallback. Paste a Token Pass key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa los modelos de Token Pass sin pasar al servicio de pago de AI Gateway. Pega una clave de Token Pass."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez les modèles inclus dans Token Pass sans basculer vers la facturation AI Gateway. Collez une clé Token Pass."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa i modelli inclusi in Token Pass senza passare alla fatturazione di AI Gateway. Incolla una chiave Token Pass."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token Pass対象モデルを、有料のAI Gatewayに切り替えずに使用します。Token Passキーを貼り付けてください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ប្រើម៉ូដែលដែលរួមបញ្ចូលក្នុង Token Pass ដោយមិនប្ដូរទៅ AI Gateway ដែលគិតថ្លៃ។ បិទភ្ជាប់សោ Token Pass។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유료 AI Gateway로 전환하지 않고 Token Pass에 포함된 모델을 사용합니다. Token Pass 키를 붙여넣으세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk modellene som følger med Token Pass uten å gå over til betalt AI Gateway. Lim inn en Token Pass-nøkkel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korzystaj z modeli dostępnych w Token Pass bez przechodzenia na płatne AI Gateway. Wklej klucz Token Pass."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use os modelos do Token Pass sem recorrer ao AI Gateway pago. Cole uma chave do Token Pass."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте модели из Token Pass без перехода на платный AI Gateway. Вставьте ключ Token Pass."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้โมเดลที่รวมอยู่ใน Token Pass โดยไม่เปลี่ยนไปใช้ AI Gateway แบบเสียเงิน วางคีย์ Token Pass"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ücretli AI Gateway’e geçmeden Token Pass kapsamındaki modelleri kullanın. Bir Token Pass anahtarı yapıştırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Користуйтеся моделями з Token Pass без переходу на платний AI Gateway. Вставте ключ Token Pass."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng các mô hình có trong Token Pass mà không chuyển sang AI Gateway trả phí. Dán khóa Token Pass."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Token Pass 包含的模型，额度用尽后不会转用付费 AI Gateway。请粘贴 Token Pass 密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Token Pass 內含的模型，額度用完後不會轉用付費 AI Gateway。請貼上 Token Pass 金鑰。"
          }
        }
      }
    }
