{
  "sourceLanguage" : "en",
  "strings" : {
    "settingsWindow.models.claude.cloudBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشغّل جهازك السحابي Claude Code باستخدام اشتراكك في Claude. سجّل الدخول باستخدام Claude لربطه."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoja mašina u oblaku pokreće Claude Code uz tvoj Claude paket. Prijavi se na Claude da je povežeš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din skymaskine kører Claude Code med dit Claude-abonnement. Log ind med Claude for at forbinde den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Cloud-Maschine führt Claude Code mit deinem Claude-Abo aus. Melde dich bei Claude an, um sie zu verbinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Cloud machine runs Claude Code with your Claude plan. Sign in with Claude to connect it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu máquina en la nube ejecuta Claude Code con tu plan de Claude. Inicia sesión con Claude para conectarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre machine cloud exécute Claude Code avec votre abonnement Claude. Connectez-vous avec Claude pour la relier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La macchina cloud esegue Claude Code con il tuo piano Claude. Accedi con Claude per connetterla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud マシンはお使いの Claude プランで Claude Code を実行します。Claude にサインインして接続してください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ម៉ាស៊ីន Cloud របស់អ្នកដំណើរការ Claude Code ដោយប្រើគម្រោង Claude របស់អ្នក។ ចូលដោយប្រើ Claudeដើម្បីភ្ជាប់។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud 머신은 사용자의 Claude 플랜으로 Claude Code를 실행합니다. Claude에 로그인하여 연결하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skymaskinen din kjører Claude Code med Claude-abonnementet ditt. Logg på med Claude for å koble den til."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maszyna w chmurze uruchamia Claude Code w ramach Twojego planu Claude. Zaloguj się do Claude, aby ją połączyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua máquina na nuvem executa Claude Code com seu plano Claude. Entre com Claude para conectá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша облачная машина запускает Claude Code по вашей подписке Claude. Войдите в Claude, чтобы подключить её."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เครื่องคลาวด์ของคุณเรียกใช้ Claude Code ด้วยแพ็กเกจ Claude ของคุณ ลงชื่อเข้าใช้ด้วย Claudeเพื่อเชื่อมต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulut makineniz Claude Code’u Claude planınızla çalıştırır. Bağlamak için Claude ile oturum açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша хмарна машина запускає Claude Code за вашим планом Claude. Увійдіть у Claude, щоб підключити її."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy đám mây của bạn chạy Claude Code bằng gói Claude của bạn. Đăng nhập bằng Claude để kết nối máy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的云端机器使用你的 Claude 套餐运行 Claude Code。请登录 Claude 以建立连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的雲端機器使用你的 Claude 方案執行 Claude Code。請登入 Claude 以建立連線。"
          }
        }
      }
    }
