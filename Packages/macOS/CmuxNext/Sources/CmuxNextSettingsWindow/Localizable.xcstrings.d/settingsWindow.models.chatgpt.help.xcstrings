      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in to ChatGPT to use your plan. The sign-in stays on this Mac; Cloud machines get a token only to run your chat."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الدخول إلى ChatGPT لاستخدام خطتك. يبقى تسجيل الدخول على هذا الـ Mac، ولا تحصل أجهزة Cloud على رمز إلا لتشغيل محادثتك."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijavi se na ChatGPT da koristiš svoj plan. Prijava ostaje na ovom Macu; Cloud mašine dobijaju token samo da pokrenu tvoj chat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log ind på ChatGPT for at bruge dit abonnement. Login'et bliver på denne Mac; Cloud-maskiner får kun et token for at køre din chat."
