        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 사진은 지정한 시각에 시작해 다음 사진까지 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert bilde starter på sitt tidspunkt og blir til det neste."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy obraz zaczyna się o swojej porze i zostaje do następnego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada imagem começa na sua hora e fica até a próxima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждое изображение появляется в своё время и остаётся до следующего."
