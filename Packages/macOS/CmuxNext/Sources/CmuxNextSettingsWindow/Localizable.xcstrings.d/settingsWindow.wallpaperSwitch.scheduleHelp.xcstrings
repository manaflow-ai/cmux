{
  "sourceLanguage" : "en",
  "strings" : {
    "settingsWindow.wallpaperSwitch.scheduleHelp" : {
      "comment" : "Help under Switch Automatically for Time of Day.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each picture starts at its time and stays until the next."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبدأ كل صورة في وقتها وتبقى حتى الصورة التالية."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaka slika počinje u svoje vrijeme i ostaje do sljedeće."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert billede starter på sit tidspunkt og bliver til det næste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Bild beginnt zu seiner Zeit und bleibt bis zum nächsten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada imagen empieza a su hora y se queda hasta la siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque image commence à son heure et reste jusqu’à la suivante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni immagine inizia alla sua ora e resta fino alla successiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各画像は指定の時刻に始まり、次の画像まで表示されます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "រូបភាពនីមួយៗចាប់ផ្តើមនៅពេលរបស់វា ហើយនៅរហូតដល់រូបបន្ទាប់។"
