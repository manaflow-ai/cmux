{
  "sourceLanguage" : "en",
  "strings" : {
    "settingsWindow.agentIntegrations.links.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect gives Claude desktop, Claude Code or the Codex app the cmux tools, so their chats can start sessions on your machines; follow them here."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمنح Connect تطبيق Claude لسطح المكتب أو Claude Code أو تطبيق Codex أدوات cmux، فتستطيع محادثاتها بدء جلسات على أجهزتك؛ تابعها من هنا."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect daje Claude desktopu, Claude Codeu ili aplikaciji Codex cmux alate, pa njihovi chatovi mogu pokretati sesije na vašim mašinama; pratite ih ovdje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect giver Claude desktop, Claude Code eller Codex-appen cmux-værktøjerne, så deres chats kan starte sessioner på dine maskiner; følg dem her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect gibt Claude Desktop, Claude Code oder der Codex-App die cmux-Werkzeuge, damit ihre Chats Sitzungen auf deinen Maschinen starten können; verfolge sie hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect da a Claude para escritorio, Claude Code o la app de Codex las herramientas de cmux, para que sus chats inicien sesiones en tus máquinas; síguelas aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect donne à Claude desktop, Claude Code ou l'app Codex les outils cmux, pour que leurs chats lancent des sessions sur vos machines ; suivez-les ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect dà a Claude desktop, Claude Code o all'app Codex gli strumenti cmux, così le loro chat possono avviare sessioni sulle tue macchine; seguile qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect は Claude デスクトップ、Claude Code、Codex アプリに cmux のツールを渡し、そのチャットからあなたのマシンでセッションを開始できるようにします。ここで追跡できます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect ផ្តល់ឧបករណ៍ cmux ដល់ Claude desktop, Claude Code ឬកម្មវិធី Codex ដូច្នេះការជជែករបស់វាអាចចាប់ផ្តើមវគ្គនៅលើម៉ាស៊ីនរបស់អ្នក។ តាមដានវានៅទីនេះ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect는 Claude 데스크톱, Claude Code 또는 Codex 앱에 cmux 도구를 제공해 그 채팅이 내 머신에서 세션을 시작할 수 있게 합니다. 여기서 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect gir Claude desktop, Claude Code eller Codex-appen cmux-verktøyene, så chattene deres kan starte økter på maskinene dine; følg dem her."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect daje Claude desktop, Claude Code lub aplikacji Codex narzędzia cmux, więc ich czaty mogą uruchamiać sesje na Twoich maszynach; śledź je tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect dá ao Claude desktop, ao Claude Code ou ao app Codex as ferramentas do cmux, para que os chats deles iniciem sessões nas suas máquinas; acompanhe-as aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect даёт Claude desktop, Claude Code или приложению Codex инструменты cmux, чтобы их чаты могли запускать сеансы на ваших машинах; следите за ними здесь."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect ให้เครื่องมือ cmux แก่ Claude desktop, Claude Code หรือแอป Codex เพื่อให้แชตของแอปเหล่านั้นเริ่มเซสชันบนเครื่องของคุณได้ ติดตามได้ที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect, Claude masaüstü, Claude Code veya Codex uygulamasına cmux araçlarını verir; böylece sohbetleri makinelerinizde oturum başlatabilir. Onları buradan izleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect дає Claude desktop, Claude Code або застосунку Codex інструменти cmux, щоб їхні чати могли запускати сеанси на ваших машинах; стежте за ними тут."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect cấp cho Claude desktop, Claude Code hoặc ứng dụng Codex các công cụ cmux để cuộc trò chuyện ở đó có thể bắt đầu phiên trên máy của bạn; theo dõi tại đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect 为 Claude 桌面版、Claude Code 或 Codex 应用提供 cmux 工具，让其对话能在你的机器上启动会话；可在这里跟进。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect 為 Claude 桌面版、Claude Code 或 Codex App 提供 cmux 工具，讓其對話能在你的機器上啟動工作階段；可在這裡追蹤。"
          }
        }
      }
    }
  },
  "version" : "1.0"
