        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux nutzt die in deiner Azure-Ressource bereitgestellten Modelle. Füge den Endpunkt, einen Schlüssel und die Bereitstellungsnamen ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux will use the models you deployed in your Azure resource. Paste its endpoint, a key and the deployment names."
