    "settingsWindow.models.dialog.azure.description" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيستخدم cmux النماذج المنشورة في مورد Azure. الصق عنوان نقطة النهاية والمفتاح وأسماء عمليات النشر."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux će koristiti modele postavljene u tvom Azure resursu. Zalijepi krajnju tačku, ključ i nazive implementacija."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux bruger modellerne i din Azure-ressource. Indsæt endpoint, nøgle og udrulningsnavne."
