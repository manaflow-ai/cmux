    "settingsPage.remoteHosts.help" : {
      "comment" : "Labs preview in Settings > Devices; the SSH host owns these workspaces.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect to an SSH host and show its workspaces in the sidebar."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتصل بمضيف SSH واعرض مساحات عمله في الشريط الجانبي."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povežite se s SSH hostom i prikažite njegove radne prostore u bočnoj traci."
