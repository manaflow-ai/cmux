{
  "sourceLanguage" : "en",
  "strings" : {
    "settingsWindow.models.dialog.anthropic.description" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيستخدم cmux مفتاح API الخاص بك لدى Claude Console للوصول إلى نماذج Claude. تُحتسب تكلفة الاستخدام على حسابك لدى Claude Console."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux će koristiti tvoj API ključ za Claude Console za pristup opciji modeli Claude. Upotreba se naplaćuje na tvom nalogu za Claude Console."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux bruger din API-nøgle til Claude Console til at tilgå Claude-modeller. Forbrug faktureres på din Claude Console-konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux verwendet deinen API-Schlüssel für Claude Console für den Zugriff auf Modelle von Claude. Die Nutzung wird deinem Claude Console-Konto berechnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux will use your API key to access Claude models. Usage bills to your Claude Console account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux usará tu clave de API de Claude Console para acceder a los modelos de Claude. El consumo se factura en tu cuenta de Claude Console."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux utilisera votre clé API Claude Console pour accéder à des modèles Claude. L’utilisation est facturée sur votre compte Claude Console."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux userà la tua chiave API di Claude Console per accedere a modelli Claude. L’uso viene addebitato sul tuo account Claude Console."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmuxはお使いのClaude ConsoleのAPIキーを使用してClaudeモデルにアクセスします。使用料金はClaude Consoleアカウントに請求されます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux នឹងប្រើ សោ API របស់អ្នកសម្រាប់ Claude Console ដើម្បីចូលប្រើ ម៉ូដែល Claude។ ថ្លៃប្រើប្រាស់គិតលើគណនី Claude Console របស់អ្នក។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux에서 Claude Console API 키로 Claude 모델에 액세스합니다. 사용량은 Claude Console 계정으로 청구됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux bruker API-nøkkelen din for Claude Console for å få tilgang til modeller fra Claude. Bruken faktureres på Claude Console-kontoen din."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux użyje Twojego klucza API usługi Claude Console, aby uzyskać dostęp do modeli Claude. Koszt użycia zostanie rozliczony na Twoim koncie Claude Console."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cmux usará sua chave de API de Claude Console para acessar os modelos de Claude. O uso será cobrado na sua conta de Claude Console."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux будет использовать ваш ключ API для Claude Console для доступа к следующему: модели Claude. Оплата списывается с аккаунта Claude Console."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux จะใช้คีย์ API ของ Claude Consoleเพื่อเข้าถึงโมเดล Claude ระบบจะเรียกเก็บค่าบริการจากบัญชี Claude Console ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux Claude modellerine erişmek için Claude Console API anahtarınızı kullanacak. Kullanım Claude Console hesabınıza faturalandırılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux використає ваш ключ API для Claude Console для доступу до такого: моделі Claude. Плата за використання нараховується на обліковий запис Claude Console."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux sẽ dùng khóa API Claude Console của bạn để truy cập mô hình Claude. Phí sử dụng được tính vào tài khoản Claude Console của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux 将使用你的Claude Console API 密钥访问Claude模型。使用费用计入你的Claude Console账号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux 將使用你的Claude Console API 金鑰存取Claude模型。使用費用計入你的Claude Console帳號。"
          }
        }
      }
