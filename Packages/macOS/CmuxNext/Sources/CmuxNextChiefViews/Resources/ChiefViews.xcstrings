    "chiefViews.terminal.untitled": {
      "comment": "Name of a terminal agent's row when its tab has no title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal"
          }
        },
        "ar": {
