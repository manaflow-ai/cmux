{
  "sourceLanguage": "en",
  "strings": {
    "chiefViews.fleet.unreachable": {
      "comment": "The Fleet view's reason when the CI dashboard did not answer",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The CI dashboard did not answer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تستجب لوحة CI."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "CI kontrolna tabla nije odgovorila."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CI-dashboardet svarede ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das CI-Dashboard hat nicht geantwortet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El panel de CI no respondió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tableau de bord CI n’a pas répondu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dashboard CI non ha risposto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CI ダッシュボードが応答しませんでした。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្ទាំងគ្រប់គ្រង CI មិនបានឆ្លើយតបទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CI 대시보드가 응답하지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "CI-oversikten svarte ikke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel CI nie odpowiedział."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O painel de CI não respondeu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель CI не ответила."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แดชบอร์ด CI ไม่ตอบสนอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CI panosu yanıt vermedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель CI не відповіла."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảng điều khiển CI không phản hồi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CI 仪表板没有响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CI 儀表板沒有回應。"
          }
        }
      }
    },
    "chiefViews.fleet.unset": {
      "comment": "The Fleet view's reason when no CI dashboard address has been entered yet",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No CI dashboard is set."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تعيين لوحة CI."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije postavljena CI kontrolna tabla."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ikke angivet noget CI-dashboard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein CI-Dashboard festgelegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún panel de CI configurado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun tableau de bord CI n’est défini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna dashboard CI impostata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CI ダッシュボードが設定されていません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនទាន់កំណត់ផ្ទាំងគ្រប់គ្រង CI ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정된 CI 대시보드가 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen CI-oversikt er angitt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ustawiono panelu CI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum painel de CI definido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель CI не задана."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ตั้งแดชบอร์ด CI"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlı bir CI panosu yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель CI не задано."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa đặt bảng điều khiển CI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未设置 CI 仪表板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未設定 CI 儀表板。"
          }
        }
      }
    },
    "chiefViews.landing.unreachable": {
      "comment": "The Landing view's reason when GitHub did not answer (often its rate limit)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub did not answer. Try Refresh in a minute."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يستجب GitHub. جرّب التحديث بعد دقيقة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub nije odgovorio. Pokušajte Osvježi za minut."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub svarede ikke. Prøv Opdater om et minut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat nicht geantwortet. Versuche es in einer Minute mit Aktualisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub no respondió. Prueba Actualizar en un minuto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub n’a pas répondu. Réessayez Actualiser dans une minute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub non ha risposto. Riprova Aggiorna tra un minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub が応答しませんでした。1 分後に更新してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub មិនបានឆ្លើយតបទេ។ សូមសាកល្បងធ្វើឱ្យស្រស់ក្នុងរយៈពេលមួយនាទី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub가 응답하지 않았습니다. 1분 후 새로 고침을 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub svarte ikke. Prøv Oppdater om et minutt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub nie odpowiedział. Spróbuj Odśwież za minutę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GitHub não respondeu. Tente Atualizar em um minuto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub не ответил. Попробуйте «Обновить» через минуту."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ไม่ตอบสนอง ลองรีเฟรชอีกครั้งในอีกหนึ่งนาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub yanıt vermedi. Bir dakika sonra Yenile’yi deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub не відповів. Спробуйте «Оновити» за хвилину."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub không phản hồi. Hãy thử Làm mới sau một phút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 没有响应。请一分钟后再刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 沒有回應。請一分鐘後再重新整理。"
          }
        }
      }
    },
    "chiefViews.open.gone": {
      "comment": "Refusal when a row's agent is no longer running, so there is no chat or terminal to show",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That agent is no longer running."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد هذا الوكيل قيد التشغيل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Taj agent više ne radi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den agent kører ikke længere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Agent läuft nicht mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese agente ya no se está ejecutando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet agent ne s’exécute plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quell’agente non è più in esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのエージェントはもう実行されていません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្នាក់ងារនោះលែងដំណើរការហើយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 에이전트는 더 이상 실행 중이 아닙니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den agenten kjører ikke lenger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten agent już nie działa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse agente não está mais em execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот агент больше не работает."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์นั้นไม่ได้ทำงานอยู่แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O ajan artık çalışmıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей агент більше не працює."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác nhân đó không còn chạy nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该代理已不再运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該代理已不再執行。"
          }
        }
      }
    },
    "chiefViews.refusal.off": {
      "comment": "Why the Chief view gallery action is unavailable: its Debug Settings toggle is off or this is a Release build",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Chief view gallery is off. Turn on Chief view gallery in Debug Settings > Home."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معرض عروض Chief متوقف. شغّل «معرض عروض Chief» في إعدادات التصحيح > الصفحة الرئيسية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Galerija prikaza Chiefa je isključena. Uključite Galeriju prikaza Chiefa u Postavkama za otklanjanje grešaka > Početna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief-visningsgalleriet er slået fra. Slå Chief-visningsgalleri til under Fejlfindingsindstillinger > Hjem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Chief-Ansichtsgalerie ist aus. Schalte „Chief-Ansichtsgalerie“ unter Debug-Einstellungen > Home ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La galería de vistas del Chief está desactivada. Actívala en Ajustes de depuración > Inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La galerie de vues du Chief est désactivée. Activez-la dans Réglages de débogage > Accueil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La galleria di viste del Chief è disattivata. Attivala in Impostazioni di debug > Home."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief ビューギャラリーはオフです。デバッグ設定 > ホーム でオンにしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វិចិត្រសាលទិដ្ឋភាព Chief ត្រូវបានបិទ។ បើកវានៅក្នុង ការកំណត់បំបាត់កំហុស > ទំព័រដើម។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief 보기 갤러리가 꺼져 있습니다. 디버그 설정 > 홈에서 켜세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief-visningsgalleriet er av. Slå det på under Feilsøkingsinnstillinger > Hjem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Galeria widoków Chiefa jest wyłączona. Włącz ją w Ustawieniach debugowania > Start."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A galeria de visualizações do Chief está desativada. Ative-a em Ajustes de depuração > Início."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Галерея представлений Chief выключена. Включите её в разделе «Настройки отладки > Главная»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แกลเลอรีมุมมองของ Chief ปิดอยู่ เปิดได้ที่ การตั้งค่าดีบัก > หน้าหลัก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief görünüm galerisi kapalı. Hata ayıklama ayarları > Ana sayfa bölümünden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Галерею подань Chief вимкнено. Увімкніть її в «Налаштуваннях налагодження > Головна»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư viện chế độ xem của Chief đang tắt. Bật nó trong Cài đặt gỡ lỗi > Trang chủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief 视图库已关闭。请在“调试设置 > 主页”中打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief 檢視庫已關閉。請在「除錯設定 > 首頁」中開啟。"
          }
        }
      }
    },
