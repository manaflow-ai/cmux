        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập này chưa đầy đủ. Hãy xác thực lại rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
