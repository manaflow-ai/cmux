    "accounts.teams.readOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only team admins can rename or delete this team."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Team-Admins können dieses Team umbenennen oder löschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les administrateurs de l'équipe peuvent la renommer ou la supprimer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لمسؤولي الفريق فقط إعادة تسمية هذا الفريق أو حذفه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los administradores del equipo pueden cambiarle el nombre o eliminarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有團隊管理員可以重新命名或刪除此團隊。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有团队管理员可以重命名或删除此团队。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팀 관리자만 이 팀의 이름을 바꾸거나 삭제할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチームの名前変更や削除ができるのはチームの管理者だけです。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo gli amministratori del team possono rinominarlo o eliminarlo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun teamets administratorer kan omdøbe eller slette dette team."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko administratorzy zespołu mogą zmienić jego nazwę lub go usunąć."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переименовать или удалить эту команду могут только её администраторы."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo administratori tima mogu preimenovati ili izbrisati ovaj tim."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare teamets administratorer kan gi nytt navn til eller slette dette teamet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente administradores da equipe podem renomeá-la ou excluí-la."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะผู้ดูแลทีมเท่านั้นที่เปลี่ยนชื่อหรือลบทีมนี้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ekibi yalnızca ekip yöneticileri yeniden adlandırabilir veya silebilir."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មានតែអ្នកគ្រប់គ្រងក្រុមប៉ុណ្ណោះដែលអាចប្ដូរឈ្មោះ ឬលុបក្រុមនេះបាន។"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейменувати або видалити цю команду можуть лише її адміністратори."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ quản trị viên của nhóm mới có thể đổi tên hoặc xóa nhóm này."
          }
        }
      }
    },
