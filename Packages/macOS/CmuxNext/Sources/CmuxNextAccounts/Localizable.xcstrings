    "accounts.cmuxSignedOut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to cmux to connect accounts to CodeRouter, so cmux agents and Cloud machines can use them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux にサインインすると、アカウントを CodeRouter に接続して cmux のエージェントと Cloud マシンで使えます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سجّل الدخول إلى cmux لربط الحسابات بـ CodeRouter، حتى تتمكن وكلاء cmux وأجهزة Cloud من استخدامها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prijavite se u cmux da povežete račune s CodeRouterom, kako bi ih cmux agenti i Cloud mašine mogli koristiti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Log ind på cmux for at forbinde konti til CodeRouter, så cmux-agenter og Cloud-maskiner kan bruge dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Melde dich bei cmux an, um Konten mit CodeRouter zu verbinden, damit cmux-Agenten und Cloud-Maschinen sie nutzen können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inicia sesión en cmux para conectar cuentas a CodeRouter y que los agentes de cmux y las máquinas Cloud puedan usarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connectez-vous à cmux pour relier des comptes à CodeRouter, afin que les agents cmux et les machines Cloud puissent les utiliser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Accedi a cmux per collegare gli account a CodeRouter, così gli agenti cmux e le macchine Cloud possono usarli."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ចូល cmux ដើម្បីភ្ជាប់គណនីទៅ CodeRouter ដើម្បីឱ្យភ្នាក់ងារ cmux និងម៉ាស៊ីន Cloud អាចប្រើវាបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux에 로그인하면 계정을 CodeRouter에 연결해 cmux 에이전트와 Cloud 머신에서 사용할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Logg inn på cmux for å koble kontoer til CodeRouter, slik at cmux-agenter og Cloud-maskiner kan bruke dem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zaloguj się do cmux, aby połączyć konta z CodeRouter, tak by agenci cmux i maszyny Cloud mogli z nich korzystać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Entre no cmux para conectar contas ao CodeRouter, para que agentes do cmux e máquinas Cloud possam usá-las."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Войдите в cmux, чтобы подключить аккаунты к CodeRouter и дать агентам cmux и машинам Cloud ими пользоваться."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลงชื่อเข้าใช้ cmux เพื่อเชื่อมบัญชีกับ CodeRouter ให้เอเจนต์ของ cmux และเครื่อง Cloud ใช้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hesapları CodeRouter'a bağlamak için cmux'a giriş yapın; böylece cmux ajanları ve Cloud makineleri bunları kullanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Увійдіть у cmux, щоб підключити облікові записи до CodeRouter і дати агентам cmux та машинам Cloud ними користуватися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đăng nhập cmux để kết nối tài khoản với CodeRouter, để các agent của cmux và máy Cloud có thể dùng chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "登录 cmux 后可将账号连接到 CodeRouter，供 cmux 代理和 Cloud 机器使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "登入 cmux 後可將帳號連接到 CodeRouter，供 cmux 代理程式與 Cloud 機器使用。"
          }
        }
      }
    },
