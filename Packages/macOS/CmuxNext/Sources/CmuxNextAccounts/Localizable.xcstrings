    "accounts.cmux.finishInBrowser": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish signing in in your browser. If no page opened, choose Open in Browser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザでサインインを完了してください。ページが開かない場合は「ブラウザで開く」を選んでください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكمل تسجيل الدخول في متصفحك. إذا لم تُفتح أي صفحة، فاختر «فتح في المتصفح»."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Završite prijavu u pregledniku. Ako se stranica nije otvorila, odaberite Otvori u pregledniku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gør login færdigt i din browser. Hvis der ikke blev åbnet en side, så vælg Åbn i browser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe die Anmeldung im Browser ab. Wenn sich keine Seite geöffnet hat, wähle „Im Browser öffnen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina de iniciar sesión en el navegador. Si no se abrió ninguna página, elige Abrir en el navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez la connexion dans votre navigateur. Si aucune page ne s’est ouverte, choisissez Ouvrir dans le navigateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa l’accesso nel browser. Se non si è aperta nessuna pagina, scegli Apri nel browser."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ចប់ការចូលនៅក្នុងកម្មវិធីរុករករបស់អ្នក។ ប្រសិនបើគ្មានទំព័របើកទេ សូមជ្រើស បើកក្នុងកម្មវិធីរុករក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저에서 로그인을 마치세요. 페이지가 열리지 않았다면 브라우저에서 열기를 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fullfør innloggingen i nettleseren. Hvis ingen side åpnet seg, velg Åpne i nettleser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokończ logowanie w przeglądarce. Jeśli żadna strona się nie otworzyła, wybierz Otwórz w przeglądarce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine de entrar no navegador. Se nenhuma página abriu, escolha Abrir no navegador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершите вход в браузере. Если страница не открылась, выберите «Открыть в браузере»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าใช้ให้เสร็จในเบราว์เซอร์ หากไม่มีหน้าเปิดขึ้น ให้เลือก เปิดในเบราว์เซอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girişi tarayıcınızda tamamlayın. Hiçbir sayfa açılmadıysa Tarayıcıda Aç'ı seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершіть вхід у браузері. Якщо сторінка не відкрилася, виберіть «Відкрити в браузері»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoàn tất đăng nhập trong trình duyệt. Nếu không có trang nào mở, hãy chọn Mở trong trình duyệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在浏览器中完成登录。如果没有打开页面，请选择“在浏览器中打开”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在瀏覽器中完成登入。如果沒有開啟頁面，請選擇「在瀏覽器中打開」。"
          }
        }
      }
    },
