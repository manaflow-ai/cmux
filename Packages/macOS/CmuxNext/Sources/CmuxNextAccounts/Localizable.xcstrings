            "value": "CodeRouter មិនទាន់គាំទ្រអ្នកផ្តល់សេវានេះនៅឡើយទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter는 아직 이 제공업체를 지원하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter støtter ikke denne leverandøren ennå."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter nie obsługuje jeszcze tego dostawcy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CodeRouter ainda não roteia este provedor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter пока не работает с этим провайдером."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter ยังไม่รองรับผู้ให้บริการนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter bu sağlayıcıyı henüz yönlendirmiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter поки не працює з цим провайдером."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter chưa hỗ trợ nhà cung cấp này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter 尚不支持此提供商。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter 尚不支援此供應商。"
          }
        }
      }
    },
