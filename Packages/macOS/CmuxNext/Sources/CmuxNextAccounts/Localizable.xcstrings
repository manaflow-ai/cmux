    "accounts.hint.bedrockKeys": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To connect, set %@ in your shell."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "接続するには、シェルで %@ を設定してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "للربط، اضبط %@ في الصدفة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Za povezivanje postavite %@ u svom shellu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Angiv %@ i din shell for at forbinde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Setze zum Verbinden %@ in deiner Shell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para conectar, define %@ en tu shell."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour connecter, définissez %@ dans votre shell."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Per collegare, imposta %@ nella shell."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ដើម្បីភ្ជាប់ សូមកំណត់ %@ ក្នុង shell របស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "연결하려면 셸에서 %@을(를) 설정하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sett %@ i skallet ditt for å koble til."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aby połączyć, ustaw %@ w powłoce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para conectar, defina %@ no seu shell."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Чтобы подключить, задайте %@ в оболочке."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หากต้องการเชื่อม ให้ตั้งค่า %@ ในเชลล์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bağlamak için kabuğunuzda %@ ayarlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Щоб підключити, задайте %@ в оболонці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Để kết nối, hãy đặt %@ trong shell."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "要连接，请在 shell 中设置 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "若要連接，請在 shell 中設定 %@。"
          }
        }
      }
    },
