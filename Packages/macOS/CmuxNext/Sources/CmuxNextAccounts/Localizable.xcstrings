            "value": "Åbn først et arbejdsområde på denne Mac, og prøv så igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne zuerst einen Arbeitsbereich auf diesem Mac und versuche es dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre primero un espacio de trabajo en este Mac y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez d’abord un espace de travail sur ce Mac, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri prima uno spazio di lavoro su questo Mac, poi riprova."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បើកកន្លែងធ្វើការនៅលើ Mac នេះជាមុនសិន រួចព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 이 Mac에서 작업 공간을 연 뒤 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne først et arbeidsområde på denne Macen, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw otwórz obszar roboczy na tym Macu i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra primeiro um espaço de trabalho neste Mac e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала откройте рабочее пространство на этом Mac и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดพื้นที่ทำงานบน Mac เครื่องนี้ก่อน แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce bu Mac’te bir çalışma alanı açın, sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу відкрийте робочий простір на цьому Mac і повторіть спробу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy mở một không gian làm việc trên máy Mac này trước rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在这台 Mac 上打开一个工作区，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在這台 Mac 上開啟一個工作區，然後再試一次。"
          }
        }
      }
    },
