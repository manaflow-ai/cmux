    "accounts.teams.error.subscription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This team has an active subscription. Cancel it in Billing, then delete the team."
          }
        },
        "de": {
