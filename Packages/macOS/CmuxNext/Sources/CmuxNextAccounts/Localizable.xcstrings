    "accounts.team.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud machines, CodeRouter and phone access use this team."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم أجهزة السحابة وCodeRouter والهاتف هذا الفريق."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud mašine, CodeRouter i telefon koriste ovaj tim."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-maskiner, CodeRouter og telefonen bruger dette team."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-Maschinen, CodeRouter und Telefon nutzen dieses Team."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las máquinas Cloud, CodeRouter y el móvil usan este equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Machines Cloud, CodeRouter et téléphone utilisent l’équipe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Macchine Cloud, CodeRouter e telefono usano questo team."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドマシン、CodeRouter、電話からのアクセスはこのチームを使います。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម៉ាស៊ីន Cloud, CodeRouter និងការចូលពីទូរសព្ទ ប្រើក្រុមនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 머신, CodeRouter, 휴대폰 접근이 이 팀을 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-maskiner, CodeRouter og telefonen bruker dette teamet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maszyny Cloud, CodeRouter i telefon używają tego zespołu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Máquinas Cloud, CodeRouter e o telefone usam esta equipe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Облачные машины, CodeRouter и телефон работают с командой."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่อง Cloud, CodeRouter และการเข้าถึงจากโทรศัพท์ใช้ทีมนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulut makineleri, CodeRouter ve telefon bu ekibi kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хмарні машини, CodeRouter і телефон працюють із командою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Cloud, CodeRouter và điện thoại dùng nhóm này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端机器、CodeRouter 和手机访问都使用此团队。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲端機器、CodeRouter 與手機存取都使用此團隊。"
          }
        }
      }
