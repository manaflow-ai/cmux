    "accounts.error.incomplete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sign-in is incomplete. Re-authenticate, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサインインは不完全です。再認証してからもう一度お試しください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الدخول هذا غير مكتمل. أعد المصادقة ثم حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova prijava nije potpuna. Ponovo se prijavite, pa pokušajte ponovo."
          }
