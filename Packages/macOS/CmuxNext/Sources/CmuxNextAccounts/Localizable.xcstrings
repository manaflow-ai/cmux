    "accounts.error.busy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another action on this account is still running. Try again when it finishes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントで別の操作がまだ実行中です。終わってからもう一度お試しください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال إجراء آخر على هذا الحساب قيد التشغيل. حاول مرة أخرى عند انتهائه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Druga radnja na ovom računu još traje. Pokušajte ponovo kada završi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En anden handling på denne konto kører stadig. Prøv igen, når den er færdig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere Aktion für dieses Konto läuft noch. Versuche es erneut, wenn sie fertig ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra acción en esta cuenta sigue en curso. Inténtalo de nuevo cuando termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre action sur ce compte est encore en cours. Réessayez quand elle sera terminée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’altra azione su questo account è ancora in corso. Riprova quando è terminata."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សកម្មភាពផ្សេងទៀតលើគណនីនេះកំពុងដំណើរការនៅឡើយ។ សូមព្យាយាមម្តងទៀតពេលវាបញ្ចប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정에서 다른 작업이 아직 실행 중입니다. 끝나면 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En annen handling på denne kontoen kjører fortsatt. Prøv igjen når den er ferdig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inna czynność na tym koncie wciąż trwa. Spróbuj ponownie, gdy się zakończy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra ação nesta conta ainda está em andamento. Tente novamente quando ela terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другое действие с этой учётной записью ещё выполняется. Повторите попытку, когда оно завершится."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังมีการดำเนินการอื่นกับบัญชีนี้อยู่ ลองอีกครั้งเมื่อเสร็จแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesapta başka bir işlem hâlâ sürüyor. Bittiğinde yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інша дія з цим обліковим записом ще виконується. Спробуйте ще раз, коли вона завершиться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một thao tác khác trên tài khoản này vẫn đang chạy. Hãy thử lại khi thao tác đó xong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户上的另一项操作仍在进行。请在其完成后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳號上的另一項操作仍在進行。請在完成後再試一次。"
          }
        }
      }
    },
    "accounts.error.staleList": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account list changed. Refresh, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントの一覧が変わりました。更新してからもう一度お試しください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت قائمة الحسابات. حدّثها، ثم حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Popis računa se promijenio. Osvježite ga, pa pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontolisten er ændret. Opdater, og prøv så igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kontoliste hat sich geändert. Aktualisiere sie und versuche es dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de cuentas cambió. Actualízala y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste des comptes a changé. Actualisez-la, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’elenco degli account è cambiato. Aggiorna, poi riprova."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ជីគណនីបានផ្លាស់ប្តូរ។ សូមផ្ទុកឡើងវិញ រួចព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 목록이 바뀌었습니다. 새로 고친 다음 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontolisten er endret. Oppdater, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista kont się zmieniła. Odśwież ją, a potem spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista de contas mudou. Atualize e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список учётных записей изменился. Обновите его и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการบัญชีเปลี่ยนไปแล้ว รีเฟรช แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap listesi değişti. Yenileyin, sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Список облікових записів змінився. Оновіть його й спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh sách tài khoản đã thay đổi. Hãy làm mới rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户列表已变更。请刷新后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳號列表已變更。請重新整理後再試一次。"
          }
        }
      }
    },
