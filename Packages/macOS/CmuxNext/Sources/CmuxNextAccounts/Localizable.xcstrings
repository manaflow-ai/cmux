        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 로그인은 불완전합니다. 다시 인증한 뒤 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne påloggingen er ufullstendig. Autentiser på nytt og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To logowanie jest niepełne. Uwierzytelnij się ponownie i spróbuj jeszcze raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este login está incompleto. Autentique novamente e tente outra vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот вход неполный. Войдите заново и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลงชื่อเข้าใช้นี้ไม่สมบูรณ์ ให้ยืนยันตัวตนอีกครั้งแล้วลองใหม่"
