    "accounts.teams.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are not in a team yet. Create one to share Cloud machines and settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist noch in keinem Team. Erstelle eines, um Cloud-Maschinen und Einstellungen zu teilen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne faites encore partie d'aucune équipe. Créez-en une pour partager des machines Cloud et des réglages."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لست في أي فريق بعد. أنشئ فريقًا لمشاركة أجهزة السحابة والإعدادات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no estás en ningún equipo. Crea uno para compartir máquinas en la nube y ajustes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你還不在任何團隊中。建立一個團隊即可共用雲端機器與設定。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你还不在任何团队中。创建一个团队即可共享云端机器和设置。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 속한 팀이 없습니다. 팀을 만들어 클라우드 머신과 설정을 공유하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだチームに参加していません。チームを作成すると、クラウドマシンと設定を共有できます。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non fai ancora parte di un team. Creane uno per condividere macchine Cloud e impostazioni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er ikke med i et team endnu. Opret et for at dele Cloud-maskiner og indstillinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie należysz jeszcze do żadnego zespołu. Utwórz zespół, aby udostępniać maszyny w chmurze i ustawienia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы пока не состоите в команде. Создайте её, чтобы делиться облачными машинами и настройками."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Još niste ni u jednom timu. Kreirajte tim da dijelite Cloud mašine i postavke."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er ikke med i et team ennå. Opprett et for å dele Cloud-maskiner og innstillinger."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ainda não está em uma equipe. Crie uma para compartilhar máquinas na nuvem e configurações."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยังไม่ได้อยู่ในทีมใด สร้างทีมเพื่อแชร์เครื่อง Cloud และการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz bir ekipte değilsiniz. Bulut makinelerini ve ayarları paylaşmak için bir ekip oluşturun."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកមិនទាន់នៅក្នុងក្រុមណាមួយនៅឡើយទេ។ បង្កើតក្រុមមួយដើម្បីចែករំលែកម៉ាស៊ីន Cloud និងការកំណត់។"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви ще не в команді. Створіть її, щоб ділитися хмарними машинами й налаштуваннями."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chưa ở trong nhóm nào. Hãy tạo một nhóm để chia sẻ máy Cloud và cài đặt."
          }
        }
      }
    },
