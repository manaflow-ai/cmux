    "accounts.teams.deleteQuestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete “%@”? Its members lose access to the team's Cloud machines and settings. This cannot be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ löschen? Seine Mitglieder verlieren den Zugriff auf die Cloud-Maschinen und Einstellungen des Teams. Dies kann nicht widerrufen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer « %@ » ? Ses membres perdront l'accès aux machines Cloud et aux réglages de l'équipe. Cette action est irréversible."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد حذف ”%@“؟ سيفقد أعضاؤه الوصول إلى أجهزة السحابة وإعدادات الفريق. لا يمكن التراجع عن ذلك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar «%@»? Sus miembros perderán el acceso a las máquinas en la nube y los ajustes del equipo. Esta acción no se puede deshacer."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要刪除「%@」嗎？其成員將無法再存取此團隊的雲端機器與設定。此動作無法還原。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要删除“%@”吗？其成员将无法再访问该团队的云端机器和设置。此操作无法撤销。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”을(를) 삭제하시겠습니까? 멤버는 팀의 클라우드 머신과 설정에 더 이상 접근할 수 없습니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を削除しますか？メンバーはこのチームのクラウドマシンと設定にアクセスできなくなります。この操作は取り消せません。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare «%@»? I suoi membri perderanno l'accesso alle macchine Cloud e alle impostazioni del team. L'operazione non può essere annullata."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet “%@”? Medlemmerne mister adgang til teamets Cloud-maskiner og indstillinger. Dette kan ikke fortrydes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć „%@”? Członkowie stracą dostęp do maszyn w chmurze i ustawień zespołu. Tej operacji nie można cofnąć."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить «%@»? Участники потеряют доступ к облачным машинам и настройкам команды. Это действие нельзя отменить."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrisati „%@“? Članovi gube pristup Cloud mašinama i postavkama tima. Ovo se ne može poništiti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slette «%@»? Medlemmene mister tilgang til teamets Cloud-maskiner og innstillinger. Dette kan ikke angres."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir “%@”? Os membros perderão o acesso às máquinas na nuvem e às configurações da equipe. Esta ação não pode ser desfeita."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบ “%@” หรือไม่ สมาชิกจะเข้าถึงเครื่อง Cloud และการตั้งค่าของทีมไม่ได้อีก การดำเนินการนี้เลิกทำไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” silinsin mi? Üyeleri ekibin bulut makinelerine ve ayarlarına erişimini kaybeder. Bu işlem geri alınamaz."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "លុប “%@” ឬ? សមាជិករបស់វានឹងបាត់បង់សិទ្ធិចូលប្រើម៉ាស៊ីន Cloud និងការកំណត់របស់ក្រុម។ សកម្មភាពនេះមិនអាចមិនធ្វើវិញបានទេ។"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити «%@»? Учасники втратять доступ до хмарних машин і налаштувань команди. Цю дію не можна скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa “%@”? Các thành viên sẽ mất quyền truy cập máy Cloud và cài đặt của nhóm. Không thể hoàn tác thao tác này."
          }
        }
      }
    },
