    "accounts.team.managed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your organization chose this device's team."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختارت مؤسستك فريق هذا الجهاز."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
