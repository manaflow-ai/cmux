        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anmeldung ist unvollständig. Melde dich erneut an und versuche es dann noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este inicio de sesión está incompleto. Vuelve a autenticarte y repite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette connexion est incomplète. Réauthentifiez-vous, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo accesso è incompleto. Autenticati di nuovo, poi riprova."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការចូលនេះមិនពេញលេញ។ សូមផ្ទៀងផ្ទាត់ម្តងទៀត រួចព្យាយាមម្តងទៀត។"
