    "accounts.paste.keyBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key goes to the macOS Keychain or to CodeRouter. cmux never writes it to cmux.json."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "キーは macOS のキーチェーンか CodeRouter に保存されます。cmux.json には書き込みません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يُحفظ المفتاح في سلسلة مفاتيح macOS أو يُرسل إلى CodeRouter. لا يكتبه cmux أبدًا في cmux.json."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ključ ide u macOS Keychain ili u CodeRouter. cmux ga nikad ne upisuje u cmux.json."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nøglen gemmes i macOS-nøgleringen eller sendes til CodeRouter. cmux skriver den aldrig i cmux.json."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Schlüssel geht in den macOS-Schlüsselbund oder an CodeRouter. cmux schreibt ihn nie in cmux.json."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La clave va al llavero de macOS o a CodeRouter. cmux nunca la escribe en cmux.json."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La clé va dans le trousseau macOS ou dans CodeRouter. cmux ne l’écrit jamais dans cmux.json."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La chiave va nel portachiavi di macOS o in CodeRouter. cmux non la scrive mai in cmux.json."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កូនសោត្រូវបានរក្សាទុកក្នុង Keychain របស់ macOS ឬផ្ញើទៅ CodeRouter។ cmux មិនដែលសរសេរវាទៅ cmux.json ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "키는 macOS 키체인이나 CodeRouter에 저장됩니다. cmux는 키를 cmux.json에 쓰지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nøkkelen lagres i macOS-nøkkelringen eller sendes til CodeRouter. cmux skriver den aldri til cmux.json."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klucz trafia do pęku kluczy macOS lub do CodeRouter. cmux nigdy nie zapisuje go w cmux.json."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A chave vai para as Chaves do macOS ou para o CodeRouter. O cmux nunca a grava no cmux.json."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ключ сохраняется в связке ключей macOS или отправляется в CodeRouter. cmux никогда не записывает его в cmux.json."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คีย์จะเก็บไว้ในพวงกุญแจของ macOS หรือส่งไปที่ CodeRouter โดย cmux จะไม่เขียนลงใน cmux.json"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anahtar macOS Anahtar Zinciri'ne veya CodeRouter'a gider. cmux onu asla cmux.json dosyasına yazmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ключ зберігається у в’язці ключів macOS або надсилається до CodeRouter. cmux ніколи не записує його в cmux.json."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khóa được lưu trong Chuỗi khóa của macOS hoặc gửi tới CodeRouter. cmux không bao giờ ghi khóa vào cmux.json."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "密钥会存入 macOS 钥匙串或发送到 CodeRouter。cmux 从不将其写入 cmux.json。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "金鑰會存入 macOS 鑰匙圈或傳送到 CodeRouter。cmux 絕不會將其寫入 cmux.json。"
          }
        }
      }
    },
