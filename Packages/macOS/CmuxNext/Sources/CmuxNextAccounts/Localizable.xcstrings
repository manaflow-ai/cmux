          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette team har et aktivt abonnement. Opsig det under Fakturering, og slet derefter teamet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
