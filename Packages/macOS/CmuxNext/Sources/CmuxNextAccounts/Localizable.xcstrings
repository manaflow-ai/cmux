            "value": "You become the team's admin, and it becomes your active team."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst Admin des Teams, und es wird dein aktives Team."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous en devenez l'administrateur, et elle devient votre équipe active."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستصبح مسؤول الفريق، وسيصبح فريقك النشط."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Serás el administrador del equipo y pasará a ser tu equipo activo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你會成為團隊管理員，且它會成為你的目前團隊。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你将成为团队管理员，并且它会成为你的当前团队。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 팀 관리자가 되고, 이 팀이 활성 팀이 됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたがチームの管理者になり、このチームがアクティブなチームになります。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diventi amministratore del team, che diventa il tuo team attivo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bliver teamets administrator, og det bliver dit aktive team."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaniesz administratorem zespołu, a zespół stanie się aktywny."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы станете администратором команды, и она станет активной."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Postajete administrator tima, a tim postaje vaš aktivni tim."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du blir teamets administrator, og det blir ditt aktive team."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você se torna o administrador da equipe, e ela passa a ser sua equipe ativa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะเป็นผู้ดูแลทีม และทีมนี้จะเป็นทีมที่ใช้งานอยู่ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekibin yöneticisi olursunuz ve ekip etkin ekibiniz olur."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកនឹងក្លាយជាអ្នកគ្រប់គ្រងក្រុម ហើយវានឹងក្លាយជាក្រុមសកម្មរបស់អ្នក។"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви станете адміністратором команди, і вона стане активною."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ là quản trị viên của nhóm, và nhóm sẽ thành nhóm đang dùng của bạn."
          }
        }
      }
    },
