    "accounts.paste.claudeBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter needs a long-lived token. Run claude setup-token, then paste the token here. It goes to CodeRouter only."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter には長期間有効なトークンが必要です。claude setup-token を実行し、表示されたトークンをここに貼り付けてください。トークンは CodeRouter にだけ送られます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج CodeRouter إلى رمز طويل الأمد. شغّل claude setup-token ثم الصق الرمز هنا. يُرسل إلى CodeRouter فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter treba dugotrajni token. Pokrenite claude setup-token, pa zalijepite token ovdje. Ide samo u CodeRouter."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter skal bruge et langvarigt token. Kør claude setup-token, og indsæt tokenet her. Det sendes kun til CodeRouter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter braucht ein langlebiges Token. Führe claude setup-token aus und füge das Token hier ein. Es geht nur an CodeRouter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter necesita un token de larga duración. Ejecuta claude setup-token y pega aquí el token. Solo se envía a CodeRouter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter a besoin d’un jeton de longue durée. Exécutez claude setup-token, puis collez le jeton ici. Il n’est envoyé qu’à CodeRouter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter richiede un token di lunga durata. Esegui claude setup-token, poi incolla qui il token. Viene inviato solo a CodeRouter."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter ត្រូវការថូខឹនរយៈពេលវែង។ ដំណើរការ claude setup-token រួចបិទភ្ជាប់ថូខឹននៅទីនេះ។ វាត្រូវបានផ្ញើទៅ CodeRouter តែប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter에는 장기 토큰이 필요합니다. claude setup-token을 실행한 뒤 토큰을 여기에 붙여 넣으세요. 토큰은 CodeRouter로만 전송됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter trenger et langvarig token. Kjør claude setup-token, og lim inn tokenet her. Det sendes bare til CodeRouter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter potrzebuje długoterminowego tokenu. Uruchom claude setup-token, a potem wklej tu token. Trafia on tylko do CodeRouter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CodeRouter precisa de um token de longa duração. Execute claude setup-token e cole o token aqui. Ele vai só para o CodeRouter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter нужен долгоживущий токен. Выполните claude setup-token и вставьте токен сюда. Он отправляется только в CodeRouter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter ต้องใช้โทเค็นแบบใช้ได้นาน ให้รัน claude setup-token แล้ววางโทเค็นที่นี่ โทเค็นจะส่งไปที่ CodeRouter เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter uzun ömürlü bir belirteç gerektirir. claude setup-token komutunu çalıştırın ve belirteci buraya yapıştırın. Yalnızca CodeRouter'a gönderilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter потрібен довготривалий токен. Виконайте claude setup-token і вставте токен сюди. Він надсилається лише до CodeRouter."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter cần một token dùng lâu dài. Chạy claude setup-token rồi dán token vào đây. Token chỉ được gửi tới CodeRouter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter 需要长期有效的令牌。运行 claude setup-token，然后将令牌粘贴到这里。令牌只会发送到 CodeRouter。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter 需要長期有效的權杖。執行 claude setup-token，然後將權杖貼到這裡。權杖只會傳送到 CodeRouter。"
          }
        }
      }
    },
