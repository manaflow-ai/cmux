    "accounts.confirm.codexNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter stores this Codex sign-in, with its refresh token, and refreshes it on the server. The codex command on this Mac may then need codex login again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter はこの Codex のサインインをリフレッシュトークンごと保存し、サーバー側で更新します。その後、この Mac の codex コマンドで codex login が再び必要になることがあります。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخزّن CodeRouter تسجيل دخول Codex هذا مع رمز التحديث الخاص به ويجدده على الخادم. قد يحتاج أمر codex على جهاز Mac هذا بعد ذلك إلى codex login مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter čuva ovu Codex prijavu zajedno s tokenom za osvježavanje i osvježava je na serveru. Naredba codex na ovom Macu tada može ponovo trebati codex login."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter gemmer dette Codex-login med dets opdateringstoken og fornyer det på serveren. Kommandoen codex på denne Mac kan derefter få brug for codex login igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter speichert diese Codex-Anmeldung samt Refresh-Token und erneuert sie auf dem Server. Der Befehl codex auf diesem Mac braucht danach eventuell erneut codex login."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter guarda este inicio de sesión de Codex, con su token de actualización, y lo renueva en el servidor. Después, el comando codex de este Mac puede necesitar codex login de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter stocke cette connexion Codex, avec son jeton d’actualisation, et la renouvelle sur le serveur. La commande codex de ce Mac peut ensuite nécessiter à nouveau codex login."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter memorizza questo accesso a Codex, con il suo token di aggiornamento, e lo rinnova sul server. Il comando codex su questo Mac potrebbe poi richiedere di nuovo codex login."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter រក្សាទុកការចូល Codex នេះ រួមទាំងថូខឹនធ្វើឱ្យថ្មី ហើយធ្វើឱ្យវាថ្មីនៅលើម៉ាស៊ីនមេ។ បន្ទាប់មក ពាក្យបញ្ជា codex នៅលើ Mac នេះអាចត្រូវការ codex login ម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter는 이 Codex 로그인을 새로 고침 토큰과 함께 저장하고 서버에서 갱신합니다. 그 후 이 Mac의 codex 명령에서 codex login이 다시 필요할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter lagrer denne Codex-påloggingen med oppdateringstokenet og fornyer den på serveren. Kommandoen codex på denne Macen kan da trenge codex login igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter przechowuje to logowanie Codex wraz z tokenem odświeżania i odnawia je na serwerze. Polecenie codex na tym Macu może potem znów wymagać codex login."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CodeRouter guarda este login do Codex, com seu token de atualização, e o renova no servidor. Depois, o comando codex neste Mac pode precisar de codex login novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter сохраняет этот вход в Codex вместе с токеном обновления и обновляет его на сервере. После этого команде codex на этом Mac может снова понадобиться codex login."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter จะเก็บการลงชื่อเข้าใช้ Codex นี้พร้อมโทเค็นรีเฟรช และต่ออายุบนเซิร์ฟเวอร์ หลังจากนั้นคำสั่ง codex บน Mac เครื่องนี้อาจต้องใช้ codex login อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter bu Codex oturumunu yenileme belirteciyle birlikte saklar ve sunucuda yeniler. Bundan sonra bu Mac'teki codex komutu yeniden codex login gerektirebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter зберігає цей вхід у Codex разом із токеном оновлення й оновлює його на сервері. Після цього команді codex на цьому Mac може знову знадобитися codex login."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter lưu đăng nhập Codex này cùng token làm mới và gia hạn nó trên máy chủ. Sau đó lệnh codex trên máy Mac này có thể cần codex login lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter 会保存此 Codex 登录及其刷新令牌，并在服务器上刷新。之后，此 Mac 上的 codex 命令可能需要再次运行 codex login。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter 會儲存此 Codex 登入及其重新整理權杖，並在伺服器上更新。之後，這台 Mac 上的 codex 指令可能需要再次執行 codex login。"
          }
        }
      }
    },
