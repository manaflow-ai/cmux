    "accounts.error.timedOut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter did not answer in time. Try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter が時間内に応答しませんでした。もう一度お試しください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يستجب CodeRouter في الوقت المحدد. حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter nije odgovorio na vrijeme. Pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter svarede ikke i tide. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter hat nicht rechtzeitig geantwortet. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter no respondió a tiempo. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter n’a pas répondu à temps. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter non ha risposto in tempo. Riprova."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter មិនបានឆ្លើយតបទាន់ពេល។ សូមព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter가 제때 응답하지 않았습니다. 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter svarte ikke i tide. Prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter nie odpowiedział na czas. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CodeRouter não respondeu a tempo. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter не ответил вовремя. Повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter ไม่ตอบกลับภายในเวลา ลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter zamanında yanıt vermedi. Yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter не відповів вчасно. Спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter không phản hồi kịp. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter 未及时响应。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter 未及時回應。請再試一次。"
          }
        }
      }
