    "billing.error.badOpen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`open` must be auto, cmux, default or none."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يجب أن تكون `open` إحدى القيم auto أو cmux أو default أو none."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`open` mora biti auto, cmux, default ili none."
          }
        },
        "da": {
