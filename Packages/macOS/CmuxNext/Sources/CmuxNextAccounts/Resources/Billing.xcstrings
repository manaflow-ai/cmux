    "billing.error.badResponse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux.com sent no checkout page; retry in a minute."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يُرسل cmux.com صفحة شراء؛ أعد المحاولة بعد دقيقة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.com nije poslao stranicu za kupovinu; pokušajte ponovo za minutu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.com sendte ingen betalingsside; prøv igen om et minut."
