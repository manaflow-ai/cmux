    "teamAgentKeys.member": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your team's owners and admins manage these keys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
