    "teamAgentKeys.confirmRemove": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this team key? Members' runs on the team's Cloud machines go back to their own keys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Team-Schlüssel entfernen? Die Läufe der Mitglieder auf den Cloud-Maschinen des Teams verwenden wieder ihre eigenen Schlüssel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer cette clé d’équipe ? Les exécutions des membres sur les machines Cloud de l’équipe reviendront à leurs propres clés."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد إزالة مفتاح الفريق هذا؟ ستعود تشغيلات الأعضاء على أجهزة Cloud الخاصة بالفريق إلى مفاتيحهم الخاصة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar esta clave de equipo? Las ejecuciones de los miembros en las máquinas Cloud del equipo volverán a usar sus propias claves."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要移除此團隊金鑰嗎？成員在團隊 Cloud 機器上的執行會改回使用自己的金鑰。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要移除此团队密钥吗？成员在团队 Cloud 机器上的运行会改回使用自己的密钥。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 팀 키를 제거할까요? 팀의 Cloud 머신에서 멤버의 실행이 각자의 키로 돌아갑니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチームキーを削除しますか？チームの Cloud マシンでのメンバーの実行は各自のキーに戻ります。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukloniti ovaj ključ tima? Pokretanja članova na Cloud mašinama tima vraćaju se na njihove vlastite ključeve."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du fjerne denne teamnøgle? Medlemmernes kørsler på teamets Cloud-maskiner går tilbage til deres egne nøgler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere questa chiave del team? Le esecuzioni dei membri sulle macchine Cloud del team torneranno alle loro chiavi."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដកកូនសោក្រុមនេះចេញឬ? ការដំណើរការរបស់សមាជិកនៅលើម៉ាស៊ីន Cloud របស់ក្រុមនឹងត្រឡប់ទៅប្រើកូនសោផ្ទាល់ខ្លួនវិញ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du fjerne denne teamnøkkelen? Medlemmenes kjøringer på teamets Cloud-maskiner går tilbake til egne nøkler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć ten klucz zespołu? Uruchomienia członków na maszynach Cloud zespołu wrócą do ich własnych kluczy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover esta chave da equipe? As execuções dos membros nas máquinas Cloud da equipe voltam a usar as chaves próprias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить этот ключ команды? Запуски участников на Cloud-машинах команды снова будут использовать их собственные ключи."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบคีย์ของทีมนี้ไหม การรันของสมาชิกบนเครื่อง Cloud ของทีมจะกลับไปใช้คีย์ของแต่ละคน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ekip anahtarı kaldırılsın mı? Üyelerin ekibin Cloud makinelerindeki çalıştırmaları kendi anahtarlarına döner."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити цей ключ команди? Запуски учасників на Cloud-машинах команди знову використовуватимуть їхні власні ключі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa khóa nhóm này? Các lần chạy của thành viên trên máy Cloud của nhóm sẽ quay lại dùng khóa riêng của họ."
          }
        }
      }
    },
    "teamAgentKeys.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A team key is used for every member's Claude or Codex runs on this team's Cloud machines, in place of their own keys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Team-Schlüssel wird für die Claude- oder Codex-Läufe aller Mitglieder auf den Cloud-Maschinen dieses Teams verwendet, anstelle ihrer eigenen Schlüssel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une clé d’équipe est utilisée pour les exécutions Claude ou Codex de chaque membre sur les machines Cloud de cette équipe, à la place de ses propres clés."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم مفتاح الفريق لكل تشغيلات Claude أو Codex للأعضاء على أجهزة Cloud الخاصة بهذا الفريق، بدلًا من مفاتيحهم الخاصة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una clave de equipo se usa en las ejecuciones de Claude o Codex de cada miembro en las máquinas Cloud de este equipo, en lugar de sus propias claves."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "團隊金鑰會用於每位成員在此團隊 Cloud 機器上的 Claude 或 Codex 執行，取代他們自己的金鑰。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "团队密钥会用于每位成员在此团队 Cloud 机器上的 Claude 或 Codex 运行，取代他们自己的密钥。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팀 키는 이 팀의 Cloud 머신에서 모든 멤버의 Claude 또는 Codex 실행에 각자의 키 대신 사용됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チームキーは、このチームの Cloud マシンでのすべてのメンバーの Claude または Codex の実行に、各自のキーの代わりに使われます。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ključ tima koristi se za Claude ili Codex pokretanja svih članova na Cloud mašinama ovog tima, umjesto njihovih vlastitih ključeva."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En teamnøgle bruges til alle medlemmers Claude- eller Codex-kørsler på dette teams Cloud-maskiner i stedet for deres egne nøgler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una chiave del team viene usata per le esecuzioni Claude o Codex di ogni membro sulle macchine Cloud di questo team, al posto delle loro chiavi."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កូនសោក្រុមត្រូវបានប្រើសម្រាប់ការដំណើរការ Claude ឬ Codex របស់សមាជិកគ្រប់រូបនៅលើម៉ាស៊ីន Cloud របស់ក្រុមនេះ ជំនួសកូនសោផ្ទាល់ខ្លួនរបស់ពួកគេ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En teamnøkkel brukes for alle medlemmers Claude- eller Codex-kjøringer på dette teamets Cloud-maskiner, i stedet for deres egne nøkler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz zespołu jest używany do uruchomień Claude lub Codex każdego członka na maszynach Cloud tego zespołu zamiast ich własnych kluczy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma chave da equipe é usada nas execuções de Claude ou Codex de cada membro nas máquinas Cloud desta equipe, no lugar das chaves próprias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ команды используется для запусков Claude или Codex всех участников на Cloud-машинах этой команды вместо их собственных ключей."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์ของทีมจะใช้กับการรัน Claude หรือ Codex ของสมาชิกทุกคนบนเครื่อง Cloud ของทีมนี้ แทนคีย์ของแต่ละคน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekip anahtarı, bu ekibin Cloud makinelerinde her üyenin Claude veya Codex çalıştırmalarında kendi anahtarlarının yerine kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ команди використовується для запусків Claude або Codex усіх учасників на Cloud-машинах цієї команди замість їхніх власних ключів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa nhóm được dùng cho các lần chạy Claude hoặc Codex của mọi thành viên trên máy Cloud của nhóm này, thay cho khóa riêng của họ."
          }
        }
      }
    },
