    "teamAgentKeys.error.conflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another admin changed this key; try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Admin hat diesen Schlüssel geändert. Versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre administrateur a modifié cette clé ; réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غيّر مسؤول آخر هذا المفتاح؛ حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro administrador cambió esta clave; vuelve a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一位管理員變更了此金鑰，請再試一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一位管理员更改了此密钥，请重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 관리자가 이 키를 변경했습니다. 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の管理者がこのキーを変更しました。もう一度お試しください。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Drugi administrator je promijenio ovaj ključ; pokušaj ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En anden administrator har ændret denne nøgle. Prøv igen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro amministratore ha modificato questa chiave; riprova."
          }
        },
        "km": {
          "stringUnit": {
