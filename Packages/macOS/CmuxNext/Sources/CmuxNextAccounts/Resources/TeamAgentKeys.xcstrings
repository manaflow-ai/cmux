    "teamAgentKeys.member": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your team's owners and admins manage these keys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Inhaber und Admins deines Teams verwalten diese Schlüssel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les propriétaires et administrateurs de votre équipe gèrent ces clés."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدير مالكو فريقك ومسؤولوه هذه المفاتيح."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los propietarios y administradores de tu equipo gestionan estas claves."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些金鑰由團隊的擁有者和管理員管理。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些密钥由团队的所有者和管理员管理。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 키는 팀의 소유자와 관리자가 관리합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのキーはチームのオーナーと管理者が管理します。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovim ključevima upravljaju vlasnici i administratori tvog tima."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit teams ejere og administratorer administrerer disse nøgler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste chiavi sono gestite dai proprietari e dagli amministratori del tuo team."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម្ចាស់ និងអ្នកគ្រប់គ្រងក្រុមរបស់អ្នកគ្រប់គ្រងកូនសោទាំងនេះ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Teamets eiere og administratorer administrerer disse nøklene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tymi kluczami zarządzają właściciele i administratorzy zespołu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os proprietários e administradores da sua equipe gerenciam estas chaves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этими ключами управляют владельцы и администраторы вашей команды."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เจ้าของและผู้ดูแลทีมของคุณเป็นผู้จัดการคีย์เหล่านี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu anahtarları ekibinizin sahipleri ve yöneticileri yönetir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цими ключами керують власники й адміністратори вашої команди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chủ sở hữu và quản trị viên của nhóm bạn quản lý các khóa này."
          }
        }
      }
    },
    "teamAgentKeys.personal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your personal team has no one to share keys with. Switch to a team to manage its keys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein persönliches Team hat niemanden, mit dem es Schlüssel teilen kann. Wechsle zu einem Team, um seine Schlüssel zu verwalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre équipe personnelle n’a personne avec qui partager des clés. Passez à une équipe pour gérer ses clés."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد في فريقك الشخصي من تشارك المفاتيح معه. انتقل إلى فريق لإدارة مفاتيحه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu equipo personal no tiene con quién compartir claves. Cambia a un equipo para gestionar sus claves."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的個人團隊沒有可共用金鑰的對象。切換到團隊以管理其金鑰。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的个人团队没有可共享密钥的对象。切换到团队以管理其密钥。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 팀에는 키를 공유할 사람이 없습니다. 팀으로 전환하여 키를 관리하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人チームにはキーを共有する相手がいません。キーを管理するにはチームに切り替えてください。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj lični tim nema s kim dijeliti ključeve. Prebaci se na tim da upravljaš njegovim ključevima."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit personlige team har ingen at dele nøgler med. Skift til et team for at administrere dets nøgler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo team personale non ha nessuno con cui condividere le chiavi. Passa a un team per gestirne le chiavi."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ក្រុមផ្ទាល់ខ្លួនរបស់អ្នកគ្មាននរណាម្នាក់ដើម្បីចែករំលែកកូនសោទេ។ ប្ដូរទៅក្រុមមួយដើម្បីគ្រប់គ្រងកូនសោរបស់វា។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det personlige teamet ditt har ingen å dele nøkler med. Bytt til et team for å administrere nøklene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój zespół osobisty nie ma z kim dzielić kluczy. Przełącz się na zespół, aby zarządzać jego kluczami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua equipe pessoal não tem com quem compartilhar chaves. Mude para uma equipe para gerenciar as chaves dela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В личной команде не с кем делиться ключами. Переключитесь на команду, чтобы управлять её ключами."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทีมส่วนตัวของคุณไม่มีใครให้แชร์คีย์ด้วย สลับไปยังทีมเพื่อจัดการคีย์ของทีม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel ekibinizde anahtar paylaşacak kimse yok. Anahtarlarını yönetmek için bir ekibe geçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "В особистій команді немає з ким ділитися ключами. Перейдіть до команди, щоб керувати її ключами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhóm cá nhân của bạn không có ai để chia sẻ khóa. Hãy chuyển sang một nhóm để quản lý khóa của nhóm đó."
          }
        }
      }
    },
