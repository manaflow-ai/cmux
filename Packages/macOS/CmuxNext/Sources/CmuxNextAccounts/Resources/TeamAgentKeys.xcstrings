    "teamAgentKeys.removed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Team key removed. Members' own keys apply again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Team-Schlüssel entfernt. Die eigenen Schlüssel der Mitglieder gelten wieder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé d’équipe supprimée. Les clés personnelles des membres s’appliquent de nouveau."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت إزالة مفتاح الفريق. تُطبَّق مفاتيح الأعضاء الخاصة مجددًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clave de equipo eliminada. Vuelven a aplicarse las claves propias de los miembros."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除團隊金鑰。成員自己的金鑰會再次生效。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除团队密钥。成员自己的密钥会再次生效。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팀 키를 제거했습니다. 멤버 각자의 키가 다시 적용됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チームキーを削除しました。メンバー各自のキーが再び使われます。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ključ tima je uklonjen. Ponovo važe vlastiti ključevi članova."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Teamnøglen er fjernet. Medlemmernes egne nøgler gælder igen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiave del team rimossa. Tornano a valere le chiavi dei singoli membri."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បានដកកូនសោក្រុមចេញ។ កូនសោផ្ទាល់ខ្លួនរបស់សមាជិកត្រូវបានប្រើម្ដងទៀត។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Teamnøkkelen er fjernet. Medlemmenes egne nøkler gjelder igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięto klucz zespołu. Znowu obowiązują własne klucze członków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chave da equipe removida. As chaves próprias dos membros voltam a valer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ команды удалён. Снова действуют собственные ключи участников."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบคีย์ของทีมแล้ว คีย์ของสมาชิกแต่ละคนจะกลับมาใช้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekip anahtarı kaldırıldı. Üyelerin kendi anahtarları yeniden geçerli."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
