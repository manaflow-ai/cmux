    "teamAgentKeys.confirmRemove": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this team key? Members' runs on the team's Cloud machines go back to their own keys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Team-Schlüssel entfernen? Die Läufe der Mitglieder auf den Cloud-Maschinen des Teams verwenden wieder ihre eigenen Schlüssel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer cette clé d’équipe ? Les exécutions des membres sur les machines Cloud de l’équipe reviendront à leurs propres clés."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد إزالة مفتاح الفريق هذا؟ ستعود تشغيلات الأعضاء على أجهزة Cloud الخاصة بالفريق إلى مفاتيحهم الخاصة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar esta clave de equipo? Las ejecuciones de los miembros en las máquinas Cloud del equipo volverán a usar sus propias claves."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要移除此團隊金鑰嗎？成員在團隊 Cloud 機器上的執行會改回使用自己的金鑰。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要移除此团队密钥吗？成员在团队 Cloud 机器上的运行会改回使用自己的密钥。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 팀 키를 제거할까요? 팀의 Cloud 머신에서 멤버의 실행이 각자의 키로 돌아갑니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチームキーを削除しますか？チームの Cloud マシンでのメンバーの実行は各自のキーに戻ります。"
          }
        }
      }
    },
    "teamAgentKeys.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A team key is used for every member's Claude or Codex runs on this team's Cloud machines, in place of their own keys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Team-Schlüssel wird für die Claude- oder Codex-Läufe aller Mitglieder auf den Cloud-Maschinen dieses Teams verwendet, anstelle ihrer eigenen Schlüssel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une clé d’équipe est utilisée pour les exécutions Claude ou Codex de chaque membre sur les machines Cloud de cette équipe, à la place de ses propres clés."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم مفتاح الفريق لكل تشغيلات Claude أو Codex للأعضاء على أجهزة Cloud الخاصة بهذا الفريق، بدلًا من مفاتيحهم الخاصة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una clave de equipo se usa en las ejecuciones de Claude o Codex de cada miembro en las máquinas Cloud de este equipo, en lugar de sus propias claves."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "團隊金鑰會用於每位成員在此團隊 Cloud 機器上的 Claude 或 Codex 執行，取代他們自己的金鑰。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "团队密钥会用于每位成员在此团队 Cloud 机器上的 Claude 或 Codex 运行，取代他们自己的密钥。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팀 키는 이 팀의 Cloud 머신에서 모든 멤버의 Claude 또는 Codex 실행에 각자의 키 대신 사용됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チームキーは、このチームの Cloud マシンでのすべてのメンバーの Claude または Codex の実行に、各自のキーの代わりに使われます。"
          }
        }
      }
    },
    "teamAgentKeys.endingIn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ending in …%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endet auf …%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se termine par …%@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتهي بـ …%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina en …%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結尾為 …%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结尾为 …%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "…%@(으)로 끝남"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "末尾 …%@"
          }
        }
      }
    },
    "teamAgentKeys.error.conflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another admin changed this key; try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Admin hat diesen Schlüssel geändert. Versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre administrateur a modifié cette clé ; réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غيّر مسؤول آخر هذا المفتاح؛ حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro administrador cambió esta clave; vuelve a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一位管理員變更了此金鑰，請再試一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一位管理员更改了此密钥，请重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 관리자가 이 키를 변경했습니다. 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の管理者がこのキーを変更しました。もう一度お試しください。"
          }
        }
      }
    },
    "teamAgentKeys.error.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The team key could not be changed. Refresh to try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Team-Schlüssel konnte nicht geändert werden. Aktualisiere, um es erneut zu versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de modifier la clé d’équipe. Actualisez pour réessayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تغيير مفتاح الفريق. حدّث للمحاولة مجددًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cambiar la clave de equipo. Actualiza para volver a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法變更團隊金鑰。請重新整理以重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更改团队密钥。请刷新以重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팀 키를 변경하지 못했습니다. 새로 고침하여 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チームキーを変更できませんでした。更新してもう一度お試しください。"
          }
        }
      }
    },
    "teamAgentKeys.error.forbidden": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only team owners and admins can change team keys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Inhaber und Admins des Teams können Team-Schlüssel ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les propriétaires et administrateurs de l’équipe peuvent modifier les clés d’équipe."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إلا لمالكي الفريق ومسؤوليه تغيير مفاتيح الفريق."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los propietarios y administradores del equipo pueden cambiar las claves de equipo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有團隊擁有者和管理員可以變更團隊金鑰。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有团队所有者和管理员可以更改团队密钥。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팀 소유자와 관리자만 팀 키를 변경할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チームキーを変更できるのはチームのオーナーと管理者だけです。"
          }
        }
      }
    },
    "teamAgentKeys.error.invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This key is not valid. Paste the whole key or sign-in file again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Schlüssel ist ungültig. Füge den ganzen Schlüssel oder die Anmeldedatei erneut ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé n’est pas valide. Collez de nouveau la clé entière ou le fichier de connexion."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المفتاح غير صالح. الصق المفتاح كاملًا أو ملف تسجيل الدخول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta clave no es válida. Vuelve a pegar la clave completa o el archivo de inicio de sesión."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此金鑰無效。請重新貼上完整的金鑰或登入檔案。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此密钥无效。请重新粘贴完整的密钥或登录文件。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 키는 유효하지 않습니다. 전체 키나 로그인 파일을 다시 붙여넣으세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーは無効です。キー全体またはサインインファイルをもう一度貼り付けてください。"
          }
        }
      }
    },
    "teamAgentKeys.error.load": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Team keys could not be loaded. Refresh to try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Team-Schlüssel konnten nicht geladen werden. Aktualisiere, um es erneut zu versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les clés d’équipe. Actualisez pour réessayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل مفاتيح الفريق. حدّث للمحاولة مجددًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar las claves de equipo. Actualiza para volver a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入團隊金鑰。請重新整理以重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载团队密钥。请刷新以重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팀 키를 불러오지 못했습니다. 새로 고침하여 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チームキーを読み込めませんでした。更新してもう一度お試しください。"
          }
        }
      }
    },
    "teamAgentKeys.error.notConfigured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Team keys are not available on this Cloud service yet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Team-Schlüssel sind in diesem Cloud-Dienst noch nicht verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés d’équipe ne sont pas encore disponibles sur ce service Cloud."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفاتيح الفريق غير متاحة بعد في خدمة Cloud هذه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves de equipo aún no están disponibles en este servicio Cloud."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Cloud 服務尚未提供團隊金鑰。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Cloud 服务尚未提供团队密钥。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Cloud 서비스에서는 아직 팀 키를 사용할 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Cloud サービスではまだチームキーを使用できません。"
          }
        }
      }
    },
    "teamAgentKeys.error.notMember": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are no longer a member of this team."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist kein Mitglied dieses Teams mehr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’êtes plus membre de cette équipe."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تعد عضوًا في هذا الفريق."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no eres miembro de este equipo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已不是此團隊的成員。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已不是此团队的成员。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 이상 이 팀의 멤버가 아닙니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチームのメンバーではなくなりました。"
          }
        }
      }
    },
    "teamAgentKeys.error.unreachable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Cloud service could not be reached. Try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Cloud-Dienst ist nicht erreichbar. Versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre le service Cloud. Réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى خدمة Cloud. حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con el servicio Cloud. Vuelve a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線至 Cloud 服務。請再試一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到 Cloud 服务。请重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud 서비스에 연결할 수 없습니다. 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud サービスに接続できませんでした。もう一度お試しください。"
          }
        }
      }
