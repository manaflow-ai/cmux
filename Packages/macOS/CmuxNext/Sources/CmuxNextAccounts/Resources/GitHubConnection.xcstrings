{
  "sourceLanguage": "en",
  "strings": {
    "github.connect": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Connect GitHub"}}, "de": {"stringUnit": {"state": "translated", "value": "GitHub verbinden"}}, "fr": {"stringUnit": {"state": "translated", "value": "Connecter GitHub"}}, "ar": {"stringUnit": {"state": "translated", "value": "ربط GitHub"}}, "es": {"stringUnit": {"state": "translated", "value": "Conectar GitHub"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "連接 GitHub"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "连接 GitHub"}}, "ko": {"stringUnit": {"state": "translated", "value": "GitHub 연결"}}, "ja": {"stringUnit": {"state": "translated", "value": "GitHub に接続"}}, "bs": {"stringUnit": {"state": "translated", "value": "Poveži GitHub"}}, "da": {"stringUnit": {"state": "translated", "value": "Forbind GitHub"}}, "it": {"stringUnit": {"state": "translated", "value": "Connetti GitHub"}}, "km": {"stringUnit": {"state": "translated", "value": "ភ្ជាប់ GitHub"}}, "nb": {"stringUnit": {"state": "translated", "value": "Koble til GitHub"}}, "pl": {"stringUnit": {"state": "translated", "value": "Połącz z GitHub"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Conectar ao GitHub"}}, "ru": {"stringUnit": {"state": "translated", "value": "Подключить GitHub"}}, "th": {"stringUnit": {"state": "translated", "value": "เชื่อมต่อ GitHub"}}, "tr": {"stringUnit": {"state": "translated", "value": "GitHub'a bağlan"}}, "uk": {"stringUnit": {"state": "translated", "value": "Підключити GitHub"}}, "vi": {"stringUnit": {"state": "translated", "value": "Kết nối GitHub"}}}},
    "github.disconnect": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Disconnect"}}, "de": {"stringUnit": {"state": "translated", "value": "Trennen"}}, "fr": {"stringUnit": {"state": "translated", "value": "Déconnecter"}}, "ar": {"stringUnit": {"state": "translated", "value": "قطع الاتصال"}}, "es": {"stringUnit": {"state": "translated", "value": "Desconectar"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "中斷連線"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "断开连接"}}, "ko": {"stringUnit": {"state": "translated", "value": "연결 해제"}}, "ja": {"stringUnit": {"state": "translated", "value": "接続解除"}}, "bs": {"stringUnit": {"state": "translated", "value": "Prekini vezu"}}, "da": {"stringUnit": {"state": "translated", "value": "Afbryd forbindelsen"}}, "it": {"stringUnit": {"state": "translated", "value": "Disconnetti"}}, "km": {"stringUnit": {"state": "translated", "value": "ផ្តាច់ការភ្ជាប់"}}, "nb": {"stringUnit": {"state": "translated", "value": "Koble fra"}}, "pl": {"stringUnit": {"state": "translated", "value": "Rozłącz"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Desconectar"}}, "ru": {"stringUnit": {"state": "translated", "value": "Отключить"}}, "th": {"stringUnit": {"state": "translated", "value": "ยกเลิกการเชื่อมต่อ"}}, "tr": {"stringUnit": {"state": "translated", "value": "Bağlantıyı kes"}}, "uk": {"stringUnit": {"state": "translated", "value": "Від’єднати"}}, "vi": {"stringUnit": {"state": "translated", "value": "Ngắt kết nối"}}}},
    "github.confirm": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Disconnect GitHub? Agents will lose access through this connection."}}, "de": {"stringUnit": {"state": "translated", "value": "GitHub trennen? Agenten verlieren den Zugriff über diese Verbindung."}}, "fr": {"stringUnit": {"state": "translated", "value": "Déconnecter GitHub ? Les agents perdront leur accès via cette connexion."}}, "ar": {"stringUnit": {"state": "translated", "value": "هل تريد قطع الاتصال بـ GitHub؟ سيفقد الوكلاء الوصول عبر هذا الاتصال."}}, "es": {"stringUnit": {"state": "translated", "value": "¿Desconectar GitHub? Los agentes perderán el acceso a través de esta conexión."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "要中斷 GitHub 連線嗎？代理程式將失去透過此連線的存取權。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "要断开 GitHub 连接吗？代理将失去通过此连接的访问权限。"}}, "ko": {"stringUnit": {"state": "translated", "value": "GitHub 연결을 해제할까요? 에이전트가 이 연결을 통한 액세스 권한을 잃습니다."}}, "ja": {"stringUnit": {"state": "translated", "value": "GitHub との接続を解除しますか？エージェントはこの接続を介してアクセスできなくなります。"}}, "bs": {"stringUnit": {"state": "translated", "value": "Prekinuti vezu s GitHubom? Agenti će izgubiti pristup putem ove veze."}}, "da": {"stringUnit": {"state": "translated", "value": "Vil du afbryde forbindelsen til GitHub? Agenter mister adgangen via denne forbindelse."}}, "it": {"stringUnit": {"state": "translated", "value": "Disconnettere GitHub? Gli agenti perderanno l'accesso tramite questa connessione."}}, "km": {"stringUnit": {"state": "translated", "value": "ផ្តាច់ការភ្ជាប់ GitHub? ភ្នាក់ងារនឹងបាត់បង់សិទ្ធិចូលប្រើតាមរយៈការភ្ជាប់នេះ។"}}, "nb": {"stringUnit": {"state": "translated", "value": "Koble fra GitHub? Agenter mister tilgang via denne tilkoblingen."}}, "pl": {"stringUnit": {"state": "translated", "value": "Rozłączyć GitHub? Agenci utracą dostęp przez to połączenie."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Desconectar do GitHub? Os agentes perderão o acesso por esta conexão."}}, "ru": {"stringUnit": {"state": "translated", "value": "Отключить GitHub? Агенты потеряют доступ через это подключение."}}, "th": {"stringUnit": {"state": "translated", "value": "ยกเลิกการเชื่อมต่อ GitHub ไหม นักพัฒนาจะเสียสิทธิ์เข้าถึงผ่านการเชื่อมต่อนี้"}}, "tr": {"stringUnit": {"state": "translated", "value": "GitHub bağlantısı kesilsin mi? Aracılar bu bağlantı üzerinden erişimi kaybedecek."}}, "uk": {"stringUnit": {"state": "translated", "value": "Від’єднати GitHub? Агенти втратять доступ через це підключення."}}, "vi": {"stringUnit": {"state": "translated", "value": "Ngắt kết nối GitHub? Các tác nhân sẽ mất quyền truy cập qua kết nối này."}}}},
    "github.cancel": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Cancel"}}, "de": {"stringUnit": {"state": "translated", "value": "Abbrechen"}}, "fr": {"stringUnit": {"state": "translated", "value": "Annuler"}}, "ar": {"stringUnit": {"state": "translated", "value": "إلغاء"}}, "es": {"stringUnit": {"state": "translated", "value": "Cancelar"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "取消"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "取消"}}, "ko": {"stringUnit": {"state": "translated", "value": "취소"}}, "ja": {"stringUnit": {"state": "translated", "value": "キャンセル"}}, "bs": {"stringUnit": {"state": "translated", "value": "Otkaži"}}, "da": {"stringUnit": {"state": "translated", "value": "Annuller"}}, "it": {"stringUnit": {"state": "translated", "value": "Annulla"}}, "km": {"stringUnit": {"state": "translated", "value": "បោះបង់"}}, "nb": {"stringUnit": {"state": "translated", "value": "Avbryt"}}, "pl": {"stringUnit": {"state": "translated", "value": "Anuluj"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Cancelar"}}, "ru": {"stringUnit": {"state": "translated", "value": "Отмена"}}, "th": {"stringUnit": {"state": "translated", "value": "ยกเลิก"}}, "tr": {"stringUnit": {"state": "translated", "value": "İptal"}}, "uk": {"stringUnit": {"state": "translated", "value": "Скасувати"}}, "vi": {"stringUnit": {"state": "translated", "value": "Hủy"}}}},
    "github.refresh": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Refresh"}}, "de": {"stringUnit": {"state": "translated", "value": "Aktualisieren"}}, "fr": {"stringUnit": {"state": "translated", "value": "Actualiser"}}, "ar": {"stringUnit": {"state": "translated", "value": "تحديث"}}, "es": {"stringUnit": {"state": "translated", "value": "Actualizar"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "重新整理"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "刷新"}}, "ko": {"stringUnit": {"state": "translated", "value": "새로 고침"}}, "ja": {"stringUnit": {"state": "translated", "value": "更新"}}, "bs": {"stringUnit": {"state": "translated", "value": "Osvježi"}}, "da": {"stringUnit": {"state": "translated", "value": "Opdater"}}, "it": {"stringUnit": {"state": "translated", "value": "Aggiorna"}}, "km": {"stringUnit": {"state": "translated", "value": "ផ្ទុកឡើងវិញ"}}, "nb": {"stringUnit": {"state": "translated", "value": "Oppdater"}}, "pl": {"stringUnit": {"state": "translated", "value": "Odśwież"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Atualizar"}}, "ru": {"stringUnit": {"state": "translated", "value": "Обновить"}}, "th": {"stringUnit": {"state": "translated", "value": "รีเฟรช"}}, "tr": {"stringUnit": {"state": "translated", "value": "Yenile"}}, "uk": {"stringUnit": {"state": "translated", "value": "Оновити"}}, "vi": {"stringUnit": {"state": "translated", "value": "Làm mới"}}}},
    "github.detail": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Connect the cmux GitHub App. Choose repositories and review permissions in GitHub."}}, "de": {"stringUnit": {"state": "translated", "value": "Verbinde die cmux-GitHub-App. Wähle Repositorys und prüfe die Berechtigungen in GitHub."}}, "fr": {"stringUnit": {"state": "translated", "value": "Connectez l’application GitHub cmux. Choisissez les dépôts et vérifiez les autorisations dans GitHub."}}, "ar": {"stringUnit": {"state": "translated", "value": "اربط تطبيق cmux على GitHub. اختر المستودعات وراجع الأذونات في GitHub."}}, "es": {"stringUnit": {"state": "translated", "value": "Conecta la aplicación de GitHub de cmux. Elige los repositorios y revisa los permisos en GitHub."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "連接 cmux GitHub 應用程式。在 GitHub 中選擇儲存庫並檢查權限。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "连接 cmux GitHub 应用。在 GitHub 中选择仓库并检查权限。"}}, "ko": {"stringUnit": {"state": "translated", "value": "cmux GitHub 앱을 연결하세요. GitHub에서 저장소를 선택하고 권한을 검토하세요."}}, "ja": {"stringUnit": {"state": "translated", "value": "cmux GitHub App に接続します。GitHub でリポジトリを選び、権限を確認してください。"}}, "bs": {"stringUnit": {"state": "translated", "value": "Poveži cmux GitHub aplikaciju. Odaberi repozitorije i pregledaj dozvole na GitHubu."}}, "da": {"stringUnit": {"state": "translated", "value": "Forbind cmux GitHub-appen. Vælg repositories, og gennemgå tilladelserne på GitHub."}}, "it": {"stringUnit": {"state": "translated", "value": "Connetti l'app GitHub di cmux. Scegli i repository e controlla le autorizzazioni su GitHub."}}, "km": {"stringUnit": {"state": "translated", "value": "ភ្ជាប់កម្មវិធី GitHub របស់ cmux។ ជ្រើសរើសឃ្លាំង និងពិនិត្យសិទ្ធិនៅលើ GitHub។"}}, "nb": {"stringUnit": {"state": "translated", "value": "Koble til cmux GitHub-appen. Velg repositorier og gå gjennom tillatelser på GitHub."}}, "pl": {"stringUnit": {"state": "translated", "value": "Połącz aplikację GitHub cmux. Wybierz repozytoria i sprawdź uprawnienia w GitHub."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Conecte o app do GitHub do cmux. Escolha os repositórios e revise as permissões no GitHub."}}, "ru": {"stringUnit": {"state": "translated", "value": "Подключите приложение cmux для GitHub. Выберите репозитории и проверьте разрешения в GitHub."}}, "th": {"stringUnit": {"state": "translated", "value": "เชื่อมต่อแอป GitHub ของ cmux เลือกที่เก็บและตรวจสอบสิทธิ์ใน GitHub"}}, "tr": {"stringUnit": {"state": "translated", "value": "cmux GitHub uygulamasına bağlanın. Depoları seçin ve GitHub'daki izinleri inceleyin."}}, "uk": {"stringUnit": {"state": "translated", "value": "Підключіть застосунок cmux для GitHub. Виберіть репозиторії та перегляньте дозволи на GitHub."}}, "vi": {"stringUnit": {"state": "translated", "value": "Kết nối ứng dụng GitHub của cmux. Chọn kho lưu trữ và xem lại quyền trên GitHub."}}}},
    "github.signIn": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Sign in to cmux to connect GitHub."}}, "de": {"stringUnit": {"state": "translated", "value": "Melde dich bei cmux an, um GitHub zu verbinden."}}, "fr": {"stringUnit": {"state": "translated", "value": "Connectez-vous à cmux pour connecter GitHub."}}, "ar": {"stringUnit": {"state": "translated", "value": "سجّل الدخول إلى cmux لربط GitHub."}}, "es": {"stringUnit": {"state": "translated", "value": "Inicia sesión en cmux para conectar GitHub."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "登入 cmux 以連接 GitHub。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "登录 cmux 以连接 GitHub。"}}, "ko": {"stringUnit": {"state": "translated", "value": "GitHub를 연결하려면 cmux에 로그인하세요."}}, "ja": {"stringUnit": {"state": "translated", "value": "GitHub に接続するには cmux にサインインしてください。"}}, "bs": {"stringUnit": {"state": "translated", "value": "Prijavi se u cmux da povežeš GitHub."}}, "da": {"stringUnit": {"state": "translated", "value": "Log ind på cmux for at forbinde GitHub."}}, "it": {"stringUnit": {"state": "translated", "value": "Accedi a cmux per connettere GitHub."}}, "km": {"stringUnit": {"state": "translated", "value": "ចូល cmux ដើម្បីភ្ជាប់ GitHub។"}}, "nb": {"stringUnit": {"state": "translated", "value": "Logg inn på cmux for å koble til GitHub."}}, "pl": {"stringUnit": {"state": "translated", "value": "Zaloguj się do cmux, aby połączyć GitHub."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Entre no cmux para conectar ao GitHub."}}, "ru": {"stringUnit": {"state": "translated", "value": "Войдите в cmux, чтобы подключить GitHub."}}, "th": {"stringUnit": {"state": "translated", "value": "ลงชื่อเข้าใช้ cmux เพื่อเชื่อมต่อ GitHub"}}, "tr": {"stringUnit": {"state": "translated", "value": "GitHub'a bağlanmak için cmux'ta oturum açın."}}, "uk": {"stringUnit": {"state": "translated", "value": "Увійдіть у cmux, щоб підключити GitHub."}}, "vi": {"stringUnit": {"state": "translated", "value": "Đăng nhập cmux để kết nối GitHub."}}}},
    "github.unavailable": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "GitHub connections are unavailable on this deployment."}}, "de": {"stringUnit": {"state": "translated", "value": "GitHub-Verbindungen sind in dieser Bereitstellung nicht verfügbar."}}, "fr": {"stringUnit": {"state": "translated", "value": "Les connexions GitHub ne sont pas disponibles sur ce déploiement."}}, "ar": {"stringUnit": {"state": "translated", "value": "اتصالات GitHub غير متاحة في هذا النشر."}}, "es": {"stringUnit": {"state": "translated", "value": "Las conexiones de GitHub no están disponibles en este despliegue."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "此部署無法使用 GitHub 連線。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此部署无法使用 GitHub 连接。"}}, "ko": {"stringUnit": {"state": "translated", "value": "이 배포에서는 GitHub 연결을 사용할 수 없습니다."}}, "ja": {"stringUnit": {"state": "translated", "value": "このデプロイでは GitHub に接続できません。"}}, "bs": {"stringUnit": {"state": "translated", "value": "GitHub veze nisu dostupne u ovoj instalaciji."}}, "da": {"stringUnit": {"state": "translated", "value": "GitHub-forbindelser er ikke tilgængelige i denne installation."}}, "it": {"stringUnit": {"state": "translated", "value": "Le connessioni GitHub non sono disponibili in questa distribuzione."}}, "km": {"stringUnit": {"state": "translated", "value": "ការភ្ជាប់ GitHub មិនអាចប្រើបាននៅលើការដាក់ពង្រាយនេះទេ។"}}, "nb": {"stringUnit": {"state": "translated", "value": "GitHub-tilkoblinger er utilgjengelige i denne distribusjonen."}}, "pl": {"stringUnit": {"state": "translated", "value": "Połączenia z GitHub są niedostępne w tym wdrożeniu."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "As conexões do GitHub não estão disponíveis nesta implantação."}}, "ru": {"stringUnit": {"state": "translated", "value": "Подключения к GitHub недоступны в этом развёртывании."}}, "th": {"stringUnit": {"state": "translated", "value": "การเชื่อมต่อ GitHub ไม่พร้อมใช้งานในการปรับใช้นี้"}}, "tr": {"stringUnit": {"state": "translated", "value": "GitHub bağlantıları bu dağıtımda kullanılamıyor."}}, "uk": {"stringUnit": {"state": "translated", "value": "Підключення до GitHub недоступні в цьому розгортанні."}}, "vi": {"stringUnit": {"state": "translated", "value": "Các kết nối GitHub không khả dụng trong bản triển khai này."}}}},
    "github.pending": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Finish connecting in your browser, then refresh."}}, "de": {"stringUnit": {"state": "translated", "value": "Schließe die Verbindung im Browser ab und aktualisiere dann."}}, "fr": {"stringUnit": {"state": "translated", "value": "Terminez la connexion dans votre navigateur, puis actualisez."}}, "ar": {"stringUnit": {"state": "translated", "value": "أكمل الربط في المتصفح، ثم حدّث."}}, "es": {"stringUnit": {"state": "translated", "value": "Completa la conexión en tu navegador y luego actualiza."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "在瀏覽器中完成連線，然後重新整理。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "在浏览器中完成连接，然后刷新。"}}, "ko": {"stringUnit": {"state": "translated", "value": "브라우저에서 연결을 완료한 다음 새로 고침하세요."}}, "ja": {"stringUnit": {"state": "translated", "value": "ブラウザで接続を完了してから更新してください。"}}, "bs": {"stringUnit": {"state": "translated", "value": "Dovrši povezivanje u pregledniku, a zatim osvježi."}}, "da": {"stringUnit": {"state": "translated", "value": "Færdiggør forbindelsen i din browser, og opdater derefter."}}, "it": {"stringUnit": {"state": "translated", "value": "Completa la connessione nel browser, poi aggiorna."}}, "km": {"stringUnit": {"state": "translated", "value": "បញ្ចប់ការភ្ជាប់នៅក្នុងកម្មវិធីរុករក រួចផ្ទុកឡើងវិញ។"}}, "nb": {"stringUnit": {"state": "translated", "value": "Fullfør tilkoblingen i nettleseren, og oppdater deretter."}}, "pl": {"stringUnit": {"state": "translated", "value": "Dokończ łączenie w przeglądarce, a następnie odśwież."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Conclua a conexão no navegador e depois atualize."}}, "ru": {"stringUnit": {"state": "translated", "value": "Завершите подключение в браузере, затем обновите."}}, "th": {"stringUnit": {"state": "translated", "value": "เชื่อมต่อให้เสร็จในเบราว์เซอร์ แล้วรีเฟรช"}}, "tr": {"stringUnit": {"state": "translated", "value": "Tarayıcınızda bağlantıyı tamamlayın, ardından yenileyin."}}, "uk": {"stringUnit": {"state": "translated", "value": "Завершіть підключення у браузері, потім оновіть."}}, "vi": {"stringUnit": {"state": "translated", "value": "Hoàn tất kết nối trong trình duyệt, sau đó làm mới."}}}},
    "github.failed": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "GitHub could not be updated. Refresh to try again."}}, "de": {"stringUnit": {"state": "translated", "value": "GitHub konnte nicht aktualisiert werden. Aktualisiere, um es erneut zu versuchen."}}, "fr": {"stringUnit": {"state": "translated", "value": "Impossible d’actualiser GitHub. Actualisez pour réessayer."}}, "ar": {"stringUnit": {"state": "translated", "value": "تعذّر تحديث GitHub. حدّث للمحاولة مجددًا."}}, "es": {"stringUnit": {"state": "translated", "value": "No se pudo actualizar GitHub. Actualiza para volver a intentarlo."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法更新 GitHub。請重新整理以重試。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法更新 GitHub。请刷新以重试。"}}, "ko": {"stringUnit": {"state": "translated", "value": "GitHub를 업데이트하지 못했습니다. 새로 고침하여 다시 시도하세요."}}, "ja": {"stringUnit": {"state": "translated", "value": "GitHub を更新できませんでした。更新してもう一度お試しください。"}}, "bs": {"stringUnit": {"state": "translated", "value": "GitHub nije moguće ažurirati. Osvježi i pokušaj ponovo."}}, "da": {"stringUnit": {"state": "translated", "value": "GitHub kunne ikke opdateres. Opdater for at prøve igen."}}, "it": {"stringUnit": {"state": "translated", "value": "Impossibile aggiornare GitHub. Aggiorna per riprovare."}}, "km": {"stringUnit": {"state": "translated", "value": "មិនអាចធ្វើបច្ចុប្បន្នភាព GitHub បានទេ។ ផ្ទុកឡើងវិញដើម្បីព្យាយាមម្ដងទៀត។"}}, "nb": {"stringUnit": {"state": "translated", "value": "GitHub kunne ikke oppdateres. Oppdater for å prøve på nytt."}}, "pl": {"stringUnit": {"state": "translated", "value": "Nie udało się zaktualizować GitHub. Odśwież, aby spróbować ponownie."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível atualizar o GitHub. Atualize para tentar novamente."}}, "ru": {"stringUnit": {"state": "translated", "value": "Не удалось обновить GitHub. Обновите и попробуйте снова."}}, "th": {"stringUnit": {"state": "translated", "value": "อัปเดต GitHub ไม่ได้ รีเฟรชเพื่อลองอีกครั้ง"}}, "tr": {"stringUnit": {"state": "translated", "value": "GitHub güncellenemedi. Yenileyerek tekrar deneyin."}}, "uk": {"stringUnit": {"state": "translated", "value": "Не вдалося оновити GitHub. Оновіть і спробуйте ще раз."}}, "vi": {"stringUnit": {"state": "translated", "value": "Không thể cập nhật GitHub. Hãy làm mới để thử lại."}}}},
