{
  "sourceLanguage": "en",
  "strings": {
    "github.connect": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Connect GitHub"}}, "de": {"stringUnit": {"state": "translated", "value": "GitHub verbinden"}}, "fr": {"stringUnit": {"state": "translated", "value": "Connecter GitHub"}}, "ar": {"stringUnit": {"state": "translated", "value": "ربط GitHub"}}, "es": {"stringUnit": {"state": "translated", "value": "Conectar GitHub"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "連接 GitHub"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "连接 GitHub"}}, "ko": {"stringUnit": {"state": "translated", "value": "GitHub 연결"}}, "ja": {"stringUnit": {"state": "translated", "value": "GitHub に接続"}}, "bs": {"stringUnit": {"state": "translated", "value": "Poveži GitHub"}}, "da": {"stringUnit": {"state": "translated", "value": "Forbind GitHub"}}, "it": {"stringUnit": {"state": "translated", "value": "Connetti GitHub"}}, "km": {"stringUnit": {"state": "translated", "value": "ភ្ជាប់ GitHub"}}, "nb": {"stringUnit": {"state": "translated", "value": "Koble til GitHub"}}, "pl": {"stringUnit": {"state": "translated", "value": "Połącz z GitHub"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Conectar ao GitHub"}}, "ru": {"stringUnit": {"state": "translated", "value": "Подключить GitHub"}}, "th": {"stringUnit": {"state": "translated", "value": "เชื่อมต่อ GitHub"}}, "tr": {"stringUnit": {"state": "translated", "value": "GitHub'a bağlan"}}, "uk": {"stringUnit": {"state": "translated", "value": "Підключити GitHub"}}, "vi": {"stringUnit": {"state": "translated", "value": "Kết nối GitHub"}}}},
    "github.disconnect": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Disconnect"}}, "de": {"stringUnit": {"state": "translated", "value": "Trennen"}}, "fr": {"stringUnit": {"state": "translated", "value": "Déconnecter"}}, "ar": {"stringUnit": {"state": "translated", "value": "قطع الاتصال"}}, "es": {"stringUnit": {"state": "translated", "value": "Desconectar"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "中斷連線"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "断开连接"}}, "ko": {"stringUnit": {"state": "translated", "value": "연결 해제"}}, "ja": {"stringUnit": {"state": "translated", "value": "接続解除"}}, "bs": {"stringUnit": {"state": "translated", "value": "Prekini vezu"}}, "da": {"stringUnit": {"state": "translated", "value": "Afbryd forbindelsen"}}, "it": {"stringUnit": {"state": "translated", "value": "Disconnetti"}}, "km": {"stringUnit": {"state": "translated", "value": "ផ្តាច់ការភ្ជាប់"}}, "nb": {"stringUnit": {"state": "translated", "value": "Koble fra"}}, "pl": {"stringUnit": {"state": "translated", "value": "Rozłącz"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Desconectar"}}, "ru": {"stringUnit": {"state": "translated", "value": "Отключить"}}, "th": {"stringUnit": {"state": "translated", "value": "ยกเลิกการเชื่อมต่อ"}}, "tr": {"stringUnit": {"state": "translated", "value": "Bağlantıyı kes"}}, "uk": {"stringUnit": {"state": "translated", "value": "Від’єднати"}}, "vi": {"stringUnit": {"state": "translated", "value": "Ngắt kết nối"}}}},
    "github.reconfigure": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Reconfigure"}}, "de": {"stringUnit": {"state": "translated", "value": "Neu konfigurieren"}}, "fr": {"stringUnit": {"state": "translated", "value": "Reconfigurer"}}, "ar": {"stringUnit": {"state": "translated", "value": "إعادة التهيئة"}}, "es": {"stringUnit": {"state": "translated", "value": "Reconfigurar"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "重新設定"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "重新配置"}}, "ko": {"stringUnit": {"state": "translated", "value": "다시 구성"}}, "ja": {"stringUnit": {"state": "translated", "value": "再設定"}}, "bs": {"stringUnit": {"state": "translated", "value": "Ponovo konfiguriši"}}, "da": {"stringUnit": {"state": "translated", "value": "Omkonfigurer"}}, "it": {"stringUnit": {"state": "translated", "value": "Riconfigura"}}, "km": {"stringUnit": {"state": "translated", "value": "កំណត់រចនាសម្ព័ន្ធឡើងវិញ"}}, "nb": {"stringUnit": {"state": "translated", "value": "Konfigurer på nytt"}}, "pl": {"stringUnit": {"state": "translated", "value": "Skonfiguruj ponownie"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Reconfigurar"}}, "ru": {"stringUnit": {"state": "translated", "value": "Перенастроить"}}, "th": {"stringUnit": {"state": "translated", "value": "กำหนดค่าใหม่"}}, "tr": {"stringUnit": {"state": "translated", "value": "Yeniden yapılandır"}}, "uk": {"stringUnit": {"state": "translated", "value": "Переналаштувати"}}, "vi": {"stringUnit": {"state": "translated", "value": "Cấu hình lại"}}}},
    "github.confirm": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Disconnect GitHub? Agents will lose access through this connection."}}, "de": {"stringUnit": {"state": "translated", "value": "GitHub trennen? Agenten verlieren den Zugriff über diese Verbindung."}}, "fr": {"stringUnit": {"state": "translated", "value": "Déconnecter GitHub ? Les agents perdront leur accès via cette connexion."}}, "ar": {"stringUnit": {"state": "translated", "value": "هل تريد قطع الاتصال بـ GitHub؟ سيفقد الوكلاء الوصول عبر هذا الاتصال."}}, "es": {"stringUnit": {"state": "translated", "value": "¿Desconectar GitHub? Los agentes perderán el acceso a través de esta conexión."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "要中斷 GitHub 連線嗎？代理程式將失去透過此連線的存取權。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "要断开 GitHub 连接吗？代理将失去通过此连接的访问权限。"}}, "ko": {"stringUnit": {"state": "translated", "value": "GitHub 연결을 해제할까요? 에이전트가 이 연결을 통한 액세스 권한을 잃습니다."}}, "ja": {"stringUnit": {"state": "translated", "value": "GitHub との接続を解除しますか？エージェントはこの接続を介してアクセスできなくなります。"}}, "bs": {"stringUnit": {"state": "translated", "value": "Prekinuti vezu s GitHubom? Agenti će izgubiti pristup putem ove veze."}}, "da": {"stringUnit": {"state": "translated", "value": "Vil du afbryde forbindelsen til GitHub? Agenter mister adgangen via denne forbindelse."}}, "it": {"stringUnit": {"state": "translated", "value": "Disconnettere GitHub? Gli agenti perderanno l'accesso tramite questa connessione."}}, "km": {"stringUnit": {"state": "translated", "value": "ផ្តាច់ការភ្ជាប់ GitHub? ភ្នាក់ងារនឹងបាត់បង់សិទ្ធិចូលប្រើតាមរយៈការភ្ជាប់នេះ។"}}, "nb": {"stringUnit": {"state": "translated", "value": "Koble fra GitHub? Agenter mister tilgang via denne tilkoblingen."}}, "pl": {"stringUnit": {"state": "translated", "value": "Rozłączyć GitHub? Agenci utracą dostęp przez to połączenie."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Desconectar do GitHub? Os agentes perderão o acesso por esta conexão."}}, "ru": {"stringUnit": {"state": "translated", "value": "Отключить GitHub? Агенты потеряют доступ через это подключение."}}, "th": {"stringUnit": {"state": "translated", "value": "ยกเลิกการเชื่อมต่อ GitHub ไหม นักพัฒนาจะเสียสิทธิ์เข้าถึงผ่านการเชื่อมต่อนี้"}}, "tr": {"stringUnit": {"state": "translated", "value": "GitHub bağlantısı kesilsin mi? Aracılar bu bağlantı üzerinden erişimi kaybedecek."}}, "uk": {"stringUnit": {"state": "translated", "value": "Від’єднати GitHub? Агенти втратять доступ через це підключення."}}, "vi": {"stringUnit": {"state": "translated", "value": "Ngắt kết nối GitHub? Các tác nhân sẽ mất quyền truy cập qua kết nối này."}}}},
    "github.cancel": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Cancel"}}, "de": {"stringUnit": {"state": "translated", "value": "Abbrechen"}}, "fr": {"stringUnit": {"state": "translated", "value": "Annuler"}}, "ar": {"stringUnit": {"state": "translated", "value": "إلغاء"}}, "es": {"stringUnit": {"state": "translated", "value": "Cancelar"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "取消"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "取消"}}, "ko": {"stringUnit": {"state": "translated", "value": "취소"}}, "ja": {"stringUnit": {"state": "translated", "value": "キャンセル"}}, "bs": {"stringUnit": {"state": "translated", "value": "Otkaži"}}, "da": {"stringUnit": {"state": "translated", "value": "Annuller"}}, "it": {"stringUnit": {"state": "translated", "value": "Annulla"}}, "km": {"stringUnit": {"state": "translated", "value": "បោះបង់"}}, "nb": {"stringUnit": {"state": "translated", "value": "Avbryt"}}, "pl": {"stringUnit": {"state": "translated", "value": "Anuluj"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Cancelar"}}, "ru": {"stringUnit": {"state": "translated", "value": "Отмена"}}, "th": {"stringUnit": {"state": "translated", "value": "ยกเลิก"}}, "tr": {"stringUnit": {"state": "translated", "value": "İptal"}}, "uk": {"stringUnit": {"state": "translated", "value": "Скасувати"}}, "vi": {"stringUnit": {"state": "translated", "value": "Hủy"}}}},
    "github.refresh": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Refresh"}}, "de": {"stringUnit": {"state": "translated", "value": "Aktualisieren"}}, "fr": {"stringUnit": {"state": "translated", "value": "Actualiser"}}, "ar": {"stringUnit": {"state": "translated", "value": "تحديث"}}, "es": {"stringUnit": {"state": "translated", "value": "Actualizar"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "重新整理"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "刷新"}}, "ko": {"stringUnit": {"state": "translated", "value": "새로 고침"}}, "ja": {"stringUnit": {"state": "translated", "value": "更新"}}, "bs": {"stringUnit": {"state": "translated", "value": "Osvježi"}}, "da": {"stringUnit": {"state": "translated", "value": "Opdater"}}, "it": {"stringUnit": {"state": "translated", "value": "Aggiorna"}}, "km": {"stringUnit": {"state": "translated", "value": "ផ្ទុកឡើងវិញ"}}, "nb": {"stringUnit": {"state": "translated", "value": "Oppdater"}}, "pl": {"stringUnit": {"state": "translated", "value": "Odśwież"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Atualizar"}}, "ru": {"stringUnit": {"state": "translated", "value": "Обновить"}}, "th": {"stringUnit": {"state": "translated", "value": "รีเฟรช"}}, "tr": {"stringUnit": {"state": "translated", "value": "Yenile"}}, "uk": {"stringUnit": {"state": "translated", "value": "Оновити"}}, "vi": {"stringUnit": {"state": "translated", "value": "Làm mới"}}}},
    "github.detail": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Connect the cmux GitHub App."}}, "de": {"stringUnit": {"state": "needs_review", "value": "Verbinde die cmux-GitHub-App."}}, "fr": {"stringUnit": {"state": "needs_review", "value": "Connectez l’application GitHub cmux."}}, "ar": {"stringUnit": {"state": "needs_review", "value": "اربط تطبيق cmux على GitHub."}}, "es": {"stringUnit": {"state": "needs_review", "value": "Conecta la aplicación de GitHub de cmux."}}, "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "連接 cmux GitHub 應用程式。"}}, "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "连接 cmux GitHub 应用。"}}, "ko": {"stringUnit": {"state": "needs_review", "value": "cmux GitHub 앱을 연결하세요."}}, "ja": {"stringUnit": {"state": "needs_review", "value": "cmux GitHub App に接続します。"}}, "bs": {"stringUnit": {"state": "needs_review", "value": "Poveži cmux GitHub aplikaciju."}}, "da": {"stringUnit": {"state": "needs_review", "value": "Forbind cmux GitHub-appen."}}, "it": {"stringUnit": {"state": "needs_review", "value": "Connetti l'app GitHub di cmux."}}, "km": {"stringUnit": {"state": "needs_review", "value": "ភ្ជាប់កម្មវិធី GitHub របស់ cmux។ ជ្រើសរើសឃ្លាំង និងពិនិត្យសិទ្ធិនៅលើ GitHub។"}}, "nb": {"stringUnit": {"state": "needs_review", "value": "Koble til cmux GitHub-appen."}}, "pl": {"stringUnit": {"state": "needs_review", "value": "Połącz aplikację GitHub cmux."}}, "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Conecte o app do GitHub do cmux."}}, "ru": {"stringUnit": {"state": "needs_review", "value": "Подключите приложение cmux для GitHub."}}, "th": {"stringUnit": {"state": "needs_review", "value": "เชื่อมต่อแอป GitHub ของ cmux เลือกที่เก็บและตรวจสอบสิทธิ์ใน GitHub"}}, "tr": {"stringUnit": {"state": "needs_review", "value": "cmux GitHub uygulamasına bağlanın."}}, "uk": {"stringUnit": {"state": "needs_review", "value": "Підключіть застосунок cmux для GitHub."}}, "vi": {"stringUnit": {"state": "needs_review", "value": "Kết nối ứng dụng GitHub của cmux."}}}},
    "github.signIn": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Sign in to cmux to connect GitHub."}}, "de": {"stringUnit": {"state": "translated", "value": "Melde dich bei cmux an, um GitHub zu verbinden."}}, "fr": {"stringUnit": {"state": "translated", "value": "Connectez-vous à cmux pour connecter GitHub."}}, "ar": {"stringUnit": {"state": "translated", "value": "سجّل الدخول إلى cmux لربط GitHub."}}, "es": {"stringUnit": {"state": "translated", "value": "Inicia sesión en cmux para conectar GitHub."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "登入 cmux 以連接 GitHub。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "登录 cmux 以连接 GitHub。"}}, "ko": {"stringUnit": {"state": "translated", "value": "GitHub를 연결하려면 cmux에 로그인하세요."}}, "ja": {"stringUnit": {"state": "translated", "value": "GitHub に接続するには cmux にサインインしてください。"}}, "bs": {"stringUnit": {"state": "translated", "value": "Prijavi se u cmux da povežeš GitHub."}}, "da": {"stringUnit": {"state": "translated", "value": "Log ind på cmux for at forbinde GitHub."}}, "it": {"stringUnit": {"state": "translated", "value": "Accedi a cmux per connettere GitHub."}}, "km": {"stringUnit": {"state": "translated", "value": "ចូល cmux ដើម្បីភ្ជាប់ GitHub។"}}, "nb": {"stringUnit": {"state": "translated", "value": "Logg inn på cmux for å koble til GitHub."}}, "pl": {"stringUnit": {"state": "translated", "value": "Zaloguj się do cmux, aby połączyć GitHub."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Entre no cmux para conectar ao GitHub."}}, "ru": {"stringUnit": {"state": "translated", "value": "Войдите в cmux, чтобы подключить GitHub."}}, "th": {"stringUnit": {"state": "translated", "value": "ลงชื่อเข้าใช้ cmux เพื่อเชื่อมต่อ GitHub"}}, "tr": {"stringUnit": {"state": "translated", "value": "GitHub'a bağlanmak için cmux'ta oturum açın."}}, "uk": {"stringUnit": {"state": "translated", "value": "Увійдіть у cmux, щоб підключити GitHub."}}, "vi": {"stringUnit": {"state": "translated", "value": "Đăng nhập cmux để kết nối GitHub."}}}},
    "github.unavailable": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "GitHub connections are unavailable on this deployment."}}, "de": {"stringUnit": {"state": "translated", "value": "GitHub-Verbindungen sind in dieser Bereitstellung nicht verfügbar."}}, "fr": {"stringUnit": {"state": "translated", "value": "Les connexions GitHub ne sont pas disponibles sur ce déploiement."}}, "ar": {"stringUnit": {"state": "translated", "value": "اتصالات GitHub غير متاحة في هذا النشر."}}, "es": {"stringUnit": {"state": "translated", "value": "Las conexiones de GitHub no están disponibles en este despliegue."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "此部署無法使用 GitHub 連線。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此部署无法使用 GitHub 连接。"}}, "ko": {"stringUnit": {"state": "translated", "value": "이 배포에서는 GitHub 연결을 사용할 수 없습니다."}}, "ja": {"stringUnit": {"state": "translated", "value": "このデプロイでは GitHub に接続できません。"}}, "bs": {"stringUnit": {"state": "translated", "value": "GitHub veze nisu dostupne u ovoj instalaciji."}}, "da": {"stringUnit": {"state": "translated", "value": "GitHub-forbindelser er ikke tilgængelige i denne installation."}}, "it": {"stringUnit": {"state": "translated", "value": "Le connessioni GitHub non sono disponibili in questa distribuzione."}}, "km": {"stringUnit": {"state": "translated", "value": "ការភ្ជាប់ GitHub មិនអាចប្រើបាននៅលើការដាក់ពង្រាយនេះទេ។"}}, "nb": {"stringUnit": {"state": "translated", "value": "GitHub-tilkoblinger er utilgjengelige i denne distribusjonen."}}, "pl": {"stringUnit": {"state": "translated", "value": "Połączenia z GitHub są niedostępne w tym wdrożeniu."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "As conexões do GitHub não estão disponíveis nesta implantação."}}, "ru": {"stringUnit": {"state": "translated", "value": "Подключения к GitHub недоступны в этом развёртывании."}}, "th": {"stringUnit": {"state": "translated", "value": "การเชื่อมต่อ GitHub ไม่พร้อมใช้งานในการปรับใช้นี้"}}, "tr": {"stringUnit": {"state": "translated", "value": "GitHub bağlantıları bu dağıtımda kullanılamıyor."}}, "uk": {"stringUnit": {"state": "translated", "value": "Підключення до GitHub недоступні в цьому розгортанні."}}, "vi": {"stringUnit": {"state": "translated", "value": "Các kết nối GitHub không khả dụng trong bản triển khai này."}}}},
    "github.pending": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Finish connecting in your browser, then refresh."}}, "de": {"stringUnit": {"state": "translated", "value": "Schließe die Verbindung im Browser ab und aktualisiere dann."}}, "fr": {"stringUnit": {"state": "translated", "value": "Terminez la connexion dans votre navigateur, puis actualisez."}}, "ar": {"stringUnit": {"state": "translated", "value": "أكمل الربط في المتصفح، ثم حدّث."}}, "es": {"stringUnit": {"state": "translated", "value": "Completa la conexión en tu navegador y luego actualiza."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "在瀏覽器中完成連線，然後重新整理。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "在浏览器中完成连接，然后刷新。"}}, "ko": {"stringUnit": {"state": "translated", "value": "브라우저에서 연결을 완료한 다음 새로 고침하세요."}}, "ja": {"stringUnit": {"state": "translated", "value": "ブラウザで接続を完了してから更新してください。"}}, "bs": {"stringUnit": {"state": "translated", "value": "Dovrši povezivanje u pregledniku, a zatim osvježi."}}, "da": {"stringUnit": {"state": "translated", "value": "Færdiggør forbindelsen i din browser, og opdater derefter."}}, "it": {"stringUnit": {"state": "translated", "value": "Completa la connessione nel browser, poi aggiorna."}}, "km": {"stringUnit": {"state": "translated", "value": "បញ្ចប់ការភ្ជាប់នៅក្នុងកម្មវិធីរុករក រួចផ្ទុកឡើងវិញ។"}}, "nb": {"stringUnit": {"state": "translated", "value": "Fullfør tilkoblingen i nettleseren, og oppdater deretter."}}, "pl": {"stringUnit": {"state": "translated", "value": "Dokończ łączenie w przeglądarce, a następnie odśwież."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Conclua a conexão no navegador e depois atualize."}}, "ru": {"stringUnit": {"state": "translated", "value": "Завершите подключение в браузере, затем обновите."}}, "th": {"stringUnit": {"state": "translated", "value": "เชื่อมต่อให้เสร็จในเบราว์เซอร์ แล้วรีเฟรช"}}, "tr": {"stringUnit": {"state": "translated", "value": "Tarayıcınızda bağlantıyı tamamlayın, ardından yenileyin."}}, "uk": {"stringUnit": {"state": "translated", "value": "Завершіть підключення у браузері, потім оновіть."}}, "vi": {"stringUnit": {"state": "translated", "value": "Hoàn tất kết nối trong trình duyệt, sau đó làm mới."}}}},
    "github.failed": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "GitHub could not be updated. Refresh to try again."}}, "de": {"stringUnit": {"state": "translated", "value": "GitHub konnte nicht aktualisiert werden. Aktualisiere, um es erneut zu versuchen."}}, "fr": {"stringUnit": {"state": "translated", "value": "Impossible d’actualiser GitHub. Actualisez pour réessayer."}}, "ar": {"stringUnit": {"state": "translated", "value": "تعذّر تحديث GitHub. حدّث للمحاولة مجددًا."}}, "es": {"stringUnit": {"state": "translated", "value": "No se pudo actualizar GitHub. Actualiza para volver a intentarlo."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法更新 GitHub。請重新整理以重試。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法更新 GitHub。请刷新以重试。"}}, "ko": {"stringUnit": {"state": "translated", "value": "GitHub를 업데이트하지 못했습니다. 새로 고침하여 다시 시도하세요."}}, "ja": {"stringUnit": {"state": "translated", "value": "GitHub を更新できませんでした。更新してもう一度お試しください。"}}, "bs": {"stringUnit": {"state": "translated", "value": "GitHub nije moguće ažurirati. Osvježi i pokušaj ponovo."}}, "da": {"stringUnit": {"state": "translated", "value": "GitHub kunne ikke opdateres. Opdater for at prøve igen."}}, "it": {"stringUnit": {"state": "translated", "value": "Impossibile aggiornare GitHub. Aggiorna per riprovare."}}, "km": {"stringUnit": {"state": "translated", "value": "មិនអាចធ្វើបច្ចុប្បន្នភាព GitHub បានទេ។ ផ្ទុកឡើងវិញដើម្បីព្យាយាមម្ដងទៀត។"}}, "nb": {"stringUnit": {"state": "translated", "value": "GitHub kunne ikke oppdateres. Oppdater for å prøve på nytt."}}, "pl": {"stringUnit": {"state": "translated", "value": "Nie udało się zaktualizować GitHub. Odśwież, aby spróbować ponownie."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível atualizar o GitHub. Atualize para tentar novamente."}}, "ru": {"stringUnit": {"state": "translated", "value": "Не удалось обновить GitHub. Обновите и попробуйте снова."}}, "th": {"stringUnit": {"state": "translated", "value": "อัปเดต GitHub ไม่ได้ รีเฟรชเพื่อลองอีกครั้ง"}}, "tr": {"stringUnit": {"state": "translated", "value": "GitHub güncellenemedi. Yenileyerek tekrar deneyin."}}, "uk": {"stringUnit": {"state": "translated", "value": "Не вдалося оновити GitHub. Оновіть і спробуйте ще раз."}}, "vi": {"stringUnit": {"state": "translated", "value": "Không thể cập nhật GitHub. Hãy làm mới để thử lại."}}}},
    "github.connected": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Connected"}}, "de": {"stringUnit": {"state": "translated", "value": "Verbunden"}}, "fr": {"stringUnit": {"state": "translated", "value": "Connecté"}}, "ar": {"stringUnit": {"state": "translated", "value": "متصل"}}, "es": {"stringUnit": {"state": "translated", "value": "Conectado"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "已連線"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已连接"}}, "ko": {"stringUnit": {"state": "translated", "value": "연결됨"}}, "ja": {"stringUnit": {"state": "translated", "value": "接続済み"}}, "bs": {"stringUnit": {"state": "translated", "value": "Povezano"}}, "da": {"stringUnit": {"state": "translated", "value": "Forbundet"}}, "it": {"stringUnit": {"state": "translated", "value": "Connesso"}}, "km": {"stringUnit": {"state": "translated", "value": "បានភ្ជាប់"}}, "nb": {"stringUnit": {"state": "translated", "value": "Tilkoblet"}}, "pl": {"stringUnit": {"state": "translated", "value": "Połączono"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Conectado"}}, "ru": {"stringUnit": {"state": "translated", "value": "Подключено"}}, "th": {"stringUnit": {"state": "translated", "value": "เชื่อมต่อแล้ว"}}, "tr": {"stringUnit": {"state": "translated", "value": "Bağlandı"}}, "uk": {"stringUnit": {"state": "translated", "value": "Підключено"}}, "vi": {"stringUnit": {"state": "translated", "value": "Đã kết nối"}}}},
    "github.reconnect": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Connect GitHub again to restore access."}}, "de": {"stringUnit": {"state": "translated", "value": "Verbinde GitHub erneut, um den Zugriff wiederherzustellen."}}, "fr": {"stringUnit": {"state": "translated", "value": "Reconnectez GitHub pour rétablir l’accès."}}, "ar": {"stringUnit": {"state": "translated", "value": "اربط GitHub مجددًا لاستعادة الوصول."}}, "es": {"stringUnit": {"state": "translated", "value": "Vuelve a conectar GitHub para restaurar el acceso."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "重新連接 GitHub 以恢復存取權。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "重新连接 GitHub 以恢复访问权限。"}}, "ko": {"stringUnit": {"state": "translated", "value": "액세스를 복원하려면 GitHub를 다시 연결하세요."}}, "ja": {"stringUnit": {"state": "translated", "value": "アクセスを復元するには GitHub に再接続してください。"}}, "bs": {"stringUnit": {"state": "translated", "value": "Ponovo poveži GitHub da vratiš pristup."}}, "da": {"stringUnit": {"state": "translated", "value": "Forbind GitHub igen for at gendanne adgangen."}}, "it": {"stringUnit": {"state": "translated", "value": "Connetti nuovamente GitHub per ripristinare l'accesso."}}, "km": {"stringUnit": {"state": "translated", "value": "ភ្ជាប់ GitHub ម្តងទៀត ដើម្បីស្ដារសិទ្ធិចូលប្រើ។"}}, "nb": {"stringUnit": {"state": "translated", "value": "Koble til GitHub på nytt for å gjenopprette tilgang."}}, "pl": {"stringUnit": {"state": "translated", "value": "Połącz GitHub ponownie, aby przywrócić dostęp."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Conecte o GitHub novamente para restaurar o acesso."}}, "ru": {"stringUnit": {"state": "translated", "value": "Подключите GitHub снова, чтобы восстановить доступ."}}, "th": {"stringUnit": {"state": "translated", "value": "เชื่อมต่อ GitHub อีกครั้งเพื่อกู้คืนสิทธิ์เข้าถึง"}}, "tr": {"stringUnit": {"state": "translated", "value": "Erişimi geri yüklemek için GitHub'a yeniden bağlanın."}}, "uk": {"stringUnit": {"state": "translated", "value": "Підключіть GitHub знову, щоб відновити доступ."}}, "vi": {"stringUnit": {"state": "translated", "value": "Kết nối lại GitHub để khôi phục quyền truy cập."}}}},
    "github.completePending": {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"أرسل GitHub طلبك إلى مالكي المؤسسة. عندما يوافق عليه أحد المالكين، اربط GitHub مرة أخرى."}},"bs":{"stringUnit":{"state":"translated","value":"GitHub je poslao vaš zahtjev vlasnicima organizacije. Kada ga vlasnik odobri, ponovo povežite GitHub."}},"da":{"stringUnit":{"state":"translated","value":"GitHub har sendt din anmodning til organisationens ejere. Når en ejer godkender den, skal du forbinde GitHub igen."}},"de":{"stringUnit":{"state":"translated","value":"GitHub hat deine Anfrage an die Eigentümer der Organisation gesendet. Sobald ein Eigentümer sie genehmigt, verbinde GitHub erneut."}},"en":{"stringUnit":{"state":"translated","value":"GitHub sent your request to the organization's owners. When an owner approves it, connect GitHub again."}},"es":{"stringUnit":{"state":"translated","value":"GitHub envió tu solicitud a los propietarios de la organización. Cuando un propietario la apruebe, vuelve a conectar GitHub."}},"fr":{"stringUnit":{"state":"translated","value":"GitHub a envoyé votre demande aux propriétaires de l'organisation. Quand un propriétaire l'approuve, connectez GitHub à nouveau."}},"it":{"stringUnit":{"state":"translated","value":"GitHub ha inviato la tua richiesta ai proprietari dell'organizzazione. Quando un proprietario la approva, collega di nuovo GitHub."}},"ja":{"stringUnit":{"state":"translated","value":"GitHub がリクエストを組織のオーナーに送信しました。オーナーが承認したら、もう一度 GitHub を接続してください。"}},"km":{"stringUnit":{"state":"translated","value":"GitHub បានផ្ញើសំណើរបស់អ្នកទៅម្ចាស់ស្ថាប័ន។ នៅពេលម្ចាស់អនុម័តវា សូមភ្ជាប់ GitHub ម្ដងទៀត។"}},"ko":{"stringUnit":{"state":"translated","value":"GitHub가 요청을 조직 소유자에게 보냈습니다. 소유자가 승인하면 GitHub를 다시 연결하세요."}},"nb":{"stringUnit":{"state":"translated","value":"GitHub sendte forespørselen din til organisasjonens eiere. Når en eier godkjenner den, kobler du til GitHub igjen."}},"pl":{"stringUnit":{"state":"translated","value":"GitHub wysłał Twoją prośbę do właścicieli organizacji. Gdy właściciel ją zatwierdzi, ponownie połącz GitHub."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O GitHub enviou sua solicitação aos proprietários da organização. Quando um proprietário aprovar, conecte o GitHub novamente."}},"ru":{"stringUnit":{"state":"translated","value":"GitHub отправил ваш запрос владельцам организации. Когда владелец его одобрит, снова подключите GitHub."}},"th":{"stringUnit":{"state":"translated","value":"GitHub ส่งคำขอของคุณไปยังเจ้าขององค์กรแล้ว เมื่อเจ้าของอนุมัติ ให้เชื่อมต่อ GitHub อีกครั้ง"}},"tr":{"stringUnit":{"state":"translated","value":"GitHub isteğinizi kuruluşun sahiplerine gönderdi. Bir sahip onayladığında GitHub'ı yeniden bağlayın."}},"uk":{"stringUnit":{"state":"translated","value":"GitHub надіслав ваш запит власникам організації. Коли власник його схвалить, знову підключіть GitHub."}},"vi":{"stringUnit":{"state":"translated","value":"GitHub đã gửi yêu cầu của bạn đến chủ sở hữu tổ chức. Khi chủ sở hữu phê duyệt, hãy kết nối lại GitHub."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"GitHub 已将你的请求发送给组织所有者。所有者批准后，请再次连接 GitHub。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"GitHub 已將你的請求傳送給組織擁有者。擁有者核准後，請再次連接 GitHub。"}}}},
    "github.completeRefused": {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"لم يتم ربط GitHub: انتهت صلاحية هذا الرابط أو أنه لتسجيل دخول آخر. اربط GitHub مرة أخرى."}},"bs":{"stringUnit":{"state":"translated","value":"GitHub nije povezan: ovaj link je istekao ili je za drugu prijavu. Ponovo povežite GitHub."}},"da":{"stringUnit":{"state":"translated","value":"GitHub er ikke forbundet: linket er udløbet eller hører til et andet login. Forbind GitHub igen."}},"de":{"stringUnit":{"state":"translated","value":"GitHub ist nicht verbunden: Dieser Link ist abgelaufen oder gehört zu einer anderen Anmeldung. Verbinde GitHub erneut."}},"en":{"stringUnit":{"state":"translated","value":"GitHub isn't connected: this link expired or is for another sign-in. Connect GitHub again."}},"es":{"stringUnit":{"state":"translated","value":"GitHub no está conectado: este enlace caducó o es de otro inicio de sesión. Vuelve a conectar GitHub."}},"fr":{"stringUnit":{"state":"translated","value":"GitHub n'est pas connecté : ce lien a expiré ou appartient à une autre connexion. Connectez GitHub à nouveau."}},"it":{"stringUnit":{"state":"translated","value":"GitHub non è collegato: questo link è scaduto o appartiene a un altro accesso. Collega di nuovo GitHub."}},"ja":{"stringUnit":{"state":"translated","value":"GitHub は接続されていません。このリンクは期限切れか、別のサインイン用です。もう一度 GitHub を接続してください。"}},"km":{"stringUnit":{"state":"translated","value":"GitHub មិនទាន់បានភ្ជាប់ទេ៖ តំណនេះផុតកំណត់ ឬសម្រាប់ការចូលផ្សេង។ សូមភ្ជាប់ GitHub ម្ដងទៀត។"}},"ko":{"stringUnit":{"state":"translated","value":"GitHub가 연결되지 않았습니다. 이 링크가 만료되었거나 다른 로그인용입니다. GitHub를 다시 연결하세요."}},"nb":{"stringUnit":{"state":"translated","value":"GitHub er ikke koblet til: lenken er utløpt eller gjelder en annen pålogging. Koble til GitHub igjen."}},"pl":{"stringUnit":{"state":"translated","value":"GitHub nie jest połączony: ten link wygasł lub dotyczy innego logowania. Ponownie połącz GitHub."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O GitHub não está conectado: este link expirou ou é de outro login. Conecte o GitHub novamente."}},"ru":{"stringUnit":{"state":"translated","value":"GitHub не подключён: срок действия ссылки истёк или она для другого входа. Снова подключите GitHub."}},"th":{"stringUnit":{"state":"translated","value":"ยังไม่ได้เชื่อมต่อ GitHub: ลิงก์นี้หมดอายุหรือเป็นของการลงชื่อเข้าใช้อื่น เชื่อมต่อ GitHub อีกครั้ง"}},"tr":{"stringUnit":{"state":"translated","value":"GitHub bağlı değil: bu bağlantının süresi doldu veya başka bir oturum için. GitHub'ı yeniden bağlayın."}},"uk":{"stringUnit":{"state":"translated","value":"GitHub не підключено: термін дії посилання минув або воно для іншого входу. Знову підключіть GitHub."}},"vi":{"stringUnit":{"state":"translated","value":"GitHub chưa được kết nối: liên kết này đã hết hạn hoặc dành cho lần đăng nhập khác. Hãy kết nối lại GitHub."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"GitHub 未连接：此链接已过期或属于其他登录。请再次连接 GitHub。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"GitHub 未連接：此連結已過期或屬於其他登入。請再次連接 GitHub。"}}}},
    "github.completeNoAnswer": {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"تعذّر الوصول إلى cmux Cloud لإكمال ربط GitHub. حاول مرة أخرى."}},"bs":{"stringUnit":{"state":"translated","value":"Nije moguće doći do cmux Cloud da se završi povezivanje GitHuba. Pokušajte ponovo."}},"da":{"stringUnit":{"state":"translated","value":"Kunne ikke nå cmux Cloud for at gøre forbindelsen til GitHub færdig. Prøv igen."}},"de":{"stringUnit":{"state":"translated","value":"cmux Cloud war nicht erreichbar, um die Verbindung mit GitHub abzuschließen. Versuche es erneut."}},"en":{"stringUnit":{"state":"translated","value":"Couldn't reach cmux Cloud to finish connecting GitHub. Try again."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo contactar con cmux Cloud para terminar de conectar GitHub. Inténtalo de nuevo."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de joindre cmux Cloud pour terminer la connexion à GitHub. Réessayez."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile raggiungere cmux Cloud per completare il collegamento a GitHub. Riprova."}},"ja":{"stringUnit":{"state":"translated","value":"GitHub の接続を完了するために cmux Cloud に接続できませんでした。もう一度お試しください。"}},"km":{"stringUnit":{"state":"translated","value":"មិនអាចទាក់ទង cmux Cloud ដើម្បីបញ្ចប់ការភ្ជាប់ GitHub បានទេ។ សូមព្យាយាមម្ដងទៀត។"}},"ko":{"stringUnit":{"state":"translated","value":"GitHub 연결을 완료하기 위해 cmux Cloud에 연결할 수 없습니다. 다시 시도하세요."}},"nb":{"stringUnit":{"state":"translated","value":"Fikk ikke kontakt med cmux Cloud for å fullføre tilkoblingen til GitHub. Prøv igjen."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się połączyć z cmux Cloud, aby dokończyć łączenie GitHub. Spróbuj ponownie."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível acessar o cmux Cloud para concluir a conexão com o GitHub. Tente novamente."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось связаться с cmux Cloud, чтобы завершить подключение GitHub. Повторите попытку."}},"th":{"stringUnit":{"state":"translated","value":"ติดต่อ cmux Cloud เพื่อเชื่อมต่อ GitHub ให้เสร็จไม่ได้ ลองอีกครั้ง"}},"tr":{"stringUnit":{"state":"translated","value":"GitHub bağlantısını tamamlamak için cmux Cloud'a ulaşılamadı. Yeniden deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося зв'язатися з cmux Cloud, щоб завершити підключення GitHub. Спробуйте ще раз."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể kết nối cmux Cloud để hoàn tất kết nối GitHub. Hãy thử lại."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法连接 cmux Cloud 来完成 GitHub 连接。请重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法連線至 cmux Cloud 以完成 GitHub 連接。請再試一次。"}}}},
    "github.retry": {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"إعادة المحاولة"}},"bs":{"stringUnit":{"state":"translated","value":"Pokušaj ponovo"}},"da":{"stringUnit":{"state":"translated","value":"Prøv igen"}},"de":{"stringUnit":{"state":"translated","value":"Erneut versuchen"}},"en":{"stringUnit":{"state":"translated","value":"Retry"}},"es":{"stringUnit":{"state":"translated","value":"Reintentar"}},"fr":{"stringUnit":{"state":"translated","value":"Réessayer"}},"it":{"stringUnit":{"state":"translated","value":"Riprova"}},"ja":{"stringUnit":{"state":"translated","value":"再試行"}},"km":{"stringUnit":{"state":"translated","value":"ព្យាយាមម្ដងទៀត"}},"ko":{"stringUnit":{"state":"translated","value":"다시 시도"}},"nb":{"stringUnit":{"state":"translated","value":"Prøv igjen"}},"pl":{"stringUnit":{"state":"translated","value":"Ponów"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Tentar novamente"}},"ru":{"stringUnit":{"state":"translated","value":"Повторить"}},"th":{"stringUnit":{"state":"translated","value":"ลองอีกครั้ง"}},"tr":{"stringUnit":{"state":"translated","value":"Yeniden dene"}},"uk":{"stringUnit":{"state":"translated","value":"Повторити"}},"vi":{"stringUnit":{"state":"translated","value":"Thử lại"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重试"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"重試"}}}},
    "github.reauth": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "GitHub access was suspended or removed. Connect GitHub again."}}, "de": {"stringUnit": {"state": "translated", "value": "Der GitHub-Zugriff wurde ausgesetzt oder entfernt. Verbinde GitHub erneut."}}, "fr": {"stringUnit": {"state": "translated", "value": "L'accès à GitHub a été suspendu ou supprimé. Connectez à nouveau GitHub."}}, "ar": {"stringUnit": {"state": "translated", "value": "تم تعليق الوصول إلى GitHub أو إزالته. اربط GitHub مرة أخرى."}}, "es": {"stringUnit": {"state": "translated", "value": "El acceso a GitHub se suspendió o se eliminó. Vuelve a conectar GitHub."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "GitHub 存取已被暫停或移除。請重新連接 GitHub。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "GitHub 访问已被暂停或移除。请重新连接 GitHub。"}}, "ko": {"stringUnit": {"state": "translated", "value": "GitHub 접근이 일시 중지되었거나 제거되었습니다. GitHub를 다시 연결하세요."}}, "ja": {"stringUnit": {"state": "translated", "value": "GitHub へのアクセスが停止または削除されました。GitHub に再接続してください。"}}, "bs": {"stringUnit": {"state": "translated", "value": "Pristup GitHubu je suspendovan ili uklonjen. Ponovo poveži GitHub."}}, "da": {"stringUnit": {"state": "translated", "value": "Adgangen til GitHub blev suspenderet eller fjernet. Forbind GitHub igen."}}, "it": {"stringUnit": {"state": "translated", "value": "L'accesso a GitHub è stato sospeso o rimosso. Connetti di nuovo GitHub."}}, "km": {"stringUnit": {"state": "translated", "value": "ការចូលប្រើ GitHub ត្រូវបានផ្អាក ឬដកចេញ។ សូមភ្ជាប់ GitHub ម្តងទៀត។"}}, "nb": {"stringUnit": {"state": "translated", "value": "Tilgangen til GitHub ble suspendert eller fjernet. Koble til GitHub på nytt."}}, "pl": {"stringUnit": {"state": "translated", "value": "Dostęp do GitHub został zawieszony lub usunięty. Połącz GitHub ponownie."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "O acesso ao GitHub foi suspenso ou removido. Conecte o GitHub novamente."}}, "ru": {"stringUnit": {"state": "translated", "value": "Доступ к GitHub приостановлен или удалён. Подключите GitHub снова."}}, "th": {"stringUnit": {"state": "translated", "value": "การเข้าถึง GitHub ถูกระงับหรือถูกลบ โปรดเชื่อมต่อ GitHub อีกครั้ง"}}, "tr": {"stringUnit": {"state": "translated", "value": "GitHub erişimi askıya alındı veya kaldırıldı. GitHub'a yeniden bağlan."}}, "uk": {"stringUnit": {"state": "translated", "value": "Доступ до GitHub призупинено або видалено. Підключіть GitHub знову."}}, "vi": {"stringUnit": {"state": "translated", "value": "Quyền truy cập GitHub đã bị tạm ngưng hoặc gỡ bỏ. Hãy kết nối lại GitHub."}}}},
    "github.connectionError": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "GitHub reported a problem with this connection. Try again later."}}, "de": {"stringUnit": {"state": "translated", "value": "GitHub meldet ein Problem mit dieser Verbindung. Versuche es später erneut."}}, "fr": {"stringUnit": {"state": "translated", "value": "GitHub signale un problème avec cette connexion. Réessayez plus tard."}}, "ar": {"stringUnit": {"state": "translated", "value": "أبلغ GitHub عن مشكلة في هذا الاتصال. حاول مرة أخرى لاحقًا."}}, "es": {"stringUnit": {"state": "translated", "value": "GitHub informó de un problema con esta conexión. Inténtalo de nuevo más tarde."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "GitHub 回報此連線發生問題。請稍後再試。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "GitHub 报告此连接出现问题。请稍后重试。"}}, "ko": {"stringUnit": {"state": "translated", "value": "GitHub에서 이 연결에 문제가 있다고 알렸습니다. 나중에 다시 시도하세요."}}, "ja": {"stringUnit": {"state": "translated", "value": "GitHub がこの接続に問題があると報告しました。後でもう一度お試しください。"}}, "bs": {"stringUnit": {"state": "translated", "value": "GitHub je prijavio problem s ovom vezom. Pokušaj ponovo kasnije."}}, "da": {"stringUnit": {"state": "translated", "value": "GitHub har meldt et problem med denne forbindelse. Prøv igen senere."}}, "it": {"stringUnit": {"state": "translated", "value": "GitHub ha segnalato un problema con questa connessione. Riprova più tardi."}}, "km": {"stringUnit": {"state": "translated", "value": "GitHub បានរាយការណ៍ពីបញ្ហាជាមួយការតភ្ជាប់នេះ។ សូមព្យាយាមម្តងទៀតនៅពេលក្រោយ។"}}, "nb": {"stringUnit": {"state": "translated", "value": "GitHub meldte et problem med denne tilkoblingen. Prøv igjen senere."}}, "pl": {"stringUnit": {"state": "translated", "value": "GitHub zgłosił problem z tym połączeniem. Spróbuj ponownie później."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "O GitHub relatou um problema com esta conexão. Tente novamente mais tarde."}}, "ru": {"stringUnit": {"state": "translated", "value": "GitHub сообщил о проблеме с этим подключением. Повторите попытку позже."}}, "th": {"stringUnit": {"state": "translated", "value": "GitHub รายงานปัญหาเกี่ยวกับการเชื่อมต่อนี้ โปรดลองอีกครั้งในภายหลัง"}}, "tr": {"stringUnit": {"state": "translated", "value": "GitHub bu bağlantıyla ilgili bir sorun bildirdi. Daha sonra tekrar dene."}}, "uk": {"stringUnit": {"state": "translated", "value": "GitHub повідомив про проблему з цим підключенням. Спробуйте пізніше."}}, "vi": {"stringUnit": {"state": "translated", "value": "GitHub báo có sự cố với kết nối này. Hãy thử lại sau."}}}},
    "github.linkExpired": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The link expired; connect again."}}, "de": {"stringUnit": {"state": "translated", "value": "Der Link ist abgelaufen; verbinde erneut."}}, "fr": {"stringUnit": {"state": "translated", "value": "Le lien a expiré ; reconnectez-vous."}}, "ar": {"stringUnit": {"state": "translated", "value": "انتهت صلاحية الرابط؛ اتصل مرة أخرى."}}, "es": {"stringUnit": {"state": "translated", "value": "El enlace caducó; vuelve a conectar."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "連結已過期；請重新連接。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "链接已过期；请重新连接。"}}, "ko": {"stringUnit": {"state": "translated", "value": "링크가 만료되었습니다. 다시 연결하세요."}}, "ja": {"stringUnit": {"state": "translated", "value": "リンクの有効期限が切れました。もう一度接続してください。"}}, "bs": {"stringUnit": {"state": "translated", "value": "Veza je istekla; poveži ponovo."}}, "da": {"stringUnit": {"state": "translated", "value": "Linket er udløbet; forbind igen."}}, "it": {"stringUnit": {"state": "translated", "value": "Il link è scaduto; connettiti di nuovo."}}, "km": {"stringUnit": {"state": "translated", "value": "តំណបានផុតកំណត់ សូមភ្ជាប់ម្តងទៀត។"}}, "nb": {"stringUnit": {"state": "translated", "value": "Lenken har utløpt; koble til på nytt."}}, "pl": {"stringUnit": {"state": "translated", "value": "Link wygasł; połącz ponownie."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "O link expirou; conecte novamente."}}, "ru": {"stringUnit": {"state": "translated", "value": "Срок действия ссылки истёк; подключитесь снова."}}, "th": {"stringUnit": {"state": "translated", "value": "ลิงก์หมดอายุ โปรดเชื่อมต่ออีกครั้ง"}}, "tr": {"stringUnit": {"state": "translated", "value": "Bağlantının süresi doldu; yeniden bağlan."}}, "uk": {"stringUnit": {"state": "translated", "value": "Термін дії посилання минув; підключіться знову."}}, "vi": {"stringUnit": {"state": "translated", "value": "Liên kết đã hết hạn; hãy kết nối lại."}}}}
  },
  "version": "1.0"
}
