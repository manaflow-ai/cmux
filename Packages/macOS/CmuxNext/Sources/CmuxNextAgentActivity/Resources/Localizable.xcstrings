    "pane.empty.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When an agent uses computer use, its session and a timeline of every action appear here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عندما يستخدم وكيل التحكم بالحاسوب، تظهر هنا جلسته وخط زمني لكل إجراء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kada agent koristi upravljanje računarom, ovdje se pojavljuju njegova sesija i vremenska linija svake radnje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Når en agent bruger computerstyring, vises dens session og en tidslinje over hver handling her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn ein Agent die Computersteuerung nutzt, erscheinen hier seine Sitzung und eine Zeitleiste aller Aktionen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cuando un agente usa el control del ordenador, aquí aparecen su sesión y una cronología de cada acción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quand un agent utilise le contrôle de l’ordinateur, sa session et la chronologie de chaque action apparaissent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quando un agente usa il controllo del computer, qui compaiono la sua sessione e una cronologia di ogni azione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "エージェントがコンピュータ操作を使うと、そのセッションとすべての操作のタイムラインがここに表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "នៅពេលភ្នាក់ងារប្រើការគ្រប់គ្រងកុំព្យូទ័រ វគ្គ និងបន្ទាត់ពេលវេលានៃសកម្មភាពនីមួយៗនឹងបង្ហាញនៅទីនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트가 컴퓨터 사용을 하면 세션과 모든 동작의 타임라인이 여기에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Når en agent bruker datamaskinstyring, vises økten og en tidslinje over hver handling her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gdy agent użyje sterowania komputerem, pojawi się tu jego sesja i oś czasu każdej akcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quando um agente usa o controle do computador, a sessão e uma linha do tempo de cada ação aparecem aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Когда агент управляет компьютером, здесь появятся его сеанс и хронология каждого действия."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เมื่อเอเจนต์ใช้การควบคุมคอมพิวเตอร์ เซสชันและไทม์ไลน์ของทุกการกระทำจะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir ajan bilgisayar denetimini kullandığında oturumu ve her eylemin zaman çizelgesi burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Коли агент керує комп’ютером, тут з’являться його сеанс і хронологія кожної дії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khi một tác tử điều khiển máy tính, phiên và dòng thời gian của mọi thao tác sẽ hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "代理使用电脑操作时，其会话和每个操作的时间线会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "代理使用電腦操作時，其工作階段和每個操作的時間軸會顯示在這裡。"
          }
        }
      }
    },
