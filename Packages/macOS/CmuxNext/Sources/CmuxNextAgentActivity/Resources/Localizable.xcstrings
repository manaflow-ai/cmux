    "pane.empty.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessions and their steps show here when an agent uses the computer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تظهر الجلسات وخطواتها هنا عندما يستخدم وكيل الكمبيوتر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sesije i njihovi koraci prikazuju se ovdje kada agent koristi računar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sessioner og deres trin vises her, når en agent bruger computeren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sitzungen und ihre Schritte erscheinen hier, wenn ein Agent den Computer bedient."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las sesiones y sus pasos aparecen aquí cuando un agente usa el ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les sessions et leurs étapes s’affichent ici quand un agent utilise l’ordinateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le sessioni e i loro passaggi appaiono qui quando un agente usa il computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "エージェントがコンピュータを操作すると、セッションとその手順がここに表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "វគ្គ និងជំហានរបស់វាបង្ហាញនៅទីនេះ នៅពេលភ្នាក់ងារប្រើកុំព្យូទ័រ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트가 컴퓨터를 사용하면 세션과 단계가 여기에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Økter og trinnene deres vises her når en agent bruker datamaskinen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sesje i ich kroki pojawiają się tutaj, gdy agent używa komputera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As sessões e suas etapas aparecem aqui quando um agente usa o computador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сеансы и их шаги появляются здесь, когда агент управляет компьютером."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เซสชันและขั้นตอนจะแสดงที่นี่เมื่อเอเจนต์ใช้คอมพิวเตอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir ajan bilgisayarı kullandığında oturumlar ve adımları burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сеанси та їхні кроки з’являються тут, коли агент керує комп’ютером."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các phiên và các bước của chúng hiển thị ở đây khi một tác nhân sử dụng máy tính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "智能体使用电脑时，会话及其步骤会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "代理程式使用電腦時，工作階段及其步驟會顯示在這裡。"
          }
        }
      }
    },
