    "agentPermissions.unclear": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This reason does not clearly match what you asked. Deny if you did not expect this."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يتطابق هذا السبب بوضوح مع ما طلبته. ارفض إن لم تتوقع ذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovaj razlog ne odgovara jasno onome što ste tražili. Odbijte ako ovo niste očekivali."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Grunden passer ikke tydeligt til det, du bad om. Afvis, hvis du ikke ventede dette."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Grund passt nicht klar zu deiner Anfrage. Lehne ab, wenn du das nicht erwartet hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este motivo no coincide claramente con lo que pediste. Deniega si no lo esperabas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette raison ne correspond pas clairement à votre demande. Refusez si vous ne vous y attendiez pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo motivo non corrisponde chiaramente alla tua richiesta. Nega se non te lo aspettavi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この理由は依頼内容とはっきり一致しません。心当たりがなければ拒否してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ហេតុផលនេះមិនត្រូវនឹងអ្វីដែលអ្នកស្នើច្បាស់ទេ។ បដិសេធបើអ្នកមិនរំពឹង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 이유는 요청한 내용과 분명히 맞지 않습니다. 예상하지 못했다면 거부하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Grunnen passer ikke tydelig med det du ba om. Avslå hvis du ikke ventet dette."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten powód nie pasuje wyraźnie do Twojej prośby. Odmów, jeśli się tego nie spodziewałeś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este motivo não corresponde claramente ao que você pediu. Negue se não esperava isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Причина явно не связана с вашим запросом. Откажите, если вы этого не ждали."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เหตุผลนี้ไม่ตรงกับสิ่งที่คุณขออย่างชัดเจน ปฏิเสธหากคุณไม่ได้คาดไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu neden isteğinizle açıkça örtüşmüyor. Beklemiyorduysanız reddedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Причина явно не пов’язана з вашим запитом. Відмовте, якщо ви цього не чекали."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lý do này không khớp rõ với yêu cầu của bạn. Hãy từ chối nếu bạn không mong đợi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这个原因与你的请求不明显相符。如果出乎意料，请拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這個原因與你的要求不明顯相符。如果出乎意料，請拒絕。"
          }
        }
      }
    },
