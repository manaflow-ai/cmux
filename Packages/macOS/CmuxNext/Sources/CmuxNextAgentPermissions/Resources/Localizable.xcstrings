    "agentPermissions.summary.computer_use": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets agents see and use your apps. macOS needs two permissions for it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتيح للوكلاء رؤية تطبيقاتك واستخدامها. يحتاج macOS إلى إذنين لذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Omogućava agentima da vide i koriste vaše aplikacije. macOS za to traži dvije dozvole."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lader agenter se og bruge dine apps. macOS kræver to tilladelser til det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erlaubt Agenten, deine Apps zu sehen und zu bedienen. macOS braucht dafür zwei Berechtigungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite a los agentes ver y usar tus apps. macOS necesita dos permisos para ello."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permet aux agents de voir et d’utiliser vos apps. macOS demande deux autorisations."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consente agli agenti di vedere e usare le tue app. macOS richiede due permessi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "エージェントがアプリを見て操作できるようにします。macOS では 2 つの許可が必要です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អនុញ្ញាតឲ្យភ្នាក់ងារមើល និងប្រើកម្មវិធីរបស់អ្នក។ macOS ត្រូវការសិទ្ធិពីរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트가 앱을 보고 사용할 수 있게 합니다. macOS에서 권한 두 개가 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lar agenter se og bruke appene dine. macOS trenger to tillatelser for det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pozwala agentom widzieć i używać Twoich aplikacji. macOS wymaga dwóch uprawnień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite que agentes vejam e usem seus apps. O macOS precisa de duas permissões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Позволяет агентам видеть ваши приложения и работать в них. macOS нужны два разрешения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ให้เอเจนต์เห็นและใช้แอปของคุณ macOS ต้องการสิทธิ์สองอย่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajanların uygulamalarınızı görmesini ve kullanmasını sağlar. macOS bunun için iki izin ister."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дозволяє агентам бачити ваші програми й працювати в них. macOS потрібні два дозволи."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cho phép tác tử thấy và dùng ứng dụng của bạn. macOS cần hai quyền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "让代理查看并使用你的 App。macOS 需要两项权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "讓代理查看並使用你的 App。macOS 需要兩項權限。"
          }
        }
      }
    },
