    "agentPermissions.guide.drag": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag %@ into the list in System Settings, then turn it on."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اسحب %@ إلى القائمة في إعدادات النظام، ثم فعّله."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prevucite %@ na listu u Postavkama sistema, pa ga uključite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Træk %@ ind på listen i Systemindstillinger, og slå det til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zieh %@ in die Liste in den Systemeinstellungen und schalte es ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arrastra %@ a la lista en Ajustes del Sistema y actívalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faites glisser %@ dans la liste des Réglages Système, puis activez-le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trascina %@ nell’elenco in Impostazioni di Sistema, poi attivalo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ をシステム設定のリストにドラッグして、オンにしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អូស %@ ទៅក្នុងបញ្ជីក្នុង System Settings រួចបើកវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@을(를) 시스템 설정 목록으로 드래그한 다음 켜세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dra %@ inn i listen i Systeminnstillinger, og slå det på."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przeciągnij %@ na listę w Ustawieniach systemowych i włącz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arraste %@ para a lista em Ajustes do Sistema e ative-o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перетащите %@ в список в Системных настройках и включите."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลาก %@ ไปยังรายการในการตั้งค่าระบบ แล้วเปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ öğesini Sistem Ayarları’ndaki listeye sürükleyip açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перетягніть %@ у список у Системних параметрах і ввімкніть."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kéo %@ vào danh sách trong Cài đặt hệ thống, rồi bật lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将 %@ 拖到“系统设置”的列表中，然后打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "將 %@ 拖到「系統設定」的列表中，然後開啟。"
          }
        }
      }
    },
