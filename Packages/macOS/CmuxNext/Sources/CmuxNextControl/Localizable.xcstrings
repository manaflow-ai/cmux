{
  "sourceLanguage": "en",
  "strings": {
    "control.error.authRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication required. Send auth <password> first."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "المصادقة مطلوبة. أرسل auth <password> أولًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Potrebna je autentifikacija. Prvo pošaljite auth <password>."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Godkendelse påkrævet. Send først auth <password>."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Authentifizierung erforderlich. Sende zuerst auth <password>."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se requiere autenticación. Envía primero auth <password>."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Authentification requise. Envoyez d'abord auth <password>."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autenticazione richiesta. Invia prima auth <password>."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "認証が必要です。最初に auth <password> を送信してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ត្រូវការការផ្ទៀងផ្ទាត់។ សូមផ្ញើ auth <password> ជាមុនសិន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "인증이 필요합니다. 먼저 auth <password>를 보내세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autentisering kreves. Send auth <password> først."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wymagane uwierzytelnienie. Najpierw wyślij auth <password>."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autenticação necessária. Envie auth <password> primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Требуется аутентификация. Сначала отправьте auth <password>."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ต้องยืนยันตัวตน ส่ง auth <password> ก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kimlik doğrulama gerekli. Önce auth <password> gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Потрібна автентифікація. Спершу надішліть auth <password>."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yêu cầu xác thực. Hãy gửi auth <password> trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "需要认证。请先发送 auth <password>。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "需要驗證。請先傳送 auth <password>。"
          }
        }
      }
    },
