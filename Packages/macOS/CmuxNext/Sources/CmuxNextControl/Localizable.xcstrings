    "control.error.batchMemberPerOp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ applies to the whole action.batch, not to one op"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ينطبق %@ على action.batch بالكامل، وليس على عملية واحدة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ se odnosi na cijeli action.batch, ne na jednu operaciju"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ gælder hele action.batch, ikke én handling"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ gilt für den ganzen action.batch, nicht für eine Operation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ se aplica a todo el action.batch, no a una operación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ s’applique à tout l’action.batch, pas à une seule opération"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ si applica all’intero action.batch, non a una singola operazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ は action.batch 全体に指定します。1 つの操作には指定できません"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ អនុវត្តចំពោះ action.batch ទាំងមូល មិនមែនចំពោះប្រតិបត្តិការមួយទេ"
          }
        },
        "ko": {
