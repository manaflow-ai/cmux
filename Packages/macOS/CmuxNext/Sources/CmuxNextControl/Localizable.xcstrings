            "value": "%@은(는) 작업 하나가 아니라 action.batch 전체에 적용됩니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ gjelder hele action.batch, ikke én operasjon"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ dotyczy całego action.batch, a nie jednej operacji"
          }
