    "control.error.scrollOffsetNumber": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "params.%@ must be a finite number of pixels"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تكون params.%@ عددًا محدودًا من البكسلات"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "params.%@ mora biti konačan broj piksela"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "params.%@ skal være et endeligt antal pixel"
          }
        },
        "de": {
          "stringUnit": {
