          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La scheda non mostra una pagina http(s), quindi la cancellazione non ha un sito a cui limitarsi; apri prima il sito"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "タブに http(s) ページが表示されていないため、消去の対象とするサイトがありません。先にサイトを開いてください"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទាំងមិនបង្ហាញទំព័រ http(s) ទេ ដូច្នេះការសម្អាតគ្មានគេហទំព័រដើម្បីកំណត់វិសាលភាព; សូមបើកគេហទំព័រជាមុនសិន"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "탭에 http(s) 페이지가 없어 지울 사이트 범위를 정할 수 없습니다. 먼저 사이트를 여세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fanen viser ingen http(s)-side, så tømmingen har ikke noe nettsted å avgrense til; åpne nettstedet først"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Karta nie wyświetla strony http(s), więc czyszczenie nie ma witryny, do której można je ograniczyć; najpierw otwórz witrynę"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A aba não mostra uma página http(s), então a limpeza não tem um site ao qual se limitar; abra o site primeiro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Во вкладке нет страницы http(s), поэтому очистку не к чему ограничить; сначала откройте сайт"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แท็บไม่ได้แสดงหน้า http(s) จึงไม่มีเว็บไซต์ให้จำกัดขอบเขตการล้าง ให้เปิดเว็บไซต์ก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sekme bir http(s) sayfası göstermiyor, bu yüzden temizlemenin sınırlanacağı bir site yok; önce siteyi açın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вкладка не показує сторінку http(s), тому очищення немає до якого сайту обмежити; спочатку відкрийте сайт"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tab không hiển thị trang http(s) nên việc xóa không có trang web để giới hạn; hãy mở trang web trước"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "该标签页没有显示 http(s) 页面，因此清除没有可限定的网站；请先打开该网站"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "該分頁沒有顯示 http(s) 頁面，因此清除沒有可限定的網站；請先開啟該網站"
          }
        }
      }
    },
    "control.error.cookiePayload": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each cookie needs a name and a value, and a url, a domain or a tab with a page"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحتاج كل ملف تعريف ارتباط إلى اسم وقيمة، وإلى عنوان URL أو نطاق أو علامة تبويب بها صفحة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svaki kolačić treba ime i vrijednost, te URL, domenu ili karticu sa stranicom"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hver cookie skal have et navn og en værdi samt en URL, et domæne eller en fane med en side"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jedes Cookie braucht einen Namen und einen Wert sowie eine URL, eine Domain oder einen Tab mit einer Seite"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada cookie necesita un nombre y un valor, y una URL, un dominio o una pestaña con una página"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque cookie nécessite un nom et une valeur, ainsi qu’une URL, un domaine ou un onglet avec une page"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ogni cookie richiede un nome e un valore, e un URL, un dominio o una scheda con una pagina"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "各 Cookie には名前と値、さらに URL、ドメイン、またはページのあるタブが必要です"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ខូគីនីមួយៗត្រូវការឈ្មោះ និងតម្លៃ ព្រមទាំង URL ដែន ឬផ្ទាំងដែលមានទំព័រ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "각 쿠키에는 이름과 값, 그리고 URL, 도메인 또는 페이지가 있는 탭이 필요합니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hver informasjonskapsel trenger et navn og en verdi, og en URL, et domene eller en fane med en side"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Każdy plik cookie wymaga nazwy i wartości oraz adresu URL, domeny lub karty ze stroną"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada cookie precisa de um nome e um valor, e de uma URL, um domínio ou uma aba com uma página"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Каждому cookie нужны имя и значение, а также URL, домен или вкладка со страницей"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คุกกี้แต่ละรายการต้องมีชื่อและค่า และมี URL โดเมน หรือแท็บที่มีหน้าเว็บ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her çerezin bir adı ve değeri, ayrıca bir URL'si, alan adı veya sayfası olan bir sekmesi olmalıdır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кожному cookie потрібні ім’я та значення, а також URL, домен або вкладка зі сторінкою"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mỗi cookie cần có tên và giá trị, cùng với URL, tên miền hoặc một tab có trang"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每个 Cookie 都需要名称和值,以及 URL、域名或带有页面的标签页"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每個 Cookie 都需要名稱和值,以及 URL、網域或含有頁面的分頁"
          }
        }
      }
    },
    "control.error.cookieUnsafe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookie names, values and paths cannot contain ';', line breaks or control characters"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن تحتوي أسماء ملفات تعريف الارتباط وقيمها ومساراتها على ';' أو فواصل أسطر أو أحرف تحكم"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazivi, vrijednosti i putanje kolačića ne mogu sadržavati ';', prijelome redova ni kontrolne znakove"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookienavne, -værdier og -stier må ikke indeholde ';', linjeskift eller kontroltegn"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookie-Namen, -Werte und -Pfade dürfen kein ';', keine Zeilenumbrüche und keine Steuerzeichen enthalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres, valores y rutas de las cookies no pueden contener ';', saltos de línea ni caracteres de control"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms, valeurs et chemins des cookies ne peuvent pas contenir « ; », de sauts de ligne ni de caractères de contrôle"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomi, valori e percorsi dei cookie non possono contenere ';', interruzioni di riga o caratteri di controllo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookie の名前、値、パスには ';'、改行、制御文字を含められません"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឈ្មោះ តម្លៃ និងផ្លូវរបស់ cookie មិនអាចមាន ';' ការចុះបន្ទាត់ ឬតួអក្សរបញ្ជាបានទេ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쿠키 이름, 값, 경로에는 ';', 줄바꿈, 제어 문자를 넣을 수 없습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Navn, verdier og stier for informasjonskapsler kan ikke inneholde ';', linjeskift eller kontrolltegn"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwy, wartości i ścieżki ciasteczek nie mogą zawierać ';', podziałów wiersza ani znaków sterujących"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomes, valores e caminhos de cookies não podem conter ';', quebras de linha nem caracteres de controle"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имена, значения и пути cookie не могут содержать ';', переводы строк или управляющие символы"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อ ค่า และพาธของคุกกี้ต้องไม่มี ';' การขึ้นบรรทัดใหม่ หรืออักขระควบคุม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çerez adları, değerleri ve yolları ';', satır sonu veya denetim karakteri içeremez"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імена, значення та шляхи cookie не можуть містити ';', розриви рядків або керівні символи"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên, giá trị và đường dẫn cookie không được chứa ';', ký tự xuống dòng hoặc ký tự điều khiển"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookie 的名称、值和路径不能包含 ';'、换行符或控制字符"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookie 的名稱、值和路徑不能包含 ';'、換行字元或控制字元"
          }
        }
      }
    },
    "control.error.cookieExpired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An expired cookie would delete a cookie; use browser.page.cookies.clear instead"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
