        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bilinmeyen yöntem %1$@. Bu uygulamadan daha eski (veya başka bir cmux uygulamasına ait) bir cmux CLI, bu uygulamada olmayan yöntemler gönderir; bu uygulamanın CLI'ı %2$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Невідомий метод %1$@. cmux CLI, старіший за цей застосунок (або з іншого застосунку cmux), надсилає методи, яких цей застосунок не має; CLI цього застосунку: %2$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Phương thức không xác định %1$@. cmux CLI cũ hơn ứng dụng này (hoặc từ một ứng dụng cmux khác) gửi các phương thức mà ứng dụng này không có; CLI của ứng dụng này là %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
