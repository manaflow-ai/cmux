    "control.error.notEditable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The focused element takes no text; focus a text field first"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العنصر المحدد لا يقبل نصًا؛ ركّز على حقل نص أولًا"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokusirani element ne prima tekst; prvo fokusirajte tekstualno polje"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det fokuserede element tager ikke tekst; fokuser først et tekstfelt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das fokussierte Element nimmt keinen Text an; fokussiere zuerst ein Textfeld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El elemento enfocado no admite texto; enfoca primero un campo de texto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’élément actif n’accepte pas de texte ; activez d’abord un champ de texte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’elemento attivo non accetta testo; attiva prima un campo di testo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカスされている要素はテキストを受け付けません。先にテキストフィールドにフォーカスしてください"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ធាតុដែលកំពុងផ្ដោតមិនទទួលអត្ថបទទេ; សូមផ្ដោតលើប្រអប់អត្ថបទជាមុន"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스된 요소는 텍스트를 받지 않습니다. 먼저 텍스트 필드에 포커스하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementet i fokus tar ikke tekst; fokuser et tekstfelt først"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Element z fokusem nie przyjmuje tekstu; najpierw ustaw fokus na polu tekstowym"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O elemento em foco não aceita texto; foque um campo de texto primeiro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Элемент в фокусе не принимает текст; сначала переведите фокус на текстовое поле"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "องค์ประกอบที่โฟกัสอยู่ไม่รับข้อความ โปรดโฟกัสช่องข้อความก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaklanan öğe metin almıyor; önce bir metin alanına odaklanın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Елемент у фокусі не приймає текст; спочатку наведіть фокус на текстове поле"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phần tử đang được chọn không nhận văn bản; hãy chọn một ô văn bản trước"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前聚焦的元素不接受文本；请先聚焦一个文本框"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前聚焦的元素不接受文字；請先聚焦一個文字欄位"
          }
        }
      }
