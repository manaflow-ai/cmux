    "control.error.cookiesClearNoSite": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab shows no http(s) page, so a clear has no site to scope to; open the site first"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا تعرض علامة التبويب صفحة http(s)، لذا لا يوجد موقع يقتصر عليه المسح؛ افتح الموقع أولًا"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kartica ne prikazuje http(s) stranicu, pa brisanje nema stranicu na koju bi se ograničilo; prvo otvorite stranicu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fanen viser ingen http(s)-side, så en rydning har intet websted at afgrænse til; åbn webstedet først"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Tab zeigt keine http(s)-Seite, daher hat das Löschen keine Website als Bereich; öffne zuerst die Website"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La pestaña no muestra una página http(s), así que el borrado no tiene un sitio al que limitarse; abre primero el sitio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
