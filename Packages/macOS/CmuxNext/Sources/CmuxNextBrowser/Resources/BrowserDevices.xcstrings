    "browserDevices.fit.explain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page lays out as a desktop and is scaled to fit this pane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページをデスクトップとしてレイアウトし、このペインに合わせて縮小しています。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُخطَّط الصفحة كسطح مكتب وتُصغَّر لتلائم هذا الجزء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stranica se raspoređuje kao desktop i skalira da stane u ovo okno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Siden opsættes som et skrivebord og skaleres, så den passer i denne rude."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Seite wird wie auf einem Desktop gesetzt und auf diesen Bereich skaliert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La página se maqueta como escritorio y se escala para caber en este panel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La page est mise en page comme sur un bureau et réduite pour tenir dans ce volet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La pagina viene impaginata come desktop e scalata per stare in questo riquadro."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ទំព័រត្រូវបានរៀបចំដូចផ្ទៃតុ ហើយបង្រួមឲ្យសមនឹងផ្ទាំងនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "페이지를 데스크톱처럼 배치하고 이 패널에 맞게 축소합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Siden settes opp som et skrivebord og skaleres for å passe i denne ruten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Strona jest układana jak na pulpicie i skalowana do tego panelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A página é diagramada como desktop e reduzida para caber neste painel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Страница вёрстается как на рабочем столе и масштабируется под эту панель."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หน้าเว็บจัดวางแบบเดสก์ท็อปและย่อให้พอดีกับบานหน้าต่างนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sayfa masaüstü gibi yerleşir ve bu bölmeye sığacak şekilde ölçeklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сторінка верстається як на робочому столі й масштабується під цю панель."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trang được bố cục như màn hình máy tính và thu nhỏ cho vừa ngăn này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "页面按桌面布局并缩放以适应此窗格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "頁面以桌面版面配置並縮放以符合此窗格。"
          }
        }
      }
    },
