    "browser.certificate.details": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux could not confirm that this server is %1$@. %2$@ Proceed only if you know this server, for example a test server on your own network."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux はこのサーバが %1$@ であることを確認できませんでした。%2$@ 自分のネットワーク上のテストサーバなど、よく知っているサーバの場合にのみ進んでください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّر على cmux التأكد من أن هذا الخادم هو %1$@. %2$@ تابع فقط إذا كنت تعرف هذا الخادم، مثل خادم اختبار على شبكتك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux nije mogao potvrditi da je ovaj server %1$@. %2$@ Nastavite samo ako poznajete ovaj server, npr. testni server na vašoj mreži."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux kunne ikke bekræfte, at denne server er %1$@. %2$@ Fortsæt kun, hvis du kender serveren, f.eks. en testserver på dit eget netværk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux konnte nicht bestätigen, dass dieser Server %1$@ ist. %2$@ Fahre nur fort, wenn du diesen Server kennst, zum Beispiel einen Testserver in deinem eigenen Netzwerk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux no pudo confirmar que este servidor sea %1$@. %2$@ Continúa solo si conoces este servidor, por ejemplo un servidor de pruebas en tu propia red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux n’a pas pu confirmer que ce serveur est %1$@. %2$@ Ne continuez que si vous connaissez ce serveur, par exemple un serveur de test sur votre propre réseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux non ha potuto confermare che questo server sia %1$@. %2$@ Procedi solo se conosci questo server, ad esempio un server di prova sulla tua rete."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux មិនអាចបញ្ជាក់ថាម៉ាស៊ីនមេនេះគឺ %1$@ ទេ។ %2$@ បន្តតែនៅពេលអ្នកស្គាល់ម៉ាស៊ីនមេនេះ ឧទាហរណ៍ ម៉ាស៊ីនមេសាកល្បងនៅលើបណ្ដាញរបស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux가 이 서버가 %1$@인지 확인할 수 없습니다. %2$@ 자신의 네트워크에 있는 테스트 서버처럼 잘 아는 서버인 경우에만 계속하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux kunne ikke bekrefte at denne serveren er %1$@. %2$@ Fortsett bare hvis du kjenner serveren, for eksempel en testserver på ditt eget nettverk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux nie mógł potwierdzić, że ten serwer to %1$@. %2$@ Kontynuuj tylko, jeśli znasz ten serwer, na przykład serwer testowy w Twojej sieci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cmux não conseguiu confirmar que este servidor é %1$@. %2$@ Continue somente se você conhece este servidor, por exemplo um servidor de teste na sua própria rede."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux не удалось подтвердить, что этот сервер — %1$@. %2$@ Продолжайте, только если вы знаете этот сервер, например тестовый сервер в вашей сети."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux ไม่สามารถยืนยันได้ว่าเซิร์ฟเวอร์นี้คือ %1$@ %2$@ ดำเนินการต่อเฉพาะเมื่อคุณรู้จักเซิร์ฟเวอร์นี้ เช่น เซิร์ฟเวอร์ทดสอบในเครือข่ายของคุณเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux bu sunucunun %1$@ olduğunu doğrulayamadı. %2$@ Yalnızca bu sunucuyu tanıyorsanız devam edin; örneğin kendi ağınızdaki bir test sunucusu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux не вдалося підтвердити, що цей сервер — %1$@. %2$@ Продовжуйте, лише якщо знаєте цей сервер, наприклад тестовий сервер у вашій мережі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux không thể xác nhận máy chủ này là %1$@. %2$@ Chỉ tiếp tục nếu bạn biết máy chủ này, ví dụ máy chủ thử nghiệm trên mạng của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 无法确认此服务器是 %1$@。%2$@ 仅当你了解此服务器（例如你自己网络上的测试服务器）时才继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 無法確認此伺服器是 %1$@。%2$@ 僅當你了解此伺服器（例如你自己網路上的測試伺服器）時才繼續。"
          }
        }
      }
    },
