        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il motore Chromium non è disponibile in questa build."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ម៉ាស៊ីន Chromium មិនមានក្នុងកំណែនេះទេ។"
