    "browser.certificate.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uses a certificate this Mac does not trust. Someone may be trying to read or change what you send to it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はこの Mac が信頼していない証明書を使用しています。送信する内容が第三者に読み取られたり変更されたりする可能性があります。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يستخدم %@ شهادة لا يثق بها هذا الـ Mac. قد يحاول شخص ما قراءة ما ترسله إليه أو تغييره."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ koristi certifikat kojem ovaj Mac ne vjeruje. Neko možda pokušava čitati ili mijenjati ono što šaljete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ bruger et certifikat, som denne Mac ikke har tillid til. Nogen forsøger måske at læse eller ændre det, du sender."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ verwendet ein Zertifikat, dem dieser Mac nicht vertraut. Jemand könnte versuchen, das, was du sendest, mitzulesen oder zu verändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ usa un certificado en el que este Mac no confía. Alguien podría intentar leer o cambiar lo que envías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ utilise un certificat auquel ce Mac ne fait pas confiance. Quelqu'un essaie peut-être de lire ou de modifier ce que vous envoyez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ usa un certificato di cui questo Mac non si fida. Qualcuno potrebbe tentare di leggere o modificare ciò che invii."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ប្រើវិញ្ញាបនបត្រដែល Mac នេះមិនទុកចិត្ត។ អ្នកណាម្នាក់ប្រហែលជាកំពុងព្យាយាមអាន ឬផ្លាស់ប្ដូរអ្វីដែលអ្នកផ្ញើ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@에서 이 Mac이 신뢰하지 않는 인증서를 사용합니다. 누군가 사용자가 보내는 내용을 읽거나 변경하려고 할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ bruker et sertifikat denne Macen ikke stoler på. Noen prøver kanskje å lese eller endre det du sender."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ używa certyfikatu, któremu ten Mac nie ufa. Ktoś może próbować odczytać lub zmienić to, co wysyłasz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ usa um certificado no qual este Mac não confia. Alguém pode estar tentando ler ou alterar o que você envia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ использует сертификат, которому этот Mac не доверяет. Кто-то может пытаться прочитать или изменить отправляемые данные."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ใช้ใบรับรองที่ Mac เครื่องนี้ไม่เชื่อถือ อาจมีผู้พยายามอ่านหรือเปลี่ยนแปลงสิ่งที่คุณส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@, bu Mac'in güvenmediği bir sertifika kullanıyor. Birisi gönderdiklerinizi okumaya veya değiştirmeye çalışıyor olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ використовує сертифікат, якому цей Mac не довіряє. Хтось може намагатися прочитати або змінити те, що ви надсилаєте."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
