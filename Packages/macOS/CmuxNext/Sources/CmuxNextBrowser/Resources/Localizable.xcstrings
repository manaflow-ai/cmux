    "browser.download.blockedDeclined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocked: you chose to block multiple downloads from this site."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックしました: このサイトからの複数のダウンロードをブロックしました。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تم الحظر: اخترت حظر التنزيلات المتعددة من هذا الموقع."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blokirano: odabrali ste blokiranje više preuzimanja s ove stranice."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blokeret: du valgte at blokere flere downloads fra dette websted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blockiert: Sie haben mehrere Downloads von dieser Website blockiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloqueado: elegiste bloquear varias descargas de este sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloqué : vous avez choisi de bloquer les téléchargements multiples de ce site."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloccato: hai scelto di bloccare i download multipli da questo sito."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បានទប់ស្កាត់៖ អ្នកបានជ្រើសរើសទប់ស្កាត់ការទាញយកច្រើនពីគេហទំព័រនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "차단됨: 이 사이트의 여러 파일 다운로드를 차단하도록 선택했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blokkert: du valgte å blokkere flere nedlastinger fra dette nettstedet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zablokowano: wybrano blokowanie wielu pobrań z tej witryny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloqueado: você escolheu bloquear vários downloads deste site."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Заблокировано: вы запретили этому сайту скачивать несколько файлов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ถูกบล็อก: คุณเลือกบล็อกการดาวน์โหลดหลายไฟล์จากไซต์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Engellendi: bu siteden birden fazla indirmeyi engellemeyi seçtiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Заблоковано: ви заблокували завантаження кількох файлів із цього сайту."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã chặn: bạn đã chọn chặn tải xuống nhiều tệp từ trang này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已阻止：你选择阻止此网站下载多个文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已封鎖：你選擇封鎖此網站下載多個檔案。"
          }
        }
      }
    },
    "browser.download.blockedUnanswered": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocked: cmux could not ask whether this site may download multiple files."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックしました: このサイトが複数のファイルをダウンロードしてよいか確認できませんでした。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تم الحظر: تعذّر على cmux السؤال عمّا إذا كان يمكن لهذا الموقع تنزيل ملفات متعددة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blokirano: cmux nije mogao pitati smije li ova stranica preuzeti više datoteka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blokeret: cmux kunne ikke spørge, om dette websted må downloade flere filer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blockiert: cmux konnte nicht fragen, ob diese Website mehrere Dateien herunterladen darf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloqueado: cmux no pudo preguntar si este sitio puede descargar varios archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloqué : cmux n’a pas pu demander si ce site peut télécharger plusieurs fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloccato: cmux non ha potuto chiedere se questo sito può scaricare più file."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បានទប់ស្កាត់៖ cmux មិនអាចសួរថាតើគេហទំព័រនេះអាចទាញយកឯកសារច្រើនបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "차단됨: cmux가 이 사이트의 여러 파일 다운로드 허용 여부를 물을 수 없었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blokkert: cmux kunne ikke spørre om dette nettstedet kan laste ned flere filer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zablokowano: cmux nie mógł zapytać, czy ta witryna może pobrać wiele plików."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloqueado: o cmux não pôde perguntar se este site pode baixar vários arquivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Заблокировано: cmux не смог спросить, можно ли этому сайту скачивать несколько файлов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ถูกบล็อก: cmux ไม่สามารถถามได้ว่าไซต์นี้ดาวน์โหลดหลายไฟล์ได้หรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Engellendi: cmux bu sitenin birden fazla dosya indirip indiremeyeceğini soramadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Заблоковано: cmux не зміг запитати, чи може цей сайт завантажувати кілька файлів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã chặn: cmux không thể hỏi liệu trang này có được tải xuống nhiều tệp hay không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已阻止：cmux 无法询问此网站是否可以下载多个文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已封鎖：cmux 無法詢問此網站是否可以下載多個檔案。"
          }
        }
      }
    },
