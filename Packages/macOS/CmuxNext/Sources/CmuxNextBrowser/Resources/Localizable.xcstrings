    "browser.screenshotSection.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to capture a section. Press Esc to cancel."
          }
        },
        "ar": {
