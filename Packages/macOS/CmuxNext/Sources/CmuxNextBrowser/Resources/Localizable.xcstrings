    "browser.engine.cefUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Chromium engine is not available in this build."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドでは Chromium エンジンを使用できません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "محرك Chromium غير متوفر في هذا البناء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium pogon nije dostupan u ovoj verziji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium-motoren er ikke tilgængelig i denne build."
