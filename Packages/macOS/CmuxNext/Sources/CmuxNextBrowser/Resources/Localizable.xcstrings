    "browser.pageUnresponsive.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can wait for it to respond or exit the page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "応答を待つか、ページを終了できます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكنك انتظار استجابتها أو الخروج من الصفحة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Možete sačekati da reaguje ili napustiti stranicu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du kan vente på, at den svarer, eller forlade siden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sie können warten, bis sie reagiert, oder die Seite verlassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puedes esperar a que responda o salir de la página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous pouvez attendre qu’elle réponde ou quitter la page."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puoi attendere che risponda o uscire dalla pagina."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អ្នកអាចរង់ចាំឱ្យវាឆ្លើយតប ឬចាកចេញពីទំព័រ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "응답을 기다리거나 페이지를 나갈 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du kan vente på at den svarer, eller forlate siden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Możesz poczekać na odpowiedź lub zamknąć stronę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você pode esperar que ela responda ou sair da página."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Можно подождать ответа или закрыть страницу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คุณสามารถรอให้หน้าตอบสนองหรือออกจากหน้านี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yanıt vermesini bekleyebilir veya sayfadan çıkabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Можна зачекати на відповідь або закрити сторінку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bạn có thể chờ trang phản hồi hoặc thoát khỏi trang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
