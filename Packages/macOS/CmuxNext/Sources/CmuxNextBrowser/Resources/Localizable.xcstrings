    "browser.error.processTerminated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page stopped responding. Reload to try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページが応答しなくなりました。再読み込みしてください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "توقفت هذه الصفحة عن الاستجابة. أعد التحميل للمحاولة مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ova stranica je prestala reagovati. Ponovo učitajte da pokušate opet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Siden holdt op med at svare. Genindlæs for at prøve igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Seite reagiert nicht mehr. Laden Sie sie neu, um es erneut zu versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta página dejó de responder. Recárgala para volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette page ne répond plus. Rechargez-la pour réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questa pagina ha smesso di rispondere. Ricarica per riprovare."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ទំព័រនេះឈប់ឆ្លើយតប។ សូមផ្ទុកឡើងវិញដើម្បីព្យាយាមម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 페이지가 응답하지 않습니다. 새로고침하여 다시 시도하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne siden sluttet å svare. Last inn på nytt for å prøve igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ta strona przestała odpowiadać. Wczytaj ją ponownie, aby spróbować jeszcze raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta página parou de responder. Recarregue para tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Страница перестала отвечать. Перезагрузите ее, чтобы повторить попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หน้านี้หยุดตอบสนอง โหลดใหม่เพื่อลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu sayfa yanıt vermiyor. Tekrar denemek için yeniden yükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сторінка перестала відповідати. Перезавантажте, щоб спробувати ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trang này đã ngừng phản hồi. Tải lại để thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此页面已停止响应。请重新加载以重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此頁面已停止回應。請重新載入再試一次。"
          }
        }
      }
    },
