    "browser.extensionPrompt.added": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” was added. Pin it from the Extensions menu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تمت إضافة “%@”. ثبّتها من قائمة الإضافات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” je dodano. Zakačite ga iz menija Proširenja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” er tilføjet. Fastgør den fra menuen Udvidelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%@“ wurde hinzugefügt. Heften Sie es im Menü „Erweiterungen“ an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se añadió “%@”. Fíjala desde el menú Extensiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "« %@ » a été ajoutée. Épinglez-la depuis le menu Extensions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” è stata aggiunta. Fissala dal menu Estensioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「%@」を追加しました。拡張機能メニューから固定できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បានបន្ថែម “%@”។ ខ្ទាស់វាពីម៉ឺនុយផ្នែកបន្ថែម។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”이(가) 추가되었습니다. 확장 프로그램 메뉴에서 고정하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%@» ble lagt til. Fest den fra Utvidelser-menyen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dodano „%@”. Przypnij je w menu Rozszerzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” foi adicionada. Fixe-a no menu Extensões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%@» добавлено. Закрепите его в меню «Расширения»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เพิ่ม “%@” แล้ว ปักหมุดได้จากเมนูส่วนขยาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” eklendi. Uzantılar menüsünden sabitleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%@» додано. Закріпіть його в меню «Розширення»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã thêm “%@”. Ghim tiện ích từ menu Tiện ích."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已添加“%@”。可在扩展程序菜单中固定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已新增「%@」。可從擴充功能選單固定。"
          }
        }
      }
    },
