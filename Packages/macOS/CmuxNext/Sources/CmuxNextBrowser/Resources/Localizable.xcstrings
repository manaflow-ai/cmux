        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour capturer une zone. Appuyez sur Échap pour annuler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per catturare una sezione. Premi Esc per annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして範囲をキャプチャします。Escでキャンセルします。"
