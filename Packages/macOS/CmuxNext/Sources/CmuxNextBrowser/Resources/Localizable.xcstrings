    "browser.pageGone.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other tabs are not affected. Reload to open the page again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ほかのタブには影響ありません。再読み込みするとページをもう一度開きます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم تتأثر علامات التبويب الأخرى. أعد التحميل لفتح الصفحة مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ostale kartice nisu pogođene. Ponovo učitajte da biste ponovo otvorili stranicu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Andre faner er ikke berørt. Genindlæs for at åbne siden igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Andere Tabs sind nicht betroffen. Laden Sie die Seite neu, um sie wieder zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las demás pestañas no se ven afectadas. Vuelve a cargar para abrir la página de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les autres onglets ne sont pas concernés. Actualisez pour rouvrir la page."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le altre schede non sono interessate. Ricarica per riaprire la pagina."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទាំងផ្សេងទៀតមិនរងផលប៉ះពាល់ទេ។ ផ្ទុកឡើងវិញដើម្បីបើកទំព័រម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다른 탭에는 영향이 없습니다. 새로고침하여 페이지를 다시 여세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Andre faner er ikke berørt. Last inn på nytt for å åpne siden igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pozostałe karty działają normalnie. Załaduj ponownie, aby otworzyć stronę jeszcze raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As outras abas não foram afetadas. Recarregue para abrir a página de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Другие вкладки не затронуты. Перезагрузите, чтобы снова открыть страницу."
