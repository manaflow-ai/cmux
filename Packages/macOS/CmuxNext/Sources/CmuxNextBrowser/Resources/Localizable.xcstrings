        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អូសដើម្បីថតផ្នែកមួយ។ ចុច Esc ដើម្បីបោះបង់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 영역을 캡처하세요. 취소하려면 Esc를 누르세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra for å ta et utsnitt. Trykk på Esc for å avbryte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby przechwycić fragment. Naciśnij Esc, aby anulować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para capturar uma seção. Pressione Esc para cancelar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите, чтобы снять область. Нажмите Esc для отмены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากเพื่อจับภาพบางส่วน กด Esc เพื่อยกเลิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bölümü yakalamak için sürükleyin. İptal etmek için Esc tuşuna basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
