    "browser.beforeUnload.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes that you made may not be saved."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد لا يتم حفظ التغييرات التي أجريتها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Promjene koje ste napravili možda neće biti sačuvane."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine ændringer gemmes muligvis ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Änderungen werden möglicherweise nicht gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que no se guarden los cambios que has hecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications que vous avez apportées ne seront peut-être pas enregistrées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche apportate potrebbero non essere salvate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行った変更が保存されない可能性があります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការផ្លាស់ប្ដូរដែលអ្នកបានធ្វើប្រហែលជាមិនត្រូវបានរក្សាទុកទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경사항이 저장되지 않을 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endringene du har gjort, blir kanskje ikke lagret."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadzone zmiany mogą nie zostać zapisane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações feitas talvez não sejam salvas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможно, внесенные изменения не сохранятся."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบบอาจไม่บันทึกการเปลี่ยนแปลงที่คุณทำไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaptığınız değişiklikler kaydedilmeyebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Внесені зміни можуть не зберегтися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thay đổi bạn đã thực hiện có thể không được lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
