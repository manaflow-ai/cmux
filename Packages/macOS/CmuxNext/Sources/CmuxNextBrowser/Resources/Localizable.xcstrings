          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åbn en agentchat i dette arbejdsområde for at sende designmarkeringer til den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öffne einen Agent-Chat in diesem Workspace, um Design-Markierungen dorthin zu senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abre un chat de agente en este espacio de trabajo para enviarle los elementos de diseño resaltados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ouvrez une discussion avec un agent dans cet espace de travail pour lui envoyer les éléments de design surlignés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apri una chat con un agente in questo spazio di lavoro per inviargli gli elementi di design evidenziati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "デザインのハイライトを送るには、このワークスペースでエージェントのチャットを開いてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បើកការជជែកភ្នាក់ងារក្នុងកន្លែងធ្វើការនេះ ដើម្បីផ្ញើការរំលេចរចនាទៅវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "디자인 하이라이트를 보내려면 이 작업 공간에서 에이전트 채팅을 여세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åpne en agentchat i dette arbeidsområdet for å sende designmarkeringer til den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otwórz czat z agentem w tym obszarze roboczym, aby wysłać do niego zaznaczenia projektu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra um chat de agente neste espaço de trabalho para enviar os destaques de design para ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Откройте чат с агентом в этом рабочем пространстве, чтобы отправлять ему выделенные элементы дизайна."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิดแชทเอเจนต์ในพื้นที่ทำงานนี้เพื่อส่งส่วนที่ไฮไลต์ของดีไซน์ไปให้"
