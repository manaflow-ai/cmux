    "browser.designMode.noAgentChat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open an agent chat in this workspace to send design highlights to it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
