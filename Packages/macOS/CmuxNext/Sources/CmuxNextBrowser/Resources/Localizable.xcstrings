    "browser.toolbar.devTools.needsChromium": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Tools need this tab's Chromium page to be running"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Entwicklertools benötigen die laufende Chromium-Seite dieses Tabs"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils de développement nécessitent que la page Chromium de cet onglet soit en cours d’exécution"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب أدوات المطور تشغيل صفحة Chromium في علامة التبويب هذه"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las herramientas para desarrolladores necesitan que la página de Chromium de esta pestaña esté en ejecución"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開發者工具需要此分頁的 Chromium 頁面正在執行"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发者工具需要此标签页的 Chromium 页面正在运行"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발자 도구를 사용하려면 이 탭의 Chromium 페이지가 실행 중이어야 합니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デベロッパツールを使うには、このタブの Chromium ページが実行中である必要があります"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alati za programere zahtijevaju da Chromium stranica ove kartice radi"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Udviklerværktøjer kræver, at fanens Chromium-side kører"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli strumenti per sviluppatori richiedono che la pagina Chromium di questa scheda sia in esecuzione"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ឧបករណ៍អ្នកអភិវឌ្ឍន៍ត្រូវការឱ្យទំព័រ Chromium នៃផ្ទាំងនេះកំពុងដំណើរការ"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utviklerverktøy krever at fanens Chromium-side kjører"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Narzędzia deweloperskie wymagają działającej strony Chromium tej karty"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As Ferramentas de Desenvolvedor exigem que a página do Chromium desta aba esteja em execução"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для инструментов разработчика страница Chromium этой вкладки должна быть запущена"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เครื่องมือนักพัฒนาต้องให้หน้า Chromium ของแท็บนี้ทำงานอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geliştirici Araçları için bu sekmenin Chromium sayfasının çalışıyor olması gerekir"
