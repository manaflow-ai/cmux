    "browser.auth.prompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ asks for a user name and password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がユーザ名とパスワードを求めています。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يطلب %@ اسم مستخدم وكلمة مرور."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ traži korisničko ime i lozinku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ beder om et brugernavn og en adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ fragt nach einem Benutzernamen und Passwort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ solicita un nombre de usuario y una contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ demande un nom d'utilisateur et un mot de passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ richiede nome utente e password."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ស្នើសុំឈ្មោះអ្នកប្រើ និងពាក្យសម្ងាត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@에서 사용자 이름과 암호를 요청합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ber om brukernavn og passord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ prosi o nazwę użytkownika i hasło."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ solicita um nome de usuário e uma senha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ запрашивает имя пользователя и пароль."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ขอชื่อผู้ใช้และรหัสผ่าน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ bir kullanıcı adı ve parola istiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ запитує ім'я користувача та пароль."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ yêu cầu tên người dùng và mật khẩu."
