{
  "sourceLanguage": "en",
  "strings": {
    "devtools.limit.browserTabOnly": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعمل في علامات تبويب المتصفح فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Radi samo u karticama preglednika."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Virker kun i browserfaner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Funktioniert nur in Browser-Tabs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works in browser tabs only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo funciona en pestañas del navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fonctionne uniquement dans les onglets du navigateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Funziona solo nelle schede del browser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ブラウザタブでのみ使えます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ដំណើរការតែក្នុងផ្ទាំងកម្មវិធីរុករកប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "브라우저 탭에서만 작동합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fungerer bare i nettleserfaner."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Działa tylko w kartach przeglądarki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Funciona somente em abas do navegador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Работает только во вкладках браузера."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ใช้ได้เฉพาะในแท็บเบราว์เซอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yalnızca tarayıcı sekmelerinde çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Працює лише у вкладках браузера."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chỉ hoạt động trong tab trình duyệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅适用于浏览器标签页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "僅適用於瀏覽器分頁。"
          }
        }
      }
    },
    "devtools.limit.chromiumOnly": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium فقط. استخدم الفتح في Chromium لهذه الصفحة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Samo Chromium. Koristite Otvori u Chromiumu za ovu stranicu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kun Chromium. Brug Åbn i Chromium til denne side."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nur Chromium. Verwende „In Chromium öffnen“ für diese Seite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chromium only. Use Open in Chromium for this page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo Chromium. Usa Abrir en Chromium para esta página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium uniquement. Utilisez Ouvrir dans Chromium pour cette page."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo Chromium. Usa Apri in Chromium per questa pagina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium のみ。このページには「Chromium で開く」を使ってください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium តែប៉ុណ្ណោះ។ ប្រើ បើកក្នុង Chromium សម្រាប់ទំព័រនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium 전용입니다. 이 페이지에는 Chromium에서 열기를 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bare Chromium. Bruk Åpne i Chromium for denne siden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tylko Chromium. Użyj Otwórz w Chromium dla tej strony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Somente Chromium. Use Abrir no Chromium para esta página."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Только Chromium. Для этой страницы используйте «Открыть в Chromium»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium เท่านั้น ใช้เปิดใน Chromium สำหรับหน้านี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yalnızca Chromium. Bu sayfa için Chromium'da Aç'ı kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Лише Chromium. Для цієї сторінки використайте «Відкрити в Chromium»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chỉ Chromium. Hãy dùng Mở trong Chromium cho trang này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅限 Chromium。请对此页面使用“在 Chromium 中打开”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "僅限 Chromium。請對此頁面使用「在 Chromium 中開啟」。"
          }
        }
      }
    },
    "devtools.limit.noWebView": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "انقر في علامة تبويب متصفح أو عرض ويب آخر أولًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prvo kliknite u karticu preglednika ili drugi web prikaz."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klik først i en browserfane eller en anden webvisning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klicke zuerst in einen Browser-Tab oder eine andere Webansicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click in a browser tab or another web view first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Primero haz clic en una pestaña del navegador u otra vista web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cliquez d’abord dans un onglet du navigateur ou une autre vue web."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fai prima clic in una scheda del browser o in un’altra vista web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "先にブラウザタブか他の Web ビューをクリックしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ចុចក្នុងផ្ទាំងកម្មវិធីរុករក ឬទិដ្ឋភាពវេបផ្សេងទៀតជាមុនសិន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "먼저 브라우저 탭이나 다른 웹 보기를 클릭하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klikk først i en nettleserfane eller en annen nettvisning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Najpierw kliknij kartę przeglądarki lub inny widok WWW."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Primeiro clique em uma aba do navegador ou outra visualização web."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сначала нажмите во вкладке браузера или другом веб-представлении."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คลิกในแท็บเบราว์เซอร์หรือมุมมองเว็บอื่นก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Önce bir tarayıcı sekmesine veya başka bir web görünümüne tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Спочатку клацніть у вкладці браузера або іншому веб-поданні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trước tiên, hãy bấm vào một tab trình duyệt hoặc chế độ xem web khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请先点按浏览器标签页或其他网页视图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請先點按瀏覽器分頁或其他網頁顯示方式。"
          }
        }
      }
    },
    "devtools.limit.useConsoleSaveAs": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "انقر بزر الماوس الأيمن في وحدة التحكم واختر حفظ باسم."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kliknite desnim klikom u Konzoli i odaberite Spremi kao."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Højreklik i Konsol, og vælg Gem som."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klicke mit der rechten Maustaste in die Konsole und wähle „Speichern unter“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click in the Console and choose Save as."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Haz clic derecho en la Consola y elige Guardar como."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faites un clic droit dans la Console et choisissez Enregistrer sous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fai clic con il pulsante destro nella Console e scegli Salva con nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "コンソールを右クリックし、「名前を付けて保存」を選んでください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ចុចខាងស្ដាំក្នុង Console ហើយជ្រើស Save as។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "콘솔에서 마우스 오른쪽 버튼을 클릭하고 다른 이름으로 저장을 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Høyreklikk i Konsoll og velg Lagre som."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kliknij prawym przyciskiem w Konsoli i wybierz Zapisz jako."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clique com o botão direito no Console e escolha Salvar como."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Нажмите правой кнопкой в Консоли и выберите «Сохранить как»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คลิกขวาในคอนโซลแล้วเลือกบันทึกเป็น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konsol'da sağ tıklayın ve Farklı kaydet'i seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Клацніть правою кнопкою в Консолі й виберіть «Зберегти як»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bấm chuột phải trong Bảng điều khiển và chọn Lưu thành."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在控制台中右键点按并选择“另存为”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在控制台中按右鍵並選擇「另存新檔」。"
          }
        }
      }
    },
    "devtools.limit.useHeapSnapshotButton": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "افتح لوحة الذاكرة وانقر على التقاط لقطة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otvorite panel Memorija i kliknite Napravi snimak."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åbn panelet Hukommelse, og klik på Tag snapshot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öffne das Arbeitsspeicherfeld und klicke auf „Snapshot erstellen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Memory panel and click Take snapshot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abre el panel Memoria y haz clic en Tomar instantánea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ouvrez le panneau Mémoire et cliquez sur Prendre un instantané."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apri il pannello Memoria e fai clic su Acquisisci snapshot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "メモリパネルを開いて「スナップショットを撮る」をクリックしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បើកផ្ទាំង Memory ហើយចុច Take snapshot។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "메모리 패널을 열고 스냅샷 찍기를 클릭하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åpne Minne-panelet og klikk på Ta øyeblikksbilde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otwórz panel Pamięć i kliknij Zrób zrzut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra o painel Memória e clique em Criar snapshot."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Откройте панель «Память» и нажмите «Сделать снимок»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิดแผงหน่วยความจำแล้วคลิกถ่ายสแนปชอต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bellek panelini açın ve Anlık görüntü al'a tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відкрийте панель «Пам'ять» і натисніть «Зробити знімок»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mở bảng Bộ nhớ và bấm Chụp nhanh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "打开“内存”面板并点按“拍摄快照”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "開啟「記憶體」面板並點按「擷取快照」。"
          }
        }
      }
    },
    "devtools.limit.useNodeMenu": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "في العناصر، انقر بزر الماوس الأيمن على عقدة واختر التقاط لقطة شاشة للعقدة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "U Elementima kliknite desnim klikom na čvor i odaberite Snimi ekran čvora."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I Elementer skal du højreklikke på en node og vælge Tag skærmbillede af node."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klicke unter „Elemente“ mit der rechten Maustaste auf einen Knoten und wähle „Screenshot des Knotens erstellen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Elements, right-click a node and choose Capture node screenshot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En Elementos, haz clic derecho en un nodo y elige Capturar pantalla del nodo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dans Éléments, faites un clic droit sur un nœud et choisissez Faire une capture d’écran du nœud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In Elementi, fai clic con il pulsante destro su un nodo e scegli Acquisisci screenshot del nodo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "要素パネルでノードを右クリックし、「ノードのスクリーンショットをキャプチャ」を選んでください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
