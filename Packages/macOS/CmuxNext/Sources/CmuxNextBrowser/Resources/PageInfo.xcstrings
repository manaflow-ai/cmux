    "pageInfo.security.secureDetails": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your information (for example, passwords or credit card numbers) is private when it is sent to this site."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تظل معلوماتك (مثل كلمات المرور أو أرقام بطاقات الائتمان) خاصة عند إرسالها إلى هذا الموقع الإلكتروني."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vaše informacije (naprimjer, lozinke ili brojevi kreditnih kartica) su privatne kada se šalju ovoj web lokaciji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dine oplysninger (f.eks. adgangskoder eller kreditkortnumre) er private, når de sendes til dette website."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Daten, z. B. Passwörter oder Kreditkartennummern, sind privat, wenn sie an diese Website gesendet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu información (por ejemplo, contraseñas o números de tarjetas de crédito) es privada cuando se envía a este sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vos informations (par exemple, vos mots de passe ou numéros de carte de crédit) restent confidentielles lorsqu'elles sont envoyées à ce site."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le tue informazioni (ad esempio password o numeri di carte di credito) sono private quando vengono inviate a questo sito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このサイトに送信される情報（パスワード、クレジットカード番号など）は第三者から保護されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ព័ត៌មានរបស់អ្នក (ឧទាហរណ៍ ពាក្យសម្ងាត់ ឬលេខកាតឥណទាន) មានលក្ខណៈឯកជន នៅពេលវាត្រូវបានផ្ញើទៅគេហទំព័រនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 사이트로 전송되는 정보(예: 비밀번호 또는 신용카드 번호)는 비공개로 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Informasjonen din (for eksempel passord eller kredittkortnumre) er privat når den sendes til dette nettstedet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Twoje informacje (np. hasła lub numery kart kredytowych) są prywatne, gdy są wysyłane do tej witryny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Suas informações (por exemplo, senhas ou números de cartão de crédito) ficam protegidas quando são enviadas para este site."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ваши данные (например, пароли или номера банковских карт) защищены при отправке на этот сайт."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ข้อมูลของคุณ (เช่น รหัสผ่านหรือหมายเลขบัตรเครดิต) จะเป็นส่วนตัวเมื่อส่งไปยังเว็บไซต์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bilgileriniz (ör. şifreler veya kredi kartı numaraları) bu siteye gönderilirken gizli kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ваша інформація (наприклад, паролі або номери кредитних карток) залишається конфіденційною під час надсилання на цей сайт."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thông tin của bạn (ví dụ: mật khẩu hoặc số thẻ tín dụng) được giữ kín khi gửi đến trang web này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "您的信息（例如密码或信用卡号）在发送至此网站时会受到保护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的資訊 (例如密碼或信用卡號碼) 在傳送到這個網站時會受到保護。"
          }
        }
      }
    },
