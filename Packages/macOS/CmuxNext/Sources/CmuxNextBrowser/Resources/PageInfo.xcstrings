    "pageInfo.security.notSecureDetails": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You should not enter any sensitive information on this site (for example, passwords or credit cards), because it could be stolen by attackers."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يجب عدم إدخال أي معلومات حساسة على هذا الموقع الإلكتروني (مثل كلمات المرور أو بطاقات الائتمان)، لأنه يمكن أن يسرقها المهاجمون."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ne biste trebali unositi osjetljive informacije na ovoj web lokaciji (naprimjer, lozinke ili kreditne kartice) jer ih napadači mogu ukrasti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du bør ikke angive følsomme oplysninger på dette website (f.eks. adgangskoder eller kreditkort), da de kan blive stjålet af hackere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du solltest auf dieser Website keine vertraulichen Informationen wie Passwörter oder Kreditkartendaten eingeben, da sie von Angreifern gestohlen werden könnten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No deberías introducir información sensible en este sitio (por ejemplo, contraseñas o tarjetas de crédito), ya que los atacantes podrían robarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous ne devez saisir aucune information sensible sur ce site (par exemple, des mots de passe ou des numéros de carte de crédit), car elle pourrait être volée par des pirates informatiques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non dovresti inserire informazioni sensibili su questo sito (ad esempio password o carte di credito) perché potrebbero essere rubate da utenti malintenzionati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このサイトでは機密情報（パスワード、クレジットカードなど）を入力しないでください。悪意のあるユーザーに盗まれる可能性があります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អ្នកមិនគួរបញ្ចូលព័ត៌មានរសើបណាមួយនៅលើគេហទំព័រនេះទេ (ឧទាហរណ៍ ពាក្យសម្ងាត់ ឬកាតឥណទាន) ព្រោះវាអាចត្រូវបានលួចដោយអ្នកវាយប្រហារ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 사이트에 민감한 정보(예: 비밀번호 또는 신용카드)를 입력하지 마세요. 공격자가 정보를 도용할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du bør ikke oppgi sensitiv informasjon på dette nettstedet (for eksempel passord eller kredittkort), fordi den kan bli stjålet av angripere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie podawaj w tej witrynie żadnych poufnych informacji (np. haseł czy danych kart kredytowych), ponieważ mogą je wykraść atakujący."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não insira informações confidenciais neste site (por exemplo, senhas ou cartões de crédito), porque elas podem ser roubadas por invasores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не вводите на этом сайте конфиденциальные данные (например, пароли или номера банковских карт), так как их могут украсть злоумышленники."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คุณไม่ควรป้อนข้อมูลที่ละเอียดอ่อนในเว็บไซต์นี้ (เช่น รหัสผ่านหรือบัตรเครดิต) เนื่องจากผู้โจมตีอาจขโมยข้อมูลได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu sitede hassas bilgilerinizi (ör. şifreler veya kredi kartları) girmemelisiniz. Aksi takdirde bu bilgiler saldırganlar tarafından çalınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не вводьте на цьому сайті конфіденційну інформацію (наприклад, паролі або дані кредитних карток), оскільки її можуть викрасти зловмисники."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bạn không nên nhập bất kỳ thông tin nhạy cảm nào trên trang web này (ví dụ: mật khẩu hoặc thẻ tín dụng) vì những kẻ tấn công có thể đánh cắp thông tin đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请勿在此网站上输入任何敏感信息（例如密码或信用卡信息），因为攻击者可能会盗取这些信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請勿在這個網站上輸入任何機密資訊 (例如密碼或信用卡資料)，因為這類資訊可能會遭到攻擊者竊取。"
          }
        }
      }
    },
