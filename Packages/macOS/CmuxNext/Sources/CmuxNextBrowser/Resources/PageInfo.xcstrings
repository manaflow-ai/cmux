    "pageInfo.security.mixedDetails": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attackers might be able to see the images you're looking at on this site and trick you by modifying them."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قد يتمكّن المهاجمون من رؤية الصور التي تشاهدها على هذا الموقع الإلكتروني وخداعك من خلال تعديلها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Napadači bi mogli vidjeti slike koje gledate na ovoj web lokaciji i prevariti vas izmjenom tih slika."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hackere kan muligvis se de billeder, du ser på dette website, og narre dig ved at ændre dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Angreifer können möglicherweise die Bilder sehen, die du dir auf dieser Website ansiehst, und dich durch Manipulation der Bilder täuschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es posible que los atacantes puedan ver las imágenes que estás viendo en este sitio y engañarte modificándolas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Des pirates informatiques pourraient voir les images que vous consultez sur ce site et vous tromper en les modifiant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli utenti malintenzionati potrebbero riuscire a vedere le immagini che stai guardando su questo sito e ingannarti modificandole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このサイトで表示されている画像を攻撃者に見られたり、画像が改ざんされて騙されたりする可能性があります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អ្នកវាយប្រហារអាចមើលឃើញរូបភាពដែលអ្នកកំពុងមើលនៅលើគេហទំព័រនេះ ហើយបោកបញ្ឆោតអ្នកដោយកែប្រែរូបភាពទាំងនោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "공격자가 이 사이트에서 보고 있는 이미지를 확인하고 이미지를 수정하여 사용자를 속일 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Angripere kan kanskje se bildene du ser på, på dette nettstedet, og lure deg ved å endre dem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atakujący mogą widzieć obrazy, które oglądasz w tej witrynie, i wprowadzić Cię w błąd, modyfikując je."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os invasores podem ver as imagens que você está visualizando neste site e enganar você modificando-as."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Злоумышленники могут видеть изображения, которые вы просматриваете на этом сайте, и обмануть вас, изменив их."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ผู้โจมตีอาจเห็นรูปภาพที่คุณกำลังดูในเว็บไซต์นี้และหลอกคุณด้วยการแก้ไขรูปภาพเหล่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saldırganlar bu sitede baktığınız resimleri görebilir ve bunları değiştirerek sizi kandırabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Зловмисники можуть бачити зображення, які ви переглядаєте на цьому сайті, і обманювати вас, змінюючи їх."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Những kẻ tấn công có thể nhìn thấy hình ảnh bạn đang xem trên trang web này và lừa bạn bằng cách sửa đổi các hình ảnh đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "攻击者可能会看到您在此网站上查看的图片，并通过修改这些图片欺骗您。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "攻擊者或許能看見你在這個網站上查看的圖片，並透過修改圖片來誘騙你。"
          }
        }
      }
    },
