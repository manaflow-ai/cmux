    "pageInfo.cookies.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookies and other site data are used to remember you, for example to sign you in or to personalize ads."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُستخدَم ملفات تعريف الارتباط وبيانات المواقع الإلكترونية الأخرى لتذكّرك، مثلاً لتسجيل دخولك أو تخصيص الإعلانات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kolačići i drugi podaci web lokacije koriste se da vas zapamte, naprimjer za prijavu ili personaliziranje oglasa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cookies og andre websitedata bruges til at huske dig, f.eks. for at logge dig ind eller tilpasse annoncer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cookies und andere Websitedaten werden verwendet, um dich wiederzuerkennen, z. B. um dich anzumelden oder Werbung zu personalisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las cookies y otros datos de sitios se usan para recordarte; por ejemplo, para iniciar sesión o personalizar anuncios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les cookies et autres données de site servent à vous reconnaître, par exemple pour vous connecter ou personnaliser les annonces."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I cookie e altri dati dei siti vengono usati per ricordarti, ad esempio per farti accedere o per personalizzare gli annunci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cookie などのサイトデータは、ログイン状態の維持や広告のカスタマイズなど、ユーザーを記憶するために使用されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ខូគី និងទិន្នន័យគេហទំព័រផ្សេងទៀតត្រូវបានប្រើដើម្បីចងចាំអ្នក ឧទាហរណ៍ ដើម្បីចូលគណនីឱ្យអ្នក ឬកំណត់ការផ្សាយពាណិជ្ជកម្មតាមបុគ្គល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "쿠키 및 기타 사이트 데이터는 로그인 유지나 광고 맞춤설정 등 사용자를 기억하는 데 사용됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Informasjonskapsler og andre nettstedsdata brukes til å huske deg, for eksempel for å logge deg på eller tilpasse annonser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pliki cookie i inne dane witryn służą do zapamiętywania Cię, np. do logowania lub personalizowania reklam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cookies e outros dados do site são usados para lembrar de você, por exemplo, para fazer login ou personalizar anúncios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Файлы cookie и другие данные сайтов используются, чтобы запоминать вас, например для входа в аккаунт или персонализации рекламы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คุกกี้และข้อมูลเว็บไซต์อื่นๆ ใช้เพื่อจดจำคุณ เช่น เพื่อให้คุณลงชื่อเข้าใช้หรือปรับโฆษณาให้เหมาะกับคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Çerezler ve diğer site verileri sizi hatırlamak için (ör. oturumunuzu açık tutmak veya reklamları kişiselleştirmek amacıyla) kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Файли cookie й інші дані сайтів використовуються, щоб запам’ятовувати вас, наприклад, для входу в обліковий запис або персоналізації реклами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cookie và dữ liệu khác của trang web dùng để ghi nhớ bạn, chẳng hạn như để đăng nhập hoặc cá nhân hóa quảng cáo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cookie 和其他网站数据可用来记住您的信息，例如让您保持登录状态或为您提供个性化广告。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cookie 和其他網站資料可用來記住你的資訊，例如讓你保持登入狀態或提供個人化廣告。"
          }
        }
      }
    },
