    "pageInfo.ask.autoPictureInPicture": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can ask to enter picture-in-picture automatically"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكنه طلب الدخول إلى وضع الصورة داخل الصورة تلقائيًا"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Može tražiti automatski prelazak u sliku u slici"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kan bede om automatisk at skifte til integreret billede"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kann fragen, ob automatisch der Bild-im-Bild-Modus aktiviert werden darf"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puede pedir permiso para activar automáticamente imagen en imagen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Peut demander à passer automatiquement en mode picture-in-picture"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Può chiedere di attivare automaticamente il picture in picture"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "自動でピクチャー イン ピクチャーに切り替えることを求めることができます"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អាចស្នើសុំចូលរូបភាពក្នុងរូបភាពដោយស្វ័យប្រវត្តិ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "자동으로 PIP 모드로 전환하도록 요청할 수 있음"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kan be om å bytte til bilde-i-bilde automatisk"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Może prosić o automatyczne przejście w tryb obrazu w obrazie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pode pedir para entrar em picture-in-picture automaticamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Может запрашивать автоматический переход в режим \"Картинка в картинке\""
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ขอเข้าสู่โหมดภาพซ้อนภาพโดยอัตโนมัติได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otomatik olarak pencere içinde pencereye geçmek için izin isteyebilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Може просити автоматично вмикати режим \"картинка в картинці\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Có thể yêu cầu tự động chuyển sang chế độ hình trong hình"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "可以请求自动进入画中画模式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "可以要求自動進入子母畫面模式"
          }
        }
      }
    },
