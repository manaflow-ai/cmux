    "pageInfo.reload.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload this page to apply your updated settings on this site"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أعِد تحميل هذه الصفحة لتطبيق إعداداتك المعدّلة على هذا الموقع الإلكتروني"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ponovo učitajte ovu stranicu da primijenite ažurirane postavke na ovoj web lokaciji"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Genindlæs denne side for at anvende dine opdaterede indstillinger på dette website"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lade diese Seite neu, um die aktualisierten Einstellungen für diese Website anzuwenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vuelve a cargar esta página para aplicar la configuración actualizada en este sitio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour appliquer les nouveaux paramètres à ce site, actualisez cette page"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ricarica questa pagina per applicare le impostazioni aggiornate su questo sito"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このサイトで更新した設定を適用するには、ページを再読み込みしてください"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទុកទំព័រនេះឡើងវិញ ដើម្បីអនុវត្តការកំណត់ដែលបានធ្វើបច្ចុប្បន្នភាពរបស់អ្នកនៅលើគេហទំព័រនេះ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 사이트에서 업데이트된 설정을 적용하려면 페이지를 새로고침하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Last inn denne siden på nytt for å bruke de oppdaterte innstillingene på dette nettstedet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Załaduj ponownie tę stronę, by zastosować zaktualizowane ustawienia w tej witrynie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atualize esta página para aplicar as configurações atualizadas neste site"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Обновите страницу, чтобы применить новые настройки для этого сайта"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โหลดหน้านี้ซ้ำเพื่อใช้การตั้งค่าที่อัปเดตในเว็บไซต์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Güncellenen ayarlarınızı bu sitede uygulamak için sayfayı yeniden yükleyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перезавантажте цю сторінку, щоб застосувати оновлені налаштування на цьому сайті"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hãy tải lại trang này để áp dụng các chế độ cài đặt đã cập nhật cho trang web này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "重新加载此页面，以便将更新后的设置应用于此网站"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "重新載入這個網頁，即可將更新後的設定套用至這個網站"
          }
        }
      }
