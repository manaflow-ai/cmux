    "pageInfo.security.dangerousDetails": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attackers on this site might trick you into installing harmful software or revealing things like your passwords, phone, or credit card numbers."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قد يخدعك المهاجمون على هذا الموقع الإلكتروني لتثبيت برامج ضارة أو الكشف عن معلومات مثل كلمات المرور أو رقم الهاتف أو أرقام بطاقات الائتمان."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Napadači na ovoj web lokaciji vas mogu prevariti da instalirate štetni softver ili otkrijete stvari kao što su lozinke, broj telefona ili brojevi kreditnih kartica."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hackere på dette website kan forsøge at narre dig til at installere skadelig software eller afsløre f.eks. dine adgangskoder, dit telefonnummer eller dine kreditkortnumre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Angreifer auf dieser Website versuchen möglicherweise, dich zur Installation schädlicher Software oder zur Preisgabe von Passwörtern, Telefon- oder Kreditkartennummern zu verleiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los atacantes de este sitio podrían engañarte para que instales software dañino o reveles información como tus contraseñas, tu teléfono o los números de tus tarjetas de crédito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Des pirates informatiques présents sur ce site pourraient vous inciter à installer des logiciels dangereux ou à révéler des informations comme vos mots de passe, votre numéro de téléphone ou vos numéros de carte de crédit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli utenti malintenzionati su questo sito potrebbero indurti con l'inganno a installare software dannoso o a rivelare informazioni come password, numero di telefono o numeri di carte di credito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このサイトの攻撃者が、有害なソフトウェアをインストールさせたり、パスワード、電話番号、クレジットカード番号などを開示させたりする可能性があります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អ្នកវាយប្រហារនៅលើគេហទំព័រនេះអាចបោកបញ្ឆោតអ្នកឱ្យដំឡើងកម្មវិធីដែលបង្កគ្រោះថ្នាក់ ឬបង្ហាញព័ត៌មានដូចជាពាក្យសម្ងាត់ លេខទូរសព្ទ ឬលេខកាតឥណទានរបស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 사이트의 공격자가 사용자를 속여 유해한 소프트웨어를 설치하게 하거나 비밀번호, 전화번호, 신용카드 번호 등을 알아낼 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Angripere på dette nettstedet kan lure deg til å installere skadelig programvare eller avsløre ting som passord, telefonnummer eller kredittkortnumre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atakujący w tej witrynie mogą podstępem nakłonić Cię do zainstalowania szkodliwego oprogramowania lub ujawnienia haseł, numeru telefonu albo numerów kart kredytowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Invasores neste site podem enganar você para que instale softwares nocivos ou revele informações como senhas, telefone ou números de cartão de crédito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Злоумышленники на этом сайте могут обманом заставить вас установить вредоносное ПО или раскрыть пароли, номер телефона или номера банковских карт."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ผู้โจมตีในเว็บไซต์นี้อาจหลอกให้คุณติดตั้งซอฟต์แวร์ที่เป็นอันตรายหรือเปิดเผยข้อมูล เช่น รหัสผ่าน หมายเลขโทรศัพท์ หรือหมายเลขบัตรเครดิต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu sitedeki saldırganlar sizi kandırarak zararlı yazılım yüklemenize veya şifreleriniz, telefon ya da kredi kartı numaralarınız gibi bilgileri açığa çıkarmanıza neden olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Зловмисники на цьому сайті можуть обманом змусити вас установити шкідливе програмне забезпечення або розкрити паролі, номер телефону чи кредитної картки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Những kẻ tấn công trên trang web này có thể lừa bạn cài đặt phần mềm độc hại hoặc tiết lộ thông tin như mật khẩu, số điện thoại hoặc số thẻ tín dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此网站上的攻击者可能会试图欺骗您，让您安装有害软件或泄露您的密码、电话号码或信用卡号等信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這個網站上的攻擊者可能會誘騙你安裝有害軟體，或是洩漏你的密碼、電話號碼或信用卡號碼等資訊。"
          }
        }
      }
    },
