          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux 브라우저에서 %@ 로그인 상태가 유지됩니다. 그 사이트의 쿠키만 가져옵니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du forblir pålogget %@ i nettleseren i cmux. Bare informasjonskapslene for det nettstedet blir med."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozostajesz zalogowany na %@ w przeglądarce cmux. Przenoszone są tylko pliki cookie tej witryny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você continua conectado a %@ no navegador do cmux. Só os cookies desse site são trazidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы остаётесь со входом на %@ в браузере cmux. Переносятся только файлы cookie этого сайта."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะยังลงชื่อเข้าใช้ %@ ในเบราว์เซอร์ของ cmux โดยนำมาเฉพาะคุกกี้ของเว็บไซต์นั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux tarayıcısında %@ oturumunuz açık kalır. Yalnızca o sitenin çerezleri aktarılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви лишаєтеся з входом на %@ у браузері cmux. Переносяться лише файли cookie цього сайту."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn vẫn đăng nhập %@ trong trình duyệt của cmux. Chỉ cookie của trang đó được mang sang."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在 cmux 的浏览器中会保持登录 %@。只会带入该网站的 Cookie。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在 cmux 的瀏覽器中會保持登入 %@。只會帶入該網站的 Cookie。"
          }
        }
      }
    },
    "importSuggestions.benefit.safariAccess" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فعّل الوصول الكامل إلى القرص لـ cmux في إعدادات النظام لنقل سجل Safari وإشاراته المرجعية."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uključite potpuni pristup disku za cmux u postavkama sistema da prenesete historiju i oznake iz Safarija."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå fuld diskadgang til for cmux i Systemindstillinger for at hente Safaris historik og bogmærker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte in den Systemeinstellungen den Festplattenvollzugriff für cmux ein, um Verlauf und Lesezeichen aus Safari zu übernehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on Full Disk Access for cmux in System Settings to bring Safari's history and bookmarks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa el acceso total al disco para cmux en Ajustes del Sistema para traer el historial y los marcadores de Safari."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez l’accès complet au disque pour cmux dans Réglages Système pour apporter l’historique et les signets de Safari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva l’accesso completo al disco per cmux in Impostazioni di Sistema per portare cronologia e segnalibri di Safari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定で cmux のフルディスクアクセスをオンにすると、Safari の履歴とブックマークを持ってこられます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "បើកការចូលប្រើថាសពេញលេញសម្រាប់ cmux ក្នុងការកំណត់ប្រព័ន្ធ ដើម្បីនាំយកប្រវត្តិ និងចំណាំរបស់ Safari។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정에서 cmux의 전체 디스크 접근 권한을 켜면 Safari의 방문 기록과 북마크를 가져올 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på full disktilgang for cmux i Systeminnstillinger for å hente loggen og bokmerkene fra Safari."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz pełny dostęp do dysku dla cmux w Ustawieniach systemowych, aby przenieść historię i zakładki Safari."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o Acesso Total ao Disco para o cmux nos Ajustes do Sistema para trazer o histórico e os favoritos do Safari."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите полный доступ к диску для cmux в Системных настройках, чтобы перенести историю и закладки Safari."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดการเข้าถึงดิสก์เต็มรูปแบบให้ cmux ในการตั้งค่าระบบ เพื่อนำประวัติและบุ๊กมาร์กของ Safari มา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari'nin geçmişini ve yer işaretlerini getirmek için Sistem Ayarları'nda cmux'a Tam Disk Erişimi verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть повний доступ до диска для cmux у Системних параметрах, щоб перенести історію та закладки Safari."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật quyền truy cập toàn bộ ổ đĩa cho cmux trong Cài đặt hệ thống để mang lịch sử và dấu trang của Safari sang."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“系统设置”中为 cmux 打开“完全磁盘访问权限”，即可带入 Safari 的历史记录和书签。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「系統設定」中為 cmux 開啟「完整磁碟取用權限」，即可帶入 Safari 的瀏覽記錄和書籤。"
          }
        }
      }
    },
