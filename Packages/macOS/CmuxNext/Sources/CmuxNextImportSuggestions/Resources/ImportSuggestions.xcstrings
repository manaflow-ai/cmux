{
  "sourceLanguage" : "en",
  "strings" : {
    "importSuggestions.benefit.browserHistory" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يملأ سجلك وإشاراتك المرجعية من %@ شريط عناوين cmux."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša historija i oznake iz aplikacije %@ pune adresnu traku u cmuxu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din historik og dine bogmærker fra %@ udfylder adresselinjen i cmux."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Verlauf und deine Lesezeichen aus %@ füllen die Adressleiste von cmux."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your %@ history and bookmarks fill cmux's address bar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu historial y tus marcadores de %@ llenan la barra de direcciones de cmux."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre historique et vos signets de %@ remplissent la barre d’adresse de cmux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cronologia e i segnalibri di %@ riempiono la barra degli indirizzi di cmux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の履歴とブックマークが cmux のアドレスバーに入ります。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ប្រវត្តិ និងចំណាំរបស់អ្នកពី %@ បំពេញរបារអាសយដ្ឋានរបស់ cmux។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 방문 기록과 북마크가 cmux 주소 막대에 채워집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loggen og bokmerkene dine fra %@ fyller adressefeltet i cmux."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historia i zakładki z %@ wypełniają pasek adresu w cmux."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu histórico e seus favoritos do %@ preenchem a barra de endereço do cmux."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История и закладки из %@ заполняют адресную строку cmux."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประวัติและบุ๊กมาร์กจาก %@ จะเติมแถบที่อยู่ของ cmux"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ geçmişiniz ve yer işaretleriniz cmux'ın adres çubuğunu doldurur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Історія та закладки з %@ заповнюють адресний рядок cmux."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lịch sử và dấu trang từ %@ điền sẵn thanh địa chỉ của cmux."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在 %@ 的历史记录和书签会填入 cmux 的地址栏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在 %@ 的瀏覽記錄和書籤會填入 cmux 的網址列。"
          }
        }
      }
    },
    "importSuggestions.benefit.browserSignedIn" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى المواقع التي سجّلت الدخول إليها في %@ مسجّلة هنا، ويملأ سجلك شريط العناوين."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stranice na koje ste prijavljeni u aplikaciji %@ ostaju prijavljene i ovdje, a historija puni adresnu traku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websteder, du er logget ind på i %@, forbliver logget ind her, og din historik udfylder adresselinjen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites, bei denen du in %@ angemeldet bist, bleiben hier angemeldet, und dein Verlauf füllt die Adressleiste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sites you're signed into in %@ stay signed in here, and your history fills the address bar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los sitios en los que iniciaste sesión en %@ siguen con la sesión iniciada aquí, y tu historial llena la barra de direcciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sites où vous êtes connecté dans %@ le restent ici, et votre historique remplit la barre d’adresse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I siti a cui hai eseguito l’accesso in %@ restano connessi qui, e la cronologia riempie la barra degli indirizzi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ でサインイン済みのサイトはここでもサインインしたままになり、履歴がアドレスバーに入ります。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "គេហទំព័រដែលអ្នកបានចូលក្នុង %@ នៅតែចូលនៅទីនេះ ហើយប្រវត្តិរបស់អ្នកបំពេញរបារអាសយដ្ឋាន។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 로그인한 사이트는 여기서도 로그인 상태가 유지되고, 방문 기록이 주소 막대에 채워집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nettsteder du er logget på i %@, forblir pålogget her, og loggen fyller adressefeltet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Witryny, na których jesteś zalogowany w %@, pozostają zalogowane tutaj, a historia wypełnia pasek adresu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os sites em que você entrou no %@ continuam conectados aqui, e o histórico preenche a barra de endereço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сайты, на которых вы вошли в %@, остаются со входом и здесь, а история заполняет адресную строку."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เว็บไซต์ที่คุณลงชื่อเข้าใช้ใน %@ จะยังลงชื่อเข้าใช้อยู่ที่นี่ และประวัติจะเติมแถบที่อยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ içinde oturum açtığınız siteler burada da açık kalır, geçmişiniz adres çubuğunu doldurur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сайти, на яких ви ввійшли в %@, лишаються з входом і тут, а історія заповнює адресний рядок."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các trang bạn đã đăng nhập trong %@ vẫn đăng nhập ở đây, và lịch sử điền sẵn thanh địa chỉ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在 %@ 中已登录的网站在这里也保持登录，历史记录也会填入地址栏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在 %@ 中已登入的網站在這裡也保持登入，瀏覽記錄也會填入網址列。"
          }
        }
      }
    },
    "importSuggestions.benefit.classic" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُفتح مساحات عمل Classic هنا، مع علاماتها ومجلداتها ومحادثات الوكلاء."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaši Classic radni prostori otvaraju se ovdje, s karticama, folderima i agentskim razgovorima."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine Classic-arbejdsområder åbner her med deres faner, mapper og agentchats."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Classic-Arbeitsbereiche öffnen sich hier, mit ihren Tabs, Ordnern und Agent-Chats."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Classic workspaces open here, with their tabs, folders and agent chats."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus espacios de trabajo de Classic se abren aquí, con sus pestañas, carpetas y chats de agentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos espaces de travail Classic s’ouvrent ici, avec leurs onglets, dossiers et discussions d’agents."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi spazi di lavoro di Classic si aprono qui, con schede, cartelle e chat degli agenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classic のワークスペースが、タブ、フォルダ、エージェントのチャットごとここで開きます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "កន្លែងធ្វើការ Classic របស់អ្នកបើកនៅទីនេះ ជាមួយផ្ទាំង ថត និងការជជែកភ្នាក់ងារ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classic 작업 공간이 탭, 폴더, 에이전트 채팅과 함께 여기서 열립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classic-arbeidsområdene dine åpnes her, med faner, mapper og agentchatter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obszary robocze z Classic otwierają się tutaj, z kartami, folderami i czatami agentów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus espaços de trabalho do Classic abrem aqui, com abas, pastas e conversas de agentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рабочие пространства Classic открываются здесь, с вкладками, папками и чатами агентов."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พื้นที่ทำงาน Classic ของคุณจะเปิดที่นี่ พร้อมแท็บ โฟลเดอร์ และแชตเอเจนต์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classic çalışma alanlarınız sekmeleri, klasörleri ve ajan sohbetleriyle burada açılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Робочі простори Classic відкриваються тут, із вкладками, папками й чатами агентів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các không gian làm việc Classic mở ở đây, cùng thẻ, thư mục và trò chuyện với tác nhân."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Classic 工作区会在这里打开，连同标签页、文件夹和智能体聊天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Classic 工作區會在這裡打開，連同分頁、資料夾和代理程式聊天。"
          }
        }
      }
    },
    "importSuggestions.benefit.classicAgain" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استورد مرة أخرى لإعادة فتح مساحات عمل Classic التي أغلقتها هنا. لا تتكرر المساحات التي لا تزال مفتوحة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvezite ponovo da otvorite Classic radne prostore koje ste ovdje zatvorili. Oni koji su još otvoreni se ne dupliraju."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importér igen for at genåbne Classic-arbejdsområder, du har lukket her. Dem, der stadig er åbne, dubleres ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importiere erneut, um Classic-Arbeitsbereiche wieder zu öffnen, die du hier geschlossen hast. Noch geöffnete werden nicht doppelt angelegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import again to reopen Classic workspaces you closed here. Ones still open aren't duplicated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa de nuevo para reabrir los espacios de trabajo de Classic que cerraste aquí. Los que siguen abiertos no se duplican."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez à nouveau pour rouvrir les espaces de travail Classic fermés ici. Ceux encore ouverts ne sont pas dupliqués."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa di nuovo per riaprire gli spazi di lavoro di Classic che hai chiuso qui. Quelli ancora aperti non vengono duplicati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一度読み込むと、ここで閉じた Classic のワークスペースが再び開きます。開いたままのものは重複しません。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "នាំចូលម្ដងទៀតដើម្បីបើកកន្លែងធ្វើការ Classic ដែលអ្នកបានបិទនៅទីនេះឡើងវិញ។ កន្លែងដែលនៅបើកមិនត្រូវបានចម្លងទេ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 가져오면 여기서 닫은 Classic 작업 공간이 다시 열립니다. 아직 열려 있는 작업 공간은 중복되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importer på nytt for å åpne Classic-arbeidsområder du har lukket her. De som fortsatt er åpne, dupliseres ikke."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaimportuj ponownie, aby otworzyć obszary robocze z Classic zamknięte tutaj. Te wciąż otwarte nie zostaną zduplikowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe novamente para reabrir os espaços de trabalho do Classic que você fechou aqui. Os que ainda estão abertos não são duplicados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Импортируйте снова, чтобы заново открыть рабочие пространства Classic, закрытые здесь. Открытые не дублируются."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นำเข้าอีกครั้งเพื่อเปิดพื้นที่ทำงาน Classic ที่คุณปิดไปที่นี่อีกครั้ง พื้นที่ที่ยังเปิดอยู่จะไม่ถูกทำซ้ำ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burada kapattığınız Classic çalışma alanlarını yeniden açmak için tekrar içe aktarın. Hâlâ açık olanlar çoğaltılmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Імпортуйте знову, щоб повторно відкрити робочі простори Classic, закриті тут. Ті, що ще відкриті, не дублюються."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập lại để mở lại các không gian làm việc Classic bạn đã đóng ở đây. Những cái vẫn đang mở sẽ không bị nhân đôi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再次导入可重新打开你在这里关闭的 Classic 工作区。仍然打开的不会重复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再次匯入可重新打開你在這裡關閉的 Classic 工作區。仍然開著的不會重複。"
          }
        }
      }
    },
    "importSuggestions.benefit.claudeCode" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصبح سجل Claude Code محادثات قابلة للبحث. افتح إحداها لتكمل من حيث توقفت."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historija iz Claude Codea postaje pretraživi razgovori. Otvorite jedan da nastavite gdje ste stali."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Claude Code-historik bliver til søgbare chats. Åbn en for at fortsætte, hvor du slap."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Claude Code-Verlauf wird zu durchsuchbaren Chats. Öffne einen, um dort weiterzumachen, wo du aufgehört hast."
