    "importSuggestions.settings.empty" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا شيء لنقله الآن. سيبحث cmux مجددًا عند عودتك إليه."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trenutno nema ničega za prenijeti. cmux ponovo provjerava kad se vratite."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er intet at hente lige nu. cmux kigger igen, når du vender tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerade gibt es nichts zu übernehmen. cmux sieht wieder nach, wenn du zurückkommst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing to bring over right now. cmux looks again when you come back to it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora no hay nada que traer. cmux volverá a mirar cuando regreses."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien à apporter pour l’instant. cmux regardera de nouveau à votre retour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento non c’è niente da portare. cmux controlla di nuovo quando ci torni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今は持ってくるものがありません。cmux に戻ったときにもう一度確認します。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "គ្មានអ្វីដើម្បីនាំមកឥឡូវនេះទេ។ cmux នឹងពិនិត្យម្ដងទៀតពេលអ្នកត្រឡប់មកវិញ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 가져올 항목이 없습니다. cmux로 돌아오면 다시 확인합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingenting å hente akkurat nå. cmux ser etter igjen når du kommer tilbake."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na razie nie ma nic do przeniesienia. cmux sprawdzi ponownie, gdy wrócisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada para trazer agora. O cmux procura de novo quando você voltar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас переносить нечего. cmux проверит снова, когда вы вернётесь."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอนนี้ไม่มีอะไรให้นำมา cmux จะตรวจอีกครั้งเมื่อคุณกลับมา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şu anda getirilecek bir şey yok. Geri döndüğünüzde cmux yeniden bakar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наразі переносити нічого. cmux перевірить знову, коли ви повернетеся."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiện chưa có gì để mang sang. cmux sẽ kiểm tra lại khi bạn quay lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前没有要带入的内容。你回到 cmux 时会再查看一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前沒有要帶入的內容。你回到 cmux 時會再查看一次。"
          }
        }
      }
    },
