{
  "sourceLanguage" : "en",
  "strings" : {
    "importSuggestions.benefit.browserHistory" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يملأ سجلك وإشاراتك المرجعية من %@ شريط عناوين cmux."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Verlauf und deine Lesezeichen aus %@ füllen die Adressleiste von cmux."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your %@ history and bookmarks fill cmux's address bar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu historial y tus marcadores de %@ llenan la barra de direcciones de cmux."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre historique et vos signets de %@ remplissent la barre d’adresse de cmux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の履歴とブックマークが cmux のアドレスバーに入ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 방문 기록과 북마크가 cmux 주소 막대에 채워집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在 %@ 的历史记录和书签会填入 cmux 的地址栏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在 %@ 的瀏覽記錄和書籤會填入 cmux 的網址列。"
          }
        }
      }
    },
    "importSuggestions.benefit.browserSignedIn" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى المواقع التي سجّلت الدخول إليها في %@ مسجّلة هنا، ويملأ سجلك شريط العناوين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites, bei denen du in %@ angemeldet bist, bleiben hier angemeldet, und dein Verlauf füllt die Adressleiste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sites you're signed into in %@ stay signed in here, and your history fills the address bar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los sitios en los que iniciaste sesión en %@ siguen con la sesión iniciada aquí, y tu historial llena la barra de direcciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sites où vous êtes connecté dans %@ le restent ici, et votre historique remplit la barre d’adresse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ でサインイン済みのサイトはここでもサインインしたままになり、履歴がアドレスバーに入ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 로그인한 사이트는 여기서도 로그인 상태가 유지되고, 방문 기록이 주소 막대에 채워집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在 %@ 中已登录的网站在这里也保持登录，历史记录也会填入地址栏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在 %@ 中已登入的網站在這裡也保持登入，瀏覽記錄也會填入網址列。"
          }
        }
      }
    },
    "importSuggestions.benefit.classic" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُفتح مساحات عمل Classic هنا، مع علاماتها ومجلداتها ومحادثات الوكلاء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Classic-Arbeitsbereiche öffnen sich hier, mit ihren Tabs, Ordnern und Agent-Chats."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Classic workspaces open here, with their tabs, folders and agent chats."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus espacios de trabajo de Classic se abren aquí, con sus pestañas, carpetas y chats de agentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos espaces de travail Classic s’ouvrent ici, avec leurs onglets, dossiers et discussions d’agents."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classic のワークスペースが、タブ、フォルダ、エージェントのチャットごとここで開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classic 작업 공간이 탭, 폴더, 에이전트 채팅과 함께 여기서 열립니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Classic 工作区会在这里打开，连同标签页、文件夹和智能体聊天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Classic 工作區會在這裡打開，連同分頁、資料夾和代理程式聊天。"
          }
        }
      }
    },
    "importSuggestions.benefit.claudeCode" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصبح سجل Claude Code محادثات قابلة للبحث. افتح إحداها لتكمل من حيث توقفت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Claude Code-Verlauf wird zu durchsuchbaren Chats. Öffne einen, um dort weiterzumachen, wo du aufgehört hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Claude Code history becomes searchable chats. Open one to pick up where you left off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu historial de Claude Code se convierte en chats con búsqueda. Abre uno para seguir donde lo dejaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre historique Claude Code devient des discussions consultables. Ouvrez-en une pour reprendre là où vous en étiez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code の履歴が検索できるチャットになります。開けば中断したところから続けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code 기록이 검색 가능한 채팅이 됩니다. 하나를 열어 멈춘 곳에서 이어 가세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Claude Code 记录会变成可搜索的聊天。打开任意一个，就能从上次停下的地方继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Claude Code 記錄會變成可搜尋的聊天。打開任一個，就能從上次停下的地方繼續。"
          }
        }
      }
    },
    "importSuggestions.benefit.codex" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصبح محادثات Codex محادثات قابلة للبحث. افتح إحداها لتكمل من حيث توقفت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Codex-Unterhaltungen werden zu durchsuchbaren Chats. Öffne eine, um dort weiterzumachen, wo du aufgehört hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Codex threads become searchable chats. Open one to pick up where you left off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus hilos de Codex se convierten en chats con búsqueda. Abre uno para seguir donde lo dejaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos fils Codex deviennent des discussions consultables. Ouvrez-en un pour reprendre là où vous en étiez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex のスレッドが検索できるチャットになります。開けば中断したところから続けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex 스레드가 검색 가능한 채팅이 됩니다. 하나를 열어 멈춘 곳에서 이어 가세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Codex 对话会变成可搜索的聊天。打开任意一个，就能从上次停下的地方继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Codex 對話串會變成可搜尋的聊天。打開任一個，就能從上次停下的地方繼續。"
          }
        }
      }
    },
    "importSuggestions.benefit.ghostty" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم طرفيات cmux إعدادات Ghostty الخاصة بك بالفعل: الخطوط والسمة والمفاتيح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux-Terminals verwenden schon deine Ghostty-Konfiguration: Schriften, Thema und Tasten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux terminals already use your Ghostty config: fonts, theme and keys."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los terminales de cmux ya usan tu configuración de Ghostty: fuentes, tema y teclas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les terminaux cmux utilisent déjà votre configuration Ghostty : polices, thème et raccourcis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux のターミナルはすでに Ghostty の設定（フォント、テーマ、キー）を使っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux 터미널은 이미 Ghostty 설정(글꼴, 테마, 키)을 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux 终端已在使用你的 Ghostty 配置：字体、主题和按键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux 終端機已在使用你的 Ghostty 設定：字體、主題和按鍵。"
          }
        }
      }
    },
    "importSuggestions.benefit.iterm2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصبح ألوان iTerm2 سمة طرفية في cmux يمكنك اختيارها من المظهر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine iTerm2-Farben werden zu einem cmux-Terminalthema, das du unter „Darstellung“ wählen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your iTerm2 colors become a cmux terminal theme you can pick in Appearance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus colores de iTerm2 se convierten en un tema de terminal de cmux que puedes elegir en Apariencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos couleurs iTerm2 deviennent un thème de terminal cmux à choisir dans Apparence."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 の色が cmux のターミナルテーマになり、「外観」で選べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 색상이 모양에서 고를 수 있는 cmux 터미널 테마가 됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 iTerm2 颜色会变成 cmux 的终端主题，可在“外观”中选用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 iTerm2 顏色會變成 cmux 的終端機主題，可在「外觀」中選用。"
          }
        }
      }
    },
    "importSuggestions.benefit.request" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى مسجّل الدخول إلى %@ في متصفح cmux. تُنقل ملفات تعريف الارتباط لهذا الموقع فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bleibst im Browser von cmux bei %@ angemeldet. Nur die Cookies dieser Website werden übernommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You stay signed in to %@ in cmux's browser. Only that site's cookies come over."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantienes la sesión iniciada en %@ en el navegador de cmux. Solo se traen las cookies de ese sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous restez connecté à %@ dans le navigateur de cmux. Seuls les témoins de ce site sont apportés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux のブラウザで %@ にサインインしたままになります。持ってくるのはそのサイトの Cookie だけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux 브라우저에서 %@ 로그인 상태가 유지됩니다. 그 사이트의 쿠키만 가져옵니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在 cmux 的浏览器中会保持登录 %@。只会带入该网站的 Cookie。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在 cmux 的瀏覽器中會保持登入 %@。只會帶入該網站的 Cookie。"
          }
        }
      }
    },
    "importSuggestions.benefit.safariAccess" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فعّل الوصول الكامل إلى القرص لـ cmux في إعدادات النظام لنقل سجل Safari وإشاراته المرجعية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte in den Systemeinstellungen den Festplattenvollzugriff für cmux ein, um Verlauf und Lesezeichen aus Safari zu übernehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on Full Disk Access for cmux in System Settings to bring Safari's history and bookmarks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa el acceso total al disco para cmux en Ajustes del Sistema para traer el historial y los marcadores de Safari."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez l’accès complet au disque pour cmux dans Réglages Système pour apporter l’historique et les signets de Safari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定で cmux のフルディスクアクセスをオンにすると、Safari の履歴とブックマークを持ってこられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정에서 cmux의 전체 디스크 접근 권한을 켜면 Safari의 방문 기록과 북마크를 가져올 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“系统设置”中为 cmux 打开“完全磁盘访问权限”，即可带入 Safari 的历史记录和书签。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「系統設定」中為 cmux 開啟「完整磁碟取用權限」，即可帶入 Safari 的瀏覽記錄和書籤。"
          }
        }
      }
    },
