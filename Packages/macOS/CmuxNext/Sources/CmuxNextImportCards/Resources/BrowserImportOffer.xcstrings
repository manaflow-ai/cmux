        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca para %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никогда для %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องแสดงสำหรับ %@ อีก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için asla"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніколи для %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không bao giờ với %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不再为 %@ 提示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不再為 %@ 提示"
          }
        }
      }
    }
