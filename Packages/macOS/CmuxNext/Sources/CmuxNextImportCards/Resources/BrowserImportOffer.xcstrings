            "value": "匯入…"
          }
        }
      }
    },
    "browserImportOffer.notNow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今はしない"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس الآن"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne sada"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke nu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht jetzt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora no"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus tard"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ora"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនមែនឥឡូវ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke nå"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie teraz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora Não"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не сейчас"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไว้ทีหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi Değil"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не зараз"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để sau"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以后再说"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "稍後再說"
          }
        }
      },
      "comment": "Browser-data import offer: dismisses the card for 30 days, including after relaunch."
    },
    "browserImportOffer.cookies.title": {
      "comment": "Cookie import banner in browser tabs: title. It brings the person's signed-in sessions (cookies) over, not passwords. %@ is the detected browser, for example Google Chrome.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import sign-ins from %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استيراد جلسات تسجيل الدخول من %@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvezi prijave iz %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Importér logins fra %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldungen aus %@ importieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar inicios de sesión de %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer les connexions depuis %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa gli accessi da %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ からサインイン情報を読み込む"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នាំចូលការចូលគណនីពី %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 로그인 정보 가져오기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer pålogginger fra %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importuj sesje logowania z %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar logins de %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортировать сеансы входа из %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำเข้าการลงชื่อเข้าใช้จาก %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ oturumlarını içe aktar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпортувати сеанси входу з %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập thông tin đăng nhập từ %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 %@ 导入登录信息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 %@ 匯入登入資訊"
          }
        }
      }
    },
    "browserImportOffer.neverForBrowser": {
      "comment": "Browser-data import offer: permanent dismissal button naming the offered browser. %@ is the browser name, for example Chrome.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never for %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبدًا لـ %@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikad za %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aldrig for %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie für %@"
          }
        },
        "es": {
