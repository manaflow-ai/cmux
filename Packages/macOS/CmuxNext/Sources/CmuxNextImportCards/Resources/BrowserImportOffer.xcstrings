{
  "sourceLanguage": "en",
  "strings": {
    "browserImportOffer.syncStopped": {
      "comment": "Toast when keeping cookies in sync stops because the source browser's cookies can no longer be read (its Keychain key was denied or its profile is gone). %@: the browser's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped syncing cookies with %@: cmux could not read them. Import again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقفت مزامنة ملفات تعريف الارتباط مع %@: تعذّر على cmux قراءتها. استورد مجددًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinhronizacija kolačića s %@ je zaustavljena: cmux ih nije mogao pročitati. Uvezi ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppede synkronisering af cookies med %@: cmux kunne ikke læse dem. Importér igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookie-Sync mit %@ gestoppt: cmux konnte sie nicht lesen. Importiere erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se dejaron de sincronizar las cookies con %@: cmux no pudo leerlas. Importa de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisation des cookies avec %@ arrêtée : cmux n’a pas pu les lire. Importez à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizzazione dei cookie con %@ interrotta: cmux non è riuscito a leggerli. Importa di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ との Cookie の同期を停止しました：cmux が読み取れませんでした。もう一度インポートしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បានបញ្ឈប់ការធ្វើសមកាលកម្មខូគីជាមួយ %@៖ cmux មិនអាចអានវាបានទេ។ នាំចូលម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@와(과)의 쿠키 동기화를 중지했습니다. cmux가 읽을 수 없었습니다. 다시 가져오세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluttet å synkronisere informasjonskapsler med %@: cmux kunne ikke lese dem. Importer på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymano synchronizację plików cookie z %@: cmux nie mógł ich odczytać. Zaimportuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização de cookies com %@ parou: o cmux não conseguiu lê-los. Importe de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация cookie с %@ остановлена: cmux не смог их прочитать. Импортируйте снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดซิงค์คุกกี้กับ %@ แล้ว: cmux อ่านไม่ได้ นำเข้าอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ile çerez eşitlemesi durduruldu: cmux bunları okuyamadı. Yeniden içe aktarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізацію cookie з %@ зупинено: cmux не зміг їх прочитати. Імпортуйте знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã ngừng đồng bộ cookie với %@: cmux không đọc được chúng. Hãy nhập lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止与 %@ 同步 Cookie：cmux 无法读取它们。请重新导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止與 %@ 同步 Cookie：cmux 無法讀取它們。請重新匯入。"
          }
        }
      }
    },
    "browserImportOffer.turnedOff": {
      "comment": "Refusal shown when an Import from Browser action runs while browser.import.enabled is off.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import from Browser is turned off in Settings > Browser."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستيراد من المتصفح متوقف في الإعدادات > المتصفح."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvoz iz preglednika je isključen u Postavke > Preglednik."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Importér fra browser er slået fra i Indstillinger > Browser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Aus Browser importieren“ ist in Einstellungen > Browser ausgeschaltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar desde el navegador está desactivado en Ajustes > Navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer depuis le navigateur est désactivé dans Réglages > Navigateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa da browser è disattivato in Impostazioni > Browser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ブラウザから読み込む」は 設定 > ブラウザ でオフになっています。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នាំចូលពីកម្មវិធីរុករក ត្រូវបានបិទនៅក្នុង ការកំណត់ > កម្មវិធីរុករក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'브라우저에서 가져오기'가 설정 > 브라우저에서 꺼져 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer fra nettleser er slått av i Innstillinger > Nettleser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importuj z przeglądarki jest wyłączone w Ustawienia > Przeglądarka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar do navegador está desativado em Ajustes > Navegador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Импорт из браузера» выключен в разделе Настройки > Браузер."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำเข้าจากเบราว์เซอร์ ถูกปิดอยู่ใน การตั้งค่า > เบราว์เซอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcıdan İçe Aktar, Ayarlar > Tarayıcı bölümünde kapalı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Імпорт з браузера» вимкнено в Налаштування > Браузер."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập từ trình duyệt đang tắt trong Cài đặt > Trình duyệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“从浏览器导入”已在“设置 > 浏览器”中关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「從瀏覽器匯入」已在「設定 > 瀏覽器」中關閉。"
          }
        }
      }
    },
    "browserImportOffer.import": {
