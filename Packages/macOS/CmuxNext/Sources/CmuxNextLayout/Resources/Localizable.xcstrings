    "layout.resizeMode.push": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ Push: the column grows and moves the columns after it"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ 押し出し: 列が広がり、後ろの列を動かします"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌥ دفع: يتسع العمود ويحرّك الأعمدة التي تليه"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌥ Guranje: kolona raste i pomjera kolone iza nje"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌥ Skub: kolonnen vokser og flytter kolonnerne efter den"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌥ Schieben: Die Spalte wächst und verschiebt die Spalten danach"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌥ Empujar: la columna crece y desplaza las columnas siguientes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌥ Pousser : la colonne s’élargit et déplace les colonnes suivantes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌥ Spingi: la colonna si allarga e sposta le colonne successive"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌥ រុញ៖ ជួរឈរពង្រីក ហើយរំកិលជួរឈរបន្ទាប់"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌥ 밀기: 열이 넓어지고 뒤의 열들이 이동합니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌥ Skyv: kolonnen vokser og flytter kolonnene etter den"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌥ Przesuń: kolumna rośnie i przesuwa kolejne kolumny"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌥ Empurrar: a coluna cresce e move as colunas seguintes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌥ Сдвиг: столбец растёт и сдвигает следующие столбцы"
          }
        },
        "th": {
