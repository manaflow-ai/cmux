    "iphone.phone.removeHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes this phone from your account's devices and ends its connection. A phone still signed in adds itself again when it reconnects."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يزيل هذا الهاتف من أجهزة حسابك وينهي اتصاله. الهاتف الذي لا يزال مسجّل الدخول يضيف نفسه مجددًا عند إعادة الاتصال."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uklanja ovaj telefon s uređaja vašeg računa i prekida njegovu vezu. Telefon koji je i dalje prijavljen ponovo se dodaje kada se ponovo poveže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fjerner telefonen fra kontoens enheder og afbryder dens forbindelse. En telefon, der stadig er logget ind, tilføjer sig selv igen, når den forbinder igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Entfernt dieses Telefon aus den Geräten deines Kontos und beendet seine Verbindung. Ein noch angemeldetes Telefon fügt sich beim nächsten Verbinden wieder hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elimina este teléfono de los dispositivos de tu cuenta y termina su conexión. Un teléfono que siga con la sesión iniciada se vuelve a añadir al reconectarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Supprime ce téléphone des appareils de votre compte et met fin à sa connexion. Un téléphone toujours connecté au compte se rajoute lorsqu’il se reconnecte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rimuove questo telefono dai dispositivi del tuo account e ne termina la connessione. Un telefono ancora connesso all’account si aggiunge di nuovo quando si riconnette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この電話をアカウントのデバイスから削除し、接続を終了します。サインインしたままの電話は、再接続時に自動で再追加されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ដកទូរសព្ទនេះចេញពីឧបករណ៍របស់គណនីអ្នក ហើយបញ្ចប់ការតភ្ជាប់របស់វា។ ទូរសព្ទដែលនៅតែចូល នឹងបន្ថែមខ្លួនវិញនៅពេលតភ្ជាប់ម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 휴대폰을 계정의 기기에서 제거하고 연결을 끊습니다. 계속 로그인된 휴대폰은 다시 연결할 때 자신을 다시 추가합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fjerner telefonen fra kontoens enheter og avslutter tilkoblingen. En telefon som fortsatt er pålogget, legger seg til igjen når den kobler til på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usuwa ten telefon z urządzeń konta i kończy jego połączenie. Telefon, który nadal jest zalogowany, doda się ponownie przy następnym połączeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Remove este telefone dos dispositivos da sua conta e encerra a conexão. Um telefone que continua conectado à conta se adiciona de novo ao reconectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Удаляет телефон из устройств учётной записи и разрывает его подключение. Телефон, на котором вы всё ещё вошли, снова добавится при переподключении."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลบโทรศัพท์นี้ออกจากอุปกรณ์ของบัญชีและยุติการเชื่อมต่อ โทรศัพท์ที่ยังลงชื่อเข้าใช้อยู่จะเพิ่มตัวเองกลับเมื่อเชื่อมต่อใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu telefonu hesabınızın cihazlarından kaldırır ve bağlantısını sonlandırır. Oturumu hâlâ açık olan bir telefon yeniden bağlandığında kendini tekrar ekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Видаляє телефон із пристроїв облікового запису й розриває його підключення. Телефон, на якому ви досі ввійшли, знову додасться під час повторного підключення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xóa điện thoại này khỏi thiết bị của tài khoản và ngắt kết nối. Điện thoại vẫn đăng nhập sẽ tự thêm lại khi kết nối lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "从账户的设备中移除此手机并断开其连接。仍处于登录状态的手机重新连接时会再次添加自己。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "從帳號的裝置中移除此手機並中斷其連線。仍保持登入的手機重新連線時會再次加入自己。"
          }
        }
      }
    },
    "iphone.phones.listFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load your phones. Check your connection."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّر تحميل هواتفك. تحقّق من اتصالك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nije moguće učitati vaše telefone. Provjerite vezu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kunne ikke indlæse dine telefoner. Tjek din forbindelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Telefone konnten nicht geladen werden. Prüfe deine Verbindung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudieron cargar tus teléfonos. Revisa tu conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de charger vos téléphones. Vérifiez votre connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile caricare i tuoi telefoni. Controlla la connessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "電話を読み込めませんでした。接続を確認してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនអាចផ្ទុកទូរសព្ទរបស់អ្នកបានទេ។ សូមពិនិត្យការតភ្ជាប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "휴대폰 목록을 불러오지 못했습니다. 연결을 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kunne ikke laste inn telefonene dine. Sjekk tilkoblingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie udało się wczytać telefonów. Sprawdź połączenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível carregar seus telefones. Verifique sua conexão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось загрузить ваши телефоны. Проверьте подключение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โหลดโทรศัพท์ของคุณไม่ได้ ตรวจสอบการเชื่อมต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Telefonlarınız yüklenemedi. Bağlantınızı kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не вдалося завантажити ваші телефони. Перевірте підключення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không tải được danh sách điện thoại. Hãy kiểm tra kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法加载你的手机。请检查网络连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "無法載入你的手機。請檢查網路連線。"
          }
        }
      }
    },
    "iphone.phones.removeFailed": {
      "extractionState": "manual",
      "localizations": {
