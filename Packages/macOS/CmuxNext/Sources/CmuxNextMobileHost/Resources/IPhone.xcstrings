    "iphone.status.signedOut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to cmux to allow iPhone connections."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سجّل الدخول إلى cmux للسماح باتصالات iPhone."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prijavite se u cmux da biste dozvolili iPhone veze."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Log ind på cmux for at tillade iPhone-forbindelser."
          }
