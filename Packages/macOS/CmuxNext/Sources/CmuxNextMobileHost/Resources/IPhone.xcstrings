    "iphone.pending.blockedHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After you choose Don't Allow, new requests from this account are ignored for 10 minutes, and too many at once are ignored too."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "بعد اختيار «عدم السماح»، تُتجاهل الطلبات الجديدة من هذا الحساب لمدة 10 دقائق، كما تُتجاهل الطلبات الكثيرة في وقت واحد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nakon što odaberete Nemoj dozvoliti, novi zahtjevi s ovog računa zanemaruju se 10 minuta, a zanemaruje se i previše zahtjeva odjednom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Når du har valgt Tillad ikke, ignoreres nye anmodninger fra denne konto i 10 minutter, og for mange på én gang ignoreres også."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nachdem du „Nicht erlauben“ gewählt hast, werden neue Anfragen dieses Kontos 10 Minuten lang ignoriert, ebenso zu viele auf einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Después de elegir No permitir, las nuevas solicitudes de esta cuenta se ignoran durante 10 minutos, y también se ignoran demasiadas a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Après avoir choisi Ne pas autoriser, les nouvelles demandes de ce compte sont ignorées pendant 10 minutes, tout comme les demandes trop nombreuses à la fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dopo aver scelto Non consentire, le nuove richieste da questo account vengono ignorate per 10 minuti, così come quelle troppo numerose contemporaneamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「許可しない」を選ぶと、このアカウントからの新しいリクエストは 10 分間無視されます。一度に多すぎるリクエストも無視されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បន្ទាប់ពីអ្នកជ្រើសរើស «កុំអនុញ្ញាត» សំណើថ្មីពីគណនីនេះនឹងត្រូវមិនអើពើរយៈពេល 10 នាទី ហើយសំណើច្រើនពេកក្នុងពេលតែមួយក៏ត្រូវមិនអើពើដែរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "허용 안 함을 선택하면 이 계정의 새 요청은 10분 동안 무시되며, 한꺼번에 너무 많은 요청도 무시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Etter at du har valgt Ikke tillat, ignoreres nye forespørsler fra denne kontoen i 10 minutter, og for mange samtidig ignoreres også."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Po wybraniu Nie zezwalaj nowe prośby z tego konta są ignorowane przez 10 minut; ignorowane są też zbyt liczne prośby naraz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Depois que você escolhe Não permitir, novas solicitações desta conta são ignoradas por 10 minutos, e muitas ao mesmo tempo também são ignoradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "После выбора «Не разрешать» новые запросы с этой учётной записи игнорируются 10 минут; слишком много запросов сразу тоже игнорируются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หลังจากคุณเลือก ไม่อนุญาต คำขอใหม่จากบัญชีนี้จะถูกเพิกเฉยเป็นเวลา 10 นาที และคำขอที่มากเกินไปพร้อมกันก็จะถูกเพิกเฉยด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İzin verme’yi seçtikten sonra bu hesaptan gelen yeni istekler 10 dakika boyunca yok sayılır; aynı anda gelen çok fazla istek de yok sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Після вибору «Не дозволяти» нові запити з цього облікового запису ігноруються 10 хвилин; забагато запитів одночасно теж ігноруються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sau khi bạn chọn Không cho phép, các yêu cầu mới từ tài khoản này sẽ bị bỏ qua trong 10 phút, và quá nhiều yêu cầu cùng lúc cũng bị bỏ qua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "选择“不允许”后，来自此账户的新请求会在 10 分钟内被忽略；同时出现过多请求时也会被忽略。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選擇「不允許」後，來自此帳號的新要求會在 10 分鐘內被忽略；同時出現過多要求時也會被忽略。"
          }
        }
      }
    },
    "iphone.pair.irohBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It can use this Mac’s terminals and agent chats. Remove it in Settings > Mobile to ask again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنه استخدام وحدات الطرفية ومحادثات الوكلاء على هذا الـ Mac. أزله من الإعدادات > الهاتف المحمول لطلب الإذن مجددًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Može koristiti terminale i razgovore s agentima na ovom Macu. Uklonite ga u Postavke > Mobilni uređaji da biste ponovo zatražili dozvolu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kan bruge terminaler og agentchats på denne Mac. Fjern den under Indstillinger > Mobil for at spørge igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es kann die Terminals und Agent-Chats dieses Macs verwenden. Entferne es unter Einstellungen > Mobil, damit erneut gefragt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
