    "iphone.pair.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is signed in as %@. Once allowed, it can open your terminals and agent chats, and approve agent actions with Face ID."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إنه مسجّل الدخول باسم %@. بعد السماح له، يمكنه فتح الطرفيات ومحادثات الوكلاء، والموافقة على إجراءات الوكلاء باستخدام Face ID."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prijavljen je kao %@. Kada ga dozvolite, može otvarati vaše terminale i razgovore s agentima te odobravati radnje agenata putem Face ID-a."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den er logget ind som %@. Når den er tilladt, kan den åbne dine terminaler og agentchats og godkende agenthandlinger med Face ID."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es ist als %@ angemeldet. Nach dem Erlauben kann es deine Terminals und Agent-Chats öffnen und Agent-Aktionen mit Face ID bestätigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiene la sesión iniciada como %@. Una vez permitido, podrá abrir tus terminales y chats de agentes, y aprobar acciones de agentes con Face ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il est connecté en tant que %@. Une fois autorisé, il peut ouvrir vos terminaux et conversations d’agents, et approuver les actions des agents avec Face ID."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ha eseguito l’accesso come %@. Una volta consentito, può aprire i tuoi terminali e le chat degli agenti e approvare le azioni degli agenti con Face ID."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ としてサインインしています。許可すると、ターミナルやエージェントのチャットを開き、Face ID でエージェントの操作を承認できるようになります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "វាបានចូលជា %@។ នៅពេលអនុញ្ញាតហើយ វាអាចបើកទែមីណាល់ និងការជជែកជាមួយភ្នាក់ងាររបស់អ្នក ហើយយល់ព្រមលើសកម្មភាពភ្នាក់ងារដោយប្រើ Face ID។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@(으)로 로그인되어 있습니다. 허용하면 터미널과 에이전트 채팅을 열고 Face ID로 에이전트 작업을 승인할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den er logget på som %@. Når den er tillatt, kan den åpne terminalene og agentchattene dine og godkjenne agenthandlinger med Face ID."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jest zalogowany jako %@. Po zezwoleniu może otwierać Twoje terminale i czaty agentów oraz zatwierdzać działania agentów za pomocą Face ID."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ele está conectado como %@. Depois de permitido, poderá abrir seus terminais e chats de agentes e aprovar ações de agentes com o Face ID."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выполнен вход как %@. После разрешения устройство сможет открывать ваши терминалы и чаты агентов и подтверждать действия агентов с помощью Face ID."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลงชื่อเข้าใช้เป็น %@ เมื่ออนุญาตแล้ว จะเปิดเทอร์มินัลและแชตเอเจนต์ของคุณได้ และอนุมัติการกระทำของเอเจนต์ด้วย Face ID ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ olarak giriş yapmış. İzin verildiğinde terminallerinizi ve ajan sohbetlerinizi açabilir, ajan işlemlerini Face ID ile onaylayabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Виконано вхід як %@. Після дозволу пристрій зможе відкривати ваші термінали й чати агентів і схвалювати дії агентів за допомогою Face ID."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thiết bị đang đăng nhập là %@. Sau khi được cho phép, thiết bị có thể mở terminal và cuộc trò chuyện với agent, đồng thời duyệt hành động của agent bằng Face ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它以 %@ 的身份登录。允许后，它可以打开你的终端和代理聊天，并通过面容 ID 批准代理操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它以 %@ 的身分登入。允許後，它可以開啟你的終端機和代理聊天，並透過 Face ID 核准代理動作。"
          }
        }
      }
    },
