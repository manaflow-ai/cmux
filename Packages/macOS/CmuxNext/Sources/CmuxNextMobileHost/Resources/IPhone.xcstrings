    "iphone.pair.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow “%@” to connect to this Mac?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هل تريد السماح لـ «%@» بالاتصال بهذا الـ Mac؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dozvoliti da se „%@“ poveže s ovim Macom?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vil du tillade, at “%@” forbinder til denne Mac?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%@“ erlauben, sich mit diesem Mac zu verbinden?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Permitir que “%@” se conecte a este Mac?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autoriser « %@ » à se connecter à ce Mac ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consentire a “%@” di connettersi a questo Mac?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”にこの Mac への接続を許可しますか？"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អនុញ្ញាតឱ្យ “%@” តភ្ជាប់ទៅ Mac នេះឬ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”이(가) 이 Mac에 연결하도록 허용하시겠습니까?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vil du tillate at «%@» kobler til denne Macen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zezwolić urządzeniu „%@” na połączenie z tym Makiem?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permitir que “%@” se conecte a este Mac?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Разрешить «%@» подключаться к этому Mac?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อนุญาตให้ “%@” เชื่อมต่อกับ Mac เครื่องนี้หรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” bu Mac’e bağlanabilsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дозволити «%@» підключатися до цього Mac?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cho phép “%@” kết nối với máy Mac này?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "允许“%@”连接到这台 Mac 吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "允許「%@」連線到這台 Mac 嗎？"
          }
        }
      }
    },
