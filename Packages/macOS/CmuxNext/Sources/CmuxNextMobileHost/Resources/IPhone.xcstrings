    "iphone.phones.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No phone has connected with this account yet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يتصل أي هاتف بهذا الحساب بعد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nijedan telefon se još nije povezao s ovim računom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen telefon har forbundet med denne konto endnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mit diesem Konto hat sich noch kein Telefon verbunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ningún teléfono se ha conectado con esta cuenta todavía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun téléphone ne s’est encore connecté avec ce compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessun telefono si è ancora connesso con questo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このアカウントで接続した電話はまだありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនទាន់មានទូរសព្ទណាតភ្ជាប់ជាមួយគណនីនេះនៅឡើយទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "아직 이 계정으로 연결된 휴대폰이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen telefon har koblet til med denne kontoen ennå."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Żaden telefon nie połączył się jeszcze z tym kontem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhum telefone se conectou com esta conta ainda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "С этой учётной записью ещё не подключался ни один телефон."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังไม่มีโทรศัพท์เชื่อมต่อกับบัญชีนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu hesapla henüz hiçbir telefon bağlanmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "З цим обліковим записом ще не підключався жоден телефон."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chưa có điện thoại nào kết nối với tài khoản này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "还没有手机使用此账户连接过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "還沒有手機使用此帳號連線過。"
          }
