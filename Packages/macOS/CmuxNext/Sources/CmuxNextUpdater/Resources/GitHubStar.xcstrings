  "strings": {
    "githubStar.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enjoying cmux?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefällt dir cmux?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous aimez cmux ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Te gusta cmux?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux を気に入っていますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "喜欢 cmux 吗？"
          }
        }
      }
    },
    "githubStar.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give us a star on GitHub to let us know!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib uns einen Stern auf GitHub, um es uns zu zeigen!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez-nous une étoile sur GitHub pour nous le faire savoir !"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Danos una estrella en GitHub para que lo sepamos!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub でスターを付けて教えてください！"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 GitHub 上给我们点个星告诉我们吧！"
          }
        }
      }
    },
    "githubStar.star": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Star on GitHub"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf GitHub markieren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étoile sur GitHub"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estrella en GitHub"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub でスター"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 GitHub 上点星"
          }
        }
      }
    },
    "githubStar.dismiss": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "githubStar.thanks": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanks for the star!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke für den Stern!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci pour l’étoile !"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Gracias por la estrella!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スターありがとうございます！"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感谢点星！"
          }
        }
      }
    },
    "githubStar.thanksDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It really helps cmux grow."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hilft cmux sehr beim Wachsen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela aide vraiment cmux à grandir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda mucho a que cmux crezca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux の成長に本当に役立ちます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这真的能帮助 cmux 成长。"
          }
        }
      }
