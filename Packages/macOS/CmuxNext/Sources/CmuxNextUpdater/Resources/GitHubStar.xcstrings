    "githubStar.message": {
      "comment": "Star prompt toast title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enjoying cmux?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefällt dir cmux?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous aimez cmux ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Te gusta cmux?"
          }
        },
        "ja": {
