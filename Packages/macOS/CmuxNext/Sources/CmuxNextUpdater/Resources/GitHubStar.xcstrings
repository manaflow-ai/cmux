    "githubStar.detail": {
      "comment": "Star prompt toast detail",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give us a star on GitHub to let us know!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib uns einen Stern auf GitHub!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez-nous une étoile sur GitHub !"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Danos una estrella en GitHub!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub でスターをお願いします！"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 GitHub 上给我们点个星吧！"
          }
        }
      }
    },
