          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Genstart for at opdatere. Dine terminaler og agenter fortsætter med at køre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zum Aktualisieren neu starten. Terminals und Agenten laufen weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reinicia para actualizar. Tus terminales y agentes siguen en ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Relancez pour mettre à jour. Vos terminaux et agents continuent de s’exécuter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Riavvia per aggiornare. I terminali e gli agenti restano in esecuzione."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បើកឡើងវិញដើម្បីធ្វើបច្ចុប្បន្នភាព។ Terminal និងភ្នាក់ងាររបស់អ្នកនៅតែដំណើរការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "재실행하여 업데이트하십시오. 터미널과 에이전트는 계속 실행됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Start på nytt for å oppdatere. Terminalene og agentene dine fortsetter å kjøre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uruchom ponownie, aby zaktualizować. Terminale i agenci będą nadal działać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reinicie para atualizar. Seus terminais e agentes continuam em execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перезапустите, чтобы обновить. Терминалы и агенты продолжат работать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิดใหม่เพื่ออัปเดต เทอร์มินัลและเอเจนต์ของคุณยังคงทำงานต่อไป"
