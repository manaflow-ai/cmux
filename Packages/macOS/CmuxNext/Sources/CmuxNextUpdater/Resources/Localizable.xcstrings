        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កំណែនេះគ្មានកូនសោចុះហត្ថលេខាបច្ចុប្បន្នភាពទេ ដូច្នេះវាមិនអាចផ្ទៀងផ្ទាត់បច្ចុប្បន្នភាពបានទេ។"
          }
