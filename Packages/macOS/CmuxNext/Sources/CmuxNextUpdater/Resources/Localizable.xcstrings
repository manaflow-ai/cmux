    "updater.detail.currentVersion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have cmux %@ (%@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のバージョンは cmux %@ (%@) です。"
          }
        }
      }
    },
    "updater.detail.devProbeFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The feed offers %@. This development build never installs updates; the check only read the feed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードには %@ があります。この開発ビルドはアップデートをインストールしません。確認ではフィードを読み取っただけです。"
          }
        }
      }
    },
    "updater.detail.onChannel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux %@ (%@) is the newest %@ build."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux %@ (%@) は %@ の最新ビルドです。"
          }
        }
      }
    },
    "updater.detail.ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relaunch to finish. Terminals keep running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再起動すると完了します。ターミナルは実行を続けます。"
          }
        }
      }
    },
    "updater.detail.requiresMacOS": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux %@ requires macOS %@ or later. This Mac runs macOS %@, so it stays on the current version."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux %@ には macOS %@ 以降が必要です。この Mac は macOS %@ のため、現在のバージョンのままになります。"
          }
        }
      }
    },
    "updater.disabled.cannotSwitch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ build cannot switch to %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ビルドは %@ に切り替えられません。"
          }
        }
      }
    },
    "updater.disabled.development": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Development builds do not install updates."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発ビルドはアップデートをインストールしません。"
          }
        }
      }
    },
    "updater.disabled.managed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your organization manages cmux updates on this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac の cmux アップデートは組織によって管理されています。"
          }
        }
      }
    },
    "updater.disabled.missingKey": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build has no update signing key, so it cannot verify updates."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドにはアップデート署名鍵がないため、アップデートを検証できません。"
          }
        }
      }
    },
    "updater.disabled.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The updater is not available in this build."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドではアップデーターを利用できません。"
          }
        }
      }
    },
