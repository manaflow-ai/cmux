    "updater.preflight.folder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux can't replace itself in %@. Move cmux to Applications, or download the update manually."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يستطيع cmux استبدال نفسه في %@. انقل cmux إلى التطبيقات، أو نزّل التحديث يدويًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux ne može zamijeniti sebe u %@. Premjestite cmux u Applications ili ručno preuzmite ažuriranje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux kan ikke erstatte sig selv i %@. Flyt cmux til Programmer, eller download opdateringen manuelt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux kann sich in %@ nicht ersetzen. Verschiebe cmux in den Ordner „Programme“ oder lade das Update manuell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux no puede reemplazarse en %@. Mueve cmux a Aplicaciones o descarga la actualización manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux ne peut pas se remplacer dans %@. Déplacez cmux dans Applications ou téléchargez la mise à jour manuellement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux non può sostituirsi in %@. Sposta cmux in Applicazioni o scarica l’aggiornamento manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux は %@ で自身を置き換えられません。cmux をアプリケーションフォルダに移動するか、アップデートを手動でダウンロードしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux មិនអាចជំនួសខ្លួនឯងនៅក្នុង %@ បានទេ។ ផ្លាស់ទី cmux ទៅ Applications ឬទាញយកបច្ចុប្បន្នភាពដោយដៃ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux가 %@에서 자신을 교체할 수 없습니다. cmux를 응용 프로그램 폴더로 옮기거나 업데이트를 직접 다운로드하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux kan ikke erstatte seg selv i %@. Flytt cmux til Programmer, eller last ned oppdateringen manuelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux nie może się zastąpić w %@. Przenieś cmux do Aplikacji albo pobierz aktualizację ręcznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cmux não consegue se substituir em %@. Mova o cmux para Aplicativos ou baixe a atualização manualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux не может заменить себя в %@. Переместите cmux в «Программы» или скачайте обновление вручную."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux ไม่สามารถแทนที่ตัวเองใน %@ ได้ ย้าย cmux ไปที่แอปพลิเคชัน หรือดาวน์โหลดอัปเดตด้วยตนเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux kendini %@ içinde değiştiremiyor. cmux’u Uygulamalar’a taşıyın veya güncellemeyi elle indirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux не може замінити себе в %@. Перемістіть cmux у «Програми» або завантажте оновлення вручну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux không thể tự thay thế trong %@. Hãy chuyển cmux vào Ứng dụng hoặc tải bản cập nhật thủ công."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 无法在 %@ 中替换自身。请将 cmux 移到“应用程序”，或手动下载更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 無法在 %@ 中取代自身。請將 cmux 移到「應用程式」，或手動下載更新。"
          }
        }
      }
