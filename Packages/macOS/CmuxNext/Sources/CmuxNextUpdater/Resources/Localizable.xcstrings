            "value": "Güncelleme Yeniden Başlamadı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновлення не перезапустилося"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản cập nhật không khởi chạy lại"
          }
        },
        "zh-Hans": {
