    "server.settings.restart.older": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server runs an older build than the app."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل هذا الخادم بإنشاء أقدم من التطبيق."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj server koristi stariji build od aplikacije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne server kører en ældre build end appen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server läuft mit einem älteren Build als die App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor usa una compilación más antigua que la app."
          }
        },
        "fr": {
