    "server.impact.lost.agents": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lost: running agents end, and their turns in progress are lost."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُفقد: يتوقف الوكلاء قيد التشغيل، وتضيع أدوارهم قيد التنفيذ."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Gubi se: pokrenuti agenti se završavaju, a njihovi potezi u toku se gube."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistes: kørende agenter stopper, og deres igangværende ture går tabt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verloren: laufende Agenten werden beendet, und ihre laufenden Züge gehen verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pierde: los agentes en ejecución terminan y sus turnos en curso se pierden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdu : les agents en cours s’arrêtent et leurs tours en cours sont perdus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si perde: gli agenti in esecuzione terminano e i loro turni in corso vanno persi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失われるもの：実行中のエージェントは終了し、進行中のターンは失われます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បាត់បង់៖ ភ្នាក់ងារដែលកំពុងដំណើរការនឹងបញ្ចប់ ហើយវេនដែលកំពុងដំណើរការនឹងបាត់បង់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손실됨: 실행 중인 에이전트가 종료되고 진행 중인 턴이 사라집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistes: kjørende agenter avsluttes, og pågående turer går tapt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracone: działający agenci kończą pracę, a ich trwające tury przepadają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdido: os agentes em execução terminam e seus turnos em andamento são perdidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теряется: запущенные агенты завершатся, а их текущие ходы будут потеряны."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สูญหาย: เอเจนต์ที่กำลังทำงานจะหยุด และรอบที่กำลังทำอยู่จะหายไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaybolur: çalışan ajanlar sona erer ve devam eden turları kaybolur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Втрачається: запущені агенти завершаться, а їхні поточні ходи буде втрачено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mất: các tác tử đang chạy sẽ dừng và các lượt đang chạy bị mất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "丢失：正在运行的智能体会结束，进行中的回合会丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遺失：執行中的代理程式會結束，進行中的回合會遺失。"
          }
        }
      }
