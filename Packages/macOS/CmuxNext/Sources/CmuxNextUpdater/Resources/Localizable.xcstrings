          "stringUnit": {
            "state": "translated",
            "value": "يتوفر تحديث (%@): انقر لتنزيله وتثبيته"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise à jour disponible (%@) : cliquez pour la télécharger et l’installer"
          }
