        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 빌드에는 업데이트 서명 키가 없어 업데이트를 확인할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne versjonen har ingen signeringsnøkkel for oppdateringer, så den kan ikke verifisere oppdateringer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ta kompilacja nie ma klucza podpisywania aktualizacji, więc nie może ich weryfikować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
