    "updater.notice.stalledDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux waited %lld min for the installer. Your windows are back. Details shows the update log."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux はインストーラを %lld 分待ちました。ウインドウは元に戻りました。「詳細」でアップデートのログを確認できます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتظر cmux المثبّت لمدة %lld دقيقة. عادت نوافذك. يعرض «التفاصيل» سجل التحديث."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux je čekao instaler %lld min. Vaši prozori su vraćeni. Detalji prikazuju zapisnik ažuriranja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ventede %lld min. på installationsprogrammet. Dine vinduer er tilbage. Detaljer viser opdateringsloggen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux hat %lld Min. auf das Installationsprogramm gewartet. Deine Fenster sind zurück. „Details“ zeigt das Update-Protokoll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux esperó al instalador %lld min. Tus ventanas han vuelto. Detalles muestra el registro de la actualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux a attendu le programme d’installation %lld min. Vos fenêtres sont revenues. Détails affiche le journal de mise à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ha atteso il programma di installazione per %lld min. Le finestre sono tornate. Dettagli mostra il registro dell’aggiornamento."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux បានរង់ចាំកម្មវិធីដំឡើង %lld នាទី។ បង្អួចរបស់អ្នកបានត្រឡប់មកវិញ។ «ព័ត៌មានលម្អិត» បង្ហាញកំណត់ហេតុបច្ចុប្បន្នភាព។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 설치 프로그램을 %lld분 동안 기다렸습니다. 윈도우가 다시 표시됩니다. 세부사항에서 업데이트 로그를 볼 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ventet %lld min på installasjonsprogrammet. Vinduene dine er tilbake. Detaljer viser oppdateringsloggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux czekał na instalator %lld min. Okna wróciły. Szczegóły pokazują dziennik aktualizacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux esperou o instalador por %lld min. Suas janelas voltaram. Detalhes mostra o registro da atualização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ждал установщик %lld мин. Окна снова на экране. В разделе «Подробнее» есть журнал обновления."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux รอตัวติดตั้งไป %lld นาที หน้าต่างของคุณกลับมาแล้ว รายละเอียดแสดงบันทึกการอัปเดต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux yükleyiciyi %lld dk bekledi. Pencereleriniz geri geldi. Ayrıntılar güncelleme günlüğünü gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux чекав на інсталятор %lld хв. Вікна знову на екрані. «Докладніше» показує журнал оновлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux đã chờ trình cài đặt %lld phút. Cửa sổ của bạn đã trở lại. Chi tiết hiển thị nhật ký cập nhật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 等待安装器 %lld 分钟。你的窗口已恢复。“详细信息”中可查看更新日志。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 等待安裝程式 %lld 分鐘。你的視窗已恢復。「詳細資訊」中可查看更新記錄。"
          }
        }
      }
    },
