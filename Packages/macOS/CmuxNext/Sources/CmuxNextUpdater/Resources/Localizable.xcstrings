        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បានទាញយកបច្ចុប្បន្នភាព %@ ហើយ។ ចុចដើម្បីចាប់ផ្ដើមឡើងវិញ និងដំឡើង។"
