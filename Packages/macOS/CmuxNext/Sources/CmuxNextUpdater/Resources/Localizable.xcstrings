    "updater.notice.relaunchingDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux relaunches in a moment. Your terminals and agents keep running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux はまもなく再起動します。ターミナルとエージェントは実行を続けます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إعادة تشغيل cmux بعد لحظات. تستمر الطرفيات والوكلاء في العمل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux se uskoro ponovo pokreće. Vaši terminali i agenti nastavljaju raditi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux genstarter om et øjeblik. Dine terminaler og agenter kører videre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux startet gleich neu. Deine Terminals und Agenten laufen weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux se reiniciará en un momento. Tus terminales y agentes siguen funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux redémarre dans un instant. Vos terminaux et agents continuent de tourner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux si riavvia tra un momento. I terminali e gli agenti continuano a funzionare."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux នឹងបើកឡើងវិញក្នុងពេលបន្តិចទៀត។ ទែមីណល់ និងភ្នាក់ងាររបស់អ្នកនៅតែដំណើរការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 곧 다시 시작됩니다. 터미널과 에이전트는 계속 실행됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux starter på nytt om et øyeblikk. Terminalene og agentene dine fortsetter å kjøre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux za chwilę uruchomi się ponownie. Terminale i agenci nadal działają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux será reiniciado em instantes. Seus terminais e agentes continuam rodando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux сейчас перезапустится. Терминалы и агенты продолжат работу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux จะเปิดใหม่ในอีกสักครู่ เทอร์มินัลและเอเจนต์ของคุณยังทำงานต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux birazdan yeniden başlıyor. Terminalleriniz ve ajanlarınız çalışmaya devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux зараз перезапуститься. Термінали й агенти продовжать працювати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux sẽ khởi động lại trong giây lát. Terminal và agent của bạn vẫn tiếp tục chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 即将重新启动。你的终端和代理会继续运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 即將重新啟動。你的終端機和代理會繼續執行。"
          }
        }
      }
    },
    "updater.notice.checkingNewVersion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The installer checks the new version (%lld s). cmux relaunches when it is done. Your terminals and agents keep running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストーラが新しいバージョンを確認しています（%lld 秒）。完了すると cmux が再起動します。ターミナルとエージェントは実行を続けます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحقق المثبّت من الإصدار الجديد (%lld ث). ستتم إعادة تشغيل cmux عند الانتهاء. تستمر الطرفيات والوكلاء في العمل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaler provjerava novu verziju (%lld s). cmux se ponovo pokreće kada završi. Vaši terminali i agenti nastavljaju raditi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Installationsprogrammet tjekker den nye version (%lld s). cmux genstarter, når det er færdigt. Dine terminaler og agenter kører videre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Installationsprogramm prüft die neue Version (%lld s). cmux startet neu, sobald es fertig ist. Deine Terminals und Agenten laufen weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El instalador comprueba la nueva versión (%lld s). cmux se reinicia cuando termina. Tus terminales y agentes siguen funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le programme d’installation vérifie la nouvelle version (%lld s). cmux se relance une fois terminé. Vos terminaux et agents continuent de tourner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il programma di installazione controlla la nuova versione (%lld s). cmux si riavvia al termine. Terminali e agenti continuano a funzionare."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កម្មវិធីដំឡើងកំពុងពិនិត្យកំណែថ្មី (%lld វិនាទី)។ cmux នឹងបើកឡើងវិញពេលរួចរាល់។ ទែមីណាល់ និងភ្នាក់ងាររបស់អ្នកនៅតែដំណើរការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치 프로그램이 새 버전을 확인하는 중입니다(%lld초). 완료되면 cmux가 다시 실행됩니다. 터미널과 에이전트는 계속 실행됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Installasjonsprogrammet sjekker den nye versjonen (%lld s). cmux starter på nytt når det er ferdig. Terminalene og agentene dine fortsetter å kjøre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalator sprawdza nową wersję (%lld s). cmux uruchomi się ponownie po zakończeniu. Terminale i agenci nadal działają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O instalador verifica a nova versão (%lld s). O cmux reabre quando terminar. Seus terminais e agentes continuam em execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установщик проверяет новую версию (%lld с). cmux перезапустится, когда проверка завершится. Терминалы и агенты продолжают работать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวติดตั้งกำลังตรวจสอบเวอร์ชันใหม่ (%lld วินาที) cmux จะเปิดใหม่เมื่อเสร็จ เทอร์มินัลและเอเจนต์ของคุณยังทำงานต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yükleyici yeni sürümü denetliyor (%lld sn). Bittiğinde cmux yeniden başlar. Terminalleriniz ve ajanlarınız çalışmaya devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інсталятор перевіряє нову версію (%lld с). cmux перезапуститься, коли перевірку завершено. Термінали й агенти продовжують працювати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình cài đặt đang kiểm tra phiên bản mới (%lld giây). cmux khởi chạy lại khi xong. Terminal và agent của bạn vẫn tiếp tục chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装器正在检查新版本（%lld 秒）。完成后 cmux 将重新启动。你的终端和代理会继续运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝程式正在檢查新版本（%lld 秒）。完成後 cmux 會重新啟動。你的終端機和代理程式會繼續執行。"
          }
        }
      }
    },
    "updater.notice.stalledTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update Did Not Relaunch"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデート後に再起動しませんでした"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتم إعادة التشغيل بعد التحديث"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ažuriranje se nije ponovo pokrenulo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdateringen genstartede ikke"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Update hat nicht neu gestartet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización no se reinició"
          }
        },
        "fr": {
          "stringUnit": {
