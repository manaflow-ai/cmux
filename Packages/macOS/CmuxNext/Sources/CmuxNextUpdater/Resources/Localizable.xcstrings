          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បច្ចុប្បន្នភាពមិនបានបើកឡើងវិញទេ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트 후 재실행되지 않음"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppdateringen startet ikke på nytt"
          }
        },
        "pl": {
