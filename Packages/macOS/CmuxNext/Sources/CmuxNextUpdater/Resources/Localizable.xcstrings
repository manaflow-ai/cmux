    "updater.detail.requiresMacOS": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux %@ requires macOS %@ or later. This Mac runs macOS %@, so it stays on the current version."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux %@ には macOS %@ 以降が必要です。この Mac は macOS %@ のため、現在のバージョンのままになります。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتطلب cmux %@ نظام macOS %@ أو أحدث. يعمل هذا الـ Mac بنظام macOS %@، لذا سيبقى على الإصدار الحالي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
