    "server.impact.kept.terminals": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept: every terminal, its shell, running programs and scrollback."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى: كل طرفية وصدفتها والبرامج قيد التشغيل وسجل التمرير."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadržava se: svaki terminal, njegova ljuska, pokrenuti programi i historija pomicanja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevares: alle terminaler, deres shell, kørende programmer og rullehistorik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt erhalten: jedes Terminal, seine Shell, laufende Programme und der Scrollback."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conserva: cada terminal, su shell, los programas en ejecución y el historial de desplazamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservé : chaque terminal, son shell, les programmes en cours et l’historique de défilement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta: ogni terminale, la sua shell, i programmi in esecuzione e la cronologia di scorrimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保持されるもの：すべてのターミナル、そのシェル、実行中のプログラム、スクロールバック。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រក្សាទុក៖ ទែមីណាល់នីមួយៗ សែលរបស់វា កម្មវិធីកំពុងដំណើរការ និងប្រវត្តិរំកិល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유지됨: 모든 터미널, 셸, 실행 중인 프로그램, 스크롤백."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beholdes: alle terminaler, skallet, kjørende programmer og rullehistorikk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaje: każdy terminal, jego powłoka, uruchomione programy i historia przewijania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantido: cada terminal, seu shell, os programas em execução e o histórico de rolagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняется: каждый терминал, его оболочка, запущенные программы и история прокрутки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คงไว้: ทุกเทอร์มินัล เชลล์ โปรแกรมที่กำลังทำงาน และประวัติการเลื่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Korunur: her terminal, kabuğu, çalışan programlar ve kaydırma geçmişi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігається: кожен термінал, його оболонка, запущені програми та історія прокручування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ lại: mọi terminal, shell, chương trình đang chạy và lịch sử cuộn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留：所有终端及其 shell、正在运行的程序和回滚内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留：所有終端機及其 shell、執行中的程式和捲動記錄。"
          }
        }
      }
    },
    "server.impact.lost.reconnect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lost: a short reconnect. A CLI command running at that moment fails and can be run again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُفقد: إعادة اتصال قصيرة. يفشل أمر CLI قيد التشغيل في تلك اللحظة ويمكن تشغيله مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Gubi se: kratko ponovno povezivanje. CLI komanda koja se tada izvršava ne uspije i može se ponovo pokrenuti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistes: en kort genforbindelse. En CLI-kommando, der kører i det øjeblik, mislykkes og kan køres igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verloren: eine kurze Neuverbindung. Ein CLI-Befehl, der in diesem Moment läuft, schlägt fehl und kann erneut ausgeführt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pierde: una breve reconexión. Un comando de CLI en ejecución en ese momento falla y se puede volver a ejecutar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdu : une brève reconnexion. Une commande CLI en cours à ce moment échoue et peut être relancée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si perde: una breve riconnessione. Un comando CLI in esecuzione in quel momento fallisce e può essere rieseguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失われるもの：短い再接続のみ。その瞬間に実行中の CLI コマンドは失敗しますが、再実行できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បាត់បង់៖ ការភ្ជាប់ឡើងវិញខ្លី។ ពាក្យបញ្ជា CLI ដែលកំពុងដំណើរការនៅពេលនោះនឹងបរាជ័យ ហើយអាចដំណើរការម្ដងទៀតបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손실됨: 짧은 재연결. 그 순간 실행 중인 CLI 명령은 실패하며 다시 실행할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistes: en kort ny tilkobling. En CLI-kommando som kjører i det øyeblikket, mislykkes og kan kjøres på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracone: krótkie ponowne połączenie. Polecenie CLI działające w tym momencie nie powiedzie się i można je uruchomić ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdido: uma breve reconexão. Um comando de CLI em execução nesse momento falha e pode ser executado de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теряется: короткое переподключение. Команда CLI, выполняемая в этот момент, завершится ошибкой, и её можно запустить снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สูญหาย: การเชื่อมต่อใหม่ชั่วครู่ คำสั่ง CLI ที่ทำงานอยู่ขณะนั้นจะล้มเหลวและเรียกใช้ใหม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaybolur: kısa bir yeniden bağlanma. O anda çalışan bir CLI komutu başarısız olur ve yeniden çalıştırılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Втрачається: коротке перепідключення. Команда CLI, що виконується в цей момент, завершиться помилкою, і її можна запустити знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mất: một lần kết nối lại ngắn. Lệnh CLI đang chạy lúc đó sẽ thất bại và có thể chạy lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "丢失：短暂的重新连接。此时正在运行的 CLI 命令会失败，可以重新运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遺失：短暫的重新連線。此時正在執行的 CLI 指令會失敗，可以重新執行。"
          }
        }
      }
    },
    "server.impact.kept.agents": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept: every agent session and its history. Agents keep running."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى: كل جلسة وكيل وسجلها. يستمر الوكلاء في العمل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadržava se: svaka sesija agenta i njena historija. Agenti nastavljaju raditi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevares: alle agentsessioner og deres historik. Agenter fortsætter med at køre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt erhalten: jede Agentensitzung und ihr Verlauf. Agenten laufen weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conserva: cada sesión de agente y su historial. Los agentes siguen funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservé : chaque session d’agent et son historique. Les agents continuent de tourner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta: ogni sessione di agente e la sua cronologia. Gli agenti continuano a funzionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保持されるもの：すべてのエージェントセッションとその履歴。エージェントは動作し続けます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រក្សាទុក៖ វគ្គភ្នាក់ងារនីមួយៗ និងប្រវត្តិរបស់វា។ ភ្នាក់ងារបន្តដំណើរការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유지됨: 모든 에이전트 세션과 기록. 에이전트는 계속 실행됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beholdes: alle agentøkter og loggen deres. Agentene fortsetter å kjøre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaje: każda sesja agenta i jej historia. Agenci działają dalej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantido: cada sessão de agente e seu histórico. Os agentes continuam em execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняется: каждая сессия агента и её история. Агенты продолжают работать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คงไว้: ทุกเซสชันเอเจนต์และประวัติ เอเจนต์ยังทำงานต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Korunur: her ajan oturumu ve geçmişi. Ajanlar çalışmaya devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігається: кожен сеанс агента та його історія. Агенти продовжують працювати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ lại: mọi phiên tác tử và lịch sử. Tác tử vẫn tiếp tục chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留：所有智能体会话及其历史记录。智能体继续运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留：所有代理程式工作階段及其記錄。代理程式會繼續執行。"
          }
        }
      }
    },
    "server.impact.lost.turns": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lost: a Chief or agent turn in progress may stop."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُفقد: قد يتوقف دور قيد التنفيذ لـ Chief أو لوكيل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Gubi se: potez Chiefa ili agenta u toku može stati."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistes: en igangværende tur for Chief eller en agent kan stoppe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verloren: ein laufender Zug von Chief oder einem Agenten kann anhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pierde: un turno en curso de Chief o de un agente puede detenerse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdu : un tour en cours de Chief ou d’un agent peut s’arrêter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si perde: un turno in corso di Chief o di un agente può interrompersi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失われるもの：進行中の Chief やエージェントのターンが止まる場合があります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បាត់បង់៖ វេនរបស់ Chief ឬភ្នាក់ងារដែលកំពុងដំណើរការអាចឈប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손실됨: 진행 중인 Chief 또는 에이전트 턴이 멈출 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistes: en pågående tur for Chief eller en agent kan stoppe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracone: trwająca tura Chiefa lub agenta może się zatrzymać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdido: um turno em andamento do Chief ou de um agente pode parar."
          }
