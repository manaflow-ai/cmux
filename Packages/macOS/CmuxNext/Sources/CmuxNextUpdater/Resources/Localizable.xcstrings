    "updater.pill.restartKeepsSessions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart to update. Your terminals and agents keep running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再起動してアップデートします。ターミナルとエージェントは実行を続けます。"
