            "state": "translated",
            "value": "Ce serveur utilise un build plus ancien que l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo server usa una build più vecchia dell’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーはアプリより古いビルドで動作しています。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម៉ាស៊ីនមេនេះដំណើរការជាមួយប៊ីលចាស់ជាងកម្មវិធី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버는 앱보다 오래된 빌드로 실행 중입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne serveren kjører et eldre bygg enn appen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten serwer działa na starszej kompilacji niż aplikacja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor usa um build mais antigo que o app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот сервер работает на более старой сборке, чем приложение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์นี้ใช้บิลด์เก่ากว่าแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sunucu, uygulamadan daha eski bir derlemeyle çalışıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей сервер працює на старішій збірці, ніж застосунок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ này chạy bản dựng cũ hơn ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器运行的构建比应用更旧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此伺服器執行的建置比 App 更舊。"
          }
        }
      }
