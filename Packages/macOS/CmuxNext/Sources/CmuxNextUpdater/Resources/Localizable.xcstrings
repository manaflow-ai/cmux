    "updater.button.updateAvailableNamed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update Available (%@): Click to Download and Install"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有可用更新（%@）：按一下以下載並安裝"
