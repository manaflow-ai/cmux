    "updater.pulled.nothingKept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fixed build installs by itself as soon as it is published."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يُثبَّت الإصدار المُصلَح تلقائيًا فور نشره."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ispravljena verzija se sama instalira čim bude objavljena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den rettede version installerer sig selv, så snart den udgives."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der korrigierte Build installiert sich selbst, sobald er veröffentlicht ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La versión corregida se instala sola en cuanto se publica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La version corrigée s’installera d’elle-même dès sa publication."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La build corretta si installa da sola appena viene pubblicata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修正版は公開され次第、自動でインストールされます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កំណែដែលបានជួសជុលនឹងដំឡើងដោយខ្លួនឯង ភ្លាមៗពេលចេញផ្សាយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "수정된 빌드는 게시되는 즉시 자동으로 설치됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den rettede versjonen installerer seg selv så snart den er publisert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poprawiona wersja zainstaluje się sama zaraz po publikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A versão corrigida se instala sozinha assim que for publicada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Исправленная сборка установится сама, как только выйдет."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "บิลด์ที่แก้ไขแล้วจะติดตั้งเองทันทีที่เผยแพร่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Düzeltilmiş sürüm yayımlanır yayımlanmaz kendiliğinden kurulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Виправлена збірка встановиться сама, щойно її опублікують."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bản sửa sẽ tự cài đặt ngay khi được phát hành."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "修复版本一发布就会自动安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "修正版本一發布就會自動安裝。"
          }
        }
      }
    },
    "updater.pulled.kept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll back to %@, the build this Mac kept, or keep this one until the fixed build installs by itself."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ارجع إلى %@، الإصدار المحفوظ على هذا الـ Mac، أو احتفظ بهذا حتى يُثبَّت الإصدار المُصلَح تلقائيًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vrati se na %@, verziju koju je ovaj Mac sačuvao, ili zadrži ovu dok se ispravljena verzija sama ne instalira."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gå tilbage til %@, den version denne Mac har gemt, eller behold denne, indtil den rettede version installerer sig selv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zu %@ zurückkehren, dem auf diesem Mac behaltenen Build, oder diesen behalten, bis sich der korrigierte Build selbst installiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vuelve a %@, la versión que guardó este Mac, o conserva esta hasta que la versión corregida se instale sola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Revenez à %@, la version conservée sur ce Mac, ou gardez celle-ci jusqu’à ce que la version corrigée s’installe d’elle-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Torna a %@, la build conservata su questo Mac, oppure tieni questa finché la build corretta non si installa da sola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacに保存されている %@ に戻すか、修正版が自動でインストールされるまでこのビルドを使い続けます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ត្រឡប់ទៅ %@ ដែល Mac នេះរក្សាទុក ឬរក្សាកំណែនេះរហូតដល់កំណែដែលបានជួសជុលដំឡើងដោយខ្លួនឯង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 Mac에 보관된 %@(으)로 되돌리거나, 수정된 빌드가 자동으로 설치될 때까지 이 빌드를 유지하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gå tilbake til %@, versjonen denne Macen har tatt vare på, eller behold denne til den rettede versjonen installerer seg selv."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wróć do %@, wersji zachowanej na tym Macu, lub zostań przy tej, aż poprawiona wersja zainstaluje się sama."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volte para %@, a versão guardada neste Mac, ou mantenha esta até a versão corrigida se instalar sozinha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Откатитесь на %@, сохранённую на этом Mac, или оставьте эту сборку, пока исправленная не установится сама."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ย้อนกลับไปที่ %@ ซึ่ง Mac เครื่องนี้เก็บไว้ หรือใช้บิลด์นี้ต่อจนกว่าบิลด์ที่แก้ไขแล้วจะติดตั้งเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu Mac’in sakladığı %@ sürümüne geri dönün ya da düzeltilmiş sürüm kendiliğinden kurulana kadar bunu kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Поверніться до %@, збірки, яку зберіг цей Mac, або залиште цю, доки виправлена збірка не встановиться сама."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quay lại %@, bản mà máy Mac này đã giữ, hoặc giữ bản này cho đến khi bản sửa tự cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "回退到此 Mac 保留的 %@，或继续使用此版本，直到修复版本自动安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "回復到此 Mac 保留的 %@，或繼續使用此版本，直到修正版本自動安裝。"
          }
        }
      }
    },
