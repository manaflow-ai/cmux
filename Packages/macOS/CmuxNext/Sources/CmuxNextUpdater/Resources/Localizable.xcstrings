            "value": "احفظ هذا التخطيط وافتحه مرة أخرى بخطوة واحدة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sačuvajte ovaj raspored i ponovo ga otvorite jednim korakom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gem dette layout, og åbn det igen i ét trin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Speichere dieses Layout und öffne es mit einem Schritt wieder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Guarda este diseño y ábrelo de nuevo en un solo paso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enregistrez cette disposition et rouvrez-la en une étape."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salva questo layout e riaprilo in un solo passaggio."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "រក្សាទុកប្លង់នេះ ហើយបើកវាម្ដងទៀតក្នុងជំហានតែមួយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 레이아웃을 저장하고 한 번에 다시 여세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lagre dette oppsettet og åpne det igjen i ett steg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zapisz ten układ i otwórz go ponownie jednym krokiem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salve este layout e abra-o de novo em uma etapa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сохраните эту раскладку и откройте её снова за один шаг."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "บันทึกเลย์เอาต์นี้แล้วเปิดใหม่ได้ในขั้นตอนเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
