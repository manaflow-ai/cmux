        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux %@에는 macOS %@ 이상이 필요합니다. 이 Mac은 macOS %@을(를) 실행 중이므로 현재 버전을 유지합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux %@ krever macOS %@ eller nyere. Denne Macen kjører macOS %@, så den blir værende på gjeldende versjon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux %@ wymaga systemu macOS %@ lub nowszego. Ten Mac ma macOS %@, więc pozostaje przy bieżącej wersji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cmux %@ requer o macOS %@ ou posterior. Este Mac usa o macOS %@, por isso continua na versão atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для cmux %@ требуется macOS %@ или новее. На этом Mac установлена macOS %@, поэтому остается текущая версия."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux %@ ต้องใช้ macOS %@ ขึ้นไป Mac เครื่องนี้ใช้ macOS %@ จึงยังคงใช้รุ่นปัจจุบัน"
