          "stringUnit": {
            "state": "translated",
            "value": "Ponovo se pokreće jednom u %@, sačuvanu na ovom Macu. Postavke i sesije ostaju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genstarter én gang til %@, gemt på denne Mac. Indstillinger og sessioner bevares."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet einmal neu in %@, auf diesem Mac aufbewahrt. Einstellungen und Sitzungen bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reinicia una vez en %@, guardada en este Mac. Los ajustes y las sesiones se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redémarre une fois sur %@, conservée sur ce Mac. Les réglages et les sessions restent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si riavvia una volta in %@, conservata su questo Mac. Impostazioni e sessioni restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacに保存された%@で一度だけ再起動します。設定とセッションはそのままです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចាប់ផ្ដើមឡើងវិញម្ដងទៅ %@ ដែលរក្សាទុកលើ Mac នេះ។ ការកំណត់ និងវគ្គនៅដដែល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에 보관된 %@(으)로 한 번 재시작합니다. 설정과 세션은 그대로 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Starter på nytt én gang i %@, lagret på denne Macen. Innstillinger og økter beholdes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchamia się ponownie raz w %@, zachowanej na tym Macu. Ustawienia i sesje zostają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia uma vez em %@, guardada neste Mac. Os ajustes e as sessões continuam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один раз перезапускается в %@, сохранённой на этом Mac. Настройки и сеансы остаются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีสตาร์ตหนึ่งครั้งเข้าสู่ %@ ที่เก็บไว้ใน Mac เครื่องนี้ การตั้งค่าและเซสชันยังคงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'te saklanan %@ sürümüne bir kez yeniden başlar. Ayarlar ve oturumlar kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один раз перезапускається в %@, збережену на цьому Mac. Налаштування й сеанси залишаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khởi động lại một lần vào %@ được giữ trên máy Mac này. Cài đặt và phiên vẫn giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新启动一次，进入此 Mac 保留的 %@。设置和会话保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新啟動一次，進入此 Mac 保留的 %@。設定和工作階段保持不變。"
          }
        }
      }
    },
    "updater.channels.waits": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac stays on %1$@ until %2$@ reaches a newer build."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى هذا الـ Mac على %1$@ حتى تصل %2$@ إلى إصدار أحدث."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj Mac ostaje na %1$@ dok %2$@ ne dobije noviju verziju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac bliver på %1$@, indtil %2$@ når et nyere build."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac bleibt auf %1$@, bis %2$@ einen neueren Build erreicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac se queda en %1$@ hasta que %2$@ llegue a una compilación más nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac reste sur %1$@ jusqu'à ce que %2$@ atteigne une version plus récente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac resta su %1$@ finché %2$@ non raggiunge una build più recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@がより新しいビルドに達するまで、このMacは%1$@のままです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac នេះនៅលើ %1$@ រហូតដល់ %2$@ ទៅដល់កំណែថ្មីជាង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@에 더 새로운 빌드가 올 때까지 이 Mac은 %1$@에 머뭅니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Macen blir på %1$@ til %2$@ når en nyere build."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac zostaje na %1$@, dopóki %2$@ nie osiągnie nowszej kompilacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac fica em %1$@ até que %2$@ chegue a uma build mais nova."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac остаётся на %1$@, пока %2$@ не получит более новую сборку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac เครื่องนี้จะอยู่ที่ %1$@ จนกว่า %2$@ จะมีบิลด์ที่ใหม่กว่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac, %2$@ daha yeni bir derlemeye ulaşana kadar %1$@ sürümünde kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей Mac залишається на %1$@, доки %2$@ не отримає новішу збірку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac này giữ ở %1$@ cho đến khi %2$@ có bản dựng mới hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 会停留在 %1$@，直到 %2$@ 有更新的版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 會停留在 %1$@，直到 %2$@ 有更新的版本。"
          }
        }
      }
    },
    "updater.channels.goBackGone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That kept build is no longer the way back."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد ذلك الإصدار المحفوظ طريق العودة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta sačuvana verzija više nije put nazad."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gemte build er ikke længere vejen tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser aufbewahrte Build ist nicht mehr der Weg zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa compilación guardada ya no es el camino de vuelta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version conservée n'est plus le chemin du retour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quella build conservata non è più la via del ritorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その保存済みビルドはもう戻り先ではありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កំណែដែលរក្សាទុកនោះ មិនមែនជាផ្លូវត្រឡប់វិញទៀតទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관된 그 빌드는 더 이상 돌아갈 곳이 아닙니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lagrede builden er ikke lenger veien tilbake."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta zachowana kompilacja nie jest już drogą powrotu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa build guardada não é mais o caminho de volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта сохранённая сборка больше не путь назад."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บิลด์ที่เก็บไว้นั้นไม่ใช่ทางกลับอีกต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saklanan o derleme artık geri dönüş yolu değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця збережена збірка більше не шлях назад."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản dựng được giữ đó không còn là đường quay lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那个保留的版本已不再是返回的途径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "那個保留的版本已不再是返回的途徑。"
          }
        }
      }
    },
