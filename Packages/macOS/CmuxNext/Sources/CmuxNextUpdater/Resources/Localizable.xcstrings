    "updater.tip.zoomPane.benefit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill the window with one pane, then go back to the split."
          }
        },
        "ja": {
