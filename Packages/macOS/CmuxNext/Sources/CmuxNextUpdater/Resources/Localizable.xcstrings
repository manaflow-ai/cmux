        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Feed ផ្ដល់ %@។ កំណែអភិវឌ្ឍនេះមិនដែលដំឡើងបច្ចុប្បន្នភាពទេ; ការពិនិត្យគ្រាន់តែអាន Feed ប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "피드에 %@이(가) 있습니다. 이 개발 빌드는 업데이트를 설치하지 않으며, 확인 과정에서는 피드만 읽었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
