    "cookieBackups.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لن يتمكن الوكيل بعد ذلك من التراجع عن مسح ملفات تعريف الارتباط هذه. لا يمكنك التراجع عن هذا الإجراء."
          }
