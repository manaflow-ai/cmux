    "titlebarHistory.closedUnavailable": {
      "comment": "Disabled row of the Recently Closed section in the titlebar Back/Forward list while no connected machine serves closed history.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تظهر العناصر المغلقة بمجرد اتصال cmux"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zatvorene stavke pojavljuju se kada se cmux poveže"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lukkede elementer vises, når cmux er forbundet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geschlossene Elemente erscheinen, sobald cmux verbunden ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closed items appear once cmux connects"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los elementos cerrados aparecen cuando cmux se conecta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les éléments fermés apparaissent une fois cmux connecté"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli elementi chiusi compaiono quando cmux si connette"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux が接続されると閉じた項目が表示されます"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ធាតុដែលបានបិទនឹងបង្ហាញនៅពេល cmux ភ្ជាប់"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux가 연결되면 닫은 항목이 표시됩니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lukkede elementer vises når cmux kobler til"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zamknięte elementy pojawią się po połączeniu cmux"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os itens fechados aparecem quando o cmux se conecta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Закрытые элементы появятся после подключения cmux"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "รายการที่ปิดจะแสดงเมื่อ cmux เชื่อมต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kapatılan öğeler cmux bağlandığında görünür"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Закриті елементи з’являться після підключення cmux"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các mục đã đóng sẽ hiện khi cmux kết nối"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 连接后将显示已关闭的项目"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 連線後將顯示已關閉的項目"
          }
        }
      }
    },
    "titlebarHistory.nothingClosed": {
