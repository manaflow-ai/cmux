        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tác nhân sẽ không thể hoàn tác các lần xóa cookie này nữa. Bạn không thể hoàn tác thao tác này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
