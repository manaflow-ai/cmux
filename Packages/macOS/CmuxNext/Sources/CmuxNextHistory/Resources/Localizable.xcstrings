    "page.disconnected": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "السجل غير متاح حتى يعيد cmux الاتصال."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Historija nije dostupna dok se cmux ponovo ne poveže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Historikken er ikke tilgængelig, før cmux genopretter forbindelsen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Verlauf ist erst verfügbar, wenn cmux wieder verbunden ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History is not available until cmux reconnects."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El historial no está disponible hasta que cmux se vuelva a conectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’historique n’est pas disponible tant que cmux ne s’est pas reconnecté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La cronologia non è disponibile finché cmux non si riconnette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux が再接続するまで履歴は使用できません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ប្រវត្តិមិនអាចប្រើបានទេ រហូតដល់ cmux ភ្ជាប់ឡើងវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux가 다시 연결될 때까지 기록을 사용할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Loggen er ikke tilgjengelig før cmux kobler til igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Historia jest niedostępna, dopóki cmux nie połączy się ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O histórico não está disponível até que o cmux se reconecte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "История недоступна, пока cmux не подключится снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ประวัติจะใช้ไม่ได้จนกว่า cmux จะเชื่อมต่ออีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux yeniden bağlanana kadar geçmiş kullanılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Історія недоступна, доки cmux не підключиться знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lịch sử không khả dụng cho đến khi cmux kết nối lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在 cmux 重新连接之前，历史记录不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在 cmux 重新連線之前，無法使用歷史記錄。"
          }
        }
      }
    }
