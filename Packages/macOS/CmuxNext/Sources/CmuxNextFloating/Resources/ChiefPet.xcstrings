    "chiefPet.upload.limits": {
      "comment": "Chief pet: why an uploaded picture was refused, naming the accepted types and size limits.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a PNG, JPEG, WebP, HEIC or GIF up to 20 MB. A moving GIF can be at most 512 KB and 256 × 256 pixels."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "استخدم PNG أو JPEG أو WebP أو HEIC أو GIF بحجم 20 ميغابايت كحد أقصى. يمكن أن يكون GIF المتحرك 512 كيلوبايت و256 × 256 بكسل كحد أقصى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koristite PNG, JPEG, WebP, HEIC ili GIF do 20 MB. Animirani GIF može imati najviše 512 KB i 256 × 256 piksela."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brug en PNG, JPEG, WebP, HEIC eller GIF på op til 20 MB. En animeret GIF må højst være 512 KB og 256 × 256 pixel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verwende PNG, JPEG, WebP, HEIC oder GIF bis 20 MB. Ein animiertes GIF darf höchstens 512 KB und 256 × 256 Pixel groß sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa un PNG, JPEG, WebP, HEIC o GIF de hasta 20 MB. Un GIF animado puede tener como máximo 512 KB y 256 × 256 píxeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilisez un PNG, JPEG, WebP, HEIC ou GIF de 20 Mo au maximum. Un GIF animé peut faire au plus 512 Ko et 256 × 256 pixels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa un PNG, JPEG, WebP, HEIC o GIF fino a 20 MB. Una GIF animata può avere al massimo 512 KB e 256 × 256 pixel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "20 MBまでのPNG、JPEG、WebP、HEIC、GIFを使ってください。動くGIFは512 KB、256 × 256ピクセルまでです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ប្រើ PNG, JPEG, WebP, HEIC ឬ GIF ទំហំមិនលើស 20 MB។ GIF មានចលនាអាចមានទំហំអតិបរមា 512 KB និង 256 × 256 ភីកសែល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "20MB 이하의 PNG, JPEG, WebP, HEIC 또는 GIF를 사용하세요. 움직이는 GIF는 최대 512KB, 256 × 256픽셀입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bruk en PNG, JPEG, WebP, HEIC eller GIF på opptil 20 MB. En animert GIF kan være maks 512 KB og 256 × 256 piksler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Użyj pliku PNG, JPEG, WebP, HEIC lub GIF do 20 MB. Animowany GIF może mieć najwyżej 512 KB i 256 × 256 pikseli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use um PNG, JPEG, WebP, HEIC ou GIF de até 20 MB. Um GIF animado pode ter no máximo 512 KB e 256 × 256 pixels."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Используйте PNG, JPEG, WebP, HEIC или GIF размером до 20 МБ. Анимированный GIF — не более 512 КБ и 256 × 256 пикселей."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ใช้ไฟล์ PNG, JPEG, WebP, HEIC หรือ GIF ขนาดไม่เกิน 20 MB ส่วน GIF เคลื่อนไหวต้องไม่เกิน 512 KB และ 256 × 256 พิกเซล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En fazla 20 MB boyutunda bir PNG, JPEG, WebP, HEIC veya GIF kullan. Hareketli bir GIF en fazla 512 KB ve 256 × 256 piksel olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Використовуйте PNG, JPEG, WebP, HEIC або GIF до 20 МБ. Анімований GIF — щонайбільше 512 КБ і 256 × 256 пікселів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dùng tệp PNG, JPEG, WebP, HEIC hoặc GIF tối đa 20 MB. GIF động tối đa 512 KB và 256 × 256 pixel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请使用不超过 20 MB 的 PNG、JPEG、WebP、HEIC 或 GIF。动态 GIF 最大 512 KB、256 × 256 像素。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請使用不超過 20 MB 的 PNG、JPEG、WebP、HEIC 或 GIF。動態 GIF 最大 512 KB、256 × 256 像素。"
          }
        }
      }
    },
