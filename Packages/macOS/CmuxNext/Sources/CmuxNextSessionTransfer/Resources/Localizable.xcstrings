          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要结束另一个版本中的这些终端吗？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 빌드의 이 터미널들을 종료할까요?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のビルドのこれらのターミナルを終了しますか？"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Završiti ove terminale u drugoj verziji?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Afslut disse terminaler i det andet build?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminare questi terminali nell’altra build?"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បញ្ចប់ Terminal ទាំងនេះនៅក្នុង build ផ្សេងទៀតឬ?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avslutte disse terminalene i det andre bygget?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zakończyć te terminale w drugiej kompilacji?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Encerrar estes terminais na outra compilação?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Завершить эти терминалы в другой сборке?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สิ้นสุดเทอร์มินัลเหล่านี้ในบิลด์อื่นหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu terminaller diğer derlemede sonlandırılsın mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Завершити ці термінали в іншій збірці?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kết thúc các terminal này trong bản dựng kia?"
          }
        }
      }
    },
