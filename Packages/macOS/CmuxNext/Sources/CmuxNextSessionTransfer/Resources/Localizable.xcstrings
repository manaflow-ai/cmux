          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動できるセッションがある別の cmux ビルドはありません。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nijedna druga cmux verzija nema sesije za premještanje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Intet andet cmux-build har sessioner, der kan flyttes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessun’altra build di cmux ha sessioni da spostare."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្មាន cmux build ផ្សេងទៀតមានវគ្គដើម្បីផ្លាស់ទីទេ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen andre cmux-bygg har økter å flytte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Żadna inna kompilacja cmux nie ma sesji do przeniesienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhuma outra compilação do cmux tem sessões para mover."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ни в одной другой сборке cmux нет сеансов для переноса."
