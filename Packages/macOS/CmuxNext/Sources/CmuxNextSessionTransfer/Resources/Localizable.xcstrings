{
  "sourceLanguage": "en",
  "strings": {
    "sessionMove.dialog.title": {
      "comment": "Title of the Move Sessions from Another cmux Build dialog, which lists the live sessions of other cmux builds on this Mac with a check box each.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Sessions from Another cmux Build"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzungen aus einem anderen cmux-Build verschieben"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer les sessions d’un autre build de cmux"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقل الجلسات من إصدار cmux آخر"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover sesiones desde otra compilación de cmux"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從其他 cmux 版本移入工作階段"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从其他 cmux 版本移入会话"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 cmux 빌드에서 세션 옮기기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の cmux ビルドからセッションを移動"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Premjesti sesije iz druge cmux verzije"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Flyt sessioner fra et andet cmux-build"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sposta le sessioni da un’altra build di cmux"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្លាស់ទីវគ្គពី cmux build ផ្សេងទៀត"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Flytt økter fra et annet cmux-bygg"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przenieś sesje z innej kompilacji cmux"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mover sessões de outra compilação do cmux"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перенести сеансы из другой сборки cmux"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ย้ายเซสชันจาก cmux บิลด์อื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oturumları başka bir cmux derlemesinden taşı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перенести сеанси з іншої збірки cmux"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chuyển phiên từ bản dựng cmux khác"
          }
        }
      }
    },
    "sessionMove.dialog.line": {
      "comment": "Explanation line in the Move Sessions from Another cmux Build dialog: each checked session is recreated in this build and then closed in the build it came from.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each checked session opens here and closes in the build it came from."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede ausgewählte Sitzung wird hier geöffnet und im Build, aus dem sie stammt, geschlossen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque session cochée s’ouvre ici et se ferme dans le build d’où elle vient."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفتح كل جلسة محددة هنا وتُغلق في الإصدار الذي جاءت منه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada sesión marcada se abre aquí y se cierra en la compilación de la que viene."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個勾選的工作階段會在這裡開啟，並在原本的版本中關閉。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个勾选的会话会在这里打开，并在原来的版本中关闭。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 각 세션이 여기에서 열리고 원래 빌드에서는 닫힙니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックした各セッションはここで開き、元のビルドでは閉じます。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svaka označena sesija otvara se ovdje i zatvara u verziji iz koje dolazi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hver markeret session åbnes her og lukkes i det build, den kom fra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ogni sessione selezionata si apre qui e si chiude nella build da cui proviene."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "វគ្គដែលបានធីកនីមួយៗបើកនៅទីនេះ ហើយបិទនៅក្នុង build ដែលវាមកពី។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hver avkrysset økt åpnes her og lukkes i bygget den kom fra."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Każda zaznaczona sesja otworzy się tutaj i zamknie w kompilacji, z której pochodzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada sessão marcada abre aqui e fecha na compilação de onde veio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Каждый отмеченный сеанс откроется здесь и закроется в сборке, из которой он пришёл."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เซสชันที่เลือกแต่ละรายการจะเปิดที่นี่และปิดในบิลด์ที่มันมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İşaretlenen her oturum burada açılır ve geldiği derlemede kapanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кожен позначений сеанс відкриється тут і закриється в збірці, з якої він прийшов."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mỗi phiên được chọn sẽ mở ở đây và đóng trong bản dựng gốc của nó."
          }
        }
      }
    },
