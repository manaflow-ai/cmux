    "sessionMove.toast.none": {
      "comment": "Toast when Move Sessions from Another cmux Build finds no other cmux build on this Mac with live sessions.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No other cmux build has sessions to move."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein anderer cmux-Build hat Sitzungen zum Verschieben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun autre build de cmux n’a de sessions à déplacer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي أي إصدار آخر من cmux على جلسات لنقلها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna otra compilación de cmux tiene sesiones para mover."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有其他 cmux 版本有可移入的工作階段。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
