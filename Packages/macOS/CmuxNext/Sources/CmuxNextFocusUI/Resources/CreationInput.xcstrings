    "creationInput.keysNotDelivered": {
      "comment": "Added to the failure notice of the person's new terminal when its create failed: the keys they typed for it were dropped. %@ is the failure reason.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (the keys typed for it were not delivered)"
          }
