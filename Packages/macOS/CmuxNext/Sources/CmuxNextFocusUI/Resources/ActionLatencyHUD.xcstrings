          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen handlinger ennå"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brak akcji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
