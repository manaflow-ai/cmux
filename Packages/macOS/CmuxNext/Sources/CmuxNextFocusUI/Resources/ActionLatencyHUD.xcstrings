    "actionLatencyHUD.header": {
      "comment": "First line of the action latency panel; %d is the budget in milliseconds.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الأحدث أولاً، الحد %d مللي ثانية حتى الالتزام"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Najnovije prvo, budžet %d ms do potvrde"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nyeste først, budget %d ms til commit"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neueste zuerst, Budget %d ms bis zum Commit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Newest first, budget %d ms to commit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo más reciente primero, presupuesto de %d ms hasta el commit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le plus récent en premier, budget de %d ms jusqu’au commit"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prima i più recenti, budget di %d ms fino al commit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい順。コミットまでの予算は %d ms"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ថ្មីបំផុតមុន ថវិកា %d ms ដល់ការបញ្ជាក់"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "최신 순, 커밋까지 예산 %d ms"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nyeste først, budsjett %d ms til commit"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Najnowsze najpierw, budżet %d ms do zatwierdzenia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mais recentes primeiro, orçamento de %d ms até o commit"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сначала новые, бюджет %d мс до фиксации"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ล่าสุดก่อน งบเวลา %d ms จนถึงการคอมมิต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Önce en yeni, işlemeye kadar %d ms bütçe"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Спершу нові, бюджет %d мс до фіксації"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mới nhất trước, ngân sách %d ms đến khi commit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "最新的在前，提交预算 %d 毫秒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "最新的在前，提交預算 %d 毫秒"
          }
        }
      }
    },
