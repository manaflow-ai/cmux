  "strings": {
    "actionLatencyHUD.empty": {
      "comment": "Shown in the action latency panel before any action ran.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا إجراءات بعد"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Još nema akcija"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
