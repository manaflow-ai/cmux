          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ мс  %2$@  %3$@  найдовше %4$@ до %5$@ %6$@ мс"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ms  %2$@  %3$@  lâu nhất %4$@ đến %5$@ %6$@ ms"
