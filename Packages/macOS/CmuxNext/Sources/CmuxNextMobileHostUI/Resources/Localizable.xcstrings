    "mobileHost.consent.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سيرى الهاتف هذه الشاشة. اسمح فقط إذا بدأت ذلك من هاتفك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Telefon će vidjeti ovaj ekran. Dozvolite samo ako ste ovo pokrenuli s telefona."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Telefonen vil se denne skærm. Tillad kun, hvis du startede det fra din telefon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Telefon sieht diesen Bildschirm. Erlaube es nur, wenn du es auf deinem Telefon gestartet hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone will see this screen. Allow only if you started this from your phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El teléfono verá esta pantalla. Permítelo solo si lo iniciaste desde tu teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le téléphone verra cet écran. N’autorisez que si vous l’avez lancé depuis votre téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il telefono vedrà questo schermo. Consenti solo se l’hai avviato dal tuo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンにこの画面が表示されます。ご自身のスマートフォンから開始した場合のみ許可してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ទូរស័ព្ទនឹងឃើញអេក្រង់នេះ។ អនុញ្ញាតតែពេលអ្នកចាប់ផ្តើមវាពីទូរស័ព្ទរបស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "휴대폰에 이 화면이 표시됩니다. 휴대폰에서 직접 시작한 경우에만 허용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Telefonen vil se denne skjermen. Tillat bare hvis du startet dette fra telefonen din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Telefon zobaczy ten ekran. Zezwól tylko, jeśli uruchomiłeś to na swoim telefonie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O telefone verá esta tela. Permita apenas se você iniciou isso pelo seu telefone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Телефон увидит этот экран. Разрешайте, только если вы запустили это со своего телефона."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โทรศัพท์จะเห็นหน้าจอนี้ อนุญาตเฉพาะเมื่อคุณเริ่มจากโทรศัพท์ของคุณเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Telefon bu ekranı görecek. Yalnızca telefonunuzdan siz başlattıysanız izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Телефон бачитиме цей екран. Дозволяйте, лише якщо ви запустили це зі свого телефона."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Điện thoại sẽ thấy màn hình này. Chỉ cho phép nếu bạn bắt đầu từ điện thoại của mình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "手机将看到此屏幕。仅当你从自己的手机发起时才允许。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "手機將看到此螢幕。僅在你從自己的手機發起時才允許。"
          }
        }
      }
    },
