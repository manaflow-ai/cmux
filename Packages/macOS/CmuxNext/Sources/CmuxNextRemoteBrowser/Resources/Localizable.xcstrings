    "remoteBrowser.failure.connectionLost": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection to the remote browser host at %@ closed."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أُغلق الاتصال بمضيف المتصفح البعيد على %@."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Veza s hostom udaljenog preglednika na %@ je zatvorena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Forbindelsen til værten for fjernbrowseren på %@ blev lukket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Verbindung zum Remote-Browser-Host unter %@ wurde geschlossen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La conexión con el host del navegador remoto en %@ se cerró."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La connexion à l’hôte du navigateur distant à %@ s’est fermée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La connessione all’host del browser remoto su %@ si è chiusa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のリモートブラウザホストとの接続が閉じました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការតភ្ជាប់ទៅម៉ាស៊ីនកម្មវិធីរុករកពីចម្ងាយនៅ %@ បានបិទ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@의 원격 브라우저 호스트와의 연결이 닫혔습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tilkoblingen til verten for den eksterne nettleseren på %@ ble lukket."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Połączenie z hostem zdalnej przeglądarki pod adresem %@ zostało zamknięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A conexão com o host do navegador remoto em %@ foi fechada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Соединение с хостом удалённого браузера по адресу %@ закрыто."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การเชื่อมต่อกับโฮสต์เบราว์เซอร์ระยะไกลที่ %@ ปิดแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ adresindeki uzak tarayıcı ana bilgisayarıyla bağlantı kapandı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "З’єднання з хостом віддаленого браузера за адресою %@ закрито."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kết nối tới máy chủ trình duyệt từ xa tại %@ đã đóng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "与 %@ 上远程浏览器主机的连接已关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "與 %@ 上遠端瀏覽器主機的連線已關閉。"
          }
        }
      }
    },
    "remoteBrowser.failure.hostEnded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote browser host at %@ ended this tab."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أنهى مضيف المتصفح البعيد على %@ علامة التبويب هذه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Host udaljenog preglednika na %@ završio je ovu karticu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Værten for fjernbrowseren på %@ afsluttede denne fane."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Remote-Browser-Host unter %@ hat diesen Tab beendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El host del navegador remoto en %@ cerró esta pestaña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’hôte du navigateur distant à %@ a mis fin à cet onglet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’host del browser remoto su %@ ha chiuso questa scheda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のリモートブラウザホストがこのタブを終了しました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ម៉ាស៊ីនកម្មវិធីរុករកពីចម្ងាយនៅ %@ បានបញ្ចប់ផ្ទាំងនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@의 원격 브라우저 호스트가 이 탭을 종료했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verten for den eksterne nettleseren på %@ avsluttet denne fanen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Host zdalnej przeglądarki pod adresem %@ zakończył tę kartę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O host do navegador remoto em %@ encerrou esta aba."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Хост удалённого браузера по адресу %@ завершил эту вкладку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โฮสต์เบราว์เซอร์ระยะไกลที่ %@ สิ้นสุดแท็บนี้แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ adresindeki uzak tarayıcı ana bilgisayarı bu sekmeyi sonlandırdı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Хост віддаленого браузера за адресою %@ завершив цю вкладку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Máy chủ trình duyệt từ xa tại %@ đã kết thúc thẻ này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 上的远程浏览器主机结束了此标签页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 上的遠端瀏覽器主機結束了此分頁。"
          }
        }
      }
    },
    "remoteBrowser.failure.refused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote browser host at %@ refused this tab. It serves only a viewer that has its per-launch secret. Open the tab again with the host's secret file, or use Open Remote Browser Tab (Local Host)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "رفض مضيف المتصفح البعيد على %@ علامة التبويب هذه. فهو يخدم فقط عارضًا يملك السر الخاص بكل تشغيل. افتح علامة التبويب مرة أخرى باستخدام ملف سر المضيف، أو استخدم فتح علامة تبويب متصفح بعيد (مضيف محلي)."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Host udaljenog preglednika na %@ odbio je ovu karticu. Služi samo preglednik koji ima njegovu tajnu za ovo pokretanje. Ponovo otvorite karticu s datotekom tajne hosta ili koristite Otvori karticu udaljenog preglednika (lokalni host)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Værten for fjernbrowseren på %@ afviste denne fane. Den betjener kun en fremviser, der har dens hemmelighed for denne start. Åbn fanen igen med værtens hemmelighedsfil, eller brug Åbn fjernbrowserfane (lokal vært)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Remote-Browser-Host unter %@ hat diesen Tab abgelehnt. Er bedient nur einen Viewer, der sein Geheimnis für diesen Start kennt. Öffne den Tab erneut mit der Geheimnisdatei des Hosts oder nutze „Remote-Browser-Tab öffnen (lokaler Host)“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El host del navegador remoto en %@ rechazó esta pestaña. Solo atiende a un visor que tenga su secreto de este inicio. Vuelve a abrir la pestaña con el archivo secreto del host o usa Abrir pestaña de navegador remoto (host local)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’hôte du navigateur distant à %@ a refusé cet onglet. Il ne sert qu’un visualiseur qui possède son secret de lancement. Rouvrez l’onglet avec le fichier secret de l’hôte, ou utilisez Ouvrir un onglet de navigateur distant (hôte local)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’host del browser remoto su %@ ha rifiutato questa scheda. Serve solo un visualizzatore che ha il suo segreto di avvio. Riapri la scheda con il file segreto dell’host oppure usa Apri scheda browser remoto (host locale)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のリモートブラウザホストがこのタブを拒否しました。このホストは起動ごとのシークレットを持つビューアにだけ応答します。ホストのシークレットファイルを指定してタブを開き直すか、「リモートブラウザタブを開く（ローカルホスト）」を使ってください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ម៉ាស៊ីនកម្មវិធីរុករកពីចម្ងាយនៅ %@ បានបដិសេធផ្ទាំងនេះ។ វាបម្រើតែកម្មវិធីមើលដែលមានអាថ៌កំបាំងរបស់វាសម្រាប់ការបើកនេះប៉ុណ្ណោះ។ បើកផ្ទាំងម្ដងទៀតជាមួយឯកសារសម្ងាត់របស់ម៉ាស៊ីន ឬប្រើ បើកផ្ទាំងកម្មវិធីរុករកពីចម្ងាយ (ម៉ាស៊ីនមូលដ្ឋាន)។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@의 원격 브라우저 호스트가 이 탭을 거부했습니다. 이 호스트는 실행마다 만드는 비밀 값을 가진 뷰어만 받습니다. 호스트의 비밀 파일로 탭을 다시 열거나 원격 브라우저 탭 열기(로컬 호스트)를 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verten for den eksterne nettleseren på %@ avviste denne fanen. Den betjener bare en visning som har hemmeligheten for denne oppstarten. Åpne fanen igjen med vertens hemmelighetsfil, eller bruk Åpne ekstern nettleserfane (lokal vert)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Host zdalnej przeglądarki pod adresem %@ odrzucił tę kartę. Obsługuje tylko przeglądarkę, która zna jego sekret z tego uruchomienia. Otwórz kartę ponownie z plikiem sekretu hosta albo użyj polecenia Otwórz kartę zdalnej przeglądarki (host lokalny)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O host do navegador remoto em %@ recusou esta aba. Ele atende apenas um visualizador que tenha o segredo desta inicialização. Abra a aba de novo com o arquivo secreto do host ou use Abrir aba de navegador remoto (host local)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Хост удалённого браузера по адресу %@ отклонил эту вкладку. Он обслуживает только клиента, у которого есть секрет текущего запуска. Откройте вкладку снова с файлом секрета хоста или используйте «Открыть вкладку удалённого браузера (локальный хост)»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โฮสต์เบราว์เซอร์ระยะไกลที่ %@ ปฏิเสธแท็บนี้ โฮสต์ให้บริการเฉพาะตัวดูที่มีความลับของการเปิดครั้งนี้ เปิดแท็บอีกครั้งพร้อมไฟล์ความลับของโฮสต์ หรือใช้ เปิดแท็บเบราว์เซอร์ระยะไกล (โฮสต์ในเครื่อง)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ adresindeki uzak tarayıcı ana bilgisayarı bu sekmeyi reddetti. Yalnızca bu başlatmanın gizli değerine sahip bir görüntüleyiciye hizmet verir. Sekmeyi ana bilgisayarın gizli dosyasıyla yeniden açın veya Uzak Tarayıcı Sekmesi Aç (Yerel Ana Bilgisayar) komutunu kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Хост віддаленого браузера за адресою %@ відхилив цю вкладку. Він обслуговує лише клієнта, який має секрет поточного запуску. Відкрийте вкладку знову з файлом секрету хоста або скористайтеся «Відкрити вкладку віддаленого браузера (локальний хост)»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Máy chủ trình duyệt từ xa tại %@ đã từ chối thẻ này. Máy chủ chỉ phục vụ trình xem có bí mật của lần khởi chạy này. Hãy mở lại thẻ với tệp bí mật của máy chủ, hoặc dùng Mở thẻ trình duyệt từ xa (máy chủ cục bộ)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 上的远程浏览器主机拒绝了此标签页。它只服务持有本次启动密钥的查看器。请用主机的密钥文件重新打开标签页，或使用“打开远程浏览器标签页（本地主机）”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 上的遠端瀏覽器主機拒絕了此分頁。它只服務持有本次啟動密鑰的檢視器。請用主機的密鑰檔案重新開啟分頁，或使用「開啟遠端瀏覽器分頁（本機主機）」。"
          }
        }
      }
    },
