        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドにはリモートブラウザホストがありません。%@ に cmux-remote-browser-host アプリを指定してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កំណែនេះមិនមានម៉ាស៊ីនកម្មវិធីរុករកពីចម្ងាយទេ។ កំណត់ %@ ទៅកម្មវិធី cmux-remote-browser-host។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 빌드에는 원격 브라우저 호스트가 없습니다. %@을(를) cmux-remote-browser-host 앱으로 설정하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne versjonen har ingen ekstern nettleservert. Sett %@ til en cmux-remote-browser-host-app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ta kompilacja nie ma hosta zdalnej przeglądarki. Ustaw %@ na aplikację cmux-remote-browser-host."
          }
        },
