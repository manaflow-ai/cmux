    "remoteBrowser.localHost.exited": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "توقف المضيف قبل أن يصبح جاهزًا. سجله في %@."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Host se zaustavio prije nego što je bio spreman. Njegov dnevnik je u %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Værten stoppede, før den var klar. Dens log ligger i %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Host wurde beendet, bevor er bereit war. Sein Protokoll liegt unter %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host stopped before it was ready. Its log is at %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El host se detuvo antes de estar listo. Su registro está en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’hôte s’est arrêté avant d’être prêt. Son journal se trouve dans %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’host si è arrestato prima di essere pronto. Il suo log è in %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストは準備が完了する前に終了しました。ログ: %@"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ម៉ាស៊ីនបានឈប់មុនពេលរួចរាល់។ កំណត់ហេតុរបស់វានៅ %@។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "호스트가 준비되기 전에 종료되었습니다. 로그 위치: %@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verten stoppet før den var klar. Loggen ligger i %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Host zatrzymał się, zanim był gotowy. Jego dziennik jest w %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O host parou antes de ficar pronto. O log está em %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Хост остановился до готовности. Его журнал: %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โฮสต์หยุดก่อนพร้อมใช้งาน บันทึกอยู่ที่ %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ana bilgisayar hazır olmadan durdu. Günlüğü: %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Хост зупинився до готовності. Його журнал: %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Máy chủ đã dừng trước khi sẵn sàng. Nhật ký ở %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "主机在就绪前已停止。日志位于 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "主機在就緒前已停止。記錄位於 %@。"
          }
        }
      }
    },
