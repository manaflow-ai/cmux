    "remoteBrowser.localHost.missing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يحتوي هذا الإصدار على مضيف المتصفح البعيد. اضبط %@ على تطبيق cmux-remote-browser-host."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ova verzija nema host udaljenog preglednika. Postavite %@ na aplikaciju cmux-remote-browser-host."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne build har ingen fjernbrowservært. Sæt %@ til en cmux-remote-browser-host-app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Build enthält keinen Remote-Browser-Host. Setze %@ auf eine cmux-remote-browser-host-App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build has no remote browser host. Set %@ to a cmux-remote-browser-host app."
