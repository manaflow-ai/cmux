    "remoteBrowser.secretFile.notPrivate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other users can read the secret file %@. Make it private with chmod 600."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكن لمستخدمين آخرين قراءة ملف السر %@. اجعله خاصًا باستخدام chmod 600."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Drugi korisnici mogu čitati datoteku tajne %@. Učinite je privatnom pomoću chmod 600."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Andre brugere kan læse hemmelighedsfilen %@. Gør den privat med chmod 600."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Andere Benutzer können die Geheimnisdatei %@ lesen. Mache sie mit chmod 600 privat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otros usuarios pueden leer el archivo secreto %@. Hazlo privado con chmod 600."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "D’autres utilisateurs peuvent lire le fichier secret %@. Rendez-le privé avec chmod 600."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Altri utenti possono leggere il file segreto %@. Rendilo privato con chmod 600."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのユーザーがシークレットファイル %@ を読めます。chmod 600 で非公開にしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អ្នកប្រើផ្សេងអាចអានឯកសារសម្ងាត់ %@ បាន។ ធ្វើឱ្យវាឯកជនដោយ chmod 600។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다른 사용자가 비밀 파일 %@을(를) 읽을 수 있습니다. chmod 600으로 비공개로 만드세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Andre brukere kan lese hemmelighetsfilen %@. Gjør den privat med chmod 600."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inni użytkownicy mogą odczytać plik sekretu %@. Ustaw go jako prywatny poleceniem chmod 600."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Outros usuários podem ler o arquivo secreto %@. Torne-o privado com chmod 600."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Другие пользователи могут прочитать файл секрета %@. Сделайте его закрытым командой chmod 600."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ผู้ใช้อื่นอ่านไฟล์ความลับ %@ ได้ ทำให้เป็นส่วนตัวด้วย chmod 600"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diğer kullanıcılar %@ gizli dosyasını okuyabilir. chmod 600 ile özel yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Інші користувачі можуть читати файл секрету %@. Зробіть його приватним командою chmod 600."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Người dùng khác có thể đọc tệp bí mật %@. Hãy đặt riêng tư bằng chmod 600."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "其他用户可以读取密钥文件 %@。请用 chmod 600 将其设为私有。"
