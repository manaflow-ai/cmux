    "access.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "القنوات التي لا يزال بإمكانها تشغيله أثناء إخفائه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kanali koji je i dalje mogu pokrenuti dok je skrivena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kanaler, der stadig må køre den, mens den er skjult."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kanäle, die die App weiterhin ausführen dürfen, während sie ausgeblendet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Channels that may still run it while it is hidden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Canales que aún pueden ejecutarla mientras está oculta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Canaux qui peuvent encore l’exécuter lorsqu’elle est masquée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Canali che possono ancora eseguirla mentre è nascosta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "非表示中も実行できるチャネルです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ឆានែលដែលនៅតែអាចដំណើរការវាបានពេលវាកំពុងលាក់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "가려진 동안에도 실행할 수 있는 채널입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kanaler som fortsatt kan kjøre den mens den er skjult."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kanały, które mogą ją uruchamiać, gdy jest ukryta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Canais que ainda podem executá-lo enquanto estiver oculto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Каналы, которые могут запускать приложение, пока оно скрыто."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ช่องทางที่ยังเรียกใช้แอปได้ขณะซ่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gizliyken onu hâlâ çalıştırabilecek kanallar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Канали, що можуть запускати програму, доки вона схована."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các kênh vẫn có thể chạy ứng dụng khi bị ẩn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "隐藏时仍可运行它的渠道。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "隱藏時仍可執行它的管道。"
          }
        }
      }
    },
