    "install.removeConfirm": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تؤدي الإزالة إلى حذف بياناته وأذوناته. أما الإخفاء فيبقيه جاهزًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uklanjanje briše njene podatke i dozvole. Skrivanje je drži spremnom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fjernelse sletter dens data og tilladelser. Skjulning holder den klar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beim Entfernen werden Daten und Berechtigungen gelöscht. Beim Ausblenden bleibt die App bereit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing deletes its data and permissions. Hiding keeps it ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Al eliminarla se borran sus datos y permisos. Al ocultarla sigue lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La suppression efface ses données et autorisations. Le masquage la garde prête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La rimozione elimina dati e permessi. Nascondendola resta pronta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "削除するとデータと権限が消去されます。非表示ならすぐに使える状態を保てます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការដកចេញនឹងលុបទិន្នន័យ និងការអនុញ្ញាតរបស់វា។ ការលាក់រក្សាវាឱ្យរួចរាល់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "제거하면 데이터와 권한이 삭제됩니다. 가리면 바로 사용할 수 있게 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fjerning sletter dataene og tillatelsene. Skjuling holder den klar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usunięcie kasuje jej dane i uprawnienia. Ukrycie zachowuje ją w gotowości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Remover apaga os dados e as permissões. Ocultar mantém o app pronto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Удаление стирает его данные и разрешения. Скрытие сохраняет его готовым."
