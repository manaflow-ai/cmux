    "install.hidden.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا تظهر التطبيقات المخفية في أي مكان. لكنها تظل تعمل حيث تسمح بذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skrivene aplikacije se nigdje ne prikazuju. I dalje rade gdje to dozvolite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skjulte apps vises ingen steder. De kører stadig, hvor du tillader det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ausgeblendete Apps werden nirgends angezeigt. Sie laufen weiterhin, wo du es erlaubst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden apps show nowhere. They still run where you allow it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las apps ocultas no aparecen en ningún sitio. Siguen ejecutándose donde lo permitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les apps masquées n’apparaissent nulle part. Elles s’exécutent toujours là où vous l’autorisez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le app nascoste non appaiono da nessuna parte. Restano in esecuzione dove lo consenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "非表示のアプリはどこにも表示されません。許可した場所では引き続き実行されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កម្មវិធីដែលបានលាក់មិនបង្ហាញនៅកន្លែងណាទេ។ វានៅតែដំណើរការនៅកន្លែងដែលអ្នកអនុញ្ញាត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "가려진 앱은 어디에도 표시되지 않습니다. 허용한 곳에서는 계속 실행됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skjulte apper vises ingen steder. De kjører fortsatt der du tillater det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ukryte aplikacje nie są nigdzie widoczne. Nadal działają tam, gdzie na to pozwolisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apps ocultos não aparecem em lugar nenhum. Eles ainda são executados onde você permitir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Скрытые приложения нигде не отображаются. Они по-прежнему работают там, где вы разрешили."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แอปที่ซ่อนจะไม่แสดงที่ใดเลย แต่ยังคงทำงานในที่ที่คุณอนุญาต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gizli uygulamalar hiçbir yerde görünmez. İzin verdiğiniz yerlerde çalışmaya devam ederler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сховані програми ніде не показуються. Вони й далі працюють там, де ви дозволяєте."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ứng dụng ẩn không hiển thị ở đâu cả. Chúng vẫn chạy ở nơi bạn cho phép."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "隐藏的 App 不会在任何地方显示。它们仍会在你允许的地方运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "隱藏的 App 不會顯示在任何地方。它們仍會在你允許的地方執行。"
          }
        }
      }
    },
