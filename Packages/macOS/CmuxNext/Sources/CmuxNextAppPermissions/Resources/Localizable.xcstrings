    "profile.completeSandbox.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا شبكة ولا ملفات. فقط ما تفعّله."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bez mreže i datoteka. Samo ono što uključite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Intet netværk, ingen filer. Kun det, du slår til."
          }
        },
