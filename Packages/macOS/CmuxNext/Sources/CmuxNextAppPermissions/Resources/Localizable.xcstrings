    "actions.disabled": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "معطّل. لن يعمل شيء حتى تفعّله."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Onemogućeno. Ništa se ne pokreće dok ne omogućite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deaktiveret. Intet kører, før du aktiverer den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deaktiviert. Nichts läuft, bis du es aktivierst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disabled. Nothing runs until you enable it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desactivada. Nada se ejecuta hasta que la actives."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désactivée. Rien ne s’exécute avant l’activation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Disattivata. Nulla viene eseguito finché non la attivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "無効です。有効にするまで何も実行されません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បានបិទ។ គ្មានអ្វីដំណើរការទេរហូតដល់អ្នកបើក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "비활성화됨. 활성화할 때까지 아무것도 실행되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deaktivert. Ingenting kjører før du aktiverer den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wyłączona. Nic się nie uruchomi, dopóki jej nie włączysz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desativado. Nada é executado até você ativar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Отключено. Ничего не запускается, пока вы не включите."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ปิดใช้งานอยู่ จะไม่มีอะไรทำงานจนกว่าคุณจะเปิดใช้งาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Devre dışı. Etkinleştirene kadar hiçbir şey çalışmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вимкнено. Нічого не запускається, доки ви не ввімкнете."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã tắt. Không có gì chạy cho đến khi bạn bật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已停用。启用前不会运行任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已停用。啟用前不會執行任何項目。"
          }
        }
      }
    },
