          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ はフォルダです。削除するか名前を変更してから、もう一度お試しください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ គឺជាថត។ សូមលុប ឬប្ដូរឈ្មោះវា ហើយព្យាយាមម្ដងទៀត។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@은(는) 폴더입니다. 제거하거나 이름을 바꾼 후 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ er en mappe. Fjern eller gi den nytt navn, og prøv igjen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ jest folderem. Usuń go lub zmień jego nazwę i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ é uma pasta. Remova-a ou renomeie-a e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ является папкой. Удалите или переименуйте её и повторите попытку."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
