    "cli.error.destinationIsDirectory" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is a folder. Remove or rename it and try again."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ مجلد. أزله أو أعد تسميته ثم حاول مرة أخرى."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
