    "cli.offer.otherApp" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` in Terminal runs another cmux app (%1$@, from %2$@). Make it run this app?"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشغّل `cmux` في Terminal تطبيق cmux آخر (%1$@، من %2$@). هل تريد جعله يشغّل هذا التطبيق؟"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` u Terminalu pokreće drugu cmux aplikaciju (%1$@, iz %2$@). Postaviti da pokreće ovu aplikaciju?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` i Terminal kører en anden cmux-app (%1$@, fra %2$@). Vil du få den til at køre denne app?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` im Terminal startet eine andere cmux-App (%1$@, aus %2$@). Soll es diese App starten?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` en Terminal ejecuta otra app de cmux (%1$@, de %2$@). ¿Hacer que ejecute esta app?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` dans Terminal lance une autre app cmux (%1$@, depuis %2$@). Lui faire lancer cette app ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` nel Terminale esegue un'altra app cmux (%1$@, da %2$@). Farle eseguire questa app?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminal の `cmux` は別の cmux アプリ (%1$@、%2$@ 内) を実行します。このアプリを実行するようにしますか？"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` នៅក្នុង Terminal ដំណើរការកម្មវិធី cmux ផ្សេង (%1$@ ពី %2$@)។ ធ្វើឱ្យវាដំណើរការកម្មវិធីនេះទេ?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널의 `cmux`는 다른 cmux 앱(%1$@, %2$@ 소속)을 실행합니다. 이 앱을 실행하게 할까요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` i Terminal kjører en annen cmux-app (%1$@, fra %2$@). Vil du få den til å kjøre denne appen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` w Terminalu uruchamia inną aplikację cmux (%1$@, z %2$@). Ustawić, aby uruchamiał tę aplikację?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` no Terminal executa outro app do cmux (%1$@, de %2$@). Fazer com que execute este app?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` в Терминале запускает другое приложение cmux (%1$@, из %2$@). Сделать так, чтобы он запускал это приложение?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` ใน Terminal เรียกใช้แอป cmux อื่น (%1$@ จาก %2$@) ต้องการให้เรียกใช้แอปนี้หรือไม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminal'deki `cmux`, başka bir cmux uygulamasını (%1$@, %2$@ içinden) çalıştırıyor. Bu uygulamayı çalıştırsın mı?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` у Терміналі запускає іншу програму cmux (%1$@, із %2$@). Зробити так, щоб він запускав цю програму?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` trong Terminal chạy một ứng dụng cmux khác (%1$@, từ %2$@). Cho nó chạy ứng dụng này?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终端中的 `cmux` 运行的是另一个 cmux 应用 (%1$@，来自 %2$@)。要让它运行此应用吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終端機中的 `cmux` 執行的是另一個 cmux App (%1$@，來自 %2$@)。要讓它執行此 App 嗎？"
          }
        }
      }
    },
