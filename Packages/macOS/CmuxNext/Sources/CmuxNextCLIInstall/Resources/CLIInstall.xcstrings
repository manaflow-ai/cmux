        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` នៅ %1$@ ភ្ជាប់ទៅកម្មវិធីដែលលែងមានហើយ (%2$@)។ ចង្អុលវាទៅកម្មវិធីនេះទេ?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@의 `cmux`가 더 이상 없는 앱에 연결되어 있습니다(%2$@). 이 앱을 가리키게 할까요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` i %1$@ peker til en app som ikke finnes lenger (%2$@). Vil du peke den til denne appen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` w %1$@ wskazuje na aplikację, której już nie ma (%2$@). Wskazać na tę aplikację?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` em %1$@ aponta para um app que não existe mais (%2$@). Apontá-lo para este app?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` в %1$@ ссылается на приложение, которого больше нет (%2$@). Перенаправить на это приложение?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` ที่ %1$@ ลิงก์ไปยังแอปที่ไม่มีอยู่แล้ว (%2$@) ต้องการให้ชี้ไปที่แอปนี้หรือไม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ konumundaki `cmux`, artık var olmayan bir uygulamaya bağlı (%2$@). Bu uygulamayı göstersin mi?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` у %1$@ посилається на програму, якої вже немає (%2$@). Спрямувати на цю програму?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` tại %1$@ liên kết tới một ứng dụng không còn tồn tại (%2$@). Trỏ nó tới ứng dụng này?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 处的 `cmux` 链接的应用已不存在 (%2$@)。要让它指向此应用吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 的 `cmux` 連結的 App 已不存在 (%2$@)。要讓它指向此 App 嗎？"
          }
        }
      }
    },
