    "cli.error.bundleNotInstalled" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux is running from its disk image (%@). Move it to Applications, open it from there, and try again."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل cmux من صورة القرص الخاصة به (%@). انقله إلى مجلد التطبيقات، وافتحه من هناك، ثم حاول مرة أخرى."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux se pokreće sa svoje disk slike (%@). Premjestite ga u Applications, otvorite ga odatle i pokušajte ponovo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux kører fra sit diskbillede (%@). Flyt det til Programmer, åbn det derfra, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux läuft von seinem Disk-Image (%@). Verschiebe es in den Ordner „Programme“, öffne es von dort und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux se está ejecutando desde su imagen de disco (%@). Muévelo a Aplicaciones, ábrelo desde allí e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux s'exécute depuis son image disque (%@). Déplacez-le dans Applications, ouvrez-le depuis là et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux è in esecuzione dalla sua immagine disco (%@). Spostalo in Applicazioni, aprilo da lì e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux はディスクイメージ (%@) から実行されています。アプリケーションフォルダに移動し、そこから開いて、もう一度お試しください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux កំពុងដំណើរការពីឌីស image របស់វា (%@)។ ផ្លាស់ទីវាទៅ Applications បើកវាពីទីនោះ ហើយសាកល្បងម្ដងទៀត។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux가 디스크 이미지(%@)에서 실행 중입니다. 응용 프로그램 폴더로 옮기고 거기서 열어 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux kjører fra diskbildet sitt (%@). Flytt det til Programmer, åpne det derfra og prøv igjen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux działa z obrazu dysku (%@). Przenieś go do Programów, otwórz stamtąd i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cmux está sendo executado a partir da imagem de disco (%@). Mova-o para Aplicativos, abra-o de lá e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux запущен из образа диска (%@). Переместите его в «Программы», откройте оттуда и повторите попытку."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux กำลังทำงานจากดิสก์อิมเมจ (%@) ย้ายไปที่โฟลเดอร์ Applications เปิดจากที่นั่น แล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux disk görüntüsünden (%@) çalışıyor. Uygulamalar klasörüne taşıyın, oradan açın ve tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux запущено з образу диска (%@). Перемістіть його до «Програм», відкрийте звідти й повторіть спробу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux đang chạy từ ảnh đĩa (%@). Hãy chuyển nó vào Applications, mở từ đó rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux 正从其磁盘映像 (%@) 运行。请将其移到“应用程序”文件夹，从那里打开后再试一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux 正從其磁碟映像檔 (%@) 執行。請將其移到「應用程式」檔案夾，從那裡開啟後再試一次。"
          }
        }
      }
    },
