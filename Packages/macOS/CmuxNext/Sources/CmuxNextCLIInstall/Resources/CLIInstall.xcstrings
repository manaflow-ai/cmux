    "cli.offer.classic" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` in Terminal runs cmux classic (%1$@). Replace makes it run this app; classic stays installed."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشغّل `cmux` في Terminal النسخة cmux classic (%1$@). سيجعله الاستبدال يشغّل هذا التطبيق، وتبقى classic مثبّتة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` u Terminalu pokreće cmux classic (%1$@). Zamjena će ga natjerati da pokreće ovu aplikaciju; classic ostaje instaliran."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` i Terminal kører cmux classic (%1$@). Erstat får den til at køre denne app; classic forbliver installeret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` im Terminal startet cmux classic (%1$@). Mit „Ersetzen“ startet es diese App; classic bleibt installiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` en Terminal ejecuta cmux classic (%1$@). Reemplazar hace que ejecute esta app; classic sigue instalada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` dans Terminal lance cmux classic (%1$@). Remplacer lui fait lancer cette app ; classic reste installée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` nel Terminale esegue cmux classic (%1$@). Sostituisci lo fa eseguire questa app; classic resta installata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminal の `cmux` は cmux classic (%1$@) を実行します。「置き換える」を選ぶとこのアプリを実行するようになります。classic はインストールされたままです。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` នៅក្នុង Terminal ដំណើរការ cmux classic (%1$@)។ ជំនួស នឹងធ្វើឱ្យវាដំណើរការកម្មវិធីនេះ ហើយ classic នៅតែបានដំឡើង។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널의 `cmux`는 cmux classic(%1$@)을 실행합니다. 대체하면 이 앱을 실행하게 되며, classic은 그대로 설치되어 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` i Terminal kjører cmux classic (%1$@). Erstatt får den til å kjøre denne appen; classic forblir installert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` w Terminalu uruchamia cmux classic (%1$@). Zastąp sprawi, że uruchomi tę aplikację; classic pozostaje zainstalowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` no Terminal executa o cmux classic (%1$@). Substituir faz com que ele execute este app; o classic continua instalado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` в Терминале запускает cmux classic (%1$@). «Заменить» заставит его запускать это приложение; classic останется установленным."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` ใน Terminal เรียกใช้ cmux classic (%1$@) การแทนที่จะทำให้เรียกใช้แอปนี้แทน ส่วน classic ยังคงติดตั้งอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminal'deki `cmux`, cmux classic'i (%1$@) çalıştırıyor. Değiştir bunu bu uygulamayı çalıştıracak şekilde ayarlar; classic kurulu kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` у Терміналі запускає cmux classic (%1$@). «Замінити» змусить його запускати цю програму; classic залишиться встановленим."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` trong Terminal chạy cmux classic (%1$@). Thay thế sẽ khiến nó chạy ứng dụng này; classic vẫn được giữ nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终端中的 `cmux` 运行的是 cmux classic (%1$@)。选择“替换”后它将运行此应用；classic 仍保持安装。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終端機中的 `cmux` 執行的是 cmux classic (%1$@)。選擇「取代」後它會執行此 App；classic 仍保持安裝。"
          }
        }
      }
    },
    "cli.offer.dangling" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`cmux` at %1$@ links to an app that is gone (%2$@). Point it at this app?"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرتبط `cmux` في %1$@ بتطبيق لم يعد موجودًا (%2$@). هل تريد توجيهه إلى هذا التطبيق؟"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
