    "cloudTunnel.describe.off": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "متوقف. لا يمكن للتطبيقات الأخرى على هذا الـ Mac الوصول إلى أجهزة Cloud."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isključeno. Druge aplikacije na ovom Macu ne mogu doseći vaše Cloud mašine."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fra. Andre apps på denne Mac kan ikke nå dine Cloud-maskiner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aus. Andere Apps auf diesem Mac erreichen deine Cloud-Maschinen nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off. Other apps on this Mac cannot reach your Cloud machines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desactivado. Las demás apps de este Mac no pueden llegar a tus máquinas de Cloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désactivé. Les autres apps de ce Mac ne peuvent pas atteindre vos machines Cloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Disattivato. Le altre app di questo Mac non possono raggiungere le tue macchine Cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフです。この Mac の他のアプリは Cloud マシンに接続できません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បិទ។ កម្មវិធីផ្សេងទៀតនៅលើ Mac នេះមិនអាចទៅដល់ម៉ាស៊ីន Cloud របស់អ្នកបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "꺼짐. 이 Mac의 다른 앱은 Cloud 머신에 연결할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Av. Andre apper på denne Macen kan ikke nå Cloud-maskinene dine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wyłączony. Inne aplikacje na tym Macu nie mogą łączyć się z maszynami Cloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desativado. Outros apps deste Mac não acessam suas máquinas Cloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выключено. Другие приложения на этом Mac не могут обращаться к машинам Cloud."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ปิดอยู่ แอปอื่นบน Mac เครื่องนี้เข้าถึงเครื่อง Cloud ของคุณไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kapalı. Bu Mac'teki diğer uygulamalar Cloud makinelerinize erişemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вимкнено. Інші програми на цьому Mac не можуть звертатися до машин Cloud."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tắt. Các ứng dụng khác trên máy Mac này không thể truy cập máy Cloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已关闭。这台 Mac 上的其他 App 无法访问你的 Cloud 机器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已關閉。這台 Mac 上的其他 App 無法存取你的 Cloud 機器。"
          }
        }
      }
    },
    "cloudTunnel.error.agentRefused": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أنت فقط من يمكنه تشغيل Cloud Tunnel: استخدم الإعدادات أو `cmux cloud tunnel on` في الطرفية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Samo vi možete uključiti Cloud Tunnel: koristite Postavke ili `cmux cloud tunnel on` u terminalu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kun du kan slå Cloud Tunnel til: brug Indstillinger eller `cmux cloud tunnel on` i en terminal."
          }
        },
        "de": {
