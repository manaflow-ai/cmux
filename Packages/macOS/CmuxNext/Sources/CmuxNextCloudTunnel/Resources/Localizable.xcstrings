{
  "sourceLanguage": "en",
  "strings": {
    "cloudTunnel.describe.awaitingApproval": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اسمح بامتداد الشبكة من cmux في إعدادات النظام > عام > عناصر تسجيل الدخول والامتدادات. يبدأ النفق بعدها مباشرة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dozvolite cmux mrežnu ekstenziju u System Settings > General > Login Items & Extensions. Tunel se pokreće odmah nakon toga."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tillad cmux' netværksudvidelse i Systemindstillinger > Generelt > Login-emner og udvidelser. Tunnelen starter lige efter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erlaube die cmux-Netzwerkerweiterung in Systemeinstellungen > Allgemein > Anmeldeobjekte & Erweiterungen. Der Tunnel startet direkt danach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the cmux network extension in System Settings > General > Login Items & Extensions. The tunnel starts right after."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite la extensión de red de cmux en Ajustes del Sistema > General > Ítems de inicio y extensiones. El túnel se inicia justo después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autorisez l'extension réseau de cmux dans Réglages Système > Général > Ouverture et extensions. Le tunnel démarre juste après."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consenti l'estensione di rete di cmux in Impostazioni di Sistema > Generali > Elementi login ed estensioni. Il tunnel si avvia subito dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 > 一般 > ログイン項目と機能拡張 で cmux のネットワーク拡張を許可してください。許可するとすぐにトンネルが開始します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អនុញ្ញាតផ្នែកបន្ថែមបណ្ដាញ cmux នៅក្នុង System Settings > General > Login Items & Extensions។ ផ្លូវរូងចាប់ផ្ដើមភ្លាមៗបន្ទាប់ពីនោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "시스템 설정 > 일반 > 로그인 항목 및 확장 프로그램에서 cmux 네트워크 확장을 허용하세요. 그러면 터널이 바로 시작됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tillat cmux sin nettverksutvidelse i Systeminnstillinger > Generelt > Påloggingsobjekter og utvidelser. Tunnelen starter rett etterpå."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zezwól na rozszerzenie sieciowe cmux w Ustawieniach systemowych > Ogólne > Rzeczy otwierane przy logowaniu i rozszerzenia. Tunel uruchomi się zaraz potem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permita a extensão de rede do cmux em Ajustes do Sistema > Geral > Itens de Início e Extensões. O túnel inicia logo em seguida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Разрешите сетевое расширение cmux в Системных настройках > Основные > Объекты входа и расширения. Туннель запустится сразу после этого."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อนุญาตส่วนขยายเครือข่ายของ cmux ในการตั้งค่าระบบ > ทั่วไป > รายการเข้าสู่ระบบและส่วนขยาย อุโมงค์จะเริ่มทำงานทันทีหลังจากนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sistem Ayarları > Genel > Giriş Öğeleri ve Uzantılar'da cmux ağ uzantısına izin verin. Tünel hemen ardından başlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дозвольте мережеве розширення cmux у Системних параметрах > Загальні > Обʼєкти входу та розширення. Тунель запуститься одразу після цього."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cho phép tiện ích mở rộng mạng của cmux trong Cài đặt hệ thống > Cài đặt chung > Mục đăng nhập & tiện ích mở rộng. Đường hầm khởi động ngay sau đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请在“系统设置”>“通用”>“登录项与扩展”中允许 cmux 网络扩展。隧道随即启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請在「系統設定」>「一般」>「登入項目與延伸功能」中允許 cmux 網路延伸功能。通道隨即啟動。"
          }
        }
      }
    },
    "cloudTunnel.describe.connected": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قيد التشغيل. يمكن لكل تطبيق على هذا الـ Mac الوصول إلى العناوين الخاصة لأجهزة Cloud."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uključeno. Svaka aplikacija na ovom Macu može doseći privatne adrese vaših Cloud mašina."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Til. Alle apps på denne Mac kan nå dine Cloud-maskiners private adresser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "An. Jede App auf diesem Mac erreicht die privaten Adressen deiner Cloud-Maschinen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On. Every app on this Mac can reach your Cloud machines' private addresses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activado. Cualquier app de este Mac llega a las direcciones privadas de tus máquinas de Cloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activé. Toutes les apps de ce Mac atteignent les adresses privées de vos machines Cloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Attivato. Ogni app di questo Mac raggiunge gli indirizzi privati delle tue macchine Cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンです。この Mac のすべてのアプリから Cloud マシンのプライベートアドレスに接続できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បើក។ កម្មវិធីទាំងអស់នៅលើ Mac នេះអាចទៅដល់អាសយដ្ឋានឯកជននៃម៉ាស៊ីន Cloud របស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "켜짐. 이 Mac의 모든 앱이 Cloud 머신의 사설 주소에 연결할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "På. Alle apper på denne Macen kan nå de private adressene til Cloud-maskinene dine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Włączony. Każda aplikacja na tym Macu może łączyć się z prywatnymi adresami maszyn Cloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ativado. Todo app deste Mac acessa os endereços privados das suas máquinas Cloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Включено. Любое приложение на этом Mac может обращаться к частным адресам машин Cloud."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิดอยู่ ทุกแอปบน Mac เครื่องนี้เข้าถึงที่อยู่ส่วนตัวของเครื่อง Cloud ของคุณได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Açık. Bu Mac'teki her uygulama Cloud makinelerinizin özel adreslerine erişebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Увімкнено. Кожна програма на цьому Mac може звертатися до приватних адрес машин Cloud."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bật. Mọi ứng dụng trên máy Mac này có thể truy cập địa chỉ riêng của các máy Cloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已打开。这台 Mac 上的所有 App 都能访问你的 Cloud 机器的私有地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已開啟。這台 Mac 上的所有 App 都能存取你的 Cloud 機器的私有位址。"
          }
        }
      }
    },
