{
  "sourceLanguage": "en",
  "strings": {
    "terminal.filePaste.failed.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t paste the file"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datei konnte nicht eingefügt werden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de coller le fichier"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر لصق الملف"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo pegar el archivo"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法貼上檔案"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法粘贴文件"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 붙여넣을 수 없습니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを貼り付けられませんでした"
          }
        }
      }
    },
    "terminal.filePaste.failed.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload could not be confirmed. Check the terminal before pasting again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Upload konnte nicht bestätigt werden. Prüfe das Terminal, bevor du erneut einfügst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’envoi n’a pas pu être confirmé. Vérifiez le terminal avant de coller à nouveau."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تأكيد الرفع. تحقق من الطرفية قبل اللصق مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar la carga. Revisa el terminal antes de volver a pegar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認上傳結果。再次貼上前，請先檢查終端機。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认上传结果。再次粘贴前，请先检查终端。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드를 확인할 수 없습니다. 다시 붙여넣기 전에 터미널을 확인하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードを確認できませんでした。再度貼り付ける前にターミナルを確認してください。"
          }
        }
      }
    },
    "terminal.filePaste.failed.dismiss": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إغلاق"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        }
      }
    }
  },
  "version": "1.0"
}
