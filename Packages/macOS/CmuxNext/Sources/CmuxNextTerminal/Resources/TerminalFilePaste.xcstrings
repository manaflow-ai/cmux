          "stringUnit": {
            "state": "needs_review",
            "value": "วางไฟล์ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dosya yapıştırılamadı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не вдалося вставити файл"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thể dán tệp"
          }
        }
      }
    },
    "terminal.filePaste.failed.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload could not be confirmed. Check the terminal before pasting again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Upload konnte nicht bestätigt werden. Prüfe das Terminal, bevor du erneut einfügst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’envoi n’a pas pu être confirmé. Vérifiez le terminal avant de coller à nouveau."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تأكيد الرفع. تحقق من الطرفية قبل اللصق مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar la carga. Revisa el terminal antes de volver a pegar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認上傳結果。再次貼上前，請先檢查終端機。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认上传结果。再次粘贴前，请先检查终端。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드를 확인할 수 없습니다. 다시 붙여넣기 전에 터미널을 확인하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードを確認できませんでした。再度貼り付ける前にターミナルを確認してください。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otpremanje nije moguće potvrditi. Provjerite terminal prije ponovnog lijepljenja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Overførslen kunne ikke bekræftes. Tjek terminalen, før du indsætter igen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile confermare il caricamento. Controlla il terminale prima di incollare di nuovo."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនអាចបញ្ជាក់ការផ្ទុកឡើងបានទេ។ ពិនិត្យស្ថានីយ មុនពេលបិទភ្ជាប់ម្ដងទៀត។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opplastingen kunne ikke bekreftes. Sjekk terminalen før du limer inn på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie udało się potwierdzić przesłania. Sprawdź terminal, zanim wkleisz ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível confirmar o envio. Verifique o terminal antes de colar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось подтвердить загрузку. Проверьте терминал, прежде чем вставлять снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยืนยันการอัปโหลดไม่ได้ ตรวจสอบเทอร์มินัลก่อนวางอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yükleme onaylanamadı. Yeniden yapıştırmadan önce terminali kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не вдалося підтвердити завантаження. Перевірте термінал, перш ніж вставляти знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thể xác nhận việc tải lên. Hãy kiểm tra terminal trước khi dán lại."
          }
        }
      }
    },
