      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t paste the file"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datei konnte nicht eingefügt werden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de coller le fichier"
          }
        },
        "ar": {
          "stringUnit": {
