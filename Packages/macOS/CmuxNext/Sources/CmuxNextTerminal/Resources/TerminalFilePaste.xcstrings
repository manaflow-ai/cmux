            "value": "Nije moguće zalijepiti datoteku"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Filen kunne ikke indsættes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile incollare il file"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនអាចបិទភ្ជាប់ឯកសារបានទេ"
          }
        },
        "nb": {
          "stringUnit": {
