    "terminal.clipboard.paste.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text contains line breaks and may run commands immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストに改行が含まれているため、コマンドがすぐに実行される可能性があります。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحتوي النص على فواصل أسطر وقد يشغّل أوامر فورًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tekst sadrži prelome redova i može odmah pokrenuti naredbe."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teksten indeholder linjeskift og kan køre kommandoer med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Text enthält Zeilenumbrüche und kann sofort Befehle ausführen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El texto contiene saltos de línea y podría ejecutar comandos de inmediato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le texte contient des sauts de ligne et peut exécuter des commandes immédiatement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il testo contiene interruzioni di riga e potrebbe eseguire subito dei comandi."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អត្ថបទមានការចុះបន្ទាត់ ហើយអាចដំណើរការពាក្យបញ្ជាភ្លាមៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "텍스트에 줄 바꿈이 포함되어 있어 명령이 즉시 실행될 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teksten inneholder linjeskift og kan kjøre kommandoer umiddelbart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tekst zawiera podziały wierszy i może od razu uruchomić polecenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O texto contém quebras de linha e pode executar comandos imediatamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Текст содержит переносы строк и может сразу выполнить команды."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ข้อความมีการขึ้นบรรทัดใหม่และอาจเรียกใช้คำสั่งทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metin satır sonları içeriyor ve komutları hemen çalıştırabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Текст містить розриви рядків і може одразу виконати команди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Văn bản chứa dấu ngắt dòng và có thể chạy lệnh ngay lập tức."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "文本包含换行符，可能会立即运行命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "文字包含換行符號，可能會立即執行指令。"
          }
        }
      }
    },
