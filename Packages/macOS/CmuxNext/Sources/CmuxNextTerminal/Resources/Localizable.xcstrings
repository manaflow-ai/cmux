    "terminal.clipboard.read.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running in this terminal asked for the clipboard contents."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このターミナルで実行中のプログラムがクリップボードの内容を要求しています。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "طلب برنامج يعمل في هذه الطرفية محتويات الحافظة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Program pokrenut u ovom terminalu zatražio je sadržaj međuspremnika."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et program, der kører i denne terminal, har bedt om indholdet af udklipsholderen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Programm in diesem Terminal hat den Inhalt der Zwischenablage angefordert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un programa que se ejecuta en este terminal ha solicitado el contenido del portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un programme exécuté dans ce terminal demande le contenu du presse-papiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un programma in esecuzione in questo terminale ha richiesto il contenuto degli appunti."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កម្មវិធីដែលកំពុងដំណើរការក្នុង Terminal នេះបានស្នើសុំមាតិកាក្ដារតម្បៀតខ្ទាស់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 터미널에서 실행 중인 프로그램이 클립보드 내용을 요청했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et program som kjører i denne terminalen, ba om innholdet på utklippstavlen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Program działający w tym terminalu poprosił o zawartość schowka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um programa em execução neste terminal pediu o conteúdo da área de transferência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Программа в этом терминале запросила содержимое буфера обмена."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โปรแกรมที่ทำงานในเทอร์มินัลนี้ขอเนื้อหาในคลิปบอร์ด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu terminalde çalışan bir program pano içeriğini istedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Програма в цьому терміналі запитала вміст буфера обміну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Một chương trình đang chạy trong terminal này yêu cầu nội dung bảng nhớ tạm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此终端中运行的程序请求读取剪贴板内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在此終端機中執行的程式要求讀取剪貼板內容。"
          }
        }
      }
    },
    "terminal.clipboard.read.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow a program to read the clipboard?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プログラムにクリップボードの読み取りを許可しますか？"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هل تسمح لبرنامج بقراءة الحافظة؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dozvoliti programu da čita međuspremnik?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vil du tillade et program at læse udklipsholderen?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Einem Programm erlauben, die Zwischenablage zu lesen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Permitir que un programa lea el portapapeles?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autoriser un programme à lire le presse-papiers ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consentire a un programma di leggere gli appunti?"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អនុញ្ញាតឲ្យកម្មវិធីអានក្ដារតម្បៀតខ្ទាស់?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "프로그램이 클립보드를 읽도록 허용하겠습니까?"
          }
        },
        "nb": {
