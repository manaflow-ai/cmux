  "strings": {
    "terminal.accessibility.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナル"
          }
        }
      }
    },
    "terminal.clipboard.allow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可"
          }
        }
      }
    },
    "terminal.clipboard.deny": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deny"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拒否"
          }
        }
      }
    },
    "terminal.clipboard.paste.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text contains line breaks and may run commands immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストに改行が含まれているため、コマンドがすぐに実行される可能性があります。"
          }
        }
      }
    },
    "terminal.clipboard.paste.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste into the terminal?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルに貼り付けますか？"
          }
        }
      }
    },
    "terminal.clipboard.read.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running in this terminal asked for the clipboard contents."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このターミナルで実行中のプログラムがクリップボードの内容を要求しています。"
          }
        }
      }
    },
    "terminal.clipboard.read.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow a program to read the clipboard?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プログラムにクリップボードの読み取りを許可しますか？"
          }
        }
      }
    },
    "terminal.clipboard.write.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running in this terminal wants to copy text to the clipboard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このターミナルで実行中のプログラムがクリップボードにテキストをコピーしようとしています。"
          }
        }
      }
    },
    "terminal.clipboard.write.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow a program to change the clipboard?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プログラムにクリップボードの変更を許可しますか？"
          }
        }
      }
    },
