    "artifacts.unreachable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Artifacts could not be reached. Check that you are signed in and online, then try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى العناصر المحفوظة. تأكد من تسجيل الدخول ومن اتصالك بالإنترنت، ثم أعد المحاولة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Artefakti nisu dostupni. Provjerite jeste li prijavljeni i povezani na internet, pa pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Artefakter kunne ikke nås. Tjek, at du er logget ind og online, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Artefakte sind nicht erreichbar. Prüfe, ob du angemeldet und online bist, und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo acceder a los artefactos. Comprueba que has iniciado sesión y tienes conexión, y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'accéder aux artefacts. Vérifiez que vous êtes connecté à votre compte et à Internet, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere gli artefatti. Verifica di aver effettuato l'accesso e di essere online, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーティファクトに接続できませんでした。サインインしてオンラインであることを確認してから、もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចភ្ជាប់ទៅវត្ថុបុរាណបានទេ។ សូមពិនិត្យថាអ្នកបានចូលគណនី និងមានអ៊ីនធឺណិត រួចព្យាយាមម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아티팩트에 연결할 수 없습니다. 로그인되어 있고 온라인인지 확인한 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke nå artefakter. Sjekk at du er logget på og tilkoblet, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można połączyć się z artefaktami. Sprawdź, czy jesteś zalogowany i online, a potem spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar os artefatos. Verifique se você entrou na conta e está online e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подключиться к артефактам. Проверьте, что вы вошли в аккаунт и в сети, и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าถึงอาร์ติแฟกต์ไม่ได้ ตรวจสอบว่าคุณลงชื่อเข้าใช้และออนไลน์อยู่ แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapıtlara ulaşılamadı. Oturum açtığınızdan ve çevrimiçi olduğunuzdan emin olup yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося під'єднатися до артефактів. Перевірте, що ви ввійшли в обліковий запис і в мережі, і спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể kết nối tới tạo phẩm. Hãy kiểm tra bạn đã đăng nhập và đang trực tuyến, rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到制品。请确认你已登录并且网络正常，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線到成品。請確認你已登入且網路正常，然後再試一次。"
          }
        }
      }
    },
