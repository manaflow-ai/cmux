    "stats.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent service is not running or did not answer, so there is nothing to count yet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمة الوكلاء لا تعمل أو لم تستجب، لذا لا يوجد ما يُحصى بعد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Servis agenata nije pokrenut ili nije odgovorio, pa još nema šta da se broji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenttjenesten kører ikke eller svarede ikke, så der er intet at tælle endnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent-Dienst läuft nicht oder hat nicht geantwortet, daher gibt es noch nichts zu zählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de agentes no se está ejecutando o no respondió, así que aún no hay nada que contar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service des agents ne fonctionne pas ou n'a pas répondu : il n'y a encore rien à compter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio degli agenti non è in esecuzione o non ha risposto, quindi non c'è ancora nulla da contare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントサービスが実行されていないか応答しなかったため、まだ集計するものがありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សេវាភ្នាក់ងារមិនកំពុងដំណើរការ ឬមិនបានឆ្លើយតប ដូច្នេះមិនទាន់មានអ្វីត្រូវរាប់ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 서비스가 실행 중이 아니거나 응답하지 않아 아직 집계할 내용이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenttjenesten kjører ikke eller svarte ikke, så det er ingenting å telle ennå."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usługa agentów nie działa lub nie odpowiedziała, więc nie ma jeszcze czego liczyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de agentes não está em execução ou não respondeu, então ainda não há nada para contar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба агентов не запущена или не ответила, поэтому считать пока нечего."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บริการเอเจนต์ไม่ได้ทำงานอยู่หรือไม่ตอบสนอง จึงยังไม่มีอะไรให้นับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajan hizmeti çalışmıyor ya da yanıt vermedi, bu yüzden henüz sayılacak bir şey yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба агентів не запущена або не відповіла, тому рахувати поки нічого."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch vụ tác tử không chạy hoặc không phản hồi nên chưa có gì để đếm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体服务未运行或没有响应，因此还没有可统计的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理程式服務未執行或沒有回應，因此還沒有可統計的內容。"
          }
        }
      }
    },
