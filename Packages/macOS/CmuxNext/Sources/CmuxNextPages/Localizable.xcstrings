    "chiefUsage.refusal.noLocalChief": {
      "comment": "Why Chief Usage cannot open: this build runs no Chief on this Mac",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief Usage reads the Chief that runs on this Mac, and this build has no local Chief."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ استخدام Chief بيانات Chief الذي يعمل على هذا الـ Mac، وهذا الإصدار لا يتضمن Chief محليًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upotreba Chiefa čita Chiefa koji radi na ovom Macu, a ova verzija nema lokalnog Chiefa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief-forbrug læser den Chief, der kører på denne Mac, og denne version har ingen lokal Chief."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief-Nutzung liest den Chief, der auf diesem Mac läuft, und dieser Build hat keinen lokalen Chief."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso del Chief lee el Chief que se ejecuta en este Mac, y esta versión no tiene un Chief local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisation du Chief lit le Chief qui tourne sur ce Mac, et cette version n’a pas de Chief local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizzo del Chief legge il Chief in esecuzione su questo Mac, e questa build non ha un Chief locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief の使用量はこの Mac で動く Chief から読み取りますが、このビルドにはローカルの Chief がありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការប្រើប្រាស់ Chief អាន Chief ដែលដំណើរការលើ Mac នេះ ហើយកំណែនេះគ្មាន Chief មូលដ្ឋានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief 사용량은 이 Mac에서 실행되는 Chief를 읽는데, 이 빌드에는 로컬 Chief가 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief-forbruk leser Chief som kjører på denne Macen, og denne versjonen har ingen lokal Chief."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użycie Chiefa odczytuje Chiefa działającego na tym Macu, a ta wersja nie ma lokalnego Chiefa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso do Chief lê o Chief que roda neste Mac, e esta versão não tem um Chief local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использование Chief читает Chief, который работает на этом Mac, а в этой сборке нет локального Chief."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การใช้งาน Chief อ่านข้อมูลจาก Chief ที่ทำงานบน Mac เครื่องนี้ แต่บิลด์นี้ไม่มี Chief ในเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief Kullanımı bu Mac’te çalışan Chief’i okur ve bu sürümde yerel bir Chief yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використання Chief читає Chief, що працює на цьому Mac, а в цій збірці немає локального Chief."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mức sử dụng Chief đọc Chief chạy trên máy Mac này, nhưng bản dựng này không có Chief cục bộ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief 用量读取在这台 Mac 上运行的 Chief，而此版本没有本地 Chief。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief 用量讀取在這台 Mac 上執行的 Chief，而此版本沒有本機 Chief。"
          }
        }
      }
    },
    "chiefUsage.unavailable": {
      "comment": "Chief Usage page: this build has no optchat-chief usage tool",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build does not include the Chief's usage tool, so there is no usage to show."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتضمن هذا الإصدار أداة استخدام Chief، لذلك لا يوجد استخدام لعرضه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova verzija ne sadrži Chiefov alat za upotrebu, pa nema upotrebe za prikaz."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne version indeholder ikke Chiefs forbrugsværktøj, så der er intet forbrug at vise."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Build enthält das Nutzungswerkzeug des Chiefs nicht, daher gibt es keine Nutzung anzuzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión no incluye la herramienta de uso del Chief, así que no hay uso que mostrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version n’inclut pas l’outil d’utilisation du Chief : il n’y a aucune utilisation à afficher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa build non include lo strumento di utilizzo del Chief, quindi non c’è alcun utilizzo da mostrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドには Chief の使用量ツールが含まれていないため、表示する使用量がありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កំណែនេះមិនរួមបញ្ចូលឧបករណ៍ប្រើប្រាស់របស់ Chief ទេ ដូច្នេះគ្មានការប្រើប្រាស់ត្រូវបង្ហាញទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드에는 Chief의 사용량 도구가 없어 표시할 사용량이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne versjonen inneholder ikke Chiefs forbruksverktøy, så det er ikke noe forbruk å vise."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta wersja nie zawiera narzędzia użycia Chiefa, więc nie ma czego pokazać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão não inclui a ferramenta de uso do Chief, então não há uso para mostrar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой сборке нет инструмента использования Chief, поэтому показывать нечего."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บิลด์นี้ไม่มีเครื่องมือการใช้งานของ Chief จึงไม่มีการใช้งานให้แสดง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sürüm Chief’in kullanım aracını içermiyor, bu yüzden gösterilecek kullanım yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця збірка не містить інструмента використання Chief, тож показувати нічого."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản dựng này không có công cụ đo mức sử dụng của Chief, nên không có gì để hiển thị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本不包含 Chief 的用量工具，因此没有可显示的用量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本不包含 Chief 的用量工具，因此沒有可顯示的用量。"
          }
        }
      }
    },
    "chiefUsage.failed": {
      "comment": "Chief Usage page: reading the usage ledger failed; the page offers to try again",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Chief's usage could not be read. Try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة استخدام Chief. حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upotreba Chiefa nije mogla biti pročitana. Pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiefs forbrug kunne ikke læses. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nutzung des Chiefs konnte nicht gelesen werden. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el uso del Chief. Vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire l’utilisation du Chief. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere l’utilizzo del Chief. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief の使用量を読み取れませんでした。もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចអានការប្រើប្រាស់របស់ Chief បានទេ។ សូមព្យាយាមម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief의 사용량을 읽을 수 없습니다. 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiefs forbruk kunne ikke leses. Prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać użycia Chiefa. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o uso do Chief. Tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать использование Chief. Повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
