{
  "sourceLanguage": "en",
  "strings": {
    "artifacts.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Artifacts could not be loaded. Try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل العناصر المحفوظة. أعد المحاولة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Artefakti se nisu mogli učitati. Pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Artefakter kunne ikke indlæses. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Artefakte konnten nicht geladen werden. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar los artefactos. Vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les artefacts. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare gli artefatti. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーティファクトを読み込めませんでした。もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចផ្ទុកវត្ថុបុរាណបានទេ។ សូមព្យាយាមម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아티팩트를 불러올 수 없습니다. 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke laste inn artefakter. Prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można wczytać artefaktów. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar os artefatos. Tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить артефакты. Повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดอาร์ติแฟกต์ไม่ได้ ลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapıtlar yüklenemedi. Yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити артефакти. Спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tải tạo phẩm. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载制品。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入成品。請再試一次。"
          }
        }
      }
    },
    "artifacts.notFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing has been saved here yet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُحفظ أي شيء هنا بعد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje još ništa nije sačuvano."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ikke gemt noget her endnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier wurde noch nichts gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se ha guardado nada aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a encore été enregistré ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui non è ancora stato salvato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにはまだ何も保存されていません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនទាន់មានអ្វីត្រូវបានរក្សាទុកនៅទីនេះនៅឡើយទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 여기에 저장된 항목이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting er lagret her ennå."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic tu jeszcze nie zapisano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi salvo aqui ainda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь пока ничего не сохранено."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีสิ่งใดบันทึกไว้ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada henüz hiçbir şey kaydedilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут поки нічого не збережено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có gì được lưu ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里还没有保存任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡還沒有儲存任何內容。"
          }
        }
      }
    },
    "artifacts.refusal.preview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Artifacts is a preview feature: turn on Show Preview Features in Settings."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العناصر المحفوظة ميزة تجريبية: فعّل «إظهار الميزات التجريبية» في الإعدادات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Artefakti su funkcija u pregledu: uključite Prikaži funkcije u pregledu u Postavkama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Artefakter er en prøvefunktion: slå Vis prøvefunktioner til i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Artefakte ist eine Vorschaufunktion: Aktiviere „Vorschaufunktionen anzeigen“ in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Artefactos es una función preliminar: activa Mostrar funciones preliminares en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artefacts est une fonction en avant-première : activez Afficher les fonctions en avant-première dans les Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Artefatti è una funzione in anteprima: attiva Mostra funzioni in anteprima nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーティファクトはプレビュー機能です。設定で「プレビュー機能を表示」をオンにしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វត្ថុបុរាណគឺជាមុខងារសាកល្បង៖ បើក «បង្ហាញមុខងារសាកល្បង» នៅក្នុងការកំណត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아티팩트는 미리 보기 기능입니다. 설정에서 미리 보기 기능 표시를 켜세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Artefakter er en forhåndsvisningsfunksjon: slå på Vis forhåndsvisningsfunksjoner i Innstillinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Artefakty to funkcja w wersji zapoznawczej: włącz Pokazuj funkcje zapoznawcze w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Artefatos é um recurso em prévia: ative Mostrar recursos em prévia nos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Артефакты — функция предварительного просмотра: включите «Показывать предварительные функции» в настройках."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อาร์ติแฟกต์เป็นฟีเจอร์ทดลอง: เปิด แสดงฟีเจอร์ทดลอง ในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapıtlar bir önizleme özelliğidir: Ayarlar'da Önizleme Özelliklerini Göster'i açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Артефакти — функція попереднього перегляду: увімкніть «Показувати функції попереднього перегляду» в налаштуваннях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo phẩm là tính năng xem trước: bật Hiện tính năng xem trước trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "制品是预览功能：请在设置中打开“显示预览功能”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "成品是預覽功能：請在設定中開啟「顯示預覽功能」。"
          }
        }
      }
    },
    "artifacts.signedOut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to cmux to see your artifacts."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول إلى cmux لعرض عناصرك المحفوظة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se u cmux da vidite svoje artefakte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind på cmux for at se dine artefakter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich bei cmux an, um deine Artefakte zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en cmux para ver tus artefactos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à cmux pour voir vos artefacts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi a cmux per vedere i tuoi artefatti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーティファクトを表示するには cmux にサインインしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចូលគណនី cmux ដើម្បីមើលវត្ថុបុរាណរបស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아티팩트를 보려면 cmux에 로그인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg på cmux for å se artefaktene dine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się do cmux, aby zobaczyć swoje artefakty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre no cmux para ver seus artefatos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в cmux, чтобы увидеть свои артефакты."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าใช้ cmux เพื่อดูอาร์ติแฟกต์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapıtlarınızı görmek için cmux'ta oturum açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть у cmux, щоб побачити свої артефакти."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập cmux để xem tạo phẩm của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录 cmux 以查看你的制品。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入 cmux 以查看你的成品。"
          }
        }
      }
    },
