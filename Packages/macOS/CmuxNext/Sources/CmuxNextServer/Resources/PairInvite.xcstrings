    "pairInvite.installHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No cmux there yet? This line installs it, then pairs:"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يوجد cmux هناك بعد؟ هذا السطر يثبّته ثم يُقرن:"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tamo još nema cmux-a? Ova linija ga instalira, pa uparuje:"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen cmux der endnu? Denne linje installerer den og parrer derefter:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dort noch kein cmux? Diese Zeile installiert es und koppelt dann:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Aún no tiene cmux? Esta línea lo instala y luego vincula:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pas encore de cmux là-bas ? Cette ligne l'installe, puis associe :"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lì non c'è ancora cmux? Questa riga lo installa, poi associa:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "まだ cmux がない場合は、この行でインストールしてからペアリングします:"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនទាន់មាន cmux នៅទីនោះទេ? បន្ទាត់នេះដំឡើងវា រួចផ្គូផ្គង:"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "아직 cmux가 없나요? 이 줄이 설치한 다음 페어링합니다:"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen cmux der ennå? Denne linjen installerer den og kobler deretter til:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie ma tam jeszcze cmux? Ta linia go zainstaluje, a potem sparuje:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ainda não tem cmux lá? Esta linha instala e depois pareia:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Там ещё нет cmux? Эта строка установит его, а затем подключит:"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังไม่มี cmux ที่นั่นใช่ไหม บรรทัดนี้จะติดตั้งแล้วจับคู่:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Orada henüz cmux yok mu? Bu satır onu kurar, ardından eşler:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Там ще немає cmux? Цей рядок встановить його, а потім під'єднає:"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Máy đó chưa có cmux? Dòng này sẽ cài đặt rồi ghép nối:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "那里还没有 cmux？这一行会先安装再配对："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "那裡還沒有 cmux？這一行會先安裝再配對："
          }
        }
      }
    },
    "pairInvite.scan": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or scan it with a phone or a laptop camera."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أو امسحه بكاميرا هاتف أو حاسوب محمول."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ili ga skenirajte kamerom telefona ili laptopa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eller scan den med en telefon eller et laptopkamera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oder scanne ihn mit einem Telefon oder einer Laptopkamera."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O escanéalo con la cámara de un teléfono o un portátil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ou scannez-le avec un téléphone ou la caméra d'un portable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oppure scansionalo con un telefono o la fotocamera di un portatile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "または、スマートフォンやノートパソコンのカメラでスキャンします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ឬស្កេនវាដោយទូរស័ព្ទ ឬកាមេរ៉ាកុំព្យូទ័រយួរដៃ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "또는 휴대폰이나 노트북 카메라로 스캔하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eller skann den med en telefon eller et laptopkamera."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Albo zeskanuj go telefonem lub kamerą laptopa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ou escaneie com um celular ou a câmera de um notebook."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Или отсканируйте его телефоном или камерой ноутбука."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หรือสแกนด้วยโทรศัพท์หรือกล้องแล็ปท็อป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Veya bir telefonla ya da dizüstü bilgisayar kamerasıyla tarayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Або відскануйте його телефоном чи камерою ноутбука."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoặc quét bằng điện thoại hay camera laptop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "也可以用手机或笔记本电脑的摄像头扫描。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "也可以用手機或筆電的相機掃描。"
          }
        }
      }
    },
    "pairInvite.once": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It works once, on one machine."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعمل مرة واحدة، على جهاز واحد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Radi jednom, na jednom računaru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den virker én gang, på én maskine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Er funktioniert einmal, auf einem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Funciona una vez, en una máquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il fonctionne une fois, sur une machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Funziona una volta, su una macchina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 回だけ、1 台のマシンで使えます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "វាដំណើរការម្តង លើម៉ាស៊ីនមួយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "한 번, 한 대의 컴퓨터에서만 작동합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den virker én gang, på én maskin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Działa raz, na jednej maszynie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Funciona uma vez, em uma máquina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Работает один раз, на одном компьютере."
