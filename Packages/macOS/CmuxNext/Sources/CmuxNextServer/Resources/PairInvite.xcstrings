{
  "sourceLanguage": "en",
  "strings": {
    "pairInvite.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair Another Machine"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إقران جهاز آخر"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Upari drugi računar"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Par en anden maskine"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Weiteres Gerät koppeln"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vincular otra máquina"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Associer une autre machine"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Associa un'altra macchina"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "別のマシンをペアリング"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្គូផ្គងម៉ាស៊ីនផ្សេងទៀត"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다른 컴퓨터 페어링"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koble til en annen maskin"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sparuj inną maszynę"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Parear outra máquina"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подключить другой компьютер"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "จับคู่เครื่องอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Başka bir makineyi eşle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Під'єднати інший комп'ютер"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ghép nối máy khác"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "配对另一台机器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "配對另一台機器"
          }
        }
      }
    },
    "pairInvite.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the other machine, run this line in a terminal. No SSH needed. You confirm it here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "على الجهاز الآخر، شغّل هذا السطر في الطرفية. لا حاجة إلى SSH. ستؤكد ذلك هنا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na drugom računaru pokrenite ovu liniju u terminalu. SSH nije potreban. Potvrđujete ovdje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kør denne linje i en terminal på den anden maskine. Ingen SSH nødvendig. Du bekræfter her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Führe diese Zeile auf dem anderen Gerät in einem Terminal aus. Kein SSH nötig. Du bestätigst hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En la otra máquina, ejecuta esta línea en una terminal. No hace falta SSH. Lo confirmas aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sur l'autre machine, exécutez cette ligne dans un terminal. Pas besoin de SSH. Vous confirmez ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sull'altra macchina, esegui questa riga in un terminale. Non serve SSH. Confermi qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "もう一方のマシンのターミナルでこの行を実行してください。SSH は不要です。確認はここで行います。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "នៅលើម៉ាស៊ីនផ្សេងទៀត ដំណើរការបន្ទាត់នេះក្នុងស្ថានីយ។ មិនត្រូវការ SSH ទេ។ អ្នកបញ្ជាក់នៅទីនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다른 컴퓨터의 터미널에서 이 줄을 실행하세요. SSH는 필요 없습니다. 확인은 여기서 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kjør denne linjen i en terminal på den andre maskinen. Ingen SSH nødvendig. Du bekrefter her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na drugiej maszynie uruchom tę linię w terminalu. SSH nie jest potrzebne. Potwierdzasz tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na outra máquina, execute esta linha em um terminal. Não precisa de SSH. Você confirma aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На другом компьютере выполните эту строку в терминале. SSH не нужен. Подтверждение — здесь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "บนเครื่องอื่น ให้รันบรรทัดนี้ในเทอร์มินัล ไม่ต้องใช้ SSH คุณยืนยันที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diğer makinede bu satırı bir terminalde çalıştırın. SSH gerekmez. Onayı burada verirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На іншому комп'ютері виконайте цей рядок у терміналі. SSH не потрібен. Підтвердження — тут."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trên máy kia, chạy dòng này trong terminal. Không cần SSH. Bạn xác nhận tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在另一台机器的终端中运行这一行。无需 SSH。你在这里确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在另一台機器的終端機中執行這一行。不需要 SSH。你在這裡確認。"
          }
        }
      }
    },
