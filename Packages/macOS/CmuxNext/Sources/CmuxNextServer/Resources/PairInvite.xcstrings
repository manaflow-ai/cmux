    "pairInvite.voided": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A second machine used this code, so nothing was paired and the code no longer works. Make a new code and use it on one machine only."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "استخدم جهاز ثانٍ هذا الرمز، لذا لم يُقرن شيء ولم يعد الرمز يعمل. أنشئ رمزًا جديدًا واستخدمه على جهاز واحد فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Drugi računar je iskoristio ovaj kod, pa ništa nije upareno i kod više ne radi. Napravite novi kod i koristite ga samo na jednom računaru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En anden maskine brugte denne kode, så intet blev parret, og koden virker ikke længere. Lav en ny kode, og brug den kun på én maskine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein zweites Gerät hat diesen Code verwendet, daher wurde nichts gekoppelt und der Code funktioniert nicht mehr. Erstelle einen neuen Code und verwende ihn nur auf einem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una segunda máquina usó este código, así que no se vinculó nada y el código ya no funciona. Crea un código nuevo y úsalo en una sola máquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une deuxième machine a utilisé ce code : rien n'a été associé et le code ne fonctionne plus. Créez un nouveau code et utilisez-le sur une seule machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una seconda macchina ha usato questo codice, quindi non è stato associato nulla e il codice non funziona più. Crea un nuovo codice e usalo su una sola macchina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "別のマシンもこのコードを使ったため、何もペアリングされず、コードは使えなくなりました。新しいコードを作成し、1 台のマシンだけで使ってください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ម៉ាស៊ីនទីពីរបានប្រើកូដនេះ ដូច្នេះគ្មានអ្វីត្រូវបានផ្គូផ្គងទេ ហើយកូដលែងដំណើរការទៀតហើយ។ បង្កើតកូដថ្មី ហើយប្រើវាលើម៉ាស៊ីនតែមួយប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다른 컴퓨터도 이 코드를 사용해 아무것도 페어링되지 않았고 코드는 더 이상 작동하지 않습니다. 새 코드를 만들어 한 대의 컴퓨터에서만 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En annen maskin brukte denne koden, så ingenting ble koblet til, og koden virker ikke lenger. Lag en ny kode og bruk den bare på én maskin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Druga maszyna użyła tego kodu, więc nic nie zostało sparowane, a kod już nie działa. Utwórz nowy kod i użyj go tylko na jednej maszynie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma segunda máquina usou este código, então nada foi pareado e o código não funciona mais. Crie um novo código e use-o em apenas uma máquina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот код использовал второй компьютер, поэтому ничего не подключено, и код больше не работает. Создайте новый код и используйте его только на одном компьютере."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "มีเครื่องที่สองใช้รหัสนี้ จึงไม่มีการจับคู่และรหัสใช้ไม่ได้อีกต่อไป สร้างรหัสใหม่และใช้บนเครื่องเดียวเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu kodu ikinci bir makine kullandı; bu yüzden hiçbir şey eşlenmedi ve kod artık çalışmıyor. Yeni bir kod oluşturup yalnızca tek bir makinede kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цей код використав другий комп'ютер, тому нічого не під'єднано, а код більше не працює. Створіть новий код і використайте його лише на одному комп'ютері."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Một máy thứ hai đã dùng mã này nên không có gì được ghép nối và mã không còn dùng được. Hãy tạo mã mới và chỉ dùng trên một máy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "第二台机器使用了此代码，因此没有完成配对，代码也已失效。请生成新代码，并只在一台机器上使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "第二台機器使用了此代碼，因此沒有完成配對，代碼也已失效。請產生新代碼，並只在一台機器上使用。"
          }
        }
      }
    },
