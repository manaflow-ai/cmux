    "pairInvite.confirmNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Confirm to pair it. Only a click pairs it, never a key or a script."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "انقر تأكيد لإقرانه. النقر وحده يُقرنه، وليس مفتاحًا أو نصًا برمجيًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kliknite Potvrdi da ga uparite. Uparuje samo klik, nikad tipka ili skripta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klik på Bekræft for at parre den. Kun et klik parrer den, aldrig en tast eller et script."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klicke auf Bestätigen, um es zu koppeln. Nur ein Klick koppelt, nie eine Taste oder ein Skript."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Haz clic en Confirmar para vincularla. Solo un clic la vincula, nunca una tecla ni un script."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cliquez sur Confirmer pour l'associer. Seul un clic l'associe, jamais une touche ni un script."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fai clic su Conferma per associarla. Solo un clic la associa, mai un tasto o uno script."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「確認」をクリックしてペアリングします。ペアリングできるのはクリックだけで、キーやスクリプトではできません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ចុច បញ្ជាក់ ដើម្បីផ្គូផ្គងវា។ មានតែការចុចប៉ុណ្ណោះដែលផ្គូផ្គង មិនមែនគ្រាប់ចុច ឬស្គ្រីបទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "확인을 클릭해 페어링하세요. 클릭만 페어링하며 키나 스크립트로는 할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klikk Bekreft for å koble den til. Bare et klikk kobler den til, aldri en tast eller et skript."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kliknij Potwierdź, aby ją sparować. Paruje tylko kliknięcie, nigdy klawisz ani skrypt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clique em Confirmar para pareá-la. Só um clique pareia, nunca uma tecla ou um script."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Нажмите «Подтвердить», чтобы подключить его. Подключает только щелчок, а не клавиша или скрипт."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คลิก ยืนยัน เพื่อจับคู่ จับคู่ได้ด้วยการคลิกเท่านั้น ไม่ใช่ปุ่มหรือสคริปต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eşlemek için Onayla'ya tıklayın. Yalnızca bir tıklama eşler, asla bir tuş ya da betik değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Натисніть «Підтвердити», щоб під'єднати його. Під'єднує лише клацання, а не клавіша чи скрипт."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhấp Xác nhận để ghép nối. Chỉ cú nhấp mới ghép nối, không phải phím hay tập lệnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "点按“确认”进行配对。只有点按才能配对，按键或脚本都不行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "按一下「確認」進行配對。只有按一下才能配對，按鍵或指令碼都不行。"
          }
        }
      }
    },
