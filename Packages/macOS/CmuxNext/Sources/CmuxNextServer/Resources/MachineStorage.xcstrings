    "machineStorage.safety": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُؤرشف العمل الموجود على هذا الـ Mac فقط أولًا، وتعود شجرة العمل التي نُظّفت عند فتح جلستها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rad koji postoji samo na ovom Macu prvo se arhivira, a očišćeno radno stablo se vraća kada se otvori njegova sesija."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbejde, der kun findes på denne Mac, arkiveres først, og en oprydet worktree kommer tilbage, når dens session åbnes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeit, die nur auf diesem Mac liegt, wird zuerst archiviert, und ein bereinigter Worktree kommt zurück, wenn seine Sitzung geöffnet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work that lives only on this Mac is archived first, and a cleaned-up worktree comes back when its session opens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El trabajo que solo está en este Mac se archiva primero, y un worktree limpiado vuelve cuando se abre su sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le travail présent uniquement sur ce Mac est d’abord archivé, et un worktree nettoyé revient à l’ouverture de sa session."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il lavoro presente solo su questo Mac viene prima archiviato, e un worktree pulito torna quando si apre la sua sessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac にしかない作業は先にアーカイブされ、クリーンアップしたワークツリーはそのセッションを開くと戻ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការងារដែលមានតែនៅលើ Mac នេះត្រូវបានរក្សាទុកក្នុងបណ្ណសារជាមុន ហើយ Worktree ដែលបានសម្អាតនឹងត្រឡប់មកវិញនៅពេលបើកវគ្គរបស់វា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에만 있는 작업은 먼저 보관되며, 정리된 워크트리는 해당 세션을 열면 돌아옵니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeid som bare finnes på denne Mac-en, arkiveres først, og en ryddet worktree kommer tilbake når økten åpnes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Praca, która istnieje tylko na tym Macu, jest najpierw archiwizowana, a wyczyszczony worktree wraca po otwarciu jego sesji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O trabalho que existe só neste Mac é arquivado primeiro, e um worktree limpo volta quando sua sessão é aberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работа, которая есть только на этом Mac, сначала архивируется, а очищенный worktree возвращается, когда открывается его сеанс."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานที่มีอยู่บน Mac เครื่องนี้เท่านั้นจะถูกเก็บถาวรก่อน และ Worktree ที่ล้างแล้วจะกลับมาเมื่อเปิดเซสชันของมัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu Mac'te bulunan çalışmalar önce arşivlenir; temizlenen bir worktree, oturumu açıldığında geri gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Робота, яка є лише на цьому Mac, спершу архівується, а очищений worktree повертається, коли відкривається його сеанс."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công việc chỉ có trên máy Mac này sẽ được lưu trữ trước, và worktree đã dọn dẹp sẽ quay lại khi phiên của nó được mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅存在于此 Mac 上的工作会先归档，清理后的工作树会在其会话打开时恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅存在於此 Mac 上的工作會先封存，清理後的工作樹會在其工作階段開啟時恢復。"
          }
        }
      }
    },
