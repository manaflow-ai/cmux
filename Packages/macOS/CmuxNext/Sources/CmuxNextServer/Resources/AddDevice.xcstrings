      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its chats edit files and run commands here without asking"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعدّل محادثاته الملفات وتشغّل الأوامر هنا دون أن تسأل"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
