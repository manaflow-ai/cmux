    "devices.removeFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux could not remove it from every place. Try again, or run cmux device remove in a terminal to see why."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّر على cmux إزالته من كل مكان. حاول مرة أخرى، أو شغّل cmux device remove في طرفية لمعرفة السبب."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux ga nije mogao ukloniti sa svih mjesta. Pokušajte ponovo ili pokrenite cmux device remove u terminalu da vidite zašto."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux kunne ikke fjerne den alle steder. Prøv igen, eller kør cmux device remove i en terminal for at se hvorfor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux konnte es nicht überall entfernen. Versuche es erneut oder führe cmux device remove in einem Terminal aus, um den Grund zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux no pudo quitarlo de todas partes. Inténtalo de nuevo o ejecuta cmux device remove en un terminal para ver por qué."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux n’a pas pu le retirer de partout. Réessayez, ou exécutez cmux device remove dans un terminal pour voir pourquoi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux non è riuscito a rimuoverlo ovunque. Riprova, o esegui cmux device remove in un terminale per vedere perché."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux はすべての場所から削除できませんでした。もう一度試すか、ターミナルで cmux device remove を実行して理由を確認してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux មិនអាចដកវាចេញពីគ្រប់កន្លែងបានទេ។ សូមព្យាយាមម្ដងទៀត ឬដំណើរការ cmux device remove ក្នុងទែមីណាល់ដើម្បីមើលមូលហេតុ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux가 모든 곳에서 제거하지 못했습니다. 다시 시도하거나 터미널에서 cmux device remove를 실행해 이유를 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux kunne ikke fjerne den overalt. Prøv igjen, eller kjør cmux device remove i en terminal for å se hvorfor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux nie mógł usunąć go ze wszystkich miejsc. Spróbuj ponownie lub uruchom cmux device remove w terminalu, aby zobaczyć powód."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cmux não conseguiu removê-lo de todos os lugares. Tente de novo, ou rode cmux device remove em um terminal para ver o motivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux не смог удалить его отовсюду. Попробуйте снова или выполните cmux device remove в терминале, чтобы увидеть причину."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux ลบออกจากทุกที่ไม่ได้ ลองอีกครั้ง หรือรัน cmux device remove ในเทอร์มินัลเพื่อดูสาเหตุ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux onu her yerden kaldıramadı. Yeniden deneyin ya da nedenini görmek için bir terminalde cmux device remove çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux не зміг вилучити його звідусіль. Спробуйте ще раз або виконайте cmux device remove у терміналі, щоб побачити причину."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux không thể gỡ nó khỏi mọi nơi. Hãy thử lại, hoặc chạy cmux device remove trong terminal để xem lý do."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 无法从所有位置移除它。请重试，或在终端中运行 cmux device remove 查看原因。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 無法從所有位置移除它。請再試一次，或在終端機執行 cmux device remove 查看原因。"
          }
        }
      }
    },
