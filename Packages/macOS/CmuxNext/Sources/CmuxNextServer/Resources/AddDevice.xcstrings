    "addDevice.network.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a computer to run your agents on it. cmux installs what it needs and checks each step."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اختر كمبيوترًا لتشغيل وكلائك عليه. يثبّت cmux ما يحتاجه ويتحقق من كل خطوة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odaberite računar na kojem će raditi vaši agenti. cmux instalira šta treba i provjerava svaki korak."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vælg en computer, dine agenter skal køre på. cmux installerer det nødvendige og tjekker hvert trin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wähle einen Computer, auf dem deine Agenten laufen sollen. cmux installiert, was nötig ist, und prüft jeden Schritt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elige un ordenador donde ejecutar tus agentes. cmux instala lo necesario y comprueba cada paso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisissez un ordinateur où exécuter vos agents. cmux installe ce qu’il faut et vérifie chaque étape."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scegli un computer su cui eseguire i tuoi agenti. cmux installa ciò che serve e controlla ogni passaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントを実行するコンピュータを選んでください。cmux が必要なものをインストールし、各ステップを確認します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ជ្រើសកុំព្យូទ័រដើម្បីដំណើរការភ្នាក់ងាររបស់អ្នក។ cmux ដំឡើងអ្វីដែលត្រូវការ ហើយពិនិត្យជំហាននីមួយៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트를 실행할 컴퓨터를 선택하세요. cmux가 필요한 것을 설치하고 각 단계를 확인합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Velg en datamaskin agentene skal kjøre på. cmux installerer det som trengs og sjekker hvert steg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybierz komputer, na którym mają działać agenci. cmux zainstaluje, co trzeba, i sprawdzi każdy krok."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolha um computador para rodar seus agentes. O cmux instala o que precisa e verifica cada etapa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выберите компьютер для запуска агентов. cmux установит всё нужное и проверит каждый шаг."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เลือกคอมพิวเตอร์ที่จะรันเอเจนต์ของคุณ cmux จะติดตั้งสิ่งที่จำเป็นและตรวจทุกขั้นตอน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajanlarınızı çalıştıracak bir bilgisayar seçin. cmux gerekenleri kurar ve her adımı denetler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Виберіть комп’ютер для запуску агентів. cmux установить усе потрібне й перевірить кожен крок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chọn một máy tính để chạy tác tử. cmux cài những gì cần và kiểm tra từng bước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "选择一台电脑来运行你的智能体。cmux 会安装所需内容并检查每一步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選擇一台電腦來執行你的代理程式。cmux 會安裝所需項目並檢查每個步驟。"
          }
        }
      }
    },
    "addDevice.network.sshKeyHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It needs ssh that signs in with a key, not a password."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب ssh يسجّل الدخول بمفتاح، لا بكلمة مرور."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potreban je ssh koji se prijavljuje ključem, ne lozinkom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kræver ssh, der logger ind med en nøgle, ikke en adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dafür braucht es ssh, das sich mit einem Schlüssel anmeldet, nicht mit einem Passwort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita ssh que inicie sesión con una clave, no con una contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut un ssh qui se connecte avec une clé, pas avec un mot de passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve ssh che acceda con una chiave, non con una password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードではなく鍵でサインインできる ssh が必要です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វាត្រូវការ ssh ដែលចូលដោយប្រើកូនសោ មិនមែនពាក្យសម្ងាត់ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호가 아닌 키로 로그인하는 ssh가 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det krever ssh som logger inn med en nøkkel, ikke et passord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymaga ssh logującego się kluczem, a nie hasłem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É preciso ssh que entre com uma chave, não com uma senha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен ssh со входом по ключу, а не по паролю."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
