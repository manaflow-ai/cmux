    "devices.join.revokeAll": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn Off Screen Sharing and Control"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إيقاف مشاركة الشاشة والتحكم"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isključi dijeljenje ekrana i kontrolu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slå skærmdeling og styring fra"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bildschirmfreigabe und Steuerung ausschalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desactivar compartir pantalla y control"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désactiver le partage d'écran et le contrôle"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Disattiva condivisione schermo e controllo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "画面共有と操作をオフにする"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បិទការចែករំលែកអេក្រង់ និងការគ្រប់គ្រង"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "화면 공유 및 제어 끄기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slå av skjermdeling og kontroll"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wyłącz udostępnianie ekranu i sterowanie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desativar compartilhamento de tela e controle"
          }
        },
        "ru": {
          "stringUnit": {
