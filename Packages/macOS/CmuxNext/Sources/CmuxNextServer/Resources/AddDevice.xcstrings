    "devices.join.ask.screenQuestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow screen sharing from your team's machines?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هل تسمح بمشاركة الشاشة مع أجهزة فريقك؟"
