    "devices.join.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your team's machines reach this Mac through the mesh. They cannot see or control it until you allow it here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تصل أجهزة فريقك إلى هذا الـ Mac عبر الشبكة. لا يمكنها رؤيته أو التحكم فيه حتى تسمح بذلك هنا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mašine vašeg tima dolaze do ovog Maca kroz mrežu. Ne mogu ga vidjeti ni upravljati njime dok to ovdje ne dozvolite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dit teams maskiner når denne Mac gennem nettet. De kan ikke se eller styre den, før du tillader det her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Rechner deines Teams erreichen diesen Mac über das Netz. Sie können ihn erst sehen oder steuern, wenn du es hier erlaubst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las máquinas de tu equipo llegan a este Mac por la red. No pueden verlo ni controlarlo hasta que lo permitas aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les machines de votre équipe atteignent ce Mac par le réseau. Elles ne peuvent ni le voir ni le contrôler tant que vous ne l’autorisez pas ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le macchine del tuo team raggiungono questo Mac tramite la rete. Non possono vederlo né controllarlo finché non lo consenti qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "チームのマシンはメッシュ経由でこの Mac に接続します。ここで許可するまで、画面を見ることも操作することもできません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ម៉ាស៊ីនរបស់ក្រុមអ្នកភ្ជាប់មក Mac នេះតាមបណ្ដាញ។ ពួកវាមិនអាចមើល ឬគ្រប់គ្រងវាបានទេ រហូតដល់អ្នកអនុញ្ញាតនៅទីនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "팀의 머신은 메시를 통해 이 Mac에 연결됩니다. 여기서 허용하기 전까지는 화면을 보거나 제어할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teamets maskiner når denne Mac-en gjennom nettet. De kan ikke se eller styre den før du tillater det her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maszyny Twojego zespołu łączą się z tym Makiem przez sieć. Nie mogą go widzieć ani nim sterować, dopóki nie pozwolisz na to tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As máquinas da sua equipe chegam a este Mac pela rede. Elas não podem vê-lo nem controlá-lo até você permitir aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Машины вашей команды подключаются к этому Mac через сеть. Они не смогут видеть его или управлять им, пока вы не разрешите это здесь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เครื่องของทีมคุณเข้าถึง Mac เครื่องนี้ผ่านเครือข่าย แต่จะดูหรือควบคุมไม่ได้จนกว่าคุณจะอนุญาตที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ekibinizin makineleri bu Mac'e ağ üzerinden ulaşır. Siz burada izin verene kadar onu göremez veya kontrol edemezler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Машини вашої команди під’єднуються до цього Mac через мережу. Вони не можуть бачити його чи керувати ним, доки ви не дозволите тут."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các máy của nhóm bạn kết nối với máy Mac này qua mạng. Chúng không thể xem hoặc điều khiển máy cho đến khi bạn cho phép tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你团队的机器通过网络连接到这台 Mac。在你于此处允许之前，它们无法查看或控制它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你團隊的機器透過網路連到這台 Mac。在你於此處允許之前，它們無法檢視或控制它。"
          }
        }
      }
    },
