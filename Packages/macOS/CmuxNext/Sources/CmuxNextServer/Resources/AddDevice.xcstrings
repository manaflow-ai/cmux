    "devices.control.log.pinned": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed %@ to turn Control on and off"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سُمح لـ %@ بتشغيل التحكم وإيقافه"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvoljeno %@ da uključuje i isključuje upravljanje"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillod %@ at slå styring til og fra"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ darf die Steuerung ein- und ausschalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se permitió a %@ activar y desactivar el control"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ autorisé à activer et désactiver le contrôle"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consentito a %@ di attivare e disattivare il controllo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に操作のオン・オフを許可"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បានអនុញ្ញាតឱ្យ %@ បើក និងបិទការគ្រប់គ្រង"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 제어를 켜고 끄도록 허용함"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillot %@ å slå styring av og på"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwolono %@ na włączanie i wyłączanie sterowania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pode ativar e desativar o controle"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ разрешено включать и выключать управление"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้ %@ เปิดและปิดการควบคุม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cihazının kontrolü açıp kapatmasına izin verildi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ дозволено вмикати й вимикати керування"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã cho phép %@ bật và tắt điều khiển"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已允许 %@ 开启和关闭控制"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已允許 %@ 開啟和關閉控制"
