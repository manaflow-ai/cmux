    "devices.removeHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It stops working with this computer at once. To use it again, add it again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتوقف عن العمل مع هذا الكمبيوتر فورًا. لاستخدامه مرة أخرى، أضفه مجددًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odmah prestaje raditi s ovim računarom. Da ga ponovo koristite, dodajte ga ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den holder straks op med at virke med denne computer. Tilføj den igen for at bruge den igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es funktioniert sofort nicht mehr mit diesem Computer. Um es wieder zu nutzen, füge es erneut hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deja de funcionar con este ordenador al instante. Para volver a usarlo, añádelo otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il cesse aussitôt de fonctionner avec cet ordinateur. Pour le réutiliser, ajoutez-le de nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Smette subito di funzionare con questo computer. Per usarlo di nuovo, aggiungilo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンピュータとの連携はすぐに停止します。再び使うには、もう一度追加してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "វាឈប់ដំណើរការជាមួយកុំព្យូទ័រនេះភ្លាមៗ។ ដើម្បីប្រើវាម្ដងទៀត សូមបន្ថែមវាឡើងវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 컴퓨터와 즉시 작동을 멈춥니다. 다시 사용하려면 다시 추가하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den slutter straks å virke med denne datamaskinen. Legg den til igjen for å bruke den igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Od razu przestaje działać z tym komputerem. Aby znów go używać, dodaj go ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ele para de funcionar com este computador na hora. Para usar de novo, adicione de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Он сразу перестанет работать с этим компьютером. Чтобы снова использовать его, добавьте заново."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "จะหยุดทำงานกับเครื่องนี้ทันที หากต้องการใช้อีก ให้เพิ่มใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu bilgisayarla hemen çalışmayı bırakır. Yeniden kullanmak için yeniden ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Він одразу перестане працювати з цим комп’ютером. Щоб знову ним користуватися, додайте його знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nó ngừng hoạt động với máy này ngay lập tức. Muốn dùng lại, hãy thêm lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它会立即停止与这台电脑配合。要再次使用，请重新添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它會立即停止與這台電腦配合。若要再次使用，請重新加入。"
          }
        }
      }
