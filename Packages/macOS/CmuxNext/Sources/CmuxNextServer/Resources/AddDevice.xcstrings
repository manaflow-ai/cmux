        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Разрешить общий экран для машин вашей команды?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อนุญาตให้เครื่องของทีมคุณแชร์หน้าจอหรือไม่"
