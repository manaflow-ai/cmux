    "devices.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No other device can reach this computer yet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
