    "devices.join.grantor.askTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ asks to turn Control on and off here"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب %@ تشغيل التحكم وإيقافه هنا"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ traži da ovdje uključuje i isključuje upravljanje"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ beder om at slå styring til og fra her"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ möchte die Steuerung hier ein- und ausschalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pide activar y desactivar el control aquí"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ demande à activer et désactiver le contrôle ici"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chiede di attivare e disattivare il controllo qui"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がここで操作のオンとオフを切り替える許可を求めています"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ សុំបើក និងបិទការគ្រប់គ្រងនៅទីនេះ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 여기의 제어를 켜고 끄도록 요청합니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ber om å slå styring av og på her"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ prosi o włączanie i wyłączanie sterowania tutaj"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pede para ativar e desativar o controle aqui"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ просит включать и выключать управление здесь"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ขอเปิดและปิดการควบคุมที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ burada kontrolü açıp kapatmak istiyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ просить вмикати й вимикати керування тут"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ yêu cầu bật và tắt điều khiển tại đây"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 请求在此处开启和关闭控制"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 請求在此處開啟和關閉控制"
          }
        }
      }
    },
    "devices.join.grantor.askHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow it only if these words match the ones %@ shows in Settings > Devices. After that, its switch turns this machine's Control and Screen sharing on and off without asking here again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بذلك فقط إذا تطابقت هذه الكلمات مع الكلمات التي يعرضها %@ في الإعدادات > الأجهزة. بعد ذلك، يشغّل مفتاحه التحكم ومشاركة الشاشة على هذا الجهاز ويوقفهما دون أن يسأل هنا مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvoli samo ako se ove riječi poklapaju s onima koje %@ prikazuje u Postavke > Uređaji. Nakon toga njegov prekidač uključuje i isključuje upravljanje i dijeljenje ekrana na ovoj mašini bez ponovnog pitanja ovdje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad det kun, hvis disse ord matcher dem, %@ viser i Indstillinger > Enheder. Derefter slår dens kontakt styring og skærmdeling på denne maskine til og fra uden at spørge her igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube es nur, wenn diese Wörter mit denen übereinstimmen, die %@ unter Einstellungen > Geräte anzeigt. Danach schaltet sein Schalter Steuerung und Bildschirmfreigabe dieses Geräts ein und aus, ohne hier erneut zu fragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permítelo solo si estas palabras coinciden con las que muestra %@ en Ajustes > Dispositivos. Después, su interruptor activa y desactiva el control y compartir pantalla en esta máquina sin volver a preguntar aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez-le seulement si ces mots correspondent à ceux que %@ affiche dans Réglages > Appareils. Ensuite, son interrupteur active et désactive le contrôle et le partage d’écran de cette machine sans redemander ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti solo se queste parole corrispondono a quelle che %@ mostra in Impostazioni > Dispositivi. Dopo, il suo interruttore attiva e disattiva controllo e condivisione schermo su questa macchina senza chiedere di nuovo qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの単語が %@ の「設定 > デバイス」に表示される単語と一致する場合にのみ許可してください。以後、そのスイッチでこのマシンの操作と画面共有をオン・オフでき、ここで再び確認されることはありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អនុញ្ញាតតែប្រសិនបើពាក្យទាំងនេះត្រូវនឹងពាក្យដែល %@ បង្ហាញក្នុង ការកំណត់ > ឧបករណ៍។ បន្ទាប់មក កុងតាក់របស់វាបើក និងបិទការគ្រប់គ្រង និងការចែករំលែកអេក្រង់នៃម៉ាស៊ីននេះ ដោយមិនសួរនៅទីនេះម្តងទៀតទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단어가 %@의 설정 > 기기에 표시된 단어와 일치할 때만 허용하세요. 그 후에는 해당 스위치로 이 기기의 제어와 화면 공유를 여기서 다시 묻지 않고 켜고 끌 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat det bare hvis disse ordene samsvarer med dem %@ viser i Innstillinger > Enheter. Deretter slår bryteren dens styring og skjermdeling på denne maskinen av og på uten å spørre her igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól tylko wtedy, gdy te słowa zgadzają się z tymi, które %@ pokazuje w Ustawienia > Urządzenia. Potem jego przełącznik włącza i wyłącza sterowanie oraz udostępnianie ekranu tej maszyny bez ponownego pytania tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita apenas se estas palavras forem iguais às que %@ mostra em Ajustes > Dispositivos. Depois disso, o botão dele ativa e desativa o controle e o compartilhamento de tela desta máquina sem perguntar aqui de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешайте, только если эти слова совпадают со словами, которые %@ показывает в «Настройки > Устройства». После этого его переключатель включает и выключает управление и общий экран этой машины, не спрашивая здесь снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตเฉพาะเมื่อคำเหล่านี้ตรงกับคำที่ %@ แสดงใน การตั้งค่า > อุปกรณ์ หลังจากนั้น สวิตช์ของเครื่องนั้นจะเปิดและปิดการควบคุมและการแชร์หน้าจอของเครื่องนี้โดยไม่ถามที่นี่อีก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu sözcükler %@ cihazının Ayarlar > Aygıtlar bölümünde gösterdikleriyle eşleşiyorsa izin verin. Bundan sonra onun anahtarı bu makinenin kontrolünü ve ekran paylaşımını burada yeniden sormadan açıp kapatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволяйте, лише якщо ці слова збігаються зі словами, які %@ показує в «Параметри > Пристрої». Після цього його перемикач вмикає й вимикає керування та спільний доступ до екрана цієї машини, не питаючи тут знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ cho phép nếu các từ này khớp với các từ %@ hiển thị trong Cài đặt > Thiết bị. Sau đó, công tắc của máy đó sẽ bật và tắt điều khiển và chia sẻ màn hình của máy này mà không hỏi lại ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有当这些词与 %@ 在“设置 > 设备”中显示的词一致时才允许。之后，它的开关可以开启和关闭本机的控制与屏幕共享，不会在此处再次询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有當這些詞與 %@ 在「設定 > 裝置」中顯示的詞一致時才允許。之後，它的開關可以開啟和關閉本機的控制與螢幕共享，不會在此處再次詢問。"
          }
        }
      }
    },
    "devices.join.grantor.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can turn Control on and off here · %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنه تشغيل التحكم وإيقافه هنا · %@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Može ovdje uključivati i isključivati upravljanje · %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan slå styring til og fra her · %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann die Steuerung hier ein- und ausschalten · %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede activar y desactivar el control aquí · %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peut activer et désactiver le contrôle ici · %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Può attivare e disattivare il controllo qui · %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで操作をオン・オフできます · %@"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អាចបើក និងបិទការគ្រប់គ្រងនៅទីនេះ · %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 제어를 켜고 끌 수 있음 · %@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan slå styring av og på her · %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Może włączać i wyłączać tu sterowanie · %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode ativar e desativar o controle aqui · %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Может включать и выключать управление здесь · %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดและปิดการควบคุมที่นี่ได้ · %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada kontrolü açıp kapatabilir · %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Може вмикати й вимикати керування тут · %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể bật và tắt điều khiển tại đây · %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可在此处开启和关闭控制 · %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可在此處開啟和關閉控制 · %@"
          }
        }
      }
    },
    "devices.join.grantor.trustFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not allowed: this Mac could not confirm it was you. Try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُسمح: تعذّر على هذا الـ Mac التأكد من أنك أنت. حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije dozvoljeno: ovaj Mac nije mogao potvrditi da ste to vi. Pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke tilladt: Denne Mac kunne ikke bekræfte, at det var dig. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht erlaubt: Dieser Mac konnte nicht bestätigen, dass du es warst. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No permitido: este Mac no pudo confirmar que eras tú. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non autorisé : ce Mac n’a pas pu confirmer que c’était vous. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non consentito: questo Mac non ha potuto confermare che eri tu. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可されていません: この Mac はあなた本人であることを確認できませんでした。もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនបានអនុញ្ញាត៖ Mac នេះមិនអាចបញ្ជាក់ថាជាអ្នកបានទេ។ សូមព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용되지 않음: 이 Mac에서 본인임을 확인할 수 없었습니다. 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke tillatt: Denne Macen kunne ikke bekrefte at det var deg. Prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zezwolono: ten Mac nie mógł potwierdzić, że to Ty. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não permitido: este Mac não conseguiu confirmar que era você. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не разрешено: этот Mac не смог подтвердить, что это вы. Попробуйте ещё раз."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่อนุญาต: Mac เครื่องนี้ยืนยันไม่ได้ว่าเป็นคุณ ลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin verilmedi: Bu Mac sizin olduğunuzu doğrulayamadı. Yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не дозволено: цей Mac не зміг підтвердити, що це ви. Спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không được phép: máy Mac này không thể xác nhận đó là bạn. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未允许：此 Mac 无法确认是你本人。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未允許：此 Mac 無法確認是你本人。請再試一次。"
          }
        }
      }
    },
    "devices.join.grantor.confirmReason": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "let your other Mac turn this Mac's Control and Screen sharing on and off"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح لجهاز Mac الآخر بتشغيل التحكم ومشاركة الشاشة على هذا الـ Mac وإيقافهما"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "dozvoliti vašem drugom Macu da uključuje i isključuje upravljanje i dijeljenje ekrana na ovom Macu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "lade din anden Mac slå styring og skærmdeling på denne Mac til og fra"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "deinem anderen Mac erlauben, Steuerung und Bildschirmfreigabe dieses Macs ein- und auszuschalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "permitir que tu otro Mac active y desactive el control y compartir pantalla de este Mac"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "permettre à votre autre Mac d’activer et de désactiver le contrôle et le partage d’écran de ce Mac"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "consentire al tuo altro Mac di attivare e disattivare controllo e condivisione schermo di questo Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の Mac にこの Mac の操作と画面共有のオン・オフを許可する"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អនុញ្ញាតឱ្យ Mac ផ្សេងទៀតរបស់អ្នកបើក និងបិទការគ្រប់គ្រង និងការចែករំលែកអេក្រង់នៃ Mac នេះ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 Mac이 이 Mac의 제어와 화면 공유를 켜고 끄도록 허용"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "la den andre Macen din slå styring og skjermdeling på denne Macen av og på"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "pozwolić innemu Macowi włączać i wyłączać sterowanie oraz udostępnianie ekranu tego Maca"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "permitir que seu outro Mac ative e desative o controle e o compartilhamento de tela deste Mac"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "разрешить другому вашему Mac включать и выключать управление и общий экран этого Mac"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้ Mac อีกเครื่องของคุณเปิดและปิดการควบคุมและการแชร์หน้าจอของ Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "diğer Mac'inizin bu Mac'in kontrolünü ve ekran paylaşımını açıp kapatmasına izin vermek"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "дозволити іншому вашому Mac вмикати й вимикати керування та спільний доступ до екрана цього Mac"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cho phép máy Mac khác của bạn bật và tắt điều khiển và chia sẻ màn hình của máy Mac này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许你的另一台 Mac 开启和关闭此 Mac 的控制与屏幕共享"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許你的另一台 Mac 開啟和關閉此 Mac 的控制與螢幕共享"
          }
        }
      }
    },
