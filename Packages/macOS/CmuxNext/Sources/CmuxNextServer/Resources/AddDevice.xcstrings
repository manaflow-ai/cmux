        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認なしでこの Mac のファイルを編集し、コマンドを実行します"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កែសម្រួលឯកសារ និងដំណើរការពាក្យបញ្ជានៅទីនេះដោយមិនសួរ"
