        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "팀 머신의 화면 공유를 허용할까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tillate skjermdeling fra teamets maskiner?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zezwolić na udostępnianie ekranu maszynom zespołu?"
