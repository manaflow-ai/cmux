          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todavía se está guardando el último cambio. Vuelve a intentarlo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La dernière modification est encore en cours d'enregistrement. Réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'ultima modifica è ancora in fase di salvataggio. Riprova tra un attimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "前回の変更をまだ保存しています。しばらくしてからもう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "នៅតែកំពុងរក្សាទុកការផ្លាស់ប្ដូរចុងក្រោយ។ សូមព្យាយាមម្ដងទៀតបន្តិចទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "마지막 변경 사항을 아직 저장하는 중입니다. 잠시 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den siste endringen lagres fortsatt. Prøv igjen om et øyeblikk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ostatnia zmiana jest nadal zapisywana. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A última alteração ainda está sendo salva. Tente novamente em instantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Последнее изменение ещё сохраняется. Попробуйте ещё раз через мгновение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังคงบันทึกการเปลี่ยนแปลงล่าสุดอยู่ โปรดลองอีกครั้งในอีกสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Son değişiklik hâlâ kaydediliyor. Birazdan yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Остання зміна ще зберігається. Спробуйте ще раз за мить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vẫn đang lưu thay đổi gần nhất. Hãy thử lại sau giây lát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仍在保存上一次更改。请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仍在儲存上一次變更。請稍後再試。"
          }
        }
      }
