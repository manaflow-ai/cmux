    "addDevice.code.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new computer shows a code like K0Q5-1M6C and four words. Type the code here, check that the words match, then approve."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعرض الكمبيوتر الجديد رمزًا مثل K0Q5-1M6C وأربع كلمات. اكتب الرمز هنا، وتحقق من تطابق الكلمات، ثم وافق."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Novi računar prikazuje kod poput K0Q5-1M6C i četiri riječi. Upišite kod ovdje, provjerite da se riječi podudaraju, pa odobrite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den nye computer viser en kode som K0Q5-1M6C og fire ord. Skriv koden her, tjek at ordene passer, og godkend."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der neue Computer zeigt einen Code wie K0Q5-1M6C und vier Wörter. Gib den Code hier ein, prüfe, ob die Wörter übereinstimmen, und genehmige dann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El ordenador nuevo muestra un código como K0Q5-1M6C y cuatro palabras. Escribe el código aquí, comprueba que las palabras coinciden y aprueba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le nouvel ordinateur affiche un code comme K0Q5-1M6C et quatre mots. Saisissez le code ici, vérifiez que les mots correspondent, puis approuvez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il nuovo computer mostra un codice come K0Q5-1M6C e quattro parole. Digita qui il codice, verifica che le parole corrispondano, poi approva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいコンピュータに K0Q5-1M6C のようなコードと 4 つの単語が表示されます。ここにコードを入力し、単語が一致することを確認してから承認してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កុំព្យូទ័រថ្មីបង្ហាញលេខកូដដូចជា K0Q5-1M6C និងពាក្យបួន។ វាយលេខកូដនៅទីនេះ ពិនិត្យថាពាក្យត្រូវគ្នា ហើយអនុម័ត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "새 컴퓨터에 K0Q5-1M6C 같은 코드와 네 단어가 표시됩니다. 여기에 코드를 입력하고 단어가 일치하는지 확인한 다음 승인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den nye datamaskinen viser en kode som K0Q5-1M6C og fire ord. Skriv inn koden her, sjekk at ordene stemmer, og godkjenn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nowy komputer pokazuje kod, np. K0Q5-1M6C, i cztery słowa. Wpisz tu kod, sprawdź, czy słowa się zgadzają, i zatwierdź."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O novo computador mostra um código como K0Q5-1M6C e quatro palavras. Digite o código aqui, confira se as palavras batem e aprove."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Новый компьютер показывает код вида K0Q5-1M6C и четыре слова. Введите код здесь, проверьте, что слова совпадают, и подтвердите."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คอมพิวเตอร์เครื่องใหม่จะแสดงรหัสเช่น K0Q5-1M6C และคำสี่คำ พิมพ์รหัสที่นี่ ตรวจว่าคำตรงกัน แล้วอนุมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yeni bilgisayar K0Q5-1M6C gibi bir kod ve dört sözcük gösterir. Kodu buraya yazın, sözcüklerin eşleştiğini denetleyin, sonra onaylayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Новий комп’ютер показує код на кшталт K0Q5-1M6C і чотири слова. Введіть код тут, перевірте, що слова збігаються, і схваліть."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Máy tính mới hiển thị mã như K0Q5-1M6C và bốn từ. Nhập mã ở đây, kiểm tra các từ khớp, rồi phê duyệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "新电脑会显示类似 K0Q5-1M6C 的代码和四个单词。在此输入代码，确认单词一致后批准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "新電腦會顯示類似 K0Q5-1M6C 的代碼和四個單字。在此輸入代碼，確認單字相符後核准。"
          }
        }
      }
    },
    "addDevice.newDevice.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run this line on the new computer. It installs cmux and shows a code with four words; then choose “It shows a code”."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "شغّل هذا السطر على الكمبيوتر الجديد. يثبّت cmux ويعرض رمزًا مع أربع كلمات؛ ثم اختر «يعرض رمزًا»."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokrenite ovaj red na novom računaru. Instalira cmux i prikazuje kod sa četiri riječi; zatim odaberite „Prikazuje kod“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kør denne linje på den nye computer. Den installerer cmux og viser en kode med fire ord; vælg derefter “Den viser en kode”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Führe diese Zeile auf dem neuen Computer aus. Sie installiert cmux und zeigt einen Code mit vier Wörtern; wähle dann „Es zeigt einen Code“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ejecuta esta línea en el ordenador nuevo. Instala cmux y muestra un código con cuatro palabras; luego elige «Muestra un código»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Exécutez cette ligne sur le nouvel ordinateur. Elle installe cmux et affiche un code avec quatre mots ; choisissez ensuite « Il affiche un code »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esegui questa riga sul nuovo computer. Installa cmux e mostra un codice con quattro parole; poi scegli «Mostra un codice»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいコンピュータでこの行を実行してください。cmux をインストールし、コードと 4 つの単語を表示します。その後「コードが表示されている」を選んでください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ដំណើរការបន្ទាត់នេះនៅលើកុំព្យូទ័រថ្មី។ វាដំឡើង cmux ហើយបង្ហាញលេខកូដជាមួយពាក្យបួន បន្ទាប់មកជ្រើស “វាបង្ហាញលេខកូដ”។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "새 컴퓨터에서 이 줄을 실행하세요. cmux를 설치하고 코드와 네 단어를 표시합니다. 그런 다음 “코드가 표시됨”을 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kjør denne linjen på den nye datamaskinen. Den installerer cmux og viser en kode med fire ord; velg deretter «Den viser en kode»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uruchom ten wiersz na nowym komputerze. Zainstaluje cmux i pokaże kod z czterema słowami; potem wybierz „Pokazuje kod”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rode esta linha no novo computador. Ela instala o cmux e mostra um código com quatro palavras; depois escolha “Ele mostra um código”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выполните эту строку на новом компьютере. Она установит cmux и покажет код с четырьмя словами; затем выберите «Он показывает код»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "รันบรรทัดนี้บนคอมพิวเตอร์เครื่องใหม่ จะติดตั้ง cmux และแสดงรหัสพร้อมคำสี่คำ จากนั้นเลือก “มีรหัสแสดงอยู่”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu satırı yeni bilgisayarda çalıştırın. cmux'u kurar ve dört sözcüklü bir kod gösterir; sonra “Bir kod gösteriyor”u seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Виконайте цей рядок на новому комп’ютері. Він установить cmux і покаже код із чотирма словами; потім виберіть «Він показує код»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chạy dòng này trên máy tính mới. Nó cài cmux và hiển thị mã kèm bốn từ; sau đó chọn “Nó hiển thị mã”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在新电脑上运行这一行。它会安装 cmux 并显示代码和四个单词；然后选择“它显示了一个代码”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在新電腦上執行這一行。它會安裝 cmux 並顯示代碼和四個單字；接著選擇「它顯示了一組代碼」。"
          }
        }
      }
    },
    "addDevice.newDevice.otherComputerHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already reach it with an ssh key? Add it by name."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تصل إليه بمفتاح ssh بالفعل؟ أضفه باسمه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Već mu pristupate ssh ključem? Dodajte ga po imenu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du den allerede med en ssh-nøgle? Tilføj den ved navn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon per ssh-Schlüssel erreichbar? Füge ihn über seinen Namen hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ya llegas a él con una clave ssh? Añádelo por su nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous y accédez déjà avec une clé ssh ? Ajoutez-le par son nom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo raggiungi già con una chiave ssh? Aggiungilo per nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに ssh 鍵で接続できますか？名前で追加してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អាចចូលវាដោយកូនសោ ssh រួចហើយ? បន្ថែមវាតាមឈ្មោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 ssh 키로 접속할 수 있나요? 이름으로 추가하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du den allerede med en ssh-nøkkel? Legg den til med navn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz już do niego dostęp kluczem ssh? Dodaj go po nazwie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já acessa com uma chave ssh? Adicione pelo nome."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже заходите на него по ssh-ключу? Добавьте его по имени."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าถึงด้วยคีย์ ssh ได้อยู่แล้ว? เพิ่มด้วยชื่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ona zaten bir ssh anahtarıyla ulaşıyor musunuz? Adıyla ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже заходите на нього за ssh-ключем? Додайте його за назвою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã truy cập bằng khóa ssh? Thêm máy theo tên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已能用 ssh 密钥连上它？按名称添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已能用 ssh 金鑰連上它？依名稱加入。"
          }
        }
      }
    },
    "addDevice.newDevice.phone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open cmux on your iPhone and sign in with this account. The first time it connects, this Mac asks you to allow it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "افتح cmux على iPhone وسجّل الدخول بهذا الحساب. عند أول اتصال يطلب منك هذا الـ Mac السماح له."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otvorite cmux na iPhoneu i prijavite se ovim računom. Pri prvom povezivanju ovaj Mac traži vašu dozvolu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åbn cmux på din iPhone, og log ind med denne konto. Første gang den forbinder, beder denne Mac dig om at tillade den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öffne cmux auf deinem iPhone und melde dich mit diesem Konto an. Beim ersten Verbinden fragt dieser Mac, ob du es erlaubst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abre cmux en tu iPhone e inicia sesión con esta cuenta. La primera vez que se conecte, este Mac te pedirá permiso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ouvrez cmux sur votre iPhone et connectez-vous avec ce compte. À la première connexion, ce Mac vous demande de l’autoriser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apri cmux sull’iPhone e accedi con questo account. Alla prima connessione, questo Mac ti chiede di consentirla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone で cmux を開き、このアカウントでサインインしてください。最初に接続するとき、この Mac が許可を求めます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បើក cmux នៅលើ iPhone ហើយចូលដោយគណនីនេះ។ ពេលភ្ជាប់ដំបូង Mac នេះនឹងសុំឱ្យអ្នកអនុញ្ញាត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iPhone에서 cmux를 열고 이 계정으로 로그인하세요. 처음 연결할 때 이 Mac이 허용할지 묻습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åpne cmux på iPhone og logg på med denne kontoen. Første gang den kobler til, ber denne Macen deg tillate den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otwórz cmux na iPhonie i zaloguj się na to konto. Przy pierwszym połączeniu ten Mac poprosi o zgodę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra o cmux no iPhone e entre com esta conta. Na primeira conexão, este Mac pede que você permita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Откройте cmux на iPhone и войдите в этот аккаунт. При первом подключении этот Mac попросит разрешение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิด cmux บน iPhone แล้วลงชื่อเข้าด้วยบัญชีนี้ ครั้งแรกที่เชื่อมต่อ Mac เครื่องนี้จะขอให้คุณอนุญาต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iPhone'unuzda cmux'u açın ve bu hesapla oturum açın. İlk bağlantıda bu Mac izin vermenizi ister."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відкрийте cmux на iPhone і увійдіть у цей обліковий запис. Під час першого під’єднання цей Mac попросить дозвіл."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mở cmux trên iPhone và đăng nhập bằng tài khoản này. Lần đầu kết nối, máy Mac này sẽ hỏi bạn cho phép."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在 iPhone 上打开 cmux 并用此帐户登录。首次连接时，这台 Mac 会请你允许。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在 iPhone 上開啟 cmux 並以此帳號登入。第一次連線時，這台 Mac 會請你允許。"
          }
        }
      }
    },
    "addDevice.approvalNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing joins until you approve it on a device that is already yours."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا ينضم شيء حتى توافق عليه من جهاز هو لك بالفعل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ništa se ne pridružuje dok to ne odobrite na uređaju koji je već vaš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Intet kommer med, før du godkender det på en enhed, der allerede er din."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nichts tritt bei, bis du es auf einem Gerät genehmigst, das schon dir gehört."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nada se une hasta que lo apruebes en un dispositivo que ya es tuyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rien ne se joint tant que vous ne l’approuvez pas sur un appareil qui est déjà à vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nulla si unisce finché non lo approvi su un dispositivo che è già tuo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでにあなたのデバイスで承認するまで、何も参加しません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្មានអ្វីចូលរួមទេ រហូតដល់អ្នកអនុម័តវានៅលើឧបករណ៍ដែលជារបស់អ្នករួចហើយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이미 내 기기에서 승인하기 전에는 아무것도 참여하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingenting blir med før du godkjenner det på en enhet som allerede er din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nic nie dołączy, dopóki nie zatwierdzisz tego na urządzeniu, które już jest Twoje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nada entra até você aprovar em um dispositivo que já é seu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ничего не подключится, пока вы не подтвердите это на устройстве, которое уже ваше."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่มีอะไรเข้าร่วมจนกว่าคุณจะอนุมัติบนอุปกรณ์ที่เป็นของคุณอยู่แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zaten sizin olan bir aygıtta onaylayana kadar hiçbir şey katılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ніщо не приєднається, доки ви не схвалите це на пристрої, який уже ваш."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không gì tham gia cho đến khi bạn phê duyệt trên một thiết bị đã là của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在你已有的设备上批准之前，什么都不会加入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在你已有的裝置上核准之前，什麼都不會加入。"
          }
        }
      }
    },
