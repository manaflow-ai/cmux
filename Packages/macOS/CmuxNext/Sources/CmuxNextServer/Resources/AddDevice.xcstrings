    "devices.control.readFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac could not read that machine's switches. Try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على هذا الـ Mac قراءة مفاتيح ذلك الجهاز. حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj Mac nije mogao pročitati prekidače te mašine. Pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac kunne ikke læse den maskines kontakter. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac konnte die Schalter dieses Geräts nicht lesen. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no pudo leer los interruptores de esa máquina. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac n’a pas pu lire les interrupteurs de cette machine. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non è riuscito a leggere gli interruttori di quella macchina. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac はそのマシンのスイッチを読み取れませんでした。もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac នេះមិនអាចអានកុងតាក់របស់ម៉ាស៊ីននោះបានទេ។ សូមព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 해당 기기의 스위치를 읽을 수 없었습니다. 다시 시도하세요."
          }
