        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อนุญาตให้เครื่องในทีมของคุณควบคุม Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
