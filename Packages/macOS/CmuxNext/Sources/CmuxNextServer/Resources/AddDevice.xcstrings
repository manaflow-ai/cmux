    "addDevice.joinLine.waiting": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "في انتظار انضمامه. تتغير هذه البطاقة عند انضمامه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Čeka se da se pridruži. Ova kartica se mijenja kada se to desi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Venter på, at den slutter sig til. Kortet ændres, når det sker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Warten auf den Beitritt. Diese Karte ändert sich, sobald er erfolgt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for it to join. This card changes when it does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esperando a que se una. Esta tarjeta cambia cuando lo haga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En attente de la connexion. Cette carte change dès qu’elle a lieu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In attesa che si unisca. Questa scheda cambia quando succede."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "参加を待っています。参加するとこのカードが変わります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កំពុងរង់ចាំវាចូលរួម។ កាតនេះនឹងប្ដូរនៅពេលវាចូលរួម។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "참여를 기다리는 중입니다. 참여하면 이 카드가 바뀝니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Venter på at den blir med. Kortet endres når det skjer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Czekanie na dołączenie. Ta karta zmieni się, gdy to nastąpi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aguardando a máquina entrar. Este cartão muda quando isso acontecer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ждём подключения. Карточка изменится, когда компьютер подключится."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "กำลังรอให้เครื่องเข้าร่วม การ์ดนี้จะเปลี่ยนเมื่อเข้าร่วมแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Katılması bekleniyor. Katıldığında bu kart değişir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Чекаємо на підключення. Картка зміниться, коли комп’ютер підключиться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đang chờ máy tham gia. Thẻ này sẽ thay đổi khi máy tham gia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "正在等待它加入。加入后此卡片会更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "正在等待它加入。加入後此卡片會更新。"
          }
        }
      }
    },
    "addDevice.joinLine.consent": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تبقى مشاركة الشاشة والتحكم متوقفة حتى يسمح بهما ذلك الجهاز."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dijeljenje ekrana i kontrola ostaju isključeni dok ih taj računar ne dozvoli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skærmdeling og styring forbliver slået fra, indtil maskinen tillader dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bildschirmfreigabe und Steuerung bleiben aus, bis dieser Rechner sie erlaubt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen sharing and control stay off until that machine allows them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Compartir pantalla y el control siguen desactivados hasta que ese equipo los permita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le partage d’écran et le contrôle restent désactivés jusqu’à ce que cette machine les autorise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La condivisione dello schermo e il controllo restano disattivati finché quel computer non li consente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "画面共有と操作は、そのマシンが許可するまでオフのままです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការចែករំលែកអេក្រង់ និងការគ្រប់គ្រងនៅតែបិទ រហូតដល់ម៉ាស៊ីននោះអនុញ្ញាត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "화면 공유와 제어는 그 컴퓨터가 허용할 때까지 꺼져 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skjermdeling og styring er av til maskinen tillater dem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Udostępnianie ekranu i sterowanie pozostają wyłączone, dopóki ten komputer na nie nie zezwoli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O compartilhamento de tela e o controle ficam desativados até que essa máquina os permita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Демонстрация экрана и управление выключены, пока этот компьютер их не разрешит."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การแชร์หน้าจอและการควบคุมจะปิดอยู่จนกว่าเครื่องนั้นจะอนุญาต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ekran paylaşımı ve denetim, o makine izin verene kadar kapalı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Демонстрація екрана й керування вимкнені, доки цей комп’ютер їх не дозволить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chia sẻ màn hình và điều khiển vẫn tắt cho đến khi máy đó cho phép."
