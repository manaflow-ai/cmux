    "addDevice.joinLine.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الصق هذا السطر في طرفية على أي جهاز Mac أو Linux. يثبّت ما يحتاجه الجهاز ويضمّه إلى أجهزة فريقك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zalijepite ovu liniju u terminal na bilo kojem Mac ili Linux računaru. Instalira ono što taj računar treba i pridružuje ga računarima vašeg tima."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Indsæt denne linje i en terminal på en hvilken som helst Mac- eller Linux-maskine. Den installerer det, maskinen skal bruge, og føjer den til dit teams maskiner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Füge diese Zeile in ein Terminal auf einem beliebigen Mac oder Linux-Rechner ein. Sie installiert, was der Rechner braucht, und fügt ihn den Rechnern deines Teams hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste this line in a terminal on any Mac or Linux machine. It installs what that machine needs and joins it to your team's machines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pega esta línea en una terminal de cualquier Mac o equipo Linux. Instala lo que ese equipo necesita y lo une a los equipos de tu equipo de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Collez cette ligne dans un terminal sur n’importe quel Mac ou machine Linux. Elle installe ce dont la machine a besoin et l’ajoute aux machines de votre équipe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Incolla questa riga in un terminale su qualsiasi Mac o computer Linux. Installa ciò che serve a quel computer e lo aggiunge ai computer del tuo team."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "任意の Mac または Linux マシンのターミナルにこの行を貼り付けてください。必要なものをインストールし、チームのマシンに参加させます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បិទភ្ជាប់បន្ទាត់នេះក្នុង terminal នៅលើម៉ាស៊ីន Mac ឬ Linux ណាមួយ។ វាដំឡើងអ្វីដែលម៉ាស៊ីននោះត្រូវការ ហើយភ្ជាប់វាទៅម៉ាស៊ីនរបស់ក្រុមអ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "아무 Mac 또는 Linux 컴퓨터의 터미널에 이 줄을 붙여 넣으세요. 필요한 것을 설치하고 팀의 컴퓨터에 참여시킵니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lim inn denne linjen i en terminal på en hvilken som helst Mac- eller Linux-maskin. Den installerer det maskinen trenger og legger den til i teamets maskiner."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wklej ten wiersz w terminalu na dowolnym komputerze Mac lub z Linuksem. Zainstaluje to, czego ten komputer potrzebuje, i doda go do komputerów Twojego zespołu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cole esta linha em um terminal em qualquer Mac ou máquina Linux. Ela instala o que essa máquina precisa e a adiciona às máquinas da sua equipe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вставьте эту строку в терминал на любом компьютере Mac или Linux. Она установит всё нужное и добавит компьютер к компьютерам вашей команды."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "วางบรรทัดนี้ในเทอร์มินัลบนเครื่อง Mac หรือ Linux เครื่องใดก็ได้ บรรทัดนี้จะติดตั้งสิ่งที่เครื่องนั้นต้องใช้และเพิ่มเครื่องนั้นเข้ากับเครื่องของทีมคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu satırı herhangi bir Mac veya Linux makinesindeki bir terminale yapıştırın. O makinenin ihtiyaç duyduklarını kurar ve makineyi ekibinizin makinelerine katar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вставте цей рядок у термінал на будь-якому комп’ютері Mac або Linux. Він установить усе потрібне й додасть комп’ютер до комп’ютерів вашої команди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dán dòng lệnh này vào terminal trên bất kỳ máy Mac hoặc Linux nào. Lệnh sẽ cài những gì máy đó cần và thêm máy vào các máy của nhóm bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在任意 Mac 或 Linux 机器的终端中粘贴这一行。它会安装该机器所需的内容，并将其加入你团队的机器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在任何 Mac 或 Linux 機器的終端機中貼上這一行。它會安裝該機器所需的內容，並將其加入你團隊的機器。"
          }
        }
      }
    },
