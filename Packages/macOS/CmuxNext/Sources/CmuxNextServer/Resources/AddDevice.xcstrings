        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ancora disattivato: cmux su questo Mac deve essere aggiornato prima che tu possa consentirlo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "オフのままです: 許可するには、この Mac の cmux をアップデートする必要があります"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "នៅតែបិទ៖ cmux នៅលើ Mac នេះត្រូវការការធ្វើបច្ចុប្បន្នភាពមុនពេលអ្នកអាចអនុញ្ញាតវាបាន"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "아직 꺼져 있음: 허용하려면 이 Mac의 cmux를 업데이트해야 합니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fortsatt av: cmux på denne Mac-en må oppdateres før du kan tillate dette"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nadal wyłączone: cmux na tym Macu wymaga aktualizacji, zanim na to zezwolisz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
