    "devices.join.ask.screenQuestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow screen sharing from your team's machines?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هل تسمح بمشاركة الشاشة مع أجهزة فريقك؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dozvoliti dijeljenje ekrana sa mašinama vašeg tima?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tillad skærmdeling fra dit teams maskiner?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bildschirmfreigabe für die Rechner deines Teams erlauben?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Permitir compartir pantalla con las máquinas de tu equipo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autoriser le partage d’écran pour les machines de votre équipe ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consentire la condivisione dello schermo alle macchine del tuo team?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "チームのマシンからの画面共有を許可しますか？"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អនុញ្ញាតការចែករំលែកអេក្រង់ពីម៉ាស៊ីនរបស់ក្រុមអ្នកឬ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "팀 머신의 화면 공유를 허용할까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tillate skjermdeling fra teamets maskiner?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zezwolić na udostępnianie ekranu maszynom zespołu?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permitir o compartilhamento de tela com as máquinas da sua equipe?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Разрешить общий экран для машин вашей команды?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อนุญาตให้เครื่องของทีมคุณแชร์หน้าจอหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ekibinizin makinelerinden ekran paylaşımına izin verilsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дозволити спільний доступ до екрана машинам вашої команди?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cho phép các máy của nhóm chia sẻ màn hình?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "允许你团队的机器共享屏幕吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "允許你團隊的機器共享螢幕嗎？"
          }
        }
      }
    },
