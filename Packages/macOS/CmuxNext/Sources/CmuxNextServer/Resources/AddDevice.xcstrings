          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังปิดอยู่: cmux บน Mac เครื่องนี้ต้องอัปเดตก่อนจึงจะอนุญาตได้"
          }
        },
        "tr": {
          "stringUnit": {
