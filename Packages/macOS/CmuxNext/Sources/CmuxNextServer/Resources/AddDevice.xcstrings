    "devices.fullAccessHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its chats edit files and run commands here without asking"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعدّل محادثاته الملفات وتشغّل الأوامر هنا دون أن تسأل"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mijenja datoteke i pokreće naredbe ovdje bez pitanja"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Redigerer filer og kører kommandoer her uden at spørge"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert hier Dateien und führt Befehle ohne Rückfrage aus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita archivos y ejecuta comandos aquí sin preguntar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifie des fichiers et lance des commandes sans demander"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica file ed esegue comandi qui senza chiedere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認なしでこの Mac のファイルを編集し、コマンドを実行します"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កែសម្រួលឯកសារ និងដំណើរការពាក្យបញ្ជានៅទីនេះដោយមិនសួរ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "묻지 않고 이 Mac에서 파일을 편집하고 명령을 실행합니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Redigerer filer og kjører kommandoer her uten å spørre"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edytuje pliki i uruchamia polecenia tutaj bez pytania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita arquivos e executa comandos aqui sem perguntar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактирует файлы и выполняет команды здесь без вопросов"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไขไฟล์และเรียกใช้คำสั่งบนเครื่องนี้โดยไม่ถาม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada sormadan dosyaları düzenler ve komutları çalıştırır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Редагує файли й виконує команди тут без запитань"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sửa tệp và chạy lệnh trên máy này mà không hỏi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需询问即可在此编辑文件并运行命令"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無需詢問即可在此編輯檔案並執行指令"
          }
        }
      }
    },
    "devices.fullAccessOnFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still off: this Mac could not confirm it was you"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال متوقفًا: تعذّر على هذا الـ Mac التأكد من أنه أنت"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "I dalje isključeno: ovaj Mac nije potvrdio da ste to vi"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stadig fra: denne Mac kunne ikke bekræfte, at det var dig"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch aus: Dieser Mac konnte dich nicht verifizieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue desactivado: este Mac no pudo confirmar que eras tú"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours inactif : ce Mac n’a pas pu vous identifier"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora spento: il Mac non ha potuto confermare che eri tu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフのままです。この Mac であなた本人か確認できませんでした"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នៅតែបិទ៖ Mac នេះមិនអាចបញ្ជាក់ថាជាអ្នកបានទេ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여전히 꺼져 있음: 이 Mac에서 본인임을 확인하지 못했습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsatt av: Macen kunne ikke bekrefte at det var deg"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadal wyłączone: ten Mac nie potwierdził, że to Ty"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua desativado: este Mac não confirmou que era você"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё ещё выключено: этот Mac не подтвердил, что это вы"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังปิดอยู่: Mac เครื่องนี้ยืนยันไม่ได้ว่าเป็นคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hâlâ kapalı: Bu Mac, sizin olduğunuzu doğrulayamadı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Досі вимкнено: цей Mac не підтвердив, що це ви"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẫn tắt: máy Mac này không xác nhận được là bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍为关闭：这台 Mac 无法确认是你本人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍為關閉：這台 Mac 無法確認是你本人"
          }
        }
      }
    },
    "devices.fullAccessOffFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full access could not be turned off. Try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إيقاف الوصول الكامل. حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Puni pristup nije moguće isključiti. Pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuld adgang kunne ikke slås fra. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollzugriff ließ sich nicht ausschalten. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo desactivar el acceso total. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de désactiver l’accès complet. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile disattivare l’accesso completo. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルアクセスをオフにできませんでした。もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចបិទសិទ្ធិចូលពេញលេញបានទេ។ សូមព្យាយាមម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 접근을 끌 수 없습니다. 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Full tilgang kunne ikke slås av. Prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wyłączyć pełnego dostępu. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível desativar o acesso total. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось выключить полный доступ. Попробуйте ещё раз."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดการเข้าถึงเต็มรูปแบบไม่ได้ ลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam erişim kapatılamadı. Yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося вимкнути повний доступ. Спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tắt toàn quyền. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法关闭完全访问。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法關閉完整存取。請再試一次。"
          }
        }
      }
