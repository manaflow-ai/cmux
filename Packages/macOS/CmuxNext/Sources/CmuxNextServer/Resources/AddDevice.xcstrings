          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den seneste ændring gemmes stadig. Prøv igen om et øjeblik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
