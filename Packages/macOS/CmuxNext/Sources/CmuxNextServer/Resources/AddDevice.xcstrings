            "state": "needs_review",
            "value": "Consentire la condivisione dello schermo alle macchine del tuo team?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "チームのマシンからの画面共有を許可しますか？"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អនុញ្ញាតការចែករំលែកអេក្រង់ពីម៉ាស៊ីនរបស់ក្រុមអ្នកឬ?"
