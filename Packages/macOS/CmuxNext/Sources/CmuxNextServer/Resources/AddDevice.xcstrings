    "addDevice.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your agents and terminals on another computer, or reach this one from your phone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "استخدم وكلاءك وطرفياتك على كمبيوتر آخر، أو صِل إلى هذا الكمبيوتر من هاتفك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koristite svoje agente i terminale na drugom računaru ili pristupite ovom s telefona."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brug dine agenter og terminaler på en anden computer, eller nå denne fra din telefon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nutze deine Agenten und Terminals auf einem anderen Computer oder erreiche diesen hier vom Telefon aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa tus agentes y terminales en otro ordenador, o accede a este desde tu teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilisez vos agents et terminaux sur un autre ordinateur, ou accédez à celui-ci depuis votre téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa i tuoi agenti e terminali su un altro computer, o raggiungi questo dal telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のコンピュータでエージェントとターミナルを使うか、iPhone からこのコンピュータに接続します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ប្រើភ្នាក់ងារ និងទែមីណាល់របស់អ្នកនៅលើកុំព្យូទ័រផ្សេង ឬចូលកុំព្យូទ័រនេះពីទូរសព្ទ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다른 컴퓨터에서 에이전트와 터미널을 사용하거나 휴대폰에서 이 컴퓨터에 연결합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bruk agentene og terminalene dine på en annen datamaskin, eller nå denne fra telefonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Używaj agentów i terminali na innym komputerze lub łącz się z tym z telefonu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use seus agentes e terminais em outro computador, ou acesse este pelo celular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Используйте агентов и терминалы на другом компьютере или подключайтесь к этому с телефона."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ใช้เอเจนต์และเทอร์มินัลของคุณบนคอมพิวเตอร์เครื่องอื่น หรือเข้าถึงเครื่องนี้จากโทรศัพท์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajanlarınızı ve terminallerinizi başka bir bilgisayarda kullanın ya da bu bilgisayara telefonunuzdan ulaşın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Використовуйте агентів і термінали на іншому комп’ютері або під’єднуйтеся до цього з телефона."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dùng tác tử và terminal của bạn trên máy tính khác, hoặc truy cập máy này từ điện thoại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
