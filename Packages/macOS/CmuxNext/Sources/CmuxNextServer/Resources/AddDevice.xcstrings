    "addDevice.network.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every computer on your network is already added. Set up a new device instead."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "كل أجهزة الكمبيوتر على شبكتك مضافة بالفعل. أعدّ جهازًا جديدًا بدلًا من ذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svi računari na vašoj mreži su već dodani. Umjesto toga postavite novi uređaj."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle computere på dit netværk er allerede tilføjet. Konfigurer en ny enhed i stedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle Computer in deinem Netzwerk sind schon hinzugefügt. Richte stattdessen ein neues Gerät ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todos los ordenadores de tu red ya están añadidos. Configura un dispositivo nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tous les ordinateurs de votre réseau sont déjà ajoutés. Configurez plutôt un nouvel appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tutti i computer della tua rete sono già aggiunti. Configura invece un nuovo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワーク上のコンピュータはすべて追加済みです。代わりに新しいデバイスを設定してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កុំព្យូទ័រទាំងអស់នៅលើបណ្ដាញរបស់អ្នកត្រូវបានបន្ថែមរួចហើយ។ សូមរៀបចំឧបករណ៍ថ្មីជំនួសវិញ។"
