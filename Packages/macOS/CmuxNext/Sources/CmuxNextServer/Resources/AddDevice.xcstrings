    "devices.control.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each switch turns Control and Screen sharing on or off on one of your machines. Each machine asks once, on itself, before it takes this Mac's switches: allow it there only if the words it shows match this Mac's words."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل مفتاح يشغّل التحكم ومشاركة الشاشة أو يوقفهما على أحد أجهزتك. يسأل كل جهاز مرة واحدة، على الجهاز نفسه، قبل أن يقبل مفاتيح هذا الـ Mac: اسمح بذلك هناك فقط إذا تطابقت الكلمات التي يعرضها مع كلمات هذا الـ Mac."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki prekidač uključuje ili isključuje upravljanje i dijeljenje ekrana na jednoj od vaših mašina. Svaka mašina pita jednom, na sebi, prije nego prihvati prekidače ovog Maca: dozvolite tamo samo ako se riječi koje prikazuje poklapaju s riječima ovog Maca."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver kontakt slår styring og skærmdeling til eller fra på en af dine maskiner. Hver maskine spørger én gang, på sig selv, før den tager imod denne Macs kontakter: Tillad det der kun, hvis de ord, den viser, matcher denne Macs ord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Schalter schaltet Steuerung und Bildschirmfreigabe auf einem deiner Geräte ein oder aus. Jedes Gerät fragt einmal, auf sich selbst, bevor es die Schalter dieses Macs annimmt: Erlaube es dort nur, wenn die angezeigten Wörter mit den Wörtern dieses Macs übereinstimmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada interruptor activa o desactiva el control y compartir pantalla en una de tus máquinas. Cada máquina pregunta una vez, en sí misma, antes de aceptar los interruptores de este Mac: permítelo allí solo si las palabras que muestra coinciden con las de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque interrupteur active ou désactive le contrôle et le partage d’écran sur l’une de vos machines. Chaque machine demande une fois, sur elle-même, avant d’accepter les interrupteurs de ce Mac : autorisez-le là-bas seulement si les mots affichés correspondent à ceux de ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni interruttore attiva o disattiva controllo e condivisione schermo su una delle tue macchine. Ogni macchina chiede una volta, su se stessa, prima di accettare gli interruttori di questo Mac: consenti lì solo se le parole mostrate corrispondono a quelle di questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各スイッチで、あなたのマシンの操作と画面共有をオン・オフします。各マシンはこの Mac のスイッチを受け入れる前に、そのマシン上で一度だけ確認します。表示される単語がこの Mac の単語と一致する場合にのみ、そこで許可してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កុងតាក់នីមួយៗបើក ឬបិទការគ្រប់គ្រង និងការចែករំលែកអេក្រង់លើម៉ាស៊ីនមួយរបស់អ្នក។ ម៉ាស៊ីននីមួយៗសួរម្តង នៅលើខ្លួនវា មុននឹងទទួលកុងតាក់របស់ Mac នេះ៖ អនុញ្ញាតនៅទីនោះតែប្រសិនបើពាក្យដែលវាបង្ហាញត្រូវនឹងពាក្យរបស់ Mac នេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 스위치는 내 기기 중 하나의 제어와 화면 공유를 켜거나 끕니다. 각 기기는 이 Mac의 스위치를 받아들이기 전에 해당 기기에서 한 번 묻습니다. 표시된 단어가 이 Mac의 단어와 일치할 때만 거기서 허용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver bryter slår styring og skjermdeling av eller på på en av maskinene dine. Hver maskin spør én gang, på seg selv, før den tar imot denne Macens brytere: Tillat det der bare hvis ordene den viser samsvarer med denne Macens ord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy przełącznik włącza lub wyłącza sterowanie i udostępnianie ekranu na jednej z Twoich maszyn. Każda maszyna pyta raz, na sobie, zanim przyjmie przełączniki tego Maca: zezwól tam tylko wtedy, gdy pokazane słowa zgadzają się ze słowami tego Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada botão ativa ou desativa o controle e o compartilhamento de tela em uma das suas máquinas. Cada máquina pergunta uma vez, nela mesma, antes de aceitar os botões deste Mac: permita lá apenas se as palavras mostradas forem iguais às deste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый переключатель включает или выключает управление и общий экран на одной из ваших машин. Каждая машина один раз спрашивает на себе, прежде чем принимать переключатели этого Mac: разрешайте там, только если показанные слова совпадают со словами этого Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สวิตช์แต่ละตัวเปิดหรือปิดการควบคุมและการแชร์หน้าจอบนเครื่องหนึ่งของคุณ แต่ละเครื่องจะถามหนึ่งครั้งบนเครื่องนั้นเองก่อนรับสวิตช์ของ Mac เครื่องนี้ ให้อนุญาตที่นั่นเฉพาะเมื่อคำที่แสดงตรงกับคำของ Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her anahtar makinelerinizden birinde kontrolü ve ekran paylaşımını açar veya kapatır. Her makine bu Mac'in anahtarlarını kabul etmeden önce kendi üzerinde bir kez sorar: Orada yalnızca gösterdiği sözcükler bu Mac'in sözcükleriyle eşleşiyorsa izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен перемикач вмикає або вимикає керування та спільний доступ до екрана на одній із ваших машин. Кожна машина один раз питає на собі, перш ніж приймати перемикачі цього Mac: дозволяйте там, лише якщо показані слова збігаються зі словами цього Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi công tắc bật hoặc tắt điều khiển và chia sẻ màn hình trên một máy của bạn. Mỗi máy hỏi một lần, trên chính nó, trước khi nhận công tắc của máy Mac này: chỉ cho phép ở đó nếu các từ nó hiển thị khớp với các từ của máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个开关会开启或关闭你的一台机器上的控制与屏幕共享。每台机器在接受此 Mac 的开关之前，会在其自身上询问一次：只有当它显示的词与此 Mac 的词一致时，才在那里允许。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個開關會開啟或關閉你的一台機器上的控制與螢幕共享。每台機器在接受此 Mac 的開關之前，會在其本身上詢問一次：只有當它顯示的詞與此 Mac 的詞一致時，才在那裡允許。"
          }
        }
      }
    },
