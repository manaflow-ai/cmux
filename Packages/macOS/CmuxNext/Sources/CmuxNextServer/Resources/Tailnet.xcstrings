    "tailnet.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cmux build can't join a tailnet"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إصدار cmux هذا لا يمكنه الانضمام إلى tailnet"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova verzija cmux-a ne može se pridružiti tailnetu"
          }
        },
