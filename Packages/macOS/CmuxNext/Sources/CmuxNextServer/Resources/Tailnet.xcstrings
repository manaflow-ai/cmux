          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта сборка cmux не может подключиться к tailnet"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux รุ่นนี้เข้าร่วม tailnet ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cmux sürümü bir tailnet’e katılamaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця збірка cmux не може приєднатися до tailnet"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
