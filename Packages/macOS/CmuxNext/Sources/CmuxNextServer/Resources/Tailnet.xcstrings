    "tailnet.limitHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only your Tailscale account can connect for now"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاليًا يمكن لحساب Tailscale الخاص بك فقط الاتصال"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za sada se može povezati samo vaš Tailscale račun"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtil videre kan kun din Tailscale-konto forbinde"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorerst kann sich nur dein Tailscale-Konto verbinden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ahora solo tu cuenta de Tailscale puede conectarse"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour l’instant, seul votre compte Tailscale se connecte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ora può connettersi solo il tuo account Tailscale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在は自分のTailscaleアカウントのみ接続できます"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បច្ចុប្បន្ន មានតែគណនី Tailscale របស់អ្នកទេដែលអាចភ្ជាប់បាន"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재는 내 Tailscale 계정만 연결할 수 있습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Foreløpig kan bare Tailscale-kontoen din koble til"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na razie połączyć się może tylko Twoje konto Tailscale"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por enquanto, só sua conta Tailscale pode se conectar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока подключаться может только ваш аккаунт Tailscale"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้เชื่อมต่อได้เฉพาะบัญชี Tailscale ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdilik yalnızca Tailscale hesabınız bağlanabilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки під’єднатися може лише ваш обліковий запис Tailscale"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện chỉ tài khoản Tailscale của bạn kết nối được"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前只有你的 Tailscale 账户可以连接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前只有你的 Tailscale 帳號可以連線"
          }
        }
      }
    },
    "tailnet.pairHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run on your other Mac. Works once, for 15 min"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّله على جهاز Mac الآخر. يعمل مرة واحدة لمدة 15 دقيقة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokrenite na drugom Macu. Radi jednom, 15 min"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kør på din anden Mac. Virker én gang i 15 min"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf deinem anderen Mac ausführen. Einmalig, 15 Min. gültig"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecútalo en tu otro Mac. Sirve una vez, 15 min"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécutez sur votre autre Mac. Une fois, pendant 15 min"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eseguilo sull’altro Mac. Vale una volta, per 15 min"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のMacで実行してください。1回限り、15分間有効"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដំណើរការលើ Mac ផ្សេងទៀត។ ប្រើបានម្ដង រយៈពេល 15 នាទី"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 Mac에서 실행하세요. 15분 동안 한 번 사용 가능"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjør på den andre Mac-en. Virker én gang i 15 min"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchom na drugim Macu. Działa raz, przez 15 min"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute no seu outro Mac. Vale uma vez, por 15 min"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустите на другом Mac. Один раз, в течение 15 мин"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รันบน Mac อีกเครื่อง ใช้ได้ครั้งเดียว ภายใน 15 นาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer Mac’inizde çalıştırın. Bir kez, 15 dk geçerli"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустіть на іншому Mac. Один раз, протягом 15 хв"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy trên máy Mac khác. Dùng một lần, trong 15 phút"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的另一台 Mac 上运行。仅限一次，15 分钟内有效"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的另一台 Mac 上執行。僅限一次，15 分鐘內有效"
          }
        }
      }
    },
