    "addMachine.readyDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its agents and workspaces are a click away in the sidebar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "وكلاؤه ومساحات عمله على بُعد نقرة في الشريط الجانبي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Njeni agenti i radni prostori su na klik u bočnoj traci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dens agenter og arbejdsområder er et klik væk i sidepanelet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seine Agenten und Arbeitsbereiche sind einen Klick entfernt in der Seitenleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sus agentes y espacios de trabajo están a un clic en la barra lateral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ses agents et espaces de travail sont à un clic dans la barre latérale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I suoi agenti e spazi di lavoro sono a un clic nella barra laterale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントとワークスペースはサイドバーからすぐに開けます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ភ្នាក់ងារ និងកន្លែងធ្វើការរបស់វានៅត្រឹមតែមួយចុចក្នុងរបារចំហៀង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트와 워크스페이스는 사이드바에서 바로 열 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agentene og arbeidsområdene er ett klikk unna i sidepanelet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jej agenci i obszary robocze są o kliknięcie w panelu bocznym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seus agentes e espaços de trabalho estão a um clique na barra lateral."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Её агенты и рабочие пространства в один клик на боковой панели."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เอเจนต์และพื้นที่ทำงานของเครื่องนี้อยู่ห่างแค่คลิกเดียวในแถบด้านข้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajanları ve çalışma alanları kenar çubuğunda bir tık uzakta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Її агенти й робочі простори за один клік на бічній панелі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các tác tử và không gian làm việc của máy chỉ cách một cú nhấp trong thanh bên."
