            "value": "يغادر أجهزة فريقك. ينتهي وصوله عند نبضته التالية، خلال %lld ثانية. لاستخدامه مرة أخرى، الصق سطرًا جديدًا عليه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Napušta računare vašeg tima. Pristup mu prestaje pri sljedećem javljanju, u roku od %lld sekundi. Da ga ponovo koristite, zalijepite novu liniju na njega."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den forlader dit teams maskiner. Adgangen ophører ved næste livstegn, inden for %lld sekunder. For at bruge den igen skal du indsætte en ny linje på den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Er verlässt die Rechner deines Teams. Sein Zugriff endet beim nächsten Heartbeat, innerhalb von %lld Sekunden. Um ihn wieder zu nutzen, füge dort eine neue Zeile ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It leaves your team's machines. Its access ends on its next heartbeat, within %lld seconds. To use it again, paste a new line on it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sale de los equipos de tu equipo de trabajo. Su acceso termina en su próximo latido, en %lld segundos como máximo. Para volver a usarlo, pega una nueva línea en él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elle quitte les machines de votre équipe. Son accès prend fin à son prochain signal de vie, d’ici %lld secondes. Pour l’utiliser à nouveau, collez-y une nouvelle ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esce dai computer del tuo team. L'accesso termina alla prossima segnalazione di presenza, entro %lld secondi. Per usarlo di nuovo, incolla una nuova riga su di esso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "チームのマシンから外れます。次のハートビート（%lld 秒以内）でアクセスが終了します。再び使うには、新しい行をそのマシンに貼り付けてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "វាចាកចេញពីម៉ាស៊ីនរបស់ក្រុមអ្នក។ សិទ្ធិចូលរបស់វាបញ្ចប់នៅពេលរាយការណ៍លើកក្រោយ ក្នុងរយៈពេល %lld វិនាទី។ ដើម្បីប្រើវាម្ដងទៀត សូមបិទភ្ជាប់បន្ទាត់ថ្មីនៅលើវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "팀의 컴퓨터에서 빠집니다. 다음 하트비트(%lld초 이내)에 접근이 끝납니다. 다시 사용하려면 새 줄을 붙여 넣으세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den forlater teamets maskiner. Tilgangen opphører ved neste livstegn, innen %lld sekunder. For å bruke den igjen limer du inn en ny linje på den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opuści komputery Twojego zespołu. Dostęp wygaśnie przy następnym sygnale obecności, w ciągu %lld s. Aby użyć go ponownie, wklej na nim nowy wiersz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ela sai das máquinas da sua equipe. O acesso termina no próximo sinal, em até %lld segundos. Para usá-la de novo, cole uma nova linha nela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Компьютер покинет компьютеры вашей команды. Доступ прекратится при следующей отметке, в течение %lld с. Чтобы снова использовать его, вставьте на нём новую строку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เครื่องนี้จะออกจากเครื่องของทีมคุณ สิทธิ์เข้าถึงจะสิ้นสุดเมื่อรายงานตัวครั้งถัดไป ภายใน %lld วินาที หากต้องการใช้อีก ให้วางบรรทัดใหม่บนเครื่องนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ekibinizin makinelerinden ayrılır. Erişimi bir sonraki bildirimde, %lld saniye içinde sona erer. Yeniden kullanmak için üzerine yeni bir satır yapıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Комп’ютер вийде з комп’ютерів вашої команди. Доступ припиниться під час наступної відмітки, протягом %lld с. Щоб знову ним користуватися, вставте на ньому новий рядок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Máy sẽ rời khỏi các máy của nhóm bạn. Quyền truy cập kết thúc ở lần báo hiện diện tiếp theo, trong vòng %lld giây. Để dùng lại, hãy dán một dòng lệnh mới trên máy đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它将离开你团队的机器。其访问权限将在下一次心跳时（%lld 秒内）结束。如需再次使用，请在其上粘贴新的命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它將離開你團隊的機器。其存取權將在下一次心跳時（%lld 秒內）結束。如需再次使用，請在其上貼上新的指令。"
          }
        }
      }
    },
