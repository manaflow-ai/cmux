    "machines.joined.busy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "انتظر حتى ينتهي آخر تغيير على هذا الجهاز."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sačekajte da se završi posljednja promjena na ovoj mašini."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vent, til den seneste ændring på denne maskine er færdig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Warte, bis die letzte Änderung an dieser Maschine abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the last change on this machine to finish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Espera a que termine el último cambio en esta máquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Attendez la fin de la dernière modification sur cette machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Attendi che l'ultima modifica su questa macchina sia terminata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このマシンでの直前の変更が終わるまでお待ちください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "រង់ចាំឱ្យការផ្លាស់ប្ដូរចុងក្រោយលើម៉ាស៊ីននេះបញ្ចប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 머신의 마지막 변경이 끝날 때까지 기다리세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vent til den siste endringen på denne maskinen er ferdig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poczekaj, aż ostatnia zmiana na tej maszynie się zakończy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aguarde a última alteração nesta máquina terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дождитесь завершения последнего изменения на этой машине."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "รอให้การเปลี่ยนแปลงล่าสุดบนเครื่องนี้เสร็จก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu makinedeki son değişikliğin bitmesini bekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Зачекайте, доки завершиться остання зміна на цій машині."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hãy đợi thay đổi gần nhất trên máy này hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请等待此机器上的上一项更改完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請等待此機器上的上一項變更完成。"
          }
        }
      }
    },
