    "addMachine.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type a host you reach with ssh, or pick a machine on your tailnet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اكتب مضيفًا تصل إليه عبر ssh، أو اختر جهازًا على شبكة tailnet الخاصة بك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Upišite host do kojeg dolazite preko ssh ili odaberite mašinu na svom tailnetu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skriv en vært, du når med ssh, eller vælg en maskine på dit tailnet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gib einen Host ein, den du per ssh erreichst, oder wähle ein Gerät in deinem Tailnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escribe un host al que llegues por ssh o elige una máquina de tu tailnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saisissez un hôte joignable en ssh, ou choisissez une machine de votre tailnet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Digita un host raggiungibile via ssh o scegli una macchina della tua tailnet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh で接続できるホストを入力するか、tailnet 上のマシンを選んでください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "វាយម៉ាស៊ីនមេដែលអ្នកភ្ជាប់តាម ssh ឬជ្រើសម៉ាស៊ីនលើ tailnet របស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ssh로 접속할 수 있는 호스트를 입력하거나 tailnet의 머신을 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skriv en vert du når med ssh, eller velg en maskin på tailnettet ditt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wpisz host dostępny przez ssh albo wybierz maszynę w swoim tailnecie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Digite um host que você acessa por ssh ou escolha uma máquina na sua tailnet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Введите хост, доступный по ssh, или выберите машину в своей tailnet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "พิมพ์โฮสต์ที่เข้าถึงได้ด้วย ssh หรือเลือกเครื่องใน tailnet ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ssh ile eriştiğiniz bir ana bilgisayar yazın veya tailnet'inizdeki bir makineyi seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Введіть хост, доступний через ssh, або виберіть машину у своїй tailnet."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhập một máy chủ bạn truy cập qua ssh, hoặc chọn một máy trong tailnet của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "输入可通过 ssh 访问的主机，或在你的 tailnet 中选择一台机器。"
