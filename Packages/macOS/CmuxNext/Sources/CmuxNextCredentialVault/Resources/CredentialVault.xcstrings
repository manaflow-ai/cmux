    "credentialVault.entry.fromMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي رسالتك على هذا المفتاح. احفظه هنا وستشير الرسالة إلى اسمه بدلًا منه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša poruka sadrži ovaj ključ. Sačuvajte ga ovdje i poruka će umjesto njega navesti njegov naziv."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din besked indeholder denne nøgle. Gem den her, så nævner beskeden den i stedet ved navn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Nachricht enthält diesen Schlüssel. Sichere ihn hier, dann nennt die Nachricht stattdessen seinen Namen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your message holds this key. Save it here and the message names it instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mensaje contiene esta clave. Guárdala aquí y el mensaje mostrará su nombre en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre message contient cette clé. Enregistrez-la ici et le message indiquera son nom à la place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo messaggio contiene questa chiave. Salvala qui e il messaggio ne riporterà invece il nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージにこのキーが含まれています。ここに保存すると、メッセージには代わりにその名前が入ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សាររបស់អ្នកមានកូនសោនេះ។ រក្សាទុកវានៅទីនេះ ហើយសារនឹងបង្ហាញឈ្មោះរបស់វាជំនួសវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지에 이 키가 포함되어 있습니다. 여기에 저장하면 메시지에는 대신 키 이름이 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen din inneholder denne nøkkelen. Lagre den her, så nevner meldingen den ved navn i stedet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja wiadomość zawiera ten klucz. Zapisz go tutaj, a wiadomość będzie zawierać zamiast niego jego nazwę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua mensagem contém esta chave. Salve-a aqui e a mensagem passará a citar o nome dela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше сообщение содержит этот ключ. Сохраните его здесь, и вместо него в сообщении будет указано его имя."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความของคุณมีคีย์นี้อยู่ บันทึกไว้ที่นี่แล้วข้อความจะแสดงชื่อของคีย์แทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajınız bu anahtarı içeriyor. Buraya kaydedin; mesaj bunun yerine anahtarın adını içerir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше повідомлення містить цей ключ. Збережіть його тут, і замість нього в повідомленні буде вказано його назву."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn của bạn chứa khóa này. Lưu nó tại đây và tin nhắn sẽ chỉ ghi tên của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的消息包含此密钥。将它存储在这里，消息中将改为显示它的名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的訊息包含此金鑰。將它儲存在這裡，訊息中將改為顯示它的名稱。"
          }
        }
      }
    },
