    "credentialVault.error.invalidValue": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تكون قيمة %@ نصًا بحجم من 1 بايت إلى 64 كيلوبايت دون بايتات NUL."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrijednost za %@ mora biti tekst od 1 bajta do 64 KB bez NUL bajtova."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Værdien for %@ skal være tekst på 1 byte til 64 KB uden NUL-bytes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wert für %@ muss Text von 1 Byte bis 64 KB ohne NUL-Bytes sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The value for %@ must be 1 byte to 64 KB of text without NUL bytes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor de %@ debe ser texto de 1 byte a 64 KB sin bytes NUL."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La valeur de %@ doit être un texte de 1 octet à 64 Ko sans octet NUL."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il valore di %@ deve essere un testo da 1 byte a 64 KB senza byte NUL."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の値は NUL バイトを含まない 1 バイトから 64 KB のテキストである必要があります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "តម្លៃសម្រាប់ %@ ត្រូវតែជាអត្ថបទពី 1 បៃ ដល់ 64 KB ដោយគ្មានបៃ NUL។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 값은 NUL 바이트가 없는 1바이트~64KB의 텍스트여야 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdien for %@ må være tekst på 1 byte til 64 KB uten NUL-byte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartość dla %@ musi być tekstem od 1 bajta do 64 KB bez bajtów NUL."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor de %@ deve ser um texto de 1 byte a 64 KB sem bytes NUL."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значение для %@ должно быть текстом от 1 байта до 64 КБ без байтов NUL."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าของ %@ ต้องเป็นข้อความขนาด 1 ไบต์ถึง 64 KB โดยไม่มีไบต์ NUL"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ değeri, NUL baytı içermeyen 1 bayt ile 64 KB arası bir metin olmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Значення для %@ має бути текстом від 1 байта до 64 КБ без байтів NUL."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá trị của %@ phải là văn bản từ 1 byte đến 64 KB, không có byte NUL."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的值必须是 1 字节至 64 KB 的文本，且不含 NUL 字节。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的值必須是 1 位元組至 64 KB 的文字，且不含 NUL 位元組。"
          }
        }
      }
    },
