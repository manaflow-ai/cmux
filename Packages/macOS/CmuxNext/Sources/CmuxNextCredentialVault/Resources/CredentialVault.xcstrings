    "credentialVault.error.notApproved": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: لم يُسمح به في cmux، ولم يتغير شيء"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: nije dozvoljeno u cmuxu, ništa nije promijenjeno"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: ikke tilladt i cmux, intet ændret"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: in cmux nicht erlaubt, nichts geändert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: not allowed in cmux, nothing changed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: no se permitió en cmux, no cambió nada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : non autorisé dans cmux, rien n’a changé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: non consentito in cmux, nulla è cambiato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: cmux で許可されませんでした。何も変更されていません"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@៖ មិនត្រូវបានអនុញ្ញាតក្នុង cmux ទេ គ្មានអ្វីផ្លាស់ប្តូរ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: cmux에서 허용되지 않아 아무것도 바뀌지 않았습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: ikke tillatt i cmux, ingenting endret"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: nie zezwolono w cmux, nic się nie zmieniło"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: não permitido no cmux, nada mudou"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: не разрешено в cmux, ничего не изменилось"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: ไม่ได้รับอนุญาตใน cmux ไม่มีอะไรเปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: cmux’ta izin verilmedi, hiçbir şey değişmedi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: не дозволено в cmux, нічого не змінено"
          }
        },
        "vi": {
