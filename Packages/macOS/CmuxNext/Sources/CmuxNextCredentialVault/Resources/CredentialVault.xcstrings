        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "តម្លៃនេះមកពីកម្មវិធីដែលស្នើសុំ មិនមែនមកពីអ្នកទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값은 내가 아니라 요청한 프로그램이 제공합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdien kommer fra programmet som ber om det, ikke fra deg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartość pochodzi od programu, który prosi, nie od Ciebie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor vem do programa que pede, não de você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значение передаёт запросившая программа, а не вы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่านี้มาจากโปรแกรมที่ขอ ไม่ได้มาจากคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değer sizden değil, isteyen programdan geliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Значення надає програма, що просить, а не ви."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá trị đến từ chương trình yêu cầu, không phải từ bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该值来自发出请求的程序，而不是你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此值來自提出要求的程式，而不是你。"
          }
        }
      }
    },
