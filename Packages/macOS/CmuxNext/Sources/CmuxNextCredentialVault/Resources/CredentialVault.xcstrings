    "credentialVault.approve.storeLine": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأتي القيمة من البرنامج الذي يطلب، وليس منك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrijednost dolazi od programa koji traži, ne od vas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Værdien kommer fra det program, der beder om det, ikke fra dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wert kommt vom anfragenden Programm, nicht von dir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The value comes from the program that asks, not from you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor lo aporta el programa que lo pide, no tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La valeur vient du programme qui le demande, pas de vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il valore proviene dal programma che lo chiede, non da te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値はあなたではなく、要求したプログラムから渡されます。"
