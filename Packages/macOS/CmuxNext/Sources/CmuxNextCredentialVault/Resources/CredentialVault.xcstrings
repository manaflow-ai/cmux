    "credentialVault.rollout.disabled": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل مخزن بيانات الاعتماد في إعدادات التصحيح لاستخدامه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogućite trezor akreditiva u postavkama za otklanjanje grešaka da biste ga koristili."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivér legitimationsboksen i fejlfindingsindstillingerne for at bruge den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie den Zugangsdaten-Tresor in den Debug-Einstellungen, um ihn zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Credential Vault in Debug Settings to use it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la bóveda de credenciales en los ajustes de depuración para usarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le coffre d’identifiants dans les réglages de débogage pour l’utiliser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva il deposito credenziali nelle impostazioni di debug per usarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用するにはデバッグ設定で認証情報保管庫を有効にしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បើកឃ្លាំងព័ត៌មានសម្ងាត់នៅក្នុងការកំណត់បំបាត់កំហុស ដើម្បីប្រើវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하려면 디버그 설정에서 자격 증명 보관함을 활성화하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiver legitimasjonshvelvet i feilsøkingsinnstillingene for å bruke det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby korzystać z sejfu poświadczeń, włącz go w ustawieniach debugowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o cofre de credenciais nas configurações de depuração para usá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы использовать хранилище учётных данных, включите его в настройках отладки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดใช้คลังข้อมูลรับรองในการตั้งค่าดีบักเพื่อใช้งาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanmak için hata ayıklama ayarlarında kimlik bilgisi kasasını etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб користуватися сховищем облікових даних, увімкніть його в налаштуваннях налагодження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật Kho thông tin xác thực trong cài đặt gỡ lỗi để sử dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在调试设置中启用凭据保险库以使用此功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在偵錯設定中啟用憑證保管庫以使用此功能。"
          }
        }
      }
    },
