    "credentialVault.error.exists": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي الخزنة بالفعل على %@. استخدم زر الاستبدال الخاص به لتغيير القيمة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trezor već sadrži %@. Koristite njegovu opciju Zamijeni da promijenite vrijednost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Boksen har allerede %@. Brug dens Erstat for at ændre værdien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tresor enthält %@ bereits. Verwende dort „Ersetzen“, um den Wert zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The vault already has %@. Use its Replace to change the value."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacén ya contiene %@. Usa su opción Reemplazar para cambiar el valor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coffre contient déjà %@. Utilisez son bouton Remplacer pour modifier la valeur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cassaforte contiene già %@. Usa il relativo Sostituisci per modificare il valore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボールトにはすでに %@ があります。値を変更するには、その「置き換え」を使用してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឃ្លាំងមាន %@ រួចហើយ។ ប្រើ ជំនួស របស់វា ដើម្បីផ្លាស់ប្ដូរតម្លៃ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함에 이미 %@이(가) 있습니다. 값을 변경하려면 해당 항목의 교체를 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvelvet har allerede %@. Bruk Erstatt på den for å endre verdien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejf zawiera już %@. Użyj opcji Zastąp przy tej pozycji, aby zmienić wartość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cofre já tem %@. Use a opção Substituir dele para alterar o valor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В хранилище уже есть %@. Чтобы изменить значение, используйте его кнопку «Заменить»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้องนิรภัยมี %@ อยู่แล้ว ใช้ปุ่มแทนที่ของรายการนั้นเพื่อเปลี่ยนค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasada %@ zaten var. Değeri değiştirmek için onun Değiştir seçeneğini kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У сховищі вже є %@. Щоб змінити значення, скористайтеся його кнопкою «Замінити»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kho đã có %@. Dùng nút Thay thế của mục đó để đổi giá trị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保险库中已有 %@。请使用它的“替换”来更改值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保險庫中已有 %@。請使用它的「取代」來變更值。"
          }
        }
      }
    },
    "credentialVault.error.index": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتعذر قراءة فهرس الخزنة في %@ أو الكتابة إليه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Indeks trezora na %@ nije moguće čitati ni pisati."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Boksens indeks i %@ kan ikke læses eller skrives."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tresor-Index unter %@ kann nicht gelesen oder geschrieben werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The vault index at %@ cannot be read or written."
