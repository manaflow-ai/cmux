    "credentialVault.error.missing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تحتوي الخزنة على %@. أضفه باستخدام `cmux vault set NAME`، أو اطلبه من الشخص باستخدام `cmux vault request NAME`."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trezor nema %@. Dodajte ga pomoću `cmux vault set NAME` ili ga zatražite od osobe pomoću `cmux vault request NAME`."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Boksen har ingen %@. Tilføj den med `cmux vault set NAME`, eller bed personen om den med `cmux vault request NAME`."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tresor enthält kein %@. Füge es mit `cmux vault set NAME` hinzu oder frage die Person mit `cmux vault request NAME`."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The vault has no %@. Add it with `cmux vault set NAME`, or ask the person with `cmux vault request NAME`."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacén no contiene %@. Añádelo con `cmux vault set NAME` o pídeselo a la persona con `cmux vault request NAME`."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coffre ne contient pas %@. Ajoutez-le avec `cmux vault set NAME` ou demandez-le à la personne avec `cmux vault request NAME`."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cassaforte non contiene %@. Aggiungilo con `cmux vault set NAME` o chiedilo alla persona con `cmux vault request NAME`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボールトに %@ がありません。`cmux vault set NAME` で追加するか、`cmux vault request NAME` で本人に依頼してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឃ្លាំងមិនមាន %@ ទេ។ បន្ថែមវាដោយប្រើ `cmux vault set NAME` ឬស្នើសុំពីបុគ្គលដោយប្រើ `cmux vault request NAME`។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함에 %@이(가) 없습니다. `cmux vault set NAME`으로 추가하거나 `cmux vault request NAME`으로 사용자에게 요청하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvelvet har ingen %@. Legg den til med `cmux vault set NAME`, eller be personen om den med `cmux vault request NAME`."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejf nie zawiera %@. Dodaj go poleceniem `cmux vault set NAME` lub poproś o niego osobę poleceniem `cmux vault request NAME`."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cofre não tem %@. Adicione com `cmux vault set NAME` ou peça à pessoa com `cmux vault request NAME`."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В хранилище нет %@. Добавьте его командой `cmux vault set NAME` или запросите у человека командой `cmux vault request NAME`."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้องนิรภัยไม่มี %@ เพิ่มได้ด้วย `cmux vault set NAME` หรือขอจากผู้ใช้ด้วย `cmux vault request NAME`"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasada %@ yok. `cmux vault set NAME` ile ekleyin veya `cmux vault request NAME` ile kişiden isteyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У сховищі немає %@. Додайте його командою `cmux vault set NAME` або запитайте в людини командою `cmux vault request NAME`."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kho không có %@. Thêm bằng `cmux vault set NAME` hoặc yêu cầu người dùng bằng `cmux vault request NAME`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保险库中没有 %@。请使用 `cmux vault set NAME` 添加，或使用 `cmux vault request NAME` 向对方请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保險庫中沒有 %@。請使用 `cmux vault set NAME` 加入，或使用 `cmux vault request NAME` 向對方要求。"
          }
        }
      }
    },
