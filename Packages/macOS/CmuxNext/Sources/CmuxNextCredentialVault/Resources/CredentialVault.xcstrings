        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W cmux jest otwarte inne zatwierdzenie Sejfu poświadczeń; najpierw na nie odpowiedz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra aprovação do Cofre de credenciais está aberta no cmux; responda a ela primeiro"
          }
        },
        "ru": {
