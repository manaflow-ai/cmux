    "credentialVault.delete.line": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يحصل عليه بعد الآن الوكلاء والأوامر التي تستخدمه. وستُزال قيمته من سلسلة المفاتيح."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenti i naredbe koji ga koriste više ga neće dobivati. Njegova vrijednost se uklanja iz vašeg privjeska ključeva."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenter og kommandoer, der bruger den, får den ikke længere. Dens værdi fjernes fra din nøglering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents und Befehle, die ihn verwenden, erhalten ihn nicht mehr. Sein Wert wird aus deinem Schlüsselbund entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents and commands that use it stop getting it. Its value leaves your Keychain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes y comandos que lo usan dejarán de recibirlo. Su valor se eliminará de tu llavero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les agents et commandes qui l’utilisent ne le recevront plus. Sa valeur sera retirée de votre trousseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli agenti e i comandi che lo usano smetteranno di riceverlo. Il suo valore verrà rimosso dal tuo portachiavi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これを使用するエージェントやコマンドは受け取れなくなります。値はキーチェーンから削除されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្នាក់ងារ និងពាក្យបញ្ជាដែលប្រើវានឹងលែងទទួលបានវា។ តម្លៃរបស់វានឹងត្រូវដកចេញពី Keychain របស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이를 사용하는 에이전트와 명령은 더 이상 받을 수 없습니다. 값은 키체인에서 제거됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenter og kommandoer som bruker den, får den ikke lenger. Verdien fjernes fra nøkkelringen din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenci i polecenia, które go używają, przestaną go otrzymywać. Jego wartość zostanie usunięta z pęku kluczy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentes e comandos que o usam deixam de recebê-lo. O valor sai das suas Chaves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты и команды, которые его используют, перестанут его получать. Его значение будет удалено из связки ключей."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์และคำสั่งที่ใช้อยู่จะไม่ได้รับอีกต่อไป และค่าจะถูกนำออกจากพวงกุญแจของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu kullanan ajanlar ve komutlar artık onu alamaz. Değeri Anahtar Zinciri'nizden kaldırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенти й команди, які його використовують, більше його не отримуватимуть. Його значення буде видалено з в'язки ключів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tác tử và lệnh đang dùng nó sẽ không nhận được nữa. Giá trị của nó sẽ bị xóa khỏi Chuỗi khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用它的智能体和命令将不再获得它。它的值会从你的钥匙串中移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用它的代理程式和指令將不再取得它。它的值會從你的鑰匙圈中移除。"
          }
        }
      }
    },
    "credentialVault.delete.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف %@ من خزنة بيانات الاعتماد؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrisati %@ iz Trezora akreditiva?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet %@ fra boksen med loginoplysninger?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aus dem Anmeldedaten-Tresor löschen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete %@ from the Credential Vault?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar %@ del almacén de credenciales?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer %@ du coffre d’identifiants ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare %@ dalla cassaforte delle credenziali?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を認証情報ボールトから削除しますか？"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "លុប %@ ចេញពីឃ្លាំងព័ត៌មានផ្ទៀងផ្ទាត់ឬ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자격 증명 보관함에서 %@을(를) 삭제하시겠습니까?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slette %@ fra påloggingshvelvet?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć %@ z sejfu danych logowania?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar %@ do Cofre de credenciais?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить %@ из хранилища учетных данных?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบ %@ ออกจากห้องนิรภัยข้อมูลรับรองหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Kimlik Bilgisi Kasası'ndan silinsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити %@ зі сховища облікових даних?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa %@ khỏi Kho thông tin xác thực?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要从凭据保险库中删除 %@ 吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要從憑證保險庫中刪除 %@ 嗎？"
          }
        }
      }
    },
