    "credentialVault.approve.replaceTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد استبدال قيمة %@ في خزنة بيانات الاعتماد؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamijeniti vrijednost %@ u Trezoru akreditiva?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du erstatte værdien af %@ i Legitimationsboksen?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Wert von %@ im Anmeldedaten-Tresor ersetzen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace the value of %@ in the Credential Vault?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Reemplazar el valor de %@ en la Bóveda de credenciales?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacer la valeur de %@ dans le Coffre d’identifiants ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituire il valore di %@ nella Cassaforte delle credenziali?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "資格情報保管庫の %@ の値を置き換えますか？"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ជំនួសតម្លៃរបស់ %@ ក្នុងឃ្លាំងព័ត៌មានសម្ងាត់ឬ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자격 증명 보관함에서 %@의 값을 바꿀까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du erstatte verdien til %@ i Legitimasjonshvelvet?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastąpić wartość %@ w Sejfie poświadczeń?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substituir o valor de %@ no Cofre de credenciais?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменить значение %@ в Хранилище учётных данных?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แทนที่ค่าของ %@ ในห้องนิรภัยข้อมูลรับรองหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimlik Bilgisi Kasası’ndaki %@ değeri değiştirilsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Замінити значення %@ у Сховищі облікових даних?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay giá trị của %@ trong Kho thông tin xác thực?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替换凭据保险库中 %@ 的值？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取代憑證保險庫中 %@ 的值？"
          }
        }
      }
    },
    "credentialVault.approve.scopeAgents": {
      "extractionState": "manual",
      "localizations": {
