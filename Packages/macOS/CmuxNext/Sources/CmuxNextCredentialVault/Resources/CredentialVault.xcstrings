    "credentialVault.approve.scopeTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد تغيير من يمكنه استخدام %@؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Promijeniti ko smije koristiti %@?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du ændre, hvem der må bruge %@?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändern, wer %@ verwenden darf?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change who may use %@?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cambiar quién puede usar %@?"
