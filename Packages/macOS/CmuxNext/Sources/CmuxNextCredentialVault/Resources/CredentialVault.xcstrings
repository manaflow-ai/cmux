            "state": "translated",
            "value": "Nuovo: solo tu. Gli agenti non possono usarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更後: あなたのみ。エージェントは使用できません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ថ្មី៖ តែអ្នកប៉ុណ្ណោះ។ ភ្នាក់ងារមិនអាចប្រើវាបានទេ។"
