        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 후: 나만. 에이전트는 사용할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nytt: bare deg. Agenter kan ikke bruke den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowe: tylko Ty. Agenci nie mogą go używać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Novo: apenas você. Agentes não podem usá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь: только вы. Агенты не могут его использовать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใหม่: คุณเท่านั้น เอเจนต์ใช้ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni: yalnızca siz. Ajanlar kullanamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тепер: лише ви. Агенти не можуть ним користуватися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mới: chỉ bạn. Tác tử không được dùng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
