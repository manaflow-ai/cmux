    "credentialVault.error.invalidName": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏“%@” ليس اسمًا صالحًا للخزنة: استخدم الحروف والأرقام و_، دون البدء برقم (128 كحد أقصى)."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ nije naziv trezora: koristite slova, cifre i _, bez cifre na početku (najviše 128)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” er ikke et boksnavn: brug bogstaver, cifre og _, uden et ciffer først (højst 128)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist kein gültiger Tresor-Name: Verwende Buchstaben, Ziffern und _, nicht mit einer Ziffer beginnend (höchstens 128)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not a vault name: use letters, digits and _, not starting with a digit (at most 128)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” no es un nombre de almacén válido: usa letras, dígitos y _, sin empezar por un dígito (128 como máximo)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n’est pas un nom de coffre valide : utilisez des lettres, des chiffres et _, sans commencer par un chiffre (128 au maximum)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non è un nome valido: usa lettere, cifre e _, senza iniziare con una cifra (massimo 128)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” はボールト名として使用できません。英字、数字、_ を使い、数字で始めないでください（最大 128 文字）。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” មិនមែនជាឈ្មោះឃ្លាំងទេ៖ ប្រើអក្សរ លេខ និង _ ដោយមិនចាប់ផ្ដើមដោយលេខ (យ៉ាងច្រើន 128)។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”은(는) 유효한 보관함 이름이 아닙니다. 문자, 숫자, _를 사용하고 숫자로 시작하지 마세요(최대 128자)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» er ikke et hvelvnavn: bruk bokstaver, sifre og _, uten å starte med et siffer (maks. 128)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nie jest nazwą w sejfie: użyj liter, cyfr i _, bez cyfry na początku (maks. 128)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não é um nome de cofre: use letras, dígitos e _, sem começar com dígito (no máximo 128)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» не является именем в хранилище: используйте буквы, цифры и _, не начиная с цифры (не более 128)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ไม่ใช่ชื่อที่ใช้ได้ในห้องนิรภัย: ใช้ตัวอักษร ตัวเลข และ _ โดยไม่ขึ้นต้นด้วยตัวเลข (สูงสุด 128)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” geçerli bir kasa adı değil: harf, rakam ve _ kullanın, rakamla başlamayın (en fazla 128)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» не є назвою у сховищі: використовуйте літери, цифри та _, не починаючи з цифри (не більше 128)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” không phải tên hợp lệ trong kho: dùng chữ cái, chữ số và _, không bắt đầu bằng chữ số (tối đa 128)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不是有效的保险库名称：请使用字母、数字和 _，且不能以数字开头（最多 128 个字符）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」不是有效的保險庫名稱：請使用字母、數字和 _，且不可以數字開頭（最多 128 個字元）。"
          }
        }
      }
    },
    "credentialVault.error.invalidNote": {
