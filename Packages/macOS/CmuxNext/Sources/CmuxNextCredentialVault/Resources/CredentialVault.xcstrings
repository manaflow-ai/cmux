    "credentialVault.approve.useLine": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنه محفوظ لك: لا يمكن للوكلاء استخدامه. يحصل البرنامج الذي يطلبه على قيمته."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čuva se za vas: agenti ga ne smiju koristiti. Program koji ga traži dobiva njegovu vrijednost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den er gemt til dig: agenter må ikke bruge den. Det program, der beder om den, får dens værdi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ist für dich reserviert: Agenten dürfen ihn nicht verwenden. Das anfragende Programm erhält seinen Wert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is kept for you: agents may not use it. The program that asks gets its value."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está reservado para ti: los agentes no pueden usarlo. El programa que lo pide recibe su valor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vous est réservé : les agents ne peuvent pas l’utiliser. Le programme qui le demande reçoit sa valeur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È riservato a te: gli agenti non possono usarlo. Il programma che lo chiede ne riceve il valore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはあなた専用です。エージェントは使用できません。要求したプログラムがその値を受け取ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វាត្រូវបានរក្សាទុកសម្រាប់អ្នក៖ ភ្នាក់ងារមិនអាចប្រើវាបានទេ។ កម្មវិធីដែលស្នើសុំទទួលបានតម្លៃរបស់វា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나만 쓰도록 보관된 항목입니다. 에이전트는 사용할 수 없습니다. 요청한 프로그램이 그 값을 받습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den er holdt av for deg: agenter kan ikke bruke den. Programmet som ber om den, får verdien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jest zachowany dla Ciebie: agenci nie mogą go używać. Program, który o niego prosi, otrzyma jego wartość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele é reservado a você: agentes não podem usá-lo. O programa que pede recebe o valor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он хранится только для вас: агенты не могут его использовать. Запросившая программа получит его значение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บไว้สำหรับคุณเท่านั้น เอเจนต์ใช้ไม่ได้ โปรแกรมที่ขอจะได้รับค่านี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca sizin için saklanıyor: ajanlar kullanamaz. İsteyen program değerini alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Він зберігається лише для вас: агенти не можуть ним користуватися. Програма, що просить, отримає його значення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mục này chỉ dành cho bạn: tác tử không được dùng. Chương trình yêu cầu sẽ nhận giá trị của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它仅供你使用：代理不能使用它。请求它的程序会获得它的值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它僅供你使用：代理不能使用它。要求它的程式會取得它的值。"
          }
        }
      }
    },
