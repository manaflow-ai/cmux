    "credentialVault.approve.onlyYou": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب أمر `cmux vault` هذا. اسمح به فقط إذا شغّلت هذا الأمر بنفسك للتو."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo traži naredba `cmux vault`. Dozvolite samo ako ste je upravo sami pokrenuli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En `cmux vault`-kommando beder om dette. Tillad det kun, hvis du selv lige har kørt kommandoen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein `cmux vault`-Befehl fragt danach. Erlaube es nur, wenn du diesen Befehl gerade selbst ausgeführt hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A `cmux vault` command asks for this. Allow it only if you just ran that command yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un comando `cmux vault` lo solicita. Permítelo solo si acabas de ejecutar ese comando tú mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une commande `cmux vault` le demande. Autorisez-la uniquement si vous venez de lancer cette commande vous-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo chiede un comando `cmux vault`. Consentilo solo se hai appena eseguito tu quel comando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`cmux vault` コマンドがこれを要求しています。自分でそのコマンドを実行した直後の場合のみ許可してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពាក្យបញ្ជា `cmux vault` ស្នើសុំនេះ។ អនុញ្ញាតតែប្រសិនបើអ្នកទើបតែដំណើរការពាក្យបញ្ជានោះដោយខ្លួនឯង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`cmux vault` 명령이 이를 요청합니다. 방금 직접 그 명령을 실행한 경우에만 허용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En `cmux vault`-kommando ber om dette. Tillat det bare hvis du selv nettopp kjørte kommandoen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosi o to polecenie `cmux vault`. Zezwól tylko wtedy, gdy właśnie samodzielnie je uruchomiłeś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um comando `cmux vault` pede isto. Permita apenas se você acabou de executar esse comando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это запрашивает команда `cmux vault`. Разрешайте, только если вы сами только что её запустили."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำสั่ง `cmux vault` ขอสิ่งนี้ อนุญาตเฉพาะเมื่อคุณเพิ่งเรียกใช้คำสั่งนั้นเองเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu bir `cmux vault` komutu istiyor. Yalnızca bu komutu az önce kendiniz çalıştırdıysanız izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це запитує команда `cmux vault`. Дозволяйте, лише якщо ви щойно самі її запустили."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lệnh `cmux vault` yêu cầu việc này. Chỉ cho phép nếu bạn vừa tự chạy lệnh đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有一条 `cmux vault` 命令请求此操作。仅当你刚刚亲自运行了该命令时才允许。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有一個 `cmux vault` 指令要求此操作。僅在你剛剛親自執行該指令時才允許。"
          }
        }
      }
    },
