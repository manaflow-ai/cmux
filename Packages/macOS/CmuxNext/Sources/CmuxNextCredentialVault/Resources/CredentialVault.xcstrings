    "credentialVault.error.cooldown": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد رفضت للتو طلبًا لخزنة بيانات الاعتماد في cmux؛ اطلب مجددًا بعد بضع ثوانٍ"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravo ste odbili zahtjev Trezora akreditiva u cmuxu; pokušajte ponovo za nekoliko sekundi"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har lige afvist en anmodning fra Legitimationsboksen i cmux; spørg igen om et par sekunder"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast gerade eine Anfrage des Anmeldedaten-Tresors in cmux abgelehnt; frage in ein paar Sekunden erneut"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You just declined a Credential Vault request in cmux; ask again in a few seconds"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acabas de rechazar una solicitud de la Bóveda de credenciales en cmux; vuelve a pedirlo en unos segundos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous venez de refuser une demande du Coffre d’identifiants dans cmux ; redemandez dans quelques secondes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai appena rifiutato una richiesta della Cassaforte delle credenziali in cmux; chiedi di nuovo tra qualche secondo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux で資格情報保管庫のリクエストを拒否したばかりです。数秒後にもう一度依頼してください"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកទើបតែបដិសេធសំណើឃ្លាំងព័ត៌មានសម្ងាត់ក្នុង cmux សូមស្នើម្តងទៀតក្នុងរយៈពេលពីរបីវិនាទី"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux에서 방금 자격 증명 보관함 요청을 거부했습니다. 몇 초 후에 다시 요청하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du avslo nettopp en forespørsel fra Legitimasjonshvelvet i cmux; spør igjen om noen sekunder"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Właśnie odrzucono prośbę Sejfu poświadczeń w cmux; poproś ponownie za kilka sekund"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você acabou de recusar uma solicitação do Cofre de credenciais no cmux; peça de novo em alguns segundos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы только что отклонили запрос Хранилища учётных данных в cmux; повторите через несколько секунд"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเพิ่งปฏิเสธคำขอของห้องนิรภัยข้อมูลรับรองใน cmux โปรดขออีกครั้งในอีกไม่กี่วินาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux’ta az önce bir Kimlik Bilgisi Kasası isteğini reddettiniz; birkaç saniye sonra yeniden isteyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви щойно відхилили запит Сховища облікових даних у cmux; повторіть за кілька секунд"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn vừa từ chối một yêu cầu của Kho thông tin xác thực trong cmux; hãy yêu cầu lại sau vài giây"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你刚刚在 cmux 中拒绝了一个凭据保险库请求；请几秒后再试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你剛剛在 cmux 中拒絕了一個憑證保險庫要求；請幾秒後再試"
          }
        }
      }
    },
    "credentialVault.error.declined": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتم إضافة %@: تم رفض الطلب أو إغلاقه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nije dodan: zahtjev je odbijen ili zatvoren."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ blev ikke tilføjet: anmodningen blev afvist eller lukket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde nicht hinzugefügt: Die Anfrage wurde abgelehnt oder geschlossen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was not added: the request was declined or closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se añadió %@: la solicitud se rechazó o se cerró."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas été ajouté : la demande a été refusée ou fermée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è stato aggiunto: la richiesta è stata rifiutata o chiusa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は追加されませんでした。依頼が拒否されたか閉じられました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនបានបន្ថែម %@ ទេ៖ សំណើត្រូវបានបដិសេធ ឬបិទ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 추가되지 않았습니다. 요청이 거부되었거나 닫혔습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ble ikke lagt til: forespørselen ble avslått eller lukket."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie dodano %@: prośba została odrzucona lub zamknięta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não foi adicionado: a solicitação foi recusada ou fechada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не добавлен: запрос отклонен или закрыт."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้เพิ่ม %@ เนื่องจากคำขอถูกปฏิเสธหรือถูกปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ eklenmedi: istek reddedildi veya kapatıldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не додано: запит відхилено або закрито."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa thêm %@: yêu cầu đã bị từ chối hoặc đóng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未添加 %@：请求已被拒绝或关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未加入 %@：要求已被拒絕或關閉。"
          }
        }
      }
    },
    "credentialVault.error.deniedAgents": {
