    "credentialVault.entry.privacy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ القيمة في سلسلة المفاتيح. يستخدمها الوكلاء بالاسم ولا يرونها أبدًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrijednost se sprema u vaš privjesak ključeva. Agenti je koriste po imenu i nikada je ne vide."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Værdien gemmes i din nøglering. Agenter bruger den ved navn og ser den aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wert wird in deinem Schlüsselbund gespeichert. Agents verwenden ihn über seinen Namen und sehen ihn nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The value goes to your Keychain. Agents use it by name and never see it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor se guarda en tu llavero. Los agentes lo usan por su nombre y nunca lo ven."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La valeur est enregistrée dans votre trousseau. Les agents l’utilisent par son nom sans jamais la voir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il valore viene salvato nel tuo portachiavi. Gli agenti lo usano per nome e non lo vedono mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値はキーチェーンに保存されます。エージェントは名前で使用し、値を見ることはありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "តម្លៃនេះត្រូវបានរក្សាទុកក្នុង Keychain របស់អ្នក។ ភ្នាក់ងារប្រើវាតាមឈ្មោះ ហើយមិនដែលឃើញវាឡើយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값은 키체인에 저장됩니다. 에이전트는 이름으로만 사용하며 값을 볼 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdien lagres i nøkkelringen din. Agenter bruker den ved navn og ser den aldri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartość trafia do Twojego pęku kluczy. Agenci używają jej po nazwie i nigdy jej nie widzą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor vai para as suas Chaves. Os agentes o usam pelo nome e nunca o veem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значение сохраняется в вашей связке ключей. Агенты используют его по имени и никогда его не видят."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่านี้จะถูกเก็บในพวงกุญแจของคุณ เอเจนต์ใช้ผ่านชื่อและไม่เคยเห็นค่าจริง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değer Anahtar Zinciri'nize kaydedilir. Ajanlar onu adıyla kullanır ve hiçbir zaman görmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Значення зберігається у вашій в'язці ключів. Агенти використовують його за назвою і ніколи його не бачать."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá trị được lưu vào Chuỗi khóa của bạn. Tác tử dùng nó theo tên và không bao giờ thấy nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此值会存入你的钥匙串。智能体仅按名称使用，永远看不到内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此值會存入你的鑰匙圈。代理程式只透過名稱使用，永遠看不到內容。"
          }
        }
      }
    },
