    "credentialVault.error.declined": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتم إضافة %@: تم رفض الطلب أو إغلاقه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nije dodan: zahtjev je odbijen ili zatvoren."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ blev ikke tilføjet: anmodningen blev afvist eller lukket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde nicht hinzugefügt: Die Anfrage wurde abgelehnt oder geschlossen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was not added: the request was declined or closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se añadió %@: la solicitud se rechazó o se cerró."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas été ajouté : la demande a été refusée ou fermée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è stato aggiunto: la richiesta è stata rifiutata o chiusa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は追加されませんでした。依頼が拒否されたか閉じられました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនបានបន្ថែម %@ ទេ៖ សំណើត្រូវបានបដិសេធ ឬបិទ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 추가되지 않았습니다. 요청이 거부되었거나 닫혔습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ble ikke lagt til: forespørselen ble avslått eller lukket."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie dodano %@: prośba została odrzucona lub zamknięta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não foi adicionado: a solicitação foi recusada ou fechada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не добавлен: запрос отклонен или закрыт."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้เพิ่ม %@ เนื่องจากคำขอถูกปฏิเสธหรือถูกปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ eklenmedi: istek reddedildi veya kapatıldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не додано: запит відхилено або закрито."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa thêm %@: yêu cầu đã bị từ chối hoặc đóng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未添加 %@：请求已被拒绝或关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未加入 %@：要求已被拒絕或關閉。"
          }
        }
      }
    },
    "credentialVault.error.deniedAgents": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن للوكلاء استخدام %@: نطاقه مقتصر عليك. غيّر ذلك من الإعدادات > خزنة بيانات الاعتماد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenti ne smiju koristiti %@: dostupan je samo vama. Promijenite to u Postavke > Trezor akreditiva."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenter må ikke bruge %@: den er kun til dig. Skift det i Indstillinger > Boks med loginoplysninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents dürfen %@ nicht verwenden: Es ist nur für dich bestimmt. Ändere das unter Einstellungen > Anmeldedaten-Tresor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents may not use %@: its scope is you only. Change it in Settings > Credential Vault."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes no pueden usar %@: su alcance es solo para ti. Cámbialo en Ajustes > Almacén de credenciales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les agents ne peuvent pas utiliser %@ : sa portée est limitée à vous. Modifiez-la dans Réglages > Coffre d’identifiants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli agenti non possono usare %@: è riservato a te. Modificalo in Impostazioni > Cassaforte delle credenziali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントは %@ を使用できません。範囲があなた専用になっています。「設定 > 認証情報ボールト」で変更してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្នាក់ងារមិនអាចប្រើ %@ បានទេ៖ វិសាលភាពរបស់វាសម្រាប់តែអ្នកប៉ុណ្ណោះ។ ផ្លាស់ប្ដូរវានៅក្នុង ការកំណត់ > ឃ្លាំងព័ត៌មានផ្ទៀងផ្ទាត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트는 %@을(를) 사용할 수 없습니다. 범위가 사용자 전용입니다. 설정 > 자격 증명 보관함에서 변경하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenter kan ikke bruke %@: den er bare for deg. Endre det i Innstillinger > Påloggingshvelv."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenci nie mogą używać %@: jest dostępny tylko dla Ciebie. Zmień to w Ustawienia > Sejf danych logowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentes não podem usar %@: o escopo é só você. Altere em Ajustes > Cofre de credenciais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агентам нельзя использовать %@: он доступен только вам. Измените это в разделе Настройки > Хранилище учетных данных."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์ใช้ %@ ไม่ได้ เพราะขอบเขตเป็นของคุณเท่านั้น เปลี่ยนได้ที่ การตั้งค่า > ห้องนิรภัยข้อมูลรับรอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanlar %@ öğesini kullanamaz: kapsamı yalnızca sizsiniz. Bunu Ayarlar > Kimlik Bilgisi Kasası'nda değiştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенти не можуть використовувати %@: він доступний лише вам. Змініть це в розділі Параметри > Сховище облікових даних."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác tử không được dùng %@: phạm vi chỉ dành cho bạn. Thay đổi trong Cài đặt > Kho thông tin xác thực."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体无法使用 %@：其范围仅限你本人。请在“设置 > 凭据保险库”中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理程式無法使用 %@：其範圍僅限你本人。請在「設定 > 憑證保險庫」中變更。"
          }
        }
      }
    },
