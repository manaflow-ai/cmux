    "credentialVault.entry.nameTaken": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخزنة تحتوي بالفعل على %@. اختر اسمًا آخر، أو ألغِ واستخدم «استبدال» الخاص به في الإعدادات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trezor već ima %@. Odaberite drugo ime ili otkažite i koristite njegovu opciju Zamijeni u Postavkama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Boksen har allerede %@. Vælg et andet navn, eller annuller og brug dens Erstat i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tresor enthält bereits %@. Wähle einen anderen Namen oder brich ab und nutze „Ersetzen“ in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The vault already has %@. Choose another name, or cancel and use its Replace in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La bóveda ya tiene %@. Elige otro nombre, o cancela y usa su Reemplazar en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coffre contient déjà %@. Choisissez un autre nom, ou annulez et utilisez son bouton Remplacer dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cassaforte contiene già %@. Scegli un altro nome, oppure annulla e usa il suo Sostituisci in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫にはすでに %@ があります。別の名前を選ぶか、キャンセルして設定の「置き換え」を使ってください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឃ្លាំងមាន %@ រួចហើយ។ ជ្រើសឈ្មោះផ្សេង ឬបោះបង់ ហើយប្រើ «ជំនួស» របស់វានៅក្នុងការកំណត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함에 이미 %@이(가) 있습니다. 다른 이름을 고르거나, 취소하고 설정에서 해당 항목의 바꾸기를 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvelvet har allerede %@. Velg et annet navn, eller avbryt og bruk Erstatt for den i Innstillinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejf ma już %@. Wybierz inną nazwę albo anuluj i użyj opcji Zastąp w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cofre já tem %@. Escolha outro nome, ou cancele e use o Substituir dele em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В хранилище уже есть %@. Выберите другое имя или отмените и используйте «Заменить» в настройках."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้องนิรภัยมี %@ อยู่แล้ว เลือกชื่ออื่น หรือยกเลิกแล้วใช้ \"แทนที่\" ของรายการนั้นในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasada zaten %@ var. Başka bir ad seçin ya da iptal edip Ayarlar’daki Değiştir’i kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У сховищі вже є %@. Виберіть іншу назву або скасуйте й скористайтеся «Замінити» в Параметрах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kho đã có %@. Hãy chọn tên khác, hoặc hủy và dùng Thay thế của nó trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保险库中已有 %@。请换一个名称，或取消后在设置中使用它的“替换”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保險庫中已有 %@。請換一個名稱，或取消後在設定中使用它的「取代」。"
          }
        }
      }
    },
    "credentialVault.entry.pasteTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقل مفتاح إلى خزنة بيانات الاعتماد"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Premjesti ključ u Trezor akreditiva"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyt en nøgle til boksen med loginoplysninger"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüssel in den Anmeldedaten-Tresor verschieben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move a Key to the Credential Vault"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover una clave al almacén de credenciales"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer une clé vers le coffre d’identifiants"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta una chiave nella cassaforte delle credenziali"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを認証情報ボールトに移動"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្លាស់ទីកូនសោទៅឃ្លាំងព័ត៌មានផ្ទៀងផ្ទាត់"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자격 증명 보관함으로 키 이동"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytt en nøkkel til påloggingshvelvet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenieś klucz do sejfu danych logowania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover uma chave para o Cofre de credenciais"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переместить ключ в хранилище учетных данных"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย้ายคีย์ไปยังห้องนิรภัยข้อมูลรับรอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir anahtarı Kimlik Bilgisi Kasası'na taşı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемістити ключ до сховища облікових даних"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển khóa vào Kho thông tin xác thực"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将密钥移到凭据保险库"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將金鑰移到憑證保險庫"
          }
        }
      }
    },
    "credentialVault.entry.privacy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ القيمة في سلسلة المفاتيح. يستخدمها الوكلاء بالاسم ولا يرونها أبدًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrijednost se sprema u vaš privjesak ključeva. Agenti je koriste po imenu i nikada je ne vide."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Værdien gemmes i din nøglering. Agenter bruger den ved navn og ser den aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wert wird in deinem Schlüsselbund gespeichert. Agents verwenden ihn über seinen Namen und sehen ihn nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The value goes to your Keychain. Agents use it by name and never see it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor se guarda en tu llavero. Los agentes lo usan por su nombre y nunca lo ven."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La valeur est enregistrée dans votre trousseau. Les agents l’utilisent par son nom sans jamais la voir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il valore viene salvato nel tuo portachiavi. Gli agenti lo usano per nome e non lo vedono mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値はキーチェーンに保存されます。エージェントは名前で使用し、値を見ることはありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "តម្លៃនេះត្រូវបានរក្សាទុកក្នុង Keychain របស់អ្នក។ ភ្នាក់ងារប្រើវាតាមឈ្មោះ ហើយមិនដែលឃើញវាឡើយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값은 키체인에 저장됩니다. 에이전트는 이름으로만 사용하며 값을 볼 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdien lagres i nøkkelringen din. Agenter bruker den ved navn og ser den aldri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartość trafia do Twojego pęku kluczy. Agenci używają jej po nazwie i nigdy jej nie widzą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor vai para as suas Chaves. Os agentes o usam pelo nome e nunca o veem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значение сохраняется в вашей связке ключей. Агенты используют его по имени и никогда его не видят."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่านี้จะถูกเก็บในพวงกุญแจของคุณ เอเจนต์ใช้ผ่านชื่อและไม่เคยเห็นค่าจริง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değer Anahtar Zinciri'nize kaydedilir. Ajanlar onu adıyla kullanır ve hiçbir zaman görmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Значення зберігається у вашій в'язці ключів. Агенти використовують його за назвою і ніколи його не бачать."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá trị được lưu vào Chuỗi khóa của bạn. Tác tử dùng nó theo tên và không bao giờ thấy nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此值会存入你的钥匙串。智能体仅按名称使用，永远看不到内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此值會存入你的鑰匙圈。代理程式只透過名稱使用，永遠看不到內容。"
          }
        }
      }
    },
