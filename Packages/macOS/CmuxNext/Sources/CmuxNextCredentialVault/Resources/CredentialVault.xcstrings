    "credentialVault.error.agentsMayNotWrite": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت وحدك من يضيف أسرار الخزنة أو يغيّرها أو يزيلها. يطلبها الوكيل باستخدام `cmux vault request NAME`."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo vi dodajete, mijenjate ili uklanjate tajne iz trezora. Agent ih traži pomoću `cmux vault request NAME`."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun du kan tilføje, ændre eller fjerne hemmeligheder i boksen. En agent beder om dem med `cmux vault request NAME`."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur du kannst Tresor-Geheimnisse hinzufügen, ändern oder entfernen. Ein Agent fragt mit `cmux vault request NAME` an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only you add, change or remove vault secrets. An agent asks with `cmux vault request NAME`."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo tú puedes añadir, cambiar o eliminar secretos del almacén. Un agente los solicita con `cmux vault request NAME`."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous seul pouvez ajouter, modifier ou supprimer les secrets du coffre. Un agent les demande avec `cmux vault request NAME`."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo tu puoi aggiungere, modificare o rimuovere i segreti della cassaforte. Un agente li richiede con `cmux vault request NAME`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボールトのシークレットを追加、変更、削除できるのはあなただけです。エージェントは `cmux vault request NAME` で依頼します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មានតែអ្នកទេដែលអាចបន្ថែម ផ្លាស់ប្ដូរ ឬលុបអាថ៌កំបាំងក្នុងឃ្លាំង។ ភ្នាក់ងារស្នើសុំដោយប្រើ `cmux vault request NAME`។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함 비밀은 사용자만 추가, 변경, 삭제할 수 있습니다. 에이전트는 `cmux vault request NAME`으로 요청합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare du kan legge til, endre eller fjerne hemmeligheter i hvelvet. En agent ber om dem med `cmux vault request NAME`."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko Ty dodajesz, zmieniasz lub usuwasz sekrety w sejfie. Agent prosi o nie poleceniem `cmux vault request NAME`."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só você adiciona, altera ou remove segredos do cofre. Um agente os solicita com `cmux vault request NAME`."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только вы можете добавлять, изменять и удалять секреты хранилища. Агент запрашивает их командой `cmux vault request NAME`."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีเพียงคุณเท่านั้นที่เพิ่ม เปลี่ยน หรือลบข้อมูลลับในห้องนิรภัยได้ เอเจนต์ขอได้ด้วย `cmux vault request NAME`"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasadaki gizli bilgileri yalnızca siz ekler, değiştirir veya kaldırırsınız. Bir ajan bunları `cmux vault request NAME` ile ister."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише ви можете додавати, змінювати чи видаляти секрети сховища. Агент запитує їх командою `cmux vault request NAME`."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ bạn mới có thể thêm, thay đổi hoặc xóa bí mật trong kho. Tác tử yêu cầu bằng `cmux vault request NAME`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你能添加、更改或移除保险库密钥。智能体可使用 `cmux vault request NAME` 发起请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你能新增、變更或移除保險庫密鑰。代理程式可使用 `cmux vault request NAME` 提出要求。"
          }
        }
      }
    },
