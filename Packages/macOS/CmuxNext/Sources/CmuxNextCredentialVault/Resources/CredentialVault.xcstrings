        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux에 다른 자격 증명 보관함 승인이 열려 있습니다. 먼저 응답하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
