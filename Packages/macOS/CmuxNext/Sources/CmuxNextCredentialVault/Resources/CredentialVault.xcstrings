    "credentialVault.error.mustBeString": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ must be a string"
          }
        }
      }
    },
    "credentialVault.error.namesMustBeStrings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "names must be an array of secret names"
          }
        }
      }
    },
    "credentialVault.error.callerMustBeObject": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "caller must be an object"
          }
        }
      }
    },
    "credentialVault.error.badScope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "scope must name user, agents or both"
          }
        }
      }
    },
    "credentialVault.error.invalidName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not a vault name: use letters, digits and _, not starting with a digit (at most 128)."
          }
        }
      }
    },
    "credentialVault.error.invalidValue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The value for %@ must be 1 byte to 64 KB of text without NUL bytes."
          }
        }
      }
    },
    "credentialVault.error.invalidNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A note is at most 200 characters."
          }
        }
      }
    },
    "credentialVault.error.missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The vault has no %@. Add it with `cmux vault set NAME`, or ask the person with `cmux vault request NAME`."
          }
        }
      }
    },
    "credentialVault.error.deniedAgents": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents may not use %@: its scope is you only. Change it in Settings > Credential Vault."
          }
        }
      }
    },
    "credentialVault.error.deniedUser": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is for agents only. Change its scope in Settings > Credential Vault."
          }
        }
      }
    },
    "credentialVault.error.agentsMayNotWrite": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only you add, change or remove vault secrets. An agent asks with `cmux vault request NAME`."
          }
        }
      }
    },
