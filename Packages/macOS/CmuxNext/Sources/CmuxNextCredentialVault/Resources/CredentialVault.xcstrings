    "credentialVault.approve.scopeUser": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجديد: أنت فقط. لا يمكن للوكلاء استخدامه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Novo: samo vi. Agenti ga ne smiju koristiti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyt: kun dig. Agenter må ikke bruge den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neu: nur du. Agenten dürfen ihn nicht verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New: only you. Agents may not use it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuevo: solo tú. Los agentes no pueden usarlo."
          }
        },
        "fr": {
