    "taskManager.refusal.app": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kill Process does not end cmux itself. Quit cmux instead."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا تنهي «إنهاء العملية» تطبيق cmux نفسه. اخرج من cmux بدلاً من ذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ubij proces ne završava sam cmux. Umjesto toga zatvorite cmux."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Afslut proces afslutter ikke selve cmux. Afslut cmux i stedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Prozess beenden“ beendet nicht cmux selbst. Beende stattdessen cmux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Finalizar proceso no finaliza cmux. Sal de cmux en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Forcer l’arrêt ne s’applique pas à cmux lui-même. Quittez plutôt cmux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Termina processo non termina cmux stesso. Esci da cmux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「プロセスを終了」は cmux 自体を終了しません。代わりに cmux を終了してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បញ្ចប់ដំណើរការ មិនបញ្ចប់ cmux ខ្លួនឯងទេ។ សូមចាកចេញពី cmux ជំនួសវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "프로세스 종료로 cmux 자체는 종료할 수 없습니다. 대신 cmux를 종료하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avslutt prosess avslutter ikke selve cmux. Avslutt cmux i stedet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zakończ proces nie kończy samego cmux. Zamiast tego zamknij cmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Encerrar processo não encerra o próprio cmux. Saia do cmux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Завершить процесс» не завершает сам cmux. Вместо этого выйдите из cmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยุติโปรเซสไม่ยุติ cmux เอง ให้ออกจาก cmux แทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İşlemi sonlandır cmux'ın kendisini sonlandırmaz. Bunun yerine cmux'tan çıkın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Завершити процес» не завершує сам cmux. Натомість вийдіть із cmux."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kết thúc tiến trình không kết thúc chính cmux. Hãy thoát cmux."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“结束进程”不会结束 cmux 本身。请改为退出 cmux。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「結束程序」不會結束 cmux 本身。請改為結束 cmux。"
          }
        }
      }
    },
