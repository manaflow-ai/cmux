        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ (PID %2$@) zostanie teraz zakończony. Niezapisana praca zostanie utracona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
