    "taskManager.kill.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (PID %2$@) ends now. Work it has not saved is lost."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ستنتهي %1$@ (PID %2$@) الآن. يُفقد العمل غير المحفوظ."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ (PID %2$@) se odmah završava. Nesačuvani rad se gubi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ (PID %2$@) afsluttes nu. Arbejde, der ikke er gemt, går tabt."
