          "stringUnit": {
            "state": "needs_review",
            "value": "Forcer l’arrêt ne s’applique qu’aux processus lancés par cmux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Termina processo termina solo i processi avviati da cmux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
