    "taskManager.refusal.remote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kill Process ends only processes on this Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تنهي «إنهاء العملية» العمليات على جهاز Mac هذا فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ubij proces završava samo procese na ovom Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Afslut proces afslutter kun processer på denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Prozess beenden“ beendet nur Prozesse auf diesem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Finalizar proceso solo finaliza procesos de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Forcer l’arrêt ne s’applique qu’aux processus de ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Termina processo termina solo i processi su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「プロセスを終了」はこの Mac 上のプロセスだけを終了します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បញ្ចប់ដំណើរការ បញ្ចប់តែដំណើរការនៅលើ Mac នេះប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "프로세스 종료는 이 Mac의 프로세스만 종료합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avslutt prosess avslutter bare prosesser på denne Macen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zakończ proces kończy tylko procesy na tym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Encerrar processo encerra apenas processos neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Завершить процесс» завершает только процессы на этом Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยุติโปรเซสยุติได้เฉพาะโปรเซสบน Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
