        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ (PID %2$@) finalizará ahora. Se perderá el trabajo no guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ (PID %2$@) s’arrête maintenant. Le travail non enregistré est perdu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ (PID %2$@) termina ora. Il lavoro non salvato va perso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@（PID %2$@）を今すぐ終了します。保存されていない作業は失われます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ (PID %2$@) នឹងបញ្ចប់ឥឡូវនេះ។ ការងារដែលមិនបានរក្សាទុកនឹងបាត់បង់។"
          }
        },
