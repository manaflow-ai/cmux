    "taskManager.refusal.notCmux": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kill Process ends only processes that cmux started."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تنهي «إنهاء العملية» العمليات التي بدأها cmux فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ubij proces završava samo procese koje je pokrenuo cmux."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Afslut proces afslutter kun processer, som cmux har startet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Prozess beenden“ beendet nur Prozesse, die cmux gestartet hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Finalizar proceso solo finaliza procesos que inició cmux."
          }
