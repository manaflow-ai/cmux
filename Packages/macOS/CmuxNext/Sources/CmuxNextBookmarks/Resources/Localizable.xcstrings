{
  "sourceLanguage": "en",
  "strings": {
    "bar.emptyHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a link here or click the star to add bookmarks"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اسحب رابطًا إلى هنا أو انقر على النجمة لإضافة إشارات"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prevucite link ovdje ili kliknite zvjezdicu da dodate oznake"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Træk et link hertil, eller klik på stjernen for at tilføje bogmærker"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Link hierher ziehen oder auf den Stern klicken, um Lesezeichen hinzuzufügen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arrastra un enlace aquí o haz clic en la estrella para añadir marcadores"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faites glisser un lien ici ou cliquez sur l'étoile pour ajouter des favoris"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trascina qui un link o fai clic sulla stella per aggiungere preferiti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ここにリンクをドラッグするか、星をクリックしてブックマークを追加"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អូសតំណមកទីនេះ ឬចុចផ្កាយដើម្បីបន្ថែមចំណាំ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "여기로 링크를 드래그하거나 별표를 클릭하여 북마크를 추가하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dra en kobling hit eller klikk på stjernen for å legge til bokmerker"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przeciągnij tu link lub kliknij gwiazdkę, aby dodać zakładki"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arraste um link para cá ou clique na estrela para adicionar favoritos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перетащите сюда ссылку или нажмите на звезду, чтобы добавить закладки"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลากลิงก์มาที่นี่หรือคลิกดาวเพื่อเพิ่มบุ๊กมาร์ก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yer işareti eklemek için buraya bir bağlantı sürükleyin veya yıldızı tıklayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перетягніть сюди посилання або натисніть зірочку, щоб додати закладки"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kéo đường liên kết vào đây hoặc nhấp vào dấu sao để thêm dấu trang"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将链接拖到此处或点击星形图标添加书签"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "將連結拖曳到這裡，或按一下星號新增書籤"
          }
        }
      }
    },
