    "screenshots.open.background" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opened Screenshots in the background. It shows your screenshots only after you click Show Screenshots in it."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم فتح لقطات الشاشة في الخلفية. لا تظهر لقطات الشاشة إلا بعد أن تنقر على «عرض لقطات الشاشة» فيها."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snimci ekrana su otvoreni u pozadini. Snimci se prikazuju tek kada u njima kliknete „Prikaži snimke ekrana“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skærmbilleder blev åbnet i baggrunden. Dine skærmbilleder vises først, når du klikker på “Vis skærmbilleder” i den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildschirmfotos wurde im Hintergrund geöffnet. Deine Bildschirmfotos erscheinen erst, nachdem du darin auf „Bildschirmfotos anzeigen“ klickst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capturas de pantalla se abrió en segundo plano. Solo muestra tus capturas después de que hagas clic en «Mostrar capturas de pantalla» en ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Captures d’écran s’est ouvert en arrière-plan. Vos captures ne s’affichent qu’après un clic sur « Afficher les captures d’écran » dans l’onglet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istantanee schermo è stato aperto in background. Le istantanee compaiono solo dopo che fai clic su “Mostra istantanee schermo” al suo interno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショットをバックグラウンドで開きました。その中の「スクリーンショットを表示」をクリックするまで、スクリーンショットは表示されません。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "បានបើករូបថតអេក្រង់នៅផ្ទៃខាងក្រោយ។ វាបង្ហាញរូបថតអេក្រង់របស់អ្នកតែបន្ទាប់ពីអ្នកចុច «បង្ហាញរូបថតអេក្រង់» នៅក្នុងវាប៉ុណ្ណោះ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크린샷을 백그라운드에서 열었습니다. 그 안에서 ‘스크린샷 표시’를 클릭해야 스크린샷이 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjermbilder ble åpnet i bakgrunnen. Skjermbildene dine vises først når du klikker på «Vis skjermbilder» i den."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwarto Zrzuty ekranu w tle. Zrzuty pojawią się dopiero po kliknięciu w nich „Pokaż zrzuty ekranu”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capturas de Tela foi aberto em segundo plano. Ele só mostra suas capturas depois que você clica em “Mostrar Capturas de Tela” nele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снимки экрана открыты в фоновом режиме. Снимки появятся только после того, как вы нажмёте в них «Показать снимки экрана»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดภาพหน้าจอในพื้นหลังแล้ว ภาพหน้าจอของคุณจะแสดงหลังจากที่คุณคลิก “แสดงภาพหน้าจอ” ในแท็บนั้นเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran Görüntüleri arka planda açıldı. Ekran görüntüleriniz yalnızca içinde “Ekran Görüntülerini Göster”e tıkladıktan sonra görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знімки екрана відкрито у фоновому режимі. Знімки з’являться лише після того, як ви натиснете в них «Показати знімки екрана»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã mở Ảnh chụp màn hình ở chế độ nền. Ảnh chỉ hiển thị sau khi bạn bấm “Hiển thị ảnh chụp màn hình” trong đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已在后台打开截屏。只有在其中点按“显示截屏”后，才会显示你的截屏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已在背景開啟截圖。只有在其中按一下「顯示截圖」後，才會顯示你的截圖。"
          }
        }
      }
    },
