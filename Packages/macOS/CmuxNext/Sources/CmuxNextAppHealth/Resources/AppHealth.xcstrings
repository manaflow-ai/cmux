{
  "sourceLanguage": "en",
  "strings": {
    "appHealth.chatRestarted": {
      "comment": "One line shown in an agent chat pane after cmux ended its hung page and loaded it again.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقفت هذه المحادثة عن الاستجابة، لذا أعاد cmux تشغيلها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj razgovor je prestao odgovarati, pa ga je cmux ponovo pokrenuo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne chat holdt op med at svare, så cmux genstartede den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Chat hat nicht mehr reagiert, deshalb hat cmux ihn neu gestartet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This chat stopped responding, so cmux restarted it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este chat dejó de responder, así que cmux lo reinició."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette discussion ne répondait plus, cmux l’a donc redémarrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa chat ha smesso di rispondere, quindi cmux l’ha riavviata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットが応答しなくなったため、cmux が再起動しました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការជជែកនេះបានឈប់ឆ្លើយតប ដូច្នេះ cmux បានចាប់ផ្ដើមវាឡើងវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 채팅이 응답하지 않아 cmux가 다시 시작했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne chatten sluttet å svare, så cmux startet den på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten czat przestał odpowiadać, więc cmux uruchomił go ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este chat parou de responder, então o cmux o reiniciou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот чат перестал отвечать, поэтому cmux перезапустил его."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชตนี้หยุดตอบสนอง cmux จึงรีสตาร์ตแชตนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sohbet yanıt vermeyi bıraktı, bu yüzden cmux onu yeniden başlattı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей чат перестав відповідати, тому cmux перезапустив його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộc trò chuyện này đã ngừng phản hồi nên cmux đã khởi động lại nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此聊天已停止响应，cmux 已将其重新启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此聊天已停止回應，cmux 已將其重新啟動。"
          }
        }
      }
    },
