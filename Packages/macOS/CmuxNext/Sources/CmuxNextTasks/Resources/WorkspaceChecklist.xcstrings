        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No items yet. Add one above, or run cmux workspace checklist add."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aún no hay elementos. Añade uno arriba o ejecuta cmux workspace checklist add."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun élément pour l’instant. Ajoutez-en un ci-dessus ou exécutez cmux workspace checklist add."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ancora nessun elemento. Aggiungine uno sopra o esegui cmux workspace checklist add."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "まだ項目がありません。上で追加するか、cmux workspace checklist add を実行してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនទាន់មានធាតុនៅឡើយ។ បន្ថែមមួយនៅខាងលើ ឬដំណើរការ cmux workspace checklist add។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "아직 항목이 없습니다. 위에서 추가하거나 cmux workspace checklist add를 실행하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen punkter ennå. Legg til ett ovenfor, eller kjør cmux workspace checklist add."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brak elementów. Dodaj jeden powyżej lub uruchom cmux workspace checklist add."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhum item ainda. Adicione um acima ou execute cmux workspace checklist add."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пунктов пока нет. Добавьте пункт выше или выполните cmux workspace checklist add."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังไม่มีรายการ เพิ่มรายการด้านบน หรือเรียกใช้ cmux workspace checklist add"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Henüz öğe yok. Yukarıdan bir tane ekleyin veya cmux workspace checklist add komutunu çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пунктів ще немає. Додайте пункт вище або виконайте cmux workspace checklist add."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chưa có mục nào. Thêm một mục ở trên hoặc chạy cmux workspace checklist add."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "还没有项目。在上方添加一项，或运行 cmux workspace checklist add。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "還沒有項目。在上方新增一項，或執行 cmux workspace checklist add。"
