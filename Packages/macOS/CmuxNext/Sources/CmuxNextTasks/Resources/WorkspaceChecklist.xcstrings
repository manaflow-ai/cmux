    "workspaceChecklist.page.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا توجد عناصر بعد. أضف عنصرًا أعلاه، أو شغّل cmux workspace checklist add."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Još nema stavki. Dodajte jednu iznad ili pokrenite cmux workspace checklist add."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen punkter endnu. Tilføj et ovenfor, eller kør cmux workspace checklist add."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noch keine Einträge. Füge oben einen hinzu oder führe cmux workspace checklist add aus."
          }
