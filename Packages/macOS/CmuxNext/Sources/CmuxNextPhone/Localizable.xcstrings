            "value": "Nedlastingen stoppet. Sjekk internettforbindelsen, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pobieranie zostało przerwane. Sprawdź połączenie z internetem i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
