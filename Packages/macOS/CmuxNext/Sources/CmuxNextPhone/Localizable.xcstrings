    "phone.setup.finishXcode.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تم تثبيت Xcode لكنه لم يُفتح بعد. افتحه، وانقر على موافقة على الترخيص، واتركه يثبّت أجزاءه الإضافية. عندما يعرض Xcode نافذة الترحيب، يمكنك إنهاؤه والعودة إلى هنا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode je instaliran, ali još nije otvoren. Otvorite ga, kliknite Prihvati na licenci i pustite ga da instalira dodatne dijelove. Kada Xcode prikaže prozor dobrodošlice, možete ga zatvoriti i vratiti se ovdje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode er installeret, men er ikke blevet åbnet endnu. Åbn det, klik på Accepter i licensen, og lad det installere sine ekstra dele. Når Xcode viser sit velkomstvindue, kan du afslutte det og komme tilbage hertil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode ist installiert, wurde aber noch nicht geöffnet. Öffne es, klicke bei der Lizenz auf Zustimmen und lass es seine zusätzlichen Teile installieren. Wenn Xcode sein Willkommensfenster zeigt, kannst du es beenden und hierher zurückkommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode is installed but has not been opened yet. Open it, click Agree on the license, and let it install its extra parts. When Xcode shows its welcome window, you can quit it and come back here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode está instalado, pero aún no se ha abierto. Ábrelo, haz clic en Aceptar en la licencia y deja que instale sus componentes adicionales. Cuando Xcode muestre su ventana de bienvenida, puedes cerrarlo y volver aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode est installé mais n’a pas encore été ouvert. Ouvrez-le, cliquez sur Accepter pour la licence et laissez-le installer ses composants supplémentaires. Quand Xcode affiche sa fenêtre de bienvenue, vous pouvez le quitter et revenir ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode è installato ma non è ancora stato aperto. Aprilo, fai clic su Accetta per la licenza e lascia che installi i componenti aggiuntivi. Quando Xcode mostra la finestra di benvenuto, puoi chiuderlo e tornare qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcodeはインストールされていますが、まだ開かれていません。開いて使用許諾契約の「同意する」をクリックし、追加のコンポーネントをインストールさせてください。Xcodeのようこそウインドウが表示されたら、Xcodeを終了してここに戻れます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode ត្រូវបានដំឡើងហើយ ប៉ុន្តែមិនទាន់ត្រូវបានបើកនៅឡើយទេ។ សូមបើកវា ចុច Agree លើអាជ្ញាប័ណ្ណ ហើយទុកឱ្យវាដំឡើងផ្នែកបន្ថែមរបស់វា។ ពេល Xcode បង្ហាញបង្អួចស្វាគមន៍ អ្នកអាចបិទវា ហើយត្រឡប់មកទីនេះវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode가 설치되었지만 아직 열리지 않았습니다. Xcode를 열고 라이선스에서 동의를 클릭한 다음 추가 구성 요소를 설치하게 두세요. Xcode에 시작 윈도우가 나타나면 종료하고 여기로 돌아오면 됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode er installert, men har ikke blitt åpnet ennå. Åpne det, klikk Godta på lisensen, og la det installere de ekstra delene. Når Xcode viser velkomstvinduet, kan du avslutte det og komme tilbake hit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode jest zainstalowany, ale nie był jeszcze otwierany. Otwórz go, kliknij Zgadzam się przy licencji i pozwól mu zainstalować dodatkowe składniki. Gdy Xcode pokaże okno powitalne, możesz go zamknąć i wrócić tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Xcode está instalado, mas ainda não foi aberto. Abra-o, clique em Concordo na licença e deixe-o instalar os componentes extras. Quando o Xcode mostrar a janela de boas-vindas, você pode encerrá-lo e voltar aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode установлен, но ещё не открывался. Откройте его, нажмите «Принять» в окне лицензии и дайте ему установить дополнительные компоненты. Когда Xcode покажет окно приветствия, можно закрыть его и вернуться сюда."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ติดตั้ง Xcode แล้วแต่ยังไม่เคยเปิด เปิด Xcode คลิก ยอมรับ ในหน้าสัญญาอนุญาต แล้วรอให้ติดตั้งส่วนเสริม เมื่อ Xcode แสดงหน้าต่างต้อนรับ คุณสามารถปิดแอปแล้วกลับมาที่นี่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode yüklü ancak henüz açılmadı. Açın, lisansta Kabul Et'e tıklayın ve ek parçalarını yüklemesine izin verin. Xcode karşılama penceresini gösterdiğinde ondan çıkıp buraya dönebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode встановлено, але ще не відкривали. Відкрийте його, натисніть «Погоджуюсь» у ліцензії та дайте йому встановити додаткові компоненти. Коли Xcode покаже вікно привітання, можна закрити його й повернутися сюди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode đã được cài đặt nhưng chưa được mở. Hãy mở nó, bấm Đồng ý với giấy phép và để nó cài đặt các thành phần bổ sung. Khi Xcode hiện cửa sổ chào mừng, bạn có thể thoát và quay lại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode 已安装，但尚未打开过。请打开它，在许可协议上点按“同意”，并让它安装额外组件。当 Xcode 显示欢迎窗口时，你就可以退出它并回到这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode 已安裝，但尚未打開過。請打開它，在授權合約上按一下「同意」，並讓它安裝額外元件。當 Xcode 顯示歡迎視窗時，你就可以結束它並回到這裡。"
          }
        }
      }
    },
