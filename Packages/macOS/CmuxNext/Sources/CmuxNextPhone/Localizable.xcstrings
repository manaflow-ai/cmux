    "phone.noPhones": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا توجد هواتف. أضف محاكي iOS في Xcode أو محاكي Android في Android Studio."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nema telefona. Dodajte iOS simulator u Xcodeu ili Android emulator u Android Studiju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen telefoner. Tilføj en iOS-simulator i Xcode eller en Android-emulator i Android Studio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keine Telefone. Füge in Xcode einen iOS-Simulator oder in Android Studio einen Android-Emulator hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No phones. Add an iOS simulator in Xcode or an Android emulator in Android Studio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No hay teléfonos. Añade un simulador de iOS en Xcode o un emulador de Android en Android Studio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun téléphone. Ajoutez un simulateur iOS dans Xcode ou un émulateur Android dans Android Studio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessun telefono. Aggiungi un simulatore iOS in Xcode o un emulatore Android in Android Studio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "電話がありません。XcodeでiOSシミュレータを、Android StudioでAndroidエミュレータを追加してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្មានទូរស័ព្ទទេ។ បន្ថែម iOS simulator ក្នុង Xcode ឬ Android emulator ក្នុង Android Studio។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "전화가 없습니다. Xcode에서 iOS 시뮬레이터를, Android Studio에서 Android 에뮬레이터를 추가하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen telefoner. Legg til en iOS-simulator i Xcode eller en Android-emulator i Android Studio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brak telefonów. Dodaj symulator iOS w Xcode lub emulator Androida w Android Studio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhum telefone. Adicione um simulador iOS no Xcode ou um emulador Android no Android Studio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Нет телефонов. Добавьте симулятор iOS в Xcode или эмулятор Android в Android Studio."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่มีโทรศัพท์ เพิ่มเครื่องจำลอง iOS ใน Xcode หรือเครื่องจำลอง Android ใน Android Studio"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Telefon yok. Xcode’da bir iOS simülatörü veya Android Studio’da bir Android emülatörü ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Немає телефонів. Додайте симулятор iOS у Xcode або емулятор Android в Android Studio."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không có điện thoại. Thêm trình mô phỏng iOS trong Xcode hoặc trình giả lập Android trong Android Studio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "没有手机。请在 Xcode 中添加 iOS 模拟器，或在 Android Studio 中添加 Android 模拟器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "沒有手機。請在 Xcode 中加入 iOS 模擬器，或在 Android Studio 中加入 Android 模擬器。"
          }
        }
      }
