    "phone.setup.androidNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هل تصنع تطبيق Android؟ ثبّت Android Studio وأنشئ محاكيًا. سيظهر هنا أيضًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pravite Android aplikaciju? Instalirajte Android Studio i napravite emulator. I on će se prikazati ovdje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laver du en Android-app? Installer Android Studio, og opret en emulator. Den vises også her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du entwickelst eine Android-App? Installiere Android Studio und erstelle einen Emulator. Er erscheint dann auch hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Making an Android app? Install Android Studio and create an emulator. It shows up here too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Estás creando una app para Android? Instala Android Studio y crea un emulador. También aparecerá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous créez une app Android ? Installez Android Studio et créez un émulateur. Il apparaîtra aussi ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stai creando un’app Android? Installa Android Studio e crea un emulatore. Apparirà anche qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Androidアプリを作っていますか?Android Studioをインストールしてエミュレータを作成してください。ここにも表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កំពុងបង្កើតកម្មវិធី Android មែនទេ? សូមដំឡើង Android Studio ហើយបង្កើតកម្មវិធីត្រាប់។ វាក៏នឹងបង្ហាញនៅទីនេះដែរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Android 앱을 만들고 있나요? Android Studio를 설치하고 에뮬레이터를 만드세요. 여기에도 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lager du en Android-app? Installer Android Studio og lag en emulator. Den vises her også."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tworzysz aplikację na Android? Zainstaluj Android Studio i utwórz emulator. Pojawi się on też tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Criando um app Android? Instale o Android Studio e crie um emulador. Ele também aparece aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Создаёте приложение для Android? Установите Android Studio и создайте эмулятор. Он тоже появится здесь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "กำลังสร้างแอป Android อยู่ใช่ไหม ติดตั้ง Android Studio แล้วสร้างอีมูเลเตอร์ ซึ่งจะแสดงที่นี่ด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Android uygulaması mı geliştiriyorsunuz? Android Studio'yu yükleyip bir emülatör oluşturun. O da burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Створюєте програму для Android? Встановіть Android Studio і створіть емулятор. Він теж з'явиться тут."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bạn đang làm ứng dụng Android? Hãy cài đặt Android Studio và tạo một trình giả lập. Nó cũng sẽ hiển thị ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在制作 Android App？请安装 Android Studio 并创建一个模拟器。它也会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在製作 Android App？請安裝 Android Studio 並建立一個模擬器。它也會顯示在這裡。"
          }
        }
      }
    },
    "phone.setup.autoCheck": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتحقّق cmux مرة أخرى تلقائيًا عند عودتك إلى هذه النافذة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux sam ponovo provjerava kada se vratite u ovaj prozor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux tjekker selv igen, når du vender tilbage til dette vindue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux prüft automatisch erneut, wenn du zu diesem Fenster zurückkehrst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux checks again on its own when you come back to this window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux vuelve a comprobar automáticamente cuando regresas a esta ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux vérifie à nouveau automatiquement quand vous revenez à cette fenêtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux controlla di nuovo automaticamente quando torni a questa finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このウインドウに戻ると、cmuxが自動的にもう一度確認します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux នឹងពិនិត្យម្តងទៀតដោយស្វ័យប្រវត្តិ ពេលអ្នកត្រឡប់មកបង្អួចនេះវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 윈도우로 돌아오면 cmux가 자동으로 다시 확인합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux sjekker igjen av seg selv når du kommer tilbake til dette vinduet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux sprawdzi ponownie automatycznie, gdy wrócisz do tego okna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cmux verifica novamente sozinho quando você volta para esta janela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux проверит снова сам, когда вы вернётесь в это окно."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux จะตรวจสอบอีกครั้งเองเมื่อคุณกลับมาที่หน้าต่างนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu pencereye geri döndüğünüzde cmux kendiliğinden tekrar kontrol eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux автоматично перевірить ще раз, коли ви повернетеся до цього вікна."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux sẽ tự kiểm tra lại khi bạn quay lại cửa sổ này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "当你回到此窗口时，cmux 会自动再次检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "當你回到此視窗時，cmux 會自動再次檢查。"
          }
        }
      }
    },
