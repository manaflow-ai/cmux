    "phone.unavailableHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحتاج هذا المحاكي إلى إصدار iOS غير مثبّت. اختر هاتفًا آخر، أو أضفه في Xcode > الإعدادات > المكونات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovaj simulator treba verziju iOS-a koja nije instalirana. Odaberite drugi telefon ili je dodajte u Xcode > Postavke > Komponente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne simulator kræver en iOS-version, der ikke er installeret. Vælg en anden telefon, eller tilføj den i Xcode > Indstillinger > Komponenter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Simulator braucht eine iOS-Version, die nicht installiert ist. Wähle ein anderes Telefon oder füge sie in Xcode > Einstellungen > Komponenten hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This simulator needs an iOS version that is not installed. Pick another phone, or add it in Xcode > Settings > Components."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este simulador necesita una versión de iOS que no está instalada. Elige otro teléfono o añádela en Xcode > Ajustes > Componentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce simulateur a besoin d’une version d’iOS qui n’est pas installée. Choisissez un autre téléphone, ou ajoutez-la dans Xcode > Réglages > Composants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo simulatore richiede una versione di iOS non installata. Scegli un altro telefono, oppure aggiungila in Xcode > Impostazioni > Componenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このシミュレータには、インストールされていないiOSバージョンが必要です。別の電話を選ぶか、Xcode > 設定 > コンポーネントで追加してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កម្មវិធីក្លែងនេះត្រូវការកំណែ iOS ដែលមិនទាន់បានដំឡើង។ សូមជ្រើសទូរសព្ទផ្សេង ឬបន្ថែមវានៅក្នុង Xcode > Settings > Components។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 시뮬레이터에는 설치되지 않은 iOS 버전이 필요합니다. 다른 전화를 선택하거나 Xcode > 설정 > 구성 요소에서 추가하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne simulatoren trenger en iOS-versjon som ikke er installert. Velg en annen telefon, eller legg den til i Xcode > Innstillinger > Komponenter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten symulator wymaga wersji iOS, która nie jest zainstalowana. Wybierz inny telefon lub dodaj ją w Xcode > Ustawienia > Komponenty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este simulador precisa de uma versão do iOS que não está instalada. Escolha outro telefone ou adicione-a em Xcode > Ajustes > Componentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этому симулятору нужна версия iOS, которая не установлена. Выберите другой телефон или добавьте её в Xcode > Настройки > Компоненты."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เครื่องจำลองนี้ต้องใช้ iOS เวอร์ชันที่ยังไม่ได้ติดตั้ง เลือกโทรศัพท์เครื่องอื่น หรือเพิ่มได้ใน Xcode > การตั้งค่า > ส่วนประกอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu simülatör, yüklü olmayan bir iOS sürümüne ihtiyaç duyuyor. Başka bir telefon seçin veya Xcode > Ayarlar > Bileşenler bölümünden ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цьому симулятору потрібна версія iOS, яку не встановлено. Виберіть інший телефон або додайте її в Xcode > Параметри > Компоненти."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trình mô phỏng này cần một phiên bản iOS chưa được cài đặt. Hãy chọn điện thoại khác, hoặc thêm phiên bản đó trong Xcode > Cài đặt > Thành phần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此模拟器需要尚未安装的 iOS 版本。请选择其他手机，或在 Xcode > 设置 > 组件中添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此模擬器需要尚未安裝的 iOS 版本。請選擇其他手機，或在 Xcode > 設定 > 元件中加入。"
          }
        }
      }
    }
  },
  "version": "1.0"
