        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La version d’iOS de ce simulateur n’est pas installée. Choisissez un autre téléphone, ou téléchargez-la."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La versione di iOS di questo simulatore non è installata. Scegli un altro telefono, oppure scaricala."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このシミュレータのiOSバージョンがインストールされていません。別の電話を選ぶか、ダウンロードしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កំណែ iOS របស់កម្មវិធីក្លែងនេះមិនទាន់បានដំឡើងទេ។ សូមជ្រើសទូរសព្ទផ្សេង ឬទាញយកវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 시뮬레이터의 iOS 버전이 설치되어 있지 않습니다. 다른 전화를 선택하거나 다운로드하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS-versjonen til denne simulatoren er ikke installert. Velg en annen telefon, eller last den ned."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wersja iOS tego symulatora nie jest zainstalowana. Wybierz inny telefon lub ją pobierz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A versão do iOS deste simulador não está instalada. Escolha outro telefone ou baixe-a."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Версия iOS для этого симулятора не установлена. Выберите другой телефон или скачайте её."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังไม่ได้ติดตั้ง iOS เวอร์ชันของเครื่องจำลองนี้ เลือกโทรศัพท์เครื่องอื่น หรือดาวน์โหลด"
