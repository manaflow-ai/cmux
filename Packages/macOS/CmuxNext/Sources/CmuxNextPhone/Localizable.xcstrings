    "phone.setup.installXcode.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعرض cmux محاكيات iPhone من Xcode، تطبيق Apple المجاني لصنع تطبيقات iPhone. احصل عليه من Mac App Store. التنزيل كبير (حوالي 3 GB، ويحتاج إلى حوالي 15 GB من مساحة القرص)، لذا قد يستغرق 30 دقيقة أو أكثر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux prikazuje iPhone simulatore iz Xcodea, besplatne Apple aplikacije za izradu iPhone aplikacija. Preuzmite ga iz Mac App Storea. Preuzimanje je veliko (oko 3 GB, a treba oko 15 GB prostora na disku), pa može potrajati 30 minuta ili više."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux viser iPhone-simulatorer fra Xcode, Apples gratis app til at lave iPhone-apps. Hent det i Mac App Store. Det er en stor overførsel (ca. 3 GB, og det kræver ca. 15 GB diskplads), så det kan tage 30 minutter eller mere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux zeigt iPhone-Simulatoren aus Xcode, der kostenlosen App von Apple zum Erstellen von iPhone-Apps. Lade es aus dem Mac App Store. Der Download ist groß (etwa 3 GB, und es braucht etwa 15 GB Speicherplatz), daher kann er 30 Minuten oder länger dauern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux shows iPhone simulators from Xcode, Apple's free app for making iPhone apps. Get it from the Mac App Store. It is a big download (about 3 GB, and it needs about 15 GB of disk space), so it can take 30 minutes or more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux muestra simuladores de iPhone de Xcode, la app gratuita de Apple para crear apps de iPhone. Consíguelo en el Mac App Store. Es una descarga grande (unos 3 GB, y necesita unos 15 GB de espacio en disco), así que puede tardar 30 minutos o más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux affiche les simulateurs iPhone de Xcode, l’app gratuite d’Apple pour créer des apps iPhone. Téléchargez-la sur le Mac App Store. Le téléchargement est volumineux (environ 3 Go, et il faut environ 15 Go d’espace disque), il peut donc prendre 30 minutes ou plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux mostra i simulatori iPhone di Xcode, l’app gratuita di Apple per creare app per iPhone. Scaricala dal Mac App Store. È un download grande (circa 3 GB, e richiede circa 15 GB di spazio su disco), quindi può richiedere 30 minuti o più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmuxは、iPhoneアプリを作るためのAppleの無料アプリXcodeのiPhoneシミュレータを表示します。Mac App Storeから入手してください。ダウンロードは大きく(約3 GB、ディスクの空き容量が約15 GB必要)、30分以上かかることがあります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux បង្ហាញកម្មវិធីក្លែង iPhone ពី Xcode ដែលជាកម្មវិធីឥតគិតថ្លៃរបស់ Apple សម្រាប់បង្កើតកម្មវិធី iPhone។ សូមយកវាពី Mac App Store។ វាជាការទាញយកធំ (ប្រហែល 3 GB ហើយត្រូវការទំហំថាសប្រហែល 15 GB) ដូច្នេះវាអាចចំណាយពេល 30 នាទី ឬច្រើនជាងនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux는 iPhone 앱을 만드는 Apple의 무료 앱인 Xcode의 iPhone 시뮬레이터를 보여 줍니다. Mac App Store에서 받으세요. 다운로드 용량이 커서(약 3GB, 디스크 공간 약 15GB 필요) 30분 이상 걸릴 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux viser iPhone-simulatorer fra Xcode, Apples gratis app for å lage iPhone-apper. Hent den fra Mac App Store. Det er en stor nedlasting (omtrent 3 GB, og den trenger omtrent 15 GB diskplass), så det kan ta 30 minutter eller mer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux pokazuje symulatory iPhone z Xcode, darmowej aplikacji Apple do tworzenia aplikacji na iPhone. Pobierz ją z Mac App Store. To duże pobieranie (około 3 GB, a potrzeba około 15 GB miejsca na dysku), więc może potrwać 30 minut lub dłużej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cmux mostra simuladores de iPhone do Xcode, o app gratuito da Apple para criar apps de iPhone. Baixe-o na Mac App Store. É um download grande (cerca de 3 GB, e precisa de cerca de 15 GB de espaço em disco), então pode levar 30 minutos ou mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux показывает симуляторы iPhone из Xcode — бесплатного приложения Apple для создания приложений для iPhone. Скачайте его из Mac App Store. Это большая загрузка (около 3 ГБ, и нужно около 15 ГБ места на диске), поэтому она может занять 30 минут или больше."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux แสดงเครื่องจำลอง iPhone จาก Xcode ซึ่งเป็นแอปฟรีของ Apple สำหรับสร้างแอป iPhone ดาวน์โหลดได้จาก Mac App Store ไฟล์มีขนาดใหญ่ (ประมาณ 3 GB และต้องใช้พื้นที่ดิสก์ประมาณ 15 GB) จึงอาจใช้เวลา 30 นาทีหรือนานกว่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux, iPhone simülatörlerini Apple'ın iPhone uygulamaları geliştirmek için sunduğu ücretsiz uygulama Xcode'dan gösterir. Mac App Store'dan edinin. Büyük bir indirmedir (yaklaşık 3 GB ve yaklaşık 15 GB disk alanı gerektirir), bu yüzden 30 dakika veya daha uzun sürebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux показує симулятори iPhone із Xcode — безкоштовної програми Apple для створення програм для iPhone. Завантажте її з Mac App Store. Це велике завантаження (близько 3 ГБ, і потрібно близько 15 ГБ місця на диску), тож воно може тривати 30 хвилин або довше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux hiển thị trình mô phỏng iPhone từ Xcode, ứng dụng miễn phí của Apple để tạo ứng dụng iPhone. Hãy tải từ Mac App Store. Đây là bản tải xuống lớn (khoảng 3 GB và cần khoảng 15 GB dung lượng ổ đĩa), nên có thể mất 30 phút hoặc lâu hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 显示来自 Xcode 的 iPhone 模拟器。Xcode 是 Apple 用于制作 iPhone App 的免费 App，可从 Mac App Store 获取。它的下载量很大（约 3 GB，并需要约 15 GB 磁盘空间），因此可能需要 30 分钟或更长时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 顯示來自 Xcode 的 iPhone 模擬器。Xcode 是 Apple 用於製作 iPhone App 的免費 App，可從 Mac App Store 取得。它的下載量很大（約 3 GB，並需要約 15 GB 磁碟空間），因此可能需要 30 分鐘或更久。"
          }
        }
      }
    },
