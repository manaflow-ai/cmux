    "phone.error.runtimeMissing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إصدار iOS الخاص بهذا المحاكي غير مثبّت. اختر هاتفًا آخر، أو نزّله."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verzija iOS-a za ovaj simulator nije instalirana. Odaberite drugi telefon ili je preuzmite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne simulators iOS-version er ikke installeret. Vælg en anden telefon, eller hent den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die iOS-Version dieses Simulators ist nicht installiert. Wähle ein anderes Telefon oder lade sie herunter."
          }
