    "phone.setup.commandLineToolsNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحتوي هذا الـ Mac على أدوات سطر الأوامر من Apple، لكنها لا تتضمن المحاكيات. ما زلت تحتاج إلى تطبيق Xcode الكامل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovaj Mac ima Appleove alate za komandnu liniju, ali oni ne uključuju simulatore. I dalje vam treba puna aplikacija Xcode."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne Mac har Apples kommandolinjeværktøjer, men de indeholder ikke simulatorer. Du skal stadig bruge hele Xcode-appen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Mac hat die Befehlszeilenwerkzeuge von Apple, aber sie enthalten keine Simulatoren. Du brauchst trotzdem die vollständige Xcode-App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac has Apple's command line tools, but they do not include simulators. You still need the full Xcode app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este Mac tiene las herramientas de línea de comandos de Apple, pero no incluyen simuladores. Aún necesitas la app completa de Xcode."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce Mac dispose des outils en ligne de commande d’Apple, mais ils n’incluent pas les simulateurs. Vous avez quand même besoin de l’app Xcode complète."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo Mac ha gli strumenti da riga di comando di Apple, ma non includono i simulatori. Ti serve comunque l’app Xcode completa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このMacにはAppleのコマンドラインツールがありますが、シミュレータは含まれていません。完全なXcodeアプリが必要です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac នេះមានឧបករណ៍បន្ទាត់ពាក្យបញ្ជារបស់ Apple ប៉ុន្តែវាមិនមានកម្មវិធីក្លែងទេ។ អ្នកនៅតែត្រូវការកម្មវិធី Xcode ពេញលេញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 Mac에는 Apple의 명령줄 도구가 있지만 시뮬레이터는 포함되어 있지 않습니다. 전체 Xcode 앱이 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne Mac-en har Apples kommandolinjeverktøy, men de inneholder ikke simulatorer. Du trenger fortsatt hele Xcode-appen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten Mac ma narzędzia wiersza poleceń Apple, ale nie zawierają one symulatorów. Nadal potrzebujesz pełnej aplikacji Xcode."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este Mac tem as ferramentas de linha de comando da Apple, mas elas não incluem simuladores. Você ainda precisa do app Xcode completo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На этом Mac есть инструменты командной строки Apple, но в них нет симуляторов. Вам всё равно нужно полное приложение Xcode."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac เครื่องนี้มีเครื่องมือบรรทัดคำสั่งของ Apple แต่ไม่มีเครื่องจำลองรวมอยู่ด้วย คุณยังต้องใช้แอป Xcode แบบเต็ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu Mac'te Apple'ın komut satırı araçları var ancak bunlar simülatörleri içermez. Yine de tam Xcode uygulamasına ihtiyacınız var."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На цьому Mac є інструменти командного рядка Apple, але вони не містять симуляторів. Вам усе одно потрібна повна програма Xcode."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Máy Mac này có công cụ dòng lệnh của Apple, nhưng chúng không bao gồm trình mô phỏng. Bạn vẫn cần ứng dụng Xcode đầy đủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这台 Mac 已有 Apple 的命令行工具，但其中不包含模拟器。你仍然需要完整的 Xcode App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這台 Mac 已有 Apple 的命令列工具，但其中不包含模擬器。你仍然需要完整的 Xcode App。"
          }
        }
      }
    },
    "phone.setup.create.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تم تثبيت كل شيء. أنشئ iPhone محاكيًا لعرضه هنا. يعمل على الـ Mac، لذا لا تحتاج إلى هاتف حقيقي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sve je instalirano. Napravite simulirani iPhone koji će se prikazati ovdje. Radi na vašem Macu, pa vam ne treba pravi telefon."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alt er installeret. Opret en simuleret iPhone, der vises her. Den kører på din Mac, så du behøver ikke en rigtig telefon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alles ist installiert. Erstelle ein simuliertes iPhone, das hier angezeigt wird. Es läuft auf deinem Mac, du brauchst also kein echtes Telefon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is installed. Create a simulated iPhone to show here. It runs on your Mac, so you do not need a real phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todo está instalado. Crea un iPhone simulado para mostrarlo aquí. Funciona en tu Mac, así que no necesitas un teléfono real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tout est installé. Créez un iPhone simulé à afficher ici. Il fonctionne sur votre Mac, vous n’avez donc pas besoin d’un vrai téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "È tutto installato. Crea un iPhone simulato da mostrare qui. Funziona sul tuo Mac, quindi non ti serve un telefono vero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "すべてインストールされました。ここに表示するシミュレートされたiPhoneを作成しましょう。Mac上で動くので、本物の電話は必要ありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អ្វីៗទាំងអស់ត្រូវបានដំឡើងហើយ។ សូមបង្កើត iPhone ក្លែងដើម្បីបង្ហាញនៅទីនេះ។ វាដំណើរការលើ Mac របស់អ្នក ដូច្នេះអ្នកមិនត្រូវការទូរសព្ទពិតទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "모든 것이 설치되었습니다. 여기에 표시할 시뮬레이션 iPhone을 만드세요. Mac에서 실행되므로 실제 전화가 필요 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alt er installert. Lag en simulert iPhone som vises her. Den kjører på Mac-en din, så du trenger ikke en ekte telefon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wszystko jest zainstalowane. Utwórz symulowany iPhone, który pojawi się tutaj. Działa on na Twoim Macu, więc nie potrzebujesz prawdziwego telefonu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tudo está instalado. Crie um iPhone simulado para mostrar aqui. Ele roda no seu Mac, então você não precisa de um telefone real."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Всё установлено. Создайте симулированный iPhone, чтобы он появился здесь. Он работает на вашем Mac, поэтому настоящий телефон не нужен."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ติดตั้งครบแล้ว สร้าง iPhone จำลองเพื่อแสดงที่นี่ โดยจะทำงานบน Mac ของคุณ จึงไม่ต้องใช้โทรศัพท์จริง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her şey yüklendi. Burada göstermek için simüle edilmiş bir iPhone oluşturun. Mac'inizde çalışır, bu yüzden gerçek bir telefona ihtiyacınız yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Усе встановлено. Створіть симульований iPhone, щоб показати його тут. Він працює на вашому Mac, тож справжній телефон не потрібен."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mọi thứ đã được cài đặt. Hãy tạo một iPhone mô phỏng để hiển thị ở đây. Nó chạy trên máy Mac của bạn, nên bạn không cần điện thoại thật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "一切已安装完毕。创建一台模拟 iPhone 在这里显示。它在你的 Mac 上运行，因此你不需要真实的手机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "一切已安裝完畢。建立一支模擬 iPhone 在這裡顯示。它在你的 Mac 上執行，因此你不需要真實的手機。"
          }
        }
      }
    },
