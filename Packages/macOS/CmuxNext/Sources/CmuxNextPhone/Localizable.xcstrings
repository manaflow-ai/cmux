    "phone.error.diskFull": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا توجد مساحة كافية على قرص الـ Mac. أفرغ بعض المساحة، ثم حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vaš Mac nema dovoljno slobodnog prostora na disku. Oslobodite malo prostora, pa pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Din Mac har ikke nok ledig diskplads. Frigør noget plads, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Mac hat nicht genug freien Speicherplatz. Gib etwas Speicher frei und versuche es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac does not have enough free disk space. Free some space, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu Mac no tiene suficiente espacio libre en disco. Libera algo de espacio e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre Mac n’a pas assez d’espace disque libre. Libérez de l’espace, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il Mac non ha abbastanza spazio libero su disco. Libera spazio, quindi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Macのディスクの空き容量が足りません。空き容量を増やしてから、もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac របស់អ្នកមិនមានទំហំថាសទំនេរគ្រប់គ្រាន់ទេ។ សូមសម្អាតទំហំខ្លះ រួចព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac에 사용 가능한 디스크 공간이 부족합니다. 공간을 확보한 다음 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac-en din har ikke nok ledig diskplass. Frigjør plass, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na Twoim Macu brakuje wolnego miejsca na dysku. Zwolnij miejsce i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seu Mac não tem espaço livre suficiente em disco. Libere espaço e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На вашем Mac недостаточно свободного места. Освободите место и попробуйте снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac ของคุณมีพื้นที่ดิสก์ว่างไม่พอ โปรดเพิ่มพื้นที่ว่าง แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac'inizde yeterli boş disk alanı yok. Biraz yer açıp tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На вашому Mac недостатньо вільного місця на диску. Звільніть місце й спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Máy Mac của bạn không đủ dung lượng trống. Hãy giải phóng bớt dung lượng rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的 Mac 没有足够的可用磁盘空间。请释放一些空间，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的 Mac 沒有足夠的可用磁碟空間。請釋放一些空間，然後再試一次。"
          }
        }
      }
    },
    "phone.error.generic": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "حدث خطأ ما. حاول مرة أخرى. إذا استمر ذلك، فسجّله وأرسله إلى Chief."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nešto nije uspjelo. Pokušajte ponovo. Ako se nastavi dešavati, snimite to i pošaljite Chiefu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noget gik galt. Prøv igen. Hvis det bliver ved, så optag det og send det til Chief."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Etwas ist schiefgelaufen. Versuche es erneut. Wenn es weiter passiert, nimm es auf und sende es an Chief."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Try again. If it keeps happening, record it and send it to Chief."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Algo salió mal. Inténtalo de nuevo. Si sigue pasando, grábalo y envíaselo a Chief."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une erreur s’est produite. Réessayez. Si le problème continue, enregistrez-le et envoyez-le à Chief."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si è verificato un problema. Riprova. Se continua a succedere, registralo e invialo a Chief."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "問題が発生しました。もう一度お試しください。繰り返し起きる場合は、録画してChiefに送ってください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មានបញ្ហាកើតឡើង។ សូមព្យាយាមម្តងទៀត។ បើវានៅតែកើតឡើង សូមថតវាទុក ហើយផ្ញើទៅ Chief។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "문제가 발생했습니다. 다시 시도하세요. 계속 발생하면 녹화해서 Chief에게 보내세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noe gikk galt. Prøv igjen. Hvis det skjer igjen, ta det opp og send det til Chief."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Coś poszło nie tak. Spróbuj ponownie. Jeśli to się powtarza, nagraj to i wyślij do Chief."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Algo deu errado. Tente novamente. Se continuar acontecendo, grave e envie para o Chief."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Что-то пошло не так. Попробуйте ещё раз. Если ошибка повторяется, запишите её и отправьте в Chief."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เกิดข้อผิดพลาด โปรดลองอีกครั้ง หากยังเกิดขึ้นอีก ให้บันทึกไว้แล้วส่งให้ Chief"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir sorun oluştu. Tekrar deneyin. Sorun devam ederse kaydedip Chief'e gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Щось пішло не так. Спробуйте ще раз. Якщо це повторюється, запишіть це й надішліть Chief."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã xảy ra lỗi. Hãy thử lại. Nếu lỗi vẫn tiếp diễn, hãy ghi lại và gửi cho Chief."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "出了点问题。请重试。如果问题持续出现，请录制下来并发送给 Chief。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "發生問題。請再試一次。如果問題持續發生，請錄製下來並傳送給 Chief。"
          }
        }
      }
    },
    "phone.error.license": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحتاج Xcode إلى موافقتك على ترخيصه. افتح Xcode مرة واحدة وانقر على موافقة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode traži da prihvatite njegovu licencu. Otvorite Xcode jednom i kliknite Prihvati."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode skal have dig til at acceptere licensen. Åbn Xcode én gang, og klik på Accepter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode braucht deine Zustimmung zur Lizenz. Öffne Xcode einmal und klicke auf Zustimmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode needs you to accept its license. Open Xcode once and click Agree."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode necesita que aceptes su licencia. Abre Xcode una vez y haz clic en Aceptar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode a besoin que vous acceptiez sa licence. Ouvrez Xcode une fois et cliquez sur Accepter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode richiede che tu accetti la sua licenza. Apri Xcode una volta e fai clic su Accetta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcodeの使用許諾契約に同意する必要があります。Xcodeを一度開いて「同意する」をクリックしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode ត្រូវការឱ្យអ្នកយល់ព្រមលើអាជ្ញាប័ណ្ណរបស់វា។ សូមបើក Xcode ម្តង ហើយចុច Agree។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode 라이선스에 동의해야 합니다. Xcode를 한 번 열고 동의를 클릭하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode krever at du godtar lisensen. Åpne Xcode én gang og klikk Godta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode wymaga akceptacji licencji. Otwórz Xcode raz i kliknij Zgadzam się."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Xcode precisa que você aceite a licença. Abra o Xcode uma vez e clique em Concordo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Нужно принять лицензию Xcode. Откройте Xcode один раз и нажмите «Принять»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode ต้องให้คุณยอมรับสัญญาอนุญาต เปิด Xcode หนึ่งครั้งแล้วคลิก ยอมรับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode lisansını kabul etmeniz gerekiyor. Xcode'u bir kez açıp Kabul Et'e tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode потребує прийняти його ліцензію. Відкрийте Xcode один раз і натисніть «Погоджуюсь»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode cần bạn chấp nhận giấy phép. Hãy mở Xcode một lần và bấm Đồng ý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode 需要你接受其许可协议。打开 Xcode 一次并点按“同意”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode 需要你接受其授權合約。打開 Xcode 一次並按一下「同意」。"
          }
        }
      }
    },
    "phone.error.needsAndroidStudio": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تحتاج هواتف Android إلى Android Studio. ثبّته وأنشئ محاكيًا، ثم تحقّق مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Android telefoni trebaju Android Studio. Instalirajte ga, napravite emulator, pa provjerite ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Android-telefoner kræver Android Studio. Installer det, opret en emulator, og tjek derefter igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Android-Telefone brauchen Android Studio. Installiere es, erstelle einen Emulator und prüfe dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android phones need Android Studio. Install it, create an emulator, then check again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los teléfonos Android necesitan Android Studio. Instálalo, crea un emulador y vuelve a comprobar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les téléphones Android ont besoin d’Android Studio. Installez-le, créez un émulateur, puis vérifiez à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I telefoni Android richiedono Android Studio. Installalo, crea un emulatore, quindi controlla di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
