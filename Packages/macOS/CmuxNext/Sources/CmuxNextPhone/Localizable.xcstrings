    "phone.setup.download.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode جاهز، لكن محاكي iPhone تنزيل منفصل بحجم حوالي 8 GB. يمكن لـ cmux تنزيله لك. يمكنك مواصلة العمل أثناء التنزيل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode je spreman, ali iPhone simulator je zasebno preuzimanje od oko 8 GB. cmux ga može preuzeti umjesto vas. Možete nastaviti raditi dok se preuzima."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode er klar, men iPhone-simulatoren er en separat overførsel på ca. 8 GB. cmux kan hente den for dig. Du kan arbejde videre, mens den hentes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode ist bereit, aber der iPhone-Simulator ist ein separater Download von etwa 8 GB. cmux kann ihn für dich herunterladen. Du kannst weiterarbeiten, während er geladen wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode is ready, but the iPhone simulator is a separate download of about 8 GB. cmux can download it for you. You can keep working while it downloads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode está listo, pero el simulador de iPhone es una descarga aparte de unos 8 GB. cmux puede descargarlo por ti. Puedes seguir trabajando mientras se descarga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode est prêt, mais le simulateur iPhone est un téléchargement séparé d’environ 8 Go. cmux peut le télécharger pour vous. Vous pouvez continuer à travailler pendant le téléchargement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode è pronto, ma il simulatore iPhone è un download separato di circa 8 GB. cmux può scaricarlo per te. Puoi continuare a lavorare durante il download."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcodeの準備はできていますが、iPhoneシミュレータは約8 GBの別のダウンロードです。cmuxが代わりにダウンロードできます。ダウンロード中も作業を続けられます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode រួចរាល់ហើយ ប៉ុន្តែកម្មវិធីក្លែង iPhone គឺជាការទាញយកដាច់ដោយឡែកប្រហែល 8 GB។ cmux អាចទាញយកវាឱ្យអ្នក។ អ្នកអាចបន្តធ្វើការខណៈពេលកំពុងទាញយក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode는 준비되었지만 iPhone 시뮬레이터는 약 8GB의 별도 다운로드입니다. cmux가 대신 다운로드할 수 있습니다. 다운로드하는 동안 계속 작업할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode er klart, men iPhone-simulatoren er en egen nedlasting på omtrent 8 GB. cmux kan laste den ned for deg. Du kan fortsette å jobbe mens den lastes ned."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode jest gotowy, ale symulator iPhone to osobne pobieranie o rozmiarze około 8 GB. cmux może go pobrać za Ciebie. Możesz dalej pracować podczas pobierania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Xcode está pronto, mas o simulador de iPhone é um download separado de cerca de 8 GB. O cmux pode baixá-lo para você. Você pode continuar trabalhando enquanto ele é baixado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode готов, но симулятор iPhone скачивается отдельно, около 8 ГБ. cmux может скачать его за вас. Вы можете продолжать работать во время загрузки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode พร้อมแล้ว แต่เครื่องจำลอง iPhone ต้องดาวน์โหลดแยกต่างหาก ขนาดประมาณ 8 GB cmux ดาวน์โหลดให้คุณได้ และคุณทำงานต่อได้ระหว่างดาวน์โหลด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode hazır, ancak iPhone simülatörü yaklaşık 8 GB'lık ayrı bir indirmedir. cmux bunu sizin için indirebilir. İndirme sürerken çalışmaya devam edebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode готовий, але симулятор iPhone — це окреме завантаження розміром близько 8 ГБ. cmux може завантажити його для вас. Ви можете працювати далі, поки триває завантаження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode đã sẵn sàng, nhưng trình mô phỏng iPhone là một bản tải xuống riêng khoảng 8 GB. cmux có thể tải xuống giúp bạn. Bạn vẫn có thể tiếp tục làm việc trong khi tải."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode 已就绪，但 iPhone 模拟器需要单独下载，约 8 GB。cmux 可以为你下载。下载期间你可以继续工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xcode 已就緒，但 iPhone 模擬器需要另外下載，約 8 GB。cmux 可以為你下載。下載期間你可以繼續工作。"
          }
        }
      }
    },
