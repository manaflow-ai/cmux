    "phone.error.alreadyRecording": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يوجد تسجيل قيد التشغيل بالفعل. أوقفه أولًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Snimanje je već u toku. Prvo ga zaustavite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En optagelse er allerede i gang. Stop den først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Aufnahme läuft bereits. Beende sie zuerst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A recording is already running. Stop it first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ya hay una grabación en curso. Detenla primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un enregistrement est déjà en cours. Arrêtez-le d’abord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "È già in corso una registrazione. Interrompila prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "録画はすでに実行中です。先に停止してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មានការថតកំពុងដំណើរការរួចហើយ។ សូមបញ្ឈប់វាជាមុនសិន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이미 녹화가 진행 중입니다. 먼저 중지하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et opptak pågår allerede. Stopp det først."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nagrywanie już trwa. Najpierw je zatrzymaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma gravação já está em andamento. Pare-a primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запись уже идёт. Сначала остановите её."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "มีการบันทึกอยู่แล้ว โปรดหยุดก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zaten bir kayıt devam ediyor. Önce onu durdurun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запис уже виконується. Спершу зупиніть його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đang có một bản ghi chạy. Hãy dừng nó trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
