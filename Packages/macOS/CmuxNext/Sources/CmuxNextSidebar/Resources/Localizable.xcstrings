    "sidebar.a11y.pullRequestCard.row": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@، %2$@، %3$@، %4$lld سطرًا مضافًا، %5$lld سطرًا محذوفًا"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, %3$@, dodano redova: %4$lld, uklonjeno redova: %5$lld"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, %3$@, %4$lld linjer tilføjet, %5$lld linjer fjernet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, %3$@, %4$lld Zeilen hinzugefügt, %5$lld Zeilen entfernt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, %3$@, %4$lld lines added, %5$lld lines removed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, %3$@, %4$lld líneas añadidas, %5$lld líneas eliminadas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, %3$@, %4$lld lignes ajoutées, %5$lld lignes supprimées"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, %3$@, %4$lld righe aggiunte, %5$lld righe rimosse"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@、%2$@、%3$@、%4$lld 行追加、%5$lld 行削除"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, %3$@, បានបន្ថែម %4$lld បន្ទាត់, បានដក %5$lld បន្ទាត់"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, %3$@, %4$lld줄 추가, %5$lld줄 삭제"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, %3$@, %4$lld linjer lagt til, %5$lld linjer fjernet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, %3$@, dodane wiersze: %4$lld, usunięte wiersze: %5$lld"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, %3$@, %4$lld linhas adicionadas, %5$lld linhas removidas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, %3$@, добавлено строк: %4$lld, удалено строк: %5$lld"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, %3$@, เพิ่ม %4$lld บรรทัด, ลบ %5$lld บรรทัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
