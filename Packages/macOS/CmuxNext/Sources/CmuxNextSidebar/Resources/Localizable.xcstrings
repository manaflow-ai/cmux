    "autoArchive.refusal.nothingIdle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "no workspace is idle long enough to archive"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا توجد مساحة عمل خاملة مدة كافية لأرشفتها"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nijedan radni prostor nije dovoljno dugo neaktivan za arhiviranje"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "intet arbejdsområde har været inaktivt længe nok til at blive arkiveret"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "kein Arbeitsbereich ist lange genug inaktiv, um archiviert zu werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ningún espacio de trabajo lleva inactivo lo suficiente para archivarlo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "aucun espace de travail n’est inactif depuis assez longtemps pour être archivé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nessuno spazio di lavoro è inattivo da abbastanza tempo da archiviarlo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アーカイブできるほど長く使っていないワークスペースはありません"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្មានកន្លែងធ្វើការណាមិនប្រើយូរគ្រប់គ្រាន់ដើម្បីទុកក្នុងប័ណ្ណសារទេ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "보관할 만큼 오래 사용하지 않은 워크스페이스가 없습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ingen arbeidsområder har vært inaktive lenge nok til å arkiveres"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "żaden obszar roboczy nie jest nieaktywny wystarczająco długo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nenhum espaço de trabalho está inativo há tempo suficiente para arquivar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "нет рабочих пространств, неактивных достаточно долго для архивации"
