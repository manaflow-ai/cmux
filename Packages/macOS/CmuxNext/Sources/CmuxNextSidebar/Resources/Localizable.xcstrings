    "sidebar.a11y.needsYou": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاجك: %lld بالانتظار، %lld انتهت ولم تُقرأ"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trebaju te: %lld čeka, %lld završeno i nepročitano"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Har brug for dig: %lld venter, %lld færdige og ulæste"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Braucht dich: %lld warten, %lld fertig und ungelesen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs you: %lld waiting, %lld finished and unread"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te necesitan: %lld esperando, %lld terminadas y sin leer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous attendent : %lld en attente, %lld terminées et non lues"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti aspettano: %lld in attesa, %lld completate e non lette"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応が必要: 待機中 %lld 件、完了・未読 %lld 件"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ត្រូវការអ្នក៖ %lld កំពុងរង់ចាំ, %lld បានបញ្ចប់ និងមិនទាន់អាន"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답 필요: 대기 중 %lld개, 완료되어 읽지 않음 %lld개"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenger deg: %lld venter, %lld ferdige og uleste"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czekają na ciebie: %lld oczekuje, %lld zakończonych i nieprzeczytanych"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisam de você: %lld aguardando, %lld concluídas e não lidas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ждут вас: %lld ожидают, %lld завершены и не прочитаны"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องการคุณ: รออยู่ %lld เสร็จแล้วและยังไม่ได้อ่าน %lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Size ihtiyaç var: %lld bekliyor, %lld bitti ve okunmadı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чекають на вас: %lld очікують, %lld завершені й непрочитані"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần bạn: %lld đang chờ, %lld đã xong và chưa đọc"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要你处理：%lld 个等待中，%lld 个已完成未读"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要你處理：%lld 個等待中，%lld 個已完成未讀"
          }
        }
      }
    },
