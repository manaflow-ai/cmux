    "motionInspector.findings.none": {
      "comment": "Motion Inspector: the scan found no animation outside the motion gates.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد حركة غير مضبوطة على الشاشة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema animacija bez kontrole na ekranu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen animationer uden styring på skærmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine ungesteuerte Animation auf dem Bildschirm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No ungated animation on screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay animaciones sin control en pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune animation hors contrôle à l’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna animazione non controllata sullo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上にゲート外のアニメーションはありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានចលនាដែលគ្មានការគ្រប់គ្រងនៅលើអេក្រង់ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면에 게이트 밖 애니메이션이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen animasjoner uten styring på skjermen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak animacji bez bramki na ekranie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma animação sem controle na tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На экране нет анимаций вне шлюза."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีแอนิเมชันที่ไม่ผ่านเกตบนหน้าจอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranda denetimsiz animasyon yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На екрані немає анімацій поза шлюзом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có hoạt ảnh ngoài cổng trên màn hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕上没有未经门控的动画。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫面上沒有未經閘門的動畫。"
          }
        }
      }
    },
    "motionInspector.findings.notScanned": {
      "comment": "Motion Inspector: shown before the first scan for animations outside the motion gates.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم الفحص بعد: ابدأ الحركة، ثم ابحث عن الحركات غير المضبوطة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nije pretraženo: pokrenite animaciju, zatim pronađite animacije bez kontrole."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke søgt endnu: start animationen, og find derefter animationer uden styring."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht gesucht: Animation starten, dann ungesteuerte Animationen finden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not scanned yet: start the animation, then find ungated animations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se ha buscado: inicia la animación y luego busca animaciones sin control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore analysé : lancez l’animation, puis trouvez les animations hors contrôle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ancora cercato: avvia l’animazione, poi trova le animazioni non controllate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ検索していません。アニメーションを開始してから、ゲート外のアニメーションを探してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនទាន់ស្កេនទេ៖ ចាប់ផ្ដើមចលនា រួចរកចលនាដែលគ្មានការគ្រប់គ្រង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 검색하지 않았습니다. 애니메이션을 시작한 다음 게이트 밖 애니메이션을 찾으세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke søkt ennå: start animasjonen, og finn deretter animasjoner uten styring."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nie przeszukano: uruchom animację, a potem znajdź animacje bez bramki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não verificado: inicie a animação e depois encontre animações sem controle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск ещё не выполнен: запустите анимацию, затем найдите анимации вне шлюза."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้สแกน: เริ่มแอนิเมชัน แล้วค้นหาแอนิเมชันที่ไม่ผ่านเกต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz taranmadı: animasyonu başlatın, ardından denetimsiz animasyonları bulun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошук ще не виконано: запустіть анімацію, потім знайдіть анімації поза шлюзом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa quét: hãy bắt đầu hoạt ảnh, rồi tìm hoạt ảnh ngoài cổng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未扫描：先开始动画，再查找未经门控的动画。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未掃描：先開始動畫，再尋找未經閘門的動畫。"
          }
        }
      }
    },
    "motionInspector.footer": {
      "comment": "Motion Inspector footer: running animations of all seen, then the inspector's own main-thread cost per frame (median and 95th percentile) and per animation start, in milliseconds.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d قيد التشغيل من %2$d. تكلفة الفاحص لكل إطار: p50 %3$.3f مللي ثانية، p95 %4$.3f مللي ثانية؛ لكل بدء %5$.3f مللي ثانية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d radi od %2$d. Trošak inspektora po okviru: p50 %3$.3f ms, p95 %4$.3f ms; po pokretanju %5$.3f ms."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d kører af %2$d. Inspektørens pris pr. billede: p50 %3$.3f ms, p95 %4$.3f ms; pr. start %5$.3f ms."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d von %2$d laufen. Kosten des Inspektors pro Bild: p50 %3$.3f ms, p95 %4$.3f ms; pro Start %5$.3f ms."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d running of %2$d. Inspector cost per frame: p50 %3$.3f ms, p95 %4$.3f ms; per start %5$.3f ms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d en curso de %2$d. Coste del inspector por fotograma: p50 %3$.3f ms, p95 %4$.3f ms; por inicio %5$.3f ms."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d en cours sur %2$d. Coût de l’inspecteur par image : p50 %3$.3f ms, p95 %4$.3f ms ; par démarrage %5$.3f ms."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d in corso su %2$d. Costo dell’ispettore per fotogramma: p50 %3$.3f ms, p95 %4$.3f ms; per avvio %5$.3f ms."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$d 件中 %1$d 件が実行中。インスペクタのフレームあたりのコスト: p50 %3$.3f ms、p95 %4$.3f ms。開始あたり %5$.3f ms。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d កំពុងដំណើរការ ក្នុងចំណោម %2$d។ តម្លៃកម្មវិធីពិនិត្យក្នុងមួយស៊ុម៖ p50 %3$.3f ms, p95 %4$.3f ms; ក្នុងមួយការចាប់ផ្ដើម %5$.3f ms។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$d개 중 %1$d개 실행 중. 검사기 프레임당 비용: p50 %3$.3f ms, p95 %4$.3f ms; 시작당 %5$.3f ms."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d kjører av %2$d. Inspektørens kostnad per bilde: p50 %3$.3f ms, p95 %4$.3f ms; per start %5$.3f ms."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa %1$d z %2$d. Koszt inspektora na klatkę: p50 %3$.3f ms, p95 %4$.3f ms; na start %5$.3f ms."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d em execução de %2$d. Custo do inspetor por quadro: p50 %3$.3f ms, p95 %4$.3f ms; por início %5$.3f ms."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполняется %1$d из %2$d. Затраты инспектора на кадр: p50 %3$.3f мс, p95 %4$.3f мс; на запуск %5$.3f мс."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังทำงาน %1$d จาก %2$d ต้นทุนของตัวตรวจสอบต่อเฟรม: p50 %3$.3f ms, p95 %4$.3f ms; ต่อการเริ่ม %5$.3f ms"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$d içinden %1$d çalışıyor. Denetçinin kare başına maliyeti: p50 %3$.3f ms, p95 %4$.3f ms; başlatma başına %5$.3f ms."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виконується %1$d з %2$d. Витрати інспектора на кадр: p50 %3$.3f мс, p95 %4$.3f мс; на запуск %5$.3f мс."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d đang chạy trong %2$d. Chi phí của trình kiểm tra mỗi khung: p50 %3$.3f ms, p95 %4$.3f ms; mỗi lần bắt đầu %5$.3f ms."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$d 个中有 %1$d 个正在运行。检查器每帧开销：p50 %3$.3f ms，p95 %4$.3f ms；每次启动 %5$.3f ms。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
