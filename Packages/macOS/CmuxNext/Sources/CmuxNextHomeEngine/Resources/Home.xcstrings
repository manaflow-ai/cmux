            "value": "이 Chief를 삭제하기 전에 다른 Chief를 기본값으로 지정하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gjør en annen Chief til standard før du sletter denne."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przed usunięciem tego Chiefa ustaw innego jako domyślnego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Defina outro Chief como padrão antes de excluir este."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перед удалением сделайте основным другого Chief."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ตั้ง Chief อื่นเป็นค่าเริ่มต้นก่อนลบ Chief นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bunu silmeden önce başka bir Chief’i varsayılan yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перед видаленням зробіть основним іншого Chief."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hãy đặt một Chief khác làm mặc định trước khi xóa Chief này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "删除此 Chief 前,请先将另一个 Chief 设为默认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "刪除此 Chief 前,請先將另一個 Chief 設為預設。"
          }
        }
      }
    },
