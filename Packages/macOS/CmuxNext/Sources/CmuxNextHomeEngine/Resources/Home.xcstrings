            "state": "translated",
            "value": "此 Chief 已關閉，因此不會回覆訊息。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Chief 已关闭，因此不会回复消息。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Chief는 꺼져 있어 메시지에 응답하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Chief はオフになっているため、メッセージに返信しません。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj Chief je isključen, pa ne odgovara na poruke."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Chief er slået fra, så den svarer ikke på beskeder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Chief è disattivato, quindi non risponde ai messaggi."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief នេះត្រូវបានបិទ ដូច្នេះវាមិនឆ្លើយតបសារទេ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Chief er slått av, så den svarer ikke på meldinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Chief jest wyłączony, więc nie odpowiada na wiadomości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Chief está desativado, então não responde a mensagens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Chief выключен, поэтому не отвечает на сообщения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief นี้ปิดอยู่ จึงไม่ตอบข้อความ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Chief kapalı, bu yüzden mesajlara yanıt vermiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей Chief вимкнено, тому він не відповідає на повідомлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
