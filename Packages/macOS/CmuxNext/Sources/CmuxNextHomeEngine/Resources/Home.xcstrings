        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កំណត់ Chief ផ្សេងជាលំនាំដើម មុនពេលលុប Chief នេះ។"
          }
        },
        "ko": {
          "stringUnit": {
