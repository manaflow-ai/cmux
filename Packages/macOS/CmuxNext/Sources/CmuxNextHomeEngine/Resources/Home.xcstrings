    "home.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversations need a newer cmux daemon."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تتطلب المحادثات إصدارًا أحدث من خادم cmux."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Razgovori zahtijevaju noviji cmux daemon."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Samtaler kræver en nyere cmux-daemon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
