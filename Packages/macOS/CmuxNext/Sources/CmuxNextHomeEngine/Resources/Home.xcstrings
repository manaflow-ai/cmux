    "home.chief.memoryPaused": {
      "comment": "Home system notice in the Chief conversation while the Chief's memory compactor cannot build summaries (cx-oqnw3).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief memory summaries are paused. The Chief still answers."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملخصات ذاكرة Chief متوقفة مؤقتًا. لا يزال Chief يجيب."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sažeci memorije za Chief su pauzirani. Chief i dalje odgovara."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chiefs hukommelsesresuméer er sat på pause. Chief svarer stadig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gedächtniszusammenfassungen des Chiefs sind pausiert. Der Chief antwortet weiterhin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resúmenes de memoria de Chief están en pausa. Chief sigue respondiendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résumés de mémoire de Chief sont en pause. Chief répond toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I riepiloghi della memoria di Chief sono in pausa. Chief risponde comunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief のメモリ要約は一時停止中です。Chief は引き続き応答します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការសង្ខេបការចងចាំរបស់ Chief ត្រូវបានផ្អាក។ Chief នៅតែឆ្លើយតប។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief 메모리 요약이 일시 중지되었습니다. Chief는 계속 응답합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chiefs minnesammendrag er satt på pause. Chief svarer fortsatt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Podsumowania pamięci Chief są wstrzymane. Chief nadal odpowiada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os resumos de memória do Chief estão pausados. O Chief continua respondendo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сводки памяти Chief приостановлены. Chief по-прежнему отвечает."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การสรุปหน่วยความจำของ Chief หยุดชั่วคราว Chief ยังคงตอบอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief bellek özetleri duraklatıldı. Chief yanıt vermeye devam ediyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Підсумки пам'яті Chief призупинено. Chief і далі відповідає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tóm tắt bộ nhớ của Chief đang tạm dừng. Chief vẫn trả lời."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief 的记忆摘要已暂停。Chief 仍会回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief 的記憶摘要已暫停。Chief 仍會回覆。"
          }
        }
      }
    },
    "home.chief.noReply": {
      "comment": "Home system notice in the Chief conversation when the person's last message has had no reply for some minutes (%lld: minutes, at least 2). The Chief host retries on its own.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No reply from the Chief for %lld min. It retries on its own and tells you if it cannot answer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا رد من Chief منذ %lld د. يعيد المحاولة تلقائيًا ويخبرك إذا تعذّر عليه الرد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nema odgovora od Chiefa već %lld min. Sam ponovo pokušava i javit će vam ako ne može odgovoriti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Intet svar fra Chief i %lld min. Den prøver selv igen og giver dig besked, hvis den ikke kan svare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seit %lld Min. keine Antwort vom Chief. Er versucht es selbst erneut und sagt dir Bescheid, wenn er nicht antworten kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin respuesta del Chief desde hace %lld min. Lo reintenta por su cuenta y te avisa si no puede responder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune réponse du Chief depuis %lld min. Il réessaie de lui-même et vous prévient s’il ne peut pas répondre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessuna risposta dal Chief da %lld min. Riprova da solo e ti avvisa se non riesce a rispondere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief から %lld 分間返信がありません。自動で再試行し、返信できない場合はお知らせします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief មិនបានឆ្លើយតបអស់រយៈពេល %lld នាទីហើយ។ វានឹងព្យាយាមម្ដងទៀតដោយខ្លួនឯង ហើយប្រាប់អ្នកប្រសិនបើវាមិនអាចឆ្លើយបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief가 %lld분 동안 답하지 않았습니다. 자동으로 다시 시도하며, 답할 수 없으면 알려 줍니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ikke noe svar fra Chief på %lld min. Den prøver igjen selv og gir deg beskjed hvis den ikke kan svare."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brak odpowiedzi od Chiefa od %lld min. Sam ponawia próbę i da ci znać, jeśli nie będzie mógł odpowiedzieć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sem resposta do Chief há %lld min. Ele tenta de novo sozinho e avisa você se não conseguir responder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief не отвечает уже %lld мин. Он сам повторяет попытку и сообщит вам, если не сможет ответить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief ไม่ได้ตอบกลับมา %lld นาทีแล้ว Chief จะลองใหม่เองและแจ้งให้คุณทราบหากตอบไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief %lld dakikadır yanıt vermedi. Kendisi yeniden deniyor ve yanıt veremezse size haber verecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief не відповідає вже %lld хв. Він сам повторює спробу й повідомить вас, якщо не зможе відповісти."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief chưa trả lời trong %lld phút. Chief sẽ tự thử lại và báo cho bạn nếu không thể trả lời."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief 已 %lld 分钟没有回复。它会自动重试，如果无法回答会告诉你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief 已 %lld 分鐘沒有回覆。它會自動重試，若無法回答會告訴你。"
          }
        }
      }
    },
    "home.chief.organizing": {
      "comment": "Home notice while older cmux DEV builds still run their own Chief, so its history cannot be merged yet.",
      "extractionState": "manual",
