            "value": "Haz que otro Chief sea el predeterminado antes de eliminar este."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Définissez un autre Chief par défaut avant de supprimer celui-ci."
          }
        },
        "it": {
          "stringUnit": {
