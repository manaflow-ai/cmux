    "home.chief.delete.body": {
      "comment": "Body of Delete Chief's question: what deleting does, and that Archive Chief only hides.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتوقف Chief ويُزال نهائيًا، وتختفي محادثته من القائمة. لا يمكن التراجع عن ذلك. أرشفة Chief تخفيه بدلًا من ذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief se zaustavlja i trajno uklanja, a njegov razgovor nestaje s liste. Ovo se ne može poništiti. Arhiviranje Chiefa ga umjesto toga samo sakriva."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief stopper og fjernes for altid, og samtalen forsvinder fra listen. Det kan ikke fortrydes. Arkivér Chief skjuler i stedet en Chief."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Chief wird angehalten und endgültig entfernt, und seine Unterhaltung verschwindet aus der Liste. Das lässt sich nicht rückgängig machen. „Chief archivieren“ blendet einen Chief stattdessen nur aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Chief stops and is removed for good, and its conversation leaves the list. You can’t undo this. Archive Chief hides a Chief instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El Chief se detiene y se elimina para siempre, y su conversación sale de la lista. No se puede deshacer. Archivar Chief solo lo oculta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le Chief s’arrête et est supprimé définitivement, et sa conversation quitte la liste. Cette action est irréversible. « Archiver le Chief » le masque simplement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il Chief si ferma e viene rimosso per sempre, e la sua conversazione esce dall’elenco. Non è possibile annullare. Archivia Chief invece lo nasconde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chiefは停止して完全に削除され、会話はリストから消えます。この操作は取り消せません。非表示にするだけなら「Chiefをアーカイブ」を使います。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief ឈប់ ហើយត្រូវបានលុបជាអចិន្ត្រៃយ៍ ហើយការសន្ទនារបស់វាចេញពីបញ្ជី។ អ្នកមិនអាចមិនធ្វើវិញបានទេ។ ការទុក Chief ក្នុងបណ្ណសារ គ្រាន់តែលាក់វាជំនួសវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief가 중지되고 영구적으로 제거되며, 대화도 목록에서 사라집니다. 이 작업은 되돌릴 수 없습니다. Chief 보관은 Chief를 숨기기만 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief stopper og fjernes for godt, og samtalen forsvinner fra listen. Dette kan ikke angres. Arkiver Chief skjuler i stedet en Chief."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief zatrzymuje się i zostaje trwale usunięty, a jego rozmowa znika z listy. Tego nie można cofnąć. Archiwizacja Chiefa tylko go ukrywa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Chief para e é removido para sempre, e a conversa sai da lista. Não é possível desfazer. Arquivar Chief apenas o oculta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief остановится и будет удалён навсегда, а его разговор исчезнет из списка. Это нельзя отменить. Архивирование Chief только скрывает его."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief จะหยุดและถูกลบถาวร และบทสนทนาจะหายไปจากรายการ เลิกทำไม่ได้ การเก็บ Chief ถาวรจะซ่อน Chief แทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief durur ve kalıcı olarak kaldırılır; konuşması listeden çıkar. Bu geri alınamaz. Chief’i Arşivle bunun yerine yalnızca gizler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief зупиниться й буде видалений назавжди, а його розмова зникне зі списку. Це не можна скасувати. Архівування Chief лише приховує його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief dừng lại và bị xóa vĩnh viễn, cuộc trò chuyện của nó rời khỏi danh sách. Không thể hoàn tác. Lưu trữ Chief chỉ ẩn Chief."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief 会停止并被永久移除,其对话也会从列表中消失。此操作无法撤销。归档 Chief 只会隐藏它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief 會停止並被永久移除,其對話也會從列表中消失。此動作無法復原。封存 Chief 只會隱藏它。"
          }
        }
      }
    },
