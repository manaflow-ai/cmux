            "value": "Haz que otro Chief sea el predeterminado antes de eliminar este."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Définissez un autre Chief par défaut avant de supprimer celui-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Imposta un altro Chief come predefinito prima di eliminare questo."
          }
        },
        "ja": {
          "stringUnit": {
