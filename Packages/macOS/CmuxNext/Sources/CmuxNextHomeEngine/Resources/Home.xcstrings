    "home.engine.reactions.note": {
      "comment": "Chief reaction classifier (a416).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cheap model decides whether your reaction on a Chief message needs an answer. Only then does the Chief start typing. Empty fields use your settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiefのメッセージへのリアクションに返答が必要かを安価なモデルが判断します。必要なときだけChiefが入力を始めます。空欄はあなたの設定を使います。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرر نموذج رخيص ما إذا كان تفاعلك على رسالة Chief يحتاج إلى رد. عندها فقط يبدأ Chief بالكتابة. الحقول الفارغة تستخدم إعداداتك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeftin model odlučuje treba li vaša reakcija na Chiefovu poruku odgovor. Tek tada Chief počinje kucati. Prazna polja koriste vaše postavke."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En billig model afgør, om din reaktion på en Chief-besked kræver svar. Kun da begynder Chief at skrive. Tomme felter bruger dine indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein günstiges Modell entscheidet, ob deine Reaktion auf eine Chief-Nachricht eine Antwort braucht. Nur dann beginnt der Chief zu tippen. Leere Felder nutzen deine Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modelo económico decide si tu reacción en un mensaje del Chief necesita respuesta. Solo entonces el Chief empieza a escribir. Los campos vacíos usan tus ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modèle bon marché décide si votre réaction sur un message du Chief appelle une réponse. Ce n’est qu’alors que le Chief commence à écrire. Les champs vides utilisent vos réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un modello economico decide se la tua reazione a un messaggio del Chief richiede una risposta. Solo allora il Chief inizia a scrivere. I campi vuoti usano le tue impostazioni."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ម៉ូដែលថោកសម្រេចថាប្រតិកម្មរបស់អ្នកលើសារ Chief ត្រូវការចម្លើយឬអត់។ មានតែពេលនោះ Chief ចាប់ផ្ដើមវាយ។ វាលទទេប្រើការកំណត់របស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief 메시지에 남긴 반응에 답이 필요한지 저렴한 모델이 판단합니다. 필요할 때만 Chief가 입력을 시작합니다. 빈 칸은 내 설정을 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En billig modell avgjør om reaksjonen din på en Chief-melding trenger svar. Først da begynner Chief å skrive. Tomme felt bruker innstillingene dine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tani model decyduje, czy twoja reakcja na wiadomość Chiefa wymaga odpowiedzi. Dopiero wtedy Chief zaczyna pisać. Puste pola używają twoich ustawień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um modelo barato decide se sua reação em uma mensagem do Chief precisa de resposta. Só então o Chief começa a digitar. Campos vazios usam seus ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Недорогая модель решает, нужен ли ответ на вашу реакцию на сообщение Chief. Только тогда Chief начинает печатать. Пустые поля берут ваши настройки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โมเดลราคาถูกตัดสินว่ารีแอคชันของคุณบนข้อความ Chief ต้องการคำตอบหรือไม่ Chief จะเริ่มพิมพ์เมื่อต้องการเท่านั้น ช่องว่างใช้การตั้งค่าของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ucuz bir model, bir Chief mesajına verdiğiniz tepkinin yanıt gerektirip gerektirmediğine karar verir. Ancak o zaman Chief yazmaya başlar. Boş alanlar ayarlarınızı kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Недорога модель вирішує, чи потребує ваша реакція на повідомлення Chief відповіді. Лише тоді Chief починає друкувати. Порожні поля беруть ваші налаштування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Một mô hình rẻ quyết định cảm xúc của bạn trên tin nhắn Chief có cần trả lời không. Chỉ khi đó Chief mới bắt đầu nhập. Ô trống dùng cài đặt của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由廉价模型判断你对 Chief 消息的回应是否需要答复。只有需要时 Chief 才开始输入。留空的字段使用你的设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由低成本模型判斷你對 Chief 訊息的回應是否需要答覆。只有需要時 Chief 才開始輸入。留空的欄位使用你的設定。"
          }
        }
      }
    },
