    "home.engine.harnessCheckFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ did not pass its check, so the Chief stays on what it runs now."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat die Prüfung nicht bestanden, daher bleibt der Chief bei dem, was er gerade nutzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas passé sa vérification : le Chief garde ce qu’il utilise maintenant."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يجتز %@ الفحص، لذا يبقى Chief على ما يعمل به الآن."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no superó su comprobación, así que el Chief sigue con lo que usa ahora."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 沒有通過檢查，因此 Chief 會繼續使用目前的設定。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有通过检查，因此 Chief 会继续使用当前的设置。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 확인을 통과하지 못해 Chief는 지금 쓰는 것을 계속 사용합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がチェックに通らなかったため、Chief は現在のまま動作します。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nije prošao provjeru, pa Chief ostaje na onome što sada koristi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bestod ikke sit tjek, så Chief bliver ved det, den kører nu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha superato il controllo, quindi il Chief resta su ciò che usa ora."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ មិនបានឆ្លងការពិនិត្យទេ ដូច្នេះ Chief នៅតែប្រើអ្វីដែលវាកំពុងប្រើ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ besto ikke sjekken, så Chief fortsetter med det den kjører nå."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie przeszedł sprawdzenia, więc Chief zostaje przy tym, czego używa teraz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não passou na verificação, então o Chief continua com o que usa agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не прошёл проверку, поэтому Chief продолжит работать на текущем."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ไม่ผ่านการตรวจสอบ Chief จึงยังใช้สิ่งที่ใช้อยู่ตอนนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ denetimi geçemedi, bu yüzden Chief şu an kullandığıyla devam ediyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не пройшов перевірку, тож Chief працює на тому, що й зараз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không vượt qua lần kiểm tra, nên Chief vẫn dùng thứ đang chạy hiện tại."
          }
        }
      }
    },
