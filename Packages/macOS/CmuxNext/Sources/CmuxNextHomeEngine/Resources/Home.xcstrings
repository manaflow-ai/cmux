    "home.engine.cropHint": {
      "comment": "Hint under the Chief picture editor: how to move and zoom the picture.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب لتحريك الصورة. مرّر أو اقرص للتكبير."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povucite da pomjerite sliku. Skrolujte ili stisnite prstima za zumiranje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk for at flytte billedet. Rul eller knib for at zoome."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Bewegen des Bildes ziehen. Zum Zoomen scrollen oder mit zwei Fingern zusammenziehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to move the picture. Scroll or pinch to zoom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para mover la imagen. Desplázate o pellizca para hacer zoom."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour déplacer l’image. Faites défiler ou pincez pour zoomer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per spostare l’immagine. Scorri o pizzica per ingrandire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグで画像を移動。スクロールまたはピンチで拡大／縮小。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អូសដើម្បីផ្លាស់ទីរូបភាព។ រំកិល ឬច្បិចដើម្បីពង្រីក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 사진을 이동합니다. 스크롤하거나 핀치하여 확대/축소합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra for å flytte bildet. Rull eller knip for å zoome."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby przesunąć obraz. Przewiń lub uszczypnij, aby powiększyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para mover a imagem. Role ou faça pinça para ampliar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите, чтобы сдвинуть изображение. Прокрутите или сведите пальцы для масштаба."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากเพื่อย้ายรูปภาพ เลื่อนหรือบีบเพื่อซูม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resmi taşımak için sürükleyin. Yakınlaştırmak için kaydırın veya kıstırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть, щоб посунути зображення. Прокрутіть або зведіть пальці для масштабу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo để di chuyển ảnh. Cuộn hoặc chụm để thu phóng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移以移动图片。滚动或捏合以缩放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移以移動圖片。捲動或捏合以縮放。"
          }
        }
      }
    },
