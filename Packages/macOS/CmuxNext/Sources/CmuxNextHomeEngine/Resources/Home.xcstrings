        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Chief はもうあなたのアカウントにないため、名前を変更できません。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj Chief više nije na vašem računu, pa mu se ime ne može promijeniti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Chief er ikke længere på din konto, så dens navn kan ikke ændres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Chief non è più nel tuo account, quindi non è possibile cambiarne il nome."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief នេះលែងនៅក្នុងគណនីរបស់អ្នកហើយ ដូច្នេះមិនអាចប្ដូរឈ្មោះវាបានទេ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Chief er ikke lenger på kontoen din, så navnet kan ikke endres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego Chiefa nie ma już na Twoim koncie, więc nie można zmienić jego nazwy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Chief não está mais na sua conta, então o nome dele não pode ser alterado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этого Chief больше нет в вашей учётной записи, поэтому его имя изменить нельзя."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief นี้ไม่อยู่ในบัญชีของคุณแล้ว จึงเปลี่ยนชื่อไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Chief artık hesabınızda değil, bu yüzden adı değiştirilemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цього Chief більше немає у вашому обліковому записі, тому його ім’я не можна змінити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief này không còn trong tài khoản của bạn nên không thể đổi tên."
          }
        }
      }
    },
