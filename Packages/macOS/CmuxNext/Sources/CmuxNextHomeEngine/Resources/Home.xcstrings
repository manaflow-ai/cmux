    "home.engine.harnessCheckFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ did not answer its check, so the Chief stays on what it runs now."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat auf die Prüfung nicht geantwortet, daher bleibt der Chief bei dem, was er gerade nutzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas répondu à sa vérification : le Chief garde ce qu’il utilise maintenant."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يستجب %@ للفحص، لذا يبقى Chief على ما يعمل به الآن."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no respondió a su comprobación, así que el Chief sigue con lo que usa ahora."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 沒有通過檢查回應，因此 Chief 會繼續使用目前的設定。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有回应检查，因此 Chief 会继续使用当前的设置。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 확인에 응답하지 않아 Chief는 지금 쓰는 것을 계속 사용합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がチェックに応答しなかったため、Chief は現在のまま動作します。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nije odgovorio na provjeru, pa Chief ostaje na onome što sada koristi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ svarede ikke på sit tjek, så Chief bliver ved det, den kører nu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha risposto al controllo, quindi il Chief resta su ciò che usa ora."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ មិនបានឆ្លើយតបការពិនិត្យទេ ដូច្នេះ Chief នៅតែប្រើអ្វីដែលវាកំពុងប្រើ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ svarte ikke på sjekken, så Chief fortsetter med det den kjører nå."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie odpowiedział na sprawdzenie, więc Chief zostaje przy tym, czego używa teraz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não respondeu à verificação, então o Chief continua com o que usa agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не ответил на проверку, поэтому Chief продолжит работать на текущем."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ไม่ตอบการตรวจสอบ Chief จึงยังใช้สิ่งที่ใช้อยู่ตอนนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ denetime yanıt vermedi, bu yüzden Chief şu an kullandığıyla devam ediyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не відповів на перевірку, тож Chief працює на тому, що й зараз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không phản hồi lần kiểm tra, nên Chief vẫn dùng thứ đang chạy hiện tại."
          }
        }
      }
    },
    "home.engine.lastTurn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last turn: %1$@, %2$@ s, %3$lld tool calls (%4$lld failed), %5$@ cached, %6$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のターン: %1$@、%2$@ 秒、ツール呼び出し %3$lld 回（失敗 %4$lld）、キャッシュ %5$@、%6$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "آخر دور: %1$@، %2$@ ث، %3$lld استدعاءات أدوات (%4$lld فشلت)، %5$@ من الذاكرة المؤقتة، %6$@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zadnji potez: %1$@, %2$@ s, %3$lld poziva alata (%4$lld neuspjelih), %5$@ iz keša, %6$@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seneste tur: %1$@, %2$@ s, %3$lld værktøjskald (%4$lld mislykkedes), %5$@ cachet, %6$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Letzter Zug: %1$@, %2$@ s, %3$lld Werkzeugaufrufe (%4$lld fehlgeschlagen), %5$@ aus dem Cache, %6$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Último turno: %1$@, %2$@ s, %3$lld llamadas a herramientas (%4$lld fallidas), %5$@ en caché, %6$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dernier tour : %1$@, %2$@ s, %3$lld appels d’outils (%4$lld échoués), %5$@ en cache, %6$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ultimo turno: %1$@, %2$@ s, %3$lld chiamate di strumenti (%4$lld non riuscite), %5$@ in cache, %6$@"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "វេនចុងក្រោយ៖ %1$@, %2$@ វិ, ការហៅឧបករណ៍ %3$lld (បរាជ័យ %4$lld), ឃ្លាំងសម្ងាត់ %5$@, %6$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "지난 턴: %1$@, %2$@초, 도구 호출 %3$lld회(실패 %4$lld), 캐시 %5$@, %6$@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Siste tur: %1$@, %2$@ s, %3$lld verktøykall (%4$lld mislyktes), %5$@ bufret, %6$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ostatnia tura: %1$@, %2$@ s, %3$lld wywołań narzędzi (%4$lld nieudanych), %5$@ z pamięci podręcznej, %6$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Último turno: %1$@, %2$@ s, %3$lld chamadas de ferramentas (%4$lld falharam), %5$@ em cache, %6$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Последний ход: %1$@, %2$@ с, вызовов инструментов %3$lld (с ошибкой %4$lld), из кэша %5$@, %6$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "รอบล่าสุด: %1$@, %2$@ วิ, เรียกเครื่องมือ %3$lld ครั้ง (ล้มเหลว %4$lld), แคช %5$@, %6$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Son tur: %1$@, %2$@ sn, %3$lld araç çağrısı (%4$lld başarısız), %5$@ önbellekten, %6$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Останній хід: %1$@, %2$@ с, викликів інструментів %3$lld (з помилкою %4$lld), з кешу %5$@, %6$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lượt gần nhất: %1$@, %2$@ giây, %3$lld lệnh gọi công cụ (%4$lld lỗi), %5$@ từ bộ nhớ đệm, %6$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "上一轮：%1$@，%2$@ 秒，工具调用 %3$lld 次（失败 %4$lld），缓存 %5$@，%6$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "上一輪：%1$@，%2$@ 秒，工具呼叫 %3$lld 次（失敗 %4$lld），快取 %5$@，%6$@"
          }
        }
      }
    },
