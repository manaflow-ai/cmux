    "home.chief.welcome.goTo": {
      "comment": "Chief's welcome message: Markdown call-out of the Go to Workspace shortcut. %@ is the shortcut, such as ⌘P. Keep the ** and ` marks.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Press `%@` to go anywhere.** It jumps to any open workspace, tab or agent, so it's the first shortcut to learn."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "**اضغط `%@` للانتقال إلى أي مكان.** ينقلك إلى أي مساحة عمل أو علامة تبويب أو وكيل مفتوح، لذا فهو أول اختصار عليك تعلّمه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Pritisnite `%@` da odete bilo gdje.** Skače na bilo koji otvoreni radni prostor, karticu ili agenta, pa je to prva prečica koju treba naučiti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tryk på `%@` for at gå hvor som helst.** Den hopper til ethvert åbent arbejdsområde, fane eller agent, så det er den første genvej, du skal lære."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Drücke `%@`, um überallhin zu springen.** So erreichst du jeden offenen Workspace, Tab oder Agenten – das ist der erste Kurzbefehl, den du lernen solltest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Pulsa `%@` para ir a cualquier sitio.** Salta a cualquier espacio de trabajo, pestaña o agente abierto, así que es el primer atajo que conviene aprender."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Appuyez sur `%@` pour aller n'importe où.** Ce raccourci ouvre n'importe quel espace de travail, onglet ou agent ouvert : c'est le premier à retenir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Premi `%@` per andare ovunque.** Passa a qualsiasi spazio di lavoro, scheda o agente aperto, quindi è la prima scorciatoia da imparare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**`%@` を押せばどこへでも移動できます。** 開いているワークスペース、タブ、エージェントにすぐ移動できるので、最初に覚えるべきショートカットです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "**ចុច `%@` ដើម្បីទៅកន្លែងណាក៏បាន។** វាលោតទៅកន្លែងធ្វើការ ផ្ទាំង ឬភ្នាក់ងារដែលបើកណាមួយ ដូច្នេះវាជាផ្លូវកាត់ដំបូងដែលត្រូវរៀន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**`%@`를 눌러 어디로든 이동하세요.** 열려 있는 워크스페이스, 탭, 에이전트로 바로 이동하므로 가장 먼저 익힐 단축키입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Trykk `%@` for å gå hvor som helst.** Den hopper til ethvert åpent arbeidsområde, fane eller agent, så det er den første snarveien du bør lære."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Naciśnij `%@`, aby przejść gdziekolwiek.** Przenosi do dowolnej otwartej przestrzeni roboczej, karty lub agenta, więc to pierwszy skrót, którego warto się nauczyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Pressione `%@` para ir a qualquer lugar.** Ele leva a qualquer espaço de trabalho, aba ou agente aberto, então é o primeiro atalho para aprender."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Нажмите `%@`, чтобы перейти куда угодно.** Это открывает любое рабочее пространство, вкладку или агента, поэтому это первое сочетание клавиш, которое стоит запомнить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**กด `%@` เพื่อไปที่ใดก็ได้** ใช้ข้ามไปยังเวิร์กสเปซ แท็บ หรือเอเจนต์ที่เปิดอยู่ จึงเป็นคีย์ลัดแรกที่ควรเรียนรู้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Her yere gitmek için `%@` tuşuna basın.** Açık olan herhangi bir çalışma alanına, sekmeye veya ajana atlar; öğrenilecek ilk kısayol budur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "**Натисніть `%@`, щоб перейти куди завгодно.** Це відкриває будь-який робочий простір, вкладку чи агента, тож це перше сполучення клавіш, яке варто запам'ятати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Nhấn `%@` để đi đến bất cứ đâu.** Phím này chuyển đến mọi không gian làm việc, tab hoặc tác tử đang mở, nên đây là phím tắt đầu tiên cần học."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**按 `%@` 即可前往任何地方。** 它能跳转到任何已打开的工作区、标签页或代理，是最先该学会的快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**按 `%@` 即可前往任何地方。** 它能跳到任何已開啟的工作區、分頁或代理，是最先該學會的快速鍵。"
          }
        }
      }
    },
