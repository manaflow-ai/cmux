            "value": "たとえばこんなことを頼めます："
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្វីដែលអ្នកអាចសួរខ្ញុំ៖"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이런 걸 요청할 수 있어요:"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ting du kan spørre meg om:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "O co możesz mnie poprosić:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coisas que você pode me pedir:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О чём можно меня попросить:"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่คุณขอให้ฉันทำได้:"
          }
        },
        "tr": {
          "stringUnit": {
