{
  "sourceLanguage": "en",
  "strings": {
    "home.engine.choosePicture": {
      "comment": "Button in Chief Settings that picks an image as the Chief's picture.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختيار صورة…"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi sliku…"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg billede…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild auswählen …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Picture…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir imagen…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir une image…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli immagine…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像を選択…"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ជ្រើសរើសរូបភាព…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 선택…"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg bilde …"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz obraz…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolher imagem…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрать изображение…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกรูปภาพ…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görsel Seç…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрати зображення…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn hình…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择图片…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇圖片…"
          }
        }
      }
    },
    "home.engine.pictureUnreadable": {
      "comment": "Shown in Chief Settings when a chosen picture cannot be used.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر استخدام هذه الصورة. اختر PNG أو JPEG أو HEIC أو WebP أو GIF بحجم 1 ميغابايت كحد أقصى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta slika se ne može koristiti. Odaberite PNG, JPEG, HEIC, WebP ili GIF do 1 MB."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billedet kunne ikke bruges. Vælg en PNG, JPEG, HEIC, WebP eller en GIF på op til 1 MB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Bild kann nicht verwendet werden. Wähle ein PNG, JPEG, HEIC, WebP oder ein GIF bis 1 MB."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That picture could not be used. Choose a PNG, JPEG, HEIC, WebP, or a GIF up to 1 MB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo usar esa imagen. Elige un PNG, JPEG, HEIC, WebP o un GIF de hasta 1 MB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’utiliser cette image. Choisissez un PNG, JPEG, HEIC, WebP ou un GIF de 1 Mo maximum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile usare l’immagine. Scegli un PNG, JPEG, HEIC, WebP o una GIF fino a 1 MB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像は使用できません。PNG、JPEG、HEIC、WebP、または 1 MB までの GIF を選んでください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចប្រើរូបភាពនេះបានទេ។ សូមជ្រើស PNG, JPEG, HEIC, WebP ឬ GIF ដែលមិនលើស 1 MB។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사진을 사용할 수 없습니다. PNG, JPEG, HEIC, WebP 또는 1MB 이하의 GIF를 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildet kunne ikke brukes. Velg en PNG, JPEG, HEIC, WebP eller en GIF på opptil 1 MB."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można użyć tego obrazu. Wybierz PNG, JPEG, HEIC, WebP lub GIF do 1 MB."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível usar essa imagem. Escolha um PNG, JPEG, HEIC, WebP ou um GIF de até 1 MB."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это изображение нельзя использовать. Выберите PNG, JPEG, HEIC, WebP или GIF до 1 МБ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้รูปภาพนี้ไม่ได้ เลือก PNG, JPEG, HEIC, WebP หรือ GIF ขนาดไม่เกิน 1 MB"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu görsel kullanılamadı. PNG, JPEG, HEIC, WebP veya en fazla 1 MB’lık bir GIF seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це зображення не можна використати. Виберіть PNG, JPEG, HEIC, WebP або GIF до 1 МБ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không dùng được hình này. Hãy chọn PNG, JPEG, HEIC, WebP hoặc GIF tối đa 1 MB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用该图片。请选择 PNG、JPEG、HEIC、WebP，或不超过 1 MB 的 GIF。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法使用該圖片。請選擇 PNG、JPEG、HEIC、WebP，或不超過 1 MB 的 GIF。"
          }
        }
      }
    },
    "home.engine.renameRefused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Chief's name could not be changed. Try again in a moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name des Chiefs konnte nicht geändert werden. Versuche es gleich noch einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de changer le nom du Chief. Réessayez dans un instant."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تغيير اسم Chief. حاول مرة أخرى بعد لحظات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cambiar el nombre del Chief. Vuelve a intentarlo en un momento."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法變更 Chief 的名稱。請稍後再試一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更改 Chief 的名称。请稍后再试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief의 이름을 변경할 수 없습니다. 잠시 후 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief の名前を変更できませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ime Chiefa nije moguće promijeniti. Pokušajte ponovo za trenutak."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiefens navn kunne ikke ændres. Prøv igen om et øjeblik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile cambiare il nome del Chief. Riprova tra un momento."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចប្ដូរឈ្មោះ Chief បានទេ។ សូមព្យាយាមម្ដងទៀតបន្តិចទៀត។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Navnet på Chief kunne ikke endres. Prøv igjen om litt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zmienić nazwy Chiefa. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alterar o nome do Chief. Tente novamente em instantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось изменить имя Chief. Повторите попытку чуть позже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนชื่อ Chief ไม่ได้ ลองอีกครั้งในอีกสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief'in adı değiştirilemedi. Birazdan yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося змінити ім’я Chief. Спробуйте ще раз за мить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đổi được tên Chief. Hãy thử lại sau giây lát."
          }
        }
      }
    },
