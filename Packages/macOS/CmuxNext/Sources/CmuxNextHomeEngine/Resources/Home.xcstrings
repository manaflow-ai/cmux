          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перед видаленням зробіть основним іншого Chief."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hãy đặt một Chief khác làm mặc định trước khi xóa Chief này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "删除此 Chief 前,请先将另一个 Chief 设为默认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "刪除此 Chief 前,請先將另一個 Chief 設為預設。"
          }
        }
      }
    },
