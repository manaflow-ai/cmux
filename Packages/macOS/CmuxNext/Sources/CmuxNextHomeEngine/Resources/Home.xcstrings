    "home.chief.welcome.examplesHeader": {
      "comment": "Chief's welcome message: heading over example requests the user can send the Chief.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Things you can ask me:"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أمور يمكنك أن تطلبها مني:"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šta me možete pitati:"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ting, du kan bede mig om:"
          }
        },
        "de": {
