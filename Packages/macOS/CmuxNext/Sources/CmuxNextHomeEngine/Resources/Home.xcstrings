    "home.engine.renameNotFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Chief is no longer on your account, so its name can’t be changed."
          }
        },
        "de": {
