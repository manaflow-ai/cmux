    "home.chief.delete.default": {
      "comment": "Refusal: Delete Chief on the default Chief.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اجعل Chief آخر هو الافتراضي قبل حذف هذا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Postavite drugog Chiefa kao zadanog prije brisanja ovog."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gør en anden Chief til standard, før du sletter denne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lege zuerst einen anderen Chief als Standard fest, bevor du diesen löschst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make another Chief the default before deleting this one."
          }
        },
        "es": {
          "stringUnit": {
