    "home.engine.error.cloudUnreachable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux could not reach the cloud for this Chief. Check your connection and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux konnte die Cloud für diesen Chief nicht erreichen. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux n’a pas pu joindre le cloud pour ce Chief. Vérifiez votre connexion et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على cmux الوصول إلى السحابة لهذا الـ Chief. تحقّق من اتصالك وحاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no pudo conectar con la nube para este Chief. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 無法連線到此 Chief 的雲端。請檢查網路連線後再試一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 无法连接到此 Chief 的云端。请检查网络连接后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 이 Chief의 클라우드에 연결할 수 없습니다. 연결을 확인한 후 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux はこの Chief のクラウドに接続できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nije mogao dosegnuti oblak za ovog Chiefa. Provjerite vezu i pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux kunne ikke nå skyen for denne Chief. Tjek din forbindelse, og prøv igen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux non è riuscito a raggiungere il cloud per questo Chief. Controlla la connessione e riprova."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux មិនអាចភ្ជាប់ទៅពពកសម្រាប់ Chief នេះបានទេ។ សូមពិនិត្យការតភ្ជាប់របស់អ្នក ហើយព្យាយាមម្តងទៀត។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux kunne ikke nå skyen for denne Chief. Sjekk tilkoblingen og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nie mógł połączyć się z chmurą dla tego Chiefa. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux não conseguiu acessar a nuvem deste Chief. Verifique sua conexão e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux не удалось связаться с облаком для этого Chief. Проверьте подключение и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux เชื่อมต่อคลาวด์ของ Chief นี้ไม่ได้ ตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux bu Chief için buluta ulaşamadı. Bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux не вдалося зв’язатися з хмарою для цього Chief. Перевірте з’єднання й спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux không thể kết nối đến đám mây của Chief này. Hãy kiểm tra kết nối rồi thử lại."
          }
        }
      }
    },
