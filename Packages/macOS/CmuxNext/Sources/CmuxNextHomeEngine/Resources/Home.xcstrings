    "home.engine.error.cloudUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cloud does not run Chiefs, so this Chief does not answer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Cloud führt keine Chiefs aus, daher antwortet dieser Chief nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce cloud n’exécute pas de Chiefs, ce Chief ne répond donc pas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه السحابة لا تشغّل الـ Chiefs، لذلك لا يردّ هذا الـ Chief."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta nube no ejecuta Chiefs, así que este Chief no responde."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此雲端不執行 Chief，因此這個 Chief 不會回覆。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此云端不运行 Chief，因此这个 Chief 不会回复。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 클라우드는 Chief를 실행하지 않으므로 이 Chief는 응답하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このクラウドでは Chief が動作しないため、この Chief は返信しません。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj oblak ne pokreće Chiefove, pa ovaj Chief ne odgovara."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne sky kører ikke Chiefs, så denne Chief svarer ikke."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo cloud non esegue Chief, quindi questo Chief non risponde."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពពកនេះមិនដំណើរការ Chief ទេ ដូច្នេះ Chief នេះមិនឆ្លើយតបទេ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne skyen kjører ikke Chiefs, så denne Chief svarer ikke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta chmura nie uruchamia Chiefów, więc ten Chief nie odpowiada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta nuvem não executa Chiefs, então este Chief não responde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это облако не запускает Chief, поэтому этот Chief не отвечает."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลาวด์นี้ไม่ได้รัน Chief ดังนั้น Chief นี้จะไม่ตอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bulut Chief çalıştırmıyor, bu yüzden bu Chief yanıt vermiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця хмара не запускає Chief, тому цей Chief не відповідає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đám mây này không chạy Chief, nên Chief này không trả lời."
          }
        }
      }
    },
    "home.engine.error.cloudStopUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cloud Chief's reply cannot be stopped from here yet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort eines Cloud-Chiefs kann hier noch nicht gestoppt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse d’un Chief dans le cloud ne peut pas encore être arrêtée d’ici."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن بعدُ إيقاف ردّ Chief سحابي من هنا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se puede detener desde aquí la respuesta de un Chief en la nube."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前還無法從這裡停止雲端 Chief 的回覆。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前还无法从这里停止云端 Chief 的回复。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 Chief의 답변은 아직 여기에서 중지할 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドの Chief の返信は、まだここから停止できません。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovor Chiefa u oblaku još se ne može zaustaviti odavde."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En cloud-Chiefs svar kan endnu ikke stoppes herfra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è ancora possibile interrompere da qui la risposta di un Chief nel cloud."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនទាន់អាចបញ្ឈប់ការឆ្លើយតបរបស់ Chief លើពពកពីទីនេះបានទេ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaret fra en sky-Chief kan ikke stoppes herfra ennå."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedzi Chiefa w chmurze nie można jeszcze zatrzymać stąd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não é possível interromper daqui a resposta de um Chief na nuvem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ облачного Chief пока нельзя остановить отсюда."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังหยุดคำตอบของ Chief บนคลาวด์จากที่นี่ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulut Chief’inin yanıtı henüz buradan durdurulamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповідь хмарного Chief поки не можна зупинити звідси."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa thể dừng câu trả lời của Chief trên đám mây từ đây."
          }
        }
      }
    },
