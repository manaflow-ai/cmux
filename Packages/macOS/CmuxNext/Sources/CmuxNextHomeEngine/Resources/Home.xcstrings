    "home.chief.archive.default": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make another Chief the default before archiving this one."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجعل Chief آخر هو الافتراضي قبل أرشفة هذا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Postavite drugog Chiefa kao zadanog prije arhiviranja ovog."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gør en anden Chief til standard, før du arkiverer denne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege zuerst einen anderen Chief als Standard fest, bevor du diesen archivierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz que otro Chief sea el predeterminado antes de archivar este."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez un autre Chief par défaut avant d’archiver celui-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Imposta un altro Chief come predefinito prima di archiviare questo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このChiefをアーカイブする前に、別のChiefをデフォルトにしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កំណត់ Chief ផ្សេងជាលំនាំដើម មុនពេលទុក Chief នេះក្នុងបណ្ណសារ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Chief를 보관하기 전에 다른 Chief를 기본값으로 지정하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gjør en annen Chief til standard før du arkiverer denne."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przed zarchiwizowaniem tego Chiefa ustaw innego jako domyślnego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Defina outro Chief como padrão antes de arquivar este."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перед архивацией сделайте основным другого Chief."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ตั้ง Chief อื่นเป็นค่าเริ่มต้นก่อนเก็บ Chief นี้ถาวร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bunu arşivlemeden önce başka bir Chief’i varsayılan yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перед архівуванням зробіть основним іншого Chief."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hãy đặt một Chief khác làm mặc định trước khi lưu trữ Chief này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档此 Chief 前，请先将另一个 Chief 设为默认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封存此 Chief 前，請先將另一個 Chief 設為預設。"
          }
        }
      }
    },
