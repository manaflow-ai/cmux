{
  "sourceLanguage": "en",
  "strings": {
    "palette.shortcut.beatsGhostty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a terminal, cmux runs before your Ghostty keybind (%@)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "في الطرفية، يعمل cmux قبل ربط مفاتيح Ghostty لديك (%@)."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "U terminalu cmux se izvršava prije vaše Ghostty prečice (%@)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I en terminal kører cmux før din Ghostty-tastebinding (%@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In einem Terminal läuft cmux vor deiner Ghostty-Tastenbelegung (%@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En un terminal, cmux se ejecuta antes que tu atajo de Ghostty (%@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dans un terminal, cmux passe avant votre raccourci Ghostty (%@)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In un terminale, cmux viene eseguito prima della tua scorciatoia Ghostty (%@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ターミナルでは、Ghosttyのキーバインド（%@）より先にcmuxが動きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "នៅក្នុងស្ថានីយ cmux ដំណើរការមុនការកំណត់គ្រាប់ចុច Ghostty របស់អ្នក (%@)។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "터미널에서는 Ghostty 키 바인딩(%@)보다 cmux가 먼저 실행됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I en terminal kjører cmux før Ghostty-tastebindingen din (%@)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "W terminalu cmux działa przed Twoim skrótem Ghostty (%@)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Em um terminal, o cmux roda antes do seu atalho do Ghostty (%@)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В терминале cmux срабатывает раньше вашей привязки Ghostty (%@)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ในเทอร์มินัล cmux จะทำงานก่อนการผูกปุ่ม Ghostty ของคุณ (%@)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir terminalde cmux, Ghostty tuş bağlamanızdan (%@) önce çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У терміналі cmux спрацьовує раніше за вашу прив’язку Ghostty (%@)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trong terminal, cmux chạy trước phím Ghostty của bạn (%@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在终端中，cmux 先于你的 Ghostty 键绑定（%@）运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在終端機中，cmux 先於你的 Ghostty 按鍵綁定（%@）執行。"
          }
        }
      }
    },
    "palette.shortcut.canKeepBoth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They run in different places, so both can keep it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعملان في أماكن مختلفة، لذا يمكن لكليهما الاحتفاظ به."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Izvršavaju se na različitim mjestima, pa ga obje mogu zadržati."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De kører forskellige steder, så begge kan beholde den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sie laufen an verschiedenen Stellen, also können beide ihn behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se ejecutan en sitios distintos, así que ambos pueden conservarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ils s’exécutent à des endroits différents : les deux peuvent le garder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vengono eseguiti in punti diversi, quindi entrambi possono tenerla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "実行される場所が違うので、両方で使えます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "វាដំណើរការនៅកន្លែងផ្សេងគ្នា ដូច្នេះទាំងពីរអាចរក្សាវាបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "서로 다른 곳에서 실행되므로 둘 다 유지할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De kjører på ulike steder, så begge kan beholde den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Działają w różnych miejscach, więc oba mogą go zachować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eles rodam em lugares diferentes, então ambos podem manter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Они работают в разных местах, поэтому оба могут его сохранить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ทำงานคนละที่ จึงใช้ร่วมกันได้ทั้งคู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Farklı yerlerde çalıştıkları için ikisi de koruyabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вони працюють у різних місцях, тож обидві можуть її зберегти."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chúng chạy ở những nơi khác nhau nên có thể cùng giữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它们在不同位置运行，因此可以同时保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它們在不同位置執行，因此可以同時保留。"
          }
        }
      }
    },
    "palette.shortcut.defaultRestored": {
      "extractionState": "manual",
      "localizations": {
        "en": {
