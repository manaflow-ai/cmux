          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Типову комбінацію відновлено"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã khôi phục phím tắt mặc định"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已恢复默认快捷键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已回復預設快速鍵"
          }
        }
      }
    },
