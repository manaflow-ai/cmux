    "palette.shortcut.leavesChromeChord": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a web page, the page keeps %@; this action runs only elsewhere."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "في صفحة الويب، تحتفظ الصفحة بالاختصار %@؛ يعمل هذا الإجراء في أماكن أخرى فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na web stranici stranica zadržava %@; ova radnja radi samo drugdje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "På en webside beholder siden %@; handlingen kører kun andre steder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In einer Webseite behält die Seite %@; diese Aktion läuft nur anderswo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En una página web, la página conserva %@; esta acción solo se ejecuta en otro lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dans une page web, la page garde %@ ; cette action ne s’exécute qu’ailleurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In una pagina web, la pagina mantiene %@; questa azione funziona solo altrove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Webページでは%@はページのままです。このアクションは他の場所でのみ動きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "នៅក្នុងទំព័របណ្ដាញ ទំព័ររក្សា %@ សកម្មភាពនេះដំណើរការតែកន្លែងផ្សេង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "웹 페이지에서는 페이지가 %@를 유지하며, 이 동작은 다른 곳에서만 실행됩니다."
          }
        },
        "nb": {
          "stringUnit": {
