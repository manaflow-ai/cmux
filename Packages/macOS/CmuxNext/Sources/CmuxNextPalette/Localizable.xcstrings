    "picker.explainer.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS will ask before cmux opens %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سيسألك macOS قبل أن يفتح cmux %@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS će pitati prije nego što cmux otvori %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS spørger, før cmux åbner %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS fragt, bevor cmux %@ öffnet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS te preguntará antes de que cmux abra %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS vous demandera avant que cmux ouvre %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS chiederà prima che cmux apra %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmuxが%@を開く前にmacOSが確認します"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS នឹងសួរមុនពេល cmux បើក %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux가 %@을(를) 열기 전에 macOS가 묻습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS spør før cmux åpner %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS zapyta, zanim cmux otworzy %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O macOS vai perguntar antes de o cmux abrir %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS спросит, прежде чем cmux откроет %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS จะถามก่อนที่ cmux จะเปิด %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux %@ klasörünü açmadan önce macOS soracak"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS запитає, перш ніж cmux відкриє %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS sẽ hỏi trước khi cmux mở %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 打开%@前，macOS 会先询问"
