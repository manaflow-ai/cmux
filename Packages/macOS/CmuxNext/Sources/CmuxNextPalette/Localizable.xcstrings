    "picker.replaceQuestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” already exists. Replace it?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” موجود بالفعل. هل تريد استبداله؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%@“ već postoji. Zamijeniti?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” findes allerede. Vil du erstatte det?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
