          "stringUnit": {
            "state": "translated",
            "value": "置き換えると内容は上書きされます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការជំនួសនឹងសរសេរជាន់មាតិការបស់វា។"
