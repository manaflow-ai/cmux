          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%@” już istnieje. Zastąpić?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” já existe. Substituir?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%@» уже существует. Заменить?"
