    "picker.explainer.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux reads a protected folder only when you open it. You can change this later in System Settings."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يقرأ cmux المجلد المحمي فقط عندما تفتحه. يمكنك تغيير ذلك لاحقًا في إعدادات النظام."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux čita zaštićenu mapu samo kada je otvorite. To možete kasnije promijeniti u Postavkama sistema."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux læser kun en beskyttet mappe, når du åbner den. Du kan ændre det senere i Systemindstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux liest einen geschützten Ordner nur, wenn du ihn öffnest. Du kannst das später in den Systemeinstellungen ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux solo lee una carpeta protegida cuando la abres. Puedes cambiarlo después en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux ne lit un dossier protégé que lorsque vous l’ouvrez. Vous pourrez modifier cela dans Réglages Système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux legge una cartella protetta solo quando la apri. Puoi cambiarlo in seguito in Impostazioni di Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmuxは保護されたフォルダを、あなたが開いたときにだけ読み込みます。この設定は後からシステム設定で変更できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux អានថតដែលបានការពារ តែនៅពេលអ្នកបើកវាប៉ុណ្ណោះ។ អ្នកអាចប្ដូរវាពេលក្រោយនៅក្នុងការកំណត់ប្រព័ន្ធ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux는 보호된 폴더를 사용자가 열 때만 읽습니다. 나중에 시스템 설정에서 변경할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux leser en beskyttet mappe bare når du åpner den. Du kan endre dette senere i Systeminnstillinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux odczytuje chroniony folder tylko wtedy, gdy go otworzysz. Możesz to później zmienić w Ustawieniach systemowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cmux só lê uma pasta protegida quando você a abre. Você pode mudar isso depois nos Ajustes do Sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux читает защищённую папку, только когда вы её открываете. Это можно изменить позже в Системных настройках."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux อ่านโฟลเดอร์ที่ได้รับการปกป้องเฉพาะเมื่อคุณเปิดเท่านั้น คุณเปลี่ยนได้ภายหลังในการตั้งค่าระบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux korumalı bir klasörü yalnızca siz açtığınızda okur. Bunu daha sonra Sistem Ayarları’nda değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux читає захищену папку, лише коли ви її відкриваєте. Це можна змінити пізніше в Системних параметрах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux chỉ đọc thư mục được bảo vệ khi bạn mở nó. Bạn có thể thay đổi điều này sau trong Cài đặt hệ thống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 仅在你打开受保护的文件夹时才读取它。你可以稍后在“系统设置”中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 只會在你打開受保護的檔案夾時讀取它。你可以稍後在「系統設定」中更改。"
          }
        }
      }
    },
