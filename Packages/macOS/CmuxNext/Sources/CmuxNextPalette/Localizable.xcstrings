    "picker.replaceDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replacing it overwrites its contents."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سيؤدي الاستبدال إلى الكتابة فوق محتواه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zamjena briše njegov sadržaj."
          }
        },
