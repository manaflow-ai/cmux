{
  "sourceLanguage": "en",
  "strings": {
    "cloud.computerControl.askBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take over its computer to continue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けるにはコンピューターの操作を引き継いでください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تولَّ التحكم في الكمبيوتر للمتابعة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuzmite računar da biste nastavili."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Overtag computeren for at fortsætte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übernimm den Computer, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma el control del ordenador para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez la main sur l'ordinateur pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendi il controllo del computer per continuare."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សូមគ្រប់គ្រងកុំព្យូទ័រដើម្បីបន្ត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하려면 컴퓨터 제어를 가져오세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta over datamaskinen for å fortsette."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejmij komputer, aby kontynuować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assuma o computador para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возьмите управление компьютером, чтобы продолжить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าควบคุมคอมพิวเตอร์เพื่อดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam etmek için bilgisayarı devralın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Візьміть керування комп'ютером, щоб продовжити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy tiếp quản máy tính để tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接管电脑以继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接管電腦以繼續。"
          }
        }
      }
    },
    "cloud.computerControl.askTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Chief needs you on %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief が %@ であなたの操作を求めています"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاجك Chief على %@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief vas treba na %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Chief har brug for dig på %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Chief braucht dich auf %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Chief te necesita en %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Chief a besoin de vous sur %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo Chief ha bisogno di te su %@"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief របស់អ្នកត្រូវការអ្នកនៅលើ %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief가 %@에서 도움을 요청합니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiefen din trenger deg på %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój Chief potrzebuje cię na %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu Chief precisa de você em %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш Chief просит помощи на %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief ของคุณต้องการคุณบน %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief'in %@ üzerinde sana ihtiyaç duyuyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш Chief просить допомоги на %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief của bạn cần bạn trên %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Chief 需要你在 %@ 上协助"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Chief 需要你在 %@ 上協助"
          }
        }
      }
    },
    "cloud.computerControl.userOriginRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the person can take over this computer or give it back once they took it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンピューターを引き継げるのは本人だけです。本人が引き継いだ場合、戻せるのも本人だけです。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إلا للشخص نفسه تولي هذا الكمبيوتر أو إعادته بعد أن يتولاه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo osoba može preuzeti ovaj računar ili ga vratiti nakon što ga je preuzela."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun personen kan overtage denne computer eller give den tilbage, når personen har overtaget den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die Person kann diesen Computer übernehmen oder ihn zurückgeben, nachdem sie ihn übernommen hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo la persona puede tomar el control de este ordenador o devolverlo después de tomarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule la personne peut prendre la main sur cet ordinateur ou le rendre après l'avoir pris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo la persona può prendere il controllo di questo computer o restituirlo dopo averlo preso."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មានតែមនុស្សប៉ុណ្ណោះដែលអាចគ្រប់គ្រងកុំព្យូទ័រនេះ ឬប្រគល់វាវិញបន្ទាប់ពីបានគ្រប់គ្រង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 컴퓨터는 사용자만 제어를 가져올 수 있고, 사용자가 가져온 뒤에는 사용자만 돌려줄 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare personen kan ta over denne datamaskinen eller gi den tilbake etter å ha tatt den over."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko osoba może przejąć ten komputer lub oddać go po przejęciu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só a pessoa pode assumir este computador ou devolvê-lo depois de assumi-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только человек может взять управление этим компьютером или вернуть его после этого."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีเพียงผู้ใช้เท่านั้นที่เข้าควบคุมคอมพิวเตอร์นี้ได้ หรือคืนได้หลังจากเข้าควบคุมแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bilgisayarı yalnızca kişi devralabilir veya devraldıktan sonra geri verebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише людина може взяти керування цим комп'ютером або повернути його після цього."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ người dùng mới có thể tiếp quản máy tính này hoặc trả lại sau khi đã tiếp quản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有用户本人可以接管此电脑，或在接管后将其交还。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有使用者本人可以接管此電腦，或在接管後將其交還。"
          }
        }
      }
    },
    "cloud.computerControl.notHere": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who drives a Chief's computer changes only on this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief のコンピューターの操作者はこの Mac でのみ変更できます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتغير من يتحكم في كمبيوتر Chief إلا على هذا الـ Mac."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko upravlja Chief računarom mijenja se samo na ovom Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvem der styrer Chiefs computer, ændres kun på denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer den Computer des Chiefs steuert, ändert sich nur auf diesem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quién controla el ordenador del Chief solo cambia en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui contrôle l'ordinateur du Chief ne change que sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi controlla il computer del Chief cambia solo su questo Mac."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកគ្រប់គ្រងកុំព្យូទ័ររបស់ Chief ផ្លាស់ប្ដូរបានតែលើ Mac នេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief 컴퓨터의 제어자는 이 Mac에서만 바꿀 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvem som styrer Chiefs datamaskin, endres bare på denne Macen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kto steruje komputerem Chiefa, zmienia się tylko na tym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem controla o computador do Chief só muda neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кто управляет компьютером Chief, меняется только на этом Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ควบคุมคอมพิวเตอร์ของ Chief เปลี่ยนได้บน Mac เครื่องนี้เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief'in bilgisayarını kimin denetlediği yalnızca bu Mac'te değişir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хто керує комп'ютером Chief, змінюється лише на цьому Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người điều khiển máy tính của Chief chỉ thay đổi được trên máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief 电脑的控制者只能在这台 Mac 上更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief 電腦的控制者只能在這台 Mac 上更改。"
          }
        }
      }
    },
    "cloud.computerControl.badAction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say what to do: status, take_over, hand_back or request_human."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作を指定してください: status、take_over、hand_back、request_human。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد ما يجب فعله: status أو take_over أو hand_back أو request_human."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Navedite radnju: status, take_over, hand_back ili request_human."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv handlingen: status, take_over, hand_back eller request_human."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib an, was zu tun ist: status, take_over, hand_back oder request_human."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica qué hacer: status, take_over, hand_back o request_human."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez l'action : status, take_over, hand_back ou request_human."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica cosa fare: status, take_over, hand_back o request_human."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សូមបញ្ជាក់សកម្មភាព៖ status, take_over, hand_back ឬ request_human។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수행할 작업을 지정하세요: status, take_over, hand_back 또는 request_human."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppgi handlingen: status, take_over, hand_back eller request_human."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj działanie: status, take_over, hand_back lub request_human."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe a ação: status, take_over, hand_back ou request_human."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите действие: status, take_over, hand_back или request_human."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบุสิ่งที่ต้องทำ: status, take_over, hand_back หรือ request_human"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne yapılacağını belirtin: status, take_over, hand_back veya request_human."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкажіть дію: status, take_over, hand_back або request_human."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chỉ định thao tác: status, take_over, hand_back hoặc request_human."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请指定操作：status、take_over、hand_back 或 request_human。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請指定操作：status、take_over、hand_back 或 request_human。"
          }
        }
      }
    },
    "cloud.computerControl.noMachine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name the Cloud machine whose computer it is (machine)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象の Cloud マシンを指定してください (machine)。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد جهاز Cloud الذي يخصه الكمبيوتر (machine)."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Navedite Cloud mašinu čiji je to računar (machine)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv den Cloud-maskine, computeren hører til (machine)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenne die Cloud-Maschine, zu der der Computer gehört (machine)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica la máquina de Cloud de ese ordenador (machine)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez la machine Cloud de cet ordinateur (machine)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica la macchina Cloud di quel computer (machine)."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សូមបញ្ជាក់ម៉ាស៊ីន Cloud នៃកុំព្យូទ័រនោះ (machine)។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 컴퓨터의 Cloud 머신을 지정하세요 (machine)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppgi Cloud-maskinen datamaskinen hører til (machine)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj maszynę Cloud, do której należy komputer (machine)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe a máquina do Cloud desse computador (machine)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите машину Cloud этого компьютера (machine)."
          }
        },
        "th": {
