    "home.chief.hostedCopyFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Chief's history could not be copied to the cloud yet. cmux tries again at the next launch."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّر نسخ سجل Chief إلى السحابة بعد. سيحاول cmux مرة أخرى عند التشغيل التالي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Historija vašeg Chiefa još nije kopirana u oblak. cmux će pokušati ponovo pri sljedećem pokretanju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Din Chiefs historik kunne ikke kopieres til skyen endnu. cmux prøver igen ved næste start."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Verlauf deines Chiefs konnte noch nicht in die Cloud kopiert werden. cmux versucht es beim nächsten Start erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aún no se pudo copiar el historial de tu Chief a la nube. cmux lo intentará de nuevo en el próximo inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’historique de votre Chief n’a pas encore pu être copié dans le cloud. cmux réessaiera au prochain lancement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non è stato ancora possibile copiare la cronologia del tuo Chief nel cloud. cmux riproverà al prossimo avvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief の履歴をまだクラウドにコピーできませんでした。cmux は次回の起動時に再試行します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនទាន់អាចចម្លងប្រវត្តិ Chief របស់អ្នកទៅពពកបានទេ។ cmux នឹងព្យាយាមម្តងទៀតនៅពេលបើកលើកក្រោយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief 기록을 아직 클라우드에 복사하지 못했습니다. cmux가 다음 실행 때 다시 시도합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chiefens historikk kunne ikke kopieres til skyen ennå. cmux prøver igjen ved neste oppstart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie udało się jeszcze skopiować historii Twojego Chiefa do chmury. cmux spróbuje ponownie przy następnym uruchomieniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ainda não foi possível copiar o histórico do seu Chief para a nuvem. O cmux tentará de novo na próxima abertura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Историю вашего Chief пока не удалось скопировать в облако. cmux попробует снова при следующем запуске."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังคัดลอกประวัติของ Chief ไปยังคลาวด์ไม่ได้ cmux จะลองอีกครั้งเมื่อเปิดครั้งถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief geçmişiniz henüz buluta kopyalanamadı. cmux bir sonraki açılışta yeniden deneyecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Історію вашого Chief поки не вдалося скопіювати в хмару. cmux спробує знову під час наступного запуску."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chưa thể sao chép lịch sử Chief của bạn lên đám mây. cmux sẽ thử lại ở lần mở tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "暂时无法将 Chief 的历史记录复制到云端。cmux 会在下次启动时重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "暫時無法將 Chief 的歷史紀錄複製到雲端。cmux 會在下次啟動時重試。"
          }
        }
      }
    },
    "home.chief.hostedBrainFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your cloud Chief could not be turned on, so it does not answer yet. cmux tries again at the next launch."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّر تشغيل Chief السحابي، لذلك لا يجيب بعد. سيحاول cmux مرة أخرى عند التشغيل التالي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vaš Chief u oblaku nije mogao biti uključen, pa još ne odgovara. cmux će pokušati ponovo pri sljedećem pokretanju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Din Chief i skyen kunne ikke slås til, så den svarer ikke endnu. cmux prøver igen ved næste start."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Cloud-Chief konnte nicht eingeschaltet werden und antwortet daher noch nicht. cmux versucht es beim nächsten Start erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo activar tu Chief en la nube, así que todavía no responde. cmux lo intentará de nuevo en el próximo inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre Chief cloud n’a pas pu être activé, il ne répond donc pas encore. cmux réessaiera au prochain lancement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non è stato possibile attivare il tuo Chief nel cloud, quindi non risponde ancora. cmux riproverà al prossimo avvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "クラウドの Chief をオンにできなかったため、まだ応答しません。cmux は次回の起動時に再試行します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនអាចបើក Chief លើពពករបស់អ្នកបានទេ ដូច្នេះវាមិនទាន់ឆ្លើយតបនៅឡើយ។ cmux នឹងព្យាយាមម្តងទៀតនៅពេលបើកលើកក្រោយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "클라우드 Chief를 켤 수 없어 아직 응답하지 않습니다. cmux가 다음 실행 때 다시 시도합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief i skyen kunne ikke slås på, så den svarer ikke ennå. cmux prøver igjen ved neste oppstart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie udało się włączyć twojego Chiefa w chmurze, więc jeszcze nie odpowiada. cmux spróbuje ponownie przy następnym uruchomieniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível ativar seu Chief na nuvem, então ele ainda não responde. O cmux tentará de novo na próxima abertura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось включить ваш облачный Chief, поэтому он пока не отвечает. cmux попробует снова при следующем запуске."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิด Chief บนคลาวด์ของคุณไม่ได้ จึงยังไม่ตอบ cmux จะลองอีกครั้งเมื่อเปิดครั้งถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bulut Chief'in açılamadı, bu yüzden henüz yanıt vermiyor. cmux bir sonraki açılışta yeniden deneyecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не вдалося ввімкнути ваш хмарний Chief, тому він ще не відповідає. cmux спробує знову під час наступного запуску."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thể bật Chief trên đám mây của bạn nên Chief chưa trả lời. cmux sẽ thử lại ở lần mở tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法开启你的云端 Chief，因此它暂时不会回复。cmux 会在下次启动时重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "無法開啟你的雲端 Chief，因此它暫時不會回覆。cmux 會在下次啟動時重試。"
          }
        }
      }
    },
    "home.chief.hostedBrainOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your cloud Chief is turned off, so it does not answer messages."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief السحابي متوقف، لذلك لا يجيب عن الرسائل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vaš Chief u oblaku je isključen, pa ne odgovara na poruke."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Din Chief i skyen er slået fra, så den svarer ikke på beskeder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Cloud-Chief ist ausgeschaltet und beantwortet daher keine Nachrichten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu Chief en la nube está desactivado, así que no responde a los mensajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre Chief cloud est désactivé, il ne répond donc pas aux messages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il tuo Chief nel cloud è disattivato, quindi non risponde ai messaggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "クラウドの Chief はオフのため、メッセージに応答しません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief លើពពករបស់អ្នកត្រូវបានបិទ ដូច្នេះវាមិនឆ្លើយតបសារទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "클라우드 Chief가 꺼져 있어 메시지에 응답하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief i skyen er slått av, så den svarer ikke på meldinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Twój Chief w chmurze jest wyłączony, więc nie odpowiada na wiadomości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seu Chief na nuvem está desativado, então ele não responde às mensagens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ваш облачный Chief выключен, поэтому он не отвечает на сообщения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief บนคลาวด์ของคุณปิดอยู่ จึงไม่ตอบข้อความ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bulut Chief'in kapalı, bu yüzden mesajlara yanıt vermiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ваш хмарний Chief вимкнено, тому він не відповідає на повідомлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief trên đám mây của bạn đang tắt nên không trả lời tin nhắn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的云端 Chief 已关闭，因此不会回复消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的雲端 Chief 已關閉，因此不會回覆訊息。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
