{
  "sourceLanguage": "en",
  "strings": {
    "passwords.firefox.primary.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أدخل كلمة السر الرئيسية لـ %@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unesite glavnu lozinku za %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Indtast den primære adgangskode til %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hauptpasswort für %@ eingeben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the Primary Password for %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Introduce la contraseña principal de %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saisissez le mot de passe principal de %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inserisci la password principale di %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ のプライマリパスワードを入力"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បញ្ចូលពាក្យសម្ងាត់ចម្បងសម្រាប់ %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@의 기본 비밀번호 입력"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skriv inn hovedpassordet for %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wpisz hasło główne dla %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Digite a senha principal do %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Введите основной пароль для %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ป้อนรหัสผ่านหลักสำหรับ %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ için ana parolayı girin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Введіть основний пароль для %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhập mật khẩu chính cho %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "输入 %@ 的主密码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "輸入 %@ 的主密碼"
          }
        }
      }
    },
    "passwords.firefox.primary.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحمي هذا الملف الشخصي كلمات السر المحفوظة بكلمة سر رئيسية. يستخدمها cmux مرة واحدة لقراءتها ولا يحتفظ بها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovaj profil štiti sačuvane lozinke glavnom lozinkom. cmux je koristi jednom da ih pročita i ne čuva je."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne profil beskytter sine gemte adgangskoder med en primær adgangskode. cmux bruger den én gang til at læse dem og gemmer den ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieses Profil schützt seine gespeicherten Passwörter mit einem Hauptpasswort. cmux verwendet es einmal zum Lesen und speichert es nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This profile protects its saved passwords with a primary password. cmux uses it once to read them and does not keep it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este perfil protege sus contraseñas guardadas con una contraseña principal. cmux la usa una vez para leerlas y no la conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce profil protège ses mots de passe enregistrés par un mot de passe principal. cmux l’utilise une fois pour les lire et ne le conserve pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo profilo protegge le password salvate con una password principale. cmux la usa una volta per leggerle e non la conserva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このプロファイルは保存済みパスワードをプライマリパスワードで保護しています。cmux は読み取りのために一度だけ使い、保持しません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ប្រវត្តិរូបនេះការពារពាក្យសម្ងាត់ដែលបានរក្សាទុកដោយពាក្យសម្ងាត់ចម្បង។ cmux ប្រើវាម្តងដើម្បីអានពួកវា ហើយមិនរក្សាទុកវាទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 프로필은 저장된 비밀번호를 기본 비밀번호로 보호합니다. cmux는 읽을 때 한 번만 사용하며 보관하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne profilen beskytter lagrede passord med et hovedpassord. cmux bruker det én gang for å lese dem og beholder det ikke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten profil chroni zapisane hasła hasłem głównym. cmux użyje go raz, aby je odczytać, i go nie zachowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este perfil protege as senhas salvas com uma senha principal. O cmux a usa uma vez para lê-las e não a guarda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот профиль защищает сохранённые пароли основным паролем. cmux использует его один раз, чтобы прочитать их, и не хранит его."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โปรไฟล์นี้ป้องกันรหัสผ่านที่บันทึกไว้ด้วยรหัสผ่านหลัก cmux ใช้เพียงครั้งเดียวเพื่ออ่านและไม่เก็บไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu profil kayıtlı parolalarını bir ana parolayla korur. cmux onu okumak için bir kez kullanır ve saklamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цей профіль захищає збережені паролі основним паролем. cmux використовує його один раз, щоб прочитати їх, і не зберігає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hồ sơ này bảo vệ mật khẩu đã lưu bằng mật khẩu chính. cmux chỉ dùng nó một lần để đọc và không giữ lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此配置文件用主密码保护已保存的密码。cmux 只使用一次来读取它们，不会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此設定檔以主密碼保護已儲存的密碼。cmux 只使用一次來讀取，不會保留。"
          }
        }
      }
    },
