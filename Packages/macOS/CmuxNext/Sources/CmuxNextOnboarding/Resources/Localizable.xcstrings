    "onboarding.computerUse.panel.drag": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag %1$@ to the list above to allow %2$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب %1$@ إلى القائمة أعلاه للسماح بـ %2$@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevucite %1$@ na listu iznad da dozvolite: %2$@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk %1$@ til listen ovenfor for at tillade %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh %1$@ in die Liste oben, um %2$@ zu erlauben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra %1$@ a la lista de arriba para permitir %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser %1$@ dans la liste ci-dessus pour autoriser %2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina %1$@ nell’elenco sopra per consentire %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を上のリストにドラッグして、%2$@を許可します"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អូស %1$@ ទៅក្នុងបញ្ជីខាងលើ ដើម្បីអនុញ្ញាត %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@을(를) 허용하려면 %1$@을(를) 위 목록으로 드래그하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra %1$@ til listen over for å tillate %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij %1$@ na listę powyżej, aby zezwolić: %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste %1$@ para a lista acima para permitir %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите %1$@ в список выше, чтобы разрешить: %2$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลาก %1$@ ไปยังรายการด้านบนเพื่ออนุญาต %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ iznini vermek için %1$@ öğesini yukarıdaki listeye sürükleyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть %1$@ до списку вище, щоб дозволити: %2$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo %1$@ vào danh sách ở trên để cho phép %2$@"
