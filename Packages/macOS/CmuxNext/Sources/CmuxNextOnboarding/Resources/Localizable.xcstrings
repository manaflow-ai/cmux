          "stringUnit": {
            "state": "needs_review",
            "value": "Hvad beskriver bedst dit arbejde?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Was beschreibt deine Arbeit am besten?"
