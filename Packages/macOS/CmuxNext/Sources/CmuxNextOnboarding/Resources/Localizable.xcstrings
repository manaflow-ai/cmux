    "onboarding.import.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import bookmarks, history, open tabs and extensions. Nothing leaves this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ブックマーク、履歴、開いているタブ、拡張機能を読み込みます。データがこの Mac から出ることはありません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "استورد الإشارات المرجعية والسجل وعلامات التبويب المفتوحة والامتدادات. لا شيء يغادر هذا الـ Mac."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uvezite oznake, historiju, otvorene kartice i ekstenzije. Ništa ne napušta ovaj Mac."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importér bogmærker, historik, åbne faner og udvidelser. Intet forlader denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importiere Lesezeichen, Verlauf, offene Tabs und Erweiterungen. Nichts verlässt diesen Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importa marcadores, historial, pestañas abiertas y extensiones. Nada sale de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importez signets, historique, onglets ouverts et extensions. Rien ne quitte ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importa preferiti, cronologia, schede aperte ed estensioni. Niente lascia questo Mac."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "នាំចូលចំណាំ ប្រវត្តិ ផ្ទាំងដែលបើក និងកម្មវិធីបន្ថែម។ គ្មានអ្វីចាកចេញពី Mac នេះទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "책갈피, 방문 기록, 열린 탭, 확장 프로그램을 가져옵니다. 이 Mac 밖으로 전송되는 것은 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importer bokmerker, logg, åpne faner og utvidelser. Ingenting forlater denne Macen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importuj zakładki, historię, otwarte karty i rozszerzenia. Nic nie opuszcza tego Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importe favoritos, histórico, abas abertas e extensões. Nada sai deste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Импортируйте закладки, историю, открытые вкладки и расширения. Ничего не покидает этот Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "นำเข้าบุ๊คมาร์ค ประวัติ แถบที่เปิดอยู่ และส่วนขยาย ไม่มีข้อมูลใดออกจาก Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yer işaretlerini, geçmişi, açık sekmeleri ve uzantıları içe aktarın. Hiçbir şey bu Mac'ten çıkmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Імпортуйте закладки, історію, відкриті вкладки й розширення. Ніщо не залишає цей Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhập dấu trang, lịch sử, tab đang mở và tiện ích mở rộng. Không có gì rời khỏi máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "导入书签、历史记录、打开的标签页和扩展。所有数据都不会离开这台 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "匯入書籤、瀏覽記錄、打開的標籤頁和延伸功能。所有資料都不會離開這台 Mac。"
          }
        }
      }
    },
