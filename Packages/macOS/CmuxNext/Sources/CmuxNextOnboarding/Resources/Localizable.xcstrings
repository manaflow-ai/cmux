    "onboarding.firstTask.note.prompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write me a short, friendly welcome note with three tips for getting started with cmux. Save it as welcome-note.md in this folder."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اكتب لي ملاحظة ترحيب قصيرة وودودة مع ثلاث نصائح للبدء مع cmux. احفظها باسم welcome-note.md في هذا المجلد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Napiši mi kratku, prijateljsku poruku dobrodošlice s tri savjeta za početak rada s cmux-om. Sačuvaj je kao welcome-note.md u ovoj fascikli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skriv en kort, venlig velkomstnote til mig med tre tips til at komme i gang med cmux. Gem den som welcome-note.md i denne mappe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schreib mir eine kurze, freundliche Willkommensnotiz mit drei Tipps für den Einstieg in cmux. Speichere sie als welcome-note.md in diesem Ordner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escríbeme una nota de bienvenida breve y amable con tres consejos para empezar con cmux. Guárdala como welcome-note.md en esta carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Écris-moi un court mot de bienvenue chaleureux avec trois conseils pour bien démarrer avec cmux. Enregistre-le sous welcome-note.md dans ce dossier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scrivimi una breve e cordiale nota di benvenuto con tre consigli per iniziare con cmux. Salvala come welcome-note.md in questa cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux を使い始めるための3つのヒントを入れた、短く親しみやすいウェルカムメモを書いてください。このフォルダに welcome-note.md として保存してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សរសេរកំណត់ចំណាំស្វាគមន៍ខ្លី និងរួសរាយមួយឱ្យខ្ញុំ ដោយមានគន្លឹះបីសម្រាប់ចាប់ផ្ដើមប្រើ cmux។ រក្សាទុកវាជា welcome-note.md ក្នុងថតនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux를 시작하는 데 도움이 되는 팁 세 가지를 담아 짧고 친근한 환영 메모를 써 주세요. 이 폴더에 welcome-note.md로 저장해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skriv et kort, vennlig velkomstnotat til meg med tre tips for å komme i gang med cmux. Lagre det som welcome-note.md i denne mappen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Napisz mi krótką, przyjazną notatkę powitalną z trzema wskazówkami na start z cmux. Zapisz ją jako welcome-note.md w tym folderze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escreva para mim um recado de boas-vindas curto e simpático com três dicas para começar a usar o cmux. Salve como welcome-note.md nesta pasta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Напиши мне короткую дружелюбную приветственную заметку с тремя советами, как начать работу с cmux. Сохрани её как welcome-note.md в этой папке."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เขียนโน้ตต้อนรับสั้น ๆ ที่เป็นกันเองให้ฉัน พร้อมเคล็ดลับสามข้อสำหรับเริ่มต้นใช้ cmux บันทึกเป็น welcome-note.md ในโฟลเดอร์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bana cmux’a başlamak için üç ipucu içeren kısa ve samimi bir karşılama notu yaz. Bu klasöre welcome-note.md olarak kaydet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Напиши мені коротку дружню вітальну нотатку з трьома порадами, як почати роботу з cmux. Збережи її як welcome-note.md у цій папці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hãy viết cho tôi một ghi chú chào mừng ngắn, thân thiện với ba mẹo để bắt đầu dùng cmux. Lưu thành welcome-note.md trong thư mục này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "给我写一段简短友好的欢迎便条，附上三个上手 cmux 的提示。在此文件夹中保存为 welcome-note.md。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "給我寫一段簡短友善的歡迎便條，附上三個上手 cmux 的提示。在此資料夾中儲存為 welcome-note.md。"
          }
        }
      }
    },
    "onboarding.firstTask.chart.prompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read sales.csv in this folder and make a bar chart of revenue by month. Save it as chart.svg in this folder, then tell me in one sentence what it shows."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اقرأ sales.csv في هذا المجلد وأنشئ مخططًا شريطيًا للإيرادات حسب الشهر. احفظه باسم chart.svg في هذا المجلد، ثم أخبرني في جملة واحدة بما يُظهره."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pročitaj sales.csv u ovoj fascikli i napravi stupčasti grafikon prihoda po mjesecima. Sačuvaj ga kao chart.svg u ovoj fascikli, a zatim mi u jednoj rečenici reci šta pokazuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Læs sales.csv i denne mappe, og lav et søjlediagram over omsætning pr. måned. Gem det som chart.svg i denne mappe, og fortæl mig så i én sætning, hvad det viser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lies sales.csv in diesem Ordner und erstelle ein Balkendiagramm des Umsatzes nach Monat. Speichere es als chart.svg in diesem Ordner und sag mir dann in einem Satz, was es zeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lee sales.csv en esta carpeta y haz un gráfico de barras de los ingresos por mes. Guárdalo como chart.svg en esta carpeta y luego dime en una frase qué muestra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lis sales.csv dans ce dossier et fais un graphique en barres du chiffre d’affaires par mois. Enregistre-le sous chart.svg dans ce dossier, puis dis-moi en une phrase ce qu’il montre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leggi sales.csv in questa cartella e crea un grafico a barre dei ricavi per mese. Salvalo come chart.svg in questa cartella, poi dimmi in una frase cosa mostra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このフォルダの sales.csv を読み、月別売上の棒グラフを作ってください。このフォルダに chart.svg として保存し、何がわかるかを1文で教えてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អាន sales.csv ក្នុងថតនេះ ហើយបង្កើតតារាងក្រាហ្វិកជាសសរនៃចំណូលតាមខែ។ រក្សាទុកវាជា chart.svg ក្នុងថតនេះ រួចប្រាប់ខ្ញុំក្នុងប្រយោគមួយថាវាបង្ហាញអ្វី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 폴더의 sales.csv를 읽고 월별 매출 막대 차트를 만들어 주세요. 이 폴더에 chart.svg로 저장한 다음, 차트가 보여 주는 내용을 한 문장으로 알려 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les sales.csv i denne mappen og lag et søylediagram over inntekter per måned. Lagre det som chart.svg i denne mappen, og fortell meg så i én setning hva det viser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przeczytaj sales.csv w tym folderze i zrób wykres słupkowy przychodów według miesięcy. Zapisz go jako chart.svg w tym folderze, a potem powiedz mi w jednym zdaniu, co pokazuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leia sales.csv nesta pasta e faça um gráfico de barras da receita por mês. Salve como chart.svg nesta pasta e depois me diga em uma frase o que ele mostra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Прочитай sales.csv в этой папке и построй столбчатую диаграмму выручки по месяцам. Сохрани её как chart.svg в этой папке, а затем одним предложением скажи, что она показывает."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อ่าน sales.csv ในโฟลเดอร์นี้แล้วสร้างแผนภูมิแท่งของรายได้ตามเดือน บันทึกเป็น chart.svg ในโฟลเดอร์นี้ แล้วบอกฉันในประโยคเดียวว่าแผนภูมิแสดงอะไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu klasördeki sales.csv dosyasını oku ve aylara göre gelirin sütun grafiğini yap. Bu klasöre chart.svg olarak kaydet, sonra bana tek cümleyle ne gösterdiğini söyle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Прочитай sales.csv у цій папці та побудуй стовпчасту діаграму виручки за місяцями. Збережи її як chart.svg у цій папці, а потім одним реченням скажи, що вона показує."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đọc sales.csv trong thư mục này và vẽ biểu đồ cột doanh thu theo tháng. Lưu thành chart.svg trong thư mục này, rồi cho tôi biết trong một câu biểu đồ cho thấy điều gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "读取此文件夹中的 sales.csv，制作按月收入的柱状图。在此文件夹中保存为 chart.svg，然后用一句话告诉我它说明了什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "讀取此資料夾中的 sales.csv，製作按月收入的長條圖。在此資料夾中儲存為 chart.svg，然後用一句話告訴我它說明了什麼。"
          }
        }
      }
    },
