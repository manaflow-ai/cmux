    },
    "onboarding.import.keychainNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS asks before cmux reads each browser's sign-ins."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux が各ブラウザのサインイン情報を読む前に macOS が確認します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يسألك macOS قبل أن يقرأ cmux تسجيلات الدخول لكل متصفح."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS pita prije nego što cmux pročita prijave svakog preglednika."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS spørger, før cmux læser hver browsers logins."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS fragt, bevor cmux die Anmeldungen jedes Browsers liest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS pregunta antes de que cmux lea los inicios de sesión de cada navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS demande avant que cmux lise les connexions de chaque navigateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS chiede conferma prima che cmux legga gli accessi di ogni browser."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS សួរមុនពេល cmux អានការចូលគណនីរបស់កម្មវិធីរុករកនីមួយៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux가 각 브라우저의 로그인 정보를 읽기 전에 macOS가 묻습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS spør før cmux leser påloggingene til hver nettleser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS pyta, zanim cmux odczyta logowania każdej przeglądarki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O macOS pergunta antes de o cmux ler os logins de cada navegador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS спросит, прежде чем cmux прочитает входы каждого браузера."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS จะถามก่อนที่ cmux จะอ่านการลงชื่อเข้าของแต่ละเบราว์เซอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux her tarayıcının oturum bilgilerini okumadan önce macOS sorar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS запитає, перш ніж cmux прочитає входи кожного браузера."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS hỏi trước khi cmux đọc thông tin đăng nhập của từng trình duyệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 读取各浏览器的登录信息前，macOS 会先询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 讀取各瀏覽器的登入資訊前，macOS 會先詢問。"
          }
        }
      }
    },
