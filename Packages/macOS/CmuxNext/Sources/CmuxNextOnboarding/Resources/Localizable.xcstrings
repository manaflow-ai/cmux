    "onboarding.computerUse.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents can see and use your apps when you ask them to. macOS needs two permissions for that."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للوكلاء رؤية تطبيقاتك واستخدامها عندما تطلب منهم ذلك. يحتاج macOS إلى إذنين لذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agenti mogu vidjeti i koristiti vaše aplikacije kada to zatražite. macOS za to traži dvije dozvole."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agenter kan se og bruge dine apps, når du beder dem om det. macOS kræver to tilladelser til det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents können deine Apps sehen und bedienen, wenn du sie darum bittest. macOS braucht dafür zwei Berechtigungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes pueden ver y usar tus apps cuando se lo pidas. macOS necesita dos permisos para ello."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les agents peuvent voir et utiliser vos apps quand vous le leur demandez. macOS demande deux autorisations pour cela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli agenti possono vedere e usare le tue app quando glielo chiedi. macOS richiede due autorizzazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頼んだときに、エージェントがアプリを見て操作できます。そのために macOS で 2 つの許可が必要です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ភ្នាក់ងារអាចមើល និងប្រើកម្មវិធីរបស់អ្នក ពេលអ្នកស្នើ។ macOS ត្រូវការការអនុញ្ញាតពីរសម្រាប់វា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청하면 에이전트가 앱을 보고 사용할 수 있습니다. 이를 위해 macOS 권한 두 개가 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agenter kan se og bruke appene dine når du ber dem om det. macOS trenger to tillatelser for det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agenci mogą widzieć Twoje aplikacje i z nich korzystać, gdy o to poprosisz. macOS wymaga do tego dwóch uprawnień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agentes podem ver e usar seus apps quando você pedir. O macOS precisa de duas permissões para isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Агенты могут видеть ваши приложения и работать в них, когда вы попросите. Для этого macOS нужны два разрешения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เอเจนต์จะเห็นและใช้แอปของคุณได้เมื่อคุณขอ macOS ต้องการสิทธิ์สองรายการสำหรับสิ่งนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İstediğinizde ajanlar uygulamalarınızı görebilir ve kullanabilir. macOS bunun için iki izin ister."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Агенти можуть бачити ваші застосунки й працювати в них, коли ви попросите. Для цього macOS потрібні два дозволи."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tác tử có thể xem và dùng ứng dụng của bạn khi bạn yêu cầu. macOS cần hai quyền cho việc này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你提出请求时，代理可以查看并使用你的 App。为此 macOS 需要两项权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你提出要求時，代理可以檢視並使用你的 App。為此 macOS 需要兩項權限。"
          }
        }
      }
    },
