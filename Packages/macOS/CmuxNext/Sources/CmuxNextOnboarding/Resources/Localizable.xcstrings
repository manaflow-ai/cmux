    "onboarding.welcome.themeNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux saves your pick in cmux.json. Your Ghostty config does not change."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選択内容は cmux.json に保存されます。Ghostty の設定は変更されません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحفظ cmux اختيارك في cmux.json. لا يتغير إعداد Ghostty الخاص بك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux sprema vaš izbor u cmux.json. Vaša Ghostty konfiguracija se ne mijenja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux gemmer dit valg i cmux.json. Din Ghostty-konfiguration ændres ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux speichert deine Wahl in cmux.json. Deine Ghostty-Konfiguration bleibt unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux guarda tu elección en cmux.json. Tu configuración de Ghostty no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux enregistre votre choix dans cmux.json. Votre configuration Ghostty ne change pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux salva la tua scelta in cmux.json. La configurazione di Ghostty non cambia."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux រក្សាទុកជម្រើសរបស់អ្នកក្នុង cmux.json។ ការកំណត់រចនាសម្ព័ន្ធ Ghostty របស់អ្នកមិនផ្លាស់ប្ដូរទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux는 선택 사항을 cmux.json에 저장합니다. Ghostty 설정은 변경되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux lagrer valget ditt i cmux.json. Ghostty-konfigurasjonen din endres ikke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux zapisuje Twój wybór w cmux.json. Konfiguracja Ghostty się nie zmienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cmux salva sua escolha no cmux.json. Sua configuração do Ghostty não muda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux сохраняет ваш выбор в cmux.json. Конфигурация Ghostty не меняется."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux บันทึกตัวเลือกของคุณใน cmux.json การกำหนดค่า Ghostty ของคุณจะไม่เปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux seçiminizi cmux.json dosyasına kaydeder. Ghostty yapılandırmanız değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux зберігає ваш вибір у cmux.json. Конфігурація Ghostty не змінюється."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux lưu lựa chọn của bạn trong cmux.json. Cấu hình Ghostty của bạn không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 会将你的选择保存在 cmux.json 中。你的 Ghostty 配置不会更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 會將你的選擇儲存在 cmux.json 中。你的 Ghostty 設定不會變更。"
          }
        }
      }
    },
