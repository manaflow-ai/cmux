    "onboarding.projects.privacy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب macOS الوصول إلى %@ مرة واحدة عند المتابعة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS jednom traži pristup za %@ kada nastavite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS beder én gang om adgang til %@, når du fortsætter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS fragt beim Fortfahren einmal nach Zugriff auf %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS asks once for access to %@ when you continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS pedirá acceso a %@ una vez cuando continúes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS demande une seule fois l’accès à %@ quand vous continuez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS chiede una sola volta l’accesso a %@ quando continui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けると、macOS が %@ へのアクセスを一度だけ確認します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS នឹងសុំសិទ្ធិចូលប្រើ %@ ម្តងនៅពេលអ្នកបន្ត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하면 macOS가 %@ 접근 권한을 한 번 요청합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS ber én gang om tilgang til %@ når du fortsetter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Po przejściu dalej macOS raz poprosi o dostęp do: %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O macOS pede acesso a %@ uma vez quando você continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "При продолжении macOS один раз запросит доступ к %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS จะขอสิทธิ์เข้าถึง %@ หนึ่งครั้งเมื่อคุณดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Devam ettiğinde macOS %@ erişimi için bir kez sorar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Після продовження macOS один раз попросить доступ до %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS sẽ hỏi quyền truy cập %@ một lần khi bạn tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续后，macOS 会就 %@ 的访问权限询问一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續後，macOS 會就 %@ 的存取權詢問一次。"
          }
        }
      }
    },
