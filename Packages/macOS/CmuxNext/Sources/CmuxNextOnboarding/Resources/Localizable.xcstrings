    "onboarding.projects.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجلدات عملت فيها مع وكلاء البرمجة. يُفتح كل مجلد تحتفظ به كمساحة عمل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Folderi u kojima ste radili s agentima za kodiranje. Svaki koji zadržite otvara se kao radni prostor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mapper, du har arbejdet i med kodeagenter. Hver, du beholder, åbnes som et arbejdsområde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner, in denen du mit Coding-Agents gearbeitet hast. Jeder, den du behältst, öffnet sich als Arbeitsbereich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folders you worked in with coding agents. Each one you keep opens as a workspace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carpetas en las que trabajaste con agentes de programación. Cada una que conserves se abre como espacio de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dossiers où vous avez travaillé avec des agents de code. Chacun de ceux que vous gardez s’ouvre comme espace de travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cartelle in cui hai lavorato con agenti di programmazione. Ognuna che tieni si apre come spazio di lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーディングエージェントと作業したフォルダです。残したフォルダはそれぞれワークスペースとして開きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ថតដែលអ្នកបានធ្វើការជាមួយភ្នាក់ងារសរសេរកូដ។ ថតនីមួយៗដែលអ្នករក្សាទុកនឹងបើកជាកន្លែងធ្វើការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코딩 에이전트와 작업한 폴더입니다. 유지하는 폴더는 각각 워크스페이스로 열립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mapper du har jobbet i med kodeagenter. Hver du beholder, åpnes som et arbeidsområde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Foldery, w których pracowałeś z agentami kodującymi. Każdy zachowany otworzy się jako obszar roboczy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pastas em que você trabalhou com agentes de código. Cada uma que você mantiver abre como um espaço de trabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Папки, в которых вы работали с агентами программирования. Каждая оставленная откроется как рабочее пространство."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โฟลเดอร์ที่คุณเคยทำงานร่วมกับเอเจนต์เขียนโค้ด แต่ละโฟลเดอร์ที่คุณเก็บไว้จะเปิดเป็นพื้นที่ทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kodlama ajanlarıyla çalıştığın klasörler. Tuttuğun her biri bir çalışma alanı olarak açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Папки, у яких ви працювали з агентами програмування. Кожна залишена відкриється як робочий простір."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các thư mục bạn đã làm việc cùng tác tử lập trình. Mỗi thư mục bạn giữ sẽ mở thành một không gian làm việc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你与编程智能体合作过的文件夹。保留的每个文件夹都会作为工作区打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你與程式設計代理合作過的資料夾。保留的每個資料夾都會以工作區開啟。"
          }
        }
      }
    },
