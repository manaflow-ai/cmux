    "onboarding.firstTask.noAgent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent could not start here. Skip this step and try one from a new chat later."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّر تشغيل الوكيل هنا. تخطَّ هذه الخطوة وجرّب مهمة من محادثة جديدة لاحقًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agent se ovdje nije mogao pokrenuti. Preskočite ovaj korak i kasnije isprobajte zadatak iz novog razgovora."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agenten kunne ikke starte her. Spring dette trin over, og prøv en opgave fra en ny chat senere."
