    "onboarding.firstTask.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick one. It runs for real, and you keep what it makes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اختر واحدة. ستُنفَّذ فعليًا، وتحتفظ بما تنتجه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odaberite jedan. Zaista se izvršava, a vi zadržavate rezultat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vælg en. Den kører for alvor, og du beholder resultatet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wähle eine aus. Sie läuft wirklich, und das Ergebnis gehört dir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elige una. Se ejecuta de verdad y te quedas con lo que crea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisissez-en une. Elle s’exécute pour de vrai, et vous gardez le résultat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scegline uno. Viene eseguito davvero e il risultato resta tuo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1つ選んでください。実際に実行され、作成されたものは手元に残ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ជ្រើសរើសមួយ។ វាដំណើរការពិតប្រាកដ ហើយអ្នករក្សាទុកអ្វីដែលវាបង្កើត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "하나를 고르세요. 실제로 실행되고, 만든 결과는 그대로 남습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Velg én. Den kjøres på ordentlig, og du beholder resultatet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybierz jedno. Działa naprawdę, a wynik zostaje u Ciebie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolha uma. Ela roda de verdade, e você fica com o resultado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выберите одну. Она выполняется по-настоящему, а результат остаётся у вас."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เลือกหนึ่งงาน งานจะทำงานจริง และคุณได้เก็บสิ่งที่สร้างขึ้นไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Birini seçin. Gerçekten çalışır ve ürettiği sizde kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Оберіть одне. Воно виконується насправді, а результат лишається у вас."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chọn một. Tác vụ chạy thật và bạn giữ lại kết quả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "选一个。它会真正运行，生成的内容归你所有。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選一個。它會真正執行，產生的內容歸你所有。"
          }
        }
      }
    },
