    "onboarding.import.passwordsConflicts": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "محفوظة مسبقًا بكلمة مرور مختلفة: %@. احتفظ cmux بكلمة المرور المحفوظة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Već sačuvano s drugom lozinkom: %@. cmux je zadržao sačuvanu lozinku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Allerede gemt med en anden adgangskode: %@. cmux beholdt den gemte adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bereits mit einem anderen Passwort gespeichert: %@. cmux hat das gespeicherte Passwort behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already saved with a different password: %@. cmux kept the saved password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ya guardadas con otra contraseña: %@. cmux conservó la contraseña guardada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Déjà enregistrés avec un autre mot de passe : %@. cmux a conservé le mot de passe enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Già salvate con una password diversa: %@. cmux ha mantenuto la password salvata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のパスワードで保存済み：%@件。cmuxは保存済みのパスワードを残しました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បានរក្សាទុករួចជាមួយពាក្យសម្ងាត់ផ្សេង៖ %@។ cmux បានរក្សាពាក្យសម្ងាត់ដែលបានរក្សាទុក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다른 비밀번호로 이미 저장됨: %@. cmux가 저장된 비밀번호를 유지했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Allerede lagret med et annet passord: %@. cmux beholdt det lagrede passordet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Już zapisane z innym hasłem: %@. cmux zachował zapisane hasło."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Já salvas com outra senha: %@. O cmux manteve a senha salva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Уже сохранены с другим паролем: %@. cmux оставил сохранённый пароль."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "บันทึกไว้แล้วด้วยรหัสผ่านอื่น: %@ cmux เก็บรหัสผ่านที่บันทึกไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zaten farklı bir parolayla kayıtlı: %@. cmux kayıtlı parolayı korudu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Уже збережено з іншим паролем: %@. cmux залишив збережений пароль."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã lưu với mật khẩu khác: %@. cmux giữ mật khẩu đã lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已用其他密码保存：%@。cmux 保留了已保存的密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
