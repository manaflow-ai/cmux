    "onboarding.passwords.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring saved passwords from these profiles?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "これらのプロファイルから保存済みパスワードを読み込みますか?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هل تريد جلب كلمات السر المحفوظة من هذه الملفات الشخصية؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prenijeti sačuvane lozinke iz ovih profila?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vil du hente gemte adgangskoder fra disse profiler?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gespeicherte Passwörter aus diesen Profilen übernehmen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Traer las contraseñas guardadas de estos perfiles?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importer les mots de passe enregistrés de ces profils ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Portare le password salvate da questi profili?"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "នាំយកពាក្យសម្ងាត់ដែលបានរក្សាទុកពីប្រវត្តិរូបទាំងនេះ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 프로필에서 저장된 암호를 가져올까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vil du hente lagrede passord fra disse profilene?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przenieść zapisane hasła z tych profili?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trazer as senhas salvas destes perfis?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перенести сохранённые пароли из этих профилей?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "นำรหัสผ่านที่บันทึกไว้จากโปรไฟล์เหล่านี้มาด้วยหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu profillerdeki kayıtlı parolalar getirilsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перенести збережені паролі з цих профілів?"
          }
        },
        "vi": {
          "stringUnit": {
