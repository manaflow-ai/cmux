    "onboarding.import.passwordsNotRead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some passwords weren’t imported: macOS didn’t allow the key, or the file couldn’t be read."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "一部のパスワードを読み込めませんでした。macOS が鍵の使用を許可しなかったか、ファイルを読み取れませんでした。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم تُستورد بعض كلمات السر: لم يسمح macOS بالمفتاح، أو تعذّرت قراءة الملف."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neke lozinke nisu uvezene: macOS nije dozvolio ključ ili se datoteka nije mogla pročitati."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nogle adgangskoder blev ikke importeret: macOS tillod ikke nøglen, eller filen kunne ikke læses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Einige Passwörter wurden nicht importiert: macOS hat den Schlüssel nicht freigegeben, oder die Datei war nicht lesbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Algunas contraseñas no se importaron: macOS no permitió usar la clave o no se pudo leer el archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Certains mots de passe n’ont pas été importés : macOS n’a pas autorisé la clé, ou le fichier n’a pas pu être lu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alcune password non sono state importate: macOS non ha consentito l’uso della chiave o il file non era leggibile."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ពាក្យសម្ងាត់មួយចំនួនមិនត្រូវបាននាំចូលទេ៖ macOS មិនបានអនុញ្ញាតកូនសោ ឬមិនអាចអានឯកសារបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "일부 암호를 가져오지 못했습니다. macOS가 키 사용을 허용하지 않았거나 파일을 읽을 수 없었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noen passord ble ikke importert: macOS tillot ikke nøkkelen, eller filen kunne ikke leses."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie zaimportowano niektórych haseł: macOS nie zezwolił na użycie klucza lub nie udało się odczytać pliku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Algumas senhas não foram importadas: o macOS não permitiu a chave ou o arquivo não pôde ser lido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Некоторые пароли не импортированы: macOS не разрешила использовать ключ или файл не удалось прочитать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "รหัสผ่านบางรายการไม่ถูกนำเข้า: macOS ไม่อนุญาตให้ใช้กุญแจ หรืออ่านไฟล์ไม่ได้"
