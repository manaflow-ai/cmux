    "onboarding.computerUse.accessibility.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets agents click, type and scroll in other apps."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح للوكلاء النقر والكتابة والتمرير في التطبيقات الأخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Omogućava agentima da klikću, kucaju i listaju u drugim aplikacijama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lader agenter klikke, skrive og rulle i andre apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents können in anderen Apps klicken, tippen und scrollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite a los agentes hacer clic, escribir y desplazarse en otras apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet aux agents de cliquer, saisir et faire défiler dans d’autres apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consente agli agenti di fare clic, scrivere e scorrere in altre app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントがほかのアプリでクリック、入力、スクロールできます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អនុញ្ញាតឱ្យភ្នាក់ងារចុច វាយ និងរំកិលក្នុងកម្មវិធីផ្សេងៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 다른 앱에서 클릭, 입력, 스크롤할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lar agenter klikke, skrive og rulle i andre apper."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pozwala agentom klikać, pisać i przewijać w innych aplikacjach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite que agentes cliquem, digitem e rolem em outros apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Агенты смогут нажимать, вводить текст и прокручивать в других приложениях."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ให้เอเจนต์คลิก พิมพ์ และเลื่อนในแอปอื่นได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajanların diğer uygulamalarda tıklamasına, yazmasına ve kaydırmasına izin verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Агенти зможуть натискати, вводити текст і прокручувати в інших застосунках."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cho phép tác tử bấm, gõ và cuộn trong ứng dụng khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让代理在其他 App 中点按、输入和滚动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓代理在其他 App 中點按、輸入和捲動。"
          }
        }
      }
    },
