    "onboarding.unlock.line": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some data is encrypted, so macOS will ask for your computer password to let cmux use %@ and bring it in securely."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعض البيانات مشفرة، لذلك سيطلب macOS كلمة سر الكمبيوتر للسماح لـ cmux باستخدام %@ ونقلها بأمان."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neki podaci su šifrovani, pa će macOS tražiti lozinku računara da bi cmux mogao koristiti %@ i sigurno ih prenijeti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogle data er krypteret, så macOS beder om din computers adgangskode, så cmux kan bruge %@ og hente dem sikkert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Daten sind verschlüsselt. Deshalb fragt macOS nach deinem Computerpasswort, damit cmux %@ verwenden und sie sicher übernehmen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos datos están cifrados, así que macOS te pedirá la contraseña del ordenador para que cmux use %@ y los traiga de forma segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines données sont chiffrées : macOS vous demandera le mot de passe de l’ordinateur pour que cmux utilise %@ et les importe en toute sécurité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni dati sono cifrati, quindi macOS chiederà la password del computer per consentire a cmux di usare %@ e importarli in modo sicuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のデータは暗号化されているため、cmux が %@ を使って安全に読み込めるよう、macOS がコンピュータのパスワードを求めます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ទិន្នន័យខ្លះត្រូវបានអ៊ិនគ្រីប ដូច្នេះ macOS នឹងសួររកពាក្យសម្ងាត់កុំព្យូទ័ររបស់អ្នក ដើម្បីឱ្យ cmux ប្រើ %@ និងនាំវាចូលដោយសុវត្ថិភាព។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 데이터는 암호화되어 있어, cmux가 %@ 항목을 사용해 안전하게 가져올 수 있도록 macOS가 컴퓨터 암호를 요청합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen data er kryptert, så macOS ber om datamaskinpassordet slik at cmux kan bruke %@ og hente dem trygt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Część danych jest zaszyfrowana, więc macOS poprosi o hasło komputera, aby cmux mógł użyć %@ i bezpiecznie je przenieść."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns dados são criptografados, então o macOS pedirá a senha do computador para que o cmux use %@ e os traga com segurança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть данных зашифрована, поэтому macOS запросит пароль компьютера, чтобы cmux мог использовать %@ и безопасно перенести их."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลบางส่วนถูกเข้ารหัส macOS จึงจะขอรหัสผ่านคอมพิวเตอร์ของคุณเพื่อให้ cmux ใช้ %@ และนำข้อมูลเข้ามาอย่างปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı veriler şifreli olduğundan macOS, cmux’un %@ öğesini kullanıp verileri güvenle getirebilmesi için bilgisayar parolanızı soracak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Частина даних зашифрована, тож macOS попросить пароль комп’ютера, щоб cmux міг використати %@ і безпечно перенести їх."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số dữ liệu được mã hóa, nên macOS sẽ hỏi mật khẩu máy tính để cmux dùng %@ và nhập dữ liệu một cách an toàn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分数据已加密，因此 macOS 会要求输入电脑密码，以便 cmux 使用 %@ 并安全地导入数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分資料已加密，因此 macOS 會要求輸入電腦密碼，讓 cmux 使用 %@ 並安全地輸入資料。"
          }
        }
      }
    },
