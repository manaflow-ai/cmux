          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trazer as senhas salvas destes perfis?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перенести сохранённые пароли из этих профилей?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "นำรหัสผ่านที่บันทึกไว้จากโปรไฟล์เหล่านี้มาด้วยหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
