    "onboarding.chats.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Claude Code and Codex chats, newest first. Each one you check reopens in its project, where it left off."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Chats aus Claude Code und Codex, die neuesten zuerst. Jeder markierte Chat öffnet sich in seinem Projekt dort, wo er aufgehört hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos discussions Claude Code et Codex, les plus récentes d’abord. Chaque discussion cochée se rouvre dans son projet, là où elle s’était arrêtée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محادثاتك في Claude Code وCodex، الأحدث أولاً. كل محادثة تحددها تُفتح من جديد في مشروعها من حيث توقفت."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus chats de Claude Code y Codex, los más recientes primero. Cada uno que marques se reabre en su proyecto, donde lo dejaste."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Claude Code 與 Codex 對話，最新的在前。勾選的對話會在其專案中從上次中斷處重新開啟。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Claude Code 和 Codex 对话，最新的在前。勾选的对话会在其项目中从上次中断处重新打开。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code와 Codex 대화를 최신순으로 보여 줍니다. 선택한 대화는 해당 프로젝트에서 멈춘 곳부터 다시 열립니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code と Codex のチャットを新しい順に表示します。チェックしたチャットは、そのプロジェクトで中断したところから再開します。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vaši razgovori iz Claude Codea i Codexa, najnoviji prvi. Svaki koji označite ponovo se otvara u svom projektu, tamo gdje je stao."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dine chats fra Claude Code og Codex, de nyeste først. Hver chat, du markerer, åbner igen i sit projekt, hvor den slap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le tue chat di Claude Code e Codex, dalla più recente. Ogni chat selezionata si riapre nel suo progetto, da dove era rimasta."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការជជែក Claude Code និង Codex របស់អ្នក ថ្មីបំផុតមុនគេ។ ការជជែកនីមួយៗដែលអ្នកធីក នឹងបើកឡើងវិញក្នុងគម្រោងរបស់វា ពីកន្លែងដែលវាបានឈប់។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chattene dine fra Claude Code og Codex, nyeste først. Hver chat du huker av, åpnes igjen i prosjektet sitt der den slapp."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Twoje czaty z Claude Code i Codex, od najnowszych. Każdy zaznaczony czat otworzy się ponownie w swoim projekcie, tam gdzie skończył."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seus chats do Claude Code e do Codex, do mais recente ao mais antigo. Cada um que você marcar reabre no projeto dele, de onde parou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ваши чаты Claude Code и Codex, сначала новые. Каждый отмеченный чат снова откроется в своём проекте с того места, где он остановился."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แชท Claude Code และ Codex ของคุณ เรียงจากล่าสุด แชทที่คุณเลือกจะเปิดอีกครั้งในโปรเจกต์ของมัน ต่อจากจุดที่ค้างไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Claude Code ve Codex sohbetlerin, en yenisi önce. İşaretlediğin her sohbet kendi projesinde kaldığı yerden yeniden açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ваші чати Claude Code і Codex, спершу нові. Кожен позначений чат знову відкриється у своєму проєкті з того місця, де зупинився."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các cuộc trò chuyện Claude Code và Codex của bạn, mới nhất trước. Mỗi cuộc bạn chọn sẽ mở lại trong dự án của nó, ngay chỗ đã dừng."
          }
        }
      }
    },
