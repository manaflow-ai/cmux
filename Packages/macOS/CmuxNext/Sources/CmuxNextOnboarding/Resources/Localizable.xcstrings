    "onboarding.terminal.limits": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps that start Terminal directly, such as an editor's Open in Terminal command, still do. Choose cmux in their own settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "エディタの「Terminal で開く」コマンドなど、Terminal を直接起動するアプリは引き続き Terminal を開きます。それぞれのアプリの設定で cmux を選択してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "التطبيقات التي تشغّل Terminal مباشرةً، مثل أمر «فتح في Terminal» في المحرر، ستستمر في ذلك. اختر cmux في إعداداتها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aplikacije koje direktno pokreću Terminal, kao što je naredba Open in Terminal u uređivaču, i dalje će to raditi. Odaberite cmux u njihovim postavkama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apps, der starter Terminal direkte, f.eks. en editors Åbn i Terminal-kommando, gør det stadig. Vælg cmux i deres egne indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apps, die Terminal direkt starten, etwa mit dem Befehl „In Terminal öffnen“ eines Editors, tun das weiterhin. Wähle cmux in deren eigenen Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las apps que inician Terminal directamente, como el comando «Abrir en Terminal» de un editor, lo seguirán haciendo. Elige cmux en sus propios ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les apps qui lancent Terminal directement, comme la commande « Ouvrir dans Terminal » d’un éditeur, continuent de le faire. Choisissez cmux dans leurs propres réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le app che avviano Terminal direttamente, come il comando “Apri in Terminal” di un editor, continueranno a farlo. Scegli cmux nelle loro impostazioni."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កម្មវិធីដែលចាប់ផ្ដើម Terminal ដោយផ្ទាល់ ដូចជាពាក្យបញ្ជា Open in Terminal របស់កម្មវិធីកែសម្រួល នៅតែធ្វើដូច្នោះ។ សូមជ្រើស cmux ក្នុងការកំណត់ផ្ទាល់របស់ពួកវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "편집기의 'Terminal에서 열기' 명령처럼 Terminal을 직접 실행하는 앱은 계속 Terminal을 엽니다. 해당 앱의 설정에서 cmux를 선택하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apper som starter Terminal direkte, for eksempel en redigerers Åpne i Terminal-kommando, gjør det fortsatt. Velg cmux i deres egne innstillinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aplikacje, które uruchamiają Terminal bezpośrednio (np. polecenie edytora „Otwórz w Terminal”), nadal będą to robić. Wybierz cmux w ich ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apps que iniciam o Terminal diretamente, como o comando “Abrir no Terminal” de um editor, continuarão fazendo isso. Escolha o cmux nos ajustes deles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Приложения, которые запускают Terminal напрямую (например, команда «Открыть в Terminal» в редакторе), будут делать это и дальше. Выберите cmux в их настройках."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แอปที่เปิด Terminal โดยตรง เช่น คำสั่ง Open in Terminal ของโปรแกรมแก้ไข จะยังคงเปิด Terminal เลือก cmux ในการตั้งค่าของแอปนั้นเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminal'i doğrudan başlatan uygulamalar (örneğin bir düzenleyicinin Terminal'de Aç komutu) bunu yapmaya devam eder. Kendi ayarlarında cmux'ı seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Програми, що запускають Terminal напряму (наприклад, команда «Відкрити в Terminal» у редакторі), і далі так робитимуть. Виберіть cmux у їхніх параметрах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các ứng dụng khởi động Terminal trực tiếp, chẳng hạn lệnh Mở trong Terminal của trình soạn thảo, vẫn sẽ mở Terminal. Hãy chọn cmux trong cài đặt của chính các ứng dụng đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "直接启动 Terminal 的 App（例如编辑器的“在 Terminal 中打开”命令）仍会打开 Terminal。请在这些 App 自己的设置中选择 cmux。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "直接啟動 Terminal 的 App（例如編輯器的「在 Terminal 中打開」指令）仍會打開 Terminal。請在這些 App 自己的設定中選擇 cmux。"
          }
        }
      }
    },
