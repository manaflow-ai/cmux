    "onboarding.terminal.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS has no default terminal setting. cmux can take over what opens Terminal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS にはデフォルトのターミナルの設定がありません。cmux は Terminal を開く操作を引き継げます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يحتوي macOS على إعداد للطرفية الافتراضية. يمكن لـ cmux تولي ما يفتح Terminal."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS nema postavku za zadani terminal. cmux može preuzeti ono što otvara Terminal."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS har ingen indstilling for standardterminal. cmux kan overtage det, der åbner Terminal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS hat keine Einstellung für ein Standardterminal. cmux kann übernehmen, was sonst Terminal öffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS no tiene un ajuste de terminal predeterminada. cmux puede encargarse de lo que abre Terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS n’a pas de réglage de terminal par défaut. cmux peut prendre en charge ce qui ouvre Terminal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS non ha un'impostazione per il terminale predefinito. cmux può gestire ciò che apre Terminal."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS គ្មានការកំណត់ទែមីណាល់លំនាំដើមទេ។ cmux អាចទទួលយកអ្វីដែលបើក Terminal។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS에는 기본 터미널 설정이 없습니다. cmux가 Terminal을 여는 동작을 대신할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS har ingen innstilling for standardterminal. cmux kan ta over det som åpner Terminal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS nie ma ustawienia domyślnego terminala. cmux może przejąć to, co otwiera Terminal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O macOS não tem um ajuste de terminal padrão. O cmux pode assumir o que abre o Terminal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В macOS нет настройки терминала по умолчанию. cmux может взять на себя то, что открывает Terminal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS ไม่มีการตั้งค่าเทอร์มินัลเริ่มต้น cmux สามารถรับหน้าที่สิ่งที่เปิด Terminal ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS'te varsayılan terminal ayarı yoktur. cmux, Terminal'i açan şeyleri devralabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У macOS немає параметра стандартного термінала. cmux може перебрати на себе те, що відкриває Terminal."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS không có cài đặt terminal mặc định. cmux có thể đảm nhận những gì mở Terminal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS 没有默认终端设置。cmux 可以接管打开 Terminal 的操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS 沒有預設終端機設定。cmux 可以接管打開 Terminal 的操作。"
          }
        }
      }
    },
