    "onboarding.role.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which best describes your work?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أيّ مما يلي يصف عملك على أفضل وجه؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Šta najbolje opisuje vaš posao?"
