    "onboarding.welcome.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A terminal and browser for agents, built on Ghostty. Pick a look; you can change it any time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ghostty をベースにした、エージェントのためのターミナル兼ブラウザです。外観を選んでください。いつでも変更できます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "طرفية ومتصفح للوكلاء، مبنيان على Ghostty. اختر مظهرًا؛ يمكنك تغييره في أي وقت."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminal i preglednik za agente, izgrađen na Ghosttyju. Odaberite izgled; možete ga promijeniti bilo kada."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En terminal og browser til agenter, bygget på Ghostty. Vælg et udseende; du kan altid ændre det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Terminal und Browser für Agents, basierend auf Ghostty. Wähle einen Look; du kannst ihn jederzeit ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una terminal y un navegador para agentes, basados en Ghostty. Elige un aspecto; puedes cambiarlo en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un terminal et un navigateur pour les agents, basé sur Ghostty. Choisissez un style ; vous pourrez le changer à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un terminale e un browser per agenti, basato su Ghostty. Scegli un aspetto; puoi cambiarlo in qualsiasi momento."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ទែមីណាល់ និងកម្មវិធីរុករកសម្រាប់ភ្នាក់ងារ បង្កើតលើ Ghostty។ ជ្រើសរូបរាងមួយ អ្នកអាចប្ដូរវាបានគ្រប់ពេល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ghostty 기반의 에이전트용 터미널 겸 브라우저입니다. 모양을 선택하십시오. 언제든지 변경할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En terminal og nettleser for agenter, bygd på Ghostty. Velg et utseende; du kan endre det når som helst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminal i przeglądarka dla agentów, zbudowane na Ghostty. Wybierz wygląd; możesz go zmienić w każdej chwili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um terminal e navegador para agentes, baseado no Ghostty. Escolha um visual; você pode alterá-lo a qualquer momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Терминал и браузер для агентов на основе Ghostty. Выберите оформление; его можно изменить в любое время."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เทอร์มินัลและเบราว์เซอร์สำหรับเอเจนต์ สร้างบน Ghostty เลือกรูปลักษณ์ คุณเปลี่ยนได้ทุกเมื่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ghostty üzerine kurulu, ajanlar için bir terminal ve tarayıcı. Bir görünüm seçin; istediğiniz zaman değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Термінал і браузер для агентів на основі Ghostty. Виберіть вигляд; його можна змінити будь-коли."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminal và trình duyệt dành cho tác tử, xây dựng trên Ghostty. Hãy chọn một giao diện; bạn có thể thay đổi bất cứ lúc nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "基于 Ghostty 构建、面向智能体的终端和浏览器。选择一种外观，你可以随时更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "以 Ghostty 打造、專為代理程式設計的終端機和瀏覽器。選擇一種外觀，你可以隨時更改。"
          }
        }
      }
    },
