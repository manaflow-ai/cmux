        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nhập mật khẩu đã lưu từ các trình duyệt khác của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "从你的其他浏览器导入已存储的密码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "從你的其他瀏覽器匯入已儲存的密碼"
          }
        }
      },
      "extractionState": "manual"
    },
    "onboarding.passwords.authDenied": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم تتم قراءة أي شيء: لم يكتمل التأكيد. انقر «استيراد» للمحاولة مرة أخرى، أو استورد دون كلمات السر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ništa nije pročitano: potvrda nije završena. Kliknite Uvezi da pokušate ponovo ili uvezite bez lozinki."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Intet blev læst: bekræftelsen blev ikke fuldført. Klik på Importér for at prøve igen, eller importér uden adgangskoder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es wurde nichts gelesen: Die Bestätigung wurde nicht abgeschlossen. Klicke auf „Importieren“, um es erneut zu versuchen, oder importiere ohne Passwörter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was read: the confirmation didn’t finish. Click Import to try again, or import without passwords."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se leyó nada: la confirmación no terminó. Haz clic en Importar para volver a intentarlo o importa sin contraseñas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rien n’a été lu : la confirmation n’a pas abouti. Cliquez sur Importer pour réessayer, ou importez sans les mots de passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non è stato letto nulla: la conferma non è stata completata. Fai clic su Importa per riprovare, oppure importa senza password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "何も読み込まれていません。確認が完了しませんでした。もう一度試すには「読み込む」をクリックするか、パスワードなしで読み込んでください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនបានអានអ្វីទេ៖ ការបញ្ជាក់មិនបានបញ្ចប់។ ចុច Import ដើម្បីសាកម្តងទៀត ឬនាំចូលដោយគ្មានពាក្យសម្ងាត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "아무것도 읽지 않았습니다. 확인이 완료되지 않았습니다. 다시 시도하려면 가져오기를 클릭하거나 암호 없이 가져오세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingenting ble lest: bekreftelsen ble ikke fullført. Klikk Importer for å prøve igjen, eller importer uten passord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nic nie zostało odczytane: potwierdzenie się nie zakończyło. Kliknij Importuj, aby spróbować ponownie, lub zaimportuj bez haseł."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nada foi lido: a confirmação não terminou. Clique em Importar para tentar de novo ou importe sem as senhas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ничего не прочитано: подтверждение не завершено. Нажмите «Импортировать», чтобы повторить, или импортируйте без паролей."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังไม่มีการอ่านข้อมูลใด ๆ: การยืนยันไม่เสร็จสมบูรณ์ คลิก นำเข้า เพื่อลองอีกครั้ง หรือนำเข้าโดยไม่รวมรหัสผ่าน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hiçbir şey okunmadı: onay tamamlanmadı. Yeniden denemek için İçe Aktar’ı tıklayın veya parolalar olmadan içe aktarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Нічого не прочитано: підтвердження не завершено. Натисніть «Імпортувати», щоб спробувати ще раз, або імпортуйте без паролів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chưa đọc gì cả: việc xác nhận chưa hoàn tất. Nhấp Nhập để thử lại, hoặc nhập mà không có mật khẩu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未读取任何内容：确认未完成。点按“导入”重试，或不含密码导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未讀取任何內容：確認未完成。按一下「匯入」再試一次，或不含密碼匯入。"
          }
        }
      },
      "extractionState": "manual"
    },
    "onboarding.passwords.store": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They go into cmux’s own encrypted password store, where autofill finds them. Agents never see them, and nothing is read until you click Import."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "パスワードは cmux 専用の暗号化されたパスワード保存先に入り、自動入力で使われます。エージェントがそれを見ることはなく、「読み込む」をクリックするまで何も読み取りません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُحفظ في مخزن كلمات السر المشفّر الخاص بـ cmux، حيث يجدها الملء التلقائي. لا يراها الوكلاء أبدًا، ولا يُقرأ شيء حتى تنقر على «استيراد»."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Idu u cmuxovo vlastito šifrirano spremište lozinki, gdje ih automatsko popunjavanje pronalazi. Agenti ih nikad ne vide, a ništa se ne čita dok ne kliknete Uvezi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De lægges i cmux’ eget krypterede adgangskodelager, hvor autoudfyld finder dem. Agenter ser dem aldrig, og intet læses, før du klikker på Importér."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sie landen im eigenen verschlüsselten Passwortspeicher von cmux, aus dem das automatische Ausfüllen liest. Agents sehen sie nie, und nichts wird gelesen, bevor du auf „Importieren“ klickst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se guardan en el almacén de contraseñas cifrado propio de cmux, donde el autorrelleno las encuentra. Los agentes nunca las ven, y no se lee nada hasta que haces clic en Importar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ils vont dans le stockage chiffré de mots de passe propre à cmux, où le remplissage automatique les trouve. Les agents ne les voient jamais, et rien n’est lu avant que vous cliquiez sur Importer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Finiscono nell’archivio cifrato di password di cmux, dove le trova la compilazione automatica. Gli agenti non le vedono mai e non viene letto nulla finché non fai clic su Importa."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "វាត្រូវបានដាក់ក្នុងឃ្លាំងពាក្យសម្ងាត់ដែលបានអ៊ិនគ្រីបរបស់ cmux ដែលការបំពេញស្វ័យប្រវត្តិរកឃើញ។ ភ្នាក់ងារមិនដែលឃើញវាទេ ហើយគ្មានអ្វីត្រូវបានអានទេ រហូតដល់អ្នកចុច នាំចូល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "암호는 cmux 자체의 암호화된 암호 저장소에 들어가며, 자동 완성이 여기서 찾습니다. 에이전트는 절대 볼 수 없으며, 가져오기를 클릭하기 전에는 아무것도 읽지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De havner i cmux’ eget krypterte passordlager, der autoutfylling finner dem. Agenter ser dem aldri, og ingenting leses før du klikker på Importer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trafiają do własnego, zaszyfrowanego magazynu haseł cmux, z którego korzysta autouzupełnianie. Agenci nigdy ich nie widzą, a nic nie jest odczytywane, dopóki nie klikniesz Importuj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elas vão para o armazenamento de senhas criptografado do próprio cmux, onde o preenchimento automático as encontra. Agentes nunca as veem, e nada é lido até você clicar em Importar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Они попадают в собственное зашифрованное хранилище паролей cmux, откуда их берёт автозаполнение. Агенты их никогда не видят, и ничего не читается, пока вы не нажмёте «Импортировать»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "รหัสผ่านจะถูกเก็บในที่เก็บรหัสผ่านที่เข้ารหัสของ cmux เอง ซึ่งการป้อนอัตโนมัติใช้ เอเจนต์จะไม่เห็นรหัสผ่านเลย และจะไม่มีการอ่านสิ่งใดจนกว่าคุณจะคลิก นำเข้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Parolalar, otomatik doldurmanın kullandığı cmux’ın kendi şifreli parola deposuna gider. Ajanlar bunları asla görmez ve İçe Aktar’ı tıklayana kadar hiçbir şey okunmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вони потрапляють до власного зашифрованого сховища паролів cmux, звідки їх бере автозаповнення. Агенти їх ніколи не бачать, і нічого не читається, доки ви не натиснете «Імпортувати»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mật khẩu được đưa vào kho mật khẩu mã hóa riêng của cmux, nơi tính năng tự động điền tìm thấy chúng. Các agent không bao giờ thấy chúng, và không có gì được đọc cho đến khi bạn bấm Nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "密码会存入 cmux 自己的加密密码库,自动填充从这里读取。智能体永远看不到它们,在你点按“导入”之前不会读取任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "密碼會存入 cmux 自己的加密密碼庫,自動填寫從這裡讀取。代理程式永遠看不到它們,在你按下「匯入」之前不會讀取任何內容。"
          }
        }
      }
    },
