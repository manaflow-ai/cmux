    "onboarding.accounts.subtitle2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-ins cmux found on this Mac. Nothing is uploaded unless you choose Connect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac で見つかったサインインです。「接続」を選ぶまで何もアップロードされません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تسجيلات الدخول التي وجدها cmux على هذا الـ Mac. لا يُرفع شيء ما لم تختر الاتصال."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prijave koje je cmux našao na ovom Macu. Ništa se ne šalje dok ne odaberete Poveži."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Logins, cmux fandt på denne Mac. Intet uploades, medmindre du vælger Forbind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anmeldungen, die cmux auf diesem Mac gefunden hat. Nichts wird hochgeladen, bevor Sie „Verbinden“ wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inicios de sesión que cmux encontró en este Mac. No se sube nada salvo que elijas Conectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connexions trouvées par cmux sur ce Mac. Rien n’est envoyé sauf si vous choisissez Connecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Accessi trovati da cmux su questo Mac. Nulla viene caricato finché non scegli Connetti."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការចូលគណនីដែល cmux រកឃើញនៅលើ Mac នេះ។ គ្មានអ្វីត្រូវបានផ្ទុកឡើងទេ លុះត្រាតែអ្នកជ្រើស ភ្ជាប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux가 이 Mac에서 찾은 로그인입니다. 연결을 선택하기 전에는 아무것도 업로드되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pålogginger cmux fant på denne Macen. Ingenting lastes opp før du velger Koble til."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Logowania znalezione przez cmux na tym Macu. Nic nie jest wysyłane, dopóki nie wybierzesz Połącz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Logins que o cmux encontrou neste Mac. Nada é enviado a menos que você escolha Conectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Входы, найденные cmux на этом Mac. Ничего не отправляется, пока вы не выберете «Подключить»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การลงชื่อเข้าที่ cmux พบใน Mac เครื่องนี้ จะไม่มีการอัปโหลดจนกว่าคุณจะเลือกเชื่อมต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux'un bu Mac'te bulduğu oturumlar. Bağlan'ı seçmedikçe hiçbir şey yüklenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Входи, знайдені cmux на цьому Mac. Нічого не надсилається, доки ви не виберете «Підключити»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các thông tin đăng nhập cmux tìm thấy trên máy Mac này. Không có gì được tải lên trừ khi bạn chọn Kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 在这台 Mac 上找到的登录信息。除非你选择“连接”，否则不会上传任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 在這台 Mac 上找到的登入資訊。除非你選擇「連接」，否則不會上傳任何內容。"
          }
        }
      }
    },
