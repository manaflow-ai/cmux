    "onboarding.passwords.keychain2": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يطلب منك الاستيراد التأكيد باستخدام Touch ID أو كلمة السر. بعد ذلك يسأل macOS عمّا إذا كان يمكن لـ cmux استخدام %@، وهو عنصر سلسلة المفاتيح الذي يقفل به المتصفح كلمات السر المحفوظة. اختر «السماح»، وسيفتحها cmux مرة واحدة على هذا الـ Mac."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uvoz traži da potvrdite pomoću Touch ID-a ili lozinke. Zatim macOS pita smije li cmux koristiti %@, stavku privjeska ključeva kojom preglednik zaključava sačuvane lozinke. Odaberite Dozvoli i cmux ih otključava jednom, na ovom Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Import beder dig bekræfte med Touch ID eller din adgangskode. Derefter spørger macOS, om cmux må bruge %@, nøgleringsemnet, som browseren låser sine gemte adgangskoder med. Vælg Tillad, så låser cmux dem op én gang på denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beim Import bestätigst du mit Touch ID oder deinem Passwort. Danach fragt macOS, ob cmux %@ verwenden darf, den Schlüsselbundeintrag, mit dem der Browser seine gespeicherten Passwörter verschlüsselt. Wähle „Erlauben“, dann entschlüsselt cmux sie einmalig auf diesem Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import asks you to confirm with Touch ID or your password. Then macOS asks whether cmux may use %@, the Keychain item the browser locks its saved passwords with. Choose Allow, and cmux unlocks them once, on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Al importar se te pide confirmar con Touch ID o tu contraseña. Después, macOS pregunta si cmux puede usar %@, el ítem del llavero con el que el navegador protege sus contraseñas guardadas. Elige Permitir y cmux las desbloquea una vez, en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’importation vous demande de confirmer avec Touch ID ou votre mot de passe. macOS demande ensuite si cmux peut utiliser %@, l’élément du trousseau avec lequel le navigateur verrouille ses mots de passe enregistrés. Choisissez Autoriser et cmux les déverrouille une fois, sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’importazione ti chiede di confermare con Touch ID o la password. Poi macOS chiede se cmux può usare %@, l’elemento del portachiavi con cui il browser protegge le password salvate. Scegli Consenti e cmux le sblocca una volta, su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "読み込むときに Touch ID またはパスワードで確認します。続いて macOS が、cmux に %@ の使用を許可するか尋ねます。これはブラウザが保存済みパスワードを保護しているキーチェーン項目です。「許可」を選ぶと、cmux はこの Mac 上で一度だけそれを解除します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការនាំចូលនឹងសុំឲ្យអ្នកបញ្ជាក់ដោយ Touch ID ឬពាក្យសម្ងាត់របស់អ្នក។ បន្ទាប់មក macOS សួរថាតើ cmux អាចប្រើ %@ បានឬទេ ដែលជាធាតុ Keychain ដែលកម្មវិធីរុករកប្រើចាក់សោពាក្យសម្ងាត់ដែលបានរក្សាទុក។ ជ្រើស Allow ហើយ cmux នឹងដោះសោវាម្តងគត់ នៅលើ Mac នេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "가져오기를 하면 Touch ID 또는 암호로 확인하라는 요청이 표시됩니다. 그런 다음 macOS가 cmux에서 %@을(를) 사용해도 되는지 묻습니다. 이 키체인 항목은 브라우저가 저장된 암호를 잠그는 데 쓰는 키입니다. 허용을 선택하면 cmux가 이 Mac에서 한 번만 잠금을 해제합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importen ber deg bekrefte med Touch ID eller passordet ditt. Deretter spør macOS om cmux kan bruke %@, nøkkelringobjektet nettleseren låser de lagrede passordene sine med. Velg Tillat, så låser cmux dem opp én gang på denne Macen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Import poprosi o potwierdzenie za pomocą Touch ID lub hasła. Następnie macOS zapyta, czy cmux może użyć %@, czyli elementu pęku kluczy, którym przeglądarka chroni zapisane hasła. Wybierz Zezwól, a cmux odblokuje je jednorazowo na tym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A importação pede que você confirme com o Touch ID ou sua senha. Depois, o macOS pergunta se o cmux pode usar %@, o item das Chaves com que o navegador protege as senhas salvas. Escolha Permitir e o cmux as desbloqueia uma vez, neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "При импорте нужно подтвердить действие с помощью Touch ID или пароля. Затем macOS спросит, может ли cmux использовать %@ — объект связки ключей, которым браузер защищает сохранённые пароли. Выберите «Разрешить», и cmux разблокирует их один раз на этом Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การนำเข้าจะขอให้คุณยืนยันด้วย Touch ID หรือรหัสผ่าน จากนั้น macOS จะถามว่า cmux ใช้ %@ ได้หรือไม่ ซึ่งเป็นรายการพวงกุญแจที่เบราว์เซอร์ใช้ล็อกรหัสผ่านที่บันทึกไว้ เลือก อนุญาต แล้ว cmux จะปลดล็อกเพียงครั้งเดียวบน Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İçe aktarma, Touch ID veya parolanızla onaylamanızı ister. Ardından macOS, cmux’un %@ öğesini kullanıp kullanamayacağını sorar; bu, tarayıcının kayıtlı parolalarını kilitlediği Anahtar Zinciri öğesidir. İzin Ver’i seçin, cmux bunları bu Mac’te bir kez açar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Під час імпорту потрібно підтвердити дію за допомогою Touch ID або пароля. Потім macOS запитає, чи може cmux використати %@ — об’єкт зв’язки ключів, яким браузер захищає збережені паролі. Виберіть «Дозволити», і cmux розблокує їх один раз на цьому Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khi nhập, bạn sẽ được yêu cầu xác nhận bằng Touch ID hoặc mật khẩu. Sau đó macOS hỏi cmux có được dùng %@ không, đây là mục Chuỗi khóa mà trình duyệt dùng để khóa các mật khẩu đã lưu. Chọn Cho phép, và cmux sẽ mở khóa chúng một lần trên máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "导入时会请你用触控 ID 或密码确认。随后 macOS 会询问是否允许 cmux 使用 %@，这是浏览器用来锁定已存储密码的钥匙串项目。选择“允许”，cmux 会在这台 Mac 上解锁一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "匯入時會請你用 Touch ID 或密碼確認。接著 macOS 會詢問是否允許 cmux 使用 %@，這是瀏覽器用來鎖定已儲存密碼的鑰匙圈項目。選擇「允許」，cmux 會在這台 Mac 上解鎖一次。"
          }
        }
      },
      "extractionState": "manual"
    },
