        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "តើអ្វីពិពណ៌នាការងាររបស់អ្នកបានល្អបំផុត?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "어떤 일을 하시나요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hva beskriver arbeidet ditt best?"
