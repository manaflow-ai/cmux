        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bana cmux’a başlamak için üç ipucu içeren kısa ve samimi bir karşılama notu yaz. Bu klasöre welcome-note.md olarak kaydet."
          }
        },
        "uk": {
