    "onboarding.computerUse.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents can use your apps when you ask them to."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للوكلاء استخدام تطبيقاتك عندما تطلب منهم ذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenti mogu koristiti vaše aplikacije kada ih to zatražite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenter kan bruge dine apps, når du beder dem om det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents können deine Apps nutzen, wenn du sie darum bittest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes pueden usar tus apps cuando se lo pidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les agents peuvent utiliser vos apps quand vous le leur demandez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli agenti possono usare le tue app quando glielo chiedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頼んだときに、エージェントがあなたのアプリを使えます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្នាក់ងារអាចប្រើកម្មវិធីរបស់អ្នក នៅពេលអ្នកស្នើ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청하면 에이전트가 앱을 사용할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenter kan bruke appene dine når du ber dem om det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenci mogą używać Twoich aplikacji, gdy o to poprosisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os agentes podem usar seus apps quando você pedir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты смогут работать в ваших приложениях, когда вы попросите."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์ใช้แอปของคุณได้เมื่อคุณขอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanlar, istediğinizde uygulamalarınızı kullanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенти зможуть працювати у ваших застосунках, коли ви попросите."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác tử có thể dùng ứng dụng của bạn khi bạn yêu cầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
