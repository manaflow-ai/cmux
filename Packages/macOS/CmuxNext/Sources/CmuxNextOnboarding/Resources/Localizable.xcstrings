    "onboarding.import.extensions.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extensions install from the Chrome Web Store. Open each one and click Add to Chrome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "拡張機能は Chrome ウェブストアからインストールします。それぞれを開いて「Chrome に追加」をクリックしてください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُثبَّت الامتدادات من Chrome Web Store. افتح كل واحد وانقر على «إضافة إلى Chrome»."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ekstenzije se instaliraju iz Chrome Web Storea. Otvorite svaku i kliknite Dodaj u Chrome."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Udvidelser installeres fra Chrome Web Store. Åbn hver enkelt, og klik på Føj til Chrome."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erweiterungen werden aus dem Chrome Web Store installiert. Öffne jede einzelne und klicke auf „Zu Chrome hinzufügen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las extensiones se instalan desde Chrome Web Store. Abre cada una y haz clic en «Añadir a Chrome»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les extensions s’installent depuis le Chrome Web Store. Ouvrez chacune d’elles et cliquez sur « Ajouter à Chrome »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le estensioni si installano dal Chrome Web Store. Apri ciascuna e fai clic su “Aggiungi a Chrome”."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កម្មវិធីបន្ថែមដំឡើងពី Chrome Web Store។ បើកនីមួយៗ ហើយចុច \"Add to Chrome\"។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "확장 프로그램은 Chrome 웹 스토어에서 설치됩니다. 각 확장 프로그램을 열고 'Chrome에 추가'를 클릭하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utvidelser installeres fra Chrome Web Store. Åpne hver av dem og klikk på Legg til i Chrome."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rozszerzenia instaluje się z Chrome Web Store. Otwórz każde z nich i kliknij „Dodaj do Chrome”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As extensões são instaladas pela Chrome Web Store. Abra cada uma e clique em “Usar no Chrome”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Расширения устанавливаются из Chrome Web Store. Откройте каждое и нажмите «Установить»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ส่วนขยายติดตั้งจาก Chrome Web Store เปิดแต่ละรายการแล้วคลิก เพิ่มใน Chrome"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uzantılar Chrome Web Store'dan yüklenir. Her birini açın ve \"Chrome'a ekle\"yi tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Розширення встановлюються з Chrome Web Store. Відкрийте кожне й натисніть «Додати в Chrome»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiện ích mở rộng được cài từ Cửa hàng Chrome trực tuyến. Mở từng tiện ích và bấm \"Thêm vào Chrome\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "扩展需从 Chrome 应用商店安装。请逐个打开并点按“添加至 Chrome”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "延伸功能需從 Chrome 線上應用程式商店安裝。請逐一打開並按一下「加到 Chrome」。"
          }
        }
      }
    },
