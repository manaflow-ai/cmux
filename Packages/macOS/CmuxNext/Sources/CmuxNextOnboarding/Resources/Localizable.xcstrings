    "onboarding.classicSessions.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import names, folders, tabs and split layouts from classic cmux. Saved commands are never run."
          }
        },
        "de": {
          "stringUnit": {
