    "onboarding.access.panelMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select “Allow Access” to let cmux read your %@ data."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر “السماح بالوصول” للسماح لـ cmux بقراءة بيانات %@."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite „Dozvoli pristup“ da cmux može čitati vaše podatke iz %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg “Giv adgang” for at lade cmux læse dine data fra %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle „Zugriff erlauben“, damit cmux deine %@-Daten lesen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona «Permitir acceso» para que cmux lea tus datos de %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez « Autoriser l’accès » pour que cmux lise vos données %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona «Consenti accesso» per permettere a cmux di leggere i tuoi dati di %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アクセスを許可」を選択すると、cmux が %@ のデータを読み取れるようになります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ជ្រើសរើស «អនុញ្ញាតការចូលប្រើ» ដើម្បីឱ្យ cmux អានទិន្នន័យ %@ របស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘접근 허용’을 선택하면 cmux가 %@ 데이터를 읽을 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg «Gi tilgang» for å la cmux lese dataene dine fra %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz „Zezwól na dostęp”, aby cmux mógł odczytać dane z %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione “Permitir acesso” para que o cmux leia seus dados do %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите «Разрешить доступ», чтобы cmux мог прочитать ваши данные %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือก “อนุญาตการเข้าถึง” เพื่อให้ cmux อ่านข้อมูล %@ ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux’un %@ verilerinizi okuyabilmesi için “Erişime İzin Ver”i seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть «Дозволити доступ», щоб cmux міг читати ваші дані %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn “Cho phép truy cập” để cmux đọc dữ liệu %@ của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“允许访问”以让 cmux 读取你的 %@ 数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇「允許取用」以讓 cmux 讀取你的 %@ 資料。"
          }
        }
      }
    },
    "onboarding.access.step2.open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. In the file picker, open this folder and choose Allow Access:"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "2. في منتقي الملفات، افتح هذا المجلد واختر السماح بالوصول:"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "2. U biraču datoteka otvorite ovu mapu i odaberite Dozvoli pristup:"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Åbn denne mappe i filvælgeren, og vælg Giv adgang:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Öffne in der Dateiauswahl diesen Ordner und wähle „Zugriff erlauben“:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "2. En el selector de archivos, abre esta carpeta y elige Permitir acceso:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Dans le sélecteur de fichiers, ouvrez ce dossier et choisissez Autoriser l’accès :"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Nel selettore di file, apri questa cartella e scegli Consenti accesso:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2. ファイルピッカーでこのフォルダを開き、「アクセスを許可」を選択します:"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "2. នៅក្នុងកម្មវិធីជ្រើសឯកសារ បើកថតនេះ ហើយជ្រើសរើស អនុញ្ញាតការចូលប្រើ៖"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 파일 선택기에서 이 폴더를 열고 접근 허용을 선택합니다:"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Åpne denne mappen i filvelgeren, og velg Gi tilgang:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "2. W oknie wyboru plików otwórz ten folder i wybierz Zezwól na dostęp:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "2. No seletor de arquivos, abra esta pasta e escolha Permitir acesso:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "2. В окне выбора файлов откройте эту папку и выберите «Разрешить доступ»:"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "2. ในตัวเลือกไฟล์ ให้เปิดโฟลเดอร์นี้ แล้วเลือก อนุญาตการเข้าถึง:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Dosya seçicide bu klasörü açın ve Erişime İzin Ver’i seçin:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "2. У вікні вибору файлів відкрийте цю папку й виберіть «Дозволити доступ»:"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Trong bộ chọn tệp, mở thư mục này và chọn Cho phép truy cập:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 在文件选择器中打开此文件夹，然后选择“允许访问”："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 在檔案選擇器中打開此檔案夾，然後選擇「允許取用」："
          }
        }
      }
    },
    "dialog.sessionLink.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Open Agent Session in a New Tab?"}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "هل تريد فتح جلسة الوكيل في علامة تبويب جديدة؟"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Otvoriti sesiju agenta u novoj kartici?"}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Åbn agentsession i en ny fane?"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Agentensitzung in neuem Tab öffnen?"}},
        "es": {"stringUnit": {"state": "needs_review", "value": "¿Abrir la sesión del agente en una pestaña nueva?"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Ouvrir la session de l’agent dans un nouvel onglet ?"}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Aprire la sessione dell’agente in una nuova scheda?"}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "エージェントのセッションを新しいタブで開きますか？"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "បើកវគ្គភ្នាក់ងារក្នុងផ្ទាំងថ្មី?"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "에이전트 세션을 새 탭에서 여시겠습니까?"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Åpne agentøkten i en ny fane?"}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Otworzyć sesję agenta w nowej karcie?"}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Abrir a sessão do agente em uma nova aba?"}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Открыть сеанс агента в новой вкладке?"}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เปิดเซสชันของเอเจนต์ในแท็บใหม่หรือไม่"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Ajan oturumu yeni sekmede açılsın mı?"}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Відкрити сеанс агента в новій вкладці?"}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Mở phiên tác nhân trong thẻ mới?"}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "要在新标签页中打开代理会话吗？"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "要在新分頁中開啟代理工作階段嗎？"}}
      }
    },
    "dialog.sessionLink.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "A link wants to open the session “%@” in a new tab."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "يريد رابط فتح الجلسة “%@” في علامة تبويب جديدة."}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Link želi otvoriti sesiju „%@“ u novoj kartici."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Et link vil åbne sessionen “%@” i en ny fane."}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Ein Link möchte die Sitzung „%@“ in einem neuen Tab öffnen."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Un enlace quiere abrir la sesión «%@» en una pestaña nueva."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Un lien veut ouvrir la session « %@ » dans un nouvel onglet."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Un link vuole aprire la sessione “%@” in una nuova scheda."}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "リンクがセッション「%@」を新しいタブで開こうとしています。"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "តំណមួយចង់បើកវគ្គ “%@” ក្នុងផ្ទាំងថ្មី។"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "링크에서 세션 “%@”을(를) 새 탭에서 열려고 합니다."}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "En lenke vil åpne økten «%@» i en ny fane."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Link chce otworzyć sesję „%@” w nowej karcie."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Um link quer abrir a sessão “%@” em uma nova aba."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Ссылка хочет открыть сеанс «%@» в новой вкладке."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ลิงก์ต้องการเปิดเซสชัน “%@” ในแท็บใหม่"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Bir bağlantı “%@” oturumunu yeni bir sekmede açmak istiyor."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Посилання хоче відкрити сеанс «%@» у новій вкладці."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Một liên kết muốn mở phiên “%@” trong thẻ mới."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "有链接想在新标签页中打开会话“%@”。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "有連結想在新分頁中開啟工作階段「%@」。"}}
      }
    },
    "dialog.sessionLink.warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "cmux cannot tell which page or app opened the link. Only continue if you opened it yourself."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "لا يستطيع cmux معرفة الصفحة أو التطبيق الذي فتح الرابط. لا تتابع إلا إذا فتحته بنفسك."}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "cmux ne može znati koja je stranica ili aplikacija otvorila link. Nastavite samo ako ste ga sami otvorili."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "cmux kan ikke se, hvilken side eller app der åbnede linket. Fortsæt kun, hvis du selv åbnede det."}},
        "de": {"stringUnit": {"state": "needs_review", "value": "cmux kann nicht erkennen, welche Seite oder App den Link geöffnet hat. Fahren Sie nur fort, wenn Sie ihn selbst geöffnet haben."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "cmux no puede saber qué página o app abrió el enlace. Continúa solo si lo abriste tú."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "cmux ne peut pas savoir quelle page ou quelle app a ouvert le lien. Ne continuez que si vous l’avez ouvert vous-même."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "cmux non può sapere quale pagina o app ha aperto il link. Continua solo se lo hai aperto tu."}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "cmux はどのページやアプリがリンクを開いたかを判別できません。自分で開いた場合のみ続行してください。"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "cmux មិនអាចដឹងថាទំព័រ ឬកម្មវិធីណាបានបើកតំណនោះទេ។ សូមបន្តតែនៅពេលអ្នកបានបើកវាដោយខ្លួនឯងប៉ុណ្ណោះ។"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "cmux는 어떤 페이지나 앱이 링크를 열었는지 알 수 없습니다. 직접 연 경우에만 계속하세요."}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "cmux kan ikke se hvilken side eller app som åpnet lenken. Fortsett bare hvis du åpnet den selv."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "cmux nie może ustalić, która strona lub aplikacja otworzyła link. Kontynuuj tylko wtedy, gdy otworzyłeś go sam."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "O cmux não consegue saber qual página ou app abriu o link. Continue somente se você mesmo o abriu."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "cmux не может определить, какая страница или приложение открыли ссылку. Продолжайте, только если вы открыли её сами."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "cmux ไม่สามารถทราบได้ว่าหน้าเว็บหรือแอปใดเปิดลิงก์นี้ ดำเนินการต่อเฉพาะเมื่อคุณเปิดเองเท่านั้น"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "cmux bağlantıyı hangi sayfanın veya uygulamanın açtığını bilemez. Yalnızca bağlantıyı kendiniz açtıysanız devam edin."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "cmux не може визначити, яка сторінка чи програма відкрила посилання. Продовжуйте, лише якщо ви відкрили його самі."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "cmux không thể biết trang hoặc ứng dụng nào đã mở liên kết. Chỉ tiếp tục nếu chính bạn đã mở nó."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "cmux 无法判断是哪个页面或应用打开了此链接。只有在你亲自打开时才继续。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "cmux 無法判斷是哪個網頁或 App 開啟了此連結。只有在您親自開啟時才繼續。"}}
      }
    },
