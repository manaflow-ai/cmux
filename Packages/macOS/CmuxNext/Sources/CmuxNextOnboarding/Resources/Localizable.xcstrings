    "onboarding.import.secretsNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwords and cookies are not imported yet: they need Chromium's own importer, which cmux does not include yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "パスワードと Cookie はまだ読み込めません。Chromium 独自の読み込み機能が必要ですが、cmux にはまだ含まれていません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يتم استيراد كلمات السر وملفات تعريف الارتباط بعد: فهي تحتاج إلى أداة الاستيراد الخاصة بـ Chromium، والتي لا يتضمنها cmux بعد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lozinke i kolačići se još ne uvoze: za njih je potreban Chromiumov vlastiti alat za uvoz, koji cmux još ne sadrži."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adgangskoder og cookies importeres ikke endnu: de kræver Chromiums egen importfunktion, som cmux ikke indeholder endnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Passwörter und Cookies werden noch nicht importiert: Dafür ist der eigene Importer von Chromium nötig, den cmux noch nicht enthält."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las contraseñas y las cookies aún no se importan: necesitan el importador propio de Chromium, que cmux todavía no incluye."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les mots de passe et les cookies ne sont pas encore importés : ils nécessitent l’outil d’importation propre à Chromium, que cmux n’inclut pas encore."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Password e cookie non vengono ancora importati: richiedono l'importatore di Chromium, che cmux non include ancora."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ពាក្យសម្ងាត់ និងខូគីមិនទាន់ត្រូវបាននាំចូលនៅឡើយទេ៖ ពួកវាត្រូវការកម្មវិធីនាំចូលផ្ទាល់របស់ Chromium ដែល cmux មិនទាន់មាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "암호와 쿠키는 아직 가져올 수 없습니다. Chromium 자체 가져오기 도구가 필요하지만 cmux에는 아직 포함되어 있지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Passord og informasjonskapsler importeres ikke ennå: de krever Chromiums egen importfunksjon, som cmux ikke har ennå."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hasła i pliki cookie nie są jeszcze importowane: wymagają własnego importera Chromium, którego cmux jeszcze nie zawiera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Senhas e cookies ainda não são importados: eles precisam do importador próprio do Chromium, que o cmux ainda não inclui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пароли и файлы cookie пока не импортируются: для них нужен собственный импортер Chromium, которого в cmux еще нет."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังไม่มีการนำเข้ารหัสผ่านและคุกกี้ เนื่องจากต้องใช้ตัวนำเข้าของ Chromium เอง ซึ่ง cmux ยังไม่มี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Parolalar ve çerezler henüz içe aktarılmıyor: Chromium'un kendi içe aktarıcısı gerekir ve cmux bunu henüz içermiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Паролі й файли cookie поки не імпортуються: для них потрібен власний імпортер Chromium, якого в cmux ще немає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mật khẩu và cookie chưa được nhập: chúng cần trình nhập riêng của Chromium, mà cmux chưa có."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "暂不导入密码和 Cookie：这需要 Chromium 自身的导入器，而 cmux 目前尚未包含。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "暫不匯入密碼和 Cookie：這需要 Chromium 本身的匯入工具，而 cmux 目前尚未包含。"
          }
        }
      }
    },
    "onboarding.import.profilesNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything goes to your default browser profile, labeled by source, so it can move to its own profile later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "すべてデフォルトのブラウザプロファイルに読み込まれ、読み込み元のラベルが付きます。あとで専用のプロファイルに移動できます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ينتقل كل شيء إلى ملف المتصفح الشخصي الافتراضي، مع تسمية حسب المصدر، ليمكن نقله إلى ملف شخصي خاص به لاحقًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sve ide u vaš zadani profil preglednika, označeno prema izvoru, kako bi se kasnije moglo premjestiti u vlastiti profil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alt lægges i din standardbrowserprofil, mærket efter kilde, så det senere kan flyttes til sin egen profil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alles landet in deinem Standard-Browserprofil, nach Quelle beschriftet, damit es später in ein eigenes Profil verschoben werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todo va a tu perfil de navegador predeterminado, etiquetado por origen, para que pueda moverse a su propio perfil más adelante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tout va dans votre profil de navigateur par défaut, étiqueté par source, afin de pouvoir être déplacé plus tard vers son propre profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tutto finisce nel profilo browser predefinito, etichettato per origine, così potrà essere spostato in un profilo dedicato in seguito."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អ្វីៗទាំងអស់ទៅកាន់ប្រវត្តិរូបកម្មវិធីរុករកលំនាំដើមរបស់អ្នក ដោយដាក់ស្លាកតាមប្រភព ដើម្បីអាចផ្លាស់ទីទៅប្រវត្តិរូបផ្ទាល់ខ្លួនពេលក្រោយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "모든 항목은 출처별로 레이블이 지정되어 기본 브라우저 프로필로 가져오므로 나중에 별도의 프로필로 옮길 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alt legges i standard nettleserprofil, merket etter kilde, slik at det senere kan flyttes til en egen profil."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wszystko trafia do domyślnego profilu przeglądarki z oznaczeniem źródła, aby później można było przenieść to do osobnego profilu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tudo vai para o seu perfil de navegador padrão, identificado pela origem, para que possa ser movido para um perfil próprio depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Все попадает в ваш профиль браузера по умолчанию с пометкой источника, чтобы позже это можно было перенести в отдельный профиль."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ทุกอย่างจะไปอยู่ในโปรไฟล์เบราว์เซอร์เริ่มต้นของคุณ โดยติดป้ายตามแหล่งที่มา เพื่อให้ย้ายไปยังโปรไฟล์ของตัวเองได้ภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her şey, kaynağına göre etiketlenerek varsayılan tarayıcı profilinize gider; böylece daha sonra kendi profiline taşınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Усе потрапляє до вашого стандартного профілю браузера з позначкою джерела, щоб згодом це можна було перенести в окремий профіль."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mọi thứ được đưa vào hồ sơ trình duyệt mặc định, gắn nhãn theo nguồn, để sau này có thể chuyển sang hồ sơ riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "所有内容都会导入你的默认浏览器描述文件，并按来源标注，以便日后移至单独的描述文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "所有內容都會匯入你的預設瀏覽器描述檔，並依來源標示，以便日後移至獨立的描述檔。"
          }
        }
      }
    },
    "onboarding.import.fda.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari needs Full Disk Access"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Safari にはフルディスクアクセスが必要です"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحتاج Safari إلى الوصول الكامل إلى القرص"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Safari treba Potpuni pristup disku"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Safari kræver Fuld diskadgang"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Safari benötigt Festplattenvollzugriff"
          }
        },
