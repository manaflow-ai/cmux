    "onboarding.v.accounts.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is uploaded unless you choose Connect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「接続」を選ぶまで何もアップロードされません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يُرفع أي شيء ما لم تختر «ربط»."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ništa se ne otprema dok ne odaberete Poveži."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Intet uploades, medmindre du vælger Forbind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nichts wird hochgeladen, bevor Sie „Verbinden“ wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se sube nada a menos que elijas Conectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rien n’est envoyé sauf si vous choisissez Connecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non viene caricato nulla finché non scegli Collega."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្មានអ្វីត្រូវបានផ្ទុកឡើងទេ លុះត្រាតែអ្នកជ្រើស ភ្ជាប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "연결을 선택하기 전에는 아무것도 업로드되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingenting lastes opp med mindre du velger Koble til."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nic nie jest wysyłane, dopóki nie wybierzesz Połącz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nada é enviado a menos que você escolha Conectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ничего не загружается, пока вы не выберете «Подключить»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "จะไม่มีการอัปโหลดใดๆ จนกว่าคุณจะเลือก เชื่อม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bağla'yı seçmediğiniz sürece hiçbir şey yüklenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Нічого не вивантажується, доки ви не виберете «Підключити»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không có gì được tải lên trừ khi bạn chọn Kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "除非你选择“连接”，否则不会上传任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "除非你選擇「連接」，否則不會上傳任何內容。"
          }
        }
      }
    }
