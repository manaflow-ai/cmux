          "stringUnit": {
            "state": "translated",
            "value": "エージェントが使用しているウインドウのライブプレビューを表示"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បង្ហាញការមើលជាមុនផ្ទាល់នៃផ្ទាំងវីនដូដែលភ្នាក់ងារកំពុងប្រើ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 사용하는 윈도우의 실시간 미리보기 보기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis direkte forhåndsvisning av vinduet agenten bruker"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż podgląd na żywo okna używanego przez agenta"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar a prévia ao vivo da janela que o agente usa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать живой предпросмотр окна, с которым работает агент"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงตัวอย่างสดของหน้าต่างที่เอเจนต์ใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanın kullandığı pencerenin canlı önizlemesini göster"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показати живий перегляд вікна, яке використовує агент"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện bản xem trước trực tiếp của cửa sổ mà tác tử đang dùng"
