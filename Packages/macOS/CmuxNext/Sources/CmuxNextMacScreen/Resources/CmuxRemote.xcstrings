          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentene mine kan slå på skjermdeling og styring på maskinene mine"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moi agenci mogą włączać udostępnianie ekranu i sterowanie na moich komputerach"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meus agentes podem ativar compartilhamento de tela e controle nas minhas máquinas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои агенты могут включать общий экран и управление на моих компьютерах"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์ของฉันเปิดการแชร์หน้าจอและการควบคุมบนเครื่องของฉันได้"
