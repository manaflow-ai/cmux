    "computerUse.confirmMode.unrestricted": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلب أحد الوكلاء هذا. يمكن للوكلاء بعد ذلك استخدام كل تطبيق على هذا الـ Mac دون سؤالك. استخدمه فقط على جهاز يمكن الاستغناء عنه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent je ovo zatražio. Agenti bi tada mogli koristiti svaku aplikaciju na ovom Macu bez pitanja. Koristite ovo samo na jednokratnoj mašini."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En agent bad om dette. Agenter kan derefter bruge alle apps på denne Mac uden at spørge dig. Brug det kun på en maskine, der kan kasseres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Agent hat das angefragt. Agenten könnten dann jede App auf diesem Mac verwenden, ohne dich zu fragen. Nutze das nur auf einer Wegwerfmaschine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An agent asked for this. Agents could then use every app on this Mac without asking you. Use it only on a disposable machine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente lo solicitó. Los agentes podrían usar cualquier app de este Mac sin preguntarte. Úsalo solo en una máquina desechable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agent l’a demandé. Les agents pourraient alors utiliser toutes les apps de ce Mac sans vous demander. Utilisez ce mode uniquement sur une machine jetable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente lo ha richiesto. Gli agenti potrebbero usare qualsiasi app su questo Mac senza chiedertelo. Usalo solo su una macchina usa e getta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントがこれをリクエストしました。変更すると、エージェントは確認なしでこの Mac のすべての App を使用できます。使い捨てのマシンでのみ使用してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្នាក់ងារមួយបានស្នើរឿងនេះ។ បន្ទាប់មក ភ្នាក់ងារអាចប្រើគ្រប់កម្មវិធីនៅលើ Mac នេះដោយមិនសួរអ្នក។ សូមប្រើវាតែនៅលើម៉ាស៊ីនបណ្ដោះអាសន្នប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 이 변경을 요청했습니다. 변경하면 에이전트가 묻지 않고 이 Mac의 모든 앱을 사용할 수 있습니다. 일회용 머신에서만 사용하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En agent ba om dette. Agenter kan da bruke alle apper på denne Macen uten å spørre deg. Bruk det bare på en maskin du kan kaste."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent o to poprosił. Agenci mogliby wtedy używać każdej aplikacji na tym Macu bez pytania. Używaj tego tylko na maszynie jednorazowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um agente pediu isso. Os agentes poderiam usar qualquer app neste Mac sem perguntar a você. Use somente em uma máquina descartável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это запросил агент. Тогда агенты смогут использовать любое приложение на этом Mac без вашего согласия. Используйте это только на одноразовой машине."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์ขอสิ่งนี้ หลังจากนั้นเอเจนต์จะใช้ทุกแอปบน Mac เครื่องนี้ได้โดยไม่ถามคุณ ใช้เฉพาะบนเครื่องที่ใช้แล้วทิ้งได้เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu bir aracı istedi. Aracılar bu Mac’teki her uygulamayı size sormadan kullanabilir. Yalnızca gözden çıkarılabilir bir makinede kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це запросив агент. Тоді агенти зможуть використовувати будь-яку програму на цьому Mac, не питаючи вас. Використовуйте це лише на одноразовій машині."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một tác tử đã yêu cầu điều này. Khi đó, tác tử có thể dùng mọi ứng dụng trên máy Mac này mà không hỏi bạn. Chỉ dùng chế độ này trên máy dùng một lần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是代理请求的。更改后，代理可以不经询问使用这台 Mac 上的所有 App。请仅在一次性机器上使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是代理程式要求的。更改後，代理程式可以不經詢問使用這部 Mac 上的所有 App。請僅在一次性機器上使用。"
          }
        }
      }
    },
    "computerUse.confirmMode.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلب أحد الوكلاء هذا. ستسألك الوكلاء بشكل أقل قبل استخدام تطبيقاتك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent je ovo zatražio. Agenti bi vas rjeđe pitali prije korištenja vaših aplikacija."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En agent bad om dette. Agenter vil spørge dig sjældnere, før de bruger dine apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Agent hat das angefragt. Agenten würden dich seltener fragen, bevor sie deine Apps verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An agent asked for this. Agents would ask you less often before they use your apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente lo solicitó. Los agentes te preguntarían con menos frecuencia antes de usar tus apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agent l’a demandé. Les agents vous demanderaient moins souvent avant d’utiliser vos apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente lo ha richiesto. Gli agenti ti chiederebbero meno spesso prima di usare le tue app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントがこれをリクエストしました。変更すると、エージェントが App を使う前に確認する頻度が減ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្នាក់ងារមួយបានស្នើរឿងនេះ។ ភ្នាក់ងារនឹងសួរអ្នកតិចជាងមុន មុនពេលប្រើកម្មវិធីរបស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 이 변경을 요청했습니다. 변경하면 에이전트가 앱을 사용하기 전에 묻는 빈도가 줄어듭니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En agent ba om dette. Agenter vil spørre deg sjeldnere før de bruker appene dine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent o to poprosił. Agenci rzadziej pytaliby Cię przed użyciem Twoich aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um agente pediu isso. Os agentes perguntariam com menos frequência antes de usar seus apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это запросил агент. Агенты будут реже спрашивать вас, прежде чем использовать ваши приложения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์ขอสิ่งนี้ เอเจนต์จะถามคุณน้อยลงก่อนใช้แอปของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu bir aracı istedi. Aracılar uygulamalarınızı kullanmadan önce size daha seyrek sorar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це запросив агент. Агенти рідше питатимуть вас, перш ніж використовувати ваші програми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một tác tử đã yêu cầu điều này. Tác tử sẽ ít hỏi bạn hơn trước khi dùng ứng dụng của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是代理请求的。更改后，代理在使用你的 App 前询问你的次数会减少。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是代理程式要求的。更改後，代理程式在使用你的 App 前詢問你的次數會減少。"
          }
        }
      }
    },
