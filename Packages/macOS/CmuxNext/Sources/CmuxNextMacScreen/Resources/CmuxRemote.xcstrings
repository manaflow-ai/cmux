{
  "sourceLanguage": "en",
  "strings": {
    "remote.agents.allow.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للوكلاء على أجهزتك تشغيل مشاركة الشاشة والتحكم في أجهزة Mac الخاصة بك أو إيقافهما دون سؤال. يظهر إشعار عند كل تغيير."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenti na tvojim uređajima mogu uključiti ili isključiti dijeljenje ekrana i upravljanje tvojim Macovima bez pitanja. Svaka promjena prikazuje obavijest."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenter på dine egne enheder kan slå skærmdeling og styring af dine Mac’er til eller fra uden at spørge. Hver ændring viser en meddelelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten auf deinen eigenen Geräten können Bildschirmfreigabe und Steuerung deiner Macs ohne Nachfrage ein- oder ausschalten. Jede Änderung zeigt eine Mitteilung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents on your own devices can turn screen sharing and control of your Macs on or off without asking. Each change shows a notice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes de tus dispositivos pueden activar o desactivar compartir pantalla y el control de tus Mac sin preguntar. Cada cambio muestra un aviso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les agents de vos appareils peuvent activer ou désactiver le partage d’écran et le contrôle de vos Mac sans demander. Chaque changement affiche une notification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli agenti sui tuoi dispositivi possono attivare o disattivare la condivisione schermo e il controllo dei tuoi Mac senza chiedere. Ogni modifica mostra un avviso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のデバイス上のエージェントは、確認なしで Mac の画面共有と操作をオン・オフできます。変更のたびに通知が表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្នាក់ងារនៅលើឧបករណ៍ផ្ទាល់ខ្លួនរបស់អ្នកអាចបើក ឬបិទការចែករំលែកអេក្រង់ និងការគ្រប់គ្រង Mac របស់អ្នកដោយមិនសួរ។ ការផ្លាស់ប្ដូរនីមួយៗបង្ហាញការជូនដំណឹង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 기기의 에이전트는 묻지 않고 내 Mac의 화면 공유와 제어를 켜거나 끌 수 있습니다. 변경할 때마다 알림이 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenter på dine egne enheter kan slå skjermdeling og styring av Mac-ene dine av eller på uten å spørre. Hver endring viser et varsel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenci na Twoich urządzeniach mogą bez pytania włączać i wyłączać udostępnianie ekranu oraz sterowanie Twoimi Macami. Każda zmiana pokazuje powiadomienie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentes nos seus dispositivos podem ligar ou desligar o compartilhamento de tela e o controle dos seus Macs sem perguntar. Cada mudança mostra um aviso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты на ваших устройствах могут без запроса включать и выключать показ экрана и управление вашими Mac. Каждое изменение показывает уведомление."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์บนอุปกรณ์ของคุณเองเปิดหรือปิดการแชร์หน้าจอและการควบคุม Mac ของคุณได้โดยไม่ต้องถาม ทุกการเปลี่ยนแปลงจะแสดงการแจ้งเตือน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi aygıtlarınızdaki ajanlar, Mac'lerinizde ekran paylaşımını ve denetimi sormadan açıp kapatabilir. Her değişiklik bir bildirim gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенти на ваших пристроях можуть без запиту вмикати й вимикати показ екрана та керування вашими Mac. Кожна зміна показує сповіщення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác tử trên thiết bị của bạn có thể bật hoặc tắt chia sẻ màn hình và điều khiển các máy Mac của bạn mà không hỏi. Mỗi thay đổi đều hiện thông báo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己设备上的智能体可以无需询问即开启或关闭你的 Mac 的屏幕共享和控制。每次更改都会显示通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己裝置上的代理可以無需詢問即開啟或關閉你的 Mac 的螢幕分享和控制。每次變更都會顯示通知。"
          }
        }
      }
    },
    "remote.agents.allow.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تسمح لوكلائك بمشاركة أجهزتك؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvoliti agentima da dijele vaše računare?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad dine agenter dele dine maskiner?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deinen Agenten erlauben, deine Geräte zu teilen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let your agents share your machines?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Permitir que tus agentes compartan tus equipos?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser vos agents à partager vos machines ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consentire ai tuoi agenti di condividere i tuoi computer?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントにマシンの共有を許可しますか？"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អនុញ្ញាតឱ្យភ្នាក់ងាររបស់អ្នកចែករំលែកម៉ាស៊ីនរបស់អ្នក?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 내 컴퓨터를 공유하도록 허용할까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La agentene dine dele maskinene dine?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwolić agentom udostępniać Twoje komputery?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que seus agentes compartilhem suas máquinas?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить агентам открывать доступ к вашим компьютерам?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้เอเจนต์แชร์เครื่องของคุณไหม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanlarınızın makinelerinizi paylaşmasına izin verilsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволити агентам відкривати доступ до ваших комп’ютерів?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép tác tử chia sẻ máy của bạn?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许你的智能体共享你的电脑？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許你的代理共享你的電腦？"
          }
        }
      }
    },
    "remote.agents.allowed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لوكلائك الآن مشاركة أجهزتك"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši agenti sada mogu dijeliti vaše računare"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine agenter kan nu dele dine maskiner"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Agenten können deine Geräte jetzt teilen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your agents can now share your machines"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus agentes ya pueden compartir tus equipos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos agents peuvent maintenant partager vos machines"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora i tuoi agenti possono condividere i tuoi computer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントがマシンを共有できるようになりました"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឥឡូវនេះភ្នាក់ងាររបស់អ្នកអាចចែករំលែកម៉ាស៊ីនរបស់អ្នក"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 에이전트가 내 컴퓨터를 공유할 수 있습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentene dine kan nå dele maskinene dine"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoi agenci mogą teraz udostępniać Twoje komputery"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus agentes agora podem compartilhar suas máquinas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь агенты могут открывать доступ к вашим компьютерам"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้เอเจนต์แชร์เครื่องของคุณได้แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanlarınız artık makinelerinizi paylaşabilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тепер агенти можуть відкривати доступ до ваших комп’ютерів"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác tử giờ có thể chia sẻ máy của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的智能体现在可以共享你的电脑"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的代理現在可以共享你的電腦"
          }
        }
      }
    },
    "remote.agents.disallowed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيطلب وكلاؤك الإذن الآن قبل مشاركة أجهزتك"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši agenti sada pitaju prije dijeljenja vaših računara"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine agenter spørger nu, før de deler dine maskiner"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Agenten fragen jetzt, bevor sie deine Geräte teilen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your agents now ask before sharing your machines"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus agentes ahora preguntan antes de compartir tus equipos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos agents demandent maintenant avant de partager vos machines"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora i tuoi agenti chiedono prima di condividere i tuoi computer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントはマシンを共有する前に確認するようになりました"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឥឡូវនេះភ្នាក់ងាររបស់អ្នកសួរមុនពេលចែករំលែកម៉ាស៊ីនរបស់អ្នក"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 에이전트가 내 컴퓨터를 공유하기 전에 묻습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentene dine spør nå før de deler maskinene dine"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoi agenci pytają teraz przed udostępnieniem Twoich komputerów"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus agentes agora perguntam antes de compartilhar suas máquinas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь агенты спрашивают, прежде чем открывать доступ к вашим компьютерам"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้เอเจนต์จะถามก่อนแชร์เครื่องของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanlarınız artık makinelerinizi paylaşmadan önce soruyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тепер агенти питають, перш ніж відкривати доступ до ваших комп’ютерів"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác tử giờ sẽ hỏi trước khi chia sẻ máy của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的智能体现在会先询问再共享你的电脑"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的代理現在會先詢問再共享你的電腦"
          }
        }
      }
    },
