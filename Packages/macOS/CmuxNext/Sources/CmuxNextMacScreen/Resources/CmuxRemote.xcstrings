    "remote.confirm.access.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلب وكيل تعيين %1$@ إلى %2$@."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent je zatražio da se %1$@ postavi na %2$@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En agent bad om at sætte %1$@ til %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Agent hat angefragt, %1$@ auf %2$@ zu setzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An agent asked to set %1$@ to %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente pidió establecer %1$@ en %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agent a demandé de régler %1$@ sur %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente ha chiesto di impostare %1$@ su %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが %1$@ を %2$@ に設定するよう求めました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្នាក់ងារមួយបានស្នើឱ្យកំណត់ %1$@ ទៅ %2$@។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 %1$@을(를) %2$@(으)로 설정하도록 요청했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En agent ba om å sette %1$@ til %2$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent poprosił o ustawienie %1$@ na %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um agente pediu para definir %1$@ como %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент запросил установить для %1$@ значение «%2$@»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์ขอให้ตั้งค่า %1$@ เป็น %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ajan, %1$@ için %2$@ ayarlanmasını istedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент попросив установити для %1$@ значення «%2$@»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một tác nhân đã yêu cầu đặt %1$@ thành %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个代理请求将 %1$@ 设为 %2$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個代理要求將 %1$@ 設為 %2$@。"
          }
        }
      }
    },
    "remote.confirm.access.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تمنح %@ حق الوصول إلى جهاز Mac هذا؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati %@ pristup ovom Mac računaru?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv %@ adgang til denne Mac?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Zugriff auf diesen Mac geben?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give %@ access to this Mac?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Dar a %@ acceso a este Mac?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donner à %@ l’accès à ce Mac ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concedere a %@ l’accesso a questo Mac?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にこのMacへのアクセスを許可しますか？"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្ដល់សិទ្ធិឱ្យ %@ ចូលប្រើ Mac នេះឬ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 이 Mac에 대한 접근 권한을 부여하겠습니까?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi %@ tilgang til denne Macen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyznać %@ dostęp do tego Maca?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar a %@ acesso a este Mac?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предоставить %@ доступ к этому Mac?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้ %@ เข้าถึง Mac เครื่องนี้หรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için bu Mac’e erişim verilsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надати %@ доступ до цього Mac?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấp cho %@ quyền truy cập máy Mac này?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要允许 %@ 访问这台 Mac 吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要允許 %@ 取用這台 Mac 嗎？"
          }
        }
      }
    },
    "remote.confirm.share.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لأجهزتك طلب رؤية جهاز Mac هذا أو التحكم فيه. أنت توافق على كل جهاز، ويعرض cmux Remote من هو متصل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši uređaji mogu zatražiti da vide ovaj Mac računar ili upravljaju njime. Svaki odobravate vi, a cmux Remote prikazuje ko je povezan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine enheder kan bede om at se eller styre denne Mac. Du godkender hver enkelt, og cmux Remote viser, hvem der er forbundet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Geräte können anfragen, diesen Mac zu sehen oder zu steuern. Du genehmigst jedes einzeln, und cmux Remote zeigt, wer verbunden ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your devices can ask to see or control this Mac. You approve each one, and cmux Remote shows who is connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus dispositivos pueden pedir ver o controlar este Mac. Tú apruebas cada uno, y cmux Remote muestra quién está conectado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos appareils peuvent demander à voir ou contrôler ce Mac. Vous approuvez chacun d’eux, et cmux Remote indique qui est connecté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dispositivi possono chiedere di vedere o controllare questo Mac. Li approvi uno per uno, e cmux Remote mostra chi è connesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いのデバイスは、このMacの表示や操作をリクエストできます。デバイスごとに承認が必要で、接続中のデバイスは cmux Remote に表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឧបករណ៍របស់អ្នកអាចស្នើសុំមើល ឬគ្រប់គ្រង Mac នេះ។ អ្នកយល់ព្រមលើឧបករណ៍នីមួយៗ ហើយ cmux Remote បង្ហាញអ្នកដែលបានភ្ជាប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 기기에서 이 Mac을 보거나 제어하도록 요청할 수 있습니다. 각 기기를 직접 승인하며, cmux Remote에 연결된 기기가 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhetene dine kan be om å se eller styre denne Macen. Du godkjenner hver enkelt, og cmux Remote viser hvem som er tilkoblet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje urządzenia mogą prosić o podgląd tego Maca lub sterowanie nim. Każde zatwierdzasz osobno, a cmux Remote pokazuje, kto jest połączony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dispositivos podem pedir para ver ou controlar este Mac. Você aprova cada um, e o cmux Remote mostra quem está conectado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши устройства могут запрашивать просмотр этого Mac или управление им. Вы одобряете каждое, а cmux Remote показывает, кто подключён."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์ของคุณสามารถขอดูหรือควบคุม Mac เครื่องนี้ได้ คุณอนุมัติทีละเครื่อง และ cmux Remote จะแสดงว่าใครเชื่อมต่ออยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazlarınız bu Mac’i görmek veya denetlemek için istekte bulunabilir. Her birini siz onaylarsınız ve cmux Remote kimin bağlı olduğunu gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші пристрої можуть просити переглядати цей Mac або керувати ним. Ви схвалюєте кожен, а cmux Remote показує, хто під’єднаний."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thiết bị của bạn có thể yêu cầu xem hoặc điều khiển máy Mac này. Bạn duyệt từng thiết bị, và cmux Remote hiển thị ai đang kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的设备可以请求查看或控制这台 Mac。每台设备都需你批准，cmux Remote 会显示谁已连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的裝置可以要求檢視或控制這台 Mac。每台裝置都需經你核准，cmux Remote 會顯示誰已連線。"
          }
        }
      }
    },
