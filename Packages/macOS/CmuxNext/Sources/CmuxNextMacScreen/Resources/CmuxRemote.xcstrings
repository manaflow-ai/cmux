    "computerUse.preview.chipHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار المعاينة المباشرة للنافذة التي يستخدمها الوكيل"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaži pregled uživo prozora koji agent koristi"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis live-forhåndsvisningen af det vindue, agenten bruger"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Vorschau des Fensters zeigen, das der Agent verwendet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the live preview of the window the agent uses"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar la vista previa en vivo de la ventana que usa el agente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher l’aperçu en direct de la fenêtre utilisée par l’agent"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra l’anteprima dal vivo della finestra usata dall’agente"
          }
        },
