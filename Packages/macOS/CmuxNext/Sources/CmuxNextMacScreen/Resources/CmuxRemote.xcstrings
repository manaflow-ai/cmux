    "remote.agents.settings.toggle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لوكلائي تشغيل مشاركة الشاشة والتحكم على أجهزتي"
          }
        },
        "bs": {
          "stringUnit": {
