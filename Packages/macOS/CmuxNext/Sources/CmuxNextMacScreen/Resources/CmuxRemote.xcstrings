    "remote.scope.ask": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسأل في كل مرة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitaj svaki put"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spørg hver gang"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Mal fragen"
