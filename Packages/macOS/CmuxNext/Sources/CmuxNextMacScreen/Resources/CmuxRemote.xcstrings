    "remote.agents.settings.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشارك وكلاؤك دون أن يسألوا، مع إشعار في كل مرة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši agenti dijele bez pitanja, uz obavijest svaki put."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine agenter deler uden at spørge, med en meddelelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Agenten teilen ohne Rückfrage, mit Mitteilung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your agents share without asking, with a notice each time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus agentes comparten sin preguntar, con un aviso cada vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos agents partagent sans demander, avec une notification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi agenti condividono senza chiedere, con un avviso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントは確認なしで共有し、毎回通知が届きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្នាក់ងាររបស់អ្នកចែករំលែកដោយមិនសួរ ហើយមានការជូនដំណឹង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 묻지 않고 공유하며 매번 알림이 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentene dine deler uten å spørre, med et varsel hver gang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoi agenci udostępniają bez pytania, z powiadomieniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus agentes compartilham sem perguntar, com um aviso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши агенты делятся без вопроса, каждый раз с уведомлением."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์ของคุณแชร์ได้โดยไม่ต้องถาม พร้อมแจ้งเตือนทุกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanlarınız sormadan paylaşır, her seferinde bildirim gelir."
          }
        },
