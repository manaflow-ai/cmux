    "remote.confirm.access.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تمنح %@ حق الوصول إلى جهاز Mac هذا؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati %@ pristup ovom Mac računaru?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv %@ adgang til denne Mac?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Zugriff auf diesen Mac geben?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give %@ access to this Mac?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Dar a %@ acceso a este Mac?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donner à %@ l’accès à ce Mac ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concedere a %@ l’accesso a questo Mac?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にこのMacへのアクセスを許可しますか？"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្ដល់សិទ្ធិឱ្យ %@ ចូលប្រើ Mac នេះឬ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 이 Mac에 대한 접근 권한을 부여하겠습니까?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi %@ tilgang til denne Macen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyznać %@ dostęp do tego Maca?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar a %@ acesso a este Mac?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предоставить %@ доступ к этому Mac?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้ %@ เข้าถึง Mac เครื่องนี้หรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için bu Mac’e erişim verilsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надати %@ доступ до цього Mac?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấp cho %@ quyền truy cập máy Mac này?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要允许 %@ 访问这台 Mac 吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要允許 %@ 取用這台 Mac 嗎？"
          }
        }
      }
    },
    "remote.confirm.share.bodyOwn": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكن لأجهزتك على هذا الحساب رؤية هذا الـ Mac أو التحكم فيه. يعرض cmux Remote من هو متصل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vaši uređaji na ovom računu mogu vidjeti ili upravljati ovim Macom. cmux Remote pokazuje ko je povezan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dine enheder på denne konto kan se eller styre denne Mac. cmux Remote viser, hvem der er forbundet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
