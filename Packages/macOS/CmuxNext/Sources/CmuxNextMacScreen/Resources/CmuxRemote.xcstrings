    "computerUse.remoteSetup.askIntro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل Computer Use في cmux Remote. يحتاج macOS إلى إذنين لـ cmux Remote. يطلب «متابعة» كلًا منهما بالتتابع."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use radi u cmux Remote. macOS treba dvije dozvole za cmux Remote. Nastavi traži svaku redom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use kører i cmux Remote. macOS skal bruge to tilladelser til cmux Remote. Fortsæt beder om dem én ad gangen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use läuft in cmux Remote. macOS braucht zwei Berechtigungen für cmux Remote. Fortfahren fragt nacheinander danach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use runs in cmux Remote. macOS needs two permissions for cmux Remote. Continue asks for each in turn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use se ejecuta en cmux Remote. macOS necesita dos permisos para cmux Remote. Continuar los pide uno tras otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use s’exécute dans cmux Remote. macOS a besoin de deux autorisations pour cmux Remote. Continuer les demande l’une après l’autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use funziona in cmux Remote. macOS ha bisogno di due permessi per cmux Remote. Continua li chiede uno alla volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use は cmux Remote で動作します。macOS では cmux Remote に 2 つの許可が必要です。「続ける」で順番に要求します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use ដំណើរការក្នុង cmux Remote។ macOS ត្រូវការការអនុញ្ញាតពីរសម្រាប់ cmux Remote។ បន្ត នឹងស្នើម្ដងមួយៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use는 cmux Remote에서 실행됩니다. macOS에서 cmux Remote에 두 가지 권한이 필요합니다. 계속을 누르면 하나씩 요청합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use kjører i cmux Remote. macOS trenger to tillatelser for cmux Remote. Fortsett ber om dem én etter én."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use działa w cmux Remote. macOS potrzebuje dwóch uprawnień dla cmux Remote. Kontynuuj prosi o nie po kolei."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Computer Use roda no cmux Remote. O macOS precisa de duas permissões para o cmux Remote. Continuar pede cada uma por vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use работает в cmux Remote. macOS нужны два разрешения для cmux Remote. «Продолжить» запросит их по очереди."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use ทำงานใน cmux Remote macOS ต้องการสิทธิ์สองอย่างสำหรับ cmux Remote ดำเนินการต่อจะขอทีละอย่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use, cmux Remote’ta çalışır. macOS’un cmux Remote için iki izne ihtiyacı var. Devam, bunları sırayla ister."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use працює в cmux Remote. macOS потрібні два дозволи для cmux Remote. «Продовжити» запитає їх по черзі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use chạy trong cmux Remote. macOS cần hai quyền cho cmux Remote. Tiếp tục sẽ lần lượt yêu cầu từng quyền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use 在 cmux Remote 中运行。macOS 需要为 cmux Remote 授予两项权限。“继续”会依次请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use 在 cmux Remote 中執行。macOS 需要為 cmux Remote 授予兩項權限。「繼續」會依序要求。"
          }
        }
      }
    },
    "computerUse.remoteSetup.askAccessibility": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "1. %@، لكي يتمكن الوكلاء من النقر والكتابة في التطبيقات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "1. %@, da agenti mogu klikati i kucati u aplikacijama."
          }
        },
