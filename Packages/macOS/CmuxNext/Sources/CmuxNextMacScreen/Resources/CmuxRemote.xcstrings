          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your devices on this account can see or control this Mac. cmux Remote shows who is connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tus dispositivos en esta cuenta pueden ver o controlar este Mac. cmux Remote muestra quién está conectado."
