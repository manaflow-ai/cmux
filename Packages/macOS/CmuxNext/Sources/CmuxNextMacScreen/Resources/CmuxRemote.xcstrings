    "computerUse.revoke.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء موافقات التطبيقات المحفوظة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opozovi sačuvana odobrenja aplikacija"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbagekald gemte appgodkendelser"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte App-Freigaben widerrufen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoke Saved App Approvals"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revocar aprobaciones de apps guardadas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Révoquer les autorisations d’apps enregistrées"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoca le approvazioni delle app salvate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの App の承認を取り消す"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដកហូតការអនុម័តកម្មវិធីដែលបានរក្សាទុក"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 앱 승인 철회"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbakekall lagrede appgodkjenninger"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odwołaj zapisane zgody dla aplikacji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revogar Aprovações de Apps Salvas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отозвать сохраненные разрешения приложений"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิกถอนการอนุมัติแอปที่บันทึกไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilmiş Uygulama Onaylarını İptal Et"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкликати збережені дозволи програм"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thu hồi phê duyệt ứng dụng đã lưu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销已存储的 App 批准"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤銷已儲存的 App 核准"
          }
        }
      }
    },
    "computerUse.revoke.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستطلب الوكلاء الإذن مرة أخرى قبل استخدام التطبيقات التي تختارها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenti će ponovo pitati prije nego što koriste aplikacije koje odaberete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenter spørger igen, før de bruger de apps, du vælger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten fragen erneut, bevor sie die von dir gewählten Apps verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents will ask again before they use the apps you choose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes volverán a preguntar antes de usar las apps que elijas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les agents demanderont à nouveau avant d’utiliser les apps choisies."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli agenti chiederanno di nuovo prima di usare le app che scegli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した App を使用する前に、エージェントが再度確認します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្នាក់ងារនឹងសួរម្ដងទៀត មុនពេលប្រើកម្មវិធីដែលអ្នកជ្រើសរើស។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 선택한 앱을 사용하기 전에 다시 묻습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenter spør igjen før de bruker appene du velger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenci ponownie zapytają przed użyciem wybranych aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os agentes perguntarão de novo antes de usar os apps que você escolher."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты снова будут спрашивать, прежде чем использовать выбранные приложения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์จะถามอีกครั้งก่อนใช้แอปที่คุณเลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aracılar, seçtiğiniz uygulamaları kullanmadan önce yeniden soracak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенти знову питатимуть, перш ніж використовувати вибрані програми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác tử sẽ hỏi lại trước khi sử dụng các ứng dụng bạn chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理在使用你所选的 App 之前会再次询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理程式在使用你所選的 App 之前會再次詢問。"
          }
        }
      }
    },
    "computerUse.revoke.none": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد تطبيقات محفوظة. تطلب الوكلاء الإذن قبل استخدام أي تطبيق."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema sačuvanih aplikacija. Agenti pitaju prije korištenja bilo koje aplikacije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen apps er gemt. Agenter spørger, før de bruger en app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Apps gespeichert. Agenten fragen vor der Verwendung jeder App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No apps are saved. Agents ask before they use any app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay apps guardadas. Los agentes preguntan antes de usar cualquier app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune app enregistrée. Les agents demandent avant d’utiliser une app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna app salvata. Gli agenti chiedono prima di usare qualsiasi app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの App はありません。エージェントはどの App を使う前にも確認します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនមានកម្មវិធីដែលបានរក្សាទុកទេ។ ភ្នាក់ងារសួរមុនពេលប្រើកម្មវិធីណាមួយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 앱이 없습니다. 에이전트는 앱을 사용하기 전에 항상 묻습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen apper er lagret. Agenter spør før de bruker en app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak zapisanych aplikacji. Agenci pytają przed użyciem każdej aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum app salvo. Os agentes perguntam antes de usar qualquer app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет сохраненных приложений. Агенты спрашивают перед использованием любого приложения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีแอปที่บันทึกไว้ เอเจนต์จะถามก่อนใช้แอปใดๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilmiş uygulama yok. Aracılar herhangi bir uygulamayı kullanmadan önce sorar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає збережених програм. Агенти питають, перш ніж використовувати будь-яку програму."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có ứng dụng nào được lưu. Tác tử sẽ hỏi trước khi dùng bất kỳ ứng dụng nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有已存储的 App。代理在使用任何 App 前都会询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有已儲存的 App。代理程式在使用任何 App 前都會詢問。"
          }
        }
      }
    },
