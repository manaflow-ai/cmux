    "computerUse.remoteSetup.askTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح لـ cmux Remote باستخدام هذا الـ Mac"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvolite cmux Remote da koristi ovaj Mac"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad cmux Remote at bruge denne Mac"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Remote die Nutzung dieses Mac erlauben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow cmux Remote to Use This Mac"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que cmux Remote use este Mac"
          }
        },
        "fr": {
