    "remote.agents.indicator": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاركه وكيلك %@؛ يتوقف عند عدم وجود مشاهد"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijeli vaš agent %@; isključuje se kada ga niko ne gleda"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Delt af din agent %@; slås fra uden seere"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von deinem Agenten %@ geteilt; schaltet sich ohne Zuschauer aus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared by your agent %@; turns off with no viewer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartido por tu agente %@; se desactiva sin espectadores"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagé par votre agent %@ ; se désactive sans spectateur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condiviso dal tuo agente %@; si disattiva senza spettatori"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェント %@ が共有中。視聴者がいないとオフになります"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បានចែករំលែកដោយភ្នាក់ងារ %@ របស់អ្នក; បិទពេលគ្មានអ្នកមើល"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 %@이(가) 공유 중, 보는 사람이 없으면 꺼집니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Delt av agenten din %@; slås av uten seere"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnione przez agenta %@; wyłącza się bez widzów"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhado pelo seu agente %@; desativa sem espectadores"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыт вашим агентом %@; выключится без зрителей"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชร์โดยเอเจนต์ %@ ของคุณ ปิดเองเมื่อไม่มีผู้ดู"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanınız %@ paylaştı; izleyen olmayınca kapanır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрито вашим агентом %@; вимкнеться без глядачів"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được tác tử %@ chia sẻ; tự tắt khi không có người xem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由你的智能体 %@ 共享；无人观看时关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由你的代理 %@ 共享；無人觀看時關閉"
          }
        }
      }
    },
