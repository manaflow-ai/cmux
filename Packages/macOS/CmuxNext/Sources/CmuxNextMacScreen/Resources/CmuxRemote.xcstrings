        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vos appareils sur ce compte peuvent voir ou contrôler ce Mac. cmux Remote indique qui est connecté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I tuoi dispositivi su questo account possono vedere o controllare questo Mac. cmux Remote mostra chi è connesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このアカウントのデバイスはこの Mac を表示または操作できます。接続中のデバイスは cmux Remote に表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ឧបករណ៍របស់អ្នកនៅលើគណនីនេះអាចមើល ឬគ្រប់គ្រង Mac នេះបាន។ cmux Remote បង្ហាញអ្នកដែលបានភ្ជាប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 계정의 기기는 이 Mac을 보거나 제어할 수 있습니다. 연결된 기기는 cmux Remote에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enhetene dine på denne kontoen kan se eller styre denne Macen. cmux Remote viser hvem som er tilkoblet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Twoje urządzenia na tym koncie mogą widzieć ten Mac lub nim sterować. cmux Remote pokazuje, kto jest połączony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seus dispositivos nesta conta podem ver ou controlar este Mac. O cmux Remote mostra quem está conectado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ваши устройства в этой учётной записи могут видеть этот Mac или управлять им. cmux Remote показывает, кто подключён."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อุปกรณ์ของคุณในบัญชีนี้สามารถดูหรือควบคุม Mac เครื่องนี้ได้ cmux Remote แสดงว่าใครเชื่อมต่ออยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu hesaptaki aygıtlarınız bu Mac'i görebilir veya denetleyebilir. cmux Remote kimin bağlı olduğunu gösterir."
          }
        },
        "uk": {
          "stringUnit": {
