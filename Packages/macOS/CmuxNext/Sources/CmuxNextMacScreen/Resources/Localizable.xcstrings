    "macScreen.card.missingBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تم نسيانه، أو أن علامة التبويب هذه جاءت من جهاز Mac آخر. قم بإقرانه مرة أخرى من شاشة Mac."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zaboravljen je ili je ova kartica došla s drugog Maca. Ponovo ga uparite iz Ekrana Maca."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den er blevet glemt, eller fanen kom fra en anden Mac. Par den igen fra Mac-skærm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Er wurde ignoriert oder dieser Tab stammt von einem anderen Mac. Kopple ihn erneut über „Mac-Bildschirm“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It was forgotten, or this tab came from another Mac. Pair it again from Mac Screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se olvidó o esta pestaña procede de otro Mac. Vuelve a vincularlo desde Pantalla del Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il a été oublié, ou cet onglet provient d’un autre Mac. Jumelez-le à nouveau depuis Écran Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "È stato dimenticato, oppure questo pannello proviene da un altro Mac. Abbinalo di nuovo da Schermo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "登録が解除されたか、このタブは別のMacから来たものです。「Macの画面」からもう一度ペアリングしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "វាត្រូវបានបំភ្លេច ឬផ្ទាំងនេះមកពី Mac ផ្សេងទៀត។ ផ្គូផ្គងវាម្ដងទៀតពី អេក្រង់ Mac។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "등록 해제되었거나 이 탭이 다른 Mac에서 왔습니다. Mac 화면에서 다시 페어링하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den er glemt, eller fanen kom fra en annen Mac. Koble den sammen på nytt fra Mac-skjerm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Został zapomniany lub ta karta pochodzi z innego Maca. Sparuj go ponownie w Ekranie Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ele foi esquecido ou esta aba veio de outro Mac. Emparelhe-o novamente na Tela do Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Он был забыт, или эта вкладка пришла с другого Mac. Снова создайте пару в «Экране Mac»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac ถูกลืมไปแล้ว หรือแถบนี้มาจาก Mac เครื่องอื่น จับคู่อีกครั้งจากหน้าจอ Mac"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unutulmuş ya da bu sekme başka bir Mac’ten gelmiş. Mac Ekranı’ndan yeniden eşleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Його забуто, або ця вкладка прийшла з іншого Mac. Створіть пару знову в «Екрані Mac»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Máy đã bị quên hoặc tab này đến từ một máy Mac khác. Hãy ghép đôi lại từ Màn hình Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它已被忘记，或此标签页来自另一台 Mac。请从“Mac 屏幕”重新配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它已被忘記，或此標籤頁來自另一部 Mac。請從「Mac 螢幕」重新配對。"
