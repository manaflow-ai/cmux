    "macScreen.home.screenRecordingDetail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتيح لـ cmux إرسال هذه الشاشة. قد يطلب منك macOS إنهاء cmux وإعادة فتحه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Omogućava cmuxu da šalje ovaj ekran. macOS može tražiti da zatvorite i ponovo otvorite cmux."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lader cmux sende denne skærm. macOS beder dig muligvis om at slutte og åbne cmux igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erlaubt cmux, diesen Bildschirm zu senden. macOS fordert dich eventuell auf, cmux zu beenden und erneut zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets cmux send this screen. macOS may ask you to quit and reopen cmux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite que cmux envíe esta pantalla. Puede que macOS te pida salir de cmux y volver a abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permet à cmux d’envoyer cet écran. macOS peut vous demander de quitter et de rouvrir cmux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consente a cmux di inviare questo schermo. macOS potrebbe chiederti di uscire da cmux e riaprirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmuxがこの画面を送信できるようにします。macOSからcmuxを終了して再度開くよう求められる場合があります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អនុញ្ញាតឱ្យ cmux ផ្ញើអេក្រង់នេះ។ macOS អាចសុំឱ្យអ្នកចាកចេញ ហើយបើក cmux ឡើងវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux가 이 화면을 전송할 수 있게 합니다. macOS에서 cmux를 종료하고 다시 열도록 요청할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lar cmux sende denne skjermen. macOS kan be deg om å avslutte og åpne cmux på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pozwala cmux wysyłać ten ekran. macOS może poprosić o zamknięcie i ponowne otwarcie cmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite que o cmux envie esta tela. O macOS pode pedir que você encerre e reabra o cmux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Позволяет cmux передавать этот экран. macOS может попросить завершить и снова открыть cmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อนุญาตให้ cmux ส่งหน้าจอนี้ macOS อาจขอให้คุณออกและเปิด cmux ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux’un bu ekranı göndermesine izin verir. macOS, cmux’tan çıkıp yeniden açmanızı isteyebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дозволяє cmux передавати цей екран. macOS може попросити вийти з cmux і відкрити його знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cho phép cmux gửi màn hình này. macOS có thể yêu cầu bạn thoát và mở lại cmux."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "允许 cmux 发送此屏幕。macOS 可能会要求你退出并重新打开 cmux。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "允許 cmux 傳送此螢幕。macOS 可能會要求你結束並重新打開 cmux。"
          }
        }
      }
    },
