    "macScreen.home.linkBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الصقه في شاشة Mac على جهاز Mac الآخر، أو امسح الرمز ضوئيًا باستخدام تطبيق cmux VNC على iPhone."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zalijepite ga u Ekran Maca na drugom Macu ili skenirajte kôd aplikacijom cmux VNC za iPhone."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sæt det ind i Mac-skærm på din anden Mac, eller scan koden med iPhone-appen cmux VNC."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Füge ihn auf deinem anderen Mac in „Mac-Bildschirm“ ein oder scanne den Code mit der iPhone-App „cmux VNC“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste it into Mac Screen on your other Mac, or scan the code with the cmux VNC iPhone app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pégalo en Pantalla del Mac en tu otro Mac o escanea el código con la app cmux VNC para iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Collez-le dans Écran Mac sur votre autre Mac, ou scannez le code avec l’app iPhone cmux VNC."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Incollalo in Schermo Mac sull’altro Mac, oppure scansiona il codice con l’app cmux VNC per iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "もう一方のMacの「Macの画面」にペーストするか、cmux VNC iPhoneアプリでコードをスキャンしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បិទភ្ជាប់វាក្នុង អេក្រង់ Mac នៅលើ Mac មួយទៀតរបស់អ្នក ឬស្កេនកូដដោយប្រើកម្មវិធី cmux VNC សម្រាប់ iPhone។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다른 Mac의 Mac 화면에 붙여넣거나 cmux VNC iPhone 앱으로 코드를 스캔하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lim den inn i Mac-skjerm på den andre Macen, eller skann koden med iPhone-appen cmux VNC."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wklej je w Ekranie Maca na drugim Macu lub zeskanuj kod w aplikacji cmux VNC na iPhone’a."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cole-o na Tela do Mac no seu outro Mac ou escaneie o código com o app cmux VNC para iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вставьте ее в «Экран Mac» на другом Mac или отсканируйте код в приложении cmux VNC для iPhone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "วางลิงก์ในหน้าจอ Mac บน Mac อีกเครื่องของคุณ หรือสแกนรหัสด้วยแอป cmux VNC บน iPhone"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diğer Mac’inizde Mac Ekranı’na yapıştırın veya kodu cmux VNC iPhone uygulamasıyla tarayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вставте його в «Екран Mac» на іншому Mac або відскануйте код у програмі cmux VNC для iPhone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dán liên kết vào Màn hình Mac trên máy Mac kia hoặc quét mã bằng ứng dụng cmux VNC trên iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将其粘贴到另一台 Mac 上的“Mac 屏幕”中，或使用 cmux VNC iPhone App 扫描代码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "將其貼到另一部 Mac 上的「Mac 螢幕」，或使用 cmux VNC iPhone App 掃描代碼。"
          }
        }
      }
    },
