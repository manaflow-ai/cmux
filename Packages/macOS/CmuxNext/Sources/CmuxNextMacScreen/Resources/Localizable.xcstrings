      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان مركز الأجهزة في الإعدادات › التطوير ليس عنوان ويب صالحًا. صحّحه، أو امسحه لاستخدام المركز المدمج."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresa centra uređaja u Postavke › Razvoj nije ispravna web adresa. Ispravite je ili je obrišite da koristite ugrađeni centar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhedshubbens adresse i Indstillinger › Udvikling er ikke en gyldig webadresse. Ret den, eller ryd den for at bruge den indbyggede hub."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Geräte-Hub-Adresse unter Einstellungen › Entwicklung ist keine gültige Webadresse. Korrigiere sie oder leere sie, um den eingebauten Hub zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Device Hub Address in Settings › Development is not a valid web address. Fix it, or clear it to use the built-in hub."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección del centro de dispositivos en Ajustes › Desarrollo no es una dirección web válida. Corrígela o bórrala para usar el centro integrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’adresse du hub d’appareils dans Réglages › Développement n’est pas une adresse web valide. Corrigez-la ou effacez-la pour utiliser le hub intégré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indirizzo dell’hub dispositivi in Impostazioni › Sviluppo non è un indirizzo web valido. Correggilo o cancellalo per usare l’hub integrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 › 開発 のデバイスハブのアドレスが有効な Web アドレスではありません。修正するか、空にして内蔵のハブを使ってください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អាសយដ្ឋានមជ្ឈមណ្ឌលឧបករណ៍នៅក្នុង ការកំណត់ › ការអភិវឌ្ឍ មិនមែនជាអាសយដ្ឋានគេហទំព័រត្រឹមត្រូវទេ។ កែវា ឬសម្អាតវាដើម្បីប្រើមជ្ឈមណ្ឌលដែលភ្ជាប់មកជាមួយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 › 개발의 기기 허브 주소가 올바른 웹 주소가 아닙니다. 주소를 고치거나 비워서 내장 허브를 사용하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Adressen til enhetshuben i Innstillinger › Utvikling er ikke en gyldig nettadresse. Rett den, eller tøm den for å bruke den innebygde huben."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres centrum urządzeń w Ustawienia › Programowanie nie jest prawidłowym adresem internetowym. Popraw go lub wyczyść, aby używać wbudowanego centrum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O endereço da central de dispositivos em Ajustes › Desenvolvimento não é um endereço web válido. Corrija-o ou apague-o para usar a central integrada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес центра устройств в Настройки › Разработка не является допустимым веб-адресом. Исправьте его или очистите, чтобы использовать встроенный центр."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่อยู่ฮับอุปกรณ์ใน การตั้งค่า › การพัฒนา ไม่ใช่ที่อยู่เว็บที่ถูกต้อง แก้ไข หรือล้างออกเพื่อใช้ฮับในตัว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar › Geliştirme’deki Cihaz Merkezi Adresi geçerli bir web adresi değil. Düzeltin ya da yerleşik merkezi kullanmak için temizleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Адреса центру пристроїв у Параметри › Розробка не є дійсною вебадресою. Виправте її або очистьте, щоб використовувати вбудований центр."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Địa chỉ trung tâm thiết bị trong Cài đặt › Phát triển không phải là địa chỉ web hợp lệ. Hãy sửa lại hoặc xóa đi để dùng trung tâm tích hợp sẵn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 › 开发 中的设备中心地址不是有效的网址。请修正，或清空以使用内置的设备中心。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 › 開發 中的裝置中心位址不是有效的網址。請修正，或清空以使用內建的裝置中心。"
          }
        }
      }
    },
    "devices.status.removed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد هذا الـ Mac ضمن أجهزتك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj Mac više nije među vašim uređajima."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac er ikke længere blandt dine enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac ist nicht mehr unter deinen Geräten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac left your devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac ha salido de tus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac a quitté vos appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac ha lasciato i tuoi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacはあなたのデバイスから外れました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac នេះបានចាកចេញពីឧបករណ៍របស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac이 내 기기에서 제거되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Macen er fjernet fra enhetene dine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac został usunięty z Twoich urządzeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac saiu dos seus dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac покинул ваши устройства."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac เครื่องนี้ออกจากอุปกรณ์ของคุณแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac aygıtlarınızdan ayrıldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей Mac вилучено з ваших пристроїв."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac này đã rời khỏi thiết bị của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 已离开你的设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部 Mac 已離開你的裝置。"
          }
        }
      }
