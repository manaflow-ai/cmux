    "macScreen.card.ownLinkLost": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقد هذا الـ Mac اتصاله بمركز الأجهزة. تحقّق من الشبكة؛ سيعيد cmux الاتصال تلقائيًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj Mac je izgubio vezu s čvorištem uređaja. Provjerite mrežu; cmux se sam ponovo povezuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac mistede forbindelsen til enhedshubben. Tjek dit netværk; cmux genopretter forbindelsen af sig selv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac hat die Verbindung zum Geräte-Hub verloren. Prüfe dein Netzwerk; cmux verbindet sich selbst neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac lost its connection to the device hub. Check your network; cmux reconnects on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac perdió la conexión con el centro de dispositivos. Revisa tu red; cmux se reconecta solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac a perdu la connexion au hub des appareils. Vérifiez votre réseau ; cmux se reconnecte tout seul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac ha perso la connessione all’hub dei dispositivi. Controlla la rete; cmux si riconnette da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacはデバイスハブとの接続が切れました。ネットワークを確認してください。cmuxは自動で再接続します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac នេះបានបាត់បង់ការតភ្ជាប់ទៅមជ្ឈមណ្ឌលឧបករណ៍។ សូមពិនិត្យបណ្ដាញរបស់អ្នក។ cmux នឹងតភ្ជាប់ឡើងវិញដោយខ្លួនឯង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac과 기기 허브의 연결이 끊어졌습니다. 네트워크를 확인하세요. cmux가 자동으로 다시 연결합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Macen mistet forbindelsen til enhetshuben. Sjekk nettverket; cmux kobler til igjen av seg selv."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac utracił połączenie z centrum urządzeń. Sprawdź sieć; cmux połączy się ponownie samodzielnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac perdeu a conexão com a central de dispositivos. Verifique sua rede; o cmux se reconecta sozinho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac потерял связь с центром устройств. Проверьте сеть; cmux переподключится сам."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac เครื่องนี้ขาดการเชื่อมต่อกับศูนย์กลางอุปกรณ์ ตรวจสอบเครือข่ายของคุณ cmux จะเชื่อมต่อใหม่เอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac’in aygıt merkeziyle bağlantısı koptu. Ağınızı denetleyin; cmux kendiliğinden yeniden bağlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей Mac втратив з’єднання з центром пристроїв. Перевірте мережу; cmux під’єднається знову сам."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac này đã mất kết nối với trung tâm thiết bị. Hãy kiểm tra mạng; cmux sẽ tự kết nối lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 与设备中心的连接已断开。请检查网络；cmux 会自动重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部 Mac 與裝置中心的連線已中斷。請檢查網路；cmux 會自動重新連線。"
          }
        }
      }
    },
