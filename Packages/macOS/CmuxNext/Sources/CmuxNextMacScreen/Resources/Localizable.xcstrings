    "macScreen.hub.notSharedBodyNamed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يشارك %@ شاشته. لمشاركتها، شغّل «السماح بـ Mac Screen» في الإعدادات › الأجهزة على ذلك الـ Mac."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne dijeli svoj ekran. Da biste ga dijelili, uključite Dozvoli Mac Screen u Postavke › Uređaji na tom Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deler ikke sin skærm. Slå Tillad Mac Screen til i Indstillinger › Enheder på den Mac for at dele den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ teilt seinen Bildschirm nicht. Aktiviere dazu „Mac Screen erlauben“ unter Einstellungen › Geräte auf dem anderen Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ does not share its screen. To share it, turn on Allow Mac Screen in Settings › Devices on that Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no comparte su pantalla. Para compartirla, activa Permitir Mac Screen en Ajustes › Dispositivos en ese Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne partage pas son écran. Pour le partager, activez Autoriser Mac Screen dans Réglages › Appareils sur l’autre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non condivide il suo schermo. Per condividerlo, attiva Consenti Mac Screen in Impostazioni › Dispositivi su quel Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は画面を共有していません。共有するには、相手のMacの設定 › デバイスで「Mac Screenを許可」をオンにしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ មិនចែករំលែកអេក្រង់របស់វាទេ។ ដើម្បីចែករំលែក សូមបើក អនុញ្ញាត Mac Screen នៅក្នុង ការកំណត់ › ឧបករណ៍ នៅលើ Mac នោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 화면을 공유하지 않습니다. 공유하려면 해당 Mac의 설정 › 기기에서 Mac Screen 허용을 켜십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deler ikke skjermen sin. Slå på Tillat Mac Screen i Innstillinger › Enheter på den Macen for å dele den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie udostępnia swojego ekranu. Aby go udostępnić, włącz opcję Pozwalaj na Mac Screen w Ustawieniach › Urządzenia na tamtym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não compartilha a tela. Para compartilhá-la, ative Permitir Mac Screen em Ajustes › Dispositivos naquele Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не открывает общий доступ к экрану. Чтобы открыть его, включите «Разрешить Mac Screen» в разделе «Настройки › Устройства» на том Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ไม่ได้แชร์หน้าจอ หากต้องการแชร์ ให้เปิด อนุญาต Mac Screen ในการตั้งค่า › อุปกรณ์บน Mac เครื่องนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ekranını paylaşmıyor. Paylaşmak için o Mac’te Ayarlar › Aygıtlar’da Mac Screen’e İzin Ver’i açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не надає спільний доступ до екрана. Щоб надати його, увімкніть «Дозволити Mac Screen» у меню «Параметри › Пристрої» на тому Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không chia sẻ màn hình. Để chia sẻ, hãy bật Cho phép Mac Screen trong Cài đặt › Thiết bị trên máy Mac đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未共享其屏幕。要共享，请在那台 Mac 的“设置 › 设备”中打开“允许 Mac Screen”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未共享其螢幕。若要共享，請在那部 Mac 的「設定 › 裝置」中開啟「允許 Mac Screen」。"
          }
        }
      }
    },
