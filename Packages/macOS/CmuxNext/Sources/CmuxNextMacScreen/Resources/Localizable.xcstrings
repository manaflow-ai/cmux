    "macScreen.hub.viewOnlyBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لهذا الـ Mac عرض %@ فقط، وليس التحكم فيه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj Mac smije samo gledati %@, ne i upravljati njime."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac må kun se %@, ikke styre den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac darf %@ nur ansehen, nicht steuern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac may only view %@, not control it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac solo puede ver %@, no controlarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac peut seulement voir %@, sans le contrôler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac può solo visualizzare %@, non controllarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
