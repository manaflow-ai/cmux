    "macScreen.hub.signedOutBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول إلى cmux لرؤية أجهزتك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se na cmux da vidite svoje uređaje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind på cmux for at se dine enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich bei cmux an, um deine Geräte zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to cmux to see your devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en cmux para ver tus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à cmux pour voir vos appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi a cmux per vedere i tuoi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスを表示するにはcmuxにサインインしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចូល cmux ដើម្បីមើលឧបករណ៍របស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기를 보려면 cmux에 로그인하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg på cmux for å se enhetene dine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się do cmux, aby zobaczyć swoje urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão no cmux para ver seus dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в cmux, чтобы увидеть свои устройства."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าใช้ cmux เพื่อดูอุปกรณ์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aygıtlarınızı görmek için cmux’ta oturum açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть у cmux, щоб бачити свої пристрої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập cmux để xem thiết bị của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录 cmux 以查看你的设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入 cmux 以檢視你的裝置。"
          }
        }
