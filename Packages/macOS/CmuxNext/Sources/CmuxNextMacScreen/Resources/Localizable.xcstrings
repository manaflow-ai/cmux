    "macScreen.hub.notFoundBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت إزالة هذا الجهاز من أجهزتك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj uređaj je uklonjen iz vaših uređaja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enhed blev fjernet fra dine enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät wurde aus deinen Geräten entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device was removed from your devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo se eliminó de tus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil a été supprimé de vos appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo è stato rimosso dai tuoi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスはあなたのデバイスから削除されました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឧបករណ៍នេះត្រូវបានដកចេញពីឧបករណ៍របស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 내 기기에서 제거되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enheten ble fjernet fra enhetene dine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie zostało usunięte z Twoich urządzeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo foi removido dos seus dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство удалено из ваших устройств."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์นี้ถูกเอาออกจากอุปกรณ์ของคุณแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aygıt aygıtlarınızdan kaldırıldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей пристрій вилучено з ваших пристроїв."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị này đã bị xóa khỏi thiết bị của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备已从你的设备中移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置已從你的裝置中移除。"
          }
        }
      }
    },
