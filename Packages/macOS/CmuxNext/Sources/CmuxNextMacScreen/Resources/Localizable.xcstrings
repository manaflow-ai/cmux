    "macScreen.card.linksGoneBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تربط مشاركة الشاشة الآن أجهزة Mac المسجّل دخولها إلى حساب cmux الخاص بك. افتح مشاركة الشاشة لرؤيتها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijeljenje ekrana sada povezuje Mac računare prijavljene na vaš cmux račun. Otvorite Dijeljenje ekrana da ih vidite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skærmdeling forbinder nu de Mac-computere, der er logget ind på din cmux-konto. Åbn Skærmdeling for at se dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirmfreigabe verbindet jetzt die Macs, die bei deinem cmux-Konto angemeldet sind. Öffne Bildschirmfreigabe, um sie zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Sharing now connects the Macs signed in to your cmux account. Open Screen Sharing to see them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir pantalla ahora conecta los Mac con sesión iniciada en tu cuenta de cmux. Abre Compartir pantalla para verlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partage d’écran connecte désormais les Mac connectés à votre compte cmux. Ouvrez Partage d’écran pour les voir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condivisione schermo ora collega i Mac che hanno eseguito l’accesso al tuo account cmux. Apri Condivisione schermo per vederli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面共有は、cmux アカウントにサインインしている Mac を接続するようになりました。画面共有を開いて確認してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឥឡូវ ការចែករំលែកអេក្រង់ ភ្ជាប់ Mac ដែលបានចូលគណនី cmux របស់អ្នក។ បើក ការចែករំលែកអេក្រង់ ដើម្បីមើលពួកវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 화면 공유는 cmux 계정에 로그인된 Mac을 연결합니다. 화면 공유를 열어 확인하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjermdeling kobler nå sammen Mac-maskinene som er logget på cmux-kontoen din. Åpne Skjermdeling for å se dem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnianie ekranu łączy teraz komputery Mac zalogowane na Twoje konto cmux. Otwórz Udostępnianie ekranu, aby je zobaczyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora o Compartilhamento de Tela conecta os Macs com sessão iniciada na sua conta do cmux. Abra o Compartilhamento de Tela para vê-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь «Общий экран» соединяет компьютеры Mac, на которых выполнен вход в вашу учетную запись cmux. Откройте «Общий экран», чтобы увидеть их."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้การแชร์หน้าจอเชื่อมต่อ Mac ที่ลงชื่อเข้าใช้บัญชี cmux ของคุณ เปิดการแชร์หน้าจอเพื่อดู"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran Paylaşma artık cmux hesabınıza giriş yapmış Mac’leri bağlıyor. Görmek için Ekran Paylaşma’yı açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тепер «Спільний екран» з’єднує комп’ютери Mac, на яких виконано вхід у ваш обліковий запис cmux. Відкрийте «Спільний екран», щоб побачити їх."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ đây Chia sẻ màn hình kết nối các máy Mac đã đăng nhập tài khoản cmux của bạn. Mở Chia sẻ màn hình để xem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕共享现在连接已登录你的 cmux 账户的 Mac。打开“屏幕共享”查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕共享現在會連接已登入你 cmux 帳號的 Mac。開啟「螢幕共享」即可查看。"
          }
        }
      }
    },
    "macScreen.card.linksGoneTitle": {
      "extractionState": "manual",
      "localizations": {
