    "devices.status.failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى مركز الأجهزة. يواصل cmux المحاولة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čvorište uređaja nije dostupno. cmux nastavlja pokušavati."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke nå enhedshubben. cmux bliver ved med at prøve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Geräte-Hub ist nicht erreichbar. cmux versucht es weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t reach the device hub. cmux keeps trying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo acceder al centro de dispositivos. cmux sigue intentándolo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre le hub des appareils. cmux continue d’essayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere l’hub dei dispositivi. cmux continua a provare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスハブに接続できません。cmuxは再試行を続けます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចទាក់ទងមជ្ឈមណ្ឌលឧបករណ៍បានទេ។ cmux នៅតែព្យាយាម។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 허브에 연결할 수 없습니다. cmux가 계속 시도합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Får ikke kontakt med enhetshuben. cmux fortsetter å prøve."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można połączyć się z centrum urządzeń. cmux ponawia próby."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar a central de dispositivos. O cmux continua tentando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с центром устройств. cmux продолжает попытки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถติดต่อศูนย์กลางอุปกรณ์ได้ cmux จะลองต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aygıt merkezine ulaşılamadı. cmux denemeye devam ediyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зв’язатися з центром пристроїв. cmux продовжує спроби."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể kết nối tới trung tâm thiết bị. cmux sẽ tiếp tục thử."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接设备中心。cmux 会继续尝试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連接裝置中心。cmux 會繼續嘗試。"
          }
        }
      }
