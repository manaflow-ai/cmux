    "devices.relay.checkNone": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد عنوان ترحيل خلال 10 ثوانٍ. تحقق من عناوين URL والسر ومن أن المنفذ مفتوح."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema adrese releja u roku od 10 sekundi. Provjerite URL-ove, tajnu i da li je port otvoren."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen relæadresse inden for 10 sekunder. Tjek URL'erne, hemmeligheden, og at porten er åben."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Relay-Adresse innerhalb von 10 Sekunden. Prüfe die URLs, das Geheimnis und ob der Port offen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No relay address within 10 seconds. Check the URLs, the secret and that the port is open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hubo dirección de relé en 10 segundos. Comprueba las URL, el secreto y que el puerto esté abierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune adresse de relais en 10 secondes. Vérifiez les URL, le secret et que le port est ouvert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun indirizzo relay entro 10 secondi. Controlla gli URL, il segreto e che la porta sia aperta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "10秒以内にリレーアドレスを取得できませんでした。URL、シークレット、ポートが開いているかを確認してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានអាសយដ្ឋាន relay ក្នុងរយៈពេល 10 វិនាទី។ ពិនិត្យ URL សម្ងាត់ និងថាតើច្រកបើកឬអត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "10초 이내에 릴레이 주소를 받지 못했습니다. URL, 비밀 키 및 포트가 열려 있는지 확인하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen reléadresse innen 10 sekunder. Sjekk URL-ene, hemmeligheten og at porten er åpen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak adresu przekaźnika w ciągu 10 sekund. Sprawdź adresy URL, sekret i czy port jest otwarty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum endereço de retransmissão em 10 segundos. Verifique as URLs, o segredo e se a porta está aberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес ретрансляции не получен за 10 секунд. Проверьте URL, секрет и то, что порт открыт."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้รับที่อยู่รีเลย์ภายใน 10 วินาที ตรวจสอบ URL ข้อมูลลับ และว่าพอร์ตเปิดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "10 saniye içinde aktarım adresi alınamadı. URL’leri, sırrı ve bağlantı noktasının açık olduğunu denetleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає адреси ретрансляції протягом 10 секунд. Перевірте URL-адреси, секрет і те, що порт відкритий."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có địa chỉ chuyển tiếp trong vòng 10 giây. Hãy kiểm tra các URL, khóa bí mật và cổng có đang mở không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "10 秒内未获得中继地址。请检查 URL、密钥以及端口是否开放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "10 秒內未取得中繼位址。請檢查 URL、密鑰以及埠是否開放。"
          }
        }
      }
    },
