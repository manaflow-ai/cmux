    "macScreen.card.failedHub": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من أن %@ ليس في وضع السكون وأنه متصل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerite da li je %@ budan i na mreži."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek, at %@ er vågen og online."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, ob %@ wach und online ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that %@ is awake and online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que %@ esté activo y conectado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que %@ est sorti de veille et en ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla che %@ sia attivo e online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@がスリープしておらず、オンラインであることを確認してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពិនិត្យថា %@ មិនស្ថិតក្នុងរបៀបដេក ហើយនៅលើអ៊ីនធឺណិត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 잠자기 상태가 아니고 온라인인지 확인하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekk at %@ er våken og tilkoblet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź, czy %@ jest wybudzony i online."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se %@ está ativo e online."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что %@ не в режиме сна и в сети."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบว่า %@ ไม่ได้อยู่ในโหมดพักเครื่องและออนไลน์อยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aygıtının uyanık ve çevrimiçi olduğunu denetleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переконайтеся, що %@ не в режимі сну та в мережі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy kiểm tra %@ đang thức và trực tuyến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查 %@ 是否已唤醒并在线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查 %@ 是否已喚醒並在線上。"
          }
        }
      }
    },
