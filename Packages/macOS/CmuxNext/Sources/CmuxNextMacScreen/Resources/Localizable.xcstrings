    "macScreen.hub.noneBodyBlocked": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يسمح %1$@ لهذا الـ Mac. غيّر ذلك على %2$@ في الإعدادات › الأجهزة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ne dozvoljava ovaj Mac. Promijenite to na %2$@ u Postavke › Uređaji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tillader ikke denne Mac. Skift det på %2$@ i Indstillinger › Enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lässt diesen Mac nicht zu. Ändere das auf %2$@ unter Einstellungen › Geräte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ doesn’t allow this Mac. Change it on %2$@ in Settings › Devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no permite este Mac. Cámbialo en %2$@ en Ajustes › Dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ n’autorise pas ce Mac. Modifiez ce réglage sur %2$@ dans Réglages › Appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ non consente questo Mac. Modificalo su %2$@ in Impostazioni › Dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@はこのMacを許可していません。%2$@の設定 › デバイスで変更してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ មិនអនុញ្ញាត Mac នេះទេ។ ប្ដូរវានៅលើ %2$@ ក្នុង ការកំណត់ › ឧបករណ៍។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에서 이 Mac을 허용하지 않습니다. %2$@의 설정 › 기기에서 변경하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tillater ikke denne Macen. Endre det på %2$@ i Innstillinger › Enheter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nie zezwala na ten Mac. Zmień to na %2$@ w Ustawienia › Urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ não permite este Mac. Altere isso em %2$@ em Ajustes › Dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ не разрешает доступ этому Mac. Измените это на %2$@ в разделе Настройки › Устройства."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ไม่อนุญาต Mac เครื่องนี้ เปลี่ยนได้ที่ %2$@ ใน การตั้งค่า › อุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bu Mac’e izin vermiyor. Bunu %2$@ üzerinde Ayarlar › Aygıtlar bölümünden değiştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ не дозволяє цей Mac. Змініть це на %2$@ у розділі Параметри › Пристрої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ không cho phép máy Mac này. Thay đổi trên %2$@ trong Cài đặt › Thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 不允许这台 Mac。请在 %2$@ 的“设置 › 设备”中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 不允許這部 Mac。請在 %2$@ 的「設定 › 裝置」中更改。"
          }
        }
      }
    },
