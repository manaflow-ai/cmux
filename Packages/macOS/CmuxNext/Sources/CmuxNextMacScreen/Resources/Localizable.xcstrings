    "macScreen.hub.loweredBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمح %@ الآن لهذا الـ Mac برؤية شاشته دون التحكم فيه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sada dozvoljava ovom Macu da vidi njegov ekran, ali ne i da ga kontroliše."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lader nu denne Mac se sin skærm, men ikke styre den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erlaubt diesem Mac jetzt, den Bildschirm zu sehen, aber nicht zu steuern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ now lets this Mac view its screen but not control it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ahora permite que este Mac vea su pantalla, pero no que la controle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ permet désormais à ce Mac de voir son écran, mais pas de le contrôler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ora consente a questo Mac di vederne lo schermo, ma non di controllarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は現在、このMacに画面の表示のみを許可し、操作は許可していません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ឥឡូវអនុញ្ញាតឱ្យ Mac នេះមើលអេក្រង់របស់វា ប៉ុន្តែមិនឱ្យគ្រប់គ្រងទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 %@에서 이 Mac이 화면을 볼 수는 있지만 제어할 수는 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lar nå denne Macen se skjermen, men ikke styre den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pozwala teraz temu Macowi widzieć swój ekran, ale nie sterować nim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ agora permite que este Mac veja a tela dele, mas não a controle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ теперь позволяет этому Mac видеть свой экран, но не управлять им."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ %@ อนุญาตให้ Mac เครื่องนี้ดูหน้าจอได้แต่ควบคุมไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ artık bu Mac’in ekranını görmesine izin veriyor ancak denetlemesine izin vermiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ тепер дозволяє цьому Mac бачити свій екран, але не керувати ним."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hiện cho phép máy Mac này xem màn hình nhưng không điều khiển."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 现在允许这台 Mac 查看其屏幕，但不能控制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 現在允許這部 Mac 檢視其螢幕，但不能控制。"
          }
        }
      }
    },
    "macScreen.hub.loweredTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر الوصول إلى العرض فقط"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristup promijenjen u samo pregled"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgang ændret til kun visning"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff auf „Nur ansehen“ geändert"
