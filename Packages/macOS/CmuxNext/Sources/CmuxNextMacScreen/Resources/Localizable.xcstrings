    "macScreen.home.allowDetail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لأجهزتك الأخرى المسجّل دخولها إلى حساب cmux هذا أن تطلب رؤية هذا الـ Mac أو التحكم فيه. أنت توافق على كل جهاز، أو تختار وصوله في الإعدادات › الأجهزة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši drugi uređaji prijavljeni na ovaj cmux račun mogu tražiti da vide ili upravljaju ovim Macom. Vi odobravate svaki uređaj ili birate njegov pristup u Postavke › Uređaji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine andre enheder, der er logget ind på denne cmux-konto, kan bede om at se eller styre denne Mac. Du godkender hver enhed eller vælger dens adgang i Indstillinger › Enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine anderen Geräte, die bei diesem cmux-Account angemeldet sind, können anfragen, diesen Mac zu sehen oder zu steuern. Du erlaubst jedes Gerät einzeln oder legst seinen Zugriff unter Einstellungen › Geräte fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your other devices signed in to this cmux account can ask to see or control this Mac. You approve each device, or choose its access in Settings › Devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus otros dispositivos con sesión iniciada en esta cuenta de cmux pueden pedir ver o controlar este Mac. Tú apruebas cada dispositivo o eliges su acceso en Ajustes › Dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos autres appareils connectés à ce compte cmux peuvent demander à voir ou à contrôler ce Mac. Vous approuvez chaque appareil ou choisissez son accès dans Réglages › Appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli altri dispositivi collegati a questo account cmux possono chiedere di vedere o controllare questo Mac. Approvi ogni dispositivo o ne scegli l’accesso in Impostazioni › Dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このcmuxアカウントにサインインしているほかのデバイスは、このMacの表示や操作をリクエストできます。デバイスごとに承認するか、設定 › デバイスでアクセス権を選択します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឧបករណ៍ផ្សេងទៀតរបស់អ្នកដែលបានចូលគណនី cmux នេះ អាចស្នើសុំមើល ឬគ្រប់គ្រង Mac នេះ។ អ្នកយល់ព្រមឧបករណ៍នីមួយៗ ឬជ្រើសរើសសិទ្ធិចូលប្រើរបស់វានៅក្នុង ការកំណត់ › ឧបករណ៍។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 cmux 계정에 로그인한 다른 기기에서 이 Mac을 보거나 제어하도록 요청할 수 있습니다. 각 기기를 직접 승인하거나 설정 › 기기에서 접근 권한을 선택하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De andre enhetene dine som er logget på denne cmux-kontoen, kan be om å se eller styre denne Macen. Du godkjenner hver enhet, eller velger tilgangen i Innstillinger › Enheter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje inne urządzenia zalogowane na to konto cmux mogą prosić o podgląd tego Maca lub sterowanie nim. Zatwierdzasz każde urządzenie albo wybierasz jego dostęp w Ustawieniach › Urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus outros dispositivos com sessão iniciada nesta conta do cmux podem pedir para ver ou controlar este Mac. Você aprova cada dispositivo ou escolhe o acesso dele em Ajustes › Dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другие ваши устройства, выполнившие вход в эту учетную запись cmux, могут запросить просмотр или управление этим Mac. Вы одобряете каждое устройство или выбираете его доступ в разделе «Настройки › Устройства»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์อื่นของคุณที่ลงชื่อเข้าใช้บัญชี cmux นี้สามารถขอดูหรือควบคุม Mac เครื่องนี้ได้ คุณอนุมัติแต่ละอุปกรณ์ หรือเลือกการเข้าถึงในการตั้งค่า › อุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cmux hesabında oturum açmış diğer aygıtlarınız bu Mac’i görmek veya denetlemek için izin isteyebilir. Her aygıtı siz onaylarsınız veya erişimini Ayarlar › Aygıtlar’da seçersiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інші ваші пристрої, на яких виконано вхід у цей обліковий запис cmux, можуть просити дозволу бачити цей Mac або керувати ним. Ви схвалюєте кожен пристрій або вибираєте його доступ у меню «Параметри › Пристрої»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thiết bị khác của bạn đã đăng nhập vào tài khoản cmux này có thể yêu cầu xem hoặc điều khiển máy Mac này. Bạn chấp thuận từng thiết bị hoặc chọn quyền truy cập của thiết bị trong Cài đặt › Thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录了此 cmux 账户的其他设备可以请求查看或控制这台 Mac。你可以逐一批准每台设备，或在“设置 › 设备”中选择其访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入了此 cmux 帳號的其他裝置可以要求檢視或控制這部 Mac。你可以逐一核准每部裝置，或在「設定 › 裝置」中選擇其取用權限。"
          }
        }
      }
    },
    "macScreen.home.allowTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بـ Mac Screen على هذا الـ Mac"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvoli Mac Screen na ovom Macu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad Mac Screen på denne Mac"
          }
        },
        "de": {
