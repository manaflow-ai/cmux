        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 권한을 요청했습니다. 해당 Mac 앞에 있는 사람이 허용해야 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ba om %@. Noen ved den Macen må tillate det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poproszono o: %@. Ktoś przy tamtym Macu musi na to pozwolić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pediu %@. Alguém naquele Mac precisa permitir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы запросили: %@. Кто-то за тем Mac должен это разрешить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณขอ %@ ผู้ที่อยู่ที่ Mac เครื่องนั้นต้องอนุญาต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ istediniz. O Mac’in başındaki birinin izin vermesi gerekiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви запросили: %@. Хтось біля того Mac має це дозволити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã yêu cầu %@. Một người tại máy Mac đó cần cho phép."
