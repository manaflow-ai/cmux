            "value": "이 Mac을 보거나 제어하는 기기가 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen enhet ser på eller styrer denne Macen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Żadne urządzenie nie wyświetla tego Maca ani nim nie steruje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhum dispositivo está vendo ou controlando este Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ни одно устройство не просматривает этот Mac и не управляет им."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่มีอุปกรณ์ใดกำลังดูหรือควบคุม Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu Mac'i görüntüleyen veya denetleyen bir aygıt yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Жоден пристрій не переглядає цей Mac і не керує ним."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không có thiết bị nào đang xem hoặc điều khiển máy Mac này."
          }
        },
        "zh-Hans": {
