    "macScreen.home.error.notALink": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هذا ليس رابط Mac Screen كاملًا. انسخه مرة أخرى من «مشاركة جهاز Mac هذا» على جهاز Mac الآخر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "To nije potpun Mac Screen link. Ponovo ga kopirajte iz opcije Dijeli ovaj Mac na drugom Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det er ikke et fuldstændigt Mac Screen-link. Kopiér det igen fra Del denne Mac på den anden Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das ist kein vollständiger Mac Screen-Link. Kopiere ihn erneut über „Diesen Mac teilen“ auf dem anderen Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That isn’t a complete Mac Screen link. Copy it again from Share This Mac on the other Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ese no es un enlace completo de Mac Screen. Vuelve a copiarlo desde Compartir este Mac en el otro Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce n’est pas un lien Mac Screen complet. Copiez-le de nouveau depuis Partager ce Mac sur l’autre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo non è un link Mac Screen completo. Copialo di nuovo da Condividi questo Mac sull’altro Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "完全な Mac Screen リンクではありません。もう一方のMacの「このMacを共有」からもう一度コピーしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "នោះមិនមែនជាតំណ Mac Screen ពេញលេញទេ។ សូមចម្លងវាម្តងទៀតពី ចែករំលែក Mac នេះ នៅលើ Mac មួយទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "완전한 Mac Screen 링크가 아닙니다. 다른 Mac의 이 Mac 공유에서 다시 복사하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det er ikke en fullstendig Mac Screen-lenke. Kopier den på nytt fra Del denne Macen på den andre Macen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "To nie jest pełne łącze Mac Screen. Skopiuj je ponownie z opcji Udostępnij ten Mac na drugim Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este não é um link completo do Mac Screen. Copie-o novamente em Compartilhar Este Mac no outro Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Это неполная ссылка Mac Screen. Скопируйте ее снова в разделе «Поделиться этим Mac» на другом Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "นี่ไม่ใช่ลิงก์ Mac Screen ที่สมบูรณ์ คัดลอกอีกครั้งจาก แชร์ Mac เครื่องนี้ บน Mac อีกเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu tam bir Mac Screen bağlantısı değil. Diğer Mac’teki Bu Mac’i Paylaş bölümünden yeniden kopyalayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Це неповне посилання Mac Screen. Скопіюйте його знову в розділі «Поширити цей Mac» на іншому Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đó không phải là liên kết Mac Screen đầy đủ. Hãy sao chép lại từ Chia sẻ máy Mac này trên máy Mac kia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这不是完整的 Mac Screen 链接。请在另一台 Mac 的“共享这台 Mac”中再次拷贝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這不是完整的 Mac Screen 連結。請在另一部 Mac 的「分享這部 Mac」中再次拷貝。"
          }
        }
      }
    },
    "macScreen.home.error.notAStream": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هذا الرابط مخصص لمرحِّل VNC، وليس لبث الشاشة. شارك جهاز Mac من cmux أو باستخدام cmux-vnc-host --capture."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovaj link je za VNC relej, a ne za prijenos ekrana. Dijelite Mac iz cmuxa ili pomoću cmux-vnc-host --capture."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dette link er til et VNC-relæ, ikke en skærmstream. Del Mac’en fra cmux eller med cmux-vnc-host --capture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Link ist für ein VNC-Relay, nicht für einen Bildschirmstream. Teile den Mac über cmux oder mit cmux-vnc-host --capture."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This link is for a VNC relay, not a screen stream. Share the Mac from cmux or with cmux-vnc-host --capture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este enlace es para un relé VNC, no para una transmisión de pantalla. Comparte el Mac desde cmux o con cmux-vnc-host --capture."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce lien concerne un relais VNC, pas un flux d’écran. Partagez le Mac depuis cmux ou avec cmux-vnc-host --capture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo link è per un relay VNC, non per uno stream dello schermo. Condividi il Mac da cmux o con cmux-vnc-host --capture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このリンクはVNCリレー用で、画面ストリーム用ではありません。cmuxから、またはcmux-vnc-host --captureでMacを共有してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "តំណនេះសម្រាប់ VNC relay មិនមែនសម្រាប់ការផ្សាយអេក្រង់ទេ។ ចែករំលែក Mac ពី cmux ឬដោយប្រើ cmux-vnc-host --capture។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 링크는 화면 스트림이 아닌 VNC 릴레이용입니다. cmux 또는 cmux-vnc-host --capture로 Mac을 공유하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne lenken er for et VNC-relé, ikke en skjermstrøm. Del Macen fra cmux eller med cmux-vnc-host --capture."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "To łącze dotyczy przekaźnika VNC, a nie strumienia ekranu. Udostępnij Maca z cmux lub za pomocą cmux-vnc-host --capture."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este link é de um relay VNC, não de uma transmissão de tela. Compartilhe o Mac pelo cmux ou com cmux-vnc-host --capture."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Эта ссылка предназначена для VNC-ретранслятора, а не для трансляции экрана. Откройте доступ к Mac из cmux или с помощью cmux-vnc-host --capture."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลิงก์นี้ใช้สำหรับรีเลย์ VNC ไม่ใช่สตรีมหน้าจอ แชร์ Mac จาก cmux หรือด้วย cmux-vnc-host --capture"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu bağlantı ekran akışı için değil, bir VNC aktarıcısı için. Mac’i cmux’tan veya cmux-vnc-host --capture ile paylaşın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Це посилання для VNC-ретранслятора, а не для трансляції екрана. Поширте Mac із cmux або за допомогою cmux-vnc-host --capture."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Liên kết này dành cho chuyển tiếp VNC, không phải luồng màn hình. Chia sẻ máy Mac từ cmux hoặc bằng cmux-vnc-host --capture."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此链接用于 VNC 中继，而非屏幕流。请从 cmux 或使用 cmux-vnc-host --capture 共享 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此連結用於 VNC 中繼，而非螢幕串流。請從 cmux 或使用 cmux-vnc-host --capture 分享 Mac。"
          }
        }
      }
    },
