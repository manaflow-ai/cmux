    "macScreen.hub.reason.removed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت إزالة جهاز من أجهزتك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uređaj je uklonjen iz vaših uređaja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En enhed blev fjernet fra dine enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Gerät wurde aus deinen Geräten entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A device was removed from your devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminó un dispositivo de tus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appareil a été supprimé de vos appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dispositivo è stato rimosso dai tuoi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスがあなたのデバイスから削除されました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឧបករណ៍មួយត្រូវបានដកចេញពីឧបករណ៍របស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 내 기기에서 제거되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En enhet ble fjernet fra enhetene dine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urządzenie zostało usunięte z Twoich urządzeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dispositivo foi removido dos seus dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство удалено из ваших устройств."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์ถูกเอาออกจากอุปกรณ์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir aygıt aygıtlarınızdan kaldırıldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пристрій вилучено з ваших пристроїв."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một thiết bị đã bị xóa khỏi thiết bị của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
