    "macScreen.hub.connectBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العرض فقط يُظهر الشاشة. التحكم الكامل يرسل أيضًا نقراتك ومفاتيحك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo pregled prikazuje ekran. Puna kontrola šalje i vaše klikove i tipke."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun visning viser skærmen. Fuld kontrol sender også dine klik og taster."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nur ansehen“ zeigt den Bildschirm. „Volle Kontrolle“ sendet auch deine Klicks und Tasten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View Only shows the screen. Full Control also sends your clicks and keys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo ver muestra la pantalla. Control total también envía tus clics y teclas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichage seul montre l’écran. Contrôle total envoie aussi vos clics et vos touches."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo visualizzazione mostra lo schermo. Controllo completo invia anche i tuoi clic e tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示のみは画面を表示します。フルコントロールではクリックとキー入力も送信します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មើលតែប៉ុណ្ណោះបង្ហាញអេក្រង់។ ការគ្រប់គ្រងពេញលេញក៏ផ្ញើការចុច និងគ្រាប់ចុចរបស់អ្នកផងដែរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보기 전용은 화면만 표시합니다. 전체 제어는 클릭과 키 입력도 보냅니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun visning viser skjermen. Full kontroll sender også klikkene og tastetrykkene dine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko podgląd wyświetla ekran. Pełna kontrola wysyła też Twoje kliknięcia i klawisze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente Visualização mostra a tela. Controle Total também envia seus cliques e teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Только просмотр» показывает экран. «Полный контроль» также передает ваши нажатия и клавиши."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูเท่านั้นจะแสดงหน้าจอ ควบคุมทั้งหมดจะส่งการคลิกและการกดปุ่มของคุณด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca Görüntüleme ekranı gösterir. Tam Denetim ayrıca tıklamalarınızı ve tuşlarınızı gönderir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Лише перегляд» показує екран. «Повний контроль» також надсилає ваші клацання та натискання клавіш."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ xem hiển thị màn hình. Toàn quyền điều khiển còn gửi các lần bấm và phím của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“仅查看”会显示屏幕。“完全控制”还会发送你的点按和按键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「僅檢視」會顯示螢幕。「完全控制」還會傳送你的按一下和按鍵。"
          }
        }
      }
    },
