    "macScreen.home.screenRecordingDetail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتيح لـ cmux إرسال هذه الشاشة. قد يطلب منك macOS إنهاء cmux وإعادة فتحه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Omogućava cmuxu da šalje ovaj ekran. macOS može tražiti da zatvorite i ponovo otvorite cmux."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lader cmux sende denne skærm. macOS beder dig muligvis om at slutte og åbne cmux igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erlaubt cmux, diesen Bildschirm zu senden. macOS fordert dich eventuell auf, cmux zu beenden und erneut zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets cmux send this screen. macOS may ask you to quit and reopen cmux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite que cmux envíe esta pantalla. Puede que macOS te pida salir de cmux y volver a abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permet à cmux d’envoyer cet écran. macOS peut vous demander de quitter et de rouvrir cmux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consente a cmux di inviare questo schermo. macOS potrebbe chiederti di uscire da cmux e riaprirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmuxがこの画面を送信できるようにします。macOSからcmuxを終了して再度開くよう求められる場合があります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អនុញ្ញាតឱ្យ cmux ផ្ញើអេក្រង់នេះ។ macOS អាចសុំឱ្យអ្នកចាកចេញ ហើយបើក cmux ឡើងវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux가 이 화면을 전송할 수 있게 합니다. macOS에서 cmux를 종료하고 다시 열도록 요청할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lar cmux sende denne skjermen. macOS kan be deg om å avslutte og åpne cmux på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pozwala cmux wysyłać ten ekran. macOS może poprosić o zamknięcie i ponowne otwarcie cmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite que o cmux envie esta tela. O macOS pode pedir que você encerre e reabra o cmux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Позволяет cmux передавать этот экран. macOS может попросить завершить и снова открыть cmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อนุญาตให้ cmux ส่งหน้าจอนี้ macOS อาจขอให้คุณออกและเปิด cmux ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux’un bu ekranı göndermesine izin verir. macOS, cmux’tan çıkıp yeniden açmanızı isteyebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дозволяє cmux передавати цей екран. macOS може попросити вийти з cmux і відкрити його знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cho phép cmux gửi màn hình này. macOS có thể yêu cầu bạn thoát và mở lại cmux."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "允许 cmux 发送此屏幕。macOS 可能会要求你退出并重新打开 cmux。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "允許 cmux 傳送此螢幕。macOS 可能會要求你結束並重新打開 cmux。"
          }
        }
      }
    },
    "macScreen.home.invalidHubAddress": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل Mac Screen عبر مركز الأجهزة. عنوان مركز الأجهزة في الإعدادات › التطوير ليس عنوان ويب صالحًا؛ صحّحه، أو امسحه لاستخدام المركز المدمج."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Screen radi preko centra uređaja. Adresa centra uređaja u Postavke › Razvoj nije ispravna web adresa; ispravite je ili je obrišite da koristite ugrađeni centar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Screen virker gennem enhedshubben. Enhedshubbens adresse i Indstillinger › Udvikling er ikke en gyldig webadresse; ret den, eller ryd den for at bruge den indbyggede hub."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Screen funktioniert über den Geräte-Hub. Die Geräte-Hub-Adresse unter Einstellungen › Entwicklung ist keine gültige Webadresse; korrigiere sie oder leere sie, um den eingebauten Hub zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Screen works through the device hub. The Device Hub Address in Settings › Development is not a valid web address; fix it, or clear it to use the built-in hub."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Screen funciona a través del centro de dispositivos. La dirección del centro de dispositivos en Ajustes › Desarrollo no es una dirección web válida; corrígela o bórrala para usar el centro integrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Screen passe par le hub d’appareils. L’adresse du hub d’appareils dans Réglages › Développement n’est pas une adresse web valide ; corrigez-la ou effacez-la pour utiliser le hub intégré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Screen funziona tramite l’hub dei dispositivi. L’indirizzo dell’hub dispositivi in Impostazioni › Sviluppo non è un indirizzo web valido; correggilo o cancellalo per usare l’hub integrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Screen はデバイスハブを介して動作します。設定 › 開発 のデバイスハブのアドレスが有効な Web アドレスではありません。修正するか、空にして内蔵のハブを使ってください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Screen ដំណើរការតាមរយៈមជ្ឈមណ្ឌលឧបករណ៍។ អាសយដ្ឋានមជ្ឈមណ្ឌលឧបករណ៍នៅក្នុង ការកំណត់ › ការអភិវឌ្ឍ មិនមែនជាអាសយដ្ឋានគេហទំព័រត្រឹមត្រូវទេ។ កែវា ឬសម្អាតវាដើម្បីប្រើមជ្ឈមណ្ឌលដែលភ្ជាប់មកជាមួយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Screen은 기기 허브를 통해 작동합니다. 설정 › 개발의 기기 허브 주소가 올바른 웹 주소가 아닙니다. 주소를 고치거나 비워서 내장 허브를 사용하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Screen fungerer via enhetshuben. Adressen til enhetshuben i Innstillinger › Utvikling er ikke en gyldig nettadresse; rett den, eller tøm den for å bruke den innebygde huben."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Screen działa przez centrum urządzeń. Adres centrum urządzeń w Ustawienia › Programowanie nie jest prawidłowym adresem internetowym; popraw go lub wyczyść, aby używać wbudowanego centrum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac Screen funciona pela central de dispositivos. O endereço da central de dispositivos em Ajustes › Desenvolvimento não é um endereço web válido; corrija-o ou apague-o para usar a central integrada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Screen работает через центр устройств. Адрес центра устройств в Настройки › Разработка не является допустимым веб-адресом; исправьте его или очистите, чтобы использовать встроенный центр."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Screen ทำงานผ่านฮับอุปกรณ์ ที่อยู่ฮับอุปกรณ์ใน การตั้งค่า › การพัฒนา ไม่ใช่ที่อยู่เว็บที่ถูกต้อง แก้ไข หรือล้างออกเพื่อใช้ฮับในตัว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Screen cihaz merkezi üzerinden çalışır. Ayarlar › Geliştirme’deki Cihaz Merkezi Adresi geçerli bir web adresi değil; düzeltin ya da yerleşik merkezi kullanmak için temizleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Screen працює через центр пристроїв. Адреса центру пристроїв у Параметри › Розробка не є дійсною вебадресою; виправте її або очистьте, щоб використовувати вбудований центр."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Screen hoạt động qua trung tâm thiết bị. Địa chỉ trung tâm thiết bị trong Cài đặt › Phát triển không phải là địa chỉ web hợp lệ; hãy sửa lại hoặc xóa đi để dùng trung tâm tích hợp sẵn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Screen 通过设备中心工作。设置 › 开发 中的设备中心地址不是有效的网址；请修正，或清空以使用内置的设备中心。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Screen 透過裝置中心運作。設定 › 開發 中的裝置中心位址不是有效的網址；請修正，或清空以使用內建的裝置中心。"
          }
        }
      }
    },
    "macScreen.home.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اعرض أجهزة Mac الأخرى وتحكّم بها من علامة تبويب في cmux."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gledajte i upravljajte drugim Mac računarima iz cmux kartice."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se og styr dine andre Mac-computere fra en cmux-fane."
