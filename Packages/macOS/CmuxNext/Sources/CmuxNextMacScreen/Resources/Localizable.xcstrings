    "macScreen.home.forgetBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لعرضه مرة أخرى، قم بإقرانه باستخدام رابطه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Da biste ga ponovo prikazali, uparite ga pomoću njegovog linka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du skal parre den med dens link for at vise den igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um ihn wieder anzuzeigen, kopple ihn mit seinem Link."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To show it again, pair it with its link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para volver a verlo, enlázalo con su enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour l’afficher de nouveau, jumelez-le avec son lien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Per mostrarlo di nuovo, abbinalo con il suo link."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "再度表示するには、そのリンクでペアリングしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ដើម្បីបង្ហាញវាម្ដងទៀត សូមផ្គូផ្គងវាជាមួយតំណរបស់វា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다시 표시하려면 해당 링크로 페어링하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "For å vise den igjen må du pare den med koblingen dens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aby go ponownie wyświetlić, sparuj go za pomocą jego łącza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para mostrá-lo novamente, emparelhe-o com o link dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Чтобы снова показать его, создайте пару по его ссылке."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หากต้องการแสดงอีกครั้ง ให้จับคู่ด้วยลิงก์ของเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yeniden göstermek için bağlantısıyla eşleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Щоб знову показати його, створіть пару за його посиланням."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Để hiển thị lại, hãy ghép đôi bằng liên kết của máy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "要再次显示，请使用其链接进行配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "若要再次顯示，請使用其連結進行配對。"
          }
        }
      }
    },
