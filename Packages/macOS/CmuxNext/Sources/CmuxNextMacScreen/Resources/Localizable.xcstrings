    "macScreen.hub.offlineBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح cmux على ذلك الـ Mac وتأكد من أنه مسجّل الدخول."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite cmux na tom Macu i provjerite da li je prijavljen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn cmux på den Mac, og sørg for, at den er logget ind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne cmux auf diesem Mac und stelle sicher, dass er angemeldet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open cmux on that Mac and make sure it is signed in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre cmux en ese Mac y asegúrate de que tiene la sesión iniciada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez cmux sur ce Mac et vérifiez qu’il est connecté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri cmux su quel Mac e assicurati che abbia effettuato l’accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのMacでcmuxを開き、サインインしていることを確認してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បើក cmux នៅលើ Mac នោះ ហើយប្រាកដថាវាបានចូលហើយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 Mac에서 cmux를 열고 로그인되어 있는지 확인하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne cmux på den Macen og sørg for at den er pålogget."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz cmux na tamtym Macu i upewnij się, że jest zalogowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o cmux naquele Mac e verifique se a sessão está iniciada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте cmux на том Mac и убедитесь, что вход выполнен."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด cmux บน Mac เครื่องนั้นและตรวจสอบให้แน่ใจว่าลงชื่อเข้าใช้แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac’te cmux’u açın ve oturum açık olduğundan emin olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте cmux на тому Mac і переконайтеся, що в ньому виконано вхід."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở cmux trên máy Mac đó và đảm bảo đã đăng nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在那台 Mac 上打开 cmux，并确保已登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在那部 Mac 上打開 cmux，並確定已登入。"
          }
        }
      }
    },
    "macScreen.hub.offlineTitle": {
      "extractionState": "manual",
      "localizations": {
