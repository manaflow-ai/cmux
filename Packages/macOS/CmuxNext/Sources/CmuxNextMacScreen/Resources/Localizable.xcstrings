    "devices.relay.checkRefused": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض المُرحِّل بيانات الاعتماد. تحقق من السر المشترك، أو من اسم المستخدم وكلمة السر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Relej je odbio vjerodajnice. Provjerite zajedničku tajnu ili korisničko ime i lozinku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Relæet afviste loginoplysningerne. Tjek den delte hemmelighed eller brugernavnet og adgangskoden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Relay hat die Anmeldedaten abgelehnt. Prüfe das gemeinsame Geheimnis oder Benutzername und Passwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The relay refused the credentials. Check the shared secret, or the username and password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El relé rechazó las credenciales. Comprueba el secreto compartido o el usuario y la contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le relais a refusé les identifiants. Vérifiez le secret partagé, ou le nom d’utilisateur et le mot de passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il relay ha rifiutato le credenziali. Controlla il segreto condiviso, oppure nome utente e password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リレーが認証情報を拒否しました。共有シークレット、またはユーザ名とパスワードを確認してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "relay បានបដិសេធព័ត៌មានផ្ទៀងផ្ទាត់។ ពិនិត្យសម្ងាត់រួម ឬឈ្មោះអ្នកប្រើ និងពាក្យសម្ងាត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "릴레이가 자격 증명을 거부했습니다. 공유 비밀 키 또는 사용자 이름과 암호를 확인하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Reléet avviste påloggingsinformasjonen. Sjekk den delte hemmeligheten, eller brukernavnet og passordet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekaźnik odrzucił dane uwierzytelniające. Sprawdź wspólny sekret albo nazwę użytkownika i hasło."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O retransmissor recusou as credenciais. Verifique o segredo compartilhado ou o nome de usuário e a senha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ретранслятор отклонил учетные данные. Проверьте общий секрет или имя пользователя и пароль."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีเลย์ปฏิเสธข้อมูลประจำตัว ตรวจสอบข้อมูลลับที่ใช้ร่วมกัน หรือชื่อผู้ใช้และรหัสผ่าน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktarıcı kimlik bilgilerini reddetti. Paylaşılan sırrı veya kullanıcı adını ve parolayı denetleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ретранслятор відхилив облікові дані. Перевірте спільний секрет або ім’я користувача та пароль."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ chuyển tiếp đã từ chối thông tin xác thực. Hãy kiểm tra khóa bí mật dùng chung, hoặc tên người dùng và mật khẩu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中继拒绝了凭据。请检查共享密钥，或用户名和密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中繼拒絕了憑證。請檢查共享密鑰，或使用者名稱和密碼。"
          }
        }
      }
    },
    "devices.relay.checkUnreachable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى المُرحِّل. تحقق من عناوين URL الخاصة به ومن أن منفذه مفتوح."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Relej nije dostupan. Provjerite njegove URL-ove i da li je njegov port otvoren."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Relæet kan ikke nås. Tjek dets URL'er, og at dets port er åben."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Relay ist nicht erreichbar. Prüfe seine URLs und ob sein Port offen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The relay can’t be reached. Check its URLs and that its port is open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder al relé. Comprueba sus URL y que su puerto esté abierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le relais est injoignable. Vérifiez ses URL et que son port est ouvert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il relay non è raggiungibile. Controlla i suoi URL e che la sua porta sia aperta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リレーに接続できません。URLとポートが開いているかを確認してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចទាក់ទង relay បានទេ។ ពិនិត្យ URL របស់វា និងថាតើច្រករបស់វាបើកឬអត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "릴레이에 연결할 수 없습니다. URL과 포트가 열려 있는지 확인하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Reléet kan ikke nås. Sjekk URL-ene og at porten er åpen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można połączyć się z przekaźnikiem. Sprawdź jego adresy URL i czy jego port jest otwarty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível acessar o retransmissor. Verifique as URLs dele e se a porta está aberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ретранслятор недоступен. Проверьте его URL и то, что его порт открыт."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถติดต่อรีเลย์ได้ ตรวจสอบ URL ของรีเลย์ และว่าพอร์ตเปิดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktarıcıya ulaşılamıyor. URL’lerini ve bağlantı noktasının açık olduğunu denetleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ретранслятор недоступний. Перевірте його URL-адреси і те, що його порт відкритий."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể kết nối tới máy chủ chuyển tiếp. Hãy kiểm tra các URL của nó và cổng có đang mở không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接中继。请检查其 URL 以及端口是否开放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連接中繼。請檢查其 URL 以及埠是否開放。"
          }
        }
      }
    },
