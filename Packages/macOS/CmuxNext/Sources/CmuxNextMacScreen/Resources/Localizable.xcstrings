    "macScreen.card.relayNone": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتمكن أي مُرحِّل من توصيل جهازي Mac. تحقق من المُرحِّلات في الإعدادات › الأجهزة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nijedan relej nije mogao povezati ova dva Maca. Provjerite svoje releje u Postavke › Uređaji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet relæ kunne forbinde de to Mac-computere. Tjek dine relæer i Indstillinger › Enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Relay konnte die beiden Macs verbinden. Prüfe deine Relays unter Einstellungen › Geräte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No relay could connect the two Macs. Check your relays in Settings › Devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún relé pudo conectar los dos Mac. Comprueba tus relés en Ajustes › Dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun relais n’a pu connecter les deux Mac. Vérifiez vos relais dans Réglages › Appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun relay è riuscito a collegare i due Mac. Controlla i tuoi server relay in Impostazioni › Dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2台のMacを接続できるリレーがありませんでした。設定 › デバイスでリレーを確認してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មាន relay ណាអាចភ្ជាប់ Mac ទាំងពីរបានទេ។ ពិនិត្យ relay របស់អ្នកនៅក្នុង ការកំណត់ › ឧបករណ៍។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 Mac을 연결할 수 있는 릴레이가 없습니다. 설정 › 기기에서 릴레이를 확인하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen releer kunne koble sammen de to Macene. Sjekk releene dine i Innstillinger › Enheter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żaden przekaźnik nie mógł połączyć obu Maców. Sprawdź swoje przekaźniki w Ustawieniach › Urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum retransmissor conseguiu conectar os dois Macs. Verifique seus retransmissores em Ajustes › Dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни один ретранслятор не смог соединить два Mac. Проверьте ретрансляторы в разделе «Настройки › Устройства»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีรีเลย์ใดเชื่อมต่อ Mac ทั้งสองเครื่องได้ ตรวจสอบรีเลย์ของคุณในการตั้งค่า › อุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir aktarıcı iki Mac’i bağlayamadı. Aktarıcılarınızı Ayarlar › Aygıtlar’da denetleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден ретранслятор не зміг з’єднати два Mac. Перевірте ретранслятори в меню «Параметри › Пристрої»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không máy chủ chuyển tiếp nào có thể kết nối hai máy Mac. Hãy kiểm tra máy chủ chuyển tiếp trong Cài đặt › Thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有中继能连接这两台 Mac。请在“设置 › 设备”中检查你的中继。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有中繼能連接這兩部 Mac。請在「設定 › 裝置」中檢查你的中繼。"
          }
        }
      }
    },
    "macScreen.card.relayRefused": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض المُرحِّل بيانات الاعتماد. تحقق من سره في الإعدادات › الأجهزة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Relej je odbio vjerodajnice. Provjerite njegovu tajnu u Postavke › Uređaji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Relæet afviste loginoplysningerne. Tjek dets hemmelighed i Indstillinger › Enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Relay hat die Anmeldedaten abgelehnt. Prüfe sein Geheimnis unter Einstellungen › Geräte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The relay refused the credentials. Check its secret in Settings › Devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El relé rechazó las credenciales. Comprueba su secreto en Ajustes › Dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le relais a refusé les identifiants. Vérifiez son secret dans Réglages › Appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il relay ha rifiutato le credenziali. Controlla il suo segreto in Impostazioni › Dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リレーが認証情報を拒否しました。設定 › デバイスでシークレットを確認してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "relay បានបដិសេធព័ត៌មានផ្ទៀងផ្ទាត់។ ពិនិត្យសម្ងាត់របស់វានៅក្នុង ការកំណត់ › ឧបករណ៍។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "릴레이가 자격 증명을 거부했습니다. 설정 › 기기에서 비밀 키를 확인하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Reléet avviste påloggingsinformasjonen. Sjekk hemmeligheten i Innstillinger › Enheter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekaźnik odrzucił dane uwierzytelniające. Sprawdź jego sekret w Ustawieniach › Urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O retransmissor recusou as credenciais. Verifique o segredo dele em Ajustes › Dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ретранслятор отклонил учетные данные. Проверьте его секрет в разделе «Настройки › Устройства»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีเลย์ปฏิเสธข้อมูลประจำตัว ตรวจสอบข้อมูลลับในการตั้งค่า › อุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktarıcı kimlik bilgilerini reddetti. Sırrını Ayarlar › Aygıtlar’da denetleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ретранслятор відхилив облікові дані. Перевірте його секрет у меню «Параметри › Пристрої»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ chuyển tiếp đã từ chối thông tin xác thực. Hãy kiểm tra khóa bí mật của nó trong Cài đặt › Thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中继拒绝了凭据。请在“设置 › 设备”中检查其密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中繼拒絕了憑證。請在「設定 › 裝置」中檢查其密鑰。"
          }
        }
      }
    },
    "macScreen.card.relayUnreachable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى المُرحِّل. تحقق من عنوان URL الخاص به ومن أن منفذه مفتوح."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Relej nije dostupan. Provjerite njegov URL i da li je njegov port otvoren."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Relæet kan ikke nås. Tjek dets URL, og at dets port er åben."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Relay ist nicht erreichbar. Prüfe seine URL und ob sein Port offen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The relay can’t be reached. Check its URL and that its port is open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder al relé. Comprueba su URL y que su puerto esté abierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le relais est injoignable. Vérifiez son URL et que son port est ouvert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il relay non è raggiungibile. Controlla il suo URL e che la sua porta sia aperta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リレーに接続できません。URLとポートが開いているかを確認してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចទាក់ទង relay បានទេ។ ពិនិត្យ URL របស់វា និងថាតើច្រករបស់វាបើកឬអត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "릴레이에 연결할 수 없습니다. URL과 포트가 열려 있는지 확인하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Reléet kan ikke nås. Sjekk URL-en og at porten er åpen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można połączyć się z przekaźnikiem. Sprawdź jego adres URL i czy jego port jest otwarty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível acessar o retransmissor. Verifique a URL dele e se a porta está aberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ретранслятор недоступен. Проверьте его URL и то, что его порт открыт."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถติดต่อรีเลย์ได้ ตรวจสอบ URL ของรีเลย์ และว่าพอร์ตเปิดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktarıcıya ulaşılamıyor. URL’sini ve bağlantı noktasının açık olduğunu denetleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ретранслятор недоступний. Перевірте його URL-адресу і те, що його порт відкритий."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể kết nối tới máy chủ chuyển tiếp. Hãy kiểm tra URL của nó và cổng có đang mở không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接中继。请检查其 URL 以及端口是否开放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連接中繼。請檢查其 URL 以及埠是否開放。"
          }
        }
      }
    },
