    "macScreen.hub.reason.revoked": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أزال %@ وصول هذا الـ Mac إلى شاشته."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je uklonio pristup ovog Maca svom ekranu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fjernede denne Macs adgang til sin skærm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat den Zugriff dieses Macs auf seinen Bildschirm entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ removed this Mac’s access to its screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ retiró el acceso de este Mac a su pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a retiré l’accès de ce Mac à son écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha rimosso l’accesso di questo Mac al suo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@がこのMacによる画面へのアクセスを削除しました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ បានដកសិទ្ធិចូលប្រើអេក្រង់របស់វាពី Mac នេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 이 Mac의 화면 접근 권한을 제거했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fjernet denne Macens tilgang til skjermen sin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ odebrał temu Macowi dostęp do swojego ekranu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ removeu o acesso deste Mac à tela dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ отозвал доступ этого Mac к своему экрану."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ เอาสิทธิ์เข้าถึงหน้าจอของตนออกจาก Mac เครื่องนี้แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, bu Mac’in ekranına erişimini kaldırdı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ скасував доступ цього Mac до свого екрана."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã xóa quyền truy cập màn hình của nó khỏi máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已移除这台 Mac 对其屏幕的访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已移除這部 Mac 對其螢幕的取用權限。"
          }
        }
      }
    },
