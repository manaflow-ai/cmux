    "macScreen.home.hubReady": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جاهز. يمكن لأجهزتك الاتصال."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremno. Vaši uređaji se mogu povezati."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klar. Dine enheder kan forbinde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereit. Deine Geräte können sich verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready. Your devices can connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo. Tus dispositivos pueden conectarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prêt. Vos appareils peuvent se connecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto. I tuoi dispositivi possono connettersi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備完了。デバイスから接続できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រួចរាល់។ ឧបករណ៍របស់អ្នកអាចតភ្ជាប់បាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "준비되었습니다. 기기에서 연결할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klar. Enhetene dine kan koble til."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotowe. Twoje urządzenia mogą się połączyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto. Seus dispositivos podem se conectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово. Ваши устройства могут подключаться."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พร้อมแล้ว อุปกรณ์ของคุณเชื่อมต่อได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır. Aygıtlarınız bağlanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово. Ваші пристрої можуть під’єднатися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sẵn sàng. Các thiết bị của bạn có thể kết nối."
          }
        },
