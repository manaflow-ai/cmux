    "macScreen.hub.reason.signedOutOrQuit": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل Mac في هذه الجلسة خروجه من cmux أو أنهاه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac u ovoj sesiji se odjavio iz cmux-a ili ga je zatvorio."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En Mac i denne session loggede ud af cmux eller afsluttede det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Mac in dieser Sitzung hat sich von cmux abgemeldet oder cmux beendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Mac in this session signed out of cmux or quit it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Mac de esta sesión cerró sesión en cmux o salió de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Mac de cette session s’est déconnecté de cmux ou l’a quitté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Mac in questa sessione è uscito dall’account di cmux o ha chiuso l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションのMacがcmuxからサインアウトしたか、cmuxを終了しました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac មួយក្នុងវគ្គនេះបានចេញពី cmux ឬបានបិទវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세션의 Mac이 cmux에서 로그아웃했거나 cmux를 종료했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En Mac i denne økten logget ut av cmux eller avsluttet det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac w tej sesji wylogował się z cmux lub zamknął aplikację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Mac nesta sessão saiu da conta do cmux ou encerrou o app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac в этом сеансе вышел из cmux или закрыл приложение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ในเซสชันนี้ออกจากระบบ cmux หรือปิดแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oturumdaki bir Mac cmux’tan çıkış yaptı veya uygulamayı kapattı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac у цьому сеансі вийшов із cmux або закрив застосунок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một máy Mac trong phiên này đã đăng xuất khỏi cmux hoặc thoát ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会话中的一台 Mac 已退出 cmux 登录或退出了 cmux。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此工作階段中的一部 Mac 已登出 cmux 或結束了 cmux。"
          }
        }
      }
    },
