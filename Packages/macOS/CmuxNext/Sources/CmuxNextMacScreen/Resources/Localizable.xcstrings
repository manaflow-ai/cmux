        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សិទ្ធិចូលប្រើបានប្ដូរទៅមើលប៉ុណ្ណោះ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근 권한이 보기 전용으로 변경됨"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilgang endret til kun visning"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp zmieniony na tylko podgląd"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesso alterado para somente visualização"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ изменен на «Только просмотр»"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิทธิ์เข้าถึงเปลี่ยนเป็นดูอย่างเดียว"
