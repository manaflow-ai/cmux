    "devices.error.credentials": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل اسم المستخدم وكلمة السر للمُرحِّل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite korisničko ime i lozinku releja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast relæets brugernavn og adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib Benutzername und Passwort des Relays ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the relay’s username and password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el usuario y la contraseña del relé."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le nom d’utilisateur et le mot de passe du relais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci nome utente e password del relay."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リレーのユーザ名とパスワードを入力してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ចូលឈ្មោះអ្នកប្រើ និងពាក្យសម្ងាត់របស់ relay។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "릴레이의 사용자 이름과 암호를 입력하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn brukernavnet og passordet for reléet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź nazwę użytkownika i hasło przekaźnika."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o nome de usuário e a senha do retransmissor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите имя пользователя и пароль ретранслятора."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนชื่อผู้ใช้และรหัสผ่านของรีเลย์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktarıcının kullanıcı adını ve parolasını girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть ім’я користувача та пароль ретранслятора."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập tên người dùng và mật khẩu của máy chủ chuyển tiếp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入中继的用户名和密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入中繼的使用者名稱和密碼。"
          }
        }
      }
    },
    "devices.error.generic": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم ينجح ذلك. حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "To nije uspjelo. Pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det virkede ikke. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hat nicht funktioniert. Versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That didn’t work. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No ha funcionado. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela n’a pas fonctionné. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ha funzionato. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うまくいきませんでした。もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនដំណើរការទេ។ សូមព្យាយាមម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업을 완료할 수 없습니다. 다시 시도하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det fungerte ikke. Prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não funcionou. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не получилось. Повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สำเร็จ ลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işe yaramadı. Yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося. Спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thành công. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作未成功。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "操作未成功。請再試一次。"
          }
        }
      }
    },
    "devices.error.gone": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد ذلك الجهاز ضمن أجهزتك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Taj uređaj više nije među vašim uređajima."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den enhed er ikke længere blandt dine enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät ist nicht mehr unter deinen Geräten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That device is no longer in your devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese dispositivo ya no está en tus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne fait plus partie de vos appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel dispositivo non è più tra i tuoi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのデバイスはもうあなたのデバイスにありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឧបករណ៍នោះលែងស្ថិតនៅក្នុងឧបករណ៍របស់អ្នកទៀតហើយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 기기가 더 이상 내 기기에 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den enheten er ikke lenger blant enhetene dine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego urządzenia nie ma już wśród Twoich urządzeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse dispositivo não está mais entre seus dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этого устройства больше нет среди ваших устройств."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์นั้นไม่ได้อยู่ในอุปกรณ์ของคุณแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O aygıt artık aygıtlarınız arasında değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цього пристрою більше немає серед ваших пристроїв."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị đó không còn trong thiết bị của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该设备已不在你的设备中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該裝置已不在你的裝置中。"
          }
        }
      }
    },
