    "macScreen.toolbar.viewOnlyHelpNamed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك رؤية %@ دون التحكم فيه. لا تُرسَل نقراتك ومفاتيحك وتمريرك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Možete vidjeti %@, ali ga ne možete kontrolisati. Vaši klikovi, tipke i pomicanje se ne šalju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan se %@, men ikke styre den. Dine klik, taster og rulning sendes ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst %@ sehen, aber nicht steuern. Deine Klicks, Tasten und Scrollbewegungen werden nicht gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can see %@ but not control it. Your clicks, keys and scrolling aren’t sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes ver %@, pero no controlarlo. Tus clics, teclas y desplazamientos no se envían."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez voir %@ mais pas le contrôler. Vos clics, touches et défilements ne sont pas envoyés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi vedere %@ ma non controllarlo. Clic, tasti e scorrimento non vengono inviati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を表示できますが、操作はできません。クリック、キー入力、スクロールは送信されません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកអាចមើល %@ ប៉ុន្តែមិនអាចគ្រប់គ្រងវាបានទេ។ ការចុច គ្រាប់ចុច និងការរំកិលរបស់អ្នកមិនត្រូវបានផ្ញើទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 볼 수 있지만 제어할 수는 없습니다. 클릭, 키 입력, 스크롤은 전송되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan se %@, men ikke styre den. Klikk, tastetrykk og rulling sendes ikke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Widzisz %@, ale nie możesz nim sterować. Twoje kliknięcia, klawisze i przewijanie nie są wysyłane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode ver %@, mas não controlá-lo. Seus cliques, teclas e rolagens não são enviados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы видите %@, но не можете им управлять. Ваши нажатия, клавиши и прокрутка не передаются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณดู %@ ได้แต่ควบคุมไม่ได้ การคลิก การกดแป้น และการเลื่อนของคุณจะไม่ถูกส่งไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aygıtını görebilir ancak denetleyemezsiniz. Tıklamalarınız, tuşlarınız ve kaydırmalarınız gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви бачите %@, але не можете ним керувати. Ваші клацання, клавіші й прокручування не надсилаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể xem %@ nhưng không thể điều khiển. Các lần nhấp, phím và thao tác cuộn của bạn không được gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以查看 %@，但无法控制。你的点按、按键和滚动不会发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以檢視 %@，但無法控制。你的點按、按鍵和捲動不會傳送。"
          }
        }
      }
    },
    "macScreen.indicator.noSession": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يوجد جهاز يعرض هذا الـMac أو يتحكم فيه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nijedan uređaj ne gleda niti kontroliše ovaj Mac."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen enhed ser eller styrer denne Mac."
          }
        },
        "de": {
          "stringUnit": {
