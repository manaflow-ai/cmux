    "macScreen.home.shareWarning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكن لأي شخص لديه رابط جهاز Mac هذا رؤية شاشته واستخدام لوحة المفاتيح والماوس. شارك الرابط مع أجهزتك فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svako ko ima link ovog Maca može vidjeti njegov ekran i koristiti njegovu tastaturu i miš. Dijelite link samo sa svojim uređajima."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle med denne Macs link kan se dens skærm og bruge dens tastatur og mus. Del kun linket med dine egne enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeder mit dem Link dieses Mac kann seinen Bildschirm sehen sowie Tastatur und Maus verwenden. Teile den Link nur mit deinen eigenen Geräten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone with this Mac’s link can see its screen and use its keyboard and mouse. Share the link only with your own devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cualquier persona con el enlace de este Mac puede ver su pantalla y usar su teclado y ratón. Comparte el enlace solo con tus propios dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toute personne disposant du lien de ce Mac peut voir son écran et utiliser son clavier et sa souris. Ne partagez ce lien qu’avec vos propres appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chiunque abbia il link di questo Mac può vederne lo schermo e usarne tastiera e mouse. Condividi il link solo con i tuoi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このMacのリンクを知っている人は誰でも、画面を見たりキーボードやマウスを操作したりできます。リンクは自分のデバイスとだけ共有してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អ្នកណាក៏ដោយដែលមានតំណរបស់ Mac នេះ អាចមើលអេក្រង់ និងប្រើក្ដារចុច និងកណ្ដុររបស់វាបាន។ ចែករំលែកតំណតែជាមួយឧបករណ៍ផ្ទាល់ខ្លួនរបស់អ្នកប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 Mac의 링크가 있는 사람은 누구나 화면을 보고 키보드와 마우스를 사용할 수 있습니다. 링크는 본인의 기기와만 공유하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle med lenken til denne Macen kan se skjermen og bruke tastaturet og musen. Del lenken bare med dine egne enheter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Każdy, kto ma łącze tego Maca, może widzieć jego ekran oraz używać jego klawiatury i myszy. Udostępniaj łącze tylko własnym urządzeniom."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Qualquer pessoa com o link deste Mac pode ver a tela e usar o teclado e o mouse dele. Compartilhe o link apenas com seus próprios dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Любой, у кого есть ссылка этого Mac, может видеть его экран и пользоваться его клавиатурой и мышью. Делитесь ссылкой только со своими устройствами."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ทุกคนที่มีลิงก์ของ Mac เครื่องนี้จะสามารถดูหน้าจอ และใช้แป้นพิมพ์และเมาส์ของเครื่องได้ แชร์ลิงก์กับอุปกรณ์ของคุณเองเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu Mac’in bağlantısına sahip olan herkes ekranını görebilir ve klavyesini ve faresini kullanabilir. Bağlantıyı yalnızca kendi aygıtlarınızla paylaşın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Будь-хто, хто має посилання цього Mac, може бачити його екран і користуватися його клавіатурою та мишею. Діліться посиланням лише з власними пристроями."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bất kỳ ai có liên kết của máy Mac này đều có thể xem màn hình và sử dụng bàn phím, chuột của máy. Chỉ chia sẻ liên kết với thiết bị của riêng bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "任何拥有这台 Mac 链接的人都可以查看其屏幕并使用其键盘和鼠标。请仅与你自己的设备共享此链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "任何擁有這部 Mac 連結的人都可以查看其螢幕並使用其鍵盤和滑鼠。請僅與你自己的裝置分享此連結。"
          }
        }
      }
    },
