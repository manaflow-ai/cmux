    "devices.relays.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مُرحِّلات TURN الخاصة بك لاستخدامها عندما لا تتمكن أجهزة Mac من الوصول إلى بعضها مباشرةً. أسرارها مختومة لكل جهاز من أجهزتك؛ ولا يراها مركز الأجهزة أبدًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši vlastiti TURN releji za slučaj kada vaši Macovi ne mogu direktno dosegnuti jedan drugog. Njihove tajne su zapečaćene za svaki vaš uređaj; čvorište uređaja ih nikad ne vidi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine egne TURN-relæer til når dine Mac-computere ikke kan nå hinanden direkte. Deres hemmeligheder er forseglet til hver af dine enheder; enhedshubben ser dem aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine eigenen TURN-Relays für den Fall, dass deine Macs sich nicht direkt erreichen. Ihre Geheimnisse sind für jedes deiner Geräte versiegelt; der Geräte-Hub sieht sie nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own TURN relays for when your Macs can’t reach each other directly. Their secrets are sealed to each of your devices; the device hub never sees them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus propios relés TURN para cuando tus Mac no pueden conectarse directamente entre sí. Sus secretos están sellados para cada uno de tus dispositivos; el centro de dispositivos nunca los ve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos propres relais TURN, pour quand vos Mac ne peuvent pas se joindre directement. Leurs secrets sont scellés pour chacun de vos appareils ; le hub des appareils ne les voit jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi relay TURN per quando i tuoi Mac non riescono a raggiungersi direttamente. I loro segreti sono sigillati per ciascuno dei tuoi dispositivi; l’hub dei dispositivi non li vede mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac同士が直接接続できない場合に使う独自のTURNリレーです。シークレットは各デバイス向けに封印され、デバイスハブからは見えません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "TURN relay ផ្ទាល់ខ្លួនរបស់អ្នក សម្រាប់ពេលដែល Mac របស់អ្នកមិនអាចទាក់ទងគ្នាដោយផ្ទាល់បាន។ សម្ងាត់របស់ពួកវាត្រូវបានបិទត្រាសម្រាប់ឧបករណ៍នីមួយៗរបស់អ្នក មជ្ឈមណ្ឌលឧបករណ៍មិនដែលឃើញពួកវាទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac끼리 직접 연결할 수 없을 때 사용할 나만의 TURN 릴레이입니다. 비밀 키는 각 기기에 봉인되어 있으며 기기 허브는 이를 볼 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine egne TURN-releer for når Mac-maskinene dine ikke når hverandre direkte. Hemmelighetene deres er forseglet til hver av enhetene dine; enhetshuben ser dem aldri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje własne przekaźniki TURN na wypadek, gdy Twoje Maki nie mogą połączyć się ze sobą bezpośrednio. Ich sekrety są zapieczętowane dla każdego z Twoich urządzeń; centrum urządzeń nigdy ich nie widzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus próprios retransmissores TURN para quando seus Macs não conseguem se comunicar diretamente. Os segredos são selados para cada um dos seus dispositivos; a central de dispositivos nunca os vê."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши собственные ретрансляторы TURN на случай, если ваши Mac не могут связаться друг с другом напрямую. Их секреты зашифрованы для каждого вашего устройства; центр устройств никогда их не видит."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีเลย์ TURN ของคุณเองสำหรับเมื่อ Mac ของคุณติดต่อกันโดยตรงไม่ได้ ข้อมูลลับจะถูกปิดผนึกไว้สำหรับอุปกรณ์แต่ละเครื่องของคุณ ศูนย์กลางอุปกรณ์จะไม่เห็นข้อมูลลับเหล่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’leriniz birbirine doğrudan ulaşamadığında kullanılacak kendi TURN aktarıcılarınız. Sırları aygıtlarınızın her biri için mühürlenir; aygıt merkezi bunları asla görmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші власні TURN-ретранслятори на випадок, коли ваші Mac не можуть зв’язатися напряму. Їхні секрети зашифровано для кожного з ваших пристроїв; центр пристроїв їх ніколи не бачить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ chuyển tiếp TURN của riêng bạn cho khi các máy Mac không thể kết nối trực tiếp với nhau. Khóa bí mật của chúng được niêm phong cho từng thiết bị của bạn; trung tâm thiết bị không bao giờ thấy chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你的 Mac 无法直接互相连接时使用的自有 TURN 中继。它们的密钥已针对你的每台设备加密封存；设备中心永远看不到这些密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當你的 Mac 無法直接互相連線時使用的自有 TURN 中繼。它們的密鑰已針對你的每部裝置加密封存；裝置中心永遠看不到這些密鑰。"
          }
        }
      }
    },
