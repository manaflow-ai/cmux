    "devices.relays.deleteBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتوقف أجهزتك عن استخدامه. ستتم إزالة سره منها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši uređaji ga prestaju koristiti. Njegova tajna se uklanja s njih."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine enheder holder op med at bruge det. Dets hemmelighed fjernes fra dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Geräte verwenden es nicht mehr. Sein Geheimnis wird von ihnen entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your devices stop using it. Its secret is removed from them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus dispositivos dejarán de usarlo. Su secreto se eliminará de ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos appareils cessent de l’utiliser. Son secret en est supprimé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dispositivi smettono di usarlo. Il suo segreto viene rimosso da essi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスはこのリレーの使用を停止し、シークレットはデバイスから削除されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឧបករណ៍របស់អ្នកនឹងឈប់ប្រើវា។ សម្ងាត់របស់វានឹងត្រូវដកចេញពីពួកវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에서 더 이상 이 릴레이를 사용하지 않으며 비밀 키가 기기에서 제거됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhetene dine slutter å bruke det. Hemmeligheten fjernes fra dem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje urządzenia przestaną go używać. Jego sekret zostanie z nich usunięty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dispositivos deixam de usá-lo. O segredo dele é removido deles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши устройства перестанут его использовать. Его секрет будет удален с них."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์ของคุณจะหยุดใช้รีเลย์นี้ และข้อมูลลับของรีเลย์จะถูกเอาออกจากอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aygıtlarınız onu kullanmayı bırakır. Sırrı aygıtlarınızdan kaldırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші пристрої перестануть його використовувати. Його секрет буде вилучено з них."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thiết bị của bạn sẽ ngừng sử dụng nó. Khóa bí mật của nó sẽ bị xóa khỏi các thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的设备将停止使用它。它的密钥将从这些设备中移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的裝置將停止使用它。它的密鑰將從這些裝置中移除。"
          }
        }
      }
    },
