    "devices.relays.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مُرحِّلات. تتصل الجلسات مباشرةً عندما يمكنها ذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema releja. Sesije se povezuju direktno kad mogu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen relæer. Sessioner forbinder direkte, når de kan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Relays. Sitzungen verbinden sich direkt, wenn möglich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No relays. Sessions connect directly when they can."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay relés. Las sesiones se conectan directamente cuando pueden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun relais. Les sessions se connectent directement lorsque c’est possible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun relay. Le sessioni si connettono direttamente quando possibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リレーはありません。セッションは可能な場合は直接接続します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មាន relay ទេ។ វគ្គនានាតភ្ជាប់ដោយផ្ទាល់នៅពេលអាចធ្វើបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "릴레이가 없습니다. 가능한 경우 세션이 직접 연결됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen releer. Økter kobler til direkte når de kan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak przekaźników. Sesje łączą się bezpośrednio, gdy to możliwe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum retransmissor. As sessões se conectam diretamente quando possível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет ретрансляторов. Сеансы подключаются напрямую, когда это возможно."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีรีเลย์ เซสชันจะเชื่อมต่อโดยตรงเมื่อทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktarıcı yok. Oturumlar mümkün olduğunda doğrudan bağlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає ретрансляторів. Сеанси під’єднуються напряму, коли це можливо."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có máy chủ chuyển tiếp. Các phiên sẽ kết nối trực tiếp khi có thể."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有中继。会话会尽可能直接连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有中繼。工作階段會盡可能直接連線。"
          }
        }
      }
    },
