    "macScreen.home.noSharedDevices": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يشارك أي من أجهزتك الأخرى Mac Screen. على الـ Mac الذي تريد رؤيته، شغّل السماح بـ Mac Screen على هذا الـ Mac."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nijedan od vaših drugih uređaja ne dijeli Mac Screen. Na Macu koji želite vidjeti uključite Dozvoli Mac Screen na ovom Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen af dine andre enheder deler Mac Screen. Slå Tillad Mac Screen på denne Mac til på den Mac, du vil se."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keines deiner anderen Geräte teilt Mac Screen. Aktiviere auf dem Mac, den du sehen möchtest, „Mac Screen auf diesem Mac erlauben“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None of your other devices share Mac Screen. On the Mac you want to see, turn on Allow Mac Screen on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguno de tus otros dispositivos comparte Mac Screen. En el Mac que quieres ver, activa Permitir Mac Screen en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun de vos autres appareils ne partage Mac Screen. Sur le Mac que vous voulez voir, activez Autoriser Mac Screen sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno degli altri dispositivi condivide Mac Screen. Sul Mac che vuoi vedere, attiva Consenti Mac Screen su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Screenを共有しているほかのデバイスはありません。表示したいMacで「このMacでMac Screenを許可」をオンにしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានឧបករណ៍ផ្សេងទៀតរបស់អ្នកចែករំលែក Mac Screen ទេ។ នៅលើ Mac ដែលអ្នកចង់មើល សូមបើក អនុញ្ញាត Mac Screen នៅលើ Mac នេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Screen을 공유하는 다른 기기가 없습니다. 보려는 Mac에서 ‘이 Mac에서 Mac Screen 허용’을 켜십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen av de andre enhetene dine deler Mac Screen. Slå på Tillat Mac Screen på denne Macen på Macen du vil se."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadne z Twoich innych urządzeń nie udostępnia Mac Screen. Na Macu, który chcesz zobaczyć, włącz opcję Pozwalaj na Mac Screen na tym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum dos seus outros dispositivos compartilha o Mac Screen. No Mac que você quer ver, ative Permitir Mac Screen neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни одно из других ваших устройств не делится через Mac Screen. На Mac, который нужно видеть, включите «Разрешить Mac Screen на этом Mac»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอุปกรณ์อื่นของคุณที่แชร์ Mac Screen บน Mac ที่คุณต้องการดู ให้เปิด อนุญาต Mac Screen บน Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer aygıtlarınızın hiçbiri Mac Screen’i paylaşmıyor. Görmek istediğiniz Mac’te Bu Mac’te Mac Screen’e izin ver seçeneğini açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден з інших ваших пристроїв не надає доступ до Mac Screen. На Mac, який ви хочете бачити, увімкніть «Дозволити Mac Screen на цьому Mac»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thiết bị nào khác của bạn chia sẻ Mac Screen. Trên máy Mac bạn muốn xem, hãy bật Cho phép Mac Screen trên máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的其他设备均未共享 Mac Screen。请在你想查看的 Mac 上打开“允许在这台 Mac 上使用 Mac Screen”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的其他裝置均未共享 Mac Screen。請在你想檢視的 Mac 上開啟「允許在這部 Mac 上使用 Mac Screen」。"
          }
        }
      }
    },
