    "macScreen.hub.declinedBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض %@ طلبك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je odbio vaš zahtjev."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ afviste din anmodning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat deine Anfrage abgelehnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ declined your request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha rechazado tu solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a refusé votre demande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha rifiutato la tua richiesta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@がリクエストを拒否しました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ បានបដិសេធសំណើរបស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 요청을 거절했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ avslo forespørselen din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ odrzuca Twoją prośbę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ recusou sua solicitação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ отклонил(а) ваш запрос."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ปฏิเสธคำขอของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isteğinizi reddetti."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ відхиляє ваш запит."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã từ chối yêu cầu của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 拒绝了你的请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 拒絕了你的要求。"
          }
        }
      }
    },
