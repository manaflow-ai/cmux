        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing links are no longer supported. Use Settings › Devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces de vinculación ya no son compatibles. Usa Ajustes › Dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens de jumelage ne sont plus pris en charge. Utilisez Réglages › Appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I link di abbinamento non sono più supportati. Usa Impostazioni › Dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングリンクはサポートされなくなりました。設定 › デバイス を使用してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "តំណផ្គូផ្គងលែងគាំទ្រទៀតហើយ។ សូមប្រើ ការកំណត់ › ឧបករណ៍។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링 링크는 더 이상 지원되지 않습니다. 설정 › 기기를 사용하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Paringslenker støttes ikke lenger. Bruk Innstillinger › Enheter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Linki parowania nie są już obsługiwane. Użyj Ustawienia › Urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Links de pareamento não são mais compatíveis. Use Ajustes › Dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылки для связывания больше не поддерживаются. Используйте Настройки › Устройства."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่รองรับลิงก์จับคู่อีกต่อไป ใช้ การตั้งค่า › อุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleştirme bağlantıları artık desteklenmiyor. Ayarlar › Aygıtlar’ı kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посилання для з’єднання більше не підтримуються. Використовуйте Параметри › Пристрої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết ghép đôi không còn được hỗ trợ. Hãy dùng Cài đặt › Thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不再支持配对链接。请使用 设置 › 设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不再支援配對連結。請使用 設定 › 裝置。"
