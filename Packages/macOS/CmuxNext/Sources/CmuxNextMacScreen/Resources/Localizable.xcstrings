    "devices.removeBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتهي جلسات Mac Screen الخاصة به ولن يتمكن بعد ذلك من رؤية الشاشات أو مشاركتها. سيعود كجهاز جديد عند تسجيل الدخول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegove Mac Screen sesije se završavaju i više ne može vidjeti ni dijeliti ekrane. Vraća se kao novi uređaj kada se ponovo prijavi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dens Mac Screen-sessioner slutter, og den kan ikke længere se eller dele skærme. Den kommer tilbage som en ny enhed, når den logger ind igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Mac Screen-Sitzungen enden und es kann keine Bildschirme mehr sehen oder teilen. Bei der nächsten Anmeldung erscheint es als neues Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its Mac Screen sessions end and it can no longer see or share screens. It comes back as a new device when it signs in again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus sesiones de Mac Screen terminarán y ya no podrá ver ni compartir pantallas. Volverá como un dispositivo nuevo cuando vuelva a iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses sessions Mac Screen prennent fin et il ne peut plus voir ni partager d’écrans. Il reviendra comme nouvel appareil lorsqu’il se reconnectera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sue sessioni Mac Screen terminano e non può più vedere né condividere schermi. Tornerà come nuovo dispositivo quando accederà di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Screenセッションは終了し、画面の表示や共有ができなくなります。再度サインインすると新しいデバイスとして戻ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វគ្គ Mac Screen របស់វានឹងបញ្ចប់ ហើយវាលែងអាចមើល ឬចែករំលែកអេក្រង់បានទៀត។ វានឹងត្រឡប់មកវិញជាឧបករណ៍ថ្មី នៅពេលវាចូលម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 기기의 Mac Screen 세션이 종료되고 더 이상 화면을 보거나 공유할 수 없습니다. 다시 로그인하면 새 기기로 추가됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Screen-øktene avsluttes, og den kan ikke lenger se eller dele skjermer. Den kommer tilbake som en ny enhet når den logger på igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego sesje Mac Screen zostaną zakończone i nie będzie już mógł wyświetlać ani udostępniać ekranów. Po ponownym zalogowaniu pojawi się jako nowe urządzenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As sessões do Mac Screen dele terminam e ele não pode mais ver nem compartilhar telas. Ele volta como um novo dispositivo ao iniciar sessão novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его сеансы Mac Screen завершатся, и оно больше не сможет просматривать экраны или делиться ими. При повторном входе оно вернется как новое устройство."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซสชัน Mac Screen ของอุปกรณ์นี้จะสิ้นสุด และจะไม่สามารถดูหรือแชร์หน้าจอได้อีก อุปกรณ์จะกลับมาเป็นอุปกรณ์ใหม่เมื่อลงชื่อเข้าใช้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Screen oturumları sona erer ve artık ekranları göremez veya paylaşamaz. Yeniden oturum açtığında yeni bir aygıt olarak geri gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Його сеанси Mac Screen завершаться, і він більше не зможе бачити чи поширювати екрани. Він повернеться як новий пристрій, коли знову ввійде."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phiên Mac Screen của thiết bị sẽ kết thúc và thiết bị không thể xem hoặc chia sẻ màn hình nữa. Thiết bị sẽ quay lại dưới dạng thiết bị mới khi đăng nhập lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它的 Mac Screen 会话会结束，并且无法再查看或共享屏幕。再次登录时，它将作为新设备重新出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它的 Mac Screen 工作階段會結束，並且無法再檢視或共享螢幕。再次登入時，它將作為新裝置重新出現。"
          }
        }
      }
    },
