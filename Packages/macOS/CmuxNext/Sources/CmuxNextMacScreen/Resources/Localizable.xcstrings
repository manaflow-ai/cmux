    "macScreen.hub.otherBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على مركز الأجهزة بدء الجلسة. حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čvorište uređaja nije moglo pokrenuti sesiju. Pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhedshubben kunne ikke starte sessionen. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Geräte-Hub konnte die Sitzung nicht starten. Versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device hub could not start the session. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El centro de dispositivos no pudo iniciar la sesión. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le hub des appareils n’a pas pu démarrer la session. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’hub dei dispositivi non ha potuto avviare la sessione. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスハブはセッションを開始できませんでした。もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មជ្ឈមណ្ឌលឧបករណ៍មិនអាចចាប់ផ្ដើមវគ្គបានទេ។ សូមព្យាយាមម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 허브에서 세션을 시작할 수 없습니다. 다시 시도하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhetshuben kunne ikke starte økten. Prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Centrum urządzeń nie mogło rozpocząć sesji. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A central de dispositivos não conseguiu iniciar a sessão. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Центру устройств не удалось начать сеанс. Повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ศูนย์กลางอุปกรณ์ไม่สามารถเริ่มเซสชันได้ ลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aygıt merkezi oturumu başlatamadı. Yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Центр пристроїв не зміг розпочати сеанс. Спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trung tâm thiết bị không thể bắt đầu phiên. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备中心无法开始会话。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置中心無法開始工作階段。請再試一次。"
          }
        }
      }
    },
    "macScreen.hub.reason.accessChanged": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غيّر %@ صلاحية هذا الـ Mac. اتصل مجددًا للمتابعة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je promijenio pristup ovog Maca. Ponovo se povežite za nastavak."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ændrede denne Macs adgang. Opret forbindelse igen for at fortsætte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat den Zugriff dieses Mac geändert. Verbinde dich erneut, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ changed this Mac’s access. Connect again to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cambió el acceso de este Mac. Vuelve a conectarte para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a modifié l’accès de ce Mac. Reconnectez-vous pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha cambiato l’accesso di questo Mac. Riconnettiti per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がこの Mac のアクセス権を変更しました。続けるには再接続してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ បានប្ដូរសិទ្ធិចូលប្រើរបស់ Mac នេះ។ ភ្ជាប់ម្ដងទៀតដើម្បីបន្ត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 이 Mac의 접근 권한을 변경했습니다. 계속하려면 다시 연결하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ endret tilgangen til denne Macen. Koble til på nytt for å fortsette."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zmienił dostęp tego Maca. Połącz się ponownie, aby kontynuować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ alterou o acesso deste Mac. Conecte-se novamente para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ изменил доступ этого Mac. Подключитесь снова, чтобы продолжить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ เปลี่ยนสิทธิ์การเข้าถึงของ Mac เครื่องนี้แล้ว เชื่อมต่ออีกครั้งเพื่อดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bu Mac’in erişimini değiştirdi. Devam etmek için yeniden bağlanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ змінив доступ цього Mac. Підключіться знову, щоб продовжити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã thay đổi quyền truy cập của máy Mac này. Hãy kết nối lại để tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 更改了此 Mac 的访问权限。请重新连接以继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已變更此 Mac 的存取權限。請重新連線以繼續。"
          }
        }
      }
    },
    "macScreen.hub.reason.approveFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سمح %@ بالجلسة، لكن تعذّر بدؤها. حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je dozvolio sesiju, ali nije mogla početi. Pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tillod sessionen, men den kunne ikke starte. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat die Sitzung erlaubt, aber sie konnte nicht starten. Versuch es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ allowed the session, but it couldn’t start. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ permitió la sesión, pero no se pudo iniciar. Vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a autorisé la session, mais elle n’a pas pu démarrer. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha consentito la sessione, ma non è stato possibile avviarla. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はセッションを許可しましたが、開始できませんでした。もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ បានអនុញ្ញាតវគ្គ ប៉ុន្តែមិនអាចចាប់ផ្ដើមបានទេ។ សូមព្យាយាមម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 세션을 허용했지만 시작할 수 없었습니다. 다시 시도하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tillot økten, men den kunne ikke starte. Prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zezwolił na sesję, ale nie udało się jej rozpocząć. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ permitiu a sessão, mas ela não pôde ser iniciada. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ разрешил сеанс, но его не удалось начать. Повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ อนุญาตเซสชันแล้ว แต่เริ่มไม่ได้ ลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ oturuma izin verdi ancak oturum başlatılamadı. Yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ дозволив сеанс, але його не вдалося почати. Спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã cho phép phiên nhưng không thể bắt đầu. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已允许会话，但会话无法开始。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已允許工作階段，但無法開始。請再試一次。"
          }
        }
      }
    },
