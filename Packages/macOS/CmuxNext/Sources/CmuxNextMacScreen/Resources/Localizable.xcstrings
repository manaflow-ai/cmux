    "macScreen.card.confirmBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تم فتح علامة التبويب هذه لك. اتصل لرؤية جهاز Mac هذا والتحكم فيه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ova kartica je otvorena za vas. Povežite se da vidite i upravljate ovim Macom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne fane blev åbnet for dig. Opret forbindelse for at se og styre denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Tab wurde für dich geöffnet. Verbinde dich, um diesen Mac zu sehen und zu steuern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tab was opened for you. Connect to see and control this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta pestaña se abrió para ti. Conéctate para ver y controlar este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cet onglet a été ouvert pour vous. Connectez-vous pour voir et contrôler ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo pannello è stato aperto per te. Connettiti per vedere e controllare questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このタブは自動的に開かれました。接続するとこのMacを表示して操作できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទាំងនេះត្រូវបានបើកសម្រាប់អ្នក។ ភ្ជាប់ដើម្បីមើល និងគ្រប់គ្រង Mac នេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 탭이 자동으로 열렸습니다. 연결하여 이 Mac을 보고 제어하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne fanen ble åpnet for deg. Koble til for å se og styre denne Macen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ta karta została otwarta dla Ciebie. Połącz się, aby wyświetlać ten Mac i sterować nim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta aba foi aberta para você. Conecte-se para ver e controlar este Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Эта вкладка была открыта для вас. Подключитесь, чтобы видеть этот Mac и управлять им."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แถบนี้ถูกเปิดไว้ให้คุณ เชื่อมต่อเพื่อดูและควบคุม Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu sekme sizin için açıldı. Bu Mac’i görmek ve denetlemek için bağlanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цю вкладку відкрито для вас. Під’єднайтеся, щоб бачити цей Mac і керувати ним."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tab này đã được mở cho bạn. Kết nối để xem và điều khiển máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此标签页已为你打开。连接即可查看和控制这台 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此標籤頁已為你打開。連線即可查看和控制這部 Mac。"
          }
        }
      }
    },
