    "devices.noOthers": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول إلى cmux على أجهزة Mac الأخرى لرؤيتها هنا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se na cmux na drugim Macovima da ih vidite ovdje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind på cmux på dine andre Mac-computere for at se dem her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich auf deinen anderen Macs bei cmux an, um sie hier zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to cmux on your other Macs to see them here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en cmux en tus otros Mac para verlos aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à cmux sur vos autres Mac pour les voir ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi a cmux sugli altri Mac per vederli qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのMacでcmuxにサインインすると、ここに表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចូល cmux នៅលើ Mac ផ្សេងទៀតរបស់អ្នក ដើម្បីមើលពួកវានៅទីនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 Mac에서 cmux에 로그인하면 여기에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg på cmux på de andre Mac-maskinene dine for å se dem her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się do cmux na innych Macach, aby zobaczyć je tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão no cmux nos seus outros Macs para vê-los aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в cmux на других своих Mac, чтобы увидеть их здесь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าใช้ cmux บน Mac เครื่องอื่นของคุณเพื่อดูเครื่องเหล่านั้นที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer Mac’lerinizi burada görmek için onlarda cmux’ta oturum açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть у cmux на інших своїх Mac, щоб бачити їх тут."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập cmux trên các máy Mac khác của bạn để xem chúng tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的其他 Mac 上登录 cmux，即可在此处看到它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的其他 Mac 上登入 cmux，即可在此處看到它們。"
          }
        }
      }
    },
