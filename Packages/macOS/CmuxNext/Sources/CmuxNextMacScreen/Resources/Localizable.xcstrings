    "devices.removeThisBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيسجّل هذا الـ Mac خروجه من أجهزتك: تنتهي جلسات Mac Screen الخاصة به ولن تراه أجهزتك الأخرى بعد الآن. سجّل الدخول مرة أخرى لإضافته كجهاز جديد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj Mac se odjavljuje iz vaših uređaja: njegove Mac Screen sesije se završavaju i vaši drugi uređaji ga više ne vide. Ponovo se prijavite da ga dodate kao novi uređaj."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac logger ud af dine enheder: Dens Mac Screen-sessioner slutter, og dine andre enheder kan ikke længere se den. Log ind igen for at tilføje den som en ny enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac wird von deinen Geräten abgemeldet: Seine Mac Screen-Sitzungen enden und deine anderen Geräte sehen ihn nicht mehr. Melde dich erneut an, um ihn als neues Gerät hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac signs out of your devices: its Mac Screen sessions end and your other devices no longer see it. Sign in again to add it back as a new device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac cerrará sesión en tus dispositivos: sus sesiones de Mac Screen terminarán y tus otros dispositivos dejarán de verlo. Vuelve a iniciar sesión para añadirlo de nuevo como un dispositivo nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac se déconnecte de vos appareils : ses sessions Mac Screen prennent fin et vos autres appareils ne le voient plus. Reconnectez-vous pour l’ajouter à nouveau comme nouvel appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac esce dai tuoi dispositivi: le sue sessioni Mac Screen terminano e gli altri dispositivi non lo vedono più. Accedi di nuovo per aggiungerlo come nuovo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacはあなたのデバイスからサインアウトします。Mac Screenセッションは終了し、ほかのデバイスからは表示されなくなります。再度サインインすると新しいデバイスとして追加されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac នេះនឹងចេញពីឧបករណ៍របស់អ្នក៖ វគ្គ Mac Screen របស់វានឹងបញ្ចប់ ហើយឧបករណ៍ផ្សេងទៀតរបស់អ្នកនឹងលែងឃើញវា។ ចូលម្ដងទៀតដើម្បីបន្ថែមវាជាឧបករណ៍ថ្មី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac이 내 기기에서 로그아웃됩니다. Mac Screen 세션이 종료되고 다른 기기에서 더 이상 이 Mac을 볼 수 없습니다. 다시 추가하려면 다시 로그인하여 새 기기로 추가하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Macen logges ut av enhetene dine: Mac Screen-øktene avsluttes, og de andre enhetene dine ser den ikke lenger. Logg på igjen for å legge den til som en ny enhet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac zostanie wylogowany z Twoich urządzeń: jego sesje Mac Screen zostaną zakończone, a inne urządzenia przestaną go widzieć. Zaloguj się ponownie, aby dodać go jako nowe urządzenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac sai dos seus dispositivos: as sessões do Mac Screen terminam e seus outros dispositivos deixam de vê-lo. Inicie sessão novamente para adicioná-lo como um novo dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac выйдет из ваших устройств: его сеансы Mac Screen завершатся, и другие ваши устройства перестанут его видеть. Войдите снова, чтобы добавить его как новое устройство."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac เครื่องนี้จะออกจากอุปกรณ์ของคุณ: เซสชัน Mac Screen ของเครื่องจะสิ้นสุด และอุปกรณ์อื่นของคุณจะไม่เห็นเครื่องนี้อีก ลงชื่อเข้าใช้อีกครั้งเพื่อเพิ่มกลับมาเป็นอุปกรณ์ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac aygıtlarınızdan çıkış yapar: Mac Screen oturumları sona erer ve diğer aygıtlarınız artık onu görmez. Yeni bir aygıt olarak geri eklemek için yeniden oturum açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей Mac вийде з ваших пристроїв: його сеанси Mac Screen завершаться, а інші ваші пристрої більше не бачитимуть його. Увійдіть знову, щоб додати його як новий пристрій."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac này sẽ đăng xuất khỏi thiết bị của bạn: các phiên Mac Screen của máy sẽ kết thúc và các thiết bị khác của bạn sẽ không còn thấy máy. Đăng nhập lại để thêm máy làm thiết bị mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 将退出你的设备：它的 Mac Screen 会话会结束，你的其他设备也将看不到它。再次登录即可将其作为新设备重新添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部 Mac 將登出你的裝置：它的 Mac Screen 工作階段會結束，你的其他裝置也將看不到它。再次登入即可將其作為新裝置重新加入。"
          }
        }
      }
    },
    "devices.removeThisTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد إزالة هذا الـ Mac من أجهزتك؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukloniti ovaj Mac iz vaših uređaja?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern denne Mac fra dine enheder?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Mac aus deinen Geräten entfernen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove This Mac from your devices?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar este Mac de tus dispositivos?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer ce Mac de vos appareils ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere questo Mac dai tuoi dispositivi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacをあなたのデバイスから削除しますか?"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដក Mac នេះចេញពីឧបករណ៍របស់អ្នកឬ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac을 내 기기에서 제거하겠습니까?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du fjerne denne Macen fra enhetene dine?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć ten Mac z Twoich urządzeń?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover este Mac dos seus dispositivos?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить этот Mac из ваших устройств?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอา Mac เครื่องนี้ออกจากอุปกรณ์ของคุณใช่ไหม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac aygıtlarınızdan kaldırılsın mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вилучити цей Mac з ваших пристроїв?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa máy Mac này khỏi thiết bị của bạn?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要从你的设备中移除这台 Mac 吗？"
