    "macScreen.hub.waitingBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلبت %@. يجب أن يسمح بذلك شخص على ذلك الـ Mac."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatražili ste %@. Neko za tim Macom to mora dozvoliti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bad om %@. En person ved den Mac skal tillade det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast „%@“ angefragt. Jemand an diesem Mac muss es erlauben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You asked for %@. Someone at that Mac needs to allow it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has solicitado %@. Alguien en ese Mac tiene que permitirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez demandé : %@. Quelqu’un sur ce Mac doit l’autoriser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai chiesto: %@. Qualcuno su quel Mac deve consentirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@をリクエストしました。そのMacで誰かが許可する必要があります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកបានស្នើសុំ %@។ នរណាម្នាក់នៅ Mac នោះត្រូវអនុញ្ញាតវា។"
