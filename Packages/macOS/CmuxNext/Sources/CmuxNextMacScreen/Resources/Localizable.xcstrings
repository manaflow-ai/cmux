    "macScreen.home.accessibilityDetail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتيح لجهاز Mac الآخر النقر والكتابة هنا. بدون ذلك، يمكنه المشاهدة فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Omogućava drugom Macu da ovdje klikće i kuca. Bez toga može samo gledati."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lader den anden Mac klikke og skrive her. Uden det kan den kun se med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erlaubt dem anderen Mac, hier zu klicken und zu tippen. Ohne diese Berechtigung kann er nur zusehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets the other Mac click and type here. Without it, it can only watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite que el otro Mac haga clic y escriba aquí. Sin este permiso, solo puede mirar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permet à l’autre Mac de cliquer et de saisir du texte ici. Sans cela, il peut seulement regarder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consente all’altro Mac di fare clic e digitare qui. Senza questo permesso, può solo guardare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "もう一方のMacがここでクリックや入力をできるようにします。許可しない場合は表示のみになります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អនុញ្ញាតឱ្យ Mac មួយទៀតចុច និងវាយនៅទីនេះ។ បើគ្មានវាទេ វាអាចត្រឹមតែមើលប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다른 Mac이 여기에서 클릭하고 입력할 수 있게 합니다. 허용하지 않으면 보기만 가능합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lar den andre Macen klikke og skrive her. Uten dette kan den bare se på."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pozwala drugiemu Macowi klikać i pisać tutaj. Bez tego może tylko oglądać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite que o outro Mac clique e digite aqui. Sem isso, ele só pode assistir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Позволяет другому Mac нажимать и вводить текст здесь. Без этого он может только смотреть."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อนุญาตให้ Mac อีกเครื่องคลิกและพิมพ์ที่นี่ หากไม่อนุญาต จะดูได้อย่างเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diğer Mac’in burada tıklamasına ve yazmasına izin verir. Bu izin olmadan yalnızca izleyebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дозволяє іншому Mac клацати й вводити текст тут. Без цього він може лише дивитися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cho phép máy Mac kia bấm và nhập tại đây. Nếu không, máy đó chỉ có thể xem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "允许另一台 Mac 在此点按和键入。未授权时只能观看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "允許另一部 Mac 在此點按和輸入。未允許時只能觀看。"
          }
        }
      }
    },
