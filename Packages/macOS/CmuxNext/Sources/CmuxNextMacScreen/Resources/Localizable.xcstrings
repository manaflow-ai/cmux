    "macScreen.approval.failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تصل الإجابة إلى مركز الأجهزة. حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovor nije stigao do čvorišta uređaja. Pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaret nåede ikke enhedshubben. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort hat den Geräte-Hub nicht erreicht. Versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The answer did not reach the device hub. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta no llegó al centro de dispositivos. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse n’a pas atteint le hub des appareils. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La risposta non ha raggiunto l’hub dei dispositivi. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答がデバイスハブに届きませんでした。もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចម្លើយមិនបានទៅដល់មជ្ឈមណ្ឌលឧបករណ៍ទេ។ សូមព្យាយាមម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답이 기기 허브에 전달되지 않았습니다. 다시 시도하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaret nådde ikke enhetshuben. Prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedź nie dotarła do centrum urządzeń. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta não chegou à central de dispositivos. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ не дошел до центра устройств. Повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำตอบไปไม่ถึงศูนย์กลางอุปกรณ์ ลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıt aygıt merkezine ulaşmadı. Yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповідь не дійшла до центру пристроїв. Спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu trả lời chưa tới được trung tâm thiết bị. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回复未能送达设备中心。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回覆未能送達裝置中心。請再試一次。"
          }
        }
      }
    },
