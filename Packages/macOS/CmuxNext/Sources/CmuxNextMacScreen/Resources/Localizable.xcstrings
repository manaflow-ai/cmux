    "devices.error.network": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى مركز الأجهزة. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čvorište uređaja nije dostupno. Provjerite vezu i pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke nå enhedshubben. Tjek din forbindelse, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Geräte-Hub ist nicht erreichbar. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t reach the device hub. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo acceder al centro de dispositivos. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre le hub des appareils. Vérifiez votre connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere l’hub dei dispositivi. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスハブに接続できません。接続を確認して、もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចទាក់ទងមជ្ឈមណ្ឌលឧបករណ៍បានទេ។ ពិនិត្យការតភ្ជាប់របស់អ្នក ហើយព្យាយាមម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 허브에 연결할 수 없습니다. 연결 상태를 확인한 후 다시 시도하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Får ikke kontakt med enhetshuben. Sjekk tilkoblingen og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można połączyć się z centrum urządzeń. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar a central de dispositivos. Verifique sua conexão e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с центром устройств. Проверьте подключение и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถติดต่อศูนย์กลางอุปกรณ์ได้ ตรวจสอบการเชื่อมต่อของคุณแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aygıt merkezine ulaşılamadı. Bağlantınızı denetleyip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зв’язатися з центром пристроїв. Перевірте з’єднання і спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể kết nối tới trung tâm thiết bị. Hãy kiểm tra kết nối và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接设备中心。请检查网络连接并重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連接裝置中心。請檢查網路連線並再試一次。"
          }
        }
      }
    },
    "devices.error.noSecret": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لهذا الـ Mac فتح سر هذا المُرحِّل. عدّل المُرحِّل وأدخله مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj Mac ne može otvoriti tajnu ovog releja. Uredite relej i ponovo je unesite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac kan ikke åbne relæets hemmelighed. Rediger relæet, og indtast den igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac kann das Geheimnis dieses Relays nicht öffnen. Bearbeite das Relay und gib es erneut ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac can’t open this relay’s secret. Edit the relay and enter it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no puede abrir el secreto de este relé. Edita el relé e introdúcelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac ne peut pas ouvrir le secret de ce relais. Modifiez le relais et saisissez-le à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non può aprire il segreto di questo relay. Modifica il relay e inseriscilo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacではこのリレーのシークレットを開けません。リレーを編集して、もう一度入力してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac នេះមិនអាចបើកសម្ងាត់របស់ relay នេះបានទេ។ កែ relay ហើយបញ្ចូលវាម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 이 릴레이의 비밀 키를 열 수 없습니다. 릴레이를 편집하여 다시 입력하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Macen kan ikke åpne hemmeligheten for dette reléet. Rediger reléet og skriv den inn på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac nie może otworzyć sekretu tego przekaźnika. Edytuj przekaźnik i wprowadź go ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac não consegue abrir o segredo deste retransmissor. Edite o retransmissor e digite-o novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac не может открыть секрет этого ретранслятора. Измените ретранслятор и введите секрет снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac เครื่องนี้ไม่สามารถเปิดข้อมูลลับของรีเลย์นี้ได้ แก้ไขรีเลย์แล้วป้อนอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac, bu aktarıcının sırrını açamıyor. Aktarıcıyı düzenleyip sırrı yeniden girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей Mac не може відкрити секрет цього ретранслятора. Відредагуйте ретранслятор і введіть секрет знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac này không thể mở khóa bí mật của máy chủ chuyển tiếp này. Hãy sửa máy chủ chuyển tiếp và nhập lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 无法打开此中继的密钥。请编辑该中继并重新输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部 Mac 無法打開此中繼的密鑰。請編輯該中繼並重新輸入。"
          }
        }
      }
    },
