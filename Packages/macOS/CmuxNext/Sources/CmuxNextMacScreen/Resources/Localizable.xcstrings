    "macScreen.home.devicesSignIn": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول إلى cmux لرؤية أجهزة Mac الأخرى هنا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se na cmux da ovdje vidite svoje druge Macove."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind på cmux for at se dine andre Mac-computere her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich bei cmux an, um deine anderen Macs hier zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to cmux to see your other Macs here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en cmux para ver aquí tus otros Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à cmux pour voir vos autres Mac ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi a cmux per vedere qui gli altri Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmuxにサインインすると、ほかのMacがここに表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចូល cmux ដើម្បីមើល Mac ផ្សេងទៀតរបស់អ្នកនៅទីនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 Mac을 여기에서 보려면 cmux에 로그인하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg på cmux for å se de andre Mac-maskinene dine her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się do cmux, aby zobaczyć tutaj swoje inne Maki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão no cmux para ver seus outros Macs aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в cmux, чтобы увидеть здесь другие свои Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าใช้ cmux เพื่อดู Mac เครื่องอื่นของคุณที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer Mac’lerinizi burada görmek için cmux’ta oturum açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть у cmux, щоб бачити тут інші свої Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập cmux để xem các máy Mac khác của bạn tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录 cmux 即可在此处看到你的其他 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入 cmux 即可在此處看到你的其他 Mac。"
          }
        }
      }
    },
