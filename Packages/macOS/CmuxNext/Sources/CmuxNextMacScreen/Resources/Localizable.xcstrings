        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişim yalnızca görüntüleme olarak değişti"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ змінено на «Лише перегляд»"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập đã đổi thành chỉ xem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访问权限已更改为仅查看"
