    "macScreen.home.resetBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لن تتمكن الأجهزة المقترنة بالرابط الحالي من الاتصال حتى يتم إقرانها مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uređaji upareni s trenutnim linkom neće se moći povezati dok se ponovo ne upare."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enheder, der er parret med det aktuelle link, kan ikke længere oprette forbindelse, før de parres igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mit dem aktuellen Link gekoppelte Geräte können sich erst wieder verbinden, wenn sie erneut gekoppelt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices paired with the current link can no longer connect until they pair again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los dispositivos vinculados con el enlace actual no podrán conectarse hasta que se vuelvan a vincular."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les appareils jumelés avec le lien actuel ne pourront plus se connecter tant qu’ils ne seront pas jumelés à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I dispositivi abbinati con il link attuale non potranno più connettersi finché non verranno abbinati di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "現在のリンクでペアリングされたデバイスは、再度ペアリングするまで接続できなくなります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ឧបករណ៍ដែលបានផ្គូផ្គងជាមួយតំណបច្ចុប្បន្ននឹងមិនអាចភ្ជាប់បានទៀតទេ រហូតដល់ពួកវាផ្គូផ្គងម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "현재 링크로 페어링된 기기는 다시 페어링할 때까지 연결할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enheter som er sammenkoblet med gjeldende lenke, kan ikke koble til før de kobles sammen på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Urządzenia sparowane przy użyciu bieżącego łącza nie będą mogły się połączyć, dopóki nie zostaną ponownie sparowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os dispositivos emparelhados com o link atual não poderão mais se conectar até serem emparelhados novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Устройства, объединенные в пару по текущей ссылке, не смогут подключиться, пока не будут снова объединены в пару."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อุปกรณ์ที่จับคู่ด้วยลิงก์ปัจจุบันจะเชื่อมต่อไม่ได้จนกว่าจะจับคู่ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geçerli bağlantıyla eşlenen aygıtlar yeniden eşlenene kadar bağlanamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пристрої в парі з поточним посиланням не зможуть під’єднатися, доки не створять пару знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các thiết bị đã ghép đôi bằng liên kết hiện tại sẽ không thể kết nối cho đến khi ghép đôi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用当前链接配对的设备将无法连接，直到重新配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用目前連結配對的裝置將無法連線，直到重新配對。"
          }
        }
      }
    },
