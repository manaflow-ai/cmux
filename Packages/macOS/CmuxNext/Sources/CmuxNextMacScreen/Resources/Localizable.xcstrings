    "macScreen.home.pairBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "على جهاز Mac الآخر، افتح شاشة Mac في cmux، وشغّل مشاركة جهاز Mac هذا وانسخ رابطه. ثم الصقه هنا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na drugom Macu otvorite Ekran Maca u cmuxu, uključite Dijeli ovaj Mac i kopirajte njegov link. Zalijepite ga ovdje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åbn Mac-skærm i cmux på den anden Mac, slå Del denne Mac til, og kopier dens link. Sæt det ind her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öffne auf dem anderen Mac „Mac-Bildschirm“ in cmux, aktiviere „Diesen Mac teilen“ und kopiere den Link. Füge ihn hier ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the other Mac, open Mac Screen in cmux, turn on Share This Mac and copy its link. Paste it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En el otro Mac, abre Pantalla del Mac en cmux, activa Compartir este Mac y copia su enlace. Pégalo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sur l’autre Mac, ouvrez Écran Mac dans cmux, activez Partager ce Mac et copiez son lien. Collez-le ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sull’altro Mac, apri Schermo Mac in cmux, attiva Condividi questo Mac e copia il suo link. Incollalo qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "もう一方のMacでcmuxの「Macの画面」を開き、「このMacを共有」をオンにしてリンクをコピーします。ここにペーストしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "នៅលើ Mac មួយទៀត សូមបើក អេក្រង់ Mac ក្នុង cmux បើក ចែករំលែក Mac នេះ ហើយចម្លងតំណរបស់វា។ បិទភ្ជាប់វានៅទីនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다른 Mac의 cmux에서 Mac 화면을 열고 이 Mac 공유를 켠 다음 링크를 복사하십시오. 여기에 붙여넣으십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åpne Mac-skjerm i cmux på den andre Macen, slå på Del denne Macen og kopier lenken. Lim den inn her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na drugim Macu otwórz Ekran Maca w cmux, włącz Udostępnij ten Mac i skopiuj jego łącze. Wklej je tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No outro Mac, abra a Tela do Mac no cmux, ative Compartilhar Este Mac e copie o link. Cole-o aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На другом Mac откройте «Экран Mac» в cmux, включите «Поделиться этим Mac» и скопируйте ссылку. Вставьте ее сюда."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "บน Mac อีกเครื่อง ให้เปิดหน้าจอ Mac ใน cmux เปิดใช้แชร์ Mac เครื่องนี้ แล้วคัดลอกลิงก์ จากนั้นวางที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diğer Mac’te cmux’ta Mac Ekranı’nı açın, Bu Mac’i Paylaş’ı açın ve bağlantısını kopyalayın. Buraya yapıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На іншому Mac відкрийте «Екран Mac» у cmux, увімкніть «Поширити цей Mac» і скопіюйте посилання. Вставте його сюди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trên máy Mac kia, mở Màn hình Mac trong cmux, bật Chia sẻ máy Mac này và sao chép liên kết. Dán liên kết vào đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在另一台 Mac 上的 cmux 中打开“Mac 屏幕”，打开“共享这台 Mac”并拷贝其链接，然后粘贴到这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在另一部 Mac 上的 cmux 中打開「Mac 螢幕」，開啟「分享這部 Mac」並拷貝其連結，然後貼到這裡。"
          }
        }
      }
    },
