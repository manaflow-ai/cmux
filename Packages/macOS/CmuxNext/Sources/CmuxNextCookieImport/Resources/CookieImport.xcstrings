    "cookieImport.card.importedLead" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "إنها في ملف تعريف متصفح cmux «%@». تؤدي الإزالة إلى إخراج ملفات تعريف الارتباط هذه بالضبط مجددًا، مما يسجّل خروج ذلك الملف من هذه المواقع."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nalaze se u cmux profilu preglednika „%@”. Ukloni ponovo uklanja upravo ove kolačiće, što odjavljuje taj profil s ovih stranica."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De ligger i cmux-browserprofilen “%@”. Fjern tager præcis disse cookies ud igen, hvilket logger profilen ud af disse websteder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sie liegen im cmux-Browserprofil „%@“. Entfernen nimmt genau diese Cookies wieder heraus und meldet das Profil bei diesen Websites ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They are in the cmux browser profile “%@”. Remove takes exactly these cookies out again, which signs that profile out of these sites."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Están en el perfil del navegador de cmux «%@». Quitar elimina exactamente estas cookies, lo que cierra la sesión de ese perfil en estos sitios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ils sont dans le profil de navigateur cmux « %@ ». Supprimer retire exactement ces cookies, ce qui déconnecte ce profil de ces sites."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sono nel profilo del browser cmux «%@». Rimuovi toglie esattamente questi cookie, scollegando quel profilo da questi siti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux ブラウザのプロファイル「%@」に入っています。「削除」でこれらの Cookie だけを取り除けます。そのプロファイルはこれらのサイトからサインアウトします。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "វានៅក្នុងប្រវត្តិរូបកម្មវិធីរុករក cmux “%@”។ លុប នឹងដកខូគីទាំងនេះចេញវិញយ៉ាងពិតប្រាកដ ដែលធ្វើឱ្យប្រវត្តិរូបនោះចាកចេញពីគេហទំព័រទាំងនេះ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux 브라우저 프로필 “%@”에 있습니다. 제거를 누르면 정확히 이 쿠키만 다시 빼내며, 그 프로필은 이 사이트들에서 로그아웃됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De ligger i cmux-nettleserprofilen «%@». Fjern tar akkurat disse informasjonskapslene ut igjen, noe som logger profilen ut av disse nettstedene."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Są w profilu przeglądarki cmux „%@”. Usuń usuwa dokładnie te pliki cookie, co wylogowuje ten profil z tych witryn."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eles estão no perfil do navegador do cmux “%@”. Remover tira exatamente esses cookies, o que desconecta esse perfil desses sites."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Они в профиле браузера cmux «%@». «Удалить» уберёт именно эти cookie, и профиль выйдет из этих сайтов."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "คุกกี้อยู่ในโปรไฟล์เบราว์เซอร์ cmux “%@” การลบจะนำคุกกี้เหล่านี้ออกตรงตามนี้ ซึ่งจะทำให้โปรไฟล์นั้นออกจากระบบของเว็บไซต์เหล่านี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bunlar cmux tarayıcı profili “%@” içinde. Kaldır tam olarak bu çerezleri yeniden çıkarır ve o profilin bu sitelerdeki oturumunu kapatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вони в профілі браузера cmux «%@». «Видалити» прибере саме ці cookie, і профіль вийде з цих сайтів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chúng nằm trong hồ sơ trình duyệt cmux “%@”. Xóa sẽ gỡ đúng các cookie này, đăng xuất hồ sơ đó khỏi các trang này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "它们位于 cmux 浏览器配置文件“%@”中。“移除”会准确移除这些 Cookie，并让该配置文件退出这些网站。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "它們位於 cmux 瀏覽器設定檔「%@」中。「移除」會準確移除這些 Cookie，並讓該設定檔登出這些網站。"
          }
        }
      }
    },
