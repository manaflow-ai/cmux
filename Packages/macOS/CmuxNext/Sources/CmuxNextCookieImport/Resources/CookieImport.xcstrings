    "cookieImport.consent.leadInto" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يطلب نسخ ملفات تعريف الارتباط من %1$@ إلى ملف تعريف متصفح cmux «%2$@»، لتكون الصفحات هناك مسجّلة الدخول كما في ذلك المتصفح."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Traži da kopira kolačiće iz %1$@ u cmux profil preglednika „%2$@”, tako da su stranice tamo prijavljene kao u tom pregledniku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Den beder om at kopiere cookies fra %1$@ til cmux-browserprofilen “%2$@”, så sider dér er logget ind som i den browser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Es bittet darum, Cookies aus %1$@ in das cmux-Browserprofil „%2$@“ zu kopieren, damit Seiten dort wie in diesem Browser angemeldet sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It asks to copy cookies from %1$@ into the cmux browser profile “%2$@”, so pages there are signed in as in that browser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pide copiar cookies de %1$@ al perfil del navegador de cmux «%2$@», para que las páginas allí tengan la sesión iniciada como en ese navegador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il demande à copier les cookies de %1$@ dans le profil de navigateur cmux « %2$@ », pour que les pages y soient connectées comme dans ce navigateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chiede di copiare i cookie da %1$@ nel profilo del browser cmux «%2$@», così le pagine lì risultano connesse come in quel browser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ の Cookie を cmux ブラウザのプロファイル「%2$@」にコピーし、そこでのページがそのブラウザと同じようにサインインした状態になるよう求めています。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "វាស្នើចម្លងខូគីពី %1$@ ទៅប្រវត្តិរូបកម្មវិធីរុករក cmux “%2$@” ដើម្បីឱ្យទំព័រនៅទីនោះចូលគណនីដូចនៅក្នុងកម្មវិធីរុករកនោះ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@의 쿠키를 cmux 브라우저 프로필 “%2$@”에 복사해 그곳의 페이지가 그 브라우저처럼 로그인되도록 요청합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Den ber om å kopiere informasjonskapsler fra %1$@ til cmux-nettleserprofilen «%2$@», slik at sider der er logget inn som i den nettleseren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prosi o skopiowanie plików cookie z %1$@ do profilu przeglądarki cmux „%2$@”, aby strony w nim były zalogowane jak w tamtej przeglądarce."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pede para copiar cookies de %1$@ para o perfil do navegador do cmux “%2$@”, para que as páginas lá fiquem conectadas como naquele navegador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Просит скопировать cookie из %1$@ в профиль браузера cmux «%2$@», чтобы страницы там были авторизованы, как в том браузере."
          }
