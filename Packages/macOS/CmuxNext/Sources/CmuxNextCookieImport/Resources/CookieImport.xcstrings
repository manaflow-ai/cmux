    "cookieImport.window.lead" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "كل طلب لاستيراد ملفات تعريف الارتباط من متصفح آخر، ومن طلبه، ولماذا، وما الذي تم استيراده. لا تُحفظ هنا أي قيمة لملف تعريف ارتباط."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Svaki zahtjev za uvoz kolačića iz drugog preglednika, ko je tražio, zašto i šta je uvezeno. Ovdje se ne čuva nijedna vrijednost kolačića."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hver anmodning om at importere cookies fra en anden browser, hvem der spurgte, hvorfor, og hvad der kom ind. Ingen cookieværdi gemmes her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jede Anfrage, Cookies aus einem anderen Browser zu importieren: wer fragte, warum und was hereinkam. Hier wird kein Cookie-Wert gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every request to import cookies from another browser, who asked, why, and what came in. No cookie value is kept here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada solicitud para importar cookies de otro navegador, quién la pidió, por qué y qué entró. Aquí no se guarda ningún valor de cookie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chaque demande d’importation de cookies depuis un autre navigateur : qui l’a faite, pourquoi et ce qui est entré. Aucune valeur de cookie n’est conservée ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ogni richiesta di importare cookie da un altro browser: chi l’ha fatta, perché e cosa è entrato. Qui non viene conservato alcun valore dei cookie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "他のブラウザから Cookie を読み込むすべての依頼と、依頼者、理由、取り込まれた内容です。Cookie の値はここに保存されません。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "សំណើនីមួយៗដើម្បីនាំចូលខូគីពីកម្មវិធីរុករកផ្សេង អ្នកណាសុំ ហេតុអ្វី និងអ្វីដែលបាននាំចូល។ គ្មានតម្លៃខូគីណាមួយត្រូវបានរក្សាទុកនៅទីនេះទេ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "다른 브라우저에서 쿠키를 가져오려는 모든 요청과 요청자, 이유, 가져온 내용입니다. 쿠키 값은 여기에 저장되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hver forespørsel om å importere informasjonskapsler fra en annen nettleser, hvem som spurte, hvorfor og hva som kom inn. Ingen verdier lagres her."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Każda prośba o import plików cookie z innej przeglądarki: kto prosił, dlaczego i co trafiło. Żadna wartość pliku cookie nie jest tu przechowywana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada pedido para importar cookies de outro navegador, quem pediu, por quê e o que entrou. Nenhum valor de cookie é guardado aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Каждый запрос на импорт cookie из другого браузера: кто просил, зачем и что было импортировано. Значения cookie здесь не хранятся."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ทุกคำขอนำเข้าคุกกี้จากเบราว์เซอร์อื่น ใครขอ เพราะอะไร และนำเข้าอะไรบ้าง ไม่มีการเก็บค่าคุกกี้ไว้ที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Başka bir tarayıcıdan çerez içe aktarma isteklerinin tümü: kim istedi, neden ve neler geldi. Burada hiçbir çerez değeri saklanmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Кожен запит на імпорт cookie з іншого браузера: хто просив, навіщо і що було імпортовано. Значення cookie тут не зберігаються."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mọi yêu cầu nhập cookie từ trình duyệt khác, ai yêu cầu, vì sao và những gì đã được nhập. Không lưu giá trị cookie nào ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每一次从其他浏览器导入 Cookie 的请求：谁请求、原因以及导入了什么。这里不保存任何 Cookie 值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每一次從其他瀏覽器匯入 Cookie 的請求：誰請求、原因以及匯入了什麼。這裡不保存任何 Cookie 值。"
          }
        }
      }
    },
