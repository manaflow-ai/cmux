    "cookieImport.consent.afterAllow" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بعد اختيار «السماح»، سيطلب macOS كلمة المرور لإلغاء قفل ملفات تعريف الارتباط الخاصة بالمتصفح. لا شيء يغادر هذا الـ Mac."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nakon što odaberete Dozvoli, macOS traži vašu lozinku da otključa kolačiće preglednika. Ništa ne napušta ovaj Mac."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Efter Tillad beder macOS om din adgangskode for at låse browserens cookies op. Intet forlader denne Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nach „Erlauben“ fragt macOS nach deinem Passwort, um die Cookies des Browsers zu entsperren. Nichts verlässt diesen Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After Allow, macOS asks for your password to unlock the browser’s cookies. Nothing leaves this Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tras pulsar Permitir, macOS te pedirá la contraseña para desbloquear las cookies del navegador. Nada sale de este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Après « Autoriser », macOS demande votre mot de passe pour déverrouiller les cookies du navigateur. Rien ne quitte ce Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dopo aver premuto Consenti, macOS chiede la password per sbloccare i cookie del browser. Nulla lascia questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可すると、ブラウザのCookieのロックを解除するためにmacOSがパスワードを求めます。データはこのMacの外に出ません。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "បន្ទាប់ពីអនុញ្ញាត macOS នឹងសុំពាក្យសម្ងាត់របស់អ្នក ដើម្បីដោះសោខូគីរបស់កម្មវិធីរុករក។ គ្មានអ្វីចេញពី Mac នេះទេ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "허용하면 macOS가 브라우저의 쿠키 잠금을 해제하기 위해 암호를 요청합니다. 어떤 데이터도 이 Mac을 벗어나지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Etter Tillat ber macOS om passordet ditt for å låse opp nettleserens informasjonskapsler. Ingenting forlater denne Macen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Po kliknięciu Zezwól macOS poprosi o hasło, aby odblokować pliki cookie przeglądarki. Nic nie opuszcza tego Maca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Depois de Permitir, o macOS pede sua senha para desbloquear os cookies do navegador. Nada sai deste Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "После нажатия «Разрешить» macOS запросит ваш пароль, чтобы разблокировать cookie браузера. Ничто не покидает этот Mac."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "หลังจากกดอนุญาต macOS จะขอรหัสผ่านของคุณเพื่อปลดล็อกคุกกี้ของเบราว์เซอร์ ไม่มีข้อมูลใดออกจาก Mac เครื่องนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "İzin Ver’den sonra macOS, tarayıcının çerezlerinin kilidini açmak için parolanızı ister. Hiçbir şey bu Mac’ten çıkmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Після натискання «Дозволити» macOS запитає ваш пароль, щоб розблокувати файли cookie браузера. Ніщо не залишає цей Mac."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sau khi chọn Cho phép, macOS sẽ yêu cầu mật khẩu của bạn để mở khóa cookie của trình duyệt. Không có gì rời khỏi Mac này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "允许后，macOS 会要求你输入密码以解锁浏览器的 Cookie。任何内容都不会离开这台 Mac。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "允許後，macOS 會要求你輸入密碼以解鎖瀏覽器的 Cookie。任何內容都不會離開這台 Mac。"
          }
        }
      }
    },
    "cookieImport.consent.afterAllowSafari" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تحتاج ملفات تعريف الارتباط في Safari إلى «الوصول الكامل إلى القرص» لـ cmux في إعدادات النظام. لا شيء يغادر هذا الـ Mac."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Safarijevi kolačići zahtijevaju Full Disk Access za cmux u System Settings. Ništa ne napušta ovaj Mac."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Safaris cookies kræver Fuld diskadgang til cmux i Systemindstillinger. Intet forlader denne Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Für die Cookies von Safari braucht cmux „Festplattenvollzugriff“ in den Systemeinstellungen. Nichts verlässt diesen Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari’s cookies need Full Disk Access for cmux in System Settings. Nothing leaves this Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las cookies de Safari requieren «Acceso total al disco» para cmux en Ajustes del Sistema. Nada sale de este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les cookies de Safari nécessitent « Accès complet au disque » pour cmux dans Réglages Système. Rien ne quitte ce Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I cookie di Safari richiedono «Accesso completo al disco» per cmux in Impostazioni di Sistema. Nulla lascia questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SafariのCookieを読むには、システム設定でcmuxにフルディスクアクセスが必要です。データはこのMacの外に出ません。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ខូគីរបស់ Safari ត្រូវការ Full Disk Access សម្រាប់ cmux ក្នុង System Settings។ គ្មានអ្វីចេញពី Mac នេះទេ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Safari의 쿠키를 읽으려면 시스템 설정에서 cmux에 전체 디스크 접근 권한이(가) 필요합니다. 어떤 데이터도 이 Mac을 벗어나지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Safaris informasjonskapsler krever «Full disktilgang» for cmux i Systeminnstillinger. Ingenting forlater denne Macen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pliki cookie Safari wymagają dla cmux uprawnienia „Pełny dostęp do dysku” w sekcji Ustawienia systemowe. Nic nie opuszcza tego Maca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os cookies do Safari exigem “Acesso Total ao Disco” para o cmux em Ajustes do Sistema. Nada sai deste Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Для cookie Safari cmux требуется «Полный доступ к диску» в разделе «Системные настройки». Ничто не покидает этот Mac."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "คุกกี้ของ Safari ต้องใช้ การเข้าถึงดิสก์แบบเต็ม สำหรับ cmux ใน การตั้งค่าระบบ ไม่มีข้อมูลใดออกจาก Mac เครื่องนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Safari çerezleri için Sistem Ayarları’nde cmux’a “Tam Disk Erişimi” izni gerekir. Hiçbir şey bu Mac’ten çıkmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Для файлів cookie Safari потрібен «Повний доступ до диска» для cmux у розділі «Системні параметри». Ніщо не залишає цей Mac."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cookie của Safari cần quyền “Truy cập toàn bộ ổ đĩa” cho cmux trong Cài đặt hệ thống. Không có gì rời khỏi Mac này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Safari 的 Cookie 需要在“系统设置”中为 cmux 开启“完全磁盘访问权限”。任何内容都不会离开这台 Mac。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Safari 的 Cookie 需要在「系統設定」中為 cmux 開啟「完整磁碟取用權限」。任何內容都不會離開這台 Mac。"
          }
        }
      }
    },
