    "cookieImport.consent.lead" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يطلب نسخ ملفات تعريف الارتباط الخاصة بـ %@ إلى متصفح cmux، لتصبح علامات التبويب فيه مسجّلة الدخول مثل ذلك المتصفح."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Traži da kopira vaše kolačiće iz %@ u cmux preglednik, tako da su njegovi tabovi prijavljeni kao u tom pregledniku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Den vil kopiere dine %@-cookies til cmux-browseren, så dens faner er logget ind ligesom i den browser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Er bittet darum, deine %@-Cookies in den cmux-Browser zu kopieren, damit dessen Tabs wie in diesem Browser angemeldet sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It asks to copy your %@ cookies into the cmux browser, so its tabs are signed in like that browser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Solicita copiar tus cookies de %@ al navegador de cmux para que sus pestañas tengan la sesión iniciada como en ese navegador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il demande de copier vos cookies %@ dans le navigateur cmux, afin que ses onglets soient connectés comme dans ce navigateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chiede di copiare i tuoi cookie di %@ nel browser di cmux, così le sue schede risultano autenticate come in quel browser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ のCookieをcmuxブラウザにコピーし、そのブラウザと同じようにタブでサインインできるようにすることを求めています。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "វាសុំចម្លងខូគី %@ របស់អ្នកទៅកម្មវិធីរុករក cmux ដើម្បីឱ្យផ្ទាំងរបស់វាចូលគណនីដូចកម្មវិធីរុករកនោះ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@의 쿠키를 cmux 브라우저로 복사하여, 해당 브라우저처럼 탭에서 로그인된 상태가 되도록 요청합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Den ber om å kopiere %@-informasjonskapslene dine til cmux-nettleseren, slik at fanene der er pålogget som i den nettleseren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prosi o skopiowanie plików cookie z %@ do przeglądarki cmux, aby jej karty były zalogowane tak jak w tamtej przeglądarce."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ele pede para copiar seus cookies do %@ para o navegador do cmux, para que as abas dele fiquem conectadas como nesse navegador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Он просит скопировать ваши cookie из %@ в браузер cmux, чтобы его вкладки были авторизованы так же, как в том браузере."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ขอคัดลอกคุกกี้ %@ ของคุณไปยังเบราว์เซอร์ cmux เพื่อให้แท็บของเบราว์เซอร์นั้นลงชื่อเข้าใช้เหมือนกับเบราว์เซอร์ดังกล่าว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ çerezlerinizi cmux tarayıcısına kopyalamak istiyor; böylece sekmeleri o tarayıcıdaki gibi oturum açmış olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Він просить скопіювати ваші файли cookie з %@ у браузер cmux, щоб його вкладки були авторизовані так само, як у тому браузері."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yêu cầu sao chép cookie %@ của bạn vào trình duyệt cmux, để các tab của nó được đăng nhập như trình duyệt đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "它请求将你的 %@ Cookie 复制到 cmux 浏览器中，使其标签页像该浏览器一样处于登录状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "它請求將你的 %@ Cookie 複製到 cmux 瀏覽器中，讓其分頁像該瀏覽器一樣處於登入狀態。"
          }
        }
      }
