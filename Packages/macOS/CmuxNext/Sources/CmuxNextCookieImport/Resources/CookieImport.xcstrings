    "cookieImport.consent.afterAllowKeychain" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بعد السماح، يطلب macOS كلمة مرور الـ Mac ليتمكّن cmux من قراءة المفتاح «%@». اختر «السماح» هناك، وليس «السماح دائمًا»، حتى يضطر cmux إلى السؤال مجددًا في المرة القادمة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nakon dozvole, macOS traži lozinku vašeg Maca kako bi cmux mogao pročitati ključ „%@”. Tamo odaberite Dozvoli, a ne Uvijek dozvoli, kako bi cmux morao ponovo pitati sljedeći put."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Efter Tillad beder macOS om din Mac-adgangskode, så cmux kan læse nøglen “%@”. Vælg Tillad dér, ikke Tillad altid, så cmux skal spørge igen næste gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nach dem Erlauben fragt macOS nach deinem Mac-Passwort, damit cmux den Schlüssel „%@“ lesen kann. Wähle dort „Erlauben“, nicht „Immer erlauben“, damit cmux beim nächsten Mal wieder fragen muss."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After Allow, macOS asks for your Mac password so cmux can read the “%@” key. Choose Allow there, not Always Allow, so cmux has to ask again next time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tras permitir, macOS pide la contraseña de tu Mac para que cmux pueda leer la clave «%@». Elige Permitir allí, no Permitir siempre, para que cmux tenga que volver a preguntar la próxima vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Après l’autorisation, macOS demande le mot de passe de votre Mac pour que cmux puisse lire la clé « %@ ». Choisissez Autoriser, pas Toujours autoriser, pour que cmux doive redemander la prochaine fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dopo aver consentito, macOS chiede la password del Mac perché cmux possa leggere la chiave «%@». Scegli Consenti, non Consenti sempre, così cmux dovrà chiedere di nuovo la prossima volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "許可すると、cmux が「%@」キーを読めるよう macOS が Mac のパスワードを求めます。そこでは「常に許可」ではなく「許可」を選んでください。次回も cmux が確認するようになります。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "បន្ទាប់ពីអនុញ្ញាត macOS នឹងសួរពាក្យសម្ងាត់ Mac របស់អ្នក ដើម្បីឱ្យ cmux អានសោ “%@” បាន។ សូមជ្រើស អនុញ្ញាត នៅទីនោះ មិនមែន អនុញ្ញាតជានិច្ច ដើម្បីឱ្យ cmux ត្រូវសួរម្តងទៀតពេលក្រោយ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "허용하면 cmux가 “%@” 키를 읽을 수 있도록 macOS가 Mac 암호를 묻습니다. 그곳에서 ‘항상 허용’이 아닌 ‘허용’을 선택하세요. 그래야 다음에도 cmux가 다시 묻습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Etter Tillat ber macOS om Mac-passordet ditt slik at cmux kan lese nøkkelen «%@». Velg Tillat der, ikke Tillat alltid, slik at cmux må spørre igjen neste gang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Po zezwoleniu macOS poprosi o hasło do Maca, aby cmux mógł odczytać klucz „%@”. Wybierz tam Zezwól, a nie Zawsze zezwalaj, aby cmux musiał zapytać ponownie następnym razem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Depois de permitir, o macOS pede a senha do seu Mac para que o cmux possa ler a chave “%@”. Escolha Permitir lá, não Sempre Permitir, para que o cmux tenha de perguntar de novo da próxima vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "После разрешения macOS попросит пароль от Mac, чтобы cmux мог прочитать ключ «%@». Выберите там «Разрешить», а не «Всегда разрешать», чтобы в следующий раз cmux снова спросил."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "หลังจากอนุญาต macOS จะขอรหัสผ่าน Mac ของคุณเพื่อให้ cmux อ่านคีย์ “%@” ได้ ให้เลือก อนุญาต ไม่ใช่ อนุญาตเสมอ เพื่อให้ cmux ต้องถามอีกครั้งในครั้งหน้า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "İzin verdikten sonra macOS, cmux’un “%@” anahtarını okuyabilmesi için Mac parolanızı ister. Orada Her Zaman İzin Ver’i değil İzin Ver’i seçin; böylece cmux bir dahaki sefere yine sormak zorunda kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Після дозволу macOS попросить пароль від Mac, щоб cmux міг прочитати ключ «%@». Виберіть там «Дозволити», а не «Завжди дозволяти», щоб наступного разу cmux знову спитав."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sau khi cho phép, macOS sẽ hỏi mật khẩu Mac để cmux đọc được khóa “%@”. Hãy chọn Cho phép, không phải Luôn cho phép, để lần sau cmux phải hỏi lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "允许后，macOS 会要求输入你的 Mac 密码，以便 cmux 读取“%@”密钥。请在那里选择“允许”，而不是“始终允许”，这样下次 cmux 仍需再次询问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "允許後，macOS 會要求輸入你的 Mac 密碼，讓 cmux 能讀取「%@」金鑰。請在那裡選擇「允許」，而非「永遠允許」，這樣下次 cmux 仍須再次詢問。"
          }
        }
      }
    },
