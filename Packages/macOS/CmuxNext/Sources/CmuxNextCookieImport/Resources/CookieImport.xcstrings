    "cookieImport.consent.everySite" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "كل المواقع: يؤدي هذا إلى تسجيل دخول cmux إلى كل ما سجّلت الدخول إليه في ملف تعريف ذلك المتصفح، بما في ذلك البريد والبنوك. ارفض واطلب من الوكيل تسمية المواقع التي يحتاجها فقط."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sve stranice: ovo prijavljuje cmux u sve u što ste prijavljeni u tom profilu preglednika, uključujući e-poštu i bankarstvo. Odbijte i tražite od agenta da navede samo stranice koje treba."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alle websteder: dette logger cmux ind på alt, du er logget ind på i den browserprofil, også e-mail og netbank. Afvis, og bed agenten om kun at nævne de websteder, den har brug for."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alle Websites: Damit wird cmux überall angemeldet, wo du in diesem Browserprofil angemeldet bist, auch bei E-Mail und Bank. Lehne ab und bitte den Agenten, nur die nötigen Websites zu nennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every site: this signs cmux in to everything you are signed in to in that browser profile, email and banking too. Deny and ask the agent to name only the sites it needs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Todos los sitios: esto inicia sesión en cmux en todo lo que tienes abierto en ese perfil del navegador, también correo y banca. Deniega y pide al agente que nombre solo los sitios que necesita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tous les sites : cmux sera connecté partout où vous l’êtes dans ce profil de navigateur, y compris messagerie et banque. Refusez et demandez à l’agent de ne nommer que les sites nécessaires."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tutti i siti: cmux viene connesso a tutto ciò a cui sei connesso in quel profilo del browser, anche email e banca. Nega e chiedi all’agente di indicare solo i siti che gli servono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "すべてのサイト：そのブラウザプロファイルでサインインしているすべて（メールや銀行も）に cmux がサインインします。拒否して、必要なサイトだけを指定するようエージェントに求めてください。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "គេហទំព័រទាំងអស់៖ វាធ្វើឱ្យ cmux ចូលគណនីគ្រប់កន្លែងដែលអ្នកបានចូលក្នុងប្រវត្តិរូបកម្មវិធីរុករកនោះ រួមទាំងអ៊ីមែល និងធនាគារ។ សូមបដិសេធ ហើយសុំឱ្យភ្នាក់ងារដាក់ឈ្មោះតែគេហទំព័រដែលវាត្រូវការ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "모든 사이트: 그 브라우저 프로필에서 로그인한 모든 곳(이메일, 은행 포함)에 cmux가 로그인됩니다. 거부하고 필요한 사이트만 지정하도록 에이전트에게 요청하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alle nettsteder: dette logger cmux inn overalt der du er logget inn i den nettleserprofilen, også e-post og nettbank. Avslå og be agenten bare nevne nettstedene den trenger."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wszystkie witryny: cmux zostanie zalogowany wszędzie, gdzie jesteś zalogowany w tym profilu przeglądarki, także w poczcie i banku. Odmów i poproś agenta o podanie tylko potrzebnych witryn."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Todos os sites: isso conecta o cmux a tudo em que você está conectado nesse perfil do navegador, incluindo e-mail e banco. Negue e peça ao agente que cite apenas os sites de que precisa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Все сайты: cmux войдёт везде, где вы вошли в этом профиле браузера, включая почту и банк. Откажите и попросите агента указать только нужные сайты."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ทุกเว็บไซต์: การนี้จะทำให้ cmux ลงชื่อเข้าใช้ทุกที่ที่คุณลงชื่อเข้าใช้ในโปรไฟล์เบราว์เซอร์นั้น รวมถึงอีเมลและธนาคาร ปฏิเสธแล้วขอให้เอเจนต์ระบุเฉพาะเว็บไซต์ที่จำเป็น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tüm siteler: bu, cmux’ta o tarayıcı profilinde oturum açtığınız her yerde (e-posta ve banka dahil) oturum açar. Reddedin ve ajandan yalnızca gereken siteleri belirtmesini isteyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Усі сайти: cmux увійде всюди, де ви увійшли в цьому профілі браузера, зокрема в пошту й банк. Відмовте й попросіть агента вказати лише потрібні сайти."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mọi trang: thao tác này đăng nhập cmux vào mọi nơi bạn đã đăng nhập trong hồ sơ trình duyệt đó, kể cả email và ngân hàng. Hãy từ chối và yêu cầu tác tử chỉ nêu các trang cần thiết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "所有网站：这会让 cmux 登录你在该浏览器配置文件中登录的所有网站，包括邮箱和银行。请拒绝，并让代理只列出它需要的网站。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "所有網站：這會讓 cmux 登入你在該瀏覽器設定檔中登入的所有網站，包括電子郵件和銀行。請拒絕，並請代理只列出它需要的網站。"
