    "cookieImport.card.readingKeychain" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يطلب macOS كلمة مرور الـ Mac لتحرير المفتاح «%@». اختر «السماح» وليس «السماح دائمًا». الرفض هناك يوقف الاستيراد ولا يُقرأ شيء."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS traži lozinku vašeg Maca da otpusti ključ „%@”. Odaberite Dozvoli, a ne Uvijek dozvoli. Odbijanje tamo zaustavlja uvoz i ništa se ne čita."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS beder om din Mac-adgangskode for at frigive nøglen “%@”. Vælg Tillad, ikke Tillad altid. Afvis dér stopper importen, og intet læses."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS fragt nach deinem Mac-Passwort, um den Schlüssel „%@“ freizugeben. Wähle „Erlauben“, nicht „Immer erlauben“. Ablehnen dort stoppt den Import, und nichts wird gelesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS is asking for your Mac password to release the “%@” key. Choose Allow, not Always Allow. Deny there stops the import and nothing is read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS pide la contraseña de tu Mac para liberar la clave «%@». Elige Permitir, no Permitir siempre. Denegar allí detiene la importación y no se lee nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS demande le mot de passe de votre Mac pour libérer la clé « %@ ». Choisissez Autoriser, pas Toujours autoriser. Refuser arrête l’importation et rien n’est lu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS chiede la password del Mac per sbloccare la chiave «%@». Scegli Consenti, non Consenti sempre. Negare lì interrompe l’importazione e nulla viene letto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS が「%@」キーを渡すために Mac のパスワードを求めています。「常に許可」ではなく「許可」を選んでください。そこで拒否すると読み込みは止まり、何も読まれません。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS កំពុងសួរពាក្យសម្ងាត់ Mac របស់អ្នក ដើម្បីបញ្ចេញសោ “%@”។ សូមជ្រើស អនុញ្ញាត មិនមែន អនុញ្ញាតជានិច្ច។ ការបដិសេធនៅទីនោះបញ្ឈប់ការនាំចូល ហើយគ្មានអ្វីត្រូវបានអានទេ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS가 “%@” 키를 넘겨주기 위해 Mac 암호를 묻고 있습니다. ‘항상 허용’이 아닌 ‘허용’을 선택하세요. 그곳에서 거부하면 가져오기가 멈추고 아무것도 읽지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS ber om Mac-passordet ditt for å frigi nøkkelen «%@». Velg Tillat, ikke Tillat alltid. Avslå der stopper importen, og ingenting leses."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS prosi o hasło do Maca, aby udostępnić klucz „%@”. Wybierz Zezwól, a nie Zawsze zezwalaj. Odmowa tam zatrzymuje import i nic nie zostanie odczytane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O macOS está pedindo a senha do seu Mac para liberar a chave “%@”. Escolha Permitir, não Sempre Permitir. Negar lá interrompe a importação e nada é lido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS запрашивает пароль от Mac, чтобы выдать ключ «%@». Выберите «Разрешить», а не «Всегда разрешать». Отказ там остановит импорт, и ничего не будет прочитано."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS กำลังขอรหัสผ่าน Mac ของคุณเพื่อปลดคีย์ “%@” ให้เลือก อนุญาต ไม่ใช่ อนุญาตเสมอ หากปฏิเสธตรงนั้นการนำเข้าจะหยุดและไม่มีการอ่านสิ่งใด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS, “%@” anahtarını vermek için Mac parolanızı istiyor. Her Zaman İzin Ver’i değil İzin Ver’i seçin. Orada reddetmek içe aktarmayı durdurur ve hiçbir şey okunmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS просить пароль від Mac, щоб видати ключ «%@». Виберіть «Дозволити», а не «Завжди дозволяти». Відмова там зупинить імпорт, і нічого не буде прочитано."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS đang hỏi mật khẩu Mac để mở khóa “%@”. Hãy chọn Cho phép, không phải Luôn cho phép. Từ chối ở đó sẽ dừng việc nhập và không có gì được đọc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS 正在请求你的 Mac 密码以释放“%@”密钥。请选择“允许”，而不是“始终允许”。在那里拒绝会停止导入，不会读取任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS 正在要求你的 Mac 密碼以釋出「%@」金鑰。請選擇「允許」，而非「永遠允許」。在那裡拒絕會停止匯入，不會讀取任何內容。"
          }
        }
      }
    },
