  "strings": {
    "remoteLocalhost.error.disabled": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تمرير localhost معطّل على %@ (server.loopback_forward في cmux-tui.json)."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prosljeđivanje localhosta je isključeno na %@ (server.loopback_forward u cmux-tui.json)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Videresendelse af localhost er slået fra på %@ (server.loopback_forward i cmux-tui.json)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die localhost-Weiterleitung ist auf %@ ausgeschaltet (server.loopback_forward in cmux-tui.json)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Localhost forwarding is turned off on %@ (server.loopback_forward in cmux-tui.json)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El reenvío de localhost está desactivado en %@ (server.loopback_forward en cmux-tui.json)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le relais de localhost est désactivé sur %@ (server.loopback_forward dans cmux-tui.json)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’inoltro di localhost è disattivato su %@ (server.loopback_forward in cmux-tui.json)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ では localhost 転送がオフになっています（cmux-tui.json の server.loopback_forward）。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការបញ្ជូន localhost ត្រូវបានបិទនៅលើ %@ (server.loopback_forward ក្នុង cmux-tui.json)។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@에서 localhost 전달이 꺼져 있습니다(cmux-tui.json의 server.loopback_forward)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Videresending av localhost er slått av på %@ (server.loopback_forward i cmux-tui.json)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przekazywanie localhost jest wyłączone na %@ (server.loopback_forward w cmux-tui.json)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O encaminhamento de localhost está desativado em %@ (server.loopback_forward em cmux-tui.json)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пересылка localhost отключена на %@ (server.loopback_forward в cmux-tui.json)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การส่งต่อ localhost ถูกปิดบน %@ (server.loopback_forward ใน cmux-tui.json)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ üzerinde localhost iletimi kapalı (cmux-tui.json içindeki server.loopback_forward)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пересилання localhost вимкнено на %@ (server.loopback_forward у cmux-tui.json)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tính năng chuyển tiếp localhost đã tắt trên %@ (server.loopback_forward trong cmux-tui.json)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 上已关闭 localhost 转发（cmux-tui.json 中的 server.loopback_forward）。"
          }
