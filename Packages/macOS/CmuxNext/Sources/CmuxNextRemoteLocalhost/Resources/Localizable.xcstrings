    "remoteLocalhost.error.other": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "رفض %@ الاتصال."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ je odbio vezu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ afviste forbindelsen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ hat die Verbindung abgelehnt."
          }
        },
        "en": {
