    "remoteLocalhost.error.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux غير متصل بـ %@. سيعيد الاتصال تلقائيًا؛ أعد التحميل عند عودة الجهاز."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux nije povezan sa %@. Ponovo se povezuje sam; osvježite kada se mašina vrati."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux er ikke forbundet til %@. Den genopretter forbindelsen selv; genindlæs, når maskinen er tilbage."
