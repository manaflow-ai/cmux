            "state": "needs_review",
            "value": "%@ បានបដិសេធការតភ្ជាប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@이(가) 연결을 거부했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ avviste tilkoblingen."
          }
        },
        "pl": {
          "stringUnit": {
