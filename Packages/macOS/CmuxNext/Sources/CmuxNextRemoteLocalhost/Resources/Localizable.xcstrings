        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux មិនបានភ្ជាប់ទៅ %@ ទេ។ វានឹងភ្ជាប់ឡើងវិញដោយខ្លួនឯង សូមផ្ទុកឡើងវិញពេលម៉ាស៊ីនត្រឡប់មកវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux가 %@에 연결되어 있지 않습니다. 자동으로 다시 연결되니 머신이 돌아오면 새로고침하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux er ikke koblet til %@. Den kobler til på nytt av seg selv; last inn på nytt når maskinen er tilbake."
