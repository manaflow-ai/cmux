          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ปฏิเสธการเชื่อมต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ bağlantıyı reddetti."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ відхилив підключення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ đã từ chối kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 拒绝了连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 拒絕了連線。"
          }
        }
      }
    },
    "remoteLocalhost.error.portNotAllowed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يسمح %@ بالتمرير إلى هذا المنفذ."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ne dozvoljava prosljeđivanje na ovaj port."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ tillader ikke videresendelse til denne port."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ erlaubt keine Weiterleitung an diesen Port."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ does not allow forwarding to this port."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ no permite reenviar a este puerto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ n’autorise pas le relais vers ce port."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ non consente l’inoltro a questa porta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はこのポートへの転送を許可していません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ មិនអនុញ្ញាតឱ្យបញ្ជូនទៅច្រកនេះទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@에서 이 포트로의 전달을 허용하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ tillater ikke videresending til denne porten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nie zezwala na przekazywanie do tego portu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ não permite encaminhar para esta porta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ не разрешает пересылку на этот порт."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ไม่อนุญาตให้ส่งต่อไปยังพอร์ตนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ bu bağlantı noktasına iletime izin vermiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ не дозволяє пересилання на цей порт."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ không cho phép chuyển tiếp tới cổng này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 不允许转发到此端口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 不允許轉送到此連接埠。"
          }
        }
      }
    },
    "remoteLocalhost.error.refused": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا شيء يستمع على هذا المنفذ في %@. شغّل الخادم هناك أو تحقّق من المنفذ."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ništa ne sluša na tom portu na %@. Pokrenite server tamo ili provjerite port."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Intet lytter på den port på %@. Start serveren der, eller kontrollér porten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auf diesem Port von %@ lauscht nichts. Starten Sie den Server dort oder prüfen Sie den Port."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is listening on that port of %@. Start the server there, or check the port."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nada escucha en ese puerto de %@. Inicia el servidor allí o revisa el puerto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rien n’écoute sur ce port de %@. Démarrez le serveur là-bas ou vérifiez le port."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nulla è in ascolto su quella porta di %@. Avvia il server lì o controlla la porta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のそのポートでは何も待ち受けていません。そこでサーバーを起動するか、ポートを確認してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្មានអ្វីកំពុងស្តាប់នៅលើច្រកនោះរបស់ %@ ទេ។ សូមចាប់ផ្តើមម៉ាស៊ីនមេនៅទីនោះ ឬពិនិត្យច្រក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@의 해당 포트에서 수신 대기 중인 것이 없습니다. 그곳에서 서버를 시작하거나 포트를 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingenting lytter på den porten på %@. Start serveren der, eller sjekk porten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nic nie nasłuchuje na tym porcie na %@. Uruchom tam serwer lub sprawdź port."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nada está escutando nessa porta de %@. Inicie o servidor lá ou verifique a porta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На этом порту %@ ничего не слушает. Запустите там сервер или проверьте порт."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่มีสิ่งใดรอรับที่พอร์ตนั้นของ %@ เริ่มเซิร์ฟเวอร์ที่นั่นหรือตรวจสอบพอร์ต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ üzerinde o bağlantı noktasını dinleyen bir şey yok. Sunucuyu orada başlatın veya bağlantı noktasını kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На цьому порту %@ нічого не слухає. Запустіть там сервер або перевірте порт."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không có gì đang lắng nghe trên cổng đó của %@. Hãy khởi động máy chủ ở đó hoặc kiểm tra cổng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 的该端口上没有服务在监听。请在那里启动服务器，或检查端口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 的該連接埠上沒有服務在監聽。請在那裡啟動伺服器，或檢查連接埠。"
          }
        }
      }
    },
