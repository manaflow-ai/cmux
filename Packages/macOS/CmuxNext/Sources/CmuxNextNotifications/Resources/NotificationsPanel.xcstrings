    "notifications.incognito.body": {
      "comment": "Body of a macOS banner from a tab in an incognito window: no workspace, tab, agent or message is named, as Notification Center keeps banners in its history.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "علامة تبويب في نافذة التصفح المتخفي تحتاج إليك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartica u anonimnom prozoru treba vašu pažnju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En fane i et inkognitovindue har brug for dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tab in einem Inkognitofenster braucht dich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tab in an incognito window needs you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pestaña de una ventana de incógnito te necesita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un onglet d’une fenêtre de navigation privée a besoin de vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una scheda in una finestra in incognito ha bisogno di te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シークレット ウィンドウのタブが対応を待っています。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្ទាំងមួយក្នុងបង្អួចអនាមិកត្រូវការអ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시크릿 창의 탭에서 확인이 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En fane i et inkognitovindu trenger deg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta w oknie incognito wymaga Twojej uwagi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma aba em uma janela anônima precisa de você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладке в окне инкогнито нужно ваше внимание."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็บในหน้าต่างที่ไม่ระบุตัวตนต้องการให้คุณดู"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizli penceredeki bir sekme ilginizi bekliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладка в анонімному вікні потребує вашої уваги."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một thẻ trong cửa sổ ẩn danh cần bạn chú ý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无痕式窗口中的一个标签页需要你处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無痕式視窗中的一個分頁需要你處理。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
