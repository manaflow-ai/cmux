    "notifications.permission.unavailable": {
      "comment": "The error cmux setup notifications gets when this app process never uses macOS notifications (an automation or test host, or not the cmux app bundle), so it cannot read or ask for the permission.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تستخدم عملية cmux هذه إشعارات macOS (مضيف أتمتة أو اختبار، أو ليست حزمة تطبيق cmux)"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj cmux proces ne koristi macOS obavještenja (host za automatizaciju ili testove, ili nije paket aplikacije cmux)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne cmux-proces bruger ikke macOS-notifikationer (en automatiserings- eller testvært, eller ikke cmux-appens bundt)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser cmux-Prozess verwendet keine macOS-Mitteilungen (ein Automatisierungs- oder Testhost oder nicht das cmux-App-Bundle)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cmux process does not use macOS notifications (an automation or test host, or not the cmux app bundle)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este proceso de cmux no usa las notificaciones de macOS (un host de automatización o de pruebas, o no es el paquete de la app cmux)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce processus cmux n’utilise pas les notifications macOS (un hôte d’automatisation ou de test, ou pas le paquet de l’app cmux)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo processo di cmux non usa le notifiche di macOS (un host di automazione o di test, o non il pacchetto dell’app cmux)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この cmux プロセスは macOS の通知を使いません（自動化やテストのホスト、または cmux アプリのバンドルではありません）"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
