    "rd.state.stopped.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أوقف %@ سطح المكتب البعيد. يُعرض آخر إطار."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ je isključio udaljenu radnu površinu. Prikazan je posljednji kadar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ slog fjernskrivebord fra. Det sidste billede vises."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ hat Remote Desktop ausgeschaltet. Das letzte Bild wird angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ turned off Remote Desktop. The last frame is shown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ desactivó el escritorio remoto. Se muestra el último fotograma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ a désactivé le bureau à distance. La dernière image est affichée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ha disattivato il desktop remoto. È mostrato l’ultimo fotogramma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がリモートデスクトップをオフにしました。最後の画面を表示しています。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ បានបិទផ្ទៃតុពីចម្ងាយ។ ស៊ុមចុងក្រោយត្រូវបានបង្ហាញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@에서 원격 데스크톱을 껐습니다. 마지막 화면이 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ slo av eksternt skrivebord. Det siste bildet vises."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ wyłączył pulpit zdalny. Wyświetlana jest ostatnia klatka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ desativou a área de trabalho remota. O último quadro é exibido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ отключил удалённый рабочий стол. Показан последний кадр."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ปิดเดสก์ท็อประยะไกลแล้ว แสดงเฟรมสุดท้ายอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ Uzak Masaüstü'nü kapattı. Son kare gösteriliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ вимкнув віддалений робочий стіл. Показано останній кадр."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ đã tắt Màn hình từ xa. Đang hiển thị khung hình cuối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 已关闭远程桌面。正在显示最后一帧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 已關閉遠端桌面。正在顯示最後一幀。"
          }
        }
      }
