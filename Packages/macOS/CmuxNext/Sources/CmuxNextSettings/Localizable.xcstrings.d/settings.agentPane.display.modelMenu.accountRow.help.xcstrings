        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kompaktowe menu modeli oferuje konto czatu. Po wyłączeniu przełączaj konta w menu konta na pasku bocznym lub w Ustawieniach."
