      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The compact model menu offers the chat's account. Off, switch accounts from the sidebar's account menu or Settings."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تعرض قائمة النماذج المختصرة حساب المحادثة. عند الإيقاف، بدّل الحسابات من قائمة الحساب في الشريط الجانبي أو من الإعدادات."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kompaktni meni modela nudi račun chata. Kad je isključeno, mijenjajte račune iz menija računa u bočnoj traci ili u Postavkama."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Den kompakte modelmenu tilbyder chattens konto. Slået fra skifter du konto fra sidepanelets kontomenu eller Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das kompakte Modellmenü bietet das Konto des Chats an. Aus: Konten im Kontomenü der Seitenleiste oder in den Einstellungen wechseln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El menú compacto de modelos ofrece la cuenta del chat. Desactivado, cambia de cuenta desde el menú de cuenta de la barra lateral o Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le menu compact des modèles propose le compte de la conversation. Désactivé, changez de compte depuis le menu Compte de la barre latérale ou les Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il menu compatto dei modelli offre l'account della chat. Disattivato, cambia account dal menu account della barra laterale o da Impostazioni."
