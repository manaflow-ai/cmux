      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحصل طرفيات Claude Code وCodex على زر يفتح سجلها السابق كمحادثة للقراءة فقط."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminali Claude Code i Codex dobijaju dugme koje otvara njihovu raniju historiju kao chat samo za čitanje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code- og Codex-terminaler får en knap, der åbner deres tidligere historik som en skrivebeskyttet chat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code- und Codex-Terminals erhalten eine Taste, die ihren früheren Verlauf als schreibgeschützten Chat öffnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code and Codex terminals get a button that opens their earlier history as a read-only chat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las terminales de Claude Code y Codex tienen un botón que abre su historial anterior como un chat de solo lectura."
