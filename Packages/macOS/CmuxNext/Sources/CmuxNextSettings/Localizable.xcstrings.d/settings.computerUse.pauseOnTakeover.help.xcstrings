      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While you use the mouse or keyboard, agents wait before their next click or key press."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أثناء استخدامك الماوس أو لوحة المفاتيح، ينتظر الوكلاء قبل النقرة أو ضغطة المفتاح التالية."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dok koristite miš ili tastaturu, agenti čekaju prije sljedećeg klika ili pritiska tipke."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mens du bruger mus eller tastatur, venter agenter før deres næste klik eller tastetryk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während du Maus oder Tastatur benutzt, warten Agenten vor ihrem nächsten Klick oder Tastendruck."
