{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.experiments.startedTaskTitleChip.help" : {
      "comment" : "Settings > Advanced > Experiments: the Started Tasks: Title Opens Chat taste prototype row",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Suggested Tasks, a started task opens its chat and highlights from its title only, not the whole row."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في المهام المقترحة، تفتح المهمة المبدوءة محادثتها وتُبرز من عنوانها فقط، لا من الصف كله."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U predloženim zadacima pokrenuti zadatak otvara svoj razgovor i ističe se samo preko naslova, ne cijelog reda."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Foreslåede opgaver åbner en startet opgave sin chat og fremhæves kun fra titlen, ikke hele rækken."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Vorgeschlagene Aufgaben öffnet eine gestartete Aufgabe ihren Chat und wird nur über ihren Titel hervorgehoben, nicht über die ganze Zeile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Tareas sugeridas, una tarea iniciada abre su chat y se resalta solo desde su título, no desde toda la fila."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Tâches suggérées, une tâche lancée ouvre son chat et se met en évidence uniquement depuis son titre, pas toute la ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Attività suggerite, un’attività avviata apre la sua chat e si evidenzia solo dal titolo, non dall’intera riga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提案タスクで、開始済みタスクは行全体ではなくタイトルからのみチャットを開き、ハイライトされます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ក្នុងកិច្ចការដែលបានស្នើ កិច្ចការដែលបានចាប់ផ្ដើមបើកការជជែករបស់វា និងបន្លិចពីចំណងជើងតែប៉ុណ្ណោះ មិនមែនពីជួរទាំងមូលទេ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추천 작업에서 시작된 작업은 행 전체가 아니라 제목에서만 채팅을 열고 강조 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Foreslåtte oppgaver åpner en startet oppgave chatten sin og fremheves bare fra tittelen, ikke hele raden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W sugerowanych zadaniach rozpoczęte zadanie otwiera swój czat i podświetla się tylko z tytułu, a nie z całego wiersza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em Tarefas sugeridas, uma tarefa iniciada abre o chat e é destacada apenas pelo título, não pela linha inteira."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В предложенных задачах запущенная задача открывает свой чат и подсвечивается только по заголовку, а не всей строкой."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ในงานที่แนะนำ งานที่เริ่มแล้วจะเปิดแชตและไฮไลต์จากชื่อเท่านั้น ไม่ใช่ทั้งแถว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önerilen görevlerde başlatılan bir görev, tüm satırdan değil yalnızca başlığından sohbetini açar ve vurgulanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У запропонованих завданнях запущене завдання відкриває свій чат і підсвічується лише заголовком, а не всім рядком."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong Tác vụ đề xuất, tác vụ đã bắt đầu chỉ mở cuộc trò chuyện và làm nổi bật từ tiêu đề, không phải cả hàng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在建议的任务中，已开始的任务只在标题上打开聊天并高亮，而不是整行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在建議的任務中，已開始的任務只在標題上開啟聊天並醒目顯示，而不是整列。"
          }
        }
      }
    }
  },
  "version" : "1.0"
