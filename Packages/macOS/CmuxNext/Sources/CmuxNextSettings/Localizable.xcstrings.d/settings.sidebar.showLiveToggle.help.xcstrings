{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.sidebar.showLiveToggle.help" : {
      "comment" : "Settings help line of the Show Live Button toggle.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Live button after the profile button turns presence on or off. Off: use the palette."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي زر المباشر بعد زر الملف الشخصي إلى تشغيل الحضور أو إيقافه. عند الإيقاف: استخدم لوحة الأوامر."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dugme Uživo iza dugmeta profila uključuje ili isključuje prisustvo. Isključeno: koristite paletu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Live-knap efter profilknappen slår tilstedeværelse til eller fra. Fra: brug paletten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Live-Taste nach der Profiltaste schaltet die Präsenz ein oder aus. Aus: nutze die Palette."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un botón En vivo tras el botón de perfil activa o desactiva la presencia. Desactivado: usa la paleta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bouton Direct après le bouton de profil active ou désactive la présence. Désactivé : utilisez la palette."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pulsante Live dopo quello del profilo attiva o disattiva la presenza. Disattivato: usa la palette."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロフィールボタンの後ろのライブボタンで、プレゼンスのオンとオフを切り替えます。オフの場合はパレットを使います。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ប៊ូតុងផ្ទាល់បន្ទាប់ពីប៊ូតុងប្រវត្តិរូប បើក ឬបិទវត្តមាន។ បិទ៖ ប្រើផាលែត។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필 버튼 뒤의 라이브 버튼으로 접속 상태를 켜거나 끕니다. 끄면 팔레트를 사용하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Live-knapp etter profilknappen slår tilstedeværelse på eller av. Av: bruk paletten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przycisk trybu na żywo po przycisku profilu włącza lub wyłącza obecność. Wyłączone: użyj palety."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um botão Ao vivo depois do botão de perfil liga ou desliga a presença. Desligado: use a paleta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка присутствия после кнопки профиля включает и выключает присутствие. Выключено: используйте палитру."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปุ่มออนไลน์หลังปุ่มโปรไฟล์ใช้เปิดหรือปิดการแสดงสถานะ ปิด: ใช้พาเลต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil düğmesinden sonraki Canlı düğmesi varlığı açar veya kapatır. Kapalı: paleti kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка присутності після кнопки профілю вмикає або вимикає присутність. Вимкнено: користуйтеся палітрою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nút trực tuyến sau nút hồ sơ bật hoặc tắt sự hiện diện. Tắt: dùng bảng lệnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "资料按钮后的在线按钮可开启或关闭在线状态。关闭时：使用命令面板。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個人檔案按鈕後的線上按鈕可開啟或關閉線上狀態。關閉時：使用命令面板。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
