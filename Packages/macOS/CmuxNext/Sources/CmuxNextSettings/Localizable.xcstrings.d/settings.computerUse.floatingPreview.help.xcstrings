{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.computerUse.floatingPreview.help" : {
      "comment" : "Settings row help text.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A live view of the app an agent uses, floating over every app. Drag it anywhere; hide it from the menu bar."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض مباشر للتطبيق الذي يستخدمه الوكيل، عائم فوق كل التطبيقات. اسحبه إلى أي مكان؛ وأخفه من شريط القوائم."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregled uživo aplikacije koju agent koristi, iznad svih aplikacija. Prevucite ga bilo gdje; sakrijte ga s trake menija."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En livevisning af den app, en agent bruger, svævende over alle apps. Træk den hvorhen som helst; skjul den fra menulinjen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Live-Ansicht der App, die ein Agent nutzt, schwebend über allen Apps. Überallhin ziehen; über die Menüleiste ausblenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vista en directo de la app que usa un agente, flotando sobre todas las apps. Arrástrala a cualquier lugar; ocúltala desde la barra de menús."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une vue en direct de l’app qu’utilise un agent, flottant au-dessus de toutes les apps. Faites-la glisser n’importe où ; masquez-la depuis la barre des menus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vista dal vivo dell’app usata da un agente, sopra tutte le app. Trascinala ovunque; nascondila dalla barra dei menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントが使うアプリのライブビューを、すべてのアプリの上に浮かべて表示します。どこへでもドラッグでき、メニューバーから隠せます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ទិដ្ឋភាពផ្ទាល់នៃកម្មវិធីដែលភ្នាក់ងារប្រើ អណ្តែតលើកម្មវិធីទាំងអស់។ អូសវាទៅកន្លែងណាក៏បាន លាក់វាពីរបារម៉ឺនុយ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트가 사용하는 앱의 실시간 화면을 모든 앱 위에 띄웁니다. 아무 곳으로나 드래그하고 메뉴 막대에서 숨길 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En direktevisning av appen en agent bruker, flytende over alle apper. Dra den hvor som helst; skjul den fra menylinjen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podgląd na żywo aplikacji używanej przez agenta, nad wszystkimi aplikacjami. Przeciągnij go w dowolne miejsce; ukryj go z paska menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma visualização ao vivo do app que um agente usa, flutuando sobre todos os apps. Arraste para qualquer lugar; oculte pela barra de menus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Живой вид приложения, которым пользуется агент, поверх всех приложений. Перетащите куда угодно; скройте из строки меню."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มุมมองสดของแอปที่เอเจนต์ใช้ ลอยอยู่เหนือทุกแอป ลากไปที่ใดก็ได้ ซ่อนได้จากแถบเมนู"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir ajanın kullandığı uygulamanın canlı görünümü, tüm uygulamaların üzerinde. İstediğiniz yere sürükleyin; menü çubuğundan gizleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Живий вигляд застосунку, яким користується агент, поверх усіх застосунків. Перетягніть будь-куди; сховайте з рядка меню."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chế độ xem trực tiếp ứng dụng mà tác tử dùng, nổi trên mọi ứng dụng. Kéo đến bất kỳ đâu; ẩn từ thanh menu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能体所用应用的实时画面，浮在所有应用之上。可拖到任意位置，并可从菜单栏隐藏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代理所用 App 的即時畫面，浮在所有 App 之上。可拖到任意位置，並可從選單列隱藏。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
