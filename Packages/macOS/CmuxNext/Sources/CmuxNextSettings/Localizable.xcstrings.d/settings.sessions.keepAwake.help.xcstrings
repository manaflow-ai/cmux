        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Не дає Mac засинати під час бездіяльності, поки працює агент. Закриття кришки так само присипляє Mac."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ngăn máy ngủ khi không hoạt động trong lúc tác tử làm việc. Gập nắp vẫn đưa máy Mac vào chế độ ngủ."
          }
