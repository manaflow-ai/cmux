  "strings" : {
    "settings.sessions.keepAwake.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stops idle sleep while an agent works. Closing the lid still sleeps the Mac."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يمنع السكون عند الخمول أثناء عمل وكيل. إغلاق الغطاء لا يزال يُدخل الـ Mac في وضع السكون."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sprječava mirovanje dok agent radi. Zatvaranje poklopca i dalje uspavljuje Mac."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Forhindrer dvale ved inaktivitet, mens en agent arbejder. Når du lukker låget, går Mac'en stadig i dvale."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verhindert den Ruhezustand, solange ein Agent arbeitet. Beim Zuklappen schläft der Mac trotzdem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Evita el reposo por inactividad mientras trabaja un agente. Al cerrar la tapa, el Mac sigue entrando en reposo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Empêche la suspension d’activité pendant qu’un agent travaille. Fermer le couvercle met toujours le Mac en veille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Impedisce lo stop per inattività mentre un agente lavora. Chiudendo il coperchio il Mac va comunque in stop."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "エージェントの作業中はアイドル時のスリープを止めます。蓋を閉じると Mac はスリープします。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "បញ្ឈប់ការដេកពេលទំនេរ ខណៈភ្នាក់ងារកំពុងធ្វើការ។ ការបិទគម្របនៅតែធ្វើឱ្យ Mac ដេក។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "에이전트가 작업하는 동안 유휴 잠자기를 막습니다. 덮개를 닫으면 Mac은 여전히 잠자기 상태가 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hindrer dvale ved inaktivitet mens en agent arbeider. Når du lukker lokket, går Macen fortsatt i dvale."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wstrzymuje usypianie przy bezczynności, gdy agent pracuje. Zamknięcie pokrywy nadal usypia Maca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Impede o repouso por inatividade enquanto um agente trabalha. Fechar a tampa ainda coloca o Mac em repouso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Не даёт Mac уйти в сон при бездействии, пока работает агент. Закрытие крышки всё равно переводит Mac в сон."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ไม่ให้เครื่องพักเมื่อไม่มีการใช้งานขณะที่เอเจนต์ทำงาน การปิดฝาก็ยังทำให้ Mac พักเครื่อง"
