        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ជួរ​ដែល​អ្នក​ជ្រើស និង​ប្រើ​ញឹកញាប់​ឡើង​ខ្ពស់។ ពេល​បិទ មិន​កត់ត្រា​អ្វី​ទេ។"
