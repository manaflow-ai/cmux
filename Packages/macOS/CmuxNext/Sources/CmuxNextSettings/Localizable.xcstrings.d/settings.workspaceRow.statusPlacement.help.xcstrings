{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.workspaceRow.statusPlacement.help" : {
      "comment" : "Settings > Sidebar > Workspace Rows: help under the Status Position row.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where the row's status mark draws: at the row's end, or before the name in the icon's place."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مكان ظهور علامة حالة الصف: في نهاية الصف، أو قبل الاسم مكان الأيقونة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdje se crta oznaka statusa reda: na kraju reda ili ispred naziva, na mjestu ikone."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor rækkens statusmærke vises: i slutningen af rækken eller før navnet i ikonets plads."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo die Statusmarkierung der Zeile erscheint: am Ende der Zeile oder vor dem Namen an der Stelle des Symbols."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dónde se dibuja la marca de estado de la fila: al final de la fila o antes del nombre, en el lugar del icono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Où s’affiche la marque d’état de la ligne : à la fin de la ligne, ou avant le nom à la place de l’icône."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dove appare il segno di stato della riga: alla fine della riga o prima del nome, al posto dell’icona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行のステータスマークを表示する場所: 行の末尾、またはアイコンの位置で名前の前。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "កន្លែងដែលសញ្ញាស្ថានភាពរបស់ជួរបង្ហាញ៖ នៅចុងជួរ ឬមុនឈ្មោះ ជំនួសរូបតំណាង។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "행의 상태 표시가 나타나는 위치: 행의 끝, 또는 아이콘 자리에서 이름 앞."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor radens statusmerke vises: på slutten av raden, eller foran navnet i ikonets plass."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdzie rysuje się oznaczenie stanu wiersza: na końcu wiersza lub przed nazwą, w miejscu ikony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde a marca de status da linha aparece: no fim da linha ou antes do nome, no lugar do ícone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Где показывается значок состояния строки: в конце строки или перед названием, на месте значка."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตำแหน่งที่เครื่องหมายสถานะของแถวแสดง: ที่ท้ายแถว หรือก่อนชื่อในตำแหน่งของไอคอน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satırın durum işaretinin çizildiği yer: satırın sonunda veya simgenin yerinde, adın önünde."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Де показується позначка стану рядка: у кінці рядка або перед назвою, на місці значка."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nơi dấu trạng thái của hàng hiển thị: ở cuối hàng, hoặc trước tên tại vị trí của biểu tượng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行状态标记的位置：在行尾，或在名称前图标的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列狀態標記的位置：在列尾，或在名稱前圖示的位置。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
