        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند الإيقاف، لا تعرض الأولوية إلا المحادثات التي تحتاج إليك أو قيد التشغيل."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isključeno, prioritet prikazuje samo razgovore kojima trebate ili koji rade."
