        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ภาพส่วนหัวแถบด้านข้างในลักษณะที่ปรากฏแบบสว่าง หากไม่ได้ตั้งค่า จะใช้ภาพของโหมดมืด"
