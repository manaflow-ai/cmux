      "comment" : "Settings row help for the light sidebar header picture.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sidebar header picture in the light appearance. Unset, the dark picture."
          }
