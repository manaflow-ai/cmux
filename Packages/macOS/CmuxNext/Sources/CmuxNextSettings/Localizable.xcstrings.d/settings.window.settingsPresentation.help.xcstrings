        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Karta otwiera ustawienia jako kartę w aktywnym panelu. Całe okno otwiera je na całym oknie, z sekcjami po lewej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
