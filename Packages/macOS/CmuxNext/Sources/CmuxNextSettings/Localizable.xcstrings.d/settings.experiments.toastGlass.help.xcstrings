{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.experiments.toastGlass.help" : {
      "comment" : "Settings > Experimental > Toast Glass help: toasts in chats use the same glass material as the app's native toasts.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر الإشعارات المنبثقة في المحادثات على الزجاج نفسه الذي تستخدمه إشعارات التطبيق."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obavijesti u chatovima stoje na istom staklu kao i obavijesti same aplikacije."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meddelelser i chats ligger på det samme glas som appens egne meddelelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweise in Chats liegen auf demselben Glas wie die eigenen Hinweise der App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toasts in chats sit on the same glass as the app's own toasts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
