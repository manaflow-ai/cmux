    "settings.workspaceHibernation.freeingAgents.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ينهي أيضًا جلسات Claude Code وCodex الخاملة؛ وفتح علامة التبويب يستأنفها."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Završava i neaktivne Claude Code i Codex sesije; otvaranje kartice ih nastavlja."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Afslutter også inaktive Claude Code- og Codex-sessioner; de genoptages, når du åbner fanen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beendet auch inaktive Claude-Code- und Codex-Sitzungen; beim Öffnen des Tabs werden sie fortgesetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Also ends idle Claude Code and Codex sessions; opening the tab resumes them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "También cierra las sesiones inactivas de Claude Code y Codex; al abrir la pestaña se reanudan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Termine aussi les sessions Claude Code et Codex inactives ; ouvrir l’onglet les reprend."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chiude anche le sessioni inattive di Claude Code e Codex; aprendo la scheda riprendono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "アイドル状態の Claude Code と Codex のセッションも終了します。タブを開くと再開されます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "បញ្ចប់វគ្គ Claude Code និង Codex ដែលទំនេរផងដែរ; ការបើកផ្ទាំងបន្តវាវិញ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "유휴 Claude Code 및 Codex 세션도 종료합니다. 탭을 열면 재개됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Avslutter også inaktive Claude Code- og Codex-økter; når du åpner fanen, gjenopptas de."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kończy też bezczynne sesje Claude Code i Codex; otwarcie karty je wznawia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Também encerra sessões ociosas do Claude Code e do Codex; abrir a aba as retoma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Также завершает простаивающие сеансы Claude Code и Codex; при открытии вкладки они возобновляются."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ปิดเซสชัน Claude Code และ Codex ที่ว่างด้วย การเปิดแท็บจะทำเซสชันต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
