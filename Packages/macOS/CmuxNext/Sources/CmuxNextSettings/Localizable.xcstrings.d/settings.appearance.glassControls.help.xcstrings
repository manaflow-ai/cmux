        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定のスイッチとスライダーのつまみをガラスで描きます。"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crta dugmad prekidača i klizača u Postavkama kao staklo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegner knapperne på kontakter og skydere i Indstillinger som glas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disegna le manopole di interruttori e cursori nelle Impostazioni come vetro."
