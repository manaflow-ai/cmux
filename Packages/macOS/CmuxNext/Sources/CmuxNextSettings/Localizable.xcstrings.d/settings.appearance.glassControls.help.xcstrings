{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.appearance.glassControls.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draws the knobs of the switches and sliders in Settings as glass."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet die Knöpfe der Schalter und Schieberegler in den Einstellungen als Glas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessine les boutons des interrupteurs et des curseurs des Réglages en verre."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرسم مقابض المفاتيح وأشرطة التمرير في الإعدادات كزجاج."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuja los mandos de los interruptores y deslizadores de Ajustes como cristal."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將「設定」中開關與滑桿的旋鈕繪製為玻璃。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将“设置”中开关和滑块的旋钮绘制为玻璃。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정의 스위치와 슬라이더 손잡이를 유리로 그립니다."
