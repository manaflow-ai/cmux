{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.ui.animations.tabs.help" : {
      "comment" : "Settings > Appearance > Motion: the help text under a motion switch (ui.animations.*).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تكبر علامات التبويب وتصغر وتنزلق عند فتحها وإغلاقها ونقلها."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kartice rastu, smanjuju se i klize kad se otvore, zatvore i pomaknu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faner vokser, krymper og glider, når de åbnes, lukkes og flyttes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tabs wachsen, schrumpfen und gleiten beim Öffnen, Schließen und Verschieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabs grow, shrink and slide as they open, close and move."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las pestañas crecen, se encogen y se deslizan al abrirse, cerrarse y moverse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les onglets grandissent, rétrécissent et glissent quand ils s’ouvrent, se ferment et bougent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le schede crescono, si restringono e scorrono quando si aprono, si chiudono e si spostano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "タブを開く、閉じる、移動するときに、伸縮やスライドで表示します。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ផ្ទាំងរីក រួម និងរំកិលនៅពេលបើក បិទ និងផ្លាស់ទី។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "탭을 열고, 닫고, 옮길 때 커지고 줄어들며 미끄러집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faner vokser, krymper og glir når de åpnes, lukkes og flyttes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Karty rosną, kurczą się i przesuwają przy otwieraniu, zamykaniu i przenoszeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As abas crescem, encolhem e deslizam ao abrir, fechar e mover."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вкладки растут, сжимаются и скользят при открытии, закрытии и перемещении."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "แท็บจะขยาย หด และเลื่อนเมื่อเปิด ปิด และย้าย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sekmeler açılırken, kapanırken ve taşınırken büyür, küçülür ve kayar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вкладки ростуть, стискаються й ковзають під час відкриття, закриття й переміщення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Thẻ phóng to, thu nhỏ và trượt khi mở, đóng và di chuyển."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "标签页在打开、关闭和移动时伸缩并滑动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "分頁在開啟、關閉和移動時伸縮並滑動。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
