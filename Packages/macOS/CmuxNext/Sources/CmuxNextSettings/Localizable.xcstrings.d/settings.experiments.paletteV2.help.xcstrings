      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجمّع النتائج ضمن مساحات العمل والجلسات والأوامر والوكلاء، وتعيد التجميع أثناء الكتابة، مع تحديد أفضل نتيجة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupiše rezultate pod Radni prostori, Sesije, Naredbe i Agenti, ponovo grupiše dok kucate, a najbolji rezultat je odabran."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupperer resultater under Arbejdsområder, Sessioner, Kommandoer og Agenter og omgrupperer, mens du skriver, med det bedste match valgt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gruppiert Ergebnisse unter Arbeitsbereiche, Sitzungen, Befehle und Agenten, gruppiert während der Eingabe neu und wählt den besten Treffer aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groups results under Workspaces, Sessions, Commands and Agents, regrouping as you type, with the top match selected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrupa los resultados en Espacios de trabajo, Sesiones, Comandos y Agentes, los reagrupa mientras escribes y selecciona la mejor coincidencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regroupe les résultats sous Espaces de travail, Sessions, Commandes et Agents, les regroupe à mesure que vous saisissez et sélectionne la meilleure correspondance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raggruppa i risultati in Spazi di lavoro, Sessioni, Comandi e Agenti, li raggruppa di nuovo mentre scrivi e seleziona la corrispondenza migliore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結果を「ワークスペース」「セッション」「コマンド」「エージェント」にグループ化し、入力に合わせて再グループ化して、最も一致するものを選択します。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ដាក់ក្រុមលទ្ធផលនៅក្រោមកន្លែងធ្វើការ វគ្គ ពាក្យបញ្ជា និងភ្នាក់ងារ ហើយដាក់ក្រុមឡើងវិញពេលអ្នកវាយ ដោយជ្រើសរើសលទ្ធផលដែលត្រូវគ្នាបំផុត។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "결과를 작업 공간, 세션, 명령, 에이전트별로 그룹화하고 입력하는 동안 다시 그룹화하며 가장 일치하는 항목을 선택합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupperer resultater under Arbeidsområder, Økter, Kommandoer og Agenter, omgrupperer mens du skriver, og velger det beste treffet."
          }
        },
        "pl" : {
          "stringUnit" : {
