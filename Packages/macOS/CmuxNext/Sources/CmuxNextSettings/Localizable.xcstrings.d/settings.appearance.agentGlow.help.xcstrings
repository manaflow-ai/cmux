        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calmo quando gli agenti sono inattivi; un leggero bagliore del colore della macchina quando un agente ha bisogno di te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントが待機中は落ち着いた表示に。エージェントが呼んでいるときは、マシンの色でやさしく光ります。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ស្ងប់ពេលភ្នាក់ងារទំនេរ ហើយភ្លឺស្រាលៗតាមពណ៌ម៉ាស៊ីន ពេលភ្នាក់ងារត្រូវការអ្នក។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트가 쉬는 동안은 차분하게, 에이전트가 당신을 필요로 하면 기기 색으로 은은하게 빛납니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rolig mens agenter er inaktive; en myk glød i maskinens farge når en agent trenger deg."
