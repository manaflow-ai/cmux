    "settings.appearance.agentGlow.help" : {
      "comment" : "Settings row help for React to Agents.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calm while agents are idle; a soft glow in the machine's color when an agent needs you."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هادئة ما دام الوكلاء خاملين، وتوهج خفيف بلون الجهاز عندما يحتاجك وكيل."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirno dok agenti miruju; blagi sjaj u boji mašine kada te agent treba."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roligt, mens agenter er inaktive; en blød glød i maskinens farve, når en agent har brug for dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruhig, solange Agenten untätig sind; ein sanftes Leuchten in der Farbe des Rechners, wenn ein Agent dich braucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En calma mientras los agentes están inactivos; un brillo suave del color de la máquina cuando un agente te necesita."
