{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.remoteDesktop.sharpLinuxText.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Linux machine without a GPU encoder codes its screen for sharp text instead of speed. Text reads clearer while it changes; typing and scrolling show a little later."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يرمّز جهاز Linux بلا مرمّز GPU شاشته لوضوح النص بدلاً من السرعة. يصبح النص أوضح أثناء تغيّره، ويظهر الكتابة والتمرير متأخرين قليلاً."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Linux računar bez GPU enkodera kodira ekran za oštar tekst umjesto za brzinu. Tekst je jasniji dok se mijenja; kucanje i pomicanje pojavljuju se malo kasnije."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En Linux-maskine uden GPU-encoder koder sin skærm til skarp tekst i stedet for hastighed. Tekst står tydeligere, mens den ændres; skrivning og rulning vises lidt senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein Linux-Rechner ohne GPU-Encoder kodiert seinen Bildschirm für scharfen Text statt für Tempo. Text liest sich klarer, während er sich ändert; Tippen und Scrollen erscheinen etwas später."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un equipo Linux sin codificador de GPU codifica su pantalla para texto nítido en lugar de velocidad. El texto se lee mejor mientras cambia; la escritura y el desplazamiento aparecen un poco más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une machine Linux sans encodeur GPU encode son écran pour un texte net plutôt que pour la vitesse. Le texte se lit mieux pendant qu’il change ; la saisie et le défilement s’affichent un peu plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una macchina Linux senza encoder GPU codifica lo schermo per un testo nitido invece che per la velocità. Il testo si legge meglio mentre cambia; digitazione e scorrimento appaiono un po’ dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "GPU エンコーダのない Linux マシンは、速度よりも文字の鮮明さを優先して画面をエンコードします。変化中の文字が読みやすくなる一方、入力やスクロールの表示が少し遅れます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ម៉ាស៊ីន Linux ដែលគ្មានកម្មវិធីអ៊ិនកូដ GPU នឹងអ៊ិនកូដអេក្រង់សម្រាប់អក្សរច្បាស់ ជំនួសឱ្យល្បឿន។ អក្សរអានបានច្បាស់ជាងពេលវាផ្លាស់ប្តូរ ការវាយ និងការរំកិលបង្ហាញយឺតបន្តិច។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "GPU 인코더가 없는 Linux 컴퓨터가 속도 대신 선명한 텍스트에 맞춰 화면을 인코딩합니다. 바뀌는 텍스트가 더 또렷해지고, 입력과 스크롤은 조금 늦게 보입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En Linux-maskin uten GPU-koder koder skjermen for skarp tekst i stedet for fart. Tekst er tydeligere mens den endres; skriving og rulling vises litt senere."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Komputer z Linuksem bez kodera GPU koduje ekran pod ostry tekst zamiast szybkości. Zmieniający się tekst czyta się wyraźniej; pisanie i przewijanie pojawiają się nieco później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uma máquina Linux sem codificador de GPU codifica a tela para texto nítido em vez de velocidade. O texto fica mais legível enquanto muda; a digitação e a rolagem aparecem um pouco depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Компьютер Linux без GPU-кодировщика кодирует экран ради чёткого текста, а не скорости. Меняющийся текст читается яснее; ввод и прокрутка появляются чуть позже."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "เครื่อง Linux ที่ไม่มีตัวเข้ารหัส GPU จะเข้ารหัสหน้าจอให้ข้อความคมชัดแทนความเร็ว ข้อความอ่านง่ายขึ้นขณะเปลี่ยน แต่การพิมพ์และการเลื่อนจะแสดงช้าลงเล็กน้อย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "GPU kodlayıcısı olmayan bir Linux makinesi ekranını hız yerine net metin için kodlar. Değişen metin daha net okunur; yazma ve kaydırma biraz daha geç görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Комп’ютер Linux без GPU-кодувальника кодує екран заради чіткого тексту, а не швидкості. Текст, що змінюється, читається ясніше; введення й прокручування з’являються трохи пізніше."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Máy Linux không có bộ mã hóa GPU sẽ mã hóa màn hình để chữ sắc nét thay vì tốc độ. Chữ dễ đọc hơn khi thay đổi; thao tác gõ và cuộn hiện ra chậm hơn một chút."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "没有 GPU 编码器的 Linux 机器会以文字清晰而非速度为先编码屏幕。变化中的文字更易读；输入和滚动会稍晚显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "沒有 GPU 編碼器的 Linux 機器會以文字清晰而非速度為先編碼螢幕。變化中的文字更易讀；輸入和捲動會稍晚顯示。"
          }
        }
      }
