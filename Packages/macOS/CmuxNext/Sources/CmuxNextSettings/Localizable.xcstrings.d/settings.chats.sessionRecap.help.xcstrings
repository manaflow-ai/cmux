        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una riga sul punto in cui si trova una chat di Claude quando torni. Ognuna è una piccola chiamata al modello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Claudeのチャットに戻ったとき、現在の状況を1行で表示します。まとめごとに小さなモデル呼び出しが1回かかります。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "មួយបន្ទាត់អំពីស្ថានភាពការជជែក Claude ពេលអ្នកត្រឡប់មកវិញ។ នីមួយៗជាការហៅម៉ូដែលតូចមួយ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Claude 채팅으로 돌아오면 현재 상황을 한 줄로 보여 줍니다. 요약마다 모델을 한 번 더 호출합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En linje om hvor en Claude-chat står når du kommer tilbake. Hver er et lite modellkall."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wiersz o tym, na czym stanął czat Claude, gdy do niego wracasz. Każdy to małe wywołanie modelu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uma linha sobre onde um chat do Claude está quando você volta. Cada uma é uma pequena chamada ao modelo."
