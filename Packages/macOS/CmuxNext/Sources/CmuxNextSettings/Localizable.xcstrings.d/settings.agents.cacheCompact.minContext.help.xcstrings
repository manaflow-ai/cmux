      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُترك المحادثات التي تستخدم أقل من هذه النسبة من نافذة السياق كما هي."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chatovi koji koriste manje konteksta od ovoga ostaju kakvi jesu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chats, der bruger mindre af kontekstvinduet end dette, lades være."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chats, die weniger ihres Kontextfensters nutzen, bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chats using less of their context window than this are left as they are."
          }
        },
