{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.appearance.toolbarButtonCornerRadius.help" : {
      "comment" : "Settings > Appearance: a look's layout and proportions (appearance.metrics)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The corner of an icon button's hover, pressed and active fill: 0 is square, half the button is round. Unset rounds as a tab does."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Ecke der Füllung einer Symboltaste beim Überfahren, Drücken und im aktiven Zustand: 0 ist eckig, die halbe Taste rund. Ohne Wert wie ein Tab gerundet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le coin du fond d’un bouton à icône au survol, à l’appui et actif : 0 est carré, la moitié du bouton est rond. Sans valeur, arrondi comme un onglet."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "زاوية تعبئة زر الأيقونة عند التمرير والضغط والتفعيل: 0 مربعة، ونصف الزر دائرية. بلا قيمة تُستدار كعلامة التبويب."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La esquina del relleno de un botón de icono al pasar, al pulsar y activo: 0 es cuadrada, la mitad del botón es redonda. Sin valor, se redondea como una pestaña."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "圖示按鈕在懸停、按下與作用中時填色的圓角：0 為方形，按鈕一半為圓形。未設定時與分頁相同。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "图标按钮在悬停、按下与活动时填充的圆角：0 为方形，按钮一半为圆形。未设置时与标签页相同。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "아이콘 버튼의 호버·누름·활성 채우기 모서리입니다. 0은 사각형, 버튼의 절반은 원형입니다. 설정하지 않으면 탭과 같이 둥급니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "アイコンボタンのホバー・押下・アクティブ時の塗りの角。0 は四角、ボタンの半分で円になります。未設定ならタブと同じ丸みです。"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ugao ispune dugmeta pri prelasku, pritisku i aktivnog stanja: 0 je kvadrat, pola dugmeta krug. Bez vrijednosti kao kartica."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hjørnet på en ikonknaps udfyldning ved hover, tryk og aktiv: 0 er firkantet, halvdelen af knappen rund. Uden værdi som en fane."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’angolo del riempimento di un pulsante al passaggio, alla pressione e attivo: 0 è quadrato, metà pulsante è tondo. Se non impostato, come una scheda."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ជ្រុងនៃផ្ទៃពណ៌ប៊ូតុងពេលដាក់ព្រួញ ចុច និងសកម្ម៖ 0 ជាការ៉េ ពាក់កណ្តាលប៊ូតុងជារង្វង់។ បើមិនកំណត់ ដូចផ្ទាំង។"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hjørnet på en ikonknapps fyll ved peker, trykk og aktiv: 0 er firkantet, halve knappen rund. Uten verdi som en fane."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Narożnik wypełnienia przycisku po najechaniu, naciśnięciu i w stanie aktywnym: 0 to kwadrat, połowa przycisku to koło. Bez wartości jak karta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O canto do preenchimento de um botão ao passar, pressionar e ativo: 0 é quadrado, metade do botão é redondo. Sem valor, como uma aba."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Скругление заливки кнопки при наведении, нажатии и в активном состоянии: 0 — квадрат, половина кнопки — круг. Без значения — как у вкладки."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "มุมของพื้นปุ่มเมื่อชี้ กด และเปิดใช้งาน: 0 คือสี่เหลี่ยม ครึ่งหนึ่งของปุ่มคือวงกลม หากไม่ตั้งค่า จะโค้งเหมือนแท็บ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Düğmenin üzerine gelme, basma ve etkin dolgusunun köşesi: 0 kare, düğmenin yarısı yuvarlak. Ayarlanmazsa sekme gibi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Заокруглення заливки кнопки при наведенні, натисканні та в активному стані: 0 — квадрат, половина кнопки — коло. Без значення — як у вкладки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Góc của phần tô nút khi di chuột, nhấn và đang bật: 0 là vuông, một nửa nút là tròn. Nếu không đặt, bo như thẻ."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
