      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The cmux app on your iPhone, signed in to the same account, can open this Mac's workspaces. You allow each new phone once."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لتطبيق cmux على iPhone المسجّل الدخول بالحساب نفسه فتح مساحات عمل هذا الـ Mac. تسمح لكل هاتف جديد مرة واحدة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija cmux na vašem iPhoneu, prijavljena na isti račun, može otvarati radne prostore ovog Maca. Svaki novi telefon dozvoljavate jednom."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux-appen på din iPhone, logget ind med samme konto, kan åbne denne Macs arbejdsområder. Du tillader hver ny telefon én gang."
          }
        },
