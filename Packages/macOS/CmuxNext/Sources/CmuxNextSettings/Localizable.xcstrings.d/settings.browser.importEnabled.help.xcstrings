        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "เสนอให้นำเข้าบุ๊กมาร์ก ประวัติ รหัสผ่าน และการลงชื่อเข้าใช้ เมื่อปิดจะซ่อนข้อเสนอ"
