{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.agents.appControl.help" : {
      "comment" : "Settings > Agents > cmux Tools: whether agents in cmux's terminals and agent chats may change the app or only read it (agents.appControl)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read Only: agents in cmux’s terminals and agent chats can read cmux but not change it: no new workspaces, tabs or panes, no typing into other terminals, no settings changes."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قراءة فقط: يمكن للوكلاء في طرفيات cmux ومحادثات الوكلاء قراءة cmux دون تغييره: لا مساحات عمل أو علامات تبويب أو أجزاء جديدة، ولا كتابة في طرفيات أخرى، ولا تغيير للإعدادات."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samo čitanje: agenti u terminalima i agent chatovima cmuxa mogu čitati cmux, ali ga ne mogu mijenjati: nema novih radnih prostora, kartica ni panela, nema kucanja u druge terminale, nema promjena postavki."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun læse: agenter i cmux’ terminaler og agentchats kan læse cmux, men ikke ændre det: ingen nye arbejdsområder, faner eller ruder, ingen indtastning i andre terminaler, ingen ændringer af indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur lesen: Agenten in den Terminals und Agent-Chats von cmux können cmux lesen, aber nicht ändern: keine neuen Arbeitsbereiche, Tabs oder Bereiche, keine Eingaben in andere Terminals, keine Änderungen an Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo lectura: los agentes en las terminales y los chats de agentes de cmux pueden leer cmux pero no cambiarlo: sin nuevos espacios de trabajo, pestañas ni paneles, sin escribir en otras terminales, sin cambios de ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lecture seule : les agents dans les terminaux et les chats d’agents de cmux peuvent lire cmux sans le modifier : pas de nouveaux espaces de travail, onglets ni volets, pas de saisie dans d’autres terminaux, pas de modification des réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sola lettura: gli agenti nei terminali e nelle chat degli agenti di cmux possono leggere cmux ma non modificarlo: niente nuovi spazi di lavoro, schede o riquadri, niente digitazione in altri terminali, nessuna modifica alle impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み取りのみ: cmux のターミナルとエージェントチャット内のエージェントは cmux を読み取れますが、変更はできません。新しいワークスペース、タブ、ペインの作成、他のターミナルへの入力、設定の変更はできません。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អានតែប៉ុណ្ណោះ៖ ភ្នាក់ងារក្នុងទែមីណាល់ និងការជជែកភ្នាក់ងាររបស់ cmux អាចអាន cmux ប៉ុន្តែមិនអាចផ្លាស់ប្តូរវាបានទេ៖ គ្មានកន្លែងធ្វើការ ផ្ទាំង ឬបន្ទះថ្មី គ្មានការវាយបញ្ចូលទៅទែមីណាល់ផ្សេង គ្មានការផ្លាស់ប្តូរការកំណត់។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "읽기 전용: cmux의 터미널과 에이전트 채팅에 있는 에이전트는 cmux를 읽을 수 있지만 변경할 수 없습니다. 새 작업 공간, 탭, 패널을 만들거나 다른 터미널에 입력하거나 설정을 바꿀 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare lese: agenter i cmux’ terminaler og agentchatter kan lese cmux, men ikke endre det: ingen nye arbeidsområder, faner eller ruter, ingen skriving i andre terminaler, ingen endringer i innstillinger."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko odczyt: agenci w terminalach i czatach agentów cmux mogą odczytywać cmux, ale nie mogą go zmieniać: żadnych nowych obszarów roboczych, kart ani paneli, żadnego pisania w innych terminalach, żadnych zmian ustawień."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente leitura: agentes nos terminais e chats de agentes do cmux podem ler o cmux, mas não alterá-lo: sem novos espaços de trabalho, abas ou painéis, sem digitar em outros terminais, sem alterar ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только чтение: агенты в терминалах и чатах агентов cmux могут читать cmux, но не изменять его: никаких новых рабочих пространств, вкладок и панелей, никакого ввода в другие терминалы, никаких изменений настроек."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านอย่างเดียว: เอเจนต์ในเทอร์มินัลและแชตเอเจนต์ของ cmux อ่าน cmux ได้แต่เปลี่ยนแปลงไม่ได้ ไม่มีพื้นที่ทำงาน แท็บ หรือบานหน้าต่างใหม่ ไม่มีการพิมพ์ลงเทอร์มินัลอื่น และไม่มีการเปลี่ยนการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salt okunur: cmux terminallerindeki ve ajan sohbetlerindeki ajanlar cmux'u okuyabilir ama değiştiremez: yeni çalışma alanı, sekme veya bölme yok, başka terminallere yazma yok, ayar değişikliği yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лише читання: агенти в терміналах і чатах агентів cmux можуть читати cmux, але не змінювати його: жодних нових робочих просторів, вкладок чи панелей, жодного введення в інші термінали, жодних змін налаштувань."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ đọc: tác nhân trong terminal và cuộc trò chuyện tác nhân của cmux có thể đọc cmux nhưng không thay đổi được: không tạo không gian làm việc, tab hay khung mới, không gõ vào terminal khác, không đổi cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只读：cmux 终端和代理聊天中的代理可以读取 cmux，但不能更改它：不能新建工作区、标签页或窗格，不能在其他终端中输入，不能更改设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "唯讀：cmux 終端機和代理聊天中的代理可以讀取 cmux，但不能變更它：不能新增工作區、分頁或窗格，不能在其他終端機中輸入，不能變更設定。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
