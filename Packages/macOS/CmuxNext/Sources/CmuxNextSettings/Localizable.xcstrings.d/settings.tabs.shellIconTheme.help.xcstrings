        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ម៉ាស៊ីន បង្ហាញផ្ទាំង Shell នីមួយៗជាមួយរូបតំណាងនៃម៉ាស៊ីនដែលវាដំណើរការលើ។"
