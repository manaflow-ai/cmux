        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يعرض خيار الأجهزة كل علامة تبويب طرفية بأيقونة الجهاز الذي تعمل عليه."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mašine prikazuju svaku karticu ljuske s ikonom mašine na kojoj radi."
