      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The quality a new Screen Sharing session starts at. The session's toolbar can still change it."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الجودة التي تبدأ بها جلسة مشاركة الشاشة الجديدة. يمكن لشريط أدوات الجلسة تغييرها."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kvalitet s kojim počinje nova sesija dijeljenja ekrana. Traka s alatima sesije ga i dalje može promijeniti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Den kvalitet, en ny skærmdelingssession starter med. Sessionens værktøjslinje kan stadig ændre den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Qualität, mit der eine neue Bildschirmfreigabe beginnt. Die Symbolleiste der Sitzung kann sie weiterhin ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La calidad con la que empieza una nueva sesión de pantalla compartida. La barra de herramientas de la sesión aún puede cambiarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La qualité de départ d’une nouvelle session de partage d’écran. La barre d’outils de la session peut toujours la modifier."
