        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La qualità con cui inizia una nuova sessione di condivisione schermo. La barra degli strumenti della sessione può ancora cambiarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "新しい画面共有セッションの開始時の画質です。セッションのツールバーで変更することもできます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "គុណភាពដែលវគ្គចែករំលែកអេក្រង់ថ្មីចាប់ផ្តើម។ របារឧបករណ៍របស់វគ្គនៅតែអាចប្តូរវាបាន។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "새 화면 공유 세션이 시작될 때의 품질입니다. 세션 도구 막대에서 계속 변경할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kvaliteten en ny skjermdelingsøkt starter med. Øktens verktøylinje kan fortsatt endre den."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jakość, z jaką zaczyna się nowa sesja udostępniania ekranu. Pasek narzędzi sesji nadal może ją zmienić."
