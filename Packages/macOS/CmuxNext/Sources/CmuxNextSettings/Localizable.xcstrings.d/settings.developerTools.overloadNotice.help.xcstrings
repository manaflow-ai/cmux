{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.developerTools.overloadNotice.help" : {
      "comment" : "Settings > Advanced > Developer Tools: help under the Overload Warning in Chats toggle",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض شريطًا فوق مربع الكتابة عندما يكون الحمل أو التبديل على هذا الـ Mac مرتفعًا جدًا."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikazuje traku iznad polja za pisanje kada je opterećenje ili swap ovog Maca previsok."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser et banner over skrivefeltet, når denne Macs belastning eller swap er for høj."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt über dem Eingabefeld ein Banner, wenn Last oder Swap dieses Mac zu hoch sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows a banner above the composer when this Mac's load or swap is too high."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra un banner sobre el redactor cuando la carga o el swap de este Mac son demasiado altos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche une bannière au-dessus de la zone de saisie quand la charge ou le swap de ce Mac est trop élevé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra un banner sopra il compositore quando il carico o lo swap di questo Mac è troppo alto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac の負荷やスワップが高すぎるとき、入力欄の上にバナーを表示します。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "បង្ហាញបដាពីលើប្រអប់សរសេរ នៅពេលបន្ទុក ឬ swap របស់ Mac នេះខ្ពស់ពេក។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac의 부하나 스왑이 너무 높을 때 입력창 위에 배너를 표시합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser et banner over skrivefeltet når belastningen eller swap på denne Macen er for høy."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje baner nad polem wiadomości, gdy obciążenie lub swap tego Maca są zbyt wysokie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra um banner acima do compositor quando a carga ou o swap deste Mac estão altos demais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает баннер над полем ввода, когда нагрузка или подкачка этого Mac слишком высоки."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงแบนเนอร์เหนือช่องพิมพ์เมื่อโหลดหรือ swap ของ Mac เครื่องนี้สูงเกินไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Mac'in yükü veya takas alanı çok yüksek olduğunda yazma alanının üstünde bir başlık gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує банер над полем введення, коли навантаження або підкачка цього Mac надто високі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiện biểu ngữ phía trên ô soạn thảo khi tải hoặc swap của máy Mac này quá cao."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当此 Mac 的负载或交换空间过高时，在输入框上方显示横幅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當此 Mac 的負載或交換空間過高時，在輸入框上方顯示橫幅。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
