      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sources shows Add Folder, and a folder an agent asks for joins its chat. Copies are read-only; secret files never go."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تعرض المصادر «إضافة مجلد»، وينضم المجلد الذي يطلبه الوكيل إلى دردشته. النسخ للقراءة فقط؛ ولا تُرسل الملفات السرية أبدًا."
          }
        },
        "bs" : {
