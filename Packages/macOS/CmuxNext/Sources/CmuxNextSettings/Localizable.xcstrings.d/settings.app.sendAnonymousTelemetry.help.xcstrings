{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.app.sendAnonymousTelemetry.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends cmux crash reports and anonymous usage events, so we can fix crashes and see which features are used. Stacks, app and macOS versions and event names only, never your prompts, files, paths, branches or text. Crash reports start at the next launch."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يرسل إلى cmux تقارير الأعطال وأحداث استخدام مجهولة الهوية، لنصلح الأعطال ونعرف الميزات المستخدمة. مكدسات الاستدعاء وإصدارات التطبيق وmacOS وأسماء الأحداث فقط، ولا يرسل أبدًا مطالباتك أو ملفاتك أو مساراتك أو فروعك أو نصوصك. تبدأ تقارير الأعطال عند التشغيل التالي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sendet cmux Absturzberichte und anonyme Nutzungsereignisse, damit wir Abstürze beheben und sehen, welche Funktionen genutzt werden. Nur Stacks, App- und macOS-Versionen und Ereignisnamen, nie deine Prompts, Dateien, Pfade, Branches oder Texte. Absturzberichte beginnen beim nächsten Start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envía a cmux informes de errores y eventos de uso anónimos, para corregir fallos y ver qué funciones se usan. Solo pilas, versiones de la app y de macOS y nombres de eventos, nunca tus prompts, archivos, rutas, ramas ni texto. Los informes de errores empiezan en el siguiente inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envoie à cmux des rapports de plantage et des événements d'utilisation anonymes, pour corriger les plantages et voir quelles fonctions servent. Uniquement des piles, les versions de l'app et de macOS et des noms d'événements, jamais vos prompts, fichiers, chemins, branches ou textes. Les rapports de plantage commencent au prochain lancement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "クラッシュレポートと匿名の利用イベントを cmux に送信し、クラッシュの修正と使われている機能の把握に役立てます。送るのはスタック、アプリと macOS のバージョン、イベント名だけで、プロンプト、ファイル、パス、ブランチ、テキストは送りません。クラッシュレポートは次回の起動から始まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "충돌 보고서와 익명 사용 이벤트를 cmux에 보내 충돌을 고치고 어떤 기능이 쓰이는지 파악합니다. 스택, 앱 및 macOS 버전, 이벤트 이름만 보내며 프롬프트, 파일, 경로, 브랜치, 텍스트는 절대 보내지 않습니다. 충돌 보고서는 다음 실행부터 시작됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "向 cmux 发送崩溃报告和匿名使用事件，帮助我们修复崩溃并了解哪些功能被使用。只发送调用栈、应用和 macOS 版本以及事件名称，绝不发送你的提示词、文件、路径、分支或文本。崩溃报告从下次启动开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "向 cmux 傳送當機報告和匿名使用事件，幫助我們修正當機並了解哪些功能被使用。只傳送呼叫堆疊、App 和 macOS 版本以及事件名稱，絕不傳送你的提示詞、檔案、路徑、分支或文字。當機報告從下次啟動開始。"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Šalje cmuxu izvještaje o padovima i anonimne događaje korištenja, da popravimo padove i vidimo koje se funkcije koriste. Samo stekovi, verzije aplikacije i macOS-a i nazivi događaja, nikad tvoji promptovi, datoteke, putanje, grane ili tekst. Izvještaji o padovima počinju pri sljedećem pokretanju."
