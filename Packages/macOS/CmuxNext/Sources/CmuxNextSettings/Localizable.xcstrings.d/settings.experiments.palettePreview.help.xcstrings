{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.experiments.palettePreview.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعرض تفاصيل مساحة العمل أو الجلسة المحددة بجانب النتائج، مع إجراءها الأساسي وإجراءات ⌘K في الأسفل."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikazuje detalje odabranog radnog prostora ili sesije pored rezultata, s njegovom glavnom radnjom i Radnje ⌘K na dnu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser detaljerne for det valgte arbejdsområde eller den valgte session ved siden af resultaterne, med den primære handling og Handlinger ⌘K nederst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt die Details des ausgewählten Arbeitsbereichs oder der ausgewählten Sitzung neben den Ergebnissen an, mit der Hauptaktion und „Aktionen ⌘K“ am unteren Rand."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the selected workspace or session's details beside the results, with its primary action and Actions ⌘K at the bottom."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra los detalles del espacio de trabajo o la sesión seleccionados junto a los resultados, con su acción principal y Acciones ⌘K en la parte inferior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche les détails de l’espace de travail ou de la session sélectionnés à côté des résultats, avec son action principale et Actions ⌘K en bas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra i dettagli dello spazio di lavoro o della sessione selezionati accanto ai risultati, con la relativa azione principale e Azioni ⌘K in basso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したワークスペースまたはセッションの詳細を結果の横に表示し、下部にその主要なアクションと「アクション ⌘K」を表示します。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "បង្ហាញព័ត៌មានលម្អិតនៃកន្លែងធ្វើការ ឬវគ្គដែលបានជ្រើសរើសនៅជាប់លទ្ធផល ជាមួយសកម្មភាពចម្បងរបស់វា និងសកម្មភាព ⌘K នៅខាងក្រោម។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 작업 공간 또는 세션의 세부 정보를 결과 옆에 표시하고, 하단에 기본 동작과 동작 ⌘K를 표시합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser detaljene for det valgte arbeidsområdet eller den valgte økten ved siden av resultatene, med hovedhandlingen og Handlinger ⌘K nederst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje szczegóły wybranego obszaru roboczego lub sesji obok wyników, wraz z jego główną akcją i Akcje ⌘K u dołu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra os detalhes do espaço de trabalho ou da sessão selecionados ao lado dos resultados, com a ação principal e Ações ⌘K na parte inferior."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает сведения о выбранном рабочем пространстве или сеансе рядом с результатами, а внизу — его основное действие и «Действия ⌘K»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงรายละเอียดของพื้นที่ทำงานหรือเซสชันที่เลือกไว้ข้างผลลัพธ์ พร้อมการทำงานหลักและการทำงาน ⌘K ที่ด้านล่าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçili çalışma alanının veya oturumun ayrıntılarını sonuçların yanında, altta ise birincil eylemini ve Eylemler ⌘K öğesini gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує відомості про вибраний робочий простір або сеанс поруч із результатами, а внизу — його основну дію та «Дії ⌘K»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị chi tiết của không gian làm việc hoặc phiên đã chọn bên cạnh kết quả, cùng hành động chính và Hành động ⌘K ở dưới cùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在结果旁显示所选工作区或会话的详细信息，并在底部显示其主要操作和“操作 ⌘K”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在結果旁顯示所選工作區或工作階段的詳細資訊，並在底部顯示其主要動作和「動作 ⌘K」。"
          }
        }
      }
    }
  },
  "version" : "1.0"
