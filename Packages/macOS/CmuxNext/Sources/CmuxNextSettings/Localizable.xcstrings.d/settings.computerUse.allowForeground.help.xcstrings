        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "កម្រិតខ្ពស់។ ភ្នាក់ងារអាចនាំកម្មវិធីមកខាងមុខ និងផ្លាស់ទីព្រួញរបស់អ្នក នៅពេលវាមិនទទួលការបញ្ចូលនៅផ្ទៃខាងក្រោយ។"
