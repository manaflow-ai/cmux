      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advanced. Agents may bring an app to the front and move your pointer when it takes no background input."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متقدّم. يمكن للوكلاء إحضار تطبيق إلى المقدمة وتحريك مؤشرك عندما لا يقبل التطبيق الإدخال في الخلفية."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napredno. Agenti smiju dovesti aplikaciju u prvi plan i pomjeriti vaš pokazivač kada ona ne prima unos u pozadini."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avanceret. Agenter må bringe en app i forgrunden og flytte din markør, når den ikke tager imod input i baggrunden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erweitert. Agenten dürfen eine App in den Vordergrund holen und deinen Zeiger bewegen, wenn sie keine Eingaben im Hintergrund annimmt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avanzado. Los agentes pueden traer una app al frente y mover tu puntero cuando no acepta entrada en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avancé. Les agents peuvent mettre une app au premier plan et déplacer votre pointeur quand elle n’accepte pas la saisie en arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avanzato. Gli agenti possono portare un’app in primo piano e spostare il puntatore quando non accetta input in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "詳細設定。バックグラウンドで入力を受け付けないアプリでは、エージェントがアプリを前面に出してポインタを動かせます。"
