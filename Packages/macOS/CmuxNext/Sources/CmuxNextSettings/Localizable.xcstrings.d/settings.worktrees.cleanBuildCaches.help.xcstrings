{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.worktrees.cleanBuildCaches.help" : {
      "comment" : "Settings > General > Storage: help for the Clean Up Build Caches toggle. Xcode DerivedData is a product folder name and stays as is; package caches are those of package managers.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Also remove this Mac's build caches nobody used lately, such as Xcode DerivedData. Package caches go only when the disk is nearly full."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يزيل أيضًا ذاكرات البناء المؤقتة على هذا الـ Mac التي لم يستخدمها أحد مؤخرًا، مثل Xcode DerivedData. لا تُزال ذاكرات الحزم المؤقتة إلا عندما يكاد القرص يمتلئ."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uklanja i keš builda na ovom Macu koji niko nije nedavno koristio, kao što je Xcode DerivedData. Keš paketa se uklanja samo kad je disk skoro pun."
          }
        },
        "da" : {
