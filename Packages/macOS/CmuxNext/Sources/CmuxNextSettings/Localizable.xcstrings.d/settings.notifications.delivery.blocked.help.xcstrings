{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.notifications.delivery.blocked.help" : {
      "comment" : "Settings > Notifications > Delivery: help under the Agent Blocked row",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When an agent's status turns Blocked without its own approval or question alert, as screen detection and plugins report it."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما تصبح حالة الوكيل محظورة دون تنبيه موافقة أو سؤال خاص به، كما يبلغ عنها اكتشاف الشاشة والإضافات."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kada status agenta postane Blokiran bez vlastitog upozorenja o odobrenju ili pitanju, kako to javljaju detekcija ekrana i dodaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når en agents status bliver Blokeret uden sin egen godkendelses- eller spørgsmålsadvarsel, som skærmgenkendelse og plugins rapporterer det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn der Status eines Agenten ohne eigene Freigabe- oder Fragemeldung zu „Blockiert“ wechselt, wie Bildschirmerkennung und Plugins es melden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando el estado de un agente pasa a Bloqueado sin su propia alerta de aprobación o pregunta, según lo informan la detección de pantalla y los plugins."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand le statut d’un agent passe à Bloqué sans sa propre alerte d’approbation ou de question, tel que le signalent la détection d’écran et les plugins."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando lo stato di un agente diventa Bloccato senza un proprio avviso di approvazione o domanda, come lo segnalano il rilevamento dello schermo e i plugin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "承認や質問の通知を伴わずにエージェントの状態がブロック中になったとき（画面検出やプラグインが報告するもの）。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "នៅពេលស្ថានភាពភ្នាក់ងារប្តូរទៅជាត្រូវបានរារាំង ដោយគ្មានការជូនដំណឹងអនុម័ត ឬសំណួររបស់វាផ្ទាល់ ដូចដែលការរកឃើញអេក្រង់ និងកម្មវិធីជំនួយរាយការណ៍។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "승인이나 질문 알림 없이 에이전트 상태가 차단됨으로 바뀔 때(화면 감지와 플러그인이 보고하는 경우)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når en agents status blir Blokkert uten egen godkjennings- eller spørsmålsvarsel, slik skjermgjenkjenning og programtillegg rapporterer det."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy stan agenta zmienia się na Zablokowany bez własnego alertu o zatwierdzeniu lub pytaniu, tak jak zgłaszają to wykrywanie ekranu i wtyczki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o status de um agente muda para Bloqueado sem o próprio alerta de aprovação ou pergunta, como a detecção de tela e os plugins informam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда статус агента становится «Заблокирован» без собственного уведомления об одобрении или вопросе, как сообщают распознавание экрана и плагины."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อสถานะของเอเจนต์เปลี่ยนเป็นถูกบล็อกโดยไม่มีการแจ้งเตือนการอนุมัติหรือคำถามของตัวเอง ตามที่การตรวจจับหน้าจอและปลั๊กอินรายงาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir ajanın durumu kendi onay veya soru uyarısı olmadan Engellendi olduğunda; ekran algılama ve eklentilerin bildirdiği şekilde."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли статус агента стає «Заблоковано» без власного сповіщення про схвалення чи запитання, як повідомляють розпізнавання екрана й плагіни."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi trạng thái của tác tử chuyển sang Bị chặn mà không có cảnh báo phê duyệt hoặc câu hỏi riêng, như phát hiện màn hình và plugin báo cáo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当智能体状态变为被阻塞且没有自身的批准或提问提醒时（由屏幕检测和插件报告）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當代理程式狀態變為被阻擋且沒有其自身的核准或提問提醒時（由螢幕偵測與外掛程式回報）。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
