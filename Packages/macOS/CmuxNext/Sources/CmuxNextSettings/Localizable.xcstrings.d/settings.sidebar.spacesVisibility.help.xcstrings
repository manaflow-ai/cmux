        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ពេលដាក់ទស្សន៍ទ្រនិច លាក់ចន្លោះជាមួយការគ្រប់គ្រងរបារចំហៀងផ្សេងទៀត។"
