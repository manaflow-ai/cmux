{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.statusIndicator.iconSet.help" : {
      "comment" : "Settings > Appearance > Loading Indicator: help under the Status Icons row.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The marks for agent working, blocked, done and error on sidebar rows, tabs and badges."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العلامات التي تُظهر أن الوكيل يعمل أو محظور أو انتهى أو حدث خطأ، في صفوف الشريط الجانبي وعلامات التبويب والشارات."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznake za agenta koji radi, je blokiran, je završio ili ima grešku na redovima bočne trake, karticama i značkama."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mærkerne for en agent, der arbejder, er blokeret, er færdig eller har en fejl, på sidepanelets rækker, faner og mærker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Markierungen für einen Agenten, der arbeitet, blockiert ist, fertig ist oder einen Fehler hat, in Seitenleistenzeilen, Tabs und Abzeichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las marcas de un agente trabajando, bloqueado, terminado o con error en las filas de la barra lateral, las pestañas y los distintivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les marques d’un agent au travail, bloqué, terminé ou en erreur sur les lignes de la barre latérale, les onglets et les pastilles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I segni per un agente al lavoro, bloccato, completato o in errore nelle righe della barra laterale, nelle schede e nei badge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイドバーの行、タブ、バッジに表示する、エージェントの作業中・ブロック中・完了・エラーのマーク。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "សញ្ញាសម្រាប់ភ្នាក់ងារកំពុងធ្វើការ ត្រូវបានរារាំង រួចរាល់ និងមានកំហុស នៅលើជួររបារចំហៀង ផ្ទាំង និងស្លាក។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사이드바 행, 탭, 배지에 표시되는 에이전트의 작업 중, 차단됨, 완료, 오류 표시입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merkene for en agent som arbeider, er blokkert, er ferdig eller har en feil, på sidefeltets rader, faner og merker."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznaczenia agenta, który pracuje, jest zablokowany, skończył lub ma błąd, w wierszach paska bocznego, kartach i plakietkach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As marcas de um agente trabalhando, bloqueado, concluído ou com erro nas linhas da barra lateral, nas abas e nos selos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значки агента, который работает, заблокирован, завершил работу или столкнулся с ошибкой, в строках боковой панели, на вкладках и в метках."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เครื่องหมายสำหรับเอเจนต์ที่กำลังทำงาน ถูกบล็อก เสร็จแล้ว หรือมีข้อผิดพลาด บนแถวของแถบด้านข้าง แท็บ และป้าย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kenar çubuğu satırlarında, sekmelerde ve rozetlerde ajanın çalıştığını, engellendiğini, bittiğini veya hata verdiğini gösteren işaretler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позначки агента, який працює, заблокований, завершив роботу або має помилку, у рядках бічної панелі, на вкладках і в значках."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các dấu cho tác tử đang làm việc, bị chặn, đã xong và gặp lỗi trên các hàng thanh bên, thẻ và huy hiệu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "侧边栏行、标签页和徽章上表示代理工作中、被阻止、已完成和出错的标记。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "側邊欄列、分頁和徽章上表示代理工作中、被封鎖、已完成和出錯的標記。"
          }
        }
      }
    }
  },
  "version" : "1.0"
