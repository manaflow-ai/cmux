        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir süre etkinlik olmayan sohbetleri arşivler. Çalışan veya arka planda işi olan sohbetler asla arşivlenmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Архівує чати після періоду без активності. Запущені чати та чати з фоновою роботою не архівуються."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu trữ cuộc trò chuyện sau một thời gian không hoạt động. Cuộc trò chuyện đang chạy hoặc có việc nền thì không bao giờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在一段时间无活动后归档聊天。正在运行或有后台任务的聊天不会被归档。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在一段時間無活動後封存聊天。正在執行或有背景工作的聊天不會被封存。"
