{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.chats.archiveInactive.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archives chats after a period of no activity. Chats that are running or have background work never are."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤرشف الدردشات بعد فترة من عدم النشاط. لا تُؤرشف أبدًا الدردشات قيد التشغيل أو التي لديها عمل في الخلفية."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arhivira razgovore nakon perioda bez aktivnosti. Razgovori koji rade ili imaju posao u pozadini nikad se ne arhiviraju."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkiverer chats efter en periode uden aktivitet. Chats, der kører eller har baggrundsarbejde, arkiveres aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiviert Chats nach einer Zeit ohne Aktivität. Chats, die laufen oder Hintergrundarbeit haben, nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiva los chats tras un periodo sin actividad. Los chats en ejecución o con trabajo en segundo plano nunca se archivan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archive les discussions après une période sans activité. Les discussions en cours ou avec un travail en arrière-plan ne le sont jamais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivia le chat dopo un periodo senza attività. Le chat in esecuzione o con lavoro in background non vengono mai archiviate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一定期間アクティビティのないチャットをアーカイブします。実行中またはバックグラウンド処理のあるチャットはアーカイブされません。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ទុកការជជែកក្នុងបណ្ណសារបន្ទាប់ពីរយៈពេលគ្មានសកម្មភាព។ ការជជែកដែលកំពុងដំណើរការ ឬមានការងារផ្ទៃខាងក្រោយ មិនដែលត្រូវបានទុកទេ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일정 기간 활동이 없는 채팅을 보관합니다. 실행 중이거나 백그라운드 작업이 있는 채팅은 보관하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkiverer chatter etter en periode uten aktivitet. Chatter som kjører eller har bakgrunnsarbeid, arkiveres aldri."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiwizuje czaty po okresie bez aktywności. Czaty, które działają lub mają pracę w tle, nigdy nie są archiwizowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquiva conversas após um período sem atividade. Conversas em execução ou com trabalho em segundo plano nunca são arquivadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Архивирует чаты после периода без активности. Запущенные чаты и чаты с фоновой работой не архивируются."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เก็บถาวรแชทหลังจากไม่มีความเคลื่อนไหวช่วงหนึ่ง แชทที่กำลังทำงานหรือมีงานเบื้องหลังจะไม่ถูกเก็บถาวร"
