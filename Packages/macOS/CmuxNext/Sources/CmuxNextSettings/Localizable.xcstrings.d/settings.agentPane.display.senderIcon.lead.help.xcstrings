{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.agentPane.display.senderIcon.lead.help" : {
      "comment" : "Settings: the agent chat's sender icon rows",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Which is big in a sender's icon: the model's mark or the session badge."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أيّهما يكون كبيرًا في أيقونة المرسل: شعار النموذج أم شارة الجلسة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Šta je veliko u ikoni pošiljaoca: oznaka modela ili značka sesije."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hvad der er stort i en afsenders ikon: modellens mærke eller sessionens badge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Was im Absendersymbol groß ist: das Zeichen des Modells oder das Abzeichen der Sitzung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Qué es grande en el icono del remitente: la marca del modelo o la insignia de la sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ce qui est grand dans l’icône de l’expéditeur : la marque du modèle ou le badge de la session."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cosa è grande nell’icona del mittente: il marchio del modello o il badge della sessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "送信者アイコンで大きく表示するもの：モデルのマーク、またはセッションのバッジ。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "អ្វីដែលធំនៅក្នុងរូបតំណាងអ្នកផ្ញើ៖ សញ្ញាម៉ូដែល ឬផ្លាកវគ្គ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "발신자 아이콘에서 크게 표시할 것: 모델의 마크 또는 세션 배지."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hva som er stort i et avsenderikon: modellens merke eller øktens merke."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Co jest duże w ikonie nadawcy: znak modelu czy plakietka sesji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O que é grande no ícone do remetente: a marca do modelo ou o selo da sessão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Что крупнее в значке отправителя: знак модели или значок сеанса."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "สิ่งที่ใหญ่ในไอคอนผู้ส่ง: เครื่องหมายของโมเดล หรือป้ายของเซสชัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gönderen simgesinde büyük olan: modelin işareti veya oturum rozeti."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Що більше в значку відправника: знак моделі чи значок сеансу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Phần lớn trong biểu tượng người gửi: dấu của mô hình hoặc huy hiệu của phiên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "发送者图标中较大的部分：模型的标志或会话徽章。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "傳送者圖示中較大的部分：模型的標誌或工作階段徽章。"
          }
        }
      }
    }
  },
  "version" : "1.0"
