{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.home.chiefPanelStyle.help" : {
      "comment" : "Settings > Chief > Chief Dock: help for the floating Chief style.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How the Chief looks floating over a workspace. Drag any style by its grip."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "شكل Chief عندما يطفو فوق مساحة عمل. اسحب أي نمط من مقبضه."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kako Chief izgleda kad lebdi iznad radnog prostora. Svaki stil povuci za njegovu ručku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hvordan Chief ser ud, når den svæver over et arbejdsområde. Træk enhver stil i dens håndtag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "So sieht der Chief aus, wenn er über einem Arbeitsbereich schwebt. Ziehe jeden Stil an seinem Griff."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cómo se ve Chief flotando sobre un espacio de trabajo. Arrastra cualquier estilo por su asa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’apparence de Chief flottant au-dessus d’un espace de travail. Faites glisser chaque style par sa poignée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Come appare Chief sopra uno spazio di lavoro. Trascina ogni stile dalla sua maniglia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ワークスペースの上にフローティング表示するときの Chief の見た目。どのスタイルもグリップでドラッグできます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "របៀបដែល Chief មើលទៅ ពេលអណ្ដែតលើកន្លែងធ្វើការ។ អូសរចនាប័ទ្មណាមួយតាមកន្លែងចាប់របស់វា។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "작업 공간 위에 떠 있는 Chief의 모양입니다. 모든 스타일은 손잡이로 끌어 옮깁니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hvordan Chief ser ut når den svever over et arbeidsområde. Dra enhver stil i håndtaket."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jak wygląda Chief unoszący się nad obszarem roboczym. Każdy styl przeciągnij za uchwyt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Como o Chief aparece flutuando sobre um espaço de trabalho. Arraste qualquer estilo pela alça."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Как выглядит Chief поверх рабочего пространства. Любой стиль перетаскивается за ручку."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ลักษณะของ Chief เมื่อลอยอยู่เหนือพื้นที่ทำงาน ลากทุกรูปแบบได้ด้วยที่จับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief'in bir çalışma alanının üzerinde serbestken görünümü. Her stili tutamacından sürükleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Як виглядає Chief, що плаває над робочим простором. Будь-який стиль перетягуйте за ручку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Giao diện của Chief khi nổi trên không gian làm việc. Kéo mọi kiểu bằng tay nắm của nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief 浮在工作区上方时的样子。任何样式都可以拖动其手柄。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief 浮在工作區上方時的樣子。任何樣式都可以拖動其把手。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
