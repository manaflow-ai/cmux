{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.labs.customizeFromTheApp.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مع الاستمرار على Option فوق جزء من النافذة لترى ما يغيّره، وانقر بزر الماوس الأيمن عليه لاختيار تخصيص…. أوقف هذا لإخفاء الاثنين."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Držite Option iznad dijela prozora da vidite šta ga mijenja, i kliknite desnim klikom za Prilagodi…. Isključite ovo da sakrijete oboje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold Option over en del af vinduet for at se, hvad der ændrer den, og højreklik på den for Tilpas…. Slå dette fra for at skjule begge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte Wahl über einem Teil des Fensters, um zu sehen, was ihn ändert, und klicke mit der rechten Maustaste für Anpassen…. Schalte dies aus, um beides auszublenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold Option over a part of the window to see what changes it, and right-click it for Customize…. Turn this off to hide both."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén Opción sobre una parte de la ventana para ver qué la cambia y haz clic derecho para Personalizar…. Desactívalo para ocultar ambos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez Option sur une partie de la fenêtre pour voir ce qui la modifie, et faites un clic droit pour Personnaliser…. Désactivez ceci pour masquer les deux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto Opzione su una parte della finestra per vedere cosa la cambia e fai clic destro per Personalizza…. Disattiva per nascondere entrambi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウの一部の上で Option を押し続けると、それを変える設定が表示されます。右クリックで「カスタマイズ…」も使えます。オフにすると両方とも表示されません。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ចុច Option លើផ្នែកមួយនៃបង្អួច ដើម្បីមើលអ្វីដែលផ្លាស់ប្ដូរវា ហើយចុចកណ្ដុរស្ដាំសម្រាប់ ប្ដូរតាមបំណង…។ បិទវា ដើម្បីលាក់ទាំងពីរ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "창의 한 부분 위에서 Option을 누르고 있으면 무엇이 그것을 바꾸는지 보이고, 오른쪽 클릭하면 사용자화…가 나옵니다. 끄면 둘 다 숨겨집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold Tilvalg over en del av vinduet for å se hva som endrer den, og høyreklikk for Tilpass…. Slå av for å skjule begge."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj Option nad częścią okna, aby zobaczyć, co ją zmienia, i kliknij prawym przyciskiem, aby wybrać Dostosuj…. Wyłącz, aby ukryć oba."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure Option sobre uma parte da janela para ver o que a altera e clique com o botão direito para Personalizar…. Desative para ocultar ambos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте Option над частью окна, чтобы увидеть, что её меняет, и нажмите правой кнопкой для «Настроить…». Выключите, чтобы скрыть и то и другое."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กด Option ค้างไว้เหนือส่วนหนึ่งของหน้าต่างเพื่อดูว่าอะไรเปลี่ยนส่วนนั้น และคลิกขวาเพื่อเลือก ปรับแต่ง… ปิดตัวเลือกนี้เพื่อซ่อนทั้งสองอย่าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neyin değiştirdiğini görmek için pencerenin bir bölümü üzerinde Option tuşunu basılı tutun ve Özelleştir… için sağ tıklayın. İkisini de gizlemek için kapatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утримуйте Option над частиною вікна, щоб побачити, що її змінює, і клацніть правою кнопкою для «Налаштувати…». Вимкніть, щоб сховати обидва."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ Option trên một phần của cửa sổ để xem điều gì thay đổi nó, và nhấp chuột phải để chọn Tùy chỉnh…. Tắt để ẩn cả hai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在窗口的某个部分上按住 Option 可查看改变它的设置，右键点按可选择“自定义…”。关闭此项即可隐藏两者。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在視窗的某個部分上按住 Option 可查看改變它的設定，按右鍵可選擇「自訂…」。關閉此項即可隱藏兩者。"
          }
        }
      }
    }
  },
  "version" : "1.0"
