        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Стискає неактивний чат Claude, поки кеш активний, щоб наступне повідомлення коштувало менше."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nén cuộc trò chuyện Claude đang rảnh khi bộ nhớ đệm còn ấm, để tin nhắn tiếp theo tốn ít hơn."
          }
        },
        "zh-Hans" : {
