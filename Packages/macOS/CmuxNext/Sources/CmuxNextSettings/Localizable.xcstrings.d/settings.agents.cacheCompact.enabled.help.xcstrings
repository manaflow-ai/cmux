{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.agents.cacheCompact.enabled.help" : {
      "comment" : "Settings > General > Prompt Cache: help under the compact-before-expiry toggle; names its cost",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يضغط محادثة Claude الخاملة بينما لا تزال ذاكرة التخزين المؤقت دافئة، فتكلّف الرسالة التالية أقل."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sažima neaktivan Claude chat dok je keš topao, da sljedeća poruka košta manje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Komprimerer en inaktiv Claude-chat, mens cachen er varm, så næste besked koster mindre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Komprimiert einen ruhenden Claude-Chat, solange sein Cache warm ist, damit die nächste Nachricht weniger kostet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compacts an idle Claude chat while its cache is warm, so the next message costs less."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Compacta un chat de Claude inactivo mientras su caché sigue activa, para que el siguiente mensaje cueste menos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Compacte un chat Claude inactif tant que son cache est actif, pour que le message suivant coûte moins."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Compatta una chat di Claude inattiva mentre la cache è ancora attiva, così il messaggio successivo costa meno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "アイドル状態の Claude チャットをキャッシュが有効なうちに圧縮し、次のメッセージのコストを抑えます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "បង្រួមការជជែក Claude ដែលទំនេរ ខណៈឃ្លាំងសម្ងាត់នៅក្តៅ ដូច្នេះសារបន្ទាប់ចំណាយតិចជាង។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "유휴 Claude 채팅을 캐시가 유지되는 동안 압축해 다음 메시지 비용을 줄입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Komprimerer en inaktiv Claude-chat mens hurtigbufferen er varm, så neste melding koster mindre."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kompaktuje bezczynny czat Claude, póki pamięć podręczna jest aktywna, aby następna wiadomość kosztowała mniej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Compacta um chat ocioso do Claude enquanto o cache está ativo, para que a próxima mensagem custe menos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сжимает простаивающий чат Claude, пока кэш активен, чтобы следующее сообщение стоило меньше."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "บีบอัดแชต Claude ที่ว่างขณะที่แคชยังอุ่นอยู่ เพื่อให้ข้อความถัดไปมีค่าใช้จ่ายน้อยลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Boştaki bir Claude sohbetini önbelleği sıcakken sıkıştırır; böylece sonraki mesaj daha ucuza gelir."
