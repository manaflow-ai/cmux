      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A short turn shows a one-line summary of what it did, instead of folding under Worked for."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يعرض الدور القصير ملخصًا من سطر واحد لما فعله، بدلًا من طيّه تحت ‏Worked for."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kratki potez prikazuje sažetak u jednom redu umjesto da se sklopi pod Worked for."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En kort tur viser et resumé på én linje af, hvad den gjorde, i stedet for at blive foldet under Worked for."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine kurze Runde zeigt eine einzeilige Zusammenfassung dessen, was sie getan hat, statt unter „Worked for“ eingeklappt zu werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un turno corto muestra un resumen de una línea de lo que hizo, en lugar de plegarse bajo Worked for."
