        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Короткий хід показує однорядкове зведення того, що він зробив, замість згортання під «Працював»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lượt ngắn hiển thị tóm tắt một dòng về những gì nó đã làm, thay vì thu gọn dưới Đã làm việc trong."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "简短回合会用一行摘要显示它做了什么，而不是折叠到“工作时长”下。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "簡短回合會用一行摘要顯示它做了什麼，而不是摺疊到「工作時長」下。"
