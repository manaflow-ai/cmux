      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يعرض الدور القصير ملخصًا من سطر واحد لما قام به، بدلًا من طيّه تحت «عمل لمدة»."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kratak potez prikazuje sažetak u jednom redu o tome šta je uradio, umjesto da se sklopi pod Radio je."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En kort tur viser et resumé på én linje af, hvad den gjorde, i stedet for at blive foldet under Arbejdede i."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine kurze Runde zeigt eine einzeilige Zusammenfassung ihrer Arbeit, statt unter „Gearbeitet für“ eingeklappt zu werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A short turn shows a one-line summary of what it did, instead of folding under Worked for."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un turno corto muestra un resumen de una línea de lo que hizo, en lugar de plegarse bajo Trabajó durante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un tour court affiche un résumé d’une ligne de ce qu’il a fait, au lieu d’être replié sous Travaillé pendant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un turno breve mostra un riepilogo di una riga di ciò che ha fatto, invece di chiudersi sotto Ha lavorato per."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "短いターンは「作業時間」の下に折りたたまれず、行った内容を 1 行で要約して表示します。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "វេនខ្លីបង្ហាញសេចក្តីសង្ខេបមួយបន្ទាត់អំពីអ្វីដែលវាបានធ្វើ ជំនួសឱ្យការបត់នៅក្រោម ធ្វើការរយៈពេល។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "짧은 턴은 작업 시간 아래로 접히는 대신 수행한 내용을 한 줄로 요약해 보여줍니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En kort runde viser et sammendrag på én linje av hva den gjorde, i stedet for å foldes under Arbeidet i."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Krótka tura pokazuje jednowierszowe podsumowanie tego, co zrobiła, zamiast zwijać się pod Pracował przez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um turno curto mostra um resumo de uma linha do que fez, em vez de ser recolhido em Trabalhou por."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Короткий ход показывает однострочную сводку того, что он сделал, вместо того чтобы сворачиваться под «Работал»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "เทิร์นสั้นจะแสดงสรุปหนึ่งบรรทัดของสิ่งที่ทำ แทนที่จะพับไว้ใต้ ทำงานเป็นเวลา"
