        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kısa bir tur, Şu süre çalıştı altında katlanmak yerine ne yaptığını tek satırlık bir özetle gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
