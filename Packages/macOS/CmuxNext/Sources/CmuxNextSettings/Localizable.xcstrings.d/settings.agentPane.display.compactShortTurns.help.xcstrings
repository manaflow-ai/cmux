          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "វេនខ្លីបង្ហាញសេចក្តីសង្ខេបមួយបន្ទាត់អំពីអ្វីដែលវាបានធ្វើ ជំនួសឱ្យការបត់នៅក្រោម Worked for។"
