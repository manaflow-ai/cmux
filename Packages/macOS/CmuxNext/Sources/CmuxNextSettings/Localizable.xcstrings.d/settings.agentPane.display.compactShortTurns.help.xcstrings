        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "简短回合会用一行摘要显示完成的工作，而不是折叠在工作时长下方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "簡短回合會用一行摘要顯示完成的工作，而不是摺疊在工作時長下方。"
