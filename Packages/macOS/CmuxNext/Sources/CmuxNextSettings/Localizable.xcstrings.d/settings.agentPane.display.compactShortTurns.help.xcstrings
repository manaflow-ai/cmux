          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Một lượt ngắn hiển thị tóm tắt một dòng về việc nó đã làm, thay vì gập lại dưới Đã làm việc trong."
          }
