        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "짧은 턴은 Worked for 아래로 접히는 대신 수행한 작업을 한 줄 요약으로 보여 줍니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En kort runde viser et sammendrag på én linje av hva den gjorde, i stedet for å foldes under Worked for."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
