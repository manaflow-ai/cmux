{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.appearance.backgroundDynamic.help" : {
      "comment" : "Settings row help: a dynamic macOS wallpaper follows light and dark or the sun.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Follow light and dark, or change with the sun through the day."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تتبع الوضعين الفاتح والداكن، أو تتغير مع الشمس خلال اليوم."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prati svijetlo i tamno ili se mijenja sa suncem tokom dana."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Følg lys og mørk, eller skift med solen gennem dagen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folgt Hell und Dunkel oder ändert sich über den Tag mit der Sonne."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seguir el modo claro y oscuro, o cambiar con el sol a lo largo del día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Suivre le mode clair et sombre, ou changer avec le soleil au fil de la journée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Segue chiaro e scuro, oppure cambia con il sole durante il giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ライトとダークに合わせるか、太陽に合わせて一日を通して変化させます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "តាមភ្លឺ និងងងឹត ឬប្ដូរតាមព្រះអាទិត្យពេញមួយថ្ងៃ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "라이트와 다크를 따르거나, 해에 따라 하루 동안 바뀝니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Følger lys og mørk, eller endrer seg med solen gjennom dagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Podąża za trybem jasnym i ciemnym albo zmienia się w ciągu dnia razem ze słońcem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seguir claro e escuro ou mudar com o sol ao longo do dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Следовать светлому и тёмному оформлению или меняться вместе с солнцем в течение дня."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ตามโหมดสว่างและมืด หรือเปลี่ยนตามดวงอาทิตย์ตลอดวัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Açık ve koyuyu izleyin ya da gün boyunca güneşle değişin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Стежити за світлим і темним виглядом або змінюватися разом із сонцем протягом дня."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Theo sáng và tối, hoặc thay đổi trong ngày theo mặt trời."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "跟随浅色和深色，或在一天中随太阳变化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "跟隨淺色和深色，或隨太陽在一天中變化。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
