    "settings.experiments.seeThroughDock.help" : {
      "comment" : "Settings > Experiments: the See-Through Dock taste prototype row",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The conversation stays visible behind the notices and the Needs your input row above the composer."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى المحادثة مرئية خلف الإشعارات وصف «يحتاج إلى إدخالك» فوق مربع الكتابة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razgovor ostaje vidljiv iza obavještenja i reda „Potreban je vaš unos“ iznad polja za pisanje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samtalen forbliver synlig bag meddelelserne og rækken “Kræver dit input” over skrivefeltet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Unterhaltung bleibt hinter den Hinweisen und der Zeile „Deine Eingabe ist nötig“ über dem Eingabefeld sichtbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conversación sigue visible detrás de los avisos y de la fila «Necesita tu respuesta» sobre el editor."
