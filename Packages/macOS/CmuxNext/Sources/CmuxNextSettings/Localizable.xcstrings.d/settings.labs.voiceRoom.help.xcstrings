        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ពេលបន្ទប់បើក cmux ផ្ញើអត្ថបទពីមីក្រូហ្វូន និងអត្ថបទលើអេក្រង់របស់អ្នកទៅបន្ទប់។"
