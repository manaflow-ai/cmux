      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أثناء فتح غرفة، يرسل cmux إليها نصًا مفرّغًا من الميكروفون ونص شاشتك."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dok je soba otvorena, cmux joj šalje transkript vašeg mikrofona i tekst s ekrana."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mens et rum er åbent, sender cmux en transskription af din mikrofon og skærmens tekst til det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Solange ein Raum offen ist, sendet cmux ein Transkript deines Mikrofons und den Text deines Bildschirms dorthin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While a room is open, cmux sends a transcript of your mic and your screen's text to it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mientras una sala está abierta, cmux le envía una transcripción de tu micrófono y el texto de tu pantalla."
