{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.updates.webCas.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web UI updates download only what changed, or the whole update when that fails."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنزّل تحديثات واجهة الويب ما تغيّر فقط، أو التحديث كاملًا إذا تعذّر ذلك."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ažuriranja web sučelja preuzimaju samo ono što se promijenilo, ili cijelo ažuriranje ako to ne uspije."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opdateringer af webbrugerfladen henter kun det, der er ændret, eller hele opdateringen, hvis det mislykkes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web-UI-Updates laden nur, was sich geändert hat, oder das ganze Update, wenn das fehlschlägt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las actualizaciones de la interfaz web descargan solo lo que cambió, o la actualización completa si eso falla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mises à jour de l'interface web ne téléchargent que ce qui a changé, ou la mise à jour entière en cas d'échec."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti dell'interfaccia web scaricano solo ciò che è cambiato, o l'intero aggiornamento se non riesce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web UI のアップデートは変更分だけをダウンロードし、失敗したときはアップデート全体をダウンロードします。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "បច្ចុប្បន្នភាព UI គេហទំព័រទាញយកតែអ្វីដែលបានផ្លាស់ប្ដូរ ឬបច្ចុប្បន្នភាពទាំងមូលនៅពេលវាបរាជ័យ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웹 UI 업데이트는 바뀐 부분만 받고, 실패하면 업데이트 전체를 받습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppdateringer av nettgrensesnittet laster bare ned det som er endret, eller hele oppdateringen hvis det mislykkes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizacje interfejsu web pobierają tylko to, co się zmieniło, a gdy to się nie uda — całą aktualizację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As atualizações da interface web baixam só o que mudou, ou a atualização inteira quando isso falha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновления веб-интерфейса загружают только изменённое, а при сбое — всё обновление целиком."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อัปเดต UI เว็บจะดาวน์โหลดเฉพาะส่วนที่เปลี่ยน หรือดาวน์โหลดทั้งอัปเดตเมื่อทำไม่สำเร็จ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web arayüzü güncellemeleri yalnızca değişeni indirir; bu başarısız olursa güncellemenin tamamını indirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оновлення вебінтерфейсу завантажують лише змінене, а в разі збою — усе оновлення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản cập nhật giao diện web chỉ tải phần đã thay đổi, hoặc tải toàn bộ bản cập nhật khi việc đó thất bại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web 界面更新只下载变化的部分；失败时下载完整更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web 介面更新只下載變更的部分；失敗時下載完整更新。"
          }
        }
      }
    }
  },
  "version" : "1.0"
