{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.experiments.menuRowStates.help" : {
      "comment" : "Settings > Experimental > Menu Row States help: an unavailable menu row says why; a row that starts work shows its progress.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تذكر صفوف القوائم غير المتاحة السبب، وتعرض الصفوف التي تبدأ عملًا تقدّمه."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedostupni redovi menija kažu zašto, a redovi koji pokreću posao prikazuju njegov napredak."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menurækker, der ikke er tilgængelige, fortæller hvorfor, og rækker, der starter arbejde, viser fremskridtet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht verfügbare Menüzeilen sagen, warum, und Zeilen, die eine Arbeit starten, zeigen ihren Fortschritt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menu rows that are unavailable say why, and rows that start work show their progress."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las filas de menú no disponibles dicen por qué, y las que inician trabajo muestran su progreso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lignes de menu indisponibles disent pourquoi, et celles qui lancent une tâche affichent sa progression."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le righe dei menu non disponibili spiegano perché, e quelle che avviano un lavoro ne mostrano l'avanzamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用できないメニュー行は理由を示し、処理を開始する行は進行状況を表示します。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ជួរម៉ឺនុយដែលមិនអាចប្រើបាន ប្រាប់មូលហេតុ ហើយជួរដែលចាប់ផ្តើមការងារ បង្ហាញវឌ្ឍនភាពរបស់វា។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용할 수 없는 메뉴 행은 이유를 알려 주고, 작업을 시작하는 행은 진행 상황을 보여 줍니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyrader som ikke er tilgjengelige, forteller hvorfor, og rader som starter arbeid, viser fremdriften."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niedostępne wiersze menu mówią dlaczego, a wiersze uruchamiające pracę pokazują jej postęp."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linhas de menu indisponíveis dizem por quê, e linhas que iniciam trabalho mostram o progresso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недоступные строки меню объясняют причину, а строки, запускающие работу, показывают её ход."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แถวเมนูที่ใช้ไม่ได้จะบอกเหตุผล และแถวที่เริ่มงานจะแสดงความคืบหน้า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanılamayan menü satırları nedenini söyler, iş başlatan satırlar ilerlemesini gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недоступні рядки меню пояснюють причину, а рядки, що запускають роботу, показують її перебіг."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các dòng menu không khả dụng cho biết lý do, và các dòng bắt đầu công việc hiển thị tiến độ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不可用的菜单行会说明原因，开始工作的行会显示进度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法使用的選單列會說明原因，開始工作的列會顯示進度。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
