{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.agentPane.followUpMode.help" : {
      "comment" : "Settings > Agent Chat > Follow-Up Messages: what the row does. Command-Return is the Command key with Return.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What Return does with a message sent while the agent is working. Command-Return does the other."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ما يفعله مفتاح Return برسالة تُرسل أثناء عمل الوكيل. ويفعل Command-Return الخيار الآخر."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Šta Return radi s porukom poslanom dok agent radi. Command-Return radi suprotno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hvad Return gør med en besked, der sendes, mens agenten arbejder. Command-Return gør det modsatte."
