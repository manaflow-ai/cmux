{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.app.keyStyle.help" : {
      "comment" : "Settings help under Key Style. j, k, gg, G and / are Vim keys; Control-N, P, F, B, A and E are Emacs keys; keep the key letters as they are.",
