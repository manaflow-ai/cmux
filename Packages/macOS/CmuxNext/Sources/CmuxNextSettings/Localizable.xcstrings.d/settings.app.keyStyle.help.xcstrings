      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vim moves through lists with j, k, gg, G and /. Emacs uses Control-N, P, F, B, A and E."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vim bewegt sich mit j, k, gg, G und / durch Listen. Emacs nutzt Control-N, P, F, B, A und E."
          }
        },
