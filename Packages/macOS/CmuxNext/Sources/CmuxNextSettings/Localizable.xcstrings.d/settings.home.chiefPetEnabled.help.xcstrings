        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Một Chief nhỏ trên mọi ứng dụng hiện các sự kiện của tác tử. ⌃⌥⌘C mở ô trả lời của nó."
          }
