        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "一个小小的 Chief 浮在所有应用上方，显示代理事件。⌃⌥⌘C 打开它的回复框。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "一個小小的 Chief 浮在所有 App 上方顯示代理事件。按 ⌃⌥⌘C 打開它的回覆框。"
