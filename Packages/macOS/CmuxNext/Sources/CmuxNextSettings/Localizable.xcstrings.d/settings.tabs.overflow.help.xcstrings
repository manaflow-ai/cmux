{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.tabs.overflow.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shrink narrows tabs before scrolling; Scroll keeps them wide."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "التقليص يضيّق علامات التبويب قبل التمرير؛ التمرير يبقيها عريضة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sužavanje sužava kartice prije pomicanja; Pomicanje ih drži širokima."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Formindsk gør faner smallere, før der rulles; Rul holder dem brede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verkleinern macht Tabs vor dem Scrollen schmaler; Scrollen hält sie breit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reducir estrecha las pestañas antes de desplazarse; Desplazar las mantiene anchas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Réduire rétrécit les onglets avant le défilement ; Défiler les garde larges."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Restringi riduce le schede prima di scorrere; Scorri le mantiene larghe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「縮小」はスクロールする前にタブを縮め、「スクロール」はタブの幅を保ちます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "បង្រួម ធ្វើឲ្យផ្ទាំងតូចមុនពេលរមូរ; រមូរ រក្សាផ្ទាំងឲ្យធំ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "축소는 스크롤 전에 탭을 좁히고, 스크롤은 탭 너비를 유지합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Krymp gjør faner smalere før rulling; Rull holder dem brede."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zmniejszanie zwęża karty przed przewijaniem; Przewijanie zachowuje je szerokie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Encolher estreita as abas antes de rolar; Rolar as mantém largas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сжатие сужает вкладки до прокрутки; Прокрутка сохраняет их широкими."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ย่อ จะทำให้แท็บแคบลงก่อนเลื่อน เลื่อน จะคงแท็บให้กว้าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Daralt, kaymadan önce sekmeleri daraltır; Kaydır onları geniş tutar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Стискання звужує вкладки перед прокручуванням; Прокручування зберігає їх широкими."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Thu nhỏ làm hẹp thẻ trước khi cuộn; Cuộn giữ thẻ rộng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“缩小”会在滚动前缩窄标签页；“滚动”让标签页保持宽度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「縮小」會先縮窄分頁再捲動；「捲動」讓分頁保持寬度。"
          }
