{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.agentPane.display.inspector.help" : {
      "comment" : "Settings > Appearance > Agent Chat > Inspector: help for the Push / Overlay choice",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«دفع» يضيّق المحادثة، و«تراكب» يغطيها."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Guranje sužava razgovor; Preklapanje ga prekriva."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skub gør chatten smallere; Overlejring dækker den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Verschieben“ macht den Chat schmaler, „Überlagern“ legt sich darüber."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push narrows the chat; Overlay covers it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desplazar estrecha el chat; Superponer lo cubre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pousser rétrécit le chat ; Superposer le recouvre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sposta restringe la chat; Sovrapponi la copre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「押し出す」はチャットを狭め、「重ねる」はチャットの上に表示します。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "រុញ ធ្វើឱ្យការជជែកតូច; ត្រួតលើ គ្របលើវា។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "밀어내기는 채팅을 좁히고, 겹치기는 채팅을 덮습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skyv gjør chatten smalere; Overlegg dekker den."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przesuń zwęża czat; Nakładka go zakrywa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Empurrar estreita o chat; Sobrepor fica sobre ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«Сдвиг» сужает чат, «Поверх» закрывает его."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ดัน จะทำให้แชทแคบลง ส่วน ซ้อนทับ จะแสดงทับแชท"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "İt, sohbeti daraltır; Üstte, sohbetin üzerini kaplar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«Зсув» звужує чат, «Поверх» закриває його."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Đẩy thu hẹp cuộc trò chuyện; Phủ lên che phủ cuộc trò chuyện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“推开”会让对话变窄；“叠放”会盖在对话上方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「推開」會讓對話變窄；「疊放」會蓋在對話上方。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
