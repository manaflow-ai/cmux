        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new tab grows into its place in the tab bar. Off shows it there at once."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "新しいタブはタブバーの位置で広がります。オフにするとすぐに表示されます。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تنمو علامة التبويب الجديدة في مكانها في شريط علامات التبويب. عند الإيقاف تظهر فورًا."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nova kartica raste na svom mjestu u traci kartica. Isključeno je odmah prikazuje."
