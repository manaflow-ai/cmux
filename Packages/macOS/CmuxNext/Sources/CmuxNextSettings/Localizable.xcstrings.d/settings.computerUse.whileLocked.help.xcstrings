{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.computerUse.whileLocked.help" : {
      "comment" : "Help text under the Keep Working While Locked toggle.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يواصل الوكلاء رؤية نوافذ التطبيقات واستخدامها أثناء قفل هذا الـ Mac. أي شيء يحتاج إلى سطح المكتب أو المؤشر ينتظر حتى تفتح القفل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agenten sehen und bedienen App-Fenster weiter, während dieser Mac gesperrt ist. Alles, was den Schreibtisch oder den Zeiger braucht, wartet, bis du entsperrst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agents keep seeing and using app windows while this Mac is locked. Anything that needs the desktop or the pointer waits for you to unlock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los agentes siguen viendo y usando las ventanas de las apps mientras este Mac está bloqueado. Lo que necesite el escritorio o el puntero espera a que lo desbloquees."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les agents continuent de voir et d’utiliser les fenêtres des apps pendant que ce Mac est verrouillé. Ce qui a besoin du bureau ou du pointeur attend que vous le déverrouilliez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac がロックされている間も、エージェントはアプリのウインドウを見て操作し続けます。デスクトップやポインタが必要な操作は、ロックを解除するまで待ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac이 잠겨 있는 동안에도 에이전트가 앱 윈도우를 계속 보고 사용합니다. 데스크탑이나 포인터가 필요한 작업은 잠금을 해제할 때까지 기다립니다."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agenti i dalje vide i koriste prozore aplikacija dok je ovaj Mac zaključan. Sve što treba radnu površinu ili pokazivač čeka da ga otključate."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agenter kan stadig se og bruge appvinduer, mens denne Mac er låst. Alt, der kræver skrivebordet eller markøren, venter, til du låser op."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli agenti continuano a vedere e usare le finestre delle app mentre questo Mac è bloccato. Tutto ciò che richiede la scrivania o il puntatore attende che tu lo sblocchi."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ភ្នាក់ងារនៅតែមើលឃើញ និងប្រើបង្អួចកម្មវិធីពេល Mac នេះចាក់សោ។ អ្វីដែលត្រូវការផ្ទៃតុ ឬទស្សន៍ទ្រនិច រង់ចាំរហូតដល់អ្នកដោះសោ។"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agenter ser og bruker fortsatt appvinduer mens denne Mac-en er låst. Alt som trenger skrivebordet eller pekeren, venter til du låser opp."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agenci nadal widzą i używają okien aplikacji, gdy ten Mac jest zablokowany. Wszystko, co wymaga biurka lub wskaźnika, czeka, aż go odblokujesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os agentes continuam vendo e usando janelas de apps enquanto este Mac está bloqueado. Tudo que precisa da mesa ou do ponteiro espera você desbloquear."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агенты продолжают видеть и использовать окна приложений, пока этот Mac заблокирован. Всё, что требует рабочего стола или указателя, ждёт, пока вы разблокируете Mac."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เอเจนต์ยังคงเห็นและใช้หน้าต่างแอปได้ขณะที่ Mac เครื่องนี้ล็อกอยู่ สิ่งที่ต้องใช้เดสก์ท็อปหรือตัวชี้จะรอจนกว่าคุณจะปลดล็อก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Mac kilitliyken aracılar uygulama pencerelerini görmeye ve kullanmaya devam eder. Masaüstü veya imleç gerektiren her şey kilidi açmanızı bekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агенти й далі бачать і використовують вікна програм, поки цей Mac заблоковано. Усе, що потребує робочого столу чи вказівника, чекає, доки ви розблокуєте Mac."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tác tử vẫn thấy và dùng cửa sổ ứng dụng khi máy Mac này bị khóa. Mọi thứ cần màn hình nền hoặc con trỏ sẽ chờ bạn mở khóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 锁定时，代理仍可看到并使用 App 窗口。需要桌面或指针的操作会等你解锁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這台 Mac 鎖定時，代理仍可看見並使用 App 視窗。需要桌面或指標的動作會等你解鎖。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
