{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.appearance.liveWallpaperFrameRate.help" : {
      "comment" : "Help text of the Live Wallpaper Frame Rate setting.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The most frames per second a live wallpaper draws. A wallpaper may ask for fewer; it stops drawing when the window is hidden, idle or on Low Power Mode."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أقصى عدد من الإطارات في الثانية ترسمه الخلفية الحية. قد تطلب الخلفية عددًا أقل؛ وتتوقف عن الرسم عندما تكون النافذة مخفية أو خاملة أو في وضع الطاقة المنخفضة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najveći broj sličica u sekundi koje živa pozadina crta. Pozadina može tražiti manje; prestaje crtati kada je prozor skriven, neaktivan ili u načinu niske potrošnje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det højeste antal billeder pr. sekund, en levende baggrund tegner. En baggrund kan bede om færre; den stopper med at tegne, når vinduet er skjult, inaktivt eller i strømsparetilstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die höchste Zahl an Bildern pro Sekunde, die ein Live-Hintergrund zeichnet. Ein Hintergrund kann weniger anfordern; er hört auf zu zeichnen, wenn das Fenster verborgen oder untätig ist oder der Stromsparmodus aktiv ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El máximo de fotogramas por segundo que dibuja un fondo animado. Un fondo puede pedir menos; deja de dibujar cuando la ventana está oculta, inactiva o en modo de bajo consumo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nombre maximal d’images par seconde qu’un fond d’écran animé dessine. Un fond peut en demander moins ; il cesse de dessiner quand la fenêtre est masquée, inactive ou en mode économie d’énergie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il numero massimo di fotogrammi al secondo che uno sfondo animato disegna. Uno sfondo può chiederne meno; smette di disegnare quando la finestra è nascosta, inattiva o in modalità Risparmio energetico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブ壁紙が描画する1秒あたりの最大フレーム数。壁紙がより少ない数を求めることもあります。ウインドウが隠れている、操作がない、または低電力モードのときは描画を止めます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ចំនួនស៊ុមច្រើនបំផុតក្នុងមួយវិនាទីដែលផ្ទាំងរូបភាពផ្ទាល់គូរ។ ផ្ទាំងរូបភាពអាចស្នើតិចជាងនេះ; វាឈប់គូរនៅពេលបង្អួចត្រូវបានលាក់ ទំនេរ ឬក្នុងរបៀបថាមពលទាប។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이브 배경화면이 그리는 초당 최대 프레임 수입니다. 배경화면이 더 적게 요청할 수 있으며, 윈도우가 가려지거나 유휴 상태이거나 저전력 모드일 때는 그리기를 멈춥니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det høyeste antallet bilder per sekund en levende bakgrunn tegner. En bakgrunn kan be om færre; den slutter å tegne når vinduet er skjult, inaktivt eller i strømsparingsmodus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Największa liczba klatek na sekundę, jaką rysuje tapeta na żywo. Tapeta może prosić o mniej; przestaje rysować, gdy okno jest ukryte, bezczynne lub w trybie niskiego zużycia energii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O máximo de quadros por segundo que um papel de parede animado desenha. Um papel de parede pode pedir menos; ele para de desenhar quando a janela está oculta, ociosa ou no Modo de Pouca Energia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наибольшее число кадров в секунду, которое рисуют живые обои. Обои могут запросить меньше; они перестают рисовать, когда окно скрыто, простаивает или включён режим энергосбережения."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จำนวนเฟรมต่อวินาทีสูงสุดที่ภาพพื้นหลังแบบเคลื่อนไหววาด ภาพพื้นหลังอาจขอน้อยกว่านั้น และจะหยุดวาดเมื่อหน้าต่างถูกซ่อน ไม่มีการใช้งาน หรืออยู่ในโหมดพลังงานต่ำ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı bir duvar kâğıdının saniyede çizdiği en fazla kare sayısı. Duvar kâğıdı daha azını isteyebilir; pencere gizliyken, boştayken veya Düşük Güç Modu'ndayken çizmeyi bırakır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найбільша кількість кадрів на секунду, яку малюють живі шпалери. Шпалери можуть просити менше; вони перестають малювати, коли вікно приховане, неактивне або ввімкнено режим енергозбереження."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số khung hình mỗi giây tối đa mà hình nền động vẽ. Hình nền có thể yêu cầu ít hơn; nó ngừng vẽ khi cửa sổ bị ẩn, không hoạt động hoặc ở Chế độ nguồn điện thấp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "动态壁纸每秒最多绘制的帧数。壁纸可以要求更少；窗口隐藏、闲置或处于低电量模式时停止绘制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動態背景圖片每秒最多繪製的影格數。背景圖片可以要求更少；視窗隱藏、閒置或處於低耗電模式時停止繪製。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
