{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.updates.installWhenIdle.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installs a downloaded update and restarts while you are away: no input for the time below, or the screen locked. Never over an unsent message. Agents and their turns keep running."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يثبّت تحديثًا تم تنزيله ويعيد التشغيل أثناء غيابك: لا إدخال طوال المدة أدناه، أو الشاشة مقفلة. لا يحدث ذلك أبدًا فوق رسالة لم تُرسل. تستمر الوكلاء وأدوارهم في العمل."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalira preuzeto ažuriranje i ponovo pokreće dok ste odsutni: bez unosa tokom vremena ispod ili sa zaključanim ekranom. Nikad preko neposlane poruke. Agenti i njihovi potezi nastavljaju raditi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installerer en hentet opdatering og genstarter, mens du er væk: intet input i tiden nedenfor, eller skærmen låst. Aldrig hen over en ikke-sendt besked. Agenter og deres ture kører videre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiert ein geladenes Update und startet neu, während du weg bist: keine Eingabe für die Zeit unten oder der Bildschirm gesperrt. Nie über einer ungesendeten Nachricht. Agenten und ihre Antworten laufen weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala una actualización descargada y reinicia mientras no estás: sin actividad durante el tiempo de abajo, o con la pantalla bloqueada. Nunca sobre un mensaje sin enviar. Los agentes y sus turnos siguen en marcha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installe une mise à jour téléchargée et redémarre pendant votre absence : aucune saisie pendant la durée ci-dessous, ou l’écran verrouillé. Jamais sur un message non envoyé. Les agents et leurs tours continuent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installa un aggiornamento scaricato e riavvia mentre sei via: nessun input per il tempo indicato sotto, o schermo bloccato. Mai sopra un messaggio non inviato. Gli agenti e i loro turni continuano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離席中にダウンロード済みのアップデートをインストールして再起動します: 下の時間のあいだ入力がないか、画面がロックされているとき。未送信のメッセージがあるときは実行しません。エージェントと実行中のターンはそのまま続きます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ដំឡើងបច្ចុប្បន្នភាពដែលបានទាញយក ហើយចាប់ផ្ដើមឡើងវិញ ពេលអ្នកមិននៅ៖ គ្មានការបញ្ចូលក្នុងរយៈពេលខាងក្រោម ឬអេក្រង់ត្រូវបានចាក់សោ។ មិនដែលធ្វើពេលមានសារមិនទាន់ផ្ញើឡើយ។ ភ្នាក់ងារ និងវេនរបស់វានៅតែបន្តដំណើរការ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자리를 비운 동안 다운로드한 업데이트를 설치하고 다시 시작합니다: 아래 시간 동안 입력이 없거나 화면이 잠겨 있을 때. 보내지 않은 메시지가 있으면 절대 실행하지 않습니다. 에이전트와 진행 중인 턴은 계속 실행됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installerer en nedlastet oppdatering og starter på nytt mens du er borte: ingen inndata i tiden nedenfor, eller skjermen låst. Aldri over en usendt melding. Agenter og turene deres fortsetter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instaluje pobraną aktualizację i uruchamia ponownie, gdy jesteś nieobecny: brak aktywności przez czas poniżej lub zablokowany ekran. Nigdy przy niewysłanej wiadomości. Agenci i ich tury działają dalej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala uma atualização baixada e reinicia enquanto você está ausente: sem entrada pelo tempo abaixo, ou com a tela bloqueada. Nunca sobre uma mensagem não enviada. Os agentes e seus turnos continuam rodando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устанавливает загруженное обновление и перезапускается, пока вас нет: нет ввода в течение времени ниже или экран заблокирован. Никогда поверх неотправленного сообщения. Агенты и их ходы продолжают работать."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ติดตั้งอัปเดตที่ดาวน์โหลดแล้วและรีสตาร์ทขณะที่คุณไม่อยู่: ไม่มีการป้อนข้อมูลตามเวลาด้านล่าง หรือหน้าจอถูกล็อก จะไม่ทำขณะมีข้อความที่ยังไม่ได้ส่ง เอเจนต์และรอบการทำงานของพวกมันยังคงทำงานต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirilen bir güncellemeyi siz yokken yükler ve yeniden başlatır: aşağıdaki süre boyunca giriş yoksa veya ekran kilitliyse. Gönderilmemiş bir mesaj varken asla. Ajanlar ve turları çalışmaya devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встановлює завантажене оновлення й перезапускається, поки вас немає: немає введення протягом часу нижче або екран заблоковано. Ніколи поверх ненадісланого повідомлення. Агенти та їхні ходи продовжують працювати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cài bản cập nhật đã tải về và khởi động lại khi bạn vắng mặt: không có thao tác trong khoảng thời gian bên dưới, hoặc màn hình đã khóa. Không bao giờ khi còn tin nhắn chưa gửi. Các agent và lượt của chúng vẫn tiếp tục chạy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你离开时安装已下载的更新并重新启动：在下方时间内没有输入，或屏幕已锁定。有未发送的消息时绝不执行。代理及其回合会继续运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你離開時安裝已下載的更新並重新啟動：在下方時間內沒有輸入，或螢幕已鎖定。有未傳送的訊息時絕不執行。代理程式及其回合會繼續執行。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
