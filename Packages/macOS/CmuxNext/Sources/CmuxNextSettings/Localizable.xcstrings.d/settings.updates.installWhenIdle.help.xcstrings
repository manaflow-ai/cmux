{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.updates.installWhenIdle.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installs a downloaded update and restarts while you are away or the screen is locked, never over an unsent message."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يثبّت التحديث الذي تم تنزيله ويعيد التشغيل أثناء غيابك أو عند قفل الشاشة، وليس أبدًا فوق رسالة لم تُرسل."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalira preuzeto ažuriranje i ponovo pokreće dok ste odsutni ili je ekran zaključan, nikad preko neposlane poruke."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installerer en hentet opdatering og genstarter, mens du er væk eller skærmen er låst, aldrig over en usendt besked."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiert ein geladenes Update und startet neu, während du weg bist oder der Bildschirm gesperrt ist, nie über einer ungesendeten Nachricht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala una actualización descargada y reinicia mientras no estás o la pantalla está bloqueada, nunca sobre un mensaje sin enviar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installe une mise à jour téléchargée et redémarre pendant votre absence ou quand l'écran est verrouillé, jamais par-dessus un message non envoyé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installa un aggiornamento scaricato e riavvia mentre sei via o lo schermo è bloccato, mai sopra un messaggio non inviato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離席中または画面のロック中に、ダウンロード済みのアップデートをインストールして再起動します。未送信のメッセージがあるときは行いません。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ដំឡើងបច្ចុប្បន្នភាពដែលបានទាញយក ហើយចាប់ផ្តើមឡើងវិញ ពេលអ្នកមិននៅ ឬអេក្រង់ត្រូវបានចាក់សោ មិនដែលលើសារដែលមិនទាន់ផ្ញើទេ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자리를 비웠거나 화면이 잠겼을 때 다운로드한 업데이트를 설치하고 재시작합니다. 보내지 않은 메시지가 있으면 하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installerer en nedlastet oppdatering og starter på nytt mens du er borte eller skjermen er låst, aldri over en usendt melding."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instaluje pobraną aktualizację i uruchamia ponownie, gdy jesteś nieobecny lub ekran jest zablokowany, nigdy nad niewysłaną wiadomością."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala uma atualização baixada e reinicia enquanto você está ausente ou a tela está bloqueada, nunca sobre uma mensagem não enviada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устанавливает загруженное обновление и перезапускает, пока вас нет или экран заблокирован, но никогда поверх неотправленного сообщения."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ติดตั้งอัปเดตที่ดาวน์โหลดแล้วและรีสตาร์ตขณะคุณไม่อยู่หรือหน้าจอล็อก ไม่ทำทับข้อความที่ยังไม่ได้ส่ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirilen güncellemeyi siz yokken veya ekran kilitliyken yükleyip yeniden başlatır; gönderilmemiş bir mesajın üzerine asla."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встановлює завантажене оновлення й перезапускає, поки вас немає або екран заблоковано, але ніколи поверх ненадісланого повідомлення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cài bản cập nhật đã tải và khởi động lại khi bạn vắng mặt hoặc màn hình bị khóa, không bao giờ khi còn tin nhắn chưa gửi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你离开或屏幕锁定时安装已下载的更新并重启，绝不会覆盖未发送的消息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你離開或螢幕鎖定時安裝已下載的更新並重新啟動，絕不會蓋過未傳送的訊息。"
          }
        }
      }
    }
