{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.updates.installWhenIdle.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installs a downloaded update and restarts while you're away (idle for the time below, or screen locked), never over an unsent message. Agents keep running."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يثبّت تحديثًا تم تنزيله ويعيد التشغيل أثناء غيابك (خمول طوال المدة أدناه أو شاشة مقفلة)، ولا يحدث فوق رسالة لم تُرسل. تستمر الوكلاء في العمل."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalira preuzeto ažuriranje i ponovo pokreće dok ste odsutni (bez unosa tokom vremena ispod ili zaključan ekran), nikad preko neposlane poruke. Agenti nastavljaju raditi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installerer en hentet opdatering og genstarter, mens du er væk (inaktiv i tiden nedenfor eller låst skærm), aldrig hen over en ikke-sendt besked. Agenter kører videre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiert ein geladenes Update und startet neu, während du weg bist (inaktiv für die Zeit unten oder Bildschirm gesperrt), nie über einer ungesendeten Nachricht. Agenten laufen weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala una actualización descargada y reinicia mientras no estás (inactivo el tiempo de abajo o pantalla bloqueada), nunca sobre un mensaje sin enviar. Los agentes siguen en marcha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installe une mise à jour téléchargée et redémarre pendant votre absence (inactif pendant la durée ci-dessous ou écran verrouillé), jamais sur un message non envoyé. Les agents continuent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installa un aggiornamento scaricato e riavvia mentre sei via (inattivo per il tempo indicato sotto o schermo bloccato), mai sopra un messaggio non inviato. Gli agenti continuano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離席中（下の時間だけ操作がないか、画面がロックされているとき）にダウンロード済みのアップデートをインストールして再起動します。未送信のメッセージがあるときは実行しません。エージェントは動き続けます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ដំឡើងបច្ចុប្បន្នភាពដែលបានទាញយក ហើយចាប់ផ្ដើមឡើងវិញពេលអ្នកមិននៅ (ទំនេររយៈពេលខាងក្រោម ឬអេក្រង់ចាក់សោ) មិនដែលលើសារដែលមិនទាន់ផ្ញើទេ។ ភ្នាក់ងារបន្តដំណើរការ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자리를 비운 동안(아래 시간 동안 입력이 없거나 화면이 잠긴 경우) 다운로드한 업데이트를 설치하고 재시작합니다. 보내지 않은 메시지가 있으면 하지 않습니다. 에이전트는 계속 실행됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installerer en nedlastet oppdatering og starter på nytt mens du er borte (inaktiv i tiden nedenfor eller låst skjerm), aldri over en usendt melding. Agenter kjører videre."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instaluje pobraną aktualizację i uruchamia ponownie, gdy cię nie ma (bezczynność przez czas poniżej lub zablokowany ekran), nigdy nad niewysłaną wiadomością. Agenci działają dalej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala uma atualização baixada e reinicia enquanto você está ausente (inativo pelo tempo abaixo ou tela bloqueada), nunca sobre uma mensagem não enviada. Os agentes continuam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устанавливает загруженное обновление и перезапускает, пока вас нет (бездействие в течение времени ниже или экран заблокирован), но не поверх неотправленного сообщения. Агенты продолжают работу."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ติดตั้งอัปเดตที่ดาวน์โหลดแล้วและรีสตาร์ทขณะคุณไม่อยู่ (ไม่ได้ใช้งานตามเวลาด้านล่าง หรือหน้าจอล็อก) ไม่ทำทับข้อความที่ยังไม่ได้ส่ง เอเจนต์ยังทำงานต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirilen güncellemeyi siz uzaktayken (aşağıdaki süre boyunca boşta ya da ekran kilitli) kurar ve yeniden başlatır; gönderilmemiş bir mesaj varken asla. Ajanlar çalışmaya devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встановлює завантажене оновлення й перезапускає, поки вас немає (бездіяльність протягом часу нижче або екран заблоковано), але не поверх ненадісланого повідомлення. Агенти працюють далі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cài bản cập nhật đã tải và khởi động lại khi bạn vắng mặt (không thao tác trong thời gian bên dưới hoặc màn hình khóa), không bao giờ khi có tin nhắn chưa gửi. Các tác tử vẫn chạy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你离开时（下方时间内无操作，或屏幕已锁定）安装已下载的更新并重新启动，有未发送的消息时绝不执行。代理会继续运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你離開時（下方時間內無操作，或螢幕已鎖定）安裝已下載的更新並重新啟動，有未送出的訊息時絕不執行。代理會繼續執行。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
