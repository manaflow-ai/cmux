{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.layout.fadeInactivePanes.help" : {
      "comment" : "Settings > General > Scrolling and Focus: help under the Fade Inactive Panes toggle.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panes without the focus fade, and come back when you focus them."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تتلاشى الأجزاء التي لا تحمل التركيز، وتعود عند التركيز عليها."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Okna bez fokusa izblijede i vrate se kad ih fokusirate."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ruder uden fokus tones ned og vender tilbage, når du fokuserer på dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bereiche ohne Fokus werden abgeblendet und kehren zurück, sobald du sie fokussierst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los paneles sin el foco se atenúan y vuelven cuando los enfocas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les panneaux sans le focus s’estompent et reviennent quand vous leur donnez le focus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I riquadri senza focus si attenuano e tornano quando dai loro il focus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "フォーカスのないペインは薄くなり、フォーカスすると元に戻ります。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ផ្ទាំងដែលគ្មានការផ្តោតនឹងស្រអាប់ ហើយត្រឡប់មកវិញនៅពេលអ្នកផ្តោតលើវា។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "포커스가 없는 패널은 흐려지고, 포커스하면 다시 돌아옵니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ruter uten fokus tones ned og kommer tilbake når du fokuserer dem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Panele bez fokusu przygasają i wracają, gdy na nich ustawisz fokus."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Painéis sem o foco esmaecem e voltam quando você os foca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Панели без фокуса затемняются и возвращаются, когда вы на них фокусируетесь."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "บานหน้าต่างที่ไม่ได้โฟกัสจะจางลง และกลับมาเมื่อคุณโฟกัส"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
