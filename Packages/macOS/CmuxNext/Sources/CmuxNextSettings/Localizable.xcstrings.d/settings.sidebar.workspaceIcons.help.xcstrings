{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.sidebar.workspaceIcons.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An icon per workspace title. \"*\" sets the rest; an empty icon hides it."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أيقونة لكل عنوان مساحة عمل. \"*\" يحدد البقية؛ والأيقونة الفارغة تخفيها."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ikona po naslovu radnog prostora. \"*\" postavlja ostale; prazna ikona je skriva."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Et ikon pr. arbejdsområdetitel. \"*\" angiver resten; et tomt ikon skjuler det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein Symbol pro Arbeitsbereichstitel. \"*\" legt den Rest fest; ein leeres Symbol blendet es aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un icono por título de espacio de trabajo. \"*\" define el de los demás; un icono vacío lo oculta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une icône par titre d’espace de travail. \"*\" définit les autres ; une icône vide la masque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un’icona per titolo di area di lavoro. \"*\" imposta le altre; un’icona vuota la nasconde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ワークスペースのタイトルごとのアイコンです。\"*\" はその他すべてを設定し、空のアイコンは非表示にします。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "រូបតំណាងសម្រាប់ចំណងជើងកន្លែងធ្វើការនីមួយៗ។ \"*\" កំណត់សម្រាប់ផ្សេងទៀត; រូបតំណាងទទេនឹងលាក់វា។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "작업 공간 제목마다 지정하는 아이콘입니다. \"*\"는 나머지를 지정하며, 빈 아이콘은 아이콘을 숨깁니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Et ikon per arbeidsområdetittel. \"*\" angir resten; et tomt ikon skjuler det."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ikona dla każdego tytułu obszaru roboczego. \"*\" ustawia pozostałe; pusta ikona ją ukrywa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um ícone por título de espaço de trabalho. \"*\" define o dos demais; um ícone vazio o oculta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Значок для названия рабочего пространства. \"*\" задаёт остальные; пустой значок скрывает его."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ไอคอนต่อชื่อพื้นที่ทำงาน \"*\" กำหนดไอคอนของที่เหลือ ไอคอนว่างจะซ่อนไอคอน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Her çalışma alanı başlığı için bir simge. \"*\" diğerlerini belirler; boş simge onu gizler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Значок для кожної назви робочого простору. \"*\" задає решту; порожній значок приховує його."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Một biểu tượng cho mỗi tiêu đề không gian làm việc. \"*\" đặt cho phần còn lại; biểu tượng trống sẽ ẩn nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每个工作区标题对应一个图标。\"*\" 设置其余工作区；空图标会将其隐藏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每個工作區標題對應一個圖像。\"*\" 設定其餘工作區；空白圖像會將其隱藏。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
