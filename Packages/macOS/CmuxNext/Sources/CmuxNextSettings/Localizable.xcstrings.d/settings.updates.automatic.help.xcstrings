{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.updates.automatic.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install When Idle restarts cmux once you have been away, never while an agent works or a message is unsent. Terminals and agents keep running."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيد خيار «التثبيت عند الخمول» تشغيل cmux بعد غيابك، ولا يفعل ذلك أبدًا أثناء عمل وكيل أو وجود رسالة غير مرسلة. تستمر الطرفيات والوكلاء في العمل."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instaliraj kada je neaktivan ponovo pokreće cmux kada ste odsutni, nikada dok agent radi ili poruka nije poslana. Terminali i agenti nastavljaju raditi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installer ved inaktivitet genstarter cmux, når du har været væk, aldrig mens en agent arbejder, eller en besked ikke er sendt. Terminaler og agenter kører videre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Inaktivität installieren startet cmux neu, wenn du weg warst – nie, während ein Agent arbeitet oder eine Nachricht nicht gesendet ist. Terminals und Agents laufen weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalar en reposo reinicia cmux cuando te has ausentado, nunca mientras un agente trabaja o hay un mensaje sin enviar. Las terminales y los agentes siguen en ejecución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installer en cas d'inactivité redémarre cmux après votre absence, jamais pendant qu'un agent travaille ou qu'un message n'est pas envoyé. Les terminaux et les agents continuent de fonctionner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installa quando inattivo riavvia cmux dopo che sei stato via, mai mentre un agente lavora o un messaggio non è stato inviato. Terminali e agenti continuano a funzionare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「アイドル時にインストール」は、離席後に cmux を再起動します。エージェントの作業中や未送信のメッセージがあるときは再起動しません。ターミナルとエージェントは動作し続けます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ដំឡើងនៅពេលទំនេរ ចាប់ផ្ដើម cmux ឡើងវិញ ពេលអ្នកចាកចេញ មិនដែលពេលភ្នាក់ងារកំពុងធ្វើការ ឬមានសារមិនទាន់ផ្ញើឡើយ។ ទែមីណាល់ និងភ្នាក់ងារនៅតែដំណើរការ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유휴 시 설치는 자리를 비운 후 cmux를 재시작하며, 에이전트가 작업 중이거나 보내지 않은 메시지가 있을 때는 재시작하지 않습니다. 터미널과 에이전트는 계속 실행됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installer ved inaktivitet starter cmux på nytt når du har vært borte, aldri mens en agent jobber eller en melding ikke er sendt. Terminaler og agenter fortsetter å kjøre."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instaluj w bezczynności uruchamia ponownie cmux, gdy Cię nie ma, nigdy podczas pracy agenta ani gdy wiadomość nie została wysłana. Terminale i agenci działają dalej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalar quando ocioso reinicia o cmux depois que você se ausenta, nunca enquanto um agente trabalha ou há uma mensagem não enviada. Terminais e agentes continuam em execução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Устанавливать при бездействии» перезапускает cmux, когда вас нет, но никогда — во время работы агента или при неотправленном сообщении. Терминалы и агенты продолжают работать."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ติดตั้งเมื่อไม่มีการใช้งานจะรีสตาร์ท cmux เมื่อคุณไม่อยู่ และจะไม่รีสตาร์ทขณะที่เอเจนต์ทำงานหรือมีข้อความที่ยังไม่ได้ส่ง เทอร์มินัลและเอเจนต์ยังคงทำงานต่อไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boşta Kalınca Yükle, siz uzaktayken cmux'u yeniden başlatır; bir ajan çalışırken veya gönderilmemiş bir ileti varken asla. Terminaller ve ajanlar çalışmaya devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Встановлювати під час бездіяльності» перезапускає cmux, коли вас немає, але ніколи — під час роботи агента чи з ненадісланим повідомленням. Термінали й агенти продовжують працювати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cài đặt khi nhàn rỗi khởi động lại cmux khi bạn vắng mặt, không bao giờ khi tác tử đang làm việc hoặc có tin nhắn chưa gửi. Terminal và tác tử vẫn tiếp tục chạy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“空闲时安装”会在你离开后重启 cmux，绝不会在代理工作或有未发送消息时重启。终端和代理会继续运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「閒置時安裝」會在你離開後重新啟動 cmux，絕不會在代理程式工作或有未傳送訊息時重新啟動。終端機和代理程式會繼續執行。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
