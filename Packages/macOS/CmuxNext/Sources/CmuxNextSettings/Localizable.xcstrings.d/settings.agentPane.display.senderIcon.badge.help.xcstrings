        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "សញ្ញាពណ៌តូចលើរូបតំណាងអ្នកផ្ញើ ដែលបែងចែកវគ្គនៃគ្រួសារម៉ូដែលតែមួយ។"
