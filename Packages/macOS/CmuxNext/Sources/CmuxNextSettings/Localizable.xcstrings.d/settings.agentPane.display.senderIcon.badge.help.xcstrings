        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الرمز الملوّن الصغير على أيقونة المرسل الذي يميّز بين جلسات عائلة النموذج نفسها."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mali obojeni znak na ikoni pošiljaoca koji razlikuje sesije iste porodice modela."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Det lille farvede tegn på en afsenders ikon, der skelner sessioner fra samme modelfamilie."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das kleine farbige Zeichen am Absendersymbol, das Sitzungen derselben Modellfamilie unterscheidet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El pequeño glifo de color en el icono del remitente que distingue las sesiones de una misma familia de modelos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le petit glyphe coloré sur l’icône de l’expéditeur qui distingue les sessions d’une même famille de modèles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
