        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "같은 모델 계열의 세션을 구분하는 발신자 아이콘의 작은 색상 글리프."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Det lille fargede tegnet på et avsenderikon som skiller økter i samme modellfamilie."
