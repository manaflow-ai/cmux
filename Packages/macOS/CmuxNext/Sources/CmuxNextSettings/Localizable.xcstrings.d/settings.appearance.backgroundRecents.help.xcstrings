{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.appearance.backgroundRecents.help" : {
      "comment" : "Settings > Appearance > Window Background: help for the hidden setting that keeps the backgrounds shown before",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الخلفيات المعروضة سابقًا، الأحدث أولًا، للعودة إليها بنقرة واحدة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ranije prikazane pozadine, najnovije prve, da se jednim klikom vratite."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De baggrunde, der blev vist før, nyeste først, så ét klik går tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die zuvor gezeigten Hintergründe, neueste zuerst, damit ein Klick zurückführt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The backgrounds shown before, newest first, so one click goes back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los fondos mostrados antes, el más reciente primero, para volver con un clic."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fonds affichés auparavant, du plus récent au plus ancien, pour revenir en un clic."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli sfondi mostrati prima, dal più recente, per tornare indietro con un clic."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前に表示した背景(新しい順)。クリック1回で戻せます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ផ្ទៃខាងក្រោយដែលបានបង្ហាញពីមុន ថ្មីបំផុតមុនគេ ដើម្បីត្រឡប់ក្រោយដោយចុចតែម្តង។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전에 표시된 배경을 최신순으로 보여 주어 한 번의 클릭으로 되돌아갈 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakgrunnene som ble vist før, nyeste først, så ett klikk går tilbake."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wcześniej wyświetlane tła, od najnowszego, aby wrócić jednym kliknięciem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os fundos mostrados antes, do mais recente, para voltar com um clique."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фоны, показанные раньше, сначала новые, чтобы вернуться одним щелчком."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พื้นหลังที่เคยแสดง เรียงจากล่าสุด เพื่อย้อนกลับได้ในคลิกเดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha önce gösterilen arka planlar, en yenisi önce; tek tıkla geri dönün."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фони, показані раніше, спершу новіші, щоб повернутися одним клацанням."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các hình nền đã hiển thị trước đó, mới nhất trước, để quay lại chỉ bằng một cú nhấp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "之前显示过的背景,最新的在前,点一下即可返回。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "之前顯示過的背景,最新的在前,按一下即可返回。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
