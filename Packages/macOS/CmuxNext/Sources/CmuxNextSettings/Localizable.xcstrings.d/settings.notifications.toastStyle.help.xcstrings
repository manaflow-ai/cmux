{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.notifications.toastStyle.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كيف تظهر الإشعارات المنبثقة والمطالبات: زجاج، أو سطح معتم، أو مسطّحة بحافة رفيعة ومن دون ظل."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kako se prikazuju obavještenja i upiti: staklo, neprozirna površina ili ravno s tankim rubom i bez sjene."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan toasts og prompter tegnes: glas, en uigennemsigtig flade eller flad med en tynd kant og ingen skygge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie Toasts und Abfragen gezeichnet werden: Glas, eine deckende Fläche oder flach mit dünnem Rand ohne Schatten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How toasts and prompts draw: glass, an opaque surface, or flat with a thin edge and no shadow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo se dibujan los avisos y las preguntas: cristal, una superficie opaca o plana con un borde fino y sin sombra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rendu des notifications éphémères et des invites : verre, surface opaque, ou à plat avec un bord fin et sans ombre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come vengono disegnati toast e richieste: vetro, una superficie opaca o piatta con un bordo sottile e senza ombra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トーストとプロンプトの描き方：ガラス、不透明な面、または細い枠線で影のないフラット。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "របៀបដែលសារលេចឡើង និងការសួរត្រូវបានគូរ៖ កញ្ចក់ ផ្ទៃស្រអាប់ ឬរាបស្មើដែលមានគែមស្តើង និងគ្មានស្រមោល។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "토스트와 프롬프트를 그리는 방식: 유리, 불투명한 표면, 또는 얇은 테두리에 그림자 없는 플랫."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan toasts og spørsmål tegnes: glass, en ugjennomsiktig flate eller flatt med en tynn kant og uten skygge."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak rysowane są powiadomienia i monity: szkło, nieprzezroczysta powierzchnia albo płasko z cienką krawędzią i bez cienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como os avisos e as solicitações são desenhados: vidro, uma superfície opaca ou plano com uma borda fina e sem sombra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как рисуются всплывающие уведомления и запросы: стекло, непрозрачная поверхность или плоско, с тонкой рамкой и без тени."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วิธีวาดการแจ้งเตือนแบบโทสต์และพรอมต์: กระจก พื้นผิวทึบ หรือแบบแบนที่มีขอบบางและไม่มีเงา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirim balonlarının ve istemlerin çizimi: cam, opak bir yüzey ya da ince kenarlı ve gölgesiz düz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Як малюються спливні сповіщення та запити: скло, непрозора поверхня або пласко, з тонкою рамкою і без тіні."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cách vẽ thông báo nổi và lời nhắc: kính, bề mặt đục, hoặc phẳng với viền mảnh và không có bóng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示和询问的绘制方式：玻璃、不透明表面，或带细边框、无阴影的扁平样式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示與詢問的繪製方式：玻璃、不透明表面，或帶細邊框、無陰影的扁平樣式。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
