{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.home.chiefEngine.help" : {
      "comment" : "Help of the Engine row (home.chiefEngine). Chief is a product name, keep it untranslated; Home is the app's Home page.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يستخدم الوضع التلقائي Chief جهاز Mac هذا أثناء تشغيله، وإلا فـ Chief المستضاف."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Automatski koristi Chief ovog Maca dok radi, inače hostovani Chief."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Auto bruger denne Macs Chief, mens den kører, ellers den hostede Chief."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Automatisch nutzt den Chief dieses Macs, solange er läuft, sonst den gehosteten Chief."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto uses this Mac's Chief while it runs, else the Hosted Chief."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Automático usa el Chief de este Mac mientras se ejecuta; si no, el Chief alojado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Automatique utilise le Chief de ce Mac tant qu'il s'exécute, sinon le Chief hébergé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Automatico usa il Chief di questo Mac mentre è in esecuzione, altrimenti il Chief ospitato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "自動では、この Mac の Chief が動作中ならそれを、そうでなければホスト型 Chief を使います。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ស្វ័យប្រវត្តិប្រើ Chief របស់ Mac នេះពេលវាកំពុងដំណើរការ បើមិនដូច្នោះទេប្រើ Chief ដែលបង្ហោះ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "자동은 이 Mac의 Chief가 실행 중이면 그것을, 아니면 호스팅 Chief를 사용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Automatisk bruker denne Mac-ens Chief mens den kjører, ellers den driftede Chief."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tryb automatyczny używa Chiefa tego Maca, gdy działa, a w przeciwnym razie hostowanego Chiefa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Automático usa o Chief deste Mac enquanto ele roda; caso contrário, o Chief hospedado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Авто использует Chief этого Mac, пока он работает, иначе размещённый Chief."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "อัตโนมัติจะใช้ Chief ของ Mac เครื่องนี้ขณะที่ทำงานอยู่ หากไม่ใช่จะใช้ Chief ที่โฮสต์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Otomatik, çalışırken bu Mac'in Chief'ini, aksi halde barındırılan Chief'i kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Автоматичний режим використовує Chief цього Mac, поки він працює, інакше розміщений Chief."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tự động dùng Chief của máy Mac này khi nó đang chạy, nếu không thì dùng Chief được lưu trữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "自动：这台 Mac 的 Chief 运行时使用它，否则使用托管的 Chief。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "自動：這台 Mac 的 Chief 執行時使用它，否則使用託管的 Chief。"
          }
        }
      }
