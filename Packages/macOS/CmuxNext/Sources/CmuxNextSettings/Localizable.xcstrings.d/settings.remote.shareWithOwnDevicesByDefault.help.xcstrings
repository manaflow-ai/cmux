    "settings.remote.shareWithOwnDevicesByDefault.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند التشغيل: تعرض أجهزتك الأخرى هذا الـ Mac دون طلب سماح، حتى توقف المشاركة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uključeno: vaši drugi uređaji vide ovaj Mac bez odobrenja, dok ne zaustavite dijeljenje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Til: dine andre enheder ser denne Mac uden Tillad, indtil du stopper deling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein: Deine anderen Geräte sehen diesen Mac ohne Erlauben, bis du das Teilen beendest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On: your other devices view this Mac with no Allow, until you stop sharing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activado: tus otros dispositivos ven este Mac sin Permitir, hasta que dejes de compartir."
