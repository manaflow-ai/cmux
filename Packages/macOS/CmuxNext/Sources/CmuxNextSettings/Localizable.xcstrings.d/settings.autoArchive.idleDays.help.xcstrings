        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Açılmadan ve değişmeden geçen gün sayısı. Sabitlenmiş, çalışan ve bekleyen çalışma alanları hiç arşivlenmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Скільки днів без відкриття й змін. Закріплені, активні й ті, що чекають на вас, робочі простори ніколи не архівуються."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Số ngày không mở và không thay đổi. Không gian đã ghim, đang chạy hoặc đang chờ không bao giờ bị lưu trữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
