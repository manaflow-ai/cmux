{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.experiments.agentBadgesBeam.help" : {
      "comment" : "Settings > Advanced > Experiments: the help line under the Agent Badges running-beam switch",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Agent Badges on, a thin light travels along a sidebar row's edge while its agent runs."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند تشغيل شارات الوكيل، يتحرك ضوء رفيع على حافة صف الشريط الجانبي أثناء عمل وكيله."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad su oznake agenta uključene, tanko svjetlo putuje rubom reda bočne trake dok njegov agent radi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med agentmærker slået til løber et tyndt lys langs kanten af en række i sidebjælken, mens dens agent kører."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei aktiven Agent-Badges läuft ein feines Licht am Rand einer Seitenleistenzeile entlang, solange ihr Agent arbeitet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con las insignias de agente activadas, una luz fina recorre el borde de una fila de la barra lateral mientras su agente trabaja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec les badges d’agent activés, une fine lumière parcourt le bord d’une ligne de la barre latérale pendant que son agent travaille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con i badge dell’agente attivi, una luce sottile scorre lungo il bordo di una riga della barra laterale mentre il suo agente lavora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントバッジがオンのとき、エージェントの実行中はサイドバーの行の縁を細い光が流れます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ពេលបើកស្លាកភ្នាក់ងារ ពន្លឺស្តើងរត់តាមគែមជួរនៅរបារចំហៀង ខណៈភ្នាក់ងាររបស់វាកំពុងដំណើរការ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트 배지가 켜져 있으면 에이전트가 실행되는 동안 사이드바 행의 가장자리를 따라 가는 빛이 흐릅니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med agentmerker på går et tynt lys langs kanten av en rad i sidefeltet mens agenten kjører."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy plakietki agenta są włączone, cienkie światło biegnie wzdłuż krawędzi wiersza paska bocznego, dopóki agent pracuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com os selos do agente ativados, uma luz fina percorre a borda de uma linha da barra lateral enquanto o agente trabalha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда значки агента включены, вдоль края строки боковой панели бежит тонкий свет, пока работает её агент."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิดป้ายเอเจนต์ แสงบางๆ จะวิ่งไปตามขอบแถวในแถบข้างขณะที่เอเจนต์ของแถวนั้นทำงาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajan rozetleri açıkken, ajanı çalıştığı sürece kenar çubuğu satırının kenarında ince bir ışık dolaşır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли значки агента ввімкнено, уздовж краю рядка бічної панелі біжить тонке світло, поки працює його агент."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật huy hiệu tác tử, một vệt sáng mảnh chạy dọc mép hàng ở thanh bên trong lúc tác tử của hàng đó chạy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启智能体徽章后,智能体运行期间,一道细光会沿侧边栏行的边缘移动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟代理程式徽章後,代理程式執行期間,一道細光會沿側邊欄列的邊緣移動。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
