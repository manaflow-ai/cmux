      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ينهي الصدفات الخاملة في مساحات العمل غير المستخدمة طويلًا؛ وتبدأ من جديد في المجلد نفسه."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Završava neaktivne shellove dugo nekorištenih radnih prostora; ponovo se pokreću u istoj mapi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Afslutter inaktive shells i længe ubrugte arbejdsområder; de starter igen i samme mappe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beendet inaktive Shells lange ungenutzter Workspaces; sie starten im selben Ordner neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ends idle shells of long-unused workspaces; they restart in the same folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cierra los shells inactivos de espacios sin usar desde hace tiempo; se reinician en la misma carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Termine les shells inactifs des espaces inutilisés depuis longtemps ; ils redémarrent dans le même dossier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chiude le shell inattive degli spazi di lavoro inutilizzati da molto; ripartono nella stessa cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "長く使っていないワークスペースのアイドル状態のシェルを終了します。同じフォルダで再起動します。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "បញ្ចប់ shell ទំនេរនៃកន្លែងធ្វើការដែលមិនបានប្រើយូរ; ពួកវាចាប់ផ្តើមឡើងវិញក្នុងថតដដែល។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "오래 사용하지 않은 워크스페이스의 유휴 셸을 종료합니다. 같은 폴더에서 다시 시작됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Avslutter inaktive skall i arbeidsområder som ikke er brukt på lenge; de starter igjen i samme mappe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kończy bezczynne powłoki dawno nieużywanych obszarów; uruchamiają się ponownie w tym samym folderze."
