{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.labs.askLedger.help" : {
      "comment" : "Settings > Advanced > Labs: opt-in local ask ledger. Changes apply after restart.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep your chat requests on this Mac and link them to pull requests in History. Takes effect after cmux restarts."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتفظ بطلبات المحادثة على هذا الـ Mac واربطها بطلبات السحب في السجل. يسري بعد إعادة تشغيل cmux."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čuvajte zahtjeve iz razgovora na ovom Macu i povežite ih sa zahtjevima za spajanje u historiji. Primjenjuje se nakon ponovnog pokretanja cmuxa."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem dine chatanmodninger på denne Mac, og knyt dem til pull requests i Historik. Træder i kraft efter genstart af cmux."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chat-Anfragen auf diesem Mac speichern und im Verlauf mit Pull Requests verknüpfen. Wird nach einem Neustart von cmux wirksam."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda tus solicitudes de chat en este Mac y vincúlalas a solicitudes de incorporación en el historial. Se aplica al reiniciar cmux."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservez vos demandes de chat sur ce Mac et associez-les aux pull requests dans l’historique. Prend effet après le redémarrage de cmux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva le richieste della chat su questo Mac e collegale alle pull request nella cronologia. Ha effetto dopo il riavvio di cmux."
