{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.agentPane.display.pinnedPlan.help" : {
      "comment" : "Settings > Appearance > Agent Chat > Pin Task List in Chat: help for the toggle",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يُبقي قائمة مهام الوكيل أسفل آخر رسالة، وليس فوق محرر الرسائل."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Drži listu zadataka agenta ispod najnovije poruke, a ne iznad polja za pisanje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Holder agentens opgaveliste under den seneste besked, ikke over skrivefeltet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hält die Aufgabenliste des Agenten unter der neuesten Nachricht statt über dem Eingabefeld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps the agent's task list under the latest message, not over the composer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantiene la lista de tareas del agente bajo el último mensaje, no sobre el editor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Garde la liste des tâches de l'agent sous le dernier message, et non au-dessus de la zone de saisie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantiene l'elenco delle attività dell'agente sotto l'ultimo messaggio, non sopra il compositore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "エージェントのタスクリストを入力欄の上ではなく、最新メッセージの下に表示します。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "រក្សាបញ្ជីកិច្ចការរបស់ភ្នាក់ងារនៅក្រោមសារចុងក្រោយ មិនមែននៅលើប្រអប់សរសេរទេ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "에이전트의 작업 목록을 입력창 위가 아닌 최신 메시지 아래에 둡니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Holder agentens oppgaveliste under den nyeste meldingen, ikke over skrivefeltet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utrzymuje listę zadań agenta pod najnowszą wiadomością, a nie nad polem tworzenia."
