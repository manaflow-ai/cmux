{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.appearance.accentGlow.light.help" : {
      "comment" : "Settings row help for the light accent glow color.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The glow's color in the light appearance. Unset, the dark color."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لون التوهج في المظهر الفاتح. إذا لم يُحدَّد، يُستخدم اللون الداكن."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boja sjaja u svijetlom izgledu. Ako nije postavljeno, koristi se tamna boja."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glødens farve i det lyse udseende. Hvis den ikke er angivet, bruges den mørke farve."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Farbe des Leuchtens im hellen Erscheinungsbild. Nicht gesetzt: die dunkle Farbe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El color del resplandor en la apariencia clara. Sin definir, el color oscuro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La couleur du halo en apparence claire. Non définie : la couleur sombre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il colore del bagliore nell'aspetto chiaro. Se non impostato, il colore scuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライト表示でのグローの色です。未設定ならダークの色を使います。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ពណ៌នៃពន្លឺរះក្នុងរូបរាងភ្លឺ។ ពេលមិនបានកំណត់ ប្រើពណ៌ងងឹត។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이트 모드에서의 광채 색상입니다. 설정하지 않으면 다크 색상을 씁니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glødens farge i det lyse utseendet. Hvis den ikke er angitt, brukes den mørke fargen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolor poświaty w jasnym wyglądzie. Gdy nie ustawiono, używany jest kolor ciemny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cor do brilho na aparência clara. Se não definido, a cor escura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цвет свечения в светлом оформлении. Если не задано, используется тёмный цвет."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สีของแสงเรืองในลักษณะที่ปรากฏแบบสว่าง หากไม่ได้ตั้งค่า จะใช้สีของโหมดมืด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açık görünümde parıltının rengi. Ayarlanmazsa koyu renk kullanılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Колір сяйва у світлому вигляді. Якщо не задано, використовується темний колір."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Màu quầng sáng trong giao diện sáng. Khi chưa đặt, dùng màu tối."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浅色外观中的光晕颜色。未设置时使用深色的颜色。"
