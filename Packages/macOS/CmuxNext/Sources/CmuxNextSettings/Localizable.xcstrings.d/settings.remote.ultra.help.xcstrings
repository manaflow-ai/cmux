        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Šalje podatke za popravak da mreže koje gube pakete ostanu brze. Uvijek troši 2 do 3 puta više podataka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sender reparationsdata, så netværk med pakketab forbliver hurtige. Altid bruger 2 til 3 gange dataene."
