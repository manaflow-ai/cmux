        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sendet Reparaturdaten, damit verlustbehaftete Netzwerke schnell bleiben. Immer nutzt 2- bis 3-mal so viele Daten."
          }
        },
