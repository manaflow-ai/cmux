        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "បញ្ឈប់ការស្រអាប់គែមរបារចំហៀង ហើយលាក់របារប្រវត្តិរូប និងស្វែងរកនៅខាងក្រោម។"
