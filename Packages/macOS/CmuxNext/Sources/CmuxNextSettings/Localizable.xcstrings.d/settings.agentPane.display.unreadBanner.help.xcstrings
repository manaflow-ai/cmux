        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "បដាសម្រាប់វេនថ្មី នៅពេលអ្នកត្រឡប់ទៅការជជែក។ ចុចកណ្ដុរស្ដាំលើវាដើម្បីលាក់វា។"
