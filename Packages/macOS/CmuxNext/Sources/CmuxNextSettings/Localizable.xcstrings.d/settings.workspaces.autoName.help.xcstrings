        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Et unavngivet arbejdsområde viser navnet på sin forreste fane. Dit eget navn vinder altid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein unbenannter Arbeitsbereich zeigt den Namen seines vorderen Tabs. Dein eigener Name hat immer Vorrang."
