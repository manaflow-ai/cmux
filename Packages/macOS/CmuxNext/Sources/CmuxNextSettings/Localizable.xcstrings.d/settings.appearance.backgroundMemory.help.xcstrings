{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.appearance.backgroundMemory.help" : {
      "comment" : "Settings > Appearance > Window Background: help of the hidden setting that keeps each background mode's last folder and picture",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The folder and picture each background mode last showed, so switching back restores them."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المجلد والصورة اللذان عرضهما كل وضع خلفية آخر مرة، لتستعيدهما عند الرجوع إليه."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa i slika koje je svaki način pozadine posljednje prikazao, da ih povratak vrati."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den mappe og det billede hver baggrundstilstand sidst viste, så de vender tilbage, når du skifter tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordner und Bild, die jeder Hintergrundmodus zuletzt zeigte, damit sie beim Zurückwechseln wiederkommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carpeta y la imagen que mostró por última vez cada modo de fondo, para recuperarlas al volver."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dossier et l’image que chaque mode d’arrière-plan a montrés en dernier, rétablis quand vous y revenez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cartella e l’immagine mostrate per ultime da ogni modalità di sfondo, ripristinate quando ci torni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各背景モードが最後に表示したフォルダと画像。モードを戻すと復元されます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ថតនិងរូបភាពដែលរបៀបផ្ទៃខាងក្រោយនីមួយៗបានបង្ហាញចុងក្រោយ ដើម្បីស្ដារវាវិញពេលប្ដូរត្រឡប់។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 배경 모드가 마지막으로 보여 준 폴더와 그림으로, 다시 전환하면 복원됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappen og bildet hver bakgrunnsmodus sist viste, så de kommer tilbake når du bytter tilbake."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder i obraz, które każdy tryb tła pokazał ostatnio, aby powrót do trybu je przywracał."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pasta e a imagem que cada modo de fundo mostrou por último, restauradas ao voltar a ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка и изображение, которые каждый режим фона показывал последними, чтобы вернуть их при возврате."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โฟลเดอร์และรูปภาพที่แต่ละโหมดพื้นหลังแสดงล่าสุด เพื่อกู้คืนเมื่อสลับกลับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her arka plan modunun en son gösterdiği klasör ve resim; moda geri dönünce geri gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тека та зображення, які кожен режим тла показував останніми, щоб повернути їх під час повернення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thư mục và ảnh mà mỗi chế độ nền hiển thị lần cuối, để khôi phục khi chuyển lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每种背景模式上次显示的文件夹和图片，切换回来时会恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每種背景模式上次顯示的資料夾和圖片，切換回來時會還原。"
          }
        }
      }
    }
  },
  "version" : "1.0"
