{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.cloud.defaultImage.help" : {
      "comment" : "Help for the Default Image menu: which Cloud environment new Cloud chats start from, and what Auto does.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Cloud environment new Cloud chats start from. Auto picks one from the chat's repository. Any other environment gives each new chat its own machine."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بيئة Cloud التي تبدأ منها محادثات Cloud الجديدة. يختار التلقائي واحدة من مستودع المحادثة. أي بيئة أخرى تمنح كل محادثة جديدة جهازها الخاص."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cloud okruženje iz kojeg počinju novi Cloud razgovori. Automatski bira jedno prema repozitoriju razgovora. Svako drugo okruženje daje svakom novom razgovoru vlastitu mašinu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Det Cloud-miljø, nye Cloud-chats starter fra. Auto vælger et ud fra chattens repository. Ethvert andet miljø giver hver ny chat sin egen maskine."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Cloud-Umgebung, in der neue Cloud-Chats starten. Automatisch wählt eine anhand des Repositorys des Chats. Jede andere Umgebung gibt jedem neuen Chat eine eigene Maschine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El entorno de Cloud desde el que empiezan los chats nuevos en Cloud. Automático elige uno según el repositorio del chat. Cualquier otro entorno da a cada chat nuevo su propia máquina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'environnement Cloud à partir duquel démarrent les nouvelles discussions Cloud. Auto en choisit un selon le dépôt de la discussion. Tout autre environnement donne à chaque nouvelle discussion sa propre machine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'ambiente Cloud da cui partono le nuove chat Cloud. Auto ne sceglie uno in base al repository della chat. Qualsiasi altro ambiente dà a ogni nuova chat una propria macchina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "新しいクラウドチャットを開始するクラウド環境。自動ではチャットのリポジトリから選びます。 それ以外の環境では、新しいチャットごとに専用のマシンを使います。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "បរិស្ថាន Cloud ដែលការជជែក Cloud ថ្មីចាប់ផ្តើមពី។ ស្វ័យប្រវត្តិជ្រើសរើសមួយពីឃ្លាំងរបស់ការជជែក។ បរិស្ថានផ្សេងទៀតផ្តល់ម៉ាស៊ីនផ្ទាល់ខ្លួនដល់ការជជែកថ្មីនីមួយៗ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "새 클라우드 채팅이 시작되는 클라우드 환경입니다. 자동은 채팅의 저장소에서 하나를 고릅니다. 다른 환경을 고르면 새 채팅마다 전용 머신을 씁니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cloud-miljøet nye Cloud-chatter starter fra. Auto velger ett ut fra chattens repository. Ethvert annet miljø gir hver ny chat sin egen maskin."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Środowisko Cloud, z którego startują nowe czaty Cloud. Automatycznie wybiera je na podstawie repozytorium czatu. Każde inne środowisko daje każdemu nowemu czatowi własną maszynę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O ambiente Cloud em que novos chats na nuvem começam. Automático escolhe um pelo repositório do chat. Qualquer outro ambiente dá a cada novo chat sua própria máquina."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Облачное окружение, с которого начинаются новые облачные чаты. Авто выбирает его по репозиторию чата. Любое другое окружение даёт каждому новому чату свою машину."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "สภาพแวดล้อม Cloud ที่แชต Cloud ใหม่เริ่มต้น อัตโนมัติจะเลือกจากรีโพสิทอรีของแชต สภาพแวดล้อมอื่นจะให้แชตใหม่แต่ละรายการมีเครื่องของตัวเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yeni Cloud sohbetlerinin başladığı Cloud ortamı. Otomatik, sohbetin deposuna göre birini seçer. Başka bir ortam her yeni sohbete kendi makinesini verir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Хмарне середовище, з якого починаються нові хмарні чати. Авто вибирає його за репозиторієм чату. Будь-яке інше середовище дає кожному новому чату власну машину."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Môi trường Cloud mà các cuộc trò chuyện Cloud mới bắt đầu từ đó. Tự động chọn một môi trường theo kho mã của cuộc trò chuyện. Mọi môi trường khác cho mỗi cuộc trò chuyện mới một máy riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "新的云端聊天所使用的云端环境。自动会根据聊天的仓库选择一个。 选择其他环境时，每个新聊天都有自己的机器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "新的雲端聊天所使用的雲端環境。自動會依聊天的儲存庫選擇一個。 選擇其他環境時，每個新聊天都有自己的機器。"
          }
        }
      }
    }
