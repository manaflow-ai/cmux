{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.appearance.toolbarButtonActiveFill.help" : {
      "comment" : "Settings > Appearance: a look's layout and proportions (appearance.metrics)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How strong the fill under a toolbar button that is on draws, as a share of the text color. Unset is the hover fill."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wie kräftig die Füllung unter einer eingeschalteten Symbolleistentaste ist, als Anteil der Textfarbe. Ohne Wert die Hover-Füllung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’intensité du fond sous un bouton de barre d’outils activé, en part de la couleur du texte. Sans valeur, le fond de survol."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مدى قوة التعبئة تحت زر شريط الأدوات المفعّل، كنسبة من لون النص. بلا قيمة تُستخدم تعبئة التمرير."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La intensidad del relleno bajo un botón activado de la barra de herramientas, como parte del color del texto. Sin valor, el relleno al pasar."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "開啟中的工具列按鈕下方填色的強度，以文字顏色的比例表示。未設定時為懸停填色。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "开启中的工具栏按钮下方填充的强度，以文字颜色的比例表示。未设置时为悬停填充。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "켜진 도구 막대 버튼 아래 채우기의 강도로, 텍스트 색의 비율입니다. 설정하지 않으면 호버 채우기입니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "オンになっているツールバーボタンの下の塗りの強さ（文字色に対する割合）。未設定ならホバーの塗りです。"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jačina ispune ispod uključenog dugmeta alatne trake, kao udio boje teksta. Bez vrijednosti ispuna pri prelasku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hvor kraftig udfyldningen under en tændt værktøjslinjeknap er, som andel af tekstfarven. Uden værdi hover-udfyldningen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’intensità del riempimento sotto un pulsante attivo della barra strumenti, come quota del colore del testo. Se non impostato, quello al passaggio."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "កម្លាំងផ្ទៃពណ៌ក្រោមប៊ូតុងរបារឧបករណ៍ដែលបើក ជាភាគនៃពណ៌អក្សរ។ បើមិនកំណត់ គឺផ្ទៃពណ៌ពេលដាក់ព្រួញ។"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hvor kraftig fyllet under en påslått verktøylinjeknapp er, som andel av tekstfargen. Uten verdi pekerfyllet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Siła wypełnienia pod włączonym przyciskiem paska narzędzi jako część koloru tekstu. Bez wartości wypełnienie po najechaniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A intensidade do preenchimento sob um botão ligado da barra de ferramentas, como parte da cor do texto. Sem valor, o preenchimento ao passar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Насколько сильна заливка под включённой кнопкой панели инструментов, как доля цвета текста. Без значения — заливка при наведении."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ความเข้มของพื้นใต้ปุ่มแถบเครื่องมือที่เปิดอยู่ เป็นสัดส่วนของสีข้อความ หากไม่ตั้งค่า จะใช้พื้นเมื่อชี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Açık bir araç çubuğu düğmesinin altındaki dolgunun gücü, metin renginin payı olarak. Ayarlanmazsa üzerine gelme dolgusu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Наскільки сильна заливка під увімкненою кнопкою панелі інструментів, як частка кольору тексту. Без значення — заливка при наведенні."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Độ đậm của phần tô dưới nút thanh công cụ đang bật, theo tỷ lệ màu chữ. Nếu không đặt, là phần tô khi di chuột."
          }
        }
      }
    }
