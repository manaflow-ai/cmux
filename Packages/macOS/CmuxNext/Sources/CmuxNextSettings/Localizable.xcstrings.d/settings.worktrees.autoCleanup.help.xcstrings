  "strings" : {
    "settings.worktrees.autoCleanup.help" : {
      "comment" : "Settings > General > Storage: help for the Clean Up Agent Worktrees toggle. Unpushed commits stay in the repository and the worktree is restored when its chat is opened again.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archive and remove worktrees agents finished with, and trim the build output of idle ones. Unpushed work is kept in git and comes back when the chat reopens."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يؤرشف worktrees التي أنهى الوكلاء العمل عليها ويزيلها، ويقلّص مخرجات البناء للخاملة منها. يُحفظ العمل غير المدفوع في git ويعود عند إعادة فتح الدردشة."
          }
        },
        "bs" : {
          "stringUnit" : {
