        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "شريط العنوان وشريط علامات التبويب والشريط الجانبي بلون المحتوى، أو مظللة لتتميز عنه."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Naslovna traka, traka s karticama i bočna traka u boji sadržaja ili zasebno zasjenjene."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Titellinjen, fanelinjen og sidepanelet i indholdets farve eller skygget fra det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Titelleiste, Tableiste und Seitenleiste in der Farbe des Inhalts oder davon abgesetzt schattiert."
