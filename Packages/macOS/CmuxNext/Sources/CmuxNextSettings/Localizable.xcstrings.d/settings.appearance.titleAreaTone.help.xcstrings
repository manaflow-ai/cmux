        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La barra de título, la barra de pestañas y la barra lateral con el color del contenido, o sombreadas aparte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La barre de titre, la barre d’onglets et la barre latérale dans la couleur du contenu, ou ombrées à part."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Barra del titolo, barra delle schede e barra laterale nel colore del contenuto, o ombreggiate a parte."
