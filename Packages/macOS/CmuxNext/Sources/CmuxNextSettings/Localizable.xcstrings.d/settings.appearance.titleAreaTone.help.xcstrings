    "settings.appearance.titleAreaTone.help" : {
      "comment" : "Help under the Title Area setting; 'Two Tones' and 'One Color' are its two choices.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The title bar, tab bar and sidebar in the content's color, or shaded apart."
