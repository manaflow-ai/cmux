        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "タイトルバー、タブバー、サイドバーをコンテンツと同じ色で描くか、陰影で区別するか。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "របារចំណងជើង របារផ្ទាំង និងរបារចំហៀង ជាពណ៌នៃខ្លឹមសារ ឬងងឹតដាច់ពីខ្លឹមសារ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "제목 막대, 탭 막대, 사이드바를 콘텐츠와 같은 색으로 그리거나 다른 음영으로 구분합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tittellinjen, fanelinjen og sidefeltet i innholdets farge, eller skyggelagt fra det."
