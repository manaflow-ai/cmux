        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ចន្លោះពីជ្រុងប្រអប់សរសេរជជែក ទៅអក្សរ និងការគ្រប់គ្រង។ បើមិនកំណត់ ប្រើតម្លៃនៃដង់ស៊ីតេ។"
