      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The room from the chat prompt box's sides to its text and controls. Unset is the density's."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Raum von den Seiten des Chat-Eingabefelds bis zu Text und Bedienelementen. Ohne Wert gilt die Dichte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’espace entre les côtés du champ de saisie du chat et son texte et ses commandes. Sans valeur, celui de la densité."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "المسافة من جانبي مربع الكتابة في الدردشة إلى نصه وعناصر التحكم. بلا قيمة تُستخدم قيمة الكثافة."
