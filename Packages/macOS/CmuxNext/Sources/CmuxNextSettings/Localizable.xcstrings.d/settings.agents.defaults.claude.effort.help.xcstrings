        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいチャットがどれだけ深く考えるか。「前回の設定」は最後に選んだ推論量を使います。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "កម្រិតដែលការជជែកថ្មីគិត។ ប្រើចុងក្រោយ រក្សាកម្រិតការខិតខំដែលអ្នកបានជ្រើសចុងក្រោយ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 채팅이 얼마나 깊이 생각할지 정합니다. 마지막 사용은 마지막으로 고른 노력 수준을 유지합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor grundig en ny chat tenker. Sist brukt beholder innsatsen du valgte sist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak intensywnie myśli nowy czat. Ostatnio używany zachowuje ostatnio wybrany wysiłek."
