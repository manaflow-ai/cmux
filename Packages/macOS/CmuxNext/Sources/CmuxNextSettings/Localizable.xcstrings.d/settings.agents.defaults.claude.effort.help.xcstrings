      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How hard a new chat thinks. Last Used keeps the last effort you picked."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدى عمق تفكير المحادثة الجديدة. «آخر ما استُخدم» يُبقي آخر مستوى اخترته."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koliko novi chat razmišlja. Posljednje korišteno zadržava posljednji napor koji ste odabrali."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor grundigt en ny chat tænker. Senest brugt beholder den indsats, du sidst valgte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie gründlich ein neuer Chat nachdenkt. „Zuletzt verwendet“ behält den zuletzt gewählten Aufwand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto piensa un chat nuevo. Último usado conserva el último esfuerzo que elegiste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’intensité de réflexion d’une nouvelle discussion. Dernier utilisé garde le dernier effort choisi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto ragiona una nuova chat. Ultimo usato mantiene l’ultimo impegno scelto."
