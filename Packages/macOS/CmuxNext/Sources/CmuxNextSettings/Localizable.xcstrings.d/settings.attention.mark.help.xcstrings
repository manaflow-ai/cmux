{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.attention.mark.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How a tab and a sidebar row that wait for you show it: the badge, or a gentle glow until you look at them."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كيف تُظهر علامة التبويب وصف الشريط الجانبي أنهما بانتظارك: الشارة، أو توهّج هادئ حتى تنظر إليهما."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie ein Tab und eine Seitenleistenzeile zeigen, dass sie auf dich warten: mit dem Abzeichen oder einem sanften Leuchten, bis du sie ansiehst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo muestran una pestaña y una fila de la barra lateral que te esperan: con la insignia o con un brillo suave hasta que las mires."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment un onglet et une ligne de la barre latérale qui vous attendent le montrent : le badge, ou une douce lueur jusqu’à ce que vous les regardiez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対応待ちのタブとサイドバーの行の示し方：バッジ、または見るまでやさしく光る表示。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확인이 필요한 탭과 사이드바 행을 표시하는 방식: 배지, 또는 확인할 때까지 은은하게 빛나기."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待你的标签页和侧边栏行如何显示：使用标记，或在你查看前柔和地发光。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待你的分頁與側邊欄列如何顯示：使用標記，或在你查看前柔和地發光。"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kako kartica i red u bočnoj traci koji vas čekaju to pokazuju: značkom ili blagim sjajem dok ih ne pogledate."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan en fane og en række i sidepanelet, der venter på dig, viser det: mærket eller en blid glød, indtil du kigger på dem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come lo mostrano una scheda e una riga della barra laterale che aspettano te: il badge o un leggero bagliore finché non le guardi."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "របៀបដែលផ្ទាំង និងជួរនៅរបារចំហៀងដែលកំពុងរង់ចាំអ្នកបង្ហាញវា៖ ស្លាក ឬពន្លឺស្រាលៗរហូតដល់អ្នកមើលវា។"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan en fane og en rad i sidepanelet som venter på deg viser det: merket eller en mild glød til du ser på dem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak karta i wiersz paska bocznego, które czekają na ciebie, to pokazują: plakietką albo delikatną poświatą, dopóki na nie nie spojrzysz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como uma aba e uma linha da barra lateral que esperam por você mostram isso: o selo ou um brilho suave até você olhar para elas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как это показывают вкладка и строка боковой панели, которые ждут вас: значком или мягким свечением, пока вы на них не посмотрите."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วิธีที่แท็บและแถวในแถบด้านข้างที่รอคุณอยู่แสดงสิ่งนี้: ป้าย หรือแสงเรืองอ่อนๆ จนกว่าคุณจะมองดู"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sizi bekleyen bir sekme ve kenar çubuğu satırı bunu nasıl gösterir: rozetle ya da siz bakana kadar hafif bir parıltıyla."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Як це показують вкладка й рядок бічної панелі, що чекають на вас: значком або м’яким світінням, доки ви на них не подивитеся."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cách một thẻ và một hàng ở thanh bên đang chờ bạn thể hiện điều đó: huy hiệu, hoặc ánh sáng dịu cho đến khi bạn nhìn vào."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
