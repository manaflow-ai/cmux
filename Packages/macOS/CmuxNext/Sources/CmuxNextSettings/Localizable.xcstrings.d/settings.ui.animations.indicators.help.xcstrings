{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.ui.animations.indicators.help" : {
      "comment" : "Settings > Appearance > Motion: the help text under a motion switch (ui.animations.*).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تدور مؤشرات الانتظار وتنبض نقاط الحالة وتومض تنبيهات الانتباه."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Indikatori učitavanja se okreću, tačke statusa pulsiraju, a upozorenja trepere."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spinnere drejer, statusprikker pulserer og opmærksomhedsblink blinker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ladeanzeigen drehen sich, Statuspunkte pulsieren und Hinweisblitze blinken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spinners turn, status dots pulse and attention flashes blink."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los indicadores de carga giran, los puntos de estado laten y los avisos parpadean."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les indicateurs de chargement tournent, les points d’état pulsent et les alertes clignotent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gli indicatori di caricamento ruotano, i punti di stato pulsano e gli avvisi lampeggiano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "スピナーが回転し、状態ドットが脈打ち、注意の点滅が光ります。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "សញ្ញាផ្ទុកបង្វិល ចំណុចស្ថានភាពលោតញ័រ និងការព្រមានភ្លឹបភ្លែត។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "스피너가 회전하고 상태 점이 깜박이며 주의 표시가 반짝입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spinnere snurrer, statusprikker pulserer og varselblink blinker."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wskaźniki ładowania się obracają, kropki stanu pulsują, a alerty migają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Indicadores de carregamento giram, pontos de status pulsam e alertas piscam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Индикаторы загрузки вращаются, точки состояния пульсируют, а предупреждения мигают."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ตัวหมุนจะหมุน จุดสถานะจะกะพริบเป็นจังหวะ และการแจ้งเตือนจะกะพริบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yükleme göstergeleri döner, durum noktaları atar ve uyarılar yanıp söner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Індикатори завантаження обертаються, точки стану пульсують, а попередження блимають."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vòng xoay quay, chấm trạng thái nhấp nháy theo nhịp và cảnh báo chớp sáng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "加载指示器旋转，状态点脉动，提醒闪烁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "載入指示器旋轉，狀態點脈動，提醒閃爍。"
          }
        }
      }
    }
  },
  "version" : "1.0"
