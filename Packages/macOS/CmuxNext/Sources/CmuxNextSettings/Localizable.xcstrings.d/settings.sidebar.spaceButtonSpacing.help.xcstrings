{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.sidebar.spaceButtonSpacing.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distance between the centers of neighboring Space buttons. The density default fits them to the sidebar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隣り合うスペースボタンの中心間の距離です。密度の既定値ではサイドバーの幅に合わせて調整されます。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المسافة بين مركزي زري مساحتين متجاورتين. تضبط القيمة الافتراضية للكثافة التباعد ليلائم الشريط الجانبي."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udaljenost između središta susjednih dugmadi prostora. Zadana gustoća prilagođava razmak bočnoj traci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afstanden mellem midtpunkterne af to områdeknapper ved siden af hinanden. Standardværdien for tætheden tilpasser afstanden til sidepanelet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abstand zwischen den Mittelpunkten benachbarter Bereichsschaltflächen. Der Standardwert für die Dichte passt den Abstand an die Seitenleiste an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distancia entre los centros de dos botones de espacios contiguos. El valor predeterminado de densidad ajusta el espaciado al ancho de la barra lateral."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distance entre les centres de deux boutons d’espace voisins. La valeur par défaut de la densité adapte l’espacement à la barre latérale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distanza tra i centri di due pulsanti degli spazi adiacenti. Il valore predefinito della densità adatta la spaziatura alla barra laterale."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ចម្ងាយរវាងចំណុចកណ្ដាលនៃប៊ូតុងលំហពីរដែលនៅជាប់គ្នា។ តម្លៃដង់ស៊ីតេលំនាំដើមកែគម្លាតឱ្យសមនឹងរបារចំហៀង។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이웃한 공간 버튼의 중심 사이 거리입니다. 밀도 기본값을 사용하면 사이드바 너비에 맞춰 간격이 조정됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avstanden mellom midtpunktene til to områdeknapper ved siden av hverandre. Standardverdien for tetthet tilpasser avstanden til sidepanelet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odległość między środkami sąsiednich przycisków przestrzeni. Domyślna gęstość dopasowuje odstępy do szerokości paska bocznego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distância entre os centros de dois botões de espaços vizinhos. O valor padrão de densidade adapta o espaçamento à barra lateral."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расстояние между центрами соседних кнопок пространств. При стандартной плотности интервал подстраивается под ширину боковой панели."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระยะระหว่างจุดกึ่งกลางของปุ่มพื้นที่ที่อยู่ติดกัน ค่าเริ่มต้นของความหนาแน่นจะปรับระยะห่างให้พอดีกับแถบด้านข้าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komşu alan düğmelerinin merkezleri arasındaki uzaklık. Varsayılan yoğunluk değeri aralığı kenar çubuğuna sığacak şekilde ayarlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відстань між центрами сусідніх кнопок просторів. За стандартної щільності інтервал підлаштовується під ширину бічної панелі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khoảng cách giữa tâm của hai nút không gian liền kề. Giá trị mật độ mặc định điều chỉnh khoảng cách cho vừa với thanh bên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相邻空间按钮中心之间的距离。使用密度默认值时，间距会随侧边栏宽度调整。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相鄰空間按鈕中心之間的距離。使用密度預設值時，間距會隨側邊欄寬度調整。"
          }
        }
      }
    }
  },
  "version" : "1.0"
