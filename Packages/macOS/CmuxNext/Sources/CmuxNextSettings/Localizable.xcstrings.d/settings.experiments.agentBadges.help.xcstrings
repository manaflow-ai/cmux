{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.experiments.agentBadges.help" : {
      "comment" : "Settings > Advanced > Experiments: the help line under the Agent Badges switch. Running, Needs approval and Done are the pill's three labels.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent tabs show a count of unread messages and approvals, and sidebar rows show a status pill: Running, Needs approval or Done."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعرض علامات تبويب الوكيل عدد الرسائل غير المقروءة والموافقات، وتعرض صفوف الشريط الجانبي شارة حالة: قيد التشغيل أو بانتظار الموافقة أو تم."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartice agenta prikazuju broj nepročitanih poruka i odobrenja, a redovi bočne trake oznaku stanja: Radi, Čeka odobrenje ili Gotovo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agentfaner viser et antal ulæste beskeder og godkendelser, og rækker i sidebjælken viser en status: Kører, Afventer godkendelse eller Færdig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent-Tabs zeigen die Zahl ungelesener Nachrichten und Freigaben, Seitenleistenzeilen eine Status-Pille: Läuft, Freigabe nötig oder Fertig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pestañas de agente muestran un recuento de mensajes sin leer y aprobaciones, y las filas de la barra lateral un estado: En curso, Requiere aprobación o Listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les onglets d’agent affichent le nombre de messages non lus et d’approbations, et les lignes de la barre latérale un statut : En cours, Approbation requise ou Terminé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le schede dell’agente mostrano il numero di messaggi non letti e approvazioni, e le righe della barra laterale uno stato: In corso, Serve approvazione o Fatto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントのタブに未読メッセージと承認待ちの数を、サイドバーの行に状態(実行中、承認が必要、完了)を表示します。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ផ្ទាំងភ្នាក់ងារបង្ហាញចំនួនសារមិនទាន់អាន និងការអនុម័ត ហើយជួរនៅរបារចំហៀងបង្ហាញស្ថានភាព៖ កំពុងដំណើរការ ត្រូវការការអនុម័ត ឬរួចរាល់។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트 탭에 읽지 않은 메시지와 승인 수를, 사이드바 행에 상태(실행 중, 승인 필요, 완료)를 표시합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agentfaner viser antall uleste meldinger og godkjenninger, og rader i sidefeltet viser en status: Kjører, Trenger godkjenning eller Ferdig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karty agenta pokazują liczbę nieprzeczytanych wiadomości i zatwierdzeń, a wiersze paska bocznego stan: Działa, Wymaga zatwierdzenia lub Gotowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As abas do agente mostram a contagem de mensagens não lidas e aprovações, e as linhas da barra lateral um status: Em execução, Precisa de aprovação ou Concluído."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вкладки агента показывают число непрочитанных сообщений и запросов на одобрение, а строки боковой панели — статус: Работает, Нужно одобрение или Готово."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แท็บเอเจนต์แสดงจำนวนข้อความที่ยังไม่อ่านและการอนุมัติ และแถวในแถบข้างแสดงสถานะ: กำลังทำงาน ต้องอนุมัติ หรือเสร็จแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajan sekmeleri okunmamış mesaj ve onay sayısını, kenar çubuğu satırları bir durum gösterir: Çalışıyor, Onay gerekiyor veya Bitti."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вкладки агента показують кількість непрочитаних повідомлень і запитів на схвалення, а рядки бічної панелі — статус: Працює, Потрібне схвалення або Готово."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các tab tác tử hiện số tin nhắn chưa đọc và yêu cầu phê duyệt, còn các hàng ở thanh bên hiện trạng thái: Đang chạy, Cần phê duyệt hoặc Xong."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能体标签页显示未读消息和待批准的数量,侧边栏行显示状态:运行中、需要批准或已完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代理程式分頁顯示未讀訊息與待核准的數量,側邊欄列顯示狀態:執行中、需要核准或已完成。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
