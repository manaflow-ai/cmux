    "settings.agents.autoSettle.onClose.help" : {
      "comment" : "Settings > Agents > Settle Chats: help for the settle-on-close toggle",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves a chat to Settled once every pull request it opened was closed without a merge."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينقل المحادثة إلى «المسوّاة» بعد إغلاق كل طلبات السحب التي فتحتها دون دمج."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premješta razgovor u Smireno kada je svaki pull request koji je otvorio zatvoren bez spajanja."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytter en chat til Afsluttet, når alle de pull requests, den åbnede, er lukket uden merge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebt einen Chat nach „Abgelegt“, sobald jeder von ihm geöffnete Pull Request ohne Merge geschlossen wurde."
          }
        },
        "es" : {
          "stringUnit" : {
