{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.experiments.threadMinimapRestReveal.help" : {
      "comment" : "Settings > Experimental > Prompt Rail Waits for a Resting Pointer help: what the switch changes in narrow agent chats.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في المحادثات الضيقة يفتح شريط المطالبات فقط عندما يستقر المؤشر على الحافة، وليس أثناء تحديد النص أبدًا."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U uskim chatovima traka upita se otvara samo kada pokazivač miruje na rubu, nikad dok birate tekst."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I smalle chats åbner promptlisten kun, når markøren hviler på kanten, aldrig mens du markerer tekst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In schmalen Chats öffnet sich die Prompt-Leiste nur, wenn der Zeiger am Rand ruht, nie beim Markieren von Text."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In narrow chats the prompt rail opens only when the pointer rests on the edge, never while you select text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En chats estrechos, la barra de prompts solo se abre cuando el puntero se detiene en el borde, nunca mientras seleccionas texto."
