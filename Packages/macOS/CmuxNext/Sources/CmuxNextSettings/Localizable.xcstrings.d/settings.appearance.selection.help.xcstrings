        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يلوّن خيار لون التمييز الصف وعلامة التبويب المحددين بلون التمييز. ويبقيهما الخيار المحايد رماديين."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Akcent boji odabrani red i karticu bojom akcenta. Neutralno ih ostavlja sivim."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Accent farver den valgte række og fane med accentfarven. Neutral holder dem grå."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Akzent tönt die ausgewählte Zeile und den Tab in der Akzentfarbe. Neutral lässt sie grau."
