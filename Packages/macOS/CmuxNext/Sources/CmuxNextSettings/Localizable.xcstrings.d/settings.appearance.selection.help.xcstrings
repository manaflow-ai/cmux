        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ពណ៌សង្កត់ លាបពណ៌ជួរ និងផ្ទាំងដែលបានជ្រើសដោយពណ៌សង្កត់។ អព្យាក្រឹត ទុកវាជាពណ៌ប្រផេះ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "강조 색상은 선택한 행과 탭을 강조 색상으로 칠합니다. 중립은 회색으로 둡니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aksent farger valgt rad og fane med aksentfargen. Nøytral holder dem grå."
