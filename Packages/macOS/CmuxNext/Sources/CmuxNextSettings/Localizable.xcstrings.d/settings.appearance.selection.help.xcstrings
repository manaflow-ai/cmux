        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "สีเน้นจะแต้มแถวและแท็บที่เลือกด้วยสีเน้น ส่วนเป็นกลางจะคงเป็นสีเทา"
