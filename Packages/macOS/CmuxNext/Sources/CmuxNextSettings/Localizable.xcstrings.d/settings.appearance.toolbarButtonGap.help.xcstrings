    "settings.appearance.toolbarButtonGap.help" : {
      "comment" : "Settings > Appearance: a look's layout and proportions (appearance.metrics)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The space between neighboring icon buttons in the title bar. Unset is three tenths of a button."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Abstand zwischen benachbarten Symboltasten in der Titelleiste. Ohne Wert drei Zehntel einer Taste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’espace entre deux boutons à icône voisins de la barre de titre. Sans valeur, trois dixièmes d’un bouton."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "المسافة بين أزرار الأيقونات المتجاورة في شريط العنوان. بلا قيمة تكون ثلاثة أعشار الزر."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El espacio entre botones de icono vecinos en la barra de título. Sin valor, tres décimas de un botón."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "標題列中相鄰圖示按鈕之間的間距。未設定時為按鈕的十分之三。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "标题栏中相邻图标按钮之间的间距。未设置时为按钮的十分之三。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "제목 막대에서 이웃한 아이콘 버튼 사이의 간격입니다. 설정하지 않으면 버튼의 10분의 3입니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "タイトルバーで隣り合うアイコンボタンの間隔。未設定ならボタンの10分の3です。"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Razmak između susjedne dugmadi s ikonama u naslovnoj traci. Bez vrijednosti tri desetine dugmeta."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Afstanden mellem nabo-ikonknapper i titellinjen. Uden værdi tre tiendedele af en knap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lo spazio tra pulsanti a icona vicini nella barra del titolo. Se non impostato, tre decimi di un pulsante."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "គម្លាតរវាងប៊ូតុងរូបតំណាងជាប់គ្នានៅរបារចំណងជើង។ បើមិនកំណត់ គឺបីភាគដប់នៃប៊ូតុង។"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Avstanden mellom nabo-ikonknapper i tittellinjen. Uten verdi tre tideler av en knapp."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odstęp między sąsiednimi przyciskami z ikonami na pasku tytułu. Bez wartości trzy dziesiąte przycisku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O espaço entre botões de ícone vizinhos na barra de título. Sem valor, três décimos de um botão."
