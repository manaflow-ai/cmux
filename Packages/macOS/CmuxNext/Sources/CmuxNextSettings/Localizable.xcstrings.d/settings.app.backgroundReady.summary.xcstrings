      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يعمل مخفيًا بعد الإنهاء ليُفتح فورًا، مقابل استهلاك ذاكرة أكبر"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Radi skriven nakon izlaza da bi se odmah otvorio, uz veću potrošnju memorije"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kører skjult efter Afslut for at åbne med det samme, på bekostning af hukommelse"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Läuft nach dem Beenden verborgen weiter und öffnet sich sofort, braucht aber mehr Speicher"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs hidden after Quit to open instantly, at a memory cost"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se ejecuta oculto tras salir para abrirse al instante, a costa de más memoria"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "S’exécute en arrière-plan après Quitter pour s’ouvrir instantanément, au prix de plus de mémoire"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Resta nascosto dopo Esci per aprirsi subito, usando più memoria"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "終了後も非表示で動作し、すぐに開きます（メモリを多く使用）"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ដំណើរការដោយលាក់បន្ទាប់ពីចាកចេញ ដើម្បីបើកភ្លាមៗ ដោយប្រើអង្គចងចាំច្រើនជាង"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "종료 후 숨겨진 채 실행되어 바로 열림, 메모리 사용 증가"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kjører skjult etter Avslutt for å åpnes med en gang, på bekostning av minne"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Działa w ukryciu po zakończeniu, by otwierać się natychmiast, kosztem pamięci"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Roda oculto depois de Encerrar para abrir na hora, usando mais memória"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Работает скрыто после завершения и открывается мгновенно, ценой памяти"
