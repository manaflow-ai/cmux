        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "发送给听写应用的快捷键。留空则使用应用的默认快捷键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
