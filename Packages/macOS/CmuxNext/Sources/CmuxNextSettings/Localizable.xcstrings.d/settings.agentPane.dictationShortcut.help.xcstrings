{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.agentPane.dictationShortcut.help" : {
      "comment" : "Settings > Agent Chat > Composer: help text under the Dictation App Shortcut row; ctrl+opt+space is a literal example shortcut",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الاختصار الذي يُرسَل إلى تطبيق الإملاء. إذا كان فارغًا فيُستخدم الاختصار الافتراضي للتطبيق."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prečica koja se šalje vašoj aplikaciji za diktiranje. Prazno koristi zadanu prečicu aplikacije."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Den genvej, der sendes til din dikteringsapp. Tom bruger appens standard."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Tastenkürzel, das an deine Diktier-App gesendet wird. Leer nutzt das Standardkürzel der App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The shortcut sent to your dictation app. Empty uses the app's default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El atajo que se envía a tu app de dictado. Vacío usa el predeterminado de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le raccourci envoyé à votre app de dictée. Vide utilise celui par défaut de l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La scorciatoia inviata alla tua app di dettatura. Vuoto usa quella predefinita dell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "音声入力アプリに送るショートカット。空欄の場合はアプリの初期設定を使います。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ផ្លូវកាត់ដែលផ្ញើទៅកម្មវិធីនិយាយតាមសំឡេងរបស់អ្នក។ ទទេ ប្រើលំនាំដើមរបស់កម្មវិធី។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "받아쓰기 앱에 보내는 단축키입니다. 비워 두면 앱의 기본값을 사용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Snarveien som sendes til dikteringsappen din. Tom bruker appens standard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skrót wysyłany do aplikacji do dyktowania. Puste używa skrótu domyślnego aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O atalho enviado ao seu app de ditado. Vazio usa o padrão do app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сочетание клавиш, отправляемое приложению диктовки. Если пусто, используется стандартное сочетание приложения."
          }
        },
        "th" : {
          "stringUnit" : {
