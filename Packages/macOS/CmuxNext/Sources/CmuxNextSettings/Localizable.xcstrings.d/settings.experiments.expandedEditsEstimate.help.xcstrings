      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تضع دردشة الوكيل الصفوف أسفل مجموعة الملفات المعدّلة الموسّعة عند ارتفاعها الحقيقي، فلا تظهر فجوة تحتها."
          }
