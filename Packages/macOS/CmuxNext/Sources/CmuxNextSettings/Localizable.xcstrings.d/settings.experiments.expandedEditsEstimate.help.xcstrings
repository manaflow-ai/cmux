        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chat agenta postavlja redove ispod proširene grupe izmijenjenih datoteka na njenu stvarnu visinu, pa ispod nje nema praznine."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agentchatten placerer rækkerne under en udvidet gruppe af ændrede filer ved dens reelle højde, så der ikke opstår et hul under den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Agent-Chat platziert die Zeilen unter einer aufgeklappten Gruppe bearbeiteter Dateien auf ihrer echten Höhe, sodass darunter keine Lücke entsteht."
