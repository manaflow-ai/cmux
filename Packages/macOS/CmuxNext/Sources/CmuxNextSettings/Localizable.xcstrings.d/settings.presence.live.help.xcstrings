{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.presence.live.help" : {
      "comment" : "Settings help line of the Live Presence toggle.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show teammates and agents who are live, and let them see you. Off: you appear offline."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أظهر زملاء الفريق والوكلاء المتصلين ودعهم يرونك. عند الإيقاف: تظهر غير متصل."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaži saradnike i agente koji su uživo i dopusti im da vide vas. Isključeno: izgledate van mreže."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis teammedlemmer og agenter, der er live, og lad dem se dig. Fra: du ser ud til at være offline."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeige Teammitglieder und Agenten, die live sind, und lass sie dich sehen. Aus: du erscheinst offline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra a compañeros y agentes que están en vivo y deja que te vean. Desactivado: apareces desconectado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche les coéquipiers et agents en direct et leur permet de vous voir. Désactivé : vous apparaissez hors ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra colleghi e agenti live e consenti loro di vederti. Disattivato: risulti offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブ中のチームメイトとエージェントを表示し、自分も見えるようにします。オフの場合はオフラインに見えます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "បង្ហាញមិត្តរួមក្រុម និងភ្នាក់ងារដែលកំពុងអនឡាញ ហើយអនុញ្ញាតឱ្យពួកគេឃើញអ្នក។ បិទ៖ អ្នកលេចជាក្រៅអនឡាញ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이브 중인 팀원과 에이전트를 표시하고 나도 보이게 합니다. 끄면 오프라인으로 보입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis lagkamerater og agenter som er live, og la dem se deg. Av: du ser frakoblet ut."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuj współpracowników i agentów będących na żywo i pozwól im widzieć Ciebie. Wyłączone: wyglądasz na offline."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra colegas e agentes que estão ao vivo e deixa que vejam você. Desligado: você aparece offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать коллег и агентов в сети и позволить им видеть вас. Выключено: вы отображаетесь не в сети."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงเพื่อนร่วมทีมและเอเจนต์ที่ออนไลน์ และให้พวกเขาเห็นคุณ ปิด: คุณจะแสดงเป็นออฟไลน์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı olan takım arkadaşlarını ve ajanları göster ve seni görmelerine izin ver. Kapalı: çevrimdışı görünürsün."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показувати колег і агентів у мережі та дозволити їм бачити вас. Вимкнено: ви відображаєтеся поза мережею."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiện đồng đội và tác tử đang trực tuyến, và cho họ thấy bạn. Tắt: bạn hiện là ngoại tuyến."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示在线的队友和代理，并让他们看到你。关闭时：你显示为离线。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示線上的隊友和代理，並讓他們看到你。關閉時：你會顯示為離線。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
