        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux'u Kendinize Göre Ayarlayın dört kısa ekran olur: bütün bir görünüm, nasıl çalıştığınız, güven ve bildirimler, sonra yoğunluk ve arka plan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Зробіть cmux своїм» стає чотирма короткими екранами: вигляд цілком, як ви працюєте, довіра й сповіщення, потім щільність і тло."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biến cmux thành của bạn trở thành bốn màn hình ngắn: cả diện mạo, cách bạn làm việc, tin cậy và thông báo, rồi mật độ và hình nền."
          }
