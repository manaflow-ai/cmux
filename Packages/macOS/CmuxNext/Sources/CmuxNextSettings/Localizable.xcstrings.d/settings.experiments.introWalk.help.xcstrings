    "settings.experiments.introWalk.help" : {
      "comment" : "Settings > Advanced > Experiments: the help line under the Intro Walk switch",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make cmux Yours becomes four short screens: a whole look, how you work, trust and notifications, then density and background."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصبح «اجعل cmux لك» أربع شاشات قصيرة: مظهر كامل، وطريقة عملك، والثقة والإشعارات، ثم الكثافة والخلفية."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prilagodite cmux postaje četiri kratka ekrana: cijeli izgled, način rada, povjerenje i obavijesti, zatim gustoća i pozadina."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør cmux til dit bliver fire korte skærme: et helt look, hvordan du arbejder, tillid og notifikationer, og så tæthed og baggrund."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach cmux zu deinem wird zu vier kurzen Bildschirmen: ein ganzer Look, wie du arbeitest, Vertrauen und Mitteilungen, dann Dichte und Hintergrund."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz cmux tuyo pasa a ser cuatro pantallas cortas: un aspecto completo, cómo trabajas, confianza y notificaciones, y luego densidad y fondo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personnaliser cmux devient quatre écrans courts : un style complet, votre façon de travailler, confiance et notifications, puis densité et arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendi cmux tuo diventa quattro brevi schermate: un intero aspetto, come lavori, fiducia e notifiche, poi densità e sfondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「cmuxを自分仕様に」が4つの短い画面になります：全体の見た目、作業スタイル、信頼と通知、そして密度と背景。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ធ្វើឱ្យ cmux ជារបស់អ្នក ក្លាយជាអេក្រង់ខ្លីៗបួន៖ រូបរាងទាំងមូល របៀបធ្វើការ ការទុកចិត្ត និងការជូនដំណឹង បន្ទាប់មកដង់ស៊ីតេ និងផ្ទៃខាងក្រោយ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux 내 것으로 만들기가 짧은 네 화면이 됩니다: 전체 모습, 작업 방식, 신뢰와 알림, 그다음 밀도와 배경."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjør cmux til ditt blir fire korte skjermer: et helt utseende, hvordan du jobber, tillit og varsler, så tetthet og bakgrunn."
