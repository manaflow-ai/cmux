        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostosuj cmux staje się czterema krótkimi ekranami: cały wygląd, sposób pracy, zaufanie i powiadomienia, potem gęstość i tło."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe o cmux do seu jeito vira quatro telas curtas: um visual completo, como você trabalha, confiança e notificações, depois densidade e fundo."
