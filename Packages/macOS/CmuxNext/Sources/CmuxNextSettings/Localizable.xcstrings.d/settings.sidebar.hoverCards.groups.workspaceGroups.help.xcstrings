        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "포인터를 워크스페이스 그룹 머리글에 올려 두면 요약 카드가 열립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Et sammendragskort åpnes når pekeren hviler på overskriften til en arbeidsområdegruppe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Karta podsumowania otwiera się, gdy wskaźnik spocznie na nagłówku grupy obszarów roboczych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um cartão de resumo abre quando o ponteiro repousa no cabeçalho de um grupo de espaços."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Карточка сводки открывается, когда указатель задерживается на заголовке группы пространств."
