      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A summary card opens when the pointer rests on a workspace group's header."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تفتح بطاقة ملخص عندما يستقر المؤشر على رأس مجموعة مساحات عمل."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kartica sa sažetkom otvara se kada pokazivač miruje na zaglavlju grupe radnih prostora."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Et oversigtskort åbnes, når markøren hviler på en arbejdsområdegruppes overskrift."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine Übersichtskarte öffnet sich, wenn der Zeiger auf dem Kopf einer Workspace-Gruppe ruht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se abre una tarjeta de resumen cuando el puntero se detiene en el encabezado de un grupo de espacios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une carte de résumé s'ouvre quand le pointeur reste sur l'en-tête d'un groupe d'espaces."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si apre una scheda di riepilogo quando il puntatore resta sull'intestazione di un gruppo di spazi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポインタをワークスペースグループの見出しに置くと、概要カードが開きます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "កាតសង្ខេបបើកនៅពេលទស្សន៍ទ្រនិចឈប់លើក្បាលក្រុមកន្លែងធ្វើការ។"
