    "settings.sidebar.look.help" : {
      "comment" : "Help under the Sidebar Look setting.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rows, headers and status marks like another app's sidebar. Your own sidebar settings still win."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行、見出し、ステータス表示を別のアプリのサイドバーのようにします。自分のサイドバー設定が引き続き優先されます。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صفوف وعناوين وعلامات حالة مثل الشريط الجانبي لتطبيق آخر. تبقى إعداداتك الخاصة للشريط الجانبي هي الغالبة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redovi, naslovi i oznake statusa kao u bočnoj traci druge aplikacije. Vaše postavke bočne trake i dalje imaju prednost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rækker, overskrifter og statusmærker som i en anden apps sidepanel. Dine egne sidepanelindstillinger vinder stadig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeilen, Überschriften und Statusmarken wie in der Seitenleiste einer anderen App. Deine eigenen Seitenleisten-Einstellungen haben weiterhin Vorrang."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filas, encabezados y marcas de estado como en la barra lateral de otra app. Tus propios ajustes de la barra lateral siguen mandando."
