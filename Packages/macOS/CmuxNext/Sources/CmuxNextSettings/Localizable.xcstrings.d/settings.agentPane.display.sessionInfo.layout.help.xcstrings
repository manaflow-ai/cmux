        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glance draws three blocks with a line between them; Rules titles every section; Groups draws each block as a card."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«لمحة» ترسم ثلاث كتل بينها خط؛ «فواصل» تعنون كل قسم؛ «مجموعات» ترسم كل كتلة كبطاقة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pregled crta tri bloka s linijom između; Linije daju naslov svakom odjeljku; Grupe crtaju svaki blok kao karticu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overblik tegner tre blokke med en linje imellem; Linjer giver hver sektion en titel; Grupper tegner hver blok som et kort."
