{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.ui.calm.help" : {
      "comment" : "Settings > Appearance > Motion: help text of Calm Mode; Calm and Still are its two on values.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calm stops sliding, spinning and hover highlights; Still also makes animations instant."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "هادئ يوقف الانزلاق والدوران وتمييز التمرير؛ وثابت يجعل الرسوم المتحركة فورية أيضًا."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mirno zaustavlja klizanje, vrtnju i isticanja pri prelasku; Mirovanje i animacije čini trenutnim."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rolig stopper glidning, drejning og svævefremhævninger; Stille gør også animationer øjeblikkelige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ruhig stoppt Gleiten, Drehen und Hover-Hervorhebungen; Still macht zudem jede Animation sofort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Calma detiene deslizamientos, giros y resaltados al pasar el puntero; Inmóvil además hace instantáneas las animaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Calme arrête glissements, rotations et surbrillances au survol ; Immobile rend aussi les animations instantanées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Calma ferma scorrimenti, rotazioni ed evidenziazioni al passaggio; Immobile rende anche istantanee le animazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "落ち着きはスライド、回転、ホバーの強調表示をなくし、静止はさらにアニメーションを即座に完了します。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ស្ងប់ បញ្ឈប់ការរអិល ការបង្វិល និងការបន្លិចពេលដាក់ទស្សន៍ទ្រនិច; នៅស្ងៀម ធ្វើឱ្យចលនាកើតឡើងភ្លាមៗផងដែរ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "차분하게는 미끄러짐, 회전, 호버 강조를 멈추고, 정지는 애니메이션도 즉시 끝냅니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rolig stopper gliding, snurring og markering ved peker; Stille gjør også animasjoner umiddelbare."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spokojny zatrzymuje przesuwanie, obracanie i podświetlenia po najechaniu; Bez ruchu dodatkowo sprawia, że animacje są natychmiastowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Calmo impede deslizes, giros e destaques ao passar o ponteiro; Imóvel também torna as animações instantâneas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«Спокойно» убирает скольжение, вращение и подсветку при наведении; «Без движения» также делает анимации мгновенными."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "สงบ หยุดการเลื่อน การหมุน และไฮไลต์เมื่อชี้ นิ่ง ทำให้ภาพเคลื่อนไหวเกิดขึ้นทันทีด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sakin kaymayı, dönmeyi ve üzerine gelme vurgularını durdurur; Durgun ayrıca animasyonları anında yapar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Спокійно зупиняє ковзання, обертання й підсвічування під час наведення; Без руху також робить анімації миттєвими."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tĩnh dừng trượt, xoay và tô sáng khi di chuột; Đứng yên còn làm mọi hoạt ảnh diễn ra ngay lập tức."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "平静会停止滑动、旋转和悬停高亮；静止还会让动画立即完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "平靜會停止滑動、旋轉和懸停醒目標示；靜止還會讓動畫立即完成。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
