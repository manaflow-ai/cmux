        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En prompt, du sender, popper ind og falder på plads i stedet for at dukke op med det samme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein gesendeter Prompt springt herein und setzt sich an seinen Platz, statt sofort zu erscheinen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A prompt you send pops in and settles where it lands, instead of appearing at once."
