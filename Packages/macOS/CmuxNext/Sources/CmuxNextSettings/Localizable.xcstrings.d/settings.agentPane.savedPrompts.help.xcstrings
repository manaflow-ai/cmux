{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.agentPane.savedPrompts.help" : {
      "comment" : "Settings row help for Saved Prompts; /name is typed as is, {{date}} {{time}} {{folder}} {{branch}} are variable names and stay untranslated",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "موجّهات تعرضها قائمة / في كل محادثة: اسم ونصه. كتابة ‎/name‎ تضع النص في مربع الكتابة، مع ملء {{date}} و{{time}} و{{folder}} و{{branch}}."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Upiti koje nudi meni / u svakom chatu: naziv i njegov tekst. Upisivanje /name upisuje tekst u polje za pisanje, uz popunjene {{date}}, {{time}}, {{folder}} i {{branch}}."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prompts, som /-menuen i hver chat tilbyder: et navn og dets tekst. Når du skriver /name, indsættes teksten i skrivefeltet med {{date}}, {{time}}, {{folder}} og {{branch}} udfyldt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prompts, die das /-Menü jedes Chats anbietet: ein Name und sein Text. /name schreibt den Text ins Eingabefeld, mit {{date}}, {{time}}, {{folder}} und {{branch}} ausgefüllt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prompts every chat's / menu offers: a name and its text. Typing /name writes the text into the composer, with {{date}}, {{time}}, {{folder}} and {{branch}} filled in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prompts que ofrece el menú / de cada chat: un nombre y su texto. Escribir /name pone el texto en el editor, con {{date}}, {{time}}, {{folder}} y {{branch}} rellenados."
          }
        },
