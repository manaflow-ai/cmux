        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ការបញ្ចូលដែលម៉ឺនុយ / ក្នុងការជជែកនីមួយៗផ្ដល់ជូន៖ ឈ្មោះ និងអត្ថបទរបស់វា។ ការវាយ /name សរសេរអត្ថបទចូលប្រអប់សរសេរ ដោយបំពេញ {{date}}, {{time}}, {{folder}} និង {{branch}}។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "모든 채팅의 / 메뉴에 나오는 프롬프트: 이름과 본문. /name을 입력하면 본문이 입력란에 들어가며 {{date}}, {{time}}, {{folder}}, {{branch}}는 자동으로 채워집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
