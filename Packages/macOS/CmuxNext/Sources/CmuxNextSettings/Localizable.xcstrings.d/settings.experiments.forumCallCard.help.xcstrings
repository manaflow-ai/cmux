{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.experiments.forumCallCard.help" : {
      "comment" : "Settings > Experimental > Forum Tool Calls help: an agent's forum search, read or post draws as a forum row linking its threads.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر عمليات البحث والقراءة والنشر في منتدى الوكلاء كصفوف منتدى مع روابط إلى سلاسلها."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pretrage, čitanja i objave na forumu agenata prikazuju se kao redovi foruma s vezama na njihove teme."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søgninger, læsninger og indlæg på agentforummet vises som forumrækker med links til deres tråde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suchen, Lesen und Beiträge im Agentenforum erscheinen als Forumzeilen mit Links zu ihren Threads."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent forum searches, reads and posts show as forum rows with links to their threads."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las búsquedas, lecturas y publicaciones del foro de agentes se muestran como filas del foro con enlaces a sus hilos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les recherches, lectures et publications du forum des agents s’affichent en lignes de forum avec des liens vers leurs fils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricerche, letture e post nel forum degli agenti appaiono come righe del forum con link alle loro discussioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントフォーラムの検索、閲覧、投稿が、スレッドへのリンク付きのフォーラム行として表示されます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការស្វែងរក ការអាន និងការបង្ហោះលើវេទិកាភ្នាក់ងារ បង្ហាញជាជួរវេទិកា ដែលមានតំណទៅខ្សែសន្ទនារបស់វា។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트 포럼 검색, 읽기, 게시가 스레드 링크가 있는 포럼 행으로 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søk, lesing og innlegg på agentforumet vises som forumrader med lenker til trådene."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyszukiwania, odczyty i posty na forum agentów pojawiają się jako wiersze forum z linkami do ich wątków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscas, leituras e publicações no fórum de agentes aparecem como linhas do fórum com links para seus tópicos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поиск, чтение и публикации на форуме агентов показываются строками форума со ссылками на их темы."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การค้นหา การอ่าน และการโพสต์ในฟอรัมของเอเจนต์จะแสดงเป็นแถวฟอรัมพร้อมลิงก์ไปยังกระทู้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajan forumundaki aramalar, okumalar ve gönderiler, konularına bağlantılı forum satırları olarak görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пошук, читання й публікації на форумі агентів показуються рядками форуму з посиланнями на їхні теми."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các lượt tìm, đọc và đăng trên diễn đàn tác nhân hiển thị thành các hàng diễn đàn có liên kết đến chủ đề."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能体论坛的搜索、阅读和发帖显示为论坛行，并附有帖子链接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代理論壇的搜尋、閱讀和發文會顯示為論壇列，並附上討論串連結。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
