{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.ui.animations.home.help" : {
      "comment" : "Settings > Appearance > Motion: the help text under a motion switch (ui.animations.*).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تتحرك محادثة Chief وفقاعاتها وحقل الكتابة وقائمة الرئيسية وتتلاشى."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief razgovor, njegovi oblačići, polje za pisanje i lista Početne pomiču se i blijede."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief-chatten, dens bobler, skrivefeltet og Hjem-listen bevæger sig og toner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Chief-Chat, seine Blasen, das Eingabefeld und die Startliste bewegen sich und blenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Chief chat, its bubbles, the composer and the Home list move and fade."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El chat de Chief, sus burbujas, el campo de redacción y la lista de Inicio se mueven y se desvanecen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La discussion Chief, ses bulles, la zone de saisie et la liste d’accueil bougent et s’estompent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La chat di Chief, le sue bolle, il campo di scrittura e l’elenco Home si muovono e sfumano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief チャット、吹き出し、入力欄、ホームのリストに動きとフェードを付けます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ការជជែក Chief ពពុះរបស់វា ប្រអប់សរសេរ និងបញ្ជីទំព័រដើម ផ្លាស់ទី និងស្រអាប់។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief 채팅, 말풍선, 입력란, 홈 목록이 움직이고 페이드됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief-chatten, boblene, skrivefeltet og Hjem-listen beveger seg og tones."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Czat Chief, jego dymki, pole pisania i lista strony głównej poruszają się i przenikają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O chat do Chief, seus balões, o campo de escrita e a lista do Início se movem e esmaecem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Чат Chief, его пузыри, поле ввода и список главной двигаются и затухают."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "แชท Chief ฟองข้อความ ช่องพิมพ์ และรายการหน้าหลักจะเคลื่อนที่และค่อย ๆ จางลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief sohbeti, baloncukları, yazma alanı ve ana sayfa listesi hareket eder ve solar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Чат Chief, його бульбашки, поле введення та список головної рухаються й затухають."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuộc trò chuyện Chief, bong bóng, ô soạn và danh sách Trang chủ di chuyển và mờ dần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief 聊天、气泡、输入框和主页列表带有移动和淡入淡出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chief 聊天、對話泡泡、輸入框與首頁列表帶有移動與淡入淡出。"
          }
        }
      }
    }
