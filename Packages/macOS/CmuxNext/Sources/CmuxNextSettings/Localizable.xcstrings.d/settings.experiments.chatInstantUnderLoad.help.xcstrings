        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz yazarken veya bir yanıt akarken, yeni sekmelerin gösterdiği sohbet listesini kaydetmeden önce bir duraklama beklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поки ви друкуєте або надходить відповідь, список чатів для нових вкладок зберігається лише після паузи."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bạn đang nhập hoặc một câu trả lời đang được truyền, chờ một khoảng dừng trước khi lưu danh sách trò chuyện mà tab mới hiển thị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你输入或回复流式传输时，等到停顿后再保存新标签页显示的聊天列表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你輸入或回覆串流傳輸時，等到停頓後再儲存新分頁顯示的聊天列表。"
