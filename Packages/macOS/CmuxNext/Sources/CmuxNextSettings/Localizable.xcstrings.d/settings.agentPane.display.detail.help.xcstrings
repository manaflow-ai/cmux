{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.agentPane.display.detail.help" : {
      "comment" : "Settings > Chat: help under Chat Detail",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مقدار ما تعرضه المحادثة: الرسائل فقط، أو صفوف الأدوات، أو الأفكار، أو مخرجات كل أداة. تضبط قائمة ··· في المحادثة مستواها الخاص."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koliko razgovor prikazuje: samo poruke, redove alata, misli ili izlaz svakog alata. Meni ··· razgovora postavlja njegov vlastiti nivo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hvor meget en chat viser: kun beskeder, værktøjsrækker, tanker eller hvert værktøjs output. En chats ···-menu angiver dens egen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wie viel ein Chat zeigt: nur Nachrichten, Werkzeugzeilen, Gedanken oder die Ausgabe jedes Werkzeugs. Das ···-Menü eines Chats legt seine eigene Stufe fest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How much a chat shows: messages only, tool rows, thoughts, or every tool's output. A chat's ··· menu sets its own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuánto muestra un chat: solo mensajes, filas de herramientas, pensamientos o la salida de cada herramienta. El menú ··· de un chat define su propio nivel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ce qu'affiche une discussion : les messages seuls, les lignes d'outils, les réflexions ou la sortie de chaque outil. Le menu ··· d'une discussion règle le sien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quanto mostra una chat: solo messaggi, righe degli strumenti, pensieri o l'output di ogni strumento. Il menu ··· di una chat imposta il suo livello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "チャットに表示する量：メッセージのみ、ツール行、思考、すべてのツール出力。チャットの ··· メニューでそのチャットだけ設定できます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ចំនួនដែលការជជែកបង្ហាញ៖ តែសារ ជួរឧបករណ៍ គំនិត ឬលទ្ធផលនៃឧបករណ៍នីមួយៗ។ ម៉ឺនុយ ··· នៃការជជែកកំណត់កម្រិតរបស់វាផ្ទាល់។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "채팅에 보여 줄 양: 메시지만, 도구 행, 생각, 또는 모든 도구 출력. 채팅의 ··· 메뉴에서 해당 채팅만 따로 설정할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hvor mye en chat viser: bare meldinger, verktøyrader, tanker eller hvert verktøys utdata. En chats ···-meny angir dens egen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ile pokazuje czat: tylko wiadomości, wiersze narzędzi, myśli lub wynik każdego narzędzia. Menu ··· czatu ustawia jego własny poziom."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quanto um chat mostra: só mensagens, linhas de ferramentas, pensamentos ou a saída de cada ferramenta. O menu ··· de um chat define o dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сколько показывает чат: только сообщения, строки инструментов, размышления или вывод каждого инструмента. Меню ··· чата задаёт его собственный уровень."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ปริมาณที่แชทแสดง: เฉพาะข้อความ แถวเครื่องมือ ความคิด หรือเอาต์พุตของทุกเครื่องมือ เมนู ··· ของแชทกำหนดค่าของแชทนั้นเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bir sohbetin ne kadar gösterdiği: yalnızca mesajlar, araç satırları, düşünceler veya her aracın çıktısı. Bir sohbetin ··· menüsü kendi düzeyini ayarlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Скільки показує чат: лише повідомлення, рядки інструментів, міркування або вивід кожного інструмента. Меню ··· чату задає його власний рівень."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mức cuộc trò chuyện hiển thị: chỉ tin nhắn, hàng công cụ, suy nghĩ hoặc đầu ra của mọi công cụ. Menu ··· của cuộc trò chuyện đặt mức riêng của nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "聊天显示多少内容：仅消息、工具行、思考，或每个工具的输出。聊天的 ··· 菜单可单独设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "聊天顯示多少內容：僅訊息、工具列、思考，或每個工具的輸出。聊天的 ··· 選單可設定它自己的層級。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
