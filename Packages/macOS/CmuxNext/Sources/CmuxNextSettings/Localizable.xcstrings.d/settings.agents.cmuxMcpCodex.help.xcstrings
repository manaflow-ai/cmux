{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.agents.cmuxMcpCodex.help" : {
      "comment" : "Settings > Agents > cmux Tools: help under the Codex switch (agents.cmuxMcpCodex)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off: Codex you start in cmux never gets cmux’s tools, even when they are on."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند الإيقاف: لا يحصل Codex الذي تشغّله في cmux على أدوات cmux أبدًا، حتى عند تشغيلها."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isključeno: Codex koji pokrenete u cmuxu nikad ne dobija cmux alate, čak ni kad su uključeni."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra: Codex, du starter i cmux, får aldrig cmux’ værktøjer, heller ikke når de er slået til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus: Codex, das du in cmux startest, erhält die cmux-Tools nie, auch wenn sie eingeschaltet sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado: Codex iniciado en cmux nunca recibe las herramientas de cmux, aunque estén activadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé : Codex lancé dans cmux ne reçoit jamais les outils de cmux, même s’ils sont activés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivato: Codex avviato in cmux non riceve mai gli strumenti di cmux, anche quando sono attivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフ：cmux で起動した Codex は、cmux のツールがオンでも使えません。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "បិទ៖ Codex ដែលអ្នកចាប់ផ្ដើមក្នុង cmux មិនដែលទទួលបានឧបករណ៍ cmux ទេ ទោះបីវាបើកក៏ដោយ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끔: cmux에서 시작한 Codex은(는) cmux 도구가 켜져 있어도 사용하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av: Codex du starter i cmux får aldri cmux-verktøyene, selv når de er på."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłączone: Codex uruchomiony w cmux nigdy nie dostaje narzędzi cmux, nawet gdy są włączone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado: o Codex iniciado no cmux nunca recebe as ferramentas do cmux, mesmo quando estão ativadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключено: Codex, запущенный в cmux, никогда не получает инструменты cmux, даже когда они включены."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิด: Codex ที่คุณเริ่มใน cmux จะไม่ได้รับเครื่องมือของ cmux แม้จะเปิดอยู่ก็ตาม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapalı: cmux’ta başlattığınız Codex, araçlar açık olsa bile cmux araçlarını hiç almaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимкнено: Codex, запущений у cmux, ніколи не отримує інструменти cmux, навіть коли їх увімкнено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt: Codex bạn khởi động trong cmux không bao giờ nhận công cụ của cmux, kể cả khi chúng đang bật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭：在 cmux 中启动的 Codex 不会获得 cmux 的工具，即使这些工具已开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉：在 cmux 中啟動的 Codex 不會取得 cmux 的工具，即使這些工具已開啟。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
