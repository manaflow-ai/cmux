{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.agentPane.display.environment.help" : {
      "comment" : "Settings > Appearance > Agent Chat > Session Info Chip: help for the Left / Right / Off choice",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مكان الشريحة: أسفل علامات التبويب (اليسار) أو في الرأس (اليمين)."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gdje stoji čip: ispod kartica (Lijevo) ili u zaglavlju (Desno)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hvor chippen sidder: under fanerne (Venstre) eller i sidehovedet (Højre)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wo der Chip sitzt: unter den Tabs (Links) oder im Header (Rechts)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where the chip sits: under the tabs (Left) or in the header (Right)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dónde se sitúa el chip: bajo las pestañas (Izquierda) o en el encabezado (Derecha)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Emplacement de la pastille : sous les onglets (Gauche) ou dans l’en-tête (Droite)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dove si trova il chip: sotto le schede (Sinistra) o nell’intestazione (Destra)."
