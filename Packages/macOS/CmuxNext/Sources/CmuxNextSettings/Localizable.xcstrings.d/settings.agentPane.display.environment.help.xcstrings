        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "チップの位置：タブの下（左）またはヘッダー内（右）。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "កន្លែងដែលបន្ទះស្ថិតនៅ៖ ក្រោមផ្ទាំង (ឆ្វេង) ឬនៅក្បាល (ស្ដាំ)។"
