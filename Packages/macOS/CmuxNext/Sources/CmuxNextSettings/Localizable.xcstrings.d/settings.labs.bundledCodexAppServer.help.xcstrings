{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.labs.bundledCodexAppServer.help" : {
      "comment" : "Settings row help for Use Bundled Codex App Server; cmux and Codex are product names",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تستخدم محادثات Codex الجديدة خادم التطبيق المضمَّن مع cmux عند اجتيازه التحقق، وإلا فتستخدم Codex المثبَّت لديك."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Novi Codex chatovi koriste server aplikacije ugrađen u cmux kada prođe provjeru, inače vaš instalirani Codex."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nye Codex-chats bruger den appserver, der følger med cmux, når den består kontrollen, ellers din installerede Codex."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Neue Codex-Chats verwenden den mit cmux gelieferten App-Server, wenn er die Prüfung besteht, sonst dein installiertes Codex."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New Codex chats use the app server bundled with cmux when it checks out, else your installed Codex."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los chats nuevos de Codex usan el servidor de app incluido con cmux si supera la comprobación; si no, tu Codex instalado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les nouveaux chats Codex utilisent le serveur d’app fourni avec cmux s’il est vérifié, sinon votre Codex installé."
          }
        },
        "it" : {
          "stringUnit" : {
