        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nowe czaty Codex używają serwera aplikacji dołączonego do cmux, gdy przejdzie weryfikację, a w przeciwnym razie zainstalowanego Codex."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
