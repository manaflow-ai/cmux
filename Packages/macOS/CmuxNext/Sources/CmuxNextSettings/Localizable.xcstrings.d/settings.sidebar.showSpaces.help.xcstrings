{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.sidebar.showSpaces.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تظهر المساحات عندما يكون لديك أكثر من مساحة واحدة. «مساحة جديدة» موجودة في لوحة الأوامر."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prostori se prikazuju kada ih imate više od jednog. „Novi prostor“ je u paleti naredbi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Områder vises, når du har mere end ét. „Nyt område“ findes i kommandopaletten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spaces werden angezeigt, sobald du mehr als einen hast. „Neuer Space“ findest du in der Befehlspalette."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaces show once you have more than one. New Space is in the command palette."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los espacios se muestran cuando tienes más de uno. «Nuevo espacio» está en la paleta de comandos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les espaces s’affichent dès que vous en avez plusieurs. « Nouvel espace » se trouve dans la palette de commandes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gli spazi compaiono quando ne hai più di uno. «Nuovo spazio» è nella palette dei comandi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "スペースは2つ以上になると表示されます。「新規スペース」はコマンドパレットにあります。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "លំហបង្ហាញនៅពេលអ្នកមានច្រើនជាងមួយ។ «លំហថ្មី» មាននៅក្នុងផ្ទាំងពាក្យបញ្ជា។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "스페이스는 두 개 이상일 때 표시됩니다. ‘새 스페이스’는 명령 팔레트에 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Områder vises når du har mer enn ett. «Nytt område» finner du i kommandopaletten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Obszary pojawiają się, gdy masz więcej niż jeden. „Nowy obszar” jest w palecie poleceń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os espaços aparecem quando você tem mais de um. “Novo Espaço” está na paleta de comandos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Области показываются, когда их больше одной. «Новая область» есть в палитре команд."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "พื้นที่จะแสดงเมื่อคุณมีมากกว่าหนึ่ง “พื้นที่ใหม่” อยู่ในพาเลตคำสั่ง"
