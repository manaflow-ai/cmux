    "settings.appearance.fontSmoothing.help" : {
      "comment" : "Help under Text Smoothing. Auto, Thin and Smooth are the choice names; translate them as in settings.choice.fontSmoothingAuto, settings.choice.fontSmoothingThin and settings.choice.fontSmoothingSmooth.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "كيفية رسم النص. يتغير بعض النص بعد إعادة تشغيل cmux؛ وتحتفظ الطرفيات بإعدادها الخاص."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kako se tekst crta. Dio teksta se mijenja nakon ponovnog pokretanja cmuxa; terminali zadržavaju svoju postavku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hvordan tekst tegnes. Noget tekst skifter, når cmux genstartes; terminaler beholder deres egen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wie Text gezeichnet wird. Mancher Text ändert sich erst nach einem Neustart von cmux; Terminals behalten ihre eigene Einstellung."
