  "strings" : {
    "settings.sessions.keepAwakeWhenLocked.help" : {
      "comment" : "Settings > Sessions > Keep Agents Running While Locked help: how long and when the Mac stays awake.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "While your Mac is locked, it stays awake for an agent that is working, even on battery, for up to 2 hours. Closing the lid on battery still puts it to sleep."
          }
        },
        "bs" : {
