        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zeigt, wie viele Mitglieder arbeiten, warten, fehlgeschlagen sind oder Ungelesenes haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Muestra cuántos miembros trabajan, esperan, fallaron o tienen elementos sin leer."
