        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lyde, som cmux selv afspiller. En notifikations standardlyd følger systemets lydstyrke for advarsler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Töne, die cmux selbst abspielt. Der Standardton eines Banners folgt der Warnton-Lautstärke des Systems."
          }
        },
