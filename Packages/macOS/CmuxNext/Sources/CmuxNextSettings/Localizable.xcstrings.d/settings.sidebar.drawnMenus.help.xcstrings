{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.sidebar.drawnMenus.help" : {
      "comment" : "Setting help: what sidebar.drawnMenus does; off keeps the system menu.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right-click and more-button menus in the sidebar follow the menu look instead of the system menu."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تتبع قوائم النقر بزر الماوس الأيمن وزر المزيد في الشريط الجانبي مظهر القوائم بدلًا من قائمة النظام."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Meniji desnog klika i dugmeta za više u bočnoj traci prate izgled menija umjesto sistemskog menija."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Højreklik- og flere-knap-menuer i sidebjælken følger menuudseendet i stedet for systemmenuen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rechtsklick- und Mehr-Menüs in der Seitenleiste folgen der Menüdarstellung statt dem Systemmenü."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los menús de clic derecho y del botón Más de la barra lateral siguen el aspecto de menús en lugar del menú del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les menus du clic droit et du bouton Plus de la barre latérale suivent l’apparence des menus au lieu du menu système."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I menu del clic destro e del pulsante Altro nella barra laterale seguono l’aspetto dei menu invece del menu di sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "サイドバーの右クリックメニューとその他ボタンのメニューが、システムメニューではなくメニューの外観に従います。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ម៉ឺនុយចុចស្តាំ និងប៊ូតុងច្រើនទៀតក្នុងរបារចំហៀង ធ្វើតាមរូបរាងម៉ឺនុយ ជំនួសឱ្យម៉ឺនុយប្រព័ន្ធ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "사이드바의 오른쪽 클릭 메뉴와 더보기 버튼 메뉴가 시스템 메뉴 대신 메뉴 모양을 따릅니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Høyreklikk- og flere-knapp-menyer i sidepanelet følger menyutseendet i stedet for systemmenyen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menu prawego przycisku i przycisku Więcej na pasku bocznym używają wyglądu menu zamiast menu systemowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os menus de clique direito e do botão Mais na barra lateral seguem a aparência dos menus em vez do menu do sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Меню правого щелчка и кнопки «Ещё» в боковой панели следуют виду меню, а не системному меню."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "เมนูคลิกขวาและปุ่มเพิ่มเติมในแถบด้านข้างจะใช้รูปลักษณ์เมนูแทนเมนูของระบบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kenar çubuğundaki sağ tık ve diğer düğmesi menüleri sistem menüsü yerine menü görünümünü izler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Меню правого клацання та кнопки «Ще» на бічній панелі відповідають вигляду меню, а не системному меню."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menu nhấp chuột phải và nút thêm trong thanh bên theo giao diện menu thay vì menu hệ thống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "边栏中的右键菜单和更多按钮菜单遵循菜单外观，而不是系统菜单。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "側邊欄中的右鍵選單與更多按鈕選單會依循選單外觀，而非系統選單。"
          }
        }
      }
    }
  },
  "version" : "1.0"
