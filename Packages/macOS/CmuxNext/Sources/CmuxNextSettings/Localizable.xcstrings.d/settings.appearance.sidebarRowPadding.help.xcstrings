{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.appearance.sidebarRowPadding.help" : {
      "comment" : "Settings > Appearance: a look's layout and proportions (appearance.metrics)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where a sidebar row's first glyph or title starts inside its fill, and its last trailing mark ends. Unset is the density's."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wo das erste Symbol oder der Titel einer Seitenleistenzeile in ihrer Füllung beginnt und ihr letztes Zeichen rechts endet. Ohne Wert gilt die Dichte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Où le premier glyphe ou le titre d’une ligne commence dans son fond, et où sa dernière marque à droite s’arrête. Sans valeur, celui de la densité."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "موضع بدء أول رمز أو عنوان في صف الشريط الجانبي داخل تعبئته، وموضع انتهاء آخر علامة فيه. بلا قيمة تُستخدم قيمة الكثافة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dónde empieza el primer glifo o el título de una fila dentro de su relleno y dónde termina su última marca. Sin valor, el de la densidad."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "側邊欄列的第一個圖示或標題在填色內開始的位置，以及最後一個尾端標記結束的位置。未設定時沿用密度的值。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "侧边栏行的第一个图标或标题在填充内开始的位置，以及最后一个尾部标记结束的位置。未设置时沿用密度的值。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "사이드바 행의 첫 아이콘이나 제목이 채우기 안에서 시작하고 마지막 표시가 끝나는 위치입니다. 설정하지 않으면 밀도 값을 따릅니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "サイドバー行の最初のグリフやタイトルが塗りの内側で始まり、末尾のマークが終わる位置。未設定なら密度の値です。"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gdje prvi simbol ili naslov reda počinje unutar ispune i gdje završava posljednja oznaka. Bez vrijednosti važi gustina."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hvor en rækkes første symbol eller titel begynder inde i udfyldningen, og hvor dens sidste mærke slutter. Uden værdi gælder tætheden."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dove il primo glifo o il titolo di una riga inizia dentro il riempimento e dove finisce l’ultimo segno. Se non impostato, vale la densità."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ទីតាំងដែលរូបតំណាង ឬចំណងជើងដំបូងនៃជួរចាប់ផ្តើមក្នុងផ្ទៃពណ៌ និងសញ្ញាចុងក្រោយបញ្ចប់។ បើមិនកំណត់ ប្រើតម្លៃនៃដង់ស៊ីតេ។"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hvor radens første symbol eller tittel starter inne i fyllet, og hvor det siste merket slutter. Uten verdi gjelder tettheten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gdzie pierwszy symbol lub tytuł wiersza zaczyna się w wypełnieniu i gdzie kończy się ostatni znacznik. Bez wartości obowiązuje gęstość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Onde o primeiro glifo ou o título de uma linha começa dentro do preenchimento e onde a última marca termina. Sem valor, vale a densidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Где первый значок или заголовок строки начинается внутри заливки и где заканчивается последняя метка. Без значения действует плотность."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ตำแหน่งที่สัญลักษณ์หรือชื่อแรกของแถวเริ่มภายในพื้น และเครื่องหมายสุดท้ายสิ้นสุด หากไม่ตั้งค่า จะใช้ค่าของความหนาแน่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Satırın ilk simgesinin veya başlığının dolgu içinde başladığı ve son işaretinin bittiği yer. Ayarlanmazsa yoğunluğunki geçerlidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Де перший значок або заголовок рядка починається всередині заливки і де закінчується остання позначка. Без значення діє щільність."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vị trí biểu tượng hoặc tiêu đề đầu tiên của hàng bắt đầu trong phần tô và dấu cuối cùng kết thúc. Nếu không đặt, dùng giá trị của mật độ."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
