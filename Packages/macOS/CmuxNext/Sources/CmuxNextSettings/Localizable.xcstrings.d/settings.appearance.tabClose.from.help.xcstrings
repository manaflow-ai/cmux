    "settings.appearance.tabClose.from.help" : {
      "comment" : "Settings row help for the tab close button color.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The color of a tab's close button. Unset, the text color."
          }
