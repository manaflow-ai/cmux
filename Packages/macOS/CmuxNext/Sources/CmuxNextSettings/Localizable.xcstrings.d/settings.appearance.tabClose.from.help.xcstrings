        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لون زر الإغلاق في علامة التبويب. إذا لم يُحدَّد، يُستخدم لون النص."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boja dugmeta za zatvaranje kartice. Ako nije postavljeno, boja teksta."
