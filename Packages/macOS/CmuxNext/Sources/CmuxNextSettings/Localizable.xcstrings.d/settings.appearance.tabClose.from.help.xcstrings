        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farven på en fanes lukkeknap. Hvis den ikke er angivet, bruges tekstfarven."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Farbe der Schließtaste eines Tabs. Nicht gesetzt: die Textfarbe."
