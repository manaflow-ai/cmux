        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A ordem das ferramentas de agente no seletor de modelos. Arraste uma ferramenta no seletor para movê-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Порядок инструментов агентов в окне выбора модели. Перетащите инструмент в этом окне, чтобы переместить его."
