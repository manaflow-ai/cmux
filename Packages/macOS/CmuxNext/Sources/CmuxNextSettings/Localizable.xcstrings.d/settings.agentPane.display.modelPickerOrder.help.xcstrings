        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’ordre des environnements dans le sélecteur de modèle. Faites glisser un environnement dans le sélecteur pour le déplacer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’ordine degli ambienti nel selettore del modello. Trascina un ambiente nel selettore per spostarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "モデルピッカー内のハーネスの順序です。ピッカーでハーネスをドラッグして移動できます。"
