        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "លំដាប់ harness ក្នុងកម្មវិធីជ្រើសម៉ូដែល។ អូស harness ក្នុងកម្មវិធីជ្រើស ដើម្បីផ្លាស់ទីវា។"
