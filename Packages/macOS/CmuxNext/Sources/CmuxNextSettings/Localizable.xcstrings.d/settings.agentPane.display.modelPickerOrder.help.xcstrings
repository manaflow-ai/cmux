        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "모델 선택기의 하네스 순서입니다. 선택기에서 하네스를 드래그해 이동하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rekkefølgen på verktøy i modellvelgeren. Dra et verktøy i velgeren for å flytte det."
