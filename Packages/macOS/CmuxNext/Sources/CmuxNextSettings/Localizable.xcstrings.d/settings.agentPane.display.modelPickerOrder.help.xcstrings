        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rækkefølgen af harnesses i modelvælgeren. Træk et harness i vælgeren for at flytte det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Reihenfolge der Harnesses in der Modellauswahl. Ziehe ein Harness in der Auswahl, um es zu verschieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El orden de los harnesses en el selector de modelos. Arrastra un harness en el selector para moverlo."
