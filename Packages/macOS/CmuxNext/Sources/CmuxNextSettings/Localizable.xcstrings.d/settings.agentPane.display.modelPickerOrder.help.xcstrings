{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.agentPane.display.modelPickerOrder.help" : {
      "comment" : "Settings (search, palette, CLI): the help of the list that keeps the order of the harness tabs in the composer's model picker",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The order of the harnesses in the model picker. Drag a harness in the picker to move it."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ترتيب أدوات الوكلاء في منتقي النماذج. اسحب أداة داخل المنتقي لتغيير موضعها."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Redoslijed agentskih alata u biraču modela. Povucite alat unutar birača da ga premjestite."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rækkefølgen af agentværktøjer i modelvælgeren. Træk et værktøj i vælgeren for at flytte det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Reihenfolge der Agentenwerkzeuge in der Modellauswahl. Ziehe ein Werkzeug in der Auswahl, um es zu verschieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El orden de las herramientas de agente en el selector de modelos. Arrastra una herramienta dentro del selector para moverla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’ordre des outils d’agent dans le sélecteur de modèles. Faites glisser un outil dans le sélecteur pour le déplacer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’ordine degli strumenti agente nel selettore di modelli. Trascina uno strumento nel selettore per spostarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "モデル選択でのエージェントツールの表示順序です。選択画面内でツールをドラッグすると移動できます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "លំដាប់ឧបករណ៍ភ្នាក់ងារនៅក្នុងកម្មវិធីជ្រើសរើសម៉ូដែល។ អូសឧបករណ៍នៅក្នុងកម្មវិធីជ្រើសរើសដើម្បីផ្លាស់ទីវា។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "모델 선택기에 표시되는 에이전트 도구의 순서입니다. 선택기에서 도구를 드래그하여 이동하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rekkefølgen for agentverktøy i modellvelgeren. Dra et verktøy i velgeren for å flytte det."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kolejność narzędzi agenta w oknie wyboru modelu. Przeciągnij narzędzie w tym oknie, aby je przenieść."
