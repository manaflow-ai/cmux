      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ترتيب أدوات التشغيل في منتقي النموذج. اسحب أداة في المنتقي لنقلها."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Redoslijed alata u biraču modela. Prevucite alat u biraču da ga pomjerite."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rækkefølgen af værktøjer i modelvælgeren. Træk et værktøj i vælgeren for at flytte det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Reihenfolge der Harnesses in der Modellauswahl. Ziehe ein Harness in der Auswahl, um es zu verschieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The order of the harnesses in the model picker. Drag a harness in the picker to move it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El orden de los entornos en el selector de modelos. Arrastra un entorno en el selector para moverlo."
