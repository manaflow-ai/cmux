        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "លំដាប់ឧបករណ៍ក្នុងកម្មវិធីជ្រើសម៉ូដែល។ អូសឧបករណ៍ក្នុងកម្មវិធីជ្រើសដើម្បីផ្លាស់ទី។"
