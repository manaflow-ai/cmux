      "comment" : "Help under the Wake Tabs on Hover setting.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleeping pages start loading when the pointer rests on their tab. Uses more memory."
