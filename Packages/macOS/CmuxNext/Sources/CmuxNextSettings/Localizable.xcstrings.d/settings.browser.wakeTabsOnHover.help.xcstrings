        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تبدأ الصفحات النائمة في التحميل عندما يستقر المؤشر على علامة تبويبها. يستخدم ذاكرة أكثر."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uspavane stranice počinju se učitavati kada pokazivač miruje na njihovoj kartici. Koristi više memorije."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sovende sider begynder at indlæse, når markøren hviler på deres fane. Bruger mere hukommelse."
