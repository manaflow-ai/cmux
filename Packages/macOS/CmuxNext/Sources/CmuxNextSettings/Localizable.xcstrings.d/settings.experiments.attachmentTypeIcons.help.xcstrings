{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.experiments.attachmentTypeIcons.help" : {
      "comment" : "Settings > Experiments: the Attachment Type Icons taste prototype row",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While an attachment loads, its chip shows a file or image icon instead of the loading mark."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أثناء تحميل مرفق، تعرض شريحته أيقونة ملف أو صورة بدلاً من علامة التحميل."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dok se prilog učitava, njegov čip prikazuje ikonu datoteke ili slike umjesto oznake učitavanja."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mens en vedhæftning indlæses, viser dens chip et fil- eller billedikon i stedet for indlæsningsmærket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während ein Anhang lädt, zeigt sein Chip ein Datei- oder Bildsymbol statt der Ladeanzeige."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras se carga un adjunto, su chip muestra un icono de archivo o de imagen en lugar del indicador de carga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant le chargement d'une pièce jointe, sa puce affiche une icône de fichier ou d'image au lieu de l'indicateur de chargement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante il caricamento di un allegato, il suo chip mostra un'icona di file o di immagine al posto dell'indicatore di caricamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添付ファイルの読み込み中、チップに読み込みマークの代わりにファイルまたは画像のアイコンを表示します。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ពេលឯកសារភ្ជាប់កំពុងផ្ទុក បន្ទះរបស់វាបង្ហាញរូបតំណាងឯកសារ ឬរូបភាព ជំនួសឱ្យសញ្ញាកំពុងផ្ទុក។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첨부 파일을 불러오는 동안 칩에 로딩 표시 대신 파일 또는 이미지 아이콘이 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mens et vedlegg lastes inn, viser brikken et fil- eller bildeikon i stedet for lastemerket."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas wczytywania załącznika jego kafelek pokazuje ikonę pliku lub obrazu zamiast wskaźnika wczytywania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto um anexo carrega, o chip mostra um ícone de arquivo ou de imagem em vez do indicador de carregamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока вложение загружается, на его плашке показан значок файла или изображения вместо индикатора загрузки."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขณะที่ไฟล์แนบกำลังโหลด ชิปจะแสดงไอคอนไฟล์หรือรูปภาพแทนเครื่องหมายกำลังโหลด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir ek yüklenirken, çipi yükleme işareti yerine bir dosya veya görsel simgesi gösterir."
