        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поки вкладення завантажується, на його плашці показано значок файлу або зображення замість індикатора завантаження."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong khi tệp đính kèm đang tải, chip của nó hiển thị biểu tượng tệp hoặc hình ảnh thay cho dấu đang tải."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "附件加载时，其标签显示文件或图片图标，而不是加载标记。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "附件載入時，其標籤顯示檔案或圖片圖示，而不是載入標記。"
