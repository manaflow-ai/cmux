    "settings.terminal.cursorBlink.help" : {
      "comment" : "Settings row help for the terminal cursor blink.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whether the terminal cursor blinks. Unset, the Ghostty config's cursor-style-blink."
          }
        },
