          "stringUnit" : {
            "state" : "translated",
            "value" : "ما إذا كان مؤشر الطرفية يومض. إذا لم يُحدَّد، يُستخدم cursor-style-blink من إعدادات Ghostty."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treperi li kursor terminala. Ako nije postavljeno, cursor-style-blink iz Ghostty konfiguracije."
