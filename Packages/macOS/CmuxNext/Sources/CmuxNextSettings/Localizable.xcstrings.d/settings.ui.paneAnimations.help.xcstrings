        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ការបំបែក ការបិទ ការផ្លាស់ទី ការពង្រីក និងការរំកិលជួរឈរ រអិលចូលកន្លែង។"
