        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "分割、閉じる、移動、ズーム、列のスクロールがスライドして収まります。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تنزلق عمليات التقسيم والإغلاق والنقل والتكبير وتمرير الأعمدة إلى أماكنها."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
