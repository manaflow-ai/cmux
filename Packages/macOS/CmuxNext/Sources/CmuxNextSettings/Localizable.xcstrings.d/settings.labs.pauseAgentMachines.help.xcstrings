      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إيقاف جهاز وكيل جديد مؤقتًا بعد 15 دقيقة من الخمول؛ ويستأنف عند وصول العمل."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauziraj novu mašinu agenta nakon 15 minuta neaktivnosti; nastavlja kada stigne posao."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt en ny agentmaskine på pause efter 15 inaktive minutter; den genoptages, når der kommer arbejde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine neue Agent-Maschine nach 15 Minuten Leerlauf pausieren; sie wird fortgesetzt, sobald Arbeit eintrifft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause a new agent machine after 15 idle minutes; it resumes when work arrives."
          }
