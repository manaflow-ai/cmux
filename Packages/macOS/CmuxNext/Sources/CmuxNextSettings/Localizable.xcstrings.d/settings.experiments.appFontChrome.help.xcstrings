      "comment" : "Settings > Experiments > App Font in Native Chrome: help text.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم الشريط الجانبي وعلامات التبويب وشريط العنوان خط التطبيق أيضًا. يتغير بعض النص بعد إعادة تشغيل cmux."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bočna traka, kartice i naslovna traka također koriste font aplikacije. Dio teksta se mijenja nakon ponovnog pokretanja cmuxa."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidepanelet, fanerne og titellinjen bruger også appens skrifttype. Noget tekst ændres først, når cmux genstartes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seitenleiste, Tabs und Titelleiste nutzen ebenfalls die App-Schrift. Manche Texte ändern sich erst nach einem Neustart von cmux."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sidebar, tabs and titlebar draw in the App Font too. Some text changes after cmux restarts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra lateral, las pestañas y la barra de título también usan la fuente de la app. Parte del texto cambia tras reiniciar cmux."
          }
