        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where Codex keeps its settings and sign-in (CODEX_HOME). Empty uses ~/.codex."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المكان الذي يحفظ فيه Codex إعداداته وتسجيل الدخول (CODEX_HOME). إذا تُرك فارغًا يُستخدم ~/.codex."
