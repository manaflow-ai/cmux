        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ពេលរបារចំហៀងត្រូវបានលាក់ ចង្អុលទៅគែមបង្អួច ដើម្បីបង្ហាញវាលើការងាររបស់អ្នក។"
