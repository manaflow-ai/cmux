        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Når sidepanelet er skjult, pek på vinduets kant for å vise det over arbeidet ditt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gdy pasek boczny jest ukryty, wskaż krawędź okna, aby pokazać go nad pracą."
