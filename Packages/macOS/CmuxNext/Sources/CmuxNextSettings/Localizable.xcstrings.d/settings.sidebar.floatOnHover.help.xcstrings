        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dok je bočna traka skrivena, pokažite na rub prozora da se prikaže iznad vašeg rada."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Når sidepanelet er skjult, så peg på vinduets kant for at vise det over dit arbejde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ist die Seitenleiste ausgeblendet, zeige auf den Fensterrand, um sie über deiner Arbeit einzublenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With the sidebar hidden, point at the window's edge to show it over your work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
