{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.agents.cmuxMcpClaude.help" : {
      "comment" : "Settings > Agents > cmux Tools: help under the Claude Code switch (agents.cmuxMcpClaude)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off: Claude Code you start in cmux never gets cmux’s tools, even when they are on."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند الإيقاف: لا يحصل Claude Code الذي تشغّله في cmux على أدوات cmux أبدًا، حتى عند تشغيلها."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isključeno: Claude Code koji pokrenete u cmuxu nikad ne dobija cmux alate, čak ni kad su uključeni."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra: Claude Code, du starter i cmux, får aldrig cmux’ værktøjer, heller ikke når de er slået til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus: Claude Code, das du in cmux startest, erhält die cmux-Tools nie, auch wenn sie eingeschaltet sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado: Claude Code iniciado en cmux nunca recibe las herramientas de cmux, aunque estén activadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé : Claude Code lancé dans cmux ne reçoit jamais les outils de cmux, même s’ils sont activés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivato: Claude Code avviato in cmux non riceve mai gli strumenti di cmux, anche quando sono attivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフ：cmux で起動した Claude Code は、cmux のツールがオンでも使えません。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "បិទ៖ Claude Code ដែលអ្នកចាប់ផ្ដើមក្នុង cmux មិនដែលទទួលបានឧបករណ៍ cmux ទេ ទោះបីវាបើកក៏ដោយ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끔: cmux에서 시작한 Claude Code은(는) cmux 도구가 켜져 있어도 사용하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av: Claude Code du starter i cmux får aldri cmux-verktøyene, selv når de er på."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłączone: Claude Code uruchomiony w cmux nigdy nie dostaje narzędzi cmux, nawet gdy są włączone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado: o Claude Code iniciado no cmux nunca recebe as ferramentas do cmux, mesmo quando estão ativadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключено: Claude Code, запущенный в cmux, никогда не получает инструменты cmux, даже когда они включены."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิด: Claude Code ที่คุณเริ่มใน cmux จะไม่ได้รับเครื่องมือของ cmux แม้จะเปิดอยู่ก็ตาม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapalı: cmux’ta başlattığınız Claude Code, araçlar açık olsa bile cmux araçlarını hiç almaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимкнено: Claude Code, запущений у cmux, ніколи не отримує інструменти cmux, навіть коли їх увімкнено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt: Claude Code bạn khởi động trong cmux không bao giờ nhận công cụ của cmux, kể cả khi chúng đang bật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭：在 cmux 中启动的 Claude Code 不会获得 cmux 的工具，即使这些工具已开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉：在 cmux 中啟動的 Claude Code 不會取得 cmux 的工具，即使這些工具已開啟。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
