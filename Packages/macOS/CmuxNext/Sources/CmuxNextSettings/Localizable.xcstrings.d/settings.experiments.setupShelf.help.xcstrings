{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.experiments.setupShelf.help" : {
      "comment" : "Settings > Advanced > Experiments: the help line under the Setups in Make cmux Yours switch",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make cmux Yours offers four setups, such as Calm or Dense. Try one, then keep it or put your settings back."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعرض «اجعل cmux لك» أربعة إعدادات جاهزة، مثل هادئ أو كثيف. جرّب واحدًا، ثم احتفظ به أو أعِد إعداداتك."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prilagodi cmux nudi četiri postavke, npr. Mirno ili Gusto. Isprobaj jednu, pa je zadrži ili vrati svoje postavke."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør cmux til din tilbyder fire opsætninger, fx Rolig eller Tæt. Prøv en, og behold den eller sæt dine indstillinger tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Mach cmux zu deinem“ bietet vier Setups an, etwa Ruhig oder Dicht. Probier eins aus und behalte es oder stell deine Einstellungen wieder her."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz tuyo cmux ofrece cuatro configuraciones, como Tranquila o Densa. Prueba una y luego quédatela o recupera tus ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personnalisez cmux propose quatre configurations, comme Calme ou Dense. Essayez-en une, puis gardez-la ou rétablissez vos réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendi tuo cmux offre quattro configurazioni, come Calma o Densa. Provane una, poi tienila o ripristina le tue impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「cmux を自分仕様に」で「静か」や「高密度」など 4 つのセットアップを選べます。試してから、残すか元の設定に戻せます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ធ្វើ cmux ជារបស់អ្នក ផ្តល់ការរៀបចំបួន ដូចជា ស្ងប់ ឬ ក្រាស់។ សាកល្បងមួយ បន្ទាប់មករក្សាទុក ឬដាក់ការកំណត់របស់អ្នកវិញ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'cmux를 내 것으로'에서 차분함, 촘촘함 등 네 가지 설정 묶음을 제공합니다. 써 보고 유지하거나 원래 설정으로 되돌리세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjør cmux til din tilbyr fire oppsett, som Rolig eller Tett. Prøv ett, og behold det eller sett innstillingene dine tilbake."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostosuj cmux oferuje cztery zestawy, np. Spokój lub Gęsto. Wypróbuj jeden, a potem zachowaj go albo przywróć swoje ustawienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe o cmux do seu jeito oferece quatro configurações, como Calmo ou Denso. Experimente uma e depois mantenha ou volte às suas configurações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Настройте cmux под себя» предлагает четыре набора, например «Спокойно» или «Плотно». Попробуйте один, затем оставьте его или верните свои настройки."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำให้ cmux เป็นของคุณ มีชุดตั้งค่าสี่ชุด เช่น สงบ หรือ แน่น ลองหนึ่งชุด แล้วเก็บไว้หรือคืนค่าการตั้งค่าเดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux'ı Kendinize Göre Ayarlayın, Sakin veya Yoğun gibi dört kurulum sunar. Birini deneyin, sonra tutun ya da ayarlarınızı geri alın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Налаштуйте cmux під себе» пропонує чотири набори, як-от «Спокійно» чи «Щільно». Спробуйте один, а потім залиште його або поверніть свої налаштування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biến cmux thành của bạn có bốn bộ thiết lập, như Yên tĩnh hoặc Dày đặc. Thử một bộ, rồi giữ lại hoặc khôi phục cài đặt của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“打造你的 cmux”提供四种预设，例如“安静”或“紧凑”。试用一种，然后保留它或恢复你的设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「打造你的 cmux」提供四種預設，例如「安靜」或「緊湊」。試用一種，然後保留它或還原你的設定。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
