{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.agents.cacheCompact.minTokens.help" : {
      "comment" : "Settings > General > Prompt Cache: help under the token threshold field for compacting before the cache expires",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُضغط المحادثات التي يبلغ سياقها هذا القدر على الأقل، أيًا كانت نافذتها."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chatovi s barem ovoliko konteksta se sažimaju, bez obzira na njihov prozor."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chats med mindst så meget kontekst komprimeres, uanset deres vindue."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chats mit mindestens so viel Kontext werden komprimiert, unabhängig von ihrem Fenster."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chats with at least this much context are compacted, whatever their window."
          }
        },
