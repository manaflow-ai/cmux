        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "メニュー、ポップオーバー、パレット、シート、トースト、カードをフェードやスライドで表示します。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ម៉ឺនុយ ផ្ទាំងលេចឡើង ផ្ទាំងបញ្ជា សន្លឹក ការជូនដំណឹង និងកាត ស្រអាប់ និងរំកិល។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "메뉴, 팝오버, 팔레트, 시트, 토스트, 카드가 페이드와 슬라이드로 나타나고 사라집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menyer, popovere, paletten, ark, varsler og kort tones og glir."
