    "settings.ui.animations.overlays.help" : {
      "comment" : "Settings > Appearance > Motion: the help text under a motion switch (ui.animations.*).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تتلاشى القوائم والنوافذ المنبثقة ولوحة الأوامر والأوراق والإشعارات العابرة والبطاقات وتنزلق."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Meniji, skočni prozori, paleta, listovi, obavijesti i kartice blijede i klize."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menuer, popovere, paletten, ark, toasts og kort toner og glider."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menüs, Popover, die Palette, Sheets, Toasts und Karten blenden und gleiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menus, popovers, the palette, sheets, toasts and cards fade and slide."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menús, ventanas emergentes, la paleta, hojas, avisos y tarjetas aparecen con fundido y deslizamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menus, popovers, palette, feuilles, toasts et cartes apparaissent en fondu et en glissant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menu, popover, la palette, fogli, avvisi e schede informative entrano ed escono con dissolvenza e scorrimento."
