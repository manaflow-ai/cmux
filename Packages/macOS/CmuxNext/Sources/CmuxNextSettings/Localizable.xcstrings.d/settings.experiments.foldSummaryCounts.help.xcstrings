      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A finished turn's Worked for line also says what it hides, such as ran 4 commands, edited 2 files."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يذكر سطر «عمل لمدة» في الدور المكتمل أيضًا ما يخفيه، مثل: شغّل 4 أوامر، وعدّل ملفين."
          }
        },
