        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ការបំបែក ការបិទ ការពង្រីក បន្ទាត់ខណ្ឌ និងបង្អួច ផ្លាស់ទីដោយមានចលនា។"
