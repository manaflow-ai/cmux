        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Podjele, zatvaranja, zumiranja, razdjelnici i prozori pomiču se uz pokret."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Opdelinger, lukninger, zoom, skillelinjer og vinduer bevæger sig."
