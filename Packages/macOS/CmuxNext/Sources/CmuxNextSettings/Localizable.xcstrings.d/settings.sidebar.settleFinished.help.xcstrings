    "settings.sidebar.settleFinished.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chat whose answer you have read folds into Settled at the end of its list until its next turn."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المحادثة التي قرأت ردها تنتقل إلى «منتهية» في آخر قائمتها حتى دورها التالي."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razgovor čiji ste odgovor pročitali prelazi u Riješeno na kraju liste do svog sljedećeg kruga."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En chat, hvis svar du har læst, flyttes til Afsluttede nederst i listen indtil næste tur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Chat, dessen Antwort du gelesen hast, wandert bis zu seinem nächsten Zug in „Abgeschlossen“ am Ende seiner Liste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un chat cuya respuesta ya leíste pasa a Cerrados al final de su lista hasta su siguiente turno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une discussion dont vous avez lu la réponse passe dans « Réglées » en bas de sa liste jusqu’à son prochain tour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una chat di cui hai letto la risposta passa in Concluse in fondo alla lista fino al turno successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答を読んだチャットは、次のターンまでリストの最後の「完了済み」にまとめられます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការជជែកដែលអ្នកបានអានចម្លើយ នឹងចូលទៅក្នុង បានបញ្ចប់ នៅចុងបញ្ជី រហូតដល់វេនបន្ទាប់។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "답변을 읽은 채팅은 다음 턴까지 목록 끝의 정리됨으로 들어갑니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En chat der du har lest svaret, flyttes til Avsluttet nederst i listen til neste tur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czat, którego odpowiedź przeczytano, trafia do Zakończonych na końcu listy aż do następnej tury."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma conversa cuja resposta você leu vai para Concluídas no fim da lista até a próxima vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чат, ответ в котором вы прочитали, уходит в «Завершённые» в конце списка до следующего хода."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แชตที่คุณอ่านคำตอบแล้วจะย้ายไปที่ เสร็จแล้ว ท้ายรายการจนกว่าจะมีรอบถัดไป"
