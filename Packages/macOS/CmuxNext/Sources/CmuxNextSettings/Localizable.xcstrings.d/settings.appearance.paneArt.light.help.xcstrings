    "settings.appearance.paneArt.light.help" : {
      "comment" : "Settings row help for the light pane art list.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pictures behind panes in the light appearance. Empty, the dark list."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صور خلف اللوحات في المظهر الفاتح. إذا كانت فارغة، تُستخدم القائمة الداكنة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slike iza okana u svijetlom izgledu. Ako je prazno, tamna lista."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billeder bag ruderne i det lyse udseende. Hvis feltet er tomt, bruges den mørke liste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilder hinter den Bereichen im hellen Erscheinungsbild. Leer: die dunkle Liste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imágenes detrás de los paneles en la apariencia clara. Vacío, la lista oscura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Images derrière les panneaux en apparence claire. Vide : la liste sombre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immagini dietro i riquadri nell'aspetto chiaro. Se vuoto, l'elenco scuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライト表示でペインの背後に置く画像です。空ならダークのリストを使います。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "រូបភាពនៅពីក្រោយផ្ទាំងក្នុងរូបរាងភ្លឺ។ ពេលទទេ ប្រើបញ្ជីងងឹត។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이트 모드에서 패널 뒤에 놓는 그림입니다. 비워 두면 다크 목록을 씁니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilder bak rutene i det lyse utseendet. Hvis feltet er tomt, brukes den mørke listen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrazy za panelami w jasnym wyglądzie. Gdy puste, używana jest lista ciemna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imagens atrás dos painéis na aparência clara. Se vazio, a lista escura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изображения за панелями в светлом оформлении. Если пусто, тёмный список."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ภาพที่อยู่หลังบานหน้าต่างในลักษณะที่ปรากฏแบบสว่าง หากว่าง จะใช้รายการของโหมดมืด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açık görünümde bölmelerin arkasındaki görseller. Boşsa koyu liste kullanılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зображення за панелями у світлому вигляді. Якщо порожньо, темний список."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các ảnh phía sau khung trong giao diện sáng. Khi để trống, dùng danh sách tối."
          }
