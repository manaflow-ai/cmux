{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.appearance.spacingScale.help" : {
      "comment" : "Settings > Appearance: a look's layout and proportions (appearance.metrics)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One multiplier for the chrome's padding and gaps (the spacing grid). Unset is the density's."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein Faktor für die Innenabstände und Lücken der Oberfläche (das Abstandsraster). Ohne Wert gilt die Dichte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un multiplicateur pour les marges et les écarts de l’interface (la grille d’espacement). Sans valeur, celui de la densité."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مُضاعِف واحد لحشوات الواجهة وفجواتها (شبكة التباعد). بلا قيمة تُستخدم قيمة الكثافة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un multiplicador para los rellenos y separaciones de la interfaz (la cuadrícula de espaciado). Sin valor, el de la densidad."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "介面內距與間隙（間距網格）的單一倍數。未設定時沿用密度的值。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "界面内边距与间隙（间距网格）的单一倍数。未设置时沿用密度的值。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "인터페이스 안쪽 여백과 간격(간격 그리드)에 곱하는 하나의 배수입니다. 설정하지 않으면 밀도 값을 따릅니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "画面の余白と間隔（余白グリッド）にかける倍率。未設定なら密度の値です。"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jedan množitelj za unutrašnje razmake i praznine sučelja (mreža razmaka). Bez vrijednosti važi gustina."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Én faktor for brugerfladens margener og mellemrum (afstandsgitteret). Uden værdi gælder tætheden."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un moltiplicatore per le spaziature e gli spazi dell’interfaccia (la griglia di spaziatura). Se non impostato, vale la densità."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "មេគុណមួយសម្រាប់គម្លាតខាងក្នុង និងចន្លោះនៃផ្ទៃប្រើប្រាស់ (ក្រឡាចត្រង្គគម្លាត)។ បើមិនកំណត់ ប្រើតម្លៃនៃដង់ស៊ីតេ។"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Én faktor for grensesnittets marger og mellomrom (avstandsrutenettet). Uten verdi gjelder tettheten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jeden mnożnik dopełnień i odstępów interfejsu (siatka odstępów). Bez wartości obowiązuje gęstość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um multiplicador para os espaçamentos e intervalos da interface (a grade de espaçamento). Sem valor, vale a densidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Один множитель для отступов и промежутков интерфейса (сетка интервалов). Без значения действует плотность."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ตัวคูณเดียวสำหรับช่องว่างภายในและระยะห่างของอินเทอร์เฟซ (ตารางระยะห่าง) หากไม่ตั้งค่า จะใช้ค่าของความหนาแน่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arayüzün iç boşlukları ve aralıkları için tek bir çarpan (aralık ızgarası). Ayarlanmazsa yoğunluğunki geçerlidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Один множник для відступів і проміжків інтерфейсу (сітка інтервалів). Без значення діє щільність."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Một hệ số nhân cho phần đệm và khoảng trống của giao diện (lưới khoảng cách). Nếu không đặt, dùng giá trị của mật độ."
          }
        }
      }
    }
  },
  "version" : "1.0"
