    },
    "settings.chats.root.volume": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folders on other or network volumes are not allowed."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُسمح بالمجلدات الموجودة على وحدات تخزين أخرى أو شبكية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fascikle na drugim ili mrežnim diskovima nisu dozvoljene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapper på andre diske eller netværksdrev er ikke tilladt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner auf anderen oder Netzwerklaufwerken sind nicht zulässig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se permiten carpetas en otros volúmenes o volúmenes de red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dossiers sur d’autres volumes ou sur des volumes réseau ne sont pas autorisés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cartelle su altri volumi o volumi di rete non sono consentite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のボリュームやネットワークボリュームのフォルダは使用できません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអនុញ្ញាតថតនៅលើភាគផ្ទុកផ្សេង ឬបណ្តាញទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 볼륨이나 네트워크 볼륨의 폴더는 허용되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapper på andre disker eller nettverksdisker er ikke tillatt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foldery na innych lub sieciowych woluminach nie są dozwolone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastas em outros volumes ou volumes de rede não são permitidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папки на других или сетевых томах не допускаются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่อนุญาตให้ใช้โฟลเดอร์บนโวลุ่มอื่นหรือโวลุ่มเครือข่าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer veya ağ birimlerindeki klasörlere izin verilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Папки на інших або мережевих томах не допускаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cho phép thư mục trên ổ đĩa khác hoặc ổ đĩa mạng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不允许使用其他卷或网络卷上的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不允許使用其他卷宗或網路卷宗上的資料夾。"
          }
        }
      }
    },
