    "settings.sidebar.cards.tips.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A daily card shows one cmux feature you have not used yet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "まだ使っていない cmux の機能を 1 日に 1 つカードで表示します。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تعرض بطاقة يومية ميزة واحدة من cmux لم تستخدمها بعد."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dnevna kartica prikazuje jednu cmux funkciju koju još niste koristili."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Et dagligt kort viser én cmux-funktion, du ikke har brugt endnu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine tägliche Karte zeigt eine cmux-Funktion, die du noch nicht genutzt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una tarjeta diaria muestra una función de cmux que aún no has usado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une carte quotidienne présente une fonctionnalité de cmux que vous n’avez pas encore utilisée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una scheda giornaliera mostra una funzione di cmux che non hai ancora usato."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "កាតប្រចាំថ្ងៃបង្ហាញមុខងារ cmux មួយដែលអ្នកមិនទាន់បានប្រើ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "아직 사용하지 않은 cmux 기능을 하루에 하나씩 카드로 보여 줍니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Et daglig kort viser én cmux-funksjon du ikke har brukt ennå."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Codzienna karta pokazuje jedną funkcję cmux, której jeszcze nie używasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um cartão diário mostra um recurso do cmux que você ainda não usou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Карточка раз в день показывает функцию cmux, которой вы ещё не пользовались."
          }
        },
        "th" : {
          "stringUnit" : {
