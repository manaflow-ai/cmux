    "settings.sidebar.hoverCards.layout.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What a workspace's hover card shows: its history of prompts and waits, its details, or both."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースのホバーカードに表示する内容: プロンプトと待機の履歴、詳細、またはその両方。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ما تعرضه بطاقة التمرير لمساحة العمل: سجل الطلبات والانتظار، أو تفاصيلها، أو كلاهما."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Šta prikazuje kartica radnog prostora: historiju upita i čekanja, detalje ili oboje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvad et arbejdsområdes kort viser: historikken over prompts og ventetid, detaljerne eller begge dele."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Was die Karte eines Arbeitsbereichs zeigt: den Verlauf der Prompts und Wartezeiten, die Details oder beides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Qué muestra la tarjeta de un espacio: su historial de instrucciones y esperas, sus detalles o ambos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce que montre la carte d'un espace : l'historique des prompts et des attentes, ses détails, ou les deux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cosa mostra la scheda di un'area di lavoro: la cronologia di prompt e attese, i dettagli o entrambi."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អ្វីដែលកាតកន្លែងធ្វើការបង្ហាញ៖ ប្រវត្តិសំណើ និងការរង់ចាំ ព័ត៌មានលម្អិត ឬទាំងពីរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "작업 공간 카드에 표시할 내용: 프롬프트와 대기 기록, 세부 정보 또는 둘 다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hva kortet for et arbeidsområde viser: historikken over prompts og venting, detaljene eller begge."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Co pokazuje karta obszaru: historię promptów i oczekiwań, szczegóły lub oba."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O que o cartão de um espaço mostra: o histórico de prompts e esperas, os detalhes ou ambos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Что показывает карточка рабочей области: историю запросов и ожиданий, подробности или и то, и другое."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สิ่งที่การ์ดของพื้นที่ทำงานแสดง: ประวัติพรอมต์และการรอ รายละเอียด หรือทั้งสองอย่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Çalışma alanı kartının gösterdiği: istem ve bekleme geçmişi, ayrıntılar veya ikisi birden."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Що показує картка робочої області: історію запитів і очікувань, подробиці або обидва."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thẻ không gian làm việc hiển thị gì: lịch sử lời nhắc và chờ, chi tiết, hoặc cả hai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "工作区悬停卡片显示的内容：提示和等待的历史、详细信息，或两者。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "工作區懸停卡片顯示的內容：提示與等待的歷史、詳細資訊，或兩者。"
          }
        }
      }
    },
