        }
      }
    },
    "settings.terminal.linkOpener.default.help": {
      "comment": "Help for Terminal > Open Program Links In. Keep the literal values (cmux, system, chrome, app:<name>, command:<command>, BROWSER) untranslated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where a URL goes when a program in a terminal opens a browser, such as aws login or gh auth login: cmux, system, chrome, safari, arc, firefox, edge, brave, app:<name>, a profile after @ (chrome@Profile 1), or command:<command> to let your script decide. A BROWSER you set yourself wins."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "المكان الذي يذهب إليه الرابط عندما يفتح برنامج في الطرفية متصفحًا، مثل aws login أو gh auth login: cmux أو system أو chrome أو safari أو arc أو firefox أو edge أو brave أو app:<name>، أو ملف تعريف بعد @ (chrome@Profile 1)، أو command:<command> ليقرر البرنامج النصي الخاص بك. متغير BROWSER الذي تضبطه بنفسك له الأولوية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gdje ide URL kada program u terminalu otvori preglednik, npr. aws login ili gh auth login: cmux, system, chrome, safari, arc, firefox, edge, brave, app:<name>, profil nakon @ (chrome@Profile 1) ili command:<command> da vaša skripta odluči. BROWSER koji sami postavite ima prednost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvor en URL går hen, når et program i en terminal åbner en browser, fx aws login eller gh auth login: cmux, system, chrome, safari, arc, firefox, edge, brave, app:<name>, en profil efter @ (chrome@Profile 1) eller command:<command>, så dit script bestemmer. En BROWSER, du selv sætter, vinder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wohin eine URL geht, wenn ein Programm im Terminal einen Browser öffnet, etwa aws login oder gh auth login: cmux, system, chrome, safari, arc, firefox, edge, brave, app:<name>, ein Profil nach @ (chrome@Profile 1) oder command:<command>, damit dein Skript entscheidet. Ein selbst gesetztes BROWSER hat Vorrang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adónde va una URL cuando un programa en una terminal abre un navegador, como aws login o gh auth login: cmux, system, chrome, safari, arc, firefox, edge, brave, app:<name>, un perfil tras @ (chrome@Profile 1) o command:<command> para que decida tu script. Un BROWSER que definas tú tiene prioridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Où va une URL quand un programme du terminal ouvre un navigateur, comme aws login ou gh auth login : cmux, system, chrome, safari, arc, firefox, edge, brave, app:<name>, un profil après @ (chrome@Profile 1) ou command:<command> pour laisser votre script décider. Un BROWSER que vous définissez vous-même l’emporte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dove va un URL quando un programma nel terminale apre un browser, come aws login o gh auth login: cmux, system, chrome, safari, arc, firefox, edge, brave, app:<name>, un profilo dopo @ (chrome@Profile 1) o command:<command> per far decidere il tuo script. Un BROWSER impostato da te ha la precedenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ターミナルのプログラムがブラウザを開くとき (aws login や gh auth login など) の URL の行き先: cmux、system、chrome、safari、arc、firefox、edge、brave、app:<name>、@ の後にプロファイル (chrome@Profile 1)、またはスクリプトに任せる command:<command>。自分で設定した BROWSER が優先されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កន្លែងដែល URL ទៅ នៅពេលកម្មវិធីក្នុងទែមីណាល់បើកកម្មវិធីរុករក ដូចជា aws login ឬ gh auth login៖ cmux, system, chrome, safari, arc, firefox, edge, brave, app:<name>, ប្រវត្តិរូបបន្ទាប់ពី @ (chrome@Profile 1) ឬ command:<command> ដើម្បីឲ្យស្គ្រីបរបស់អ្នកសម្រេច។ BROWSER ដែលអ្នកកំណត់ខ្លួនឯងមានអាទិភាព។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "터미널의 프로그램이 브라우저를 열 때(예: aws login, gh auth login) URL이 가는 곳: cmux, system, chrome, safari, arc, firefox, edge, brave, app:<name>, @ 뒤의 프로필(chrome@Profile 1), 또는 스크립트가 정하게 하는 command:<command>. 직접 설정한 BROWSER가 우선합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvor en URL går når et program i en terminal åpner en nettleser, for eksempel aws login eller gh auth login: cmux, system, chrome, safari, arc, firefox, edge, brave, app:<name>, en profil etter @ (chrome@Profile 1), eller command:<command> for å la skriptet ditt bestemme. En BROWSER du setter selv, vinner."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dokąd trafia URL, gdy program w terminalu otwiera przeglądarkę, np. aws login lub gh auth login: cmux, system, chrome, safari, arc, firefox, edge, brave, app:<name>, profil po @ (chrome@Profile 1) albo command:<command>, aby zdecydował Twój skrypt. Ustawiona przez Ciebie zmienna BROWSER ma pierwszeństwo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para onde vai uma URL quando um programa no terminal abre um navegador, como aws login ou gh auth login: cmux, system, chrome, safari, arc, firefox, edge, brave, app:<name>, um perfil após @ (chrome@Profile 1) ou command:<command> para seu script decidir. Um BROWSER definido por você tem prioridade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Куда идёт URL, когда программа в терминале открывает браузер, например aws login или gh auth login: cmux, system, chrome, safari, arc, firefox, edge, brave, app:<name>, профиль после @ (chrome@Profile 1) или command:<command>, чтобы решал ваш скрипт. Заданная вами переменная BROWSER имеет приоритет."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ที่ที่ URL ไปเมื่อโปรแกรมในเทอร์มินัลเปิดเบราว์เซอร์ เช่น aws login หรือ gh auth login: cmux, system, chrome, safari, arc, firefox, edge, brave, app:<name>, โปรไฟล์หลัง @ (chrome@Profile 1) หรือ command:<command> เพื่อให้สคริปต์ของคุณตัดสินใจ BROWSER ที่คุณตั้งเองจะมีผลก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminaldeki bir program tarayıcı açtığında (aws login veya gh auth login gibi) URL'nin gittiği yer: cmux, system, chrome, safari, arc, firefox, edge, brave, app:<name>, @ sonrasında bir profil (chrome@Profile 1) veya betiğinizin karar vermesi için command:<command>. Kendi ayarladığınız BROWSER önceliklidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Куди йде URL, коли програма в терміналі відкриває браузер, наприклад aws login або gh auth login: cmux, system, chrome, safari, arc, firefox, edge, brave, app:<name>, профіль після @ (chrome@Profile 1) або command:<command>, щоб вирішував ваш скрипт. Встановлена вами змінна BROWSER має пріоритет."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nơi URL được mở khi một chương trình trong terminal mở trình duyệt, như aws login hoặc gh auth login: cmux, system, chrome, safari, arc, firefox, edge, brave, app:<name>, một hồ sơ sau @ (chrome@Profile 1), hoặc command:<command> để script của bạn quyết định. BROWSER do bạn tự đặt sẽ được ưu tiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "终端中的程序打开浏览器时（例如 aws login 或 gh auth login）URL 的去向：cmux、system、chrome、safari、arc、firefox、edge、brave、app:<name>、@ 后接配置文件（chrome@Profile 1），或用 command:<command> 让你的脚本决定。你自己设置的 BROWSER 优先。"
          }
