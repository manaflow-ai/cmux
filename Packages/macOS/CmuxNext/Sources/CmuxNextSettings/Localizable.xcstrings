        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "완료되었거나 닫힌 하위 세션은 포함되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ferdige og lukkede underøkter teller ikke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zakończone i zamknięte podsesje się nie liczą."
          }
        },
        "pt-BR": {
          "stringUnit": {
