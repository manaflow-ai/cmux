    "settings.appearance.borders.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None removes every border, hairline and separator in the app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「なし」にすると、アプリ内のすべての枠線、細線、区切り線がなくなります。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«بلا» يزيل كل الحدود والخطوط الرفيعة والفواصل في التطبيق."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bez uklanja sve ivice, tanke linije i razdjelnike u aplikaciji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen fjerner alle kanter, hårstreger og skillelinjer i appen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Keine“ entfernt alle Rahmen, Haarlinien und Trennlinien in der App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ninguno quita todos los bordes, líneas finas y separadores de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucune retire toutes les bordures, lignes fines et séparateurs de l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessuno rimuove tutti i bordi, le linee sottili e i separatori dell’app."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្មាន ដកស៊ុម បន្ទាត់ស្តើង និងបន្ទាត់ខណ្ឌទាំងអស់ក្នុងកម្មវិធី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "없음으로 하면 앱의 모든 테두리, 가는 선, 구분선이 사라집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen fjerner alle kanter, hårstreker og skillelinjer i appen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brak usuwa wszystkie obramowania, cienkie linie i separatory w aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhuma remove todas as bordas, linhas finas e separadores do app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Нет» убирает все рамки, тонкие линии и разделители в приложении."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่มี จะเอาเส้นขอบ เส้นบาง และเส้นคั่นทั้งหมดในแอปออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yok, uygulamadaki tüm kenarlıkları, ince çizgileri ve ayırıcıları kaldırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Немає» прибирає всі рамки, тонкі лінії й роздільники в застосунку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không sẽ bỏ mọi viền, đường mảnh và đường phân cách trong ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“无”会移除应用中的所有边框、细线和分隔线。"
          }
