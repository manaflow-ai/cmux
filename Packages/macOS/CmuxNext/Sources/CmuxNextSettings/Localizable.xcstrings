    "settings.attention.agentChats.help": {
      "comment": "Help for notifications.attention.agentChats",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ring an agent chat's pane when its turn ends, until you click or type in it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إظهار حلقة حول جزء دردشة الوكيل عند انتهاء دوره، حتى تنقر عليه أو تكتب فيه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prikaži prsten oko okna chata s agentom kad mu se potez završi, dok ne klikneš ili ne kucaš u njemu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vis en ring om en agentchats rude, når dens tur slutter, indtil du klikker eller skriver i den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeigt einen Ring um den Bereich eines Agent-Chats, wenn sein Zug endet, bis du hineinklickst oder tippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Muestra un anillo en el panel de un chat del agente cuando termina su turno, hasta que hagas clic o escribas en él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Affiche un anneau autour du volet d’une discussion d’agent à la fin de son tour, jusqu’à ce que vous cliquiez ou tapiez dedans."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mostra un anello intorno al riquadro di una chat dell’agente quando il suo turno finisce, finché non fai clic o scrivi al suo interno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "エージェントチャットのターンが終わると、クリックするか入力するまでペインにリングを表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បង្ហាញរង្វង់ជុំវិញផ្ទាំងជជែកភ្នាក់ងារ នៅពេលវេនរបស់វាបញ្ចប់ រហូតដល់អ្នកចុច ឬវាយបញ្ចូលក្នុងវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트 채팅의 턴이 끝나면 클릭하거나 입력할 때까지 창에 링을 표시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vis en ring rundt en agentchats rute når turen er over, til du klikker eller skriver i den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokazuj obwódkę panelu czatu z agentem po zakończeniu jego tury, dopóki go nie klikniesz lub nie zaczniesz w nim pisać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mostra um anel no painel de um chat do agente quando o turno termina, até você clicar ou digitar nele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Показывать кольцо вокруг панели чата с агентом, когда его ход заканчивается, пока вы не щёлкнете или не начнёте печатать в ней."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แสดงวงแหวนรอบบานหน้าต่างแชทเอเจนต์เมื่อจบเทิร์น จนกว่าคุณจะคลิกหรือพิมพ์ในนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir ajan sohbetinin sırası bittiğinde, tıklayana veya yazana kadar bölmesinde halka gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Показувати кільце навколо панелі чату з агентом, коли його хід завершується, доки ви не клацнете або не почнете друкувати в ній."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hiển thị vòng quanh khung trò chuyện tác tử khi lượt của nó kết thúc, cho đến khi bạn nhấp hoặc gõ vào đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "代理聊天的回合结束时，在其窗格周围显示环，直到你点击或在其中输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "代理聊天的回合結束時，在其窗格周圍顯示環，直到你點按或在其中輸入。"
          }
        }
      }
    },
