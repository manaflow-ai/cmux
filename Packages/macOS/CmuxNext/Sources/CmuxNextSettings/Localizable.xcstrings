    "settings.chats.sessionRecap.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A line on where a Claude chat stands when you come back. Each is a small model call."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سطر يوضح ما وصلت إليه محادثة Claude عند عودتك. كل ملخص استدعاء صغير للنموذج."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Red o tome gdje je Claude razgovor stao kada se vratite. Svaki je mali poziv modela."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En linje om, hvor en Claude-chat står, når du vender tilbage. Hver er et lille modelkald."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Zeile zum Stand eines Claude-Chats, wenn du zurückkehrst. Jede ist ein kleiner Modellaufruf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una línea sobre dónde está un chat de Claude cuando vuelves. Cada una es una pequeña llamada al modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une ligne sur l'état d'un chat Claude quand vous y revenez. Chacune est un petit appel au modèle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una riga sul punto in cui si trova una chat di Claude quando torni. Ognuna è una piccola chiamata al modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Claudeのチャットに戻ったとき、現在の状況を1行で表示します。まとめごとに小さなモデル呼び出しが1回かかります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មួយបន្ទាត់អំពីស្ថានភាពការជជែក Claude ពេលអ្នកត្រឡប់មកវិញ។ នីមួយៗជាការហៅម៉ូដែលតូចមួយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Claude 채팅으로 돌아오면 현재 상황을 한 줄로 보여 줍니다. 요약마다 모델을 한 번 더 호출합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En linje om hvor en Claude-chat står når du kommer tilbake. Hver er et lite modellkall."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wiersz o tym, na czym stanął czat Claude, gdy do niego wracasz. Każdy to małe wywołanie modelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma linha sobre onde um chat do Claude está quando você volta. Cada uma é uma pequena chamada ao modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Строка о том, на чём остановился чат Claude, когда вы возвращаетесь. Каждая — небольшой вызов модели."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หนึ่งบรรทัดบอกว่าแชต Claude อยู่ตรงไหนแล้วเมื่อคุณกลับมา แต่ละครั้งคือการเรียกโมเดลเล็กน้อยหนึ่งครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir Claude sohbetine döndüğünüzde nerede kaldığını gösteren bir satır. Her biri küçük bir model çağrısıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Рядок про те, на чому зупинився чат Claude, коли ви повертаєтеся. Кожен — невеликий виклик моделі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Một dòng về tình trạng cuộc trò chuyện Claude khi bạn quay lại. Mỗi lần là một lần gọi mô hình nhỏ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "回到 Claude 聊天时，显示一行说明当前进展。每次都是一次小型模型调用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "回到 Claude 聊天時，顯示一行說明目前進展。每次都是一次小型模型呼叫。"
          }
        }
      }
    },
