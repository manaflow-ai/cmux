    "settings.agentPane.attachmentView.help": {
      "comment": "Settings > Agent Chat > Attachment View: help under the row",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طريقة ظهور الصور والملفات في مربع الكتابة وفي الرسائل المرسلة. «ضمن النص» يضع كل واحد منها في النص حيث أضفته؛ «شريط» يعرضها في صف. تبقى الرسالة وترتيبها كما هما."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kako se slike i datoteke prikazuju u polju za pisanje i u poslanim porukama. U tekstu stavlja svaku tamo gdje ste je dodali; Traka ih prikazuje u redu. Poruka i njen redoslijed ostaju isti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvordan billeder og filer vises i skrivefeltet og i sendte beskeder. I teksten placerer hver enkelt, hvor du tilføjede den; Bånd viser dem på en række. Beskeden og dens rækkefølge forbliver den samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie Bilder und Dateien im Eingabefeld und in gesendeten Nachrichten erscheinen. Im Text setzt jedes dorthin, wo du es hinzugefügt hast; Leiste zeigt sie in einer Reihe. Die Nachricht und ihre Reihenfolge bleiben gleich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How pictures and files show in the composer and in sent messages. Inline puts each one in the text where you added it; Strip shows them in a row. The message and its order stay the same."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo se muestran las imágenes y los archivos en el redactor y en los mensajes enviados. En el texto coloca cada uno donde lo añadiste; Tira los muestra en una fila. El mensaje y su orden no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment les images et les fichiers s’affichent dans le champ de saisie et dans les messages envoyés. Dans le texte place chacun là où vous l’avez ajouté ; Bandeau les affiche sur une ligne. Le message et son ordre restent les mêmes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come appaiono immagini e file nel campo di scrittura e nei messaggi inviati. Nel testo mette ciascuno dove l’hai aggiunto; Striscia li mostra in una fila. Il messaggio e il suo ordine restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力欄と送信済みメッセージでの画像とファイルの表示方法。インラインは追加した位置のテキスト内に置き、ストリップは1列に並べて表示します。メッセージとその順序は変わりません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "របៀបដែលរូបភាព និងឯកសារបង្ហាញក្នុងប្រអប់សរសេរ និងក្នុងសារដែលបានផ្ញើ។ ក្នុងអត្ថបទ ដាក់នីមួយៗនៅកន្លែងដែលអ្នកបានបន្ថែម; ឆ្នូត បង្ហាញពួកវាជាជួរ។ សារ និងលំដាប់របស់វានៅដដែល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성란과 보낸 메시지에서 사진과 파일이 표시되는 방식입니다. 인라인은 추가한 위치의 텍스트 안에 두고, 스트립은 한 줄로 보여 줍니다. 메시지와 순서는 그대로 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvordan bilder og filer vises i skrivefeltet og i sendte meldinger. I teksten plasserer hver der du la den til; Stripe viser dem på en rad. Meldingen og rekkefølgen forblir den samme."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak obrazy i pliki wyświetlają się w polu wiadomości i w wysłanych wiadomościach. W tekście umieszcza każdy tam, gdzie go dodano; Pasek pokazuje je w rzędzie. Wiadomość i jej kolejność się nie zmieniają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como imagens e arquivos aparecem no campo de escrita e nas mensagens enviadas. No texto coloca cada um onde você o adicionou; Faixa mostra-os em uma fileira. A mensagem e sua ordem continuam iguais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как картинки и файлы показываются в поле ввода и в отправленных сообщениях. «В тексте» ставит каждый туда, куда вы его добавили; «Лента» показывает их в ряд. Сообщение и его порядок не меняются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิธีแสดงรูปภาพและไฟล์ในช่องเขียนข้อความและในข้อความที่ส่งแล้ว แบบในบรรทัดจะวางแต่ละรายการไว้ในข้อความตรงที่คุณเพิ่ม แบบแถบจะแสดงเรียงเป็นแถว ข้อความและลำดับยังคงเหมือนเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resimlerin ve dosyaların yazma alanında ve gönderilen mesajlarda nasıl görüneceği. Satır İçi her birini eklediğiniz yere metnin içine koyar; Şerit bunları bir sırada gösterir. Mesaj ve sırası aynı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як зображення та файли показуються в полі введення і в надісланих повідомленнях. «У тексті» ставить кожне туди, куди ви його додали; «Стрічка» показує їх у ряд. Повідомлення та його порядок не змінюються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cách ảnh và tệp hiển thị trong ô soạn và trong tin nhắn đã gửi. Nội dòng đặt từng mục vào văn bản tại chỗ bạn thêm; Dải hiển thị chúng thành một hàng. Tin nhắn và thứ tự của nó vẫn giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片和文件在输入框及已发送消息中的显示方式。“内嵌”将每个附件放在你添加它的文本位置；“横条”将它们排成一行显示。消息及其顺序保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片和檔案在輸入框及已傳送訊息中的顯示方式。「內嵌」會將每個附件放在你加入它的文字位置；「橫條」會將它們排成一列顯示。訊息及其順序保持不變。"
          }
        }
      }
    },
