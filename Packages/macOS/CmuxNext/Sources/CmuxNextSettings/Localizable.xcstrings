    "settings.agentPane.display.codeSize.help": {
      "comment": "Settings: the agent chat's and Markdown viewer's display rows",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Code as a share of the chat's text size. Empty uses the Markdown viewer's."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حجم الشيفرة كنسبة من حجم نص الدردشة. إذا كان فارغًا فيُستخدم ما في عارض Markdown."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod kao udio veličine teksta razgovora. Prazno koristi vrijednost Markdown preglednika."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode som andel af chattens tekststørrelse. Tom bruger Markdown-fremviserens."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Code als Anteil der Textgröße im Chat. Leer nutzt den Wert der Markdown-Ansicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código como proporción del tamaño del texto del chat. Vacío usa el del visor de Markdown."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code en proportion de la taille du texte du chat. Vide utilise celle du lecteur Markdown."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice come quota della dimensione del testo della chat. Vuoto usa quella del visualizzatore Markdown."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットの文字サイズに対するコードの比率。空の場合はMarkdownビューアの値を使います。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កូដជាសមាមាត្រនៃទំហំអក្សរជជែក។ ទទេ ប្រើតម្លៃរបស់កម្មវិធីមើល Markdown។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅 텍스트 크기에 대한 코드 비율입니다. 비워 두면 Markdown 뷰어의 값을 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode som andel av tekststørrelsen i chatten. Tom bruker Markdown-visningens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod jako część rozmiaru tekstu czatu. Puste używa wartości podglądu Markdown."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código como proporção do tamanho do texto do chat. Vazio usa o do visualizador de Markdown."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер кода как доля размера текста чата. Если пусто, используется значение просмотра Markdown."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขนาดโค้ดเป็นสัดส่วนของขนาดข้อความแชท ถ้าว่างจะใช้ของตัวแสดง Markdown"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodun sohbet metni boyutuna oranı. Boş bırakılırsa Markdown Görüntüleyici'ninki kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розмір коду як частка розміру тексту чату. Якщо порожньо, використовується значення переглядача Markdown."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã theo tỷ lệ cỡ chữ trò chuyện. Để trống sẽ dùng giá trị của trình xem Markdown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码相对聊天文字大小的比例。留空则使用 Markdown 查看器的设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "程式碼相對聊天文字大小的比例。留空則使用 Markdown 檢視器的設定。"
          }
        }
      }
    },
