    "settings.browser.keepNeighborTabsAwake": {
      "comment": "Settings row in Browser > Memory: browser.keepNeighborTabsAwake.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إبقاء علامات التبويب المجاورة نشطة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Drži susjedne kartice budnim"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
