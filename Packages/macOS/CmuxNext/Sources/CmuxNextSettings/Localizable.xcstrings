    "settings.labs.voiceRoomURL.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عنوان الويب للغرفة. إذا كان فارغًا يُستخدم خادم الغرفة على هذا الـMac."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Web adresa sobe. Prazno koristi server sobe na ovom Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rummets webadresse. Tom bruger rumserveren på denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Webadresse des Raums. Leer nutzt den Raumserver auf diesem Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The room's web address. Empty uses the room server on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La dirección web de la sala. Vacío usa el servidor de salas de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’adresse web de la salle. Vide utilise le serveur de salle de ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’indirizzo web della stanza. Vuoto usa il server delle stanze di questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ルームの Web アドレス。空欄のときはこの Mac のルームサーバーを使います。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អាសយដ្ឋានវេបរបស់បន្ទប់។ ទុកទទេ ប្រើម៉ាស៊ីនមេបន្ទប់នៅលើ Mac នេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "룸의 웹 주소입니다. 비워 두면 이 Mac의 룸 서버를 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rommets nettadresse. Tom bruker romserveren på denne Macen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adres internetowy pokoju. Puste używa serwera pokoju na tym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O endereço da web da sala. Vazio usa o servidor de salas deste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Веб-адрес комнаты. Если пусто, используется сервер комнаты на этом Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ที่อยู่เว็บของห้อง ถ้าเว้นว่างจะใช้เซิร์ฟเวอร์ห้องบน Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odanın web adresi. Boş bırakılırsa bu Mac'teki oda sunucusu kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Веб-адреса кімнати. Якщо порожньо, використовується сервер кімнати на цьому Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Địa chỉ web của phòng. Để trống sẽ dùng máy chủ phòng trên máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "房间的网址。留空则使用这台 Mac 上的房间服务器。"
