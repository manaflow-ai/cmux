    "settings.appearance.paneBackgrounds.help": {
      "comment": "Settings row help for Pane Backgrounds.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One background behind the whole window, or a copy in each pane. A pane's own background (right-click a pane) shows either way."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خلفية واحدة خلف النافذة كلها، أو نسخة في كل جزء. تظهر خلفية الجزء الخاصة (انقر بزر الماوس الأيمن على الجزء) في الحالتين."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna pozadina iza cijelog prozora ili kopija u svakom oknu. Vlastita pozadina okna (desni klik na okno) prikazuje se u oba slučaja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Én baggrund bag hele vinduet eller en kopi i hver rude. En rudes egen baggrund (højreklik på en rude) vises i begge tilfælde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Hintergrund hinter dem ganzen Fenster oder eine Kopie in jedem Bereich. Der eigene Hintergrund eines Bereichs (Rechtsklick auf den Bereich) wird immer angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fondo detrás de toda la ventana o una copia en cada panel. El fondo propio de un panel (clic derecho en el panel) se muestra en ambos casos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un arrière-plan derrière toute la fenêtre, ou une copie dans chaque volet. L'arrière-plan propre d'un volet (clic droit sur le volet) s'affiche dans les deux cas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno sfondo dietro l'intera finestra o una copia in ogni riquadro. Lo sfondo proprio di un riquadro (clic destro sul riquadro) si vede in entrambi i casi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウ全体に1つの背景、またはペインごとにコピーを表示します。ペイン固有の背景（ペインを右クリック）はどちらの場合も表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្ទៃខាងក្រោយមួយនៅពីក្រោយបង្អួចទាំងមូល ឬច្បាប់ចម្លងមួយក្នុងផ្ទាំងនីមួយៗ។ ផ្ទៃខាងក្រោយផ្ទាល់ខ្លួនរបស់ផ្ទាំង (ចុចកណ្ដុរស្ដាំលើផ្ទាំង) បង្ហាញទាំងពីរករណី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창 전체 뒤에 배경 하나, 또는 각 창 영역에 사본을 표시합니다. 창 영역 자체 배경(창 영역을 오른쪽 클릭)은 어느 쪽이든 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én bakgrunn bak hele vinduet, eller en kopi i hver rute. En rutes egen bakgrunn (høyreklikk på en rute) vises uansett."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno tło za całym oknem lub kopia w każdym panelu. Własne tło panelu (kliknij panel prawym przyciskiem) jest widoczne w obu przypadkach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um fundo atrás da janela inteira ou uma cópia em cada painel. O fundo próprio de um painel (clique com o botão direito no painel) aparece nos dois casos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один фон за всем окном или копия в каждой панели. Собственный фон панели (щелчок правой кнопкой по панели) виден в обоих случаях."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นหลังเดียวหลังทั้งหน้าต่าง หรือสำเนาในแต่ละบานหน้าต่าง พื้นหลังเฉพาะของบานหน้าต่าง (คลิกขวาที่บานหน้าต่าง) จะแสดงทั้งสองแบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm pencerenin arkasında tek bir arka plan ya da her bölmede bir kopya. Bir bölmenin kendi arka planı (bölmeye sağ tıklayın) her iki durumda da görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одне тло за всім вікном або копія в кожній панелі. Власне тло панелі (клацніть панель правою кнопкою) видно в обох випадках."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một hình nền phía sau toàn bộ cửa sổ, hoặc một bản sao trong mỗi khung. Hình nền riêng của khung (nhấp chuột phải vào khung) luôn hiển thị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整个窗口后面一个背景，或每个窗格各有一份副本。窗格自己的背景（右键点按窗格）在两种情况下都会显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整個視窗後方一個背景，或每個窗格各有一份副本。窗格自己的背景（在窗格上按右鍵）在兩種情況下都會顯示。"
          }
        }
      }
    },
