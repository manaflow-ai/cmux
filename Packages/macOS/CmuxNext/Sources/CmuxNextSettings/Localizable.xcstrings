        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spotify, Music 같은 앱에서 재생 중인 항목도 표시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viser også det som spilles i apper som Spotify eller Music."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokazuje też, co gra w aplikacjach takich jak Spotify lub Muzyka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Também mostra o que toca em apps como Spotify ou Music."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Показывать и то, что играет в приложениях вроде Spotify или Music."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แสดงสิ่งที่กำลังเล่นในแอปอย่าง Spotify หรือ Music ด้วย"
