    "settings.agentPane.display.thinking.shimmerBand.help": {
      "comment": "Settings > Chat > Transcript > Shimmer Width: help; 0 is the number zero",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The width of the shimmer's light band. 0 uses half the line."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "عرض شريط الضوء. القيمة 0 تستخدم نصف السطر."}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Širina svijetle trake. 0 koristi pola reda."}},
