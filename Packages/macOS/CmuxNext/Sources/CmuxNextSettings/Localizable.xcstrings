        "es": {"stringUnit": {"state": "needs_review", "value": "Poner en cola"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Mettre en file"}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Metti in coda"}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "キューに入れる"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ដាក់ជួរ"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "대기열"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Sett i kø"}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Kolejkuj"}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Enfileirar"}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "В очередь"}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เข้าคิว"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Sıraya al"}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "У чергу"}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Xếp hàng"}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "排队"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "排隊"}}
      }
    },
