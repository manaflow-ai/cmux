    "settings.markdown.codeFont.help": {
      "comment": "Settings: the agent chat's and Markdown viewer's display rows",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The font of code blocks and inline code. Empty uses the terminal font. The agent chat uses it too unless it has its own."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خط كتل الشيفرة والشيفرة المضمنة. إذا كان فارغًا فيُستخدم خط الطرفية. تستخدمه دردشة الوكيل أيضًا ما لم يكن لها خط خاص."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Font blokova koda i koda u redu. Prazno koristi font terminala. Razgovor s agentom ga također koristi osim ako ima svoj."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrifttypen til kodeblokke og indlejret kode. Tom bruger terminalens. Agentchatten bruger den også, medmindre den har sin egen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schrift für Codeblöcke und Inline-Code. Leer nutzt die Terminal-Schrift. Der Agent-Chat nutzt sie auch, außer er hat eine eigene."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fuente de los bloques de código y del código en línea. Vacío usa la del terminal. El chat del agente también la usa salvo que tenga la suya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La police des blocs de code et du code en ligne. Vide utilise celle du terminal. Le chat de l'agent l'utilise aussi, sauf s'il a la sienne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il font dei blocchi di codice e del codice in linea. Vuoto usa quello del terminale. Anche la chat dell'agente lo usa, salvo che ne abbia uno proprio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードブロックとインラインコードのフォント。空の場合はターミナルのフォントを使います。エージェントチャットも独自の設定がない限りこれを使います。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពុម្ពអក្សរនៃប្លុកកូដ និងកូដក្នុងបន្ទាត់។ ទទេ ប្រើពុម្ពអក្សរស្ថានីយ។ ការជជែកភ្នាក់ងារក៏ប្រើវាដែរ លុះត្រាតែវាមានផ្ទាល់ខ្លួន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드 블록과 인라인 코드의 글꼴입니다. 비워 두면 터미널 글꼴을 사용합니다. 에이전트 채팅도 자체 설정이 없으면 이 글꼴을 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriften for kodeblokker og innebygd kode. Tom bruker terminalens. Agentchatten bruker den også med mindre den har sin egen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czcionka bloków kodu i kodu w tekście. Puste używa czcionki terminala. Czat agenta też jej używa, chyba że ma własną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fonte dos blocos de código e do código em linha. Vazio usa a do terminal. O chat do agente também a usa, a menos que tenha a sua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шрифт блоков кода и встроенного кода. Если пусто, используется шрифт терминала. Чат агента тоже использует его, если у него нет своего."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แบบอักษรของบล็อกโค้ดและโค้ดในบรรทัด ถ้าว่างจะใช้ของเทอร์มินัล แชทเอเจนต์ก็ใช้ด้วย เว้นแต่จะตั้งของตัวเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod blokları ve satır içi kodun yazı tipi. Boş bırakılırsa terminalinki kullanılır. Ajan sohbeti de kendine ait bir tane yoksa bunu kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шрифт блоків коду та вбудованого коду. Якщо порожньо, використовується шрифт термінала. Чат агента теж використовує його, якщо не має власного."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phông chữ của khối mã và mã nội dòng. Để trống sẽ dùng phông của terminal. Trò chuyện với tác tử cũng dùng phông này trừ khi có phông riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码块和行内代码的字体。留空则使用终端字体。智能体聊天也使用它，除非设置了自己的字体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "程式碼區塊與行內程式碼的字體。留空則使用終端機字體。代理程式聊天也使用它，除非設定了自己的字體。"
          }
        }
      }
    },
    "settings.markdown.remoteImages": {
