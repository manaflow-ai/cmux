    "settings.tabs.newTabWidgets.chats.help": {
      "comment": "Settings: help for the New Tab recent chats toggle; the palette is the command palette.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محادثاتك الأخيرة تحت مربع الكتابة. ولوحة الأوامر تجد أي محادثة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši nedavni razgovori ispod polja za pisanje. Paleta pronalazi bilo koji razgovor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine seneste chats under skrivefeltet. Paletten finder enhver chat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine letzten Chats unter dem Eingabefeld. Die Befehlspalette findet jeden Chat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recent chats under the composer. The palette finds any chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus chats recientes bajo el compositor. La paleta encuentra cualquier chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos discussions récentes sous le champ de saisie. La palette trouve n’importe quelle discussion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue chat recenti sotto il compositore. La palette trova qualsiasi chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力欄の下に最近のチャットを表示します。どのチャットもパレットで見つかります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការ​ជជែក​ថ្មីៗ​របស់​អ្នក​នៅ​ក្រោម​ប្រអប់​សរសេរ។ ផ្ទាំង​ពាក្យ​បញ្ជា​រក​ឃើញ​ការ​ជជែក​ណា​មួយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력창 아래에 최근 채팅을 보여 줍니다. 팔레트에서 어떤 채팅이든 찾을 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De siste chattene dine under skrivefeltet. Paletten finner alle chatter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnie czaty pod polem tekstowym. Paleta znajdzie każdy czat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas conversas recentes abaixo do compositor. A paleta encontra qualquer conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недавние чаты под полем ввода. Палитра находит любой чат."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชตล่าสุดของคุณใต้ช่องเขียน พาเลตต์ค้นหาแชตใดก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazma alanının altında son sohbetleriniz. Palet her sohbeti bulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нещодавні чати під полем введення. Палітра знаходить будь-який чат."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cuộc trò chuyện gần đây bên dưới ô soạn thảo. Bảng lệnh tìm được mọi cuộc trò chuyện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在输入框下方显示最近的对话。命令面板可以找到任何对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在輸入框下方顯示最近的對話。命令面板可以找到任何對話。"
          }
        }
      }
    },
