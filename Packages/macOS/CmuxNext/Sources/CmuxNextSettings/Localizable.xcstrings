    "settings.window.rail.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the sidebar's pinned sections as a column of icons beside it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعرض الأقسام المثبتة في الشريط الجانبي كعمود من الأيقونات بجانبه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prikazuje prikvačene odjeljke bočne trake kao stupac ikona pored nje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viser sidepanelets fastgjorte sektioner som en kolonne af ikoner ved siden af det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeigt die angehefteten Bereiche der Seitenleiste als Symbolspalte daneben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Muestra las secciones fijadas de la barra lateral como una columna de iconos junto a ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Affiche les sections épinglées de la barre latérale sous forme de colonne d’icônes à côté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mostra le sezioni fissate della barra laterale come una colonna di icone accanto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サイドバーの固定セクションを、その横のアイコン列として表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បង្ហាញផ្នែកដែលបានខ្ទាស់របស់របារចំហៀង ជាជួរឈររូបតំណាងនៅក្បែរវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사이드바의 고정된 섹션을 옆에 아이콘 열로 표시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viser sidefeltets festede seksjoner som en kolonne med ikoner ved siden av."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokazuje przypięte sekcje paska bocznego jako kolumnę ikon obok niego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mostra as seções fixadas da barra lateral como uma coluna de ícones ao lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Показывает закреплённые разделы боковой панели столбцом значков рядом с ней."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แสดงส่วนที่ปักหมุดของแถบด้านข้างเป็นคอลัมน์ไอคอนข้างแถบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kenar çubuğunun sabitlenmiş bölümlerini yanında bir simge sütunu olarak gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Показує закріплені розділи бічної панелі стовпцем значків поруч із нею."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hiển thị các phần đã ghim của thanh bên dưới dạng một cột biểu tượng bên cạnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将边栏中固定的分区显示为旁边的一列图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "將側邊欄中釘選的區段顯示為旁邊的一欄圖示。"
          }
        }
      }
    },
