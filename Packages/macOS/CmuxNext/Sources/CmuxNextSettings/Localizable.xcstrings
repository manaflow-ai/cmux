    "settings.machines.hosts.help": {
      "comment": "Settings row help for Hosts; ssh and `cmux hosts check` stay untranslated",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أجهزة الكمبيوتر التي تصل إليها عبر ssh، لكلٍّ منها تسمية وعناوين تُجرَّب بالترتيب. يوضح cmux hosts check أيها يستجيب."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Računari do kojih stižete preko ssh, svaki s oznakom i adresama koje se isprobavaju redom. cmux hosts check kaže koji odgovaraju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Computere, du når over ssh, hver med en etiket og adresser, der prøves i rækkefølge. cmux hosts check viser, hvilke der svarer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Computer, die du über ssh erreichst, jeweils mit einem Namen und Adressen, die der Reihe nach versucht werden. cmux hosts check zeigt, welche antworten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computers you reach over ssh, each a label and the addresses tried in order. cmux hosts check says which ones answer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Equipos a los que accedes por ssh, cada uno con una etiqueta y las direcciones que se prueban en orden. cmux hosts check indica cuáles responden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les ordinateurs que vous joignez par ssh, chacun avec un libellé et des adresses essayées dans l’ordre. cmux hosts check indique lesquels répondent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I computer che raggiungi via ssh, ciascuno con un’etichetta e gli indirizzi provati in ordine. cmux hosts check indica quali rispondono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ssh で接続するコンピュータ。それぞれラベルと、順に試すアドレスを持ちます。cmux hosts check で応答するものがわかります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កុំព្យូទ័រដែលអ្នកភ្ជាប់តាម ssh នីមួយៗមានស្លាក និងអាសយដ្ឋានដែលសាកល្បងតាមលំដាប់។ cmux hosts check ប្រាប់ថាមួយណាឆ្លើយតប។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ssh로 접속하는 컴퓨터로, 각각 레이블과 순서대로 시도하는 주소가 있습니다. cmux hosts check로 응답하는 컴퓨터를 확인할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Datamaskiner du når over ssh, hver med en etikett og adresser som prøves i rekkefølge. cmux hosts check viser hvilke som svarer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Komputery, z którymi łączysz się przez ssh, każdy z etykietą i adresami próbowanymi po kolei. cmux hosts check pokazuje, które odpowiadają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Computadores que você acessa por ssh, cada um com um rótulo e os endereços tentados em ordem. cmux hosts check mostra quais respondem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Компьютеры, к которым вы подключаетесь по ssh: у каждого метка и адреса, которые пробуются по порядку. cmux hosts check показывает, какие отвечают."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คอมพิวเตอร์ที่คุณเข้าถึงผ่าน ssh แต่ละเครื่องมีป้ายชื่อและที่อยู่ที่ลองตามลำดับ cmux hosts check บอกว่าเครื่องใดตอบสนอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ssh ile eriştiğiniz bilgisayarlar; her birinin bir etiketi ve sırayla denenen adresleri vardır. cmux hosts check hangilerinin yanıt verdiğini söyler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Комп’ютери, до яких ви підключаєтеся через ssh: кожен має мітку й адреси, які пробуються по черзі. cmux hosts check показує, які відповідають."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các máy tính bạn truy cập qua ssh, mỗi máy có một nhãn và các địa chỉ được thử theo thứ tự. cmux hosts check cho biết máy nào phản hồi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你通过 ssh 访问的计算机，每台都有一个标签和按顺序尝试的地址。cmux hosts check 会显示哪些有响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你透過 ssh 連線的電腦，每台都有一個標籤和依序嘗試的位址。cmux hosts check 會顯示哪些有回應。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
