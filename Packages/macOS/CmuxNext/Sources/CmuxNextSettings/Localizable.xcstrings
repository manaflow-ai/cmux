    "settings.picker.pinned.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The picker lists these folders under Locations, after Home and Downloads. Use full paths or ~/ paths."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعرض المنتقي هذه المجلدات ضمن المواقع، بعد المجلد الرئيسي والتنزيلات. استخدم مسارات كاملة أو مسارات ~/."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Birač prikazuje ove mape pod Lokacijama, nakon Početne mape i Preuzimanja. Koristite pune putanje ili ~/ putanje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vælgeren viser disse mapper under Placeringer efter Hjem og Overførsler. Brug fulde stier eller ~/-stier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Auswahl zeigt diese Ordner unter Orte, nach Benutzerordner und Downloads. Verwende vollständige Pfade oder ~/-Pfade."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El selector muestra estas carpetas en Ubicaciones, después de Inicio y Descargas. Usa rutas completas o rutas ~/."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le sélecteur affiche ces dossiers sous Emplacements, après Départ et Téléchargements. Utilisez des chemins complets ou des chemins ~/."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il selettore mostra queste cartelle in Posizioni, dopo Inizio e Download. Usa percorsi completi o percorsi ~/."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピッカーは、これらのフォルダを「場所」の「ホーム」と「ダウンロード」の後に表示します。フルパスか ~/ パスを使用してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កម្មវិធីជ្រើសបង្ហាញថតទាំងនេះនៅក្រោមទីតាំង បន្ទាប់ពីថតផ្ទះ និងទាញយក។ ប្រើផ្លូវពេញ ឬផ្លូវ ~/។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "선택기는 이 폴더를 위치에서 홈과 다운로드 다음에 표시합니다. 전체 경로나 ~/ 경로를 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Velgeren viser disse mappene under Steder, etter Hjem og Nedlastinger. Bruk fullstendige baner eller ~/-baner."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybór pokazuje te foldery w Lokalizacjach, po Katalogu domowym i Pobranych. Użyj pełnych ścieżek lub ścieżek ~/."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O seletor mostra estas pastas em Locais, depois de Início e Downloads. Use caminhos completos ou caminhos ~/."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выбор показывает эти папки в разделе «Места» после «Домой» и «Загрузки». Используйте полные пути или пути ~/."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ตัวเลือกจะแสดงโฟลเดอร์เหล่านี้ในตำแหน่ง ต่อจากโฮมและดาวน์โหลด ใช้พาธเต็มหรือพาธ ~/"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seçici bu klasörleri Konumlar altında, Ana Klasör ve İndirilenler’den sonra listeler. Tam yollar veya ~/ yolları kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вибір показує ці папки в розділі «Розташування» після «Домівка» і «Завантаження». Використовуйте повні шляхи або шляхи ~/."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bộ chọn liệt kê các thư mục này trong Vị trí, sau Thư mục nhà và Tải về. Dùng đường dẫn đầy đủ hoặc đường dẫn ~/."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "选择器在“位置”中“个人”和“下载”之后列出这些文件夹。请使用完整路径或 ~/ 路径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選擇器在「位置」中「個人」和「下載項目」之後列出這些檔案夾。請使用完整路徑或 ~/ 路徑。"
          }
        }
      }
    },
