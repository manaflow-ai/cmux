    "settings.workspaceRow.linesByAgent.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "needs_review", "value": "تخطيط صف لكل وكيل، حسب معرّف الوكيل مثل claude أو codex. يتقدّم على تخطيطات الصف الأخرى." } },
        "bs": { "stringUnit": { "state": "needs_review", "value": "Raspored reda za svakog agenta, po ID-u agenta kao što su claude ili codex. Ima prednost nad ostalim rasporedima reda." } },
        "da": { "stringUnit": { "state": "needs_review", "value": "Et rækkelayout for hver agent, efter agent-id som claude eller codex. Det går forud for de andre rækkelayouts." } },
        "de": { "stringUnit": { "state": "needs_review", "value": "Ein Zeilenlayout für jeden Agent, nach Agent-ID wie claude oder codex. Es hat Vorrang vor den anderen Zeilenlayouts." } },
        "en": { "stringUnit": { "state": "translated", "value": "A row layout for each agent, by agent id such as claude or codex. It wins over the other row layouts." } },
        "es": { "stringUnit": { "state": "needs_review", "value": "Un diseño de fila para cada agente, por id de agente como claude o codex. Tiene prioridad sobre los demás diseños de fila." } },
        "fr": { "stringUnit": { "state": "needs_review", "value": "Une disposition de ligne pour chaque agent, par identifiant d'agent comme claude ou codex. Elle l'emporte sur les autres dispositions." } },
        "it": { "stringUnit": { "state": "needs_review", "value": "Un layout della riga per ogni agente, per id agente come claude o codex. Ha la precedenza sugli altri layout della riga." } },
        "ja": { "stringUnit": { "state": "translated", "value": "エージェント ID (claude、codex など) ごとの行レイアウト。他の行レイアウトより優先されます。" } },
        "km": { "stringUnit": { "state": "needs_review", "value": "ប្លង់ជួរសម្រាប់ភ្នាក់ងារនីមួយៗ តាមលេខសម្គាល់ភ្នាក់ងារ ដូចជា claude ឬ codex។ វាមានអាទិភាពលើប្លង់ជួរផ្សេងទៀត។" } },
        "ko": { "stringUnit": { "state": "needs_review", "value": "에이전트 ID(claude, codex 등)별 행 레이아웃입니다. 다른 행 레이아웃보다 우선합니다." } },
        "nb": { "stringUnit": { "state": "needs_review", "value": "Et radoppsett for hver agent, etter agent-ID som claude eller codex. Det går foran de andre radoppsettene." } },
        "pl": { "stringUnit": { "state": "needs_review", "value": "Układ wiersza dla każdego agenta, według identyfikatora agenta, np. claude lub codex. Ma pierwszeństwo przed innymi układami wiersza." } },
        "pt-BR": { "stringUnit": { "state": "needs_review", "value": "Um layout de linha para cada agente, pelo id do agente, como claude ou codex. Tem prioridade sobre os outros layouts de linha." } },
        "ru": { "stringUnit": { "state": "needs_review", "value": "Макет строки для каждого агента, по идентификатору агента, например claude или codex. Имеет приоритет над другими макетами строки." } },
        "th": { "stringUnit": { "state": "needs_review", "value": "เลย์เอาต์แถวสำหรับเอเจนต์แต่ละตัว ตามรหัสเอเจนต์ เช่น claude หรือ codex มีผลเหนือเลย์เอาต์แถวอื่น" } },
        "tr": { "stringUnit": { "state": "needs_review", "value": "Her ajan için bir satır düzeni, claude veya codex gibi ajan kimliğine göre. Diğer satır düzenlerinin önüne geçer." } },
        "uk": { "stringUnit": { "state": "needs_review", "value": "Макет рядка для кожного агента, за ідентифікатором агента, наприклад claude або codex. Має пріоритет над іншими макетами рядка." } },
        "vi": { "stringUnit": { "state": "needs_review", "value": "Bố cục hàng cho từng tác tử, theo id tác tử như claude hoặc codex. Được ưu tiên hơn các bố cục hàng khác." } },
        "zh-Hans": { "stringUnit": { "state": "needs_review", "value": "按代理 ID（如 claude 或 codex）设置的行布局。优先于其他行布局。" } },
        "zh-Hant": { "stringUnit": { "state": "needs_review", "value": "依代理 ID（如 claude 或 codex）設定的列版面配置。優先於其他列版面配置。" } }
      }
    },
    "settings.workspaceRow.linesByKind": {
      "extractionState": "manual",
