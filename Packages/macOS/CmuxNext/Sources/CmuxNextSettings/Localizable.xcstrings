    "settings.tabs.tabMinInactiveWidth.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Narrowest the other tabs get before the strip scrolls. Never wider than the selected tab's minimum."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーがスクロールする前に、ほかのタブが縮む最小の幅です。選択中タブの最小幅より広くはなりません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أضيق عرض تصل إليه علامات التبويب الأخرى قبل أن يتمرر الشريط. لا يزيد أبدًا عن الحد الأدنى لعلامة التبويب المحددة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Najmanja širina ostalih kartica prije nego što se traka počne pomicati. Nikad šira od minimuma odabrane kartice."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den mindste bredde de andre faner får, før bjælken ruller. Aldrig bredere end den valgte fanes minimum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "So schmal werden die anderen Tabs, bevor die Leiste scrollt. Nie breiter als das Minimum des ausgewählten Tabs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El ancho mínimo de las demás pestañas antes de que la barra se desplace. Nunca mayor que el mínimo de la pestaña seleccionada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Largeur minimale des autres onglets avant que la barre ne défile. Jamais plus large que le minimum de l’onglet sélectionné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La larghezza minima delle altre schede prima che la barra scorra. Mai più larga del minimo della scheda selezionata."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ទទឹងតូចបំផុតរបស់ផ្ទាំងផ្សេងទៀត មុនពេលរបាររមូរ។ មិនដែលធំជាងអប្បបរមានៃផ្ទាំងដែលបានជ្រើសទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "탭 바가 스크롤되기 전에 다른 탭이 줄어드는 최소 너비입니다. 선택한 탭의 최소 너비보다 넓어지지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den minste bredden de andre fanene får før linjen ruller. Aldri bredere enn minstebredden til den valgte fanen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Najmniejsza szerokość pozostałych kart, zanim pasek zacznie się przewijać. Nigdy większa niż minimum wybranej karty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A largura mínima das outras abas antes de a barra rolar. Nunca maior que o mínimo da aba selecionada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Наименьшая ширина остальных вкладок, прежде чем панель начнёт прокручиваться. Не больше минимума выбранной вкладки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ความกว้างต่ำสุดของแท็บอื่นก่อนที่แถบจะเลื่อน ไม่เกินความกว้างต่ำสุดของแท็บที่เลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Şerit kaymaya başlamadan önce diğer sekmelerin alabileceği en küçük genişlik. Seçili sekmenin en küçük genişliğinden fazla olmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Найменша ширина інших вкладок, перш ніж панель почне прокручуватися. Не більша за мінімум вибраної вкладки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Độ rộng nhỏ nhất của các tab khác trước khi thanh cuộn. Không bao giờ lớn hơn mức tối thiểu của tab đang chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "标签栏开始滚动前其他标签页的最小宽度。不会超过所选标签页的最小宽度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "分頁列開始捲動前其他分頁的最小寬度。不會超過所選分頁的最小寬度。"
          }
        }
      }
    },
