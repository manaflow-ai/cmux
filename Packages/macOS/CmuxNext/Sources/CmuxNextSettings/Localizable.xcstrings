    "settings.notifications.timeoutSeconds.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used when a source clears after a timeout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "通知元がタイムアウトで消去する設定のときに使います。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يُستخدم عندما يُمسح المصدر بعد انتهاء المهلة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koristi se kad se izvor briše nakon isteka vremena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bruges, når en kilde ryddes efter timeout."
          }
        },
        "de": {
