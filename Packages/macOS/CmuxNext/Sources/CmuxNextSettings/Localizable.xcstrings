    "settings.browser.passwords.generate.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offers a generated password when a site asks for a new one, and saves it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
