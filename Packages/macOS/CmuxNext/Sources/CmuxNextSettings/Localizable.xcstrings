    "settings.sidebar.showTimestamps.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rows show when they last changed, such as 3d."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعرض الصفوف وقت آخر تغيير، مثل 3d."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Redovi prikazuju kada su se zadnji put promijenili, npr. 3d."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rækker viser, hvornår de sidst ændrede sig, fx 3d."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeilen zeigen, wann sie sich zuletzt geändert haben, etwa 3d."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las filas muestran cuándo cambiaron por última vez, como 3d."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les lignes indiquent leur dernière modification, comme 3d."
