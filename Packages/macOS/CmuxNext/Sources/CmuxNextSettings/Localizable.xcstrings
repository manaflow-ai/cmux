    "settings.ui.reducedBackgrounds.help": {
      "comment": "Settings row help for Plain Backgrounds.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plain theme color, without paintings, wallpapers or glass."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لون السمة البسيط، بلا لوحات أو خلفيات أو زجاج."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obična boja teme, bez slika, pozadina ili stakla."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Temaets ensfarvede baggrund uden malerier, skrivebordsbaggrunde eller glas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die schlichte Themenfarbe, ohne Gemälde, Hintergrundbilder oder Glas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El color liso del tema, sin pinturas, fondos de pantalla ni cristal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La couleur unie du thème, sans peintures, fonds d'écran ni verre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il colore semplice del tema, senza dipinti, sfondi o vetro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "絵画・壁紙・ガラスを使わず、テーマの単色で表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ពណ៌ធម្មតារបស់រូបរាង ដោយគ្មានគំនូរ រូបផ្ទៃតុ ឬកញ្ចក់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "그림, 배경 화면, 유리 효과 없이 테마의 단색을 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Temaets ensfargede bakgrunn, uten malerier, skrivebordsbakgrunner eller glass."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jednolity kolor motywu, bez obrazów, tapet i szkła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A cor lisa do tema, sem pinturas, papéis de parede ou vidro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Однотонный цвет темы, без картин, обоев и стекла."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สีพื้นของธีม โดยไม่มีภาพวาด ภาพพื้นหลัง หรือกระจก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tablolar, duvar kâğıtları veya cam olmadan temanın düz rengi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Однотонний колір теми, без картин, шпалер і скла."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Màu trơn của chủ đề, không có tranh, hình nền hay hiệu ứng kính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用主题的纯色，不显示画作、墙纸或玻璃效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用主題的純色，不顯示畫作、桌布或玻璃效果。"
          }
        }
      }
    },
