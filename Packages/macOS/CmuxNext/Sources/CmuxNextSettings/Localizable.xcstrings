    "settings.notifications.sounds.cooldown.help": {
      "comment": "Settings > Notifications > Sounds > Burst Cooldown: help text",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تصدر الإشعارات الكثيرة في وقت واحد صوتًا واحدًا. القيمة 0 توقف ذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mnogo obavještenja odjednom oglasi se jednom. 0 isključuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mange notifikationer på én gang lyder én gang. 0 slår det fra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viele Mitteilungen auf einmal ertönen einmal. 0 schaltet es aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Many notifications at once sound once. 0 turns it off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Muchas notificaciones a la vez suenan una sola vez. 0 lo desactiva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plusieurs notifications simultanées sonnent une seule fois. 0 désactive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Molte notifiche insieme suonano una volta. 0 lo disattiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "同時に届いた多数の通知は1回だけ鳴ります。0 でオフになります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការជូនដំណឹងច្រើនក្នុងពេលតែមួយបន្លឺសំឡេងតែម្ដង។ 0 បិទវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "동시에 온 여러 알림은 한 번만 울립니다. 0이면 끕니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mange varsler samtidig lyder én gang. 0 slår det av."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wiele powiadomień naraz odtwarza dźwięk raz. 0 wyłącza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Muitas notificações ao mesmo tempo tocam uma vez. 0 desativa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Много уведомлений сразу звучат один раз. 0 отключает."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การแจ้งเตือนหลายรายการพร้อมกันจะดังครั้งเดียว 0 คือปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aynı anda gelen çok sayıda bildirim bir kez ses çıkarır. 0 kapatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Багато сповіщень одночасно звучать один раз. 0 вимикає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhiều thông báo cùng lúc chỉ phát âm thanh một lần. 0 để tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "同时到达的多条通知只响一次。0 表示关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "同時到達的多則通知只響一次。0 表示關閉。"
          }
        }
      }
    },
