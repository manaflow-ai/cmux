    "settings.browser.omnibar.glassTint.help": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The color over the glass, from the terminal theme. Accent is the theme's own accent color, or gray when the theme has none."
        }
      },
      "ar": {
        "stringUnit": {
          "state": "needs_review",
          "value": "اللون فوق الزجاج، من سمة الطرفية. التمييز هو لون التمييز الخاص بالسمة، أو رمادي إذا لم يكن لها لون."
        }
      },
      "bs": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Boja preko stakla, iz teme terminala. Akcent je vlastita akcentna boja teme, ili siva kada je tema nema."
        }
      },
      "da": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Farven over glasset, fra terminaltemaet. Accent er temaets egen accentfarve, eller grå når temaet ikke har nogen."
        }
      },
      "de": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Die Farbe über dem Glas, aus dem Terminal-Thema. Akzent ist die eigene Akzentfarbe des Themas, oder Grau, wenn es keine hat."
        }
      },
      "es": {
        "stringUnit": {
          "state": "needs_review",
          "value": "El color sobre el cristal, del tema del terminal. Acento es el color de acento propio del tema, o gris si no tiene."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "needs_review",
          "value": "La couleur au-dessus du verre, issue du thème du terminal. Accent est la couleur d’accent du thème, ou gris s’il n’en a pas."
        }
      },
      "it": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Il colore sopra il vetro, dal tema del terminale. Accento è il colore di accento del tema, o grigio se non ne ha."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "ガラスに重ねる色で、ターミナルのテーマから取ります。アクセントはテーマ自身のアクセントカラーで、ない場合はグレーです。"
        }
      },
      "km": {
        "stringUnit": {
          "state": "needs_review",
          "value": "ពណ៌លើកញ្ចក់ ពីធីមទែមីណាល់។ សង្កត់ធ្ងន់គឺពណ៌សង្កត់ធ្ងន់ផ្ទាល់របស់ធីម ឬពណ៌ប្រផេះ ពេលធីមគ្មាន។"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "needs_review",
          "value": "글래스 위의 색상으로, 터미널 테마에서 가져옵니다. 강조는 테마 자체의 강조 색상이며, 없으면 회색입니다."
        }
      },
      "nb": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Fargen over glasset, fra terminaltemaet. Aksent er temaets egen aksentfarge, eller grå når temaet ikke har noen."
        }
      },
      "pl": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Kolor nad szkłem, z motywu terminala. Akcent to własny kolor akcentu motywu lub szary, gdy motyw go nie ma."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "needs_review",
          "value": "A cor sobre o vidro, do tema do terminal. Destaque é a cor de destaque do próprio tema, ou cinza quando o tema não tem."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Цвет поверх стекла из темы терминала. Акцент — собственный акцентный цвет темы или серый, если его нет."
        }
      },
      "th": {
        "stringUnit": {
          "state": "needs_review",
          "value": "สีที่อยู่บนกระจก จากธีมของเทอร์มินัล สีเน้นคือสีเน้นของธีมเอง หรือสีเทาเมื่อธีมไม่มี"
        }
      },
      "tr": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Camın üzerindeki renk, terminal temasından. Vurgu, temanın kendi vurgu rengidir; yoksa gridir."
        }
      },
      "uk": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Колір поверх скла з теми термінала. Акцент — власний акцентний колір теми або сірий, якщо його немає."
        }
      },
      "vi": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Màu phủ lên kính, lấy từ chủ đề terminal. Nhấn mạnh là màu nhấn của chính chủ đề, hoặc xám nếu chủ đề không có."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "needs_review",
          "value": "玻璃上方的颜色，取自终端主题。强调色是主题自身的强调色，没有时为灰色。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "needs_review",
          "value": "玻璃上方的顏色，取自終端機主題。強調色是主題自身的強調色，沒有時為灰色。"
        }
      }
    }
  },
