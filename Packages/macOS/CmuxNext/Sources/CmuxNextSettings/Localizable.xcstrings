    "settings.macScreen.debug.relayOnly.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Screen tabs connect through the TURN relay only, never directly, to check the relay path. Tabs that are connected reconnect."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تتصل علامات تبويب شاشة Mac عبر خادم ترحيل TURN فقط، وليس مباشرةً أبدًا، للتحقق من مسار الترحيل. تُعيد علامات التبويب المتصلة الاتصال."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kartice Ekrana Maca povezuju se samo preko TURN releja, nikada direktno, radi provjere puta preko releja. Povezane kartice se ponovo povezuju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac-skærm-faner forbinder kun via TURN-relæet, aldrig direkte, så relæstien kan kontrolleres. Forbundne faner genopretter forbindelsen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac-Bildschirm-Tabs verbinden sich nur über das TURN-Relay, nie direkt, um den Relay-Pfad zu prüfen. Verbundene Tabs verbinden sich neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las pestañas de Pantalla del Mac se conectan solo a través del relé TURN, nunca directamente, para comprobar la ruta del relé. Las pestañas conectadas se vuelven a conectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les onglets Écran Mac se connectent uniquement via le relais TURN, jamais directement, pour vérifier le chemin du relais. Les onglets connectés se reconnectent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I pannelli Schermo Mac si connettono solo tramite il relay TURN, mai direttamente, per verificare il percorso del relay. I pannelli connessi si riconnettono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "リレー経路を確認するため、Macの画面タブはTURNリレー経由でのみ接続し、直接は接続しません。接続中のタブは再接続します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទាំងអេក្រង់ Mac ភ្ជាប់តាមរយៈការបញ្ជូនបន្ត TURN ប៉ុណ្ណោះ មិនដែលភ្ជាប់ដោយផ្ទាល់ទេ ដើម្បីពិនិត្យផ្លូវបញ្ជូនបន្ត។ ផ្ទាំងដែលបានភ្ជាប់នឹងភ្ជាប់ឡើងវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "릴레이 경로를 확인하기 위해 Mac 화면 탭이 직접 연결하지 않고 TURN 릴레이를 통해서만 연결됩니다. 연결된 탭은 다시 연결됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac-skjerm-faner kobler til bare via TURN-reléet, aldri direkte, for å sjekke reléstien. Tilkoblede faner kobler til på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Karty ekranu Maca łączą się tylko przez przekaźnik TURN, nigdy bezpośrednio, aby sprawdzić ścieżkę przekaźnika. Połączone karty łączą się ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As abas de Tela do Mac se conectam somente pelo relay TURN, nunca diretamente, para verificar o caminho do relay. As abas conectadas se reconectam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вкладки «Экран Mac» подключаются только через ретранслятор TURN, а не напрямую, чтобы проверить путь через ретранслятор. Подключенные вкладки переподключаются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แถบหน้าจอ Mac จะเชื่อมต่อผ่านรีเลย์ TURN เท่านั้น ไม่เชื่อมต่อโดยตรง เพื่อตรวจสอบเส้นทางรีเลย์ แถบที่เชื่อมต่ออยู่จะเชื่อมต่อใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac Ekranı sekmeleri röle yolunu denetlemek için doğrudan değil, yalnızca TURN rölesi üzerinden bağlanır. Bağlı sekmeler yeniden bağlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вкладки «Екран Mac» підключаються лише через ретранслятор TURN, ніколи напряму, щоб перевірити шлях через ретранслятор. Підключені вкладки перепідключаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các tab Màn hình Mac chỉ kết nối qua máy chủ chuyển tiếp TURN, không bao giờ kết nối trực tiếp, để kiểm tra đường chuyển tiếp. Các tab đang kết nối sẽ kết nối lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac 屏幕标签页仅通过 TURN 中继连接，从不直接连接，以检查中继路径。已连接的标签页会重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac 螢幕標籤頁僅透過 TURN 中繼連線，絕不直接連線，以檢查中繼路徑。已連線的標籤頁會重新連線。"
          }
        }
      }
    },
