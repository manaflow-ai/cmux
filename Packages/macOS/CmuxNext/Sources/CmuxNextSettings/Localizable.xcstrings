    "settings.appearance.backgroundBlur.summary": {
      "comment": "One-line summary of the window Material setting (Frosted, Glass, Clear Glass, None) in the wallpaper card.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear Glass shows the desktop through the wallpaper"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُظهر الزجاج الشفاف سطح المكتب عبر الخلفية"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
