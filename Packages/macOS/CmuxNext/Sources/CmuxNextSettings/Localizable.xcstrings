    "settings.sidebar.cards.tips.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A \"Did you know\" card above the account button shows one cmux feature a day that you have not used yet. Each tip shows only once."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントボタンの上の「ご存知でしたか」カードに、まだ使っていない cmux の機能を 1 日に 1 つ表示します。各ヒントは一度だけ表示されます。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تعرض بطاقة \"هل تعلم\" فوق زر الحساب ميزة واحدة من cmux يوميًا لم تستخدمها بعد. تظهر كل نصيحة مرة واحدة فقط."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kartica \"Jeste li znali\" iznad dugmeta računa prikazuje jednu cmux funkciju dnevno koju još niste koristili. Svaki savjet se prikazuje samo jednom."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Et \"Vidste du\"-kort over kontoknappen viser én cmux-funktion om dagen, som du ikke har brugt endnu. Hvert tip vises kun én gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine „Schon gewusst?“-Karte über der Kontotaste zeigt täglich eine cmux-Funktion, die du noch nicht genutzt hast. Jeder Tipp erscheint nur einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una tarjeta «¿Sabías que?» sobre el botón de cuenta muestra cada día una función de cmux que aún no has usado. Cada consejo aparece solo una vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une carte « Le saviez-vous ? » au-dessus du bouton du compte présente chaque jour une fonctionnalité de cmux que vous n’avez pas encore utilisée. Chaque astuce n’apparaît qu’une fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una scheda «Lo sapevi?» sopra il pulsante dell’account mostra ogni giorno una funzione di cmux che non hai ancora usato. Ogni suggerimento appare una sola volta."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "កាត \"តើអ្នកដឹងទេ\" នៅលើប៊ូតុងគណនី បង្ហាញមុខងារ cmux មួយក្នុងមួយថ្ងៃ ដែលអ្នកមិនទាន់បានប្រើ។ គន្លឹះនីមួយៗបង្ហាញតែម្តងប៉ុណ្ណោះ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "계정 버튼 위의 \"알고 계셨나요\" 카드가 아직 사용하지 않은 cmux 기능을 하루에 하나씩 보여 줍니다. 각 팁은 한 번만 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Et «Visste du»-kort over kontoknappen viser én cmux-funksjon om dagen som du ikke har brukt ennå. Hvert tips vises bare én gang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Karta „Czy wiesz, że” nad przyciskiem konta pokazuje codziennie jedną funkcję cmux, której jeszcze nie używasz. Każda wskazówka pojawia się tylko raz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um cartão \"Você sabia?\" acima do botão da conta mostra, por dia, um recurso do cmux que você ainda não usou. Cada dica aparece só uma vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Карточка «А вы знали?» над кнопкой учётной записи раз в день показывает функцию cmux, которой вы ещё не пользовались. Каждый совет показывается только один раз."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "การ์ด \"รู้หรือไม่\" เหนือปุ่มบัญชีจะแสดงฟีเจอร์ของ cmux ที่คุณยังไม่เคยใช้วันละหนึ่งอย่าง เคล็ดลับแต่ละรายการจะแสดงเพียงครั้งเดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hesap düğmesinin üstündeki \"Biliyor muydunuz?\" kartı, henüz kullanmadığınız bir cmux özelliğini günde bir kez gösterir. Her ipucu yalnızca bir kez gösterilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Картка «А ви знали?» над кнопкою облікового запису раз на день показує функцію cmux, якою ви ще не користувалися. Кожна порада з’являється лише один раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Thẻ \"Bạn có biết\" phía trên nút tài khoản mỗi ngày giới thiệu một tính năng cmux bạn chưa dùng. Mỗi mẹo chỉ hiện một lần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "账户按钮上方的“你知道吗”卡片每天介绍一项你还没用过的 cmux 功能。每条提示只显示一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "帳號按鈕上方的「你知道嗎」卡片每天介紹一項你還沒用過的 cmux 功能。每則提示只顯示一次。"
          }
        }
      }
    },
    "settings.app.startAgentGlobalHotKey.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Agent (⌃⌥⌘Space) works while another app is in front. Change its key in Keyboard Shortcuts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「エージェントを開始」（⌃⌥⌘Space）を、ほかのアプリが前面にあるときにも使えます。キーは「キーボードショートカット」で変更できます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعمل «بدء وكيل» (⌃⌥⌘Space) أثناء وجود تطبيق آخر في المقدمة. غيّر مفتاحه في اختصارات لوحة المفاتيح."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokreni agenta (⌃⌥⌘Space) radi dok je druga aplikacija u prvom planu. Prečicu promijenite u Prečicama tastature."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Start agent (⌃⌥⌘Space) virker, mens en anden app er forrest. Skift tasten under Tastaturgenveje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Agent starten“ (⌃⌥⌘Space) funktioniert, während eine andere App im Vordergrund ist. Die Taste änderst du unter Tastaturkurzbefehle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Iniciar agente (⌃⌥⌘Space) funciona mientras otra app está en primer plano. Cambia su atajo en Atajos de teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Démarrer un agent (⌃⌥⌘Space) fonctionne lorsqu’une autre app est au premier plan. Modifiez son raccourci dans Raccourcis clavier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avvia agente (⌃⌥⌘Space) funziona mentre un’altra app è in primo piano. Cambia il tasto in Scorciatoie da tastiera."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ចាប់ផ្តើមភ្នាក់ងារ (⌃⌥⌘Space) ដំណើរការ ពេលកម្មវិធីផ្សេងនៅខាងមុខ។ ប្តូរគ្រាប់ចុចរបស់វានៅក្នុងផ្លូវកាត់ក្តារចុច។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다른 앱이 앞에 있어도 에이전트 시작(⌃⌥⌘Space)이 작동합니다. 키는 키보드 단축키에서 바꿀 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Start agent (⌃⌥⌘Space) virker mens en annen app er foran. Endre tasten under Tastatursnarveier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uruchom agenta (⌃⌥⌘Space) działa, gdy na pierwszym planie jest inna aplikacja. Klawisz zmienisz w Skrótach klawiszowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Iniciar agente (⌃⌥⌘Space) funciona enquanto outro app está em primeiro plano. Altere a tecla em Atalhos de teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Запустить агента» (⌃⌥⌘Space) работает, когда впереди другое приложение. Клавишу можно изменить в разделе «Сочетания клавиш»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เริ่มเอเจนต์ (⌃⌥⌘Space) ใช้งานได้ขณะที่แอปอื่นอยู่ด้านหน้า เปลี่ยนปุ่มได้ในปุ่มลัดแป้นพิมพ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajan Başlat (⌃⌥⌘Space), başka bir uygulama öndeyken de çalışır. Tuşunu Klavye Kısayolları'ndan değiştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Запустити агента» (⌃⌥⌘Space) працює, коли попереду інша програма. Клавішу можна змінити в розділі «Сполучення клавіш»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bắt đầu tác tử (⌃⌥⌘Space) hoạt động khi một ứng dụng khác ở phía trước. Đổi phím trong Phím tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "其他应用在前台时也可使用“启动智能体”（⌃⌥⌘Space）。可在“键盘快捷键”中更改按键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "其他 App 在前景時也可使用「啟動代理」（⌃⌥⌘Space）。可在「鍵盤快速鍵」中更改按鍵。"
          }
        }
      }
    },
