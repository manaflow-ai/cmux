    "settings.notifications.timeoutSeconds.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used when a source clears after a timeout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "通知元がタイムアウトで消去する設定のときに使います。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يُستخدم عندما يُمسح المصدر بعد انتهاء المهلة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koristi se kad se izvor briše nakon isteka vremena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bruges, når en kilde ryddes efter timeout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gilt, wenn eine Quelle nach Zeitlimit entfernt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se usa cuando una fuente se borra tras el tiempo de espera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilisé quand une source s’efface après un délai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usato quando una fonte si cancella dopo il timeout."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ប្រើនៅពេលប្រភពសម្អាតបន្ទាប់ពីអស់ពេល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "소스가 시간 초과 후 지워질 때 사용됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brukes når en kilde fjernes etter tidsavbrudd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Używane, gdy źródło czyści się po upływie czasu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usado quando uma fonte limpa após o tempo limite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Используется, когда источник очищается по тайм-ауту."
          }
        },
