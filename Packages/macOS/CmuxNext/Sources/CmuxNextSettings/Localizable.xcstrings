      }
    },
    "settings.workspaceRow.linesByKind.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "needs_review", "value": "تخطيط صف لكل نوع من مساحات العمل: طرفية أو وكيل أو متصفح أو مختلط. يتقدّم على تخطيط الصف." } },
        "bs": { "stringUnit": { "state": "needs_review", "value": "Raspored reda za svaku vrstu radnog prostora: terminal, agent, preglednik ili mješoviti. Ima prednost nad rasporedom reda." } },
        "da": { "stringUnit": { "state": "needs_review", "value": "Et rækkelayout for hver type arbejdsområde: terminal, agent, browser eller blandet. Det går forud for rækkelayoutet." } },
        "de": { "stringUnit": { "state": "needs_review", "value": "Ein Zeilenlayout für jede Art von Arbeitsbereich: Terminal, Agent, Browser oder gemischt. Es hat Vorrang vor dem Zeilenlayout." } },
        "en": { "stringUnit": { "state": "translated", "value": "A row layout for each kind of workspace: terminal, agent, browser or mixed. It wins over Row Layout." } },
        "es": { "stringUnit": { "state": "needs_review", "value": "Un diseño de fila para cada tipo de espacio de trabajo: terminal, agente, navegador o mixto. Tiene prioridad sobre el diseño de fila." } },
        "fr": { "stringUnit": { "state": "needs_review", "value": "Une disposition de ligne pour chaque type d'espace de travail : terminal, agent, navigateur ou mixte. Elle l'emporte sur la disposition de la ligne." } },
        "it": { "stringUnit": { "state": "needs_review", "value": "Un layout della riga per ogni tipo di area di lavoro: terminale, agente, browser o misto. Ha la precedenza sul layout della riga." } },
        "ja": { "stringUnit": { "state": "translated", "value": "ワークスペースの種類 (ターミナル、エージェント、ブラウザ、混在) ごとの行レイアウト。行のレイアウトより優先されます。" } },
        "km": { "stringUnit": { "state": "needs_review", "value": "ប្លង់ជួរសម្រាប់ប្រភេទកន្លែងធ្វើការនីមួយៗ៖ ស្ថានីយ ភ្នាក់ងារ កម្មវិធីរុករក ឬចម្រុះ។ វាមានអាទិភាពលើប្លង់ជួរ។" } },
        "ko": { "stringUnit": { "state": "needs_review", "value": "작업 공간 종류(터미널, 에이전트, 브라우저, 혼합)별 행 레이아웃입니다. 행 레이아웃보다 우선합니다." } },
        "nb": { "stringUnit": { "state": "needs_review", "value": "Et radoppsett for hver type arbeidsområde: terminal, agent, nettleser eller blandet. Det går foran radoppsettet." } },
        "pl": { "stringUnit": { "state": "needs_review", "value": "Układ wiersza dla każdego rodzaju obszaru roboczego: terminal, agent, przeglądarka lub mieszany. Ma pierwszeństwo przed układem wiersza." } },
        "pt-BR": { "stringUnit": { "state": "needs_review", "value": "Um layout de linha para cada tipo de espaço de trabalho: terminal, agente, navegador ou misto. Tem prioridade sobre o layout da linha." } },
        "ru": { "stringUnit": { "state": "needs_review", "value": "Макет строки для каждого типа рабочего пространства: терминал, агент, браузер или смешанный. Имеет приоритет над макетом строки." } },
        "th": { "stringUnit": { "state": "needs_review", "value": "เลย์เอาต์แถวสำหรับเวิร์กสเปซแต่ละชนิด: เทอร์มินัล เอเจนต์ เบราว์เซอร์ หรือแบบผสม มีผลเหนือเลย์เอาต์แถว" } },
        "tr": { "stringUnit": { "state": "needs_review", "value": "Her çalışma alanı türü için bir satır düzeni: terminal, ajan, tarayıcı veya karma. Satır düzeninin önüne geçer." } },
        "uk": { "stringUnit": { "state": "needs_review", "value": "Макет рядка для кожного типу робочого простору: термінал, агент, браузер або змішаний. Має пріоритет над макетом рядка." } },
        "vi": { "stringUnit": { "state": "needs_review", "value": "Bố cục hàng cho từng loại không gian làm việc: terminal, tác tử, trình duyệt hoặc hỗn hợp. Được ưu tiên hơn bố cục hàng." } },
        "zh-Hans": { "stringUnit": { "state": "needs_review", "value": "为每种工作区（终端、代理、浏览器或混合）设置的行布局。优先于行布局。" } },
        "zh-Hant": { "stringUnit": { "state": "needs_review", "value": "為每種工作區（終端機、代理、瀏覽器或混合）設定的列版面配置。優先於列版面配置。" } }
      }
    },
