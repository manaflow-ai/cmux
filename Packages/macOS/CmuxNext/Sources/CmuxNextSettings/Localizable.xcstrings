        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outside text fields: f clicks a link, j and k scroll, gg and Shift-G jump to the ends."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "خارج حقول النص: يضغط f رابطًا، ويمرر j وk الصفحة، وينتقل gg وShift-G إلى الطرفين."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Izvan tekstualnih polja: f klikne link, j i k pomjeraju stranicu, gg i Shift-G idu na krajeve."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uden for tekstfelter: f klikker på et link, j og k ruller, gg og Shift-G springer til enderne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Außerhalb von Textfeldern: f klickt einen Link, j und k scrollen, gg und Shift-G springen an Anfang und Ende."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fuera de los campos de texto: f hace clic en un enlace, j y k desplazan, gg y Shift-G van a los extremos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hors d’un champ de texte : f clique sur un lien, j et k font défiler, gg et Shift-G vont aux extrémités."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fuori dai campi di testo: f fa clic su un link, j e k scorrono, gg e Shift-G vanno all’inizio e alla fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "テキストフィールドの外で、fでリンクをクリックし、jとkでスクロールし、ggとShift-Gで先頭と末尾に移動します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "នៅក្រៅប្រអប់អត្ថបទ៖ f ចុចតំណ j និង k រំកិល gg និង Shift-G ទៅខាងលើ និងខាងក្រោមបំផុត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "텍스트 필드 밖에서 f는 링크를 클릭하고, j와 k는 스크롤하며, gg와 Shift-G는 맨 위와 맨 아래로 이동합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utenfor tekstfelt: f klikker en lenke, j og k ruller, gg og Shift-G hopper til endene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poza polami tekstowymi: f klika link, j i k przewijają, gg i Shift-G przechodzą na początek i koniec."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fora de campos de texto: f clica em um link, j e k rolam, gg e Shift-G vão para as extremidades."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вне текстовых полей: f нажимает ссылку, j и k прокручивают, gg и Shift-G переходят в начало и конец."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "นอกช่องข้อความ: f คลิกลิงก์ j และ k เลื่อนหน้า gg และ Shift-G ไปบนสุดและล่างสุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metin alanları dışında: f bir bağlantıya tıklar, j ve k kaydırır, gg ve Shift-G uçlara gider."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Поза текстовими полями f натискає посилання, j і k прокручують, gg і Shift-G переходять на початок і в кінець."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bên ngoài ô văn bản: f nhấp liên kết, j và k cuộn, gg và Shift-G về đầu và cuối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在文本框之外：f 点击链接，j 和 k 滚动，gg 和 Shift-G 跳到顶部和底部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在文字欄位之外：f 點按連結，j 和 k 捲動，gg 和 Shift-G 跳到頂端和底端。"
          }
        }
      }
    },
