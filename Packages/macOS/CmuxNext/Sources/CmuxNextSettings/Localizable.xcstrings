            "state": "translated",
            "value": "Lar agenter bruke appvinduer mens Mac er låst"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenci mogą używać okien aplikacji przy zablokowanym Macu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que agentes usem janelas de apps com o Mac bloqueado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты могут использовать окна приложений при заблокированном Mac"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้เอเจนต์ใช้หน้าต่างแอปได้ขณะ Mac ล็อกอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac kilitliyken aracıların uygulama pencerelerini kullanmasına izin verir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенти можуть використовувати вікна програм, коли Mac заблоковано"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép tác tử dùng cửa sổ ứng dụng khi máy Mac bị khóa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让代理在 Mac 锁定时使用 App 窗口"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓代理在 Mac 鎖定時使用 App 視窗"
          }
        }
      }
    },
    "settings.default.neverDiscard": {
      "comment": "Settings > Browser > Memory > Hibernate Hidden Tabs: the value with nothing in cmux.json: hidden tabs only freeze and are never discarded (reloaded) on their own.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
