    "settings.window.titlebar.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimal has no titlebar strip; the top row moves the window."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ミニマルではタイトルバーがなく、最上段の行でウインドウを移動します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "النمط البسيط بلا شريط عنوان؛ والصف العلوي يحرّك النافذة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minimalno nema naslovnu traku; gornji red pomjera prozor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minimal har ingen titellinje; den øverste række flytter vinduet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minimal hat keine Titelleiste; die oberste Zeile bewegt das Fenster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mínimo no tiene barra de título; la fila superior mueve la ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minimal n’a pas de barre de titre ; la rangée du haut déplace la fenêtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minimale non ha barra del titolo; la riga superiore sposta la finestra."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អប្បបរមាគ្មានរបារចំណងជើង; ជួរខាងលើផ្លាស់ទីបង្អួច។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "최소에는 제목 막대가 없으며, 맨 윗줄로 윈도우를 이동합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minimal har ingen tittellinje; den øverste raden flytter vinduet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minimalny nie ma paska tytułu; górny wiersz przesuwa okno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mínimo não tem barra de título; a linha superior move a janela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В минимальном нет заголовка; окно перемещается за верхнюю строку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แบบน้อยที่สุดไม่มีแถบชื่อเรื่อง แถวบนสุดใช้ย้ายหน้าต่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minimal’de başlık çubuğu yoktur; üst satır pencereyi taşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У мінімальному немає смуги заголовка; вікно переміщується за верхній рядок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tối giản không có thanh tiêu đề; hàng trên cùng dùng để di chuyển cửa sổ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "极简模式没有标题栏；拖移顶行即可移动窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "極簡模式沒有標題列；拖移頂列即可移動視窗。"
          }
        }
      }
    }
  },
  "version": "1.0"
