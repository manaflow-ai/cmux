          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Werkzeug und Befehlsübersicht jeder Anfrage gehen in deinen eigenen cmux-Feed, damit dein iPhone antworten kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La herramienta y el resumen del comando de cada solicitud van a tu propio feed de cmux, para que tu iPhone pueda responder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’outil et le résumé de la commande de chaque demande vont dans votre propre flux cmux, pour que votre iPhone puisse répondre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo strumento e il riepilogo del comando di ogni richiesta vanno nel tuo feed cmux, così l’iPhone può rispondere."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Each request's tool and command summary goes to your own cmux feed, so your iPhone can answer it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "각 요청의 도구와 명령 요약이 내 cmux 피드로 전송되어 iPhone에서 응답할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Each request's tool and command summary goes to your own cmux feed, so your iPhone can answer it."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
