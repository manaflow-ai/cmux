            "state": "translated",
            "value": "Mostra schede dell’area di lavoro"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បង្ហាញផ្ទាំងកន្លែងធ្វើការ"
          }
        },
        "ko": {
          "stringUnit": {
