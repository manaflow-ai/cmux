        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tarayıcı sekmeleri, diğer tarayıcılarınızdan çerezleri içe aktarmayı önerir."
          }
        },
        "uk": {
          "stringUnit": {
