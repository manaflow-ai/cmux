    "settings.sessions.resumeAgents.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal agents reopen their session after a crash or restart."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعيد وكلاء الطرفية فتح جلستها بعد تعطل أو إعادة تشغيل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenti u terminalu ponovo otvaraju svoju sesiju nakon pada ili ponovnog pokretanja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminalagenter genåbner deres session efter et nedbrud eller en genstart."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal-Agenten öffnen ihre Sitzung nach einem Absturz oder Neustart wieder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes de terminal reabren su sesión tras un fallo o reinicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les agents du terminal rouvrent leur session après un plantage ou un redémarrage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli agenti nel terminale riaprono la loro sessione dopo un arresto anomalo o un riavvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラッシュや再起動のあと、ターミナルのエージェントが同じセッションを再開します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្នាក់ងារក្នុងទែមីណាល់បើកវគ្គរបស់វាឡើងវិញ បន្ទាប់ពីគាំង ឬចាប់ផ្ដើមឡើងវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충돌이나 재시작 후 터미널 에이전트가 세션을 다시 엽니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminalagenter åpner økten sin igjen etter et krasj eller en omstart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenci w terminalu ponownie otwierają swoją sesję po awarii lub ponownym uruchomieniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentes do terminal reabrem a sessão após uma falha ou reinício."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты в терминале снова открывают свой сеанс после сбоя или перезапуска."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์ในเทอร์มินัลจะเปิดเซสชันเดิมอีกครั้งหลังแครชหรือรีสตาร์ท"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal ajanları bir çökme veya yeniden başlatmadan sonra oturumlarını yeniden açar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенти в терміналі знову відкривають свій сеанс після збою або перезапуску."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác tử trong terminal mở lại phiên của mình sau sự cố hoặc khởi động lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "崩溃或重启后，终端中的智能体会重新打开其会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當機或重新啟動後，終端機中的代理程式會重新開啟其工作階段。"
          }
        }
      }
    },
