    "settings.agentPane.display.unreadBanner.help": {
      "comment": "Settings: the agent chat's and Markdown viewer's display rows",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A banner for new turns when you come back to a chat. Right-click it to hide it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "شريط للأدوار الجديدة عند عودتك إلى محادثة. انقر عليه بزر الماوس الأيمن لإخفائه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Traka za nove poteze kada se vratite u razgovor. Desni klik na nju je sakriva."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et banner for nye ture, når du vender tilbage til en chat. Højreklik på det for at skjule det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Banner für neue Runden, wenn du zu einem Chat zurückkehrst. Rechtsklick darauf blendet es aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un aviso de turnos nuevos al volver a un chat. Haz clic derecho en él para ocultarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un bandeau pour les nouveaux tours quand vous revenez dans une conversation. Clic droit dessus pour le masquer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un banner per i nuovi turni quando torni in una chat. Fai clic destro per nasconderlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "チャットに戻ったときに新しいターンを知らせるバナー。右クリックで非表示にできます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បដាសម្រាប់វេនថ្មី នៅពេលអ្នកត្រឡប់ទៅការជជែក។ ចុចកណ្ដុរស្ដាំលើវាដើម្បីលាក់វា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "채팅으로 돌아오면 새 턴을 알려 주는 배너입니다. 오른쪽 클릭하여 숨길 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et banner for nye runder når du kommer tilbake til en chat. Høyreklikk banneret for å skjule det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pasek z nowymi turami, gdy wracasz do czatu. Kliknij go prawym przyciskiem, aby go ukryć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um aviso de turnos novos quando você volta a um chat. Clique com o botão direito nele para ocultá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Баннер о новых ходах, когда вы возвращаетесь в чат. Щёлкните его правой кнопкой, чтобы скрыть."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แถบแจ้งรอบใหม่เมื่อคุณกลับมาที่แชท คลิกขวาที่แถบเพื่อซ่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir sohbete döndüğünüzde yeni turlar için bir afiş. Gizlemek için ona sağ tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Банер про нові ходи, коли ви повертаєтеся до чату. Клацніть його правою кнопкою, щоб сховати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Biểu ngữ báo các lượt mới khi bạn quay lại một cuộc trò chuyện. Nhấp chuột phải vào biểu ngữ để ẩn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "回到聊天时显示新轮次的横幅。右键点按即可隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "回到聊天時顯示新輪次的橫幅。按右鍵點按即可隱藏。"
          }
        }
      }
    },
