    "settings.diagnostics.hangReports.summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في Nightly فقط. بلا أسماء ملفات أو نصوص أو عناوين."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo Nightly. Bez imena datoteka, teksta i adresa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun Nightly. Ingen filnavne, tekst eller adresser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Nightly. Keine Dateinamen, Texte oder Adressen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightly only. No file names, text or addresses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo Nightly. Sin nombres de archivo, texto ni direcciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightly uniquement. Aucun nom de fichier, texte ni adresse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo Nightly. Nessun nome di file, testo o indirizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightlyのみ。ファイル名、テキスト、アドレスは含みません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សម្រាប់ Nightly ប៉ុណ្ណោះ។ គ្មាន​ឈ្មោះ​ឯកសារ អត្ថបទ ឬ​អាសយដ្ឋាន។"
