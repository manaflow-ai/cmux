    "settings.browser.agentMouseMaxMove": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Longest Agent Pointer Move"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أطول حركة لمؤشر الوكيل"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najduži pomak pokazivača agenta"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Længste markørbevægelse for agent"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Längste Zeigerbewegung des Agenten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Movimiento más largo del puntero del agente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacement le plus long du pointeur de l’agent"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Movimento più lungo del puntatore dell’agente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントのポインタ移動の最長時間"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការផ្លាស់ទីទ្រនិចរបស់ភ្នាក់ងារវែងបំផុត"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 포인터 이동 최대 시간"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lengste pekerbevegelse for agent"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najdłuższy ruch wskaźnika agenta"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Movimento mais longo do ponteiro do agente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самое долгое движение указателя агента"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเลื่อนตัวชี้ของเอเจนต์ที่นานที่สุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En uzun ajan işaretçi hareketi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдовший рух вказівника агента"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần di chuyển con trỏ dài nhất của tác tử"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理指针单次移动最长时间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理指標單次移動最長時間"
          }
        }
      }
    },
    "settings.browser.agentMouseMaxMove.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The longest time one agent pointer move takes with human motion. Short moves take less."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أطول مدة تستغرقها حركة واحدة لمؤشر الوكيل مع الحركة البشرية. الحركات القصيرة تستغرق وقتًا أقل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najduže vrijeme koje traje jedan pomak pokazivača agenta uz ljudsko kretanje. Kratki pomaci traju kraće."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den længste tid én markørbevægelse fra en agent tager med menneskelig bevægelse. Korte bevægelser tager kortere tid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die längste Zeit, die eine Zeigerbewegung des Agenten mit menschlicher Bewegung dauert. Kurze Bewegungen dauern kürzer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo máximo que tarda un movimiento del puntero del agente con movimiento humano. Los movimientos cortos tardan menos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La durée maximale d’un déplacement du pointeur de l’agent en mouvement humain. Les déplacements courts durent moins."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tempo massimo di un movimento del puntatore dell’agente con movimento umano. I movimenti brevi durano meno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「人間」の動きで、エージェントのポインタが 1 回移動するのにかかる最長時間です。短い移動はこれより短くなります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រយៈពេលវែងបំផុតដែលការផ្លាស់ទីទ្រនិចមួយដងរបស់ភ្នាក់ងារប្រើ ជាមួយចលនាដូចមនុស្ស។ ការផ្លាស់ទីខ្លីប្រើពេលតិចជាង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사람 움직임에서 에이전트 포인터가 한 번 이동하는 데 걸리는 최대 시간입니다. 짧은 이동은 더 짧게 걸립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lengste tiden én pekerbevegelse fra en agent tar med menneskelig bevegelse. Korte bevegelser tar kortere tid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najdłuższy czas jednego ruchu wskaźnika agenta przy ludzkim ruchu. Krótkie ruchy trwają krócej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo máximo de um movimento do ponteiro do agente com movimento humano. Movimentos curtos levam menos tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самое долгое время одного движения указателя агента в режиме «Человек». Короткие движения занимают меньше."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลานานที่สุดที่การเลื่อนตัวชี้ของเอเจนต์หนึ่งครั้งใช้เมื่อเคลื่อนแบบมนุษย์ การเลื่อนระยะสั้นใช้เวลาน้อยกว่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnsan hareketiyle bir ajan işaretçi hareketinin sürebileceği en uzun süre. Kısa hareketler daha az sürer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдовший час одного руху вказівника агента в режимі «Людина». Короткі рухи тривають менше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời gian dài nhất cho một lần di chuyển con trỏ của tác tử khi dùng chuyển động như người. Di chuyển ngắn mất ít thời gian hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用拟人移动时，代理指针单次移动所用的最长时间。短距离移动用时更短。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用擬人移動時，代理指標單次移動所用的最長時間。短距離移動用時更短。"
          }
        }
      }
    },
