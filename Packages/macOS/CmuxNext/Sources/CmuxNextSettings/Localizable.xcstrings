    "settings.browser.verificationAutofill.enabled.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offers emailed codes on the sender's own site. Never filled without your click."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعرض الرموز المرسلة بالبريد على موقع المرسل نفسه. لا يُملأ أبدًا دون نقرتك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nudi kodove iz e-pošte na stranici pošiljaoca. Nikad se ne popunjavaju bez vašeg klika."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tilbyder mailede koder på afsenderens eget websted. Udfyldes aldrig uden dit klik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bietet per E-Mail gesendete Codes auf der eigenen Website des Absenders an. Nie ohne deinen Klick eingesetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ofrece los códigos recibidos por correo en el propio sitio del remitente. Nunca se rellenan sin tu clic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Propose les codes reçus par e-mail sur le site de l’expéditeur. Jamais remplis sans votre clic."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Propone i codici ricevuti via email sul sito del mittente. Mai inseriti senza il tuo clic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "メールで届いたコードを送信元のサイトで提案します。クリックしない限り入力されません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ដល់ជូនលេខកូដពីអ៊ីមែល តែលើគេហទំព័ររបស់អ្នកផ្ញើប៉ុណ្ណោះ។ មិនបំពេញដោយគ្មានការចុចរបស់អ្នកឡើយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이메일로 받은 코드를 보낸 사이트에서만 제안합니다. 클릭하지 않으면 입력되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tilbyr koder fra e-post på avsenderens eget nettsted. Fylles aldri inn uten klikket ditt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Proponuje kody z e-maili w witrynie nadawcy. Nigdy nie wpisuje ich bez Twojego kliknięcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oferece códigos recebidos por e-mail no próprio site do remetente. Nunca preenchido sem seu clique."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Предлагает присланные коды на сайте отправителя. Никогда не вставляет их без вашего нажатия."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เสนอรหัสจากอีเมลบนเว็บไซต์ของผู้ส่งเท่านั้น ไม่กรอกโดยที่คุณไม่ได้คลิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "E-postayla gelen kodları gönderenin kendi sitesinde önerir. Tıklamanız olmadan asla doldurulmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пропонує коди з листів на сайті відправника. Ніколи не вставляє без вашого натискання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đề xuất mã gửi qua email trên chính trang của người gửi. Không bao giờ điền khi bạn chưa nhấp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在发件网站本身提供邮件中的验证码。未经你点击绝不填充。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在寄件網站本身提供郵件中的驗證碼。未經你點按絕不填入。"
          }
        }
      }
    },
