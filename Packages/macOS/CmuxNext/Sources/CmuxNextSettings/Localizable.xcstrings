            "value": "ให้แท็บข้างเคียงทำงานอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Komşu sekmeleri uyanık tut"
          }
        },
        "uk": {
          "stringUnit": {
