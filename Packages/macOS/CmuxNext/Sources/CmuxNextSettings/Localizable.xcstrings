    "settings.layout.scrollAreas.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Side-by-side panes that do not fit scroll sideways instead of shrinking, also in docked columns."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الأجزاء المتجاورة التي لا تتسع تتمرر أفقيًا بدلًا من أن تصغر، وكذلك في الأعمدة المثبتة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Okna jedno do drugog koja ne stanu pomiču se bočno umjesto da se smanjuju, i u usidrenim kolonama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ruder side om side, der ikke er plads til, ruller sidelæns i stedet for at blive mindre, også i dockede kolonner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nebeneinanderliegende Bereiche, die nicht passen, scrollen seitlich, statt kleiner zu werden, auch in angedockten Spalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los paneles contiguos que no caben se desplazan en horizontal en lugar de encogerse, también en las columnas acopladas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les panneaux côte à côte qui ne tiennent pas défilent horizontalement au lieu de rétrécir, y compris dans les colonnes ancrées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I riquadri affiancati che non entrano scorrono lateralmente invece di rimpicciolirsi, anche nelle colonne agganciate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "横に並んだペインが収まらないときは、縮めずに横にスクロールします。ドックした列でも同じです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទាំងនៅជាប់គ្នាដែលមិនសមនឹងរំកិលទៅចំហៀង ជំនួសឱ្យការរួញតូច រួមទាំងក្នុងជួរឈរដែលបានភ្ជាប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "나란히 놓인 창이 들어가지 않으면 줄어들지 않고 가로로 스크롤됩니다. 도킹된 열에서도 같습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ruter side om side som ikke får plass, ruller sidelengs i stedet for å krympe, også i dokkede kolonner."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Panele obok siebie, które się nie mieszczą, przewijają się w bok zamiast się zmniejszać, także w zadokowanych kolumnach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Painéis lado a lado que não cabem rolam na horizontal em vez de encolher, também em colunas fixadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Панели рядом, которые не помещаются, прокручиваются вбок, а не сжимаются, в том числе в закреплённых столбцах."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "บานหน้าต่างที่วางเคียงกันซึ่งไม่พอดีจะเลื่อนด้านข้างแทนการหดลง รวมถึงในคอลัมน์ที่ปักหมุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yan yana sığmayan bölmeler küçülmek yerine yana kayar; sabitlenmiş sütunlarda da."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Панелі поруч, які не вміщуються, прокручуються вбік, а не зменшуються, також у закріплених стовпцях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các khung cạnh nhau không vừa sẽ cuộn ngang thay vì thu nhỏ, kể cả trong các cột được neo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "并排的窗格放不下时会横向滚动而不是缩小，停靠列中也一样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "並排的窗格放不下時會橫向捲動而不是縮小，停靠欄中也一樣。"
          }
        }
      }
    },
