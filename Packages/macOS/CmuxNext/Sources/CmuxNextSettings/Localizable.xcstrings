        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在新分頁上顯示問候語"
          }
        }
      }
    },
    "settings.tabs.newTabWidgets.warmGreeting.help": {
      "comment": "Settings: help for the New Tab time-of-day greeting toggle.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحية بحسب وقت اليوم مثل مساء الخير."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozdrav prema dobu dana, npr. Dobar dan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En hilsen efter tidspunktet, fx God eftermiddag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Begrüßung je nach Tageszeit, etwa Guten Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A time-of-day greeting such as Good afternoon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un saludo según la hora del día, como Buenas tardes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un message selon l'heure, comme Bon après-midi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un saluto in base all'ora del giorno, come Buon pomeriggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「こんにちは」など、時間帯に合わせた挨拶。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការ​ស្វាគមន៍​តាម​ពេល​វេលា ដូចជា អរុណសួស្ដី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋은 오후예요처럼 시간대에 맞는 인사말입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En hilsen etter tid på dagen, som God ettermiddag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powitanie zależne od pory dnia, np. Dzień dobry."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma saudação conforme a hora do dia, como Boa tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приветствие по времени суток, например «Добрый день»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำทักทายตามช่วงเวลา เช่น สวัสดีตอนบ่าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günün saatine göre bir selamlama, örneğin İyi günler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Привітання за часом доби, наприклад «Добрий день»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời chào theo thời điểm trong ngày, như Chào buổi chiều."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按时段问候，例如“下午好”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依時段問候，例如「午安」。"
          }
        }
      }
    },
    "settings.tabs.newTabWidgets.quote": {
      "comment": "Settings: toggle that shows the quote of the day on the New Tab page.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار اقتباس اليوم في علامة التبويب الجديدة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaži citat dana na novoj kartici"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis dagens citat på ny fane"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zitat des Tages im neuen Tab anzeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Quote of the Day on New Tab"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar la cita del día en la nueva pestaña"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher la citation du jour dans le nouvel onglet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra la citazione del giorno nella nuova scheda"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規タブに今日の名言を表示"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បង្ហាញ​សម្រង់​ប្រចាំ​ថ្ងៃ​នៅ​លើ​ផ្ទាំង​ថ្មី"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 탭에 오늘의 명언 보기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis dagens sitat på ny fane"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż cytat dnia na nowej karcie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar a citação do dia na nova aba"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать цитату дня в новой вкладке"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงคำคมประจำวันในแท็บใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni sekmede günün sözünü göster"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати цитату дня в новій вкладці"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện câu trích dẫn trong ngày trên thẻ mới"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在新标签页上显示每日一句"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在新分頁上顯示每日一句"
          }
        }
      }
    },
    "settings.tabs.newTabWidgets.quote.help": {
      "comment": "Settings: help for the New Tab quote of the day toggle.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقتباس مضمّن من الملكية العامة يتغير يوميًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugrađeni citat iz javnog domena koji se mijenja svaki dan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et indbygget citat fra det offentlige domæne, der skifter dagligt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein mitgeliefertes gemeinfreies Zitat, das täglich wechselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bundled public-domain quote, changing daily."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cita de dominio público incluida, que cambia cada día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une citation du domaine public intégrée, qui change chaque jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una citazione di pubblico dominio inclusa, che cambia ogni giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日変わる、同梱のパブリックドメインの名言。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សម្រង់​ដែន​សាធារណៈ​ដែល​ភ្ជាប់​មក​ជាមួយ ផ្លាស់ប្ដូរ​រៀងរាល់​ថ្ងៃ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 바뀌는 내장 퍼블릭 도메인 명언입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et innebygd sitat fra det offentlige domene som skifter daglig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wbudowany cytat z domeny publicznej, zmieniany codziennie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma citação de domínio público incluída, que muda diariamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенная цитата из общественного достояния, меняется каждый день."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำคมสาธารณสมบัติที่มาพร้อมแอป เปลี่ยนทุกวัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her gün değişen, yerleşik kamu malı bir söz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вбудована цитата із суспільного надбання, змінюється щодня."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một câu trích dẫn thuộc phạm vi công cộng có sẵn, đổi mỗi ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置的公有领域名言，每日更换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內建的公有領域名言，每日更換。"
          }
        }
      }
    },
