    "settings.tabs.newTabKind.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Cmd-T and the + button open. Auto picks the kind you last opened in that folder."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يفتحه Cmd-T وزر +. يختار الوضع التلقائي النوع الذي فتحته آخر مرة في ذلك المجلد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Šta otvaraju Cmd-T i dugme +. Automatski bira vrstu koju ste posljednju otvorili u toj mapi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvad Cmd-T og knappen + åbner. Automatisk vælger den type, du sidst åbnede i den mappe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was Cmd-T und die Schaltfläche + öffnen. Automatisch wählt die Art, die du zuletzt in diesem Ordner geöffnet hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que abren Cmd-T y el botón +. Automático elige el tipo que abriste por última vez en esa carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qu’ouvrent Cmd-T et le bouton +. Automatique choisit le type que vous avez ouvert en dernier dans ce dossier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cosa aprono Cmd-T e il pulsante +. Automatico sceglie il tipo aperto per ultimo in quella cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-T と + ボタンで開くもの。自動では、そのフォルダで最後に開いた種類を選びます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អ្វីដែល Cmd-T និងប៊ូតុង + បើក។ ស្វ័យប្រវត្តិជ្រើសប្រភេទដែលអ្នកបានបើកចុងក្រោយក្នុងថតនោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-T와 + 버튼으로 여는 항목입니다. 자동은 해당 폴더에서 마지막으로 연 종류를 고릅니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hva Cmd-T og +-knappen åpner. Automatisk velger typen du sist åpnet i den mappen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Co otwiera Cmd-T i przycisk +. Automatycznie wybiera rodzaj ostatnio otwarty w tym folderze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O que Cmd-T e o botão + abrem. Automático escolhe o tipo que você abriu por último nessa pasta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Что открывают Cmd-T и кнопка +. «Авто» выбирает тип, который вы последним открывали в этой папке."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สิ่งที่ Cmd-T และปุ่ม + เปิด อัตโนมัติจะเลือกชนิดที่คุณเปิดล่าสุดในโฟลเดอร์นั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cmd-T ve + düğmesinin açtığı şey. Otomatik, o klasörde en son açtığınız türü seçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Що відкривають Cmd-T і кнопка +. «Авто» вибирає тип, який ви востаннє відкривали в цій папці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Những gì Cmd-T và nút + mở. Tự động chọn loại bạn mở gần nhất trong thư mục đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-T 和 + 按钮打开的内容。自动会选择你在该文件夹中最近打开的类型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-T 和 + 按鈕開啟的內容。自動會選擇你在該資料夾中最近開啟的類型。"
          }
        }
      }
    },
