    "settings.browser.importCookieSync.help": {
      "comment": "Settings > Browser > Import: help under Keep Imported Cookies in Sync.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brings over changed cookies from the browser you imported from. Stays on this Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ينقل ملفات تعريف الارتباط المتغيرة من المتصفح الذي استوردت منه. يبقى كل شيء على هذا الـ Mac."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prenosi promijenjene kolačiće iz preglednika iz kojeg ste uvezli. Ostaje na ovom Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Henter ændrede cookies fra den browser, du importerede fra. Bliver på denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Übernimmt geänderte Cookies aus dem Browser, aus dem du importiert hast. Bleibt auf diesem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trae las cookies que cambiaron en el navegador del que importaste. Nada sale de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reprend les cookies modifiés du navigateur d’où vous avez importé. Reste sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Riporta i cookie cambiati dal browser da cui hai importato. Resta su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "インポート元のブラウザで変わった Cookie を取り込みます。この Mac から外には送信されません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "នាំយកខូគីដែលបានផ្លាស់ប្ដូរពីកម្មវិធីរុករកដែលអ្នកបាននាំចូលពី។ នៅតែលើ Mac នេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "가져온 브라우저에서 바뀐 쿠키를 가져옵니다. 이 Mac 밖으로 나가지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Henter endrede informasjonskapsler fra nettleseren du importerte fra. Blir på denne Macen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przenosi zmienione pliki cookie z przeglądarki, z której importowano. Pozostaje na tym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Traz os cookies alterados do navegador de onde você importou. Fica neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Переносит изменённые cookie из браузера, из которого вы импортировали. Данные остаются на этом Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "นำคุกกี้ที่เปลี่ยนไปจากเบราว์เซอร์ที่คุณนำเข้ามา อยู่บน Mac เครื่องนี้เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İçe aktardığınız tarayıcıdan değişen çerezleri getirir. Bu Mac'te kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Переносить змінені cookie з браузера, з якого ви імпортували. Дані лишаються на цьому Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mang sang cookie đã thay đổi từ trình duyệt bạn đã nhập. Mọi thứ ở lại trên máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "同步你导入时所用浏览器中发生变化的 Cookie。数据只留在这台 Mac 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "同步你匯入來源瀏覽器中有變動的 Cookie。資料只留在這台 Mac。"
          }
        }
      }
    },
