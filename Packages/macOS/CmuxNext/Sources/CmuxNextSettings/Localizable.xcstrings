    "settings.diagnostics.hangReports.summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في Nightly فقط. بلا أسماء ملفات أو نصوص أو عناوين."
