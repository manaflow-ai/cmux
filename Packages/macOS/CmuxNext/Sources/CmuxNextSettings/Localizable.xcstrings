            "value": "Her makine daha eski kaydedilmiş komutları siler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кожна машина видаляє записані команди, старші за цей термін."
          }
        },
        "vi": {
