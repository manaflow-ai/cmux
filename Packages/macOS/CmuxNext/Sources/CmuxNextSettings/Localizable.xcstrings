    "settings.browser.importEnabled.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offers to bring bookmarks, history, passwords and sign-ins over from other browsers: Import from Browser in the File menu and the palette, and the import cards in Settings. Off hides them and nothing imports by itself. Data already imported stays."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض نقل الإشارات المرجعية والسجل وكلمات المرور وجلسات تسجيل الدخول من متصفحات أخرى: «الاستيراد من المتصفح» في قائمة «ملف» ولوحة الأوامر، وبطاقات الاستيراد في «الإعدادات». عند الإيقاف تُخفى كلها ولا يُستورد شيء تلقائيًا. تبقى البيانات المستوردة سابقًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nudi prenos oznaka, historije, lozinki i prijava iz drugih preglednika: Uvoz iz preglednika u meniju Datoteka i paleti te kartice za uvoz u Postavkama. Isključeno ih skriva i ništa se ne uvozi samo od sebe. Već uvezeni podaci ostaju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbyder at hente bogmærker, historik, adgangskoder og logins fra andre browsere: Importér fra browser i menuen Arkiv og paletten samt importkortene i Indstillinger. Slået fra skjules de, og intet importeres af sig selv. Data, der allerede er importeret, bliver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bietet an, Lesezeichen, Verlauf, Passwörter und Anmeldungen aus anderen Browsern zu übernehmen: „Aus Browser importieren“ im Menü „Ablage“ und in der Palette sowie die Importkarten in den Einstellungen. Aus blendet sie aus und nichts wird von selbst importiert. Bereits importierte Daten bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ofrece traer marcadores, historial, contraseñas e inicios de sesión de otros navegadores: Importar desde el navegador en el menú Archivo y en la paleta, y las tarjetas de importación en Ajustes. Desactivado los oculta y nada se importa por sí solo. Los datos ya importados se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Propose de récupérer les signets, l’historique, les mots de passe et les connexions d’autres navigateurs : Importer depuis le navigateur dans le menu Fichier et la palette, et les cartes d’importation dans Réglages. Désactivé, tout cela est masqué et rien n’est importé de soi-même. Les données déjà importées restent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Propone di portare segnalibri, cronologia, password e accessi da altri browser: Importa da browser nel menu File e nella palette, e le schede di importazione in Impostazioni. Disattivato li nasconde e nulla viene importato da solo. I dati già importati restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のブラウザからブックマーク、履歴、パスワード、ログイン情報を取り込むよう提案します。ファイルメニューとパレットの「ブラウザから読み込む」、設定の読み込みカードです。オフにするとこれらは非表示になり、自動では何も読み込まれません。読み込み済みのデータは残ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្តល់ជូនការនាំយកចំណាំ ប្រវត្តិ ពាក្យសម្ងាត់ និងការចូលគណនីពីកម្មវិធីរុករកផ្សេងទៀត៖ នាំចូលពីកម្មវិធីរុករក នៅក្នុងម៉ឺនុយ ឯកសារ និងផ្ទាំងពាក្យបញ្ជា ព្រមទាំងកាតនាំចូលនៅក្នុង ការកំណត់។ បិទ នឹងលាក់វា ហើយគ្មានអ្វីនាំចូលដោយខ្លួនឯងទេ។ ទិន្នន័យដែលបាននាំចូលរួចនៅដដែល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 브라우저의 북마크, 방문 기록, 암호, 로그인 정보를 가져오도록 제안합니다. 파일 메뉴와 팔레트의 '브라우저에서 가져오기', 설정의 가져오기 카드입니다. 끄면 모두 숨겨지고 저절로 가져오는 것은 없습니다. 이미 가져온 데이터는 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbyr å hente bokmerker, historikk, passord og pålogginger fra andre nettlesere: Importer fra nettleser i Arkiv-menyen og paletten, og importkortene i Innstillinger. Av skjuler dem, og ingenting importeres av seg selv. Data som allerede er importert, blir værende."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proponuje przeniesienie zakładek, historii, haseł i logowań z innych przeglądarek: Importuj z przeglądarki w menu Plik i palecie oraz karty importu w Ustawieniach. Wyłączone ukrywa je i nic nie importuje się samo. Już zaimportowane dane pozostają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oferece trazer favoritos, histórico, senhas e logins de outros navegadores: Importar do navegador no menu Arquivo e na paleta, e os cartões de importação em Ajustes. Desativado os oculta e nada é importado sozinho. Os dados já importados permanecem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предлагает перенести закладки, историю, пароли и входы из других браузеров: «Импорт из браузера» в меню «Файл» и палитре, а также карточки импорта в настройках. Если выключено, всё это скрыто и ничего не импортируется само. Уже импортированные данные остаются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสนอให้นำบุ๊กมาร์ก ประวัติ รหัสผ่าน และการลงชื่อเข้าใช้มาจากเบราว์เซอร์อื่น ได้แก่ นำเข้าจากเบราว์เซอร์ ในเมนูไฟล์และพาเลต และการ์ดนำเข้าในการตั้งค่า เมื่อปิดจะซ่อนทั้งหมดและไม่มีการนำเข้าเอง ข้อมูลที่นำเข้าแล้วยังคงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer tarayıcılardan yer işaretlerini, geçmişi, parolaları ve oturum açma bilgilerini getirmeyi önerir: Dosya menüsünde ve palette Tarayıcıdan İçe Aktar ile Ayarlar'daki içe aktarma kartları. Kapalıyken bunlar gizlenir ve hiçbir şey kendiliğinden içe aktarılmaz. Önceden içe aktarılan veriler kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропонує перенести закладки, історію, паролі та входи з інших браузерів: «Імпорт з браузера» в меню «Файл» і палітрі, а також картки імпорту в налаштуваннях. Якщо вимкнено, усе це приховано й нічого не імпортується саме. Уже імпортовані дані залишаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đề xuất chuyển dấu trang, lịch sử, mật khẩu và thông tin đăng nhập từ trình duyệt khác: Nhập từ trình duyệt trong menu Tệp và bảng lệnh, cùng các thẻ nhập trong Cài đặt. Tắt sẽ ẩn chúng và không có gì tự nhập. Dữ liệu đã nhập vẫn được giữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提议从其他浏览器导入书签、历史记录、密码和登录信息：“文件”菜单和命令面板中的“从浏览器导入”，以及设置中的导入卡片。关闭后这些都会隐藏，也不会自行导入任何内容。已导入的数据会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提議從其他瀏覽器匯入書籤、瀏覽記錄、密碼和登入資訊：「檔案」選單和命令面板中的「從瀏覽器匯入」，以及設定中的匯入卡片。關閉後這些都會隱藏，也不會自行匯入任何內容。已匯入的資料會保留。"
          }
        }
      }
    },
