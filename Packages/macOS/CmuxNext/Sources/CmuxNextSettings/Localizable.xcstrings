    "settings.computerUse.deniedApps.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Apps no agent may use, in any mode: an app ID, an ID prefix ending in *, or name: and the app's name."}},
        "ar": {"stringUnit": {"state": "translated", "value": "تطبيقات لا يمكن لأي وكيل استخدامها في أي وضع: معرّف تطبيق، أو بادئة معرّف تنتهي بـ *، أو name: متبوعًا باسم التطبيق."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Aplikacije koje nijedan agent ne smije koristiti, ni u jednom načinu: ID aplikacije, prefiks ID-a koji završava sa *, ili name: i naziv aplikacije."}},
        "da": {"stringUnit": {"state": "translated", "value": "Apps, som ingen agent må bruge, uanset tilstand: et app-id, et id-præfiks, der slutter med *, eller name: og appens navn."}},
        "de": {"stringUnit": {"state": "translated", "value": "Apps, die kein Agent in irgendeinem Modus verwenden darf: eine App-ID, ein ID-Präfix mit * am Ende oder name: und der App-Name."}},
        "es": {"stringUnit": {"state": "translated", "value": "Apps que ningún agente puede usar, en ningún modo: un ID de app, un prefijo de ID que termina en * o name: y el nombre de la app."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Apps qu’aucun agent ne peut utiliser, quel que soit le mode : un identifiant d’app, un préfixe d’identifiant terminé par *, ou name: suivi du nom de l’app."}},
        "it": {"stringUnit": {"state": "translated", "value": "App che nessun agente può usare, in nessuna modalità: un ID app, un prefisso di ID che termina con * oppure name: e il nome dell’app."}},
        "ja": {"stringUnit": {"state": "translated", "value": "どのモードでもエージェントが使えないアプリ：アプリID、* で終わるIDの接頭辞、または name: とアプリ名。"}},
        "km": {"stringUnit": {"state": "translated", "value": "កម្មវិធីដែលគ្មានភ្នាក់ងារណាអាចប្រើបាន ក្នុងរបៀបណាក៏ដោយ៖ ID កម្មវិធី បុព្វបទ ID ដែលបញ្ចប់ដោយ * ឬ name: និងឈ្មោះកម្មវិធី។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "어떤 모드에서도 에이전트가 사용할 수 없는 앱: 앱 ID, *로 끝나는 ID 접두사, 또는 name: 뒤에 앱 이름."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Apper ingen agent kan bruke, uansett modus: en app-ID, et ID-prefiks som slutter med *, eller name: og appens navn."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Aplikacje, których żaden agent nie może używać w żadnym trybie: identyfikator aplikacji, prefiks identyfikatora zakończony *, albo name: i nazwa aplikacji."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Apps que nenhum agente pode usar, em nenhum modo: um ID de app, um prefixo de ID terminado em * ou name: e o nome do app."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Приложения, которые агенты не могут использовать ни в одном режиме: ID приложения, префикс ID с * на конце или name: и название приложения."}},
        "th": {"stringUnit": {"state": "translated", "value": "แอปที่เอเจนต์ใดก็ใช้ไม่ได้ไม่ว่าในโหมดใด: ID แอป, คำนำหน้า ID ที่ลงท้ายด้วย * หรือ name: ตามด้วยชื่อแอป"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Hiçbir ajanın hiçbir modda kullanamayacağı uygulamalar: bir uygulama kimliği, * ile biten bir kimlik öneki veya name: ve uygulamanın adı."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Програми, якими жоден агент не може користуватися в жодному режимі: ID програми, префікс ID із * в кінці або name: і назва програми."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Ứng dụng mà không tác nhân nào được dùng, ở bất kỳ chế độ nào: ID ứng dụng, tiền tố ID kết thúc bằng *, hoặc name: và tên ứng dụng."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "任何模式下都不允许智能体使用的应用：应用 ID、以 * 结尾的 ID 前缀，或 name: 加应用名称。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "任何模式下都不允許代理程式使用的 App：App ID、以 * 結尾的 ID 前綴，或 name: 加上 App 名稱。"}}
      }
    },
    "settings.computerUse.deniedApps.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Apps agents may never use"}},
        "ar": {"stringUnit": {"state": "translated", "value": "تطبيقات لا يستخدمها الوكلاء أبدًا"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Aplikacije koje agenti nikad ne smiju koristiti"}},
        "da": {"stringUnit": {"state": "translated", "value": "Apps, som agenter aldrig må bruge"}},
        "de": {"stringUnit": {"state": "translated", "value": "Apps, die Agenten nie verwenden dürfen"}},
        "es": {"stringUnit": {"state": "translated", "value": "Apps que los agentes nunca pueden usar"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Apps que les agents ne peuvent jamais utiliser"}},
        "it": {"stringUnit": {"state": "translated", "value": "App che gli agenti non possono mai usare"}},
        "ja": {"stringUnit": {"state": "translated", "value": "エージェントが決して使えないアプリ"}},
        "km": {"stringUnit": {"state": "translated", "value": "កម្មវិធីដែលភ្នាក់ងារមិនអាចប្រើបានឡើយ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "에이전트가 절대 사용할 수 없는 앱"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Apper agenter aldri kan bruke"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Aplikacje, których agenci nigdy nie mogą używać"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Apps que os agentes nunca podem usar"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Приложения, которые агенты никогда не используют"}},
        "th": {"stringUnit": {"state": "translated", "value": "แอปที่เอเจนต์ห้ามใช้"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Ajanların asla kullanamayacağı uygulamalar"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Програми, якими агенти ніколи не користуються"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Ứng dụng tác nhân không bao giờ được dùng"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "智能体永远不能使用的应用"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "代理程式永遠不能使用的 App"}}
      }
    },
    "settings.computerUse.allowOwnMachines": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Allow My Other Machines"}},
        "ar": {"stringUnit": {"state": "translated", "value": "السماح لأجهزتي الأخرى"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Dozvoli moje druge mašine"}},
        "da": {"stringUnit": {"state": "translated", "value": "Tillad mine andre maskiner"}},
        "de": {"stringUnit": {"state": "translated", "value": "Meine anderen Rechner erlauben"}},
        "es": {"stringUnit": {"state": "translated", "value": "Permitir mis otros equipos"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Autoriser mes autres machines"}},
        "it": {"stringUnit": {"state": "translated", "value": "Consenti le mie altre macchine"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分の他のマシンを許可"}},
        "km": {"stringUnit": {"state": "translated", "value": "អនុញ្ញាតម៉ាស៊ីនផ្សេងទៀតរបស់ខ្ញុំ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "내 다른 기기 허용"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Tillat mine andre maskiner"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Zezwalaj moim innym komputerom"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Permitir minhas outras máquinas"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Разрешить другие мои компьютеры"}},
        "th": {"stringUnit": {"state": "translated", "value": "อนุญาตเครื่องอื่นของฉัน"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Diğer makinelerime izin ver"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Дозволити інші мої комп’ютери"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Cho phép các máy khác của tôi"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "允许我的其他机器"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "允許我的其他機器"}}
      }
    },
    "settings.computerUse.allowOwnMachines.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Agents on your other machines, signed in to the same account, may use this Mac's apps."}},
        "ar": {"stringUnit": {"state": "translated", "value": "يمكن للوكلاء على أجهزتك الأخرى المسجّلة بالحساب نفسه استخدام تطبيقات هذا الـ Mac."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Agenti na vašim drugim mašinama, prijavljenim na isti račun, smiju koristiti aplikacije ovog Maca."}},
        "da": {"stringUnit": {"state": "translated", "value": "Agenter på dine andre maskiner, der er logget ind på samme konto, må bruge denne Macs apps."}},
        "de": {"stringUnit": {"state": "translated", "value": "Agenten auf deinen anderen Rechnern, die mit demselben Konto angemeldet sind, dürfen die Apps dieses Mac verwenden."}},
        "es": {"stringUnit": {"state": "translated", "value": "Los agentes de tus otros equipos, con la misma cuenta, pueden usar las apps de este Mac."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les agents de vos autres machines, connectées au même compte, peuvent utiliser les apps de ce Mac."}},
        "it": {"stringUnit": {"state": "translated", "value": "Gli agenti sulle tue altre macchine, con lo stesso account, possono usare le app di questo Mac."}},
        "ja": {"stringUnit": {"state": "translated", "value": "同じアカウントでサインインしている他のマシンのエージェントが、このMacのアプリを使えます。"}},
        "km": {"stringUnit": {"state": "translated", "value": "ភ្នាក់ងារនៅលើម៉ាស៊ីនផ្សេងទៀតរបស់អ្នក ដែលចូលដោយគណនីដូចគ្នា អាចប្រើកម្មវិធីរបស់ Mac នេះបាន។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "같은 계정으로 로그인한 다른 기기의 에이전트가 이 Mac의 앱을 사용할 수 있습니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Agenter på de andre maskinene dine, logget på samme konto, kan bruke appene på denne Macen."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Agenci na Twoich innych komputerach, zalogowanych na to samo konto, mogą używać aplikacji tego Maca."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Agentes nas suas outras máquinas, com a mesma conta, podem usar os apps deste Mac."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Агенты на других ваших компьютерах с той же учётной записью могут использовать приложения этого Mac."}},
        "th": {"stringUnit": {"state": "translated", "value": "เอเจนต์บนเครื่องอื่นของคุณที่ลงชื่อเข้าบัญชีเดียวกันสามารถใช้แอปของ Mac เครื่องนี้ได้"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Aynı hesapla oturum açmış diğer makinelerinizdeki ajanlar bu Mac'in uygulamalarını kullanabilir."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Агенти на інших ваших комп’ютерах з тим самим обліковим записом можуть користуватися програмами цього Mac."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Tác nhân trên các máy khác của bạn, đăng nhập cùng tài khoản, được dùng ứng dụng của máy Mac này."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "登录同一账户的其他机器上的智能体可以使用这台 Mac 的应用。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "登入同一帳號的其他機器上的代理程式可以使用這台 Mac 的 App。"}}
      }
    },
    "settings.computerUse.allowOwnMachines.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Agents on your other machines may use this Mac"}},
        "ar": {"stringUnit": {"state": "translated", "value": "يمكن لوكلاء أجهزتك الأخرى استخدام هذا الـ Mac"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Agenti s drugih mašina smiju koristiti ovaj Mac"}},
        "da": {"stringUnit": {"state": "translated", "value": "Agenter på dine andre maskiner må bruge denne Mac"}},
        "de": {"stringUnit": {"state": "translated", "value": "Agenten auf anderen Rechnern dürfen diesen Mac nutzen"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los agentes de otros equipos pueden usar este Mac"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les agents d’autres machines peuvent utiliser ce Mac"}},
        "it": {"stringUnit": {"state": "translated", "value": "Gli agenti di altre macchine possono usare questo Mac"}},
        "ja": {"stringUnit": {"state": "translated", "value": "他のマシンのエージェントがこのMacを使えます"}},
        "km": {"stringUnit": {"state": "translated", "value": "ភ្នាក់ងារនៅម៉ាស៊ីនផ្សេងអាចប្រើ Mac នេះ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "다른 기기의 에이전트가 이 Mac을 사용 가능"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Agenter på andre maskiner kan bruke denne Macen"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Agenci z innych komputerów mogą używać tego Maca"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Agentes de outras máquinas podem usar este Mac"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Агенты с других компьютеров могут использовать этот Mac"}},
        "th": {"stringUnit": {"state": "translated", "value": "เอเจนต์บนเครื่องอื่นใช้ Mac นี้ได้"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Diğer makinelerdeki ajanlar bu Mac'i kullanabilir"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Агенти з інших комп’ютерів можуть користуватися цим Mac"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Tác nhân trên máy khác được dùng máy Mac này"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "其他机器上的智能体可使用这台 Mac"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "其他機器上的代理程式可使用這台 Mac"}}
      }
    },
    "settings.computerUse.pauseOnTakeover": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Pause When I Use the Mouse or Keyboard"}},
        "ar": {"stringUnit": {"state": "translated", "value": "الإيقاف المؤقت عند استخدامي الماوس أو لوحة المفاتيح"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Pauziraj kad koristim miš ili tastaturu"}},
        "da": {"stringUnit": {"state": "translated", "value": "Sæt på pause, når jeg bruger mus eller tastatur"}},
        "de": {"stringUnit": {"state": "translated", "value": "Pausieren, wenn ich Maus oder Tastatur benutze"}},
        "es": {"stringUnit": {"state": "translated", "value": "Pausar cuando uso el ratón o el teclado"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Mettre en pause quand j’utilise la souris ou le clavier"}},
        "it": {"stringUnit": {"state": "translated", "value": "Pausa quando uso mouse o tastiera"}},
        "ja": {"stringUnit": {"state": "translated", "value": "マウスやキーボードを使っているときは一時停止"}},
        "km": {"stringUnit": {"state": "translated", "value": "ផ្អាកពេលខ្ញុំប្រើកណ្ដុរ ឬក្ដារចុច"}},
        "ko": {"stringUnit": {"state": "translated", "value": "마우스나 키보드를 사용할 때 일시 정지"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Sett på pause når jeg bruker mus eller tastatur"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Wstrzymuj, gdy używam myszy lub klawiatury"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Pausar quando eu usar o mouse ou o teclado"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Приостанавливать, когда я пользуюсь мышью или клавиатурой"}},
        "th": {"stringUnit": {"state": "translated", "value": "หยุดชั่วคราวเมื่อฉันใช้เมาส์หรือแป้นพิมพ์"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Fare veya klavye kullandığımda duraklat"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Призупиняти, коли я користуюся мишею або клавіатурою"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Tạm dừng khi tôi dùng chuột hoặc bàn phím"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "我使用鼠标或键盘时暂停"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "我使用滑鼠或鍵盤時暫停"}}
      }
    },
    "settings.computerUse.pauseOnTakeover.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "While you use the mouse or keyboard, agents wait before their next click or key press."}},
        "ar": {"stringUnit": {"state": "translated", "value": "أثناء استخدامك الماوس أو لوحة المفاتيح، ينتظر الوكلاء قبل النقرة أو ضغطة المفتاح التالية."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Dok koristite miš ili tastaturu, agenti čekaju prije sljedećeg klika ili pritiska tipke."}},
        "da": {"stringUnit": {"state": "translated", "value": "Mens du bruger mus eller tastatur, venter agenter før deres næste klik eller tastetryk."}},
        "de": {"stringUnit": {"state": "translated", "value": "Während du Maus oder Tastatur benutzt, warten Agenten vor ihrem nächsten Klick oder Tastendruck."}},
        "es": {"stringUnit": {"state": "translated", "value": "Mientras usas el ratón o el teclado, los agentes esperan antes de su siguiente clic o pulsación."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Pendant que vous utilisez la souris ou le clavier, les agents attendent avant leur prochain clic ou frappe."}},
        "it": {"stringUnit": {"state": "translated", "value": "Mentre usi mouse o tastiera, gli agenti attendono prima del clic o del tasto successivo."}},
        "ja": {"stringUnit": {"state": "translated", "value": "マウスやキーボードを使っている間、エージェントは次のクリックやキー入力を待ちます。"}},
        "km": {"stringUnit": {"state": "translated", "value": "ពេលអ្នកប្រើកណ្ដុរ ឬក្ដារចុច ភ្នាក់ងាររង់ចាំមុនការចុច ឬការវាយគ្រាប់ចុចបន្ទាប់។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "마우스나 키보드를 사용하는 동안 에이전트는 다음 클릭이나 키 입력 전에 기다립니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Mens du bruker mus eller tastatur, venter agenter før neste klikk eller tastetrykk."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Gdy używasz myszy lub klawiatury, agenci czekają z kolejnym kliknięciem lub naciśnięciem klawisza."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Enquanto você usa o mouse ou o teclado, os agentes esperam antes do próximo clique ou tecla."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Пока вы пользуетесь мышью или клавиатурой, агенты ждут перед следующим щелчком или нажатием клавиши."}},
        "th": {"stringUnit": {"state": "translated", "value": "ขณะที่คุณใช้เมาส์หรือแป้นพิมพ์ เอเจนต์จะรอก่อนคลิกหรือกดแป้นครั้งต่อไป"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Fare veya klavye kullanırken ajanlar bir sonraki tıklamadan veya tuş basışından önce bekler."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Поки ви користуєтеся мишею або клавіатурою, агенти чекають перед наступним клацанням чи натисканням клавіші."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Khi bạn dùng chuột hoặc bàn phím, tác nhân chờ trước lần nhấp hoặc nhấn phím tiếp theo."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "你使用鼠标或键盘时，智能体会等待，然后再进行下一次点按或按键。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "你使用滑鼠或鍵盤時，代理程式會等待，再進行下一次點按或按鍵。"}}
      }
    },
    "settings.computerUse.pauseOnTakeover.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Agents wait while you use this Mac"}},
        "ar": {"stringUnit": {"state": "translated", "value": "ينتظر الوكلاء أثناء استخدامك هذا الـ Mac"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Agenti čekaju dok koristite ovaj Mac"}},
        "da": {"stringUnit": {"state": "translated", "value": "Agenter venter, mens du bruger denne Mac"}},
        "de": {"stringUnit": {"state": "translated", "value": "Agenten warten, während du diesen Mac nutzt"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los agentes esperan mientras usas este Mac"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les agents attendent pendant que vous utilisez ce Mac"}},
        "it": {"stringUnit": {"state": "translated", "value": "Gli agenti attendono mentre usi questo Mac"}},
        "ja": {"stringUnit": {"state": "translated", "value": "Macを使っている間はエージェントが待機"}},
        "km": {"stringUnit": {"state": "translated", "value": "ភ្នាក់ងាររង់ចាំពេលអ្នកប្រើ Mac នេះ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 Mac을 사용하는 동안 에이전트 대기"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Agenter venter mens du bruker denne Macen"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Agenci czekają, gdy używasz tego Maca"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Os agentes esperam enquanto você usa este Mac"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Агенты ждут, пока вы пользуетесь Mac"}},
        "th": {"stringUnit": {"state": "translated", "value": "เอเจนต์รอขณะคุณใช้ Mac นี้"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Bu Mac'i kullanırken ajanlar bekler"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Агенти чекають, поки ви користуєтеся Mac"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Tác nhân chờ khi bạn dùng máy Mac này"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "你使用这台 Mac 时智能体会等待"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "你使用這台 Mac 時代理程式會等待"}}
      }
    },
    "settings.computerUse.showCursor.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "A blue cursor shows wherever an agent clicks or types."}},
        "ar": {"stringUnit": {"state": "translated", "value": "يظهر مؤشر أزرق حيثما ينقر الوكيل أو يكتب."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Plavi kursor se prikazuje gdje god agent klikne ili kuca."}},
        "da": {"stringUnit": {"state": "translated", "value": "En blå markør vises, hvor en agent klikker eller skriver."}},
        "de": {"stringUnit": {"state": "translated", "value": "Ein blauer Zeiger zeigt, wo ein Agent klickt oder tippt."}},
        "es": {"stringUnit": {"state": "translated", "value": "Un cursor azul aparece donde un agente hace clic o escribe."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un curseur bleu apparaît là où un agent clique ou tape."}},
        "it": {"stringUnit": {"state": "translated", "value": "Un cursore blu appare dove un agente fa clic o digita."}},
        "ja": {"stringUnit": {"state": "translated", "value": "エージェントがクリックや入力をする場所に青いカーソルが表示されます。"}},
        "km": {"stringUnit": {"state": "translated", "value": "ទស្សន៍ទ្រនិចពណ៌ខៀវបង្ហាញនៅកន្លែងដែលភ្នាក់ងារចុច ឬវាយ។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "에이전트가 클릭하거나 입력하는 곳에 파란색 커서가 표시됩니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "En blå markør vises der en agent klikker eller skriver."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Niebieski kursor pokazuje, gdzie agent klika lub pisze."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Um cursor azul aparece onde um agente clica ou digita."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Синий курсор показывает, где агент нажимает или печатает."}},
        "th": {"stringUnit": {"state": "translated", "value": "เคอร์เซอร์สีน้ำเงินจะแสดงตรงที่เอเจนต์คลิกหรือพิมพ์"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Bir ajanın tıkladığı veya yazdığı her yerde mavi bir imleç görünür."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Синій курсор показує, де агент клацає або друкує."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Con trỏ màu xanh hiện ở bất cứ đâu tác nhân nhấp hoặc gõ."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "智能体点按或输入的位置会显示蓝色光标。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "代理程式點按或輸入的位置會顯示藍色游標。"}}
      }
    },
    "settings.computerUse.showCursor.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "A blue cursor shows where agents act"}},
        "ar": {"stringUnit": {"state": "translated", "value": "مؤشر أزرق يُظهر مكان عمل الوكلاء"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Plavi kursor pokazuje gdje agenti rade"}},
        "da": {"stringUnit": {"state": "translated", "value": "En blå markør viser, hvor agenter handler"}},
        "de": {"stringUnit": {"state": "translated", "value": "Ein blauer Zeiger zeigt, wo Agenten handeln"}},
        "es": {"stringUnit": {"state": "translated", "value": "Un cursor azul muestra dónde actúan los agentes"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un curseur bleu montre où agissent les agents"}},
        "it": {"stringUnit": {"state": "translated", "value": "Un cursore blu mostra dove agiscono gli agenti"}},
        "ja": {"stringUnit": {"state": "translated", "value": "エージェントの操作位置に青いカーソル"}},
        "km": {"stringUnit": {"state": "translated", "value": "ទស្សន៍ទ្រនិចខៀវបង្ហាញកន្លែងភ្នាក់ងារធ្វើការ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "파란색 커서가 에이전트 동작 위치를 표시"}},
        "nb": {"stringUnit": {"state": "translated", "value": "En blå markør viser hvor agenter handler"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Niebieski kursor pokazuje, gdzie działają agenci"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Um cursor azul mostra onde os agentes agem"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Синий курсор показывает действия агентов"}},
        "th": {"stringUnit": {"state": "translated", "value": "เคอร์เซอร์สีน้ำเงินแสดงจุดที่เอเจนต์ทำงาน"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Mavi imleç ajanların nerede çalıştığını gösterir"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Синій курсор показує дії агентів"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Con trỏ xanh cho thấy nơi tác nhân thao tác"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "蓝色光标显示智能体操作的位置"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "藍色游標顯示代理程式操作的位置"}}
      }
    },
    "settings.computerUse.allowForeground": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Allow Foreground Input"}},
        "ar": {"stringUnit": {"state": "translated", "value": "السماح بالإدخال في المقدمة"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Dozvoli unos u prvom planu"}},
        "da": {"stringUnit": {"state": "translated", "value": "Tillad input i forgrunden"}},
        "de": {"stringUnit": {"state": "translated", "value": "Eingaben im Vordergrund erlauben"}},
        "es": {"stringUnit": {"state": "translated", "value": "Permitir entrada en primer plano"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Autoriser la saisie au premier plan"}},
        "it": {"stringUnit": {"state": "translated", "value": "Consenti input in primo piano"}},
        "ja": {"stringUnit": {"state": "translated", "value": "前面での入力を許可"}},
        "km": {"stringUnit": {"state": "translated", "value": "អនុញ្ញាតការបញ្ចូលនៅផ្ទៃខាងមុខ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "전경 입력 허용"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Tillat inndata i forgrunnen"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Zezwalaj na wprowadzanie na pierwszym planie"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Permitir entrada em primeiro plano"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Разрешить ввод на переднем плане"}},
        "th": {"stringUnit": {"state": "translated", "value": "อนุญาตการป้อนข้อมูลเบื้องหน้า"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Ön plan girişine izin ver"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Дозволити введення на передньому плані"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Cho phép nhập ở tiền cảnh"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "允许前台输入"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "允許前景輸入"}}
      }
    },
    "settings.computerUse.allowForeground.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Advanced. Agents may bring an app to the front and move your pointer when it takes no background input."}},
        "ar": {"stringUnit": {"state": "translated", "value": "متقدّم. يمكن للوكلاء إحضار تطبيق إلى المقدمة وتحريك مؤشرك عندما لا يقبل التطبيق الإدخال في الخلفية."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Napredno. Agenti smiju dovesti aplikaciju u prvi plan i pomjeriti vaš pokazivač kada ona ne prima unos u pozadini."}},
        "da": {"stringUnit": {"state": "translated", "value": "Avanceret. Agenter må bringe en app i forgrunden og flytte din markør, når den ikke tager imod input i baggrunden."}},
        "de": {"stringUnit": {"state": "translated", "value": "Erweitert. Agenten dürfen eine App in den Vordergrund holen und deinen Zeiger bewegen, wenn sie keine Eingaben im Hintergrund annimmt."}},
        "es": {"stringUnit": {"state": "translated", "value": "Avanzado. Los agentes pueden traer una app al frente y mover tu puntero cuando no acepta entrada en segundo plano."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Avancé. Les agents peuvent mettre une app au premier plan et déplacer votre pointeur quand elle n’accepte pas la saisie en arrière-plan."}},
        "it": {"stringUnit": {"state": "translated", "value": "Avanzato. Gli agenti possono portare un’app in primo piano e spostare il puntatore quando non accetta input in background."}},
        "ja": {"stringUnit": {"state": "translated", "value": "詳細設定。バックグラウンドで入力を受け付けないアプリでは、エージェントがアプリを前面に出してポインタを動かせます。"}},
        "km": {"stringUnit": {"state": "translated", "value": "កម្រិតខ្ពស់។ ភ្នាក់ងារអាចនាំកម្មវិធីមកខាងមុខ និងផ្លាស់ទីព្រួញរបស់អ្នក នៅពេលវាមិនទទួលការបញ្ចូលនៅផ្ទៃខាងក្រោយ។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "고급. 앱이 백그라운드 입력을 받지 않으면 에이전트가 앱을 앞으로 가져오고 포인터를 움직일 수 있습니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Avansert. Agenter kan hente en app til forgrunnen og flytte pekeren når den ikke tar imot inndata i bakgrunnen."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Zaawansowane. Agenci mogą przenieść aplikację na pierwszy plan i poruszać wskaźnikiem, gdy nie przyjmuje ona danych w tle."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Avançado. Os agentes podem trazer um app para a frente e mover seu ponteiro quando ele não aceita entrada em segundo plano."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Дополнительно. Агенты могут выводить приложение на передний план и двигать указатель, если оно не принимает ввод в фоне."}},
        "th": {"stringUnit": {"state": "translated", "value": "ขั้นสูง เอเจนต์สามารถนำแอปขึ้นมาด้านหน้าและขยับตัวชี้ของคุณเมื่อแอปไม่รับการป้อนข้อมูลเบื้องหลัง"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Gelişmiş. Arka planda giriş almayan bir uygulamada ajanlar uygulamayı öne getirip işaretçinizi hareket ettirebilir."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Додатково. Агенти можуть виводити програму на передній план і рухати вказівник, якщо вона не приймає введення у фоні."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Nâng cao. Tác nhân được đưa ứng dụng lên trước và di chuyển con trỏ của bạn khi ứng dụng không nhận nhập liệu ở nền."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "高级。当应用不接受后台输入时，智能体可将其置于前台并移动你的指针。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "進階。當 App 不接受背景輸入時，代理程式可將其帶到前景並移動你的指標。"}}
      }
    },
    "settings.computerUse.allowForeground.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Advanced: agents may take focus and move the pointer"}},
        "ar": {"stringUnit": {"state": "translated", "value": "متقدّم: يمكن للوكلاء أخذ التركيز وتحريك المؤشر"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Napredno: agenti smiju preuzeti fokus i pomjerati pokazivač"}},
        "da": {"stringUnit": {"state": "translated", "value": "Avanceret: agenter må tage fokus og flytte markøren"}},
        "de": {"stringUnit": {"state": "translated", "value": "Erweitert: Agenten dürfen Fokus und Zeiger übernehmen"}},
        "es": {"stringUnit": {"state": "translated", "value": "Avanzado: los agentes pueden tomar el foco y el puntero"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Avancé : les agents peuvent prendre le focus et le pointeur"}},
        "it": {"stringUnit": {"state": "translated", "value": "Avanzato: gli agenti possono prendere focus e puntatore"}},
        "ja": {"stringUnit": {"state": "translated", "value": "詳細：エージェントがフォーカスとポインタを操作"}},
        "km": {"stringUnit": {"state": "translated", "value": "កម្រិតខ្ពស់៖ ភ្នាក់ងារអាចយកការផ្ដោត និងផ្លាស់ទីព្រួញ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "고급: 에이전트가 포커스와 포인터를 제어 가능"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Avansert: agenter kan ta fokus og flytte pekeren"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Zaawansowane: agenci mogą przejąć fokus i wskaźnik"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Avançado: agentes podem assumir o foco e mover o ponteiro"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Дополнительно: агенты могут брать фокус и двигать указатель"}},
        "th": {"stringUnit": {"state": "translated", "value": "ขั้นสูง: เอเจนต์รับโฟกัสและขยับตัวชี้ได้"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Gelişmiş: ajanlar odağı alıp işaretçiyi hareket ettirebilir"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Додатково: агенти можуть брати фокус і рухати вказівник"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Nâng cao: tác nhân được lấy tiêu điểm và di chuyển con trỏ"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "高级：智能体可获取焦点并移动指针"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "進階：代理程式可取得焦點並移動指標"}}
      }
    },
