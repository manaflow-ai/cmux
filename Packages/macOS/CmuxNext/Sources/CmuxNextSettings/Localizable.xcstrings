    "settings.agents.subsessions.maxChildren.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finished and closed sub-sessions don't count."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا تُحتسب الجلسات الفرعية المنتهية والمغلقة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Završene i zatvorene podsesije se ne računaju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Færdige og lukkede undersessioner tæller ikke med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fertige und geschlossene Untersitzungen zählen nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
