    "settings.browser.openSignInPages.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in pages open in cmux even when other links open in your default browser."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُفتح صفحات تسجيل الدخول في cmux حتى عندما تُفتح الروابط الأخرى في متصفحك الافتراضي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stranice za prijavu otvaraju se u cmuxu čak i kada se ostali linkovi otvaraju u zadanom pregledniku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Login-sider åbnes i cmux, selv når andre links åbnes i din standardbrowser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anmeldeseiten öffnen sich in cmux, auch wenn andere Links in deinem Standardbrowser geöffnet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las páginas de inicio de sesión se abren en cmux aunque otros enlaces se abran en tu navegador predeterminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les pages de connexion s'ouvrent dans cmux même lorsque les autres liens s'ouvrent dans votre navigateur par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le pagine di accesso si aprono in cmux anche quando gli altri link si aprono nel browser predefinito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ほかのリンクがデフォルトのブラウザで開く設定でも、サインインページはcmuxで開きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ទំព័រចូលបើកក្នុង cmux ទោះបីតំណផ្សេងទៀតបើកក្នុងកម្មវិធីរុករកលំនាំដើមរបស់អ្នកក៏ដោយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다른 링크가 기본 브라우저에서 열리더라도 로그인 페이지는 cmux에서 열립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Påloggingssider åpnes i cmux selv når andre lenker åpnes i standardnettleseren din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Strony logowania otwierają się w cmux, nawet gdy inne linki otwierają się w domyślnej przeglądarce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Páginas de login abrem no cmux mesmo quando outros links abrem no seu navegador padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Страницы входа открываются в cmux, даже если другие ссылки открываются в браузере по умолчанию."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หน้าลงชื่อเข้าใช้จะเปิดใน cmux แม้ลิงก์อื่นจะเปิดในเบราว์เซอร์เริ่มต้นของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diğer bağlantılar varsayılan tarayıcınızda açılsa bile oturum açma sayfaları cmux'ta açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сторінки входу відкриваються в cmux, навіть коли інші посилання відкриваються в браузері за замовчуванням."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trang đăng nhập mở trong cmux ngay cả khi các liên kết khác mở trong trình duyệt mặc định của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "即使其他链接在默认浏览器中打开，登录页面也会在 cmux 中打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "即使其他連結在預設瀏覽器中開啟，登入頁面仍會在 cmux 中開啟。"
          }
        }
      }
