    "settings.chief.autoRouteSubagents.help": {
      "comment": "Chief subagent routing (Leo 2026-11-01).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Chief picks each subagent's agent, such as Codex for code. Off: the Chief's own."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief が各サブエージェントの実行先を選びます（例: コードには Codex）。オフ: Chief と同じエージェント。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يختار Chief وكيل كل وكيل فرعي، مثل Codex للبرمجة. عند الإيقاف: وكيل Chief نفسه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Chief wählt den Agenten jedes Subagenten, etwa Codex für Code. Aus: den Agenten des Chiefs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El Chief elige el agente de cada subagente, como Codex para código. Desactivado: el del Chief."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le Chief choisit l'agent de chaque sous-agent, par exemple Codex pour le code. Désactivé : celui du Chief."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief가 각 하위 에이전트의 에이전트를 고릅니다(예: 코딩에는 Codex). 끄면 Chief의 에이전트를 씁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief 为每个子代理挑选代理，例如编程用 Codex。关闭：使用 Chief 自己的代理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief 會為每個子代理挑選代理，例如程式工作用 Codex。關閉：使用 Chief 自己的代理。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief bira agenta za svakog podagenta, npr. Codex za kod. Isključeno: Chiefov agent."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief vælger hver underagents agent, f.eks. Codex til kode. Fra: Chiefs egen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il Chief sceglie l’agente di ogni subagente, ad esempio Codex per il codice. Disattivato: quello del Chief."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief ជ្រើសភ្នាក់ងារសម្រាប់ភ្នាក់ងាររងនីមួយៗ ដូចជា Codex សម្រាប់កូដ។ បិទ៖ ភ្នាក់ងាររបស់ Chief ផ្ទាល់។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief velger agent for hver underagent, for eksempel Codex for kode. Av: Chiefs egen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief wybiera agenta każdego podagenta, np. Codex do kodu. Wyłączone: agent Chiefa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Chief escolhe o agente de cada subagente, como o Codex para código. Desativado: o do próprio Chief."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief выбирает агента для каждого субагента, например Codex для кода. Выкл.: агент самого Chief."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief เลือกเอเจนต์ให้เอเจนต์ย่อยแต่ละตัว เช่น Codex สำหรับโค้ด ปิด: ใช้เอเจนต์ของ Chief เอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief, her alt ajanın ajanını seçer; örneğin kod için Codex. Kapalı: Chief'in kendi ajanı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief обирає агента для кожного субагента, наприклад Codex для коду. Вимкнено: агент самого Chief."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief chọn tác tử cho mỗi tác tử phụ, như Codex cho viết mã. Tắt: tác tử của chính Chief."
          }
        }
      }
    },
