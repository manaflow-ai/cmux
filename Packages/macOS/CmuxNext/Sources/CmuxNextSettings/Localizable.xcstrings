    "settings.tabs.barOrder.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a browser pane with the tab bar at the top: the tab bar above the address bar, or below it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "タブバーが上にあるブラウザのペインで、タブバーをアドレスバーの上に置くか、下に置くか。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "في جزء متصفح مع شريط علامات التبويب في الأعلى: شريط علامات التبويب فوق شريط العنوان أو تحته."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "U oknu preglednika s trakom kartica na vrhu: traka kartica iznad adresne trake ili ispod nje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I en browserrude med fanebjælken øverst: fanebjælken over adresselinjen eller under den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In einem Browserbereich mit der Tableiste oben: die Tableiste über der Adressleiste oder darunter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En un panel de navegador con la barra de pestañas arriba: la barra de pestañas sobre la barra de direcciones o debajo de ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dans une sous-fenêtre de navigateur avec la barre d’onglets en haut : la barre d’onglets au-dessus de la barre d’adresse ou en dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In un riquadro del browser con la barra delle schede in alto: la barra delle schede sopra la barra degli indirizzi o sotto."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ក្នុងផ្ទាំងកម្មវិធីរុករកដែលមានរបារផ្ទាំងនៅខាងលើ៖ របារផ្ទាំងនៅលើរបារអាសយដ្ឋាន ឬនៅក្រោមវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "탭 막대가 위에 있는 브라우저 패널에서 탭 막대를 주소 막대 위 또는 아래에 둡니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I en nettleserrute med fanelinjen øverst: fanelinjen over adresselinjen eller under den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "W panelu przeglądarki z paskiem kart na górze: pasek kart nad paskiem adresu lub pod nim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Em um painel de navegador com a barra de abas no topo: a barra de abas acima da barra de endereço ou abaixo dela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В панели браузера с панелью вкладок сверху: панель вкладок над адресной строкой или под ней."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ในบานหน้าต่างเบราว์เซอร์ที่มีแถบแท็บอยู่ด้านบน: แถบแท็บอยู่เหนือแถบที่อยู่ หรืออยู่ใต้แถบนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sekme çubuğu üstte olan bir tarayıcı bölmesinde: sekme çubuğu adres çubuğunun üstünde ya da altında."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У панелі браузера з панеллю вкладок угорі: панель вкладок над адресним рядком або під ним."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trong ngăn trình duyệt có thanh tab ở trên cùng: thanh tab nằm trên thanh địa chỉ hoặc bên dưới nó."
