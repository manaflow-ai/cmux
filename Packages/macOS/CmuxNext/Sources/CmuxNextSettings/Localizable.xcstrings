    "settings.status.runNotifyMinimumSeconds.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux status run notifies when the command took at least this long."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux status run はコマンドがこの時間以上かかったときに通知します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يرسل cmux status run إشعارًا عندما يستغرق الأمر هذه المدة على الأقل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux status run obavještava kad naredba traje barem ovoliko."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux status run giver besked, når kommandoen tog mindst så lang tid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux status run benachrichtigt, wenn der Befehl mindestens so lange dauerte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux status run avisa cuando el comando tardó al menos esto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux status run notifie quand la commande a duré au moins ce temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux status run notifica quando il comando ha impiegato almeno questo tempo."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux status run ជូនដំណឹងពេលពាក្យបញ្ជាយូរយ៉ាងហោចណាស់ប៉ុណ្ណេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux status run은 명령이 이 시간 이상 걸리면 알립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux status run varsler når kommandoen tok minst så lang tid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux status run powiadamia, gdy polecenie trwało co najmniej tyle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux status run notifica quando o comando levou pelo menos esse tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux status run уведомляет, если команда шла не меньше этого."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux status run แจ้งเตือนเมื่อคำสั่งใช้เวลาอย่างน้อยเท่านี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux status run, komut en az bu kadar sürdüğünde bildirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux status run сповіщає, якщо команда тривала щонайменше стільки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
