    "settings.internalDeveloperMode.help": {
      "comment": "Help text under the Internal Developer Mode toggle. \"Debug: …\" is the title prefix of the palette rows; translate it the same way as the action.debug.titleFormat string.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعرض أوامر \"Debug: …\" في لوحة الأوامر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prikazuje naredbe \"Debug: …\" u paleti naredbi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viser \"Debug: …\"-kommandoer i kommandopaletten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeigt Befehle \"Debug: …\" in der Befehlspalette."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows \"Debug: …\" commands in the Command Palette."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Muestra los comandos \"Debug: …\" en la paleta de comandos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Affiche les commandes \"Debug: …\" dans la palette de commandes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mostra i comandi \"Debug: …\" nella palette dei comandi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "コマンドパレットに \"Debug: …\" コマンドを表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បង្ហាញពាក្យបញ្ជា \"Debug: …\" នៅក្នុងផ្ទាំងពាក្យបញ្ជា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "명령 팔레트에 \"Debug: …\" 명령을 표시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viser \"Debug: …\"-kommandoer i kommandopaletten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokazuje polecenia \"Debug: …\" w palecie poleceń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mostra comandos \"Debug: …\" na paleta de comandos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Показывает команды \"Debug: …\" в палитре команд."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แสดงคำสั่ง \"Debug: …\" ในจานคำสั่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Komut paletinde \"Debug: …\" komutlarını gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Показує команди \"Debug: …\" у палітрі команд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hiển thị các lệnh \"Debug: …\" trong bảng lệnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在命令面板中显示 \"Debug: …\" 命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在指令面板中顯示 \"Debug: …\" 指令。"
          }
        }
      }
