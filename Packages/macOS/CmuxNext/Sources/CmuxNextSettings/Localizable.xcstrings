    "settings.markdown.fontSize.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The size viewers open at. Cmd-= and Cmd-- change one viewer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الحجم الذي تُفتح به العارضات. يغيّر Cmd-= وCmd-- عارضًا واحدًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Veličina s kojom se otvaraju preglednici. Cmd-= i Cmd-- mijenjaju jedan preglednik."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Størrelsen, visninger åbner med. Cmd-= og Cmd-- ændrer én visning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Größe, mit der Ansichten öffnen. Cmd-= und Cmd-- ändern eine einzelne Ansicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El tamaño con el que se abren los visores. Cmd-= y Cmd-- lo cambian en un visor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La taille à l’ouverture des visionneuses. Cmd-= et Cmd-- modifient une seule visionneuse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La dimensione con cui si aprono i visualizzatori. Cmd-= e Cmd-- la cambiano in un visualizzatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ビューアを開いたときのサイズです。Cmd-= と Cmd-- でビューアごとに変更できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ទំហំដែលកម្មវិធីមើលបើកជាមួយ។ Cmd-= និង Cmd-- ប្ដូរកម្មវិធីមើលមួយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "뷰어가 열릴 때의 크기입니다. Cmd-=와 Cmd--로 뷰어마다 바꿀 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Størrelsen visninger åpner med. Cmd-= og Cmd-- endrer én visning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rozmiar, z jakim otwierają się przeglądarki. Cmd-= i Cmd-- zmieniają jedną przeglądarkę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O tamanho com que os visualizadores abrem. Cmd-= e Cmd-- o alteram em um visualizador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Размер, с которым открывается просмотр. Cmd-= и Cmd-- меняют его в одном окне просмотра."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ขนาดที่ตัวแสดงใช้เมื่อเปิด Cmd-= และ Cmd-- เปลี่ยนขนาดในตัวแสดงหนึ่งตัว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Görüntüleyicilerin açıldığı boyut. Cmd-= ve Cmd-- tek bir görüntüleyiciyi değiştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Розмір, з яким відкриваються переглядачі. Cmd-= і Cmd-- змінюють його в одному переглядачі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cỡ chữ khi mở trình xem. Cmd-= và Cmd-- thay đổi cỡ chữ trong một trình xem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "查看器打开时的大小。Cmd-= 和 Cmd-- 可调整单个查看器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "檢視器開啟時的大小。Cmd-= 和 Cmd-- 可調整單一檢視器。"
          }
        }
      }
    },
