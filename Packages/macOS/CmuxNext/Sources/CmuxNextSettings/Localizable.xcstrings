    "settings.sessions.keepAwake": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Mac Awake While Agents Work"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إبقاء Mac مستيقظًا أثناء عمل الوكلاء"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Drži Mac budnim dok agenti rade"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Mac vågen, mens agenter arbejder"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac wach halten, während Agenten arbeiten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener el Mac activo mientras trabajan los agentes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder le Mac éveillé pendant que les agents travaillent"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni il Mac attivo mentre gli agenti lavorano"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントの作業中は Mac をスリープさせない"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រក្សា Mac ឱ្យភ្ញាក់ពេលភ្នាក់ងារកំពុងធ្វើការ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 작업하는 동안 Mac 깨어 있게 유지"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Mac våken mens agenter arbeider"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie usypiaj Maca, gdy agenci pracują"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter o Mac ativo enquanto os agentes trabalham"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не давать Mac засыпать, пока работают агенты"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ให้ Mac พักเครื่องขณะที่เอเจนต์ทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanlar çalışırken Mac'i uyanık tut"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не давати Mac засинати, поки працюють агенти"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ Mac thức khi tác tử đang làm việc"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体工作时让 Mac 保持唤醒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理程式工作時讓 Mac 保持喚醒"
          }
        }
      }
    },
    "settings.sessions.keepAwake.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops idle sleep while an agent on this Mac is working. Your display can still turn off, and closing the lid still puts the Mac to sleep."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمنع السكون عند الخمول أثناء عمل وكيل على هذا الـ Mac. يظل بإمكان الشاشة أن تنطفئ، وإغلاق الغطاء لا يزال يُدخل الـ Mac في وضع السكون."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprječava prelazak u stanje mirovanja dok agent na ovom Macu radi. Ekran se i dalje može isključiti, a zatvaranje poklopca i dalje uspavljuje Mac."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forhindrer dvale ved inaktivitet, mens en agent på denne Mac arbejder. Skærmen kan stadig slukke, og når du lukker låget, går Mac'en stadig i dvale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert den Ruhezustand bei Inaktivität, solange ein Agent auf diesem Mac arbeitet. Der Bildschirm kann sich trotzdem ausschalten, und beim Zuklappen geht der Mac weiterhin in den Ruhezustand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita el reposo por inactividad mientras un agente trabaja en este Mac. La pantalla puede apagarse igualmente y, al cerrar la tapa, el Mac sigue entrando en reposo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche la suspension d’activité pendant qu’un agent travaille sur ce Mac. L’écran peut toujours s’éteindre, et fermer le couvercle met toujours le Mac en veille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impedisce lo stop per inattività mentre un agente lavora su questo Mac. Il display può comunque spegnersi e chiudendo il coperchio il Mac va comunque in stop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac でエージェントが作業している間は、アイドル時のスリープを止めます。ディスプレイはオフになることがあり、蓋を閉じると Mac はスリープします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ឈប់ការដេកពេលទំនេរ ខណៈភ្នាក់ងារនៅលើ Mac នេះកំពុងធ្វើការ។ អេក្រង់នៅតែអាចបិទបាន ហើយការបិទគម្របនៅតែធ្វើឱ្យ Mac ដេក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 에이전트가 작업하는 동안 유휴 잠자기를 막습니다. 디스플레이는 계속 꺼질 수 있고, 덮개를 닫으면 Mac은 여전히 잠자기 상태가 됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindrer dvale ved inaktivitet mens en agent på denne Macen arbeider. Skjermen kan fortsatt slå seg av, og når du lukker lokket, går Macen fortsatt i dvale."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymuje usypianie przy bezczynności, gdy agent na tym Macu pracuje. Ekran nadal może się wyłączyć, a zamknięcie pokrywy nadal usypia Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impede o repouso por inatividade enquanto um agente trabalha neste Mac. A tela ainda pode desligar, e fechar a tampa ainda coloca o Mac em repouso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не даёт Mac уйти в сон при бездействии, пока на нём работает агент. Дисплей всё равно может выключиться, а закрытие крышки по-прежнему переводит Mac в сон."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ให้เครื่องพักเมื่อไม่มีการใช้งานขณะที่เอเจนต์บน Mac นี้กำลังทำงาน จอภาพยังคงปิดได้ และการปิดฝาก็ยังทำให้ Mac พักเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'teki bir ajan çalışırken boşta uykuyu engeller. Ekranınız yine de kapanabilir ve kapağı kapatmak Mac'i yine uyutur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не дає Mac засинати під час бездіяльності, поки на ньому працює агент. Дисплей усе одно може вимкнутися, а закриття кришки так само переводить Mac у режим сну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngăn máy ngủ khi không hoạt động trong lúc một tác tử trên máy Mac này đang làm việc. Màn hình vẫn có thể tắt và gập nắp vẫn đưa máy Mac vào chế độ ngủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 Mac 上有智能体工作时，阻止闲置睡眠。显示器仍可关闭，合上盖子仍会让 Mac 进入睡眠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 上有代理程式工作時，防止閒置睡眠。顯示器仍可關閉，闔上螢幕仍會讓 Mac 進入睡眠。"
          }
        }
      }
    },
