          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjul Dock-symbolet når ingen vinduer er åpne"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryj ikonę w Docku, gdy żadne okno nie jest otwarte"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar ícone do Dock quando não houver janelas abertas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывать значок в Dock, когда нет открытых окон"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซ่อนไอคอนใน Dock เมื่อไม่มีหน้าต่างเปิดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık pencere yokken Dock simgesini gizle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ховати значок у Dock, коли немає відкритих вікон"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn biểu tượng Dock khi không có cửa sổ nào mở"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有打开的窗口时隐藏程序坞图标"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有開啟的視窗時隱藏 Dock 圖像"
          }
        }
      }
    },
    "settings.app.hideDockIconWithoutWindows.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يبقى cmux في شريط القائمة حتى تُفتح نافذة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux ostaje u traci menija dok se ne otvori prozor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux bliver i menulinjen, indtil et vindue åbnes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux bleibt in der Menüleiste, bis sich ein Fenster öffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux stays in the menu bar until a window opens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux sigue en la barra de menús hasta que se abra una ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux reste dans la barre des menus jusqu’à l’ouverture d’une fenêtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux resta nella barra dei menu finché non si apre una finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ウインドウが開くまで、cmux はメニューバーで動作し続けます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux នៅក្នុងរបារម៉ឺនុយ រហូតដល់មានវីនដូបើក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "윈도우가 열릴 때까지 cmux는 메뉴 막대에 머뭅니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux blir i menylinjen til et vindu åpnes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux zostaje na pasku menu, dopóki nie otworzy się okno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cmux fica na barra de menus até que uma janela seja aberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux остаётся в строке меню, пока не откроется окно."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux อยู่ในแถบเมนูจนกว่าจะมีหน้าต่างเปิดขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux, bir pencere açılana kadar menü çubuğunda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux лишається в рядку меню, доки не відкриється вікно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux ở trên thanh menu cho đến khi một cửa sổ mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在打开窗口之前，cmux 会留在菜单栏中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在開啟視窗之前，cmux 會留在選單列中。"
          }
        }
      }
    },
