    "settings.sidebar.sectionLook.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How the sections above and below the workspace list draw."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ワークスペース一覧の上下にあるセクションの表示方法。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "كيفية عرض الأقسام أعلى قائمة مساحات العمل وأسفلها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kako se prikazuju odjeljci iznad i ispod liste radnih prostora."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvordan sektionerne over og under listen over arbejdsområder vises."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wie die Abschnitte über und unter der Arbeitsbereichsliste aussehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cómo se muestran las secciones encima y debajo de la lista de espacios de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apparence des sections au-dessus et au-dessous de la liste des espaces de travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Come appaiono le sezioni sopra e sotto l'elenco delle aree di lavoro."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "របៀបបង្ហាញផ្នែកខាងលើ និងខាងក្រោមបញ្ជីកន្លែងធ្វើការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "작업 공간 목록 위아래 섹션의 표시 방식입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvordan seksjonene over og under listen over arbeidsområder vises."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jak wyglądają sekcje nad i pod listą przestrzeni roboczych."
          }
        },
