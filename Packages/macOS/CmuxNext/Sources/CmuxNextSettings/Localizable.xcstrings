    "settings.sidebar.hoverCards.delay.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long the pointer rests on a workspace or a tab before its card opens. While a card shows, the next one opens at once."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المدة التي يستقر فيها المؤشر على مساحة عمل أو علامة تبويب قبل فتح بطاقتها. أثناء ظهور بطاقة، تُفتح البطاقة التالية فورًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko dugo pokazivač miruje na radnom prostoru ili kartici prije nego što se otvori njegova kartica. Dok je kartica prikazana, sljedeća se otvara odmah."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor længe markøren hviler på et arbejdsområde eller en fane, før dets kort åbner. Mens et kort vises, åbner det næste med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange der Zeiger auf einem Workspace oder Tab ruht, bevor sich seine Karte öffnet. Solange eine Karte angezeigt wird, öffnet sich die nächste sofort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto tiempo se detiene el puntero sobre un espacio de trabajo o una pestaña antes de que se abra su tarjeta. Mientras se muestra una tarjeta, la siguiente se abre al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durée pendant laquelle le pointeur reste sur un espace de travail ou un onglet avant l'ouverture de sa carte. Tant qu'une carte est affichée, la suivante s'ouvre aussitôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per quanto tempo il puntatore resta su uno spazio di lavoro o una scheda prima che si apra la sua scheda. Mentre una scheda è visibile, la successiva si apre subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースやタブの上にポインタを置いてからカードが開くまでの時間です。カードの表示中は、次のカードがすぐに開きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រយៈពេលដែលទស្សន៍ទ្រនិចនៅលើកន្លែងធ្វើការ ឬផ្ទាំង មុនពេលកាតរបស់វាបើក។ ពេលកាតមួយកំពុងបង្ហាញ កាតបន្ទាប់បើកភ្លាមៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드가 열리기 전에 포인터가 워크스페이스나 탭 위에 머무르는 시간입니다. 카드가 표시되는 동안에는 다음 카드가 바로 열립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor lenge pekeren hviler på et arbeidsområde eller en fane før kortet åpnes. Mens et kort vises, åpnes det neste med en gang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak długo wskaźnik musi pozostać na obszarze roboczym lub karcie, zanim otworzy się jego karta. Gdy karta jest widoczna, następna otwiera się od razu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto tempo o ponteiro fica sobre um espaço de trabalho ou uma aba antes de o cartão abrir. Enquanto um cartão está visível, o próximo abre na hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько указатель должен задержаться на рабочем пространстве или вкладке, прежде чем откроется её карточка. Пока карточка видна, следующая открывается сразу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระยะเวลาที่ตัวชี้ต้องวางบนเวิร์กสเปซหรือแท็บก่อนที่การ์ดจะเปิด ขณะที่การ์ดแสดงอยู่ การ์ดถัดไปจะเปิดทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartı açılmadan önce işaretçinin bir çalışma alanı veya sekme üzerinde ne kadar durduğu. Bir kart görünürken sonraki hemen açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки вказівник має затриматися на робочому просторі або вкладці, перш ніж відкриється її картка. Поки картка видима, наступна відкривається одразу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời gian con trỏ dừng trên một không gian làm việc hoặc tab trước khi thẻ của nó mở. Khi một thẻ đang hiện, thẻ tiếp theo mở ngay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指针在工作区或标签页上停留多久后打开其卡片。卡片显示时，下一张会立即打开。"
          }
        },
