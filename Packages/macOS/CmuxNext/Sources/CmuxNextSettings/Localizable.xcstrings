    "settings.sidebar.sideBySide.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اسحب صف مساحة عمل إلى حافة جزء لعرضها بجانب الحالية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Povucite red radnog prostora na rub okna da ga prikažete pored trenutnog."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Træk en arbejdsområderække hen på kanten af en rude for at vise det ved siden af det aktuelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ziehe eine Arbeitsbereich-Zeile an den Rand eines Bereichs, um ihn neben dem aktuellen anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a workspace row onto a pane's edge to show it beside the current one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arrastra una fila de espacio de trabajo al borde de un panel para mostrarlo junto al actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faites glisser une ligne d’espace de travail sur le bord d’un volet pour l’afficher à côté de l’actuel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trascina una riga di workspace sul bordo di un riquadro per mostrarlo accanto a quello attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ワークスペースの行をペインの端にドラッグすると、現在のものの横に表示できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អូសជួរកន្លែងធ្វើការទៅគែមផ្ទាំង ដើម្បីបង្ហាញវាក្បែរកន្លែងបច្ចុប្បន្ន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "워크스페이스 행을 패널 가장자리로 드래그하면 현재 워크스페이스 옆에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dra en arbeidsområderad til kanten av en rute for å vise den ved siden av det gjeldende."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przeciągnij wiersz obszaru roboczego na krawędź panelu, aby pokazać go obok bieżącego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arraste uma linha de espaço de trabalho até a borda de um painel para mostrá-lo ao lado do atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перетащите строку рабочего пространства к краю панели, чтобы показать его рядом с текущим."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลากแถวเวิร์กสเปซไปที่ขอบของบานหน้าต่างเพื่อแสดงข้างเวิร์กสเปซปัจจุบัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir çalışma alanını mevcut olanın yanında göstermek için satırını bir bölmenin kenarına sürükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перетягніть рядок робочого простору до краю панелі, щоб показати його поруч із поточним."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kéo dòng không gian làm việc đến cạnh của một ngăn để hiện nó bên cạnh không gian hiện tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将工作区行拖到窗格边缘，即可在当前工作区旁边显示它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "將工作區列拖到窗格邊緣，即可在目前工作區旁邊顯示它。"
          }
        }
      }
    },
