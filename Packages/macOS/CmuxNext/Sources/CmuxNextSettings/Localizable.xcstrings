    "settings.window.trafficLightClearance.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Space kept free for the window's close, minimize and zoom buttons."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مساحة تُترك فارغة لأزرار الإغلاق والتصغير والتكبير في النافذة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prostor koji ostaje slobodan za dugmad za zatvaranje, minimiziranje i zumiranje prozora."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plads, der holdes fri til vinduets luk-, minimer- og zoomknapper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Platz, der für die Tasten zum Schließen, Minimieren und Zoomen frei bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Espacio libre para los botones de cerrar, minimizar y ampliar de la ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Espace laissé libre pour les boutons de fermeture, de réduction et de zoom de la fenêtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spazio lasciato libero per i pulsanti di chiusura, riduzione e zoom della finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウの閉じる、しまう、拡大ボタンのために空けておく余白です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ចន្លោះទុកទំនេរសម្រាប់ប៊ូតុងបិទ បង្រួម និងពង្រីកបង្អួច។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "창의 닫기, 최소화, 확대 버튼을 위해 비워 두는 공간입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plass som holdes fri til vinduets lukk-, minimer- og zoomknapper."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miejsce pozostawione dla przycisków zamykania, minimalizowania i powiększania okna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Espaço mantido livre para os botões de fechar, minimizar e ampliar da janela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Место, оставленное для кнопок закрытия, сворачивания и масштабирования окна."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
