    "settings.autoArchive.idleDays.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A workspace counts as idle when you have not opened it and nothing in it changed for this many days. Pinned workspaces, running commands and workspaces that need you never archive."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُعدّ مساحة العمل خاملة عندما لا تفتحها ولا يتغير فيها شيء طوال هذا العدد من الأيام. لا تُؤرشف أبدًا مساحات العمل المثبتة أو التي تشغّل أوامر أو التي تحتاج إليك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Radni prostor je neaktivan kad ga niste otvorili i ništa se u njemu nije promijenilo ovoliko dana. Prikačeni prostori, pokrenute komande i prostori koji vas trebaju nikad se ne arhiviraju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et arbejdsområde er inaktivt, når du ikke har åbnet det, og intet i det har ændret sig i så mange dage. Fastgjorte arbejdsområder, kørende kommandoer og arbejdsområder, der venter på dig, arkiveres aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Arbeitsbereich gilt als inaktiv, wenn du ihn so viele Tage nicht geöffnet hast und sich nichts darin geändert hat. Angeheftete Arbeitsbereiche, laufende Befehle und Arbeitsbereiche, die dich brauchen, werden nie archiviert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un espacio de trabajo está inactivo cuando no lo has abierto y nada ha cambiado en él durante estos días. Los fijados, los que ejecutan comandos y los que te necesitan nunca se archivan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un espace de travail est inactif quand vous ne l’avez pas ouvert et que rien n’y a changé pendant ce nombre de jours. Les espaces épinglés, les commandes en cours et les espaces qui ont besoin de vous ne sont jamais archivés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uno spazio di lavoro è inattivo quando non lo apri e nulla cambia al suo interno per questi giorni. Quelli fissati, con comandi in esecuzione o che hanno bisogno di te non vengono mai archiviati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この日数のあいだ開かず、中身も変わらなかったワークスペースを未使用とみなします。ピン留め中、コマンド実行中、対応が必要なワークスペースはアーカイブしません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កន្លែងធ្វើការត្រូវចាត់ទុកថាមិនប្រើ ពេលអ្នកមិនបានបើក ហើយគ្មានអ្វីផ្លាស់ប្តូរក្នុងវាចំនួនថ្ងៃនេះ។ កន្លែងធ្វើការដែលខ្ទាស់ ពាក្យបញ្ជាកំពុងដំណើរការ និងកន្លែងដែលត្រូវការអ្នក មិនដែលទុកក្នុងប័ណ្ណសារទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 일수 동안 열지 않았고 안에서 아무것도 바뀌지 않은 워크스페이스를 사용하지 않는 것으로 봅니다. 고정된 워크스페이스, 실행 중인 명령, 확인이 필요한 워크스페이스는 보관하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et arbeidsområde er inaktivt når du ikke har åpnet det og ingenting i det har endret seg på så mange dager. Festede arbeidsområder, kjørende kommandoer og arbeidsområder som trenger deg, arkiveres aldri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obszar roboczy jest nieaktywny, gdy go nie otwierasz i nic się w nim nie zmienia przez tyle dni. Przypięte obszary, działające polecenia i obszary, które cię potrzebują, nigdy nie są archiwizowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um espaço de trabalho fica inativo quando você não o abre e nada muda nele por esses dias. Fixados, com comandos rodando ou que precisam de você nunca são arquivados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Рабочее пространство считается неактивным, если вы его не открывали и в нём ничего не менялось столько дней. Закреплённые, с запущенными командами и ждущие вас никогда не архивируются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เวิร์กสเปซจะถือว่าไม่ได้ใช้เมื่อคุณไม่ได้เปิดและไม่มีอะไรเปลี่ยนในนั้นตามจำนวนวันนี้ เวิร์กสเปซที่ปักหมุด คำสั่งที่กำลังรัน และเวิร์กสเปซที่ต้องการคุณจะไม่ถูกเก็บถาวร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir çalışma alanını bu kadar gün açmadıysanız ve içinde hiçbir şey değişmediyse boşta sayılır. Sabitlenmiş, komut çalıştıran ve sizi bekleyen çalışma alanları hiç arşivlenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Робочий простір вважається неактивним, якщо ви його не відкривали і в ньому нічого не змінювалося стільки днів. Закріплені, з запущеними командами та ті, що чекають на вас, ніколи не архівуються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Một không gian làm việc được xem là không dùng khi bạn không mở và không có gì thay đổi trong đó trong ngần ấy ngày. Không gian đã ghim, đang chạy lệnh hoặc đang cần bạn không bao giờ bị lưu trữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在这么多天里你没有打开、其中也没有任何变化的工作区视为闲置。已固定、正在运行命令或需要你处理的工作区不会被归档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在這麼多天裡你沒有開啟、其中也沒有任何變化的工作區視為閒置。已釘選、正在執行指令或需要你處理的工作區不會被封存。"
          }
        }
      }
    },
