    "settings.sidebar.nowPlaying.otherApps.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also shows what plays in apps like Spotify or Music."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعرض أيضًا ما يتم تشغيله في تطبيقات مثل Spotify أو Music."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
