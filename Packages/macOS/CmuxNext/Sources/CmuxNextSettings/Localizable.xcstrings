    "settings.screenshots.findTools.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Screenshots pane also shows the folders of screenshot apps it finds, such as CleanShot X, Shottr and Kap."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعرض جزء لقطات الشاشة أيضًا مجلدات تطبيقات لقطات الشاشة التي يعثر عليها، مثل CleanShot X وShottr وKap."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Okno Snimci ekrana prikazuje i mape aplikacija za snimke ekrana koje pronađe, kao što su CleanShot X, Shottr i Kap."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skærmbilleder-panelet viser også mapperne fra de skærmbilledapps, det finder, f.eks. CleanShot X, Shottr og Kap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Bereich „Bildschirmfotos“ zeigt auch die Ordner gefundener Bildschirmfoto-Apps wie CleanShot X, Shottr und Kap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El panel Capturas de pantalla también muestra las carpetas de las apps de capturas que encuentra, como CleanShot X, Shottr y Kap."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le panneau Captures d’écran affiche aussi les dossiers des apps de capture trouvées, comme CleanShot X, Shottr et Kap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il pannello Istantanee schermo mostra anche le cartelle delle app per istantanee che trova, come CleanShot X, Shottr e Kap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "スクリーンショットペインには、CleanShot X、Shottr、Kap など検出したスクリーンショットアプリのフォルダも表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទាំងរូបថតអេក្រង់ក៏បង្ហាញថតឯកសាររបស់កម្មវិធីថតអេក្រង់ដែលវារកឃើញផងដែរ ដូចជា CleanShot X, Shottr និង Kap។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "스크린샷 패널에는 CleanShot X, Shottr, Kap 등 찾은 스크린샷 앱의 폴더도 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skjermbilder-panelet viser også mappene til skjermbildeappene det finner, for eksempel CleanShot X, Shottr og Kap."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Panel Zrzuty ekranu pokazuje też foldery znalezionych aplikacji do zrzutów, takich jak CleanShot X, Shottr i Kap."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O painel Capturas de Tela também mostra as pastas dos apps de captura que encontrar, como CleanShot X, Shottr e Kap."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Панель «Снимки экрана» также показывает папки найденных приложений для снимков, например CleanShot X, Shottr и Kap."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แผงภาพหน้าจอจะแสดงโฟลเดอร์ของแอปจับภาพหน้าจอที่พบด้วย เช่น CleanShot X, Shottr และ Kap"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ekran Görüntüleri bölmesi, bulduğu CleanShot X, Shottr ve Kap gibi ekran görüntüsü uygulamalarının klasörlerini de gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Панель «Знімки екрана» також показує теки знайдених застосунків для знімків, як-от CleanShot X, Shottr і Kap."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ngăn Ảnh chụp màn hình cũng hiển thị thư mục của các ứng dụng chụp màn hình tìm thấy, như CleanShot X, Shottr và Kap."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "截屏面板也会显示找到的截屏应用的文件夹，例如 CleanShot X、Shottr 和 Kap。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "截圖面板也會顯示找到的截圖 App 的資料夾，例如 CleanShot X、Shottr 和 Kap。"
          }
        }
      }
    },
