    "settings.browser.hostWhitelist.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only these hosts open in cmux, such as example.com or *.example.com. Empty opens every host in cmux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux で開くのはこれらのホストだけです（例: example.com、*.example.com）。空の場合はすべてのホストを cmux で開きます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا تُفتح في cmux إلا هذه المضيفات، مثل example.com أو *.example.com. إذا تُركت فارغة تُفتح كل المضيفات في cmux."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Samo ovi hostovi se otvaraju u cmuxu, npr. example.com ili *.example.com. Prazno otvara sve hostove u cmuxu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kun disse værter åbnes i cmux, f.eks. example.com eller *.example.com. Tom åbner alle værter i cmux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nur diese Hosts öffnen sich in cmux, etwa example.com oder *.example.com. Leer öffnet alle Hosts in cmux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo estos hosts se abren en cmux, como example.com o *.example.com. Vacío abre todos los hosts en cmux."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seuls ces hôtes s’ouvrent dans cmux, comme example.com ou *.example.com. Vide ouvre tous les hôtes dans cmux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo questi host si aprono in cmux, ad esempio example.com o *.example.com. Vuoto apre tutti gli host in cmux."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មាន​តែ​ម៉ាស៊ីន​ទាំងនេះ​ទេ​ដែល​បើក​ក្នុង cmux ដូចជា example.com ឬ *.example.com។ ទទេ​បើក​ម៉ាស៊ីន​ទាំងអស់​ក្នុង cmux។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 호스트만 cmux에서 열립니다(예: example.com, *.example.com). 비워 두면 모든 호스트가 cmux에서 열립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bare disse vertene åpnes i cmux, for eksempel example.com eller *.example.com. Tom åpner alle verter i cmux."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tylko te hosty otwierają się w cmux, np. example.com lub *.example.com. Puste otwiera wszystkie hosty w cmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Somente estes hosts abrem no cmux, como example.com ou *.example.com. Vazio abre todos os hosts no cmux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В cmux открываются только эти хосты, например example.com или *.example.com. Если пусто, в cmux открываются все хосты."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เฉพาะโฮสต์เหล่านี้ที่เปิดใน cmux เช่น example.com หรือ *.example.com หากว่างไว้ ทุกโฮสต์จะเปิดใน cmux"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yalnızca bu ana bilgisayarlar cmux’ta açılır; örneğin example.com veya *.example.com. Boşsa tüm ana bilgisayarlar cmux’ta açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У cmux відкриваються лише ці хости, наприклад example.com або *.example.com. Якщо порожньо, у cmux відкриваються всі хости."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chỉ những máy chủ này mở trong cmux, ví dụ example.com hoặc *.example.com. Để trống thì mọi máy chủ đều mở trong cmux."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "只有这些主机在 cmux 中打开，例如 example.com 或 *.example.com。留空则所有主机都在 cmux 中打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "只有這些主機會在 cmux 中開啟，例如 example.com 或 *.example.com。留空則所有主機都在 cmux 中開啟。"
          }
        }
      }
    },
    "settings.browser.externalPatterns.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal links that match open in your default browser. Text matches anywhere in the URL, * and ? are wildcards, and re: starts a regular expression."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "一致するターミナルのリンクはデフォルトブラウザで開きます。テキストは URL のどこにでも一致し、* と ? はワイルドカード、re: で正規表現を始めます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُفتح روابط الطرفية المطابقة في متصفحك الافتراضي. يطابق النص أي جزء من عنوان URL، و* و? أحرف بدل، وre: تبدأ تعبيرًا نمطيًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linkovi terminala koji se podudaraju otvaraju se u podrazumijevanom pregledniku. Tekst se podudara bilo gdje u URL-u, * i ? su džokeri, a re: počinje regularni izraz."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminallinks, der matcher, åbnes i din standardbrowser. Tekst matcher hvor som helst i URL’en, * og ? er jokertegn, og re: starter et regulært udtryk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Passende Terminal-Links öffnen sich in deinem Standardbrowser. Text passt an jeder Stelle der URL, * und ? sind Platzhalter, und re: leitet einen regulären Ausdruck ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los enlaces del terminal que coinciden se abren en tu navegador predeterminado. El texto coincide en cualquier parte de la URL, * y ? son comodines y re: inicia una expresión regular."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les liens du terminal correspondants s’ouvrent dans votre navigateur par défaut. Le texte correspond n’importe où dans l’URL, * et ? sont des jokers, et re: introduit une expression régulière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I link del terminale corrispondenti si aprono nel browser predefinito. Il testo corrisponde in qualsiasi punto dell’URL, * e ? sono caratteri jolly e re: inizia un’espressione regolare."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "តំណ​ស្ថានីយ​ដែល​ត្រូវ​គ្នា​បើក​ក្នុង​កម្មវិធី​រុករក​លំនាំដើម​របស់​អ្នក។ អត្ថបទ​ត្រូវ​គ្នា​នៅ​កន្លែង​ណា​ក៏​បាន​ក្នុង URL, * និង ? ជា​តួ​ជំនួស ហើយ re: ចាប់ផ្ដើម​កន្សោម​ទៀងទាត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "일치하는 터미널 링크는 기본 브라우저에서 열립니다. 텍스트는 URL의 어느 부분과도 일치하며, *와 ?는 와일드카드이고 re:는 정규 표현식을 시작합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminallenker som samsvarer, åpnes i standard nettleser. Tekst samsvarer hvor som helst i URL-en, * og ? er jokertegn, og re: starter et regulært uttrykk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pasujące linki terminala otwierają się w domyślnej przeglądarce. Tekst pasuje w dowolnym miejscu adresu URL, * i ? to symbole wieloznaczne, a re: rozpoczyna wyrażenie regularne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Links do terminal que correspondem abrem no seu navegador padrão. O texto corresponde em qualquer parte da URL, * e ? são curingas e re: inicia uma expressão regular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подходящие ссылки из терминала открываются в браузере по умолчанию. Текст совпадает в любом месте URL, * и ? — подстановочные знаки, а re: начинает регулярное выражение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลิงก์เทอร์มินัลที่ตรงกันจะเปิดในเบราว์เซอร์เริ่มต้นของคุณ ข้อความตรงกับส่วนใดก็ได้ของ URL, * และ ? เป็นไวลด์การ์ด และ re: ขึ้นต้นนิพจน์ทั่วไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eşleşen terminal bağlantıları varsayılan tarayıcınızda açılır. Metin URL’nin herhangi bir yerinde eşleşir, * ve ? joker karakterdir, re: ise bir düzenli ifade başlatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відповідні посилання терміналу відкриваються у стандартному браузері. Текст збігається в будь-якому місці URL, * і ? — символи підстановки, а re: починає регулярний вираз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Liên kết terminal khớp sẽ mở trong trình duyệt mặc định của bạn. Văn bản khớp ở bất kỳ đâu trong URL, * và ? là ký tự đại diện, còn re: bắt đầu một biểu thức chính quy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "匹配的终端链接在默认浏览器中打开。文本可匹配 URL 的任意位置，* 和 ? 是通配符，re: 开头表示正则表达式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "符合的終端機連結會在預設瀏覽器中開啟。文字可符合 URL 的任何位置，* 和 ? 是萬用字元，re: 開頭表示規則運算式。"
          }
        }
      }
    },
    "settings.history.terminalCommands.summary": {
