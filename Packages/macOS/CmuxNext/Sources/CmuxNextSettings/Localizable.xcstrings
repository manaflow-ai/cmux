    "settings.browser.passwords.offerToSave.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A browser tab asks to save a sign-in you submit. Tabs an agent drives never ask."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تسأل علامة تبويب المتصفح عن حفظ بيانات تسجيل الدخول التي ترسلها. لا تسأل علامات التبويب التي يتحكم بها وكيل أبدًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kartica preglednika pita da sačuva prijavu koju pošaljete. Kartice kojima upravlja agent nikad ne pitaju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En browserfane spørger, om den skal gemme et login, du sender. Faner, som en agent styrer, spørger aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Browser-Tab fragt, ob eine von dir gesendete Anmeldung gespeichert werden soll. Tabs, die ein Agent steuert, fragen nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una pestaña del navegador pregunta si guardar un inicio de sesión que envías. Las pestañas que controla un agente nunca preguntan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un onglet du navigateur propose d’enregistrer une connexion que vous envoyez. Les onglets pilotés par un agent ne le proposent jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una scheda del browser chiede di salvare un accesso che invii. Le schede controllate da un agente non lo chiedono mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "送信したサインイン情報を保存するかブラウザタブが確認します。エージェントが操作するタブでは確認しません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទាំងកម្មវិធីរុករកសួរថាតើត្រូវរក្សាទុកការចូលដែលអ្នកបញ្ជូនឬទេ។ ផ្ទាំងដែលភ្នាក់ងារបញ្ជាមិនដែលសួរទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "제출한 로그인 정보를 저장할지 브라우저 탭에서 묻습니다. 에이전트가 제어하는 탭은 묻지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En nettleserfane spør om den skal lagre en pålogging du sender. Faner en agent styrer, spør aldri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Karta przeglądarki pyta, czy zapisać wysłane dane logowania. Karty sterowane przez agenta nigdy nie pytają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma aba do navegador pergunta se deve salvar um login que você envia. Abas controladas por um agente nunca perguntam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вкладка браузера предлагает сохранить отправленные данные для входа. Вкладки, которыми управляет агент, никогда не предлагают."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แท็บเบราว์เซอร์จะถามว่าจะบันทึกข้อมูลลงชื่อเข้าใช้ที่คุณส่งไหม แท็บที่เอเจนต์ควบคุมจะไม่ถาม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir tarayıcı sekmesi gönderdiğiniz oturum açma bilgilerini kaydetmeyi sorar. Bir aracının yönettiği sekmeler asla sormaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вкладка браузера пропонує зберегти надіслані дані для входу. Вкладки, якими керує агент, ніколи не пропонують."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tab trình duyệt hỏi có lưu thông tin đăng nhập bạn gửi không. Tab do tác tử điều khiển không bao giờ hỏi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "浏览器标签页会询问是否存储你提交的登录信息。由代理操控的标签页从不询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "瀏覽器分頁會詢問是否儲存你提交的登入資訊。由代理操控的分頁從不詢問。"
          }
        }
      }
    },
