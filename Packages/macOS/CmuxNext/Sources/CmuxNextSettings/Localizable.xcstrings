    "settings.appearance.backgroundLocation.help": {
      "comment": "Settings row help for the sun location. Keep 37.77,-122.42 as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latitude,longitude for sunrise and sunset, such as 37.77,-122.42. Unset: your time zone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "خط العرض وخط الطول لشروق الشمس وغروبها، مثل 37.77,-122.42. إذا لم يُحدَّد: منطقتك الزمنية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geografska širina,dužina za izlazak i zalazak sunca, npr. 37.77,-122.42. Ako nije postavljeno: vaša vremenska zona."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Breddegrad,længdegrad for solopgang og solnedgang, fx 37.77,-122.42. Uden valg: din tidszone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Breiten- und Längengrad für Sonnenauf- und -untergang, etwa 37.77,-122.42. Ohne Angabe: deine Zeitzone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Latitud,longitud para el amanecer y el atardecer, como 37.77,-122.42. Sin definir: tu zona horaria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Latitude,longitude pour le lever et le coucher du soleil, par exemple 37.77,-122.42. Sans valeur : votre fuseau horaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Latitudine,longitudine per alba e tramonto, ad esempio 37.77,-122.42. Se non impostata: il tuo fuso orario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "日の出と日の入りに使う緯度,経度（例: 37.77,-122.42）。未設定の場合はタイムゾーンを使います。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "រយៈទទឹង,រយៈបណ្ដោយសម្រាប់ថ្ងៃរះ និងថ្ងៃលិច ដូចជា 37.77,-122.42។ បើមិនកំណត់៖ ល្វែងម៉ោងរបស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "일출과 일몰에 쓸 위도,경도입니다(예: 37.77,-122.42). 설정하지 않으면 시간대를 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Breddegrad,lengdegrad for soloppgang og solnedgang, for eksempel 37.77,-122.42. Uten verdi: tidssonen din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Szerokość,długość geograficzna dla wschodu i zachodu słońca, np. 37.77,-122.42. Bez ustawienia: Twoja strefa czasowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Latitude,longitude para o nascer e o pôr do sol, como 37.77,-122.42. Sem definir: seu fuso horário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Широта,долгота для восхода и заката, например 37.77,-122.42. Если не задано — ваш часовой пояс."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ละติจูด,ลองจิจูดสำหรับเวลาพระอาทิตย์ขึ้นและตก เช่น 37.77,-122.42 หากไม่ได้ตั้งค่า: ใช้เขตเวลาของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gün doğumu ve batımı için enlem,boylam, örneğin 37.77,-122.42. Ayarlanmazsa: saat diliminiz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Широта,довгота для сходу та заходу сонця, наприклад 37.77,-122.42. Якщо не задано — ваш часовий пояс."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vĩ độ,kinh độ cho giờ mặt trời mọc và lặn, ví dụ 37.77,-122.42. Nếu không đặt: múi giờ của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "用于日出和日落的纬度,经度，例如 37.77,-122.42。未设置：使用你的时区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "用於日出和日落的緯度,經度，例如 37.77,-122.42。未設定：使用你的時區。"
          }
        }
      }
    },
    "settings.appearance.backgroundMemory": {
