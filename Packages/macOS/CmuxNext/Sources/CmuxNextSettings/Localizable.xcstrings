        "ru": {"stringUnit": {"state": "translated", "value": "Что агенты могут делать с вашими приложениями"}},
        "th": {"stringUnit": {"state": "translated", "value": "สิ่งที่เอเจนต์ทำได้กับแอปของคุณ"}},
