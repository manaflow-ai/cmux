    "settings.autoArchive.style.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What cmux does with workspaces you have not used for a while. Archived workspaces stay in their group, dimmed and last, and come back when you open them."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ما يفعله cmux بمساحات العمل التي لم تستخدمها منذ مدة. تبقى مساحات العمل المؤرشفة في مجموعتها، باهتة وفي الأسفل، وتعود عند فتحها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Šta cmux radi s radnim prostorima koje neko vrijeme niste koristili. Arhivirani prostori ostaju u svojoj grupi, zatamnjeni i na kraju, i vraćaju se kad ih otvorite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvad cmux gør med arbejdsområder, du ikke har brugt i et stykke tid. Arkiverede arbejdsområder bliver i deres gruppe, nedtonet og sidst, og kommer tilbage, når du åbner dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Was cmux mit Arbeitsbereichen macht, die du länger nicht benutzt hast. Archivierte Arbeitsbereiche bleiben in ihrer Gruppe, abgeblendet und am Ende, und kommen zurück, wenn du sie öffnest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo que hace cmux con los espacios de trabajo que no usas desde hace tiempo. Los archivados se quedan en su grupo, atenuados y al final, y vuelven cuando los abres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce que fait cmux des espaces de travail que vous n’avez pas utilisés depuis un moment. Les espaces archivés restent dans leur groupe, estompés et en dernier, et reviennent quand vous les ouvrez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cosa fa cmux con gli spazi di lavoro che non usi da un po’. Quelli archiviati restano nel loro gruppo, attenuati e in fondo, e tornano quando li apri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "しばらく使っていないワークスペースを cmux がどう扱うかを選びます。アーカイブしたワークスペースはグループ内の末尾に淡く表示され、開くと元に戻ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អ្វីដែល cmux ធ្វើជាមួយកន្លែងធ្វើការដែលអ្នកមិនបានប្រើមួយរយៈ។ កន្លែងធ្វើការក្នុងប័ណ្ណសារនៅក្នុងក្រុមរបស់វា ស្រអាប់ និងនៅចុងក្រោយ ហើយត្រឡប់មកវិញពេលអ្នកបើកវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "한동안 쓰지 않은 워크스페이스를 cmux가 어떻게 처리할지 정합니다. 보관된 워크스페이스는 그룹 안 맨 아래에 흐리게 남고, 열면 돌아옵니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hva cmux gjør med arbeidsområder du ikke har brukt på en stund. Arkiverte arbeidsområder blir i gruppen sin, dempet og sist, og kommer tilbake når du åpner dem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Co cmux robi z obszarami roboczymi, których dawno nie używasz. Zarchiwizowane zostają w swojej grupie, przygaszone i na końcu, i wracają, gdy je otworzysz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O que o cmux faz com espaços de trabalho que você não usa há algum tempo. Os arquivados ficam no grupo, esmaecidos e por último, e voltam quando você os abre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Что cmux делает с рабочими пространствами, которыми вы давно не пользовались. Архивные остаются в своей группе, приглушённые и в конце, и возвращаются, когда вы их открываете."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สิ่งที่ cmux ทำกับเวิร์กสเปซที่คุณไม่ได้ใช้มาสักพัก เวิร์กสเปซที่เก็บถาวรจะอยู่ในกลุ่มเดิม แสดงจางและอยู่ท้ายสุด และกลับมาเมื่อคุณเปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux’un bir süredir kullanmadığınız çalışma alanlarıyla ne yapacağı. Arşivlenenler gruplarında soluk ve en sonda kalır, açtığınızda geri gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Що cmux робить із робочими просторами, якими ви давно не користувалися. Архівні лишаються у своїй групі, приглушені й наприкінці, і повертаються, коли ви їх відкриваєте."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux làm gì với các không gian làm việc bạn đã lâu không dùng. Không gian đã lưu trữ vẫn ở trong nhóm, mờ đi và nằm cuối, và trở lại khi bạn mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 如何处理你一段时间未使用的工作区。归档的工作区留在原组的末尾并变暗，打开时恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 如何處理你一段時間未使用的工作區。封存的工作區留在原群組的末尾並變暗，開啟時恢復。"
          }
        }
      }
    },
