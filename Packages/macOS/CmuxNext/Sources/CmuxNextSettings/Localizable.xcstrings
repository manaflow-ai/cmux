    "settings.appearance.backgroundRotation.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How often a shuffled background turns to its next picture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie oft ein gemischter Hintergrund zum nächsten Bild wechselt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fréquence à laquelle un fond aléatoire passe à l’image suivante."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد مرات انتقال الخلفية المخلوطة إلى صورتها التالية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con qué frecuencia un fondo aleatorio pasa a la siguiente imagen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨機背景多久換到下一張圖片。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随机背景多久换到下一张图片。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "섞인 배경이 다음 그림으로 바뀌는 간격입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シャッフルした背景が次の画像に切り替わる間隔。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko često nasumična pozadina prelazi na sljedeću sliku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor ofte en blandet baggrund skifter til næste billede."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni quanto uno sfondo casuale passa all’immagine successiva."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ញឹកញាប់ប៉ុណ្ណាដែលផ្ទៃខាងក្រោយចៃដន្យប្ដូរទៅរូបភាពបន្ទាប់។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor ofte en blandet bakgrunn bytter til neste bilde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak często losowe tło przechodzi do następnego obrazu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com que frequência um fundo aleatório passa para a próxima imagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как часто случайный фон переходит к следующему изображению."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความถี่ที่พื้นหลังแบบสุ่มเปลี่ยนไปรูปถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karıştırılan arka planın bir sonraki resme ne sıklıkla geçtiği."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як часто випадковий фон переходить до наступного зображення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tần suất hình nền xáo trộn chuyển sang ảnh tiếp theo."
          }
        }
      }
    },
