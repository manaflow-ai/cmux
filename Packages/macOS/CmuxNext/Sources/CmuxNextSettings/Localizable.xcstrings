    "settings.tabs.newTabWidgets.clock": {
      "comment": "Settings: toggle that shows the clock widget on the New Tab page.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار الساعة في علامة التبويب الجديدة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaži sat na novoj kartici"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis ur på ny fane"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Uhr im neuen Tab anzeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Clock on New Tab"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar reloj en la nueva pestaña"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher l'horloge dans le nouvel onglet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra l'orologio nella nuova scheda"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規タブに時計を表示"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បង្ហាញ​នាឡិកា​នៅ​លើ​ផ្ទាំង​ថ្មី"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 탭에 시계 보기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis klokke på ny fane"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż zegar na nowej karcie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar relógio na nova aba"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать часы в новой вкладке"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงนาฬิกาในแท็บใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni sekmede saati göster"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати годинник у новій вкладці"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện đồng hồ trên thẻ mới"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在新标签页上显示时钟"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在新分頁上顯示時鐘"
          }
        }
      }
    },
    "settings.tabs.newTabWidgets.clock.help": {
      "comment": "Settings: help for the New Tab clock widget toggle.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض هادئ للوقت المحلي بجانب أداة الكتابة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskretan prikaz lokalnog vremena pored polja za pisanje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En diskret visning af lokal tid ved siden af skrivefeltet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine dezente Anzeige der Ortszeit neben dem Eingabefeld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quiet local time display beside the composer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una discreta hora local junto al editor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un affichage discret de l'heure locale à côté du champ de saisie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una discreta visualizzazione dell'ora locale accanto al compositore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力欄の横に控えめに表示される現地時刻。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការ​បង្ហាញ​ម៉ោង​ក្នុង​តំបន់​ដ៏​ស្ងប់ស្ងាត់​នៅ​ក្បែរ​ប្រអប់​សរសេរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성기 옆에 조용히 표시되는 현지 시간입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En diskret visning av lokal tid ved siden av skrivefeltet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyskretny podgląd czasu lokalnego obok pola tworzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma exibição discreta da hora local ao lado do compositor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неброское местное время рядом с полем ввода."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแสดงเวลาท้องถิ่นแบบเรียบ ๆ ข้างช่องเขียน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazma alanının yanında sade bir yerel saat göstergesi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неяскравий показ місцевого часу поруч із полем введення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị giờ địa phương nhẹ nhàng bên cạnh ô soạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在输入框旁低调显示本地时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在輸入框旁低調顯示本地時間。"
          }
        }
      }
    },
