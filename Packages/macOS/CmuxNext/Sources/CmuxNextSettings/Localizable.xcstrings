    "settings.updates.daemon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Background Updates"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحديثات الخلفية المباشرة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ažuriranja u pozadini uživo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-opdateringer i baggrunden"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Hintergrundupdates"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizaciones en segundo plano en vivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mises à jour en direct en arrière-plan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiornamenti in background dal vivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドのライブアップデート"
          }
        },
        "km": {
