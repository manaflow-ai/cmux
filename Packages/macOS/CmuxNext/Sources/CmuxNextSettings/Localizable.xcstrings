    "settings.browser.showAgentCursor.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows an agent's cursor, clicks and typing in browser tabs. Passwords show dots."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعرض مؤشر الوكيل ونقراته وكتابته في علامات تبويب المتصفح. تظهر كلمات المرور نقاطًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prikazuje kursor, klikove i kucanje agenta u karticama preglednika. Lozinke se prikazuju kao tačke."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viser en agents markør, klik og indtastning i browserfaner. Adgangskoder vises som prikker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeigt Zeiger, Klicks und Eingaben eines Agenten in Browser-Tabs. Passwörter erscheinen als Punkte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Muestra el cursor, los clics y lo que escribe un agente en las pestañas del navegador. Las contraseñas muestran puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Affiche le curseur, les clics et la saisie d’un agent dans les onglets du navigateur. Les mots de passe s’affichent en points."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mostra il cursore, i clic e la digitazione di un agente nelle schede del browser. Le password mostrano puntini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ブラウザタブでエージェントのカーソル、クリック、入力を表示します。パスワードはドットで表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បង្ហាញទស្សន៍ទ្រនិច ការចុច និងការវាយរបស់ភ្នាក់ងារក្នុងផ្ទាំងកម្មវិធីរុករក។ ពាក្យសម្ងាត់បង្ហាញជាចំណុច។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "브라우저 탭에서 에이전트의 커서, 클릭, 입력을 표시합니다. 암호는 점으로 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viser en agents markør, klikk og skriving i nettleserfaner. Passord vises som prikker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokazuje kursor agenta, kliknięcia i pisanie w kartach przeglądarki. Hasła są kropkami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mostra o cursor, os cliques e a digitação de um agente nas abas do navegador. Senhas mostram pontos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Показывает курсор, щелчки и ввод агента во вкладках браузера. Пароли показываются точками."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แสดงเคอร์เซอร์ การคลิก และการพิมพ์ของเอเจนต์ในแท็บเบราว์เซอร์ รหัสผ่านจะแสดงเป็นจุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tarayıcı sekmelerinde ajanın imlecini, tıklamalarını ve yazdıklarını gösterir. Parolalar nokta olarak görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Показує курсор, клацання й набір агента у вкладках браузера. Паролі показуються крапками."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hiện con trỏ, các lần nhấp và phím gõ của tác nhân trong thẻ trình duyệt. Mật khẩu hiện dấu chấm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在浏览器标签页中显示代理的光标、点击和输入。密码显示为圆点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在瀏覽器分頁中顯示代理的游標、點按和輸入。密碼顯示為圓點。"
          }
        }
      }
    },
