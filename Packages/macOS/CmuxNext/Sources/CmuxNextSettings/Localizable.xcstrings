    "settings.labs.liveTree.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار مسار الشجرة المباشرة المشترك وممرات الترجمة في جزء الوكيل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaži zajedničku putanju live stabla i trake kompajliranja u oknu agenta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis den delte sti til live-træet og compilerbanerne i agentruden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gemeinsamen Pfad des Live-Baums und die Compiler-Lanes im Agentenbereich anzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the shared live-tree path and compile lanes in the agent pane."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar la ruta compartida del árbol en vivo y los carriles de compilación en el panel del agente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher le chemin partagé de l’arbre en direct et les voies de compilation dans le volet de l’agent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il percorso condiviso dell’albero live e le corsie di compilazione nel riquadro dell’agente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントペインに共有ライブツリーのパスとコンパイルレーンを表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បង្ហាញផ្លូវមែកធាងបន្តផ្ទាល់ដែលបានចែករំលែក និងផ្លូវចងក្រងក្នុងផ្ទាំងភ្នាក់ងារ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 패널에 공유 라이브 트리 경로와 컴파일 레인을 표시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis den delte banen til live-treet og kompilatorfeltene i agentruten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż wspólną ścieżkę drzewa na żywo i tory kompilacji w panelu agenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar o caminho compartilhado da árvore ao vivo e as faixas de compilação no painel do agente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать общий путь живого дерева и линии компиляции на панели агента."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงเส้นทางต้นไม้แบบสดที่แชร์และเลนการคอมไพล์ในบานหน้าต่างเอเจนต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşılan canlı ağaç yolunu ve derleme şeritlerini aracı bölmesinde göster."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати спільний шлях живого дерева та смуги компіляції в панелі агента."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị đường dẫn cây trực tiếp dùng chung và các luồng biên dịch trong ngăn tác tử."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在智能体面板中显示共享实时树路径和编译通道。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在代理窗格中顯示共用即時樹路徑與編譯通道。"
          }
        }
      }
    },
