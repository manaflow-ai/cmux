        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在新标签页显示模板圆点"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在新分頁顯示範本圓點"
          }
        }
      }
    },
    "settings.tabs.newTabWidgets.styleDots.help": {
      "comment": "Settings: help for the toggle that shows the New Tab template dots.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقاط أسفل الصفحة تبدّل قالبها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tačke ispod stranice koje mijenjaju njen predložak."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikker under siden, der skifter dens skabelon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Punkte unter der Seite, die ihre Vorlage wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dots under the page that switch its template."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puntos bajo la página que cambian su plantilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des points sous la page qui changent son modèle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punti sotto la pagina che ne cambiano il modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページの下に、テンプレートを切り替えるドットを表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចំណុច​នៅ​ក្រោម​ទំព័រ​ដែល​ប្ដូរ​គំរូ​របស់​វា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지 아래에서 템플릿을 바꾸는 점입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikker under siden som bytter malen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kropki pod stroną, które zmieniają jej szablon."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontos abaixo da página que trocam o modelo dela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точки под страницей, которые переключают её шаблон."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จุดใต้หน้าที่ใช้สลับเทมเพลตของหน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayfanın altında şablonunu değiştiren noktalar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Точки під сторінкою, що перемикають її шаблон."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các dấu chấm dưới trang để chuyển mẫu của trang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面下方用于切换模板的圆点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頁面下方用於切換範本的圓點。"
          }
        }
      }
    },
